+#!/usr/bin/env bash
+set -euo pipefail
+usage() { echo "Usage: $0 --model-path MODEL.onnx --output OUT.plan"; exit 2; }
+MODEL=""
+OUT=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --model-path) MODEL="$2"; shift 2;;
+    --output) OUT="$2"; shift 2;;
+    *) usage;;
+  esac
+done
+[ -n "$MODEL" ] || usage
+[ -n "$OUT" ] || usage
+
+echo "Building TensorRT engine for $MODEL -> $OUT"
+# This script assumes trtexec is available
+trtexec --onnx="$MODEL" --saveEngine="$OUT" --fp16 --workspace=2048 || {
+  echo "trtexec failed; check runner environment"
+  exit 1
+}
+echo "Engine saved to $OUT"
+
