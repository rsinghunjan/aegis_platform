+#!/usr/bin/env python3
+"""
+Export QPU billing metrics from Postgres to Prometheus.
+ - Connects to qpu Postgres and aggregates estimated cost per team and total queued cost.
+ - Exposes Prometheus metrics:
+   aegis_qpu_queue_est_cost_total
+   aegis_qpu_team_est_cost{team}
+   aegis_qpu_jobs_in_queue_total
+"""
+import os
+import time
+import psycopg2
+from prometheus_client import start_http_server, Gauge
+
+DB_DSN = os.environ.get("QPU_POSTGRES_DSN", "postgresql://qpu:qpu_pass@postgres.qpu.svc.cluster.local:5432/qpu")
+PORT = int(os.environ.get("BILLING_EXPORTER_PORT", "9420"))
+POLL = int(os.environ.get("BILLING_EXPORTER_POLL", "60"))
+
+GAUGE_TOTAL = Gauge("aegis_qpu_queue_est_cost_total", "Total estimated cost in QPU queue USD")
+GAUGE_TEAM = Gauge("aegis_qpu_team_est_cost", "Estimated cost per team", ["team"])
+GAUGE_JOBS = Gauge("aegis_qpu_jobs_in_queue_total", "Jobs in queue", ["team"])
+
+def query_and_export():
+    conn = psycopg2.connect(DB_DSN)
+    cur = conn.cursor()
+    cur.execute("SELECT team, COALESCE(SUM(est_cost),0) FROM qpu_jobs WHERE status='submitted' GROUP BY team")
+    rows = cur.fetchall()
+    total = 0.0
+    for team, s in rows:
+        val = float(s)
+        GAUGE_TEAM.labels(team=team).set(val)
+        cur.execute("SELECT COUNT(*) FROM qpu_jobs WHERE status='submitted' AND team=%s", (team,))
+        cnt = cur.fetchone()[0]
+        GAUGE_JOBS.labels(team=team).set(cnt)
+        total += val
+    GAUGE_TOTAL.set(total)
+    cur.close()
+    conn.close()
+
+if __name__ == "__main__":
+    start_http_server(PORT)
+    while True:
+        try:
+            query_and_export()
+        except Exception as e:
+            print("Billing exporter error:", e)
+        time.sleep(POLL)
+
