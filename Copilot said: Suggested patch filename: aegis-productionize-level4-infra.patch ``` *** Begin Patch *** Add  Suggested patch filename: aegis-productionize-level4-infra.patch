+#!/usr/bin/env python3
+"""
+CI helper: verify an artifact has a Rekor entry before allowing promotion.
+
+Usage:
+  python3 rekor_enforce.py --artifact /path/to/bundle.json --rekor $REKOR_SERVER
+
+Exits 0 if a Rekor entry is present, non-zero otherwise.
+"""
+import os
+import sys
+import argparse
+import hashlib
+import requests
+
+def sha256_file(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+def query_rekor(artifact_hash, rekor_server):
+    # Rekor search by artifact hash (sha256)
+    url = rekor_server.rstrip("/") + "/api/v1/index/retrieve"
+    # Rekor API expects signature/publicKey or integrated search; fallback to artifact hash search via public API if available
+    # Use transparency API: /api/v1/log/entries?logIndex=
+    # For simplicity, use the search endpoint
+    try:
+        r = requests.post(rekor_server.rstrip("/") + "/api/v1/log/entries/retrieve", json={"hash": artifact_hash}, timeout=10)
+        if r.status_code == 200:
+            return r.json()
+    except Exception:
+        pass
+    return None
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--artifact", required=True)
+    ap.add_argument("--rekor", default=os.environ.get("REKOR_SERVER"))
+    args = ap.parse_args()
+    if not args.rekor:
+        print("REKOR_SERVER must be provided via --rekor or REKOR_SERVER env var", file=sys.stderr)
+        sys.exit(2)
+    if not os.path.exists(args.artifact):
+        print("Artifact not found", file=sys.stderr)
+        sys.exit(3)
+    h = sha256_file(args.artifact)
+    print("Artifact sha256:", h)
+    res = query_rekor(h, args.rekor)
+    if res:
+        print("Found Rekor entry:", res.keys())
+        sys.exit(0)
+    else:
+        print("No Rekor entry found for artifact", file=sys.stderr)
+        sys.exit(4)
+
+if __name__ == "__main__":
+    main()
+
