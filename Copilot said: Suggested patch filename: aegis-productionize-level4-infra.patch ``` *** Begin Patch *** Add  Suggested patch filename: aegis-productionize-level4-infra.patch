+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to configure cosign to use a KMS-backed key (AWS/GCP/Azure) and set Rekor server env for CI.
+# This script does NOT provision the KMS key; it expects the KMS key ARN/URI to be provided.
+#
+# Usage:
+#   export COSIGN_KMS_URI="kms://arn:aws:kms:us-west-2:123:alias/aegis-cosign"
+#   export REKOR_SERVER="https://rekor.example.com"
+#   ./enable_cosign_kms.sh
+
+: "${COSIGN_KMS_URI:?COSIGN_KMS_URI must be set to your KMS key URI}"
+: "${REKOR_SERVER:?REKOR_SERVER must be set to your Rekor server URL}"
+
+echo "Validating cosign access to KMS key: $COSIGN_KMS_URI"
+if ! command -v cosign >/dev/null 2>&1; then
+  echo "cosign not found in PATH; please install cosign before running this script."
+  exit 1
+fi
+
+# Simple check: attempt to retrieve public key material (cosign auto-handles KMS via signing operations)
+TMPFILE=$(mktemp -u /tmp/cosign_pub.XXXX.json)
+echo "{}" > "$TMPFILE"
+echo "Signing a small test blob with KMS key (this will create a signature that verifies KMS access)"
+if cosign sign-blob --key "$COSIGN_KMS_URI" "$TMPFILE"; then
+  echo "cosign sign-blob succeeded"
+else
+  echo "cosign sign-blob failed; ensure your CI runner or local environment has permission to use the KMS key."
+  rm -f "$TMPFILE"
+  exit 2
+fi
+rm -f "$TMPFILE"
+
+echo "Store these env vars in your CI runner or cluster external secret:"
+echo "  COSIGN_KEY=$COSIGN_KMS_URI"
+echo "  REKOR_SERVER=$REKOR_SERVER"
+echo
+echo "CI note: when using GitHub Actions, set environment secrets and use a self-hosted GPU runner for TRT bakes."
+echo "Done."
