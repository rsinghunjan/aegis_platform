+#!/usr/bin/env python3
+"""
+Simple auto-rollback decider: read analysis JSON and call Argo Rollouts or Argo to rollback if thresholds exceeded.
+This is a minimal example - in production use proper Argo Rollouts API and authentication.
+"""
+import json
+import subprocess
+import sys
+import os
+
+ANALYSIS = sys.argv[1] if len(sys.argv) > 1 else "/work/analysis.json"
+
+def load_analysis(path):
+    with open(path) as fh:
+        return json.load(fh)
+
+def rollback_workflow(workflow_name):
+    print("Rolling back workflow:", workflow_name)
+    # Example: use argo CLI to terminate and resubmit previous successful version, or call rollout undo
+    subprocess.run(["argo", "terminate", workflow_name])
+
+def main():
+    a = load_analysis(ANALYSIS)
+    if a.get("safety_violations", 0) > 0 or a.get("blocked_calls", 0) > a.get("blocked_threshold", 0):
+        wf = a.get("workflow_name", "autonomy-canary")
+        rollback_workflow(wf)
+        print("Rollback requested")
+        sys.exit(2)
+    print("No rollback needed")
+
+if __name__ == "__main__":
+    main()
+
