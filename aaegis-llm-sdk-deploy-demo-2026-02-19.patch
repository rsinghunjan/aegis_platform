+import os
+from typing import Tuple, Dict
+import anthropic
+
+ANTHROPIC_API_KEY = os.environ.get("ANTHROPIC_API_KEY", "")
+ANTHROPIC_API_BASE = os.environ.get("ANTHROPIC_API_BASE", "")  # optional private endpoint
+
+class AnthropicClient:
+    def __init__(self, default_model: str = "claude-2.1"):
+        self.model = default_model
+        self.client = anthropic.Client(api_key=ANTHROPIC_API_KEY)
+
+    async def generate(self, prompt: str, model: str = None, max_tokens: int = 1024) -> Tuple[str, Dict]:
+        m = model or self.model
+        # Using sync client; in prod wrap in threadpool for concurrency.
+        resp = self.client.complete(
+            model=m,
+            prompt=prompt,
+            max_tokens_to_sample=max_tokens,
+            stop_sequences=None,
+        )
+        text = resp.get("completion", "")
+        # Anthropic responses may not include token usage depending on plan
+        usage = {}
+        return text, usage
+
