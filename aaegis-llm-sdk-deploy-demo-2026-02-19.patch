+import os
+from typing import Tuple, Dict
+from google.cloud import aiplatform
+from google.protobuf import json_format
+
+# This client uses Vertex AI prediction; for private endpoint use private service endpoint config:
+# set GOOGLE_APPLICATION_CREDENTIALS and optionally AIP_API_ENDPOINT env var to private endpoint host:port
+GOOGLE_PROJECT = os.environ.get("GOOGLE_PROJECT", "")
+GOOGLE_REGION = os.environ.get("GOOGLE_REGION", "us-central1")
+GOOGLE_API_ENDPOINT = os.environ.get("AIP_API_ENDPOINT", "")  # e.g., "us-central1-aiplatform.googleapis.com"
+
+class GoogleClient:
+    def __init__(self, default_model: str = "gemini-pro"):
+        self.model = default_model
+        if GOOGLE_API_ENDPOINT:
+            self.client = aiplatform.gapic.PredictionServiceClient(client_options={"api_endpoint": GOOGLE_API_ENDPOINT})
+        else:
+            self.client = aiplatform.gapic.PredictionServiceClient()
+
+    async def generate(self, prompt: str, model: str = None, max_tokens: int = 1024) -> Tuple[str, Dict]:
+        # Build request for Vertex AI Predict
+        m = model or self.model
+        # model resource name expected: projects/{project}/locations/{location}/publishers/google/models/{model}
+        model_name = f"projects/{GOOGLE_PROJECT}/locations/{GOOGLE_REGION}/publishers/google/models/{m}"
+        instances = [{"content": prompt}]
+        response = self.client.predict(endpoint=model_name, instances=instances)
+        # Simplified extraction; real responses depend on model and API
+        predictions = list(response.predictions)
+        text = ""
+        if predictions:
+            # attempt to read 'content' or first string
+            pred = predictions[0]
+            if isinstance(pred, dict) and "content" in pred:
+                text = pred["content"]
+            else:
+                text = str(pred)
+        usage = {}
+        return text, usage
+
