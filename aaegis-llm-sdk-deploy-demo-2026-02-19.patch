*** Add File:demo/run_demo.sh
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
+REG=localhost:5000
+ADAPTER_IMAGE=${REG}/aegis/llm-adapter:latest
+VERIFIER_IMAGE=${REG}/aegis/llm-verifier:latest
+
+echo "Building adapter image..."
+docker build -t ${ADAPTER_IMAGE} -f ${ROOT_DIR}/llm/adapter/Dockerfile ${ROOT_DIR}
+echo "Building verifier image..."
+docker build -t ${VERIFIER_IMAGE} -f ${ROOT_DIR}/llm/verifier/Dockerfile ${ROOT_DIR}
+
+echo "Pushing images to local registry ${REG} (ensure registry runs at ${REG})..."
+docker push ${ADAPTER_IMAGE}
+docker push ${VERIFIER_IMAGE}
+
+echo "Applying k8s manifests (namespace ml)..."
+kubectl create namespace ml --dry-run=client -o yaml | kubectl apply -f -
+kubectl -n ml apply -f ${ROOT_DIR}/k8s/llm-adapter-deployment.yaml
+kubectl -n ml apply -f ${ROOT_DIR}/k8s/llm-verifier-deployment.yaml
+
+echo "Waiting for pods to be ready..."
+kubectl -n ml wait --for=condition=available deployment/llm-adapter --timeout=120s || true
+kubectl -n ml wait --for=condition=available deployment/llm-verifier --timeout=120s || true
+
+echo "Port-forwarding adapter to localhost:8000 (background)..."
+kubectl -n ml port-forward svc/llm-adapter 8000:8000 >/tmp/llm_portfw.out 2>&1 &
+PF_PID=$!
+sleep 3
+
+echo "Running pilot evaluation harness (will POST to adapter at http://localhost:8000/v1/generate)..."
+AEGIS_LLM_ADAPTER_URL="http://localhost:8000/v1/generate" python3 ${ROOT_DIR}/llm/pilot/run_eval.py --tasks ${ROOT_DIR}/llm/pilot/tasks.json --out /tmp/aegis_llm_pilot/results.csv
+
+echo "Results saved at /tmp/aegis_llm_pilot/results.csv"
+echo "Cleaning up port-forward (pid=${PF_PID})"
+kill ${PF_PID} || true
+
+echo "Demo complete. To teardown, run:"
+echo "  kubectl -n ml delete -f ${ROOT_DIR}/k8s/llm-adapter-deployment.yaml"
+echo "  kubectl -n ml delete -f ${ROOT_DIR}/k8s/llm-verifier-deployment.yaml"
+
