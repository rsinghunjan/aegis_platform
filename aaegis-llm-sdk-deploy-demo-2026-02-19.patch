+import os
+import openai
+from typing import Tuple, Dict
+
+OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY", "")
+OPENAI_API_BASE = os.environ.get("OPENAI_API_BASE", "")  # optional private endpoint / proxy
+
+if OPENAI_API_KEY:
+    openai.api_key = OPENAI_API_KEY
+if OPENAI_API_BASE:
+    openai.api_base = OPENAI_API_BASE
+
+class OpenAIClient:
+    def __init__(self, default_model: str = "gpt-4o"):
+        self.model = default_model
+
+    async def generate(self, prompt: str, model: str = None, max_tokens: int = 1024) -> Tuple[str, Dict]:
+        m = model or self.model
+        # Note: openai-python currently uses sync IO — use threads or background executor in prod.
+        resp = openai.ChatCompletion.create(model=m, messages=[{"role":"user","content":prompt}], max_tokens=max_tokens)
+        text = resp["choices"][0]["message"]["content"]
+        usage = resp.get("usage", {})
+        return text, usage
