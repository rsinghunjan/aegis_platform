+"""
+FastAPI dependency and middleware to verify A2A envelopes on incoming HTTP requests.
+Integrates with Safety Kernel for pre-check of remote plans.
+"""
+from fastapi import Request, HTTPException
+from a2a.envelope.envelope import verify_envelope_signature
+import httpx
+import json
+
+SAFETY_CHECK_URL = "http://safety.svc.cluster.local:8000/v1/pre_check_plan"
+
+async def verify_and_run_safety(request: Request):
+    try:
+        body = await request.json()
+    except Exception:
+        raise HTTPException(status_code=400, detail="invalid json")
+    if not verify_envelope_signature(body):
+        raise HTTPException(status_code=403, detail="invalid envelope signature")
+    # If envelope is a plan, run safety pre-check
+    msg_type = body.get("header", {}).get("msg_type", "")
+    if msg_type == "plan":
+        plan = body.get("payload")
+        try:
+            r = httpx.post(SAFETY_CHECK_URL, json={"plan": plan}, timeout=5)
+            if r.status_code != 200:
+                raise HTTPException(status_code=403, detail="safety kernel rejected plan")
+        except Exception:
+            raise HTTPException(status_code=503, detail="safety kernel unavailable")
+    # attach verified envelope to request.state for downstream handlers
+    request.state.envelope = body
+
