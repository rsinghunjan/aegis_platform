+syntax = "proto3";
+package a2a;
+option python_package = "a2a.grpc";
+
+message Envelope {
+  string json = 1; // canonical JSON envelope as string
+}
+
+message Ack {
+  bool ok = 1;
+  string message = 2;
+}
+
+service A2A {
+  rpc SendGoal(Envelope) returns (Ack);
+  rpc SendPlan(Envelope) returns (Ack);
+  rpc SendActionResult(Envelope) returns (Ack);
+  rpc SendEvidence(Envelope) returns (Ack);
