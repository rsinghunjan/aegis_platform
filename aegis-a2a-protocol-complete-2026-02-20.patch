+"""
+Simple gRPC A2A server implementation.
+"""
+import os
+import json
+from concurrent import futures
+import grpc
+from a2a.grpc import a2a_pb2, a2a_pb2_grpc
+from a2a.envelope.envelope import verify_envelope_signature
+
+class A2AServicer(a2a_pb2_grpc.A2AServicer):
+    def _handle_envelope(self, envelope_json):
+        env = json.loads(envelope_json)
+        ok = verify_envelope_signature(env)
+        if not ok:
+            return False, "invalid-signature"
+        # route to safety kernel or agent runtime as needed. For now, persist to MCP or log.
+        # TODO: integrate with SafetyKernel and Agent Runtime endpoints.
+        print("Received envelope:", env.get("header",{}).get("msg_type"))
+        return True, "accepted"
+
+    def SendGoal(self, request, context):
+        ok, msg = self._handle_envelope(request.json)
+        return a2a_pb2.Ack(ok=ok, message=msg)
+
+    def SendPlan(self, request, context):
+        ok, msg = self._handle_envelope(request.json)
+        return a2a_pb2.Ack(ok=ok, message=msg)
+
+    def SendActionResult(self, request, context):
+        ok, msg = self._handle_envelope(request.json)
+        return a2a_pb2.Ack(ok=ok, message=msg)
+
+    def SendEvidence(self, request, context):
+        ok, msg = self._handle_envelope(request.json)
+        return a2a_pb2.Ack(ok=ok, message=msg)
+
+def serve():
+    server = grpc.server(futures.ThreadPoolExecutor(max_workers=10))
+    a2a_pb2_grpc.add_A2AServicer_to_server(A2AServicer(), server)
+    port = os.environ.get("A2A_GRPC_PORT", "50052")
+    server.add_insecure_port(f"[::]:{port}")
+    server.start()
+    print("A2A gRPC server started on", port)
+    server.wait_for_termination()
+
+if __name__ == "__main__":
+    serve()
+
