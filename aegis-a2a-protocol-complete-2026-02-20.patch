+#!/usr/bin/env bash
+#
+# Request an agent certificate from Vault PKI role and persist to file system for mutual-TLS.
+# Requires Vault PKI configured and role named 'aegis-agent'.
+#
+VAULT_ADDR=${VAULT_ADDR:-https://vault.vault.svc.cluster.local:8200}
+ROLE=${1:-aegis-agent}
+CN=${2:-agent-`hostname -s`}
+OUT_DIR=${3:-/tmp/a2a-certs}
+mkdir -p "${OUT_DIR}"
+
+echo "Requesting certificate for CN=${CN} from Vault role ${ROLE}"
+curl -sSk --request POST --data "{\"common_name\":\"${CN}\"}" ${VAULT_ADDR}/v1/pki/issue/${ROLE} | jq -r '.data.certificate' > ${OUT_DIR}/cert.pem
+curl -sSk --request POST --data "{\"common_name\":\"${CN}\"}" ${VAULT_ADDR}/v1/pki/issue/${ROLE} | jq -r '.data.private_key' > ${OUT_DIR}/key.pem
+echo "Saved cert/key to ${OUT_DIR}"
+echo "In Kubernetes, mount these as secrets and configure your gRPC servers/clients to use them for mTLS."
+
