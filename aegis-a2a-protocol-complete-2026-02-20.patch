+"""
+Handshake flow:
+ - Generate capability manifest
+ - Sign manifest
+ - Send to peer's /v1/handshake endpoint (HTTP)
+ - Peer verifies signature and registers manifest in agent registry
+"""
+import os
+import json
+import requests
+from a2a.envelope.envelope import make_envelope, sign_envelope
+
+REGISTRY_URL = os.environ.get("A2A_REGISTRY_URL", "http://a2a-registry.ml.svc.cluster.local:8605/v1/register")
+AGENT_ID = os.environ.get("AGENT_ID", "agent-unknown")
+
+def build_manifest(agent_id: str, actions: list, meta: dict):
+    return {"agent_id": agent_id, "actions": actions, "meta": meta}
+
+def send_handshake(peer_endpoint: str, manifest: dict) -> bool:
+    env = make_envelope("manifest", manifest, AGENT_ID)
+    signed = sign_envelope(env)
+    if not signed:
+        raise RuntimeError("Signing failed")
+    # POST to peer /v1/handshake
+    r = requests.post(f"{peer_endpoint}/v1/handshake", json=signed, timeout=10)
+    r.raise_for_status()
+    return True
+
+def register_locally(manifest: dict, signature: dict):
+    payload = {"agent_id": manifest.get("agent_id"), "manifest": manifest, "signature": signature}
+    requests.post(REGISTRY_URL, json=payload, timeout=5)
+
