+"""
+Agent Registry Service (A2A Agent Registry)
+- Stores agent capability manifests and provides discovery / lookup
+"""
+import os
+import json
+import time
+from flask import Flask, request, jsonify
+
+DB_FILE = os.environ.get("A2A_REGISTRY_DB", "/data/a2a_registry.json")
+os.makedirs(os.path.dirname(DB_FILE), exist_ok=True)
+if not os.path.exists(DB_FILE):
+    with open(DB_FILE, "w") as f:
+        json.dump({"manifests": {}}, f)
+
+app = Flask("a2a-registry")
+
+def load_db():
+    with open(DB_FILE) as f:
+        return json.load(f)
+
+def save_db(d):
+    with open(DB_FILE, "w") as f:
+        json.dump(d, f, indent=2)
+
+@app.route("/v1/register", methods=["POST"])
+def register():
+    body = request.json
+    agent_id = body.get("agent_id")
+    manifest = body.get("manifest")
+    signature = body.get("signature")
+    if not agent_id or not manifest or not signature:
+        return jsonify({"error":"agent_id, manifest and signature required"}), 400
+    db = load_db()
+    db["manifests"][agent_id] = {
+        "manifest": manifest,
+        "signature": signature,
+        "updated_at": int(time.time())
+    }
+    save_db(db)
+    return jsonify({"ok": True, "agent_id": agent_id})
+
+@app.route("/v1/manifest/<agent_id>", methods=["GET"])
+def get_manifest(agent_id):
+    db = load_db()
+    m = db["manifests"].get(agent_id)
+    if not m:
+        return jsonify({"error":"not found"}), 404
+    return jsonify(m)
+
+@app.route("/v1/list", methods=["GET"])
+def list_manifests():
+    db = load_db()
+    return jsonify(list(db["manifests"].keys()))
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8605")))
+
