+    produce(topic, {"header":{"msg_type":"plan","sender":AGENT_ID,"timestamp":int(time.time()),"ttl":300},"payload":plan,"signature":{}})
+    print("Published plan to Kafka topic:", topic)
+
+if __name__ == "__main__":
