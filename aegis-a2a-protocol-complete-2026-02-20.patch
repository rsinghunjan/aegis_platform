+"""
+A2A Signed Message Envelope Library
+- Create signed envelopes (via Vault transit) and verify envelopes (via Rekor / signature check)
+"""
+import os
+import json
+import time
+import httpx
+from typing import Dict, Any, Optional
+
+VAULT_SIGN_URL = os.environ.get("VAULT_SIGN_URL", "http://vault.vault.svc.cluster.local:8200/v1/transit/sign/aegis-transit")
+REKOR_SEARCH_URL = os.environ.get("REKOR_SEARCH_URL", "https://rekor.staging.internal/api/v1/log/entries/retrieve")
+
+def make_envelope(msg_type: str, payload: Dict[str, Any], sender: str, ttl_seconds: int = 300) -> Dict[str, Any]:
+    envelope = {
+        "header": {
+            "msg_type": msg_type,
+            "sender": sender,
+            "timestamp": int(time.time()),
+            "ttl": ttl_seconds
+        },
+        "payload": payload
+    }
+    return envelope
+
+def sign_envelope(envelope: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    """
+    Request Vault transit signing on the canonical JSON bytes.
+    Returns envelope with signature field if successful.
+    """
+    try:
+        canon = json.dumps(envelope, sort_keys=True, separators=(",", ":"))
+        r = httpx.post(VAULT_SIGN_URL, json={"input": canon}, timeout=5)
+        r.raise_for_status()
+        sig = r.json()
+        envelope["signature"] = sig
+        return envelope
+    except Exception as e:
+        # best-effort: return None to indicate signing failed
+        return None
+
+def verify_envelope_signature(envelope: Dict[str, Any]) -> bool:
+    """
+    Basic verification: ensure signature field exists. For stronger guarantees,
+    fetch Rekor entries or use Vault verify endpoint / public key to validate.
+    """
+    sig = envelope.get("signature")
+    if not sig:
+        return False
+    # NOTE: production should verify signature cryptographically using Vault public key
+    return True
+
