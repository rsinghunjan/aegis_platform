+"""
+Lightweight middleware that enforces the envelope schema and persists the manifest to registry if handshake route used.
+"""
+from jsonschema import validate, ValidationError
+from fastapi import Request, HTTPException
+from a2a.envelope.envelope import verify_envelope_signature
+from a2a.json_schemas import envelope as envelope_schema
+import json
+
+def enforce_envelope(request: Request):
+    try:
+        body = request.json()
+    except Exception:
+        raise HTTPException(status_code=400, detail="invalid json")
+    try:
+        validate(instance=body, schema=envelope_schema)
+    except ValidationError as e:
+        raise HTTPException(status_code=400, detail=f"envelope schema invalid: {e}")
+    if not verify_envelope_signature(body):
+        raise HTTPException(status_code=403, detail="signature verification failed")
+    request.state.envelope = body
+
