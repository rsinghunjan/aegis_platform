+"""
+gRPC client for A2A interactions.
+"""
+import os
+import json
+import grpc
+from a2a.grpc import a2a_pb2, a2a_pb2_grpc
+from a2a.envelope.envelope import sign_envelope, make_envelope
+
+def send_envelope_grpc(peer_host: str, peer_port: int, msg_type: str, payload: dict, sender: str):
+    env = make_envelope(msg_type, payload, sender)
+    signed = sign_envelope(env)
+    if not signed:
+        raise RuntimeError("Sign failed")
+    channel = grpc.insecure_channel(f"{peer_host}:{peer_port}")
+    stub = a2a_pb2_grpc.A2AStub(channel)
+    req = a2a_pb2.Envelope(json=json.dumps(signed))
+    if msg_type == "goal":
+        return stub.SendGoal(req)
+    elif msg_type == "plan":
+        return stub.SendPlan(req)
+    elif msg_type == "action_result":
+        return stub.SendActionResult(req)
+    elif msg_type == "evidence":
+        return stub.SendEvidence(req)
+    else:
+        raise RuntimeError("unknown msg_type")
+
