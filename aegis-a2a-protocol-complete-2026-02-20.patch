+"""
+Kafka transport helpers for A2A messages.
+Wraps produce & consumer convenience functions and topic naming conventions.
+"""
+import os
+import json
+from typing import Callable
+from kafka import KafkaProducer, KafkaConsumer
+
+BOOTSTRAP = os.environ.get("KAFKA_BOOTSTRAP", "kafka:9092")
+
+def topic_for(agent_from: str, agent_to: str, msg_type: str) -> str:
+    # topic naming: aegis.a2a.<from>.<to>.<type>
+    return f"aegis.a2a.{agent_from}.{agent_to}.{msg_type}"
+
+def produce(topic: str, envelope: dict):
+    p = KafkaProducer(bootstrap_servers=[BOOTSTRAP], value_serializer=lambda v: json.dumps(v).encode())
+    p.send(topic, envelope)
+    p.flush()
+
+def consume(topic: str, group_id: str, handler: Callable[[dict], None]):
+    c = KafkaConsumer(topic, group_id=group_id, bootstrap_servers=[BOOTSTRAP], value_deserializer=lambda m: json.loads(m.decode()))
+    for msg in c:
+        handler(msg.value)
+
