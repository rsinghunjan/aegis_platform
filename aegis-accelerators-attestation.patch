+#!/usr/bin/env python3
+"""
+Collect hardware driver and device IDs for attestation and chain-of-custody.
+Produces JSON with GPU/CPU/PCI/OS info suitable for inclusion in attestation bundles.
+"""
+import json, subprocess, os, sys, platform, time
+
+def run(cmd):
+    try:
+        out = subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL, universal_newlines=True)
+        return out.strip()
+    except Exception:
+        return ""
+
+def collect_nvidia():
+    info = {}
+    if run("which nvidia-smi"):
+        # ask for GPU name, driver, pci bus id
+        try:
+            out = subprocess.check_output(["nvidia-smi", "--query-gpu=name,driver_version,pci.bus_id,gpu_serial", "--format=csv,noheader"], universal_newlines=True)
+            gpus = []
+            for line in out.strip().splitlines():
+                parts = [p.strip() for p in line.split(",")]
+                gpus.append({"name": parts[0], "driver_version": parts[1], "pci_bus_id": parts[2], "serial": parts[3] if len(parts)>3 else ""})
+            info["nvidia_gpus"] = gpus
+        except Exception:
+            info["nvidia_gpus_raw"] = run("nvidia-smi -q")
+    return info
+
+def collect_lscpu():
+    return run("lscpu")
+
+def collect_lspci():
+    return run("lspci -mm")
+
+def collect_os():
+    return {"platform": platform.system(), "platform_release": platform.release(), "platform_version": platform.version(), "machine": platform.machine()}
+
+def gather_all():
+    att = {"collected_at": int(time.time())}
+    att["os"] = collect_os()
+    att["lscpu"] = collect_lscpu()
+    att["lspci"] = collect_lspci()
+    att.update(collect_nvidia())
+    # Add cloud metadata if available
+    att["cloud_instance_id"] = run("curl -s --connect-timeout 1 http://169.254.169.254/latest/meta-data/instance-id || true")
+    return att
+
+if __name__ == "__main__":
+    out = gather_all()
+    if len(sys.argv) > 1:
+        with open(sys.argv[1], "w") as f:
+            json.dump(out, f, indent=2)
+    else:
+        print(json.dumps(out, indent=2))
+
