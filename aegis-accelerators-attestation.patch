+#!/usr/bin/env python3
+"""
+Enhanced attestation orchestrator that includes hardware inventory (driver versions, device ids)
+in the attestation bundle. Signs bundle with cosign and uploads to evidence (WORM) bucket.
+"""
+import os, subprocess, tempfile, json
+from datetime import datetime
+from ops.attestation.hardware_inventory import gather_all
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def bundle_artifacts(paths, out_prefix="attestation"):
+    tmp = tempfile.mkdtemp()
+    bundle = os.path.join(tmp, f"{out_prefix}-{int(__import__('time').time())}.tar.gz")
+    subprocess.check_call(["tar","-czf",bundle] + paths)
+    return bundle
+
+def sign_bundle(bundle):
+    if not COSIGN_KEY_REF:
+        print("No COSIGN_KEY_REF set; skipping signing")
+        return None
+    subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, bundle])
+    return bundle + ".sig"
+
+def upload_bundle(bundle, key_prefix="attestations"):
+    if not EVIDENCE_BUCKET:
+        print("No EVIDENCE_BUCKET set; skipping upload")
+        return None
+    key = f"{key_prefix}/{os.path.basename(bundle)}"
+    subprocess.check_call(["aws","s3","cp", bundle, f"{EVIDENCE_BUCKET}/{key}"])
+    return f"{EVIDENCE_BUCKET}/{key}"
+
+def main():
+    tmpdir = tempfile.mkdtemp()
+    # Collect existing artifacts if any
+    artifacts = []
+    for p in ["./build.log","./watermark_validation.csv","./moderation_eval.json"]:
+        if os.path.exists(p):
+            artifacts.append(p)
+    # Collect hardware inventory
+    hw = gather_all()
+    hw_path = os.path.join(tmpdir, "hardware_inventory.json")
+    with open(hw_path, "w") as fh:
+        json.dump(hw, fh, indent=2)
+    artifacts.append(hw_path)
+    # Bundle
+    bundle = bundle_artifacts(artifacts, out_prefix="aegis-attestation")
+    print("Created bundle:", bundle)
+    # Sign
+    sig = sign_bundle(bundle)
+    print("Signature created:", sig)
+    # Upload
+    uri = upload_bundle(bundle)
+    print("Uploaded attestation bundle to:", uri)
+    # Write attestation metadata
+    att = {"bundle_uri": uri, "signed": bool(sig), "collected_at": datetime.utcnow().isoformat(), "hardware_summary": {"gpus": hw.get("nvidia_gpus", [])}}
+    att_path = os.path.join(tmpdir, "attestation.json")
+    with open(att_path, "w") as f:
+        json.dump(att, f, indent=2)
+    if COSIGN_KEY_REF:
+        try:
+            subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, att_path])
+        except Exception as e:
+            print("Failed to sign attestation json:", e)
+    if EVIDENCE_BUCKET:
+        subprocess.check_call(["aws","s3","cp", att_path, f"{EVIDENCE_BUCKET}/attestations/{os.path.basename(att_path)}"])
+    print("Attestation complete.")
+
+if __name__ == "__main__":
+    main()
+
