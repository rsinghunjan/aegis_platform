+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Deploy the admission webhook with TLS and a cosign public-key secret.
+# This script:
+#  - generates a self-signed CA + server cert (or reuses existing)
+#  - creates kubernetes secrets: webhook-tls and aegis-cosign-pubkey
+#  - applies the webhook deployment and ValidatingWebhookConfiguration templates (manifests must exist in deploy/webhook/)
+#
+# Usage:
+#   ./ops/webhook/deploy_with_cosign.sh --kubeconfig /path/kubeconfig --pubkey /path/pubkey.pem --ca /path/ca.crt
+
+KUBECONFIG=${KUBECONFIG:-}
+COSIGN_PUBKEY_PATH=""
+CA_BUNDLE_PATH=""
+
+show_help() {
+  cat <<EOF
+Usage: $0 --pubkey /path/to/pubkey.pem [--kubeconfig /path/to/kubeconfig] [--ca /path/to/ca.crt]
+
+If --ca is omitted this script will call ops/webhook/generate_selfsigned_cert.sh to create certs in /tmp/webhook-certs.
+EOF
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --kubeconfig) KUBECONFIG="$2"; shift 2;;
+    --pubkey) COSIGN_PUBKEY_PATH="$2"; shift 2;;
+    --ca) CA_BUNDLE_PATH="$2"; shift 2;;
+    --help) show_help; exit 0;;
+    *) echo "Unknown arg: $1"; show_help; exit 2;;
+  esac
+done
+
+if [ -z "$COSIGN_PUBKEY_PATH" ]; then echo "Missing --pubkey"; show_help; exit 2; fi
+
+if [ -z "$CA_BUNDLE_PATH" ]; then
+  echo "No CA provided — generating self-signed certs into /tmp/webhook-certs"
+  bash ops/webhook/generate_selfsigned_cert.sh /tmp/webhook-certs
+  CA_BUNDLE_PATH=/tmp/webhook-certs/ca.crt
+  SERVER_CRT=/tmp/webhook-certs/server.crt
+  SERVER_KEY=/tmp/webhook-certs/server.key
+else
+  # Expect server key/crt to live next to CA with fixed names (caller responsibility)
+  SERVER_CRT="${CA_BUNDLE_PATH%/*}/server.crt"
+  SERVER_KEY="${CA_BUNDLE_PATH%/*}/server.key"
+fi
+
+if [ ! -f "$SERVER_CRT" ] || [ ! -f "$SERVER_KEY" ]; then
+  echo "Missing server.crt or server.key next to CA. Exiting."
+  exit 2
+fi
+
+KUBE_ARGS=()
+if [ -n "$KUBECONFIG" ]; then KUBE_ARGS=(--kubeconfig "$KUBECONFIG"); fi
+
+echo "Creating TLS secret (webhook-tls) in namespace ml-serving..."
+kubectl "${KUBE_ARGS[@]}" create namespace ml-serving --dry-run=client -o yaml | kubectl "${KUBE_ARGS[@]}" apply -f -
+kubectl "${KUBE_ARGS[@]}" delete secret webhook-tls -n ml-serving --ignore-not-found
+kubectl "${KUBE_ARGS[@]}" create secret tls webhook-tls -n ml-serving --cert="$SERVER_CRT" --key="$SERVER_KEY"
+
+echo "Creating cosign public key secret (aegis-cosign-pubkey)..."
+kubectl "${KUBE_ARGS[@]}" delete secret aegis-cosign-pubkey -n ml-serving --ignore-not-found
+kubectl "${KUBE_ARGS[@]}" create secret generic aegis-cosign-pubkey -n ml-serving --from-file=pubkey.pem="$COSIGN_PUBKEY_PATH"
+
+echo "Applying webhook manifests (deploy/webhook/*)..."
+kubectl "${KUBE_ARGS[@]}" apply -f deploy/webhook/deployment-cosign.yaml
+
+echo "You must update deploy/webhook/validatingwebhook-config.yaml by replacing <REPLACE_WITH_BASE64_CA_BUNDLE>"
+echo "with base64 of $CA_BUNDLE_PATH, then apply it:"
+echo "  base64 -w0 $CA_BUNDLE_PATH"
+echo "  sed -e 's,<REPLACE_WITH_BASE64_CA_BUNDLE>,'\"$(base64 -w0 $CA_BUNDLE_PATH)"'/' -i deploy/webhook/validatingwebhook-config.yaml"
+echo "  kubectl ${KUBE_ARGS[*]} apply -f deploy/webhook/validatingwebhook-config.yaml"
+
+echo "Webhook deploy helper complete. Validate with ops/cluster/runtime_validator_enhanced.py"
+
