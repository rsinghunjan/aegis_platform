+#!/usr/bin/env python3
+"""
+Generate a Kubernetes ConfigMap YAML for moderation thresholds produced by calibration.
+Usage:
+  python services/serving/diffusers/moderation/create_thresholds_configmap.py --thresholds thresholds.json --out cm.yaml
+"""
+import argparse, json, yaml
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--thresholds", required=True)
+    p.add_argument("--out", required=True)
+    args = p.parse_args()
+    with open(args.thresholds) as f:
+        th = json.load(f)
+    cm = {
+        "apiVersion": "v1",
+        "kind": "ConfigMap",
+        "metadata": {"name": "aegis-moderation-thresholds", "namespace": "ml-serving"},
+        "data": {k: json.dumps(v) for k, v in th.items()}
+    }
+    with open(args.out, "w") as f:
+        yaml.safe_dump(cm, f)
+    print("Wrote", args.out)
+
+if __name__ == "__main__":
+    main()
+
