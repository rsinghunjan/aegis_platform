+#!/usr/bin/env python3
+"""
+Annotate a pod with suggested low-carbon node(s) based on carbon lookup.
+ - Usage: python ops/monitoring/annotate_pod_with_low_carbon_node.py --pod <pod> --namespace <ns>
+ - This is a helper for schedulers/preflight; it does not enforce placement.
+"""
+import argparse, json
+from kubernetes import client, config
+from ops.monitoring.carbon_node_scheduler import pick_low_carbon_node
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--pod", required=True)
+    p.add_argument("--namespace", default="default")
+    p.add_argument("--count", type=int, default=3)
+    args = p.parse_args()
+    config.load_kube_config()
+    v1 = client.CoreV1Api()
+    candidates = pick_low_carbon_node()
+    top = candidates[: args.count]
+    ann = {"aegis/low-carbon-nodes": json.dumps([n["name"] for n in top])}
+    body = {"metadata": {"annotations": ann}}
+    v1.patch_namespaced_pod(args.pod, args.namespace, body)
+    print("Annotated pod", args.pod, "with top nodes:", [n["name"] for n in top])
+
+if __name__ == "__main__":
+    main()
+
