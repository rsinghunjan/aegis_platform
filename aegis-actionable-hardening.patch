+#!/usr/bin/env python3
+"""
+Self-heal controller that creates a rollback PR for operator approval (GitOps flow).
+ - On detection of a persistent alert it will create a rollback branch/PR using ops/self_heal/gitops_rollback.py
+ - This avoids automated immediate destructive actions; an operator approves the PR to apply rollback.
+"""
+import time
+from ops.self_heal.gitops_rollback import create_rollback_pr
+
+ALERTS = {
+    "CostRunawaySuspected": {"expr": "sum(rate(nvidia_gpu_utilization[5m])) by (cluster) > 0.9 and sum(redis_list_length{list='diffusers:queue'}) > 50", "target_deployment": "aegis-diffusers"},
+}
+
+def handle_alert(name, info):
+    print("Handling alert", name)
+    # Decide previous tag (in practice, query image registry or Git history)
+    prev_tag = info.get("prev_tag", "stable")
+    repo = info.get("gitops_repo", "")
+    path = info.get("manifest_path", "")
+    if not repo or not path:
+        print("Missing gitops repo or path in alert info; cannot create rollback PR")
+        return
+    create_rollback_pr(repo, path, info["target_deployment"], prev_tag)
+    print("Rollback PR created - operator approval required")
+
+def main_loop():
+    while True:
+        # Hook into Prometheus alerts or evaluate conditions here (PoC)
+        # For PoC, we sleep
+        time.sleep(30)
+
+if __name__ == "__main__":
+    print("Self-heal GitOps controller (PoC) - run from orchestration/alerting system")
+    main_loop()
+
