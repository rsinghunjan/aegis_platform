+AUDITOR_EMAIL=${1:-}
+
+TMP=$(mktemp -d)
+PACKAGE=/tmp/mpc_audit_package.tar.gz
+bash ops/audit/prepare_mpc_audit_package.sh "$TMP"
+if [ -f "$TMP"*_mpc_audit_package.tar.gz ]; then
+  PACKAGE=$(ls $TMP*_mpc_audit_package.tar.gz | head -n1)
+fi
+
+S3URL=""
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  aws s3 cp "$PACKAGE" "s3://${EVIDENCE_BUCKET%/}/audit/mpc/$(basename $PACKAGE)"
+  S3URL="s3://${EVIDENCE_BUCKET%/}/audit/mpc/$(basename $PACKAGE)"
+fi
+
+ISSUE_TITLE="Request: MPC cryptography audit — Aegis platform"
+ISSUE_BODY="Hello audit team,\n\nPlease find the MPC audit package prepared for review.\n\nS3 location: ${S3URL}\n\nDeliverables requested:\n1) Crypto correctness and malicious-share resistance\n2) Threshold & dropout resilience review\n3) Report with severity‑ranked findings and remediation suggestions\n\nContact: ${AUDITOR_EMAIL:-security-audit@auditor.example}\n\nThanks."
+
