+#!/usr/bin/env python3
+"""
+Generate remediation backlog GitHub issues from Level‑4 verification report.
+
+Usage:
+  python3 ops/verify/generate_remediation_backlog.py /tmp/level4_verification_report.json
+
+This script reads the JSON report and opens issues (using `gh`) for each failure.
+Requires gh CLI authenticated in environment.
+"""
+import sys, json, subprocess
+from pathlib import Path
+
+def create_issue(title, body, labels=None):
+    cmd = ["gh","issue","create","--title", title, "--body", body]
+    if labels:
+        for l in labels:
+            cmd += ["--label", l]
+    try:
+        subprocess.check_call(cmd)
+    except subprocess.CalledProcessError as e:
+        print("Failed to create issue:", e)
+
+def main(report_path):
+    p = Path(report_path)
+    if not p.exists():
+        print("Report not found:", report_path); sys.exit(2)
+    j = json.load(open(p))
+    report = j.get("summary") or j.get("details") or j
+    # Heuristic: look for common failure keys
+    issues = []
+    # Rekor_missing
+    rekor_missing = j.get("details",{}).get("reparsed_report",{}).get("rekor_missing", [])
+    if rekor_missing:
+        create_issue("Remediation: Missing Rekor entries for evidence manifests", f"Found {len(rekor_missing)} manifests missing Rekor entries. Sample:\n{rekor_missing[:5]}\n\nRun ops/evidence/register_and_verify_rekor.sh or fix signer workflow.", labels=["audit","evidence"])
+    # DP control loop
+    dp = j.get("details",{}).get("reparsed_report",{}).get("dp_control_loop",{})
+    if not dp.get("dp_check") or not dp.get("dp_report"):
+        create_issue("Remediation: DP control loop not fully integrated", "DP check/report not observed in FL controller logs. Inject DP wrapper or ensure orchestrator calls check_and_start_round/report_round.", labels=["privacy","fl"])
+    # MPC audit presence
+    if not j.get("details",{}).get("reparsed_report",{}).get("mpc_audit_present"):
+        create_issue("Remediation: MPC audit package not present", "No MPC audit package detected in evidence bucket. Run ops/audit/prepare_mpc_audit_package.sh and deliver to auditors.", labels=["crypto","audit"])
+    # KMS alias
+    if not j.get("details",{}).get("reparsed_report",{}).get("kms_alias_present"):
+        create_issue("Remediation: KMS alias for cosign not present", "KMS alias alias/aegis/cosign not found in account. Verify KMS keys and alias creation.", labels=["security","kms"])
+    print("Remediation backlog generation complete.")
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("Usage: generate_remediation_backlog.py <report.json>"); sys.exit(2)
+    main(sys.argv[1])
+
