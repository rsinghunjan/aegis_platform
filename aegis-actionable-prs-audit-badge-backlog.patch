+#!/usr/bin/env bash
+#
+# Create or update a Level‑4 badge file in the repo and push the change.
+# Usage:
+#  ./ops/verify/write_badge_and_commit.sh PASS "All checks passed" 
+#
+set -euo pipefail
+RESULT=${1:-FAIL}
+MESSAGE=${2:-"No message"}
+FILE="docs/level4_badge.md"
+# badge content
+cat > "$FILE" <<MD
+# Aegis Level‑4 Verification Badge
+
+Status: **${RESULT}**
+
+Message: ${MESSAGE}
+
+Last updated: $(date -u -Iseconds)
+MD
+
+git config user.name "aegis-bot"
+git config user.email "aegis-bot@local"
+git add "$FILE"
+git commit -m "ci: update Level‑4 badge — ${RESULT}" || echo "No changes to commit"
+git push origin HEAD:main
+echo "Badge updated and pushed (main)."
