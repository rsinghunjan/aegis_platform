+#!/usr/bin/env python3
+"""
+Patch Helm chart manifests (or rendered manifests) to inject Vault CSI + mTLS and open PRs for each chart.
+
+Usage:
+  python3 ops/helm/create_vault_csi_prs.py --charts charts/helm-app1 charts/helm-app2 --branch-prefix inject-vault-csi
+
+Behavior:
+ - For each chart dir provided, create a temporary branch, patch YAML files to add Vault CSI volumes,
+   mtls secret volumes and mounts, add mtls annotation hints, commit, push and open a PR using `gh`.
+ - Operator MUST review the generated PRs before merging.
+
+Requires:
+ - git configured and authenticated (GITHUB_TOKEN or gh auth)
+ - gh (GitHub CLI) installed and authenticated
+"""
+import argparse
+import os
+import subprocess
+import tempfile
+from pathlib import Path
+import yaml
+
+def patch_file(path):
+    changed = False
+    docs = list(yaml.safe_load_all(Path(path).read_text()))
+    for d in docs:
+        if not isinstance(d, dict): continue
+        kind = d.get("kind","")
+        if kind in ("Deployment","StatefulSet","DaemonSet"):
+            spec = d.setdefault("spec",{})
+            tpl = spec.setdefault("template",{})
+            pod = tpl.setdefault("spec",{})
+            vols = pod.setdefault("volumes", [])
+            vols_append = [
+                {"name":"vault-csi","csi":{"driver":"secrets-store.csi.k8s.io","readOnly":True,"volumeAttributes":{"secretProviderClass":"vault-aegis"}}},
+                {"name":"mtls-secret","secret":{"secretName":"crypten-mtls"}}
+            ]
+            for v in vols_append:
+                if v not in vols:
+                    vols.append(v); changed=True
+            for c in pod.get("containers",[]):
+                mounts = c.setdefault("volumeMounts",[])
+                vm1 = {"name":"vault-csi","mountPath":"/mnt/secrets"}
+                vm2 = {"name":"mtls-secret","mountPath":"/etc/tls","readOnly":True}
+                if vm1 not in mounts:
+                    mounts.append(vm1); changed=True
+                if vm2 not in mounts:
+                    mounts.append(vm2); changed=True
+            meta = d.setdefault("metadata",{})
+            ann = meta.setdefault("annotations",{})
+            if ann.get("sidecar.istio.io/inject") != "true":
+                ann["sidecar.istio.io/inject"] = "true"; changed=True
+    if changed:
+        Path(path).write_text("\n---\n".join(yaml.safe_dump(d) for d in docs))
+    return changed
+
+def patch_chart(chart_dir):
+    changed_any = False
+    for root,_,files in os.walk(chart_dir):
+        for f in files:
+            if f.endswith((".yaml",".yml")):
+                p = os.path.join(root,f)
+                try:
+                    if patch_file(p):
+                        changed_any = True
+                except Exception as e:
+                    print("Skipping",p,"due to error:",e)
+    return changed_any
+
+def git_cmd(cmd, cwd="."):
+    subprocess.check_call(cmd, cwd=cwd)
+
+def create_pr_for_chart(chart_dir, branch_prefix="inject-vault-csi"):
+    chart_name = Path(chart_dir).name
+    branch = f"{branch_prefix}/{chart_name}"
+    print("Creating branch", branch, "for", chart_dir)
+    git_cmd(["git","checkout","-b",branch])
+    # patch files in place
+    changed = patch_chart(chart_dir)
+    if not changed:
+        print("No changes detected for", chart_dir, "- skipping PR creation")
+        git_cmd(["git","checkout","-"], cwd=".")
+        git_cmd(["git","branch","-D",branch], cwd=".")
+        return None
+    # commit
+    git_cmd(["git","add", chart_dir])
+    git_cmd(["git","commit","-m",f"chore: inject Vault CSI + mTLS mounts into {chart_name} (automated)"])
+    git_cmd(["git","push","--set-upstream","origin",branch])
+    # create PR
+    pr_title = f"chore: inject Vault CSI + mTLS into {chart_name}"
+    pr_body = "Automated patch to add Vault CSI mounts and mTLS secret mounts. Please review carefully before merging."
+    subprocess.check_call(["gh","pr","create","--title",pr_title,"--body",pr_body,"--base","main","--head",branch])
+    return branch
+
+def main(charts, branch_prefix):
+    # ensure clean working tree
+    subprocess.check_call(["git","status","--porcelain"])
+    for c in charts:
+        if not os.path.isdir(c):
+            print("Chart path not found:", c); continue
+        create_pr_for_chart(c, branch_prefix)
+    print("Done.")
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--charts", nargs="+", required=True, help="Paths to chart directories or manifest dirs")
+    p.add_argument("--branch-prefix", default="inject-vault-csi")
+    args = p.parse_args()
+    main(args.charts, args.branch_prefix)
+
