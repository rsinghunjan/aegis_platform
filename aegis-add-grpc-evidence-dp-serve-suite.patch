+#!/usr/bin/env python3
+"""
+Generate python grpc code from .proto files in ops/proto using grpc_tools.protoc.
+This script is safe to call repeatedly; it will silently succeed if stubs already exist.
+"""
+import os
+from pathlib import Path
+def generate(proto_path):
+    try:
+        from grpc_tools import protoc
+    except Exception as e:
+        raise RuntimeError("grpc_tools not installed, install ops/grpc/requirements.txt") from e
+    proto_dir = str(Path("ops/proto").resolve())
+    out_dir = proto_dir
+    args = [
+        "",
+        f"-I{proto_dir}",
+        f"--python_out={out_dir}",
+        f"--grpc_python_out={out_dir}",
+        str(proto_path)
+    ]
+    protoc.main(args)
+
+def main():
+    pdir = Path("ops/proto")
+    for p in pdir.glob("*.proto"):
+        generate(p)
+    print("Generated gRPC stubs for protos in ops/proto")
+
+if __name__=="__main__":
+    main()
+
