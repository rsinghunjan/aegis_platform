+from ops.proto import dp_pb2, dp_pb2_grpc
+
+import requests
+
+DP_URL = os.environ.get("DP_ACCOUNTING_URL", "http://dp-accounting:8310")
+
+class DPServicer(dp_pb2_grpc.DPServicer):
+    def CheckRun(self, request, context):
+        payload = {"project": request.project, "modality": request.modality, "noise": float(request.noise), "sample_rate": float(request.sample_rate), "steps": int(request.steps), "delta": float(request.delta)}
+        try:
+            r = requests.post(f"{DP_URL}/check_run", json=payload, timeout=10)
+            r.raise_for_status()
+            j = r.json()
+            # extract epsilon if present
+            eps = float(j.get("epsilon", j.get("epsilon_total", 0.0)))
+            accepted = j.get("accepted", True) if isinstance(j, dict) else True
+            return dp_pb2.DPCheckResponse(accepted=bool(accepted), message=str(j), epsilon=float(eps))
+        except Exception as e:
+            return dp_pb2.DPCheckResponse(accepted=False, message=str(e), epsilon=0.0)
+
+def serve(port=50052):
+    server = grpc.server(futures.ThreadPoolExecutor(max_workers=10))
+    dp_pb2_grpc.add_DPServicer_to_server(DPServicer(), server)
+    server.add_insecure_port(f"[::]:{port}")
+    print("Starting DP gRPC server on port", port)
+    server.start()
+    try:
+        while True:
+            time.sleep(3600)
+    except KeyboardInterrupt:
+        server.stop(0)
+
+if __name__=="__main__":
+    serve()
+
