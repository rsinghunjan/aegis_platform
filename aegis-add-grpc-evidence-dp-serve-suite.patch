+#!/usr/bin/env python3
+"""
+gRPC Evidence server: accepts evidence manifests via RPC and delegates to local record_manifest + uploader.
+Generates Python stubs at startup if not present.
+"""
+import os
+import time
+from concurrent import futures
+import grpc
+
+PROTO_PKG = "ops.proto"
+
+def ensure_stubs():
+    # generate stubs if missing
+    from pathlib import Path
+    p = Path("ops/proto/evidence_pb2.py")
+    if not p.exists():
+        print("Generating grpc python stubs for protos...")
+        import ops.grpc._generate_stubs as gen
+        gen.main()
+
+ensure_stubs()
+
+from ops.proto import evidence_pb2, evidence_pb2_grpc  # generated
+
+try:
+    from ops.autonomy.safety_monitor import record_manifest
+except Exception:
+    def record_manifest(action, details):
+        import json, tempfile
+        p = f"/tmp/safety_manifest_{action}_{int(time.time())}.json"
+        open(p,"w").write(json.dumps(details))
+        return p
+
+class EvidenceServicer(evidence_pb2_grpc.EvidenceServicer):
+    def RegisterEvidence(self, request, context):
+        try:
+            manifest_json = request.manifest_json
+            # Try to parse manifest; still pass through as string if parse fails
+            import json
+            try:
+                details = json.loads(manifest_json)
+            except Exception:
+                details = {"raw": manifest_json}
+            mpath = record_manifest(request.action, details)
+            # If record_manifest returned queued path, reflect that
+            return evidence_pb2.EvidenceResponse(ok=True, message="recorded", rekor_uuid=str(mpath))
+        except Exception as e:
+            return evidence_pb2.EvidenceResponse(ok=False, message=str(e), rekor_uuid="")
+
+def serve(port=50051):
+    server = grpc.server(futures.ThreadPoolExecutor(max_workers=10))
+    evidence_pb2_grpc.add_EvidenceServicer_to_server(EvidenceServicer(), server)
+    server.add_insecure_port(f"[::]:{port}")
+    print("Starting Evidence gRPC server on port", port)
+    server.start()
+    try:
+        while True:
+            time.sleep(3600)
+    except KeyboardInterrupt:
+        server.stop(0)
+
+if __name__=="__main__":
+    serve()
+
