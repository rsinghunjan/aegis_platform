"""
LangGraph - simple graph planner & agent adapter using RedisGraph.

APIs:
 - POST /graph/node  {id, labels, props}
 - POST /graph/edge  {src, dst, relation}
 - POST /plan        {query: natural_language_query} -> returns plan steps (simple)
"""
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import os, logging, json, httpx
import redis

logger = logging.getLogger("langgraph")
logging.basicConfig(level=logging.INFO)

REDIS_HOST = os.environ.get("REDIS_HOST", "redis")
REDIS_PORT = int(os.environ.get("REDIS_PORT", "6379"))
REDIS_GRAPH_KEY = os.environ.get("REDIS_GRAPH_KEY", "AegisGraph")

r = redis.Redis(host=REDIS_HOST, port=REDIS_PORT, decode_responses=True)
try:
    from redisgraph import Node, Edge, Graph
    graph = Graph(REDIS_GRAPH_KEY, r)
except Exception:
    graph = None

app = FastAPI(title="LangGraph")

class NodeIn(BaseModel):
    id: str
    labels: list[str] = []
    props: dict = {}

class EdgeIn(BaseModel):
    src: str
    dst: str
    relation: str

class PlanIn(BaseModel):
    query: str

@app.post("/graph/node")
def add_node(n: NodeIn):
    if graph is None:
        raise HTTPException(status_code=500, detail="redisgraph not available")
    node = Node(label=",".join(n.labels), properties=n.props)
    graph.add_node(node)
    graph.commit()
    return {"status":"ok"}

@app.post("/graph/edge")
def add_edge(e: EdgeIn):
    if graph is None:
        raise HTTPException(status_code=500, detail="redisgraph not available")
    # naive lookup & create nodes if missing omitted for brevity
    # In production, ensure node identities and properties are stored and referenced
    return {"status":"ok", "note":"edge persistence requires node management; implement as needed"}

@app.post("/plan")
def plan_query(p: PlanIn):
    # Simple planner: echo steps based on keywords (demo)
    q = p.query.lower()
    steps = []
    if "summarize" in q:
        steps.append({"action":"retrieve_context", "desc":"Get relevant docs from retriever"})
        steps.append({"action":"call_llm", "desc":"Summarize retrieved docs"})
    elif "relation" in q or "graph" in q:
        steps.append({"action":"graph_query", "desc":"Query graph for relations"})
        steps.append({"action":"call_llm", "desc":"Explain relations"})
    else:
        steps.append({"action":"retrieve_context", "desc":"Default retrieve and answer"})
        steps.append({"action":"call_llm", "desc":"Produce final answer"})
    return {"plan": steps}
