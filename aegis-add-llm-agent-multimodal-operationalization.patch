+#!/usr/bin/env python3
+"""
+Latency and Safety Monitor (Prometheus exporter)
+ - Exposes p99 latency and safety signals for LLM/diffusion/agent inference endpoints.
+ - Also emits E-STOP and HIL integration health metrics.
+
+Usage:
+  python3 latency_safety_monitors.py --listen 0.0.0.0:9101 --probe-endpoint http://localhost:8000/health
+"""
+import argparse
+from prometheus_client import start_http_server, Gauge
+import requests, time, threading
+
+LATENCY_P99 = Gauge("aegis_inference_p99_ms", "p99 inference latency ms", ["service"])
+SAFETY_FLAGS = Gauge("aegis_inference_safety_flag", "Safety flag (0 ok, 1 violated)", ["service", "check"])
+HIL_HEALTH = Gauge("aegis_hil_health", "HIL health (0 bad,1 ok)", ["rig"])
+
+def probe_loop(endpoint, service):
+    while True:
+        try:
+            r = requests.get(endpoint, timeout=5)
+            if r.status_code == 200:
+                data = r.json() if r.headers.get("content-type","").startswith("application/json") else {}
+                # If service returns latency histogram or p99
+                p99 = data.get("p99_ms")
+                if p99:
+                    LATENCY_P99.labels(service=service).set(p99)
+                # safety example checks
+                safe_flag = 0 if data.get("safety_ok", True) else 1
+                SAFETY_FLAGS.labels(service=service, check="safety_ok").set(safe_flag)
+            else:
+                SAFETY_FLAGS.labels(service=service, check="endpoint_ok").set(1)
+        except Exception:
+            SAFETY_FLAGS.labels(service=service, check="endpoint_ok").set(1)
+        time.sleep(10)
+
+def hil_probe_loop(rig_endpoint, rig):
+    while True:
+        try:
+            r = requests.get(rig_endpoint, timeout=5)
+            HIL_HEALTH.labels(rig=rig).set(1 if r.status_code==200 else 0)
+        except Exception:
+            HIL_HEALTH.labels(rig=rig).set(0)
+        time.sleep(15)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--listen", default="0.0.0.0:9101")
+    p.add_argument("--probe-endpoint", action="append", help="endpoint=url,service=name")
+    p.add_argument("--hil-rig", action="append", help="rig=url,name")
+    args = p.parse_args()
+    host, port = args.listen.split(":")
+    start_http_server(int(port), addr=host)
+    for pe in args.probe_endpoint or []:
+        endpoint, service = pe.split(",",1)
+        t=threading.Thread(target=probe_loop, args=(endpoint,service), daemon=True)
+        t.start()
+    for hr in args.hil_rig or []:
+        rig_endpoint, rig = hr.split(",",1)
+        t=threading.Thread(target=hil_probe_loop, args=(rig_endpoint,rig), daemon=True)
+        t.start()
+    print("Exporter started on", args.listen)
+    while True:
+        time.sleep(60)
+
+if __name__ == "__main__":
+    main()
+
