+#!/usr/bin/env python3
+"""
+Fusion evaluation scripts
+ - Given model outputs on fused inputs, compute basic fusion metrics (mAP, IoU) and log OOD behavior.
+
+Usage:
+  python3 fusion_eval.py --preds preds.json --gts gts.json --out /tmp/fusion_eval.json
+"""
+import argparse, json
+from sklearn.metrics import precision_recall_fscore_support
+
+def load_pairs(preds, gts):
+    with open(preds) as fh:
+        P = json.load(fh)
+    with open(gts) as fh:
+        G = json.load(fh)
+    # assume list of dicts with 'id' and 'labels'
+    return P, G
+
+def evaluate(P, G):
+    # coarse example; real eval uses bbox IoU and detection metrics
+    y_true=[]
+    y_pred=[]
+    for p in P:
+        gid = p.get("id")
+        g = next((x for x in G if x.get("id")==gid), None)
+        if not g:
+            continue
+        y_true.append(g.get("label",0))
+        y_pred.append(p.get("label",0))
+    prec, rec, f1, _ = precision_recall_fscore_support(y_true, y_pred, average="binary")
+    return {"precision": prec, "recall": rec, "f1": f1}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--preds", required=True)
+    p.add_argument("--gts", required=True)
+    p.add_argument("--out", required=True)
+    args = p.parse_args()
+    P,G = load_pairs(args.preds, args.gts)
+    metrics = evaluate(P,G)
+    with open(args.out,"w") as fh:
+        json.dump(metrics, fh, indent=2)
+    print("Wrote fusion eval to", args.out)
+
+if __name__ == "__main__":
+    main()
+
