+#!/usr/bin/env python3
+"""
+Lightweight agent runtime scaffold
+ - Planner (stub), Executor (safety-wrapped), Memory store (in-memory)
+ - Integrates with HIL/E-STOP adapter to enforce actuation safety
+
+Usage:
+  python3 agent_runtime.py --task "deliver_package" --config agent_config.yml
+"""
+import argparse, time, threading, json
+
+class Memory:
+    def __init__(self):
+        self.mem = []
+    def append(self, item):
+        self.mem.append(item)
+    def retrieve(self):
+        return list(self.mem)
+
+class Planner:
+    def plan(self, state, goal):
+        # Placeholder planning: produce sequence of high-level actions
+        return ["navigate_to_point", "align", "exec_action"]
+
+class Executor:
+    def __init__(self, estop_adapter=None):
+        self.estop = estop_adapter
+    def execute(self, action):
+        # Check E-STOP before executing
+        if self.estop and self.estop.is_estopped():
+            raise RuntimeError("E-STOP engaged; aborting action")
+        # In real system, dispatch to controllers / HIL adapters
+        print("Executing action:", action)
+        time.sleep(0.5)
+        return {"status":"ok", "action": action}
+
+class EStopAdapter:
+    def __init__(self, endpoint):
+        self.endpoint = endpoint
+    def is_estopped(self):
+        try:
+            import requests
+            r = requests.get(self.endpoint, timeout=1)
+            j = r.json() if r.headers.get("content-type","",).startswith("application/json") else {}
+            return not j.get("ok", True)
+        except Exception:
+            return True
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--task", required=True)
+    p.add_argument("--estop-endpoint", default="http://localhost:9200/estop")
+    args = p.parse_args()
+    mem = Memory()
+    planner = Planner()
+    estop = EStopAdapter(args.estop_endpoint)
+    execr = Executor(estop_adapter=estop)
+    plan = planner.plan({}, args.task)
+    print("Plan:", plan)
+    for a in plan:
+        try:
+            res = execr.execute(a)
+            mem.append({"action": a, "result": res})
+        except Exception as e:
+            print("Execution halted:", e)
+            break
+    print("Memory contents:", mem.retrieve())
+
+if __name__ == "__main__":
+    main()
