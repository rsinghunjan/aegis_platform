+#!/usr/bin/env python3
+"""
+Sensor capture & sync checker
+ - Validates timestamp alignment across sensor logs (camera, lidar, imu)
+ - Produces a small report and alignment jitter histogram as NDJSON
+
+Usage:
+  python3 sync_check.py --camera camera.jsonl --lidar lidar.jsonl --imu imu.jsonl --out /tmp/sync_report.ndjson
+"""
+import argparse, json
+import statistics
+
+def load_timestamps(jsonl):
+    ts=[]
+    with open(jsonl) as fh:
+        for l in fh:
+            j=json.loads(l)
+            ts.append(j.get("timestamp"))
+    return ts
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--camera", required=True)
+    p.add_argument("--lidar", required=True)
+    p.add_argument("--imu", required=True)
+    p.add_argument("--out", required=True)
+    args = p.parse_args()
+    cam_ts = load_timestamps(args.camera)
+    lid_ts = load_timestamps(args.lidar)
+    imu_ts = load_timestamps(args.imu)
+    # naive alignment: compute pairwise nearest neighbor differences
+    diffs=[]
+    for t in cam_ts:
+        nearest = min(lid_ts, key=lambda x: abs(x-t))
+        diffs.append(abs(nearest - t))
+    mean_jitter = statistics.mean(diffs) if diffs else None
+    report = {"camera_count": len(cam_ts), "lidar_count": len(lid_ts), "imu_count": len(imu_ts), "mean_camera_lidar_jitter_s": mean_jitter}
+    with open(args.out, "w") as fh:
+        json.dump(report, fh, indent=2)
+    print("Wrote sync report to", args.out)
+
+if __name__ == "__main__":
+    main()
+
