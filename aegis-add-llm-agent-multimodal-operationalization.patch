+#!/usr/bin/env python3
+"""
+Adapter to connect agent runtime with HIL rig E-STOP & waveform safety checks.
+ - Provides a small REST server that exposes /estop (JSON) and /waveform_check endpoints.
+ - HIL rig or safety service should POST safety updates to this service.
+"""
+from flask import Flask, jsonify, request
+import argparse, threading, time
+
+app = Flask(__name__)
+state = {"estop": False, "waveform_ok": True, "last_update": None}
+
+@app.route("/estop", methods=["GET"])
+def estop_get():
+    return jsonify({"ok": not state["estop"], "estop": state["estop"], "last_update": state["last_update"]})
+
+@app.route("/update", methods=["POST"])
+def update():
+    data = request.get_json() or {}
+    state["estop"] = bool(data.get("estop", state["estop"]))
+    state["waveform_ok"] = bool(data.get("waveform_ok", state["waveform_ok"]))
+    state["last_update"] = time.time()
+    return jsonify({"status":"updated"})
+
+@app.route("/waveform_check", methods=["GET"])
+def waveform_check():
+    return jsonify({"waveform_ok": state["waveform_ok"], "last_update": state["last_update"]})
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--host", default="0.0.0.0")
+    p.add_argument("--port", type=int, default=9200)
+    args = p.parse_args()
+    app.run(host=args.host, port=args.port)
+
+if __name__ == "__main__":
+    main()
+
