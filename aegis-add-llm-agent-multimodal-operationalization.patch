+#!/usr/bin/env python3
+"""
+Prepare tokenizer and dataset shards for large-scale generative model fine-tuning.
+ - Splits large dataset into sharded TFRecord / JSONL shards and produces a tokenizer snapshot.
+ - Records shard manifest for distributed training orchestration.
+
+Usage:
+  python3 tokenizer_shard_prep.py --dataset data/train.jsonl --out shards/ --shard-size 100000 --tokenizer-out tokenizer/
+"""
+import argparse, os, json
+from pathlib import Path
+from tokenizers import ByteLevelBPETokenizer
+
+def build_tokenizer(data_files, tokenizer_out):
+    os.makedirs(tokenizer_out, exist_ok=True)
+    tokenizer = ByteLevelBPETokenizer()
+    tokenizer.train(files=data_files, vocab_size=52000, min_frequency=2)
+    tokenizer.save_model(tokenizer_out)
+    return tokenizer_out
+
+def shard_jsonl(dataset, outdir, shard_size):
+    os.makedirs(outdir, exist_ok=True)
+    shard_index = 0
+    count = 0
+    fh = None
+    manifest = []
+    with open(dataset) as inf:
+        for line in inf:
+            if count % shard_size == 0:
+                if fh:
+                    fh.close()
+                shard_path = os.path.join(outdir, f"shard-{shard_index:05d}.jsonl")
+                fh = open(shard_path, "w")
+                manifest.append(shard_path)
+                shard_index += 1
+            fh.write(line)
+            count += 1
+    if fh:
+        fh.close()
+    # write manifest
+    mpath = os.path.join(outdir, "shard_manifest.json")
+    with open(mpath, "w") as mh:
+        json.dump({"shards": manifest, "count": count}, mh, indent=2)
+    return mpath
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--dataset", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--shard-size", type=int, default=100000)
+    p.add_argument("--tokenizer-out", default=None)
+    args = p.parse_args()
+    manifest = shard_jsonl(args.dataset, args.out, args.shard_size)
+    print("Shard manifest:", manifest)
+    if args.tokenizer_out:
+        tok = build_tokenizer([args.dataset], args.tokenizer_out)
+        print("Tokenizer saved to:", tok)
+
+if __name__ == "__main__":
+    main()
+
