+#!/usr/bin/env python3
+"""
+Collect MCP records and A2A audit messages for compliance bundles.
+Requires MCP_API env and Kafka bootstrap (or access to persisted A2A audit logs).
+"""
+import os, json, subprocess, tempfile, shutil
+MCP_API = os.environ.get("MCP_API", "")
+OUT = "evidence_mcp_a2a.zip"
+tmp = tempfile.mkdtemp()
+
+if MCP_API:
+    try:
+        r = subprocess.check_output(["curl","-sS", f"{MCP_API}/models"])
+        open(tmp+"/mcp_list.json","wb").write(r)
+    except Exception:
+        pass
+
+# Attempt to dump recent A2A approvals via kafka-console-consumer if available
+try:
+    subprocess.check_call(["kafka-console-consumer","--bootstrap-server","kafka:9092","--topic","aegis-a2a-approvals","--from-beginning","--max-messages","100","--timeout-ms","5000"], cwd=tmp)
+except Exception:
+    pass
+
+shutil.make_archive(OUT.replace(".zip",""), "zip", tmp)
+print("Wrote", OUT)
