+#!/usr/bin/env python3
+"""
+A2A Python SDK: publish/consume A2A messages to Kafka with schema validation and optional signing.
+Uses confluent-kafka or kafka-python (simplified to use kafka-python here).
+"""
+import json, os, time
+from kafka import KafkaProducer, KafkaConsumer
+from jsonschema import validate
+from a2a.schemas import a2a_messages as schemas
+import subprocess
+
+KAFKA_BOOTSTRAP = os.environ.get("KAFKA_BOOTSTRAP", "kafka:9092")
+
+producer = KafkaProducer(bootstrap_servers=KAFKA_BOOTSTRAP, value_serializer=lambda v: json.dumps(v).encode('utf-8'))
+
+def publish(topic, msg, schema_name=None, sign=False):
+    if schema_name:
+        schema = schemas["definitions"].get(schema_name)
+        if schema:
+            validate(instance=msg, schema=schema)
+    payload = msg.copy()
+    if sign and os.environ.get("COSIGN_KEY"):
+        tmp = "/tmp/a2a_msg.json"
+        with open(tmp,"w") as fh: json.dump(payload, fh)
+        subprocess.check_call(["cosign","sign-blob","--key",os.environ["COSIGN_KEY"], tmp])
+        with open(tmp+".sig","rb") as fh:
+            payload["_signature"] = fh.read().hex()
+    producer.send(topic, payload)
+    producer.flush()
+
+def consume(topic, group_id, handler):
+    consumer = KafkaConsumer(topic, bootstrap_servers=KAFKA_BOOTSTRAP, auto_offset_reset='earliest', group_id=group_id, value_deserializer=lambda v: json.loads(v.decode('utf-8')))
+    for msg in consumer:
+        handler(msg.value)
+
