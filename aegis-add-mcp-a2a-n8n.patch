+#!/usr/bin/env bash
+set -euo pipefail
+#
+# CI helper: POST MCP record and sign the MCP JSON with cosign (KMS).
+# Usage: create_and_sign_mcp.sh <mcp_json> <mcp_api>
+
+MCP_JSON="$1"
+MCP_API="$2"
+COSIGN_KEY="${COSIGN_KEY:-}"
+
+if [ -z "$MCP_JSON" ] || [ -z "$MCP_API" ]; then
+  echo "Usage: $0 <mcp_json> <mcp_api>"
+  exit 2
+fi
+
+curl -sS -X POST "$MCP_API" -H "Content-Type: application/json" -d @"$MCP_JSON"
+
+if [ -n "$COSIGN_KEY" ]; then
+  cosign sign-blob --key "${COSIGN_KEY}" "$MCP_JSON"
+  echo "Signed MCP JSON with cosign (key: $COSIGN_KEY)"
+else
+  echo "COSIGN_KEY not set; skipping sign"
+fi
+
