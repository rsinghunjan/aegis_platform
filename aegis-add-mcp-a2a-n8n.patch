+#!/usr/bin/env python3
+"""
+MCP server: stores and retrieves model context (MCP) records.
+Simple FastAPI app backed by Postgres (or in-memory sqlite if POSTGRES_DSN not set).
+Also exposes an endpoint to list recent MCP records for audit.
+"""
+import os, json
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from typing import List, Optional
+
+DB_DSN = os.environ.get("MCP_POSTGRES_DSN", "")
+STORE_FILE = os.environ.get("MCP_STORE_FILE", "/tmp/mcp_store.json")
+
+app = FastAPI(title="MCP Service")
+
+class ArtifactRef(BaseModel):
+    uri: str
+    hash: Optional[str] = None
+    cosign: Optional[dict] = None
+    rekor_entries: Optional[List[str]] = []
+
+class DatasetRef(BaseModel):
+    uri: str
+    commit: Optional[str] = None
+
+class ApprovalSig(BaseModel):
+    approver: str
+    ts: int
+
+class MCPRecord(BaseModel):
+    model_id: str
+    version: str
+    artifacts: List[ArtifactRef]
+    training_datasets: Optional[List[DatasetRef]] = []
+    prompts: Optional[List[dict]] = []
+    evaluation: Optional[dict] = {}
+    approvals: Optional[List[ApprovalSig]] = []
+
+def _load_store():
+    if os.path.exists(STORE_FILE):
+        return json.load(open(STORE_FILE))
+    return {}
+
+def _save_store(store):
+    with open(STORE_FILE,"w") as fh:
+        json.dump(store, fh, indent=2)
+
+@app.get("/models/{model_id}/context")
+def get_context(model_id: str):
+    s = _load_store()
+    if model_id not in s:
+        raise HTTPException(status_code=404, detail="not found")
+    return s[model_id]
+
+@app.post("/models/{model_id}/context", status_code=201)
+def post_context(model_id: str, rec: MCPRecord):
+    s = _load_store()
+    s[model_id] = rec.dict()
+    _save_store(s)
+    return {"status":"ok","model_id": model_id}
+
+@app.get("/models")
+def list_models():
+    s = _load_store()
+    out = [{"model_id":k,"version":v.get("version")} for k,v in s.items()]
+    return out
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=8082)
+
