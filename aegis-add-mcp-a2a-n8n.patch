+#!/usr/bin/env python3
+"""
+Consume aegis.a2a.approvals requests and write to approver DB (Postgres).
+"""
+import os, json, psycopg2
+from a2a.sdk.a2a_client import consume
+
+DB_DSN = os.environ.get("APPROVER_POSTGRES_DSN", "postgresql://mlflow:pass@postgres:5432/approver")
+
+def handle(msg):
+    if msg.get("type") != "approval_request":
+        return
+    conn = psycopg2.connect(DB_DSN)
+    cur = conn.cursor()
+    approval_id = msg["id"]
+    cur.execute("INSERT INTO approvals (id, namespace, action, requester, signed) VALUES (%s,%s,%s,%s,%s)", (approval_id, "aegis-ml", json.dumps({"artifact": msg["artifact_uri"]}), msg["requester"], False))
+    conn.commit()
+    cur.close()
+    conn.close()
+    print("Persisted approval", approval_id)
+
+if __name__ == "__main__":
+    consume("aegis.a2a.approvals", group_id="approver-consumer", handler=handle)
+
