#!/usr/bin/env python3
"""
Wrapper: import model from HF using existing importer and publish MCP via mcp/cli/announce_mcp.py

Usage:
  python scripts/hf_import_and_publish_mcp.py --repo-id google/flan-t5-small --model-name flan-t5 --version v1 --upload-s3 --sign-key aegis-model-sign --register
"""
import argparse
import os
import subprocess
import sys

from api.hf_importer import import_from_hf  # re-use existing importer implementation

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--repo-id", required=True)
    ap.add_argument("--model-name", required=True)
    ap.add_argument("--version", default=None)
    ap.add_argument("--sign-key", default=None)
    ap.add_argument("--upload-s3", action="store_true")
    ap.add_argument("--register", action="store_true")
    ap.add_argument("--s3-bucket", default=None)
    args = ap.parse_args()

    # call existing importer - it should return artifact info (we assume import_from_hf returns dict)
    print("Calling api.hf_importer.import_from_hf(...)")
    res = import_from_hf(
        repo_id=args.repo_id,
        model_name=args.model_name,
        version=args.version,
        sign_key=args.sign_key,
        upload_s3=args.upload_s3,
        s3_bucket=args.s3_bucket,
        register=args.register
    )
    # Expected minimal res: {"artifact_uri": "...", "artifact_hash": "...", "model_id": "...", "version": "..."}
    artifact_uri = res.get("artifact_uri") or res.get("s3_uri") or res.get("artifact_path")
    artifact_hash = res.get("artifact_hash") or res.get("sha256")
    model_id = res.get("model_id") or args.model_name
    version = res.get("version") or (args.version or "v0")

    # announce MCP
    cmd = ["python", "mcp/cli/announce_mcp.py", "--model-id", model_id, "--version", version, "--artifact-uri", artifact_uri]
    if artifact_hash:
        cmd += ["--artifact-hash", artifact_hash]
    print("Running:", " ".join(cmd))
    subprocess.check_call(cmd)
    print("Import + MCP publish complete")


if __name__ == "__main__":
    main()
