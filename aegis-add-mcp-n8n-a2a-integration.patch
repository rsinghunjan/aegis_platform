#!/usr/bin/env python3
"""
A2A lightweight client - publishes approval_request messages either to Kafka (if KAFKA_BOOTSTRAP set)
or to the approver HTTP API as a fallback. Also performs JSON Schema validation.
"""
import os
import json
import time
import uuid
import requests
from jsonschema import validate, ValidationError

SCHEMA_PATH = os.environ.get("A2A_SCHEMA_PATH", "a2a/schemas/a2a_messages.json")
KAFKA_BOOTSTRAP = os.environ.get("KAFKA_BOOTSTRAP", "")
APPROVER_API = os.environ.get("AEGIS_APPROVER_API", "http://approver.aegis-system.svc.cluster.local")

with open(SCHEMA_PATH) as fh:
    SCHEMAS = json.load(fh)["definitions"]


def _build_approval_request(model_id: str, artifact_uri: str, requester: str):
    msg = {
        "id": str(uuid.uuid4()),
        "type": "approval_request",
        "model_id": model_id,
        "artifact_uri": artifact_uri,
        "requester": requester,
        "ts": int(time.time())
    }
    return msg


def publish_approval_request(model_id: str, artifact_uri: str, requester: str = "a2a-client"):
    msg = _build_approval_request(model_id, artifact_uri, requester)
    try:
        validate(instance=msg, schema=SCHEMAS["approval_request"])
    except ValidationError as e:
        raise RuntimeError("A2A validation failed: " + str(e))

    # If Kafka configured, attempt to publish (simple kafka-python optional)
    if KAFKA_BOOTSTRAP:
        try:
            from kafka import KafkaProducer
            p = KafkaProducer(bootstrap_servers=KAFKA_BOOTSTRAP, value_serializer=lambda v: json.dumps(v).encode("utf-8"))
            p.send("aegis-a2a-approvals", msg)
            p.flush()
            print("Published approval_request to Kafka")
            return msg
        except Exception as e:
            print("Kafka publish failed, fallback to HTTP:", e)

    # Fallback: POST to approver API
    url = f"{APPROVER_API}/request"
    resp = requests.post(url, json=msg, timeout=10)
    resp.raise_for_status()
    print("Posted approval_request to approver API")
    return msg
