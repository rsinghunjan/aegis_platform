#!/usr/bin/env python3
"""
CLI helper: announce a model MCP record to MCP service and optionally sign the MCP JSON with cosign.

Usage:
  AEGIS_MCP_API="https://mcp.example/api" COSIGN_KEY="kms://..." python mcp/cli/announce_mcp.py \
    --model-id mymodel --version v1 --artifact-uri s3://aegis/whatever.plan --artifact-hash <sha256>
"""
import argparse
import json
import os
import requests
import subprocess
import sys
from datetime import datetime

MCP_API = os.environ.get("AEGIS_MCP_API", "http://localhost:8082")
COSIGN_KEY = os.environ.get("COSIGN_KEY", "")


def sign_if_possible(path):
    if not COSIGN_KEY:
        print("COSIGN_KEY not configured; skipping cosign sign of MCP JSON")
        return None
    try:
        subprocess.check_call(["cosign", "sign-blob", "--key", COSIGN_KEY, path])
        sig_path = path + ".sig"
        if os.path.exists(sig_path):
            print("Signed MCP JSON ->", sig_path)
            return sig_path
    except Exception as e:
        print("cosign sign failed:", e)
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--model-id", required=True)
    ap.add_argument("--version", required=True)
    ap.add_argument("--artifact-uri", required=True)
    ap.add_argument("--artifact-hash", default=None)
    ap.add_argument("--training-dataset", action="append", default=[])
    ap.add_argument("--prompts", type=str, default=None, help="JSON array of prompts")
    args = ap.parse_args()

    rec = {
        "model_id": args.model_id,
        "version": args.version,
        "artifacts": [{"uri": args.artifact_uri, "hash": args.artifact_hash}],
        "training_datasets": [{"uri": d} for d in args.training_dataset],
        "prompts": json.loads(args.prompts) if args.prompts else [],
        "evaluation": {},
        "approvals": []
    }

    tmp = "/tmp/mcp_record.json"
    with open(tmp, "w") as fh:
        json.dump(rec, fh, indent=2)

    # POST to MCP
    url = f"{MCP_API.rstrip('/')}/models/{args.model_id}/context"
    print("Posting MCP record to", url)
    resp = requests.post(url, json=rec)
    if resp.status_code not in (200, 201):
        print("MCP POST failed:", resp.status_code, resp.text)
        sys.exit(2)
    print("MCP posted OK")

    sig = sign_if_possible(tmp)
    if sig:
        # Optionally, also register the signature artifact in Rekor if REKOR_SERVER set
        rekor = os.environ.get("REKOR_SERVER", "")
        if rekor:
            try:
                print("Attempting Rekor upload for MCP JSON (best effort)...")
                # rekor-cli upload for blobs requires local tool; do a best-effort search
                subprocess.check_call(["rekor-cli", "upload", "--rekor_server", rekor, "--artifact", tmp], stderr=subprocess.STDOUT)
                print("Rekor upload attempted")
            except Exception as e:
                print("Rekor upload failed (continuing):", e)
    print("Done")


if __name__ == "__main__":
    main()
