#!/usr/bin/env python3
"""
MCP (Model Context Protocol) service - simple FastAPI server.

Stores MCP records (file-backed by default) and exposes a minimal API:
 - POST /models/{model_id}/context  : create/update MCP record
 - GET  /models/{model_id}/context  : fetch MCP record
 - GET  /models                     : list models (for audits)

Usage (dev):
  AEGIS_MCP_STORE=/data/mcp_store.json uvicorn mcp.server.main:app --host 0.0.0.0 --port 8082

In production point MCP_POSTGRES_DSN to a Postgres DSN to persist there instead of a file.
"""
import os
import json
from typing import Optional
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from datetime import datetime
import pathlib

STORE_FILE = os.environ.get("AEGIS_MCP_STORE", "/data/mcp_store.json")
POSTGRES_DSN = os.environ.get("MCP_POSTGRES_DSN", "")

app = FastAPI(title="Aegis MCP Service", version="0.1.0")


class ArtifactRef(BaseModel):
    uri: str
    hash: Optional[str] = None
    cosign: Optional[dict] = None
    rekor_entries: Optional[list] = []


class DatasetRef(BaseModel):
    uri: str
    commit: Optional[str] = None


class ApprovalSig(BaseModel):
    approver: str
    ts: int


class MCPRecord(BaseModel):
    model_id: str
    version: str
    artifacts: list[ArtifactRef]
    training_datasets: Optional[list[DatasetRef]] = []
    prompts: Optional[list[dict]] = []
    evaluation: Optional[dict] = {}
    approvals: Optional[list[ApprovalSig]] = []


def _ensure_store():
    p = pathlib.Path(STORE_FILE)
    if not p.parent.exists():
        p.parent.mkdir(parents=True, exist_ok=True)
    if not p.exists():
        p.write_text("{}")
    return p


def _load_store():
    p = _ensure_store()
    try:
        return json.loads(p.read_text())
    except Exception:
        return {}


def _save_store(d):
    p = _ensure_store()
    p.write_text(json.dumps(d, indent=2))


@app.post("/models/{model_id}/context", status_code=201)
def post_context(model_id: str, rec: MCPRecord):
    store = _load_store()
    store[model_id] = rec.dict()
    store[model_id]["updated_at"] = datetime.utcnow().isoformat()
    _save_store(store)
    return {"status": "ok", "model_id": model_id}


@app.get("/models/{model_id}/context")
def get_context(model_id: str):
    store = _load_store()
    if model_id not in store:
        raise HTTPException(status_code=404, detail="not found")
    return store[model_id]


@app.get("/models")
def list_models():
    store = _load_store()
    out = [{"model_id": k, "version": v.get("version"), "updated_at": v.get("updated_at")} for k, v in store.items()]
    return out


if __name__ == "__main__":
    import uvicorn
    uvicorn.run("mcp.server.main:app", host="0.0.0.0", port=8082, reload=True)
