#!/usr/bin/env python3
"""
A2A approver consumer - simple HTTP endpoint consumer style for deployments where Kafka is not present.
Also contains a small Kafka consumer if KAFKA_BOOTSTRAP provided.
This script demonstrates how to persist A2A approval requests into the approver DB.
"""
import os
import json
import time
import psycopg2
from flask import Flask, request, jsonify

APP = Flask(__name__)
DB_DSN = os.environ.get("APPROVER_POSTGRES_DSN", "postgresql://mlflow:pass@postgres:5432/approver")


@APP.route("/request", methods=["POST"])
def handle_request():
    msg = request.get_json()
    # basic validation
    if not msg or msg.get("type") != "approval_request":
        return jsonify({"error": "invalid message"}), 400
    # persist to DB
    try:
        conn = psycopg2.connect(DB_DSN)
        cur = conn.cursor()
        cur.execute("INSERT INTO approvals (id, namespace, action, requester, signed) VALUES (%s,%s,%s,%s,%s)",
                    (msg["id"], "aegis-ml", json.dumps({"artifact": msg["artifact_uri"]}), msg["requester"], False))
        conn.commit()
        cur.close()
        conn.close()
    except Exception as e:
        print("DB insert failed:", e)
        return jsonify({"error": "db"}), 500
    return jsonify({"status": "ok"}), 201


def run_kafka_consumer():
    if not os.environ.get("KAFKA_BOOTSTRAP"):
        return
    try:
        from kafka import KafkaConsumer
        consumer = KafkaConsumer("aegis-a2a-approvals", bootstrap_servers=os.environ["KAFKA_BOOTSTRAP"],
                                 auto_offset_reset="earliest", group_id="approver-consumer",
                                 value_deserializer=lambda v: json.loads(v.decode("utf-8")))
        for msg in consumer:
            print("Kafka received", msg.value)
            # Persist similarly as above (omitted for brevity)
    except Exception as e:
        print("Kafka consumer error:", e)


if __name__ == "__main__":
    # optionally run kafka consumer in background (not both)
    import threading
    t = threading.Thread(target=run_kafka_consumer, daemon=True)
    t.start()
    APP.run(host="0.0.0.0", port=8085)
