*** Add File:tools/n8n/import_workflows.sh
+#!/usr/bin/env bash
+set -euo pipefail
+N8N_URL=${1:-http://n8n.aegis.example.com}
+API_KEY=${2:-}
+WORKFLOWS_DIR=${3:-n8n/workflows}
+
+if [ -z "$API_KEY" ]; then
+  echo "Usage: $0 <n8n_url> <n8n_api_key> [workflows_dir]"
+  exit 2
+fi
+
+for f in ${WORKFLOWS_DIR}/*.json; do
+  echo "Importing $f"
+  curl -sS -X POST "${N8N_URL}/rest/workflows/import" \
+    -H "Content-Type: application/json" \
+    -H "Authorization: Bearer ${API_KEY}" \
+    --data-binary @"${f}" | jq -r
+done
+
+echo "Imported workflows. Verify in n8n UI."
+
+Security note: Prefer to create credentials in n8n and use Vault to provide the API key to this script when running.
+
