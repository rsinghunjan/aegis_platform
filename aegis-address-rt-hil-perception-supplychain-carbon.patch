+#!/usr/bin/env python3
+"""
+Simulation Cluster Runner
+ - Generates scenario packs, submits Argo workflows (carla->hil) in parallel,
+   collects failures, aggregates metrics and writes failure artifacts for triage.
+ - Requires 'argo' CLI authenticated against Argo server.
+"""
+import argparse, os, subprocess, json, tempfile, time
+from datetime import datetime
+from concurrent.futures import ThreadPoolExecutor
+
+def generate_pack(count, outpath):
+    subprocess.check_call(["python3","ops/av/sim_hil/carla_scenario_pack_generator.py","--count",str(count),"--out",outpath])
+
+def submit_pack(pack):
+    # submit Argo workflow that consumes pack - operator must implement mapping
+    wf_yaml = "ops/av/sim_hil/carla_to_hil_pipeline.yaml"
+    # here we simply call argo submit with parameters if supported
+    try:
+        subprocess.check_call(["argo","submit",wf_yaml,"--parameter","scenario_pack="+pack,"--wait"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True, ""
+    except Exception as e:
+        return False, str(e)
+
+def collect_failures(base_dir, out):
+    # search for 'fail' markers in HIL results; this is operator-specific
+    failures=[]
+    for root,_,files in os.walk(base_dir):
+        for f in files:
+            if f.endswith(".fail") or f.endswith(".error") or f.endswith(".ndjson"):
+                failures.append(os.path.join(root,f))
+    with open(out,"w") as fh:
+        json.dump({"collected_at": datetime.utcnow().isoformat()+"Z", "failures": failures}, fh, indent=2)
+    return out
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--packs", type=int, default=10)
+    p.add_argument("--scenarios-per-pack", type=int, default=50)
+    p.add_argument("--out", default=f"/tmp/sim_cluster_{int(time.time())}")
+    p.add_argument("--parallel", type=int, default=4)
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    packs=[]
+    for i in range(args.packs):
+        pack_path = os.path.join(args.out, f"pack_{i}.tar.gz")
+        generate_pack(args.scenarios_per_pack, pack_path)
+        packs.append(pack_path)
+    results=[]
+    with ThreadPoolExecutor(max_workers=args.parallel) as ex:
+        futures = {ex.submit(submit_pack, p): p for p in packs}
+        for fut in futures:
+            pack = futures[fut]
+            ok, msg = fut.result()
+            results.append({"pack": pack, "ok": ok, "msg": msg})
+    res_path = os.path.join(args.out,"submission_results.json")
+    with open(res_path,"w") as fh:
+        json.dump(results, fh, indent=2)
+    failures = collect_failures(args.out, os.path.join(args.out,"failures.json"))
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("sim_cluster_run", {"out": args.out})
+    except Exception:
+        pass
+    print("Simulation cluster run complete. Results:", res_path, "Failures:", failures)
+
+if __name__=="__main__":
+    main()
+
