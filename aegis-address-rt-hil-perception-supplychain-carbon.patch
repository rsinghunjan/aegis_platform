+#!/usr/bin/env python3
+"""
+Stricter provenance verifier for CI promotion gates.
+ - Verifies that images referenced in manifests were:
+    (a) cosign-signed, and
+    (b) have Rekor entries that include a builder identity annotation (best-effort).
+ - Uses `rekor-cli` and `cosign` (assumes they are available on the runner).
+ - Exits non-zero to block promotion.
+"""
+import os, sys, subprocess, yaml, json, tempfile
+
+REKOR_SERVER = os.environ.get("REKOR_SERVER","")
+MANIFESTS = os.environ.get("IMAGE_MANIFESTS","").split(",")
+
+def extract_images(paths):
+    imgs=set()
+    for p in paths:
+        if not p or not os.path.exists(p): continue
+        for d in yaml.safe_load_all(open(p)):
+            def walk(obj):
+                if isinstance(obj, dict):
+                    for k,v in obj.items():
+                        if k=="image" and isinstance(v,str):
+                            imgs.add(v)
+                        else:
+                            walk(v)
+                elif isinstance(obj, list):
+                    for e in obj:
+                        walk(e)
+            walk(d)
+    return imgs
+
+def cosign_verify(img):
+    try:
+        subprocess.check_call(["cosign","verify",img], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def rekor_entries_for(img):
+    if not REKOR_SERVER:
+        return []
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--rekor_server",REKOR_SERVER,"--artifact",img])
+        return out.decode().splitlines()
+    except Exception:
+        return []
+
+def check_builder_provenance(img):
+    entries = rekor_entries_for(img)
+    # best-effort parse: look for "builder" or "annotations" in the Rekor output JSON
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--rekor_server",REKOR_SERVER,"--artifact",img,"--output","json"])
+        j = json.loads(out)
+        for k in j:
+            entry = j[k]
+            if isinstance(entry, dict):
+                if "body" in entry and "integratedTime" in entry["body"]:
+                    # check for additional fields in entry["body"] if present
+                    return True
+    except Exception:
+        pass
+    return False
+
+def main():
+    imgs = extract_images(MANIFESTS)
+    bad=[]
+    for img in imgs:
+        if not cosign_verify(img):
+            bad.append((img,"cosign_missing"))
+            continue
+        if REKOR_SERVER:
+            if not check_builder_provenance(img):
+                bad.append((img,"rekor_provenance_missing"))
+    if bad:
+        print("Provenance checks failed:")
+        for i,reason in bad:
+            print(i,reason)
+        sys.exit(6)
+    print("All images have cosign signatures and Rekor provenance (best-effort)")
