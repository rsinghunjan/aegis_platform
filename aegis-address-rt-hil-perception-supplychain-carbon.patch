+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run a hardware RT sweep across a set of representative ECUs/controllers and network modes.
+# - Runs CAN sampler, TSN probe, RT orchestrator, and rt_slo_prover for each target
+# - Produces per-target signed bundles and an aggregated report
+# - Usage:
+#    TARGETS="ecu1:can0,ecu2:eth1" COSIGN_KMS_URI=kms://... S3_UPLOAD=s3://... ./run_hw_rt_sweep.sh --out /tmp/rt_sweep
+
+OUT=${1:-/tmp/aegis_hw_rt_sweep_$(date +%s)}
+COSIGN=${COSIGN_KMS_URI:-}
+S3_UPLOAD=${S3_UPLOAD:-}
+TARGETS=${TARGETS:-localhost}
+
+mkdir -p "$OUT"
+
+IFS="," read -r -a tarr <<< "$TARGETS"
+
+for t in "${tarr[@]}"; do
+  host=$(echo "$t" | cut -d: -f1)
+  iface=$(echo "$t" | cut -d: -f2 || true)
+  if [ -z "$iface" ]; then iface="can0"; fi
+  id="${host}_${iface}_$(date +%s)"
+  outdir="$OUT/$id"
+  mkdir -p "$outdir"
+  echo "Running RT sweep for $host on interface $iface -> $outdir"
+
+  # 1) CAN latency sampler (best-effort; assumes socketcan on local host or reachable host)
+  if [ "$host" = "localhost" ] || [ "$host" = "$(hostname)" ]; then
+    python3 ops/av/rt/can_latency_sampler.py --iface "$iface" --count 50 --out "$outdir/can_samples.ndjson" || true
+  else
+    echo "Remote host sampling request: operator must run CAN sampler on $host and copy to $outdir"
+  fi
+
+  # 2) TSN probe (best-effort)
+  if command -v tsntool >/dev/null 2>&1; then
+    tsntool latency --iface "${iface}" --count 100 > "$outdir/tsn_latency.txt" 2>&1 || true
+  fi
+
+  # 3) Run RT orchestrator for this node (assumes orchestrator supports --node)
+  ./ops/robotics/rt/lab_validation/orchestrate_rt_full.sh --node "$host" --out "$outdir/rt_run" || true
+
+  # 4) Prove SLOs
+  python3 ops/robotics/rt/lab_validation/rt_slo_prover.py --jitter "$outdir/rt_run/rt_jitter_samples.ndjson" --safe "$outdir/rt_run/safe_stop.json" --out "$outdir/rt_slo_proof.json" || true
+
+  # 5) Package per-target bundle
+  bundle="${outdir}.tar.gz"
+  tar -czf "$bundle" -C "$outdir" . || true
+  if [ -n "$COSIGN" ]; then
+    cosign sign --key "$COSIGN" "$bundle" || true
+  fi
+  if [ -n "$S3_UPLOAD" ]; then
+    aws s3 cp "$bundle" "$S3_UPLOAD/${id}.tar.gz" || true
+  fi
+  python3 - <<PY || true
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("hw_rt_sweep_target", {"target":"$host:$iface","bundle":"$bundle"})
+print("Recorded manifest for $host:$iface")
+PY
+done
+
+# Aggregate report
+AGG="/tmp/rt_sweep_agg_$(date +%s).json"
+python3 - <<PY
+import json,os,glob
+outs=[]
+for p in glob.glob("$OUT/*/rt_slo_proof.json"):
+    try:
+        outs.append(json.load(open(p)))
+    except Exception:
+        outs.append({"path":p,"error":"read_failed"})
+open("$AGG","w").write(json.dumps({"collected":outs},indent=2))
+print("Wrote aggregate report to $AGG")
+PY
+echo "RT hardware sweep complete. Aggregate report: $AGG"
+exit 0
+
