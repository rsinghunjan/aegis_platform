+#!/usr/bin/env python3
+"""
+HIL Campaign Manager
+ - Orchestrates a set of HIL scenarios, collects artifacts, runs automated comparators,
+   generates a campaign report, and files triage issues for failures.
+ - Integrates with `gh` CLI to open issues (requires gh auth) and evidence_sdk to record manifests.
+"""
+import argparse, os, subprocess, json, tempfile, uuid
+from datetime import datetime
+
+def run_scenario(cmd, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    try:
+        subprocess.check_call(cmd, shell=True)
+        return True
+    except Exception as e:
+        open(os.path.join(outdir,"error.txt"),"w").write(str(e))
+        return False
+
+def compare_waveform(measured, golden, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    # call existing comparator; fallback to simple stub
+    try:
+        subprocess.check_call(["python3","ops/robotics/control/validation/hil_waveform_capture.py","--measured",measured,"--gold",golden,"--campaign","hil_campaign"], stdout=open(os.path.join(outdir,"compare.log"),"w"))
+        return True
+    except Exception as e:
+        open(os.path.join(outdir,"compare_error.txt"),"w").write(str(e))
+        return False
+
+def open_triage_issue(title, body, artifacts):
+    try:
+        cmd = ["gh","issue","create","--title",title,"--body",body]
+        subprocess.check_call(cmd)
+        return True
+    except Exception:
+        print("Failed to open GH issue; printing body:\n",body)
+        return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--scenarios", nargs="+", required=True, help="List of scenario runner commands (shell commands)")
+    p.add_argument("--golden", required=True, help="path to golden waveform")
+    p.add_argument("--out", default="/tmp/hil_campaign_"+datetime.utcnow().strftime("%Y%m%d%H%M%S"))
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    campaign_id = str(uuid.uuid4())
+    summary = {"campaign_id": campaign_id, "started_at": datetime.utcnow().isoformat()+"Z", "scenarios": []}
+    for i,cmd in enumerate(args.scenarios):
+        sname = f"scenario_{i}"
+        outdir = os.path.join(args.out, sname)
+        ok = run_scenario(cmd, outdir)
+        compare_ok = False
+        if ok:
+            measured = os.path.join(outdir,"measured.ndjson")
+            if os.path.exists(measured):
+                compare_ok = compare_waveform(measured, args.golden, outdir)
+        scenario_result = {"name": sname, "cmd": cmd, "ran_ok": ok, "compare_ok": compare_ok, "outdir": outdir}
+        summary["scenarios"].append(scenario_result)
+        if not (ok and compare_ok):
+            title = f"HIL Campaign failure: {sname}"
+            body = f"Campaign {campaign_id} - scenario {sname} failed. See artifacts at {outdir}\n\nResult: {json.dumps(scenario_result, indent=2)}"
+            open_triage_issue(title, body, [outdir])
+    summary["finished_at"] = datetime.utcnow().isoformat()+"Z"
+    summary_path = os.path.join(args.out,"campaign_summary.json")
+    with open(summary_path,"w") as fh:
+        json.dump(summary, fh, indent=2)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("hil_campaign", {"campaign": summary_path})
+    except Exception:
+        pass
+    print("HIL campaign completed. Summary:", summary_path)
+
+if __name__ == "__main__":
+    main()
+
