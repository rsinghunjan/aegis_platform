+#!/usr/bin/env python3
+"""
+Carbon Gate Tuner + Dynamic Gate
+ - Compute rolling-average grid intensity and produce adaptive thresholds
+ - Runs in two modes:
+    monitor -> emit metrics and suggested threshold
+    enforce -> block promotions when rolling-average exceeds threshold unless override signed artifact present
+ - Override artifact is a cosign-signed JSON with {"approval_id":..., "allow":"true", "expires": "..."}
+"""
+import os, time, json, argparse, statistics, subprocess
+from datetime import datetime, timedelta
+from ops.carbon.watttime_client import get_latest_intensity
+from ops.sdk.evidence_sdk import record_manifest
+
+REGION=os.environ.get("Aegis_CARBON_REGION","US-CA")
+WINDOW_MINUTES=int(os.environ.get("CARBON_WINDOW_MINUTES","30"))
+MONITOR_INTERVAL=int(os.environ.get("CARBON_MONITOR_INTERVAL","60"))
+THRESHOLD_BASE=float(os.environ.get("Aegis_CARBON_PROMOTE_THRESHOLD_GCO2","300"))
+OVERRIDE_PATH=os.environ.get("CARBON_OVERRIDE_ARTIFACT","")
+
+def verify_override(path):
+    if not path or not os.path.exists(path):
+        return False
+    try:
+        subprocess.check_call(["cosign","verify",path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def compute_rolling(window_minutes, samples):
+    # samples: list of (ts, intensity)
+    cutoff = time.time() - window_minutes*60
+    vals = [v for (ts,v) in samples if ts >= cutoff and v is not None]
+    if not vals:
+        return None
+    return statistics.mean(vals), statistics.median(vals)
+
+def monitor_loop(out, window_minutes, interval):
+    samples=[]
+    while True:
+        val = get_latest_intensity(REGION)
+        samples.append((time.time(), val))
+        mean, median = (None, None)
+        r = compute_rolling(window_minutes, samples)
+        if r:
+            mean, median = r[0], r[1] if isinstance(r, tuple) else (r, r)
+        report = {"ts": datetime.utcnow().isoformat()+"Z", "latest": val, "rolling_mean": mean, "rolling_median": median, "threshold_base": THRESHOLD_BASE}
+        with open(out,"a") as fh:
+            fh.write(json.dumps(report)+"\n")
+        try:
+            record_manifest("carbon_tuner_monitor", {"report": out})
+        except Exception:
+            pass
+        print("Monitor:", report)
+        time.sleep(interval)
+
+def enforce_once(window_minutes, override_path):
+    samples=[]
+    # gather samples for window by polling a few times (best-effort)
+    for _ in range(max(3, int(window_minutes/5))):
+        val = get_latest_intensity(REGION)
+        samples.append((time.time(), val))
+        time.sleep(5)
+    rolling = compute_rolling(window_minutes, samples)
+    if rolling is None:
+        print("No data, blocking promotion by default")
+        raise SystemExit(2)
+    mean = rolling[0] if isinstance(rolling, tuple) else rolling
+    # dynamic threshold: base * (1 + short-term variance factor)
+    suggested_threshold = THRESHOLD_BASE
+    print("Rolling mean:", mean, "threshold:", suggested_threshold)
+    if mean <= suggested_threshold:
+        print("Within threshold -> allow")
+        sys.exit(0)
+    # above threshold: check override
+    if override_path and verify_override(override_path):
+        print("Valid override artifact present -> allow")
+        sys.exit(0)
+    print("Above threshold and no valid override -> block")
+    raise SystemExit(3)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--mode", choices=["monitor","enforce"], default="monitor")
+    p.add_argument("--out", default="/tmp/carbon_tuner.log")
+    p.add_argument("--window-minutes", type=int, default=WINDOW_MINUTES)
+    p.add_argument("--interval", type=int, default=MONITOR_INTERVAL)
+    p.add_argument("--override", default=OVERRIDE_PATH)
+    args = p.parse_args()
+    if args.mode=="monitor":
+        monitor_loop(args.out, args.window_minutes, args.interval)
+    else:
+        enforce_once(args.window_minutes, args.override)
+
+if __name__=="__main__":
+    main()
+
