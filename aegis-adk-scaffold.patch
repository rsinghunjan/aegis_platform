+"""
+ADK schemas: versioned Action and Observation dictionaries.
+Keep these lightweight and backward compatible.
+"""
+from dataclasses import dataclass, asdict
+from typing import Any, Dict, Optional
+import time, json
+
+SCHEMA_VERSION = "adk.v1"
+
+@dataclass
+class Action:
+    id: str
+    type: str
+    params: Dict[str, Any]
+    timestamp: float = None
+
+    def __post_init__(self):
+        if self.timestamp is None:
+            self.timestamp = time.time()
+
+    def to_dict(self):
+        d = asdict(self)
+        d["schema_version"] = SCHEMA_VERSION
+        return d
+
+@dataclass
+class Observation:
+    id: str
+    sensor: str
+    data: Dict[str, Any]
+    timestamp: float = None
+
+    def __post_init__(self):
+        if self.timestamp is None:
+            self.timestamp = time.time()
+
+    def to_dict(self):
+        d = asdict(self)
+        d["schema_version"] = SCHEMA_VERSION
+        return d
+
