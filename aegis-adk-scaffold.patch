+"""
+Trace recorder: writes ndjson lines for events and can produce a trace file for evidence bundling.
+Each event is an object: { "ts":..., "type":"action.started", "payload": {...} }
+"""
+import json, os, time
+from typing import Dict, Any
+
+class Recorder:
+    def __init__(self, out_path):
+        self.out_path = out_path
+        os.makedirs(os.path.dirname(out_path), exist_ok=True)
+        # create file if not exists
+        open(self.out_path, "a").close()
+
+    def _emit(self, ev_type: str, payload: Dict[str, Any]):
+        entry = {"ts": time.time(), "type": ev_type, "payload": payload}
+        with open(self.out_path, "a") as fh:
+            fh.write(json.dumps(entry) + "\n")
+
+    def action_submitted(self, action: Dict[str, Any]):
+        self._emit("action.submitted", action)
+
+    def action_started(self, action: Dict[str, Any]):
+        self._emit("action.started", action)
+
+    def action_finished(self, action: Dict[str, Any], result: Dict[str, Any]):
+        self._emit("action.finished", {"action": action, "result": result})
+
+    def policy_violation(self, info: Dict[str, Any]):
+        self._emit("policy.violation", info)
+
+    def get_trace_path(self):
+        return self.out_path
+
