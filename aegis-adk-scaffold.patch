+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Include ADK traces/evidence into PoA auditor bundle
+# Usage: ./ops/adk/poa_integration.sh --adk-out /tmp/adk_sample --auditor-out /tmp/pofa_bundle.tar.gz --cosign $COSIGN_KMS_URI
+ADK_OUT=${1:-/tmp/adk_sample}
+AUDITOR_OUT=${2:-/tmp/auditor_adk_bundle.tar.gz}
+COSIGN=${3:-${COSIGN_KMS_URI:-}}
+
+if [ ! -d "$ADK_OUT" ]; then
+  echo "ADK out dir missing: $ADK_OUT"
+  exit 2
+fi
+
+tar -czf "$AUDITOR_OUT" -C "$ADK_OUT" .
+if [ -n "$COSIGN" ]; then
+  cosign sign --key "$COSIGN" "$AUDITOR_OUT" || echo "cosign sign failed"
+fi
+echo "Produced auditor ADK bundle: $AUDITOR_OUT"
+
