+"""
+ADK runtime interfaces & lightweight base implementations.
+Implementations should subclass Planner and Executor for domain logic.
+"""
+from typing import Dict, Any, List
+from ops.adk.sdk.schemas import Action, Observation
+from ops.adk.sdk.recorder import Recorder
+import uuid, time
+
+class Planner:
+    def propose(self, goal: Dict[str, Any], state: Dict[str, Any]) -> List[Action]:
+        """Return a sequence of Actions to satisfy goal given current state."""
+        raise NotImplementedError()
+
+class Executor:
+    def execute(self, action: Action, state: Dict[str, Any]) -> Dict[str, Any]:
+        """Execute action against environment/HIL; return result dict (status, evidence_ref, latency_ms)"""
+        raise NotImplementedError()
+
+class Enforcer:
+    def check(self, action: Action, state: Dict[str, Any]) -> (bool, str):
+        """Return (allow, reason). If allow==False, executor must not run action."""
+        return True, ""
+
+class Agent:
+    def __init__(self, planner: Planner, executor: Executor, enforcer: Enforcer, recorder: Recorder):
+        self.planner = planner
+        self.executor = executor
+        self.enforcer = enforcer
+        self.recorder = recorder
+        self.state = {}
+
+    def run_goal(self, goal: Dict[str, Any]):
+        plan = self.planner.propose(goal, self.state)
+        for a in plan:
+            aid = str(uuid.uuid4())
+            action = Action(id=aid, type=a.type, params=a.params)
+            self.recorder.action_submitted(action.to_dict())
+            allow, reason = self.enforcer.check(action, self.state)
+            if not allow:
+                self.recorder.policy_violation({"action": action.to_dict(), "reason": reason})
+                return {"status":"blocked", "reason": reason}
+            self.recorder.action_started(action.to_dict())
+            start = time.time()
+            res = self.executor.execute(action, self.state)
+            res["latency_ms"] = (time.time() - start) * 1000.0
+            self.recorder.action_finished(action.to_dict(), res)
+        return {"status":"completed"}
+
