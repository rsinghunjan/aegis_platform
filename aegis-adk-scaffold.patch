+#!/usr/bin/env python3
+"""
+Minimal sample agent using ADK SDK.
+Run locally to produce a trace file and an evidence bundle.
+"""
+import argparse, os, json
+from ops.adk.sdk.recorder import Recorder
+from ops.adk.sdk.agent import Agent
+from ops.adk.sample_agent.planner_simple import SimplePlanner
+from ops.adk.sample_agent.executor_sim import SimExecutor
+from ops.adk.sample_agent.enforcer_policy import PolicyEnforcer
+from ops.adk.sdk.evidence.py import bundle_evidence if False else None
+from ops.adk.sdk.evidence import bundle_evidence
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--goal", required=True, help='JSON string or path (e.g. {"command":"stop"})')
+    p.add_argument("--out", default="/tmp/adk_sample")
+    p.add_argument("--cosign", default="")
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    recorder = Recorder(os.path.join(args.out,"trace.ndjson"))
+    planner = SimplePlanner()
+    executor = SimExecutor(sim_out_dir=os.path.join(args.out,"evidence"))
+    enforcer = PolicyEnforcer(policy={})
+    agent = Agent(planner, executor, enforcer, recorder)
+    try:
+        goal = json.loads(args.goal) if args.goal.strip().startswith("{") else json.load(open(args.goal))
+    except Exception:
+        goal = {"command": "status"}
+    res = agent.run_goal(goal)
+    print("Agent run result:", res)
+    # bundle trace + evidence
+    trace = recorder.get_trace_path()
+    ev_files = [trace]
+    # include evidence_dir files
+    ev_dir = os.path.join(args.out,"evidence")
+    for f in os.listdir(ev_dir):
+        ev_files.append(os.path.join(ev_dir,f))
+    bundle_path = os.path.join(args.out, "adk_evidence.tar.gz")
+    bundle_evidence(ev_files, bundle_path, metadata={"goal":goal}, cosign_key=args.cosign or None)
+    print("Wrote evidence bundle to", bundle_path)
+
+if __name__=="__main__":
+    main()
+
