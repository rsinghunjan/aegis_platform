+"""
+Evidence helper: bundle trace + artifacts and optionally sign with cosign (KMS).
+"""
+import tarfile, os, subprocess, tempfile, json
+from typing import List, Optional
+
+def bundle_evidence(files: List[str], outpath: str, metadata: Optional[dict]=None, cosign_key: Optional[str]=None):
+    tmpdir = tempfile.mkdtemp()
+    manifest = {"files": [], "metadata": metadata or {}}
+    for f in files:
+        if os.path.exists(f):
+            base = os.path.basename(f)
+            dest = os.path.join(tmpdir, base)
+            subprocess.check_call(["cp", f, dest])
+            manifest["files"].append({"name": base, "sha256": _sha256(dest)})
+    mpath = os.path.join(tmpdir, "manifest.json")
+    with open(mpath, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    with tarfile.open(outpath, "w:gz") as tar:
+        tar.add(tmpdir, arcname="evidence")
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key", cosign_key, outpath])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    return outpath
+
+def _sha256(path):
+    import hashlib
+    h=hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
