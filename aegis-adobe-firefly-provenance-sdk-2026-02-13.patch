+#!/usr/bin/env python3
+"""
+Collect MLflow run metadata, cosign/Rekor attestations and receipt_signer output,
+and produce a single evidence bundle JSON suitable to attach to asset metadata.
+
+Usage:
+  python generate_evidence_bundle_adobe.py --run-id <mlflow-run-id> --attestation <att.json> --out bundle.json
+"""
+import argparse, json, os, requests, base64
+
+def fetch_mlflow_run(run_id, mlflow_uri):
+    if not run_id or not mlflow_uri:
+        return None
+    try:
+        r = requests.get(f"{mlflow_uri.rstrip('/')}/api/2.0/preview/mlflow/runs/get?run_id={run_id}", timeout=5.0)
+        if r.ok:
+            return r.json()
+    except Exception:
+        pass
+    return None
+
+def load_attestation(path):
+    if not path or not os.path.exists(path):
+        return None
+    return json.load(open(path))
+
+def collect_rekor_entries(att):
+    if not att:
+        return None
+    # If att contains rekor index or entry, use it. Otherwise return None
+    return att.get("rekor_index") or att.get("rekor_entry")
+
+def main(run_id, att_path, mlflow_uri, out):
+    bundle = {"mlflow": None, "attestation": None, "rekor": None, "generated_at": None}
+    bundle["mlflow"] = fetch_mlflow_run(run_id, mlflow_uri)
+    att = load_attestation(att_path)
+    bundle["attestation"] = att
+    bundle["rekor"] = collect_rekor_entries(att)
+    bundle["generated_at"] = __import__("time").time()
+    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
+    with open(out, "w") as f:
+        json.dump(bundle, f, indent=2)
+    print("Wrote evidence bundle to", out)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--run-id", default="")
+    p.add_argument("--attestation", default="")
+    p.add_argument("--mlflow-uri", default=os.environ.get("MLFLOW_TRACKING_URI",""))
+    p.add_argument("--out", default="evidence_bundle.json")
+    args = p.parse_args()
+    main(args.run_id, args.attestation, args.mlflow_uri, args.out)
+
