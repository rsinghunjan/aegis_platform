+#!/usr/bin/env python3
+"""
+DP aggregation example using IBM diffprivlib. Demonstrates parameterized epsilon.
+Install: pip install diffprivlib
+"""
+import numpy as np
+from diffprivlib.mechanisms import GaussianTruncated
+
+def dp_aggregate_mean(vecs, epsilon=1.0, delta=1e-5, sensitivity=1.0):
+    # vecs: list of numeric values or vectors
+    arr = np.array(vecs, dtype=float)
+    mean = np.mean(arr, axis=0)
+    mech = GaussianTruncated(epsilon=epsilon, delta=delta, sensitivity=sensitivity)
+    # apply mechanism elementwise for vector mean
+    noisy = []
+    for x in np.atleast_1d(mean):
+        noisy.append(mech.randomise(float(x)))
+    return np.array(noisy)
+
+if __name__ == "__main__":
+    print(dp_aggregate_mean([[0.1,0.2],[0.2,0.1]], epsilon=0.5).tolist())
+
