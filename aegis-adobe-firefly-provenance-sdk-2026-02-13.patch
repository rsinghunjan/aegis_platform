+// AdobeAegisSDK.swift
+// Lightweight Swift SDK for iOS/macOS to interact with Aegis services (retrieval guard, HIL, attestation verification)
+import Foundation
+
+public class AdobeAegisSDK {
+    let retrievalGuardBase: URL
+    let hilBase: URL
+    let rekorBase: URL
+
+    public init(retrievalGuard: URL, hil: URL, rekor: URL) {
+        self.retrievalGuardBase = retrievalGuard
+        self.hilBase = hil
+        self.rekorBase = rekor
+    }
+
+    public func checkRetrieval(subjectId: String, artifactId: String, completion: @escaping (Bool, String?) -> Void) {
+        var req = URLRequest(url: retrievalGuardBase.appendingPathComponent("/check"))
+        req.httpMethod = "POST"
+        req.addValue("application/json", forHTTPHeaderField: "Content-Type")
+        let body = ["subject_id": subjectId, "artifact_id": artifactId]
+        req.httpBody = try? JSONSerialization.data(withJSONObject: body)
+        URLSession.shared.dataTask(with: req) { data, resp, err in
+            guard let data = data, let j = try? JSONSerialization.jsonObject(with: data) as? [String:Any] else {
+                completion(false, "guard_error"); return
+            }
+            completion(j["ok"] as? Bool ?? false, j["reason"] as? String)
+        }.resume()
+    }
+
+    public func requestHILIntent(actionId: String, summary: String, owner: String, completion: @escaping (String?) -> Void) {
+        var req = URLRequest(url: hilBase.appendingPathComponent("/intent"))
+        req.httpMethod = "POST"
+        req.addValue("application/json", forHTTPHeaderField: "Content-Type")
+        let body = ["action_id": actionId, "summary": summary, "owner": owner]
+        req.httpBody = try? JSONSerialization.data(withJSONObject: body)
+        URLSession.shared.dataTask(with: req) { data, _, _ in
+            guard let d = data, let j = try? JSONSerialization.jsonObject(with: d) as? [String:Any] else { completion(nil); return }
+            completion(j["request_id"] as? String)
+        }.resume()
+    }
+
+    public func verifyRekorEntry(logIndex: String, completion: @escaping (Bool) -> Void) {
+        let url = rekorBase.appendingPathComponent("/api/v1/log/entries")
+        var comps = URLComponents(url: url, resolvingAgainstBaseURL: false)!
+        comps.queryItems = [URLQueryItem(name: "logIndex", value: logIndex)]
+        URLSession.shared.dataTask(with: comps.url!) { data, _, _ in
+            guard let d = data, let j = try? JSONSerialization.jsonObject(with: d) as? [String:Any] else { completion(false); return }
+            completion(!j.isEmpty)
+        }.resume()
+    }
+}
