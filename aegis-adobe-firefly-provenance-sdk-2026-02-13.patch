+/**
+ * Adobe I/O plugin skeleton (Node) — Aegis integration example
+ * Provides helpers: retrievalGuard.check(), hil.requestIntent(), verifyAttestation()
+ *
+ * Usage: embed in Adobe I/O action or plugin to validate and gate model/assets.
+ */
+const fetch = require("node-fetch");
+const base64 = require("base-64");
+
+class AegisClient {
+  constructor(opts) {
+    this.retrievalGuardUrl = opts.retrievalGuardUrl; // e.g. https://aegis/retrieval_guard
+    this.hilUrl = opts.hilUrl; // e.g. https://aegis/a2a/intent
+    this.rekorUrl = opts.rekorUrl; // e.g. https://rekor:3000
+    this.signerUrl = opts.signerUrl; // receipt_signer
+  }
+
+  async checkRetrieval(subjectId, artifactId) {
+    const res = await fetch(`${this.retrievalGuardUrl}/check`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ subject_id: subjectId, artifact_id: artifactId })
+    });
+    return res.ok ? res.json() : { ok: false, reason: "guard_error" };
+  }
+
+  async requestHILIntent(actionId, summary, owner) {
+    const res = await fetch(`${this.hilUrl}/intent`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ action_id: actionId, summary, owner })
+    });
+    return res.ok ? res.json() : null;
+  }
+
+  async verifyRekorEntry(entryUUID) {
+    // Simple fetch — in production use Rekor client libs and validate signatures/certs
+    const res = await fetch(`${this.rekorUrl}/api/v1/log/entries?logIndex=${entryUUID}`);
+    if (!res.ok) return false;
+    const j = await res.json();
+    // basic presence check
+    return Object.keys(j).length > 0;
+  }
+
+  async verifyAttestation(attestation) {
+    // attestation: JSON object containing signature + payload. For demo we check Rekor if present.
+    if (attestation.rekor_index) {
+      return await this.verifyRekorEntry(attestation.rekor_index);
+    }
+    return false;
+  }
+}
+
+module.exports = AegisClient;
+
