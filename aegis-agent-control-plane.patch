+      containers:
+      - name: agent
+        image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
+        imagePullPolicy: {{ .Values.image.pullPolicy }}
+        command: ["python", "-m", "api.golden_agent_controller_main"]
+        env:
+        - name: AEGIS_AGENT_POLL_INTERVAL_S
+          value: "{{ .Values.agent.pollSeconds }}"
+        - name: AEGIS_AGENT_WORKER_ID
+          value: "{{ .Values.agent.workerId }}"
+        {{- range $k, $v := .Values.env }}
+        - name: {{ $k }}
+          value: "{{ $v }}"
+        {{- end }}
+{{- end -}}
