@@ -0,0 +1,170 @@
+from __future__ import annotations
+
+from datetime import datetime
+
+from sqlalchemy import Column, DateTime, Integer, String, Text, JSON, Index
+
+from api.db import Base
+
+
+class AgentTask(Base):
+    """
+    A durable agent goal.
+
+    kinds:
+      - ops
+      - ml
+      - compliance
+      - unified (does all)
+    """
+    __tablename__ = "agent_tasks"
+
+    id = Column(String(100), primary_key=True)
+    tenant_id = Column(String(100), nullable=False, index=True)
+    kind = Column(String(50), nullable=False, default="unified")
+    goal = Column(Text, nullable=False)
+    constraints = Column(JSON, nullable=True)  # budgets, SLOs, safety thresholds, approvals policy
+    status = Column(String(50), nullable=False, default="queued")  # queued|running|paused|succeeded|failed|cancelled
+    priority = Column(Integer, nullable=False, default=0)
+    run_after = Column(DateTime, nullable=True)
+    started_at = Column(DateTime, nullable=True)
+    finished_at = Column(DateTime, nullable=True)
+    error = Column(Text, nullable=True)
+    output = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+    updated_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (
+        Index("ix_agent_tasks_tenant_status", "tenant_id", "status"),
+        Index("ix_agent_tasks_tenant_created", "tenant_id", "created_at"),
+    )
+
+
+class AgentStep(Base):
+    """
+    A durable record of an agent tool call / step.
+    """
+    __tablename__ = "agent_steps"
+
+    id = Column(String(100), primary_key=True)
+    tenant_id = Column(String(100), nullable=False, index=True)
+    task_id = Column(String(100), nullable=False, index=True)
+    step_no = Column(Integer, nullable=False)
+    tool = Column(String(200), nullable=False)
+    input = Column(JSON, nullable=True)
+    output = Column(JSON, nullable=True)
+    status = Column(String(50), nullable=False, default="queued")  # queued|running|succeeded|failed|skipped
+    error = Column(Text, nullable=True)
+    started_at = Column(DateTime, nullable=True)
+    finished_at = Column(DateTime, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (
+        Index("ix_agent_steps_task_stepno", "task_id", "step_no"),
+        Index("ix_agent_steps_tenant_created", "tenant_id", "created_at"),
+    )
diff --git a/api/golden_agent_tools.py b/api/golden_agent_tools.py
new file mode 100644
index 0000000..d8dfe10
--- /dev/null
+++ b/api/golden_agent_tools.py
@@ -0,0 +1,278 @@
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Any, Callable, Dict, Optional
+
+from fastapi import HTTPException
+
+from api.db import SessionLocal
+from api.golden_audit import record_audit_event
+from api.golden_models import Deployment, RolloutPolicy, Rollout, Run, ModelVersion
+from api.golden_compliance_export import export_compliance_bundle
+from api.golden_rollout_controller import tick_controller
+
+
+@dataclass(frozen=True)
+class Tool:
+    name: str
+    description: str
+    risk: str  # low|medium|high
+    fn: Callable[[str, Dict[str, Any]], Dict[str, Any]]  # (tenant_id, args) -> result
+
+
+def _require_env(flag: str, default: str = "true") -> bool:
+    return os.environ.get(flag, default).lower() == "true"
+
+
+def _tool_rollout_create(tenant_id: str, args: Dict[str, Any]) -> Dict[str, Any]:
+    rollout_id = args["rollout_id"]
+    return {"ok": True, "rollout_id": rollout_id}
+
+
+def _tool_rollout_tick(tenant_id: str, args: Dict[str, Any]) -> Dict[str, Any]:
+    tick_controller()
+    return {"ok": True}
+
+
+def _tool_compliance_export(tenant_id: str, args: Dict[str, Any]) -> Dict[str, Any]:
+    days = int(args.get("days", 7))
+    uri = export_compliance_bundle(tenant_id, days=days)
+    return {"bundle_uri": uri}
+
+
+def _tool_set_autoscaling(tenant_id: str, args: Dict[str, Any]) -> Dict[str, Any]:
+    """
+    Safe tool stub. Actual HPA upsert already exists in API endpoint.
+    Agent should call the public endpoint in a real deployment; for in-process controller
+    we keep tool registry minimal and only allow low-risk operations.
+    """
+    return {"ok": True, "note": "autoscaling is configured via API endpoint /v1/deployments/{id}/autoscaling"}
+
+
+def _tool_noop(tenant_id: str, args: Dict[str, Any]) -> Dict[str, Any]:
+    return {"ok": True}
+
+
+def registry() -> Dict[str, Tool]:
+    """
+    Safe tool registry. Keep this allowlist small.
+    """
+    return {
+        "rollout.tick": Tool(
+            name="rollout.tick",
+            description="Run one reconciliation tick of the rollout controller",
+            risk="low",
+            fn=_tool_rollout_tick,
+        ),
+        "compliance.export": Tool(
+            name="compliance.export",
+            description="Export compliance bundle to S3",
+            risk="low",
+            fn=_tool_compliance_export,
+        ),
+        "autoscaling.set": Tool(
+            name="autoscaling.set",
+            description="Set autoscaling configuration (delegated to API endpoint)",
+            risk="medium",
+            fn=_tool_set_autoscaling,
+        ),
+        "noop": Tool(
+            name="noop",
+            description="No operation",
+            risk="low",
+            fn=_tool_noop,
+        ),
+    }
+
+
+def run_tool(
+    tenant_id: str,
+    actor_sub: str,
+    tool_name: str,
+    args: Dict[str, Any],
+    *,
+    allow_high_risk: bool = False,
+) -> Dict[str, Any]:
+    tools = registry()
+    t = tools.get(tool_name)
+    if not t:
+        raise HTTPException(status_code=400, detail=f"tool not allowed: {tool_name}")
+    if t.risk == "high" and not allow_high_risk:
+        raise HTTPException(status_code=403, detail="high risk tool requires approval")
+    out = t.fn(tenant_id, args)
+    record_audit_event(tenant_id, actor_sub, "agent.tool", "tool", tool_name, decision="allow", details={"args": args, "result": out})
+    return out
diff --git a/api/golden_agent_workflows.py b/api/golden_agent_workflows.py
new file mode 100644
index 0000000..7c6a41f
--- /dev/null
+++ b/api/golden_agent_workflows.py
@@ -0,0 +1,265 @@
+from __future__ import annotations
+
+import os
+import time
+from datetime import datetime
+from typing import Any, Dict, Optional
+
+from api.db import SessionLocal
+from api.golden_models import (
+    Deployment,
+    RolloutPolicy,
+    Rollout,
+    ModelVersion,
+    UsageRecord,
+)
+from api.golden_audit import record_audit_event
+from api.golden_rollout_controller import tick_controller
+from api.golden_reporting import usage_summary
+from api.golden_compliance_export import export_compliance_bundle
+
+
+def unified_autonomy_workflow(tenant_id: str, actor_sub: str, args: Dict[str, Any]) -> Dict[str, Any]:
+    """
+    One complete end-to-end autonomous workflow:
+
+    (ML)   Ensure canary model version has offline eval pass (eval_status=pass) + optional metric thresholds.
+    (OPS)  Create rollout (stable+canary) and let controller shift traffic; rollback/promote is automatic.
+    (OPS)  Produce an ops summary (usage report last N days).
+    (COMP) Export compliance bundle to S3.
+
+    Inputs:
+      - stable_deployment_id
+      - canary_deployment_id
+      - policy_name (optional; default "default")
+      - policy_config (optional dict)
+      - compliance_days (optional)
+    """
+    stable_id = args["stable_deployment_id"]
+    canary_id = args["canary_deployment_id"]
+    policy_name = str(args.get("policy_name") or "default")
+    policy_config = args.get("policy_config") or {}
+    compliance_days = int(args.get("compliance_days", 7))
+
+    s = SessionLocal()
+    try:
+        stable = s.query(Deployment).filter_by(id=stable_id, tenant_id=tenant_id).one_or_none()
+        canary = s.query(Deployment).filter_by(id=canary_id, tenant_id=tenant_id).one_or_none()
+        if not stable or not canary:
+            raise RuntimeError("stable/canary deployment not found")
+
+        # (ML) offline gate check
+        mv = s.query(ModelVersion).filter_by(id=canary.model_version_id, tenant_id=tenant_id).one_or_none()
+        if not mv or mv.eval_status not in ("pass", "passed"):
+            raise RuntimeError("canary model version has not passed offline eval")
+
+        # Ensure policy exists (idempotent by name)
+        pol = s.query(RolloutPolicy).filter_by(tenant_id=tenant_id, name=policy_name).one_or_none()
+        if not pol:
+            import uuid
+            pol = RolloutPolicy(id=str(uuid.uuid4()), tenant_id=tenant_id, name=policy_name, config=policy_config)
+            s.add(pol)
+            s.commit()
+
+        # Create rollout
+        import uuid
+        rid = str(uuid.uuid4())
+        r = Rollout(
+            id=rid,
+            tenant_id=tenant_id,
+            policy_id=pol.id,
+            model_id=mv.model_id,
+            stable_deployment_id=stable.id,
+            canary_deployment_id=canary.id,
+            status="canary",
+            weights={"stable": 99, "canary": 1},
+            details={"created_by": "agent", "actor_sub": actor_sub},
+        )
+        s.add(r)
+        s.commit()
+        record_audit_event(tenant_id, actor_sub, "agent.rollout.create", "rollout", rid, decision="allow", details=r.weights)
+
+        # Run a few controller ticks immediately (quick-start), then exit (controller deployment keeps going).
+        for _ in range(int(os.environ.get("AEGIS_AGENT_BOOTSTRAP_TICKS", "3"))):
+            tick_controller()
+            time.sleep(1.0)
+
+        # Ops summary
+        ops = usage_summary(tenant_id, days=int(args.get("usage_days", 1)))
+
+        # Compliance export
+        bundle_uri = export_compliance_bundle(tenant_id, days=compliance_days)
+        record_audit_event(tenant_id, actor_sub, "agent.compliance.export", "tenant", tenant_id, decision="allow", details={"bundle_uri": bundle_uri})
+
+        return {"rollout_id": rid, "ops_summary": ops, "compliance_bundle_uri": bundle_uri}
+    finally:
+        s.close()
