+++ b/api/golden_agent_controller_main.py
@@ -0,0 +1,222 @@
+"""
+Out-of-process Aegis Agent Controller.
+
+This worker:
+  - polls agent_tasks
+  - executes a safe workflow (unified_autonomy_workflow)
+  - records agent_steps
+
+Run as its own Deployment via Helm.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+import uuid
+from datetime import datetime
+from typing import Any, Dict
+
+from api.db import SessionLocal
+from api.golden_agent_models import AgentTask, AgentStep
+from api.golden_agent_workflows import unified_autonomy_workflow
+from api.golden_audit import record_audit_event
+
+
+POLL_S = int(os.environ.get("AEGIS_AGENT_POLL_INTERVAL_S", "5"))
+CLAIM_TASKS = os.environ.get("AEGIS_AGENT_CLAIM_TASKS", "true").lower() == "true"
+WORKER_ID = os.environ.get("AEGIS_AGENT_WORKER_ID", f"agent-{uuid.uuid4().hex[:8]}")
+
+
+def _now() -> datetime:
+    return datetime.utcnow()
+
+
+def _claim_one_task(s) -> AgentTask | None:
+    # Extremely simple "claim" logic; for production use SKIP LOCKED.
+    t = (
+        s.query(AgentTask)
+        .filter(AgentTask.status == "queued")
+        .order_by(AgentTask.priority.desc(), AgentTask.created_at.asc())
+        .first()
+    )
+    if not t:
+        return None
+    t.status = "running"
+    t.started_at = _now()
+    t.updated_at = _now()
+    s.commit()
+    return t
+
+
+def _step(s, tenant_id: str, task_id: str, step_no: int, tool: str, inp: Dict[str, Any]) -> AgentStep:
+    st = AgentStep(
+        id=str(uuid.uuid4()),
+        tenant_id=tenant_id,
+        task_id=task_id,
+        step_no=step_no,
+        tool=tool,
+        input=inp,
+        status="running",
+        started_at=_now(),
+    )
+    s.add(st)
+    s.commit()
+    return st
+
+
+def run_once() -> None:
+    s = SessionLocal()
+    try:
+        t = _claim_one_task(s)
+        if not t:
+            return
+
+        actor_sub = f"agent:{WORKER_ID}"
+        record_audit_event(t.tenant_id, actor_sub, "agent.task.start", "agent_task", t.id, decision="allow", details={"kind": t.kind})
+
+        try:
+            # Single end-to-end workflow (step 1)
+            st = _step(s, t.tenant_id, t.id, 1, "workflow.unified_autonomy", {"constraints": t.constraints})
+            args = dict(t.constraints or {})
+            out = unified_autonomy_workflow(t.tenant_id, actor_sub, args=args)
+            st.status = "succeeded"
+            st.output = out
+            st.finished_at = _now()
+            s.commit()
+
+            t.status = "succeeded"
+            t.output = out
+            t.finished_at = _now()
+            t.updated_at = _now()
+            s.commit()
+            record_audit_event(t.tenant_id, actor_sub, "agent.task.finish", "agent_task", t.id, decision="allow", details={"status": "succeeded"})
+        except Exception as e:
+            st = _step(s, t.tenant_id, t.id, 99, "workflow.error", {"error": str(e)})
+            st.status = "failed"
+            st.error = str(e)
+            st.finished_at = _now()
+            s.commit()
+            t.status = "failed"
+            t.error = str(e)
+            t.finished_at = _now()
+            t.updated_at = _now()
+            s.commit()
+            record_audit_event(t.tenant_id, actor_sub, "agent.task.finish", "agent_task", t.id, decision="deny", details={"status": "failed", "error": str(e)})
+    finally:
+        s.close()
+
+
+def main() -> None:
+    while True:
+        try:
+            run_once()
+        except Exception:
+            pass
+        time.sleep(POLL_S)
+
+
+if __name__ == "__main__":
+    main()
