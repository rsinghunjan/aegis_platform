+
+
+@app.post("/v1/agent/tasks")
+async def agent_create_task(
+    request: Request,
+    kind: str = Form("unified"),
+    goal: str = Form(...),
+    constraints: Optional[str] = Form(None),
+    priority: int = Form(0),
+):
+    """
+    Create an agent task. constraints is JSON string, and should include:
+      - stable_deployment_id
+      - canary_deployment_id
+      - policy_name/policy_config (optional)
+      - compliance_days (optional)
+      - usage_days (optional)
+    """
+    import json
+
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "platform_admin"])
+    s = SessionLocal()
+    try:
+        tid = str(uuid.uuid4())
+        c = json.loads(constraints) if constraints else {}
+        t = AgentTask(
+            id=tid,
+            tenant_id=actor.tenant_id,
+            kind=kind,
+            goal=goal,
+            constraints=c,
+            status="queued",
+            priority=int(priority),
+        )
+        s.add(t)
+        s.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "agent.task.create", "agent_task", tid, decision="allow", details={"kind": kind})
+        return {"task_id": tid, "status": "queued"}
+    finally:
+        s.close()
+
+
+@app.get("/v1/agent/tasks/{task_id}")
+async def agent_get_task(request: Request, task_id: str):
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "platform_admin"])
+    s = SessionLocal()
+    try:
+        t = s.query(AgentTask).filter_by(id=task_id, tenant_id=actor.tenant_id).one_or_none()
+        if not t:
+            raise HTTPException(status_code=404, detail="task not found")
+        return {
+            "task_id": t.id,
+            "status": t.status,
+            "goal": t.goal,
+            "constraints": t.constraints,
+            "output": t.output,
+            "error": t.error,
+            "created_at": t.created_at,
+            "updated_at": t.updated_at,
+        }
+    finally:
+        s.close()
