@@ -0,0 +1,257 @@
+from __future__ import annotations
+
+import json
+import os
+from typing import Any, Dict, List, Optional, Tuple
+
+import httpx
+
+
+PLANNER_MODEL = os.environ.get("AEGIS_AGENT_PLANNER_MODEL", "gpt-4o-mini")
+PLANNER_URL = os.environ.get("AEGIS_AGENT_PLANNER_URL", "").rstrip("/")  # optional: external LLM endpoint
+PLANNER_TIMEOUT_S = float(os.environ.get("AEGIS_AGENT_PLANNER_TIMEOUT_S", "20"))
+
+
+def _system_prompt(allowed_tools: List[str]) -> str:
+    return (
+        "You are the Aegis Agent Planner. Produce a JSON plan only.\n"
+        "You must output a single JSON object with schema 'aegis.agent.plan.v1'.\n"
+        "Use ONLY allowed tools. Do not invent tools.\n"
+        "Prefer safe diagnostics first, then low-risk remediation, then escalation for high-risk.\n"
+        f"Allowed tools: {allowed_tools}\n"
+        "Plan format:\n"
+        "{'schema':'aegis.agent.plan.v1','graph':{'start':'n1','nodes':[{'id':'n1','tool':'...','input':{},'risk':'low','on_success':['n2'],'on_failure':['nX']}]},"  # noqa: E501
+        "'budgets':{'max_cost_usd':10,'max_minutes':30},'approvals':{'require_high_risk':true}}"
+    )
+
+
+def _fallback_plan(goal: str, allowed_tools: List[str]) -> Dict[str, Any]:
+    """
+    Deterministic minimal plan when no external planner is configured.
+    """
+    nodes = []
+    nid = 1
+    def add(tool, inp, risk="low", ok=None, bad=None):
+        nonlocal nid
+        i = f"n{nid}"
+        nid += 1
+        nodes.append({"id": i, "tool": tool, "input": inp, "risk": risk, "on_success": ok or [], "on_failure": bad or []})
+        return i
+
+    # 1) perception
+    n1 = add("signals.prometheus.query", {"query": "sum(rate(aegis_infer_error_total[5m]))"}, "low")
+    n2 = add("signals.prometheus.query", {"query": "histogram_quantile(0.95, sum(rate(aegis_canary_p95_ms_bucket[5m])) by (le))"}, "low")
+    n3 = add("signals.prometheus.query", {"query": "sum(rate(aegis_safety_block_total[5m]))"}, "low")
+    # 2) diagnose
+    n4 = add("diagnose.latency", {"window_minutes": 10}, "low")
+    # 3) remediate (safe)
+    n5 = add("ops.autoscaling.recommend", {"mode": "inference"}, "low")
+    # 4) compliance
+    n6 = add("compliance.export", {"days": 7}, "low")
+    # link linearly
+    for i in range(len(nodes) - 1):
+        nodes[i]["on_success"] = [nodes[i + 1]["id"]]
+        nodes[i]["on_failure"] = [nodes[i + 1]["id"]]
+
+    return {
+        "schema": "aegis.agent.plan.v1",
+        "graph": {"start": nodes[0]["id"], "nodes": nodes},
+        "budgets": {"max_cost_usd": 10.0, "max_minutes": 30},
+        "approvals": {"require_high_risk": True},
+        "meta": {"planner": "fallback", "goal": goal},
+    }
+
+
+async def plan_with_llm(goal: str, allowed_tools: List[str]) -> Dict[str, Any]:
+    """
+    If AEGIS_AGENT_PLANNER_URL is set, call it as OpenAI-compatible chat completions endpoint.
+    Otherwise, return fallback plan.
+    """
+    if not PLANNER_URL:
+        return _fallback_plan(goal, allowed_tools)
+
+    sys = _system_prompt(allowed_tools)
+    body = {
+        "model": PLANNER_MODEL,
+        "messages": [
+            {"role": "system", "content": sys},
+            {"role": "user", "content": goal},
+        ],
+        "temperature": 0.0,
+        "response_format": {"type": "json_object"},
+    }
+    async with httpx.AsyncClient(timeout=PLANNER_TIMEOUT_S) as client:
+        r = await client.post(f"{PLANNER_URL}/v1/chat/completions", json=body)
+        r.raise_for_status()
+        data = r.json()
+    # Extract content
+    content = (((data.get("choices") or [])[0] or {}).get("message") or {}).get("content")
+    if not isinstance(content, str):
+        return _fallback_plan(goal, allowed_tools)
+    try:
+        return json.loads(content)
+    except Exception:
+        return _fallback_plan(goal, allowed_tools)
diff --git a/api/golden_agent_executor.py b/api/golden_agent_executor.py
new file mode 100644
index 0000000..413d4d6
--- /dev/null
+++ b/api/golden_agent_executor.py
@@ -0,0 +1,370 @@
+from __future__ import annotations
+
+import time
+import uuid
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from typing import Any, Dict, List, Optional
+
+from fastapi import HTTPException
+
+from api.db import SessionLocal
+from api.golden_audit import record_audit_event
+from api.golden_agent_models import AgentPlan, AgentStep, AgentTask
+from api.golden_agent_tools import run_tool, registry as tool_registry
+from api.golden_reporting import usage_summary, audit_summary
+
+
+def _now() -> datetime:
+    return datetime.utcnow()
+
+
+def _index_nodes(plan: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
+    nodes = (((plan.get("graph") or {}).get("nodes")) or [])
+    out = {}
+    for n in nodes:
+        if isinstance(n, dict) and "id" in n:
+            out[str(n["id"])] = n
+    return out
+
+
+def _validate_plan(plan: Dict[str, Any], allowed_tools: List[str]) -> None:
+    if plan.get("schema") != "aegis.agent.plan.v1":
+        raise HTTPException(status_code=400, detail="invalid plan schema")
+    graph = plan.get("graph") or {}
+    if "start" not in graph:
+        raise HTTPException(status_code=400, detail="plan missing graph.start")
+    nodes = graph.get("nodes") or []
+    if not isinstance(nodes, list) or not nodes:
+        raise HTTPException(status_code=400, detail="plan graph.nodes empty")
+    for n in nodes:
+        if not isinstance(n, dict):
+            raise HTTPException(status_code=400, detail="plan node must be object")
+        tool = n.get("tool")
+        if tool and tool not in allowed_tools:
+            raise HTTPException(status_code=400, detail=f"tool not allowed in plan: {tool}")
+        risk = str(n.get("risk") or "low")
+        if risk not in ("low", "medium", "high"):
+            raise HTTPException(status_code=400, detail="invalid risk value")
+
+
+def _budget_ok(start: datetime, plan: Dict[str, Any]) -> bool:
+    b = plan.get("budgets") or {}
+    max_minutes = float(b.get("max_minutes", 30))
+    return (_now() - start) <= timedelta(minutes=max_minutes)
+
+
+def execute_plan(
+    tenant_id: str,
+    actor_sub: str,
+    task_id: str,
+    plan_id: str,
+    *,
+    allow_high_risk: bool,
+) -> Dict[str, Any]:
+    """
+    Executes plan graph by following on_success/on_failure edges.
+    Tools are executed exclusively through the allowlisted registry for uniform logging.
+
+    Self-correction:
+      - if a step fails, follow on_failure edge
+      - if budgets exceeded, stop and mark task as failed with escalation hint
+    """
+    tools = tool_registry()
+    allowed = list(tools.keys()) + [
+        # "virtual" tools (implemented in executor directly)
+        "diagnose.latency",
+        "ops.autoscaling.recommend",
+        "reports.usage",
+        "reports.audit",
+        "escalate.approval_request",
+    ]
+
+    s = SessionLocal()
+    start = _now()
+    try:
+        t = s.query(AgentTask).filter_by(id=task_id, tenant_id=tenant_id).one_or_none()
+        p = s.query(AgentPlan).filter_by(id=plan_id, tenant_id=tenant_id, task_id=task_id).one_or_none()
+        if not t or not p:
+            raise RuntimeError("task/plan not found")
+
+        plan = p.plan
+        _validate_plan(plan, allowed_tools=allowed)
+        nodes = _index_nodes(plan)
+        current_id = str(((plan.get("graph") or {}).get("start")) or "")
+        visited = set()
+        step_no = 1
+        results: Dict[str, Any] = {"executed": []}
+
+        p.status = "running"
+        p.updated_at = _now()
+        t.status = "running"
+        t.updated_at = _now()
+        s.commit()
+
+        while current_id:
+            if current_id in visited:
+                raise RuntimeError("cycle detected in plan")
+            visited.add(current_id)
+            if not _budget_ok(start, plan):
+                # escalation path
+                results["error"] = "budget_exceeded"
+                break
+
+            node = nodes.get(current_id)
+            if not node:
+                raise RuntimeError(f"unknown node id: {current_id}")
+
+            tool = str(node.get("tool") or "")
+            inp = node.get("input") or {}
+            risk = str(node.get("risk") or "low")
+
+            st = AgentStep(
+                id=str(uuid.uuid4()),
+                tenant_id=tenant_id,
+                task_id=task_id,
+                step_no=step_no,
+                tool=tool,
+                input=inp,
+                status="running",
+                started_at=_now(),
+            )
+            s.add(st)
+            s.commit()
+
+            ok = True
+            out: Dict[str, Any] = {}
+            err: Optional[str] = None
+            try:
+                if tool in tools:
+                    out = run_tool(tenant_id, actor_sub, tool, dict(inp), allow_high_risk=allow_high_risk)
+                elif tool == "diagnose.latency":
+                    # simple diagnosis using last usage summary; expand with traces later
+                    out = {"hint": "check p95 latency, consider scaling or rollback; traces integration pending", "window_minutes": int(inp.get("window_minutes", 10))}
+                elif tool == "ops.autoscaling.recommend":
+                    out = {"recommendation": "increase max replicas and tune HPA/KEDA on token rate; GPU metrics via DCGM exporter recommended"}
+                elif tool == "reports.usage":
+                    out = usage_summary(tenant_id, days=int(inp.get("days", 1)))
+                elif tool == "reports.audit":
+                    out = audit_summary(tenant_id, days=int(inp.get("days", 1)))
+                elif tool == "escalate.approval_request":
+                    # self-correction escalation: request human approval for high-risk
+                    ok = False
+                    err = "approval_required"
+                    out = {"required": True, "message": "human approval required for high-risk remediation"}
+                else:
+                    raise HTTPException(status_code=400, detail=f"unknown tool: {tool}")
+            except Exception as e:
+                ok = False
+                err = str(e)
+
+            st.status = "succeeded" if ok else "failed"
+            st.output = out
+            st.error = err
+            st.finished_at = _now()
+            s.commit()
+
+            results["executed"].append({"node": current_id, "tool": tool, "ok": ok, "output": out, "error": err})
+            step_no += 1
+
+            # self-correction routing
+            next_ids = node.get("on_success") if ok else node.get("on_failure")
+            if isinstance(next_ids, list) and next_ids:
+                current_id = str(next_ids[0])
+            else:
+                current_id = ""
+
+        if results.get("error") == "budget_exceeded":
+            p.status = "failed"
+            t.status = "paused"
+            t.error = "budget exceeded; escalation required"
+        else:
+            p.status = "completed"
+            t.status = "succeeded"
+            t.output = results
+
+        p.updated_at = _now()
+        t.updated_at = _now()
+        s.commit()
+
+        record_audit_event(tenant_id, actor_sub, "agent.plan.execute", "agent_plan", plan_id, decision="allow", details={"task_id": task_id, "status": p.status})
+        return results
+    finally:
+        s.close()
