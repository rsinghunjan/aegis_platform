new file mode 100644
index 0000000..b002c5c
--- /dev/null
+++ b/api/golden_prometheus.py
@@ -0,0 +1,121 @@
+from __future__ import annotations
+
+import os
+from typing import Any, Dict, Optional
+
+import httpx
+
+
+PROM_URL = os.environ.get("AEGIS_PROMETHEUS_URL", "").rstrip("/")
+PROM_TIMEOUT_S = float(os.environ.get("AEGIS_PROMETHEUS_TIMEOUT_S", "5"))
+PROM_BEARER_TOKEN = os.environ.get("AEGIS_PROMETHEUS_BEARER_TOKEN", "")
+
+
+class PrometheusUnavailable(RuntimeError):
+    pass
+
+
+async def prom_query(query: str) -> Dict[str, Any]:
+    if not PROM_URL:
+        raise PrometheusUnavailable("AEGIS_PROMETHEUS_URL is not set")
+    headers = {}
+    if PROM_BEARER_TOKEN:
+        headers["Authorization"] = f"Bearer {PROM_BEARER_TOKEN}"
+    async with httpx.AsyncClient(timeout=PROM_TIMEOUT_S) as client:
+        r = await client.get(f"{PROM_URL}/api/v1/query", params={"query": query}, headers=headers)
+        r.raise_for_status()
+        return r.json()
