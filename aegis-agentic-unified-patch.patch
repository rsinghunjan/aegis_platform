+#!/usr/bin/env python3
+"""
+Create an evidence bundle for agent/tool execution, optionally sign with cosign.
+
+Produces a JSON file with:
+ - metadata: agent_id, tool_id, model_version, timestamps
+ - inputs: prompt, plan, args
+ - outputs: stdout/stderr, exit_code
+ - artifacts: pointers to logs, traces
+
+If COSIGN_KEY env var is set, attempts to sign the bundle with `cosign sign-blob`.
+"""
+import os
+import json
+import time
+import subprocess
+from pathlib import Path
+
+OUT_DIR = Path(os.environ.get("EVIDENCE_DIR", "/tmp/aegis_evidence"))
+OUT_DIR.mkdir(parents=True, exist_ok=True)
+
+
+def bundle_evidence(metadata: dict, inputs: dict, outputs: dict, artifacts: dict = None):
+    ts = int(time.time())
+    bundle = {
+        "metadata": metadata,
+        "inputs": inputs,
+        "outputs": outputs,
+        "artifacts": artifacts or {},
+        "timestamp": ts
+    }
+    fname = OUT_DIR / f"evidence_{metadata.get('run_id','run')}_{ts}.json"
+    with open(fname, "w") as fh:
+        json.dump(bundle, fh, indent=2)
+    # Optionally sign
+    cosign_key = os.environ.get("COSIGN_KEY")
+    if cosign_key:
+        try:
+            subprocess.run(["cosign", "sign-blob", "--key", cosign_key, str(fname)], check=True)
+        except Exception:
+            # signing should not block evidence creation
+            print("cosign sign failed (non-fatal)")
+    return str(fname)
+
+
+if __name__ == "__main__":
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--agent-id", required=True)
+    ap.add_argument("--tool-id", required=True)
+    ap.add_argument("--run-id", default="run")
+    ap.add_argument("--stdout", default="")
+    ap.add_argument("--stderr", default="")
+    args = ap.parse_args()
+    metadata = {"agent_id": args.agent_id, "tool_id": args.tool_id, "run_id": args.run_id}
+    inputs = {"example": True}
+    outputs = {"stdout": args.stdout, "stderr": args.stderr, "exit_code": 0}
+    path = bundle_evidence(metadata, inputs, outputs)
+    print("Wrote evidence to", path)
+
