+#!/usr/bin/env python3
+"""
+Stub for approver mediator integration.
+ - POST to approver with evidence link and requested action.
+ - Waits (poll) for approval result. In production, use webhook callbacks and shorter polling.
+"""
+import os
+import time
+import requests
+
+APPROVER_URL = os.environ.get("APPROVER_URL", "http://approver-signing.aegis-system.svc.cluster.local:8080/approve")
+
+
+def request_approval(evidence_url: str, action: dict, required_signers: int = 2, timeout_s: int = 300):
+    payload = {"evidence": evidence_url, "action": action, "required": required_signers}
+    r = requests.post(APPROVER_URL, json=payload, timeout=5)
+    if r.status_code not in (200, 202):
+        return False, "request_failed"
+    req_id = r.json().get("request_id")
+    # poll (placeholder)
+    start = time.time()
+    while time.time() - start < timeout_s:
+        st = requests.get(f"{APPROVER_URL}/{req_id}", timeout=5)
+        if st.status_code == 200:
+            resp = st.json()
+            if resp.get("state") == "approved":
+                return True, resp
+            if resp.get("state") == "rejected":
+                return False, resp
+        time.sleep(5)
+    return False, "timeout"
+
+
+if __name__ == "__main__":
+    import argparse, json
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--evidence", required=True)
+    ap.add_argument("--action", required=True)
+    args = ap.parse_args()
+    ok, resp = request_approval(args.evidence, json.loads(args.action))
+    print(ok, resp)
