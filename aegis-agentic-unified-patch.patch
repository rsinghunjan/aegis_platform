+#!/usr/bin/env python3
+"""
+Simple plan verifier:
+ - Validates structure of the plan
+ - Calls OPA PDP for each tool usage to ensure allowed
+ - If any high-risk action is present without approval, returns deny
+"""
+import os
+import requests
+import json
+
+OPA_ALLOW_URL = os.environ.get("OPA_ALLOW_URL", "http://opa.aegis-system.svc.cluster.local:8181/v1/data/aegis/agent/allow")
+
+
+def verify_plan(plan: dict, agent_role: str, env: str = "staging"):
+    # plan: {"steps": [{"tool_id": "...", "args": {...}, "requires_approval": bool}, ...]}
+    for step in plan.get("steps", []):
+        action = {"tool_id": step.get("tool_id"), "args": step.get("args", {})}
+        payload = {"input": {"agent_role": agent_role, "action": action, "env": env}}
+        r = requests.post(OPA_ALLOW_URL, json=payload, timeout=5)
+        if r.status_code != 200:
+            return False, f"opa_err:{r.status_code}"
+        res = r.json()
+        allow = res.get("result", False)
+        if not allow:
+            return False, f"opa_deny:{step.get('tool_id')}"
+    return True, "ok"
+
+
+if __name__ == "__main__":
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--agent-role", default="dev-agent")
+    args = ap.parse_args()
+    plan = json.load(open(args.plan_file))
+    ok, reason = verify_plan(plan, args.agent_role)
+    print(ok, reason)
+    if not ok:
+        raise SystemExit(2)
+
