+package aegis.agent
+"""
+OPA policy for agent tool capability enforcement.
+
+Data dependency: data.capabilities should map agent_role -> [tool_ids]
+Data example (store in OPA data or ConfigMap):
+{
+  "capabilities": {
+    "dev-agent": ["read.fs", "http.get", "tool.inspect"],
+    "ops-agent": ["infra.deploy", "infra.scale", "http.get"]
+  }
+}
+"""
+
+default allow = false
+
+allow {
+  some i
+  input.agent_role   # e.g., "dev-agent"
+  input.action
+  capabilities := data.capabilities[input.agent_role]
+  capabilities != null
+  capabilities[_] == input.action.tool_id
+  not deny_by_constraint[input.action]
+}
+
+deny_by_constraint[action] {
+  # Example constraint: block infra.deploy in prod unless approval present
+  action.tool_id == "infra.deploy"
+  input.env == "prod"
+  not input.approval.token
+}
+
+# Enforce argument schema if available in data.tool_schemas
+arg_schema_violation {
+  schema := data.tool_schemas[input.action.tool_id]
+  schema != null
+  not validate_args(schema, input.action.args)
+}
+
+validate_args(schema, args) {
+  # Placeholder: keep simple structural checks in Rego or validate upstream
+  count(keys(args)) <= schema.max_args
+}
