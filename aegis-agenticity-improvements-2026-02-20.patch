+"""
+Adapter to the digital twin / simulator for plan testing.
+This file calls the system simulator (agent/simulator/*.py) or an external simulator.
+"""
+import requests
+import os
+from typing import List, Dict
+
+SIM_URL = os.environ.get("SIM_URL", "http://simulator.ml.svc.cluster.local:8700/v1/simulate")
+
+class SimulatorAdapter:
+    def __init__(self, url: str = SIM_URL):
+        self.url = url
+
+    def run_plan(self, plan: List[Dict], runs: int = 1):
+        """
+        Call simulator -> returns list of results for each run.
+        Expected result: [{ "ok": True, "details": ... }, ...]
+        """
+        payload = {"plan": plan, "runs": runs}
+        try:
+            r = requests.post(self.url, json=payload, timeout=30)
+            r.raise_for_status()
+            return r.json().get("results", [])
+        except Exception:
+            # conservative fallback -> indicate failure to simulate
+            return [{"ok": False, "error": "simulator-unavailable"}]
+
