+"""
+Signature flow for critical actions: request Vault transit signature and record Rekor attestation.
+Requires Vault HSM-backed transit key and Rekor write permissions.
+"""
+import os
+import httpx
+
+VAULT_SIGN_URL = os.environ.get("VAULT_SIGN_URL", "http://vault.vault.svc.cluster.local:8200/v1/transit/sign/aegis-transit")
+REKOR_URL = os.environ.get("REKOR_URL", "https://rekor.staging.internal")
+
+def sign_action_payload(payload: dict) -> dict:
+    # request vault sign
+    r = httpx.post(VAULT_SIGN_URL, json={"input": payload}, timeout=5)
+    r.raise_for_status()
+    sig = r.json()
+    # publish minimal proof to Rekor (placeholder)
+    hash_val = payload.get("hash") or ""
+    try:
+        entry = {"apiVersion":"0.0.1","kind":"hashedrekord","spec":{"data":{"hash":{"algorithm":"sha256","value":hash_val}}}}
+        httpx.post(f"{REKOR_URL}/api/v1/log", json=entry, timeout=5)
+    except Exception:
+        pass
+    return sig
+
