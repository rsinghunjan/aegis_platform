+"""
+Trace->Evidence correlation utilities.
+Records trace_id into MCP evidence payloads and persists via MCP API.
+"""
+import os
+import httpx
+from opentelemetry import trace
+
+MCP_URL = os.environ.get("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+
+def current_trace_id_hex():
+    span = trace.get_current_span()
+    ctx = span.get_span_context()
+    if not ctx or not ctx.trace_id:
+        return None
+    return format(ctx.trace_id, "032x")
+
+def persist_evidence_with_trace(evidence: dict):
+    """
+    Best-effort: attach trace_id to evidence.llm_call.trace_id and POST to MCP /model-context.
+    """
+    try:
+        tid = current_trace_id_hex()
+        if tid:
+            evidence.setdefault("llm_call", {})["trace_id"] = tid
+        httpx.post(f"{MCP_URL}/model-context", json=evidence, timeout=5)
+    except Exception:
+        # do not raise; evidence persistence should not block service
+        pass
+
