+"""
+Plan verification harness:
+ - Structural validation (schema)
+ - Simulator re-run of plan in digital twin (shadow)
+ - Learned scorer integration (placeholder) to re-rank proposals
+ - Produces 'verified' boolean and failure reasons
+"""
+import json
+from typing import List, Dict, Tuple
+from planner.simulator_adapter import SimulatorAdapter
+from planner.scorer import LearnedScorer
+
+sim = SimulatorAdapter()
+scorer = LearnedScorer()
+
+def validate_plan_schema(plan: List[Dict]) -> Tuple[bool, List[str]]:
+    reasons = []
+    if not isinstance(plan, list):
+        return False, ["plan-not-list"]
+    for idx, step in enumerate(plan):
+        if "name" not in step or "params" not in step:
+            reasons.append(f"step-{idx}-missing-fields")
+    return (len(reasons) == 0), reasons
+
+def simulate_and_score(plan: List[Dict], runs: int = 1) -> Tuple[bool, List[str], float]:
+    # Run plan in simulator; if any run fails -> flagged
+    sim_results = sim.run_plan(plan, runs=runs)
+    failed = [r for r in sim_results if not r.get("ok", True)]
+    score = scorer.score(plan)
+    reasons = []
+    if failed:
+        reasons.append("simulated-failure")
+    # additional heuristics: low score threshold
+    if score < 0.3:
+        reasons.append("low-scorer-score")
+    verified = (len(reasons) == 0)
+    return verified, reasons, score
+
