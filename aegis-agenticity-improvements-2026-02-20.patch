+"""
+Lightweight knowledge-graph service for agent memory/state.
+ - Simple REST API to upsert nodes/edges and query recent state
+ - Backed by a file-based store for the scaffold; replace with Neo4j or DGraph in prod
+"""
+from flask import Flask, request, jsonify
+import os, json, time
+
+DB_FILE = os.environ.get("KG_DB", "/data/kg_db.json")
+os.makedirs(os.path.dirname(DB_FILE), exist_ok=True)
+if not os.path.exists(DB_FILE):
+    json.dump({"nodes": [], "edges": []}, open(DB_FILE, "w"))
+
+app = Flask("kg")
+
+def load_db():
+    return json.load(open(DB_FILE))
+
+def save_db(d):
+    json.dump(d, open(DB_FILE, "w"), indent=2)
+
+@app.route("/v1/node", methods=["POST"])
+def add_node():
+    body = request.json
+    db = load_db()
+    node = {"id": body.get("id"), "type": body.get("type"), "props": body.get("props", {}), "ts": int(time.time())}
+    db["nodes"].append(node)
+    save_db(db)
+    return jsonify(node)
+
+@app.route("/v1/query_recent", methods=["GET"])
+def query_recent():
+    db = load_db()
+    nodes = sorted(db["nodes"], key=lambda n: n["ts"], reverse=True)[:50]
+    return jsonify(nodes)
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=8400)
+
