+#!/usr/bin/env python3
+"""
+Example training entrypoint that records evidence at start/finish and signs the produced artifact.
+This demonstrates using the Evidence SDK in an experiment CI job or in-cluster training job.
+"""
+import argparse
+import time
+from pathlib import Path
+from ops.sdk.evidence_sdk import record_manifest, sign_and_publish_model
+
+def dummy_train(epochs=1, out="/tmp/model.pt"):
+    # simulate training and emit a simple model file
+    for e in range(epochs):
+        print("Epoch", e+1)
+        time.sleep(0.5)
+    p = Path(out)
+    p.write_text("dummy-model-bytes")
+    return str(p)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--epochs", type=int, default=1)
+    p.add_argument("--out", default="/tmp/model.pt")
+    args = p.parse_args()
+    start_manifest = record_manifest("train_start", {"script":"train_with_evidence.py","epochs":args.epochs})
+    print("Recorded start manifest:", start_manifest)
+    model_path = dummy_train(args.epochs, args.out)
+    finish_manifest = record_manifest("train_finish", {"artifact": model_path})
+    print("Recorded finish manifest:", finish_manifest)
+    # sign & publish
+    res = sign_and_publish_model(model_path, {"trainer":"demo","epochs":args.epochs})
+    print("publish result:", res)
+
+if __name__=="__main__":
+    main()
+
