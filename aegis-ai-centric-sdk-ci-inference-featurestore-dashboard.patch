+#!/usr/bin/env python3
+"""
+Evidence SDK for model lifecycle operations.
+ - record_manifest: write a signed manifest locally and optionally queue for upload
+ - sign_and_publish_model: cosign-sign a model artifact, upload to S3, and register with Rekor
+ - best-effort / robust: logs and returns metadata for inclusion in evidence bundles
+
+Usage:
+  from ops.sdk.evidence_sdk import record_manifest, sign_and_publish_model
+  m = record_manifest("train_start", {"model":"toy","commit":"abc"})
+  sign_and_publish_model("/tmp/model.pt", {"model":"toy","commit":"abc"}, bucket="aegis-models")
+"""
+import json
+import os
+import subprocess
+from pathlib import Path
+import time
+
+PENDING_DIR = Path(os.environ.get("EVIDENCE_PENDING_DIR", "/tmp/evidence_pending"))
+PENDING_DIR.mkdir(parents=True, exist_ok=True)
+
+def _write_local_manifest(kind, payload):
+    ts = int(time.time())
+    manifest = {"kind": kind, "payload": payload, "ts": ts}
+    p = PENDING_DIR / f"manifest_{kind}_{ts}.json"
+    p.write_text(json.dumps(manifest, indent=2))
+    return str(p)
+
+def record_manifest(kind, payload):
+    """
+    Record a manifest locally and return the path. Best-effort call to safety_monitor.record_manifest if available.
+    """
+    try:
+        # best-effort: integrate with existing safety_monitor
+        from ops.autonomy.safety_monitor import record_manifest as rm
+        return rm(kind, payload)
+    except Exception:
+        return _write_local_manifest(kind, payload)
+
+def sign_and_publish_model(artifact_path, metadata, bucket=None, cosign_kms_uri=None, rekor_server=None):
+    """
+    Sign model artifact using cosign (KMS-backed) and upload to S3-compatible bucket; register with Rekor.
+    Returns dict with keys: s3_uri, cosign_ok, rekor_out, errors
+    """
+    out = {"s3_uri": None, "cosign_ok": False, "rekor_out": None, "errors": []}
+    art = Path(artifact_path)
+    if not art.exists():
+        out["errors"].append("artifact_missing")
+        return out
+    # write metadata sidecar
+    meta_path = art.with_suffix(art.suffix + ".meta.json")
+    meta_path.write_text(json.dumps(metadata, indent=2))
+    # cosign sign
+    cosign_kms_uri = cosign_kms_uri or os.environ.get("COSIGN_KMS_URI")
+    if not cosign_kms_uri:
+        out["errors"].append("no_cosign_kms")
+    else:
+        try:
+            subprocess.check_call(["cosign","sign","--key", cosign_kms_uri, str(art)])
+            out["cosign_ok"] = True
+        except Exception as e:
+            out["errors"].append(f"cosign_failed:{e}")
+    # upload to s3
+    bucket = bucket or os.environ.get("MODEL_ARTIFACT_BUCKET")
+    s3_endpoint = os.environ.get("EVIDENCE_S3_ENDPOINT")
+    if bucket:
+        try:
+            s3_uri = f"s3://{bucket.rstrip('/')}/{art.name}"
+            # if custom endpoint, use aws CLI with --endpoint-url
+            aws_cmd = ["aws","s3","cp", str(art), s3_uri]
+            if s3_endpoint:
+                aws_cmd = ["aws","s3","cp", str(art), s3_uri, "--endpoint-url", s3_endpoint]
+            subprocess.check_call(aws_cmd)
+            out["s3_uri"] = s3_uri
+        except Exception as e:
+            out["errors"].append(f"s3_upload_failed:{e}")
+    else:
+        out["errors"].append("no_bucket_configured")
+    # Rekor register
+    rekor_server = rekor_server or os.environ.get("REKOR_SERVER")
+    if rekor_server:
+        try:
+            ro = subprocess.check_output(["rekor-cli","upload","--artifact", str(art)], stderr=subprocess.STDOUT)
+            out["rekor_out"] = ro.decode()
+        except Exception as e:
+            out["errors"].append(f"rekor_failed:{e}")
+    else:
+        out["errors"].append("no_rekor_server")
+    return out
+
