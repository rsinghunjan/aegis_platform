+#!/usr/bin/env python3
+"""
+Streaming inference server that uses HuggingFace transformers as backend if available.
+ - Exposes the same Generation gRPC service for token-streaming.
+ - Supports pluggable backends: vLLM (if env VLLM=1) or HF pipeline fallback.
+"""
+import os
+import time
+from concurrent import futures
+import grpc
+
+try:
+    from ops.proto import generation_pb2, generation_pb2_grpc
+except Exception:
+    raise
+
+from ops.autonomy.safety_monitor import check_and_allow, record_manifest
+from ops.safety.content_filter import is_prompt_allowed
+from ops.safety.watermark import apply_watermark_to_tokens
+
+BACKEND = os.environ.get("INFERENCE_BACKEND", "HF")  # HF or VLLM
+
+def hf_generator(prompt, max_tokens):
+    # lazy import to reduce startup cost if not used
+    from transformers import pipeline, AutoTokenizer, AutoModelForCausalLM
+    # small model by default (can be overridden by env)
+    model_name = os.environ.get("HF_MODEL", "gpt2")
+    tok = AutoTokenizer.from_pretrained(model_name)
+    model = AutoModelForCausalLM.from_pretrained(model_name)
+    gen = pipeline("text-generation", model=model, tokenizer=tok, device=0 if os.environ.get("USE_GPU","0")=="1" else -1)
+    out = gen(prompt, max_new_tokens=max_tokens, return_full_text=False)
+    text = out[0].get("generated_text","")
+    # naive tokenization
+    for i,t in enumerate(text.split()):
+        yield t
+
+def serve(port=50054):
+    class Servicer(generation_pb2_grpc.GenerationServicer):
+        def StreamGenerate(self, request, context):
+            prompt = request.prompt or ""
+            max_tokens = request.max_tokens or 16
+            if not check_and_allow("generate", {"prompt_preview": prompt[:120]}):
+                record_manifest("generate_blocked", {"reason":"safety_monitor_rejected"})
+                context.set_code(grpc.StatusCode.PERMISSION_DENIED)
+                context.set_details("Blocked")
+                return
+            allowed, reasons = is_prompt_allowed(prompt)
+            if not allowed:
+                record_manifest("generate_blocked_content", {"reasons": reasons})
+                context.set_code(grpc.StatusCode.INVALID_ARGUMENT)
+                context.set_details("Prompt disallowed")
+                return
+            record_manifest("generate_request", {"prompt": prompt[:1024]})
+            if BACKEND == "VLLM":
+                # placeholder for vLLM integration; in production, stream tokens from vLLM's generator
+                gen = (f"vllm_tok{i}" for i in range(max_tokens))
+            else:
+                gen = hf_generator(prompt, max_tokens)
+            for idx, token in enumerate(gen):
+                t = generation_pb2.Token(token=apply_watermark_to_tokens([token])[0], index=idx)
+                yield t
+                time.sleep(0.02)
+
+        def Generate(self, request, context):
+            tokens = []
+            for t, _ in self.StreamGenerate(request, context):
+                tokens.append(t)
+            record_manifest("generate_response", {"tokens": len(tokens)})
+            return generation_pb2.GenerationResponse(tokens=tokens, message="ok")
+
+    server = grpc.server(futures.ThreadPoolExecutor(max_workers=8))
+    generation_pb2_grpc.add_GenerationServicer_to_server(Servicer(), server)
+    server.add_insecure_port(f"[::]:{port}")
+    print("Starting inference server on port", port, "backend:", BACKEND)
+    server.start()
+    try:
+        server.wait_for_termination()
+    except KeyboardInterrupt:
+        server.stop(0)
+
+if __name__=="__main__":
+    serve()
+
