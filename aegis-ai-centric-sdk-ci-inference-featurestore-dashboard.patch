+#!/usr/bin/env python3
+"""
+Simplified client to stream tokens from inference_server_hf.py
+"""
+import time
+import grpc
+from ops.proto import generation_pb2, generation_pb2_grpc
+
+def stream(host="127.0.0.1", port=50054, prompt="hello world", max_tokens=32):
+    ch = grpc.insecure_channel(f"{host}:{port}")
+    stub = generation_pb2_grpc.GenerationStub(ch)
+    req = generation_pb2.GenerationRequest(prompt=prompt, max_tokens=max_tokens, stream=True)
+    for tok in stub.StreamGenerate(req, timeout=120):
+        print(tok.index, tok.token)
+
+if __name__=="__main__":
+    stream()
+
