+#!/usr/bin/env python3
+"""
+Minimal Feast connector helper for feature ingestion / online store writes.
+Requires Feast installed and configured to point to your feature store.
+"""
+from datetime import datetime
+from feast import FeatureStore, Entity
+import os
+
+def push_features(feature_repo_path, entity_id, features: dict):
+    """
+    feature_repo_path: path to a Feast repo or feature store.yaml
+    entity_id: string id for entity
+    features: dict of feature_name: value
+    """
+    store = FeatureStore(repo_path=feature_repo_path)
+    entity_row = {**features}
+    entity_row["event_timestamp"] = datetime.utcnow()
+    entity_row["entity_id"] = entity_id
+    # Requires that Feast feature view and entity are configured already.
+    store.write_feaature_rows([entity_row], "online")  # best-effort placeholder
+    return True
+
