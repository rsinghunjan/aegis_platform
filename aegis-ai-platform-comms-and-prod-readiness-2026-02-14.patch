*** Add File:apply_term_updates.sh
+#!/usr/bin/env bash
+set -euo pipefail
+echo "This script will replace several common phrases with the canonical term 'Aegis AI platform' in text and markdown files under the current repo (DRY RUN by default)."
+
+DRY=${1:-true}
+echo "Dry run: ${DRY}"
+
+PATTERNS=(
+  "Aegis platform"
+  "Aegis (control-plane)"
+  "Aegis control-plane"
+  "Aegis control plane"
+  "Aegis platform/control-plane"
+  "Aegis control‑plane"
+)
+
+FILES=$(git ls-files '*.md' '*.rst' '*.txt' '*.yml' '*.yaml' || true)
+
+for f in ${FILES}; do
+  for p in "${PATTERNS[@]}"; do
+    if grep -qF "$p" "$f"; then
+      if [ "${DRY}" = "false" ]; then
+        sed -i "s|$p|Aegis AI platform|g" "$f"
+        echo "Replaced in $f: $p -> Aegis AI platform"
+      else
+        echo "Would replace in $f: $p"
+      fi
+    fi
+  done
+done
+
+echo "Done. Rerun with 'false' as first argument to perform replacements."
+
