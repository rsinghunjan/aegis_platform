+"""
+Simple RAG microservice:
+ - vector upsert API
+ - retrieve+compose API that returns context snippets for LLM prompts
+ - integrates with prompt registry to render templates
+"""
+from flask import Flask, request, jsonify
+import os, json
+from services.rag.milvus_client import upsert_documents, query_similar
+
+app = Flask(__name__)
+COLLECTION = os.environ.get("RAG_COLLECTION", "aegis_docs")
+DEFAULT_K = int(os.environ.get("RAG_TOPK", "5"))
+PROMPT_REGISTRY_URL = os.environ.get("PROMPT_REGISTRY_URL", "http://prompt-registry:8081")
+
+@app.route("/upsert", methods=["POST"])
+def upsert():
+    body = request.get_json()
+    docs = body.get("docs", [])
+    # each doc: {"embedding": [...], "meta": {...}}
+    pk = upsert_documents(COLLECTION, [(d["embedding"], d.get("meta", {})) for d in docs])
+    return jsonify({"inserted": len(pk), "pks": pk})
+
+@app.route("/retrieve", methods=["POST"])
+def retrieve():
+    body = request.get_json()
+    query_embedding = body.get("embedding")
+    top_k = body.get("top_k", DEFAULT_K)
+    if not query_embedding:
+        return jsonify({"error":"embedding required"}), 400
+    hits = query_similar(COLLECTION, query_embedding, top_k)
+    return jsonify({"hits": hits})
+
+@app.route("/compose_prompt", methods=["POST"])
+def compose_prompt():
+    body = request.get_json()
+    template_name = body.get("template", "default")
+    query_embedding = body.get("embedding")
+    top_k = body.get("top_k", DEFAULT_K)
+    # get context
+    hits = query_similar(COLLECTION, query_embedding, top_k)
+    context = "\n\n".join([h["meta"].get("text","") for h in hits])
+    # fetch template from prompt registry
+    try:
+        import requests
+        resp = requests.get(f"{PROMPT_REGISTRY_URL}/template/{template_name}", timeout=3)
+        if resp.status_code == 200:
+            template = resp.json().get("template", "{context}\n\nQ: {query}\nA:")
+        else:
+            template = "{context}\n\nQ: {query}\nA:"
+    except Exception:
+        template = "{context}\n\nQ: {query}\nA:"
+    prompt = template.replace("{context}", context).replace("{query}", body.get("query",""))
+    return jsonify({"prompt": prompt, "hits": hits})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8082")))
+
