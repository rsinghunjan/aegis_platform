+"""
+Prompt registry service:
+ - store prompt templates (versioned) in a simple JSON store (backed by git or file)
+ - sign templates via cosign on publish (optional)
+"""
+from flask import Flask, request, jsonify
+import os, json, tempfile, subprocess
+from datetime import datetime
+
+app = Flask(__name__)
+STORE = os.environ.get("PROMPT_STORE_PATH", "/data/prompts.json")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def load_store():
+    try:
+        return json.load(open(STORE))
+    except Exception:
+        return {}
+
+def save_store(d):
+    os.makedirs(os.path.dirname(STORE), exist_ok=True)
+    with open(STORE, "w") as fh:
+        json.dump(d, fh, indent=2)
+
+@app.route("/template/<name>", methods=["GET"])
+def get_template(name):
+    s = load_store()
+    t = s.get(name)
+    if not t:
+        return jsonify({"error":"not found"}), 404
+    return jsonify(t)
+
+@app.route("/template/<name>", methods=["POST"])
+def put_template(name):
+    body = request.get_json()
+    template = body.get("template")
+    author = body.get("author","unknown")
+    if not template:
+        return jsonify({"error":"template required"}), 400
+    s = load_store()
+    versions = s.get(name,{}).get("versions",[])
+    v = {"version": len(versions)+1, "template": template, "author": author, "ts": datetime.utcnow().isoformat()+"Z"}
+    versions.append(v)
+    s[name] = {"name":name, "versions": versions}
+    save_store(s)
+    # sign and upload the template for audit if cosign key present
+    if COSIGN_KEY_REF and EVIDENCE_BUCKET:
+        tmp = tempfile.mkdtemp()
+        path = os.path.join(tmp, f"{name}_v{v['version']}.txt")
+        with open(path,"w") as fh: fh.write(template)
+        subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, path])
+        if EVIDENCE_BUCKET.startswith("s3://"):
+            subprocess.check_call(["aws","s3","cp", path, f"{EVIDENCE_BUCKET}/prompts/{os.path.basename(path)}"])
+    return jsonify({"ok":True, "version": v["version"]})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PROMPT_PORT","8081")))
+
