+"""
+Simple agent orchestrator:
+ - Accepts an agent plan (list of steps) composed of tool calls
+ - Executes steps in sequence using tool adapters: search (calls RAG), exec (runs sandboxed task)
+ - Logs attested action records to evidence bucket via cosign (if configured)
+ - Consults Policy Engine before any tool call that is sensitive (policy_engine url)
+"""
+from flask import Flask, request, jsonify
+import os, subprocess, json, time, requests
+
+app = Flask(__name__)
+RAG_URL = os.environ.get("RAG_URL","http://rag:8082")
+SANDBOX_RUNNER = os.environ.get("SANDBOX_RUNNER","/ops/sandbox/run_sandbox.sh")
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL","http://policy-engine:8085/evaluate")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def policy_check(action, actor="automation"):
+    try:
+        r = requests.post(POLICY_ENGINE, json={"action": action, "actor": actor}, timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        return {"allow": False, "error": str(e)}
+
+def call_search(query):
+    # for simplicity assume embeddings passed or RAG will compose template
+    r = requests.post(f"{RAG_URL}/retrieve", json={"embedding": query.get("embedding")})
+    return r.json()
+
+def call_exec(cmd):
+    # run in sandbox runner, which isolates via docker/runsc/etc
+    out = subprocess.check_output([SANDBOX_RUNNER, json.dumps({"cmd": cmd})], universal_newlines=True)
+    return out
+
+def attest_event(ev):
+    tmp = f"/tmp/agent_ev_{int(time.time())}.json"
+    with open(tmp,"w") as fh: json.dump(ev, fh)
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, tmp])
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", tmp, f"{EVIDENCE_BUCKET}/agent/{os.path.basename(tmp)}"])
+    return tmp
+
+@app.route("/run", methods=["POST"])
+def run_plan():
+    body = request.get_json()
+    plan = body.get("plan", [])
+    actor = body.get("actor","automation")
+    results = []
+    for step in plan:
+        tool = step.get("tool")
+        args = step.get("args", {})
+        # sensitive tool policy check
+        if tool in ("exec",):
+            pol = policy_check("forensic_signoff", actor)
+            if not pol.get("allow", False):
+                return jsonify({"error":"policy_denied", "detail": pol}), 403
+        try:
+            if tool == "search":
+                res = call_search(args)
+            elif tool == "exec":
+                res = call_exec(args.get("cmd"))
+            else:
+                res = {"error":"unknown_tool"}
+            ev = {"ts": int(time.time()), "actor": actor, "tool": tool, "args": args, "result_summary": str(res)[:1000]}
+            attest_event(ev)
+            results.append({"tool": tool, "result": res})
+        except Exception as e:
+            return jsonify({"error":"tool_failed", "tool": tool, "detail": str(e)}), 500
+    return jsonify({"results": results})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("AGENT_PORT","8090")))
+
