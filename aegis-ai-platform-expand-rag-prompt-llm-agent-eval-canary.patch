+"""
+Evaluation harness for LLM/RAG outputs.
+ - Runs a benchmark dataset of (query, expected) and computes simple metrics (exact match, BLEU, etc)
+ - Logs results to MLflow and returns a summary JSON
+"""
+import os, json, time
+import requests
+import mlflow
+from sklearn.metrics import accuracy_score
+
+MLFLOW_URI = os.environ.get("MLFLOW_TRACKING_URI", "http://mlflow:5000")
+RAG_SERVICE = os.environ.get("RAG_URL","http://rag:8082")
+LLM_PROXY = os.environ.get("LLM_PROXY_URL","http://llm-proxy:8083")
+
+def evaluate(dataset_path):
+    dataset = json.load(open(dataset_path))
+    preds = []
+    golds = []
+    for item in dataset:
+        q = item["query"]
+        # naive: ask RAG to compose prompt and call LLM
+        r = requests.post(f"{RAG_SERVICE}/compose_prompt", json={"template": "default", "query": q, "embedding":[0.0]*1536})
+        prompt = r.json()["prompt"]
+        r2 = requests.post(f"{LLM_PROXY}/v1/generate", json={"prompt": prompt})
+        pred = r2.text.strip()
+        preds.append(pred)
+        golds.append(item.get("expected",""))
+    # simple exact-match metric
+    em = sum(1 for p,g in zip(preds,golds) if p==g)/len(golds)
+    mlflow.set_tracking_uri(MLFLOW_URI)
+    with mlflow.start_run():
+        mlflow.log_metric("exact_match", em)
+        mlflow.log_param("dataset", dataset_path)
+    return {"exact_match": em, "n": len(golds)}
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--dataset", required=True)
+    args = p.parse_args()
+    print(evaluate(args.dataset))
+
