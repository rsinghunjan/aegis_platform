+"""
+Canary A/B pipeline integration example:
+ - Triggers A/B experiment using two model variants
+ - Collects metrics and consults policy engine before promoting winner
+ - Attests decisions and uploads evidence
+"""
+import os, requests, time, json, subprocess
+
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL","http://policy-engine:8085/evaluate")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def post_policy(action, actor="automation"):
+    r = requests.post(POLICY_ENGINE, json={"action": action, "actor": actor}, timeout=5)
+    return r.json()
+
+def attest(data, name="ab"):
+    tmp = f"/tmp/{name}-{int(time.time())}.json"
+    with open(tmp,"w") as fh: json.dump(data, fh)
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key",COSIGN_KEY_REF,tmp])
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", tmp, f"{EVIDENCE_BUCKET}/ab/{os.path.basename(tmp)}"])
+    return tmp
+
+def run_ab(a_model, b_model, nsamples=100):
+    # placeholder: gather metrics for both models; decide by a single metric
+    # In reality use evaluation harness to run requests and collect latency/quality
+    a_score = 0.75
+    b_score = 0.78
+    result = {"a":a_score, "b":b_score}
+    attest({"phase":"compare","metrics":result})
+    # policy check before promote
+    dec = post_policy("deploy_low_risk")
+    if dec.get("allow"):
+        winner = "b" if b_score > a_score else "a"
+        attest({"action":"promote","winner":winner})
+        return {"promoted": winner}
+    else:
+        return {"promoted": None, "reason":"policy_denied"}
+
+if __name__=="__main__":
+    print(run_ab("model:v1","model:v2"))
+
