+"""
+Lightweight Milvus client helper for Aegis RAG service.
+Requires: pymilvus
+"""
+from pymilvus import connections, CollectionSchema, FieldSchema, DataType, Collection, utility
+import os
+
+MILVUS_HOST = os.environ.get("MILVUS_HOST", "localhost")
+MILVUS_PORT = os.environ.get("MILVUS_PORT", "19530")
+
+def connect():
+    connections.connect("default", host=MILVUS_HOST, port=MILVUS_PORT)
+
+def ensure_collection(name="aegis_docs", dim=1536):
+    connect()
+    if utility.has_collection(name):
+        return Collection(name)
+    id_field = FieldSchema(name="id", dtype=DataType.INT64, is_primary=True, auto_id=True)
+    vec_field = FieldSchema(name="embedding", dtype=DataType.FLOAT_VECTOR, dim=dim)
+    meta = FieldSchema(name="meta", dtype=DataType.JSON)
+    schema = CollectionSchema([id_field, vec_field, meta], description="Aegis docs")
+    coll = Collection(name, schema=schema)
+    # create index for vector field
+    coll.create_index("embedding", {"index_type":"IVF_FLAT","metric_type":"L2","params":{"nlist":128}})
+    coll.load()
+    return coll
+
+def upsert_documents(collection_name, embeddings_and_meta):
+    """
+    embeddings_and_meta: list of (embedding:list[float], meta:dict)
+    """
+    coll = ensure_collection(collection_name)
+    embeddings = [e for e,m in embeddings_and_meta]
+    metas = [m for e,m in embeddings_and_meta]
+    res = coll.insert([None, embeddings, metas])
+    coll.flush()
+    return res.primary_keys
+
+def query_similar(collection_name, query_embedding, top_k=5):
+    coll = ensure_collection(collection_name)
+    results = coll.search([query_embedding], "embedding", {"metric_type":"L2"}, ["meta"], limit=top_k)
+    # results is list per query; single query => results[0]
+    out = []
+    for r in results[0]:
+        out.append({"score": float(r.score), "meta": r.entity.get("meta")})
+    return out
+
