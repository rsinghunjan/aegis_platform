+tmp=$(mktemp -d)
+git clone --depth 1 https://github.com/facebookresearch/xformers.git "$tmp/xformers"
+pushd "$tmp/xformers"
+${PYTHON_BIN} -m pip install --upgrade pip setuptools wheel cmake ninja
+TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST:-"8.6;8.0"} export TORCH_CUDA_ARCH_LIST
+${PYTHON_BIN} -m pip wheel . -w "$OUT_DIR"
+popd
+rm -rf "$tmp"
+echo "Wheels in $OUT_DIR"
+
