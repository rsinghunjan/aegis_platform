+#!/usr/bin/env python3
+"""
+Checks nodes for isolated runtimes (runsc/kata/firecracker), optionally label nodes, and produce JSON report.
+"""
+import argparse, json, sys
+from datetime import datetime
+try:
+    from kubernetes import client, config
+except Exception:
+    client = None
+
+def load_kube(kubeconfig=None):
+    if client is None:
+        raise RuntimeError("kubernetes python client required: pip install kubernetes")
+    if kubeconfig:
+        config.load_kube_config(kubeconfig)
+    else:
+        try:
+            config.load_incluster_config()
+        except Exception:
+            config.load_kube_config()
+
+def check_and_label_nodes(label_nodes=False):
+    v1 = client.CoreV1Api()
+    nodes = v1.list_node().items
+    report = {"timestamp": datetime.utcnow().isoformat(), "nodes": []}
+    for n in nodes:
+        name = n.metadata.name
+        runtime = (n.status.node_info.container_runtime_version or "").lower()
+        labels = n.metadata.labels or {}
+        has_isolation = any(k in runtime for k in ("runsc","kata","firecracker"))
+        report["nodes"].append({"name": name, "runtime": runtime, "labels": labels, "has_isolation": has_isolation})
+        if label_nodes:
+            patch = {"metadata": {"labels": {"runtime.aegis/has-isolation": "true" if has_isolation else "false"}}}
+            try:
+                v1.patch_node(name, patch)
+            except Exception as e:
+                print(f"Failed to label node {name}: {e}")
+    return report
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--kubeconfig", default=None)
+    p.add_argument("--label-nodes", action="store_true")
+    args = p.parse_args()
+    load_kube(args.kubeconfig)
+    report = check_and_label_nodes(label_nodes=args.label_nodes)
+    print(json.dumps(report, indent=2))
+    lacking = [n for n in report["nodes"] if not n["has_isolation"]]
+    if lacking:
+        print("Nodes without recommended isolation:", [n["name"] for n in lacking])
+        sys.exit(2)
+    print("All nodes report isolation heuristics OK")
+
+if __name__ == "__main__":
+    main()
+
