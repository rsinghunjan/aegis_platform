+#!/usr/bin/env bash
+set -euo pipefail
+OUT_DIR=${1:-/tmp/webhook-certs}
+mkdir -p "$OUT_DIR"
+pushd "$OUT_DIR" >/dev/null
+openssl genrsa -out ca.key 2048
+openssl req -x509 -new -nodes -key ca.key -subj "/CN=aegis-webhook-ca" -days 3650 -out ca.crt
+openssl genrsa -out server.key 2048
+openssl req -new -key server.key -subj "/CN=aegis-admission-webhook.ml-serving.svc" -out server.csr
+cat > webhook.ext <<EOF
+authorityKeyIdentifier=keyid,issuer
+basicConstraints=CA:FALSE
+keyUsage = digitalSignature, keyEncipherment
+subjectAltName = DNS:aegis-admission-webhook.ml-serving.svc, DNS:aegis-admission-webhook
+EOF
+openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -days 365 -extfile webhook.ext
+echo "Certificates created in $OUT_DIR"
+echo "CA bundle (base64):"
+base64 -w0 ca.crt || true
+popd >/dev/null
+echo "Create secret webhook-tls and aegis-cosign-pubkey before applying webhook manifests."
+
