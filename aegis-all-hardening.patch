+#!/usr/bin/env python3
+import os, importlib, requests
+VENDOR_MODE = os.environ.get("WATERMARK_VENDOR_MODE", "local")
+VENDOR_API_URL = os.environ.get("WATERMARK_VENDOR_API_URL", "")
+VENDOR_API_KEY = os.environ.get("WATERMARK_VENDOR_API_KEY", "")
+vendor = None
+if VENDOR_MODE == "local":
+    try:
+        vendor = importlib.import_module("vendor_watermark")
+    except Exception:
+        vendor = None
+
+def embed(image_bytes: bytes, payload: str, strength: float = 0.02) -> bytes:
+    if VENDOR_MODE == "remote" and VENDOR_API_URL:
+        headers = {"Authorization": f"Bearer {VENDOR_API_KEY}"} if VENDOR_API_KEY else {}
+        r = requests.post(f"{VENDOR_API_URL}/embed", headers=headers, files={"image": image_bytes}, data={"payload": payload})
+        r.raise_for_status(); return r.content
+    if vendor:
+        return vendor.embed(image_bytes, payload, strength=strength)
+    raise RuntimeError("No watermark vendor configured (set WATERMARK_VENDOR_MODE and provide vendor)")
+
+def detect(image_bytes: bytes, payload: str) -> bool:
+    if VENDOR_MODE == "remote" and VENDOR_API_URL:
+        headers = {"Authorization": f"Bearer {VENDOR_API_KEY}"} if VENDOR_API_KEY else {}
+        r = requests.post(f"{VENDOR_API_URL}/detect", headers=headers, files={"image": image_bytes}, data={"payload": payload})
+        r.raise_for_status(); return bool(r.json().get("detected", False))
+    if vendor:
+        return vendor.detect(image_bytes, payload)
+    raise RuntimeError("No watermark vendor configured")
