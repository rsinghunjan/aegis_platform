+#!/usr/bin/env python3
+import os, subprocess, tempfile
+REPO_URL = os.environ.get("GITOPS_REPO","")
+GIT_AUTHOR = os.environ.get("GIT_AUTHOR","aegis-bot <aegis-bot@example.com>")
+def create_rollback_pr(repo_url, target_path, deployment_name, prev_image_tag):
+    if not repo_url: raise RuntimeError("GITOPS_REPO not configured")
+    tmp=tempfile.mkdtemp()
+    subprocess.check_call(["git","clone",repo_url,tmp])
+    branch=f"rollback/{deployment_name}/{int(__import__('time').time())}"
+    subprocess.check_call(["git","checkout","-b",branch],cwd=tmp)
+    target_file=os.path.join(tmp,target_path)
+    with open(target_file,"r") as f: content=f.read()
+    new_content=content.replace(f"{deployment_name}:latest", f"{deployment_name}:{prev_image_tag}")
+    with open(target_file,"w") as f: f.write(new_content)
+    subprocess.check_call(["git","add",target_file],cwd=tmp)
+    subprocess.check_call(["git","commit","-m",f"Rollback {deployment_name} to {prev_image_tag}","--author",GIT_AUTHOR],cwd=tmp)
+    subprocess.check_call(["git","push","--set-upstream","origin",branch],cwd=tmp)
+    print("Created branch",branch,"— open PR in your Git host for operator approval")
+if __name__=="__main__":
+    import argparse
+    p=argparse.ArgumentParser(); p.add_argument("--repo"); p.add_argument("--path"); p.add_argument("--deployment"); p.add_argument("--prev-tag"); args=p.parse_args()
+    create_rollback_pr(args.repo or REPO_URL, args.path, args.deployment, args.prev_tag)
+
