+POWER_METRICS=["dcgm_gpu_power_draw_watts","nvidia_gpu_power_draw_watts","dcgm_gpu_power"]
+def _prom_range_query(query,start,end,step=10):
+    url=urljoin(PROM_URL,"/api/v1/query_range"); params={"query":query,"start":str(start),"end":str(end),"step":f"{step}s"}
+    r=requests.get(url,params=params,timeout=30); r.raise_for_status(); return r.json().get("data",{}).get("result",[])
+def compute_energy_kwh(start_ts,end_ts,pod=None,node=None,gpu_index=None,step=10):
+    total_wh=0.0; any_samples=False
+    for m in POWER_METRICS:
+        selector=""
+        if pod: selector=f'{{pod="{pod}"}}'
+        elif node and gpu_index is not None: selector=f'{{node="{node}", minor_number="{gpu_index}"}}'
+        elif node: selector=f'{{node="{node}"}}'
+        q=f"{m}{selector}"
+        try: res=_prom_range_query(q,start_ts,end_ts,step)
+        except Exception: res=[]
+        for s in res:
+            vals=s.get("values",[])
+            if not vals: continue
+            any_samples=True
+            prev=None
+            for t_str,v_str in vals:
+                t=float(t_str); v=float(v_str) if v_str not in ("","NaN","nan") else 0.0
+                if prev is not None:
+                    dt=t-prev
+                    total_wh += v * dt / 3600.0 * 1000.0
+                prev=t
+    if not any_samples: return None
+    return total_wh/1000.0
+if __name__=="__main__":
+    import argparse
+    p=argparse.ArgumentParser(); p.add_argument("--start",type=float,required=True); p.add_argument("--end",type=float,required=True); p.add_argument("--pod"); p.add_argument("--node"); p.add_argument("--gpu-index",type=int)
