+    # Optional private-endpoint connectivity check for configured providers (best-effort)
+    async def _check_provider_endpoints():
+        checks = []
+        for k in ("ANTHROPIC_API_BASE", "OPENAI_API_BASE", "AIP_API_ENDPOINT"):
+            v = os.environ.get(k, "") or None
+            if v:
+                checks.append((k, v))
+        async with httpx.AsyncClient(timeout=5.0) as client:
+            for name, endpoint in checks:
+                try:
+                    # try a HEAD first, fallback to GET
+                    logger.info(f"Checking provider endpoint {name} -> {endpoint}")
+                    r = await client.head(endpoint)
+                    if r.status_code >= 400:
+                        r = await client.get(endpoint)
+                    logger.info(f"{name} reachable, status {r.status_code}")
+                except Exception as e:
+                    logger.warning(f"Provider endpoint check failed for {name}: {e}")
+
+    # Fire-and-forget check
+    try:
+        import asyncio
+        asyncio.create_task(_check_provider_endpoints())
+    except Exception:
+        logger.info("Skipping provider endpoint checks on startup")
