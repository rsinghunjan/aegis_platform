+#!/usr/bin/env python3
+"""
+Enhanced Consent Manager with scopes and ability to list/revoke consents.
+Persistence: simple SQLite for demo; replace with durable DB for production.
+"""
+from flask import Flask, request, jsonify
+import sqlite3, os
+from datetime import datetime, timedelta
+import json
+
+DB_PATH = os.environ.get("CONSENT_DB", "/data/consent_v2.db")
+app = Flask(__name__)
+os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+conn = sqlite3.connect(DB_PATH, check_same_thread=False)
+conn.execute("""CREATE TABLE IF NOT EXISTS consents_v2 (
+    id TEXT PRIMARY KEY,
+    subject_id TEXT,
+    scope TEXT,
+    granted INTEGER,
+    granted_ts TEXT,
+    expires_ts TEXT,
+    metadata TEXT
+)""")
+conn.commit()
+
+@app.route("/consent", methods=["POST"])
+def grant_consent():
+    j = request.json or {}
+    subject = j.get("subject_id")
+    scope = j.get("scope", "general")
+    duration_days = int(j.get("duration_days", 365))
+    metadata = j.get("metadata", {})
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    uid = f"{subject}-{scope}"
+    now = datetime.utcnow()
+    expires = now + timedelta(days=duration_days)
+    conn.execute("REPLACE INTO consents_v2 (id,subject_id,scope,granted,granted_ts,expires_ts,metadata) VALUES (?,?,?,?,?,?,?)",
+                 (uid, subject, scope, 1, now.isoformat()+"Z", expires.isoformat()+"Z", json.dumps(metadata)))
+    conn.commit()
+    return jsonify({"status":"granted","subject_id":subject,"scope":scope,"expires":expires.isoformat()+"Z"})
+
+@app.route("/consent", methods=["GET"])
+def check_consent():
+    subject = request.args.get("subject_id")
+    scope = request.args.get("scope","general")
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    uid = f"{subject}-{scope}"
+    cur = conn.execute("SELECT granted,expires_ts,metadata FROM consents_v2 WHERE id=?", (uid,))
+    row = cur.fetchone()
+    if not row:
+        return jsonify({"consent": False})
+    granted, expires_ts, metadata = row
+    if not granted:
+        return jsonify({"consent": False})
+    if expires_ts and datetime.fromisoformat(expires_ts.replace("Z","")) < datetime.utcnow():
+        return jsonify({"consent": False})
+    return jsonify({"consent": True, "expires": expires_ts, "metadata": json.loads(metadata or "{}")})
+
+@app.route("/consent/revoke", methods=["POST"])
+def revoke_consent():
+    j = request.json or {}
+    subject = j.get("subject_id")
+    scope = j.get("scope","general")
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    uid = f"{subject}-{scope}"
+    conn.execute("UPDATE consents_v2 SET granted=0 WHERE id=?", (uid,))
+    conn.commit()
+    return jsonify({"status":"revoked","subject_id":subject,"scope":scope})
+
+@app.route("/consent/list", methods=["GET"])
+def list_consents():
+    subject = request.args.get("subject_id")
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    cur = conn.execute("SELECT scope,granted,granted_ts,expires_ts,metadata FROM consents_v2 WHERE subject_id=?", (subject,))
+    rows = cur.fetchall()
+    out = []
+    for r in rows:
+        out.append({"scope":r[0],"granted":bool(r[1]),"granted_ts":r[2],"expires_ts":r[3],"metadata": json.loads(r[4] or "{}")})
+    return jsonify({"consents": out})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
