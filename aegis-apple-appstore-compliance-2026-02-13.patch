+#!/usr/bin/env python3
+"""
+Presidio redaction wrapper for Aegis ingestion pipeline.
+Calls a local Presidio service or the Azure/REST endpoint and returns redacted text + redaction metadata.
+"""
+import os
+import requests
+import json
+
+PRESIDIO_URL = os.environ.get("PRESIDIO_URL", "http://presidio-analyzer:3000")
+
+def redact_text(text, recognizers=None):
+    payload = {"text": text, "analyzerEngine": "Recognizer", "language": "en"}
+    if recognizers:
+        payload["recognizers"] = recognizers
+    try:
+        r = requests.post(f"{PRESIDIO_URL}/analyze", json=payload, timeout=5.0)
+        r.raise_for_status()
+        analysis = r.json()
+        # create redacted text by replacing spans with [REDACTED]
+        redacted = text
+        offsets = sorted([(m["start"], m["end"]) for r in analysis.get("result",[]) for m in r.get("matches",[])], reverse=True)
+        for s,e in offsets:
+            redacted = redacted[:s] + "[REDACTED]" + redacted[e:]
+        return {"redacted_text": redacted, "analysis": analysis}
+    except Exception as e:
+        # Fail closed in ingest path depending on policy; here we return original and an error flag
+        return {"redacted_text": text, "analysis": {"error": str(e)}}
+
+if __name__ == "__main__":
+    import sys
+    txt = sys.stdin.read() if not sys.stdin.isatty() else "Patient John Doe 555-12-3456"
+    print(json.dumps(redact_text(txt), indent=2))
+
