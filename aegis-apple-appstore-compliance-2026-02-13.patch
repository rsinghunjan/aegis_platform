+#!/usr/bin/env python3
+"""
+Simple fetchtoken mint/redeem service for offline approvals:
+ - /mint  -> returns a signed token with expiry
+ - /redeem -> redeems at edge; redemption recorded to MCP when connectivity resumes
+"""
+import os
+import json
+import time
+import hmac, hashlib, base64
+from flask import Flask, request, jsonify
+import requests
+
+SECRET = os.environ.get("FETCH_SECRET", "dev-secret")  # replace with Vault-managed secret
+EXPIRY_SECONDS = int(os.environ.get("FETCH_EXPIRY", "3600"))
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+app = Flask(__name__)
+
+def sign(payload: dict) -> str:
+    msg = json.dumps(payload, separators=(",",":"), sort_keys=True).encode()
+    sig = hmac.new(SECRET.encode(), msg, hashlib.sha256).digest()
+    return base64.urlsafe_b64encode(msg).decode() + "." + base64.urlsafe_b64encode(sig).decode()
+
+def verify(token: str):
+    try:
+        msg_b64, sig_b64 = token.split(".")
+        msg = base64.urlsafe_b64decode(msg_b64.encode())
+        sig = base64.urlsafe_b64decode(sig_b64.encode())
+        expected = hmac.new(SECRET.encode(), msg, hashlib.sha256).digest()
+        return hmac.compare_digest(sig, expected), json.loads(msg)
+    except Exception:
+        return False, None
+
+@app.route("/mint", methods=["POST"])
+def mint():
+    j = request.json or {}
+    aid = j.get("artifact_id", "unknown")
+    payload = {"artifact_id": aid, "exp": time.time() + EXPIRY_SECONDS, "issued": time.time()}
+    token = sign(payload)
+    return jsonify({"token": token, "artifact_id": aid, "exp": payload["exp"]})
+
+@app.route("/redeem", methods=["POST"])
+def redeem():
+    j = request.json or {}
+    token = j.get("token")
+    ok, payload = verify(token)
+    if not ok:
+        return jsonify({"redeemed": False, "reason": "invalid"}), 400
+    # record redemption locally (edge) or to MCP if reachable
+    try:
+        requests.post(f"{MCP_API.rstrip('/')}/offline/redemptions", json={"token": token, "payload": payload}, timeout=3.0)
+    except Exception:
+        # best-effort: persist to /data/offline_redemptions for later sync (edge)
+        os.makedirs("/data/offline_redemptions", exist_ok=True)
+        with open(f"/data/offline_redemptions/{int(time.time())}.json","w") as f:
+            json.dump({"token":token,"payload":payload}, f)
+    return jsonify({"redeemed": True, "artifact_id": payload.get("artifact_id")})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8081")))
+
