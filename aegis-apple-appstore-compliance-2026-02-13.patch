+#!/usr/bin/env python3
+"""
+Generate an evidence bundle for App Store/Apple Review that includes:
+ - MLflow model run metadata
+ - Notarization ticket (if available)
+ - Rekor / cosign attestations (optional)
+ - Privacy & consent policy references
+"""
+import os
+import json
+import requests
+
+MLFLOW_URI = os.environ.get("MLFLOW_TRACKING_URI", "http://mlflow:5000")
+REKOR_URL = os.environ.get("REKOR_URL", "")
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def fetch_mlflow_run(run_id):
+    try:
+        r = requests.get(f"{MLFLOW_URI.rstrip('/')}/api/2.0/preview/mlflow/runs/get?run_id={run_id}", timeout=5.0)
+        if r.ok:
+            return r.json()
+    except Exception:
+        pass
+    return None
+
+def load_notary(path):
+    if path and os.path.exists(path):
+        return json.load(open(path))
+    return None
+
+def collect_rekor_entries(image_refs):
+    entries = []
+    if not REKOR_URL:
+        return entries
+    for i in image_refs:
+        try:
+            r = requests.get(f"{REKOR_URL.rstrip('/')}/api/v1/log/entries?logIndex=0", timeout=3.0)
+            if r.ok:
+                entries.append(r.json())
+        except Exception:
+            pass
+    return entries
+
+def main(run_id=None, notary_path=None, image_refs=None, out="artifacts/evidence_bundle.json"):
+    bundle = {"mlflow": None, "notary": None, "rekor": None, "annotations": {}}
+    if run_id:
+        bundle["mlflow"] = fetch_mlflow_run(run_id)
+    bundle["notary"] = load_notary(notary_path)
+    bundle["rekor"] = collect_rekor_entries(image_refs or [])
+    bundle["annotations"] = {"privacy_policy":"https://your-org/privacy", "consent_schema":"v2"}
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    with open(out,"w") as f:
+        json.dump(bundle, f, indent=2)
+    print("Wrote evidence bundle to", out)
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--run-id")
+    p.add_argument("--notary")
+    p.add_argument("--images", nargs="*")
+    p.add_argument("--out", default="artifacts/evidence_bundle.json")
+    args = p.parse_args()
+    main(args.run_id, args.notary, args.images, args.out)
+
