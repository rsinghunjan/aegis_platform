+// FetchTokenClient.swift
+// Simple client to redeem fetchtoken on-device (edge) and call prefilled A2A flows
+import Foundation
+
+public class FetchTokenClient {
+    let redeemURL: URL
+    public init(redeemURL: URL) { self.redeemURL = redeemURL }
+
+    public func redeem(token: String, completion: @escaping (Bool, String?) -> Void) {
+        var req = URLRequest(url: redeemURL.appendingPathComponent("/redeem"))
+        req.httpMethod = "POST"
+        req.addValue("application/json", forHTTPHeaderField: "Content-Type")
+        let body = ["token": token]
+        req.httpBody = try? JSONSerialization.data(withJSONObject: body)
+        URLSession.shared.dataTask(with: req) { data, _, _ in
+            guard let d = data, let j = try? JSONSerialization.jsonObject(with: d) as? [String:Any] else { completion(false, nil); return }
+            completion((j["redeemed"] as? Bool) == true, j["artifact_id"] as? String)
+        }.resume()
+    }
+}
