+#!/usr/bin/env python3
+"""
+Utility functions for applying simple Gaussian DP noise to scalar metrics or vectors.
+Not a production-grade DP library — use JAX/TF Privacy or PyDP for rigorous guarantees.
+"""
+import numpy as np
+
+def add_gaussian_noise(vec, epsilon=1.0):
+    sigma = 1.0 / max(epsilon, 1e-6)
+    noise = np.random.normal(0, sigma, size=np.shape(vec))
+    return vec + noise
+
+def dp_aggregate(updates, epsilon=1.0):
+    avg = np.mean(updates, axis=0)
+    return add_gaussian_noise(avg, epsilon=epsilon)
+
+if __name__ == "__main__":
+    import sys
+    import json
+    arr = json.loads(sys.argv[1]) if len(sys.argv) > 1 else [[0.1,0.2],[0.2,0.1]]
+    import numpy as np
+    print(dp_aggregate(np.array(arr)).tolist())
+
