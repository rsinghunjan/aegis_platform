+#!/usr/bin/env python3
+"""
+Log Core ML model metadata (size, example latency) and energy metric placeholders to MLflow.
+This script expects a local mlmodel and will run a tiny latency micro-benchmark if possible.
+"""
+import argparse
+import os
+import time
+import mlflow
+
+def model_size(path):
+    return os.path.getsize(path)
+
+def micro_latency_test(path, runs=10):
+    # Placeholder: running actual inference requires Core ML runtime; we just stub a synthetic value
+    # Operators should run this on macOS runners with Core ML to measure real latency and energy.
+    t = 0.001 * runs
+    return t / runs
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--model-path", required=True)
+    p.add_argument("--name", default="coreml-model")
+    args = p.parse_args()
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI", "http://mlflow:5000"))
+    with mlflow.start_run(run_name=args.name):
+        size = model_size(args.model_path)
+        latency = micro_latency_test(args.model_path)
+        mlflow.log_metric("coreml.size_bytes", size)
+        mlflow.log_metric("coreml.pseudo_latency_s", latency)
+        mlflow.log_metric("emissions_kgco2e", float(os.environ.get("EMISSIONS_KG", "0.0")))
+        mlflow.log_artifact(args.model_path, artifact_path="coreml")
+        print("Logged metrics: size=", size, "latency=", latency)
+
+if __name__ == "__main__":
+    import os
+    main()
