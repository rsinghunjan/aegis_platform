+// RetrievalGuardClient.swift
+import Foundation
+
+public class RetrievalGuardClient {
+    let a2aEndpoint: URL
+    let consentManager: URL
+    public init(a2aEndpoint: URL, consentEndpoint: URL) {
+        self.a2aEndpoint = a2aEndpoint
+        self.consentManager = consentEndpoint.absoluteString as! URL
+    }
+
+    public func requestRetrieval(artifactId: String, subjectId: String, requester: String, purpose: String = "research", completion: @escaping (Bool) -> Void) {
+        // First check consent via consent service
+        let consentURL = URL(string: "\(consentManager)/consent?subject_id=\(subjectId)&purpose=\(purpose)")!
+        URLSession.shared.dataTask(with: consentURL) { data, _, _ in
+            guard let d = data, let j = try? JSONSerialization.jsonObject(with: d) as? [String:Any], (j["consent"] as? Bool) == true else {
+                completion(false); return
+            }
+            // Then request A2A approval (prefill)
+            var req = URLRequest(url: URL(string: "\(self.a2aEndpoint)/request")!)
+            req.httpMethod = "POST"
+            req.addValue("application/json", forHTTPHeaderField: "Content-Type")
+            let body: [String:Any] = ["action_id": "retrieve-\(artifactId)", "approver":"owner", "comment":"Device retrieval request", "requester": requester, "artifact_id": artifactId]
+            req.httpBody = try? JSONSerialization.data(withJSONObject: body)
+            URLSession.shared.dataTask(with: req) { data, _, _ in
+                guard let d = data, let _ = try? JSONSerialization.jsonObject(with: d) as? [String:Any] else { completion(false); return }
+                completion(true)
+            }.resume()
+        }.resume()
+    }
+}
