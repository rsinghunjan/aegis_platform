+#!/usr/bin/env python3
+"""
+Convert ONNX/TensorFlow models to Core ML (.mlmodel) and apply simple optimizations.
+Requires coremltools. This is intentionally minimal — adapt to your conversion needs.
+"""
+import argparse
+import os
+import coremltools as ct
+
+def convert_onnx(onnx_path: str, out_path: str):
+    print("Loading ONNX model:", onnx_path)
+    # coremltools can convert from ONNX
+    mlmodel = ct.converters.onnx.convert(model=onnx_path)
+    mlmodel.save(out_path)
+    print("Saved Core ML model to:", out_path)
+
+def quantize_model(mlmodel_path: str, out_path: str):
+    print("Applying 16-bit quantization (example)")
+    mlmodel = ct.models.MLModel(mlmodel_path)
+    q = ct.models.neural_network.quantization_utils.quantize_weights(mlmodel, nbits=16, quantization_mode="linear")
+    q.save(out_path)
+    print("Saved quantized model to:", out_path)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--onnx", required=True)
+    p.add_argument("--out", default="artifacts/coreml/model.mlmodel")
+    args = p.parse_args()
+    os.makedirs(os.path.dirname(args.out), exist_ok=True)
+    convert_onnx(args.onnx, args.out)
+    # optional quantize pass
+    quant_out = args.out.replace(".mlmodel", ".quant.mlmodel")
+    try:
+        quantize_model(args.out, quant_out)
+    except Exception as e:
+        print("Quantization failed, skipping:", e)
+
+if __name__ == "__main__":
+    main()
+
