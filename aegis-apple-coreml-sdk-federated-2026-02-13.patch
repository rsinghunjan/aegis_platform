+// SecureEnclaveSigner.swift
+import Foundation
+import CryptoKit
+
+public class SecureEnclaveSigner {
+    private let tag: String
+    private var privateKey: SecureEnclave.P256.Signing.PrivateKey?
+
+    public init(keyTag: String) {
+        self.tag = keyTag
+        if let key = try? SecureEnclave.P256.Signing.PrivateKey(accessControl: .init(), authenticationContext: nil) {
+            self.privateKey = key
+        }
+    }
+
+    public func sign(data: Data) throws -> Data {
+        guard let key = privateKey else { throw NSError(domain:"SE", code:1, userInfo:nil) }
+        let sig = try key.signature(for: data)
+        return sig.derRepresentation
+    }
+}
