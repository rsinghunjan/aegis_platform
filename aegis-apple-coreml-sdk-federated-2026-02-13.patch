+#!/usr/bin/env python3
+"""
+Receipt signer using Vault Transit for server-side signing (production).
+Records minimal proof (optionally posts to Rekor).
+"""
+import os
+import json
+import base64
+import requests
+
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "http://vault.aegis-system.svc.cluster.local:8200")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")
+TRANSIT_KEY = os.environ.get("TRANSIT_KEY_NAME", "cosign-signing")
+REKOR_URL = os.environ.get("REKOR_URL", "")
+
+def vault_sign(payload: dict) -> dict:
+    url = f"{VAULT_ADDR.rstrip('/')}/v1/transit/sign/{TRANSIT_KEY}"
+    b64 = base64.b64encode(json.dumps(payload, separators=(",",":")).encode()).decode()
+    body = {"input": b64}
+    headers = {"X-Vault-Token": VAULT_TOKEN} if VAULT_TOKEN else {}
+    r = requests.post(url, json=body, headers=headers, timeout=5.0)
+    r.raise_for_status()
+    return r.json()
+
+def record_to_rekor(payload: dict, sig: dict):
+    if not REKOR_URL:
+        return
+    try:
+        requests.post(f"{REKOR_URL.rstrip('/')}/api/v1/log/entries", json={"payload":payload,"signature":sig}, timeout=5.0)
+    except Exception:
+        pass
+
+def sign_receipt(payload: dict) -> dict:
+    sig = vault_sign(payload)
+    record_to_rekor(payload, sig)
+    return {"signature": sig}
+
+if __name__ == "__main__":
+    import time
+    payload = {"action":"demo","ts":time.time()}
+    print(sign_receipt(payload))
+
