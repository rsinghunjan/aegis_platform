+// ConsentManager.swift
+// Simple iOS client for Consent Manager service
+import Foundation
+
+public struct ConsentResponse: Codable {
+    public let status: String?
+    public let expires: String?
+}
+
+public class ConsentManager {
+    let baseURL: URL
+    public init(baseURL: URL) { self.baseURL = baseURL }
+
+    public func grantConsent(subjectId: String, purpose: String = "general", durationDays: Int = 365, completion: @escaping (Bool) -> Void) {
+        let url = baseURL.appendingPathComponent("/consent")
+        var req = URLRequest(url: url)
+        req.httpMethod = "POST"
+        req.addValue("application/json", forHTTPHeaderField: "Content-Type")
+        let body = ["subject_id": subjectId, "purpose": purpose, "duration_days": durationDays] as [String : Any]
+        req.httpBody = try? JSONSerialization.data(withJSONObject: body)
+        URLSession.shared.dataTask(with: req) { data, resp, err in
+            guard let data = data else { completion(false); return }
+            let ok = (try? JSONDecoder().decode(ConsentResponse.self, from: data)) != nil
+            completion(ok)
+        }.resume()
+    }
+
+    public func checkConsent(subjectId: String, purpose: String = "general", completion: @escaping (Bool) -> Void) {
+        var url = baseURL.appendingPathComponent("/consent")
+        url = URL(string: "\(url.absoluteString)?subject_id=\(subjectId)&purpose=\(purpose)")!
+        URLSession.shared.dataTask(with: url) { data, _, _ in
+            guard let d = data, let j = try? JSONSerialization.jsonObject(with: d) as? [String:Any] else { completion(false); return }
+            completion((j["consent"] as? Bool) == true)
+        }.resume()
+    }
+}
