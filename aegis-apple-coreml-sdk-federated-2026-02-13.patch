+#!/usr/bin/env python3
+"""
+Simple federated learning orchestrator (server) that accepts model updates, performs secure aggregation
+via weighted averaging, and applies a simple Gaussian noise for epsilon-DP. This is a skeleton for demo.
+"""
+import os
+import json
+import time
+from flask import Flask, request, jsonify
+import numpy as np
+
+app = Flask(__name__)
+
+MODEL_STORE = "/data/federated"
+os.makedirs(MODEL_STORE, exist_ok=True)
+CURRENT_WEIGHTS = None
+ROUND = 0
+
+def load_weights():
+    global CURRENT_WEIGHTS
+    p = os.path.join(MODEL_STORE, "global.json")
+    if os.path.exists(p):
+        CURRENT_WEIGHTS = np.array(json.load(open(p)))
+    else:
+        CURRENT_WEIGHTS = None
+
+def save_weights(w):
+    json.dump(w.tolist(), open(os.path.join(MODEL_STORE, "global.json"), "w"))
+
+@app.route("/round", methods=["GET"])
+def round_info():
+    return jsonify({"round": ROUND})
+
+@app.route("/submit", methods=["POST"])
+def submit_update():
+    global CURRENT_WEIGHTS, ROUND
+    j = request.json or {}
+    update = np.array(j.get("weights", []))
+    scale = float(j.get("scale", 1.0))
+    if CURRENT_WEIGHTS is None:
+        CURRENT_WEIGHTS = update * scale
+    else:
+        # weighted average simple aggregator
+        CURRENT_WEIGHTS = (CURRENT_WEIGHTS + update * scale) / 2.0
+    # apply Gaussian noise for DP (simple)
+    epsilon = float(os.environ.get("DP_EPSILON", "1.0"))
+    sigma = 1.0 / max(epsilon, 1e-6)
+    noise = np.random.normal(0, sigma, size=CURRENT_WEIGHTS.shape)
+    noisy = CURRENT_WEIGHTS + noise
+    save_weights(noisy)
+    ROUND += 1
+    # record to MCP (best-effort)
+    try:
+        mcp = os.environ.get("AEGIS_MCP_API", "")
+        if mcp:
+            requests.post(f"{mcp.rstrip('/')}/federated/rounds", json={"round":ROUND,"timestamp":time.time()}, timeout=2.0)
+    except Exception:
+        pass
+    return jsonify({"status":"ok","round":ROUND})
+
+if __name__ == "__main__":
+    load_weights()
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8085")))
+
