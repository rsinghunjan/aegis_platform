+name: Build & Publish Auditor Bundle
+on:
+  workflow_dispatch:
+    inputs:
+      tag:
+        required: true
+      evidence_bucket:
+        required: true
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Setup Python
+        uses: actions/setup-python@v4
+        with:
+          python-version: "3.10"
+      - name: Build auditor bundle
+        env:
+          EVIDENCE_BUCKET: ${{ github.event.inputs.evidence_bucket }}
+          COSIGN_KMS_URI: ${{ secrets.COSIGN_KMS_URI }}
+        run: |
+          python3 ops/autonomy/generate_auditor_zip.py --out /tmp/aegis_audit_bundle.tar.gz || true
+      - name: Upload artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: auditor-bundle
+          path: /tmp/aegis_audit_bundle.tar.gz
+      - name: Create release
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          gh release create "${{ github.event.inputs.tag }}" /tmp/aegis_audit_bundle.tar.gz --title "Aegis Auditor Bundle ${{ github.event.inputs.tag }}" --notes "Automated auditor bundle"
