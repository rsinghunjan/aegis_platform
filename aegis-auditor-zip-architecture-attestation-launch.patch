+#!/usr/bin/env python3
+"""
+Produce an auditor-ready ZIP containing:
+ - Level‑4 verification report (/tmp/level4_verification_report.json)
+ - Formal artifacts (tools/formal outputs)
+ - TLA+/Apalache logs (if present)
+ - Evidence index and highlighted Rekor UUIDs (ops/verify/evidence_index.json)
+ - Audit status (config/audit_status.yaml)
+ - Autonomy statement & evidence summary (docs/autonomy_statement.md, docs/evidence_summary.md)
+ - A small reproduce.sh with commands auditors can run
+
+The script will:
+ - collect files into a temp directory
+ - optionally cosign the zip (COSIGN_KMS_URI)
+ - optionally upload to EVIDENCE_BUCKET
+ - optionally register with Rekor using rekor-cli
+
+Usage:
+  python3 ops/autonomy/generate_auditor_zip.py --out /tmp/aegis_audit_bundle.tar.gz
+"""
+import argparse
+import os
+import shutil
+import tarfile
+import json
+import time
+from pathlib import Path
+import subprocess
+
+DEFAULT_OUT = "/tmp/aegis_audit_bundle.tar.gz"
+
+ITEMS = [
+    "/tmp/level4_verification_report.json",
+    "docs/autonomy_statement.md",
+    "docs/evidence_summary.md",
+    "config/audit_status.yaml",
+    "ops/verify/evidence_index.json",
+    "specs/safety",
+    "tools/formal",
+    "ops/autonomy",
+    "docs",
+]
+
+def collect(dest_dir):
+    dst = Path(dest_dir)
+    dst.mkdir(parents=True, exist_ok=True)
+    for p in ITEMS:
+        src = Path(p)
+        if src.exists():
+            target = dst / src.name
+            if src.is_dir():
+                shutil.copytree(src, target, dirs_exist_ok=True)
+            else:
+                shutil.copy2(src, target)
+    # produce a reproduce script
+    repro = dst / "reproduce_instructions.sh"
+    repro.write_text("""#!/usr/bin/env bash
+echo "Reproduce Level-4 verification (example)"
+echo "1) Install deps: pip install -r ops/grpc/requirements.txt z3-solver"
+echo "2) Run Z3 BMC: python3 tools/formal/z3_bmc_full.py --depth 6"
+echo "3) Inspect /tmp/level4_verification_report.json"
+""")
+    repro.chmod(0o755)
+    return dst
+
+def make_tar(src_dir, out_path):
+    with tarfile.open(out_path, "w:gz") as tar:
+        tar.add(src_dir, arcname=Path(src_dir).name)
+    return out_path
+
+def cosign_sign(path):
+    if os.environ.get("COSIGN_KMS_URI"):
+        try:
+            subprocess.check_call(["cosign","sign-blob","--key",os.environ["COSIGN_KMS_URI"], path])
+            return True
+        except Exception as e:
+            print("cosign sign failed:", e)
+    return False
+
+def upload_s3(path):
+    eb = os.environ.get("EVIDENCE_BUCKET")
+    if eb:
+        dest = f"s3://{eb.rstrip('/')}/audit_bundles/{Path(path).name}"
+        try:
+            subprocess.check_call(["aws","s3","cp", path, dest])
+            return dest
+        except Exception as e:
+            print("s3 upload failed:", e)
+    return None
+
+def rekor_register(path):
+    if shutil_which("rekor-cli"):
+        try:
+            out = subprocess.check_output(["rekor-cli","upload","--artifact", path])
+            return out.decode()
+        except Exception as e:
+            print("rekor upload failed:", e)
+    return None
+
+def shutil_which(cmd):
+    from shutil import which
+    return which(cmd) is not None
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", default=DEFAULT_OUT)
+    args = p.parse_args()
+    ts = int(time.time())
+    tmp = Path(f"/tmp/aegis_audit_bundle_{ts}")
+    if tmp.exists():
+        shutil.rmtree(tmp)
+    collected = collect(tmp)
+    tarpath = make_tar(str(collected), args.out)
+    print("Created bundle:", tarpath)
+    signed = cosign_sign(tarpath)
+    if signed:
+        print("Bundle cosign-signed (best-effort)")
+    s3uri = upload_s3(tarpath)
+    if s3uri:
+        print("Uploaded to S3:", s3uri)
+    rek = rekor_register(tarpath)
+    if rek:
+        print("Rekor register output:", rek)
+    print("Auditor bundle ready:", tarpath)
+
+if __name__=="__main__":
+    main()
+
