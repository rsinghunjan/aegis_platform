+#!/usr/bin/env python3
+"""
+Produce a simple Rekor UUID index by scanning local evidence directory or using rekor-cli for files.
+ - If given a path to evidence files, attempts rekor-cli search --artifact for each file to gather UUID.
+ - Writes ops/verify/rekor_index.json with a mapping filename -> rekor entry (best-effort).
+"""
+import argparse
+import json
+import os
+import subprocess
+from pathlib import Path
+
+OUT = Path("ops/verify/rekor_index.json")
+
+def query_rekor_for_file(fpath):
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--artifact", fpath], stderr=subprocess.STDOUT)
+        return out.decode()
+    except Exception as e:
+        return str(e)
+
+def main(paths, out):
+    mapping = {}
+    for p in paths:
+        p = Path(p)
+        if p.exists():
+            res = query_rekor_for_file(str(p))
+            mapping[str(p)] = res
+    out.write_text(json.dumps(mapping, indent=2))
+    print("Wrote Rekor index to", out)
+
+if __name__=="__main__":
+    import sys
+    ps = sys.argv[1:] or ["/tmp/evidence","/tmp"]
+    OUT.parent.mkdir(parents=True, exist_ok=True)
+    main(ps, OUT)
+
