+#!/usr/bin/env python3
+"""
+Legal signoff webhook receiver.
+
+Endpoints:
+ - POST /legal/callback
+    Payload: { "artifact_id": "<id>", "signed_by": "<legal_name>", "notes": "<optional>" }
+    Behavior: verifies payload, writes signoff metadata to Vault (if configured), creates signed manifest with cosign,
+              uploads manifest+sig to EVIDENCE_BUCKET, and returns success.
+
+Environment:
+ - COSIGN_KEY_REF: KMS reference used by cosign to sign the manifest
+ - EVIDENCE_BUCKET: s3://bucket or gs://bucket
+ - VAULT_SIGNOFF_PATH: optional, path to write signoff JSON via `vault` CLI (e.g., secret/data/aegis/legal_signoffs)
+ - ALLOW_INSECURE: if "true" will accept unsigned or unauthenticated callbacks (NOT recommended)
+"""
+import os
+import json
+import tempfile
+import subprocess
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+VAULT_SIGNOFF_PATH = os.environ.get("VAULT_SIGNOFF_PATH", "")
+ALLOW_INSECURE = os.environ.get("ALLOW_INSECURE", "false").lower() == "true"
+
+def write_vault_record(artifact_id, meta):
+    if not VAULT_SIGNOFF_PATH:
+        return False
+    try:
+        # Vault CLI: vault kv put <path> artifact=<artifact_id> metadata='<json>'
+        subprocess.check_call(["vault", "kv", "put", VAULT_SIGNOFF_PATH, f"artifact={artifact_id}", f"metadata={json.dumps(meta)}"])
+        return True
+    except Exception as e:
+        app.logger.warning("Vault write failed: %s", e)
+        return False
+
+def cosign_sign(path):
+    if not COSIGN_KEY_REF:
+        raise RuntimeError("COSIGN_KEY_REF not configured")
+    subprocess.check_call(["cosign", "sign", "--key", COSIGN_KEY_REF, path])
+    return path + ".sig"
+
+def upload_to_evidence(path):
+    if not EVIDENCE_BUCKET:
+        raise RuntimeError("EVIDENCE_BUCKET not configured")
+    if EVIDENCE_BUCKET.startswith("s3://"):
+        subprocess.check_call(["aws", "s3", "cp", path, f"{EVIDENCE_BUCKET}/{os.path.basename(path)}"])
+        return f"{EVIDENCE_BUCKET}/{os.path.basename(path)}"
+    elif EVIDENCE_BUCKET.startswith("gs://"):
+        subprocess.check_call(["gsutil", "cp", path, f"{EVIDENCE_BUCKET}/{os.path.basename(path)}"])
+        return f"{EVIDENCE_BUCKET}/{os.path.basename(path)}"
+    else:
+        raise RuntimeError("Unsupported EVIDENCE_BUCKET scheme")
+
+@app.route("/legal/callback", methods=["POST"])
+def legal_callback():
+    payload = request.get_json(force=True)
+    artifact_id = payload.get("artifact_id")
+    signer = payload.get("signed_by")
+    notes = payload.get("notes", "")
+    if not artifact_id or not signer:
+        return jsonify({"error":"artifact_id and signed_by required"}), 400
+
+    manifest = {
+        "artifact_id": artifact_id,
+        "signed_by": signer,
+        "notes": notes,
+        "ts": __import__("time").time()
+    }
+    tmp = tempfile.mkdtemp()
+    path = os.path.join(tmp, f"legal_signoff_{artifact_id}.json")
+    with open(path, "w") as f:
+        json.dump(manifest, f, indent=2)
+
+    # sign manifest
+    try:
+        sig = None
+        if COSIGN_KEY_REF:
+            cosign_sign(path)
+            sig = path + ".sig"
+    except Exception as e:
+        app.logger.error("cosign sign failed: %s", e)
+        return jsonify({"error":"sign failed", "detail":str(e)}), 500
+
+    # upload manifest (and sig) to evidence
+    try:
+        uploaded = upload_to_evidence(path)
+        if sig:
+            upload_to_evidence(sig)
+    except Exception as e:
+        app.logger.error("upload failed: %s", e)
+        return jsonify({"error":"upload failed", "detail":str(e)}), 500
+
+    recorded = write_vault_record(artifact_id, {"manifest": uploaded, "signed_by": signer, "ts": manifest["ts"]})
+    return jsonify({"ok": True, "uploaded": uploaded, "signed": bool(sig), "vault_recorded": recorded})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=8088)
+
