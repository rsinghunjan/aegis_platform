+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Attestation reproducibility check:
+# - Given an artifact id and a rebuild command (CI replay), run the replay build,
+# - verify cosign signature for produced artifact, and compare digest with stored bundle.
+#
+# Usage:
+#  ops/attestation/reproducibility_check.sh --artifact-uri s3://bucket/attestation-123.tar.gz --rebuild-cmd "./ci/rebuild.sh"
+#
+ARTIFACT_URI=""
+REBUILD_CMD=""
+TMPDIR=$(mktemp -d)
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --artifact-uri) ARTIFACT_URI="$2"; shift 2;;
+    --rebuild-cmd) REBUILD_CMD="$2"; shift 2;;
+    *) echo "Unknown $1"; exit 2;;
+  esac
+done
+
+if [ -z "$ARTIFACT_URI" ] || [ -z "$REBUILD_CMD" ]; then
+  echo "Usage: $0 --artifact-uri <s3://...|gs://...> --rebuild-cmd '<cmd>'"
+  exit 2
+fi
+
+echo "Downloading artifact $ARTIFACT_URI to $TMPDIR"
+if [[ "$ARTIFACT_URI" == s3://* ]]; then
+  aws s3 cp "$ARTIFACT_URI" "$TMPDIR/art.tar.gz"
+elif [[ "$ARTIFACT_URI" == gs://* ]]; then
+  gsutil cp "$ARTIFACT_URI" "$TMPDIR/art.tar.gz"
+else
+  curl -sSfL "$ARTIFACT_URI" -o "$TMPDIR/art.tar.gz"
+fi
+
+echo "Verifying cosign signature if present (requires COSIGN_KEY_REF or pubkey)"
+if command -v cosign >/dev/null 2>&1; then
+  echo "Attempting cosign verify (best effort) - if key ref available"
+  set +e
+  cosign verify "$TMPDIR/art.tar.gz" >/dev/null 2>&1 || true
+  set -e
+else
+  echo "cosign not in PATH; skipping verify"
+fi
+
+echo "Running rebuild command (replay)"
+# run rebuild in a subdir
+pushd "$TMPDIR" >/dev/null
+# NOTE: rebuild command should produce an attestation or artifact in same format
+eval "$REBUILD_CMD"
+popd >/dev/null
+
+echo "Compare artifacts (digest) - operator must adapt to your rebuild outputs"
+# Example: compute sha256 for original vs rebuilt artifact if rebuilt produced art_rebuilt.tar.gz
+if [ -f "$TMPDIR/art.tar.gz" ] && [ -f "$TMPDIR/art_rebuilt.tar.gz" ]; then
+  sha1=$(sha256sum "$TMPDIR/art.tar.gz" | awk '{print $1}')
+  sha2=$(sha256sum "$TMPDIR/art_rebuilt.tar.gz" | awk '{print $1}')
+  echo "original: $sha1"
+  echo "rebuilt : $sha2"
+  if [ "$sha1" = "$sha2" ]; then
+    echo "REPRODUCIBLE: digests match"
+    exit 0
+  else
+    echo "NOT REPRODUCIBLE: digests differ"
+    exit 3
+  fi
+else
+  echo "Rebuilt artifact not found; please adapt rebuild command to produce art_rebuilt.tar.gz"
+  exit 4
+fi
+
