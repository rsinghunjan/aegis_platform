+name: PR Policy Auto-Merge
+
+# This workflow runs on pull_request and consults the policy engine to decide whether to auto-merge low-risk PRs.
+# WARNING: Only enable auto-merge for repositories/teams you trust. Uses GITHUB_TOKEN for merge.
+on:
+  pull_request:
+    types: [opened, synchronize, reopened, labeled]
+
+jobs:
+  evaluate_and_maybe_merge:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write   # required to merge
+      pull-requests: write
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Gather context
+        id: ctx
+        run: |
+          echo "::set-output name=pr_number::${{ github.event.pull_request.number }}"
+          echo "::set-output name=actor::${{ github.actor }}"
+          echo "::set-output name=repo::${{ github.repository }}"
+
+      - name: Query policy engine
+        id: policy
+        env:
+          POLICY_ENGINE_URL: ${{ secrets.POLICY_ENGINE_URL }} # e.g., https://policy.example.internal/evaluate
+        run: |
+          ACTION=$(jq -r .pull_request.title <<< '${{ toJson(github.event) }}' | awk '{print tolower($0)}')
+          # Heuristic: if title contains "canary" treat as deploy_low_risk else deploy_high_risk
+          if echo "${{ github.event.pull_request.title }}" | grep -qiE 'canary|bump|chore|docs|typo'; then
+            ACTION_KEY="deploy_low_risk"
+          else
+            ACTION_KEY="deploy_high_risk"
+          fi
+          PAYLOAD="{\"action\":\"${ACTION_KEY}\",\"actor\":\"${{ github.actor }}\"}"
+          echo "Policy payload: $PAYLOAD"
+          RESP=$(curl -sSf -X POST -H "Content-Type: application/json" -d "$PAYLOAD" "${POLICY_ENGINE_URL}")
+          echo "::set-output name=resp::$RESP"
+      - name: Decide & Merge
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          RESP='${{ steps.policy.outputs.resp }}'
+          echo "Policy response: $RESP"
+          ALLOW=$(echo "$RESP" | jq -r .allow)
+          APPROVAL=$(echo "$RESP" | jq -r .policy.approval)
+          PR_NUM=${{ steps.ctx.outputs.pr_number }}
+          if [ "$ALLOW" = "true" ] && [ "$APPROVAL" = "auto" ]; then
+            echo "Auto-merge permitted by policy. Merging PR $PR_NUM"
+            curl -sSf -X PUT -H "Authorization: token $GITHUB_TOKEN" -H "Accept: application/vnd.github.v3+json" \
+              "https://api.github.com/repos/${{ github.repository }}/pulls/$PR_NUM/merge" \
+              -d '{"merge_method":"squash"}'
+          else
+            echo "PR requires manual approval. Labeling PR."
+            curl -sSf -X POST -H "Authorization: token $GITHUB_TOKEN" -H "Accept: application/vnd.github.v3+json" \
+              "https://api.github.com/repos/${{ github.repository }}/issues/$PR_NUM/labels" \
+              -d '{"labels":["requires-approval"]}'
+            curl -sSf -X POST -H "Authorization: token $GITHUB_TOKEN" -H "Accept: application/vnd.github.v3+json" \
+              "https://api.github.com/repos/${{ github.repository }}/issues/$PR_NUM/comments" \
+              -d "{\"body\":\"This PR requires manual approval per policy (approval=${APPROVAL}). Please follow the review process.\"}"
+          fi
+
