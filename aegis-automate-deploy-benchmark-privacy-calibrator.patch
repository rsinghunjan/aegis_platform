+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@v2
+
+      - name: Login to GHCR
+        uses: docker/login-action@v2
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Build and push image
+        uses: docker/build-push-action@v4
+        with:
+          context: ./ops/webhook
+          file: ./ops/webhook/Dockerfile
+          push: true
+          tags: |
+            ghcr.io/${{ github.repository_owner }}/admission-webhook:latest
+            ghcr.io/${{ github.repository_owner }}/admission-webhook:${{ github.sha }}
