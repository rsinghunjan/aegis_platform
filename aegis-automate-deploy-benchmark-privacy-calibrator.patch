+#!/usr/bin/env python3
+"""
+Push privacy decision report to Vault and optionally upload to evidence bucket.
+Requires vault CLI (or use hvac client) configured with VAULT_ADDR & VAULT_TOKEN.
+"""
+import argparse, subprocess, os, json, time
+
+def upload_to_s3(path, bucket):
+    if not bucket:
+        return None
+    cmd = ["aws","s3","cp", path, f"{bucket.rstrip('/')}/privacy_reports/"]
+    subprocess.check_call(cmd)
+    return f"{bucket.rstrip('/')}/privacy_reports/{os.path.basename(path)}"
+
+def vault_put(vault_path, data):
+    # using vault CLI kv put; expects VAULT_ADDR & VAULT_TOKEN env
+    kv_cmd = ["vault","kv","put", vault_path]
+    for k,v in data.items():
+        kv_cmd.append(f"{k}={v}")
+    subprocess.check_call(kv_cmd)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--report", required=True)
+    p.add_argument("--vault-path", default="secret/data/aegis/privacy_decisions")
+    p.add_argument("--evidence-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    args = p.parse_args()
+    s3_uri = upload_to_s3(args.report, args.evidence_bucket)
+    meta = {"report_uri": s3_uri or f"file://{args.report}", "ts": int(time.time())}
+    try:
+        vault_put(args.vault_path, meta)
+        print("Wrote decision metadata to Vault at", args.vault_path)
+    except Exception as e:
+        print("Failed to write to Vault:", e)
+
+if __name__=="__main__":
+    main()
+
