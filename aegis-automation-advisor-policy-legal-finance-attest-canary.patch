+#!/usr/bin/env python3
+"""
+Kill-switch checker: consult Vault (or a config file) to determine if automated actions are allowed.
+All automation entrypoints should call check() before performing destructive actions.
+"""
+import os
+import subprocess
+
+VAULT_PATH = os.environ.get("KILL_SWITCH_VAULT_PATH","secret/data/aegis/kill_switch")
+
+def check_vault_kill_switch():
+    try:
+        out = subprocess.check_output(["vault","kv","get","-field=value", VAULT_PATH], universal_newlines=True)
+        if out.strip().lower() == "on":
+            return True
+    except Exception:
+        # If Vault not available, default to safe: enabled kill switch (don't proceed)
+        return True
+    return False
+
+def is_killed():
+    return check_vault_kill_switch()
+
+if __name__ == "__main__":
+    print("kill_switch enabled:", is_killed())
+
