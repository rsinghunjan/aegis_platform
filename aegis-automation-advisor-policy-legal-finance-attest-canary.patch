+#!/usr/bin/env python3
+"""
+Advisor agent: given a small YAML service spec, generate IaC (Terraform) and CI (GitHub Actions)
+templates, run unit tests, and create a branch with the generated artifacts for operator review.
+
+This is intended to automate repeated consultant tasks: generate opinionated templates, run
+the acceptance harness, and surface a ready-to-review PR branch. It does NOT auto-merge.
+"""
+import os
+import sys
+import yaml
+import subprocess
+from jinja2 import Environment, FileSystemLoader, StrictUndefined
+from pathlib import Path
+import tempfile
+
+TEMPLATE_DIR = Path(__file__).parent / "templates"
+
+def load_spec(path):
+    with open(path) as f:
+        return yaml.safe_load(f)
+
+def render_templates(spec, out_dir):
+    env = Environment(loader=FileSystemLoader(str(TEMPLATE_DIR)), undefined=StrictUndefined)
+    rendered = []
+    for t in ["terraform.tf.j2", "ci.yml.j2", "k8s_deployment.yaml.j2"]:
+        tpl = env.get_template(t)
+        text = tpl.render(spec=spec)
+        out_path = Path(out_dir) / t.replace(".j2","")
+        out_path.write_text(text)
+        rendered.append(out_path)
+    return rendered
+
+def run_unit_tests(out_dir):
+    # Unit test placeholder: ensure generated files parse as YAML where applicable
+    errors = []
+    tf = Path(out_dir) / "terraform.tf"
+    ci = Path(out_dir) / "ci.yml"
+    k8s = Path(out_dir) / "k8s_deployment.yaml"
+    for p in [ci, k8s]:
+        try:
+            import yaml
+            yaml.safe_load(p.read_text())
+        except Exception as e:
+            errors.append((p, str(e)))
+    return errors
+
+def create_branch_with_files(out_dir, repo_dir=".", branch_prefix="advisor"):
+    timestamp = __import__("time").strftime("%Y%m%d%H%M%S", __import__("time").gmtime())
+    branch = f"{branch_prefix}/{timestamp}"
+    subprocess.check_call(["git","checkout","-b",branch], cwd=repo_dir)
+    for p in Path(out_dir).iterdir():
+        dest = Path(repo_dir) / "generated" / p.name
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        dest.write_text(p.read_text())
+        subprocess.check_call(["git","add", str(dest)], cwd=repo_dir)
+    subprocess.check_call(["git","commit","-m",f"Advisor: add generated templates {timestamp}"], cwd=repo_dir)
+    print("Created branch", branch, "with generated artifacts. Push branch and open a PR for review.")
+    return branch
+
+def main():
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--spec", required=True, help="service spec YAML")
+    p.add_argument("--out", default=None, help="output dir (temp if omitted)")
+    p.add_argument("--repo", default=".", help="git repo to create branch in")
+    args = p.parse_args()
+    spec = load_spec(args.spec)
+    out = args.out or tempfile.mkdtemp(prefix="advisor-")
+    print("Rendering templates to", out)
+    render_templates(spec, out)
+    errs = run_unit_tests(out)
+    if errs:
+        print("Unit test errors:", errs)
+        sys.exit(2)
+    branch = create_branch_with_files(out, repo_dir=args.repo)
+    print("Done. Next: push and open PR:", f"git push origin {branch}")
+
+if __name__ == "__main__":
+    main()
+
