+#!/usr/bin/env python3
+"""
+Collect job evidence + hardware inventory, bundle, cosign-sign with KMS, and upload to WORM evidence store.
+Includes driver versions and device IDs for chain-of-custody.
+"""
+import os, tempfile, subprocess, json, time
+from pathlib import Path
+from ops.attestation.hardware_inventory import gather_all
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def collect_job_evidence(job_id, job_dir="./job_evidence"):
+    # Collect logs/artifacts for a specific job
+    out = []
+    base = Path(job_dir)
+    if base.exists():
+        for p in base.rglob("*"):
+            if p.is_file():
+                out.append(str(p))
+    return out
+
+def bundle_and_sign(items, out_prefix="att"):
+    tmp = tempfile.mkdtemp()
+    bundle = Path(tmp) / f"{out_prefix}-{int(time.time())}.tar.gz"
+    subprocess.check_call(["tar","-czf", str(bundle)] + items)
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, str(bundle)])
+    return str(bundle)
+
+def upload(bundle, prefix="attestations"):
+    if not EVIDENCE_BUCKET:
+        print("No EVIDENCE_BUCKET set; skipping upload")
+        return None
+    key = f"{prefix}/{Path(bundle).name}"
+    subprocess.check_call(["aws","s3","cp", bundle, f"{EVIDENCE_BUCKET}/{key}"])
+    return f"{EVIDENCE_BUCKET}/{key}"
+
+def create_attestation(job_id):
+    hw = gather_all()
+    job_items = collect_job_evidence(job_id)
+    # write hw json
+    tmpdir = tempfile.mkdtemp()
+    hw_path = Path(tmpdir) / "hardware.json"
+    hw_path.write_text(json.dumps(hw, indent=2))
+    items = job_items + [str(hw_path)]
+    bundle = bundle_and_sign(items, out_prefix=f"attestation-{job_id}")
+    uri = upload(bundle)
+    meta = {"job_id": job_id, "bundle_uri": uri, "signed": bool(COSIGN_KEY_REF), "ts": int(time.time())}
+    meta_path = Path(tmpdir) / "attestation.json"
+    meta_path.write_text(json.dumps(meta, indent=2))
+    if COSIGN_KEY_REF:
+        subprocess.call(["cosign","sign","--key", COSIGN_KEY_REF, str(meta_path)])
+    if EVIDENCE_BUCKET:
+        subprocess.check_call(["aws","s3","cp", str(meta_path), f"{EVIDENCE_BUCKET}/attestations/{meta_path.name}"])
+    return meta
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--job-id", required=True)
+    args = p.parse_args()
+    print("Creating attestation for job", args.job_id)
+    print(create_attestation(args.job_id))
+
