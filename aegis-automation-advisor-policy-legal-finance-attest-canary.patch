+#!/usr/bin/env python3
+"""
+Finance reconcile with automatic ticketing and optional auto-blocking policy.
+On mismatch, create a GitHub issue (or call FINANCE_ALERT_WEBHOOK) and optionally call quota service
+to block tenant if auto-block policy enabled.
+"""
+import os, requests, psycopg2, json
+DATABASE_URL = os.environ.get("DATABASE_URL","postgresql://postgres:postgres@postgres:5432/quota")
+FINANCE_API = os.environ.get("FINANCE_API","")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK","")
+GITHUB_REPO = os.environ.get("GITHUB_REPO","")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN","")
+AUTO_BLOCK = os.environ.get("FINANCE_AUTO_BLOCK","false").lower() == "true"
+QUOTA_SERVICE = os.environ.get("QUOTA_SERVICE","http://aegis-quota.ml-serving.svc:8082")
+
+def post_finance_charge(record):
+    if not FINANCE_API:
+        return {"status":"skipped"}
+    r = requests.post(FINANCE_API.rstrip("/") + "/charges", json=record, timeout=10)
+    return {"status": r.status_code, "body": r.text}
+
+def create_issue(title, body):
+    if GITHUB_TOKEN and GITHUB_REPO:
+        url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+        headers = {"Authorization": f"token {GITHUB_TOKEN}"}
+        r = requests.post(url, json={"title": title, "body": body}, headers=headers, timeout=10)
+        return r.json()
+    if ALERT_WEBHOOK:
+        requests.post(ALERT_WEBHOOK, json={"title": title, "body": body})
+        return {"status":"webhook_sent"}
+    return {"error":"no alert configured"}
+
+def block_tenant(tenant):
+    # call quota service to set tenant quota to 0 or a block flag (assumes service supports it)
+    try:
+        r = requests.post(f"{QUOTA_SERVICE}/admin/block", json={"tenant": tenant}, timeout=10)
+        return r.status_code == 200
+    except Exception:
+        return False
+
+def reconcile():
+    conn = psycopg2.connect(DATABASE_URL)
+    with conn.cursor() as cur:
+        cur.execute("SELECT rid, tenant, amount, created_at FROM reservations")
+        rows = cur.fetchall()
+        mismatches=[]
+        for rid,tenant,amount,created_at in rows:
+            rec = {"id": rid, "tenant": tenant, "amount": int(amount), "ts": int(created_at)}
+            res = post_finance_charge(rec)
+            if res.get("status") not in (200,201,"skipped"):
+                mismatches.append({"rid": rid, "tenant": tenant, "status": res})
+                # create ticket
+                title = f"Finance reconcile mismatch for {rid}"
+                body = f"Record: {rec}\nResponse: {res}"
+                create_issue(title, body)
+                if AUTO_BLOCK:
+                    ok = block_tenant(tenant)
+                    if ok:
+                        create_issue(f"Tenant {tenant} auto-blocked", f"Auto-block applied for tenant {tenant} due to reconcile mismatch")
+    print("Reconcile done. mismatches:", len(mismatches))
+
+if __name__ == "__main__":
+    reconcile()
+
