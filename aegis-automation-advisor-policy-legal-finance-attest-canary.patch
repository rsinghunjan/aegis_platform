+#!/usr/bin/env python3
+"""
+Simple policy engine and RBAC store.
+Policies are JSON/YAML rules that map actions to requirements (roles, approval levels).
+The engine exposes a small HTTP API for evaluation.
+"""
+import yaml, os, json
+from flask import Flask, request, jsonify
+
+POLICY_PATH = os.environ.get("AEGIS_POLICY_PATH","./policies/policies.yaml")
+RBAC_PATH = os.environ.get("AEGIS_RBAC_PATH","./policies/rbac.yaml")
+
+def load_policies():
+    try:
+        return yaml.safe_load(open(POLICY_PATH))
+    except Exception:
+        return {}
+
+def load_rbac():
+    try:
+        return yaml.safe_load(open(RBAC_PATH))
+    except Exception:
+        return {}
+
+def evaluate(action, actor):
+    policies = load_policies()
+    rbac = load_rbac()
+    role = rbac.get("users",{}).get(actor)
+    if not role:
+        return {"allow": False, "reason": "unknown actor"}
+    rule = policies.get("actions",{}).get(action)
+    if not rule:
+        return {"allow": False, "reason": "no policy for action"}
+    required_roles = rule.get("required_roles", [])
+    if role in required_roles or "admin" in required_roles and role=="admin":
+        return {"allow": True, "reason": "role satisfied", "policy": rule}
+    # decision tree: check approval_level
+    approval = rule.get("approval", "manual")
+    return {"allow": False, "reason": "requires approval", "approval": approval}
+
+app = Flask(__name__)
+
+@app.route("/evaluate", methods=["POST"])
+def eval_api():
+    payload = request.get_json(force=True)
+    action = payload.get("action")
+    actor = payload.get("actor")
+    return jsonify(evaluate(action, actor))
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=8085)
+
