+#!/usr/bin/env python3
+"""
+Automated legal workflow:
+ - create legal review ticket (via webhook or GitHub issues)
+ - poll for signoff (human completes review)
+ - when signed, create a signoff manifest and cosign-sign it (KMS)
+"""
+import os, json, time, subprocess, requests
+
+LEGAL_WEBHOOK = os.environ.get("LEGAL_WEBHOOK","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+GITHUB_REPO = os.environ.get("GITHUB_REPO","")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN","")
+
+def create_ticket(title, body):
+    if LEGAL_WEBHOOK:
+        requests.post(LEGAL_WEBHOOK, json={"title": title, "body": body}, timeout=10)
+        return {"status":"webhook_sent"}
+    # fallback to GitHub issue if token set
+    if GITHUB_TOKEN and GITHUB_REPO:
+        url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+        headers = {"Authorization": f"token {GITHUB_TOKEN}"}
+        r = requests.post(url, json={"title": title, "body": body}, headers=headers, timeout=10)
+        return r.json()
+    return {"error":"no legal webhook or GH configured"}
+
+def poll_for_signoff(issue_url, timeout=3600, interval=30):
+    # Basic poll: operator updates issue with "SIGNED" tag or comment
+    elapsed = 0
+    while elapsed < timeout:
+        if LEGAL_WEBHOOK:
+            # assume webhook integration will POST back to a callback - no op here
+            time.sleep(interval); elapsed += interval; continue
+        if GITHUB_TOKEN and issue_url:
+            headers = {"Authorization": f"token {GITHUB_TOKEN}"}
+            r = requests.get(issue_url, headers=headers, timeout=10)
+            j = r.json()
+            if "closed_at" in j and j["closed_at"]:
+                return {"signed_by":"legal", "issue": j}
+        time.sleep(interval); elapsed += interval
+    return {"error":"timeout"}
+
+def create_signoff_manifest(artifact_id, legal_actor):
+    manifest = {"artifact_id": artifact_id, "legal_signoff": True, "signed_by": legal_actor, "ts": int(time.time())}
+    path = f"/tmp/legal_signoff_{artifact_id}.json"
+    with open(path,"w") as f:
+        json.dump(manifest,f)
+    if COSIGN_KEY_REF:
+        try:
+            subprocess.check_call(["cosign","sign","--key",COSIGN_KEY_REF, path])
+            return {"manifest": path, "signed": True}
+        except Exception as e:
+            return {"manifest": path, "signed": False, "error": str(e)}
+    return {"manifest": path, "signed": False}
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifact-id", required=True)
+    p.add_argument("--title", default="Legal review requested")
+    p.add_argument("--body", default="Please review forensic artifacts.")
+    args = p.parse_args()
+    t = create_ticket(args.title, args.body)
+    print("Ticket created:", t)
+    # In real flow, poll_for_signoff used by operator automation to wait for signoff
+
