+#!/usr/bin/env python3
+"""
+Production finance reconciliation runner that:
+ - reads finance API credentials from Vault (via `vault` CLI)
+ - posts charges, writes reconcile log to Postgres, creates tickets on mismatch and optionally auto-blocks tenants
+
+Requires:
+ - DATABASE_URL env var
+ - VAULT_FINANCE_PATH env var (path to kv v2 where {api, api_key} stored)
+ - QUOTA_SERVICE env var (quota admin endpoint)
+ - GITHUB_REPO + GITHUB_TOKEN or ALERT_WEBHOOK for ticketing
+ - FINANCE_AUTO_BLOCK=true to enable auto-block behavior (use cautiously)
+"""
+import os
+import subprocess
+import json
+import time
+import requests
+import psycopg2
+
+DATABASE_URL = os.environ.get("DATABASE_URL")
+VAULT_FINANCE_PATH = os.environ.get("VAULT_FINANCE_PATH","secret/data/aegis/finance")
+QUOTA_SERVICE = os.environ.get("QUOTA_SERVICE","http://aegis-quota.ml-serving.svc:8082")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK","")
+GITHUB_REPO = os.environ.get("GITHUB_REPO","")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN","")
+FINANCE_AUTO_BLOCK = os.environ.get("FINANCE_AUTO_BLOCK","false").lower() == "true"
+
+def vault_get(key):
+    try:
+        out = subprocess.check_output(["vault","kv","get","-field=value", f"{VAULT_FINANCE_PATH}/{key}"], universal_newlines=True)
+        return out.strip()
+    except Exception as e:
+        print("Vault read failed:", e)
+        raise
+
+def get_finance_creds():
+    api = vault_get("api")
+    api_key = vault_get("api_key")
+    return api, api_key
+
+def post_charge(finance_api, api_key, record):
+    headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}
+    r = requests.post(finance_api.rstrip("/") + "/charges", json=record, headers=headers, timeout=15)
+    return r
+
+def create_ticket(title, body):
+    if GITHUB_TOKEN and GITHUB_REPO:
+        url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+        headers = {"Authorization": f"token {GITHUB_TOKEN}"}
+        r = requests.post(url, json={"title": title, "body": body}, headers=headers, timeout=15)
+        return r.json()
+    if ALERT_WEBHOOK:
+        requests.post(ALERT_WEBHOOK, json={"title": title, "body": body}, timeout=15)
+        return {"status":"webhook_sent"}
+    return {"error":"no-alert-configured"}
+
+def block_tenant(tenant):
+    try:
+        r = requests.post(f"{QUOTA_SERVICE}/admin/block", json={"tenant": tenant}, timeout=10)
+        return r.status_code == 200
+    except Exception as e:
+        print("Block tenant failed:", e)
+        return False
+
+def main():
+    if not DATABASE_URL:
+        raise RuntimeError("DATABASE_URL required")
+    finance_api, api_key = get_finance_creds()
+    conn = psycopg2.connect(DATABASE_URL)
+    with conn.cursor() as cur:
+        cur.execute("SELECT rid, tenant, amount, created_at FROM reservations")
+        rows = cur.fetchall()
+        for rid, tenant, amount, created_at in rows:
+            rec = {"id": rid, "tenant": tenant, "amount": int(amount), "ts": int(created_at)}
+            try:
+                resp = post_charge(finance_api, api_key, rec)
+                if resp.status_code not in (200,201):
+                    title = f"Finance reconcile mismatch: {rid}"
+                    body = f"Reservation: {rec}\nResponse: {resp.status_code} {resp.text}"
+                    create_ticket(title, body)
+                    if FINANCE_AUTO_BLOCK:
+                        ok = block_tenant(tenant)
+                        if ok:
+                            create_ticket(f"Tenant {tenant} auto-blocked", f"Tenant {tenant} auto-blocked due to reconcile failure for {rid}")
+                else:
+                    # write reconciliation log
+                    cur.execute("INSERT INTO reconciliation_log (rid, status, response, created_at) VALUES (%s,%s,%s,extract(epoch from now())::bigint)",
+                                (rid, "ok", resp.text))
+                    conn.commit()
+            except Exception as e:
+                create_ticket("Finance reconcile runner error", str(e))
+    conn.close()
+
+if __name__ == "__main__":
+    main()
+
