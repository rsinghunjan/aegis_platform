+#!/usr/bin/env python3
+"""
+Simple GitHub PR controller that:
+ - watches a repository for new PRs (polling)
+ - uses the policy engine to determine if the PR corresponds to a low-risk or high-risk action
+ - if policy allows auto-merge, merges the PR; otherwise, labels and comments that manual approval is required
+
+Environment:
+ - GITHUB_REPO: owner/repo
+ - GITHUB_TOKEN: token with repo access
+ - POLICY_ENGINE_URL: http://policy-engine:8085/evaluate
+"""
+import os
+import time
+import requests
+
+GITHUB_REPO = os.environ.get("GITHUB_REPO", "")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN", "")
+POLL_INTERVAL = int(os.environ.get("PR_CONTROLLER_POLL", "30"))
+POLICY_ENGINE_URL = os.environ.get("POLICY_ENGINE_URL", "http://localhost:8085/evaluate")
+
+HEADERS = {"Authorization": f"token {GITHUB_TOKEN}", "Accept": "application/vnd.github.v3+json"}
+
+def list_open_prs():
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/pulls"
+    r = requests.get(url, headers=HEADERS, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def post_comment(pr_number, body):
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues/{pr_number}/comments"
+    r = requests.post(url, headers=HEADERS, json={"body": body}, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def add_label(pr_number, labels):
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues/{pr_number}/labels"
+    r = requests.post(url, headers=HEADERS, json={"labels": labels}, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def merge_pr(pr_number):
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/pulls/{pr_number}/merge"
+    r = requests.put(url, headers=HEADERS, json={"merge_method": "squash"}, timeout=30)
+    return r.status_code == 200
+
+def infer_action_from_pr(pr):
+    # Basic heuristic: if PR title contains "canary" or "scale" treat as low risk
+    title = pr.get("title","").lower()
+    if "canary" in title or "bump" in title or "chore" in title:
+        return "deploy_low_risk"
+    return "deploy_high_risk"
+
+def evaluate_policy(action, actor):
+    r = requests.post(POLICY_ENGINE_URL, json={"action": action, "actor": actor}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def process_pr(pr):
+    pr_number = pr["number"]
+    actor = pr["user"]["login"]
+    action = infer_action_from_pr(pr)
+    policy = evaluate_policy(action, actor)
+    if policy.get("allow") and policy.get("reason") == "role satisfied" and policy.get("policy",{}).get("approval") == "auto":
+        merged = merge_pr(pr_number)
+        if merged:
+            post_comment(pr_number, "Auto-merged by Aegis PR controller per policy.")
+            print("Merged PR", pr_number)
+            return
+    # Otherwise, leave PR for manual review, add label and comment
+    add_label(pr_number, ["requires-approval"])
+    post_comment(pr_number, "This PR requires manual approval per policy. Aegis has opened the PR and awaits platform lead approval.")
+    print("PR", pr_number, "requires manual approval")
+
+def main_loop():
+    while True:
+        prs = list_open_prs()
+        for pr in prs:
+            # Skip PRs already labeled
+            labels = [l["name"] for l in pr.get("labels",[])]
+            if "requires-approval" in labels or "merged" in labels:
+                continue
+            process_pr(pr)
+        time.sleep(POLL_INTERVAL)
+
+if __name__ == "__main__":
+    if not GITHUB_REPO or not GITHUB_TOKEN:
+        print("GITHUB_REPO and GITHUB_TOKEN must be set")
+        raise SystemExit(2)
+    main_loop()
+
