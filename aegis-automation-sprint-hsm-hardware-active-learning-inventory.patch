+#!/usr/bin/env python3
+"""
+Active learning labeling loop (uncertainty sampling by prediction entropy).
+ - Given an unlabeled CSV with columns: id,text
+ - Calls a model prediction endpoint to get class probabilities
+ - Computes entropy; selects top-K most uncertain examples to export as labeling tasks (CSV)
+ - Optionally creates GitHub issues for labeling tasks (requires GITHUB_TOKEN & GITHUB_REPO)
+
+Usage:
+  python3 services/labeling/active_learning_loop.py --unlabeled data/unlabeled.csv --out labels/to_label.csv --k 500 --model-endpoint http://llm-proxy:8083/v1/classify
+"""
+import argparse, csv, math, requests, os, json
+
+def entropy(probs):
+    return -sum([p * math.log(p+1e-12) for p in probs])
+
+def get_probs_for_text(endpoint, text):
+    # Expect endpoint to return JSON { "probs": [p0,p1,...] } or raw logits -> softmax
+    try:
+        r = requests.post(endpoint, json={"text": text}, timeout=10)
+        r.raise_for_status()
+        j = r.json()
+        return j.get("probs") or j.get("probabilities") or j.get("softmax")
+    except Exception as e:
+        print("Model call failed:", e)
+        return None
+
+def create_github_issue(repo, token, title, body):
+    url = f"https://api.github.com/repos/{repo}/issues"
+    hdr = {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+    r = requests.post(url, json={"title": title, "body": body}, headers=hdr, timeout=10)
+    if r.status_code in (200,201):
+        return r.json().get("html_url")
+    else:
+        print("GitHub issue create failed:", r.status_code, r.text)
+        return None
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--unlabeled", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--k", type=int, default=500)
+    p.add_argument("--model-endpoint", required=True)
+    p.add_argument("--github-repo", default=os.environ.get("GITHUB_REPO",""))
+    p.add_argument("--github-token", default=os.environ.get("GITHUB_TOKEN",""))
+    args=p.parse_args()
+
+    rows=[]
+    with open(args.unlabeled) as fh:
+        reader=csv.DictReader(fh)
+        for r in reader:
+            rows.append(r)
+    scored=[]
+    for r in rows:
+        txt = r.get("text","")
+        probs = get_probs_for_text(args.model_endpoint, txt)
+        if not probs:
+            continue
+        e = entropy(probs)
+        scored.append({"id": r.get("id"), "text": txt, "entropy": e, "probs": probs})
+    scored_sorted = sorted(scored, key=lambda x: x["entropy"], reverse=True)
+    selected = scored_sorted[:args.k]
+    # write out CSV
+    with open(args.out,"w",newline="") as fh:
+        writer = csv.writer(fh)
+        writer.writerow(["id","text","entropy"])
+        for s in selected:
+            writer.writerow([s["id"], s["text"], s["entropy"]])
+    print("Wrote", args.out, "selected", len(selected))
+    # optionally create GitHub issues
+    if args.github_repo and args.github_token:
+        for s in selected:
+            title = f"Labeling task: {s['id']}"
+            body = f"Text to label:\n\n```\n{s['text']}\n```\n\nEntropy: {s['entropy']}\n\nPlease label as supported(1)/hallucinated(0) and comment with `label: 1` or `label: 0`."
+            url = create_github_issue(args.github_repo, args.github_token, title, body)
+            print("Created issue:", url)
+
+if __name__=="__main__":
+    main()
+
