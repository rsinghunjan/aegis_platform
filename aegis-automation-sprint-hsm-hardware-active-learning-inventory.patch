+#!/usr/bin/env python3
+"""
+Repo inventory automation: scans repository and heuristically classifies items as:
+ - automated: CI/workflow present or executable script that appears automated
+ - scaffolded: templates / runbooks present but operator required
+ - manual_required: clearly marked 'manual' or runbook-only items (HSM init, auditor)
+
+Outputs JSON and CSV summary.
+"""
+import os, json, csv, re
+
+ROOT = "."
+WORKFLOW_DIR = ".github/workflows"
+KEYWORDS_AUTOMATED = ["workflow_dispatch", "on: push", "ci", "actions", "gitlab-ci", "circleci", "run: docker", "runs-on"]
+KEYWORDS_MANUAL = ["manual", "operator", "human", "auditor", "rotation_ceremony", "offline", "paper"]
+
+def scan_files():
+    items=[]
+    for dirpath, dirs, files in os.walk(ROOT):
+        # skip .git
+        if "/.git/" in dirpath or dirpath.startswith("./.git"):
+            continue
+        for fn in files:
+            path = os.path.join(dirpath, fn)
+            try:
+                with open(path, errors="ignore") as fh:
+                    txt = fh.read(10000)
+            except Exception:
+                continue
+            kind = "scaffolded"
+            # heuristics for automation
+            if path.startswith(WORKFLOW_DIR) or any(k in txt for k in KEYWORDS_AUTOMATED):
+                kind = "automated"
+            if any(k in txt.lower() for k in KEYWORDS_MANUAL):
+                kind = "manual_required"
+            items.append({"path": path, "classification": kind})
+    return items
+
+def write_outputs(items):
+    with open("/tmp/aegis_inventory.json","w") as fh:
+        json.dump(items, fh, indent=2)
+    with open("/tmp/aegis_inventory.csv","w", newline="") as fh:
+        w=csv.writer(fh)
+        w.writerow(["path","classification"])
+        for it in items:
+            w.writerow([it["path"], it["classification"]])
+    print("Wrote /tmp/aegis_inventory.json and /tmp/aegis_inventory.csv")
+
+def summary(items):
+    counts={}
+    for it in items:
+        counts[it["classification"]] = counts.get(it["classification"],0)+1
+    print("Inventory summary:", counts)
+
+if __name__=="__main__":
+    items = scan_files()
+    summary(items)
+    write_outputs(items)
+
