+#!/usr/bin/env python3
+"""
+Auto-rotate workflow orchestrator (operator-driven, safe).
+
+This script assists operators by:
+ - recording an issuance manifest for a new key
+ - staging the new key into Vault
+ - re-signing artifacts (calls rotate_and_resign.py) in dry-run or active mode
+ - optionally promoting the staged key to active after operator & auditor confirmation
+ - recording events in Vault and optionally uploading manifests to evidence bucket
+
+CRITICAL: This script does NOT auto-create CloudHSM clusters or CMKs. Those steps remain manual.
+
+Usage:
+  python3 ops/hsm/auto_rotate_workflow.py --new-key-arn arn:aws:kms:... --artifact-list artifacts.txt --evidence-bucket s3://my-evidence --vault-kms-path secret/data/aegis/kms --dry-run
+"""
+import argparse, subprocess, json, time, os
+
+def write_issuance_manifest(key_arn, operator, notes="/tmp"):
+    from datetime import datetime
+    manifest = {"key_ref": key_arn, "operator": operator, "notes": notes, "ts": int(time.time())}
+    fn = f"/tmp/issuance_manifest_{int(time.time())}.json"
+    with open(fn,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    print("Wrote issuance manifest:", fn)
+    return fn
+
+def stage_key_in_vault(key_arn, vault_path):
+    entry = f"aws-kms://{key_arn}" if not key_arn.startswith("aws-kms://") and "arn:aws:kms" in key_arn else key_arn
+    print("Staging key entry into Vault path:", vault_path + "/staging")
+    subprocess.check_call(["vault","kv","put", f"{vault_path}/staging", f"cosign_key_refs={entry}"])
+
+def re_sign_artifacts(artifact_list, new_key_ref, dry_run=True):
+    if dry_run:
+        print("Dry-run: would re-sign artifacts listed in", artifact_list, "with", new_key_ref)
+        return
+    # call helper to re-sign
+    cmd = ["python3","ops/hsm/rotate_and_resign.py","--artifact-list", artifact_list, "--new-key", new_key_ref]
+    subprocess.check_call(cmd)
+
+def promote_to_active(vault_path, new_key_ref):
+    print("Promoting staged key to active at", vault_path)
+    subprocess.check_call(["vault","kv","put", vault_path, f"cosign_key_refs={new_key_ref}"])
+
+def upload_manifest_to_s3(manifest_path, bucket):
+    if not bucket:
+        return None
+    if not bucket.startswith("s3://"):
+        raise RuntimeError("Only s3:// supported for evidence upload")
+    subprocess.check_call(["aws","s3","cp", manifest_path, f"{bucket.rstrip('/')}/kms_manifests/"])
+    return f"{bucket.rstrip('/')}/kms_manifests/{os.path.basename(manifest_path)}"
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--new-key-arn", required=True)
+    p.add_argument("--artifact-list", required=True)
+    p.add_argument("--evidence-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    p.add_argument("--vault-kms-path", default="secret/data/aegis/kms")
+    p.add_argument("--operator", default=os.environ.get("USER","operator"))
+    p.add_argument("--dry-run", action="store_true")
+    args=p.parse_args()
+
+    print("Auto-rotate workflow starting (dry-run=%s)" % args.dry_run)
+    manifest = write_issuance_manifest(args.new_key_arn, args.operator)
+    if args.evidence_bucket and not args.dry_run:
+        uri = upload_manifest_to_s3(manifest, args.evidence_bucket)
+        print("Uploaded issuance manifest to", uri)
+    # Stage key in Vault staging
+    stage_key_in_vault(args.new_key_arn, args.vault_kms_path)
+    print("STAGED. Request auditor approval and record confirmations in Vault. Pausing for operator confirmation.")
+    input("Press ENTER after auditor approval has been recorded in Vault staging (or Ctrl-C to abort)...")
+
+    # Re-sign artifacts
+    new_key_ref = f"aws-kms://{args.new_key_arn}" if not args.new_key_arn.startswith("aws-kms://") else args.new_key_arn
+    re_sign_artifacts(args.artifact_list, new_key_ref, dry_run=args.dry_run)
+
+    if args.dry_run:
+        print("Dry-run complete. No promotion performed.")
+        return
+
+    # Final operator confirmation before promoting active
+    confirm = input("Type 'PROMOTE' to promote staged key to active (or anything else to abort): ")
+    if confirm.strip() == "PROMOTE":
+        promote_to_active(args.vault_kms_path, new_key_ref)
+        print("Promotion complete.")
+    else:
+        print("Promotion aborted by operator.")
+
+if __name__=="__main__":
+    main()
+
