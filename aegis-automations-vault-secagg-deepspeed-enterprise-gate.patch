+/*
+Terraform placeholder for provisioning Vault PKI and a role for issuing client certificates.
+Replace provider/region with your cloud provider configuration, secure the state, and set real values.
+This is a scaffold — review and adapt to your infra and security policies before running.
+*/
+terraform {
+  required_providers {
+    vault = {
+      source  = "hashicorp/vault"
+      version = ">= 3.0.0"
+    }
+  }
+}
+
+provider "vault" {
+  # VAULT_ADDR and VAULT_TOKEN should be provided via environment or CI secrets
+  address = var.vault_addr
+  token   = var.vault_token
+}
+
+variable "vault_addr" {}
+variable "vault_token" {}
+variable "pki_mount" { default = "pki" }
+variable "role_name" { default = "aegis-fl-client-role" }
+
+resource "vault_mount" "pki" {
+  path = var.pki_mount
+  type = "pki"
+  description = "PKI engine for Aegis FL client certs"
+}
+
+resource "vault_pki_secret_backend_root_cert" "root" {
+  backend = vault_mount.pki.path
+  common_name = "aegis.internal"
+  ttl = "87600h"
+}
+
+resource "vault_pki_secret_backend_role" "client_role" {
+  backend = vault_mount.pki.path
+  name = var.role_name
+  allowed_domains = ["aegis.internal"]
+  allow_subdomains = true
+  max_ttl = "24h"
+}
+
+output "pki_mount" {
+  value = vault_mount.pki.path
+}
+
