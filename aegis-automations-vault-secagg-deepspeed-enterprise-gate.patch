+kubectl get pods -n cert-manager >/dev/null 2>&1 || kubectl apply -f https://github.com/cert-manager/cert-manager/releases/latest/download/cert-manager.yaml
+
+echo "2) Apply ClusterIssuer and Certificate"
+kubectl apply -f ops/webhook/cert-manager/cluster-issuer.yaml
+kubectl apply -f ops/webhook/cert-manager/webhook-certificate.yaml -n "$NS"
+
+echo "3) Deploy image validator and webhook"
+kubectl apply -f ops/webhook/image-validator-deployment.yaml -n "$NS"
+kubectl apply -f ops/webhook/k8s/image-webhook-configuration.yaml
+
+echo "4) Patch webhook caBundle"
+bash ops/webhook/patch_webhook_cabundle.sh "$NS" "aegis-webhooks-tls" "aegis-image-signature-webhook" || true
+
+echo "Image webhook deploy complete. Validate by creating a test Pod referencing an unsigned image and expect rejection (if ALLOW unsigned not set)."
