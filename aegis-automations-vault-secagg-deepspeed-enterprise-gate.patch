+#!/usr/bin/env bash
+set -euo pipefail
+#
+# DeepSpeed autotune runner (scaffold)
+# Runs a small matrix of NCCL/network tuning parameters and archives logs to S3 (placeholder).
+OUTDIR="${OUTDIR:-/tmp/deepspeed_autotune_$(date +%s)}"
+mkdir -p "$OUTDIR"
+NODES=${NODES:-2}
+GPUS_PER_NODE=${GPUS_PER_NODE:-1}
+RDZV="${RDZV_ENDPOINT:-localhost:29500}"
+declare -a SOCKETS=("eth0" "ens5")
+declare -a IB=("0" "1")
+
+for sock in "${SOCKETS[@]}"; do
+  for ib in "${IB[@]}"; do
+    echo "Run with NCCL_SOCKET_IFNAME=$sock NCCL_IB_DISABLE=$((1-ib))"
+    export NCCL_SOCKET_IFNAME="$sock"
+    export NCCL_IB_DISABLE=$((1-ib))
+    LOGDIR="$OUTDIR/run_${sock}_ib${ib}"
+    mkdir -p "$LOGDIR"
+    # run a torch.distributed smoke to exercise NCCL
+    python3 -m torch.distributed.run --nproc_per_node=${GPUS_PER_NODE} --nnodes=${NODES} --rdzv_backend=c10d --rdzv_endpoint=${RDZV} ops/ml/validation/train_small.py > "$LOGDIR/train.log" 2>&1 || echo "Run failed (check $LOGDIR/train.log)"
+    # collect dmesg / nvidia-smi snapshot
+    nvidia-smi --query-gpu=name,utilization.gpu,power.draw --format=csv > "$LOGDIR/nvidia_snapshot.csv" || true
+    dmesg | tail -n 200 > "$LOGDIR/dmesg_tail.log" || true
+  done
+done
+
+echo "Autotune runs completed. Archive logs:"
+tar -czf "$OUTDIR.tar.gz" -C "$OUTDIR" .
+echo "Archive: $OUTDIR.tar.gz"
+# Optionally upload to S3 (placeholder)
+if [ -n "${S3_UPLOAD:-}" ]; then
+  aws s3 cp "$OUTDIR.tar.gz" "${S3_UPLOAD}/deepspeed_autotune/$(basename $OUTDIR).tar.gz" || echo "S3 upload failed"
+fi
+
