+#!/usr/bin/env python3
+"""
+Helper (optional) - prints changed files between PR head and base.
+Used by maintainers for local debugging.
+"""
+import subprocess, sys
+
+def changed_files(base='origin/main', head='HEAD'):
+    try:
+        out = subprocess.check_output(['git','fetch','origin', base.split('/')[-1], '--depth=1'], stderr=subprocess.DEVNULL)
+    except Exception:
+        pass
+    out = subprocess.check_output(['git','diff','--name-only', f'{base}...{head}'])
+    print(out.decode())
+
+if __name__=='__main__':
+    changed_files()
+
