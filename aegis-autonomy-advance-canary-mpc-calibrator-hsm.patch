+#!/usr/bin/env python3
+"""
+Create a new AWS KMS key (or rotate by creating new key + alias), enable rotation,
+and write an evidence manifest to S3. Optionally sign the manifest using cosign via KMS.
+
+Requires:
+ - AWS credentials in environment (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) or instance role
+ - boto3
+ - aws cli or cosign installed if signing is desired
+ - EVIDENCE_BUCKET env var set for S3 uploads
+"""
+import argparse, boto3, json, time, os, subprocess, sys
+
+def create_kms_key(desc):
+    client = boto3.client("kms")
+    resp = client.create_key(Description=desc, KeyUsage='SIGN_VERIFY', Origin='AWS_KMS')
+    key_id = resp['KeyMetadata']['KeyId']
+    arn = resp['KeyMetadata']['Arn']
+    # enable automatic yearly rotation
+    client.enable_key_rotation(KeyId=key_id)
+    return key_id, arn
+
+def create_alias(alias, key_id):
+    client = boto3.client("kms")
+    try:
+        client.create_alias(AliasName=alias, TargetKeyId=key_id)
+    except client.exceptions.AlreadyExistsException:
+        client.update_alias(AliasName=alias, TargetKeyId=key_id)
+
+def upload_manifest(bucket, manifest_path):
+    if not bucket:
+        return None
+    s3 = boto3.client("s3")
+    key = f"kms-manifests/{os.path.basename(manifest_path)}"
+    s3.upload_file(manifest_path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def sign_manifest_with_cosign_kms(kms_uri, manifest_path):
+    # cosign sign-blob --key=aws-kms://arn:aws:kms:... manifest
+    try:
+        subprocess.check_call(["cosign","sign-blob","--key", kms_uri, manifest_path])
+        sig_path = manifest_path + ".sig"
+        return sig_path
+    except Exception as e:
+        print("cosign sign-blob failed:", e)
+        return None
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--alias", default="alias/aegis/cosign")
+    p.add_argument("--desc", default="Aegis cosign KMS key")
+    p.add_argument("--evidence-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    p.add_argument("--cosign-kms-uri", default=os.environ.get("COSIGN_KMS_URI",""))
+    args = p.parse_args()
+
+    print("Creating new KMS key...")
+    key_id, arn = create_kms_key(args.desc)
+    print("Created key:", key_id, arn)
+    print("Assigning alias:", args.alias)
+    create_alias(args.alias, key_id)
+
+    manifest = {
+        "created_at": int(time.time()),
+        "key_id": key_id,
+        "key_arn": arn,
+        "alias": args.alias,
+        "actor": os.environ.get("USER") or os.environ.get("USERNAME") or "ci",
+    }
+    manifest_path = f"/tmp/kms_rotate_manifest_{int(time.time())}.json"
+    with open(manifest_path, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+
+    s3_uri = upload_manifest(args.evidence_bucket, manifest_path)
+    if s3_uri:
+        print("Uploaded manifest to", s3_uri)
+
+    if args.cosign_kms_uri or args.cosign_kms_uri=="":
+        kms_uri = args.cosign_kms_uri
+    else:
+        kms_uri = os.environ.get("COSIGN_KMS_URI","")
+
+    if kms_uri:
+        sig = sign_manifest_with_cosign_kms(kms_uri, manifest_path)
+        if sig:
+            print("Signed manifest with cosign; signature at", sig)
+    print("Rotation manifest written to", manifest_path)
+    if s3_uri:
+        print("Evidence available at", s3_uri)
+
+if __name__=="__main__":
+    main()
+
