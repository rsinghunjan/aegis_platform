+
+      - name: Install Helm (staging)
+        if: ${{ github.event.inputs.deploy == 'true' && secrets.KUBE_CONFIG_DATA }}
+        run: curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
+
+      - name: Deploy canary release using Helm (staging)
+        if: ${{ github.event.inputs.deploy == 'true' && secrets.KUBE_CONFIG_DATA }}
