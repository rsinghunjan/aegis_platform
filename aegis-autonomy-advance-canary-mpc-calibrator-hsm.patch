+#!/usr/bin/env bash
+set -euo pipefail
+NS=${1:-aegis-test}
+JOB_NAME=${2:-webhook-smoke-job}
+
+kubectl create namespace "$NS" || true
+
+cat > /tmp/webhook_smoke_job.yaml <<EOF
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: ${JOB_NAME}
+  namespace: ${NS}
+  annotations:
+    carbon/sensitivity: "high"
+spec:
+  template:
+    spec:
+      containers:
+        - name: sleeper
+          image: busybox
+          command: ["sh","-c","sleep 2"]
+          resources:
+            limits:
+              cpu: "100m"
+              memory: "64Mi"
+      restartPolicy: Never
+  backoffLimit: 0
+EOF
+
+set +e
+kubectl apply -f /tmp/webhook_smoke_job.yaml
+RC=$?
+set -e
+
+if [ $RC -ne 0 ]; then
+  echo "Job creation blocked or errored. Dumping webhook logs..."
+  kubectl -n aegis logs deploy/aegis-admission-webhook --tail=200 || true
+  exit 1
+fi
+
+echo "Smoke job created successfully in namespace $NS. Cleaning up..."
+kubectl -n "$NS" delete job "$JOB_NAME" --ignore-not-found
+kubectl delete namespace "$NS" --ignore-not-found
+echo "Smoke test passed."
+
