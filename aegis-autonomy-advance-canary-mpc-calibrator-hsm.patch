+        required: false
+        default: ''
+      deploy:
+        description: 'Deploy to staging (true/false)'
+        required: false
+        default: 'true'
+
+permissions:
+  contents: read
+  packages: write
+  id-token: write
+
+jobs:
+  build-push-canary:
+    runs-on: ubuntu-latest
+    env:
+      IMAGE_REPO: ghcr.io/${{ github.repository_owner }}/admission-webhook
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up QEMU & Buildx
+        uses: docker/setup-buildx-action@v2
+
+      - name: Login to GHCR
+        uses: docker/login-action@v2
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Build and push image
+        id: build
+        uses: docker/build-push-action@v4
+        with:
+          context: ./ops/webhook
+          file: ./ops/webhook/Dockerfile
+          push: true
+          tags: |
+            ${{ env.IMAGE_REPO }}:latest
