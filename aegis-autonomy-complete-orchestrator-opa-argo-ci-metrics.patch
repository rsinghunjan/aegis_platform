+#!/usr/bin/env python3
+"""
+Simple automation coverage evaluator:
+ - Reads a historical incidents log (JSON list) where each entry includes fields:
+   {id, score, model_env, action_taken, automated (bool)}
+ - Computes % of incidents handled fully automatically and false-automation reversals.
+ - Produces a small JSON report.
+"""
+import argparse, json, sys
+
+def run(infile, outpath):
+    data = json.load(open(infile))
+    total = len(data)
+    auto_handled = sum(1 for e in data if e.get("automated") and e.get("action_outcome")=="remediated")
+    auto_failed = sum(1 for e in data if e.get("automated") and e.get("reversed_by_human"))
+    auto_rate = 100.0 * auto_handled / total if total else 0.0
+    false_rev_rate = 100.0 * auto_failed / auto_handled if auto_handled else 0.0
+    report = {
+        "total_incidents": total,
+        "auto_handled_count": auto_handled,
+        "auto_handled_percent": auto_rate,
+        "auto_reversed_count": auto_failed,
+        "auto_reversed_percent_of_auto": false_rev_rate
+    }
+    json.dump(report, open(outpath, "w"), indent=2)
+    print("Wrote coverage report to", outpath)
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--incidents-log", required=True)
+    ap.add_argument("--out", default="automation_coverage_report.json")
+    args = ap.parse_args()
+    run(args.incidents_log, args.out)
+
