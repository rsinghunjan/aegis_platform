+#!/usr/bin/env python3
+"""
+Add a /mode endpoint to orchestrator service to expose current autonomy mode.
+This module expects the orchestrator to import and call get_current_mode() or mount configmap.
+"""
+import yaml, os
+
+CONFIG_PATH = os.environ.get("AUTONOMY_CONFIG_PATH", "/etc/aegis/autonomy_modes.yaml")
+
+def get_current_mode():
+    try:
+        data = yaml.safe_load(open(CONFIG_PATH))
+        return data.get("default_mode","hybrid")
+    except Exception:
+        return "hybrid"
+
