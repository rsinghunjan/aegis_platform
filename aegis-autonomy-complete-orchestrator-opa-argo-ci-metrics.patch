+#!/usr/bin/env python3
+"""
+Orchestrator provenance & metrics extension
+ - Adds provenance logging for each decision (to file + optional S3 audit sink)
+ - Exposes Prometheus metrics: total_events, decisions_by_action, opa_unavailable_count
+"""
+import os, time, json, logging
+from prometheus_client import CollectorRegistry, Counter, Gauge, push_to_gateway, start_http_server
+
+LOG = logging.getLogger("aegis.orch.prov")
+logging.basicConfig(level=logging.INFO)
+
+PROV_LOG_PATH = os.environ.get("ORCH_PROV_LOG", "/var/log/aegis/orchestrator_provenance.log")
+PROM_PORT = int(os.environ.get("ORCH_PROM_PORT", "9105"))
+PUSHGATEWAY = os.environ.get("PROM_PUSHGATEWAY", "")
+
+registry = CollectorRegistry()
+c_total = Counter('aegis_orch_events_total', 'Total events processed by orchestrator', registry=registry)
+c_action = Counter('aegis_orch_decisions', 'Decision counts by action', ['action'], registry=registry)
+c_opa_unavail = Counter('aegis_opa_unavailable_total', 'OPA unavailable count', registry=registry)
+
+def start_metrics_server():
+    # Start a Prometheus metrics http server for scraping
+    start_http_server(PROM_PORT)
+    LOG.info("Orchestrator metrics server started on port %d", PROM_PORT)
+
+def push_metrics():
+    if not PUSHGATEWAY:
+        return
+    try:
+        push_to_gateway(PUSHGATEWAY, job='aegis_orchestrator', registry=registry)
+    except Exception:
+        LOG.exception("push to pushgateway failed")
+
+def record_provenance(event, decision, extra=None):
+    """
+    Persist provenance entry and emit metrics.
+    """
+    entry = {
+        "ts": time.time(),
+        "event_id": event.get("id"),
+        "model": event.get("model"),
+        "env": event.get("model_env"),
+        "score": event.get("score"),
+        "dp_over_budget": event.get("dp_over_budget", False),
+        "decision": decision,
+        "extra": extra or {}
+    }
+    try:
+        with open(PROV_LOG_PATH, "a") as fh:
+            fh.write(json.dumps(entry) + "\n")
+    except Exception:
+        LOG.exception("failed writing provenance log")
+    # metrics
+    try:
+        c_total.inc()
+        c_action.labels(action=decision.get("action","unknown")).inc()
+        if decision.get("reason","") == "opa_unavailable":
+            c_opa_unavail.inc()
+    except Exception:
+        LOG.exception("metrics emit failed")
+    # optionally push to pushgateway periodically
+    push_metrics()
+
