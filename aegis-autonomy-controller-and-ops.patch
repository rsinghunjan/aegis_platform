+"""
+Out-of-process controller entrypoint.
+
+Run as a separate Deployment:
+  python -m api.golden_controller_main
+"""
+
+from __future__ import annotations
+
+import time
+import os
+
+from api.golden_rollout_controller import tick_controller
+
+
+INTERVAL_S = int(os.environ.get("AEGIS_CONTROLLER_INTERVAL_S", "30"))
+
+
+def main() -> None:
+    # simple loop; in production use leader election
+    while True:
+        try:
+            tick_controller()
+        except Exception:
+            pass
+        time.sleep(INTERVAL_S)
+
+
+if __name__ == "__main__":
+    main()
