@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+import os
+from datetime import datetime, timedelta
+from typing import Any, Dict, Optional
+
+from sqlalchemy import func
+
+from api.db import SessionLocal
+from api.golden_models import SafetyEvent
+
+
+def safety_regression_score(tenant_id: str, deployment_id: str, window_minutes: int = 5) -> Dict[str, Any]:
+    """
+    Compute a simple regression signal using SafetyEvent rows.
+    If your repo does not store SafetyEvent, this should be adapted.
+    """
+    s = SessionLocal()
+    try:
+        since = datetime.utcnow() - timedelta(minutes=window_minutes)
+        total = (
+            s.query(func.count(SafetyEvent.id))
+            .filter(SafetyEvent.tenant_id == tenant_id)
+            .filter(SafetyEvent.deployment_id == deployment_id)
+            .filter(SafetyEvent.created_at >= since)
+            .scalar()
+        )
+        blocked = (
+            s.query(func.count(SafetyEvent.id))
+            .filter(SafetyEvent.tenant_id == tenant_id)
+            .filter(SafetyEvent.deployment_id == deployment_id)
+            .filter(SafetyEvent.created_at >= since)
+            .filter(SafetyEvent.decision == "block")
+            .scalar()
+        )
+        total_i = int(total or 0)
+        blocked_i = int(blocked or 0)
+        rate = (blocked_i / total_i) if total_i else 0.0
+        return {"total": total_i, "blocked": blocked_i, "block_rate": rate, "window_minutes": window_minutes}
+    finally:
+        s.close()
