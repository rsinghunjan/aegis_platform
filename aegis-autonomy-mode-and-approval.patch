+#!/usr/bin/env python3
+"""
+Auto-approver service that issues approval tokens for eligible requests.
+
+ - Calls OPA to check if an input is auto-approvable (e.g., low/medium risk under HYBRID)
+ - If approved, issues a signed token (cosign sign-blob or KMS signature) that the plan_verifier can validate
+ - Stores approvals in Postgres/SQLite for audit
+
+Note: This is a simplified demo. In production use KMS-backed signing and verification.
+"""
+import os
+import time
+import uuid
+import json
+import sqlite3
+import subprocess
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import requests
+
+APP = FastAPI()
+DB = os.environ.get("APPROVER_DB", "/tmp/approver.db")
+OPA_CHECK_URL = os.environ.get("OPA_ALLOW_URL", "http://opa.aegis-system.svc.cluster.local:8181/v1/data/aegis/autonomy/allow_action")
+COSIGN_KEY = os.environ.get("COSIGN_KEY")  # KMS URI or key path
+
+def init_db():
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("""CREATE TABLE IF NOT EXISTS approvals (id TEXT PRIMARY KEY, timestamp REAL, input_json TEXT, token TEXT)""")
+    conn.commit()
+    conn.close()
+
+
+class ApprovalRequest(BaseModel):
+    namespace: str
+    action: dict
+    requester: str
+
+
+@APP.post("/auto-approve")
+def auto_approve(req: ApprovalRequest):
+    payload = {"input": {"namespace": req.namespace, "action": req.action}}
+    r = requests.post(OPA_CHECK_URL, json=payload, timeout=5)
+    if r.status_code != 200:
+        raise HTTPException(status_code=502, detail="OPA error")
+    allowed = r.json().get("result", False)
+    if not allowed:
+        raise HTTPException(status_code=403, detail="Not auto-approvable")
+    # create approval record and sign a token
+    approval_id = str(uuid.uuid4())
+    token_payload = {"approval_id": approval_id, "namespace": req.namespace, "action": req.action, "ts": int(time.time())}
+    token_file = f"/tmp/approval_{approval_id}.json"
+    with open(token_file, "w") as fh:
+        json.dump(token_payload, fh)
+    token_sig = None
+    if COSIGN_KEY:
+        try:
+            # sign token file with cosign sign-blob --key
+            subprocess.check_call(["cosign", "sign-blob", "--key", COSIGN_KEY, token_file])
+            token_sig = token_file + ".sig"
+        except Exception:
+            token_sig = None
+    # store in DB
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("INSERT INTO approvals (id,timestamp,input_json,token) VALUES (?,?,?,?)", (approval_id, time.time(), json.dumps(token_payload), token_sig or "unsigned"))
+    conn.commit()
+    conn.close()
+    return {"approval_id": approval_id, "token_path": token_sig or token_file}
+
+
+if __name__ == "__main__":
+    init_db()
+    import uvicorn
+    uvicorn.run(APP, host="0.0.0.0", port=int(os.environ.get("APPROVER_PORT", 8081)))
+
