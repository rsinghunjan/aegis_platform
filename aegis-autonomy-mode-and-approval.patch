+#!/usr/bin/env python3
+"""
+Plan verifier that:
+ - Validates a plan structure
+ - Calls OPA PDP (opa_autonomy.rego) for each action with current autonomy mode and approvals
+ - Returns allow/deny and reasons
+"""
+import os
+import requests
+import json
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa.aegis-system.svc.cluster.local:8181/v1/data/aegis/autonomy/allow_action")
+
+def verify_plan(plan: dict, namespace: str, approvals: dict = None):
+    """
+    plan: {"steps":[{"tool_id":"...","args":{...}}]}
+    approvals: {"step_index": {"token":"..."}}
+    """
+    approvals = approvals or {}
+    for i, step in enumerate(plan.get("steps", [])):
+        payload = {"input": {"namespace": namespace, "action": {"tool_id": step.get("tool_id"), "args": step.get("args", {})}, "approval": approvals.get(str(i))}}
+        r = requests.post(OPA_URL, json=payload, timeout=5)
+        if r.status_code != 200:
+            return False, f"opa_error:{r.status_code}"
+        res = r.json().get("result", False)
+        if not res:
+            # fetch deny reason (call deny_reason)
+            # For simplicity assume deny reason in response is not provided; return generic
+            return False, f"denied:{step.get('tool_id')}"
+    return True, "ok"
+
+if __name__ == "__main__":
+    import argparse, sys
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--namespace", default="sandbox-ns")
+    args = ap.parse_args()
+    plan = json.load(open(args.plan_file))
+    ok, msg = verify_plan(plan, args.namespace)
+    print(ok, msg)
+    if not ok:
+        sys.exit(2)
+
