+package aegis.autonomy
+
+default allow_action = false
+
+# input: {"agent":"agent-id","namespace":"team-a","action":{"tool_id":"infra.deploy","args":{}}}
+
+# Lookup autonomy mode (in data.autonomy.modes namespace -> {namespace:mode})
+get_mode(ns) = m {
+  m := data.autonomy.modes[ns]
+}
