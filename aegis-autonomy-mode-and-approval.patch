+# Lookup capability risk
+tool_risk(tool) = r {
+  some k
+  r := data.capabilities[k][_].risk
+  data.capabilities[k][_].id == tool
+}
+
+# Allow logic:
+# - if mode OFF: deny all tool calls
+# - if SANDBOX: only allow low-risk
+# - if HYBRID: allow low+medium automatically; high requires approval token in input.approval.token
+# - if AUTONOMOUS: allow up to high automatically; critical requires approval
+
+allow_action {
+  ns := input.namespace
+  mode := get_mode(ns)
+  tool := input.action.tool_id
+  risk := tool_risk(tool)
+  mode == "OFF"
