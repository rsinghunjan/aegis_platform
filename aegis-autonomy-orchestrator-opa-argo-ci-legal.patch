+#!/usr/bin/env python3
+"""
+Aegis Orchestrator
+- Accepts webhook POSTs at /webhook (and optionally NATS subscriptions)
+- Queries OPA for policy decision
+- Executes Argo remediation or retrain workflows using `argo submit`
+"""
+import os
+import json
+import subprocess
+import logging
+import threading
+from flask import Flask, request, jsonify
+import requests
+
+LOG = logging.getLogger("aegis.orchestrator")
+logging.basicConfig(level=logging.INFO)
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa:8181")
+ARGO_NS = os.environ.get("ARGO_NS", "aegis-ml")
+ARGO_CLI = os.environ.get("ARGO_CLI", "argo")
+APPROVER_HUMAN_URL = os.environ.get("APPROVER_HUMAN_URL", "")
+ENABLE_NATS = os.environ.get("ENABLE_NATS", "false").lower() == "true"
+NATS_URL = os.environ.get("NATS_URL", "nats://nats:4222")
+
+app = Flask("aegis-orchestrator")
+
+def opa_decision(event):
+    """
+    Query OPA for a policy decision. Expects OPA policy to return {"result": {"action": "...", "reason": "..."}}
+    """
+    try:
+        resp = requests.post(f"{OPA_URL}/v1/data/aegis/policy/decision", json={"input": event}, timeout=5)
+        resp.raise_for_status()
+        return resp.json().get("result", {})
+    except Exception as e:
+        LOG.exception("OPA request failed: %s", e)
+        return {"action": "require_human", "reason": "opa_unavailable"}
+
+def submit_argo(template_name, parameters=None):
+    """
+    Submit an Argo Workflow from a WorkflowTemplate. Uses the argo CLI for simplicity.
+    Parameters is a dict of key->value to pass as --parameter key=value
+    """
+    cmd = [ARGO_CLI, "submit", "--from", f"workflowtemplate/{template_name}", "-n", ARGO_NS]
+    if parameters:
+        for k,v in parameters.items():
+            cmd += ["--parameter", f"{k}={v}"]
+    LOG.info("Submitting Argo workflow: %s", " ".join(cmd))
+    try:
+        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True, timeout=120)
+        LOG.info("Argo submit output: %s", out)
+        return {"ok": True, "output": out}
+    except subprocess.CalledProcessError as e:
+        LOG.exception("Argo submit failed: %s", e.output if hasattr(e,'output') else e)
+        return {"ok": False, "error": str(e)}
+
+def handle_event(event):
+    """
+    Core logic: evaluate via OPA, then take action.
+    """
+    LOG.info("Handling event: %s", event.get("id", "<no-id>"))
+    decision = opa_decision(event)
+    action = decision.get("action", "require_human")
+    LOG.info("OPA decision: %s", decision)
+    if action == "auto_block":
+        # block only: update blacklist and record evidence (use auto_contain template)
+        params = {"incident_id": event.get("id","evt"), "model": event.get("model","unknown")}
+        return submit_argo("aegis-auto-contain", parameters=params)
+    elif action == "auto_remediate":
+        # full remediation and retrain
+        params = {"incident_id": event.get("id","evt"), "model": event.get("model","unknown"), "reason": decision.get("reason","")}
+        return submit_argo("aegis-auto-remediate-retrain", parameters=params)
+    else:
+        # require human: notify approvers and create ticket (best-effort)
+        notify = {"incident_id": event.get("id","evt"), "model": event.get("model","unknown"), "reason": decision.get("reason","")}
+        try:
+            if APPROVER_HUMAN_URL:
+                requests.post(APPROVER_HUMAN_URL, json=notify, timeout=3)
+        except Exception:
+            LOG.exception("notify approvers failed")
+        return {"ok": True, "action": "require_human"}
+
+@app.route("/webhook", methods=["POST"])
+def webhook():
+    ev = request.get_json() or {}
+    # Kick off background handling so webhook returns quickly
+    threading.Thread(target=handle_event, args=(ev,)).start()
+    return jsonify({"ok": True}), 202
+
+def nats_subscriber_loop():
+    # Optional: lazy import nats client to avoid hard dependency when not enabled
+    try:
+        from nats.aio.client import Client as NATS
+        import asyncio
+        nc = NATS()
+        async def run():
+            await nc.connect(servers=[NATS_URL])
+            async def cb(msg):
+                subj = msg.subject
+                data = msg.data.decode()
+                try:
+                    ev = json.loads(data)
+                except Exception:
+                    ev = {"raw": data}
+                LOG.info("Received NATS event on %s", subj)
+                handle_event(ev)
+            await nc.subscribe("safety.incidents", cb=cb)
+            # keep running
+            while True:
+                await asyncio.sleep(1)
+        asyncio.run(run())
+    except Exception:
+        LOG.exception("NATS subscriber failed or not enabled")
+
+if __name__ == "__main__":
+    if ENABLE_NATS:
+        t = threading.Thread(target=nats_subscriber_loop, daemon=True)
+        t.start()
+    port = int(os.environ.get("ORCHESTRATOR_PORT", "8088"))
+    app.run(host="0.0.0.0", port=port)
