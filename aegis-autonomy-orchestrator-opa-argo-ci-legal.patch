+package aegis.policy
+
+default decision = {"action": "require_human", "reason": "default"}
+
+# decision() returns an object with action and reason
+decision = {"action": action, "reason": reason} {
+  input := input
+  # High confidence PII or NSFW in prod requires human (safety critical)
+  input.score >= 0.98
+  input.model_env == "prod"
+  action = "require_human"
+  reason = sprintf("high_confidence_prod_score_%v", [input.score])
+}
+
+decision = {"action": action, "reason": reason} {
+  # Trusted automatic remediation in staging for very high scores
+  input.score >= 0.95
+  input.model_env == "staging"
+  action = "auto_remediate"
+  reason = "high_confidence_staging_auto_retrain"
+}
+
+decision = {"action": action, "reason": reason} {
+  # Auto-block outputs that are clearly PII/NSFW but not high impact
+  input.score >= 0.90
+  input.model_env != "prod"
+  action = "auto_block"
+  reason = "block_low_env"
+}
+
+decision = {"action": action, "reason": reason} {
+  # If DP budget over threshold, fail closed and require human
+  input.dp_over_budget == true
+  action = "require_human"
+  reason = "dp_over_budget"
+}
+
+decision = {"action": "require_human", "reason": "fallback"}
