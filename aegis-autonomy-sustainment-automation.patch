+#!/usr/bin/env python3
+"""
+Generate an internal autonomy statement document that collects the latest evidence:
+ - Level‑4 verification summary (JSON -> human)
+ - Rekor UUID listing (provided by evidence inventory)
+ - KPIs (evidence coverage, MTTR, DP health) — gathered from Prometheus if PROM_URL present
+ - Attach link(s) to audit reports (config/audit_status.yaml)
+
+Outputs: docs/autonomy_statement.md and uploads to EVIDENCE_BUCKET and Rekor.
+"""
+import os, json, time, subprocess
+from pathlib import Path
+import yaml
+
+OUT = Path("docs/autonomy_statement.md")
+REPORT = Path("/tmp/level4_verification_report.json")
+AUDIT = Path("config/audit_status.yaml")
+
+def fetch_prom_kpi(prom_url, query):
+    try:
+        import requests
+        r = requests.get(prom_url + "/api/v1/query", params={"query": query}, timeout=10)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        return {}
+
+def main():
+    lines = []
+    lines.append("# Aegis Autonomy Statement")
+    lines.append("")
+    lines.append(f"Generated: {time.asctime()}")
+    lines.append("")
+    # verification summary
+    if REPORT.exists():
+        j = json.load(open(REPORT))
+        lines.append("## Level‑4 Verification — Summary")
+        lines.append(f"- Overall: {j.get('summary', {}).get('overall','unknown')}")
+        lines.append(f"- Evidence coverage: {j.get('details',{}).get('reparsed_report',{}).get('evidence_coverage','?')}")
+    else:
+        lines.append("Level‑4 verification report not found at /tmp/level4_verification_report.json")
+    # audit status
+    if AUDIT.exists():
+        a = yaml.safe_load(AUDIT.read_text())
+        lines.append("## Audit Status")
+        for k,v in a.items():
+            lines.append(f"- {k}: approved={v.get('approved')} report={v.get('report_s3')} rekor={v.get('rekor_uuid')}")
+    # KPIs
+    prom = os.environ.get("PROM_URL")
+    if prom:
+        cov = fetch_prom_kpi(prom, 'sum(aegis_evidence_coverage)') or {}
+        lines.append("## KPIs (sample from Prometheus)")
+        lines.append(f"- sample coverage metric query result: {cov}")
+    # Rekor inventory: try discovery in S3 evidence bucket listing file if present
+    eb = os.environ.get("EVIDENCE_BUCKET")
+    if eb:
+        lines.append("## Evidence bucket")
+        lines.append(f"- Evidence bucket: s3://{eb}")
+    OUT.write_text("\n".join(lines))
+    print("Wrote autonomy statement to", OUT)
+    # upload & sign
+    if os.environ.get("COSIGN_KMS_URI"):
+        try:
+            subprocess.check_call(["cosign","sign-blob","--key",os.environ["COSIGN_KMS_URI"], str(OUT)])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    if eb:
+        try:
+            subprocess.check_call(["aws","s3","cp", str(OUT), f"s3://{eb}/autonomy_statement/{OUT.name}"])
+        except Exception as e:
+            print("s3 upload failed:", e)
+    if subprocess.call(["which","rekor-cli"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
+        try:
+            subprocess.check_call(["rekor-cli","upload","--artifact", str(OUT)])
+        except Exception as e:
+            print("rekor upload failed:", e)
+
+if __name__=="__main__":
+    main()
+
