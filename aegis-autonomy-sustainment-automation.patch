+#!/usr/bin/env python3
+"""
+Rotate approvers according to a simple round-robin schedule.
+ - Reads docs/approvers.yml and rotates the lists by one position.
+ - Writes updated file and produces a signed manifest (cosign) and Rekor registration.
+ - Uploads manifest to evidence S3 if configured.
+"""
+import yaml, time, subprocess
+from pathlib import Path
+APPR_FILE = Path("docs/approvers.yml")
+
+def rotate_list(lst):
+    if not lst: return lst
+    return lst[1:] + lst[:1]
+
+def main():
+    if not APPR_FILE.exists():
+        print("Approver file not found:", APPR_FILE); return
+    doc = yaml.safe_load(APPR_FILE.read_text())
+    for group, members in (doc.get("approvers") or {}).items():
+        doc["approvers"][group] = [rotate_list(list(m.values()))[0] if isinstance(m, dict) else rotate_list(m) for m in members] if False else members[1:]+members[:1] if isinstance(members,list) else members
+    APPR_FILE.write_text(yaml.safe_dump(doc))
+    ts = int(time.time())
+    manifest = {"action":"rotate_approvers","ts":ts,"approvers":doc.get("approvers")}
+    out = f"/tmp/approver_rotate_{ts}.json"
+    Path(out).write_text(json.dumps(manifest, indent=2))
+    try:
+        if "COSIGN_KMS_URI" in os.environ:
+            subprocess.check_call(["cosign","sign-blob","--key",os.environ["COSIGN_KMS_URI"], out])
+    except Exception as e:
+        print("cosign sign failed:", e)
+    try:
+        if subprocess.call(["which","rekor-cli"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
+            subprocess.check_call(["rekor-cli","upload","--artifact", out])
+    except Exception as e:
+        print("rekor upload failed:", e)
+    print("Rotated approvers and recorded manifest:", out)
+
+if __name__=="__main__":
+    import os, json
+    main()
+
