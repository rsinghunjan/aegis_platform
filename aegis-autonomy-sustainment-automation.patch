+#!/usr/bin/env python3
+"""
+Policy-to-Implementation Traceability
+ - Parse OPA rego files for `actions` keys and strings
+ - Search repo for occurrences of action strings to find code locations
+ - Emit traceability.json mapping action -> [file:lines]
+ - Simple CI-friendly report for missing mappings
+
+Usage:
+  python3 tools/policy_traceability.py --out traceability.json
+"""
+import os, re, json, argparse
+from pathlib import Path
+
+REPO_ROOT="."
+
+def find_actions_in_rego(path):
+    text = Path(path).read_text()
+    # find quoted action strings: "canary_promote" or key names in actions = { "name": {...}}
+    actions = set(re.findall(r'\"([a-zA-Z0-9_]+)\"', text))
+    # also find bare keys in actions = { key: { } }
+    m = re.search(r'actions\s*=\s*{(.+?)}', text, re.S)
+    if m:
+        inner = m.group(1)
+        keys = re.findall(r'([a-zA-Z0-9_]+)\s*:', inner)
+        for k in keys: actions.add(k)
+    return actions
+
+def grep_action(action):
+    hits = []
+    for p in Path(REPO_ROOT).rglob("*"):
+        if p.is_file() and p.suffix not in ['.png','.jpg','.gif','.zip','.tar.gz']:
+            try:
+                txt = p.read_text(errors='ignore')
+            except Exception:
+                continue
+            for i,line in enumerate(txt.splitlines(), start=1):
+                if action in line:
+                    hits.append({"path": str(p), "line": i, "context": line.strip()[:200]})
+    return hits
+
+def main(out):
+    actions = set()
+    for p in Path("services/policy/opa").rglob("*.rego"):
+        actions |= find_actions_in_rego(p)
+    mapping = {}
+    missing = []
+    for a in sorted(actions):
+        hits = grep_action(a)
+        mapping[a] = hits
+        if not hits:
+            missing.append(a)
+    res = {"generated_at": os.getenv("GITHUB_SHA","local"), "mapping": mapping, "missing": missing}
+    Path(out).write_text(json.dumps(res, indent=2))
+    if missing:
+        print("Missing mappings for actions:", missing)
+        exit(2)
+    print("Traceability generated to", out)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", default="traceability.json")
+    args = p.parse_args()
+    main(args.out)
+
