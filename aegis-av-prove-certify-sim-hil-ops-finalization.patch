+#!/usr/bin/env python3
+"""
+CAN latency sampler (socketcan).
+Writes NDJSON with timestamp and latency_ms for sent/received echo frames.
+Requires operator to ensure safe use on vehicle bus.
+"""
+import argparse, json, socket, struct, time, os
+
+def send_ping_and_measure(iface="can0", count=20, out="/tmp/can_samples.ndjson"):
+    s = socket.socket(socket.AF_CAN, socket.SOCK_RAW, socket.CAN_RAW)
+    s.bind((iface,))
+    with open(out, "w") as fh:
+        for i in range(count):
+            ts0 = time.time()
+            try:
+                # send raw frame (may require root)
+                s.send(b"\x00\x01\x02\x03")
+            except Exception:
+                pass
+            s.settimeout(0.1)
+            try:
+                data = s.recv(128)
+                ts1 = time.time()
+                latency_ms = (ts1 - ts0) * 1000.0
+                fh.write(json.dumps({"ts_s": ts1, "latency_ms": latency_ms}) + "\n")
+            except Exception:
+                fh.write(json.dumps({"ts_s": time.time(), "latency_ms": None}) + "\n")
+            time.sleep(0.05)
+    print("Wrote CAN samples to", out)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--iface", default="can0")
+    p.add_argument("--count", type=int, default=20)
+    p.add_argument("--out", default="/tmp/can_samples.ndjson")
+    args = p.parse_args()
+    send_ping_and_measure(args.iface, args.count, args.out)
+
