+#!/usr/bin/env python3
+"""
+Safety case assembler:
+ - Collects HARA, requirements, RT/HIL results, formal proofs, perception evals and builds a traced manifest
+ - Produces a signed tar.gz safety case bundle for submission to certifier
+"""
+import argparse, os, json, tarfile, tempfile
+from datetime import datetime
+
+def collect(base, globs):
+    found=[]
+    for g in globs:
+        for root,_,files in os.walk(base):
+            for f in files:
+                if f.endswith(g) or g in f:
+                    found.append(os.path.join(root,f))
+    return found
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--base", default=".")
+    p.add_argument("--out", default=f"/tmp/aegis_safety_case_{datetime.utcnow().strftime('%Y%m%d%H%M%S')}.tar.gz")
+    args = p.parse_args()
+    base = args.base
+    artifacts = {
+        "hara": collect(base, ["hara", "HARA"]),
+        "requirements": collect(base, ["test_matrix", "reqs"]),
+        "rt": collect(base, ["rt_slo_proof.json","rt_jitter","safe_stop"]),
+        "hil": collect(base, ["controller_cert","hil","waveform"]),
+        "formal": collect(base, [".tla",".apalache"]),
+        "perception": collect(base, ["ood_results","adv_eval","ensemble_eval"]),
+    }
+    manifest = {"generated_at": datetime.utcnow().isoformat()+"Z", "artifacts": artifacts}
+    tmp = tempfile.mkdtemp(prefix="aegis_safety_case_")
+    manifest_path = os.path.join(tmp, "manifest.json")
+    with open(manifest_path, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    with tarfile.open(args.out, "w:gz") as t:
+        t.add(manifest_path, arcname="manifest.json")
+        for k,files in artifacts.items():
+            for f in files:
+                try:
+                    t.add(f, arcname=os.path.relpath(f, base))
+                except Exception:
+                    pass
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("safety_case_bundle", {"bundle": args.out})
+    except Exception:
+        pass
+    print("Safety case bundle written to", args.out)
+
+if __name__=="__main__":
+    main()
