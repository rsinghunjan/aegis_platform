+#!/usr/bin/env python3
+"""
+Redundancy & fail-op checker:
+ - Validates duplicate/independent process chains exist
+ - Simulates failure of a primary component and verifies fallback completes within timeout
+ - Records evidence via evidence_sdk
+"""
+import argparse, subprocess, time, json, os
+
+def is_running(process_filter):
+    try:
+        out = subprocess.check_output(["pgrep","-f",process_filter])
+        return True
+    except Exception:
+        return False
+
+def simulate_and_verify(primary, backup, timeout_s=10, out="/tmp/redundancy_result.json"):
+    baseline_primary = is_running(primary)
+    baseline_backup = is_running(backup)
+    # simulate failure of primary
+    subprocess.call(["pkill","-f",primary])
+    t0 = time.time()
+    recovered = False
+    while time.time() - t0 < timeout_s:
+        if is_running(backup):
+            recovered = True
+            break
+        time.sleep(0.5)
+    res = {"primary": primary, "backup": backup, "baseline_primary": baseline_primary, "baseline_backup": baseline_backup, "recovered": recovered, "checked_at": time.time()}
+    with open(out,"w") as fh:
+        json.dump(res, fh, indent=2)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("redundancy_check", {"out": out})
+    except Exception:
+        pass
+    print("Wrote redundancy result to", out)
+    return recovered
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--primary", required=True)
+    p.add_argument("--backup", required=True)
+    p.add_argument("--timeout", type=int, default=10)
+    args = p.parse_args()
+    ok = simulate_and_verify(args.primary, args.backup, args.timeout)
+    if not ok:
+        raise SystemExit(2)
+
