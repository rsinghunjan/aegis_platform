+#!/usr/bin/env python3
+"""
+Compute safe-stop latency requirements from vehicle dynamics.
+Given max speed, braking deceleration and system reaction time, compute stopping distance/time targets.
+Outputs suggested SLOs (p99 jitter_ms, safe_stop_ms) for controller proofs.
+"""
+import argparse, math, json
+from datetime import datetime
+
+def compute_safe_stop(max_speed_m_s, decel_m_s2, reaction_s=0.2):
+    # stopping distance under constant decel: d = v^2/(2*a)
+    # total time = reaction + braking_time (v/a)
+    braking_time = max_speed_m_s / decel_m_s2
+    total_time = reaction_s + braking_time
+    # safe_stop latency must allow to detect and command stop within margin
+    return {"max_speed_m_s": max_speed_m_s, "decel_m_s2": decel_m_s2, "reaction_s": reaction_s, "braking_time_s": braking_time, "safe_stop_ms": total_time*1000.0}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--max-speed", type=float, required=True, help="max speed (m/s)")
+    p.add_argument("--decel", type=float, required=True, help="braking deceleration (m/s^2, positive)")
+    p.add_argument("--reaction", type=float, default=0.2, help="system reaction time (s)")
+    p.add_argument("--out", default="/tmp/vehicle_slo.json")
+    args = p.parse_args()
+    slo = compute_safe_stop(args.max_speed, args.decel, args.reaction)
+    slo["p99_jitter_ms"] = 0.1  # recommended starting point; operator tune
+    slo["generated_at"] = datetime.utcnow().isoformat()+"Z"
+    with open(args.out,"w") as fh:
+        json.dump(slo, fh, indent=2)
+    print("Wrote vehicle SLO guidance to", args.out)
+
+if __name__=="__main__":
+    main()
+
