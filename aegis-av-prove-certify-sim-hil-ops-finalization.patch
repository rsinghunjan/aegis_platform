+#!/usr/bin/env python3
+"""
+Canary rollout manager for vehicle software:
+ - Stage progression: shadow -> canary -> rollout
+ - Requires cosign-signed approval artifact (approval JSON) to progress stages
+ - Operator manual approval workflow: place cosign-signed approval artifact at specified path
+"""
+import argparse, os, subprocess, time
+
+def verify_approval(artifact_path):
+    if not os.path.exists(artifact_path):
+        return False
+    try:
+        subprocess.check_call(["cosign","verify", artifact_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def promote(manifest):
+    print("Applying manifest:", manifest)
+    subprocess.check_call(["kubectl","apply","-f", manifest])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--manifest", required=True)
+    p.add_argument("--approval", required=True, help="path to cosign-signed approval artifact (approval.json)")
+    p.add_argument("--stages", default="shadow,canary,rollout")
+    p.add_argument("--wait-s", type=int, default=30)
+    args = p.parse_args()
+    stages = args.stages.split(",")
+    for s in stages:
+        print("Stage:", s)
+        if s == "shadow":
+            promote(args.manifest)
+            print("Shadow stage deployed (non-actuating). Monitor telemetry before proceeding.")
+            time.sleep(args.wait_s)
+            continue
+        print("Waiting for approval artifact:", args.approval)
+        attempts=0
+        while attempts < 120:
+            if verify_approval(args.approval):
+                print("Approval verified; promoting to", s)
+                promote(args.manifest)
+                break
+            attempts += 1
+            time.sleep(5)
+        else:
+            raise SystemExit("Approval not provided/verified in time")
+    print("Canary rollout complete")
+
+if __name__=="__main__":
+    main()
+
