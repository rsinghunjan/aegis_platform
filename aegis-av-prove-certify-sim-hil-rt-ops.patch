+#!/usr/bin/env python3
+"""
+Canary rollout manager for vehicle software:
+ - Orchestrates shadow -> canary -> rollout stages
+ - Requires cosign-signed approval artifacts for promotion to next stage
+ - Integrates with a simple approval service endpoint (operator to provide)
+"""
+import argparse, os, subprocess, time, json
+from datetime import datetime
+
+APPROVAL_URL=os.environ.get("APPROVAL_URL","http://approval.local")
+COSIGN_KEY=os.environ.get("COSIGN_KMS_URI","")
+
+def request_manual_approval(stage, manifest):
+    print(f"Requesting approval for stage {stage}; operator must sign approval artifact and place at {manifest}.approval.json")
+    # poll for approval artifact
+    attempts=0
+    while attempts < 60:
+        if os.path.exists(manifest + ".approval.json"):
+            # verify signature via cosign if available
+            try:
+                subprocess.check_call(["cosign","verify", manifest + ".approval.json"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+                print("Approval artifact verified")
+                return True
+            except Exception:
+                print("Approval artifact present but verification failed")
+                return False
+        attempts+=1
+        time.sleep(5)
+    return False
+
+def promote(manifest):
+    print("Promoting manifest", manifest)
+    # operator-specified promotion step, e.g., kubectl apply
+    subprocess.call(["kubectl","apply","-f", manifest])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--manifest", required=True)
+    p.add_argument("--stages", default="shadow,canary,rollout")
+    args = p.parse_args()
+    stages = args.stages.split(",")
+    for s in stages:
+        print(f"Stage: {s}")
+        if s == "shadow":
+            promote(args.manifest)
+            print("Shadow mode: non-actuating deploy done. Monitor telemetry before proceeding.")
+            time.sleep(10)
+            continue
+        # request approval to move to canary or rollout
+        ok = request_manual_approval(s, args.manifest)
+        if not ok:
+            raise SystemExit(4)
+        promote(args.manifest)
+        print(f"Promoted to {s} at {datetime.utcnow().isoformat()}")
+    print("Canary rollout complete")
+
+if __name__=="__main__":
+    main()
+
