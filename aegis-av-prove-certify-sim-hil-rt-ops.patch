+#!/usr/bin/env python3
+"""
+Simple CAN latency sampler that timestamps sent and received test frames for measurement.
+Requires python-can (optional) or raw socketcan access.
+Outputs NDJSON lines with 'ts_s' and 'latency_ms' fields.
+"""
+import time, json, socket, argparse
+
+def send_and_sample(iface="can0", can_id=0x7DF, count=10, out="/tmp/can_samples.ndjson"):
+    # best-effort socketcan raw frames
+    s = socket.socket(socket.AF_CAN, socket.SOCK_RAW, socket.CAN_RAW)
+    s.bind((iface,))
+    with open(out,"w") as fh:
+        for i in range(count):
+            msg = bytes.fromhex("00010203")
+            ts0 = time.time()
+            try:
+                # operator may want to use python-can for richer API; keep minimal
+                s.send(msg)
+            except Exception:
+                pass
+            # naive receive with timeout
+            s.settimeout(0.1)
+            try:
+                data = s.recv(64)
+                ts1 = time.time()
+                latency_ms = (ts1 - ts0) * 1000.0
+                fh.write(json.dumps({"ts_s": ts1, "latency_ms": latency_ms}) + "\n")
+            except Exception:
+                fh.write(json.dumps({"ts_s": time.time(), "latency_ms": None}) + "\n")
+            time.sleep(0.05)
+    print("Wrote CAN samples to", out)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--iface", default="can0")
+    p.add_argument("--count", type=int, default=20)
+    p.add_argument("--out", default="/tmp/can_samples.ndjson")
+    args = p.parse_args()
+    send_and_sample(args.iface, count=args.count, out=args.out)
