+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Vehicle RT validation orchestration:
+#  - Run CAN/CAN-FD latency sampler (requires socketcan or vendor adapter)
+#  - Run Ethernet TSN latency tester (if TSN hardware present)
+#  - Run RT orchestrator (op/robotics/rt) against ECU/controller hosts
+#  - Produce p99 jitter and safe-stop proof via rt_slo_prover.py
+#  - Package artifacts, sign bundle and record evidence
+#
+# Usage:
+#  NODE=<controller-host> ./vehicle_rt_validation.sh --out /tmp/aegis_av_rt --s3 s3://aegis-evidence/...
+
+NODE=${NODE:-localhost}
+OUT=${1:-/tmp/aegis_av_rt_$(date +%s)}
+S3=${S3:-}
+COSIGN=${COSIGN_KMS_URI:-}
+
+mkdir -p "$OUT"
+echo "Vehicle RT validation: node=$NODE out=$OUT"
+
+echo "[1] CAN/CAN-FD latency sampling (requires socketcan/ican tools)"
+if command -v candump >/dev/null 2>&1 && command -v cansend >/dev/null 2>&1; then
+  timeout 20s candump can0 > "${OUT}/candump.log" || true
+  # send a few ping frames (operator to ensure safe bus)
+  for i in 1 2 3; do
+    cansend can0 123#DEADBEEF || true
+    sleep 0.2
+  done
+  cp /var/log/syslog "${OUT}/syslog" 2>/dev/null || true
+else
+  echo "candump/cansend not found; skipping CAN sampling" > "${OUT}/can_skipped.txt"
+fi
+
+echo "[2] TSN latency test (best-effort)"
+if command -v tsntool >/dev/null 2>&1; then
+  tsntool latency --iface eth0 --count 100 > "${OUT}/tsn_latency.txt" || true
+else
+  echo "tsntool not found; skipping TSN test" > "${OUT}/tsn_skipped.txt"
+fi
+
+echo "[3] Run RT lab orchestrator against node"
+./ops/robotics/rt/lab_validation/orchestrate_rt_full.sh --node "$NODE" --out "$OUT/rt_run" || true
+
+echo "[4] Compute p99 / safe-stop proof"
+python3 ops/robotics/rt/lab_validation/rt_slo_prover.py --jitter "$OUT/rt_run/rt_jitter_samples.ndjson" --safe "$OUT/rt_run/safe_stop.json" --out "$OUT/rt_slo_proof.json" || true
+
+echo "[5] Package & sign"
+tar -czf "${OUT}.tar.gz" -C "$(dirname "$OUT")" "$(basename "$OUT")"
+if [ -n "$COSIGN" ]; then
+  cosign sign --key "$COSIGN" "${OUT}.tar.gz" || true
+fi
+
+if [ -n "$S3" ]; then
+  aws s3 cp "${OUT}.tar.gz" "$S3" || true
+fi
+
+python3 - <<PY || true
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("av_rt_validation", {"bundle":"${OUT}.tar.gz","node":"$NODE"})
+print("evidence recorded")
+PY
+
+echo "Vehicle RT validation complete. Bundle: ${OUT}.tar.gz"
