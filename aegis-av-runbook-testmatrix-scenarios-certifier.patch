+#!/usr/bin/env python3
+"""
+Create a certifier submission package:
+ - Collect safety case bundle, RT/HIL/perception artifacts
+ - Produce a manifest mapping requirements -> artifact files
+ - Sign package with cosign (KMS) if COSIGN_KMS_URI is set
+ - Optionally upload to S3 and print Rekor verification hints
+"""
+import argparse, os, json, tarfile, subprocess, tempfile
+from datetime import datetime
+from glob import glob
+
+def collect_artifacts(base_paths):
+    files=[]
+    for p in base_paths:
+        files.extend(glob(p, recursive=True))
+    return sorted(set(files))
+
+def build_manifest(artifacts, outpath):
+    manifest={"generated_at": datetime.utcnow().isoformat()+"Z","artifacts": artifacts}
+    with open(outpath,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+
+def package_bundle(files, outbundle):
+    tmpdir=tempfile.mkdtemp(prefix="aegis_cert_")
+    for f in files:
+        try:
+            dest=os.path.join(tmpdir, os.path.relpath(f,"."))
+            os.makedirs(os.path.dirname(dest), exist_ok=True)
+            subprocess.check_call(["cp","-a",f,dest])
+        except Exception:
+            pass
+    with tarfile.open(outbundle,"w:gz") as t:
+        t.add(tmpdir, arcname="bundle")
+
+def sign_bundle(bundle, cosign_key):
+    try:
+        subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+    except Exception as e:
+        print("cosign sign failed:", e)
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--artifacts", nargs="+", default=["*/rt_slo_proof.json","*/cert*.tar.gz","*/perception/ood_results.json","ops/formal/*.tla"])
+    p.add_argument("--out", default=f"/tmp/certifier_submission_{datetime.utcnow().strftime('%Y%m%d%H%M%S')}.tar.gz")
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    args=p.parse_args()
+    files=collect_artifacts(args.artifacts)
+    manifest_path="/tmp/cert_manifest.json"
+    build_manifest(files, manifest_path)
+    files.append(manifest_path)
+    package_bundle(files, args.out)
+    print("Created submission bundle:", args.out)
+    if args.cosign_key:
+        sign_bundle(args.out, args.cosign_key)
+    if args.s3:
+        subprocess.call(["aws","s3","cp",args.out,args.s3])
+    # record evidence
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("certifier_submission", {"bundle": args.out})
+    except Exception:
+        pass
+
+if __name__=="__main__":
+    main()
+
