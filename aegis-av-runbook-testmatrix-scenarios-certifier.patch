+#!/usr/bin/env python3
+"""
+Generate CARLA scenario packs from templates and package them for HIL consumption.
+Outputs a tar.gz that can be pushed to HIL runners or S3.
+"""
+import argparse, os, json, tarfile, tempfile
+from datetime import datetime
+
+TEMPLATE = {
+  "id": None,
+  "description": "generated scenario",
+  "actors": ["vehicle","pedestrian"],
+  "weather": "clear",
+  "spawn": {"x":0,"y":0,"z":0},
+  "events": []
+}
+
+def make_scenarios(count, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    for i in range(count):
+        s = dict(TEMPLATE)
+        s["id"] = f"scenario_{i}"
+        s["description"] = f"Auto-generated scenario {i}"
+        s["events"] = [{"type":"cut_in","time":2.0}] if i%2==0 else [{"type":"sensor_dropout","time":3.0}]
+        with open(os.path.join(outdir, f"{s['id']}.json"), "w") as fh:
+            json.dump(s, fh, indent=2)
+
+def package(outdir, outpath):
+    with tarfile.open(outpath, "w:gz") as t:
+        t.add(outdir, arcname=os.path.basename(outdir))
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--count", type=int, default=10)
+    p.add_argument("--out", default=f"/tmp/carla_scenarios_{datetime.utcnow().strftime('%Y%m%d%H%M%S')}.tar.gz")
+    p.add_argument("--tmp", default=None)
+    args=p.parse_args()
+    tmp = args.tmp or tempfile.mkdtemp(prefix="carla_scen_")
+    make_scenarios(args.count, tmp)
+    package(tmp, args.out)
+    print("Wrote scenario pack to", args.out)
+
+if __name__=="__main__":
+    main()
+
