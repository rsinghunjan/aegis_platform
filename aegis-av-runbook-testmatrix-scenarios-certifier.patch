+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Operator runbook script (one‑shot) to:
+#  1) Run deterministic RT validation on representative vehicle/robot hardware
+#  2) Run HIL certification harness (controllers)
+#  3) Run perception OOD & adversarial suites
+#  4) Run formal triage (Apalache)
+#  5) Assemble safety case and produce signed auditor bundle
+#  6) Perform simple acceptance checks and exit non‑zero if gate fails
+#
+# Usage:
+#  COSIGN_KMS_URI=kms://... S3_UPLOAD=s3://aegis-evidence/<run-id>/ ./ops/av/runbooks/operator_full_runbook.sh --node <host> --manifest manifests/deploy.yaml
+
+NODE=localhost
+OUT_BASE=${OUT_BASE:-/tmp/aegis_operator_run_$(date +%s)}
+S3_UPLOAD=${S3_UPLOAD:-}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+MANIFESTS=${1:-}
+
+function usage(){
+  echo "Usage: $0 [--node host] [--out /tmp/out] [--s3 s3://...]"
+  exit 1
+}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --node) NODE="$2"; shift 2;;
+    --out) OUT_BASE="$2"; shift 2;;
+    --s3) S3_UPLOAD="$2"; shift 2;;
+    --help) usage;;
+    *) shift;;
+  esac
+done
+
+mkdir -p "$OUT_BASE"
+echo "Operator run starting: node=$NODE out=$OUT_BASE"
+
+echo "[1] Run vehicle RT validation"
+./ops/av/rt/vehicle_rt_validation.sh --out "$OUT_BASE/rt" || true
+
+echo "[2] Run vehicle controller certification harness (HIL)"
+python3 ops/av/certification/vehicle_controller_cert_harness.py --out "$OUT_BASE/cert" --cosign-key "${COSIGN_KMS_URI:-}" || true
+
+echo "[3] Run perception OOD / adversarial suites"
+python3 ops/av/perception/ood_and_adversarial_runner.py --model ops/dl/inference/test_models/tiny_model.onnx --images_dir ops/av/perception/test_images --out "$OUT_BASE/perception" || true
+python3 ops/agents/safety/adversarial_eval.py --outdir "$OUT_BASE/adv_eval" || true
+
+echo "[4] Run Apalache triage"
+./ops/formal/apalache_triage_runner.sh "$OUT_BASE/apalache" || true
+
+echo "[5] Build safety case & submission bundle"
+python3 ops/av/ops/safety_case_builder.py --base . --out "$OUT_BASE/safety_case_bundle.tar.gz" || true
+
+echo "[6] Perform automated acceptance checks (best-effort)"
+FAIL=0
+# check RT SLO proof
+if [ -f "$OUT_BASE/rt_slo_proof.json" ]; then
+  P99_OK=$(jq -r '.p99_ok' "$OUT_BASE/rt_slo_proof.json" 2>/dev/null || echo "false")
+  SAFE_OK=$(jq -r '.safe_ok' "$OUT_BASE/rt_slo_proof.json" 2>/dev/null || echo "false")
+  echo "RT p99_ok=$P99_OK safe_ok=$SAFE_OK"
+  if [ "$P99_OK" != "true" ] || [ "$SAFE_OK" != "true" ]; then
+    echo "RT SLO check failed"
+    FAIL=1
+  fi
+else
+  echo "RT SLO proof not found"
+  FAIL=1
+fi
+
+# check HIL waveform compare result
+if [ -f "$OUT_BASE/cert/waveform_compare.json" ]; then
+  MSE=$(jq -r '.mse' "$OUT_BASE/cert/waveform_compare.json" 2>/dev/null || echo "null")
+  echo "Waveform MSE=$MSE"
+else
+  echo "Waveform compare result missing"
+  FAIL=1
+fi
+
+# check perception OOD: ensure some results exist and failure rate below threshold
+if [ -f "$OUT_BASE/perception/ood_results.json" ]; then
+  TOTAL=$(jq 'length' "$OUT_BASE/perception/ood_results.json" 2>/dev/null || echo 0)
+  FAILS=$(jq '[.[] | select(.ok==false)] | length' "$OUT_BASE/perception/ood_results.json" 2>/dev/null || echo 0)
+  echo "Perception OOD: total=$TOTAL fails=$FAILS"
+  # threshold: fail rate must be under 10% for this automated gate
+  if [ "$TOTAL" -gt 0 ]; then
+    RATE=$(awk "BEGIN {print ($FAILS/$TOTAL)}")
+    awk "BEGIN{ if ($RATE > 0.10) exit 1; else exit 0 }" || (echo "Perception fail rate too high ($RATE)" && FAIL=1)
+  fi
+else
+  echo "Perception OOD results missing"
+  FAIL=1
+fi
+
+echo "[7] Finalize bundle"
+BUNDLE="$OUT_BASE/audit_bundle_$(date +%s).tar.gz"
+tar -czf "$BUNDLE" -C "$(dirname "$OUT_BASE")" "$(basename "$OUT_BASE")" || true
+if [ -n "$COSIGN_KMS_URI" ]; then
+  cosign sign --key "$COSIGN_KMS_URI" "$BUNDLE" || true
+fi
+if [ -n "$S3_UPLOAD" ]; then
+  aws s3 cp "$BUNDLE" "$S3_UPLOAD" || true
+fi
+
+python3 - <<PY || true
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("operator_full_run", {"bundle":"$BUNDLE", "node":"$NODE"})
+print("manifest recorded")
+PY
+
+if [ "$FAIL" -ne 0 ]; then
+  echo "Operator gating FAILED. Inspect $OUT_BASE for artifacts."
+  exit 2
+fi
+echo "Operator gating PASSED. Bundle: $BUNDLE"
+exit 0
+
