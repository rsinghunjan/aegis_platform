+#!/usr/bin/env python3
+"""
+Avis-specific pre-load attestation webhook.
+Validates Rekor index and optionally checks region/branch metadata sent by the serving orchestrator.
+"""
+import os, requests
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+REKOR_URL = os.environ.get("REKOR_URL", "https://rekor.avis.example.com")
+ALLOWED_REGIONS = os.environ.get("AVIS_ALLOWED_REGIONS", "us,eu").split(",")
+
+def verify_rekor_index(index):
+    try:
+        r = requests.get(f"{REKOR_URL}/api/v1/log/entries?logIndex={index}", timeout=5)
+        return r.ok and bool(r.json())
+    except Exception:
+        return False
+
+@app.route("/validate_load", methods=["POST"])
+def validate_load():
+    req = request.json or {}
+    evidence = req.get("evidence", {})
+    region = req.get("region", "unknown")
+    if region not in ALLOWED_REGIONS:
+        return jsonify({"ok": False, "reason": "region_not_allowed"}), 403
+    ri = evidence.get("rekor_index")
+    if ri and verify_rekor_index(ri):
+        return jsonify({"ok": True})
+    return jsonify({"ok": False, "reason": "missing_or_invalid_attestation"}), 403
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8600")))
+
