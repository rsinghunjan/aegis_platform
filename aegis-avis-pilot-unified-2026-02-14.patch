+#!/usr/bin/env python3
+"""
+TFF PoC orchestrator for Avis pilot.
+- Logs round metadata to Rekor (audit)
+- Issues enrollment ticket placeholder (use Vault for production)
+"""
+import os, time, requests, json
+
+REKOR_API = os.environ.get("REKOR_URL","https://rekor.avis.example.com")
+VAULT_ADDR = os.environ.get("VAULT_ADDR","https://vault.avis.example.com")
+MCP = os.environ.get("AEGIS_MCP_API","http://mcp:8082")
+
+def log_round(round_meta):
+    entry = {"body":{"kind":"rekord","apiVersion":"0.0.1","spec":{"round":round_meta}}}
+    try:
+        r = requests.post(f"{REKOR_API}/api/v1/log/entries", json=entry, timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        print("Rekor log failed:", e)
+        return None
+
+def issue_enrollment_token(client_id):
+    # In prod: Vault token minting or signed enrollment assertion
+    return {"client_id": client_id, "enrollment_token": "ENROLL_TOKEN_PLACEHOLDER"}
+
+def schedule_round(name, clients_expected):
+    meta = {"name": name, "clients_expected": clients_expected, "ts": int(time.time())}
+    log_round(meta)
+    job_id = f"tff-{int(time.time())}"
+    requests.post(f"{MCP}/federated/rounds", json={"round_id": job_id, "meta": meta}, timeout=3)
+    return job_id
+
+if __name__ == "__main__":
+    jid = schedule_round("avis-demand-poc", 5)
+    print("Scheduled federated round:", jid)
