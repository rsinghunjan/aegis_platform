+"""
+Delta Lake ingestion helper (requires Delta Lake on Spark).
+Ingest Parquet data to Delta table and optimize / vacuum.
+"""
+from pyspark.sql import SparkSession
+from delta import *
+import sys
+def ingest(parquet_path, delta_table_path):
+    spark = SparkSession.builder \
+        .appName("delta-ingest") \
+        .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension") \
+        .config("spark.sql.catalog.spark_catalog", "org.apache.spark.sql.delta.catalog.DeltaCatalog") \
+        .getOrCreate()
+    df = spark.read.parquet(parquet_path)
+    df.write.format("delta").mode("overwrite").save(delta_table_path)
+    # optimize and vacuum (requires Delta optimizations available on cluster)
+    spark.sql(f"VACUUM delta.`{delta_table_path}` RETAIN 168 HOURS")
+    spark.stop()
+
+if __name__=="__main__":
+    if len(sys.argv) < 3:
+        print("Usage: delta_ingest.py <parquet_path> <delta_table_path>")
+        sys.exit(2)
+    ingest(sys.argv[1], sys.argv[2])
+
