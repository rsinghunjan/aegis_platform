+"""
+Example PySpark ETL job (reads CSV from object store, transforms, writes Parquet to Delta table)
+Run on Spark cluster (EMR / Dataproc / Databricks).
+"""
+from pyspark.sql import SparkSession
+from pyspark.sql.functions import col, lower
+
+def main(s3_input, delta_output_path):
+    spark = SparkSession.builder.appName("aegis-etl").getOrCreate()
+    df = spark.read.option("header","true").csv(s3_input)
+    df2 = df.select("id","text","metadata").withColumn("text_norm", lower(col("text")))
+    df2.write.format("parquet").mode("overwrite").save(delta_output_path)
+    spark.stop()
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("Usage: spark_job_example.py <s3_input> <delta_output_path>")
+        sys.exit(2)
+    main(sys.argv[1], sys.argv[2])
+
