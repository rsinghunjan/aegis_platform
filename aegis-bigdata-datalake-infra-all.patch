+"""
+Example ingestion pipeline: read records from Delta/Parquet, compute embeddings via embedding service,
+and upsert into Milvus collections.
+"""
+import os, sys, json
+from pymilvus import Collection, connections, utility
+import numpy as np
+import requests
+import pandas as pd
+
+MILTUS_HOST = os.environ.get("MILVUS_HOST","localhost")
+MILTUS_PORT = int(os.environ.get("MILVUS_PORT","19530"))
+EMBEDDING_API = os.environ.get("EMBEDDING_API","http://embedder:8000/embed")
+
+def embed_texts(texts):
+    r = requests.post(EMBEDDING_API, json={"texts": texts}, timeout=30)
+    r.raise_for_status()
+    return r.json().get("embeddings", [])
+
+def upsert(df, collection_name):
+    connections.connect(host=MILTUS_HOST, port=MILTUS_PORT)
+    if not utility.has_collection(collection_name):
+        # create simple collection schema; operator should manage schema/parameters
+        from pymilvus import FieldSchema, CollectionSchema, DataType
+        fields = [
+            FieldSchema(name="id", dtype=DataType.INT64, is_primary=True, auto_id=False),
+            FieldSchema(name="embedding", dtype=DataType.FLOAT_VECTOR, dim=768)
+        ]
+        schema = CollectionSchema(fields, description="Aegis embeddings")
+        Collection(collection_name, schema)
+    coll = Collection(collection_name)
+    texts = df["text"].tolist()
+    embeddings = embed_texts(texts)
+    ids = df["id"].astype("int64").tolist()
+    coll.insert([ids, embeddings])
+    coll.flush()
+
+if __name__=="__main__":
+    if len(sys.argv) < 3:
+        print("Usage: ingest_to_milvus.py <parquet_or_csv> <collection>")
+        sys.exit(2)
+    path = sys.argv[1]
+    col = sys.argv[2]
+    if path.endswith(".parquet"):
+        df = pd.read_parquet(path)
+    else:
+        df = pd.read_csv(path)
+    upsert(df, col)
+
