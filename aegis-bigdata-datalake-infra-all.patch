+"""
+Iceberg ingestion helper (Spark with Iceberg catalog configured).
+Writes Parquet data into an Apache Iceberg table using Spark.
+"""
+from pyspark.sql import SparkSession
+import sys
+
+def ingest(parquet_path, table_identifier):
+    spark = SparkSession.builder \
+        .appName("iceberg-ingest") \
+        .config("spark.sql.catalog.my_catalog", "org.apache.iceberg.spark.SparkCatalog") \
+        .config("spark.sql.catalog.my_catalog.type", "hadoop") \
+        .config("spark.sql.catalog.my_catalog.warehouse", "/tmp/iceberg-warehouse") \
+        .getOrCreate()
+    df = spark.read.parquet(parquet_path)
+    df.write.format("iceberg").mode("overwrite").save(table_identifier)
+    spark.stop()
+
+if __name__=="__main__":
+    if len(sys.argv) < 3:
+        print("Usage: iceberg_ingest.py <parquet_path> <table_identifier>")
+        sys.exit(2)
+    ingest(sys.argv[1], sys.argv[2])
+
