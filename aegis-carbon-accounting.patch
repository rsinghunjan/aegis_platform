+#!/usr/bin/env python3
+"""
+Admission webhook (stub) that enforces per-namespace/project carbon budgets.
+ - Tracks budget consumption in Redis
+ - Estimates job CO2e using requested resources and an expected_duration annotation (hours)
+ - Rejects creation if budget would be exceeded
+
+This is a demo: in production deploy as TLS-enabled webhook and validate authenticity.
+"""
+import json, os, time
+from http.server import HTTPServer, BaseHTTPRequestHandler
+import redis
+from ops.carbon.convert.energy_to_co2 import estimate_co2_for_job
+
+REDIS_URL = os.environ.get("REDIS_URL","redis://redis:6379/0")
+r = redis.from_url(REDIS_URL)
+
+# budgets stored in Redis as "budget:{namespace}" -> float kgCO2 available
+DEFAULT_BUDGET_KG = float(os.environ.get("DEFAULT_CARBON_BUDGET_KG","100.0"))
+
+def get_budget(namespace):
+    v = r.get(f"budget:{namespace}")
+    if v is None:
+        r.set(f"budget:{namespace}", DEFAULT_BUDGET_KG)
+        return DEFAULT_BUDGET_KG
+    return float(v)
+
+def deduct_budget(namespace, kg):
+    # atomic decrement
+    key = f"budget:{namespace}"
+    pipe = r.pipeline()
+    pipe.get(key)
+    pipe.decrbyfloat(key, kg)
+    old, new = pipe.execute()
+    return float(new)
+
+class Handler(BaseHTTPRequestHandler):
+    def do_POST(self):
+        length = int(self.headers.get('Content-Length',0))
+        body = self.rfile.read(length)
+        req = json.loads(body)
+        # Expect admission review-like payload; simplified parsing:
+        namespace = req.get('request',{}).get('namespace','default')
+        obj = req.get('request',{}).get('object',{})
+        annotations = obj.get('metadata',{}).get('annotations',{})
+        expected_hours = float(annotations.get('aegis/expected_duration_hours', '1'))
+        region = annotations.get('aegis/region', 'us-west-2')
+        instance_type = obj.get('spec',{}).get('template',{}).get('spec',{}).get('containers',[{}])[0].get('resources',{}).get('limits',{}).get('nvidia.com/gpu', 0)
+        # coarse parse: instance_type annotation or fallback to default
+        instance_type_name = annotations.get('aegis/instance_type','p4d.24xlarge')
+        # estimate co2 for job
+        energy_kwh, co2e_kg, details = estimate_co2_for_job(region=region, instance_type=instance_type_name, runtime_hours=expected_hours, gpu_hours=float(instance_type))
+        budget = get_budget(namespace)
+        allowed = True
+        message = ""
+        if co2e_kg > budget:
+            allowed = False
+            message = f"budget_exceeded: required_kg={co2e_kg:.2f} budget_kg={budget:.2f}"
+        else:
+            # deduct
+            new_budget = deduct_budget(namespace, co2e_kg)
+            message = f"accepted: co2e_kg={co2e_kg:.2f}, remaining_budget={new_budget:.2f}"
+
+        resp = {"response":{"allowed": allowed, "status": {"message": message}}}
+        self.send_response(200)
+        self.end_headers()
+        self.wfile.write(json.dumps(resp).encode())
+
+if __name__=="__main__":
+    HTTPServer(('0.0.0.0', 8443), Handler).serve_forever()
+
