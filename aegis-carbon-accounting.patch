+#!/usr/bin/env python3
+"""
+Extend auditor package to include carbon accounting artifacts and sign bundle.
+Produces manifest including CO2e totals for included job artifacts.
+"""
+import argparse, json, os, tarfile, tempfile, subprocess
+from datetime import datetime
+
+def build_bundle(artifacts, outpath, cosign_key=None, s3=None):
+    tmp = tempfile.mkdtemp()
+    manifest = {"generated_at": datetime.utcnow().isoformat()+"Z", "files": [], "total_co2e_kg": 0.0}
+    total = 0.0
+    for f in artifacts:
+        base = os.path.basename(f)
+        subprocess.check_call(["cp", f, tmp])
+        manifest["files"].append({"name": base, "path": f})
+        # try to read co2e from artifact if present
+        try:
+            j = json.load(open(f))
+            c = float(j.get("co2e_kg", 0.0))
+            total += c
+        except Exception:
+            pass
+    manifest["total_co2e_kg"] = total
+    mpath = os.path.join(tmp, "carbon_manifest.json")
+    with open(mpath, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    with tarfile.open(outpath, "w:gz") as tar:
+        tar.add(tmp, arcname="audit")
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,outpath])
+        except Exception as e:
+            print("cosign signing failed:", e)
+    if s3:
+        try:
+            subprocess.check_call(["aws","s3","cp", outpath, os.path.join(s3, os.path.basename(outpath))])
+        except Exception as e:
+            print("s3 upload failed:", e)
+    return outpath
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifacts", required=True, help="comma-separated list of artifact paths (job carbon jsons)")
+    p.add_argument("--out", required=True)
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    args = p.parse_args()
+    arts = args.artifacts.split(",")
+    out = build_bundle(arts, args.out, cosign_key=args.cosign_key, s3=args.s3)
+    print("Wrote carbon auditor bundle:", out)
+
