+#!/usr/bin/env python3
+"""
+Autoscaler hook that scores instance types by estimated carbon per useful work.
+ - Input: candidate instance types, region, estimated job profile (gpu_hours)
+ - Output: ranking and suggested instance type
+This is a heuristic demonstration: in production integrate with cloud APIs and real energy benchmarks.
+"""
+import math
+from ops.carbon.convert.energy_to_co2 import fallback_emission_factor
+
+# sample efficiency metric: useful-work-per-watt baseline (higher is better)
+INSTANCE_EFFICIENCY = {
+    "p4d.24xlarge": 1.0,
+    "p3.16xlarge": 0.7,
+    "g4dn.xlarge": 0.2,
+    "default": 0.5
+}
+
+def score_instance(instance_type, region, runtime_hours, gpu_hours):
+    ef = fallback_emission_factor(region) / 1000.0  # kgCO2 per kWh -> tCO2? keep kg
+    # approximate watts
+    watts = 300 * (gpu_hours / max(1.0, runtime_hours)) if gpu_hours>0 else 300
+    energy_kwh = watts * runtime_hours / 1000.0
+    co2e = energy_kwh * ef * 1000.0  # kg
+    eff = INSTANCE_EFFICIENCY.get(instance_type, INSTANCE_EFFICIENCY["default"])
+    # score = co2e / eff (lower is better)
+    return co2e / eff
+
+def rank_instances(candidates, region, runtime_hours, gpu_hours):
+    scored = [(i, score_instance(i, region, runtime_hours, gpu_hours)) for i in candidates]
+    scored.sort(key=lambda x: x[1])
+    return scored
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--candidates", required=True, help="comma-separated instance types")
+    p.add_argument("--region", default="us-west-2")
+    p.add_argument("--runtime-hours", type=float, default=1.0)
+    p.add_argument("--gpu-hours", type=float, default=1.0)
+    args = p.parse_args()
+    candidates = args.candidates.split(",")
+    ranked = rank_instances(candidates, args.region, args.runtime_hours, args.gpu_hours)
+    for inst, score in ranked:
+        print(inst, score)
+
