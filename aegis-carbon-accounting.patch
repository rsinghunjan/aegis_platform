+#!/usr/bin/env python3
+"""
+Energy to CO2 converter
+ - Primary: query ElectricityMap API for region/time emission factor (gCO2/kWh)
+ - Fallback: static JSON table (ops/carbon/convert/default_emissions.json)
+ - Estimate energy from measured power or instance typology
+"""
+import os, time, json, requests
+from datetime import datetime
+
+ELEC_API_KEY = os.environ.get("ELECTRICITYMAP_API_KEY","")
+FALLBACK = "ops/carbon/convert/default_emissions.json"
+PUE = float(os.environ.get("AEGIS_PUE", "1.2"))
+
+# Very small instance energy mapping (W avg) per-instance family (placeholder)
+INSTANCE_WATTS = {
+    "p4d.24xlarge": 2000 * 8,   # rough aggregated GPU card consumption
+    "a100": 400,                # per GPU nominal
+    "p4": 350,
+    "default": 300
+}
+
+def query_electricitymap(region, ts=None):
+    """Query ElectricityMap for average gCO2/kWh for the region at timestamp.
+    Returns grams CO2 per kWh or None.
+    """
+    if not ELEC_API_KEY:
+        return None
+    ts = ts or int(time.time())
+    # ElectricityMap API endpoint (example). Users must map their region code properly.
+    url = f"https://api.electricitymap.org/v3/carbon-intensity/history?zone={region}&start_at={int(ts)-3600}&end_at={int(ts)}"
+    headers = {"Accept": "application/json", "auth-token": ELEC_API_KEY}
+    try:
+        r = requests.get(url, headers=headers, timeout=5)
+        data = r.json()
+        # pick latest value
+        points = data.get("data", [])
+        if points:
+            return float(points[-1].get("carbonIntensity", 0.0))
+    except Exception:
+        return None
+    return None
+
+def fallback_emission_factor(region):
+    try:
+        j = json.load(open(FALLBACK))
+        return float(j.get(region, j.get("default", 400.0)))
+    except Exception:
+        return 400.0
+
+def estimate_energy_kwh(runtime_hours, measured_power_w=None, instance_type=None, gpu_hours=0.0):
+    """Estimate job energy in kWh.
+    - If measured_power_w provided, energy = measured_power_w * runtime_hours / 1000 * PUE
+    - Else estimate using instance_type avg watts * runtime_hours * PUE
+    """
+    if measured_power_w:
+        energy_kwh = (measured_power_w * runtime_hours) / 1000.0 * PUE
+        details = {"method":"measured_power"}
+        return energy_kwh, details
+    avg_w = INSTANCE_WATTS.get(instance_type, INSTANCE_WATTS["default"])
+    # crude estimate: average over number of GPUs implied by gpu_hours/runtime_hours
+    energy_kwh = (avg_w * runtime_hours) / 1000.0 * PUE
+    details = {"method":"instance_estimate","avg_w":avg_w}
+    return energy_kwh, details
+
+def energy_to_co2(energy_kwh, region, ts=None):
+    gf = query_electricitymap(region, ts)
+    if gf is None:
+        gf = fallback_emission_factor(region)
+    # gf is grams CO2 per kWh
+    co2e_kg = energy_kwh * gf / 1000.0
+    return co2e_kg, {"grid_gCO2_per_kWh": gf}
+
+def estimate_co2_for_job(region, instance_type, runtime_hours, gpu_hours=0.0, measured_power_w=None):
+    energy_kwh, e_det = estimate_energy_kwh(runtime_hours, measured_power_w=measured_power_w, instance_type=instance_type, gpu_hours=gpu_hours)
+    co2e_kg, cdet = energy_to_co2(energy_kwh, region)
+    details = {"energy_details": e_det, "co2_details": cdet}
+    return energy_kwh, co2e_kg, details
+
