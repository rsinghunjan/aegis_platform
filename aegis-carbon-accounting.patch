+#!/usr/bin/env python3
+"""
+Job carbon exporter
+ - Collects job metadata (start/end, instance type, region, gpu_hours)
+ - Optionally samples GPU power via nvidia-smi (if available) to compute energy_kWh
+ - Uses energy_to_co2.convert() to compute co2e_kg
+ - Emits a JSON artifact and optionally pushes Prometheus metrics to Pushgateway
+
+Usage (post-job):
+  python3 ops/carbon/exporter/job_carbon_exporter.py --job-id JOB123 --start 1670000000 --end 1670003000 --region us-west-2 --instance-type p4d.24xlarge --gpu-hours 4 --pushgateway http://pushgateway:9091
+"""
+import argparse, time, json, os, subprocess
+from datetime import datetime
+
+from ops.carbon.convert.energy_to_co2 import estimate_co2_for_job
+
+def sample_gpu_power(samples=5, interval_s=1):
+    """Try to sample GPU power via nvidia-smi. Returns avg Watts or None."""
+    powers = []
+    for _ in range(samples):
+        try:
+            out = subprocess.check_output(["nvidia-smi","--query-gpu=power.draw","--format=csv,noheader,nounits"], stderr=subprocess.DEVNULL)
+            val = float(out.decode().strip().splitlines()[0])
+            powers.append(val)
+        except Exception:
+            return None
+    return sum(powers)/len(powers) if powers else None
+
+def push_metric(pushgateway, job_id, metric, value):
+    try:
+        import requests
+        body = f"# TYPE {metric} gauge\n{metric}{{job_id=\"{job_id}\"}} {value}\n"
+        requests.post(f"{pushgateway}/metrics/job/aegis_carbon", data=body, timeout=5)
+    except Exception:
+        pass
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--job-id", required=True)
+    p.add_argument("--start", type=int, required=True)
+    p.add_argument("--end", type=int, required=True)
+    p.add_argument("--region", required=True)
+    p.add_argument("--instance-type", required=True)
+    p.add_argument("--gpu-hours", type=float, default=0.0)
+    p.add_argument("--pushgateway", default=os.environ.get("PUSHGATEWAY",""))
+    p.add_argument("--out", default=f"/tmp/carbon_job_{{}}.json")
+    args = p.parse_args()
+
+    runtime_hours = max(1e-6, (args.end - args.start) / 3600.0)
+
+    measured_power_w = sample_gpu_power()
+    # If measured_power_w available, use it. Else estimate from instance type + gpu_hours.
+    energy_kwh, co2e_kg, details = estimate_co2_for_job(
+        region=args.region,
+        instance_type=args.instance_type,
+        runtime_hours=runtime_hours,
+        gpu_hours=args.gpu_hours,
+        measured_power_w=measured_power_w
+    )
+
+    outpath = args.out.format(args.job_id)
+    payload = {
+        "job_id": args.job_id,
+        "start": args.start,
+        "end": args.end,
+        "runtime_hours": runtime_hours,
+        "instance_type": args.instance_type,
+        "region": args.region,
+        "gpu_hours": args.gpu_hours,
+        "measured_power_w": measured_power_w,
+        "energy_kwh": energy_kwh,
+        "co2e_kg": co2e_kg,
+        "details": details,
+        "generated_at": datetime.utcnow().isoformat() + "Z"
+    }
+    os.makedirs(os.path.dirname(outpath), exist_ok=True)
+    with open(outpath, "w") as fh:
+        json.dump(payload, fh, indent=2)
+    print("Wrote carbon artifact:", outpath)
+
+    if args.pushgateway:
+        push_metric(args.pushgateway, args.job_id, "aegis_job_energy_kwh", energy_kwh)
+        push_metric(args.pushgateway, args.job_id, "aegis_job_co2e_kg", co2e_kg)
+
+if __name__=="__main__":
+    main()
+
