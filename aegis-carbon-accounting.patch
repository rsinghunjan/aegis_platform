+#!/usr/bin/env python3
+"""
+Very small carbon-aware scheduler helper.
+Given a job manifest and candidate regions, picks the region with lowest current carbon intensity,
+then emits a Kubernetes job manifest with nodeSelector region=<chosen>.
+
+This is a helper - integrate into your batch submission pipeline or Argo workflows.
+"""
+import os, json, requests, time
+from ops.carbon.convert.energy_to_co2 import query_electricitymap, fallback_emission_factor
+
+def pick_region(candidate_regions):
+    best = None
+    best_val = float("inf")
+    for r in candidate_regions:
+        v = query_electricitymap(r)
+        if v is None:
+            v = fallback_emission_factor(r)
+        if v < best_val:
+            best_val = v
+            best = (r, v)
+    return best
+
+def inject_node_selector(job_manifest, region):
+    # job_manifest is a dict representing a Kubernetes Job
+    spec = job_manifest.setdefault("spec", {}).setdefault("template", {}).setdefault("spec", {})
+    spec.setdefault("nodeSelector", {})["region"] = region
+    return job_manifest
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--job-json", required=True)
+    p.add_argument("--candidates", required=True, help="comma separated region codes")
+    p.add_argument("--out", default="/tmp/carbon_job_manifest.json")
+    args = p.parse_args()
+    job = json.load(open(args.job_json))
+    candidates = args.candidates.split(",")
+    chosen, val = pick_region(candidates)
+    print("Chosen region:", chosen, "with gCO2/kWh:", val)
+    newjob = inject_node_selector(job, chosen)
+    with open(args.out, "w") as fh:
+        json.dump(newjob, fh, indent=2)
+    print("Wrote job manifest with nodeSelector to", args.out)
+
