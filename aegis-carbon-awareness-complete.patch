+#!/usr/bin/env python3
+"""
+Carbon-aware scheduler (simple prototype):
+ - Queries electricityMap or WattTime (if API key present) for current grid carbon intensity (gCO2/kWh)
+ - If intensity <= threshold (gCO2/kWh) schedules a provided k8s job manifest via kubectl
+ - Otherwise delays scheduling until next check interval
+
+Usage:
+  python3 ops/carbon/carbon_scheduler.py --job job_manifest.yaml --threshold 200 --poll-interval 300
+
+Notes:
+ - Requires kubectl in PATH and access to target cluster.
+ - Set ELECTRICITYMAP_API_KEY or WATTTIME_ZONE credentials if available.
+"""
+import argparse
+import time
+import requests
+import subprocess
+import os
+import sys
+
+EM_API = os.environ.get("ELECTRICITYMAP_API_KEY","")
+WATTTIME_ZONE = os.environ.get("WATTTIME_ZONE","")
+
+def query_electricitymap(lat=0, lon=0):
+    if not EM_API:
+        return None
+    url = f"https://api.electricitymap.org/v3/carbon-intensity/locations/coords?lat={lat}&lon={lon}"
+    hdr = {"Authorization": f"Bearer {EM_API}"}
+    r = requests.get(url, headers=hdr, timeout=10)
+    r.raise_for_status()
+    j = r.json()
+    # returns gCO2eq_per_kwh
+    return j.get("data",{}).get("carbonIntensity")
+
+def query_wattime(zone):
+    if not zone:
+        return None
+    url = f"https://api2.watttime.org/v2/point?zone={zone}"
+    # Assumes WATTTIME_USERNAME and WATTTIME_PASSWORD are set in env if needed (not implemented here)
+    try:
+        r = requests.get(url, timeout=10)
+        r.raise_for_status()
+        j = r.json()
+        return j.get("data",{}).get("carbon_intensity")
+    except Exception:
+        return None
+
+def schedule_job(manifest_path):
+    print("Applying kubectl manifest:", manifest_path)
+    subprocess.check_call(["kubectl","apply","-f", manifest_path])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--job", required=True)
+    p.add_argument("--threshold", type=float, default=250.0, help="gCO2/kWh threshold to allow scheduling")
+    p.add_argument("--poll-interval", type=int, default=300, help="seconds between checks")
+    p.add_argument("--lat", type=float, default=0.0)
+    p.add_argument("--lon", type=float, default=0.0)
+    args = p.parse_args()
+
+    print("Starting carbon-aware scheduler for job:", args.job)
+    while True:
+        intensity = None
+        try:
+            intensity = query_electricitymap(args.lat, args.lon)
+            if intensity is None:
+                intensity = query_wattime(WATTTIME_ZONE)
+        except Exception as e:
+            print("Carbon API query failed:", e)
+        if intensity is None:
+            print("No carbon intensity available; defaulting to schedule immediately")
+            schedule_job(args.job)
+            return
+        print("Current carbon intensity (gCO2/kWh):", intensity)
+        if intensity <= args.threshold:
+            print("Intensity below threshold; scheduling job")
+            schedule_job(args.job)
+            return
+        else:
+            print(f"Intensity {intensity} > threshold {args.threshold}; sleeping {args.poll_interval}s")
+            time.sleep(args.poll_interval)
+
+if __name__=="__main__":
+    main()
+
