+#!/usr/bin/env python3
+"""
+Prototype Admission Webhook that inspects Job manifests and rejects scheduling
+if the job is carbon-heavy and not annotated to allow scheduling outside green nodes.
+
+This is a skeleton / PoC. A production webhook must:
+ - Run as Deployment in cluster
+ - Be registered as ValidatingWebhookConfiguration with proper CA bundle
+ - Handle AdmissionReview requests and replies exactly per k8s API
+
+Here we implement a simple HTTP endpoint that expects a JSON with 'job' key (the Job manifest)
+and returns {"allowed": true/false, "reason": "..."} for integration testing.
+"""
+from flask import Flask, request, jsonify
+import os
+
+app = Flask(__name__)
+GREEN_LABEL = os.environ.get("GREEN_LABEL","carbon=green")
+
+def is_job_carbon_heavy(job):
+    # Heuristic: annotation carbon/sensitivity == "high" OR resources > cpu 8
+    ann = job.get("metadata",{}).get("annotations",{})
+    if ann.get("carbon/sensitivity","") == "high":
+        return True
+    # check container resources
+    spec = job.get("spec",{}).get("template",{}).get("spec",{})
+    for c in spec.get("containers",[]):
+        resources = c.get("resources",{})
+        limits = resources.get("limits",{})
+        cpu = limits.get("cpu")
+        try:
+            if cpu:
+                cpu_v = float(str(cpu).replace("m","")) if "m" in str(cpu) else float(cpu)
+                if cpu_v >= 8:
+                    return True
+        except Exception:
+            pass
+    return False
+
+@app.route("/validate-job", methods=["POST"])
+def validate_job():
+    body = request.json or {}
+    job = body.get("job") or {}
+    # If job annotated to allow-schedule-anywhere, permit
+    ann = job.get("metadata",{}).get("annotations",{})
+    if ann.get("carbon/allow_anywhere","false").lower() in ("1","true","yes"):
+        return jsonify({"allowed": True, "reason": "explicit allow annotation"})
+    heavy = is_job_carbon_heavy(job)
+    if not heavy:
+        return jsonify({"allowed": True, "reason": "not carbon-heavy"})
+    # If heavy, require nodeSelector with carbon=green
+    spec = job.get("spec",{}).get("template",{}).get("spec",{})
+    node_sel = spec.get("nodeSelector",{}) or {}
+    if node_sel.get("carbon") == "green":
+        return jsonify({"allowed": True, "reason": "targeting green nodepool"})
+    return jsonify({"allowed": False, "reason": "carbon-heavy job must target carbon=green nodepool or set carbon/allow_anywhere"})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8443")))
+
