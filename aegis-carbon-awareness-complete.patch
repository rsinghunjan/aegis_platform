+#!/usr/bin/env python3
+"""
+Run a shell command (training/inference job) under CodeCarbon EmissionsTracker,
+capture energy/CO2 estimates and persist metrics to MLflow and a local JSON record.
+
+Usage:
+  python3 services/carbon/codecarbon_mlflow.py --cmd "python3 services/train/finetune_transformer.py --config cfg" --model-name my-model --outdir /tmp/carbon_runs
+
+Notes:
+ - Requires CodeCarbon to be installed (see services/requirements-carbon.txt).
+ - MLflow: set MLFLOW_TRACKING_URI env var if you want results recorded in MLflow.
+ - The underlying job is executed as a subprocess; exit code is returned.
+"""
+import argparse
+import subprocess
+import time
+import json
+import os
+from codecarbon import EmissionsTracker
+
+def run_and_track(cmd, outdir="/tmp/carbon_runs", mlflow_experiment=None):
+    os.makedirs(outdir, exist_ok=True)
+    run_id = f"run-{int(time.time())}"
+
+    tracker = EmissionsTracker()
+    tracker.start()
+    start_ts = time.time()
+    proc = subprocess.run(cmd, shell=True)
+    end_ts = time.time()
+    emissions = tracker.stop()
+
+    record = {
+        "run_id": run_id,
+        "cmd": cmd,
+        "returncode": proc.returncode,
+        "start_ts": int(start_ts),
+        "end_ts": int(end_ts),
+        "duration_s": end_ts - start_ts,
+        "energy_kwh": emissions.energy_consumed,
+        "co2_kg": emissions.emissions,
+        "emissions_provider": str(emissions.emissions_data_provider) if hasattr(emissions,"emissions_data_provider") else None
+    }
+
+    outpath = os.path.join(outdir, f"{run_id}.json")
+    with open(outpath, "w") as fh:
+        json.dump(record, fh, indent=2)
+    print("Wrote carbon record to", outpath)
+
+    try:
+        import mlflow
+        mlflow_uri = os.environ.get("MLFLOW_TRACKING_URI")
+        if mlflow_uri:
+            mlflow.set_tracking_uri(mlflow_uri)
+        exp = mlflow_experiment or os.environ.get("MLFLOW_EXPERIMENT","carbon-tracking")
+        mlflow.set_experiment(exp)
+        with mlflow.start_run(run_name=run_id):
+            mlflow.log_param("cmd", cmd)
+            mlflow.log_metric("duration_s", record["duration_s"])
+            mlflow.log_metric("energy_kwh", record["energy_kwh"])
+            mlflow.log_metric("co2_kg", record["co2_kg"])
+            mlflow.log_artifact(outpath, artifact_path="carbon_records")
+    except Exception as e:
+        print("MLflow logging failed:", e)
+
+    return proc.returncode, outpath
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--cmd", required=True, help="Shell command to run")
+    p.add_argument("--outdir", default="/tmp/carbon_runs")
+    p.add_argument("--mlflow-experiment", default=None)
+    args = p.parse_args()
+    rc, path = run_and_track(args.cmd, outdir=args.outdir, mlflow_experiment=args.mlflow_experiment)
+    if rc != 0:
+        print("Command failed with rc", rc)
+    else:
+        print("Command completed successfully")
+
+if __name__=="__main__":
+    main()
+
