+#!/usr/bin/env python3
+"""
+Prometheus exporter that exposes CO2/energy metrics per run.
+ - Reads JSON records written by services/carbon/codecarbon_mlflow.py (default /tmp/carbon_runs)
+ - Exposes metrics:
+     aegis_carbon_co2_kg{run_id="..."} -> gauge (latest)
+     aegis_carbon_energy_kwh{run_id="..."} -> gauge (latest)
+
+Run:
+  python3 services/observability/carbon_exporter.py --dir /tmp/carbon_runs --port 9095
+"""
+import argparse
+import time
+import os
+import json
+from prometheus_client import start_http_server, Gauge
+
+GAUGE_CO2 = Gauge('aegis_carbon_co2_kg', 'Estimated CO2 kg for a run', ['run_id'])
+GAUGE_ENERGY = Gauge('aegis_carbon_energy_kwh', 'Estimated energy (kWh) for a run', ['run_id'])
+
+def load_and_expose(dirpath):
+    for fn in os.listdir(dirpath):
+        if not fn.endswith(".json"):
+            continue
+        try:
+            path = os.path.join(dirpath, fn)
+            j = json.load(open(path))
+            run_id = j.get("run_id")
+            if run_id:
+                GAUGE_CO2.labels(run_id=run_id).set(float(j.get("co2_kg", 0.0) or 0.0))
+                GAUGE_ENERGY.labels(run_id=run_id).set(float(j.get("energy_kwh", 0.0) or 0.0))
+        except Exception as e:
+            print("Failed to load", fn, e)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--dir", default="/tmp/carbon_runs")
+    p.add_argument("--port", type=int, default=9095)
+    p.add_argument("--interval", type=int, default=30)
+    args = p.parse_args()
+    os.makedirs(args.dir, exist_ok=True)
+    start_http_server(args.port)
+    print("Carbon exporter listening on port", args.port, "scanning", args.dir)
+    while True:
+        load_and_expose(args.dir)
+        time.sleep(args.interval)
+
+if __name__=="__main__":
+    main()
+
