+#!/usr/bin/env python3
+"""
+Promotion guard that includes carbon checks.
+ - Checks latest staging model accuracy and emissions_kgco2e metric (if present).
+ - Uses a policy: (accuracy_gain / emissions_kg) >= MIN_GAIN_PER_KG  OR emissions_kg <= MAX_EMISSIONS_PER_PROMOTION
+ - If policy fails, opens an A2A approval request and includes carbon metadata in the request.
+"""
+import os
+import sys
+import requests
+from services.mlflow.mlflow_client import get_latest_model_metrics
+
+MODEL_NAME = os.environ.get("MODEL_NAME", "aegis-model")
+REQUIRED_ACCURACY = float(os.environ.get("REQUIRED_ACCURACY", "0.80"))
+MIN_GAIN_PER_KG = float(os.environ.get("MIN_GAIN_PER_KG", "0.01"))  # accuracy fraction per kgCO2e
+MAX_EMISSIONS_PER_PROMOTION = float(os.environ.get("MAX_EMISSIONS_PER_PROMOTION", "100.0"))  # kgCO2e
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+PRODUCTION_MODEL = os.environ.get("PRODUCTION_MODEL", "")
+
+def get_production_accuracy():
+    if not PRODUCTION_MODEL:
+        return 0.0
+    metrics = get_latest_model_metrics(PRODUCTION_MODEL, stage="Production")
+    if not metrics:
+        return 0.0
+    return float(metrics.get("accuracy", 0.0))
+
+def check_and_promote():
+    metrics = get_latest_model_metrics(MODEL_NAME, stage="Staging")
+    if not metrics:
+        print("no staging model found")
+        return 1
+    acc = float(metrics.get("accuracy", 0.0))
+    emissions = float(metrics.get("emissions_kgco2e", 0.0))
+    print("staging accuracy", acc, "emissions_kg", emissions)
+    prod_acc = get_production_accuracy()
+    acc_gain = max(0.0, acc - prod_acc)
+
+    # Decision logic
+    if acc >= REQUIRED_ACCURACY:
+        meets_carbon_policy = False
+        if emissions <= MAX_EMISSIONS_PER_PROMOTION:
+            meets_carbon_policy = True
+        elif emissions > 0 and (acc_gain / emissions) >= MIN_GAIN_PER_KG:
+            meets_carbon_policy = True
+
+        if meets_carbon_policy:
+            # proceed to request promotion (still via A2A for audit)
+            body = {"action_id":"promote-"+MODEL_NAME, "artifact_uri": f"mlflow://{MODEL_NAME}", "approver":"mlops", "decision":"requested", "comment":"auto-promotion request (carbon policy passed)"}
+            try:
+                r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+                if r.ok:
+                    print("A2A request opened", r.json().get("id"))
+                    requests.post(f"{AEGIS_MCP.rstrip('/')}/promotion/events", json={"model":MODEL_NAME,"accuracy":acc,"emissions_kg":emissions,"a2a":r.json().get("id")}, timeout=3.0)
+                    return 0
+            except Exception as e:
+                print("failed to open A2A", e)
+                return 1
+        else:
+            # Open A2A but include carbon advisory for human approver
+            body = {"action_id":"promote-"+MODEL_NAME, "artifact_uri": f"mlflow://{MODEL_NAME}", "approver":"mlops", "decision":"requested", "comment":"promotion blocked by carbon policy - approval required", "carbon": {"emissions_kg": emissions, "acc_gain": acc_gain}}
+            try:
+                r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+                if r.ok:
+                    print("A2A carbon advisory opened", r.json().get("id"))
+                    requests.post(f"{AEGIS_MCP.rstrip('/')}/promotion/events", json={"model":MODEL_NAME,"accuracy":acc,"emissions_kg":emissions,"a2a":r.json().get("id"),"carbon_policy":"requires_human"}, timeout=3.0)
+                    return 0
+            except Exception as e:
+                print("failed to open A2A", e)
+                return 1
+    else:
+        print("does not meet required accuracy")
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/promotion/events", json={"model":MODEL_NAME,"accuracy":acc,"promote":False}, timeout=3.0)
+        return 2
+
+if __name__ == "__main__":
+    sys.exit(check_and_promote())
+
