+#!/usr/bin/env python3
+"""
+Carbon-aware scheduler:
+- Polls a configurable carbon-intensity API (or uses a stub) and when intensity is below a configured threshold
+  it submits queued Argo Workflow YAMLs (found in CARBON_QUEUE_DIR) using `kubectl apply -f`.
+- This is intentionally simple and runs as a small controller on the cluster.
+
+Config (env):
+ - CARBON_API_URL: optional JSON API returning {"carbon_intensity": <gCO2eq/kWh>} or leave empty to use stubbed values.
+ - CARBON_THRESHOLD: gCO2eq/kWh threshold below which jobs are allowed (default 200).
+ - CARBON_QUEUE_DIR: directory with workflow yaml files to submit (default /data/carbon_queue)
+ - SUBMITTED_DIR: directory to move submitted files (default /data/carbon_submitted)
+ - POLL_SECONDS: how often to poll (default 300)
+"""
+import os
+import time
+import json
+import shutil
+import subprocess
+import requests
+
+CARBON_API_URL = os.environ.get("CARBON_API_URL", "")
+CARBON_THRESHOLD = float(os.environ.get("CARBON_THRESHOLD", "200.0"))
+CARBON_QUEUE_DIR = os.environ.get("CARBON_QUEUE_DIR", "/data/carbon_queue")
+SUBMITTED_DIR = os.environ.get("SUBMITTED_DIR", "/data/carbon_submitted")
+POLL_SECONDS = int(os.environ.get("POLL_SECONDS", "300"))
+
+os.makedirs(CARBON_QUEUE_DIR, exist_ok=True)
+os.makedirs(SUBMITTED_DIR, exist_ok=True)
+
+def get_carbon_intensity():
+    if not CARBON_API_URL:
+        # stub: return a simple diurnal pattern to allow local testing (lower at night)
+        h = time.gmtime().tm_hour
+        return 50.0 if (h >= 0 and h <= 6) else 250.0
+    try:
+        r = requests.get(CARBON_API_URL, timeout=5.0)
+        r.raise_for_status()
+        j = r.json()
+        return float(j.get("carbon_intensity", j.get("value", 999.0)))
+    except Exception:
+        return 999.0
+
+def submit_workflow(path):
+    try:
+        subprocess.check_call(["kubectl", "apply", "-f", path])
+        return True
+    except subprocess.CalledProcessError:
+        return False
+
+def main():
+    while True:
+        intensity = get_carbon_intensity()
+        # log locally
+        print("current carbon intensity (gCO2eq/kWh):", intensity)
+        if intensity <= CARBON_THRESHOLD:
+            # submit all queued workflows
+            for f in sorted(os.listdir(CARBON_QUEUE_DIR)):
+                if not f.endswith((".yaml",".yml")):
+                    continue
+                path = os.path.join(CARBON_QUEUE_DIR, f)
+                print("Attempting to submit", path)
+                ok = submit_workflow(path)
+                if ok:
+                    dst = os.path.join(SUBMITTED_DIR, f"{int(time.time())}-{f}")
+                    shutil.move(path, dst)
+                    print("Submitted and moved to", dst)
+                else:
+                    print("Submission failed for", path)
+        else:
+            print("Carbon intensity above threshold, delaying submissions.")
+        time.sleep(POLL_SECONDS)
+
+if __name__ == "__main__":
+    main()
+
