+#!/usr/bin/env python3
+"""
+A small wrapper to measure/estimate emissions for batch inference using CodeCarbon.
+Intended to be called around heavy batch inference jobs to record per-batch emissions.
+It logs emissions to MCP and pushes a Prometheus metric to a pushgateway.
+"""
+import os
+import time
+import requests
+
+try:
+    from codecarbon import EmissionsTracker
+except Exception:
+    EmissionsTracker = None
+
+PUSHGATEWAY = os.environ.get("PROM_PUSHGATEWAY", "")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def push_emissions_metric(job_name, emissions_kg):
+    if not PUSHGATEWAY:
+        return
+    try:
+        from prometheus_client import CollectorRegistry, Gauge, push_to_gateway
+        registry = CollectorRegistry()
+        g = Gauge('aegis_inference_emissions_kg', 'Estimated kg CO2e for inference batch', registry=registry)
+        g.set(emissions_kg)
+        push_to_gateway(PUSHGATEWAY, job=job_name, registry=registry)
+    except Exception:
+        pass
+
+def run_with_emissions(job_name, func, *args, **kwargs):
+    tracker = None
+    if EmissionsTracker is not None:
+        try:
+            tracker = EmissionsTracker(project_name="aegis-inference", output_dir="/tmp/codecarbon")
+            tracker.start()
+        except Exception:
+            tracker = None
+    start = time.time()
+    result = func(*args, **kwargs)
+    duration = time.time() - start
+    emissions = None
+    if tracker is not None:
+        try:
+            emissions = tracker.stop()
+        except Exception:
+            try:
+                emissions = float(getattr(tracker, "_last_emissions", 0.0))
+            except Exception:
+                emissions = None
+    if emissions is not None:
+        push_emissions_metric(job_name, float(emissions))
+        try:
+            requests.post(f"{AEGIS_MCP.rstrip('/')}/monitoring/emissions", json={"job": job_name, "emissions_kg": float(emissions), "duration_s": duration}, timeout=3.0)
+        except Exception:
+            pass
+    return result
+
