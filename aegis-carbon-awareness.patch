+#!/usr/bin/env python3
+"""
+Estimate energy and CO2e for a job and log to MLflow and evidence SDK.
+
+Estimation model:
+ - energy_kwh = (avg_power_watt * duration_seconds) / 3600
+ - co2e_g = energy_kwh * carbon_intensity_g_per_kwh
+
+If carbon intensity is unavailable, use static default or WattTime via watttime_client.
+"""
+import os, argparse, json
+from ops.carbon.watttime_client import get_latest_intensity
+from ops.sdk.evidence_sdk import record_manifest
+try:
+    import mlflow
+except Exception:
+    mlflow = None
+
+def estimate_and_log(run_id=None, duration_s=0.0, avg_power_w=0.0, region="US-CA", mlflow_uri=None):
+    intensity = get_latest_intensity(region=region) or float(os.environ.get("Aegis_CARBON_STATIC", "400.0"))
+    energy_kwh = (avg_power_w * duration_s) / 3600.0
+    co2e_g = energy_kwh * intensity
+    payload = {
+        "run_id": run_id,
+        "duration_s": duration_s,
+        "avg_power_w": avg_power_w,
+        "energy_kwh": energy_kwh,
+        "co2e_g": co2e_g,
+        "carbon_intensity_g_per_kwh": intensity,
+    }
+    # record to MLflow if run_id provided
+    if mlflow and mlflow_uri:
+        mlflow.set_tracking_uri(mlflow_uri)
+        with mlflow.start_run(run_id=run_id) if run_id else mlflow.start_run():
+            mlflow.log_metric("energy_kwh", energy_kwh)
+            mlflow.log_metric("co2e_g", co2e_g)
+            mlflow.log_param("avg_power_w", avg_power_w)
+            mlflow.log_param("duration_s", duration_s)
+    # record evidence manifest
+    try:
+        record_manifest("job_emissions", payload)
+    except Exception:
+        pass
+    return payload
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--run-id", default=None)
+    p.add_argument("--duration-sec", type=float, required=True)
+    p.add_argument("--avg-power-w", type=float, required=True)
+    p.add_argument("--region", default="US-CA")
+    p.add_argument("--mlflow-uri", default=os.environ.get("MLFLOW_TRACKING_URI"))
+    args = p.parse_args()
+    res = estimate_and_log(args.run_id, args.duration_sec, args.avg_power_w, args.region, args.mlflow_uri)
+    print(json.dumps(res, indent=2))
+
