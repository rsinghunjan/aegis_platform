+#!/usr/bin/env python3
+"""
+Simple carbon-aware scheduler daemon.
+
+Behavior:
+ - Maintain a queue directory of job manifests (YAML).
+ - Periodically check grid carbon intensity using exporter/client.
+ - When intensity <= threshold, dequeue and apply job manifest via kubectl.
+
+This is intentionally simple and avoids in-cluster admission webhooks. Run as a controller pod or external daemon with kubeconfig.
+"""
+import os, time, subprocess, yaml
+from pathlib import Path
+from ops.carbon.watttime_client import get_latest_intensity
+
+QUEUE_DIR = Path(os.environ.get("CARBON_QUEUE_DIR","/var/lib/aegis/carbon_queue"))
+THRESHOLD = float(os.environ.get("Aegis_CARBON_THRESHOLD_GCO2_PER_KWH", "250.0"))
+REGION = os.environ.get("Aegis_CARBON_REGION","US-CA")
+POLL_INTERVAL = int(os.environ.get("Aegis_CARBON_SCHED_POLL", "30"))
+
+def ensure_queue():
+    QUEUE_DIR.mkdir(parents=True, exist_ok=True)
+
+def enqueue(manifest_path):
+    ensure_queue()
+    dest = QUEUE_DIR / (Path(manifest_path).name)
+    Path(manifest_path).replace(dest)
+    print("Enqueued", dest)
+
+def dequeue_and_submit(path: Path):
+    print("Submitting job", path)
+    try:
+        subprocess.check_call(["kubectl","apply","-f", str(path)])
+        path.unlink()
+        return True
+    except Exception as e:
+        print("Failed to submit:", e)
+        return False
+
+def run_loop():
+    ensure_queue()
+    while True:
+        intensity = get_latest_intensity(REGION)
+        if intensity is None:
+            print("No intensity available; skipping")
+        else:
+            print("Current intensity:", intensity, "gCO2/kWh (threshold", THRESHOLD, ")")
+            if intensity <= THRESHOLD:
+                # submit up to N jobs
+                for p in sorted(QUEUE_DIR.glob("*.yaml")):
+                    dequeue_and_submit(p)
+            else:
+                print("Intensity above threshold; deferring queued jobs")
+        time.sleep(POLL_INTERVAL)
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--queue-dir", default=str(QUEUE_DIR))
+    args = p.parse_args()
+    QUEUE_DIR = Path(args.queue_dir)
+    run_loop()
+
