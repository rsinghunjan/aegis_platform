+#!/usr/bin/env python3
+"""
+CLI helper to submit a job manifest into the carbon scheduler queue.
+Usage:
+  ./ops/carbon/cli_submit.py my_heavy_job.yaml
+"""
+import sys, shutil
+from pathlib import Path
+from ops.carbon.carbon_scheduler import enqueue, QUEUE_DIR
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("Usage: cli_submit.py <manifest.yaml>")
+        sys.exit(2)
+    src = Path(sys.argv[1])
+    if not src.exists():
+        print("Manifest not found:", src)
+        sys.exit(2)
+    ensure = QUEUE_DIR
+    ensure.mkdir(parents=True, exist_ok=True)
+    dest = ensure / src.name
+    shutil.copy2(src, dest)
+    print("Queued manifest at", dest)
+
