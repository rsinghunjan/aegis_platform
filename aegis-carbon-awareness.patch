+#!/usr/bin/env python3
+"""
+Prometheus exporter exposing current carbon intensity metric (gCO2eq per kWh).
+Exports:
+ - aegis_carbon_intensity_gco2_per_kwh{region="..."} gauge
+ - aegis_carbon_source{source="watttime|cloud|static"} info
+"""
+from prometheus_client import start_http_server, Gauge, Info
+import time, os
+from ops.carbon.watttime_client import get_latest_intensity
+from ops.carbon.cloud_carbon_client import aws_carbon_estimate, gcp_carbon_estimate
+
+INT_GAUGE = Gauge("aegis_carbon_intensity_gco2_per_kwh", "Grid carbon intensity (gCO2eq/kWh)", ["region"])
+SRC_INFO = Info("aegis_carbon_source", "Source of carbon intensity")
+
+def fetch_and_export(region="US-CA", interval=60):
+    while True:
+        val = None
+        source = "none"
+        # try WattTime
+        wt = get_latest_intensity(grid=region)
+        if wt is not None:
+            val = wt
+            source = "watttime"
+        else:
+            # try cloud APIs
+            c = aws_carbon_estimate(region) or gcp_carbon_estimate(region)
+            if c is not None:
+                val = c
+                source = "cloud"
+        # fallback to static if none available
+        if val is None:
+            val = float(os.environ.get("Aegis_CARBON_STATIC", "400.0"))
+            source = "static"
+        INT_GAUGE.labels(region=region).set(val)
+        SRC_INFO.info({"source": source})
+        time.sleep(interval)
+
+if __name__=="__main__":
+    REGION = os.environ.get("Aegis_CARBON_REGION", "US-CA")
+    PORT = int(os.environ.get("Aegis_CARBON_EXPORTER_PORT", "9810"))
+    start_http_server(PORT)
+    print("Starting carbon exporter on port", PORT, "region", REGION)
+    fetch_and_export(REGION, interval=int(os.environ.get("Aegis_CARBON_FETCH_INTERVAL", "60")))
+
