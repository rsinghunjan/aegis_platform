+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to estimate emissions for a job after completion.
+# Usage: estimate_and_log.sh --run-id <mlflow_run> --duration-sec 3600 --avg-power-w 400
+#
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --run-id) RUN_ID=$2; shift 2;;
+    --duration-sec) DURATION=$2; shift 2;;
+    --avg-power-w) POWER=$2; shift 2;;
+    --mlflow-uri) MLFLOW=$2; shift 2;;
+    *) shift;;
+  esac
+done
+
+python3 ops/carbon/job_emissions.py --run-id "${RUN_ID:-}" --duration-sec "${DURATION:-0}" --avg-power-w "${POWER:-0}" --mlflow-uri "${MLFLOW:-}"
+
