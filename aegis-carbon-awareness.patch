+#!/usr/bin/env python3
+"""
+Simple WattTime client to fetch grid carbon intensity (gCO2eq/kWh).
+Requires WATTTIME_API_KEY env var. If not present, returns None.
+"""
+import os
+import requests
+from datetime import datetime, timezone
+
+WATTTIME_BASE = "https://api.watttime.org/v2"
+
+def get_latest_intensity(grid="US-CA", api_key=None):
+    api_key = api_key or os.environ.get("WATTTIME_API_KEY")
+    if not api_key:
+        return None
+    headers = {"Authorization": f"Bearer {api_key}"}
+    # Example endpoint: /data?zone=WECC&start=...
+    # Use best-effort query to get recent point
+    try:
+        r = requests.get(f"{WATTTIME_BASE}/latest?zone={grid}", headers=headers, timeout=10)
+        r.raise_for_status()
+        j = r.json()
+        # Response may contain 'data': {'carbon_intensity': ...} or similar - best-effort parse
+        val = None
+        if "data" in j and isinstance(j["data"], dict):
+            # WattTime v2 might include 'carbon_intensity' or 'carbon' field
+            val = j["data"].get("carbon_intensity") or j["data"].get("carbon")
+        # fallback structure
+        if val is None and "carbonIntensity" in j:
+            val = j["carbonIntensity"]
+        if val is None:
+            return None
+        return float(val)
+    except Exception:
+        return None
+
+if __name__=="__main__":
+    print(get_latest_intensity())
+
