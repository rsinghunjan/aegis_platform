+#!/usr/bin/env python3
+"""
+GPU Power Exporter for Prometheus
+
+Attempts to read NVIDIA GPU power usage via pynvml. If not available, optionally falls back to
+reading a Prometheus DCGM exporter URL (configured by env var DCGM_PROM_URL).
+
+Exposes:
+ - aegis_gpu_power_watts{gpu_index}
+ - aegis_gpu_power_limit_watts{gpu_index}
+ - aegis_gpu_power_total_wh{gpu_index} (integrated over time by process)
+
+Usage:
+  python3 gpu_power_exporter.py --port 9450 --poll-interval 5
+
+Notes:
+ - This exporter is best-run on GPU nodes (DaemonSet) and scraped by Prometheus.
+ - Requires permissions to access /dev/nvidia* and NVML available.
+"""
+import os
+import time
+import argparse
+import threading
+from prometheus_client import start_http_server, Gauge, Counter
+
+USE_DCGM_FALLBACK = bool(os.environ.get("DCGM_PROM_URL"))
+DCGM_PROM_URL = os.environ.get("DCGM_PROM_URL", "http://localhost:9400/metrics")
+
+try:
+    import pynvml
+    PYNVML_AVAILABLE = True
+except Exception:
+    PYNVML_AVAILABLE = False
+
+POWER_WATTS = Gauge("aegis_gpu_power_watts", "Instantaneous GPU power draw (W)", ["gpu_index"])
+POWER_LIMIT = Gauge("aegis_gpu_power_limit_watts", "GPU power limit (W)", ["gpu_index"])
+ENERGY_WH = Counter("aegis_gpu_energy_wh_total", "Accumulated GPU energy (Wh) observed by exporter", ["gpu_index"])
+
+def read_nvml():
+    pynvml.nvmlInit()
+    device_count = pynvml.nvmlDeviceGetCount()
+    readings = []
+    for i in range(device_count):
+        h = pynvml.nvmlDeviceGetHandleByIndex(i)
+        try:
+            power = pynvml.nvmlDeviceGetPowerUsage(h) / 1000.0  # mW -> W
+        except Exception:
+            power = 0.0
+        try:
+            power_limit = pynvml.nvmlDeviceGetPowerManagementLimit(h) / 1000.0
+        except Exception:
+            power_limit = 0.0
+        readings.append((i, power, power_limit))
+    return readings
+
+def exporter_loop(poll_interval=5.0):
+    last_time = time.time()
+    last_power = {}
+    while True:
+        now = time.time()
+        elapsed = now - last_time
+        last_time = now
+        readings = []
+        if PYNVML_AVAILABLE:
+            try:
+                readings = read_nvml()
+            except Exception as e:
+                print("NVML read failed:", e)
+                readings = []
+        if not readings and USE_DCGM_FALLBACK:
+            # Basic fallback: parse DCGM Prometheus endpoint (simple pass)
+            try:
+                import requests
+                r = requests.get(DCGM_PROM_URL, timeout=3)
+                text = r.text
+                # crude parse: look for nvidia_gpu_power_draw{gpu="i"} value
+                for line in text.splitlines():
+                    if "nvidia_gpu_power_draw" in line and "gpu=" in line:
+                        # example: nvidia_gpu_power_draw{gpu="0", ...} 123.45
+                        try:
+                            parts = line.split()
+                            value = float(parts[-1])
+                            # extract gpu index
+                            idx = 0
+                            i = line.find('gpu="')
+                            if i != -1:
+                                j = line.find('"', i+5)
+                                idx = int(line[i+5:j])
+                            readings.append((idx, value, 0.0))
+                        except Exception:
+                            continue
+            except Exception as e:
+                print("DCGM fallback failed:", e)
+        # publish readings
+        for idx, power, limit in readings:
+            POWER_WATTS.labels(gpu_index=str(idx)).set(power)
+            POWER_LIMIT.labels(gpu_index=str(idx)).set(limit)
+            # accumulate Wh: power(W) * elapsed(s) / 3600 = Wh
+            ENERGY_WH.labels(gpu_index=str(idx)).inc(power * (elapsed / 3600.0))
+        time.sleep(poll_interval)
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--port", type=int, default=9450)
+    ap.add_argument("--poll-interval", type=float, default=5.0)
+    args = ap.parse_args()
+    start_http_server(args.port)
+    print("Starting GPU power exporter on port", args.port, "NVML available:", PYNVML_AVAILABLE)
+    exporter_loop(poll_interval=args.poll_interval)
+
+if __name__ == "__main__":
+    main()
+
