+#!/usr/bin/env python3
+"""
+Carbon-aware runner for Argo / batch jobs.
+
+Behavior:
+ - Query a carbon intensity API (ElectricityMap or Carbon Aware)
+ - If current intensity <= threshold, run the target command immediately
+ - Otherwise, wait/poll until intensity drops below threshold or until max_wait_s exceeded
+ - Write a small JSON file indicating scheduling decision and measured intensity
+
+Usage (as an entrypoint in an Argo job container):
+  python3 carbon_aware_runner.py --command "python train.py" --threshold 200 --max-wait 7200
+
+Notes:
+ - For production use, integrate with your cluster scheduler to prefer low-carbon regions rather than simple delay.
+ - ElectricityMap requires API key; set ELECTRICITYMAP_API_KEY env var or use CARBON_AWARE_URL for local adapter.
+"""
+import os
+import time
+import json
+import argparse
+import subprocess
+import requests
+from pathlib import Path
+
+DEFAULT_CHECK_URL = os.environ.get("CARBON_AWARE_URL", "https://api.carbonintensity.org.uk/intensity")  # placeholder
+ELECTRICITYMAP_URL = "https://api.electricitymap.org/v3/co2-intensity"  # requires key
+
+OUT_DIR = Path(os.environ.get("CARBON_RUNNER_OUT", "/tmp/carbon_runner"))
+OUT_DIR.mkdir(parents=True, exist_ok=True)
+
+def get_intensity_via_carbonaware():
+    # Tries the placeholder Carbon Intensity API (UK) then ElectricityMap if key present
+    try:
+        r = requests.get(DEFAULT_CHECK_URL, timeout=5)
+        if r.status_code == 200:
+            payload = r.json()
+            # UK carbonintensity returns data[0].intensity.forecast (gCO2/kWh)
+            if "data" in payload and isinstance(payload["data"], list):
+                val = payload["data"][0].get("intensity", {}).get("forecast", None)
+                if val is not None:
+                    return float(val)
+    except Exception:
+        pass
+    # fallback to ElectricityMap if key provided
+    key = os.environ.get("ELECTRICITYMAP_API_KEY")
+    if key:
+        try:
+            r = requests.get(ELECTRICITYMAP_URL, params={}, headers={"Authorization": f"Bearer {key}"}, timeout=5)
+            if r.status_code == 200:
+                payload = r.json()
+                # electricitymap v3 shape varies; try to find a numeric intensity value
+                if "data" in payload and "carbonIntensity" in payload["data"]:
+                    return float(payload["data"]["carbonIntensity"])
+        except Exception:
+            pass
+    return None
+
+def run_command(command):
+    t0 = time.time()
+    proc = subprocess.run(command, shell=True)
+    duration = time.time() - t0
+    return proc.returncode, duration
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--command", required=True, help="Shell command to run")
+    ap.add_argument("--threshold", type=float, default=250.0, help="gCO2/kWh threshold to allow run")
+    ap.add_argument("--poll-interval", type=int, default=300, help="Seconds between intensity polls")
+    ap.add_argument("--max-wait", type=int, default=3600, help="Max seconds to wait before running anyway")
+    args = ap.parse_args()
+
+    start_wait = time.time()
+    measured = None
+    while True:
+        intensity = get_intensity_via_carbonaware()
+        measured = intensity
+        now = time.time()
+        waited = now - start_wait
+        if intensity is not None and intensity <= args.threshold:
+            decision = "run_now"
+            rc, duration = run_command(args.command)
+            break
+        if waited >= args.max_wait:
+            decision = "run_after_wait"
+            rc, duration = run_command(args.command)
+            break
+        # else wait
+        time.sleep(args.poll_interval)
+
+    out = {
+        "decision": decision,
+        "measured_intensity_gco2_per_kwh": measured,
+        "threshold": args.threshold,
+        "waited_s": waited,
+        "exit_code": rc,
+        "duration_s": duration
+    }
+    outpath = OUT_DIR / f"carbon_schedule_{int(time.time())}.json"
+    with open(outpath, "w") as fh:
+        json.dump(out, fh, indent=2)
+    print("Wrote scheduling decision to", outpath)
+    raise SystemExit(rc)
+
+if __name__ == "__main__":
+    main()
+
