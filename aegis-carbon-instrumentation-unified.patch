+#!/usr/bin/env python3
+"""
+CodeCarbon + MLflow wrapper for training and inference jobs.
+
+Usage:
+  python3 codecarbon_wrapper.py --mode train --entrypoint "python train.py --epochs 10" \
+      --project myproject --run-name run1 --out-dir /tmp/carbon
+
+This script:
+ - Runs a subprocess (training or inference) while measuring emissions via CodeCarbon
+ - Emits job-level kWh and estimated CO2e to stdout and (optionally) to MLflow
+ - Writes a small JSON evidence file with energy & CO2 metadata for the run
+ - Returns subprocess exit code
+
+Notes:
+ - Requires CodeCarbon installed (see requirements.txt)
+ - For accurate GPU power telemetry use the gpu_power_exporter (pynvml) or DCGM exporter; CodeCarbon otherwise uses CPU/GPU heuristics.
+"""
+import os
+import json
+import time
+import shlex
+import subprocess
+import argparse
+from pathlib import Path
+
+try:
+    from codecarbon import EmissionsTracker
+except Exception:
+    EmissionsTracker = None
+
+try:
+    import mlflow
+except Exception:
+    mlflow = None
+
+OUT_DIR_DEFAULT = Path(os.environ.get("CARBON_OUT_DIR", "/tmp/aegis_carbon"))
+OUT_DIR_DEFAULT.mkdir(parents=True, exist_ok=True)
+
+
+def run_and_track(command: str, project: str = "aegis", run_name: str = None, mlflow_uri: str = None):
+    run_id = f"{int(time.time())}"
+    # configure CodeCarbon tracker
+    if EmissionsTracker is None:
+        print("Warning: codecarbon not installed; skipping emissions tracking.")
+        start_time = time.time()
+        proc = subprocess.run(shlex.split(command))
+        duration = time.time() - start_time
+        metadata = {"duration_s": duration, "energy_kwh": None, "co2_kg": None, "exit_code": proc.returncode}
+        out = OUT_DIR_DEFAULT / f"carbon_{run_id}.json"
+        with open(out, "w") as fh:
+            json.dump(metadata, fh, indent=2)
+        return proc.returncode
+
+    tracker = EmissionsTracker(project_name=project, save_to_file=False)
+    tracker.start()
+    start = time.time()
+    proc = subprocess.run(shlex.split(command))
+    duration = time.time() - start
+    emissions = tracker.stop()  # returns grams CO2
+    co2_kg = emissions / 1000.0 if emissions is not None else None
+
+    # CodeCarbon does not directly return energy kWh, approximate if possible (some backends may provide)
+    # We prefer to read GPU energy via gpu_power_exporter external metric; here we store what CodeCarbon provides.
+    metadata = {
+        "project": project,
+        "run_name": run_name,
+        "command": command,
+        "duration_s": duration,
+        "co2_kg": co2_kg,
+        "exit_code": proc.returncode,
+        "timestamp": int(time.time())
+    }
+    out = OUT_DIR_DEFAULT / f"carbon_{run_id}.json"
+    with open(out, "w") as fh:
+        json.dump(metadata, fh, indent=2)
+
+    # optionally log to MLflow
+    if mlflow is not None and mlflow_uri:
+        try:
+            mlflow.set_tracking_uri(mlflow_uri)
+            with mlflow.start_run(run_name=run_name or run_id):
+                if metadata["co2_kg"] is not None:
+                    mlflow.log_metric("co2_kg", metadata["co2_kg"])
+                mlflow.log_metric("duration_s", metadata["duration_s"])
+                mlflow.log_artifact(str(out), artifact_path="carbon")
+        except Exception as e:
+            print("MLflow logging failed:", e)
+
+    print("Carbon metadata written to", out)
+    return proc.returncode
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--mode", choices=["train", "infer"], default="train")
+    ap.add_argument("--entrypoint", required=True, help="Subprocess command to run")
+    ap.add_argument("--project", default="aegis")
+    ap.add_argument("--run-name", default=None)
+    ap.add_argument("--mlflow-uri", default=os.environ.get("MLFLOW_TRACKING_URI", ""))
+    args = ap.parse_args()
+    rc = run_and_track(args.entrypoint, project=args.project, run_name=args.run_name, mlflow_uri=args.mlflow_uri or None)
+    raise SystemExit(rc)
+
+
+if __name__ == "__main__":
+    main()
+
