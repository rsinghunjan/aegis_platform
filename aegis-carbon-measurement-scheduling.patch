+#!/usr/bin/env bash
+#
+# CI check to ensure heavy training jobs include carbon metadata and use job_wrapper or meter.
+# Fails if newly added training job workflows don't reference job_wrapper or job_energy_meter.
+#
+set -euo pipefail
+FILES=$(git diff --name-only origin/main... | grep -E '\.py$|\.sh$' || true)
+if [ -z "$FILES" ]; then
+  echo "No changed files"
+  exit 0
+fi
+bad=0
+for f in $FILES; do
+  if grep -qE "train|pytorch|multimodal" "$f" 2>/dev/null; then
+    if ! grep -q "job_energy_meter" "$f" 2>/dev/null && ! grep -q "job_wrapper.sh" "$f" 2>/dev/null; then
+      echo "File $f appears to run training but does not use job_energy_meter or job_wrapper.sh"
+      bad=1
+    fi
+  fi
+done
+if [ "$bad" -eq 1 ]; then
+  echo "Failing CI for missing carbon instrumentation"
+  exit 2
+fi
+echo "Carbon instrumentation checks passed"
+
