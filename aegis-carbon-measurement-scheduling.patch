+#!/usr/bin/env python3
+"""
+Simple CO2Signal client used to fetch current and forecast grid intensity (gCO2/kWh).
+Falls back to cached value in /tmp/co2_cached.json when offline.
+"""
+import os
+import requests
+import json
+import time
+from pathlib import Path
+
+API_KEY = os.environ.get("CO2SIGNAL_API_KEY", "")
+CACHE = Path("/tmp/co2_cached.json")
+BASE = "https://api.co2signal.com/v1"
+
+def _headers():
+    return {"auth-token": API_KEY} if API_KEY else {}
+
+def fetch_current(region_code):
+    """
+    region_code example: "US" or cloud region like "us-east-1" (we try region then country fallback)
+    Returns dict: {"intensity": gCO2_per_kWh, "ts": epoch}
+    """
+    if not API_KEY:
+        # no key — try cache
+        if CACHE.exists():
+            return json.loads(CACHE.read_text())
+        raise RuntimeError("CO2SIGNAL_API_KEY unset and no cache present")
+    # Try country lookup first (2-letter)
+    country = region_code.split("-")[0].upper()
+    try:
+        r = requests.get(f"{BASE}/latest?countryCode={country}", headers=_headers(), timeout=10)
+        r.raise_for_status()
+        j = r.json()
+        intensity = j.get("data", {}).get("carbonIntensity")
+        out = {"intensity": float(intensity), "ts": int(time.time()), "raw": j}
+        CACHE.write_text(json.dumps(out))
+        return out
+    except Exception:
+        # fallback to cache
+        if CACHE.exists():
+            return json.loads(CACHE.read_text())
+        raise
+
+def fetch_forecast(region_code):
+    """Attempt to fetch hourly forecast for next 24h. Returns list of {ts, intensity} entries."""
+    if not API_KEY:
+        return []
+    country = region_code.split("-")[0].upper()
+    try:
+        r = requests.get(f"{BASE}/forecast?countryCode={country}", headers=_headers(), timeout=10)
+        r.raise_for_status()
+        j = r.json()
+        hours = j.get("data", {}).get("forecast", [])
+        # normalize to list of {ts, intensity}
+        out = []
+        for h in hours:
+            out.append({"ts": h.get("datetime"), "intensity": h.get("intensity")})
+        return out
+    except Exception:
+        return []
+
+if __name__ == "__main__":
+    import sys
+    r = sys.argv[1] if len(sys.argv) > 1 else "US"
+    print(fetch_current(r))
+
