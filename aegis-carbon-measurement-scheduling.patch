+#!/usr/bin/env python3
+"""
+Minimal exporter that reads latest job energy manifests and writes Prometheus textfile entries
+for node_exporter textfile collector. Intended to be run as a cron job or sidecar.
+"""
+import glob
+import json
+from pathlib import Path
+import time
+import os
+
+PENDING_DIR = os.environ.get("EVIDENCE_DIR", "/tmp")
+PROM_DIR = os.environ.get("PROM_TEXTFILE_DIR", "/var/lib/node_exporter/textfile_collector")
+OUT = Path(PROM_DIR)
+OUT.mkdir(parents=True, exist_ok=True)
+
+def main():
+    manifests = list(glob.glob(str(Path(PENDING_DIR) / "job_energy_*.json")))
+    total_co2 = 0.0
+    total_kwh = 0.0
+    for m in manifests:
+        try:
+            j = json.load(open(m))
+            total_co2 += float(j.get("kgco2", 0.0))
+            total_kwh += float(j.get("kwh", 0.0))
+        except Exception:
+            continue
+    # write metrics
+    try:
+        with open(OUT / "aegis_carbon_metrics.prom", "w") as fh:
+            fh.write(f'aegis_total_co2_kg {total_co2}\n')
+            fh.write(f'aegis_total_energy_kwh {total_kwh}\n')
+            fh.write(f'aegis_jobs_count {len(manifests)}\n')
+    except Exception:
+        pass
+
+if __name__=="__main__":
+    main()
+
