+package aegis.carbon
+
+# Simple policy to decide scheduling preference given cost vs carbon tradeoff.
+# Input:
+# {
+#   "preference": "carbon"|"cost"|"balanced",
+#   "estimates": { "region": {"cost": <float>, "carbon": <float>} ...}
+# }
+
+default allow_region = false
+
+allow_region[region] {
+  pref := input.preference
+  estimates := input.estimates
+  region := input.region
+  pref == "carbon"
+  # choose min carbon region
+  min_region := min([r | r := region; _ := estimates[r]])
+  region == min_region
+}
+
+min(arr) = m {
+  m := arr[0]
+  not smaller(m, arr)
+}
+
+smaller(x, arr) {
+  some r
+  arr[r] < x
+}
