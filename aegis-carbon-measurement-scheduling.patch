+#!/usr/bin/env bash
+#
+# Wrapper to schedule and run a training job with CO2-aware scheduling, energy metering and evidence recording.
+#
+set -euo pipefail
+CMD="${1:-}"
+REGION="${AEGIS_REGION:-us-east-1}"
+DURATION_MIN="${2:-120}"
+PREFERENCE="${3:-carbon}"  # carbon | cost | balanced
+
+if [ -z "$CMD" ]; then
+  echo "Usage: job_wrapper.sh '<cmd>' [duration_min] [preference]" >&2
+  exit 2
+fi
+
+echo "Querying best start window..."
+WIN=$(python3 ops/carbon/job_scheduler.py --region "$REGION" --duration-min "$DURATION_MIN" --preference "$PREFERENCE" --lookahead-hours 24)
+echo "$WIN"
+BEST_START=$(echo "$WIN" | python3 -c "import sys,json;print(json.load(sys.stdin)['best_start_iso'])")
+BEST_EPOCH=$(python3 - <<PY
+from dateutil import parser
+import sys
+print(int(parser.parse("$BEST_START").timestamp()))
+PY
+)
+NOW=$(date +%s)
+if [ "$BEST_EPOCH" -gt "$NOW" ]; then
+  DELAY=$((BEST_EPOCH - NOW))
+  echo "Delaying job for $DELAY seconds until $BEST_START (best carbon window)"
+  sleep "$DELAY"
+else
+  echo "Starting immediately (best window is in the past or immediate)"
+fi
+
+OUT="/tmp/job_energy_$(date +%s).json"
+echo "Running meter wrapper for command: $CMD"
+python3 ops/carbon/job_energy_meter.py --region "$REGION" --out "$OUT" --cmd "$CMD"
+echo "Job finished; manifest at $OUT"
+exit 0
+
