+#!/usr/bin/env python3
+"""
+CO2-aware job scheduler helper.
+
+Given an estimated job energy need (kWh) or simple estimate (weight), picks the best start window in the next 24h
+based on CO2Signal forecasts, PUE config and optional cost vs carbon tradeoff.
+
+Usage:
+  python3 ops/carbon/job_scheduler.py --region us-east-1 --duration-min 120 --preference carbon --lookahead-hours 24
+
+Outputs a recommended start timestamp (epoch) and summary JSON.
+"""
+import argparse
+import time
+from datetime import datetime, timedelta
+from ops.carbon.co2_client import fetch_forecast, fetch_current
+from pathlib import Path
+import json
+import os
+
+def score_window(forecast_entries, start_ts, end_ts, pue=1.25, cost_multiplier=1.0):
+    # forecast_entries: list of {"ts", "intensity"} where ts may be ISO or epoch; normalize to epoch if needed
+    # compute average intensity in window and return score = intensity * pue * cost_multiplier
+    vals = []
+    for e in forecast_entries:
+        it = e.get("intensity")
+        vals.append(float(it) if it is not None else 0.0)
+    if not vals:
+        return float("inf")
+    avg_intensity = sum(vals) / len(vals)
+    return avg_intensity * pue * cost_multiplier
+
+def window_entries_for_hourly_forecast(forecast, start_dt, end_dt):
+    # forecast is list of dicts - best-effort: return entries within window
+    out = []
+    for e in forecast:
+        ts = e.get("ts")
+        # try to parse a numeric ts, or ISO string
+        try:
+            tval = int(ts)
+        except Exception:
+            try:
+                from dateutil import parser
+                tval = int(parser.parse(ts).timestamp())
+            except Exception:
+                continue
+        if start_dt.timestamp() <= tval < end_dt.timestamp():
+            out.append({"ts": tval, "intensity": float(e.get("intensity", 0.0))})
+    return out
+
+def pick_best_window(region, duration_min=60, lookahead_hours=24, preference="carbon", cost_multiplier=1.0):
+    # fetch forecast (hourly)
+    forecast = fetch_forecast(region)
+    now = datetime.utcnow()
+    best = None
+    best_score = None
+    pue_cfg = None
+    # load pue
+    try:
+        import yaml
+        cfg = yaml.safe_load(Path(os.environ.get("PUE_CONFIG_PATH","ops/carbon/pue_config.yaml")).read_text())
+        pue_cfg = cfg.get("regions", {}).get(region, cfg.get("default", {}))
+    except Exception:
+        pue_cfg = {"pue": 1.25}
+    pue = float(pue_cfg.get("pue", 1.25))
+    for hour_offset in range(0, lookahead_hours):
+        start_dt = now + timedelta(hours=hour_offset)
+        end_dt = start_dt + timedelta(minutes=duration_min)
+        entries = window_entries_for_hourly_forecast(forecast, start_dt, end_dt)
+        score = score_window(entries, start_dt.timestamp(), end_dt.timestamp(), pue=pue, cost_multiplier=cost_multiplier)
+        if best is None or score < best_score:
+            best = (start_dt, end_dt, entries)
+            best_score = score
+    return {
+        "region": region,
+        "best_start_iso": best[0].isoformat(),
+        "best_end_iso": best[1].isoformat(),
+        "score": best_score,
+        "pue": pue,
+    }
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--region", default=os.environ.get("AEGIS_REGION","us-east-1"))
+    p.add_argument("--duration-min", type=int, default=60)
+    p.add_argument("--lookahead-hours", type=int, default=24)
+    p.add_argument("--preference", choices=["carbon","cost","balanced"], default="carbon")
+    p.add_argument("--cost-mult", type=float, default=1.0)
+    args = p.parse_args()
+    res = pick_best_window(args.region, duration_min=args.duration_min, lookahead_hours=args.lookahead_hours, preference=args.preference, cost_multiplier=args.cost_mult)
+    print(json.dumps(res, indent=2))
+
+if __name__=="__main__":
+    main()
+
