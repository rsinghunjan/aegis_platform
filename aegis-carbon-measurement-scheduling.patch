+#!/usr/bin/env python3
+"""
+Job energy meter and CO2 calculator.
+
+Usage:
+  # Example as a wrapper:
+  python3 ops/carbon/job_energy_meter.py --out /tmp/job_energy.json --region us-east-1 --cmd "python train.py"
+
+Features:
+ - Samples GPU power via nvidia-smi periodically (default 1s sample).
+ - Falls back to estimator by device TDP * utilization when nvidia-smi not available.
+ - Computes kWh, converts to kgCO2 using CO2Signal current intensity and PUE from pue_config.yaml.
+ - Writes a job evidence file and (if available) calls safety_monitor.record_manifest to persist evidence.
+ - Optionally writes Prometheus textfile for node_exporter textfile collector.
+"""
+import argparse
+import os
+import time
+import json
+import subprocess
+from pathlib import Path
+from threading import Thread, Event
+
+SAMPLE_INTERVAL = float(os.environ.get("AEGIS_ENERGY_SAMPLE_INTERVAL", "1.0"))
+PROM_TEXTFILE_DIR = os.environ.get("PROM_TEXTFILE_DIR", "/var/lib/node_exporter/textfile_collector")
+PUE_CONFIG = os.environ.get("PUE_CONFIG_PATH", "ops/carbon/pue_config.yaml")
+
+def has_nvidia_smi():
+    from shutil import which
+    return which("nvidia-smi") is not None
+
+def sample_gpu_power(stop_event, out_samples):
+    # sample nvidia-smi power.draw values (watts)
+    while not stop_event.is_set():
+        try:
+            proc = subprocess.run(["nvidia-smi","--query-gpu=power.draw,utilization.gpu","--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=2)
+            lines = [l.strip() for l in proc.stdout.splitlines() if l.strip()]
+            for l in lines:
+                # "120.56 W, 52 %"
+                parts = [p.strip() for p in l.split(",")]
+                try:
+                    p_w = float(parts[0])
+                except Exception:
+                    p_w = 0.0
+                out_samples.append({"ts": time.time(), "power_w": p_w})
+        except Exception:
+            # can't sample — append zero and continue
+            out_samples.append({"ts": time.time(), "power_w": 0.0})
+        time.sleep(SAMPLE_INTERVAL)
+
+def estimate_from_utilization(util_percent, tdp_w):
+    return (util_percent/100.0) * tdp_w
+
+def load_pue_config():
+    try:
+        import yaml
+        cfg = yaml.safe_load(Path(PUE_CONFIG).read_text())
+        return cfg
+    except Exception:
+        return {"default": {"pue": 1.25}}
+
+def compute_kwh(samples):
+    if not samples:
+        return 0.0
+    # compute trapezoidal integration over samples (assume regular sampling interval)
+    total_w_seconds = 0.0
+    for i in range(1, len(samples)):
+        dt = samples[i]["ts"] - samples[i-1]["ts"]
+        avg_w = (samples[i]["power_w"] + samples[i-1]["power_w"]) / 2.0
+        total_w_seconds += avg_w * dt
+    kwh = total_w_seconds / 3600.0 / 1000.0 * 1000.0  # power already in watts; divide by 3600 to get Wh, then /1000 to kWh
+    # Note: above double division fixed: use Wh = W * s / 3600, then kWh = Wh / 1000
+    # correct approach:
+    # total_w_seconds (W*s) -> Wh = total_w_seconds/3600 ; kWh = Wh/1000 = total_w_seconds / 3600 / 1000
+    # implement as:
+    kwh = total_w_seconds / 3600.0 / 1000.0
+    return kwh
+
+def write_prom_text(metric_name, value, labels=None):
+    try:
+        if labels:
+            lbl = "{" + ",".join([f'{k}="{v}"' for k,v in labels.items()]) + "}"
+        else:
+            lbl = ""
+        out = f"{metric_name}{lbl} {value}\n"
+        Path(PROM_TEXTFILE_DIR).mkdir(parents=True, exist_ok=True)
+        path = Path(PROM_TEXTFILE_DIR) / f"aegis_{metric_name}.prom"
+        path.write_text(out)
+    except Exception:
+        pass
+
+def record_manifest_safe(manifest):
+    # best-effort: try to call safety_monitor.record_manifest
+    try:
+        from ops.autonomy.safety_monitor import record_manifest
+        return record_manifest(manifest.get("action","job_energy"), manifest)
+    except Exception:
+        # write local file
+        p = Path("/tmp") / f"job_energy_{int(time.time())}.json"
+        p.write_text(json.dumps(manifest))
+        return str(p)
+
+def run_and_measure(cmd, region, out_path):
+    samples = []
+    stop_event = Event()
+    thread = None
+    if has_nvidia_smi():
+        thread = Thread(target=sample_gpu_power, args=(stop_event, samples))
+        thread.start()
+    start_ts = time.time()
+    # run command
+    proc = subprocess.Popen(cmd, shell=True)
+    rc = proc.wait()
+    end_ts = time.time()
+    # stop sampler
+    if thread:
+        stop_event.set()
+        thread.join(timeout=5)
+    # compute kWh
+    kwh = compute_kwh(samples)
+    # get grid intensity and PUE
+    from ops.carbon.co2_client import fetch_current
+    cfg = load_pue_config()
+    region_key = region
+    pue = cfg.get("regions", {}).get(region_key, cfg.get("default", {})).get("pue", cfg.get("default", {}).get("pue", 1.25))
+    try:
+        cur = fetch_current(region_key)
+        intensity = float(cur.get("intensity", 0.0))
+    except Exception:
+        intensity = 0.0
+    kgco2 = kwh * (intensity/1000.0) * pue
+    manifest = {
+        "action": "job_energy",
+        "cmd": cmd,
+        "start_ts": start_ts,
+        "end_ts": end_ts,
+        "duration_s": end_ts - start_ts,
+        "kwh": kwh,
+        "grid_intensity_g_per_kwh": intensity,
+        "pue": pue,
+        "kgco2": kgco2,
+        "samples_count": len(samples),
+    }
+    # persist manifest locally & via safety_monitor
+    mpath = record_manifest_safe(manifest)
+    # write a short summary for prometheus
+    write_prom_text("job_energy_wh_total", kwh*1000.0, labels={"cmd": os.path.basename(cmd.split()[0])})
+    write_prom_text("job_co2_kg_total", kgco2, labels={"cmd": os.path.basename(cmd.split()[0])})
+    # write out to file if requested
+    if out_path:
+        Path(out_path).write_text(json.dumps(manifest, indent=2))
+    return rc, manifest, mpath
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", default="", help="Path to write manifest JSON")
+    p.add_argument("--region", default=os.environ.get("AEGIS_REGION","us-east-1"))
+    p.add_argument("--cmd", required=True, help="Command to run (in quotes)")
+    args = p.parse_args()
+    rc, manifest, mpath = run_and_measure(args.cmd, args.region, args.out)
+    print("Return code:", rc)
+    print("Manifest:", mpath)
+    if rc != 0:
+        raise SystemExit(rc)
+
+if __name__ == "__main__":
+    import argparse
+    main()
+
