+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click demo: submit a small training job (dummy), wait, compute carbon, create audit bundle, sign & upload
+#
+: "${CLUSTER_CONTEXT:?Set CLUSTER_CONTEXT}"
+: "${REGISTRY:?Set REGISTRY (for example registry path)}"
+: "${COSIGN_KMS_URI:?Set COSIGN_KMS_URI}"
+: "${S3_UPLOAD:?Set S3_UPLOAD}"
+: "${REDIS_URL:?Set REDIS_URL}"
+
+kubectl config use-context "$CLUSTER_CONTEXT"
+
+OUTDIR="${OUTDIR:-/tmp/aegis_carbon_demo_$(date +%s)}"
+mkdir -p "$OUTDIR"
+
+echo "[1] Submit dummy training job (sleep) in aegis-app namespace"
+cat <<'YAML' > "$OUTDIR/dummy_job.yaml"
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: aegis-dummy-train
+  namespace: aegis-app
+spec:
+  template:
+    metadata:
+      annotations:
+        aegis/expected_duration_hours: "0.01"
+        aegis/region: "us-west-2"
+        aegis/instance_type: "p4d.24xlarge"
+    spec:
+      containers:
+        - name: sleeper
+          image: busybox
+          command: ["sh","-c","sleep 30"]
+          resources:
+            limits:
+              nvidia.com/gpu: "1"
+      restartPolicy: Never
+  backoffLimit: 0
+YAML
+
+kubectl apply -f "$OUTDIR/dummy_job.yaml"
+
+echo "[2] Wait for completion and collect job timestamps"
+JOB_NAME="aegis-dummy-train"
+kubectl wait --for=condition=complete --timeout=120s job/"$JOB_NAME" -n aegis-app || true
+start_ts=$(kubectl get job "$JOB_NAME" -n aegis-app -o jsonpath='{.status.startTime}')
+completion_ts=$(kubectl get job "$JOB_NAME" -n aegis-app -o jsonpath='{.status.completionTime}')
+echo "start=$start_ts completion=$completion_ts"
+
+# convert ISO timestamps to epoch seconds
+start_epoch=$(date -d "$start_ts" +%s)
+end_epoch=$(date -d "$completion_ts" +%s)
+
+echo "[3] Run job carbon exporter"
+JOB_ID="demo_${RANDOM}"
+JOB_REGION="us-west-2"
+JOB_INSTANCE="p4d.24xlarge"
+JOB_GPU_HOURS=0.01
+python3 ops/carbon/exporter/job_carbon_exporter.py --job-id "$JOB_ID" --start "$start_epoch" --end "$end_epoch" --region "$JOB_REGION" --instance-type "$JOB_INSTANCE" --gpu-hours "$JOB_GPU_HOURS" --pushgateway "http://pushgateway.aegis.svc:9091" --out "$OUTDIR/carbon_${JOB_ID}.json"
+
+echo "[4] Create carbon auditor bundle and sign"
+python3 ops/carbon/audit/carbon_audit_packager.py --artifacts "$OUTDIR/carbon_${JOB_ID}.json" --out "$OUTDIR/carbon_audit_${JOB_ID}.tar.gz" --cosign-key "$COSIGN_KMS_URI" --s3 "$S3_UPLOAD"
+
+echo "[5] Verify cosign signature (local)"
+if command -v cosign >/dev/null 2>&1; then
+  cosign verify --key "$COSIGN_KMS_URI" "$OUTDIR/carbon_audit_${JOB_ID}.tar.gz" || echo "cosign verify failed"
+else
+  echo "cosign not installed locally to verify"
+fi
+
+echo "One-click carbon flow complete. Artifacts:"
+ls -l "$OUTDIR"
+
