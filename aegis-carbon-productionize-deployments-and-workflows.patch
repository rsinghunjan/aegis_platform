+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Deploy minimal carbon stack: Redis (if absent), webhook and RBAC. Requires helm and kubectl configured.
+:
+  "${CLUSTER_CONTEXT:?Set CLUSTER_CONTEXT (kubectl context)}"
+kubectl config use-context "$CLUSTER_CONTEXT"
+
+echo "Ensure aegis-app namespace exists"
+kubectl create ns aegis-app || true
+
+echo "Install Redis (if not present)"
+if ! kubectl get svc aegis-redis-headless -n aegis-app >/dev/null 2>&1; then
+  helm repo add bitnami https://charts.bitnami.com/bitnami || true
+  helm upgrade --install aegis-redis bitnami/redis --namespace aegis-app --set auth.enabled=false
+else
+  echo "Redis appears installed"
+fi
+
+echo "Apply RBAC for exporter"
+kubectl apply -f ops/carbon/k8s/carbon-exporter-rbac.yaml
+
+echo "Deploy carbon exporter job template and webhook manifests"
+kubectl apply -f ops/carbon/k8s/carbon-exporter-job-template.yaml
+kubectl apply -f ops/carbon/k8s/carbon-webhook-rbac.yaml
+kubectl apply -f ops/carbon/k8s/carbon-webhook-deployment.yaml
+kubectl apply -f ops/carbon/k8s/carbon-webhook-service.yaml
+
+echo "Stack deployed. NOTE: webhook requires valid TLS secret for admission in production and k8s admission registration."
+echo "Create Kubernetes Mutating/ValidatingWebhookConfiguration referencing the service aegis-carbon-webhook.aegis-app.svc (not auto-created here)."
+
