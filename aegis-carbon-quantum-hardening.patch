+#!/usr/bin/env python3
+"""
+Energy accountant: compute per-job GPU energy (kWh) by querying Prometheus/DCGM metrics.
+
+Usage (example):
+  python ops/monitoring/energy_accountant.py --start 1610000000 --end 1610000600 --pod my-pod
+
+Important:
+ - Prometheus must scrape DCGM exporter and expose a power metric such as:
+     dcgm_gpu_power_draw_watts or nvidia_gpu_power_draw_watts or dcgm_gpu_power
+ - Prefer querying by pod label when available; otherwise query by node/gpu index.
+ - This is a best-effort implementation. For accurate accounting prefer host-level power telemetry or per-job GPU allocation tracking.
+"""
+import os
+import time
+import requests
+from urllib.parse import urljoin
+import argparse
+
+PROM_URL = os.environ.get("PROMETHEUS_URL", "http://prometheus.monitoring.svc:9090")
+# Candidate metric names to try (common DCGM exporter / community exporters)
+POWER_METRICS = [
+    "dcgm_gpu_power_draw_watts",
+    "nvidia_gpu_power_draw_watts",
+    "dcgm_gpu_power"
+]
+
+def _prom_range_query(query, start_ts, end_ts, step_s=10):
+    url = urljoin(PROM_URL, "/api/v1/query_range")
+    params = {"query": query, "start": str(start_ts), "end": str(end_ts), "step": f"{step_s}s"}
+    r = requests.get(url, params=params, timeout=30)
+    r.raise_for_status()
+    j = r.json()
+    return j.get("data", {}).get("result", [])
+
+def compute_energy_kwh(start_ts, end_ts, pod_name=None, node_name=None, gpu_index=None, step_s=10):
+    """
+    Compute energy in kWh by integrating power (watts) over time window [start_ts, end_ts].
+    Filters:
+      - If pod_name provided, tries to filter metrics with pod label
+      - Else if node_name/gpu_index provided, tries to filter by node and minor_number/gpu
+    Returns total_kwh (float) or None if no metric samples found.
+    """
+    total_wh = 0.0
+    any_samples = False
+    for metric in POWER_METRICS:
+        # build filter
+        label_selector = ""
+        if pod_name:
+            label_selector = f'{{pod="{pod_name}"}}'
+        elif node_name and gpu_index is not None:
+            # some exporters use 'device' or 'minor_number' or 'index' labels; try common ones
+            label_selector = f'{{node="{node_name}", minor_number="{gpu_index}"}}'
+        elif node_name:
+            label_selector = f'{{node="{node_name}"}}'
+        query = f"{metric}{label_selector}"
+        try:
+            results = _prom_range_query(query, start_ts, end_ts, step_s=step_s)
+        except Exception:
+            results = []
+        for series in results:
+            # series['values'] is list of [timestamp, value]
+            vals = series.get("values", [])
+            if not vals:
+                continue
+            any_samples = True
+            # integrate using rectangle rule: sum(value * dt)
+            prev_t = None
+            for t_str, v_str in vals:
+                t = float(t_str)
+                try:
+                    v = float(v_str)
+                except Exception:
+                    v = 0.0
+                if prev_t is not None:
+                    dt = t - prev_t
+                    total_wh += v * dt / 3600.0 * 1000.0  # v in Watts * dt seconds -> Wh (note: *1000 if v was kW; keep careful)
+                prev_t = t
+    if not any_samples:
+        return None
+    # total_wh is in (W*s)/3600 -> Wh; convert to kWh
+    total_kwh = total_wh / 1000.0
+    return total_kwh
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--start", required=True, type=float, help="start timestamp (epoch seconds)")
+    p.add_argument("--end", required=True, type=float, help="end timestamp (epoch seconds)")
+    p.add_argument("--pod", default=None)
+    p.add_argument("--node", default=None)
+    p.add_argument("--gpu-index", type=int, default=None)
+    p.add_argument("--step", type=int, default=10)
+    args = p.parse_args()
+    kwh = compute_energy_kwh(args.start, args.end, pod_name=args.pod, node_name=args.node, gpu_index=args.gpu_index, step_s=args.step)
+    print({"start": args.start, "end": args.end, "kwh": kwh})
+
+if __name__ == "__main__":
+    main()
+
