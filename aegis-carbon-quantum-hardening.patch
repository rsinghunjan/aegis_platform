+#!/usr/bin/env python3
+"""
+Carbon intensity lookup helper.
+ - Primary implementation: call configured CARBON_API_URL (e.g., ElectricityMap or provider API)
+ - Fallback: use static default intensity (gCO2e/kWh)
+
+Environment:
+ - CARBON_API_URL (optional) - e.g., https://api.electricitymap.org/v3/co2-intensity
+ - CARBON_API_KEY (optional) - API key / token header
+ - CARBON_DEFAULT_GCO2_PER_KWH (optional) - fallback numeric (default 400 gCO2e/kWh)
+"""
+import os
+import time
+import requests
+
+CARBON_API_URL = os.environ.get("CARBON_API_URL", "")
+CARBON_API_KEY = os.environ.get("CARBON_API_KEY", "")
+DEFAULT_G_PER_KWH = float(os.environ.get("CARBON_DEFAULT_GCO2_PER_KWH", "400"))
+
+def lookup_co2_intensity(region: str = None, at_timestamp: float = None) -> float:
+    """
+    Return gCO2e per kWh for given region and timestamp.
+    If API not configured or lookup fails, return DEFAULT_G_PER_KWH.
+    """
+    if not CARBON_API_URL:
+        return DEFAULT_G_PER_KWH
+    params = {}
+    if region:
+        params["zone"] = region
+    if at_timestamp:
+        params["datetime"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(at_timestamp))
+    headers = {}
+    if CARBON_API_KEY:
+        headers["auth-token"] = CARBON_API_KEY
+    try:
+        r = requests.get(CARBON_API_URL, params=params, headers=headers, timeout=10)
+        r.raise_for_status()
+        j = r.json()
+        # adapt to common ElectricityMap response: { data: { carbonIntensity: {forecast...} } } or { carbonIntensity: 123 }
+        if isinstance(j, dict):
+            # try common shapes
+            if "carbonIntensity" in j:
+                return float(j["carbonIntensity"])
+            if "data" in j and isinstance(j["data"], dict) and "carbonIntensity" in j["data"]:
+                return float(j["data"]["carbonIntensity"])
+            # electricitymap: j['data']['carbonIntensity'] or j['data'] may contain 'gCO2'
+        # fallback
+        return DEFAULT_G_PER_KWH
+    except Exception:
+        return DEFAULT_G_PER_KWH
+
