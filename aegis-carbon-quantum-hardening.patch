+#!/usr/bin/env python3
+"""
+Billing uploader v2
+ - Accepts billing records including energy_kwh and (optionally) co2e_kg
+ - If co2e_kg missing, will call carbon_lookup to compute and attach it
+ - Sends to finance webhook via finance_connector.send_charge and persists locally if unavailable
+"""
+import os
+import json
+from services.telemetry import carbon_lookup
+from services.telemetry.finance_connector import send_charge
+
+def prepare_and_send_charge(record: dict):
+    """
+    record should contain:
+      - id, tenant, cost_usd, energy_kwh (optional), co2e_kg (optional), metadata
+    """
+    rec = dict(record)
+    energy = rec.get("energy_kwh")
+    if energy is None:
+        # cannot compute energy here; caller should provide energy per-job
+        rec["energy_kwh"] = None
+    if rec.get("co2e_kg") is None and rec.get("energy_kwh"):
+        # compute carbon
+        intensity_g = carbon_lookup.lookup_co2_intensity(region=rec.get("region"))
+        rec["co2e_kg"] = rec["energy_kwh"] * (intensity_g / 1000.0)
+    # attach timestamp
+    rec.setdefault("ts", int(__import__("time").time()))
+    ok = send_charge(rec)
+    return ok
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--record", help="json string of billing record")
+    args = p.parse_args()
+    r = json.loads(args.record)
+    print("send result:", prepare_and_send_charge(r))
+
