+#!/usr/bin/env python3
+"""
+Worker instrumentation helpers to start/stop per-job energy metering and attach results to evidence.
+ - Lightweight file-backed meter is used for portability in PoC; recommend replacing with Redis or durable store.
+ - Usage:
+     start_meter(job_id, pod_name)
+     ... run job ...
+     stop_meter(job_id, pod_name) -> returns { energy_kwh, co2e_kg }
+"""
+import os
+import json
+import time
+from pathlib import Path
+from ops.monitoring.energy_accountant import compute_energy_kwh
+from services.telemetry import carbon_lookup
+from ops.telemetry import billing_uploader_v2
+
+METER_DIR = os.environ.get("JOB_METER_DIR", "/tmp/aegis_job_meters")
+Path(METER_DIR).mkdir(parents=True, exist_ok=True)
+
+def start_meter(job_id: str, pod_name: str = None, node_name: str = None, gpu_index: int = None):
+    path = os.path.join(METER_DIR, f"{job_id}.json")
+    rec = {"job_id": job_id, "pod": pod_name, "node": node_name, "gpu_index": gpu_index, "start_ts": int(time.time())}
+    with open(path, "w") as f:
+        json.dump(rec, f)
+    return rec
+
+def stop_meter(job_id: str, region: str = None):
+    path = os.path.join(METER_DIR, f"{job_id}.json")
+    if not os.path.exists(path):
+        raise FileNotFoundError("meter not started for job " + job_id)
+    rec = json.load(open(path))
+    rec["end_ts"] = int(time.time())
+    # compute energy (best-effort)
+    kwh = compute_energy_kwh(rec["start_ts"], rec["end_ts"], pod_name=rec.get("pod"), node_name=rec.get("node"), gpu_index=rec.get("gpu_index"))
+    rec["energy_kwh"] = kwh
+    if kwh:
+        g_per_kwh = carbon_lookup.lookup_co2_intensity(region=region)
+        rec["co2e_kg"] = kwh * (g_per_kwh / 1000.0)
+    else:
+        rec["co2e_kg"] = None
+    # attach to billing record and attempt to send
+    billing_rec = {"id": f"bill-{job_id}", "tenant": "unknown", "cost_usd": 0.0, "energy_kwh": rec.get("energy_kwh"), "co2e_kg": rec.get("co2e_kg"), "region": region}
+    try:
+        billing_uploader_v2.prepare_and_send_charge(billing_rec)
+    except Exception as e:
+        print("billing send failed", e)
+    # persist evidence locally in meter dir (caller should also upload to S3)
+    with open(path, "w") as f:
+        json.dump(rec, f, indent=2)
+    return rec
+
