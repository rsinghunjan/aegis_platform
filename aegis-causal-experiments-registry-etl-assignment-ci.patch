+#!/usr/bin/env python3
+"""
+Simple drift detector for treatment effect drift:
+ - Periodically computes ATE on the latest causal_ready dataset and compares to baseline
+ - Emits a JSON report and can call an alert webhook if drift exceeds threshold
+ - Intended as a worker scheduled in Kubernetes CronJob or similar
+"""
+import os, time, pandas as pd, json, requests
+
+DATA_PATH = os.environ.get("CAUSAL_DATA_PATH","/data/causal_ready.parquet")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK","")
+BASELINE_ATE = float(os.environ.get("BASELINE_ATE","0.0"))
+DRIFT_THRESHOLD = float(os.environ.get("DRIFT_THRESHOLD","0.1"))
+
+def compute_ate(df, treatment_col="treatment", outcome_col="outcome"):
+    treated = df[df[treatment_col]==1][outcome_col]
+    control = df[df[treatment_col]==0][outcome_col]
+    if len(treated)==0 or len(control)==0:
+        return None
+    return treated.mean() - control.mean()
+
+def run_once():
+    if not os.path.exists(DATA_PATH):
+        print("Data path missing:", DATA_PATH); return
+    df = pd.read_parquet(DATA_PATH)
+    ate = compute_ate(df)
+    report = {"ts": int(time.time()), "ate": ate, "baseline": BASELINE_ATE}
+    print("Drift report:", report)
+    # check drift
+    if ate is None:
+        return
+    if abs(ate - BASELINE_ATE) > DRIFT_THRESHOLD:
+        print("DRIFT detected:", ate, "baseline:", BASELINE_ATE)
+        if ALERT_WEBHOOK:
+            try:
+                requests.post(ALERT_WEBHOOK, json=report, timeout=5)
+            except Exception as e:
+                print("Alert webhook failed:", e)
+
+if __name__=="__main__":
+    run_once()
+
