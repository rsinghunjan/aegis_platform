+#!/usr/bin/env python3
+"""
+Assignment enforcement middleware for orchestrator / edge agents.
+ - Before performing an action that depends on treatment assignment, call the experiments registry /assign endpoint to verify assignment.
+ - Example usage: check_assignment("exp-id", "user-123") -> True/False
+"""
+import os, requests
+
+EXPERIMENT_REG = os.environ.get("EXPERIMENT_REG","http://experiment-registry:8081")
+
+def check_assignment(experiment_id, user_id):
+    url = f"{EXPERIMENT_REG}/assign"
+    r = requests.post(url, json={"experiment_id": experiment_id, "user_id": user_id}, timeout=5)
+    if r.status_code != 200:
+        raise RuntimeError(f"Experiment registry error: {r.status_code}")
+    j = r.json()
+    return j.get("assigned", False), j
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv)<3:
+        print("Usage: assignment_middleware.py <exp_id> <user_id>")
+    else:
+        ok, info = check_assignment(sys.argv[1], sys.argv[2])
+        print("Assigned:", ok, info)
+
