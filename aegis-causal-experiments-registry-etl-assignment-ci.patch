+#!/usr/bin/env python3
+"""
+Experiment registry service (minimal).
+ - Stores experiments, assignment rules, seeds, approvals and evidence URIs.
+ - Provides API to create experiments, get assignment for a user, approve experiments, and list experiments.
+ - Simple SQLite backend for quick start; swap to Postgres for production.
+
+API endpoints:
+ - POST /experiments          -> create experiment JSON
+ - GET  /experiments/<id>     -> get experiment
+ - POST /experiments/<id>/approve -> mark approved by user
+ - POST /assign              -> returns assignment for user_id and experiment_id (applies deterministic randomization)
+ - GET  /status              -> health check
+
+Security: this prototype does not implement auth. In production secure with mTLS or Vault-issued tokens.
+"""
+import os, sqlite3, uuid, time, json
+from flask import Flask, request, jsonify
+
+DB = os.environ.get("EXPERIMENT_DB", "/data/experiments.db")
+os.makedirs(os.path.dirname(DB), exist_ok=True)
+conn = sqlite3.connect(DB, check_same_thread=False)
+cur = conn.cursor()
+cur.execute("""CREATE TABLE IF NOT EXISTS experiments(
+    id TEXT PRIMARY KEY,
+    name TEXT,
+    owner TEXT,
+    seed INTEGER,
+    rollout REAL,
+    assignment_rule TEXT,
+    start_ts INTEGER,
+    end_ts INTEGER,
+    approved_by TEXT,
+    evidence_uri TEXT,
+    metadata TEXT
+)""")
+conn.commit()
+
+app = Flask(__name__)
+
+@app.route("/status", methods=["GET"])
+def status():
+    return jsonify({"ok": True})
+
+@app.route("/experiments", methods=["POST"])
+def create_experiment():
+    body = request.json or {}
+    eid = body.get("id") or str(uuid.uuid4())
+    name = body.get("name", "exp-"+eid[:8])
+    owner = body.get("owner", "")
+    seed = int(body.get("seed", int(time.time())))
+    rollout = float(body.get("rollout", 0.5))
+    rule = body.get("assignment_rule", "uniform")
+    start_ts = int(body.get("start_ts", int(time.time())))
+    end_ts = int(body.get("end_ts", 0))
+    metadata = json.dumps(body.get("metadata", {}))
+    cur.execute("INSERT OR REPLACE INTO experiments(id,name,owner,seed,rollout,assignment_rule,start_ts,end_ts,metadata) VALUES (?,?,?,?,?,?,?,?,?)",
+                (eid,name,owner,seed,rollout,rule,start_ts,end_ts,metadata))
+    conn.commit()
+    return jsonify({"id": eid, "name": name})
+
+@app.route("/experiments/<eid>", methods=["GET"])
+def get_experiment(eid):
+    cur.execute("SELECT id,name,owner,seed,rollout,assignment_rule,start_ts,end_ts,approved_by,evidence_uri,metadata FROM experiments WHERE id=?", (eid,))
+    row = cur.fetchone()
+    if not row:
+        return ("",404)
+    keys = ["id","name","owner","seed","rollout","assignment_rule","start_ts","end_ts","approved_by","evidence_uri","metadata"]
+    result = dict(zip(keys,row))
+    try:
+        result["metadata"] = json.loads(result["metadata"])
+    except Exception:
+        pass
+    return jsonify(result)
+
+@app.route("/experiments/<eid>/approve", methods=["POST"])
+def approve_experiment(eid):
+    body = request.json or {}
+    approver = body.get("by", "operator")
+    evidence = body.get("evidence_uri","")
+    cur.execute("UPDATE experiments SET approved_by=?, evidence_uri=? WHERE id=?", (approver, evidence, eid))
+    conn.commit()
+    return jsonify({"ok": True, "id": eid, "approved_by": approver})
+
+@app.route("/assign", methods=["POST"])
+def assign():
+    """
+    Deterministic assignment given user_id and experiment_id.
+    Body: { "experiment_id": "...", "user_id": "..." }
+    Returns: { assigned: true/false, bucket: float, seed_used: int }
+    """
+    body = request.json or {}
+    eid = body.get("experiment_id")
+    uid = body.get("user_id") or body.get("device_id") or body.get("agent_id")
+    if not eid or not uid:
+        return jsonify({"error": "experiment_id and user_id required"}), 400
+    cur.execute("SELECT seed, rollout FROM experiments WHERE id=?", (eid,))
+    row = cur.fetchone()
+    if not row:
+        return jsonify({"error":"experiment not found"}), 404
+    seed, rollout = row
+    # deterministic hash -> bucket
+    import hashlib, struct
+    h = hashlib.sha256(f"{seed}:{uid}".encode()).digest()[:8]
+    bucket = struct.unpack("!Q", h)[0] / float(2**64)
+    assigned = bucket < float(rollout)
+    return jsonify({"assigned": bool(assigned), "bucket": bucket, "seed": seed})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("EXPERIMENT_REG_PORT", "8081")))
+
