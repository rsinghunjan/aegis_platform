+#!/usr/bin/env python3
+"""
+Batch ETL: read raw event parquet/CSV, build causal_ready dataset and write parquet.
+ - Simple local implementation using pandas; for large-scale run with Spark (Dataproc/EMR) use services/data/etl/spark_job_example.py or Delta pipelines.
+ - Registers dataset in MLflow if MLFLOW_TRACKING_URI is set and --register flag provided.
+"""
+import argparse, os, pandas as pd, time, mlflow
+
+def build_causal_ready(df):
+    # Minimal transformation:
+    # - choose latest observation per user_id within window
+    # - pivot/find treatment and outcome
+    # This is very domain-specific. This function is a template.
+    if "user_id" not in df.columns:
+        df = df.rename(columns={df.columns[0]: "user_id"})
+    # Example: treat column must exist
+    if "treatment" not in df.columns or "outcome" not in df.columns:
+        raise RuntimeError("Input must contain 'treatment' and 'outcome' columns")
+    # take most recent per user
+    df = df.sort_values("timestamp").groupby("user_id").last().reset_index()
+    # keep covariates as columns other than user_id, treatment, outcome, experiment_id
+    return df
+
+def register_dataset(path):
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    mlflow.set_experiment("causal-datasets")
+    with mlflow.start_run():
+        mlflow.log_artifact(path, artifact_path="datasets")
+        print("Registered dataset", path)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="inp", required=True)
+    p.add_argument("--out", dest="out", default="/tmp/causal_ready.parquet")
+    p.add_argument("--register", action="store_true")
+    args = p.parse_args()
+    print("Reading", args.inp)
+    if args.inp.endswith(".parquet"):
+        df = pd.read_parquet(args.inp)
+    else:
+        df = pd.read_csv(args.inp)
+    print("Rows in input:", len(df))
+    outdf = build_causal_ready(df)
+    outdf.to_parquet(args.out, index=False)
+    print("Wrote causal-ready dataset to", args.out)
+    if args.register:
+        register_dataset(args.out)
+
+if __name__=="__main__":
+    main()
+
