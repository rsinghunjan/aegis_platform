+#!/usr/bin/env python3
+"""
+Register causal analysis artifacts in MLflow and produce a signed manifest in the evidence bucket.
+ - Inputs: artifact path(s) or report(s)
+ - Outputs: MLflow run, uploaded artifacts and signed manifest (cosign)
+"""
+import argparse, os, subprocess, json, time
+
+def mlflow_log_and_register(artifact_path, experiment="causal-analysis"):
+    import mlflow
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    mlflow.set_experiment(experiment)
+    with mlflow.start_run():
+        mlflow.log_artifact(artifact_path, artifact_path="causal_reports")
+        run_id = mlflow.active_run().info.run_id
+    return run_id
+
+def sign_manifest(manifest_path, cosign_key):
+    if not cosign_key:
+        print("No cosign key provided; skipping sign")
+        return False
+    subprocess.check_call(["cosign","sign","--key", cosign_key, manifest_path])
+    return True
+
+def upload_manifest(manifest_path, evidence_bucket):
+    if not evidence_bucket:
+        return None
+    if not evidence_bucket.startswith("s3://"):
+        raise RuntimeError("Only s3:// supported")
+    subprocess.check_call(["aws","s3","cp", manifest_path, f"{evidence_bucket.rstrip('/')}/causal_manifests/"])
+    return f"{evidence_bucket.rstrip('/')}/causal_manifests/{os.path.basename(manifest_path)}"
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--report", required=True)
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KEY_REF",""))
+    p.add_argument("--evidence-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    args = p.parse_args()
+    run_id = mlflow_log_and_register(args.report)
+    manifest = {"report": args.report, "run_id": run_id, "ts": int(time.time())}
+    fn = f"/tmp/causal_manifest_{int(time.time())}.json"
+    with open(fn,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    print("Wrote manifest", fn)
+    signed = sign_manifest(fn, args.cosign_key)
+    if signed:
+        print("Manifest signed")
+    uri = upload_manifest(fn, args.evidence_bucket)
+    print("Uploaded manifest to", uri)
+
+if __name__=="__main__":
+    main()
+
