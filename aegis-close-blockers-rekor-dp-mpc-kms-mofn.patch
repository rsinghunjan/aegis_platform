+"""
+Generate deterministic test vectors for MPC auditor review.
+Produces:
+ - /tmp/mpc_audit_vectors.json containing input vectors and expected (reference) aggregates.
+ - deterministic RNG seed used.
+"""
+import json, os, random
+from hashlib import sha256
+
+OUT="/tmp/mpc_audit_vectors.json"
+SEED=123456789
+random.seed(SEED)
+
+def gen_vector(length=64):
+    return [random.randint(0,255) for _ in range(length)]
+
+def compute_reference(vectors):
+    # naive byte-wise xor reference (matches coordinator's placeholder aggregation)
+    from functools import reduce
+    ref = []
+    for i in range(len(vectors[0])):
+        acc = 0
+        for v in vectors:
+            acc ^= v[i]
+        ref.append(acc)
+    return ref
+
+def main():
+    parties = 3
+    vectors = [gen_vector(64) for _ in range(parties)]
+    ref = compute_reference(vectors)
+    payload = {"seed": SEED, "parties": parties, "vectors": vectors, "reference_aggregate": ref}
+    with open(OUT,"w") as fh:
+        json.dump(payload, fh, indent=2)
+    print("Wrote", OUT)
+
+if __name__=="__main__":
+    main()
+
