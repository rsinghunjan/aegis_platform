+#!/usr/bin/env python3
+"""
+Helper to validate JWT tokens against an OIDC JWKS URL and expected audience.
+Use this in M-of-N service to validate approver tokens.
+"""
+import os
+import requests
+import jwt
+from jwt import PyJWKClient
+
+JWKS_URL = os.environ.get("OIDC_JWKS_URL", "")
+AUDIENCE = os.environ.get("OIDC_AUDIENCE", "")
+
+def validate_jwt(token):
+    if not JWKS_URL or not AUDIENCE:
+        raise RuntimeError("OIDC_JWKS_URL or OIDC_AUDIENCE not configured")
+    jwks_client = PyJWKClient(JWKS_URL)
+    signing_key = jwks_client.get_signing_key_from_jwt(token)
+    decoded = jwt.decode(token, signing_key.key, algorithms=["RS256","ES256"], audience=AUDIENCE, options={"verify_exp": True})
+    # return useful claims
+    return decoded
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("Usage: mofn_oidc_validator.py <jwt>")
+        raise SystemExit(2)
+    t = sys.argv[1]
+    print(validate_jwt(t))
+
