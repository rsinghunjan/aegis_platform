+#!/usr/bin/env python3
+"""
+Static scan to ensure FL orchestrator(s) call DP check/report helpers.
+Searches the repo for files that look like FL orchestrators and warns if calls are missing.
+Returns non-zero if any likely orchestrator lacks check_and_start_round or report_round calls.
+"""
+import os, re, sys
+
+ROOT = os.getcwd()
+PATTERNS = ["check_and_start_round(", "report_round("]
+FL_INDICATORS = ["fl_controller", "orchestrator", "federated", "fl/"]
+
+def likely_fl_file(path):
+    ln = path.lower()
+    return any(k in ln for k in FL_INDICATORS) or ln.endswith("_controller.py")
+
+def scan_file(path):
+    with open(path, "r", encoding="utf-8", errors="ignore") as fh:
+        s = fh.read()
+    return all(p in s for p in PATTERNS)
+
+def main():
+    missing = []
+    for root, dirs, files in os.walk(ROOT):
+        # skip venvs, .git
+        if ".git" in root or "venv" in root or "node_modules" in root:
+            continue
+        for f in files:
+            if f.endswith(".py"):
+                path = os.path.join(root, f)
+                if likely_fl_file(path):
+                    ok = scan_file(path)
+                    if not ok:
+                        missing.append(path)
+    if missing:
+        print("Potential FL orchestrator files missing DP check/report calls:")
+        for m in missing:
+            print(" -", m)
+        print("Failing CI: inject calls to check_and_start_round/report_round or use the decorator.")
+        return 2
+    print("All likely FL orchestrator files contain DP check/report calls (or none were detected).")
+    return 0
+
+if __name__ == "__main__":
+    sys.exit(main())
+
