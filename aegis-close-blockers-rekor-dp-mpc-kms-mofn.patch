+#!/usr/bin/env python3
+"""
+Decorator-based DP enforcement helper for FL controller functions.
+
+Usage:
+  from services.fl.fl_controller_dp_enforcer import require_dp_check
+
+  @require_dp_check(project="default", noise=1.0, sample_rate=0.01, steps=1)
+  def run_one_round(...):
+      # perform training round
+      return epsilon_used
+
+The decorator will:
+ - call check_and_start_round(...) to obtain a run_id (or raise if disallowed),
+ - inject run_id into function kwargs as `__dp_run_id`,
+ - after the function returns epsilon, call report_round(project, run_id, epsilon).
+"""
+import functools
+from services.fl.fl_controller_dp_wrapper import check_and_start_round, report_round
+
+def require_dp_check(project="default", noise=1.0, sample_rate=0.01, steps=1, delta=1e-5):
+    def decorator(fn):
+        @functools.wraps(fn)
+        def wrapped(*args, **kwargs):
+            run_id = check_and_start_round(project=project, noise=noise, sample_rate=sample_rate, steps=steps, delta=delta)
+            kwargs["__dp_run_id"] = run_id
+            try:
+                res = fn(*args, **kwargs)
+                # Expect the wrapped function to return epsilon used (or a dict containing 'epsilon')
+                if isinstance(res, dict):
+                    epsilon = res.get("epsilon")
+                else:
+                    epsilon = res
+                if epsilon is None:
+                    raise RuntimeError("Wrapped function did not return epsilon; report_round cannot be called")
+                report_round(project=project, run_id=run_id, epsilon=epsilon)
+                return res
+            except Exception:
+                # In case of failure, record a report with epsilon=null (best-effort)
+                try:
+                    report_round(project=project, run_id=run_id, epsilon=0.0)
+                except Exception:
+                    pass
+                raise
+        return wrapped
+    return decorator
+
