+#!/usr/bin/env python3
+"""
+Upload an artifact to Rekor (best-effort).
+
+Behavior:
+ - Prefer to call `rekor-cli upload --artifact <file>` if present.
+ - Fallback to simple HTTP POST to Rekor server if REKOR_SERVER is set.
+ - Returns the Rekor entry UUID or raises on failure.
+
+Usage:
+  python3 ops/evidence/register_rekor.py /tmp/manifest.json
+"""
+import os
+import sys
+import subprocess
+import json
+import base64
+import requests
+
+REKOR_SERVER = os.environ.get("REKOR_SERVER", "")
+
+def upload_with_rekor_cli(path):
+    try:
+        out = subprocess.check_output(["rekor-cli", "upload", "--artifact", path], stderr=subprocess.STDOUT)
+        # rekor-cli prints helpful output; try to find UUID in output
+        s = out.decode()
+        # try to parse json if rekor-cli returns json
+        try:
+            j = json.loads(s)
+            if isinstance(j, dict) and "uuid" in j:
+                return j["uuid"]
+        except Exception:
+            # simple grep fallback
+            for line in s.splitlines():
+                if "UUID" in line or "Entry created" in line:
+                    parts = line.split()
+                    for p in parts:
+                        if len(p) == 36 and p.count("-") == 4:
+                            return p
+        return None
+    except Exception as e:
+        raise RuntimeError(f"rekor-cli upload failed: {e}")
+
+def upload_via_rest(path, server):
+    # Minimal rekor REST API upload; construct request per rekor spec (best-effort)
+    with open(path, "rb") as fh:
+        data = fh.read()
+    b64 = base64.b64encode(data).decode()
+    payload = {
+        "apiVersion": "0.0.1",
+        "spec": {
+            "data": {
+                "hash": {
+                    "algorithm": "sha256",
+                    "value": ""  # let rekor compute if it supports
+                },
+                "content": b64
+            }
+        }
+    }
+    url = server.rstrip("/") + "/api/v1/log/entries"
+    r = requests.post(url, json=payload, timeout=30)
+    if r.status_code in (200,201):
+        try:
+            j = r.json()
+            # returns mapping of uuid->entry
+            if isinstance(j, dict) and len(j) > 0:
+                return list(j.keys())[0]
+        except Exception:
+            return None
+    raise RuntimeError(f"rekor REST upload failed: {r.status_code} {r.text}")
+
+def main(path):
+    if not os.path.exists(path):
+        raise SystemExit(f"file not found: {path}")
+    # Try rekor-cli
+    try:
+        if shutil_which("rekor-cli"):
+            uuid = upload_with_rekor_cli(path)
+            if uuid:
+                print(uuid)
+                return 0
+    except Exception as e:
+        print("rekor-cli upload failed:", e, file=sys.stderr)
+    # Fallback to REST
+    if REKOR_SERVER:
+        try:
+            uuid = upload_via_rest(path, REKOR_SERVER)
+            print(uuid or "")
+            return 0
+        except Exception as e:
+            print("rekor REST upload failed:", e, file=sys.stderr)
+    raise SystemExit("Failed to register artifact with Rekor; ensure rekor-cli or REKOR_SERVER is configured")
+
+def shutil_which(cmd):
+    from shutil import which
+    return which(cmd) is not None
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        print("Usage: register_rekor.py <artifact_path>", file=sys.stderr)
+        sys.exit(2)
+    main(sys.argv[1])
+
