+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Quick runner hardening check to be executed on each self-hosted runner.
+# Verifies presence of essential tools and label file.
+#
+REQUIRED_CMDS=(cosign rekor-cli apalache-mc neuron-cc poprun habana_info cansend candump tsntool onnxruntime)
+LABEL_FILE="/etc/aegis-runner-labels"
+
+echo "Checking runner hardening..."
+missing=()
+for c in "${REQUIRED_CMDS[@]}"; do
+  if ! command -v "$c" >/dev/null 2>&1; then
+    missing+=("$c")
+  fi
+done
+
+if [ ${#missing[@]} -gt 0 ]; then
+  echo "Missing required commands: ${missing[*]}"
+  exit 1
+fi
+
+if [ ! -f "$LABEL_FILE" ]; then
+  echo "Runner label file not found: $LABEL_FILE"
+  exit 2
+fi
+
+echo "Runner appears hardened (commands present and label file exists)."
+cat "$LABEL_FILE"
+exit 0
+
