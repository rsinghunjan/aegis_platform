+#!/usr/bin/env python3
+"""
+Ensure Builder Hardening
+ - Verifies that expected builder runners exist, are labeled, and have required tools installed.
+ - Optionally runs a small build+sign smoke to ensure cosign & rekor workflows function on builders.
+ - Exits non-zero if requirements not met to prevent promotions until hardened builders are available.
+
+Requires:
+ - A runners inventory file at /etc/aegis-runner-labels or provided via environment RUNNER_LABELS_FILE
+ - Builders listed in BUILDERS env var as comma-separated hostnames
+"""
+import os, sys, subprocess, json
+
+RUNNER_LABELS_FILE = os.environ.get("RUNNER_LABELS_FILE", "/etc/aegis-runner-labels")
+BUILDERS = os.environ.get("BUILDERS","").split(",")
+
+def check_labels(path):
+    if not os.path.exists(path):
+        return False, f"labels file missing: {path}"
+    # simple parse: ensure required labels exist somewhere
+    content = open(path).read()
+    required = ["aegis/role", "aegis/npu"]
+    for r in required:
+        if r not in content:
+            return False, f"required label {r} missing in {path}"
+    return True, ""
+
+def check_builder_tooling(host):
+    # Placeholder: test SSH and presence of cosign/rekor-cli on builder
+    try:
+        subprocess.check_call(["ssh", host, "which cosign"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        subprocess.check_call(["ssh", host, "which rekor-cli"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True, ""
+    except Exception as e:
+        return False, str(e)
+
+def main():
+    ok, msg = check_labels(RUNNER_LABELS_FILE)
+    if not ok:
+        print("Runner labeling check failed:", msg)
+        sys.exit(8)
+    bad_builders = []
+    for b in BUILDERS:
+        if not b: continue
+        ok, msg = check_builder_tooling(b)
+        if not ok:
+            bad_builders.append((b,msg))
+    if bad_builders:
+        print("Builder hardening checks failed for:")
+        for b,m in bad_builders:
+            print(b,m)
+        sys.exit(9)
+    print("Builder hardening checks passed")
+
+if __name__=="__main__":
+    main()
+
