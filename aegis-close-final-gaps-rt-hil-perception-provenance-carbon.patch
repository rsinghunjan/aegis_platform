+#!/usr/bin/env python3
+"""
+RT Remediation Agent
+ - Inspect rt_slo_proof.json outputs and produce actionable remediation suggestions
+ - Optionally attempt best-effort remediation commands (requires operator approval)
+ - Record remediation attempts via evidence_sdk
+
+Usage:
+  python3 rt_remediation_agent.py --report /path/to/rt_slo_proof.json --remediate --out /tmp/rt_remediation.json
+"""
+import argparse, json, os, subprocess
+from datetime import datetime
+
+def analyze(report):
+    suggestions = []
+    p99 = report.get("p99_ms")
+    safe = report.get("safe_ms")
+    if p99 is None:
+        suggestions.append("No jitter samples found: ensure RT orchestrator produced rt_jitter_samples.ndjson")
+    else:
+        if p99 > report.get("p99_slo_ms", 0.2):
+            suggestions.append(f"p99 ({p99} ms) > target ({report.get('p99_slo_ms')} ms): check CPU isolation, irq affinity, PREEMPT_RT config")
+            suggestions.append("Suggested remediation: isolate CPU cores for control thread, set IRQ affinity and use chrt --fifo for control process")
+    if safe is None:
+        suggestions.append("No safe-stop latency found: ensure safe-stop trace capture completed")
+    else:
+        if safe > report.get("safe_slo_ms", 50.0):
+            suggestions.append(f"safe-stop ({safe} ms) > target ({report.get('safe_slo_ms')} ms): check controller loop priority and actuator stack latency")
+            suggestions.append("Suggested remediation: increase control thread priority, reduce non-essential interrupts and offload logging")
+    return suggestions
+
+def remediate_commands(report):
+    # Best-effort remediation commands: operator must review before running
+    cmds = []
+    cmds.append("# Example: set control process to real-time FIFO priority (replace <pid>)")
+    cmds.append("sudo chrt -f -p 80 <PID>")
+    cmds.append("# Example: isolate CPUs (example - cpus 2,3)")
+    cmds.append("echo 2-3 > /sys/devices/system/cpu/online  # operator to adapt")
+    cmds.append("# Example: set IRQ affinity for NIC (replace irq number)")
+    cmds.append("echo 4 > /proc/irq/<IRQ>/smp_affinity_list")
+    return cmds
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--report", required=True)
+    p.add_argument("--remediate", action="store_true")
+    p.add_argument("--out", default="/tmp/rt_remediation.json")
+    args = p.parse_args()
+    report = {}
+    try:
+        report = json.load(open(args.report))
+    except Exception:
+        print("Failed to read report:", args.report)
+        raise
+    suggestions = analyze(report)
+    out = {"report_checked": args.report, "checked_at": datetime.utcnow().isoformat()+"Z", "suggestions": suggestions}
+    if args.remediate:
+        out["remediation_commands"] = remediate_commands(report)
+    with open(args.out, "w") as fh:
+        json.dump(out, fh, indent=2)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("rt_remediation", {"out": args.out})
+    except Exception:
+        pass
+    print("Wrote remediation summary to", args.out)
+
+if __name__=="__main__":
+    from datetime import datetime
+    import json
+    main()
+
