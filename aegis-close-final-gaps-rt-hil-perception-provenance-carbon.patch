+#!/usr/bin/env python3
+"""
+Automated Certification Workflow
+ - Runs HIL campaigns, executes Apalache formal checks, packages evidence, optionally uploads to certifier endpoint,
+   and records an auditable manifest for reviewers.
+ - Designed to be invoked from CI or operator runners when a certification run is required.
+
+Usage:
+  python3 automated_cert_workflow.py --scenarios-file cert/scenarios.txt --golden /opt/aegis/golden_trace.ndjson --out /tmp/cert_run --upload-url https://certifier.example/upload
+"""
+import argparse, os, subprocess, json, tempfile, requests
+from datetime import datetime
+
+def run_hil(scenarios, outdir):
+    cmd = ["python3","ops/robotics/control/certified/hil_campaign_manager.py","--golden", scenarios["golden"], "--out", outdir]
+    for s in scenarios["list"]:
+        cmd += ["--scenarios", s]
+    subprocess.check_call(cmd)
+
+def run_formal(outdir):
+    subprocess.check_call(["./ops/formal/apalache_triage_runner.sh", outdir])
+
+def package(outdir, bundle):
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+
+def upload(bundle, url, api_token=None):
+    if not url:
+        return None
+    files = {"file": open(bundle,"rb")}
+    headers = {}
+    if api_token:
+        headers["Authorization"] = f"Bearer {api_token}"
+    resp = requests.post(url, files=files, headers=headers, timeout=120)
+    return resp.status_code, resp.text
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--scenarios-file", required=True)
+    p.add_argument("--golden", required=True)
+    p.add_argument("--out", default=f"/tmp/cert_run_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--upload-url", default="")
+    p.add_argument("--api-token", default=os.environ.get("CERTIFIER_API_TOKEN",""))
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KMS_URI",""))
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    # read scenarios file (one command per line)
+    with open(args.scenarios_file) as fh:
+        scen_cmds = [l.strip() for l in fh if l.strip()]
+    scenarios = {"golden": args.golden, "list": scen_cmds}
+    try:
+        run_hil(scenarios, args.out)
+    except subprocess.CalledProcessError as e:
+        print("HIL campaign failed:", e)
+    try:
+        run_formal(args.out)
+    except subprocess.CalledProcessError as e:
+        print("Formal checks encountered issues:", e)
+    bundle = args.out + ".tar.gz"
+    package(args.out, bundle)
+    if args.cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",args.cosign_key, bundle])
+        except Exception as e:
+            print("Cosign sign failed (best-effort):", e)
+    upload_result = None
+    if args.upload_url:
+        try:
+            upload_result = upload(bundle, args.upload_url, args.api_token)
+        except Exception as e:
+            print("Upload failed:", e)
+    manifest = {"bundle": bundle, "uploaded": upload_result, "generated_at": datetime.utcnow().isoformat()+"Z"}
+    with open(os.path.join(args.out,"cert_manifest.json"), "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("automated_cert_workflow", {"bundle": bundle})
+    except Exception:
+        pass
+    print("Certification workflow complete. Bundle:", bundle)
+
+if __name__=="__main__":
+    from datetime import datetime
+    main()
+
