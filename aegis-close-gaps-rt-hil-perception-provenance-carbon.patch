+#!/usr/bin/env python3
+"""
+HIL campaign automation
+ - Runs hil_campaign_manager to execute scenarios, then triggers formal Apalache checks
+ - Packages campaign artifacts and auto-creates triage issues (using gh) with a standardized template
+ - Produces a campaign bundle for auditors (signed if COSIGN_KMS_URI provided)
+"""
+import argparse, os, subprocess, json, tempfile
+from datetime import datetime
+
+ISSUE_TEMPLATE = """HIL Campaign failure: {scenario}
+
+Campaign ID: {campaign_id}
+Host: {host}
+Outdir: {outdir}
+
+Summary:
+{summary}
+
+Artifacts: {artifacts}
+"""
+
+def run_campaign(scenarios, golden, out):
+    cmd = ["python3","ops/robotics/control/certified/hil_campaign_manager.py","--out",out,"--golden",golden]
+    for s in scenarios:
+        cmd += ["--scenarios", s]
+    try:
+        subprocess.check_call(cmd)
+        return True
+    except Exception as e:
+        print("Campaign runner returned:", e)
+        return False
+
+def run_apalache(out):
+    try:
+        subprocess.check_call(["./ops/formal/apalache_triage_runner.sh", out])
+        return True
+    except Exception:
+        return False
+
+def create_issue(title, body):
+    try:
+        subprocess.check_call(["gh","issue","create","--title", title, "--body", body])
+        return True
+    except Exception:
+        print("gh not available or failed; skipping issue create")
+        return False
+
+def package_and_sign(outdir, cosign_key=None):
+    bundle = f"{outdir}.tar.gz"
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception:
+            print("cosign sign failed (best-effort)")
+    return bundle
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--scenarios", nargs="+", required=True)
+    p.add_argument("--golden", required=True)
+    p.add_argument("--out", default=f"/tmp/hil_campaign_{datetime.utcnow().strftime('%Y%m%d%H%M%S')}")
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--host", default="localhost")
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    ok = run_campaign(args.scenarios, args.golden, args.out)
+    ap = run_apalache(args.out)
+    summary = {"campaign_ok": ok, "apalache_ok": ap}
+    summary_path = os.path.join(args.out,"automation_summary.json")
+    with open(summary_path,"w") as fh:
+        json.dump(summary, fh, indent=2)
+    # if any scenario failed, open issue for triage
+    if not ok or not ap:
+        create_issue("HIL campaign triage required", ISSUE_TEMPLATE.format(scenario="multiple", campaign_id="auto", host=args.host, outdir=args.out, summary=json.dumps(summary, indent=2), artifacts=args.out))
+    bundle = package_and_sign(args.out, args.cosign_key)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("hil_campaign_bundle", {"bundle": bundle})
+    except Exception:
+        pass
+    print("HIL campaign automation complete. Bundle:", bundle)
+
+if __name__=="__main__":
+    import json
+    from datetime import datetime
+    main()
+
