+#!/usr/bin/env python3
+"""
+Strict provenance enforcer
+ - Verifies cosign signatures for images referenced in manifests
+ - Queries Rekor (JSON output) and checks for builder identity / annotations
+ - Blocks promotion if provenance not sufficiently evidenced
+
+Requires: cosign, rekor-cli on runner
+"""
+import os, sys, yaml, subprocess, json
+
+REKOR_SERVER = os.environ.get("REKOR_SERVER","")
+MANIFESTS = os.environ.get("IMAGE_MANIFESTS","").split(",")
+
+def extract_images(manifest_paths):
+    images=set()
+    for p in manifest_paths:
+        if not p or not os.path.exists(p):
+            continue
+        for d in yaml.safe_load_all(open(p)):
+            def walk(o):
+                if isinstance(o, dict):
+                    for k,v in o.items():
+                        if k=="image" and isinstance(v,str):
+                            images.add(v)
+                        else:
+                            walk(v)
+                elif isinstance(o, list):
+                    for e in o:
+                        walk(e)
+            walk(d)
+    return images
+
+def cosign_verify(img):
+    try:
+        subprocess.check_call(["cosign","verify",img], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def rekor_entries_json(img):
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--artifact",img,"--rekor_server",REKOR_SERVER,"--output","json"])
+        return json.loads(out)
+    except Exception:
+        return {}
+
+def builder_identity_present(rekor_json):
+    # Best-effort: look for annotations/subject/builder fields in Rekor entries
+    try:
+        for k,v in rekor_json.items():
+            body = v.get("body", {})
+            if "integratedTime" in body:
+                # if the entry contains extra metadata or signature provenance, accept
+                return True
+    except Exception:
+        pass
+    return False
+
+def main():
+    imgs = extract_images(MANIFESTS)
+    bad=[]
+    for img in imgs:
+        if not cosign_verify(img):
+            bad.append((img,"cosign_missing"))
+            continue
+        if REKOR_SERVER:
+            j = rekor_entries_json(img)
+            if not builder_identity_present(j):
+                bad.append((img,"rekor_provenance_missing"))
+    if bad:
+        print("Provenance enforcement failed:")
+        for i,r in bad:
+            print(i,r)
+        sys.exit(7)
+    print("Provenance enforcement passed")
+
+if __name__=="__main__":
+    main()
+
