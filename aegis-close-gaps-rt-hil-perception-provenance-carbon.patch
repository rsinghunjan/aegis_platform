+#!/usr/bin/env python3
+"""
+Compose and cosign an override artifact for carbon gate
+ - Produces a JSON with approval_id, approved_by, approved_at, scope, reason, expiry
+ - Signs the artifact with cosign (KMS) so it can be used as an override in the carbon gate enforce step
+
+Usage:
+  COSIGN_KMS_URI=kms://... python3 override_signer.py --approval-id id --approved-by alice@example.com --scope '{"manifests":"deploy.yaml"}' --out /tmp/override.json
+"""
+import argparse, json, time, subprocess
+from datetime import datetime, timedelta
+import os
+
+def sign(path, cosign_key):
+    try:
+        subprocess.check_call(["cosign","sign","--key",cosign_key, path])
+        return True
+    except Exception as e:
+        print("cosign sign failed:", e)
+        return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--approval-id", required=True)
+    p.add_argument("--approved-by", required=True)
+    p.add_argument("--scope", required=True, help="JSON string describing scope")
+    p.add_argument("--reason", default="Operator override")
+    p.add_argument("--ttl-min", type=int, default=60)
+    p.add_argument("--out", default="/tmp/carbon_override.json")
+    args = p.parse_args()
+    expiry = (datetime.utcnow() + timedelta(minutes=args.ttl_min)).isoformat() + "Z"
+    obj = {"approval_id": args.approval_id, "approved_by": args.approved_by, "approved_at": datetime.utcnow().isoformat()+"Z", "scope": json.loads(args.scope), "reason": args.reason, "expiry": expiry}
+    with open(args.out,"w") as fh:
+        json.dump(obj, fh, indent=2)
+    key = os.environ.get("COSIGN_KMS_URI","")
+    if key:
+        sign(args.out, key)
+    print("Wrote override artifact to", args.out)
+
+if __name__=="__main__":
+    main()
+
