+#!/usr/bin/env python3
+"""
+RT Sweep Scheduler
+ - Periodically runs the hardware RT sweep across configured targets
+ - Aggregates results, uploads bundles (S3) and records evidence
+ - Sends simple notifications (placeholder) when failures found
+
+Usage:
+  python3 rt_sweep_scheduler.py --config ops/av/rt/rt_sweep_targets.json --out /tmp/rt_sweep_runs --s3 s3://aegis-evidence/...
+"""
+import argparse, json, os, subprocess, time
+from datetime import datetime
+
+def load_targets(path):
+    if not os.path.exists(path):
+        return ["localhost:can0"]
+    return json.load(open(path))
+
+def run_target(target, outdir, cosign=None, s3=None):
+    host = target.get("host","localhost")
+    iface = target.get("iface","can0")
+    env = os.environ.copy()
+    env["TARGETS"] = f"{host}:{iface}"
+    env["COSIGN_KMS_URI"] = cosign or env.get("COSIGN_KMS_URI","")
+    env["S3_UPLOAD"] = s3 or env.get("S3_UPLOAD","")
+    cmd = ["./ops/av/rt/run_hw_rt_sweep.sh", outdir]
+    try:
+        subprocess.check_call(cmd, env=env)
+        return True, ""
+    except subprocess.CalledProcessError as e:
+        return False, str(e)
+
+def notify(email, subject, body):
+    # Placeholder: integrate with real notification (pager, slack)
+    print("NOTIFY", email, subject)
+    print(body)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--config", default="ops/av/rt/rt_sweep_targets.json")
+    p.add_argument("--out", default="/tmp/rt_sweep_runs")
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    p.add_argument("--cosign", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--notify", default=os.environ.get("RT_NOTIFY",""))
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    targets = load_targets(args.config)
+    summary = {"started_at": datetime.utcnow().isoformat()+"Z", "results": []}
+    for t in targets:
+        ts = datetime.utcnow().strftime("%Y%m%d%H%M%S")
+        tid = f"{t.get('host')}_{t.get('iface')}_{ts}"
+        outdir = os.path.join(args.out, tid)
+        ok, msg = run_target(t, outdir, cosign=args.cosign, s3=args.s3)
+        entry = {"target": t, "outdir": outdir, "ok": ok, "msg": msg}
+        summary["results"].append(entry)
+        if not ok and args.notify:
+            notify(args.notify, f"RT sweep failed for {t}", msg or "check logs")
+    summary_path = os.path.join(args.out, "summary.json")
+    with open(summary_path,"w") as fh:
+        json.dump(summary, fh, indent=2)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("rt_sweep_summary", {"summary": summary_path})
+    except Exception:
+        pass
+    print("RT sweep finished. Summary:", summary_path)
+
+if __name__=="__main__":
+    import json
+    from datetime import datetime
+    main()
+
