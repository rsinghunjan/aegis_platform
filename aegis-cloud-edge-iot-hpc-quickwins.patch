+name: Enforce MCP Cosign + Rekor (CI gate)
+on:
+  pull_request:
+  workflow_dispatch:
+jobs:
+  enforce-provenance:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Install dependencies
+        run: |
+          sudo apt-get update -y
+          sudo apt-get install -y jq openssl
+          curl -sSfL https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64 -o cosign
+          chmod +x cosign
+          sudo mv cosign /usr/local/bin/
+
+      - name: Locate MCP JSON
+        id: find_mcp
+        run: |
+          # Allow override via workflow input; default path
+          MCP_JSON="${{ github.event.inputs.mcp_json_path || 'mcp_record.json' }}"
+          if [ ! -f "$MCP_JSON" ]; then
+            echo "mcp_json_found=false" >> $GITHUB_OUTPUT
+            echo "MCP JSON not found at $MCP_JSON"
+            exit 1
+          fi
+          echo "mcp_json=$MCP_JSON" >> $GITHUB_OUTPUT
+
+      - name: Verify signature with cosign
+        env:
+          COSIGN_PUB: ${{ secrets.COSIGN_PUB || '' }}
+        run: |
+          MCP_JSON="${{ steps.find_mcp.outputs.mcp_json }}"
+          SIG_FILE="${MCP_JSON}.sig"
+          if [ ! -f "$SIG_FILE" ]; then
+            echo "Signature ${SIG_FILE} not found; failing"
+            exit 1
+          fi
+          if [ -z "$COSIGN_PUB" ]; then
+            echo "COSIGN_PUB not configured in secrets; failing enforcement"
+            exit 1
+          fi
+          cosign verify-blob --key "$COSIGN_PUB" --signature "$SIG_FILE" "$MCP_JSON"
+
+      - name: Rekor entry check (best-effort)
+        env:
+          REKOR_SERVER: ${{ secrets.REKOR_SERVER || '' }}
+        run: |
+          if [ -z "$REKOR_SERVER" ]; then
+            echo "REKOR_SERVER not configured; skipping Rekor check"
+            exit 0
+          fi
+          MCP_JSON="${{ steps.find_mcp.outputs.mcp_json }}"
+          DIGEST=$(openssl dgst -sha256 -binary "$MCP_JSON" | openssl base64 -A)
+          # Best-effort: query Rekor for artifact hash (API versions differ)
+          RESP=$(curl -s "${REKOR_SERVER}/api/v1/index/retrieve?hash=${DIGEST}" || true)
+          if [ -z "$RESP" ] || [ "$RESP" = "null" ]; then
+            echo "No Rekor entry found for digest; failing provenance gate"
+            exit 1
+          fi
+          echo "Found Rekor entry"
+
