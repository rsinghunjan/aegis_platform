+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple Slurm/MPIRUN wrapper that runs training and then uploads checkpoints & creates MCP records.
+#
+# Usage:
+#  slurm wrapper example:
+#    ./slurm/hpc_job_wrapper.sh --mpirun "mpirun -np 8 python train.py" --checkpoint /path/to/ckpt.pt --model mymodel
+#
+while [[ $# -gt 0 ]]; do
+  key="$1"
+  case $key in
+    --mpirun)
+      MPIRUN_CMD="$2"; shift 2;;
+    --checkpoint)
+      CHECKPOINT="$2"; shift 2;;
+    --model)
+      MODEL="$2"; shift 2;;
+    *)
+      echo "Unknown arg $1"; exit 2;;
+  esac
+done
+
+if [ -z "${MPIRUN_CMD:-}" ] || [ -z "${CHECKPOINT:-}" ] || [ -z "${MODEL:-}" ]; then
+  echo "usage: $0 --mpirun '<mpirun ...>' --checkpoint <path> --model <model_id>"
+  exit 2
+fi
+
+echo "Running distributed job: $MPIRUN_CMD"
+eval "$MPIRUN_CMD"
+echo "Job finished. Uploading checkpoint..."
+./scripts/upload_checkpoint_and_create_mcp.sh "$CHECKPOINT" "$MODEL"
+echo "HPC wrapper complete"
+
