+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Upload a checkpoint to S3/LakeFS, sign it with cosign (KMS), and post an MCP record.
+#
+# Usage:
+#   ./scripts/upload_checkpoint_and_create_mcp.sh /path/to/checkpoint.pt model_id
+#
+CKPT=${1:-}
+MODEL_ID=${2:-}
+S3_BUCKET=${S3_BUCKET:-}
+AEGIS_MCP_API=${AEGIS_MCP_API:-http://mcp:8082}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+
+if [ -z "$CKPT" ] || [ -z "$MODEL_ID" ]; then
+  echo "Usage: $0 <checkpoint_file> <model_id>"
+  exit 2
+fi
+
+BASENAME=$(basename "$CKPT")
+KEY="checkpoints/${MODEL_ID}/${BASENAME}"
+
+if [ -n "$S3_BUCKET" ]; then
+  echo "Uploading $CKPT to s3://$S3_BUCKET/$KEY"
+  aws s3 cp "$CKPT" "s3://$S3_BUCKET/$KEY"
+  URI="s3://$S3_BUCKET/$KEY"
+else
+  echo "No S3_BUCKET configured; please set S3_BUCKET env"
+  exit 1
+fi
+
+# Sign artifact using cosign KMS (if configured)
+if [ -n "$COSIGN_KMS_URI" ]; then
+  export COSIGN_KMS_URI="$COSIGN_KMS_URI"
+  ./scripts/sign_with_kms.sh "$CKPT"
+  SIG_PATH="${CKPT}.sig"
+else
+  echo "COSIGN_KMS_URI not set; skipping signing"
+  SIG_PATH=""
+fi
+
+# Create MCP record payload
+RUN_ID="hpc-$(date +%s)"
+MCP_JSON="/tmp/mcp_${MODEL_ID}_${RUN_ID}.json"
+cat > "$MCP_JSON" <<JSON
+{
+  "model_id": "${MODEL_ID}",
+  "version": "",
+  "artifacts": [{"uri": "${URI}"}],
+  "evaluation": {"run_id": "${RUN_ID}", "type":"checkpoint-upload"},
+  "approvals": []
+}
+JSON
+
+echo "Posting MCP record to ${AEGIS_MCP_API}/models/${MODEL_ID}/context"
+curl -s -X POST "${AEGIS_MCP_API}/models/${MODEL_ID}/context" -H "Content-Type: application/json" --data-binary @"${MCP_JSON}" || true
+
+if [ -n "$SIG_PATH" ]; then
+  echo "Also uploading signature alongside checkpoint (best-effort) to S3"
+  aws s3 cp "$SIG_PATH" "s3://$S3_BUCKET/${KEY}.sig" || true
+fi
+
+echo "Done. MCP record created: $MCP_JSON"
+
