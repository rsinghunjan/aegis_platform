+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Generic helper to sign a blob using cosign with a KMS URI.
+# Supports AWS KMS, GCP KMS, Azure Key Vault, and HashiCorp Vault (cosign KMS support).
+#
+# Usage:
+#   COSIGN_KMS_URI=aws-kms://arn:aws:kms:... ./scripts/sign_with_kms.sh artifact.bin
+#
+ARTIFACT=${1:-}
+KMS_URI=${COSIGN_KMS_URI:-}
+
+if [ -z "$ARTIFACT" ]; then
+  echo "usage: sign_with_kms.sh <artifact>"
+  exit 2
+fi
+if [ -z "$KMS_URI" ]; then
+  echo "Set COSIGN_KMS_URI env to your KMS key URI (e.g. aws-kms://arn:aws:kms:... )"
+  exit 2
+fi
+
+echo "Signing $ARTIFACT with cosign using KMS $KMS_URI"
+cosign sign-blob --kms "$KMS_URI" --output-signature "${ARTIFACT}.sig" "$ARTIFACT"
+echo "Signature written to ${ARTIFACT}.sig"
+
