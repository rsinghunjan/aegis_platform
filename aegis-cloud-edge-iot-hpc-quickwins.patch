+#!/usr/bin/env python3
+"""
+Minimal TPM attestation stub for constrained devices.
+This script demonstrates how a device could produce an attestation blob (PCRs) and post to MCP.
+In production you must use a proper TPM stack (tpm2-tools, TPM2 TSS) and secure provisioning.
+"""
+import os, json, time, subprocess, requests
+
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+DEVICE_ID = os.environ.get("DEVICE_ID", "iot-device-1")
+
+def read_pcrs():
+    # Best-effort: if tpm2_tools available, use them, otherwise return a fake value
+    try:
+        out = subprocess.check_output(["tpm2_pcrread", "sha256:0,1,2"], stderr=subprocess.DEVNULL)
+        return {"pcr": out.decode("utf-8")}
+    except Exception:
+        return {"pcr": "stubbed-pcr-value"}
+
+def post_attestation():
+    pcrs = read_pcrs()
+    payload = {"device_id": DEVICE_ID, "pcrs": pcrs, "ts": int(time.time())}
+    try:
+        requests.post(f"{AEGIS_MCP_API.rstrip('/')}/devices/{DEVICE_ID}/attest", json=payload, timeout=3.0)
+        print("Posted attestation to MCP")
+    except Exception as e:
+        print("Post failed:", e)
+
+if __name__ == "__main__":
+    post_attestation()
+
