+#!/usr/bin/env bash
+set -euo pipefail
+# This script is intended to run in CI and fail the job if direct Triton/vLLM calls are detected.
+# It can optionally create a PR comment using gh CLI to suggest using client_sdk.
+
+REPO=${GITHUB_REPOSITORY:-}
+PR=${PR_NUMBER:-}
+BAD=0
+for f in $(git ls-files '*.py' '*.js' '*.ts' | grep -v ops/serving/gateway); do
+  if grep -Iq "triton" "$f" || grep -Iq "v2/models" "$f" || grep -Iq "tritonclient" "$f"; then
+    echo "Direct Triton call found in $f"
+    BAD=1
+  fi
+done
+if [ "$BAD" -eq 1 ]; then
+  if command -v gh >/dev/null 2>&1 && [ -n "$PR" ]; then
+    gh pr comment "$PR" --body "Direct calls to Triton/vLLM detected. Please use ops/serving/gateway/client_sdk.py to ensure safety filtering is applied." || true
+  fi
+  echo "Direct Triton/vLLM calls detected, failing CI."
+  exit 2
+fi
+echo "No direct Triton usage detected."
+
