+name: Calibrate & Publish Thresholds
+on:
+  workflow_dispatch:
+  workflow_run:
+    workflows: ["Build & Publish Detector Image"]
+    types: [completed]
+jobs:
+  calibrate:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Setup Python
+        uses: actions/setup-python@v4
+        with:
+          python-version: "3.11"
+      - name: Install deps
+        run: pip install scikit-learn
+      - name: Run calibration (requires ops/fl/calibration/labeled.csv in repo)
+        run: |
+          if [ ! -f ops/fl/calibration/labeled.csv ]; then
+            echo "No labeled.csv found - aborting"
+            exit 0
+          fi
+          python3 ops/fl/calibration/calibrate_thresholds.py --input ops/fl/calibration/labeled.csv --out /tmp/thresholds.json
+          cat /tmp/thresholds.json
+      - name: Upload thresholds artifact
+        if: github.event.inputs.publish == 'true' || true
+        run: |
+          ARTIFACT_BASE="${{ secrets.ARTIFACT_BASE }}" || true
+          if command -v aws >/dev/null 2>&1 && [ -n "${{ secrets.ARTIFACT_BASE }}" ]; then
+            aws s3 cp /tmp/thresholds.json "${{ secrets.ARTIFACT_BASE }}/thresholds/thresholds-$(date -u +%Y%m%dT%H%M%SZ).json" || true
+          fi
