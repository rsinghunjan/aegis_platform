+#!/usr/bin/env python3
+"""
+ONNXRuntime wrapper to score text using exported toxicity.onnx model (if present).
+Falls back to heuristics if ONNX model missing.
+"""
+import os, json
+try:
+    import onnxruntime as ort
+except Exception:
+    ort = None
+def score_text(text):
+    model_path = "ops/agents/safety/models/toxicity/toxicity.onnx"
+    if ort and os.path.exists(model_path):
+        sess = ort.InferenceSession(model_path)
+        inp_name = sess.get_inputs()[0].name
+        res = sess.run(None, {inp_name: [text]})
+        # logistic regression returns probabilities; adapt accordingly
+        try:
+            prob = float(res[0][0][1])
+        except Exception:
+            prob = float(res[0][0]) if len(res[0][0])==1 else 0.0
+        return {"score": prob, "source":"onnx"}
+    # fallback heuristic
+    low = 0.95 if any(w in text.lower() for w in ["kill","bomb","poison"]) else 0.2 if "hate" in text.lower() else 0.0
+    return {"score": low, "source":"heuristic"}
+
+if __name__=="__main__":
+    import sys
+    t = " ".join(sys.argv[1:])
+    print(json.dumps(score_text(t)))
+
