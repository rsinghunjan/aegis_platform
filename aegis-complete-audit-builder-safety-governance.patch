+#!/usr/bin/env python3
+"""
+Train a lightweight toxicity classifier (TF-IDF + LogisticRegression) and export to ONNX via skl2onnx if available.
+Saves model (joblib) and onnx to ./models/toxicity/
+"""
+import os, argparse, joblib
+from sklearn.feature_extraction.text import TfidfVectorizer
+from sklearn.linear_model import LogisticRegression
+from sklearn.pipeline import Pipeline
+import json
+
+SAMPLE_DATA = [
+    {"text":"I will kill you","label":1},
+    {"text":"I hate you","label":1},
+    {"text":"I love this product","label":0},
+    {"text":"This is great","label":0}
+]
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--outdir", default="ops/agents/safety/models/toxicity")
+    args = p.parse_args()
+    os.makedirs(args.outdir, exist_ok=True)
+    texts = [x["text"] for x in SAMPLE_DATA]
+    labels = [x["label"] for x in SAMPLE_DATA]
+    pipe = Pipeline([("tfidf", TfidfVectorizer()), ("clf", LogisticRegression())])
+    pipe.fit(texts, labels)
+    joblib.dump(pipe, os.path.join(args.outdir,"toxicity.joblib"))
+    # try to export to ONNX if skl2onnx is available
+    try:
+        from skl2onnx import convert_sklearn
+        from skl2onnx.common.data_types import StringTensorType
+        onnx_model = convert_sklearn(pipe, "toxicity", initial_types=[('input', StringTensorType([None,1]))])
+        with open(os.path.join(args.outdir,"toxicity.onnx"), "wb") as f:
+            f.write(onnx_model.SerializeToString())
+        print("Exported toxicity.onnx")
+    except Exception:
+        print("skl2onnx not available; saved joblib model")
+    print("Toxicity classifier trained and saved to", args.outdir)
+
+if __name__=="__main__":
+    main()
+
