+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Comprehensive operator audit run:
+#  - Run NPU vendor smoke tests
+#  - Run iterative RT validator and RT SLO prover
+#  - Run HIL certification harness
+#  - Run Apalache formal triage & package reviewer bundle
+#  - Produce a single signed auditor bundle and optionally upload to S3
+#
+# Usage:
+#   COSIGN_KMS_URI=kms://... REKOR_SERVER=https://rekor.example S3_UPLOAD=s3://bucket/path \
+#     ./ops/operator/run_complete_audit.sh --node robot-host --out /tmp/aegis_audit
+
+NODE=localhost
+OUT_BASE=${OUT:-/tmp/aegis_complete_audit_$(date +%s)}
+S3_UPLOAD=${S3_UPLOAD:-}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+ATTEMPTS=${ATTEMPTS:-3}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --node) NODE="$2"; shift 2;;
+    --out) OUT_BASE="$2"; shift 2;;
+    --s3) S3_UPLOAD="$2"; shift 2;;
+    --attempts) ATTEMPTS="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+mkdir -p "$OUT_BASE"
+echo "Starting complete audit: node=$NODE out=$OUT_BASE"
+
+echo "[1] Run NPU vendor smoke tests (Inferentia/Graphcore/Habana)"
+python3 ops/hw/validation/npu_readiness_check.py || true
+cp /tmp/npu_readiness.json "$OUT_BASE/" 2>/dev/null || true
+cp /tmp/*_smoke.json "$OUT_BASE/" 2>/dev/null || true
+
+echo "[2] Run iterative RT validator (attempts=$ATTEMPTS)"
+./ops/robotics/rt/lab_validation/iterative_rt_validator.sh "$NODE" "$OUT_BASE/rt" "$ATTEMPTS" || true
+cp "$OUT_BASE/rt"* "$OUT_BASE/" 2>/dev/null || true
+
+echo "[3] Prove RT SLOs (p99 jitter and safe-stop)"
+python3 ops/robotics/rt/lab_validation/rt_slo_prover.py --bundle "${OUT_BASE}.tar.gz" --out "$OUT_BASE/rt_slo_proof.json" || true
+cp /tmp/rt_slo_proof.json "$OUT_BASE/" 2>/dev/null || true
+
+echo "[4] Run HIL certification harness (controller tests & contact injection)"
+python3 ops/robotics/control/certified/certification_harness.py --out "$OUT_BASE/cert" --cosign-key "${COSIGN_KMS_URI:-}" || true
+
+echo "[5] Run formal triage & package (Apalache)"
+./ops/formal/apalache_triage_runner.sh "$OUT_BASE/apalache" || true
+cp "$OUT_BASE/apalache"* "$OUT_BASE/" 2>/dev/null || true
+
+echo "[6] Run output-safety evaluation (adversarial + ensemble)"
+python3 ops/agents/safety/adversarial_eval.py --outdir "$OUT_BASE/adv_eval" || true
+python3 ops/agents/safety/eval_harness.py --in ops/agents/safety/ci/test_outputs.ndjson --outdir "$OUT_BASE/safety_eval" || true
+
+echo "[7] Collect CI & builder evidence (if produced)"
+# collect known evidence paths
+for f in /tmp/*evidence* /tmp/*evidence.json /tmp/rekor_search.json; do
+  [ -f "$f" ] && cp "$f" "$OUT_BASE/" || true
+done
+
+echo "[8] Package auditor bundle"
+BUNDLE="${OUT_BASE}.tar.gz"
+tar -czf "$BUNDLE" -C "$(dirname "$OUT_BASE")" "$(basename "$OUT_BASE")"
+echo "Created bundle: $BUNDLE"
+
+if [ -n "$COSIGN_KMS_URI" ]; then
+  echo "[9] Sign auditor bundle with cosign (KMS)"
+  cosign sign --key "$COSIGN_KMS_URI" "$BUNDLE" || true
+fi
+
+if [ -n "$S3_UPLOAD" ]; then
+  echo "[10] Upload auditor bundle to S3"
+  aws s3 cp "$BUNDLE" "$S3_UPLOAD" || true
+fi
+
+echo "[11] Record evidence manifest (best-effort)"
+python3 - <<PY || true
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("complete_audit_run", {"bundle":"$BUNDLE","node":"$NODE"})
+print("Recorded evidence manifest")
+PY
+
+echo "Complete audit finished. Bundle: $BUNDLE"
+
