+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Builder script for Inferentia: compile an ONNX model with neuron-cc (if available),
+# build a small builder image that includes compiled artifacts, push, cosign sign, and record Rekor entry.
+#
+MODEL=${MODEL:-ops/dl/inference/test_models/tiny_model.onnx}
+REGISTRY=${REGISTRY:-internal-registry/aegis}
+IMAGE_TAG=${IMAGE_TAG:-${REGISTRY}/builder-inferentia:latest}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+
+echo "Inferentia builder starting. MODEL=$MODEL IMAGE_TAG=$IMAGE_TAG"
+mkdir -p /workspace/artifacts
+
+if command -v neuron-cc >/dev/null 2>&1; then
+  echo "Compiling ONNX -> neuron artifact"
+  neuron-cc compile -s 1 -o /workspace/artifacts/model_neuron "$MODEL" || true
+else
+  echo "Neuron compiler not found; skipping compile"
+fi
+
+if [ -f /workspace/Dockerfile ]; then
+  echo "Building builder image"
+  docker build -t "$IMAGE_TAG" /workspace || true
+  echo "Pushing builder image"
+  docker push "$IMAGE_TAG" || true
+fi
+
+if [ -n "$COSIGN_KMS_URI" ]; then
+  echo "Signing image with cosign KMS"
+  cosign sign --key "$COSIGN_KMS_URI" "$IMAGE_TAG" || true
+fi
+
+echo "Inferentia builder finished. Artifacts under /workspace/artifacts"
+python3 - <<PY || true
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("builder_inferentia_run", {"image":"$IMAGE_TAG"})
+print("Recorded builder evidence")
+PY
