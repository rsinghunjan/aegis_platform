+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run the coverage scanner and produce a coverage report.
+# Usage:
+#   ./run_coverage_and_report.sh --kube-context myctx --namespace aegis-ml --upload-s3 s3://aegis-reports
+
+KUBE_CTX=""
+NAMESPACE=""
+S3_UPLOAD=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --kube-context) KUBE_CTX="$2"; shift 2;;
+    --namespace) NAMESPACE="$2"; shift 2;;
+    --upload-s3) S3_UPLOAD="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+OUT_DIR=$(mktemp -d)
+RAW="/tmp/aegis_coverage_raw.txt"
+REPORT="$OUT_DIR/aegis_coverage_report.json"
+
+echo "Running code + cluster coverage checks..."
+python3 ops/automation/deployment_coverage_check.py --kube-context "$KUBE_CTX" --namespace "$NAMESPACE" > "$RAW" || true
+
+echo "Generating JSON summary..."
+python3 - <<PY > "$REPORT"
+import json, time
+raw = open("$RAW").read() if __import__('os').path.exists("$RAW") else ""
+report = {
+  "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+  "raw_summary": raw[:32000],
+}
+print(json.dumps(report, indent=2))
+PY
+
+echo "Report written to $REPORT"
+
+if [ -n "$S3_UPLOAD" ]; then
+  if command -v aws >/dev/null 2>&1; then
+    echo "Uploading $REPORT to $S3_UPLOAD"
+    aws s3 cp "$REPORT" "${S3_UPLOAD}/aegis_coverage_report_$(date -u +%Y%m%dT%H%M%SZ).json" || echo "s3 upload failed"
+  else
+    echo "aws cli not available; cannot upload"
+  fi
+fi
+
+echo "Done. Please review $REPORT"
+
