+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: approver-signing-service-oidc
+  namespace: aegis-system
+spec:
+  replicas: 2
+  selector:
+    matchLabels:
+      app: approver-signing-service-oidc
+  template:
+    metadata:
+      labels:
+        app: approver-signing-service-oidc
+    spec:
+      containers:
+      - name: signing
+        image: <YOUR_REGISTRY>/aegis-approver-signing-oidc:latest
+        env:
+        - name: COSIGN_KMS_URI
+          valueFrom:
+            secretKeyRef:
+              name: cosign-kms-secret
+              key: kms_uri
+        - name: OIDC_INTROSPECTION_URL
+          valueFrom:
+            secretKeyRef:
+              name: oidc-config
+              key: introspection_url
+        - name: OIDC_INTROSPECTION_CLIENT_ID
+          valueFrom:
+            secretKeyRef:
+              name: oidc-config
+              key: client_id
+        - name: OIDC_INTROSPECTION_CLIENT_SECRET
+          valueFrom:
+            secretKeyRef:
+              name: oidc-config
+              key: client_secret
+        - name: APPROVER_SCOPE
+          value: "approver"
+        - name: APPROVER_AUDIT_LOG
+          value: "/var/log/aegis/approver_audit.log"
+        volumeMounts:
+        - name: audit-log
+          mountPath: /var/log/aegis
+      volumes:
+      - name: audit-log
+        emptyDir: {}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: approver-signing-oidc
+  namespace: aegis-system
+spec:
+  ports:
+  - port: 8086
+    targetPort: 8086
+  selector:
+    app: approver-signing-service-oidc
+
