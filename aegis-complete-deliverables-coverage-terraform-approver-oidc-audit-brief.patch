+provider "aws" {
+  region = var.aws_region
+}
+
+# Create a KMS key for cosign signing
+resource "aws_kms_key" "cosign" {
+  description             = "Cosign KMS key for signing detectors and artifacts"
+  deletion_window_in_days = 30
+}
+
+# Example IAM policy statement that grants Encrypt/Decrypt/Sign use to a specific principal (replace)
+data "aws_iam_policy_document" "allow_cosign_use" {
+  statement {
+    actions = [
+      "kms:Sign",
+      "kms:Verify",
+      "kms:DescribeKey",
+      "kms:GetPublicKey",
+    ]
+    resources = [aws_kms_key.cosign.arn]
+    principals {
+      type        = "AWS"
+      identifiers = [var.signer_principal_arn]
+    }
+  }
+}
+
+resource "aws_kms_key_policy" "placeholder" {
+  key_id = aws_kms_key.cosign.key_id
+  policy = data.aws_iam_policy_document.allow_cosign_use.json
+}
+
+output "kms_key_arn" {
+  value = aws_kms_key.cosign.arn
+}
+
