+#!/usr/bin/env python3
+"""
+Approver signing service (OIDC-protected, KMS-backed cosign)
+
+ - Validates incoming bearer token via OIDC introspection endpoint (or via public JWKS).
+ - Requires approver to have 'approver' scope (configurable via APPROVER_SCOPE).
+ - Signs the posted binary payload using cosign sign-blob with COSIGN_KMS_URI and returns hex signature.
+ - Appends an audit entry to an append-only audit log (rotating file) with timestamp, approver sub, and signature fingerprint.
+
+Security notes:
+ - This service is a mediator; in production place it behind ingress with mTLS and require OIDC authentication.
+ - COSIGN_KMS_URI must be restricted to this service via IAM/OIDC policy.
+"""
+import os, sys, time, logging, tempfile, subprocess, binascii, json
+from flask import Flask, request, jsonify
+import requests
+
+APP = Flask(__name__)
+logging.basicConfig(level=logging.INFO)
+
+# Config via env
+OIDC_INTROSPECTION = os.environ.get("OIDC_INTROSPECTION_URL", "")
+OIDC_CLIENT_ID = os.environ.get("OIDC_INTROSPECTION_CLIENT_ID", "")
+OIDC_CLIENT_SECRET = os.environ.get("OIDC_INTROSPECTION_CLIENT_SECRET", "")
+APPROVER_SCOPE = os.environ.get("APPROVER_SCOPE", "approver")
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI", "")
+AUDIT_LOG = os.environ.get("APPROVER_AUDIT_LOG", "/var/log/aegis/approver_audit.log")
+
+def introspect_token(token: str):
+    if not OIDC_INTROSPECTION:
+        return {"active": False}
+    try:
+        r = requests.post(OIDC_INTROSPECTION, data={"token": token}, auth=(OIDC_CLIENT_ID, OIDC_CLIENT_SECRET), timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        logging.exception("introspection failed")
+        return {"active": False}
+
+def record_audit(entry: dict):
+    try:
+        os.makedirs(os.path.dirname(AUDIT_LOG), exist_ok=True)
+        with open(AUDIT_LOG, "a") as fh:
+            fh.write(json.dumps(entry, separators=(",",":" )) + "\n")
+    except Exception:
+        logging.exception("audit log write failed")
+
+@APP.route("/sign", methods=["POST"])
+def sign_blob():
+    auth = request.headers.get("Authorization", "")
+    if not auth.startswith("Bearer "):
+        return jsonify({"ok": False, "error": "missing_bearer"}), 401
+    token = auth.split(" ",1)[1]
+    info = introspect_token(token)
+    if not info.get("active"):
+        return jsonify({"ok": False, "error": "invalid_token"}), 401
+    # Check scope / role
+    scopes = info.get("scope","")
+    if APPROVER_SCOPE not in scopes.split():
+        return jsonify({"ok": False, "error": "insufficient_scope"}), 403
+    approver = info.get("sub") or info.get("username") or info.get("email") or "unknown"
+    data = request.get_data()
+    if not data:
+        return jsonify({"ok": False, "error": "empty_payload"}), 400
+    # write payload to temp file and call cosign sign-blob
+    with tempfile.NamedTemporaryFile(delete=False) as bfh:
+        bfh.write(data)
+        bpath = bfh.name
+    sigpath = bpath + ".sig"
+    try:
+        if not COSIGN_KEY:
+            return jsonify({"ok": False, "error": "cosign_kms_not_configured"}), 500
+        cmd = ["cosign", "sign-blob", "--key", COSIGN_KEY, "--output-signature", sigpath, bpath]
+        subprocess.check_call(cmd, timeout=30)
+        with open(sigpath, "rb") as fh:
+            sig = fh.read()
+        hex_sig = binascii.hexlify(sig).decode()
+        # record audit entry (minimal)
+        entry = {"ts": time.time(), "approver": approver, "sig_len": len(sig), "payload_sha256": subprocess.check_output(["sha256sum", bpath]).decode().split()[0]}
+        record_audit(entry)
+        return jsonify({"ok": True, "signature_hex": hex_sig})
+    except subprocess.CalledProcessError:
+        logging.exception("cosign sign-blob failed")
+        return jsonify({"ok": False, "error": "signing_failed"}), 500
+    finally:
+        try:
+            os.unlink(bpath)
+            if os.path.exists(sigpath):
+                os.unlink(sigpath)
+        except Exception:
+            pass
+
+if __name__=="__main__":
+    APP.run(host="0.0.0.0", port=int(os.environ.get("PORT","8086")))
+
