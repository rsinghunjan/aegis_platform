+#!/usr/bin/env python3
+"""
+Create PRs that propose injecting safety_monitor.check_and_allow into detected autonomous entrypoints.
+ - Uses ops/autonomy/inject_safety_monitor.py to generate patched files into 'patched/'
+ - For each top-level package modified, creates a branch, commits patched files, pushes and opens a PR using gh.
+
+Usage:
+  python3 ops/autonomy/create_injection_prs.py --paths services/fl services/models --branch-prefix inject-safety
+
+Requires:
+  - git configured
+  - gh (GitHub CLI) authenticated
+"""
+import argparse
+import subprocess
+import os
+from pathlib import Path
+
+def run_cmd(cmd, cwd=None):
+    subprocess.check_call(cmd, shell=True, cwd=cwd)
+
+def create_pr_for_path(path, branch_prefix):
+    # run injector
+    run_cmd(f"python3 ops/autonomy/inject_safety_monitor.py --paths {path} --out patched")
+    # determine changed files in patched/
+    patched_dir = Path("patched")
+    if not patched_dir.exists():
+        print("No patched files generated for", path)
+        return
+    branch = f"{branch_prefix}/{Path(path).name}"
+    run_cmd(f"git checkout -b {branch}")
+    # copy patched files into repo (overwriting originals) but commit only patched changes
+    for pf in patched_dir.rglob("*.py"):
+        dest = Path(pf.name)
+        run_cmd(f"cp {pf} {dest}")
+        run_cmd(f"git add {dest}")
+    run_cmd(f"git commit -m 'chore: inject safety_monitor checks into {path} (automated)' || true")
+    run_cmd(f"git push --set-upstream origin {branch}")
+    # open PR
+    try:
+        run_cmd(f"gh pr create --title 'chore: inject safety checks into {path}' --body 'Automated patch to add runtime safety checks. Please review.' --base main --head {branch}")
+    except Exception as e:
+        print("gh pr create failed:", e)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--paths", nargs="+", required=True)
+    p.add_argument("--branch-prefix", default="inject-safety")
+    args = p.parse_args()
+    for path in args.paths:
+        create_pr_for_path(path, args.branch_prefix)
+
+if __name__=="__main__":
+    main()
+
