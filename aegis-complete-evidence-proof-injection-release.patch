+#!/usr/bin/env python3
+"""
+Full-featured Z3 BMC model for Aegis safety:
+ - Models per-modality DP epsilon accounting and composition.
+ - Models per-action Rekor registration boolean.
+ - Enforces global epsilon budget and per-action evidence requirements.
+
+Usage:
+  python3 tools/formal/z3_bmc_full.py --depth 6
+"""
+import argparse
+from z3 import Int, Bool, Solver, And, Or, Not, sat
+import json
+
+MODALITIES = ["image", "text"]
+ACTIONS = ["canary_promote", "kms_alias_swap", "model_promote", "fl_round"]
+REQ_KMS_APPROVALS = 2
+GLOBAL_EPSILON_BUDGET = 100  # scaled integer (e.g., epsilon*100)
+
+def mk_state(i):
+    state = {
+        "rekor_reg": {a: Bool(f"rekor_{a}_{i}") for a in ACTIONS},
+        "evidence_coverage": Int(f"evidence_{i}"),
+        "dp_eps": {m: Int(f"eps_{m}_{i}") for m in MODALITIES},
+        "dp_eps_sum": Int(f"eps_sum_{i}"),
+        "approvals_kms": Int(f"approvals_kms_{i}"),
+        "mpc_enabled": Bool(f"mpc_enabled_{i}")
+    }
+    return state
+
+def transition(s, s_next, act):
+    constraints = []
+    # evidence coverage bounds
+    constraints.append(And(s_next["evidence_coverage"] >= 0, s_next["evidence_coverage"] <= 100))
+    # eps nonnegative
+    for m in MODALITIES:
+        constraints.append(s_next["dp_eps"][m] >= 0)
+    constraints.append(s_next["dp_eps_sum"] >= 0)
+    constraints.append(s_next["approvals_kms"] >= 0)
+    # Rekor flags persist or become true
+    for a in ACTIONS:
+        constraints.append(Or(s_next["rekor_reg"][a] == s["rekor_reg"][a], s_next["rekor_reg"][a] == True))
+
+    if act == "canary_promote":
+        constraints.append(s_next["evidence_coverage"] == s["evidence_coverage"])
+        constraints.append(s_next["dp_eps_sum"] == s["dp_eps_sum"])
+        constraints.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+    elif act == "kms_alias_swap":
+        constraints.append(s["approvals_kms"] >= REQ_KMS_APPROVALS)
+        constraints.append(s_next["evidence_coverage"] == 100)
+        constraints.append(s_next["rekor_reg"]["kms_alias_swap"] == True)
+        constraints.append(s_next["dp_eps_sum"] == s["dp_eps_sum"])
+    elif act == "model_promote":
+        constraints.append(s_next["evidence_coverage"] == 100)
+        constraints.append(s_next["rekor_reg"]["model_promote"] == True)
+        constraints.append(s_next["dp_eps_sum"] == s["dp_eps_sum"])
+    elif act == "fl_round":
+        # choose per-modality eps increments (0..10 each)
+        for m in MODALITIES:
+            eps = Int(f"eps_{m}")
+            constraints.append(And(eps >= 0, eps <= 10))
+            constraints.append(s_next["dp_eps"][m] == s["dp_eps"][m] + eps)
+        constraints.append(s_next["dp_eps_sum"] == s["dp_eps_sum"] + sum([Int(f"eps_{m}") for m in MODALITIES]))
+    return And(*constraints)
+
+def safety(s):
+    # total epsilon constraint and evidence relation
+    total_eps = s["dp_eps_sum"]
+    # If an action is rekor-registered then evidence_coverage must be 100
+    ev_ok = And([Or(Not(s["rekor_reg"][a]), s["evidence_coverage"] == 100) for a in ACTIONS])
+    return And(total_eps <= GLOBAL_EPSILON_BUDGET, ev_ok)
+
+def run(depth=6):
+    states = [mk_state(i) for i in range(depth+1)]
+    solver = Solver()
+    # initial state constraints
+    solver.add(states[0]["evidence_coverage"] == 100)
+    for m in MODALITIES:
+        solver.add(states[0]["dp_eps"][m] == 0)
+    solver.add(states[0]["dp_eps_sum"] == 0)
+    solver.add(states[0]["approvals_kms"] >= 0)
+    solver.add(states[0]["mpc_enabled"] == False)
+    for a in ACTIONS:
+        solver.add(states[0]["rekor_reg"][a] == True)
+
+    # transitions
+    for i in range(depth):
+        solver.add(Or(*[transition(states[i], states[i+1], act) for act in ACTIONS]))
+
+    # look for safety violation anywhere
+    bads = [Not(safety(states[i])) for i in range(depth+1)]
+    solver.add(Or(*bads))
+
+    if solver.check() == sat:
+        m = solver.model()
+        trace = []
+        for i in range(depth+1):
+            st = {"evidence": m.eval(states[i]["evidence_coverage"]).as_long() if m.eval(states[i]["evidence_coverage"]) is not None else None,
+                  "dp_eps_sum": m.eval(states[i]["dp_eps_sum"]).as_long() if m.eval(states[i]["dp_eps_sum"]) is not None else None,
+                  "approvals_kms": m.eval(states[i]["approvals_kms"]).as_long() if m.eval(states[i]["approvals_kms"]) is not None else None,
+                  "mpc_enabled": bool(m.eval(states[i]["mpc_enabled"])) if m.eval(states[i]["mpc_enabled"]) is not None else None,
+                  "rekor": {a: bool(m.eval(states[i]["rekor_reg"][a])) for a in ACTIONS}
+                  }
+            trace.append(st)
+        print("Counterexample trace:")
+        print(json.dumps(trace, indent=2))
+        return {"sat": True, "trace": trace}
+    else:
+        print("No counterexample found up to depth", depth)
+        return {"sat": False}
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--depth", type=int, default=6)
+    args = p.parse_args()
+    run(args.depth)
+
