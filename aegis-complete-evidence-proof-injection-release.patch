+#!/usr/bin/env python3
+"""
+Generate a one-page evidence summary (Markdown) suitable for stakeholders and auditors.
+ - Collects Level‑4 verification report, audit_status, Rekor UUIDs (from evidence index), and key KPIs.
+ - Produces docs/evidence_summary.md, a signed copy (cosign) and an archive uploaded to evidence S3 and registered with Rekor.
+
+Usage:
+  python3 ops/verify/generate_evidence_summary.py --out docs/evidence_summary.md
+
+Requires:
+  - EVIDENCE_BUCKET (optional) to upload
+  - COSIGN_KMS_URI (optional) to sign
+  - rekor-cli (optional) to register
+"""
+import argparse
+import json
+import yaml
+import os
+import time
+from pathlib import Path
+import subprocess
+
+OUT = Path("docs/evidence_summary.md")
+REPORT = Path("/tmp/level4_verification_report.json")
+AUDIT = Path("config/audit_status.yaml")
+EVIDENCE_INDEX = Path("ops/verify/evidence_index.json")  # optional, produced by evidence pipeline
+
+def load_json(path):
+    try:
+        return json.load(open(path))
+    except Exception:
+        return {}
+
+def load_yaml(path):
+    try:
+        return yaml.safe_load(open(path))
+    except Exception:
+        return {}
+
+def render_summary():
+    lines = []
+    lines.append("# Aegis Production Evidence Summary")
+    lines.append("")
+    lines.append(f"Generated: {time.asctime()}")
+    lines.append("")
+    # Level4 report summary
+    if REPORT.exists():
+        j = load_json(REPORT)
+        lines.append("## Level‑4 Verification")
+        summary = j.get("summary", {})
+        lines.append(f"- Overall: {summary.get('overall', 'unknown')}")
+        lines.append(f"- Evidence coverage: {j.get('details',{}).get('reparsed_report',{}).get('evidence_coverage','?')}")
+    else:
+        lines.append("Level‑4 verification report not found (expected /tmp/level4_verification_report.json)")
+    lines.append("")
+    # Audit status
+    a = load_yaml(AUDIT) if AUDIT.exists() else {}
+    lines.append("## Audit Status")
+    if a:
+        for k,v in a.items():
+            lines.append(f"- {k}: approved={v.get('approved')} report={v.get('report_s3') or '<none>'} rekor={v.get('rekor_uuid') or '<none>'}")
+    else:
+        lines.append("- No audit status file found (config/audit_status.yaml)")
+    lines.append("")
+    # Evidence inventory (best-effort)
+    lines.append("## Evidence Inventory (highlights)")
+    idx = load_json(EVIDENCE_INDEX) if EVIDENCE_INDEX.exists() else {}
+    if idx:
+        for k,v in idx.get("items", [])[:20]:
+            lines.append(f"- {k}: {v}")
+    else:
+        lines.append("- No evidence index found (ops/verify/evidence_index.json)")
+    lines.append("")
+    # KPIs (if available via env or Prometheus)
+    lines.append("## KPIs (sample)")
+    lines.append(f"- Evidence coverage (daily): {j.get('details',{}).get('reparsed_report',{}).get('evidence_coverage','?') if REPORT.exists() else 'unknown'}")
+    lines.append("")
+    # Links & next steps
+    lines.append("## Links & Next Steps")
+    lines.append("- Full evidence bundle: S3 evidence bucket (see config or ops)")
+    lines.append("- For MPC: ensure config/audit_status.yaml shows mpc_crypto_audit.approved=true or DP-first signed approval issue exists.")
+    lines.append("- Contact: security@your-org (replace with your security mailbox)")
+    return "\n".join(lines)
+
+def sign_and_publish(path, evidence_bucket=None):
+    tar = f"{path}.tar.gz"
+    subprocess.run(["tar", "-czf", tar, "--", path], check=False)
+    if os.environ.get("COSIGN_KMS_URI"):
+        try:
+            subprocess.run(["cosign","sign-blob","--key",os.environ["COSIGN_KMS_URI"], tar], check=False)
+        except Exception:
+            pass
+    if evidence_bucket:
+        try:
+            subprocess.run(["aws","s3","cp", tar, f"s3://{evidence_bucket.rstrip('/')}/evidence_summaries/{Path(tar).name}"], check=False)
+        except Exception:
+            pass
+    if shutil_which("rekor-cli"):
+        try:
+            subprocess.run(["rekor-cli","upload","--artifact", tar], check=False)
+        except Exception:
+            pass
+
+def shutil_which(cmd):
+    from shutil import which
+    return which(cmd) is not None
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", default=str(OUT))
+    args = p.parse_args()
+    content = render_summary()
+    Path(args.out).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.out).write_text(content)
+    print("Wrote evidence summary to", args.out)
+    sign_and_publish(args.out, os.environ.get("EVIDENCE_BUCKET"))
+
+if __name__=="__main__":
+    main()
+
