+#!/usr/bin/env python3
+"""
+Simple adapter to forward Alertmanager JSON to PagerDuty Events v2 API.
+Intended as a small webhook receiver; in production, use a hardened service or PagerDuty alertmanager integration.
+"""
+from flask import Flask, request, jsonify
+import os
+import requests
+
+PD_ROUTING_KEY = os.environ.get("PAGERDUTY_ROUTING_KEY", "")
+app = Flask(__name__)
+
+@app.route("/alert", methods=["POST"])
+def alert():
+    data = request.get_json()
+    if not PD_ROUTING_KEY:
+        return jsonify({"error":"no routing key configured"}), 500
+    title = data.get("alerts",[{}])[0].get("annotations", {}).get("summary","Aegis alert")
+    payload = {
+        "routing_key": PD_ROUTING_KEY,
+        "event_action": "trigger",
+        "payload": {
+            "summary": title,
+            "source": "aegis",
+            "severity": "critical"
+        }
+    }
+    r = requests.post("https://events.pagerduty.com/v2/enqueue", json=payload, timeout=10)
+    return jsonify({"status": r.status_code, "resp": r.text}), r.status_code
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8085")))
+
