+#!/usr/bin/env bash
+#
+# Verify self-hosted ownership of critical infra: Rekor, KMS alias, Vault, Prometheus, Grafana, Terraform outputs
+#
+set -euo pipefail
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+REKOR_URL=${REKOR_SERVER:-}
+AWS_PROFILE=${AWS_PROFILE:-}
+
+echo "Checking Rekor endpoint: ${REKOR_URL:-<not-set>}"
+if [ -n "$REKOR_URL" ]; then
+  curl -fsS "${REKOR_URL}/health" || echo "Rekor health check failed (verify URL/credentials)"
+else
+  echo "REKOR_SERVER not set"
+fi
+
+echo "Checking KMS alias alias/aegis/cosign"
+aws kms list-aliases --query "Aliases[?AliasName=='alias/aegis/cosign']" || echo "KMS alias lookup failed"
+
+echo "Checking Vault reachable (VAULT_ADDR)"
+if [ -n "${VAULT_ADDR:-}" ]; then
+  curl -fsS "${VAULT_ADDR}/v1/sys/health" || echo "Vault health check failed"
+else
+  echo "VAULT_ADDR not set"
+fi
+
+echo "Checking Prometheus / Grafana endpoints (best-effort)"
+if [ -n "${PROM_URL:-}" ]; then
+  curl -fsS "${PROM_URL}/-/ready" || echo "Prometheus ready check failed"
+fi
+if [ -n "${GRAFANA_URL:-}" ]; then
+  curl -fsS "${GRAFANA_URL}/api/health" || echo "Grafana health check failed"
+fi
+
+echo "Checking Terraform outputs (if terraform.tfstate present)"
+if [ -f terraform/terraform.tfstate ]; then
+  jq '.outputs' terraform/terraform.tfstate || true
+else
+  echo "No terraform state found locally; consider running 'terraform output' in your infra repo"
+fi
+
+echo "Self-hosted infra verification completed (best-effort)."
