+#!/usr/bin/env python3
+"""
+Shamir threshold share wrapper (optional dependency).
+This file provides a small abstraction for splitting/combining secrets using 'secretsharing' if available.
+It is intended as a helper for MPC key distribution and not the MPC protocol itself.
+"""
+try:
+    from secretsharing import PlaintextToHexSecretSharer as _Shamir
+except Exception:
+    _Shamir = None
+
+def split_secret(secret, k, n):
+    if _Shamir is None:
+        raise RuntimeError("secretsharing library not installed; pip install secretsharing")
+    hex_secret = secret.encode().hex()
+    shares = _Shamir.split_secret(hex_secret, k, n)
+    return shares
+
+def recover_secret(shares):
+    if _Shamir is None:
+        raise RuntimeError("secretsharing library not installed; pip install secretsharing")
+    hex_secret = _Shamir.recover_secret(shares)
+    return bytes.fromhex(hex_secret).decode()
+
