+#!/usr/bin/env python3
+"""
+Simulate autonomous decision flows against OPA and record evidence for each decision.
+ - Configurable scenario file lists actions to attempt.
+ - For auto decisions, produce signed manifest + Rekor entry via ops/evidence/evidence_enforcer.py
+ - For gated decisions, create MOFN request stub (simulate) and record request manifest.
+"""
+import os
+import json
+import time
+import subprocess
+from services.policy.opa.opa_client import evaluate
+
+MOFN_URL = os.environ.get("MOFN_URL", "http://mofn.local")
+EVIDENCE_ENFORCER = os.path.join(os.path.dirname(__file__), "..", "evidence", "evidence_enforcer.py")
+
+def record_manifest(action, decision, payload=None, prefix="autonomy"):
+    ts = int(time.time())
+    manifest = {"action": action, "decision": decision, "payload": payload or {}, "ts": ts}
+    out = f"/tmp/autonomy_{action}_{ts}.json"
+    with open(out, "w") as fh:
+        json.dump(manifest, fh)
+    try:
+        subprocess.check_call(["python3", EVIDENCE_ENFORCER, out, prefix])
+    except Exception as e:
+        print("Warning: evidence enforcer failed:", e)
+    return out
+
+def simulate(scenario):
+    for act in scenario:
+        print("Evaluating", act)
+        dec = evaluate(act)
+        print("OPA decision:", dec)
+        if dec.get("allow"):
+            print("Auto-performing action", act)
+            record_manifest(act, "auto")
+        else:
+            # simulate MOFN request creation
+            req_id = f"sim-{act}-{int(time.time())}"
+            record_manifest(act, "mofn_requested", {"request_id": req_id})
+            print("MOFN requested:", req_id)
+
+if __name__ == "__main__":
+    import sys
+    scenario = sys.argv[1:] or ["canary_promote", "canary_rollback", "kms_alias_swap", "model_promote"]
+    simulate(scenario)
+
