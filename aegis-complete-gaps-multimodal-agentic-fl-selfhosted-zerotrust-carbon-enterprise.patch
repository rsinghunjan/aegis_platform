+#!/usr/bin/env python3
+"""
+Image preprocessing for multimodal pipeline.
+ - Loads local image or downloads HTTP(S) image (best-effort).
+ - Resizes, normalizes and stores a compact numpy representation.
+"""
+import os
+from PIL import Image
+import numpy as np
+import requests
+from io import BytesIO
+
+def download_image(src):
+    if src.startswith("http://") or src.startswith("https://"):
+        r = requests.get(src, timeout=10)
+        r.raise_for_status()
+        return Image.open(BytesIO(r.content)).convert("RGB")
+    return Image.open(src).convert("RGB")
+
+def preprocess_image(src, out_path, size=(64,64)):
+    img = download_image(src)
+    img = img.resize(size)
+    arr = (np.array(img).astype("float32") / 255.0).astype("float32")
+    # store compressed npz
+    np.savez_compressed(out_path, image=arr)
+    return out_path
+
+if __name__ == "__main__":
+    import sys
+    preprocess_image(sys.argv[1], sys.argv[2])
+
