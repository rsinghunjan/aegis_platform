+#!/usr/bin/env bash
+set -euo pipefail
+# Validate PGP-signed approval artifact and persist minimal evidence to MCP (best-effort)
+# Usage: ./pgp_validate_and_record.sh /path/to/approval.asc <ticket-id>
+
+APPROVAL=${1:-}
+TICKET=${2:-ticket-unknown}
+MCP_URL=${MCP_URL:-http://mcp.mcp.svc.cluster.local:8000}
+
+if [ -z "$APPROVAL" ] || [ ! -f "$APPROVAL" ]; then
+  echo "Provide path to PGP-signed approval artifact"
+  exit 2
+fi
+
+echo "Validating PGP signature locally..."
+if gpg --verify "$APPROVAL" >/dev/null 2>&1; then
+  echo "Signature valid. Extracting summary..."
+  SUMMARY=$(gpg --status-fd=1 --verify "$APPROVAL" 2>&1 | head -n 40 | tr -d '\n' | sed 's/"/\\"/g')
+  echo "Persisting minimal evidence to MCP..."
+  PAYLOAD="{\"schema_version\":\"1.1\",\"model_id\":\"aegis-operator-approval\",\"version\":\"v1\",\"llm_call\":{\"ticket\":\"$TICKET\",\"approval_summary\":\"$SUMMARY\"}}"
+  curl -sS -X POST -H "Content-Type: application/json" -d "$PAYLOAD" ${MCP_URL}/model-context || echo "Failed to persist to MCP"
+else
+  echo "PGP validation failed. DO NOT PROCEED"
+  exit 3
+fi
+
