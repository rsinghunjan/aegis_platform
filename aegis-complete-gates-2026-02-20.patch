+#!/usr/bin/env bash
+#
+# AWS CloudHSM commissioning & operator CLI guide (interactive)
+# This script is an operator helper; it does not automate privileged operations fully —
+# operators must run steps in a bastion with CloudHSM client installed.
+#
+# Usage:
+#   ./aws_cloudhsm_cli_guide.sh <cluster-id>
+#
+set -euo pipefail
+
+CLUSTER_ID=${1:-}
+if [ -z "$CLUSTER_ID" ]; then
+  echo "Usage: $0 <cloudhsm-cluster-id>"
+  exit 2
+fi
+
+echo "1) Ensure you run this from a bastion with CloudHSM client tooling (cloudhsm_mgmt_util) installed."
+echo
+echo "2) Initialize the cluster (run once as privileged admin):"
+echo "   sudo cloudhsm_mgmt_util -e createUser -u admin -p '<strong-password>' -r admin"
+echo "   # Follow vendor docs to complete cluster init and certificate exchange"
+
+echo
+echo "3) Create operator accounts (OperatorA, OperatorB). These are cloud-facing principals that will be used for dual-control."
+echo "   Example CloudHSM steps (placeholder):"
+echo "   sudo cloudhsm_mgmt_util -e createUser -u operatorA -p '<opA-pass>' -r operator"
+echo "   sudo cloudhsm_mgmt_util -e createUser -u operatorB -p '<opB-pass>' -r operator"
+
+echo
+echo "4) Create key in HSM (Operator A). Either generate inside HSM or import wrapped key as per vendor instructions."
+echo "   Example (pseudo):"
+echo "     cloudhsm-cli create-key --label aegis-transit-key --type RSA --size 4096"
+echo "   Save fingerprint: cloudhsm-cli key-fingerprint --label aegis-transit-key > /tmp/aegis-transit-key.fp"
+
+echo
+echo "5) Operator B: independently verify fingerprint and produce signed approval artifact (PGP-signed file)."
+echo "   Example:"
+echo "     gpg --clearsign --output /tmp/aegis-transit-key.approval /tmp/aegis-transit-key.fp"
+
+echo
+echo "6) Operator A: finalize activation referencing Operator B approval (vendor-specific command)."
+echo "   vendor example (placeholder): cloudhsm-cli activate-key --label aegis-transit-key --approval /tmp/aegis-transit-key.approval"
+
+echo
+echo "7) Verify via Vault: ensure Vault has PKCS#11 lib and transit key uses HSM as key source (see vault/scripts/test_sign_with_vault.sh)."
+echo
+echo "Important: capture all CLI outputs and place into ticketing system. Keep approval artifacts in evidence store and do NOT commit secrets to git."
