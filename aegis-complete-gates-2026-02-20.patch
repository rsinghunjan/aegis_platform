+#!/usr/bin/env python3
+"""
+Script to block AUTO mode by creating block file and patching ConfigMap.
+Unblock after verification of fix removes the block file and record evidence.
+"""
+import os, sys, json, subprocess
+
+BLOCK_FILE = "/tmp/aegis_pentest_block.json"
+CONFIGMAP = os.environ.get("AGENT_CFG","aegis-agent-control")
+NAMESPACE = os.environ.get("NAMESPACE","ml")
+
+def block(reason="critical/high pentest findings"):
+    with open(BLOCK_FILE,"w") as f:
+        json.dump({"blocked": True, "reason": reason}, f)
+    print("Created block file:", BLOCK_FILE)
+    # also ensure PAUSED if currently AUTO
+    subprocess.run(["kubectl","-n",NAMESPACE,"patch","configmap",CONFIGMAP,"-p","{\"data\":{\"mode\":\"PAUSED\"}}"], check=False)
+
+def unblock():
+    if os.path.exists(BLOCK_FILE):
+        os.remove(BLOCK_FILE)
+    print("Removed block file. NOTE: governance must re-enable AUTO via dual-control.")
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("Usage: auto_block_and_unblock.py block|unblock [reason]")
+        sys.exit(2)
+    cmd = sys.argv[1]
+    if cmd == "block":
+        reason = sys.argv[2] if len(sys.argv) > 2 else "critical/high pentest findings"
+        block(reason)
+    else:
+        unblock()
+
