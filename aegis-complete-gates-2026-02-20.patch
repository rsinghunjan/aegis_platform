*** Add File:governance/dual_control/dual_control_verify_gpg.py
+#!/usr/bin/env python3
+"""
+Verify PGP signatures for dual-control artifacts and ensure they are from expected operator keys.
+Requires local GPG keyring having operator public keys imported.
+Usage: python3 dual_control_verify_gpg.py /path/opA.asc /path/opB.asc
+"""
+import sys, subprocess, json
+
+def verify(path):
+    try:
+        out = subprocess.check_output(["gpg","--status-fd=1","--verify", path], stderr=subprocess.STDOUT)
+        return True, out.decode()
+    except subprocess.CalledProcessError as e:
+        return False, e.output.decode()
+
+if __name__=="__main__":
+    if len(sys.argv) < 3:
+        print("Usage: dual_control_verify_gpg.py opA.asc opB.asc")
+        sys.exit(2)
+    a = sys.argv[1]; b = sys.argv[2]
+    ok_a, out_a = verify(a)
+    ok_b, out_b = verify(b)
+    print(json.dumps({"opA":{"ok":ok_a,"out":out_a[:1000]},"opB":{"ok":ok_b,"out":out_b[:1000]}}))
+    if not (ok_a and ok_b):
+        sys.exit(3)
+    print("Both signatures verified.")
+
