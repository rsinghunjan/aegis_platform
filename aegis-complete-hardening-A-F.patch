+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: aegis-admission-webhook
+  namespace: ml-serving
+spec:
+  replicas: 2
+  selector:
+    matchLabels:
+      app: aegis-admission-webhook
+  template:
+    metadata:
+      labels:
+        app: aegis-admission-webhook
+    spec:
+      serviceAccountName: sandbox-runner
+      containers:
+        - name: webhook
+          image: your-registry/aegis-admission-webhook:latest
+          imagePullPolicy: IfNotPresent
+          env:
+            - name: COSIGN_PUBKEY
+              value: "/etc/webhook/cosign/pubkey.pem"
+            - name: ALLOWED_RUNTIMES
+              value: "runsc,kata"
+            - name: PROTECTED_NAMESPACES
+              value: "ml-serving"
+          ports:
+            - containerPort: 9443
+          volumeMounts:
+            - name: webhook-certs
+              mountPath: /etc/webhook/certs
+              readOnly: true
+            - name: cosign-key
+              mountPath: /etc/webhook/cosign
+              readOnly: true
+      volumes:
+        - name: webhook-certs
+          secret:
+            secretName: webhook-tls
+        - name: cosign-key
+          secret:
+            secretName: aegis-cosign-pubkey
