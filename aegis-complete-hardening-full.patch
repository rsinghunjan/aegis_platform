+#!/usr/bin/env python3
+import random
+try:
+    from qiskit import QuantumCircuit, Aer, execute
+    _HAS_QISKIT = True
+except Exception:
+    _HAS_QISKIT = False
+def _mock_simulator(circuit_desc, shots=1024):
+    counts={}
+    n=circuit_desc.get("n_qubits",1)
+    for _ in range(shots):
+        out=format(random.getrandbits(n), f'0{n}b'); counts[out]=counts.get(out,0)+1
+    return {"counts":counts,"shots":shots}
+def run_simulator(circuit_desc, shots=1024):
+    if _HAS_QISKIT:
+        n=circuit_desc.get("n_qubits",1); qc=QuantumCircuit(n,n)
+        for op in circuit_desc.get("ops",[]): 
+            gate=op.get("gate"); qs=op.get("qubits",[])
+            if gate.lower()=="h": qc.h(qs[0])
+            elif gate.lower()=="x": qc.x(qs[0])
+            elif gate.lower()=="cx" and len(qs)>=2: qc.cx(qs[0],qs[1])
+        qc.measure(range(n), range(n))
+        backend=Aer.get_backend('qasm_simulator'); job=execute(qc, backend=backend, shots=shots); res=job.result().get_counts(); return {"counts":res,"shots":shots}
+    else:
+        return _mock_simulator(circuit_desc, shots=shots)
