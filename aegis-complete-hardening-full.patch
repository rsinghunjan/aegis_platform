+#!/usr/bin/env python3
+import os, json
+from typing import Dict, Any
+from langdetect import detect as lang_detect
+DEFAULT_MODEL = os.environ.get("MOD_TEXT_MODEL","unitary/toxic-bert")
+LANG_MODELS = {}
+_pipes: Dict[str, Any] = {}
+def _load_pipe(model_name):
+    from transformers import pipeline
+    try: return pipeline("text-classification", model=model_name)
+    except Exception: return None
+def get_pipe_for_text(text: str):
+    try: lang = lang_detect(text)
+    except Exception: lang="en"
+    model_name = LANG_MODELS.get(lang, DEFAULT_MODEL)
+    if model_name not in _pipes: _pipes[model_name] = _load_pipe(model_name)
+    return _pipes.get(model_name)
+def moderate_text(text: str, threshold: float = 0.6):
+    pipe = get_pipe_for_text(text)
+    if not pipe:
+        return {"allowed": True, "score": 0.0, "label": "UNKNOWN"}
+    out = pipe(text, truncation=True)
+    label = out[0].get("label","UNKNOWN"); score=float(out[0].get("score",0.0))
+    allowed = not (score > threshold and label.lower() in ("toxic","insult","threat","offensive"))
+    return {"allowed":allowed,"score":score,"label":label}
+def calibrate_text_thresholds(dataset_jsonl: str, out_json: str):
+    import numpy as np
+    scores_by_model={}; labels_by_model={}
+    with open(dataset_jsonl) as f:
+        for line in f:
+            j=json.loads(line); text=j["text"]; lab=int(j["label"])
+            pipe=get_pipe_for_text(text); model=pipe.model.name_or_path if pipe else DEFAULT_MODEL
+            out = pipe(text, truncation=True) if pipe else [{"score":0.0}]
+            sc=float(out[0].get("score",0.0))
+            scores_by_model.setdefault(model,[]).append(sc)
+            labels_by_model.setdefault(model,[]).append(lab)
+    results={}
+    for m,scores in scores_by_model.items():
+        labs=labels_by_model[m]; best_t,best_f1=0.5,0.0
+        for t in np.linspace(0.1,0.9,81):
+            preds=[1 if s>t else 0 for s in scores]
+            tp=sum(1 for p,l in zip(preds,labs) if p==1 and l==1)
+            fp=sum(1 for p,l in zip(preds,labs) if p==1 and l==0)
+            fn=sum(1 for p,l in zip(preds,labs) if p==0 and l==1)
+            prec=tp/(tp+fp+1e-9); rec=tp/(tp+fn+1e-9); f1=2*prec*rec/(prec+rec+1e-9)
+            if f1>best_f1: best_f1,f1; best_t=t; best_f1=f1
+        results[m]={"threshold":best_t,"f1":best_f1}
+    with open(out_json,"w") as f: json.dump(results,f,indent=2)
+    return results
+
