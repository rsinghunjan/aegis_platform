+#!/usr/bin/env python3
+import os, requests
+from urllib.parse import urljoin
+POWER_METRICS=["dcgm_gpu_power_draw_watts","nvidia_gpu_power_draw_watts","dcgm_gpu_power"]
+PROM_URL = os.environ.get("PROMETHEUS_URL","http://prometheus.monitoring.svc:9090")
+def _prom_range_query(query,start_ts,end_ts,step_s=10):
+    url = urljoin(PROM_URL,"/api/v1/query_range")
+    params={"query":query,"start":str(start_ts),"end":str(end_ts),"step":f"{step_s}s"}
+    r=requests.get(url,params=params,timeout=30); r.raise_for_status(); return r.json().get("data",{}).get("result",[])
+def compute_energy_kwh(start_ts,end_ts,pod_name=None,node_name=None,gpu_index=None,step_s=10):
+    total_wh=0.0; any_samples=False
+    for metric in POWER_METRICS:
+        label_selector=""
+        if pod_name: label_selector=f'{{pod="{pod_name}"}}'
+        elif node_name and gpu_index is not None: label_selector=f'{{node="{node_name}", minor_number="{gpu_index}"}}'
+        elif node_name: label_selector=f'{{node="{node_name}"}}'
+        query=f"{metric}{label_selector}"
+        try: results=_prom_range_query(query,start_ts,end_ts,step_s)
+        except Exception: results=[]
+        for series in results:
+            vals=series.get("values",[])
+            if not vals: continue
+            any_samples=True
+            prev_t=None
+            for t_str,v_str in vals:
+                t=float(t_str)
+                try: v=float(v_str)
+                except Exception: v=0.0
+                if prev_t is not None:
+                    dt=t-prev_t
+                    total_wh += v * dt / 3600.0 * 1000.0
+                prev_t=t
+    if not any_samples: return None
+    return total_wh / 1000.0
+if __name__=="__main__":
+    import argparse, time
+    p=argparse.ArgumentParser(); p.add_argument("--start",type=float,required=True); p.add_argument("--end",type=float,required=True); p.add_argument("--pod"); p.add_argument("--node"); p.add_argument("--gpu-index",type=int)
+    args=p.parse_args(); print(compute_energy_kwh(args.start,args.end,pod_name=args.pod,node_name=args.node,gpu_index=args.gpu_index))
+
