+import os, time, requests
+CARBON_API_URL = os.environ.get("CARBON_API_URL","")
+CARBON_API_KEY = os.environ.get("CARBON_API_KEY","")
+DEFAULT_G_PER_KWH = float(os.environ.get("CARBON_DEFAULT_GCO2_PER_KWH","400"))
+def lookup_co2_intensity(region: str = None, at_timestamp: float = None) -> float:
+    if not CARBON_API_URL: return DEFAULT_G_PER_KWH
+    params = {}
+    if region: params["zone"]=region
+    if at_timestamp: params["datetime"]=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(at_timestamp))
+    headers = {"auth-token": CARBON_API_KEY} if CARBON_API_KEY else {}
+    try:
+        r = requests.get(CARBON_API_URL, params=params, headers=headers, timeout=10); r.raise_for_status(); j=r.json()
+        if isinstance(j, dict):
+            if "carbonIntensity" in j: return float(j["carbonIntensity"])
+            if "data" in j and isinstance(j["data"], dict) and "carbonIntensity" in j["data"]: return float(j["data"]["carbonIntensity"])
+        return DEFAULT_G_PER_KWH
+    except Exception:
+        return DEFAULT_G_PER_KWH
