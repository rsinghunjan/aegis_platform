+#!/usr/bin/env bash
+set -euo pipefail
+if [ -z "${XFORMERS_S3_PREFIX:-}" ]; then echo "XFORMERS_S3_PREFIX must be set"; exit 2; fi
+if ! command -v aws >/dev/null 2>&1; then echo "aws cli required"; exit 2; fi
+TMPDIR=$(mktemp -d)
+aws s3 cp --recursive "${XFORMERS_S3_PREFIX}" "${TMPDIR}/"
+WHEELS=( ${TMPDIR}/*.whl )
+if [ ${#WHEELS[@]} -eq 0 ]; then echo "No wheels found"; exit 3; fi
+python3 -m pip install --upgrade pip setuptools wheel
+for w in "${WHEELS[@]}"; do python3 -m pip install --no-deps --force-reinstall "$w"; done
+rm -rf "${TMPDIR}"
+echo "Installed xformers wheels"
+
