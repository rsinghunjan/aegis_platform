+#!/usr/bin/env python3
+import os, math, requests
+from urllib.parse import urljoin
+try:
+    from kubernetes import client, config
+except Exception:
+    client = None
+PROM_URL = os.environ.get("PROMETHEUS_URL","http://prometheus.monitoring.svc:9090")
+SCALED_OBJECT_NAME = os.environ.get("KEDA_SCALEDOBJECT_NAME","diffusers-queue-scaledobject")
+NAMESPACE = os.environ.get("KEDA_NAMESPACE","ml-serving")
+def query(q):
+    r = requests.get(urljoin(PROM_URL,"/api/v1/query"), params={"query":q}, timeout=10); r.raise_for_status(); return r.json()
+def suggest():
+    qres = query("sum(redis_list_length{list='diffusers:queue'})")
+    queue_len = float(qres["data"]["result"][0]["value"][1]) if qres["data"]["result"] else 0.0
+    gres = query("avg(dcgm_gpu_utilization)") 
+    gpu_util = float(gres["data"]["result"][0]["value"][1]) if gres["data"]["result"] else 0.0
+    threshold = max(5, math.ceil(queue_len * 0.5))
+    max_replicas = 1 if gpu_util > 80 else 8
+    return {"threshold": threshold, "max_replicas": max_replicas}
+def patch_keda(threshold, max_replicas, dry_run=True):
+    if client is None:
+        print("k8s client not available; dry-run body:", {"threshold":threshold,"max_replicas":max_replicas}); return
+    config.load_kube_config(); api = client.CustomObjectsApi()
+    body = {"spec":{"maxReplicaCount":int(max_replicas),"triggers":[{"type":"prometheus","metadata":{"threshold":str(threshold)}}]}}
+    if dry_run: print("Dry-run patch body:", body); return
+    try: api.patch_namespaced_custom_object(group="keda.sh", version="v1alpha1", namespace=NAMESPACE, plural="scaledobjects", name=SCALED_OBJECT_NAME, body=body); print("patched")
+    except Exception as e: print("patch failed",e)
+if __name__=="__main__":
+    s=suggest(); patch_keda(s["threshold"], s["max_replicas"], dry_run=True); print(s)
+
