+subjectAltName = DNS:aegis-admission-webhook.ml-serving.svc, DNS:aegis-admission-webhook
+EOF
+openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -days 365 -extfile webhook.ext
