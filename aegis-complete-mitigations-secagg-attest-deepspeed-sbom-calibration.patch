+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click Aegis Enterprise Gate runner.
+# Prereq: source ops/runbooks/prefilled_values.env and set kube context.
+source ops/runbooks/prefilled_values.env
+
+echo "[Gate] 0) Preliminary checks"
+: "${COSIGN_KMS_URI:?COSIGN_KMS_URI must be set in prefills}"
+: "${REKOR_SERVER:?REKOR_SERVER must be set}"
+: "${S3_UPLOAD:?S3_UPLOAD must be set}"
+
+echo "[Gate] 1) Run pre-deploy CI checks locally (images signing & SBOM)"
+bash ops/ci/check_signed_images_before_deploy.sh manifests || { echo "Image signing checks failed"; exit 1; }
+
+echo "[Gate] 2) Deploy webhook infra (cert-manager, cluster issuer, certs)"
+bash ops/webhook/deploy_webhooks.sh || { echo "Webhook deploy failed"; exit 1; }
+
+echo "[Gate] 3) Provision Vault PKI role (if Vault addr set)"
+if [ -n "${VAULT_ADDR:-}" ]; then
+  bash ops/fl/attestation/vault_pki_setup.sh || echo "Vault PKI setup returned non-fatal errors"
+fi
+
+echo "[Gate] 4) Secure-aggregation smoke"
+python3 ops/fl/tests/secagg_integration_test.py || { echo "Secure-aggregation integration failed"; exit 1; }
+
+echo "[Gate] 5) FL round with DP clients"
+python3 ops/fl/server.py & SERVER_PID=$!
+sleep 3
+for i in 1 2 3; do
+  python3 ops/fl/client_opacus.py --epochs 1 --noise 1.0 || true
+done
+curl -s -X POST -H "Content-Type: application/json" -d '{"algorithm":"fedavg"}' http://127.0.0.1:5005/aggregate || { echo "FL aggregate failed"; kill $SERVER_PID || true; exit 1; }
+kill $SERVER_PID || true
+
+echo "[Gate] 6) DeepSpeed multi-node validation (staged)"
+bash ops/ml/validation/deepspeed_full_test.sh --num-nodes 2 --gpus-per-node 1 || { echo "DeepSpeed full test failed"; exit 1; }
+
+echo "[Gate] 7) Triton & vLLM load tests (adjust model names)"
+python3 ops/serving/validation/triton_load_test.py --url "triton:8001" --model "aegis-llm" || echo "Triton load test warning"
+python3 ops/serving/validation/vllm_load_test.py --url "http://vllm-server:8080/api/v1/generate" || echo "vLLM load test warning"
+
+echo "[Gate] 8) SBOM & CVE checks"
+bash .github/workflows/sbom_enforce.yml || echo "SBOM enforce CI check (run in GitHub Actions) - ensure pipeline green"
+
+echo "[Gate] 9) GPU power calibration"
+python3 ops/telemetry/pdu_ipmi_compare.py --samples 5 --interval 2 --out /tmp/pdu_compare.json || echo "PDU comparison failed"
+bash ops/telemetry/calibration_apply_configmap.sh aegis-system aegis-gpu-calibration /tmp/pdu_compare.json || true
+
+echo "[Gate] 10) Run carbon exporter for a sample job (simulate timestamps)"
+now=$(date +%s)
+python3 ops/carbon/exporter/job_carbon_exporter.py --job-id gate_demo --start $((now-60)) --end $now --region us-west-2 --instance-type p4d.24xlarge --gpu-hours 0.01 --out /tmp/carbon_gate_demo.json || true
+
+echo "[Gate] 11) Create signed auditor bundle"
+ARTS="/tmp/pdu_compare.json,/tmp/carbon_gate_demo.json"
+bash ops/compliance/prepare_audit_bundle_and_rekor.sh "$ARTS" /tmp/aegis_gate_bundle.tar.gz || echo "Audit bundle creation warning"
+
+echo "Aegis Enterprise Gate completed. Review /tmp/aegis_gate_bundle.tar.gz and logs."
