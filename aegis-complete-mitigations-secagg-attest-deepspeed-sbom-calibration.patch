+#!/usr/bin/env python3
+"""
+Parse grype JSON output and exit non-zero if any vulnerability meets the configured threshold.
+Intended to be used in CI after grype run.
+"""
+import json, sys
+
+SEVERITY_ORDER = ["UNKNOWN","NEGLIGIBLE","LOW","MEDIUM","HIGH","CRITICAL"]
+
+def severity_index(s):
+    try:
+        return SEVERITY_ORDER.index(s.upper())
+    except ValueError:
+        return 0
+
+def main(grype_json_path, threshold="HIGH"):
+    j = json.load(open(grype_json_path))
+    thresh_idx = severity_index(threshold)
+    matches = j.get("matches", [])
+    fail = False
+    for m in matches:
+        sev = m.get("vulnerability", {}).get("severity", "UNKNOWN")
+        if severity_index(sev) >= thresh_idx:
+            print("Blocking vuln:", m.get("artifact",""), m.get("vulnerability",{}).get("id"), sev)
+            fail = True
+    if fail:
+        sys.exit(1)
+    print("No blocking vulnerabilities found")
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("usage: block_on_vulns.py /path/grype.json [threshold]")
+        sys.exit(2)
+    threshold = sys.argv[2] if len(sys.argv)>2 else "HIGH"
+    main(sys.argv[1], threshold)
+
