+name: Pre-deploy Checks (image signing & SBOM)
+on:
+  push:
+    branches: [ "main", "release/*" ]
+jobs:
+  pre_deploy:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install tools
+        run: |
+          curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin v0.80.0 || true
+          curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/local/bin v0.65.0 || true
+          curl -sSL -o /usr/local/bin/cosign https://github.com/sigstore/cosign/releases/download/v1.15.0/cosign-linux-amd64
+          chmod +x /usr/local/bin/cosign
+      - name: Find images in manifests
+        run: |
+          mkdir -p /tmp/images
+          grep -R "image:" -n manifests || true
+          images=$(grep -R "image:" -n manifests | awk -F: '{print $3}' | tr -d ' ' | sort -u)
+          echo "$images" > /tmp/images/list.txt
+      - name: Verify images are cosign-signed (block)
+        env:
+          COSIGN_KMS_URI: ${{ secrets.COSIGN_KMS_URI }}
+        run: |
+          while read -r img; do
+            if [ -z "$img" ]; then continue; fi
+            echo "Verifying $img"
+            cosign verify --key "${COSIGN_KMS_URI}" "$img" || (echo "Image $img not signed - blocking" && exit 1)
+          done < /tmp/images/list.txt
+      - name: SBOM & grype scan (block on HIGH/CRITICAL)
+        env:
+          S3_UPLOAD: ${{ secrets.S3_UPLOAD }}
+        run: |
+          while read -r img; do
+            if [ -z "$img" ]; then continue; fi
+            outdir=$(mktemp -d)
+            syft "$img" -o json > "$outdir/sbom.json"
+            grype "$img" -o json > "$outdir/grype.json" || true
+            python3 ops/supplychain/block_on_vulns.py "$outdir/grype.json" HIGH || (echo "Blocking vuln for $img" && exit 1)
+            aws s3 cp "$outdir/sbom.json" "${S3_UPLOAD:-s3://aegis-evidence}/sboms/$(basename $img).json" || true
+          done < /tmp/images/list.txt
