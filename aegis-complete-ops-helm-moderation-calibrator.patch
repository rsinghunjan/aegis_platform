+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper for common AWS activation steps. This script guides the operator; it does not automate
+# cluster initialization steps that require human inputs or offline certs.
+#
+CLUSTER_ID=${1:-}
+REGION=${AWS_REGION:-us-west-2}
+
+if [ -z "$CLUSTER_ID" ]; then
+  echo "Usage: $0 <cloudhsm-cluster-id>"
+  exit 2
+fi
+
+echo "[1/5] Describe cluster"
+aws cloudhsmv2 describe-clusters --cluster-id "$CLUSTER_ID" --region "$REGION"
+
+echo "[2/5] Please follow the AWS CloudHSM initialization guide to initialize the cluster."
+echo "Once initialized, create KMS Custom Key Store via the console, then create CMK in KMS specifying origin AWS_CLOUDHSM"
+
+read -p "Enter KMS key ARN (arn:aws:kms:...): " KEY_ARN
+if [ -z "$KEY_ARN" ]; then
+  echo "No key provided; exiting"
+  exit 3
+fi
+
+echo "[3/5] Record issuance manifest"
+python3 ops/hsm/issue_key_manifest.py --key-ref "$KEY_ARN" --operator "$(whoami)" --notes "Activated via aws_activate_kms.sh"
+
+echo "[4/5] Promote into Vault staging (operator must confirm)"
+vault kv put secret/data/aegis/kms/staging cosign_key_refs="aws-kms://$KEY_ARN"
+
+echo "[5/5] Smoke test cosign (requires cosign installed)"
+TMP=/tmp/aegis_cosign_test_$$.txt
+echo "aegis test $(date -u)" > "$TMP"
+cosign sign --key "aws-kms://$KEY_ARN" "$TMP"
+cosign verify --key "aws-kms://$KEY_ARN" "$TMP"
+echo "All good. Upload artifact to evidence bucket if needed."
+
