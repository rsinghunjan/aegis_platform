+#!/usr/bin/env python3
+"""
+Moderation service + attestation endpoint
+ - Selects provider based on MODERATION_PROVIDER env (aws | google | openai | external)
+ - Calls provider adapter to moderate text or image
+ - Creates moderation manifest, signs with cosign (COSIGN_KEY_REF), uploads to EVIDENCE_BUCKET, records manifest URI in Vault (VAULT_MODERATION_PATH)
+ - Exposes endpoints:
+    POST /moderate/text  { "id": "...", "text": "..." }
+    POST /moderate/image { "id": "...", "file": multipart/form-data }
+
+Environment:
+ - MODERATION_PROVIDER: aws | google | openai | external
+ - COSIGN_KEY_REF: cosign key reference (e.g., aws-kms://...)
+ - EVIDENCE_BUCKET: s3://...
+ - VAULT_MODERATION_PATH: secret/data/aegis/moderation
+"""
+import os, json, tempfile, subprocess, time
+from flask import Flask, request, jsonify
+from services.safety.moderation_provider_loader import moderate_image as provider_image, moderate_text as provider_text
+
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+VAULT_MODERATION_PATH = os.environ.get("VAULT_MODERATION_PATH","secret/data/aegis/moderation")
+
+app = Flask(__name__)
+
+def write_manifest(item_id, verdict, details):
+    manifest = {"id": item_id, "verdict": verdict, "details": details, "ts": int(time.time())}
+    fn = f"/tmp/mod_manifest_{item_id}_{int(time.time())}.json"
+    with open(fn,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return fn
+
+def sign_manifest(fn):
+    if not COSIGN_KEY_REF:
+        raise RuntimeError("COSIGN_KEY_REF not set")
+    subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, fn])
+    return True
+
+def upload_manifest(fn):
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        dest = f"{EVIDENCE_BUCKET}/moderation/{os.path.basename(fn)}"
+        subprocess.check_call(["aws","s3","cp", fn, dest])
+        return dest
+    return None
+
+def record_vault(item_id, uri):
+    try:
+        subprocess.check_call(["vault","kv","put", f"{VAULT_MODERATION_PATH}/{item_id}", f"manifest_uri={uri}"])
+    except Exception:
+        pass
+
+@app.route("/moderate/text", methods=["POST"])
+def moderate_text():
+    body = request.get_json(force=True)
+    item_id = body.get("id") or f"text-{int(time.time())}"
+    text = body.get("text","")
+    res = provider_text(text) if provider_text else {"verdict":"review","reasons":["noop"],"confidence":0.0}
+    fn = write_manifest(item_id, res.get("verdict"), res)
+    sign_manifest(fn)
+    uri = upload_manifest(fn)
+    record_vault(item_id, uri or fn)
+    return jsonify({"id": item_id, "verdict": res.get("verdict"), "manifest": uri})
+
+@app.route("/moderate/image", methods=["POST"])
+def moderate_image():
+    f = request.files.get("file")
+    item_id = request.form.get("id") or f"img-{int(time.time())}"
+    data = f.read()
+    res = provider_image(data) if provider_image else {"verdict":"review","reasons":["noop"],"confidence":0.0}
+    fn = write_manifest(item_id, res.get("verdict"), res)
+    sign_manifest(fn)
+    uri = upload_manifest(fn)
+    record_vault(item_id, uri or fn)
+    return jsonify({"id": item_id, "verdict": res.get("verdict"), "manifest": uri})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("MOD_PORT","8200")))
+
