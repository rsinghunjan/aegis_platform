+#!/usr/bin/env python3
+"""
+Shamir helper for secret distribution used in MPC key management / threshold signing.
+This uses the 'secretsharing' package if available.
+"""
+try:
+    from secretsharing import PlaintextToHexSecretSharer as Shamir
+except Exception:
+    Shamir = None
+
+def split_secret(secret, k, n):
+    if Shamir is None:
+        raise RuntimeError("secretsharing library not installed")
+    hexs = secret.encode().hex()
+    return Shamir.split_secret(hexs, k, n)
+
+def recover_secret(shares):
+    if Shamir is None:
+        raise RuntimeError("secretsharing library not installed")
+    hexs = Shamir.recover_secret(shares)
+    return bytes.fromhex(hexs).decode()
+
