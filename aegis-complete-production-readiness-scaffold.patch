+"""
+Per-modality DP accounting helpers for large-scale runs.
+ - call DP /check_run per modality shard, aggregate the epsilon contributions
+ - emit per-shard evidence manifests to evidence bucket
+"""
+import os, json, time
+import requests
+from pathlib import Path
+
+DP_URL = os.environ.get("DP_ACCOUNTING_URL", "http://dp-accounting:8310")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def shard_check(project, modality, noise, sample_rate, steps, delta=1e-5):
+    payload = {"project": project, "modality": modality, "noise": float(noise), "sample_rate": float(sample_rate), "steps": int(steps), "delta": float(delta)}
+    r = requests.post(f"{DP_URL}/check_run", json=payload, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def aggregate_shard_reports(reports):
+    # Simplified composition: sum epsilons
+    eps = sum(r.get("epsilon", 0.0) for r in reports)
+    return {"epsilon_total": eps, "components": reports}
+
+def record_manifest(manifest, out_dir="/tmp/dp_shard_manifests"):
+    Path(out_dir).mkdir(parents=True, exist_ok=True)
+    ts = int(time.time())
+    path = os.path.join(out_dir, f"dp_manifest_{ts}.json")
+    with open(path, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    # optional evidence upload happens elsewhere (evidence_enforcer)
+    return path
