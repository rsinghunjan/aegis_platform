+#!/usr/bin/env python3
+"""
+Enhanced MPC coordinator prototype with simple threshold & dropout resilience logic.
+ - Accepts authenticated shares (authentication left as an exercise / mTLS)
+ - Aggregates when threshold reached per vector/chunk or after timeout
+ - Logs evidence on received shares and when aggregate produced
+
+This remains a prototype and must be cryptographically audited before production use.
+"""
+import time, json, os
+from threading import Lock
+
+EXPECTED_THRESHOLD = int(os.environ.get("MPC_THRESHOLD", "3"))
+TIMEOUT_SECONDS = int(os.environ.get("MPC_AGG_TIMEOUT", "30"))
+EVIDENCE_DIR = os.environ.get("MPC_EVIDENCE_DIR", "/tmp/mpc_evidence")
+os.makedirs(EVIDENCE_DIR, exist_ok=True)
+
+class EnhancedCoordinator:
+    def __init__(self):
+        self.store = {}  # vector_id -> { chunk_id: {client_id:share}}
+        self.timers = {}
+        self.lock = Lock()
+
+    def submit_share(self, client_id, vector_id, chunk_id, share_bytes):
+        with self.lock:
+            v = self.store.setdefault(vector_id, {})
+            c = v.setdefault(chunk_id, {})
+            c[client_id] = share_bytes
+            ts = int(time.time())
+            with open(os.path.join(EVIDENCE_DIR, f"share_{vector_id}_{chunk_id}_{client_id}_{ts}.json"), "w") as fh:
+                json.dump({"client_id":client_id,"vector_id":vector_id,"chunk_id":chunk_id,"ts":ts}, fh)
+            # start timer if first share
+            if (vector_id,chunk_id) not in self.timers:
+                self.timers[(vector_id,chunk_id)] = ts
+            # aggregate if threshold reached
+            if len(c) >= EXPECTED_THRESHOLD:
+                return self._aggregate_locked(vector_id, chunk_id)
+            return {"accepted": True, "message": "stored"}
+
+    def _aggregate_locked(self, vector_id, chunk_id):
+        c = self.store[vector_id][chunk_id]
+        # naive XOR combine as placeholder
+        agg = bytearray()
+        shares = list(c.values())
+        agg = bytearray(shares[0])
+        for s in shares[1:]:
+            for i,b in enumerate(s):
+                agg[i] ^= b
+        ts = int(time.time())
+        outp = os.path.join(EVIDENCE_DIR, f"aggregate_{vector_id}_{chunk_id}_{ts}.bin")
+        with open(outp, "wb") as fh:
+            fh.write(bytes(agg))
+        return {"ready": True, "aggregate_path": outp}
+
+    def poll_timeouts(self):
+        with self.lock:
+            now = int(time.time())
+            to_agg = []
+            for (v,c), start in list(self.timers.items()):
+                if now - start >= TIMEOUT_SECONDS:
+                    to_agg.append((v,c))
+            for v,c in to_agg:
+                if v in self.store and c in self.store[v] and len(self.store[v][c])>0:
+                    self._aggregate_locked(v,c)
+                    del self.timers[(v,c)]
+
+if __name__=="__main__":
+    # minimal CLI to accept JSON share submissions
+    import sys
+    ec = EnhancedCoordinator()
+    while True:
+        line = sys.stdin.readline()
+        if not line:
+            break
+        req = json.loads(line)
+        print(ec.submit_share(req["client_id"], req["vector_id"], req["chunk_id"], bytes(req["share"])))
+
