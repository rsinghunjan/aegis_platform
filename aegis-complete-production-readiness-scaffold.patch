+#!/usr/bin/env python3
+"""
+CO2Signal integration for real carbon intensity (requires API key).
+See https://www.co2signal.com/ for API usage.
+"""
+import os, requests
+
+API_KEY = os.environ.get("CO2SIGNAL_API_KEY","")
+BASE_URL = "https://api.co2signal.com/v1/latest"
+
+def get_carbon(region_code="DE"):
+    if not API_KEY:
+        raise RuntimeError("CO2SIGNAL_API_KEY not set")
+    headers = {"auth-token": API_KEY}
+    r = requests.get(BASE_URL, params={"countryCode": region_code}, headers=headers, timeout=10)
+    r.raise_for_status()
+    data = r.json().get("data",{})
+    return data.get("carbonIntensity"), data
+
+if __name__=="__main__":
+    print(get_carbon("US"))
+
