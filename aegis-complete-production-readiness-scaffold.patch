+#!/usr/bin/env python3
+"""
+Distributed multimodal ingestion using Dask.
+
+Reads a JSON manifest (list of records with id,image_src,text...), runs per-modality
+preprocessing in parallel, writes processed shards and a processed_manifest.json.
+
+Requirements: dask[distributed], requests, pillow, numpy
+
+Example:
+  python3 ops/ingest/dask_ingest.py --manifest data/manifest.json --out data/processed --workers 4
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+from dask.distributed import Client, LocalCluster
+from dask import delayed, compute
+
+from services.models.multimodal.preprocess_image import preprocess_image
+from services.models.multimodal.preprocess_text import preprocess_text
+
+@delayed
+def process_record(rec, out_dir):
+    pid = rec.get("id")
+    img_out = os.path.join(out_dir, f"{pid}.img.npz")
+    txt_out = os.path.join(out_dir, f"{pid}.txt.json")
+    preprocess_image(rec["image_src"], img_out)
+    preprocess_text(rec["text"], txt_out)
+    return {"id": pid, "image": img_out, "text": txt_out, "label": rec.get("label", 0)}
+
+def run(manifest_path, out_dir, workers=4):
+    Path(out_dir).mkdir(parents=True, exist_ok=True)
+    with open(manifest_path) as fh:
+        manifest = json.load(fh)
+    cluster = LocalCluster(n_workers=workers, threads_per_worker=1, processes=True)
+    client = Client(cluster)
+    tasks = [process_record(rec, out_dir) for rec in manifest]
+    results = compute(*tasks)
+    processed = list(results)
+    out_manifest = os.path.join(out_dir, "processed_manifest.json")
+    with open(out_manifest, "w") as fh:
+        json.dump(processed, fh, indent=2)
+    client.close()
+    cluster.close()
+    print("Wrote processed manifest:", out_manifest)
+    return out_manifest
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--manifest", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--workers", type=int, default=4)
+    args = p.parse_args()
+    run(args.manifest, args.out, args.workers)
+
