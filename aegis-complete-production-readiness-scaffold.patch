+#!/usr/bin/env bash
+#
+# Injects a fault into canary and proves Flagger auto-rolls back within MTTR threshold.
+#
+set -euo pipefail
+CANARY=${1:-aegis-admission-webhook}
+NAMESPACE=${2:-aegis}
+MTTR_THRESHOLD=${3:-300} # seconds
+START=$(date +%s)
+echo "Triggering fault..."
+kubectl -n "$NAMESPACE" exec deploy/"$CANARY" -- /bin/sh -c "curl -s -X POST http://127.0.0.1:8080/fault/enable" || true
+for i in $(seq 1 60); do
+  PHASE=$(kubectl -n "$NAMESPACE" get canary "$CANARY" -o jsonpath='{.status.phase}' || echo "")
+  echo "Phase: $PHASE"
+  if [ "$PHASE" = "Failed" ]; then
+    END=$(date +%s)
+    MTTR=$((END-START))
+    echo "Rollback observed. MTTR=${MTTR}s"
+    if [ "$MTTR" -le "$MTTR_THRESHOLD" ]; then
+      echo "Rollback within threshold."
+      exit 0
+    else
+      echo "Rollback exceeded threshold!"
+      exit 2
+    fi
+  fi
+  sleep 10
+done
+echo "No rollback observed within timeout."
+exit 3
+
