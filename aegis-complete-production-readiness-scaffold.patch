+#!/usr/bin/env python3
+"""
+Acquire short-lived credentials via AWS STS assume-role (recommended for CI).
+"""
+import boto3, os, argparse, json
+
+def assume(role_arn, session_name="aegis-session", duration=3600):
+    sts = boto3.client("sts")
+    r = sts.assume_role(RoleArn=role_arn, RoleSessionName=session_name, DurationSeconds=duration)
+    creds = r["Credentials"]
+    out = {"AWS_ACCESS_KEY_ID":creds["AccessKeyId"], "AWS_SECRET_ACCESS_KEY":creds["SecretAccessKey"], "AWS_SESSION_TOKEN":creds["SessionToken"]}
+    print(json.dumps(out))
+    return out
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--role", required=True)
+    args = p.parse_args()
+    assume(args.role)
+
