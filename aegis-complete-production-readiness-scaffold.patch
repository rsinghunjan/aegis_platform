+#!/usr/bin/env python3
+"""
+Lint IAM policies from terraform output (best-effort).
+Checks for wildcard permissions and flags high-risk statements.
+Requires terraform output JSON or aws iam policy JSON files.
+"""
+import json, sys, os
+
+def lint_policy(policy):
+    findings = []
+    for s in policy.get("Statement", []):
+        acts = s.get("Action", [])
+        if isinstance(acts, str): acts = [acts]
+        for a in acts:
+            if "*" in a:
+                findings.append(f"Wildcard Action {a}")
+    return findings
+
+def main():
+    if len(sys.argv)<2:
+        print("Usage: iam_linter.py <policy.json> [..]")
+        sys.exit(2)
+    all_findings = []
+    for p in sys.argv[1:]:
+        j = json.load(open(p))
+        all_findings += lint_policy(j)
+    if all_findings:
+        print("IAM Linter findings:")
+        for f in all_findings: print("-", f)
+        sys.exit(1)
+    print("No wildcard IAM actions found (basic check)")
+
+if __name__=="__main__":
+    main()
+
