+#!/usr/bin/env python3
+"""
+Production-ready PyTorch Lightning training recipe (scaffold).
+ - mixed precision, distributed training support (DDP), checkpointing, logging
+ - uses per-round DP check/report integration (expects services.fl.fl_controller_dp_wrapper)
+
+This is a scaffold: replace dataset and model bodies with your production model.
+"""
+import os
+import argparse
+from pathlib import Path
+import pytorch_lightning as pl
+from pytorch_lightning.callbacks import ModelCheckpoint, EarlyStopping
+from pytorch_lightning.loggers import TensorBoardLogger
+
+try:
+    from services.fl.fl_controller_dp_wrapper import check_and_start_round, report_round
+except Exception:
+    def check_and_start_round(*args, **kwargs): return "local-run"
+    def report_round(*args, **kwargs): return {"ok": True}
+
+import torch
+from torch.utils.data import Dataset, DataLoader
+import numpy as np
+
+class MultimodalDataset(Dataset):
+    def __init__(self, processed_manifest):
+        import json
+        with open(processed_manifest) as fh:
+            self.items = json.load(fh)
+    def __len__(self): return len(self.items)
+    def __getitem__(self, idx):
+        it = self.items[idx]
+        # load npz image
+        img = np.load(it["image"])["image"].astype("float32")
+        txt = it["text"]
+        try:
+            import json
+            with open(txt) as fh:
+                toks = json.load(fh)["tokens"]
+        except Exception:
+            toks = [0]
+        label = int(it.get("label", 0))
+        return torch.tensor(img).permute(2,0,1), torch.tensor(toks, dtype=torch.long), label
+
+class LitMultimodal(pl.LightningModule):
+    def __init__(self, lr=1e-3):
+        super().__init__()
+        self.save_hyperparameters()
+        # simple model placeholders
+        self.conv = torch.nn.Flatten()
+        self.classifier = torch.nn.Linear(64*64*3 + 16, 2)
+        self.loss = torch.nn.CrossEntropyLoss()
+    def forward(self, img, txt): 
+        b = img.view(img.size(0), -1)
+        txt_emb = torch.randn(img.size(0), 16, device=img.device)
+        return self.classifier(torch.cat([b, txt_emb], dim=1))
+    def training_step(self, batch, batch_idx):
+        img, txt, y = batch
+        logits = self(img, txt)
+        loss = self.loss(logits, y)
+        self.log("train_loss", loss)
+        return loss
+    def configure_optimizers(self):
+        return torch.optim.Adam(self.parameters(), lr=self.hparams.lr)
+
+def main(processed_manifest, epochs=3, gpus=0, precision=16):
+    # Perform DP check per training job
+    run_id = check_and_start_round(project="multimodal-prod", noise=1.0, sample_rate=0.01, steps=epochs)
+    ds = MultimodalDataset(processed_manifest)
+    dl = DataLoader(ds, batch_size=8, shuffle=True, num_workers=4)
+    model = LitMultimodal()
+    logger = TensorBoardLogger("tb_logs", name="multimodal")
+    ckpt = ModelCheckpoint(dirpath="checkpoints", save_top_k=1, monitor="train_loss", mode="min")
+    trainer = pl.Trainer(max_epochs=epochs, gpus=gpus, precision=precision, strategy="ddp" if gpus>1 else None, logger=logger, callbacks=[ckpt], gradient_clip_val=1.0)
+    trainer.fit(model, dl)
+    # report epsilon (compute or estimate in production)
+    report_round(project="multimodal-prod", run_id=run_id, epsilon=0.7)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--processed-manifest", required=True)
+    p.add_argument("--epochs", type=int, default=3)
+    p.add_argument("--gpus", type=int, default=0)
+    args = p.parse_args()
+    main(args.processed_manifest, args.epochs, args.gpus)
