+#!/usr/bin/env python3
+"""
+Patch multiple Helm chart manifests (templated or rendered) to add Vault CSI mounts and mTLS secret volume.
+Operators should review diffs before applying.
+Usage:
+  python3 ops/helm/patch_vault_csi_all.py --input charts/ --output patched_charts/
+"""
+import argparse
+import os
+import yaml
+from pathlib import Path
+
+def patch_file(path, outdir):
+    docs = list(yaml.safe_load_all(Path(path).read_text()))
+    changed = False
+    for d in docs:
+        if not isinstance(d, dict): continue
+        kind = d.get("kind","")
+        if kind in ("Deployment","StatefulSet","DaemonSet"):
+            pod = d.setdefault("spec",{}).setdefault("template",{}).setdefault("spec",{})
+            vols = pod.setdefault("volumes",[])
+            vols.append({"name":"vault-csi","csi":{"driver":"secrets-store.csi.k8s.io","readOnly":True,"volumeAttributes":{"secretProviderClass":"vault-aegis"}}})
+            vols.append({"name":"mtls-secret","secret":{"secretName":"crypten-mtls"}})
+            for c in pod.get("containers",[]):
+                mounts = c.setdefault("volumeMounts",[])
+                mounts.append({"name":"vault-csi","mountPath":"/mnt/secrets"})
+                mounts.append({"name":"mtls-secret","mountPath":"/etc/tls","readOnly":True})
+            changed = True
+    outp = os.path.join(outdir, os.path.basename(path))
+    Path(outdir).mkdir(parents=True, exist_ok=True)
+    Path(outp).write_text("\n---\n".join(yaml.safe_dump(d) for d in docs))
+    return changed
+
+def main(input_dir, out_dir):
+    for root,_,files in os.walk(input_dir):
+        for f in files:
+            if f.endswith((".yaml",".yml")):
+                p = os.path.join(root,f)
+                patch_file(p, out_dir)
+    print("Patched charts written to", out_dir)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--input", required=True)
+    p.add_argument("--output", required=True)
