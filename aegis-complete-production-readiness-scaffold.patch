+#!/usr/bin/env python3
+"""
+Collect basic attestation artifacts (node id, kubelet cert thumbprint, image digests)
+Sign the attestation with cosign (KMS) and upload to evidence S3 + Rekor.
+"""
+import os, json, time, subprocess
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KMS_URI = os.environ.get("COSIGN_KMS_URI","")
+REKOR_SERVER = os.environ.get("REKOR_SERVER","")
+
+def collect():
+    att = {"ts": int(time.time()), "node": os.uname().nodename}
+    # image digests (best-effort)
+    try:
+        out = subprocess.check_output(["kubectl","get","pods","--all-namespaces","-o","json"], stderr=subprocess.DEVNULL)
+        att["pods_json_len"] = len(out)
+    except Exception:
+        pass
+    path = f"/tmp/attestation_{int(time.time())}.json"
+    with open(path,"w") as fh: json.dump(att, fh)
+    # sign & upload
+    try:
+        if COSIGN_KMS_URI:
+            subprocess.check_call(["cosign","sign-blob","--key",COSIGN_KMS_URI,path])
+    except Exception:
+        pass
+    try:
+        if EVIDENCE_BUCKET:
+            subprocess.check_call(["aws","s3","cp", path, f"s3://{EVIDENCE_BUCKET.rstrip('/')}/attestations/"])
+    except Exception:
+        pass
+    try:
+        if shutil_which("rekor-cli"):
+            subprocess.check_call(["rekor-cli","upload","--artifact", path])
+    except Exception:
+        pass
+    print("Collected attestation:", path)
+
+def shutil_which(cmd):
+    from shutil import which
+    return which(cmd) is not None
+
+if __name__=="__main__":
+    collect()
+
