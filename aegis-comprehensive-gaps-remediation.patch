+#!/usr/bin/env python3
+"""
+Scan the repo for Kubernetes manifests and check for:
+ - Vault CSI mounts usage
+ - mTLS cert volumeMounts presence
+ - ServiceAccount least-privilege hints (non-root)
+This is a best-effort linter to support zero-trust readiness.
+"""
+import os, sys, yaml, glob
+
+ROOT = os.getcwd()
+issues = []
+
+def check_manifest(path):
+    with open(path) as fh:
+        docs = list(yaml.safe_load_all(fh))
+    for d in docs:
+        if not isinstance(d, dict): continue
+        kind = d.get("kind","")
+        if kind in ("Deployment","StatefulSet","DaemonSet"):
+            spec = d.get("spec",{})
+            template = spec.get("template",{})
+            podspec = template.get("spec",{})
+            # check volumes for vault csi
+            vols = podspec.get("volumes",[])
+            for v in vols:
+                if v.get("csi",{}).get("driver","").lower().find("vault") != -1:
+                    break
+            else:
+                issues.append((path, "missing Vault CSI volumes"))
+            # check for TLS secret mounts
+            found_tls = False
+            for c in podspec.get("containers",[]):
+                for vm in c.get("volumeMounts",[]):
+                    if "tls" in vm.get("name","").lower() or "cert" in vm.get("name","").lower():
+                        found_tls = True
+            if not found_tls:
+                issues.append((path, "no TLS/cert volume mounts detected"))
+
+def main():
+    for f in glob.glob("**/*.yaml", recursive=True) + glob.glob("**/*.yml", recursive=True):
+        try:
+            check_manifest(f)
+        except Exception:
+            pass
+    if issues:
+        print("Zero-trust scanner found potential issues:")
+        for p, msg in issues:
+            print(f"- {p}: {msg}")
+        sys.exit(1)
+    print("Zero-trust scanner: no obvious issues found")
+
+if __name__ == "__main__":
+    main()
+
