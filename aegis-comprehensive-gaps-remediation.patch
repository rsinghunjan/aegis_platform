+#!/usr/bin/env python3
+"""
+Simple client to evaluate OPA policies for autonomy decisions.
+Calls local OPA at http://localhost:8181/v1/data/aegis/policy/decision
+"""
+import os, requests, json
+
+OPA_URL = os.environ.get("OPA_URL", "http://localhost:8181/v1/data/aegis/policy/decision")
+
+def evaluate(action, context=None):
+    payload = {"input": {"action": action, "context": context or {}}}
+    r = requests.post(OPA_URL, json=payload, timeout=5)
+    r.raise_for_status()
+    return r.json().get("result")
+
+if __name__ == "__main__":
+    import sys
+    act = sys.argv[1] if len(sys.argv)>1 else "canary_promote"
+    print(evaluate(act))
