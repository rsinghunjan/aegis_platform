+#!/usr/bin/env bash
+#
+# Generate self-signed mTLS certs for staging use and create a k8s secret manifest.
+#
+set -euo pipefail
+OUT_DIR=${1:-/tmp/aegis-mtls}
+mkdir -p "$OUT_DIR"
+
+openssl genrsa -out "$OUT_DIR/ca.key" 2048
+openssl req -x509 -new -nodes -key "$OUT_DIR/ca.key" -subj "/CN=aegis-ca" -days 3650 -out "$OUT_DIR/ca.crt"
+
+openssl genrsa -out "$OUT_DIR/server.key" 2048
+openssl req -new -key "$OUT_DIR/server.key" -subj "/CN=mpc-coordinator" -out "$OUT_DIR/server.csr"
+openssl x509 -req -in "$OUT_DIR/server.csr" -CA "$OUT_DIR/ca.crt" -CAkey "$OUT_DIR/ca.key" -CAcreateserial -out "$OUT_DIR/server.crt" -days 365
+
+cat <<EOF > "$OUT_DIR/secret.yaml"
+apiVersion: v1
+kind: Secret
+metadata:
+  name: crypten-mtls
+type: Opaque
+data:
+  ca.crt: $(base64 -w0 "$OUT_DIR/ca.crt")
+  server.crt: $(base64 -w0 "$OUT_DIR/server.crt")
+  server.key: $(base64 -w0 "$OUT_DIR/server.key")
+EOF
+
+echo "Generated certs and secret manifest at $OUT_DIR"
+
