+#!/usr/bin/env python3
+"""
+Minimal multimodal training example that integrates DP check/report calls.
+It expects the FL DP wrapper (services.fl.fl_controller_dp_wrapper) to be available.
+This script demonstrates modality preprocessing, a tiny model, and DP control loop usage.
+"""
+import os, json, argparse, time
+import torch
+import torch.nn as nn
+import torch.optim as optim
+from torchvision import transforms
+from PIL import Image
+
+try:
+    from services.fl.fl_controller_dp_wrapper import check_and_start_round, report_round
+except Exception:
+    # If wrapper not installed, provide no-op fallbacks for local testing
+    def check_and_start_round(*args, **kwargs):
+        return "local-run-id"
+    def report_round(*args, **kwargs):
+        return {"ok": True}
+
+class TinyMultimodal(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.img_net = nn.Sequential(nn.Flatten(), nn.Linear(64*64*3, 64), nn.ReLU())
+        self.txt_net = nn.Embedding(1000, 16)
+        self.classifier = nn.Sequential(nn.Linear(64+16, 32), nn.ReLU(), nn.Linear(32,2))
+    def forward(self, img, txt_idx):
+        i = self.img_net(img)
+        t = self.txt_net(txt_idx).mean(dim=1)
+        x = torch.cat([i,t], dim=1)
+        return self.classifier(x)
+
+def text_to_index(s):
+    return sum(ord(c) for c in s) % 1000
+
+def load_dataset(data_dir):
+    with open(os.path.join(data_dir, "manifest.json")) as fh:
+        manifest = json.load(fh)
+    X_img, X_txt, y = [], [], []
+    tf = transforms.Compose([transforms.Resize((64,64)), transforms.ToTensor()])
+    for rec in manifest:
+        img = Image.open(rec["image"]).convert("RGB")
+        X_img.append(tf(img).view(-1))
+        X_txt.append(text_to_index(rec["text"]))
+        y.append(rec["label"])
+    return torch.stack(X_img), torch.tensor(X_txt), torch.tensor(y)
+
+def train(data_dir, epochs=1):
+    # DP check before training round
+    run_id = check_and_start_round(project="multimodal-demo", noise=1.0, sample_rate=0.01, steps=epochs)
+    X_img, X_txt, y = load_dataset(data_dir)
+    model = TinyMultimodal()
+    optim_ = optim.Adam(model.parameters(), lr=1e-3)
+    loss_fn = nn.CrossEntropyLoss()
+    for e in range(epochs):
+        model.train()
+        optim_.zero_grad()
+        logits = model(X_img, X_txt.unsqueeze(1))
+        loss = loss_fn(logits, y)
+        loss.backward()
+        optim_.step()
+        print(f"epoch {e} loss {loss.item()}")
+    # compute a toy epsilon to report
+    epsilon = 0.5
+    report = report_round(project="multimodal-demo", run_id=run_id, epsilon=epsilon)
+    print("DP report:", report)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--data-dir", required=True)
+    p.add_argument("--epochs", type=int, default=1)
+    args = p.parse_args()
+    train(args.data_dir, args.epochs)
+
