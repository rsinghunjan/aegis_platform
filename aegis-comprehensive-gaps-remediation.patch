+#!/usr/bin/env python3
+"""
+Generate a tiny synthetic multimodal dataset (image + text label).
+"""
+import os, argparse, json, random
+from PIL import Image
+import numpy as np
+
+def main(out, n=32):
+    os.makedirs(out, exist_ok=True)
+    samples = []
+    for i in range(n):
+        img = (np.random.rand(64,64,3)*255).astype('uint8')
+        img_path = os.path.join(out, f"img_{i}.png")
+        Image.fromarray(img).save(img_path)
+        text = random.choice(["good", "bad", "neutral"])
+        samples.append({"image": img_path, "text": text, "label": random.randint(0,1)})
+    with open(os.path.join(out, "manifest.json"), "w") as fh:
+        json.dump(samples, fh)
+    print("Wrote", len(samples), "samples to", out)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", required=True)
+    p.add_argument("--n", type=int, default=32)
+    args = p.parse_args()
+    main(args.out, args.n)
+
