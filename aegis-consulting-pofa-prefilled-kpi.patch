+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Prefilled One‑Click PoA — Example placeholders filled for a representative target.
+# Replace placeholders (HOSTS, SLOS, NPU_RUNNERS, COSIGN_KMS_URI, REKOR_SERVER, S3_UPLOAD) as needed.
+#
+# Usage:
+#   ./ops/runbooks/one_click_pofa_prefilled.sh
+#
+# Representative defaults (replace before running)
+DATASET=${DATASET:-"/data/example_train.jsonl"}
+TARGETS=${TARGETS:-"falcon-ecu-01.example.com:can0"}
+SCENARIOS=${SCENARIOS:-"ops/av/certification/falcon_scenarios.txt"}
+INVARIANT=${INVARIANT:-"ops/formal/specs/safety.tla"}
+NPU_RUNNERS=${NPU_RUNNERS:-"npu-1.example.com,npu-2.example.com"}
+SLO_P99_MS=${SLO_P99_MS:-0.5}
+SLO_SAFE_MS=${SLO_SAFE_MS:-50}
+LLM_P99_MS=${LLM_P99_MS:-300}
+OUT=${OUT:-"/tmp/pofa_prefilled_$(date +%s)"}
+COSIGN=${COSIGN_KMS_URI:-""}
+REKOR=${REKOR_SERVER:-""}
+S3=${S3_UPLOAD:-""}
+
+mkdir -p "$OUT"
+echo "Running prefined PoA -> OUT=$OUT"
+
+export TRAIN_CMD=${TRAIN_CMD:-"./train.py"}
+
+echo "[1] Tokenize & shard dataset"
+python3 ops/llm/tokenizer_prep.py --dataset "$DATASET" --out "$OUT/shards" --tokenizer-out "$OUT/tokenizer" --shard-size 20000 --shuffle || true
+
+echo "[2] Validate GPU cluster"
+./ops/llm/validate_gpu_cluster.sh || true
+
+echo "[3] Sharded training smoke"
+python3 ops/llm/training_pipeline_launcher.py --shard-manifest "$OUT/shards/shard_manifest.json" --train-cmd "$TRAIN_CMD" --nodes 1 --gpus-per-node 1 --hours 0.5 --cost-slo 200 --out "$OUT/train" || true
+
+echo "[4] Run small sim (dry-run)"
+python3 ops/av/perception/scale/scale_orchestrator.py --packs 2 --per-pack 50 --parallel 1 --out "$OUT/sim" --npu-runners "$NPU_RUNNERS" --dry-run || true
+
+echo "[5] RT sweeps & hardware proofs"
+python3 ops/validation/run_hw_validation_pipeline.py --targets "$TARGETS" --out "$OUT/hw" --cosign "$COSIGN" --s3 "$S3" --p99-threshold "$SLO_P99_MS" --safe-threshold-ms "$SLO_SAFE_MS" || true
+
+echo "[6] HIL + Apalache invariant closure"
+python3 ops/robotics/control/hil_invariant_closure.py --scenarios-file "$SCENARIOS" --invariant "$INVARIANT" --golden /opt/aegis/golden_trace.ndjson --out "$OUT/hil" --cosign "$COSIGN" || true
+
+echo "[7] Build auditor bundle"
+python3 ops/certifier/auditor_package_allinone.py --root . --vehicle "Prefilled-PoA-Vehicle" --out "$OUT/auditor_bundle.tar.gz" --cosign-key "$COSIGN" --s3 "$S3" || true
+
+echo "[8] Run KPI collector"
+python3 ops/metrics/kpi_collector.py --report "$OUT/pofa_report.json" --out "$OUT/pofa_kpi_summary.json" || true
+
+echo "Prefilled PoA complete. Inspect $OUT"
+
