*** Add File:ops/metrics/generate_sample_kpi_report.py
+#!/usr/bin/env python3
+"""
+Generate a sample KPI report from a PoA report (or create a synthetic example).
+ - Usage: python3 generate_sample_kpi_report.py --pofa /tmp/pofa_run/pofa_report.json --out /tmp/sample_kpi.json
+"""
+import argparse, json, os, time
+
+def load_pofa(path):
+    if not path or not os.path.exists(path):
+        return None
+    return json.load(open(path))
+
+def synthesize(pofa):
+    if not pofa:
+        # produce the sample_kpi_report.json values
+        return json.load(open("ops/metrics/sample_kpi_report.json"))
+    total = pofa.get("total_duration_s", 0)
+    human_after = 4
+    human_before = 12
+    summary = {
+        "poa_run_id": "from_pofa",
+        "started_at": pofa.get("started_at"),
+        "ended_at": pofa.get("ended_at"),
+        "total_duration_s": total,
+        "stages": pofa.get("stages", []),
+        "human_hours_before": human_before,
+        "human_hours_after": human_after,
+        "kpi_summary": {
+            "time_to_evidence_minutes": total/60.0,
+            "human_hours_saved": human_before - human_after,
+            "signed_artifacts_fraction": 1.0,
+            "hil_critical_failures": 0
+        }
+    }
+    return summary
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--pofa", default="")
+    p.add_argument("--out", default="/tmp/sample_kpi_report.json")
+    args = p.parse_args()
+    pofa = load_pofa(args.pofa)
+    report = synthesize(pofa)
+    with open(args.out, "w") as fh:
+        json.dump(report, fh, indent=2)
+    print("Wrote KPI report to", args.out)
+
