+#!/usr/bin/env python3
+"""
+Ingest HIL artifacts (logs, traces, recordings) into MLflow and emit lineage + evidence.
+Used by HIL orchestrator after a campaign finishes.
+"""
+import os
+import glob
+import tempfile
+from ops.sdk.evidence_sdk import record_manifest
+from ops.lineage.openlineage_client import emit as emit_lineage
+import mlflow
+
+MLFLOW_URI = os.environ.get("MLFLOW_TRACKING_URI","http://localhost:5000")
+
+def ingest_dir(campaign_id: str, artifact_dir: str, s3_uri: str = ""):
+    mlflow.set_tracking_uri(MLFLOW_URI)
+    with mlflow.start_run(run_name=f"hil-{campaign_id}") as run:
+        run_id = run.info.run_id
+        mlflow.log_param("campaign_id", campaign_id)
+        for path in glob.glob(os.path.join(artifact_dir, "**"), recursive=True):
+            if os.path.isfile(path):
+                mlflow.log_artifact(path, artifact_path="hil_artifacts")
+        # Optionally upload to S3 and produce artifact URIs (left as operator step)
+    # Emit lineage
+    try:
+        emit_lineage("HIL_CAMPAIGN", job_name="hil_campaign", run_id=run_id, inputs=[], outputs=[{"namespace":"aegis","name":f"hil:{campaign_id}"}])
+    except Exception:
+        pass
+    # record evidence
+    try:
+        record_manifest("hil_ingest", {"campaign_id": campaign_id, "mlflow_run": run_id, "artifact_dir": artifact_dir})
+    except Exception:
+        pass
+    return run_id
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--campaign-id", required=True)
+    p.add_argument("--artifact-dir", required=True)
+    args = p.parse_args()
+    r = ingest_dir(args.campaign_id, args.artifact_dir)
+    print("Ingested HIL artifacts to MLflow run", r)
+
