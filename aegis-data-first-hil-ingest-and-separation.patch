+#!/usr/bin/env python3
+"""
+Register a sensor/schema to the local schema registry (ops/schema_registry/extended_schema_registry.py)
+Usage: python ops/data/schema_registry/register_schema.py --name sensor.trace --version 1 ops/data/schemas/sensor_schema_v1.json
+"""
+import argparse
+import json
+import requests
+
+REGISTRY_URL = "http://localhost:8101/schema"  # adjust in prod
+
+def register(name, version, path, admin_token=None):
+    with open(path) as fh:
+        schema = json.load(fh)
+    payload = {"name": name, "version": version, "schema": schema, "compatibility": "backward"}
+    headers = {}
+    if admin_token:
+        headers["Authorization"] = f"Bearer {admin_token}"
+    r = requests.post(REGISTRY_URL, json=payload, headers=headers, timeout=5)
+    r.raise_for_status()
+    print("Registered schema", name, "v", version)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--name", required=True)
+    p.add_argument("--version", type=int, required=True)
+    p.add_argument("schema_file")
+    p.add_argument("--admin-token")
+    args = p.parse_args()
+    register(args.name, args.version, args.schema_file, args.admin_token)
+
