+#!/usr/bin/env python3
+"""
+Validate sensor/sim trace files against JSON Schema, upload to object store, log to MLflow, and emit OpenLineage events.
+ - Validates each JSON record in newline-delimited JSON (ndjson) or single JSON file.
+ - Uploads artifact to S3 (via boto3) or local path.
+ - Logs MLflow run with artifact and dataset metadata.
+ - Emits OpenLineage dataset/register/run events to configured OPENLINEAGE_URL.
+
+Usage:
+  python ops/data/ingest/validate_and_ingest.py --file /tmp/capture.ndjson --schema ops/data/schemas/sensor_schema_v1.json --capture-id CAP123 --mlflow-uri http://mlflow:5000 --s3-uri s3://aegis-sim-traces/
+"""
+import os
+import json
+import argparse
+import tempfile
+import time
+from typing import Tuple
+
+try:
+    import jsonschema
+except Exception:
+    jsonschema = None
+
+try:
+    import mlflow
+except Exception:
+    mlflow = None
+
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+from ops.lineage.openlineage_client import emit as emit_lineage
+from ops.sdk.evidence_sdk import record_manifest
+
+def validate_file(file_path: str, schema: dict) -> Tuple[int,int]:
+    """
+    Validate an NDJSON file against JSON schema.
+    Returns (valid, invalid) counts and writes a validated temp file.
+    """
+    if jsonschema is None:
+        raise RuntimeError("jsonschema library required (pip install jsonschema)")
+    valid, invalid = 0, 0
+    temp_fd, temp_path = tempfile.mkstemp(suffix=".ndjson")
+    with os.fdopen(temp_fd, "w") as out:
+        with open(file_path, "r") as fh:
+            for line in fh:
+                if not line.strip():
+                    continue
+                try:
+                    j = json.loads(line)
+                    jsonschema.validate(instance=j, schema=schema)
+                    out.write(json.dumps(j) + "\n")
+                    valid += 1
+                except Exception as e:
+                    invalid += 1
+    return valid, invalid, temp_path
+
+def upload_artifact(local_path: str, s3_uri: str):
+    if boto3 is None:
+        raise RuntimeError("boto3 required to upload to S3")
+    # s3_uri expected s3://bucket/path-prefix/
+    if not s3_uri.startswith("s3://"):
+        raise RuntimeError("s3_uri must be s3://...")
+    parts = s3_uri[5:].split("/",1)
+    bucket = parts[0]
+    prefix = parts[1] if len(parts)>1 else ""
+    key = os.path.join(prefix, os.path.basename(local_path))
+    s3 = boto3.client("s3")
+    s3.upload_file(local_path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def log_to_mlflow(capture_id: str, artifact_uri: str, mlflow_uri: str, schema_name: str, rows: int):
+    if mlflow is None:
+        raise RuntimeError("mlflow client required")
+    mlflow.set_tracking_uri(mlflow_uri)
+    with mlflow.start_run(run_name=f"ingest-{capture_id}") as run:
+        mlflow.log_param("capture_id", capture_id)
+        mlflow.log_param("schema", schema_name)
+        mlflow.log_metric("rows", rows)
+        mlflow.log_artifact(artifact_uri.replace("s3://", "/tmp/") if artifact_uri.startswith("s3://") else artifact_uri, artifact_path="dataset")
+        run_id = run.info.run_id
+    return run_id
+
+def emit_lineage_event(job_name: str, run_id: str, inputs=None, outputs=None):
+    try:
+        emit_lineage(event_type="START", job_name=job_name, run_id=run_id, inputs=inputs or [], outputs=outputs or [])
+    except Exception:
+        pass
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--file", required=True)
+    p.add_argument("--schema", required=True)
+    p.add_argument("--capture-id", required=True)
+    p.add_argument("--mlflow-uri", default=os.environ.get("MLFLOW_TRACKING_URI","http://localhost:5000"))
+    p.add_argument("--s3-uri", default=os.environ.get("S3_URI",""))
+    p.add_argument("--schema-name", default="sensor.trace")
+    args = p.parse_args()
+
+    schema = json.load(open(args.schema))
+    valid, invalid, validated_path = validate_file(args.file, schema)
+    print(f"Validated: {valid}, Invalid: {invalid}, temp: {validated_path}")
+
+    artifact_uri = validated_path
+    if args.s3_uri:
+        artifact_uri = upload_artifact(validated_path, args.s3_uri)
+        print("Uploaded to", artifact_uri)
+
+    # log to mlflow
+    run_id = log_to_mlflow(args.capture_id, validated_path if not args.s3_uri else validated_path, args.mlflow_uri, args.schema_name, valid)
+    print("Logged to MLflow run:", run_id)
+
+    # emit lineage
+    emit_lineage_event("ingest_sensor", run_id, inputs=[], outputs=[{"namespace":"aegis","name":f"{args.schema_name}:{args.capture_id}"}])
+
+    # record evidence manifest
+    try:
+        record_manifest("ingest_sensor", {"capture_id": args.capture_id, "rows": valid, "invalid": invalid, "mlflow_run": run_id, "artifact": artifact_uri})
+    except Exception:
+        pass
+
+if __name__=="__main__":
+    main()
+
