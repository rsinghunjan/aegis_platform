+#!/usr/bin/env python3
+"""
+Shards an input text dataset into N shards for distributed training.
+Usage:
+  python3 tools/data/shard_dataset.py data/sample_texts.txt --shards 4 --out-dir data/shards
+"""
+import argparse
+from pathlib import Path
+
+def shard(infile, shards=4, outdir="data/shards"):
+    lines = Path(infile).read_text().splitlines()
+    Path(outdir).mkdir(parents=True, exist_ok=True)
+    for i in range(shards):
+        Path(f"{outdir}/shard_{i}.txt").write_text("\n".join(lines[i::shards]))
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("infile")
+    p.add_argument("--shards", type=int, default=4)
+    p.add_argument("--out-dir", default="data/shards")
+    args = p.parse_args()
+    shard(args.infile, args.shards, args.out_dir)
+
