+#!/usr/bin/env python3
+"""
+Minimal OpenLineage emitter (best-effort).
+ - Set OPENLINEAGE_URL env var to emit run/start/complete events.
+"""
+import os
+import json
+import requests
+from datetime import datetime
+
+OPENLINEAGE_URL = os.environ.get("OPENLINEAGE_URL")
+
+def emit(event_type: str, job_name: str, run_id: str, inputs=None, outputs=None, facets=None):
+    if not OPENLINEAGE_URL:
+        return
+    payload = {
+        "eventType": event_type,
+        "eventTime": datetime.utcnow().isoformat()+"Z",
+        "run": {"runId": run_id},
+        "job": {"namespace": "aegis", "name": job_name},
+        "inputs": inputs or [],
+        "outputs": outputs or [],
+        "facets": facets or {}
+    }
+    try:
+        requests.post(OPENLINEAGE_URL, json=payload, timeout=3)
+    except Exception:
+        pass
