+#!/usr/bin/env python3
+"""
+Run Great Expectations checks against sample dataset.
+ - Requires great_expectations installed.
+ - Produces a simple pass/fail exit code for CI.
+"""
+import sys
+from pathlib import Path
+import great_expectations as ge
+
+DATA_PATH = Path("data/sample_texts.txt")
+
+def run_checks():
+    if not DATA_PATH.exists():
+        print("No dataset", DATA_PATH)
+        return 2
+    df = ge.read_csv(str(DATA_PATH), header=None, names=["text"])
+    suite = ge.core.ExpectationSuite(expectation_suite_name="aegis_suite", data_context=None)
+    # Simple expectations: non-null, min rows
+    df_ge = ge.from_pandas(df)
+    results = df_ge.expect_column_values_to_not_be_null("text")
+    if not results.success:
+        print("Null values found")
+        return 1
+    if df_ge.shape[0] < 1:
+        print("Insufficient rows")
+        return 1
+    print("Data quality checks passed")
+    return 0
+
+if __name__=="__main__":
+    sys.exit(run_checks())
+
