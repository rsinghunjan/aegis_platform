+"""
+Example training script instrumented with MLflow and improved tokenizer usage.
+ - Logs params/metrics and uploads model artifact + evidence manifest.
+"""
+import argparse
+import time
+from pathlib import Path
+from ops.integrations.mlflow_client import start_run, log_params, log_metrics, log_artifact, register_model
+from ops.sdk.evidence_sdk import record_manifest, sign_and_publish_model
+from ops.tokenizer.prod_tokenizer import ProdTokenizer
+
+def dummy_train(epochs=1, out="/tmp/model.pt"):
+    # simulate training and emit a simple model file
+    for e in range(epochs):
+        print("Epoch", e+1)
+        time.sleep(0.5)
+    p = Path(out)
+    p.write_text("dummy-model-bytes")
+    return str(p)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--epochs", type=int, default=1)
+    p.add_argument("--out", default="/tmp/model.pt")
+    args = p.parse_args()
+    tok = ProdTokenizer()
+    tok.build_from_texts(["hello world", "aegis platform demo"])
+
+    run = start_run(run_name="toy_train")
+    try:
+        log_params({"epochs": args.epochs})
+        start_manifest = record_manifest("train_start", {"script":"train_with_mlflow.py","epochs":args.epochs})
+        model_path = dummy_train(args.epochs, args.out)
+        log_artifact(model_path)
+        log_metrics({"train_loss": 0.123})
+        finish_manifest = record_manifest("train_finish", {"artifact": model_path})
+        # register model in MLflow (uri: runs:/<run_id>/model) - best-effort
+        run_id = mlflow_run_id = run.info.run_id
+        model_uri = f"runs:/{run_id}/{Path(model_path).name}"
+        try:
+            register_model(model_uri, "aegis_demo_model")
+        except Exception:
+            pass
+        # attempt to sign & publish artifact to evidence store
+        try:
+            res = sign_and_publish_model(model_path, {"trainer":"mlflow_demo","epochs":args.epochs})
+            print("publish:", res)
+        except Exception as e:
+            print("publish failed:", e)
+    finally:
+        import mlflow
+        mlflow.end_run()
+
+if __name__=="__main__":
+    main()
