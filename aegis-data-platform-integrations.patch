+#!/usr/bin/env python3
+"""
+Simple drift detector using unigram token distribution KL divergence between baseline and new batch.
+This is a conservative, illustrative detector.
+"""
+import json
+from collections import Counter
+from math import log
+from pathlib import Path
+
+def load_texts(p):
+    return Path(p).read_text().splitlines()
+
+def unigram_dist(texts):
+    c = Counter()
+    for t in texts:
+        for w in t.split():
+            c[w] += 1
+    total = sum(c.values())
+    return {k: v/total for k,v in c.items()} if total>0 else {}
+
+def kl_divergence(p, q, eps=1e-10):
+    # KL(P||Q)
+    s = 0.0
+    for k, pv in p.items():
+        qv = q.get(k, eps)
+        s += pv * (log(pv+eps) - log(qv+eps))
+    return s
+
+def detect(baseline_path, candidate_path, threshold=0.5):
+    base = unigram_dist(load_texts(baseline_path))
+    cand = unigram_dist(load_texts(candidate_path))
+    score = kl_divergence(base, cand)
+    return score, score > threshold
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("usage: drift_detector baseline candidate")
+        sys.exit(2)
+    sc, drift = detect(sys.argv[1], sys.argv[2])
+    print("KL:", sc, "drift:", drift)
+    sys.exit(0 if not drift else 1)
+
