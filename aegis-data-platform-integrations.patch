+#!/usr/bin/env python3
+"""
+Tiny schema registry: stores JSON schemas on disk (config/schemas) and exposes a minimal API.
+Intended as a simple, versioned registry for datasets and model input specs.
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from pathlib import Path
+import json
+
+BASE = Path("config/schemas")
+BASE.mkdir(parents=True, exist_ok=True)
+
+app = FastAPI(title="Aegis Schema Registry")
+
+class SchemaIn(BaseModel):
+    name: str
+    version: int
+    schema: dict
+
+@app.post("/schema")
+def add_schema(s: SchemaIn):
+    p = BASE / f"{s.name}_v{s.version}.json"
+    p.write_text(json.dumps(s.schema, indent=2))
+    return {"ok": True}
+
+@app.get("/schema/{name}/{version}")
+def get_schema(name: str, version: int):
+    p = BASE / f"{name}_v{version}.json"
+    if not p.exists():
+        raise HTTPException(status_code=404, detail="schema not found")
+    return json.loads(p.read_text())
+
+if __name__=="__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=8100)
+
