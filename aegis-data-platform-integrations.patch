+#!/usr/bin/env python3
+"""
+Production tokenizer wrapper using Hugging Face tokenizers (fast).
+Provides encode/decode and vocab save/load.
+"""
+from tokenizers import Tokenizer, models, pre_tokenizers, trainers
+from pathlib import Path
+
+VOCAB_FILE = Path("ops/tokenizer/tokenizer.json")
+
+class ProdTokenizer:
+    def __init__(self):
+        if VOCAB_FILE.exists():
+            self.tok = Tokenizer.from_file(str(VOCAB_FILE))
+        else:
+            self.tok = Tokenizer(models.BPE())
+            self.tok.pre_tokenizer = pre_tokenizers.Whitespace()
+
+    def build_from_texts(self, texts, vocab_size=30000):
+        trainer = trainers.BpeTrainer(vocab_size=vocab_size, show_progress=True, special_tokens=["<pad>","<unk>","<bos>","<eos>"])
+        self.tok.train_from_iterator(iter(texts), trainer=trainer)
+        VOCAB_FILE.parent.mkdir(parents=True, exist_ok=True)
+        self.tok.save(str(VOCAB_FILE))
+        return VOCAB_FILE
+
+    def encode(self, text):
+        return self.tok.encode(text).ids
+
+    def decode(self, ids):
+        return self.tok.decode(ids)
+
