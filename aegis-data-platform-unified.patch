+#!/usr/bin/env python3
+"""
+Simple JDBC -> Parquet -> S3 exporter.
+Use for scheduled batch extracts or as a basis for CDC snapshots.
+"""
+import os
+import pandas as pd
+from sqlalchemy import create_engine
+import pyarrow as pa
+import pyarrow.parquet as pq
+import boto3
+
+DB_URL = os.environ.get("JDBC_URL", "sqlite:///./sample.db")
+S3_BUCKET = os.environ.get("DATA_BUCKET", "aegis-data-bucket")
+S3_KEY_PREFIX = os.environ.get("DATA_PREFIX", "raw/")
+
+def export_query_to_s3(query: str, out_filename: str = "export.parquet"):
+    engine = create_engine(DB_URL)
+    df = pd.read_sql_query(query, engine)
+    table = pa.Table.from_pandas(df)
+    pq.write_table(table, out_filename)
+    s3 = boto3.client("s3")
+    key = f"{S3_KEY_PREFIX}{out_filename}"
+    s3.upload_file(out_filename, S3_BUCKET, key)
+    print("Wrote:", f"s3://{S3_BUCKET}/{key}")
+
+if __name__ == "__main__":
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--query", required=True)
+    ap.add_argument("--out", default="export.parquet")
+    args = ap.parse_args()
+    export_query_to_s3(args.query, out_filename=args.out)
+
