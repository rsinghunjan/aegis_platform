+def register_dataset(name: str, platform: str = "s3", path: str = "s3://aegis-data-bucket/curated/"):
+    payload = {
+        "entityType": "dataset",
+        "entity": {
+            "aspect": {
+                "com.linkedin.pegasus2avro.dataset.DatasetKey": {
+                    "platform": platform,
+                    "name": name
+                }
+            }
+        }
+    }
+    # This uses a very simple DataHub API shape placeholder; adapt to your DataHub version.
+    r = requests.post(f"{DATAHUB_GMS}/entities?action=ingest", json=payload)
+    r.raise_for_status()
+    print("Registered dataset", name)
+
+if __name__ == "__main__":
+    register_dataset("aegis.curated.events")
