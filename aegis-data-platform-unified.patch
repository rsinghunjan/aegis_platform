+#!/usr/bin/env python3
+"""
+Lightweight dataset access audit logger.
+Writes lines to S3 or local file for ingestion into audit/forensics pipelines.
+"""
+import os
+import json
+import time
+from pathlib import Path
+
+AUDIT_PATH = Path(os.environ.get("AUDIT_PATH", "/var/log/aegis/audit"))
+AUDIT_PATH.mkdir(parents=True, exist_ok=True)
+
+def log_access(user: str, dataset: str, action: str, details: dict = None):
+    entry = {
+        "ts": int(time.time()),
+        "user": user,
+        "dataset": dataset,
+        "action": action,
+        "details": details or {}
+    }
+    fname = AUDIT_PATH / f"audit_{int(time.time())}.json"
+    with open(fname, "w") as fh:
+        fh.write(json.dumps(entry))
+    return str(fname)
+
+if __name__ == "__main__":
+    print(log_access("alice", "curated.users", "read", {"rows": 100}))
+
