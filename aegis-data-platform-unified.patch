+"""Airflow DAG: simple ETL from a JDBC source (or S3), run Great Expectations checks, and write Parquet to S3."""
+from datetime import datetime, timedelta
+from airflow import DAG
+from airflow.operators.python import PythonOperator
+import os
+import pandas as pd
+import boto3
+import great_expectations as ge
+
+S3_BUCKET = os.environ.get("DATA_BUCKET", "aegis-data-bucket")
+S3_PREFIX = os.environ.get("DATA_PREFIX", "curated/")
+
+def extract_from_jdbc(**ctx):
+    # Placeholder: replace with your DB connector & query
+    # Example uses CSV for demo
+    df = pd.read_csv("/tmp/sample_input.csv")
+    df.to_parquet("/tmp/stage.parquet", index=False)
+    return "/tmp/stage.parquet"
+
+def validate_with_ge(path: str, **ctx):
+    df = ge.from_pandas(pd.read_parquet(path))
+    suite = {
+        "expectations": [
+            {"expectation_type": "expect_table_row_count_to_be_between", "kwargs": {"min_value": 1}},
+            {"expectation_type": "expect_column_values_to_not_be_null", "kwargs": {"column": df.columns[0]}}
+        ]
+    }
+    res = df.validate(expectation_suite=suite, catch_exceptions=False)
+    if not res["success"]:
+        raise RuntimeError("Data quality checks failed")
+    return True
+
+def load_to_s3(path: str, **ctx):
+    s3 = boto3.client("s3")
+    key = f"{S3_PREFIX}{os.path.basename(path)}"
+    s3.upload_file(path, S3_BUCKET, key)
+    return f"s3://{S3_BUCKET}/{key}"
+
+default_args = {
+    "owner": "aegis",
+    "depends_on_past": False,
+    "email_on_failure": True,
+    "retries": 1,
+    "retry_delay": timedelta(minutes=5)
+}
+
+with DAG("etl_parquet_ge", start_date=datetime(2023,1,1), schedule_interval="@daily", default_args=default_args, catchup=False) as dag:
+    t1 = PythonOperator(task_id="extract", python_callable=extract_from_jdbc)
+    t2 = PythonOperator(task_id="validate", python_callable=validate_with_ge, op_args=["/tmp/stage.parquet"])
+    t3 = PythonOperator(task_id="load", python_callable=load_to_s3, op_args=["/tmp/stage.parquet"])
+    t1 >> t2 >> t3
+
