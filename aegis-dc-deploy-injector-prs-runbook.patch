+#!/usr/bin/env python3
+"""
+Render a tailored Helm bundle for an enterprise data center.
+
+This script:
+ - Accepts parameters (vault address, s3 endpoint, rekor server, dns domain)
+ - Renders the helm chart to a directory (requires helm on PATH to produce templated manifests)
+ - If helm is not installed, it writes a values.generated.yaml and copies chart to outdir for operator use
+
+Usage:
+  python3 ops/helm/render_tailored_bundle.py --out /tmp/aegis_bundle \
+      --vault https://vault.example.internal:8200 \
+      --s3 https://minio.internal:9000 --bucket aegis-evidence \
+      --rekor https://rekor.internal:3000 --dns internal.example
+"""
+import argparse
+import shutil
+import subprocess
+from pathlib import Path
+import yaml
+import os
+
+ROOT = Path("helm/aegis-dc")
+
+def write_values(outdir, args):
+    v = {
+        "vault": {"address": args.vault, "role": args.vault_role, "secretProviderClass": args.sp_class},
+        "evidence": {"s3Endpoint": args.s3, "bucket": args.bucket, "region": args.s3_region},
+        "rekor": {"server": args.rekor},
+        "dns": {"domain": args.dns}
+    }
+    p = Path(outdir) / "values.generated.yaml"
+    p.write_text(yaml.safe_dump(v))
+    return p
+
+def helm_template(outdir, values_file):
+    try:
+        subprocess.check_call(["helm", "template", "aegis-dc", str(ROOT), "-f", str(values_file), "--output-dir", str(outdir)])
+        return True
+    except Exception as e:
+        print("helm template failed or helm not installed:", e)
+        return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", default="/tmp/aegis_bundle")
+    p.add_argument("--vault", required=True)
+    p.add_argument("--vault-role", default="aegis-grpc-server")
+    p.add_argument("--sp-class", default="aegis-vault-certs")
+    p.add_argument("--s3", required=True)
+    p.add_argument("--bucket", required=True)
+    p.add_argument("--s3-region", default="local")
+    p.add_argument("--rekor", required=True)
+    p.add_argument("--dns", required=True)
+    args = p.parse_args()
+    outdir = Path(args.out)
+    if outdir.exists():
+        shutil.rmtree(outdir)
+    outdir.mkdir(parents=True)
+    values_file = write_values(outdir, args)
+    ok = helm_template(outdir, values_file)
+    if not ok:
+        # fallback: copy chart and generated values
+        shutil.copytree(ROOT, outdir / "aegis-dc", dirs_exist_ok=True)
+        print("Helm not available: chart and values written to", outdir)
+    else:
+        print("Rendered templates in", outdir)
+
+if __name__=="__main__":
+    main()
+
