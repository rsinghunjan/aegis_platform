+#!/usr/bin/env python3
+"""
+Apply injector patches and open draft PRs for reviewers.
+
+Workflow:
+ - Run injector to produce patched files into a temp directory (uses ops/autonomy/run_injector_and_generate_diffs.py)
+ - For each patched file, create a branch, copy patched file(s) into working tree, commit, push and open a draft PR using `gh` CLI.
+
+Important:
+ - This script will push branches to origin. Use DO_OPEN_PR=false for dry-run.
+ - Requires git remote 'origin' and gh CLI authenticated.
+
+Usage:
+  DO_OPEN_PR=true python3 ops/autonomy/apply_injector_and_create_prs.py --paths services controllers --branch-prefix inject/safety
+"""
+import argparse
+import tempfile
+import shutil
+import subprocess
+import os
+from pathlib import Path
+
+INJECTOR_RUNNER = Path("ops/autonomy/run_injector_and_generate_diffs.py")
+
+def run_injector(paths, outdir):
+    cmd = [os.environ.get("PYTHON", "python3"), str(INJECTOR_RUNNER), "--paths"] + paths + ["--out", str(outdir)]
+    subprocess.check_call(cmd)
+
+def collect_patched_files(patched_dir):
+    return list(Path(patched_dir).rglob("*.py"))
+
+def create_branch_and_pr(patched_files, branch_name, pr_title, pr_body):
+    # create branch
+    subprocess.check_call(["git", "checkout", "-b", branch_name])
+    for pf in patched_files:
+        dest = Path(pf.name)
+        shutil.copy2(pf, dest)
+        subprocess.check_call(["git", "add", str(dest)])
+    # commit
+    try:
+        subprocess.check_call(["git", "commit", "-m", pr_title])
+    except subprocess.CalledProcessError:
+        print("Nothing to commit on branch", branch_name)
+    # push
+    subprocess.check_call(["git", "push", "--set-upstream", "origin", branch_name])
+    # open draft PR
+    try:
+        subprocess.check_call(["gh", "pr", "create", "--title", pr_title, "--body", pr_body, "--base", "main", "--head", branch_name, "--draft"])
+        print("Draft PR created for branch", branch_name)
+    except Exception as e:
+        print("Failed to create PR via gh:", e)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--paths", nargs="+", default=["services","controllers"])
+    p.add_argument("--branch-prefix", default="inject/safety")
+    p.add_argument("--tmp", default=None)
+    args = p.parse_args()
+
+    tmpdir = args.tmp or tempfile.mkdtemp(prefix="aegis_inject_")
+    try:
+        run_injector(args.paths, tmpdir)
+        patched = collect_patched_files(tmpdir)
+        if not patched:
+            print("No patched files generated; nothing to do.")
+            return
+        # Group patches by top-level package (parent dir name)
+        groups = {}
+        for pfile in patched:
+            pkg = Path(pfile.name).parent.name or "repo"
+            groups.setdefault(pkg, []).append(pfile)
+        for pkg, files in groups.items():
+            branch = f"{args.branch_prefix}/{pkg}"
+            title = f"chore: inject safety_monitor instrumentation into {pkg}"
+            body = "Automated instrumentation injection. Please review changes and run tests before merging."
+            if os.environ.get("DO_OPEN_PR","false").lower() == "true":
+                create_branch_and_pr(files, branch, title, body)
+            else:
+                print("Dry-run mode: patch group for", pkg)
+                for f in files:
+                    print(" -", f)
+    finally:
+        if args.tmp is None:
+            shutil.rmtree(tmpdir)
+
+if __name__=="__main__":
+    main()
+
