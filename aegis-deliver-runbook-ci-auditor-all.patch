+#!/usr/bin/env python3
+"""
+Auditor package builder (all-in-one)
+ - Collects RT proofs, HIL bundles, Apalache outputs, perception artifacts and provenance evidence
+ - Builds evidence manifest and tar.gz bundle, cosign-signs (if key provided) and optionally uploads to S3
+"""
+import argparse
+import json
+import os
+import subprocess
+import tarfile
+from glob import glob
+from datetime import datetime
+
+def collect(patterns, root="."):
+    files=[]
+    for p in patterns:
+        files += glob(os.path.join(root,p), recursive=True)
+    return sorted(set(files))
+
+def build_manifest(root, vehicle, s3_base=""):
+    patterns = {
+        "rt_proofs": ["**/rt_slo_proof.json"],
+        "hil_bundles": ["**/*hil_cert_bundle*.tar.gz","**/*cert_bundle*.tar.gz"],
+        "formal": ["ops/formal/*.tla","**/apalache_outputs/**"],
+        "perception": ["**/perception/**","**/adv_dataset/**","**/*.onnx"],
+        "provenance": ["**/rekor_search*.json","**/cosign_verify*.txt"]
+    }
+    manifest = {"vehicle": vehicle, "generated_at": datetime.utcnow().isoformat()+"Z", "artifacts": {}}
+    for k,pat in patterns.items():
+        manifest["artifacts"][k] = collect(pat, root)
+    if s3_base:
+        manifest["s3_base"] = s3_base
+    path=f"/tmp/{vehicle}_evidence_manifest_{int(datetime.utcnow().timestamp())}.json"
+    with open(path,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return path
+
+def package_files(manifest_path, out_bundle):
+    with tarfile.open(out_bundle,"w:gz") as t:
+        t.add(manifest_path, arcname=os.path.basename(manifest_path))
+        m=json.load(open(manifest_path))
+        for k,files in m.get("artifacts",{}).items():
+            for f in files:
+                if os.path.exists(f):
+                    t.add(f, arcname=os.path.relpath(f))
+    return out_bundle
+
+def sign_bundle(bundle, cosign_key):
+    if not cosign_key:
+        return False
+    try:
+        subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        return True
+    except Exception as e:
+        print("cosign sign failed:", e)
+        return False
+
+def upload_bundle(bundle, s3_target):
+    if not s3_target:
+        return False
+    try:
+        subprocess.check_call(["aws","s3","cp",bundle,s3_target])
+        return True
+    except Exception as e:
+        print("s3 upload failed:", e)
+        return False
+
+if __name__=="__main__":
+    p=argparse.ArgumentParser()
+    p.add_argument("--root", default=".")
+    p.add_argument("--vehicle", default="FalconAV")
+    p.add_argument("--out", default=f"/tmp/falconav_auditor_bundle_{int(datetime.utcnow().timestamp())}.tar.gz")
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    args=p.parse_args()
+    manifest=build_manifest(args.root, args.vehicle, args.s3)
+    print("Built manifest:", manifest)
+    bundle=package_files(manifest, args.out)
+    print("Packaged bundle:", bundle)
+    signed=sign_bundle(bundle, args.cosign_key)
+    print("Signed:", signed)
+    if args.s3:
+        ok=upload_bundle(bundle, os.path.join(args.s3, os.path.basename(bundle)))
+        print("Uploaded to S3:", ok)
+    # record manifest best-effort
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("auditor_bundle_built", {"bundle": bundle, "manifest": manifest})
+    except Exception:
+        pass
+    print("Auditor package complete. Bundle:", bundle)
+
