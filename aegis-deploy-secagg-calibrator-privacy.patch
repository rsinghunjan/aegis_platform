+#!/usr/bin/env python3
+"""
+Generate a privacy tuning decision report based on CSV results produced by the tuning sweep.
+Input: CSV produced by tune_runner/tune sweep having fields: noise, sample_rate, epsilon, accuracy, record_path
+Output: Markdown decision report summarizing tradeoffs and recommended parameters.
+"""
+import argparse, csv, statistics, json
+from datetime import datetime
+
+def read_results(path):
+    rows=[]
+    with open(path) as fh:
+        r = csv.DictReader(fh)
+        for row in r:
+            # coerce numeric fields
+            for k in ("noise","sample_rate","epsilon","accuracy"):
+                if row.get(k) is not None and row[k]!="":
+                    try:
+                        row[k] = float(row[k])
+                    except:
+                        row[k] = None
+            rows.append(row)
+    return rows
+
+def pick_recommendation(rows, epsilon_budget=2.0):
+    # Simple heuristic: choose highest accuracy with epsilon <= budget
+    candidates = [r for r in rows if r.get("epsilon") is not None and r.get("epsilon") <= epsilon_budget]
+    if not candidates:
+        # fallback: choose min epsilon
+        rows_sorted = sorted(rows, key=lambda r: (r.get("epsilon") or 1e9, - (r.get("accuracy") or 0)))
+        return rows_sorted[0] if rows_sorted else None
+    # pick max accuracy
+    best = max(candidates, key=lambda r: (r.get("accuracy") or 0))
+    return best
+
+def generate_md(rows, recommended, out):
+    ts = datetime.utcnow().isoformat()
+    with open(out,"w") as fh:
+        fh.write(f"# Privacy Tuning Decision Report\n\n")
+        fh.write(f"generated_at: {ts}\n\n")
+        fh.write("## Summary\n\n")
+        if recommended:
+            fh.write(f"Recommended parameters: noise={recommended.get('noise')}, sample_rate={recommended.get('sample_rate')}, epsilon={recommended.get('epsilon')}, accuracy={recommended.get('accuracy')}\n\n")
+        else:
+            fh.write("No recommendation could be determined\n\n")
+        fh.write("## All trials\n\n")
+        fh.write("|noise|sample_rate|epsilon|accuracy|record|\n")
+        fh.write("|----:|----------:|------:|-------:|------|\n")
+        for r in rows:
+            fh.write(f"|{r.get('noise') or ''}|{r.get('sample_rate') or ''}|{r.get('epsilon') or ''}|{r.get('accuracy') or ''}|{r.get('record_path') or ''}|\n")
+    print("Wrote report to", out)
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--results-csv", required=True)
+    p.add_argument("--epsilon-budget", type=float, default=2.0)
+    p.add_argument("--out", default="/tmp/privacy_decision.md")
+    args = p.parse_args()
+    rows = read_results(args.results_csv)
+    recommended = pick_recommendation(rows, args.epsilon_budget)
+    generate_md(rows, recommended, args.out)
+
+if __name__=="__main__":
+    main()
+
