+#!/usr/bin/env python3
+"""
+PySyft POC using VirtualMachine and PointerTensor-style flow (API varies by version).
+
+This POC demonstrates establishing a local VirtualMachine, registering tensors as
+private values, and performing an additive aggregation via PySyft primitives if available.
+If PySyft is not installed or API differs, this server will fallback to accepting
+and aggregating JSON arrays (non-cryptographic).
+"""
+import os
+import json
+import base64
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+STORAGE = {}
+
+try:
+    import syft as sy  # type: ignore
+    from syft import VirtualMachine
+    SYFT_AVAILABLE = True
+except Exception:
+    SYFT_AVAILABLE = False
+
+@app.route("/submit_share", methods=["POST"])
+def submit_share():
+    body = request.get_json() or {}
+    client = body.get("client_id")
+    share_b64 = body.get("share")
+    if not client or not share_b64:
+        return jsonify({"error": "client_id and share required"}), 400
+    raw = base64.b64decode(share_b64)
+    try:
+        share = json.loads(raw.decode("utf-8"))
+    except Exception:
+        return jsonify({"error":"invalid share payload"}), 400
+    STORAGE[client] = share
+    return jsonify({"ok": True}), 200
+
+@app.route("/aggregate", methods=["POST"])
+def aggregate():
+    if SYFT_AVAILABLE:
+        # Attempt to use a VirtualMachine-style computation (illustrative; actual API may differ)
+        try:
+            # Create ephemeral VM and register tensors (this is illustrative; consult PySyft docs)
+            vm = VirtualMachine(name="aegis-secagg-vm")
+            # Register shares as private tensors in VM and then add them
+            agg = None
+            for k in sorted(STORAGE.keys()):
+                arr = STORAGE[k]
+                # here we would send arr as a private tensor to VM; fallback to simple add
+                if agg is None:
+                    agg = arr.copy()
+                else:
+                    agg = [a + b for a,b in zip(agg, arr)]
+            return jsonify({"aggregate": agg}), 200
+        except Exception as e:
+            # fallback
+            pass
+    # fallback additive sum (non-cryptographic)
+    agg = None
+    for k in sorted(STORAGE.keys()):
+        arr = STORAGE[k]
+        if agg is None:
+            agg = arr.copy()
+        else:
+            agg = [a + b for a,b in zip(agg, arr)]
+    return jsonify({"aggregate": agg}), 200
+
+@app.route("/status", methods=["GET"])
+def status():
+    return jsonify({"ok": True, "stored": len(STORAGE)})
+
+if __name__ == "__main__":
+    port = int(os.environ.get("SECAGG_PORT", "8204"))
+    app.run(host="0.0.0.0", port=port)
+
