+#!/usr/bin/env python3
+"""
+Minimal example of a distributed PyTorch training script.
+Intended as a template for multi-node / multi-GPU training using torch.distributed / torchrun.
+Logs metrics to MLflow and saves periodic checkpoints to local fs (caller should upload to S3).
+
+Usage (single-node multi-gpu):
+  torchrun --nproc_per_node=4 ops/dl/distributed/train_torch_distributed.py --epochs 2 --batch-size 16
+
+For multi-node, use torchrun with --nnodes / --node_rank and appropriate --rdzv backend.
+"""
+import argparse, os, time
+import torch
+import torch.nn as nn
+import torch.optim as optim
+from torch.utils.data import DataLoader, TensorDataset
+import mlflow
+
+def make_model():
+    return nn.Sequential(
+        nn.Conv2d(3, 16, kernel_size=3, stride=2, padding=1),
+        nn.ReLU(),
+        nn.AdaptiveAvgPool2d((1,1)),
+        nn.Flatten(),
+        nn.Linear(16, 10)
+    )
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--epochs", type=int, default=1)
+    parser.add_argument("--batch-size", type=int, default=32)
+    parser.add_argument("--mlflow-uri", default=os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    parser.add_argument("--checkpoint-dir", default="/tmp/checkpoints")
+    args = parser.parse_args()
+
+    os.makedirs(args.checkpoint_dir, exist_ok=True)
+
+    # simple synthetic dataset
+    x = torch.randn(1024,3,64,64)
+    y = torch.randint(0,10,(1024,))
+    ds = TensorDataset(x,y)
+    dl = DataLoader(ds, batch_size=args.batch_size, shuffle=True)
+
+    # distributed init (if launched with torchrun)
+    if "RANK" in os.environ and "WORLD_SIZE" in os.environ:
+        rank = int(os.environ["RANK"])
+        world_size = int(os.environ["WORLD_SIZE"])
+        torch.distributed.init_process_group(backend="nccl")
+        local_rank = int(os.environ.get("LOCAL_RANK", 0))
+        device = torch.device(f"cuda:{local_rank}" if torch.cuda.is_available() else "cpu")
+    else:
+        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+
+    model = make_model().to(device)
+    if torch.cuda.device_count() > 1:
+        model = nn.parallel.DistributedDataParallel(model, device_ids=[device.index] if device.type=="cuda" else None)
+
+    opt = optim.Adam(model.parameters(), lr=1e-3)
+    loss_fn = nn.CrossEntropyLoss()
+
+    mlflow.set_tracking_uri(args.mlflow_uri)
+    with mlflow.start_run(run_name="distributed_train_example") as run:
+        mlflow.log_param("batch_size", args.batch_size)
+        mlflow.log_param("epochs", args.epochs)
+        for epoch in range(args.epochs):
+            model.train()
+            total_loss = 0.0
+            for i,(bx,by) in enumerate(dl):
+                bx = bx.to(device); by = by.to(device)
+                opt.zero_grad()
+                out = model(bx)
+                loss = loss_fn(out, by)
+                loss.backward()
+                opt.step()
+                total_loss += loss.item()
+            mlflow.log_metric("train_loss", total_loss, step=epoch)
+            ckpt = os.path.join(args.checkpoint_dir, f"model_epoch_{epoch}.pt")
+            # only rank 0 writes checkpoint if distributed
+            should_save = (not torch.distributed.is_initialized()) or torch.distributed.get_rank() == 0
+            if should_save:
+                torch.save({"epoch": epoch, "state_dict": model.state_dict()}, ckpt)
+                mlflow.log_artifact(ckpt, artifact_path="checkpoints")
+    print("Training complete")
+
+if __name__=="__main__":
+    main()
+
