+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to launch a multi-node / multi-GPU torchrun job.
+# This is a thin wrapper; adapt the rendezvous (rdzv) backend to your cluster (e.g., etcd, file, env).
+#
+NNODES=${NNODES:-1}
+NPROC_PER_NODE=${NPROC_PER_NODE:-4}
+MASTER_ADDR=${MASTER_ADDR:-127.0.0.1}
+MASTER_PORT=${MASTER_PORT:-29500}
+NNODE_RANK=${NNODE_RANK:-0}
+
+# Example usage:
+# MASTER_ADDR=10.0.0.1 MASTER_PORT=29500 NNODES=2 NNODE_RANK=0 NPROC_PER_NODE=4 ./launch_torch_distributed.sh
+
+echo "Launching torchrun: nnodes=${NNODES} nproc_per_node=${NPROC_PER_NODE} node_rank=${NNODE_RANK}"
+exec torchrun --nnodes ${NNODES} --nproc_per_node ${NPROC_PER_NODE} --rdzv_backend=c10d --rdzv_endpoint ${MASTER_ADDR}:${MASTER_PORT} --node_rank ${NNODE_RANK} ops/dl/distributed/train_torch_distributed.py --epochs 2 --batch-size 32
+
