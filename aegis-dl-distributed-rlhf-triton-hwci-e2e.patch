+#!/usr/bin/env bash
+set -euo pipefail
+#
+# End-to-end orchestrator for:
+# - Run distributed training (torchrun) or Ray job
+# - Upload checkpoints to S3 via checkpoint_uploader.py
+# - Export ONNX and validate runtimes (ONNXRuntime/TensorRT)
+# - Package model into Triton model repo and sign + Rekor register
+#
+S3_PREFIX=${1:-s3://aegis-models}
+JOB_TYPE=${JOB_TYPE:-local}  # "local" or "ray"
+CHECKPOINT_DIR=${CHECKPOINT_DIR:-/tmp/checkpoints}
+MODEL_ONNX=${MODEL_ONNX:-/tmp/model.onnx}
+TRITON_MODELS_DIR=${TRITON_MODELS_DIR:-/tmp/triton_models}
+IMAGE_TAG=${IMAGE_TAG:-internal-registry/aegis/dl-train:ci}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+REKOR_SERVER=${REKOR_SERVER:-}
+
+mkdir -p "$CHECKPOINT_DIR" "$TRITON_MODELS_DIR"
+
+echo "[1] Launch training (local torchrun single-node for demo)"
+torchrun --nproc_per_node=1 ops/dl/distributed/train_torch_distributed.py --epochs 1 --batch-size 8 --checkpoint-dir "$CHECKPOINT_DIR"
+
+echo "[2] Upload checkpoints to S3"
+for f in "$CHECKPOINT_DIR"/*.pt; do
+  if [ -f "$f" ]; then
+    python3 ops/multimodal/scale/checkpoint_uploader.py "$f" "$S3_PREFIX"
+  fi
+done
+
+echo "[3] Export ONNX (expect checkpoint exists)"
+python3 ops/multimodal/training/export_onnx.py --ckpt $(ls -1 $CHECKPOINT_DIR/*.pt | tail -n1) --out "$MODEL_ONNX"
+
+echo "[4] Validate runtimes on runner"
+python3 ops/multimodal/ci/validate_runtimes_all.sh "$MODEL_ONNX" /tmp/runtime_val || true
+
+echo "[5] Package Triton model repo"
+MODEL_DIR="$TRITON_MODELS_DIR/aegis_multimodal/1"
+mkdir -p "$MODEL_DIR"
+cp "$MODEL_ONNX" "$MODEL_DIR/model.onnx"
+cp ops/dl/inference/triton_repo/example_model/config.pbtxt "$TRITON_MODELS_DIR/aegis_multimodal/config.pbtxt"
+
+echo "[6] Tar and sign model repo"
+tar -czf /tmp/aegis_triton_model.tar.gz -C "$TRITON_MODELS_DIR" .
+if [ -n "$COSIGN_KMS_URI" ]; then
+  cosign sign --key "$COSIGN_KMS_URI" /tmp/aegis_triton_model.tar.gz || true
+fi
+
+if [ -n "$REKOR_SERVER" ]; then
+  rekor-cli search --rekor_server "$REKOR_SERVER" --artifact /tmp/aegis_triton_model.tar.gz > /tmp/rekor_search.json 2>/dev/null || true
+fi
+
+python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("e2e_training_and_validation", {"checkpoint_dir":"$CHECKPOINT_DIR","onnx":"$MODEL_ONNX","triton_model":"/tmp/aegis_triton_model.tar.gz"})
+print("Recorded E2E evidence manifest")
+PY
+
+echo "E2E pipeline complete. Artifacts: /tmp/aegis_triton_model.tar.gz"
+
