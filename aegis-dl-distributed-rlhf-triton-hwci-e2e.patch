+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Startup script for a self-hosted hardware runner VM.
+# Installs Docker, NVIDIA drivers (placeholder), cosign, GitHub Actions runner registration (operator must supply token).
+#
+RUNNER_DIR=${RUNNER_DIR:-/opt/actions-runner}
+GITHUB_URL=${GITHUB_URL:-https://github.com/your-org/your-repo}
+RUNNER_TOKEN=${RUNNER_TOKEN:-}
+RUNNER_NAME=${RUNNER_NAME:-aegis-hw-runner-$(hostname)}
+
+apt-get update
+apt-get install -y docker.io jq curl ca-certificates || true
+systemctl enable --now docker || true
+
+echo "Install cosign (simple curl download)"
+COSIGN_VER="2.1.0"
+curl -L -o /usr/local/bin/cosign https://github.com/sigstore/cosign/releases/download/v${COSIGN_VER}/cosign-linux-amd64
+chmod +x /usr/local/bin/cosign || true
+
+mkdir -p "$RUNNER_DIR"
+chown $(whoami) "$RUNNER_DIR"
+cd "$RUNNER_DIR"
+if [ ! -f actions-runner-linux-x64-2.308.0.tar.gz ]; then
+  echo "Download GitHub Actions runner tarball (operator must update version)"
+  curl -L -o actions-runner.tar.gz https://github.com/actions/runner/releases/download/v2.308.0/actions-runner-linux-x64-2.308.0.tar.gz || true
+  tar xzf actions-runner.tar.gz
+fi
+
+if [ -z "$RUNNER_TOKEN" ]; then
+  echo "No RUNNER_TOKEN provided — short-lived registration token must be supplied by operator"
+else
+  ./config.sh --url "$GITHUB_URL" --token "$RUNNER_TOKEN" --name "$RUNNER_NAME" --work _work --labels self-hosted,hardware || true
+  ./svc.sh install || true
+  ./svc.sh start || true
+fi
+
+echo "Runner startup complete. Operator must ensure NVIDIA drivers and CUDA are installed for GPU workloads."
+
