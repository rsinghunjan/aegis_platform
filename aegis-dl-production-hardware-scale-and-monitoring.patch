+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Generic spot/preempt handler for containers: trap TERM and upload checkpoint before exit.
+#
+CHECKPOINT_PATH=${CHECKPOINT_PATH:-/tmp/checkpoint.pt}
+UPLOAD_CMD=${UPLOAD_CMD:-"python3 ops/multimodal/scale/checkpoint_uploader.py $CHECKPOINT_PATH $S3_PREFIX"}
+
+term_handler() {
+  echo "Received SIGTERM - attempt to save and upload checkpoint"
+  # application should write checkpoint to $CHECKPOINT_PATH prior to catching signal; fallback: touch
+  if [ ! -f "$CHECKPOINT_PATH" ]; then
+    echo "{}" > "$CHECKPOINT_PATH"
+  fi
+  echo "Uploading checkpoint..."
+  eval "$UPLOAD_CMD" || true
+  echo "Upload attempt complete - exiting"
+  exit 0
+}
+
+trap term_handler SIGTERM
+
+# Keep process alive to simulate training container's entrypoint waiting for TERM
+echo "Preemption handler active; waiting for SIGTERM"
+while true; do sleep 60; done
+
