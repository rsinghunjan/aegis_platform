+#!/usr/bin/env python3
+"""
+Shard a large dataset into N tar shards using simple hashing (WebDataset-compatible).
+Usage:
+  python3 data_sharder.py --input /path/to/records.ndjson --shards 100 --out /tmp/shards
+"""
+import argparse, os, json, hashlib
+
+def shard(path, shards, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    handles = [open(os.path.join(outdir,f"shard-{i:05d}.ndjson"), "w") for i in range(shards)]
+    with open(path) as fh:
+        for line in fh:
+            h = hashlib.sha256(line.encode("utf-8")).digest()
+            idx = int.from_bytes(h[:4], "big") % shards
+            handles[idx].write(line)
+    for h in handles:
+        h.close()
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--input", required=True)
+    p.add_argument("--shards", type=int, default=16)
+    p.add_argument("--out", default="/tmp/shards")
+    args = p.parse_args()
+    shard(args.input, args.shards, args.out)
+    print("Sharded dataset to", args.out)
+
