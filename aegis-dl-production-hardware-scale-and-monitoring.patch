+#!/usr/bin/env python3
+"""
+Simple orchestrator helper: queries cost monitor endpoint (or MLflow evidence) and pauses Kubernetes training Jobs by adding label 'paused=true'.
+This is a conservative operator action; requires kubeconfig and permissions.
+"""
+import os, subprocess, json, time
+from kubernetes import client, config
+
+THRESHOLD_USD = float(os.environ.get("TRAINING_BUDGET_USD", "1000"))
+
+def get_estimated_cost():
+    # Placeholder: read a metrics endpoint or file; operator to replace with real source.
+    # For demo, return 0
+    return 0.0
+
+def pause_jobs(label_selector="aegis/training=true"):
+    config.load_kube_config()
+    api = client.BatchV1Api()
+    jobs = api.list_job_for_all_namespaces(label_selector=label_selector)
+    for j in jobs.items:
+        name = j.metadata.name; ns = j.metadata.namespace
+        if j.metadata.labels and j.metadata.labels.get("paused") == "true":
+            continue
+        # patch to add label
+        body = {"metadata":{"labels":{"paused":"true"}}}
+        api.patch_namespaced_job(name, ns, body)
+        print("Paused job", ns, name)
+
+def main():
+    cost = get_estimated_cost()
+    print("Estimated cost:", cost)
+    if cost > THRESHOLD_USD:
+        print("Cost exceeded threshold; pausing jobs")
+        pause_jobs()
+
+if __name__=="__main__":
+    main()
+
