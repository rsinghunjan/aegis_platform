+#!/usr/bin/env python3
+"""
+Lightweight DP accounting store and checker.
+ - Tracks per-client (or per-api-key) cumulative epsilon usage.
+ - Stores state in SQLite for simplicity; in prod use a hardened service.
+"""
+import sqlite3, os, time
+DB = os.environ.get("DP_DB","/tmp/dp_accounting.db")
+
+def init():
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("CREATE TABLE IF NOT EXISTS accounts (client TEXT PRIMARY KEY, epsilon REAL, last_update INTEGER)")
+    conn.commit()
+    conn.close()
+
+def charge(client: str, eps: float):
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("INSERT OR IGNORE INTO accounts(client,epsilon,last_update) VALUES(?,?,?)", (client,0.0,int(time.time())))
+    c.execute("UPDATE accounts SET epsilon = epsilon + ?, last_update = ? WHERE client = ?", (eps,int(time.time()),client))
+    conn.commit()
+    conn.close()
+
+def get_epsilon(client: str) -> float:
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("SELECT epsilon FROM accounts WHERE client = ?", (client,))
+    row = c.fetchone()
+    conn.close()
+    return float(row[0]) if row else 0.0
+
+def clients_over_budget(max_eps: float):
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("SELECT client,epsilon FROM accounts WHERE epsilon > ?", (max_eps,))
+    rows = c.fetchall()
+    conn.close()
+    return rows
+
+if __name__ == "__main__":
+    init()
+    print("DP accounting DB initialized at", DB)
+
