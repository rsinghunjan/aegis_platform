+#!/usr/bin/env python3
+"""
+Safety filter microservice for post-generation outputs.
+ - Exposes /filter which accepts {"text": "..."} and returns {blocked:bool, reasons:[], pii_matches:[], nsfw_confidence:0.0}
+ - Intended to be called from Triton post-processing or gateway before returning output to users.
+"""
+from flask import Flask, request, jsonify
+from ops.multimodal.ingest.dlp import analyze_text
+import logging
+
+app = Flask(__name__)
+LOG = logging.getLogger("aegis.safety.filter")
+
+@app.route("/filter", methods=["POST"])
+def filter():
+    body = request.json or {}
+    text = body.get("text","")
+    res = analyze_text(text)
+    blocked = res.get("pii", False)
+    reasons = []
+    if blocked:
+        reasons.append("pii_detected")
+    return jsonify({"blocked": blocked, "reasons": reasons, "pii_matches": res.get("matches", {})})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=8090)
