+#!/usr/bin/env python3
+"""
+Scrub evidence artifacts for PII and create a signed bundle for auditors.
+Usage:
+  SCRUB_OUT=/tmp/scrubbed_out ./scrub_and_bundle.py /path/to/evidence /tmp/out_bundle.tar.gz
+"""
+import os, sys, tarfile, tempfile, shutil
+from ops.evidence.redact import scrub_json, strip_image_exif
+
+SRC = sys.argv[1] if len(sys.argv)>1 else "/tmp/evidence"
+OUT = sys.argv[2] if len(sys.argv)>2 else "/tmp/scrubbed_bundle.tar.gz"
+
+TMP = tempfile.mkdtemp()
+for root, dirs, files in os.walk(SRC):
+    rel = os.path.relpath(root, SRC)
+    outdir = os.path.join(TMP, rel)
+    os.makedirs(outdir, exist_ok=True)
+    for f in files:
+        srcf = os.path.join(root, f)
+        dstf = os.path.join(outdir, f)
+        if f.lower().endswith((".json", ".txt", ".log")):
+            try:
+                with open(srcf, "r") as fh:
+                    j = fh.read()
+                # attempt parse JSON; if fails treat as raw text
+                try:
+                    obj = json.loads(j)
+                    obj = scrub_json(obj)
+                    with open(dstf, "w") as fh:
+                        json.dump(obj, fh)
+                except Exception:
+                    from ops.evidence.redact import redact_text
+                    with open(dstf, "w") as fh:
+                        fh.write(redact_text(j))
+            except Exception:
+                shutil.copy(srcf, dstf)
+        elif f.lower().endswith((".jpg", ".jpeg", ".png")):
+            with open(srcf, "rb") as fh:
+                b = fh.read()
+            safe = strip_image_exif(b)
+            with open(dstf, "wb") as fh:
+                fh.write(safe)
+        else:
+            shutil.copy(srcf, dstf)
+
+with tarfile.open(OUT, "w:gz") as tf:
+    tf.add(TMP, arcname="evidence")
+
+shutil.rmtree(TMP)
+print("Wrote scrubbed bundle to", OUT)
+
