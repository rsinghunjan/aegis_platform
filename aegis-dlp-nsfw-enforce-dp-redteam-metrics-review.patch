+#!/usr/bin/env python3
+"""
+Simple human review queue service backed by Redis.
+ - POST /enqueue {id, payload, reason} -> stores item and returns id
+ - GET /list -> list pending items
+ - POST /approve {id, approvals:[<signed-blob-path>] } -> verifies signatures and, if enough approvals, marks approved
+ - Requires VERIFY_APPROVALS_CMD env pointing to verify_approvals.py or cosign verify-blob flow.
+"""
+import os, json, time
+from flask import Flask, request, jsonify
+import redis, subprocess
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+VERIFY_CMD = os.environ.get("VERIFY_APPROVALS_CMD", "/workspace/ops/agents/verify_approvals.py")
+REQUIRED_APPROVALS = int(os.environ.get("REQUIRED_APPROVALS", "2"))
+
+app = Flask("review-queue")
+r = redis.from_url(REDIS_URL)
+
+def key(id): return f"review:{id}"
+
+@app.route("/enqueue", methods=["POST"])
+def enqueue():
+    b = request.json or {}
+    id = b.get("id") or str(int(time.time()*1000))
+    item = {"id": id, "payload": b.get("payload"), "reason": b.get("reason"), "ts": time.time(), "status": "pending"}
+    r.set(key(id), json.dumps(item))
+    r.lpush("review_queue", id)
+    return jsonify({"ok": True, "id": id})
+
+@app.route("/list", methods=["GET"])
+def list_pending():
+    ids = r.lrange("review_queue", 0, -1)
+    items = []
+    for i in ids:
+        v = r.get(key(i.decode()))
+        if v:
+            items.append(json.loads(v))
+    return jsonify({"items": items})
+
+@app.route("/approve", methods=["POST"])
+def approve():
+    b = request.json or {}
+    id = b.get("id")
+    approvals = b.get("approvals", [])
+    if not id or not approvals:
+        return jsonify({"error":"id and approvals required"}),400
+    # write approval blobs to temp files and call verify_approvals.py
+    tmp_files = []
+    for idx, blob in enumerate(approvals):
+        path = f"/tmp/approval_{id}_{idx}.bin"
+        with open(path,"wb") as fh:
+            fh.write(bytes.fromhex(blob))  # expect hex-encoded signed blob
+        tmp_files.append(path)
+    try:
+        subprocess.check_call([VERIFY_CMD] + tmp_files)
+    except subprocess.CalledProcessError:
+        return jsonify({"ok":False,"reason":"approval_verification_failed"}),403
+    # mark approved
+    v = r.get(key(id))
+    if not v:
+        return jsonify({"error":"not_found"}),404
+    item = json.loads(v)
+    item["status"]="approved"
+    item["approved_at"]=time.time()
+    r.set(key(id), json.dumps(item))
+    # remove from queue
+    r.lrem("review_queue", 0, id)
+    return jsonify({"ok":True})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8091")))
+
