+#!/usr/bin/env python3
+"""
+DP Accounting service (REST) backed by PostgreSQL.
+ - Endpoints:
+   POST /charge {client, eps}
+   GET /eps/{client}
+   GET /over_budget?max=<float>
+ Auth: simple token via DP_AUTH_TOKEN env var (prod should use mTLS / IAM)
+"""
+import os, json, logging
+from flask import Flask, request, jsonify, abort
+import psycopg2
+
+DB_URL = os.environ.get("DP_DB_URL", "postgresql://dp:dp@localhost:5432/dp")
+AUTH_TOKEN = os.environ.get("DP_AUTH_TOKEN", "changeme")
+
+def get_conn():
+    return psycopg2.connect(DB_URL)
+
+app = Flask("dp-service")
+logging.basicConfig(level=logging.INFO)
+
+def require_auth():
+    tok = request.headers.get("Authorization","").replace("Bearer ","")
+    if tok != AUTH_TOKEN:
+        abort(401)
+
+@app.route("/charge", methods=["POST"])
+def charge():
+    require_auth()
+    b = request.json or {}
+    client = b.get("client")
+    eps = float(b.get("eps", 0.0))
+    if not client:
+        abort(400)
+    conn = get_conn()
+    cur = conn.cursor()
+    cur.execute("INSERT INTO accounts (client, epsilon) VALUES (%s, %s) ON CONFLICT (client) DO UPDATE SET epsilon = accounts.epsilon + EXCLUDED.epsilon", (client, eps))
+    conn.commit()
+    cur.close()
+    conn.close()
+    return jsonify({"ok": True})
+
+@app.route("/eps/<client>", methods=["GET"])
+def get_eps(client):
+    require_auth()
+    conn = get_conn()
+    cur = conn.cursor()
+    cur.execute("SELECT epsilon FROM accounts WHERE client=%s", (client,))
+    r = cur.fetchone()
+    cur.close()
+    conn.close()
+    return jsonify({"client": client, "epsilon": float(r[0]) if r else 0.0})
+
+@app.route("/over_budget", methods=["GET"])
+def over_budget():
+    require_auth()
+    max_eps = float(request.args.get("max", "1.0"))
+    conn = get_conn()
+    cur = conn.cursor()
+    cur.execute("SELECT client, epsilon FROM accounts WHERE epsilon > %s", (max_eps,))
+    rows = cur.fetchall()
+    cur.close()
+    conn.close()
+    return jsonify({"over": [{"client": r[0], "epsilon": float(r[1])} for r in rows]})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8084")))
+
