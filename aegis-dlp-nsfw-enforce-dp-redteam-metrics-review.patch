+#!/usr/bin/env python3
+"""
+Enforce pre-training scrub: this script must be run (and succeed) before training starts.
+It checks dataset metadata for "scrubbed": true; if missing, it runs scrubbing (redaction)
+and records a _scrubbed.json marker in dataset directory.
+"""
+import os, sys, json, argparse
+from ops.evidence.redact import scrub_json
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--dataset-dir", required=True)
+args = parser.parse_args()
+meta_path = os.path.join(args.dataset_dir, "meta.json")
+if not os.path.exists(meta_path):
+    print("meta.json missing; cannot verify scrub status")
+    sys.exit(2)
+meta = json.load(open(meta_path))
+if meta.get("scrubbed", False):
+    print("Dataset already scrubbed")
+    sys.exit(0)
+print("Dataset not scrubbed; performing scrub (in place)...")
+# Example: assume data files in 'items.json' (list of items)
+items_path = os.path.join(args.dataset_dir, "items.json")
+if os.path.exists(items_path):
+    items = json.load(open(items_path))
+    items_scrubbed = [scrub_json(i) for i in items]
+    with open(items_path, "w") as fh:
+        json.dump(items_scrubbed, fh)
+meta["scrubbed"] = True
+with open(meta_path, "w") as fh:
+    json.dump(meta, fh)
+open(os.path.join(args.dataset_dir, "_scrubbed.marker"), "w").write("ok")
+print("Scrub complete; dataset marked scrubbed")
+
