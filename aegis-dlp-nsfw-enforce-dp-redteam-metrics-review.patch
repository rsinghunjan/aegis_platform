+Requires GH_TOKEN in env and GITHUB_REPOSITORY (owner/repo).
+"""
+import os, sys, requests
+
+TOKEN = os.environ.get("GH_TOKEN")
+REPO = os.environ.get("GITHUB_REPOSITORY")
+API = "https://api.github.com"
+
+def create_issue(title, body):
+    url = f"{API}/repos/{REPO}/issues"
+    r = requests.post(url, json={"title": title, "body": body}, headers={"Authorization": f"token {TOKEN}"})
+    r.raise_for_status()
+    print("Created issue:", r.json().get("html_url"))
+
+if __name__=="__main__":
+    if len(sys.argv) < 3:
+        print("usage: create_issue.py title body")
+        sys.exit(2)
+    create_issue(sys.argv[1], sys.argv[2])
