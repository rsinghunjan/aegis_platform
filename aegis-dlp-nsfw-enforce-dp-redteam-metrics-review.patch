+#!/usr/bin/env python3
+"""
+Triton gateway: proxy requests to Triton, then run safety filters before returning results.
+Also emits Prometheus metrics for monitoring detection rates and escapes.
+
+This ensures post-generation filter is enforced in one place (edge/gateway).
+"""
+import os, json, time, logging
+from flask import Flask, request, jsonify
+import requests
+from prometheus_client import start_http_server, Counter, Histogram
+
+LOG = logging.getLogger("triton.gateway")
+logging.basicConfig(level=logging.INFO)
+
+TRITON_URL = os.environ.get("TRITON_URL", "http://triton:8000")
+FILTER_URL = os.environ.get("FILTER_URL", "http://safety-filter:8090/filter")
+PROM_PORT = int(os.environ.get("PROM_PORT", "9101"))
+
+# Metrics
+RPC_COUNT = Counter("aegis_triton_gateway_requests_total", "Total gateway requests")
+RPC_LATENCY = Histogram("aegis_triton_gateway_latency_seconds", "Gateway latency")
+FILTER_BLOCKED = Counter("aegis_safety_filter_blocked_total", "Number of outputs blocked by safety filter")
+FILTER_PII_DETECTED = Counter("aegis_safety_filter_pii_total", "PII detections by filter")
+
+app = Flask("triton-gateway")
+
+def call_triton(model, payload):
+    # Simple HTTP infer: POST /v2/models/{model}/infer
+    url = f"{TRITON_URL}/v2/models/{model}/infer"
+    r = requests.post(url, json=payload, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def call_filter(text):
+    r = requests.post(FILTER_URL, json={"text": text}, timeout=5)
+    r.raise_for_status()
+    return r.json()
+
+@app.route("/generate", methods=["POST"])
+def generate():
+    start = time.time()
+    RPC_COUNT.inc()
+    body = request.json or {}
+    model = body.get("model", "multimodal_ensemble")
+    payload = body.get("payload", {})
+    try:
+        triton_resp = call_triton(model, payload)
+        # Simplified: assume triton_resp contains a text field or tokens we can convert
+        text = triton_resp.get("outputs", [{"data": [""]}])[0]["data"][0]
+        filt = call_filter(text)
+        if filt.get("blocked", False):
+            FILTER_BLOCKED.inc()
+            if filt.get("pii_matches"):
+                FILTER_PII_DETECTED.inc()
+            # Send to review queue or return blocked response
+            # Placeholders: push to review service or return 403
+            return jsonify({"ok": False, "reason": "blocked_by_safety", "details": filt}), 403
+        RPC_LATENCY.observe(time.time() - start)
+        return jsonify({"ok": True, "text": text, "meta": {"safety": filt}})
+    except Exception as e:
+        LOG.exception("generate failed")
+        return jsonify({"ok": False, "error": str(e)}), 500
+
+if __name__ == "__main__":
+    start_http_server(PROM_PORT)
+    app.run(host="0.0.0.0", port=8089)
+
