*** Add File:scripts/deid/deidentify.py
+#!/usr/bin/env python3
+"""
+Simple de-identification script for CSV datasets.
+ - Removes/obfuscates common PHI fields (name, ssn, mrn, email, phone)
+ - Hashes patient_id with a salt for linkage if needed (irreversible unless salt retained under hospital control)
+ WARNING: This is a starter. Clinical informatics must validate before use.
+"""
+import csv, hashlib, argparse, os, json
+
+def hash_id(v, salt):
+    return hashlib.sha256((salt + v).encode('utf-8')).hexdigest()
+
+def deid_csv(infile, outfile, salt, drop_fields):
+    with open(infile,'r',newline='') as inf, open(outfile,'w',newline='') as outf:
+        r = csv.DictReader(inf)
+        fields = [f for f in r.fieldnames if f not in drop_fields]
+        # if hashed id needed add 'hashed_id'
+        if 'patient_id' in r.fieldnames:
+            fields.append('hashed_patient_id')
+        w = csv.DictWriter(outf, fieldnames=fields)
+        w.writeheader()
+        for row in r:
+            out = {k:v for k,v in row.items() if k in fields and k not in ['patient_id']}
+            if 'patient_id' in row:
+                out['hashed_patient_id'] = hash_id(row['patient_id'], salt)
+            w.writerow(out)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="infile", required=True)
+    p.add_argument("--out", dest="outfile", required=True)
+    p.add_argument("--salt", required=True)
+    p.add_argument("--drop-fields", nargs="*", default=["name","ssn","mrn","email","phone"])
+    args = p.parse_args()
+    deid_csv(args.infile, args.outfile, args.salt, args.drop_fields)
+    print("Wrote de-identified CSV to", args.outfile)
+
