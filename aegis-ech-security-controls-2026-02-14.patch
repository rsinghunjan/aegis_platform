+// Terraform skeleton to create a dedicated VPC / air-gapped environment for El Camino Hospital pilots.
+// NOTE: This is a starter template. Adjust CIDRs, provider, networking, and peering to your org standards.
+provider "aws" {
+  region = var.aws_region
+}
+
+resource "aws_vpc" "aegis_ech_vpc" {
+  cidr_block = var.vpc_cidr
+  tags = {
+    Name = "aegis-ech-pilot-vpc"
+    Owner = "ElCaminoHospital"
+  }
+}
+
+resource "aws_subnet" "private_subnet" {
+  count = length(var.private_subnets)
+  vpc_id = aws_vpc.aegis_ech_vpc.id
+  cidr_block = var.private_subnets[count.index]
+  availability_zone = element(var.azs, count.index)
+  tags = {
+    Name = "aegis-ech-private-${count.index}"
+  }
+}
+
+# No Internet Gateway in this VPC to enforce air-gapped posture.
+# Provide VPC endpoints for S3, ECR, Secrets Manager as required for controlled egress.
+resource "aws_vpc_endpoint" "s3" {
+  vpc_id            = aws_vpc.aegis_ech_vpc.id
+  service_name      = "com.amazonaws.${var.aws_region}.s3"
+  vpc_endpoint_type = "Gateway"
+  route_table_ids   = var.route_table_ids
+}
+
+output "vpc_id" {
+  value = aws_vpc.aegis_ech_vpc.id
+}
+
