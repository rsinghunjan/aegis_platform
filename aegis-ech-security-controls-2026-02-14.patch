*** Add File:scripts/vault/emergency_revoke_signing_key.sh
+#!/usr/bin/env bash
+set -euo pipefail
+VAULT_ADDR=${VAULT_ADDR:-https://vault.vault.svc.cluster.local:8200}
+KEY=${1:-aegis-signing-key}
+POLICY_NAME=${2:-aegis-ci-policy}
+
+echo "Emergency revocation: Removing signing capability for key ${KEY}"
+# 1) Revoke policy capabilities: remove policy from roles (operator action)
+echo "Revoking policy ${POLICY_NAME} (operator must adjust roles accordingly)"
+vault policy delete ${POLICY_NAME} || true
+
+# 2) Create new transit key for future signing
+NEW_KEY="${KEY}-rotated-$(date +%s)"
+vault write -address="${VAULT_ADDR}" -f transit/keys/${NEW_KEY}
+echo "Created replacement key ${NEW_KEY}. Update services to use replacement key immediately."
+
+echo "Note: Rekor entries already issued remain valid in the log; remediate per legal guidance."
+
