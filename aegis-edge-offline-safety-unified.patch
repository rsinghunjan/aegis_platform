+#!/usr/bin/env python3
+"""
+Pre-provisioned fetch-token service for emergency A2A approvals in offline/edge conditions.
+
+- Admin can create a set of signed tokens (fetchtokens) with metadata and expiry.
+- Tokens are HMAC-signed using a secret stored in env or secret manager.
+- Edge services may present a token to the approver/retrieval-guard for expedited emergency approval.
+- Use sparingly & audit every redemption via MCP.
+"""
+import os
+import hmac
+import hashlib
+import json
+import time
+import uuid
+import logging
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+LOG = logging.getLogger("aegis.a2a.fetchtoken")
+logging.basicConfig(level=logging.INFO)
+app = FastAPI(title="Aegis FetchToken Service")
+
+SECRET = os.environ.get("FETCHTOKEN_SECRET", "change-me")  # store in KMS/secret manager
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+class TokenSpec(BaseModel):
+    purpose: str
+    expires_at: int  # epoch seconds
+    scope: str = "originals:*"  # e.g., originals:artifact-id
+
+def sign(payload: str) -> str:
+    sig = hmac.new(SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()
+    return sig
+
+@app.post("/admin/create")
+def create_token(spec: TokenSpec):
+    tid = str(uuid.uuid4())
+    payload = json.dumps({"tid": tid, "purpose": spec.purpose, "expires_at": spec.expires_at, "scope": spec.scope})
+    sig = sign(payload)
+    token = {"token": payload, "sig": sig}
+    # write to MCP (audit)
+    try:
+        import requests
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/a2a/fetchtokens", json={"tid": tid, "scope": spec.scope, "expires_at": spec.expires_at}, timeout=5.0)
+    except Exception as e:
+        LOG.warning("failed to write fetchtoken audit: %s", e)
+    return token
+
+@app.post("/verify")
+def verify_token(token: dict):
+    try:
+        payload = token.get("token")
+        sig = token.get("sig")
+        if not payload or not sig:
+            raise HTTPException(status_code=400, detail="malformed token")
+        expected = sign(payload)
+        if not hmac.compare_digest(expected, sig):
+            raise HTTPException(status_code=403, detail="invalid signature")
+        obj = json.loads(payload)
+        if int(time.time()) > int(obj.get("expires_at",0)):
+            raise HTTPException(status_code=403, detail="expired token")
+        return {"ok": True, "scope": obj.get("scope")}
+    except HTTPException:
+        raise
+    except Exception as e:
+        LOG.error("verify error: %s", e)
+        raise HTTPException(status_code=500, detail="verify error")
+
