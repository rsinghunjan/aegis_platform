+#!/usr/bin/env python3
+"""
+Quick takedown API for privacy / legal removal requests.
+
+- POST /request { artifact_id, reason, requester }
+  -> creates takedown ticket, writes to MCP and places job file in /data/takedown_queue
+- Admin can call /process to run immediate deletion (operator-driven)
+"""
+import os
+import json
+import uuid
+import time
+import logging
+from fastapi import FastAPI, HTTPException, Body
+
+LOG = logging.getLogger("aegis.compliance.takedown")
+logging.basicConfig(level=logging.INFO)
+app = FastAPI(title="Aegis Takedown API")
+
+QUEUE_DIR = os.environ.get("TAKEDOWN_QUEUE", "/data/takedown_queue")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+os.makedirs(QUEUE_DIR, exist_ok=True)
+
+@app.post("/request")
+def request_takedown(payload: dict = Body(...)):
+    artifact = payload.get("artifact_id")
+    reason = payload.get("reason","unspecified")
+    requester = payload.get("requester","unknown")
+    tid = str(uuid.uuid4())
+    ticket = {"ticket_id": tid, "artifact_id": artifact, "reason": reason, "requester": requester, "ts": int(time.time())}
+    # write to MCP for audit
+    try:
+        import requests
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/compliance/takedowns", json=ticket, timeout=3.0)
+    except Exception as e:
+        LOG.warning("mcp write failed: %s", e)
+    # enqueue
+    with open(os.path.join(QUEUE_DIR, f"{tid}.json"), "w") as f:
+        json.dump(ticket, f)
+    return {"ticket_id": tid, "status": "queued"}
+
+@app.post("/process")
+def process_one():
+    files = [f for f in os.listdir(QUEUE_DIR) if f.endswith(".json")]
+    if not files:
+        return {"processed": 0}
+    fpath = os.path.join(QUEUE_DIR, files[0])
+    with open(fpath) as f:
+        t = json.load(f)
+    # operator responsible for deletion; here we just mark as processed and log
+    processed_marker = os.path.join(QUEUE_DIR, f"{t['ticket_id']}.processed")
+    with open(processed_marker,"w") as fm:
+        fm.write(json.dumps({"ticket": t, "processed_at": int(time.time())}))
+    os.remove(fpath)
+    try:
+        import requests
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/compliance/takedowns/processed", json={"ticket": t}, timeout=3.0)
+    except Exception:
+        pass
+    return {"processed": 1, "ticket": t}
+
