+#!/usr/bin/env python3
+"""
+Staged autonomy controller:
+- Receives proposed actions with verifier scores and invariants.
+- Decision flow:
+  - If score >= AUTO_THRESHOLD and invariants_ok => execute auto action (sandboxed) and create signed receipt.
+  - Else if score >= RECOMMEND_THRESHOLD => create a 'recommendation' (UI or operator) and optionally prefill A2A request.
+  - Else => create A2A approval request for human decision.
+- All actions log to MCP and require evidence_id for chaining.
+"""
+import os
+import logging
+import requests
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+LOG = logging.getLogger("aegis.hil.staged")
+logging.basicConfig(level=logging.INFO)
+app = FastAPI(title="Aegis Staged Autonomy Controller")
+
+AUTO_THRESHOLD = float(os.environ.get("AUTO_THRESHOLD", "0.75"))
+RECOMMEND_THRESHOLD = float(os.environ.get("RECOMMEND_THRESHOLD", "0.50"))
+SANDBOX_API = os.environ.get("SANDBOX_API", "http://sandbox:8000/run")
+A2A_API = os.environ.get("A2A_API", "http://approver:8080/request")
+RECEIPT_API = os.environ.get("RECEIPT_API", "http://receipt-signer:8080/sign")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+class ActionReq(BaseModel):
+    action_id: str
+    action_type: str
+    params: dict
+    verifier_score: float
+    invariants_ok: bool
+    evidence_id: str = None
+    requestor: str = "system"
+
+def post_mcp(event):
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/actions/events", json=event, timeout=3.0)
+    except Exception as e:
+        LOG.warning("mcp write failed: %s", e)
+
+def sign_receipt(event):
+    try:
+        r = requests.post(RECEIPT_API, json=event, timeout=5.0)
+        if r.ok:
+            return r.json()
+    except Exception as e:
+        LOG.warning("receipt signing failed: %s", e)
+    return None
+
+@app.post("/decide")
+def decide(req: ActionReq):
+    event = {"action_id": req.action_id, "type": req.action_type, "params": req.params, "score": req.verifier_score, "evidence_id": req.evidence_id, "ts": int(__import__("time").time())}
+    post_mcp({"phase":"decision_received","event":event})
+
+    # Auto execution
+    if req.verifier_score >= AUTO_THRESHOLD and req.invariants_ok:
+        # execute in sandbox
+        try:
+            r = requests.post(SANDBOX_API, json={"image":"alpine:3.18","cmd":req.params.get("cmd",[]),"requestor":req.requestor}, timeout=10.0)
+            res = r.json() if r.ok else {"error":"sandbox_exec_failed"}
+            receipt = sign_receipt({"event": event, "result": res, "type":"auto_execute"})
+            post_mcp({"phase":"auto_executed","event":event, "result":res, "receipt": receipt})
+            return {"decision":"auto_executed","result":res,"receipt":receipt}
+        except Exception as e:
+            LOG.error("auto exec failed: %s", e)
+            raise HTTPException(status_code=500, detail="auto execution failed")
+    # Recommend (human-in-the-loop assisted)
+    if req.verifier_score >= RECOMMEND_THRESHOLD:
+        # create recommendation record and optionally prefill A2A request
+        try:
+            prefill = {"model_id":"verifier-ensemble","artifact_uri":req.evidence_id,"approver":"oncall","decision":"requested","comment":"recommendation auto-prefill"}
+            r = requests.post(A2A_API, json=prefill, timeout=5.0)
+            a2a_id = r.json().get("id") if r.ok else None
+        except Exception:
+            a2a_id = None
+        post_mcp({"phase":"recommendation","event":event,"a2a_prefill":a2a_id})
+        return {"decision":"recommendation","a2a_prefill":a2a_id}
+    # Low confidence -> require A2A approval
+    try:
+        req_body = {"model_id":"verifier-ensemble","artifact_uri":req.evidence_id,"approver":"oncall","decision":"requested","comment":"low-confidence auto A2A"}
+        r = requests.post(A2A_API, json=req_body, timeout=5.0)
+        if r.ok:
+            a2a_id = r.json().get("id")
+        else:
+            a2a_id = None
+    except Exception as e:
+        LOG.warning("a2a create failed: %s", e)
+        a2a_id = None
+    post_mcp({"phase":"a2a_requested","event":event,"a2a_id":a2a_id})
+    return {"decision":"a2a_requested","a2a_id":a2a_id}
+
