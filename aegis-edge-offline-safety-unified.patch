+#!/usr/bin/env python3
+"""
+Edge -> Central Milvus sync agent.
+
+Assumptions:
+- Edge ingestion writes evidence JSON files to /data/sync_queue/*.json
+  each file contains: { "id": "<uuid>", "text": "...", "embedding": [..], "meta": {...} }
+- This agent attempts to push them to CENTRAL_MILVUS (env) and on success moves to /data/sync_ok/
+- Simple backoff and idempotent insert (if exists, skip).
+"""
+import os
+import json
+import time
+import shutil
+import logging
+from pymilvus import connections, Collection, utility
+
+LOG = logging.getLogger("aegis.edge.milvus_sync")
+logging.basicConfig(level=logging.INFO)
+
+LOCAL_QUEUE = os.environ.get("EDGE_SYNC_QUEUE", "/data/sync_queue")
+PROCESSED_DIR = os.environ.get("EDGE_SYNC_OK", "/data/sync_ok")
+CENTRAL_HOST = os.environ.get("CENTRAL_MILVUS_HOST", "milvus.milvus")
+CENTRAL_PORT = os.environ.get("CENTRAL_MILVUS_PORT", "19530")
+CENTRAL_COLLECTION = os.environ.get("CENTRAL_COLLECTION", "aegis_docs")
+
+os.makedirs(LOCAL_QUEUE, exist_ok=True)
+os.makedirs(PROCESSED_DIR, exist_ok=True)
+
+def connect_central():
+    try:
+        connections.connect(host=CENTRAL_HOST, port=str(CENTRAL_PORT))
+        if not utility.has_collection(CENTRAL_COLLECTION):
+            LOG.error("Central collection %s not found", CENTRAL_COLLECTION)
+            return None
+        return Collection(CENTRAL_COLLECTION)
+    except Exception as e:
+        LOG.warning("connect central failed: %s", e)
+        return None
+
+def process_file(path, collection):
+    try:
+        with open(path, "r") as f:
+            doc = json.load(f)
+        doc_id = doc.get("id")
+        embed = doc.get("embedding")
+        text = doc.get("text","")
+        meta = doc.get("meta",{})
+        # idempotency: check if id exists using filter (best-effort)
+        try:
+            res = collection.query(expr=f'id == "{doc_id}"', output_fields=["id"]) if collection.has_field("id") else []
+            if res:
+                LOG.info("doc %s already in central, skipping", doc_id)
+                return True
+        except Exception:
+            # ignore query errors, attempt insert
+            pass
+        # Insert - assumes schema [id (str), embedding (float vector), text (str), meta (json)]
+        collection.insert([{"id": doc_id, "embedding": embed, "text": text, "meta": meta}])
+        LOG.info("synced %s", doc_id)
+        return True
+    except Exception as e:
+        LOG.error("process_file error %s: %s", path, e)
+        return False
+
+def main():
+    while True:
+        collection = connect_central()
+        files = sorted([os.path.join(LOCAL_QUEUE,f) for f in os.listdir(LOCAL_QUEUE) if f.endswith(".json")])
+        if not files:
+            time.sleep(5)
+            continue
+        if not collection:
+            LOG.info("central unavailable, will retry in 10s")
+            time.sleep(10)
+            continue
+        for p in files:
+            ok = process_file(p, collection)
+            if ok:
+                shutil.move(p, os.path.join(PROCESSED_DIR, os.path.basename(p)))
+            else:
+                LOG.info("will retry %s later", p)
+        time.sleep(2)
+
+if __name__ == "__main__":
+    main()
+
