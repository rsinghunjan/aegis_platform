+#!/usr/bin/env python3
+"""
+Retrieval curation job:
+- Periodically checks doc age/freshness and flags stale docs for re-ingestion.
+- If percentage stale > threshold, pushes a reindex/retrain ticket to MCP.
+"""
+import os
+import time
+import logging
+from pymilvus import connections, Collection, utility
+import requests
+from datetime import datetime, timedelta
+
+LOG = logging.getLogger("aegis.retriver.curation")
+logging.basicConfig(level=logging.INFO)
+
+MILVUS_HOST = os.environ.get("MILVUS_HOST","milvus.milvus")
+MILVUS_PORT = os.environ.get("MILVUS_PORT","19530")
+COLLECTION_NAME = os.environ.get("MILVUS_COLLECTION","aegis_docs")
+STALE_DAYS = int(os.environ.get("STALE_DAYS","90"))
+STALE_PCT_THRESHOLD = float(os.environ.get("STALE_PCT_THRESHOLD","0.2"))
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API","http://mcp:8082")
+
+def main():
+    connections.connect(host=MILVUS_HOST, port=str(MILVUS_PORT))
+    if not utility.has_collection(COLLECTION_NAME):
+        LOG.error("collection %s missing", COLLECTION_NAME)
+        return
+    col = Collection(COLLECTION_NAME)
+    # best-effort: use 'meta' field with timestamp if present; otherwise cannot compute
+    total = 0
+    stale = 0
+    try:
+        for ent in col.query(expr="id != ''", output_fields=["meta"], timeout=60):
+            total += 1
+            meta = ent.get("meta") or {}
+            ts = meta.get("created_ts")
+            if ts:
+                created = datetime.utcfromtimestamp(int(ts))
+                if datetime.utcnow() - created > timedelta(days=STALE_DAYS):
+                    stale += 1
+        pct = stale / max(1, total)
+        LOG.info("curation: total=%d stale=%d pct=%.3f", total, stale, pct)
+        if pct >= STALE_PCT_THRESHOLD:
+            # push reindex/retrain ticket to MCP
+            payload = {"event": "retriever_curation_alert", "total": total, "stale": stale, "pct": pct, "ts": int(time.time())}
+            try:
+                requests.post(f"{AEGIS_MCP.rstrip('/')}/ops/retriever_curation", json=payload, timeout=5.0)
+            except Exception as e:
+                LOG.warning("mcp push failed: %s", e)
+    except Exception as e:
+        LOG.error("curation job failed: %s", e)
+
+if __name__ == "__main__":
+    main()
+
