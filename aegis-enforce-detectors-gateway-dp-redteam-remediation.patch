+"""
+Client SDK that ensures all generation requests go through the Triton Gateway,
+so post-generation filters are always enforced.
+Use this SDK in place of calling Triton directly from clients/SDKs/agents.
+"""
+import os, requests, json
+
+GATEWAY_URL = os.environ.get("TRITON_GATEWAY_URL", "http://triton-gateway:8089/generate")
+DP_HEADER = "X-Client-ID"
+
+def generate(model: str, payload: dict, client_id: str = None, timeout: int = 60) -> dict:
+    body = {"model": model, "payload": payload}
+    headers = {"Content-Type": "application/json"}
+    if client_id:
+        headers[DP_HEADER] = client_id
+    r = requests.post(GATEWAY_URL, json=body, headers=headers, timeout=timeout)
+    r.raise_for_status()
+    return r.json()
+
+def safe_generate_text(prompt: str, client_id: str = None):
+    payload = {"inputs": prompt}
+    return generate("multimodal_ensemble", {"inputs": prompt}, client_id=client_id)
+
