+"""
+DP client helper used by serving gateways or other call paths to charge per-request epsilon.
+"""
+import os, requests
+
+DP_SERVICE = os.environ.get("DP_SERVICE_URL", "http://dp-service:8084")
+AUTH = {"Authorization": f"Bearer {os.environ.get('DP_AUTH_TOKEN','changeme')}"}
+
+def charge(client_id: str, eps: float):
+    r = requests.post(f"{DP_SERVICE}/charge", json={"client": client_id, "eps": eps}, headers=AUTH, timeout=5)
+    r.raise_for_status()
+    return r.json()
