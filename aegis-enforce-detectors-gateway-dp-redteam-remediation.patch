+#!/usr/bin/env python3
+"""
+CLI for approvers to sign approval blobs (cosign sign-blob) and submit hex blob to review queue.
+Requires cosign CLI and COSIGN_KMS_URI (or local key) configured.
+"""
+import os, sys, subprocess, requests, binascii, tempfile
+
+REVIEW_QUEUE = os.environ.get("REVIEW_QUEUE_URL", "http://review-queue:8091/approve")
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI", "")
+
+if len(sys.argv) < 2:
+    print("Usage: approver_cli.py <approval-json-file>")
+    sys.exit(2)
+
+file = sys.argv[1]
+# Sign blob using cosign sign-blob -> outputs signature file
+sigfile = tempfile.mktemp()
+try:
+    subprocess.check_call(["cosign", "sign-blob", "--key", COSIGN_KEY, "--output-signature", sigfile, file])
+except Exception as e:
+    print("cosign sign-blob failed:", e)
+    sys.exit(3)
+
+with open(sigfile, "rb") as fh:
+    sig = fh.read()
+hexsig = binascii.hexlify(sig).decode()
+
+payload = {"id": os.path.basename(file), "approvals":[hexsig]}
+r = requests.post(REVIEW_QUEUE, json=payload)
+print("Review queue response:", r.status_code, r.text)
+
