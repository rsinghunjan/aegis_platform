+#!/usr/bin/env python3
+"""
+Alertmanager webhook receiver specialized for content incidents.
+On alert, it submits an Argo WorkflowTemplate 'aegis-content-remediation' which performs
+remediation steps (disable model, rollback, purge dataset) and bundles evidence.
+"""
+import os, json, logging, subprocess
+from flask import Flask, request, jsonify
+
+app = Flask("content-alert-handler")
+ARGO_NS = os.environ.get("ARGO_NS", "aegis-ml")
+REMED_TEMPLATE = os.environ.get("REMED_TEMPLATE", "aegis-content-remediation")
+
+@app.route("/alert", methods=["POST"])
+def alert():
+    data = request.json
+    # Minimal validation; in production verify Alertmanager signature
+    try:
+        # Submit Argo workflow from template
+        cmd = ["kubectl", "create", "workflow", "-n", ARGO_NS, "--from", f"workflowtemplate/{REMED_TEMPLATE}", "-o", "name"]
+        wf = subprocess.check_output(cmd).decode().strip()
+        return jsonify({"ok": True, "workflow": wf})
+    except Exception as e:
+        logging.exception("failed to submit remediation workflow")
+        return jsonify({"ok": False, "error": str(e)}), 500
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","7072")))
+
