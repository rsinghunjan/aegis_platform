+#!/usr/bin/env python3
+"""
+DP-first policy enforcer. Ensures MPC is disabled when dp_first=true and environment=production.
+Call this at startup of orchestrator/serving components to fail fast if policy violated.
+"""
+import os, sys, yaml
+
+CONFIG_PATH = os.environ.get("DP_POLICY_PATH", "config/dp_policy.yaml")
+ENV = os.environ.get("ENVIRONMENT", "staging")
+
+def load_policy(path=CONFIG_PATH):
+    try:
+        with open(path,"r") as fh:
+            return yaml.safe_load(fh)
+    except Exception:
+        return {}
+
+def enforce():
+    policy = load_policy()
+    dp_first = policy.get("dp_first", False)
+    if dp_first and ENV.lower() == "production":
+        # If MPC is enabled in prod, abort unless explicit override
+        mpc_enabled = os.environ.get("MPC_ENABLED", "false").lower() == "true"
+        if mpc_enabled:
+            print("DP-first policy requires MPC disabled in production. Aborting startup.", file=sys.stderr)
+            sys.exit(4)
+    # else OK
+
+if __name__ == "__main__":
+    enforce()
+    print("DP policy enforcement: OK")
+
