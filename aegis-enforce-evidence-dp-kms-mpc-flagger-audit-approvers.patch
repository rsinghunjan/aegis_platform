+#!/usr/bin/env bash
+#
+# Compute MTTR from S3 manifests by looking for canary promotion & rollback manifests
+#
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+CANARY_PREFIX=${1:-canary_evidence}
+if [ -z "$EVIDENCE_BUCKET" ]; then
+  echo "Set EVIDENCE_BUCKET env var"
+  exit 2
+fi
+TMPDIR=$(mktemp -d)
+aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/${CANARY_PREFIX}/" "$TMPDIR/" || true
+prom=$(find "$TMPDIR" -type f -name '*promot*.json' -print -quit || true)
+roll=$(find "$TMPDIR" -type f -name '*rollback*.json' -print -quit || true)
+if [ -z "$prom" ] || [ -z "$roll" ]; then
+  echo "No promotion/rollback samples found"
+  exit 3
+fi
+prom_ts=$(jq -r '.ts // .timestamp // .time // empty' "$prom" | head -n1)
+roll_ts=$(jq -r '.ts // .timestamp // .time // empty' "$roll" | head -n1)
+if [ -z "$prom_ts" ] || [ -z "$roll_ts" ]; then
+  echo "Could not extract ts from manifests"
+  exit 4
+fi
+mttr=$((roll_ts - prom_ts))
+echo "MTTR (sample) = ${mttr}s (promotion: ${prom}, rollback: ${roll})"
+exit 0
+
