+        if: ${{ secrets.KUBE_CONFIG_DATA }}
+        run: |
+          echo "${{ secrets.KUBE_CONFIG_DATA }}" | base64 -d > $HOME/.kube/config
+      - name: Trigger failing traffic (fault injection)
+        run: |
+          CANARY="${{ github.event.inputs.canary_name }}"
+          NS="${{ github.event.inputs.namespace }}"
+          # best-effort: attempt to call a fault endpoint in the pod
+          POD=$(kubectl -n "$NS" get pods -l app="$CANARY" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
+          if [ -n "$POD" ]; then
+            kubectl -n "$NS" exec "$POD" -- /bin/sh -c "curl -s -X POST http://127.0.0.1:8080/fault/enable || true"
+          else
+            echo "No pod found for canary; aborting" && exit 2
+          fi
+      - name: Wait for rollback and capture timestamps
+        run: |
+          CANARY="${{ github.event.inputs.canary_name }}"
+          NS="${{ github.event.inputs.namespace }}"
+          START=$(date +%s)
+          for i in $(seq 1 60); do
+            PHASE=$(kubectl -n "$NS" get canary "$CANARY" -o jsonpath='{.status.phase}' || echo "")
+            echo "Phase: $PHASE"
+            if [ "$PHASE" = "Failed" ]; then
+              END=$(date +%s)
+              MTTR=$((END-START))
+              echo "Rollback observed. MTTR=${MTTR}s"
+              echo "{\"mttr\":${MTTR},\"start\":${START},\"end\":${END}}" > /tmp/mttr.json
+              exit 0
+            fi
+            sleep 10
+          done
+          echo "Timeout waiting for rollback" && exit 3
+      - name: Upload MTTR artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: flagger-mttr
+          path: /tmp/mttr.json
+
