+#!/usr/bin/env python3
+"""
+Execute KMS alias swap given a MOFN-approved request.
+
+This script:
+ - queries the MOFN status for request_id (expects manifest path in payload),
+ - verifies the manifest has a Rekor entry,
+ - performs the alias swap via AWS KMS create-alias (idempotent),
+ - produces and ensures a final signed manifest is uploaded and rekor-registered.
+
+Usage:
+  python3 ops/hsm/execute_alias_swap_from_mofn.py --request-id <id> --alias alias/aegis/cosign
+"""
+import os, sys, json, time, argparse, subprocess, requests
+from pathlib import Path
+
+MOFN_URL = os.environ.get("MOFN_URL", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+REKOR_SERVER = os.environ.get("REKOR_SERVER", "")
+
+def get_mofn_status(request_id):
+    r = requests.get(f"{MOFN_URL}/status", params={"request_id": request_id}, timeout=15)
+    r.raise_for_status()
+    return r.json()
+
+def verify_rekor_for_path(manifest_s3_path):
+    # download manifest locally
+    local = "/tmp/alias_manifest.json"
+    subprocess.check_call(["aws","s3","cp", manifest_s3_path, local])
+    # check rekor
+    if subprocess.call(["rekor-cli","search","--artifact", local]) == 0:
+        return local
+    raise RuntimeError("manifest not registered in Rekor")
+
+def perform_alias_swap(alias, new_key_id):
+    # create alias (AWS idempotent when same alias -> target)
+    subprocess.check_call(["aws","kms","create-alias","--alias-name", alias, "--target-key-id", new_key_id])
+
+def sign_and_register_final(manifest_local):
+    # sign (cosign) + rekor upload + upload to s3 final path
+    subprocess.check_call(["cosign","sign-blob","--key", os.environ.get("COSIGN_KMS_URI", ""), manifest_local])
+    subprocess.check_call(["rekor-cli","upload","--artifact", manifest_local])
+    if EVIDENCE_BUCKET:
+        subprocess.check_call(["aws","s3","cp", manifest_local, f"s3://{EVIDENCE_BUCKET.rstrip('/')}/kms-rotation/"])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--request-id", required=True)
+    p.add_argument("--alias", required=True)
+    args = p.parse_args()
+
+    if not MOFN_URL:
+        print("MOFN_URL not configured", file=sys.stderr); sys.exit(2)
+    status = get_mofn_status(args.request_id)
+    if not status.get("approved"):
+        print("MOFN request not approved; aborting", file=sys.stderr); sys.exit(3)
+    # assume payload contains s3 manifest path and new_key_id
+    payload = status.get("payload", {})
+    manifest_s3 = payload if isinstance(payload, str) and payload.startswith("s3://") else payload.get("manifest_s3")
+    new_key = payload.get("new_key_id") or payload.get("new_key")
+    if not manifest_s3 or not new_key:
+        print("MOFN payload missing manifest_s3 or new_key_id", file=sys.stderr); sys.exit(4)
+    print("Verifying Rekor for manifest:", manifest_s3)
+    manifest_local = verify_rekor_for_path(manifest_s3)
+    print("Performing alias swap ->", new_key)
+    perform_alias_swap(args.alias, new_key)
+    # create final manifest
+    final = "/tmp/kms_alias_swap_final.json"
+    data = {"alias": args.alias, "new_key_id": new_key, "ts": int(time.time()), "mofn_request": args.request_id}
+    with open(final, "w") as fh:
+        json.dump(data, fh)
+    sign_and_register_final(final)
+    print("Alias swap completed and final manifest recorded")
+
+if __name__=="__main__":
+    main()
+
