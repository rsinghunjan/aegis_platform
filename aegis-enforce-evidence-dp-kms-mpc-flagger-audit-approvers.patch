+#!/usr/bin/env python3
+"""
+Small helper to ingest external audit findings (JSON) and create GitHub issues
+for remediation, track status, and mark as closed when remediation proof is supplied.
+
+Requires GITHUB_TOKEN in env with repo:scope to create issues.
+"""
+import os, sys, json, requests
+
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN", "")
+REPO = os.environ.get("GITHUB_REPO", "")
+
+def create_issue(title, body, labels=None):
+    url = f"https://api.github.com/repos/{REPO}/issues"
+    headers = {"Authorization": f"token {GITHUB_TOKEN}"}
+    payload = {"title": title, "body": body, "labels": labels or ["security","audit"]}
+    r = requests.post(url, headers=headers, json=payload, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def ingest_findings(path):
+    with open(path, "r") as fh:
+        findings = json.load(fh)
+    created = []
+    for f in findings.get("findings", []):
+        title = f"[AUDIT] " + f.get("title", "Unnamed finding")
+        body = "Severity: %s\n\n%s\n\nEvidence: %s" % (f.get("severity",""), f.get("description",""), ",".join(f.get("evidence",[])))
+        issue = create_issue(title, body, labels=[f"severity:{f.get('severity','medium')}","audit"])
+        created.append(issue["html_url"])
+    return created
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("Usage: audit_tracker.py <findings.json>", file=sys.stderr)
+        sys.exit(2)
+    if not GITHUB_TOKEN or not REPO:
+        print("Set GITHUB_TOKEN and GITHUB_REPO env vars", file=sys.stderr); sys.exit(3)
+    out = ingest_findings(sys.argv[1])
+    print("Created issues:")
+    for u in out:
+        print(" -", u)
+
