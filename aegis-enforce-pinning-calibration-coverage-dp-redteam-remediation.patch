+#!/usr/bin/env python3
+"""
+Calibration script to compute detection thresholds for desired FN rate.
+Input: CSV file with two columns: text,label (label: 1=positive/contains PII/NSFW, 0=negative)
+Output: thresholds.json with chosen threshold per detector (e.g., text_confidence_min).
+"""
+import csv, sys, json, argparse
+from sklearn.metrics import roc_curve
+import numpy as np
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--input", required=True, help="labeled CSV: text,label")
+parser.add_argument("--detector", default="text_pii", help="detector id")
+parser.add_argument("--target-fn", type=float, default=0.001, help="target false negative rate (e.g., 0.001)")
+parser.add_argument("--out", default="thresholds.json")
+args = parser.parse_args()
+
+texts = []
+labels = []
+with open(args.input) as fh:
+    r = csv.reader(fh)
+    for row in r:
+        if not row: continue
+        texts.append(row[0])
+        labels.append(int(row[1]))
+
+# For calibration we need detectors to score each text. Use a simple proxy: regex positives -> score 1.0 else random low.
+from ops.multimodal.ingest.dlp import analyze_text
+
+scores = []
+for t in texts:
+    res = analyze_text(t)
+    # Determine a confidence score: if presidio match exists, high; else heuristics
+    if res.get("pii", False):
+        scores.append(0.99)
+    else:
+        scores.append(0.01)
+
+fpr, tpr, th = roc_curve(labels, scores)
+fnr = 1 - tpr
+idx = (np.abs(fnr - args.target_fn)).argmin()
+chosen = float(th[idx])
+
+out = {args.detector: {"threshold": chosen, "target_fn": args.target_fn}}
+with open(args.out, "w") as fh:
+    json.dump(out, fh, indent=2)
+print("Wrote thresholds to", args.out)
+
