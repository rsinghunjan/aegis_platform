+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Fetch pinned model artifacts from a trusted artifact store and verify checksums
+# Usage (in builder): ARTIFACT_BASE=https://artifacts.example.com/aegis/models ./verify_and_install_models.sh /opt/aegis/models
+
+ART_BASE=${ARTIFACT_BASE:-""}
+DEST=${1:-/opt/aegis/models}
+mkdir -p "$DEST"
+
+if [ -z "$ART_BASE" ]; then
+  echo "Set ARTIFACT_BASE env to your private artifact store base URL"
+  exit 2
+fi
+
+fetch() {
+  src="$1"
+  dst="$2"
+  echo "Fetching $src -> $dst"
+  curl -fsSL "$src" -o "$dst"
+}
+
+verify_checksum() {
+  file="$1"
+  checksum_file="$2"
+  (cd "$(dirname "$file")" && sha256sum -c "$(basename "$checksum_file")") || (echo "checksum failed for $file" && exit 3)
+}
+
+echo "Downloading pinned nudenet classifier..."
+mkdir -p "$DEST/nudenet"
+fetch "$ART_BASE/nudenet/classifier-0.2.4.pkl" "$DEST/nudenet/classifier-0.2.4.pkl"
+fetch "$ART_BASE/nudenet/checksum.sha256" "$DEST/nudenet/checksum.sha256"
+verify_checksum "$DEST/nudenet/classifier-0.2.4.pkl" "$DEST/nudenet/checksum.sha256"
+
+echo "Downloading Presidio analyzer models..."
+mkdir -p "$DEST/presidio"
+fetch "$ART_BASE/presidio/analyzer-models.tar.gz" "$DEST/presidio/analyzer-models.tar.gz"
+fetch "$ART_BASE/presidio/checksum.sha256" "$DEST/presidio/checksum.sha256"
+verify_checksum "$DEST/presidio/analyzer-models.tar.gz" "$DEST/presidio/checksum.sha256"
+tar -xzf "$DEST/presidio/analyzer-models.tar.gz" -C "$DEST/presidio"
+
+echo "Ensure Whisper models are provisioned via artifact store. (Not auto-downloaded in this script)"
+
+echo "Model provisioning complete."
+
