+#!/usr/bin/env python3
+"""
+Minimal human review UI for approvers.
+ - Lists pending items from review-queue /list
+ - Allows upload of signed approval blob or invokes local cosign sign-blob via CLI (if available)
+ - Submits approval to /approve endpoint with hex-encoded signature blob
+
+This UI is intentionally minimal; in production replace with a proper internal webapp and secure auth.
+"""
+import os, requests, binascii, tempfile, subprocess
+from flask import Flask, render_template_string, request, redirect, url_for
+
+REVIEW_URL = os.environ.get("REVIEW_QUEUE_URL", "http://review-queue:8091")
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI", "")
+
+app = Flask("human-review-ui")
+
+INDEX = """
+<h1>Aegis Human Review</h1>
+<a href="/list">Refresh</a>
+"""
+
+@app.route("/list")
+def list_pending():
+    r = requests.get(REVIEW_URL + "/list")
+    items = r.json().get("items",[])
+    html = "<h2>Pending</h2><ul>"
+    for it in items:
+        html += f"<li>{it['id']} - {it['reason'] if 'reason' in it else ''} - <a href='/item/{it['id']}'>view</a></li>"
+    html += "</ul>"
+    return html
+
+@app.route("/item/<id>", methods=["GET","POST"])
+def item(id):
+    if request.method == "GET":
+        r = requests.get(REVIEW_URL + "/list")
+        items = r.json().get("items",[])
+        item = next((x for x in items if x.get("id")==id), None)
+        return f"<pre>{item}</pre><form method='post' enctype='multipart/form-data'><input type='file' name='sig'/><button>Upload approval blob</button></form>"
+    else:
+        f = request.files.get("sig")
+        data = f.read()
+        hexblob = binascii.hexlify(data).decode()
+        r = requests.post(REVIEW_URL + "/approve", json={"id": id, "approvals":[hexblob]})
+        return redirect(url_for("list_pending"))
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8092")))
+
