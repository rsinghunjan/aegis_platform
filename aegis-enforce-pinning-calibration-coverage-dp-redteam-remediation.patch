+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Generate temporary self-signed CA and client certs for testing mTLS between GW and DP service.
+OUTDIR=${1:-/tmp/dp_mtls}
+mkdir -p "$OUTDIR"
+
+openssl genrsa -out "$OUTDIR/ca.key" 2048
+openssl req -x509 -new -nodes -key "$OUTDIR/ca.key" -subj "/CN=aegis-ca" -days 365 -out "$OUTDIR/ca.crt"
+
+openssl genrsa -out "$OUTDIR/dp.key" 2048
+openssl req -new -key "$OUTDIR/dp.key" -subj "/CN=dp-service" -out "$OUTDIR/dp.csr"
+openssl x509 -req -in "$OUTDIR/dp.csr" -CA "$OUTDIR/ca.crt" -CAkey "$OUTDIR/ca.key" -CAcreateserial -out "$OUTDIR/dp.crt" -days 365
+
+openssl genrsa -out "$OUTDIR/gw.key" 2048
+openssl req -new -key "$OUTDIR/gw.key" -subj "/CN=triton-gateway" -out "$OUTDIR/gw.csr"
+openssl x509 -req -in "$OUTDIR/gw.csr" -CA "$OUTDIR/ca.crt" -CAkey "$OUTDIR/ca.key" -CAcreateserial -out "$OUTDIR/gw.crt" -days 365
+
+echo "Generated test mTLS certs in $OUTDIR. Configure DP service to use dp.crt/dp.key and gateway to present gw.crt/gw.key using CA ca.crt"
+
