+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Fail if code calls Triton direct endpoint strings or tritonclient usage (enforce gateway routing)
+FOUND=0
+for f in $(git ls-files '*.py' '*.js' '*.ts' | grep -v ops/serving/gateway); do
+  if grep -q "triton" "$f" || grep -q "v2/models" "$f"; then
+    echo "Potential direct Triton call in $f"
+    FOUND=1
+  fi
+done
+if [ "$FOUND" -eq 1 ]; then
+  echo "Direct Triton calls detected. Use client_sdk or gateway."
+  exit 2
+fi
+echo "No direct Triton calls found."
+
