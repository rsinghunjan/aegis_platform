@@ -0,0 +1,203 @@
+"""
+Tool/function calling semantics (gateway-level).
+
+We implement a safe minimal subset:
+  - Accept OpenAI tool schema in requests
+  - Pass through to upstream vLLM OpenAI-compatible API
+  - If upstream returns tool_calls, we capture them into audit details
+
+NOTE: We do not execute tools server-side in this patch. Execution is app-specific.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+
+def extract_tool_calls(resp: Dict[str, Any]) -> List[Dict[str, Any]]:
+    """
+    OpenAI-like responses may include:
+      choices[0].message.tool_calls = [{id,type,function:{name,arguments}}]
+    """
+    try:
+        choices = resp.get("choices") or []
+        if not choices:
+            return []
+        msg = (choices[0] or {}).get("message") or {}
+        tc = msg.get("tool_calls") or []
+        return tc if isinstance(tc, list) else []
+    except Exception:
+        return []
