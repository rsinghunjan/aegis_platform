+"""
+GPU scheduling policies, queues, and preemption strategies.
+
+This patch provides:
+  - Kueue LocalQueue + ClusterQueue templates (GitOps) and simple attachment via labels/annotations.
+  - Volcano queue annotations template (GitOps).
+
+We do not create these resources from the API by default (safer for enterprise ops).
+Instead, we provide templates + an API endpoint to surface the recommended labels/annotations
+that a job should carry to be admitted to a queue.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict
+
+
+def kueue_job_labels(queue_name: str) -> Dict[str, str]:
+    return {"kueue.x-k8s.io/queue-name": queue_name}
+
+
+def volcano_job_annotations(queue_name: str) -> Dict[str, str]:
+    return {"scheduling.volcano.sh/queue-name": queue_name}
+
+
+def kueue_templates() -> str:
+    return """\
+apiVersion: kueue.x-k8s.io/v1beta1
+kind: ClusterQueue
+metadata:
+  name: aegis-gpu
+spec:
+  namespaceSelector: {}
+  resourceGroups:
+  - coveredResources: ["cpu","memory","nvidia.com/gpu"]
+    flavors:
+    - name: default
+      resources:
+      - name: "cpu"
+        nominalQuota: 200
+      - name: "memory"
+        nominalQuota: 1024Gi
+      - name: "nvidia.com/gpu"
+        nominalQuota: 32
+---
+apiVersion: kueue.x-k8s.io/v1beta1
+kind: LocalQueue
+metadata:
+  name: aegis-gpu
+  namespace: REPLACE_ME_TENANT_NS
+spec:
+  clusterQueue: aegis-gpu
+"""
