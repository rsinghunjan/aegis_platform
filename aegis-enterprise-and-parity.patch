+"""
+Assistants-style stateful threads (parity-lite).
+
+Implements a minimal subset:
+  - create thread
+  - add messages to thread
+  - run thread (calls underlying vLLM chat completions)
+
+This is not full OpenAI Assistants parity. It provides stateful conversation
+storage and a run primitive, which is often enough for internal tooling.
+"""
+
+from __future__ import annotations
+
+import time
+import uuid
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional
+
+
+def new_id(prefix: str) -> str:
+    return f"{prefix}_{uuid.uuid4().hex[:16]}"
+
+
+def thread_obj(thread_id: str) -> Dict[str, Any]:
+    return {"id": thread_id, "object": "thread", "created_at": int(time.time())}
+
+
+def message_obj(thread_id: str, role: str, content: str) -> Dict[str, Any]:
+    return {
+        "id": new_id("msg"),
+        "object": "thread.message",
+        "thread_id": thread_id,
+        "role": role,
+        "content": [{"type": "text", "text": {"value": content}}],
+        "created_at": int(time.time()),
+    }
+
+
+def run_obj(thread_id: str, run_id: str, status: str = "queued") -> Dict[str, Any]:
+    return {"id": run_id, "object": "thread.run", "thread_id": thread_id, "status": status, "created_at": int(time.time())}
