+"""
+Standard templates for DDP / DeepSpeed / Accelerate.
+
+These templates are designed to be used with PyTorchJob (Kubeflow operator).
+They assume your container image includes:
+  - torchrun / deepspeed / accelerate CLI
+  - your train script (e.g. train.py)
+
+You can set script + args per job.
+"""
+
+from __future__ import annotations
+
+from typing import Dict, List
+
+
+def torchrun_args(script: str, script_args: List[str], nproc_per_node: int = 1) -> List[str]:
+    return [
+        "torchrun",
+        "--nproc_per_node",
+        str(nproc_per_node),
+        script,
+        *script_args,
+    ]
+
+
+def deepspeed_args(script: str, script_args: List[str], ds_config_path: str = "/work/ds_config.json") -> List[str]:
+    return [
+        "deepspeed",
+        "--deepspeed_config",
+        ds_config_path,
+        script,
+        *script_args,
+    ]
+
+
+def accelerate_args(script: str, script_args: List[str], config_path: str = "/work/accelerate.yaml") -> List[str]:
+    return [
+        "accelerate",
+        "launch",
+        "--config_file",
+        config_path,
+        script,
+        *script_args,
+    ]
