+"""
+Operator installation + version compatibility hardening.
+
+We avoid kubectl/helm shelling out from the API. Instead we:
+  - provide "compat checks" that confirm CRDs exist and match expected versions
+  - provide YAML manifests under k8s/operators for GitOps install
+
+This module exposes detection helpers used by API endpoints.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Optional, Tuple
+
+from kubernetes import client, config
+from kubernetes.client.rest import ApiException
+
+
+def _load_k8s():
+    mode = os.environ.get("AEGIS_K8S_CONFIG", "auto")
+    if mode == "incluster":
+        config.load_incluster_config()
+        return
+    if mode == "kubeconfig":
+        config.load_kube_config()
+        return
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+
+
+def crd_exists(name: str) -> bool:
+    _load_k8s()
+    api = client.ApiextensionsV1Api()
+    try:
+        api.read_custom_resource_definition(name)
+        return True
+    except ApiException as e:
+        if e.status == 404:
+            return False
+        raise
+
+
+def training_operator_status() -> dict:
+    """
+    Detects common operators:
+      - Kubeflow Training Operator (PyTorchJob CRD)
+      - Ray Operator (RayJob CRD)
+      - Kueue (queues)
+      - Volcano (queues)
+    """
+    return {
+        "pytorchjob_crd": crd_exists("pytorchjobs.kubeflow.org"),
+        "rayjob_crd": crd_exists("rayjobs.ray.io"),
+        "kueue_crd": crd_exists("clusters.queues.kueue.x-k8s.io") or crd_exists("localqueues.kueue.x-k8s.io"),
+        "volcano_crd": crd_exists("queues.scheduling.volcano.sh"),
+    }
