+    rid = new_id("run")
+    # Build chat messages from thread
+    s = SessionLocal()
+    try:
+        from api.golden_models import AssistantMessage
+        msgs = (
+            s.query(AssistantMessage)
+            .filter(AssistantMessage.tenant_id == actor.tenant_id)
+            .filter(AssistantMessage.thread_id == thread_id)
+            .order_by(AssistantMessage.created_at.asc())
+            .all()
