+"""
+Demonstration of a simple additive-mask based secure-aggregation protocol (NOT production cryptography).
+Purpose: show how clients can mask updates and server can unmask after collecting masks.
+In production, replace with Bonawitz et al. secure aggregation or library.
+"""
+import os, json, random, tempfile
+
+def client_mask(weights):
+    # generate mask same shape as weights
+    mask = [random.uniform(-1,1) for _ in range(len(weights))]
+    masked = [w + m for w,m in zip(weights, mask)]
+    return masked, mask
+
+def server_aggregate(masked_updates, masks):
+    # masked_updates: list of masked update lists
+    # masks: list of masks provided when clients reveal (insecure)
+    import numpy as np
+    arrs = [np.array(m) for m in masked_updates]
+    sum_masked = sum(arrs)
+    sum_masks = sum([np.array(m) for m in masks])
+    aggregated = (sum_masked - sum_masks) / len(masked_updates)
+    return aggregated.tolist()
+
+if __name__=="__main__":
+    # demo
+    updates = [[1,2,3],[2,3,4],[0,1,2]]
+    masked=[]
+    masks=[]
+    for u in updates:
+        msked, m = client_mask(u)
+        masked.append(msked)
+        masks.append(m)
+    agg = server_aggregate(masked, masks)
+    print("Aggregated:", agg)
+
