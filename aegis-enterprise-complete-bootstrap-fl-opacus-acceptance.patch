+#!/usr/bin/env python3
+"""
+FL client with Opacus DP-SGD example (small PyTorch model).
+This replaces the simple local_train_simulate with an Opacus-enabled training loop.
+For demo purposes uses synthetic data and a tiny model; adapt to your real dataset and model.
+"""
+import torch
+import torch.nn as nn
+import torch.optim as optim
+from opacus import PrivacyEngine
+import numpy as np
+import json, os
+
+class TinyModel(nn.Module):
+    def __init__(self, dim=10):
+        super().__init__()
+        self.fc = nn.Linear(dim, 1)
+    def forward(self, x):
+        return self.fc(x)
+
+def dp_train(weights, epochs=1, lr=1e-3, clipping=1.0, noise_mult=1.0, batch_size=32):
+    dim = len(weights) if weights else 10
+    model = TinyModel(dim)
+    if weights:
+        with torch.no_grad():
+            w = torch.tensor(weights[:dim], dtype=torch.float).view(dim,1)
+            # map to model parameters (demo)
+    optimizer = optim.SGD(model.parameters(), lr=lr)
+    privacy_engine = PrivacyEngine(
+        model,
+        sample_rate=batch_size/1000.0,
+        alphas=[10, 100],
+        noise_multiplier=noise_mult,
+        max_grad_norm=clipping,
+    )
+    privacy_engine.attach(optimizer)
+    # synthetic data
+    X = torch.randn(1000, dim)
+    y = torch.randn(1000, 1)
+    dataset = torch.utils.data.TensorDataset(X,y)
+    loader = torch.utils.data.DataLoader(dataset, batch_size=batch_size, shuffle=True)
+    model.train()
+    for _ in range(epochs):
+        for xb,yb in loader:
+            optimizer.zero_grad()
+            pred = model(xb)
+            loss = nn.functional.mse_loss(pred, yb)
+            loss.backward()
+            optimizer.step()
+    # return model weights as list
+    weights_out = []
+    for p in model.parameters():
+        weights_out.extend(p.detach().cpu().numpy().ravel().tolist())
+    eps, best_alpha = privacy_engine.accountant.get_privacy_spent(delta=1e-5)
+    return weights_out, {"epsilon": eps, "alpha": best_alpha}
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--epochs", type=int, default=1)
+    p.add_argument("--noise", type=float, default=1.0)
+    args = p.parse_args()
+    w,meta = dp_train([], epochs=args.epochs, noise_mult=args.noise)
+    print("Trained weights length:", len(w))
+    print("DP meta:", meta)
+
