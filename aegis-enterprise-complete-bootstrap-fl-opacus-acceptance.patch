+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Prefilled bootstrap script for Aegis production stack.
+# Uses ops/runbooks/prefilled_values.env for environment values (placeholders if not filled).
+#
+if [ -f ops/runbooks/prefilled_values.env ]; then
+  source ops/runbooks/prefilled_values.env
+else
+  echo "Missing ops/runbooks/prefilled_values.env - copy docs/runbooks/prefilled_values.template and fill values."
+  exit 2
+fi
+
+echo "[bootstrap] Using cluster context: $CLUSTER_CONTEXT"
+kubectl config use-context "$CLUSTER_CONTEXT"
+
+echo "[bootstrap] Create namespaces"
+kubectl create ns aegis-app || true
+kubectl create ns aegis-ml || true
+kubectl create ns aegis-system || true
+
+echo "[bootstrap] Install Redis (session store) if missing"
+if ! kubectl -n aegis-app get svc aegis-redis-headless >/dev/null 2>&1; then
+  helm repo add bitnami https://charts.bitnami.com/bitnami || true
+  helm upgrade --install aegis-redis bitnami/redis --namespace aegis-app --set auth.enabled=false
+fi
+
+echo "[bootstrap] Deploy Prompt Registry Helm (image must be pushed to registry)"
+helm upgrade --install aegis-prompt-registry ops/prompt/registry/helm -n aegis-app \
+  --set image.repository="${CONTAINER_REGISTRY}/aegis-prompt-registry" --set image.tag="latest"
+
+echo "[bootstrap] Deploy oauth2-proxy (OIDC) - ensure secrets for OIDC are created separately."
+kubectl apply -f ops/security/oidc/oauth2-proxy-deployment.yaml -n aegis-system || true
+
+echo "[bootstrap] Deploy FL server, RBAC and supporting services"
+kubectl apply -f ops/fl/k8s/rbac.yaml -n aegis-app || true
+kubectl apply -f ops/fl/k8s/fl-server-deployment.yaml -n aegis-app || true
+
+echo "[bootstrap] Deploy Triton & vLLM sample servers (adjust PVCs/models separately)"
+kubectl apply -f ops/serving/triton/deployment.yaml -n aegis-ml || true
+kubectl apply -f ops/serving/vllm/deployment.yaml -n aegis-ml || true
+
+echo "[bootstrap] Deploy carbon & webhook stack"
+bash ops/carbon/deploy_stack.sh || true
+
+echo "[bootstrap] Deploy telemetry daemonset for GPU power (optional)"
+kubectl apply -f ops/telemetry/gpu-power-daemonset.yaml -n aegis-system || true
+
+echo "[bootstrap] Deploy FL client job template and sample client images must be pushed to registry."
+kubectl apply -f ops/fl/k8s/fl-client-job-template.yaml -n aegis-app || true
+
+echo "[bootstrap] Create service accounts, Vault policies and RBAC (operator must configure Vault separately)."
+kubectl apply -f ops/fl/k8s/rbac.yaml -n aegis-app || true
+kubectl apply -f ops/carbon/k8s/carbon-webhook-rbac.yaml -n aegis-app || true
+
+echo "[bootstrap] Bootstrap complete. Follow docs/runbooks/carbon_bootstrap_and_validate.md and ops/fl/docs/ops.md to validate."
+
