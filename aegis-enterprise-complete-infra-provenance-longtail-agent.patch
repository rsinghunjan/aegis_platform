+
+def package_sign(outdir, cosign_key):
+    bundle = outdir.rstrip("/") + "_hil_cert.tar.gz"
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    return bundle
+
+def record_manifest_safe(key, value):
