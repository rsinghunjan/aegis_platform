+#!/usr/bin/env python3
+"""
+Long-tail worker: analyze sim outputs, extract failing scenarios, push to a queue for HIL replay.
+This script runs in K8s sim-analyzer pods.
+"""
+import argparse, os, json, redis, time
+
+REDIS_URL = os.environ.get("REDIS_URL","redis://redis:6379/0")
+
+def find_fails(sim_out_dir):
+    fails=[]
+    for root,_,files in os.walk(sim_out_dir):
+        for f in files:
+            if f.endswith(".result.json"):
+                j=json.load(open(os.path.join(root,f)))
+                if not j.get("pass",True):
+                    fails.append({"id": j.get("scenario_id"), "reason": j.get("reason"), "path": os.path.join(root,f)})
+    return fails
+
+def push_to_queue(fails):
+    import redis
+    r = redis.from_url(REDIS_URL)
+    for f in fails:
+        r.rpush("sim:failures", json.dumps(f))
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="input", required=True)
+    args = p.parse_args()
+    fails = find_fails(args.input)
+    print("Found failures:", len(fails))
+    if fails:
+        push_to_queue(fails)
+        print("Pushed failures to redis queue")
+
