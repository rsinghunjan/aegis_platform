+"""
+Consumer for sim failure queue that schedules HIL replays and records evidence.
+ - Polls Redis for failing scenarios, batches them and invokes a HIL replay job (K8s job or Argo).
+ - Records job ids and manifests.
+"""
+import argparse, os, json, time, redis, subprocess
+
+REDIS_URL = os.environ.get("REDIS_URL","redis://redis:6379/0")
+
+def pop_failures(batch_size=10):
+    r = redis.from_url(REDIS_URL)
+    outs=[]
+    for _ in range(batch_size):
+        item = r.lpop("sim:failures")
+        if not item:
+            break
+        outs.append(json.loads(item))
+    return outs
+
+def schedule_hil_replay(fails, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    for f in fails:
+        # submit HIL job (placeholder)
+        jobdir = os.path.join(outdir, f.get("id"))
+        os.makedirs(jobdir, exist_ok=True)
+        subprocess.call(["python3","ops/robotics/control/hil_replay.py","--scenario",f.get("id"),"--out",jobdir])
+    return True
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--batch", type=int, default=10)
+    p.add_argument("--out", default="/tmp/longtail_hil")
+    args = p.parse_args()
+    while True:
+        fails = pop_failures(args.batch)
