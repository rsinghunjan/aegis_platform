+#!/usr/bin/env python3
+"""
+Run RT sweeps across a fleet of exact hardware targets, validate SLOs, produce signed proof bundles,
+upload bundles to S3 and emit a summary.
+"""
+import argparse, yaml, os, subprocess, json
+from datetime import datetime
+
+def load_targets(path):
+    with open(path) as fh:
+        return yaml.safe_load(fh).get("targets", [])
+
+def run_sweep(target, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    env = os.environ.copy()
+    env["TARGET_HOST"] = target["host"]
+    env["TARGET_IFACE"] = target["iface"]
+    # call underlying RT sweep script (operator-specific)
+    cmd = ["./ops/av/rt/run_hw_rt_sweep.sh", outdir]
+    try:
+        subprocess.check_call(cmd, env=env)
+    except Exception as e:
+        print("RT sweep failed for", target["name"], e)
+    proof = os.path.join(outdir, "rt_slo_proof.json")
+    return proof if os.path.exists(proof) else None
+
+def sign_bundle(outdir, cosign_key):
+    bundle = outdir.rstrip("/") + ".tar.gz"
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    return bundle
+
+def upload_s3(path, s3_uri):
+    try:
+        subprocess.check_call(["aws","s3","cp",path, s3_uri])
+        return True
+    except Exception as e:
+        print("s3 upload failed:", e)
+        return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--targets-yaml", default="conf/hw_targets_exact.yaml")
+    p.add_argument("--out", default="/tmp/rt_fleet")
+    p.add_argument("--cosign", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    p.add_argument("--p99-threshold", type=float, default=0.5)
+    p.add_argument("--safe-threshold-ms", type=float, default=50.0)
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    targets = load_targets(args.targets_yaml)
+    summary = {"run_at": datetime.utcnow().isoformat()+"Z", "results": []}
+    for t in targets:
+        od = os.path.join(args.out, t["name"])
+        proof = run_sweep(t, od)
+        ok = False
+        bundle = None
+        if proof:
+            # basic validation: open proof and check values
+            try:
+                j=json.load(open(proof))
+                p99 = j.get("p99_ms",9999)
+                safe = j.get("safe_ms",9999)
+                ok = (p99 <= args.p99_threshold) and (safe <= args.safe_threshold_ms)
+            except Exception:
+                ok=False
+            bundle = sign_bundle(od, args.cosign)
+            if args.s3 and bundle:
+                upload_s3(bundle, os.path.join(args.s3, os.path.basename(bundle)))
+        summary["results"].append({"target": t["name"], "proof": proof, "bundle": bundle, "ok": ok})
+    summary_path = os.path.join(args.out, "summary.json")
+    with open(summary_path, "w") as fh:
+        json.dump(summary, fh, indent=2)
+    print("RT fleet sweep complete. Summary:", summary_path)
+
+if __name__=="__main__":
+    main()
+
