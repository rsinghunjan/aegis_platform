+#!/usr/bin/env python3
+"""
+Map PoA & run artifacts to Prometheus metrics via Pushgateway.
+ - Push total PoA duration and per-stage durations as metrics.
+"""
+import argparse, json, os, requests
+
+PUSHGATEWAY = os.environ.get("PUSHGATEWAY","http://pushgateway:9091")
+
+def push(metric, value, job="aegis_pofa", labels=None):
+    labels = labels or {}
+    label_str = ",".join([f'{k}="{v}"' for k,v in labels.items()])
+    body = f"# TYPE {metric} gauge\n{metric}{{{label_str}}} {value}\n" if label_str else f"# TYPE {metric} gauge\n{metric} {value}\n"
+    url = f"{PUSHGATEWAY}/metrics/job/{job}"
+    requests.post(url, data=body, timeout=5)
+
+def emit_from_report(report_path):
+    r = json.load(open(report_path))
+    push("aegis_pofa_total_duration_seconds", r.get("total_duration_s", 0))
+    for s in r.get("stages", []):
+        push("aegis_pofa_stage_duration_seconds", s.get("duration_s",0), labels={"stage": s.get("stage","")})
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--report", required=True)
+    args = p.parse_args()
+    emit_from_report(args.report)
+    print("Pushed metrics to Pushgateway")
+
