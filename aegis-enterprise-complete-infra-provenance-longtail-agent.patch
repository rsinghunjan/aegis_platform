+#!/usr/bin/env python3
+"""
+Large-scale agent validator: submits many tasks to agent manager, collects traces, checks for policy violations and aggregates metrics.
+"""
+import argparse, requests, time, json, os
+
+AGENT_URL = os.environ.get("AGENT_URL","http://localhost:8300")
+
+def submit_task(i):
+    payload = {"task": f"validate_{i}", "actions":[{"type":"navigate"},{"type":"throttle","value":30},{"type":"brake"}]}
+    try:
+        r = requests.post(f"{AGENT_URL}/submit", json=payload, timeout=10)
+        return r.status_code == 200
+    except Exception:
+        return False
+
+def fetch_logs(out):
+    try:
+        r = requests.get(f"{AGENT_URL}/logs", timeout=10)
+        if r.status_code == 200:
+            with open(out,"w") as fh:
+                json.dump(r.json(), fh)
+            return True
+    except Exception:
+        pass
+    return False
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--count", type=int, default=50)
+    p.add_argument("--out", default="/tmp/agent_validate")
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    for i in range(args.count):
+        submit_task(i)
+        time.sleep(0.2)
+    fetch_logs(os.path.join(args.out,"agent_logs.json"))
+    print("Agent validation finished. Logs:", os.path.join(args.out,"agent_logs.json"))
+
