+"""
+Simple HTTP service to enforce runtime action constraints for agents.
+ - Receives POST /action events: {"action": {...}, "state": {...}}
+ - Verifies policy (JSON file) and, on violation, calls E-STOP adapter and records evidence.
+"""
+from flask import Flask, request, jsonify
+import argparse, json, requests, os
+from datetime import datetime
+
+app = Flask(__name__)
+POLICY_PATH = os.environ.get("AGENT_POLICY_PATH","/etc/aegis/agent_policy.json")
+ESTOP_ENDPOINT = os.environ.get("ESTOP_ENDPOINT","http://localhost:9200")
+
+def load_policy(path):
+    try:
+        return json.load(open(path))
+    except Exception:
+        return {}
+
+def check_violation(action, state, policy):
+    # Example rule: if brake_engaged and action.type == "throttle" => violation
+    if state.get("brake_engaged") and action.get("type") == "throttle":
+        return True, "throttle_while_brake"
+    # Check numeric bounds
+    if action.get("type") == "throttle" and action.get("value",0) > policy.get("max_throttle",100):
+        return True, "throttle_exceeds_max"
+    return False, ""
+
+def call_estop(reason):
+    try:
+        requests.post(ESTOP_ENDPOINT + "/update", json={"estop": True, "reason": reason}, timeout=2)
+    except Exception as e:
+        app.logger.error("E-STOP call failed: %s", e)
+
+def record_evidence(entry):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("agent_policy_violation", entry)
+    except Exception:
+        app.logger.info("No evidence SDK available, skipping record_manifest")
+
+@app.route("/action", methods=["POST"])
+def action():
+    payload = request.get_json() or {}
+    action = payload.get("action", {})
+    state = payload.get("state", {})
+    policy = load_policy(POLICY_PATH)
+    violated, reason = check_violation(action, state, policy)
+    ts = datetime.utcnow().isoformat() + "Z"
+    entry = {"action": action, "state": state, "violated": violated, "reason": reason, "ts": ts}
+    if violated:
+        call_estop(reason)
+        record_evidence(entry)
+        return jsonify({"ok": False, "reason": reason}), 403
+    return jsonify({"ok": True}), 200
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--host", default="0.0.0.0")
+    p.add_argument("--port", type=int, default=8400)
+    args = p.parse_args()
+    app.run(host=args.host, port=args.port)
