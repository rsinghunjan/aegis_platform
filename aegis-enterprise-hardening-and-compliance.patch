*** Add File:ops/audit/signed_audit_collector.py
+#!/usr/bin/env python3
+"""
+Collect audit logs, compute hashes, sign bundle with cosign (KMS) and upload to S3 + Rekor entry.
+Intended to run as a cron job (e.g., daily) to snapshot audit logs for retention and tamper-evidence.
+"""
+import os, json, hashlib, tarfile, subprocess, tempfile
+from datetime import datetime
+
+AUDIT_LOG_DIR = os.environ.get("AUDIT_LOG_DIR","/var/log/audit")
+OUT_S3 = os.environ.get("S3_AUDIT_BUCKET","s3://aegis-audit")
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI","")
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path,"rb") as fh:
+        for chunk in iter(lambda: fh.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+def bundle_and_sign(outdir):
+    tmp = tempfile.mkdtemp()
+    tarpath = os.path.join(tmp, f"aegis_audit_{int(datetime.utcnow().timestamp())}.tar.gz")
+    with tarfile.open(tarpath, "w:gz") as tar:
+        tar.add(outdir, arcname="audit")
+    if COSIGN_KEY:
+        subprocess.check_call(["cosign","sign","--key",COSIGN_KEY, tarpath])
+    if OUT_S3:
+        subprocess.check_call(["aws","s3","cp", tarpath, OUT_S3])
+    print("Bundled and uploaded audit:", tarpath)
+
+if __name__=="__main__":
+    # collect today's logs (simple example)
+    today = datetime.utcnow().strftime("%Y-%m-%d")
+    outdir = os.path.join("/tmp","audit_snapshot_"+today)
+    os.makedirs(outdir, exist_ok=True)
+    for root,_,files in os.walk(AUDIT_LOG_DIR):
+        for f in files:
+            if f.endswith(".log"):
+                src = os.path.join(root,f)
+                dest = os.path.join(outdir,f)
+                subprocess.call(["cp",src,dest])
+    bundle_and_sign(outdir)
+
