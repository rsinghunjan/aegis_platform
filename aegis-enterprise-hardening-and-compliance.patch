+#!/usr/bin/env bash
+#
+# Example key rotation script (AWS KMS sample). Adjust for GCP/Azure accordingly.
+KEY_ID=${1:-"alias/aegis-cosign-key"}
+REGION=${AWS_REGION:-us-west-2}
+echo "Creating a new KMS key and rotating alias for $KEY_ID in $REGION"
+NEW_KEY_ID=$(aws kms create-key --region $REGION --query KeyMetadata.KeyId --output text)
+aws kms create-alias --alias-name $KEY_ID-new --target-key-id $NEW_KEY_ID || true
+# Point alias to new key atomically
+aws kms update-alias --alias-name "$KEY_ID" --target-key-id "$NEW_KEY_ID"
+echo "Rotated alias $KEY_ID to key $NEW_KEY_ID"
+# Log rotation event (should be recorded in audit logs)
+aws kms get-key-rotation-status --key-id $NEW_KEY_ID
+
