+#!/usr/bin/env python3
+"""
+Admission webhook stub that enforces simple budget policy:
+ - Prevents creation of deployments that would exceed a namespace GPU budget (configured in annotation)
+"""
+from http.server import HTTPServer, BaseHTTPRequestHandler
+import json, os
+
+class Handler(BaseHTTPRequestHandler):
+    def do_POST(self):
+        length = int(self.headers.get('Content-Length',0))
+        body = self.rfile.read(length)
+        req = json.loads(body)
+        # parse Deployment request (simplified)
+        namespace = req.get('request',{}).get('namespace','default')
+        # Lookup budget mapping (in prod call billing API)
+        namespace_budget = {"default": 2}
+        # Very naive: reject if annotation requests GPU > budget
+        try:
+            obj = req['request']['object']
+            containers = obj.get('spec',{}).get('template',{}).get('spec',{}).get('containers',[])
+            requested_gpus = 0
+            for c in containers:
+                resources = c.get('resources',{})
+                limits = resources.get('limits',{})
+                requested_gpus += int(limits.get('nvidia.com/gpu',0))
+            if requested_gpus > namespace_budget.get(namespace,0):
+                resp = {"response":{"allowed":False,"status":{"message":"GPU budget exceeded"}}}
+            else:
+                resp = {"response":{"allowed":True}}
+        except Exception as e:
+            resp = {"response":{"allowed":False,"status":{"message":str(e)}}}
+        self.send_response(200)
+        self.end_headers()
+        self.wfile.write(json.dumps(resp).encode())
+
+if __name__=="__main__":
+    HTTPServer(('0.0.0.0', 8443), Handler).serve_forever()
+
