+from __future__ import annotations
+
+"""
+OpenTelemetry (OTel) ingestion + correlation.
+
+This is intentionally minimal and uses OTLP/HTTP JSON as a best-effort sink.
+For production, you should:
+  - run an OpenTelemetry Collector
+  - export traces/metrics/logs to your backend (Tempo/Jaeger/Prometheus/Loki)
+  - use exemplars / trace IDs in metrics
+
+This patch provides:
+  - /v1/otel/v1/traces ingestion endpoint (tenant-scoped)
+  - trace correlation fields stored into audit events via external_context/_external
+"""
+
+import json
+from datetime import datetime
+from typing import Any, Dict, Optional
+
+from fastapi import HTTPException
+
+from api.db import SessionLocal
+from api.golden_models import AuditEvent
+
+
+def _extract_trace_context(payload: Dict[str, Any]) -> Dict[str, Any]:
+    """
+    Best-effort extraction of trace_id/span_id from OTLP/HTTP JSON format.
+    """
+    out: Dict[str, Any] = {}
+    try:
+        rs = (payload.get("resourceSpans") or [])
+        if not rs:
+            return out
+        ils = ((rs[0] or {}).get("scopeSpans") or (rs[0] or {}).get("instrumentationLibrarySpans") or [])
+        if not ils:
+            return out
+        spans = ((ils[0] or {}).get("spans") or [])
+        if not spans:
+            return out
+        sp0 = spans[0] or {}
+        tid = sp0.get("traceId")
+        sid = sp0.get("spanId")
+        if tid:
+            out["trace_id"] = tid
+        if sid:
+            out["span_id"] = sid
+    except Exception:
+        return {}
+    return out
+
+
+def store_trace_marker(tenant_id: str, actor_sub: str, payload: Dict[str, Any]) -> Dict[str, Any]:
+    """
+    Store a lightweight audit marker pointing to a trace.
+    """
+    ctx = _extract_trace_context(payload)
+    if not ctx:
+        return {"stored": False, "reason": "no_trace_context"}
+    s = SessionLocal()
+    try:
+        ev = AuditEvent(
+            tenant_id=tenant_id,
+            actor_sub=actor_sub,
+            action="otel.trace.ingest",
+            entity_type="otel",
+            entity_id=str(ctx.get("trace_id") or ""),
+            decision="allow",
+            details={"_external": {"trace": ctx}},
+            created_at=datetime.utcnow(),
+        )
+        s.add(ev)
+        s.commit()
+        return {"stored": True, **ctx}
+    finally:
+        s.close()
