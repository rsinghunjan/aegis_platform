+from __future__ import annotations
+
+"""
+Robust SLO error-rate decisioning from PromQL.
+
+This converts PromQL results into numeric error rates and provides a helper
+to evaluate a policy threshold.
+"""
+
+from typing import Any, Dict, Optional, Tuple
+
+
+def extract_instant_scalar(resp: Dict[str, Any]) -> Optional[float]:
+    """
+    Prometheus instant query response:
+      data.result[0].value = [ts, "number"]
+    """
+    try:
+        data = resp.get("data") or {}
+        res = data.get("result") or []
+        if not res:
+            return None
+        v = (res[0] or {}).get("value")
+        if not v or len(v) < 2:
+            return None
+        return float(v[1])
+    except Exception:
+        return None
+
+
+def error_rate_promql(service: str, window: str = "5m") -> str:
+    """
+    Assumes you export request counters as:
+      http_requests_total{service="aegis-gateway",code=~"5.."}
+      http_requests_total{service="aegis-gateway"}
+    Adjust labels to match your environment.
+    """
+    return (
+        f"(sum(rate(http_requests_total{{service=\"{service}\",code=~\"5..\"}}[{window}])) "
+        f"/ clamp_min(sum(rate(http_requests_total{{service=\"{service}\"}}[{window}])), 1))"
+    )
+
+
+def decide_error_rate(error_rate: Optional[float], max_allowed: float) -> Tuple[bool, Dict[str, Any]]:
+    if error_rate is None:
+        return True, {"decision": "allow", "reason": "no_data"}
+    if float(error_rate) > float(max_allowed):
+        return False, {"decision": "deny", "reason": "error_rate_exceeded", "error_rate": float(error_rate), "max_allowed": float(max_allowed)}
+    return True, {"decision": "allow", "reason": "ok", "error_rate": float(error_rate), "max_allowed": float(max_allowed)}
