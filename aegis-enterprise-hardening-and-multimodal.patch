+from __future__ import annotations
+
+"""
+First-class multimodal request/response contracts (v1).
+
+This does NOT guarantee your underlying model supports the modality.
+It provides a stable API contract Aegis can validate + meter.
+
+Supported input item types (v1):
+  - text: {"type":"text","text":"..."}
+  - image_url: {"type":"image_url","image_url":{"url":"https://..."}}
+  - image_base64: {"type":"image_base64","image_base64":{"b64":"...","mime":"image/png"}}
+  - audio_base64: {"type":"audio_base64","audio_base64":{"b64":"...","mime":"audio/wav"}}
+
+This is aligned with common OpenAI-style "content parts" patterns.
+"""
+
+from typing import Any, Dict, List, Optional, Tuple
+
+
+def normalize_mm_messages(messages: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+    """
+    Convert multimodal content parts into a format that upstreams (like vLLM OpenAI-compatible)
+    often accept (content list of parts) without losing structure.
+    """
+    out = []
+    for m in messages or []:
+        role = m.get("role") or "user"
+        content = m.get("content")
+        if isinstance(content, str):
+            out.append({"role": role, "content": content})
+            continue
+        if isinstance(content, list):
+            # Validate parts lightly
+            parts = []
+            for p in content:
+                if not isinstance(p, dict) or "type" not in p:
+                    continue
+                t = p["type"]
+                if t == "text" and isinstance(p.get("text"), str):
+                    parts.append({"type": "text", "text": p["text"]})
+                elif t == "image_url" and isinstance((p.get("image_url") or {}).get("url"), str):
+                    parts.append({"type": "image_url", "image_url": {"url": p["image_url"]["url"]}})
+                elif t == "image_base64" and isinstance((p.get("image_base64") or {}).get("b64"), str):
+                    parts.append({"type": "image_url", "image_url": {"url": f"data:{(p.get('image_base64') or {}).get('mime','image/png')};base64,{p['image_base64']['b64']}"}})
+                elif t == "audio_base64" and isinstance((p.get("audio_base64") or {}).get("b64"), str):
+                    # pass through as a custom part; upstream may not support yet
+                    parts.append({"type": "audio_base64", "audio_base64": p["audio_base64"]})
+            out.append({"role": role, "content": parts})
+            continue
+        out.append({"role": role, "content": ""})
+    return out
