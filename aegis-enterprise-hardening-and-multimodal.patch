+++ b/api/golden_drift.py
@@ -0,0 +1,222 @@
+from __future__ import annotations
+
+"""
+Drift monitoring as a first-class signal type.
+
+This patch adds:
+  - a DB model for drift signals (drift_signals)
+  - a minimal detector that compares two time windows from Prometheus query_range
+
+Design:
+  - Drift signals are generic: "metric_name", "baseline_value", "current_value", "drift_score"
+  - You can plug in better drift logic later (PSI, KL divergence, embedding drift, etc.)
+"""
+
+import math
+import time
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional, Tuple
+
+from api.golden_prometheus import prom_query_range
+
+
+def _avg_from_range(resp: Dict[str, Any]) -> Optional[float]:
+    """
+    Prometheus range response:
+      data.result[0].values = [[ts, "v"], ...]
+    """
+    try:
+        data = resp.get("data") or {}
+        res = data.get("result") or []
+        if not res:
+            return None
+        values = (res[0] or {}).get("values") or []
+        xs = [float(v[1]) for v in values if v and len(v) >= 2]
+        if not xs:
+            return None
+        return sum(xs) / float(len(xs))
+    except Exception:
+        return None
+
+
+def drift_score(baseline: float, current: float) -> float:
+    """
+    Simple symmetric relative drift score.
+    """
+    denom = max(1e-9, abs(baseline) + abs(current))
+    return abs(current - baseline) / denom
+
+
+async def detect_drift_from_prometheus(
+    promql: str,
+    *,
+    baseline_minutes: int = 60,
+    current_minutes: int = 15,
+    step: str = "30s",
+) -> Dict[str, Any]:
+    now = time.time()
+    cur_end = now
+    cur_start = now - current_minutes * 60
+    base_end = cur_start
+    base_start = base_end - baseline_minutes * 60
+    base_resp = await prom_query_range(promql, base_start, base_end, step=step)
+    cur_resp = await prom_query_range(promql, cur_start, cur_end, step=step)
+    base_avg = _avg_from_range(base_resp)
+    cur_avg = _avg_from_range(cur_resp)
+    if base_avg is None or cur_avg is None:
+        return {"ok": False, "reason": "insufficient_data"}
+    return {
+        "ok": True,
+        "baseline_avg": base_avg,
+        "current_avg": cur_avg,
+        "drift_score": drift_score(float(base_avg), float(cur_avg)),
+        "baseline_window_min": baseline_minutes,
+        "current_window_min": current_minutes,
+    }
