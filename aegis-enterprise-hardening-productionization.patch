+#!/usr/bin/env python3
+"""
+Simple Triton gRPC load tester. Sends concurrent inference requests and records latencies.
+Requires tritonclient installed: pip install tritonclient[grpc]
+"""
+import time, argparse, statistics
+from concurrent.futures import ThreadPoolExecutor
+from tritonclient.grpc import InferenceServerClient, InferInput, InferRequestedOutput
+
+def run_load(url, model_name, parallel=8, requests_per_thread=10):
+    client = InferenceServerClient(url=url, verbose=False)
+    def send_one(_):
+        # craft a simple request, model must accept this shape
+        try:
+            input0 = InferInput("INPUT__0", [1, 16], "FP32")
+            import numpy as np
+            data = np.random.rand(1,16).astype("float32")
+            input0.set_data_from_numpy(data)
+            outputs = [InferRequestedOutput("OUTPUT__0")]
+            start = time.time()
+            res = client.infer(model_name, inputs=[input0], outputs=outputs)
+            return time.time() - start
+        except Exception as e:
+            print("request error", e)
+            return None
+    times = []
+    with ThreadPoolExecutor(max_workers=parallel) as ex:
+        futures = []
+        for i in range(parallel * requests_per_thread):
+            futures.append(ex.submit(send_one, i))
+        for f in futures:
+            t = f.result()
+            if t:
+                times.append(t)
+    print("sent", len(times), "successful requests")
+    if times:
+        print("p50:", statistics.median(times), "p95:", sorted(times)[int(0.95*len(times))-1])
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--url", default="localhost:8001")
+    p.add_argument("--model", required=True)
+    p.add_argument("--parallel", type=int, default=8)
+    p.add_argument("--rpt", type=int, default=10)
+    args = p.parse_args()
+    run_load(args.url, args.model, args.parallel, args.rpt)
+
