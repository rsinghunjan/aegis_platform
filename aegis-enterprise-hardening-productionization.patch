+#!/usr/bin/env python3
+"""
+Vault PKI integration helpers for client attestation and certificate issuance.
+Assumes Vault PKI is configured and a role exists that can issue client certificates.
+
+Functions:
+ - request_client_cert(client_id) -> returns cert_pem, key_pem
+ - verify_client_cert(cert_pem) -> placeholder to validate cert chain via system trust or Vault CA
+"""
+import os, requests, json, subprocess, tempfile
+
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "https://vault.default.svc:8200")
+VAULT_ROLE = os.environ.get("VAULT_PKI_ROLE", "aegis-client-role")
+
+def request_client_cert(client_id: str, ttl: str = "24h"):
+    """
+    Requests a certificate for client_id using Vault PKI role.
+    Requires VAULT_TOKEN env var or appropriate auth method.
+    """
+    url = f"{VAULT_ADDR}/v1/pki/issue/{VAULT_ROLE}"
+    payload = {"common_name": client_id, "ttl": ttl}
+    token = os.environ.get("VAULT_TOKEN")
+    headers = {"X-Vault-Token": token} if token else {}
+    r = requests.post(url, json=payload, headers=headers, timeout=10, verify=False)
+    r.raise_for_status()
+    resp = r.json()["data"]
+    cert = resp["certificate"]
+    key = resp["private_key"]
+    ca_chain = resp.get("issuing_ca", "")
+    return cert, key, ca_chain
+
+def verify_client_cert(cert_pem: str, ca_pem: str = None):
+    """
+    Verifies cert with system openssl verify or with provided CA.
+    """
+    tmpd = tempfile.mkdtemp()
+    certf = os.path.join(tmpd, "cert.pem")
+    with open(certf, "w") as fh:
+        fh.write(cert_pem)
+    cmd = ["openssl", "verify"]
+    if ca_pem:
+        caf = os.path.join(tmpd, "ca.pem")
+        with open(caf, "w") as fh:
+            fh.write(ca_pem)
+        cmd += ["-CAfile", caf]
+    cmd.append(certf)
+    try:
+        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT)
+        return True, out.decode()
+    except subprocess.CalledProcessError as e:
+        return False, e.output.decode()
+
