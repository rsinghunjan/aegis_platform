+      cat <<EOF | curl --data-binary @- "${PUSHGATEWAY}/metrics/job/aegis_node_gpu_power/node=${NODE_NAME}"
+# TYPE aegis_node_total_gpu_power_w gauge
+aegis_node_total_gpu_power_w ${PWR_SUM}
+EOF
+    fi
+  fi
+  sleep ${INTERVAL}
+done
