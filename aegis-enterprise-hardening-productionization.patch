+#!/usr/bin/env python3
+"""
+Collects audit artifacts, validates cosign signatures (if present), builds manifest and cosign-signs the manifest.
+Uploads manifest and artifacts list to S3 (if configured).
+"""
+import os, json, subprocess, tempfile
+from datetime import datetime
+
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI", "")
+S3_UPLOAD = os.environ.get("S3_UPLOAD", "")
+
+def verify_cosign(bundle_path):
+    try:
+        subprocess.check_call(["cosign","verify",bundle_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def create_manifest(artifacts, out_manifest):
+    manifest = {"generated_at": datetime.utcnow().isoformat() + "Z", "artifacts": []}
+    for a in artifacts:
+        entry = {"path": a}
+        if os.path.exists(a):
+            entry["sha256"] = subprocess.check_output(["sha256sum", a]).decode().split()[0]
+            entry["cosign_valid"] = verify_cosign(a)
+        else:
+            entry["note"] = "missing"
+        manifest["artifacts"].append(entry)
+    with open(out_manifest, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return out_manifest
+
+def sign_manifest(manifest_path):
+    if COSIGN_KEY:
+        subprocess.check_call(["cosign","sign","--key",COSIGN_KEY, manifest_path])
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifacts", required=True, help="comma separated paths")
+    p.add_argument("--out", default="/tmp/aegis_audit_manifest.json")
+    args = p.parse_args()
+    arts = args.artifacts.split(",")
+    manifest = create_manifest(arts, args.out)
+    sign_manifest(manifest)
+    print("Manifest created and signed:", manifest)
+    if S3_UPLOAD:
+        subprocess.check_call(["aws","s3","cp", manifest, S3_UPLOAD + "/" + os.path.basename(manifest)])
+        print("Uploaded to S3:", S3_UPLOAD)
+
