+#!/usr/bin/env python3
+"""
+Lightweight illustrative implementation of the Bonawitz-style pairwise-masking
+secure aggregation protocol for federated learning rounds.
+
+NOT PRODUCTION: This is a more complete reference scaffold (DH key exchange,
+pairwise masks, masked upload and unmasking). Replace with a vetted library
+for production (e.g., an audited Bonawitz implementation).
+
+Usage (conceptual):
+ - Clients generate ephemeral ECDH keypair and upload public key to server.
+ - Server distributes all client public keys to participants for the round.
+ - Each client computes pairwise shared secrets with each other client and
+   derives pairwise masks; the sum of pairwise masks cancels at server after
+   all clients upload masks or reveal shares in reconstruction phase.
+ - Clients mask their model update vectors and upload masked updates.
+ - Server aggregates masked updates and requests mask shares / confirmations
+   to unmask aggregate.
+"""
+import os, json, base64, hashlib
+from cryptography.hazmat.primitives.asymmetric import x25519
+from cryptography.hazmat.primitives import serialization, hashes, hmac
+from cryptography.hazmat.primitives.kdf.hkdf import HKDF
+from typing import List, Dict
+import numpy as np
+
+# Helper functions
+def gen_keypair():
+    sk = x25519.X25519PrivateKey.generate()
+    pk = sk.public_key()
+    pk_bytes = pk.public_bytes(encoding=serialization.Encoding.Raw, format=serialization.PublicFormat.Raw)
+    sk_bytes = sk.private_bytes(encoding=serialization.Encoding.Raw, format=serialization.PrivateFormat.Raw, encryption_algorithm=serialization.NoEncryption())
+    return sk_bytes, pk_bytes
+
+def load_private(sk_bytes):
+    return x25519.X25519PrivateKey.from_private_bytes(sk_bytes)
+
+def load_public(pk_bytes):
+    return x25519.X25519PublicKey.from_public_bytes(pk_bytes)
+
+def derive_shared_key(sk_bytes, peer_pk_bytes):
+    sk = load_private(sk_bytes)
+    peer_pk = load_public(peer_pk_bytes)
+    ss = sk.exchange(peer_pk)
+    # HKDF to derive a mask seed
+    hk = HKDF(algorithm=hashes.SHA256(), length=32, salt=None, info=b"aegis-fl-mask")
+    key = hk.derive(ss)
+    return key  # 32 bytes
+
+def mask_vector(weights: List[float], mask_key: bytes):
+    # deterministic mask generator via HMAC-SHA256 as PRG - expand to vector length
+    prg = hmac.HMAC(mask_key, hashes.SHA256())
+    out = []
+    # simple: generate chunked randomness and map to floats in [-0.5,0.5]
+    needed = len(weights)
+    idx = 0
+    ctr = 0
+    while idx < needed:
+        prg_copy = prg.copy()
+        prg_copy.update(ctr.to_bytes(4, "big"))
+        block = prg_copy.finalize()
+        for b in block:
+            if idx >= needed:
+                break
+            out.append((b / 255.0) - 0.5)
+            idx += 1
+        ctr += 1
+    masked = [w + m for w, m in zip(weights, out)]
+    return masked
+
+# Server-side helpers (scaffold)
+class RoundState:
+    def __init__(self, round_id):
+        self.round_id = round_id
+        self.clients = {}  # client_id -> public_key_b64
+        self.masked_updates = []  # list of (client_id, path_to_masked_bundle)
+        self.revealed_shares = {}  # client_id -> list of mask shares if any
+
+    def register_client(self, client_id: str, pk_b64: str):
+        self.clients[client_id] = pk_b64
+
+    def get_public_keys(self) -> Dict[str,str]:
+        return self.clients
+
+    def add_masked_update(self, client_id: str, bundle_path: str):
+        self.masked_updates.append((client_id, bundle_path))
+
+    def list_participants(self) -> List[str]:
+        return list(self.clients.keys())
+
+# Client-side example flow
+def client_prepare_and_mask(client_id: str, local_weights: List[float], client_sk: bytes, clients_pk_map: Dict[str, bytes]):
+    """
+    client_sk: private key bytes for this client
+    clients_pk_map: mapping client_id -> public key bytes of all participants (including self)
+    """
+    # compute pairwise mask keys and sum them according to role (sign rule to cancel)
+    total_mask = [0.0] * len(local_weights)
+    for other_id, other_pk in clients_pk_map.items():
+        if other_id == client_id:
+            continue
+        key = derive_shared_key(client_sk, other_pk)
+        # deterministically decide sign to ensure masks cancel: e.g., order by client id
+        sign = 1 if client_id > other_id else -1
+        mask = mask_vector(local_weights, key)
+        if sign == 1:
+            total_mask = [a + b for a,b in zip(total_mask, mask)]
+        else:
+            total_mask = [a - b for a,b in zip(total_mask, mask)]
+    masked = [w + m for w,m in zip(local_weights, total_mask)]
+    return masked
+
+if __name__ == "__main__":
+    # tiny demo
+    alice_sk, alice_pk = gen_keypair()
+    bob_sk, bob_pk = gen_keypair()
+    clients = {"alice": alice_pk, "bob": bob_pk}
+    alice_weights = [0.1]*10
+    bob_weights = [0.2]*10
+    masked_alice = client_prepare_and_mask("alice", alice_weights, alice_sk, clients)
+    masked_bob = client_prepare_and_mask("bob", bob_weights, bob_sk, clients)
+    agg_masked = [a + b for a,b in zip(masked_alice, masked_bob)]
+    # server must reconstruct by asking clients to reveal (or by known cancellation) - in this demo cancellation holds
+    print("Aggregated masked sum first elements:", agg_masked[:3])
+
