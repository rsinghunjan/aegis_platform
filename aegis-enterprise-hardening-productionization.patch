+"""
+Tiny distributed training example for DeepSpeed/NCCL validation.
+This script performs a trivial all-reduce across ranks to exercise torch.distributed.
+Run with torch.distributed.run / deepspeed launcher on multiple ranks.
+"""
+import os
+import torch
+import torch.distributed as dist
+import argparse
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--local_rank", type=int, default=0)
+    args = parser.parse_args()
+    # Init process group - expects env vars set by launcher
+    dist.init_process_group(backend="nccl", init_method="env://")
+    rank = dist.get_rank()
+    world = dist.get_world_size()
+    torch.cuda.set_device(args.local_rank)
+    t = torch.ones(1024, device="cuda") * (rank + 1)
+    dist.all_reduce(t)
+    s = t.sum().item()
+    print(f"Rank {rank}/{world} reduced sum sample: {s}")
+    dist.destroy_process_group()
+
+if __name__ == "__main__":
+    main()
