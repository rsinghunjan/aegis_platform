+/*
+Provision production-grade AWS KMS (cosign) and Rekor HA on ECS (Fargate) behind an ALB.
+Customize VPC/subnets/security to your environment. This is an opinionated scaffold — adapt for scale/regions/infra.
+*/
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = ">= 4.0" }
+  }
+}
+provider "aws" { region = var.aws_region }
+
+variable "aws_region" { default = "us-west-2" }
+variable "rekor_image" { default = "gcr.io/rekor-project/rekor-server:latest" }
+variable "rekor_s3_bucket" { description = "S3 bucket for Rekor storage" }
+
+data "aws_vpc" "default" { default = true }
+data "aws_subnet_ids" "private" { vpc_id = data.aws_vpc.default.id }
+
+resource "aws_kms_key" "cosign_prod" {
+  description             = "Aegis production cosign KMS key"
+  enable_key_rotation     = true
+  deletion_window_in_days = 30
+}
+resource "aws_kms_alias" "cosign_prod_alias" {
+  name          = "alias/aegis-cosign-prod"
+  target_key_id = aws_kms_key.cosign_prod.key_id
+}
+
+resource "aws_iam_role" "rekor_task_exec" {
+  name = "aegis-rekor-task-exec"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{ Effect = "Allow", Principal = { Service = "ecs-tasks.amazonaws.com" }, Action = "sts:AssumeRole" }]
+  })
+}
+resource "aws_iam_role_policy_attachment" "rekor_task_exec_policy" {
+  role       = aws_iam_role.rekor_task_exec.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+# S3 bucket must exist (provide or provision). Rekor stores objects and uses an index; for high scale use RDS + object store per Rekor docs.
+resource "aws_ecs_cluster" "rekor" { name = "aegis-rekor-cluster" }
+
+resource "aws_security_group" "rekor_alb_sg" {
+  name   = "rekor-alb-sg"
+  vpc_id = data.aws_vpc.default.id
+  ingress { from_port = 80; to_port = 80; protocol = "tcp"; cidr_blocks = ["0.0.0.0/0"] }
+  egress { from_port = 0; to_port = 0; protocol = "-1"; cidr_blocks = ["0.0.0.0/0"] }
+}
+
+# Minimal task definition for Rekor (Fargate)
+resource "aws_ecs_task_definition" "rekor" {
+  family                   = "aegis-rekor-task"
+  requires_compatibilities = ["FARGATE"]
+  cpu                      = "1024"
+  memory                   = "2048"
+  network_mode             = "awsvpc"
+  execution_role_arn       = aws_iam_role.rekor_task_exec.arn
+  container_definitions = jsonencode([{
+    name = "rekor"
+    image = var.rekor_image
+    essential = true
+    portMappings = [{ containerPort = 3000 }]
+    environment = [
+      { name = "REKOR_STORAGE_TYPE", value = "s3" },
+      { name = "REKOR_S3_BUCKET", value = var.rekor_s3_bucket }
+    ]
+  }])
+}
+
+resource "aws_ecs_service" "rekor_service" {
+  name            = "aegis-rekor"
+  cluster         = aws_ecs_cluster.rekor.id
+  task_definition = aws_ecs_task_definition.rekor.arn
+  desired_count   = 2
+  launch_type     = "FARGATE"
+  network_configuration {
+    subnets = data.aws_subnet_ids.private.ids
+    security_groups = [aws_security_group.rekor_alb_sg.id]
+  }
+  deployment_minimum_healthy_percent = 50
+  deployment_maximum_percent = 200
+}
+
+output "cosign_kms_arn" { value = aws_kms_key.cosign_prod.arn }
+output "rekor_endpoint" { value = aws_ecs_service.rekor_service.name }
+
