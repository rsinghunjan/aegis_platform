+#!/usr/bin/env python3
+"""
+Collect evidence for auditors:
+- Collect Rekor entries, cosign signatures, MLflow run artifacts, approver DB extracts
+Produces a zip artifact for upload to compliance trackers.
+"""
+import os, json, shutil, subprocess, tempfile
+tmp = tempfile.mkdtemp()
+outzip = "evidence_bundle_enhanced.zip"
+
+def fetch_rekor(artifact_path, rekor_server, outdir):
+    sha = subprocess.check_output(["sha256sum", artifact_path]).decode().split()[0]
+    try:
+        subprocess.check_call(["rekor-cli","search","--rekor_server", rekor_server, "--sha", sha, "--output", os.path.join(outdir, "rekor_entry.json")])
+    except Exception:
+        pass
+
+if __name__ == "__main__":
+    rekor = os.environ.get("REKOR_SERVER")
+    artifacts = ["artifacts/candidate.plan", "artifacts/candidate.plan.sig"]
+    for a in artifacts:
+        if os.path.exists(a):
+            shutil.copy(a, tmp)
+            if rekor:
+                fetch_rekor(a, rekor, tmp)
+    # Approver DB extract (requires DB creds env)
+    try:
+        subprocess.check_call(["pg_dump","-t","approvals","-f",os.path.join(tmp,"approver_approvals.sql")])
+    except Exception:
+        pass
+    shutil.make_archive("evidence_bundle_enhanced","zip",tmp)
+    print("Wrote", outzip)
+
