+#!/usr/bin/env bash
+set -euo pipefail
+ARTIFACT="$1"
+REKOR_SERVER="${REKOR_SERVER:-$REKOR_SERVER}"
+if [ -z "$ARTIFACT" ] || [ ! -f "$ARTIFACT" ]; then
+  echo "Usage: $0 <artifact-path>"
+  exit 2
+fi
+if [ -z "$REKOR_SERVER" ]; then
+  echo "REKOR_SERVER env missing; set to https://rekor.example"
+  exit 3
+fi
+SHA=$(sha256sum "$ARTIFACT" | awk '{print $1}')
+echo "Checking Rekor for artifact sha256=$SHA"
+if command -v rekor-cli >/dev/null 2>&1; then
+  rekor-cli search --rekor_server "$REKOR_SERVER" --sha "$SHA" >/dev/null || { echo "No Rekor entry found"; exit 4; }
+else
+  # fallback HTTP attempt (may require adaptation)
+  RES=$(curl -sS -X POST "$REKOR_SERVER/api/v1/log/entries/retrieve" -H "Content-Type: application/json" -d "{\"hash\":\"$SHA\"}" || true)
+  if [ -z "$RES" ] || ! echo "$RES" | grep -q "$SHA"; then
+    echo "No Rekor entry found (HTTP fallback)"
+    exit 4
+  fi
+fi
+echo "Rekor entry found"
+
