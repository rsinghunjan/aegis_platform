+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to verify artifact cosign signature and Rekor entry; exit non-zero to block promotion
+ARTIFACT="$1"   # path to local file or s3:// URL
+COSIGN_KEY="${COSIGN_KMS_URI:-}"
+REKOR_SERVER="${REKOR_SERVER:-}"
+
+if [[ "$ARTIFACT" == s3://* ]]; then
+  TMP="/tmp/ci_artifact_$(date +%s).tar.gz"
+  aws s3 cp "$ARTIFACT" "$TMP"
+  ARTIFACT="$TMP"
+fi
+
+if command -v cosign >/dev/null 2>&1; then
+  if [ -n "$COSIGN_KEY" ]; then
+    cosign verify --key "$COSIGN_KEY" "$ARTIFACT"
+  else
+    cosign verify "$ARTIFACT"
+  fi
+else
+  echo "cosign missing; cannot verify signature. Blocking by default."
+  exit 2
+fi
+
+if command -v rekor-cli >/dev/null 2>&1 && [ -n "$REKOR_SERVER" ]; then
+  DIG=$(sha256sum "$ARTIFACT" | awk '{print $1}')
+  if ! rekor-cli search --sha "$DIG" --server "$REKOR_SERVER" >/dev/null 2>&1; then
+    echo "No Rekor entry found for digest $DIG; blocking"
+    exit 3
+  fi
+else
+  echo "rekor-cli not available or REKOR_SERVER not set; skipping Rekor check (CI should set REKOR_SERVER and install rekor-cli)"
+fi
+
+echo "cosign + rekor checks passed"
+
