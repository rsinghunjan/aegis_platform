+#!/usr/bin/env python3
+"""
+Spot pool & autoscaler tuner
+ - Suggests spot pool sizes and HPA/KEDA thresholds based on sample job profiles
+ - Outputs suggested YAML snippets you can apply to your cluster
+"""
+import argparse, json
+def suggest(num_workers, avg_gpu_hours_per_job, desired_backlog=10):
+    # crude heuristics: target concurrency = desired_backlog
+    suggested_pool = max(1, int((avg_gpu_hours_per_job * desired_backlog) / 1.0))
+    return {"suggested_spot_pool_size": suggested_pool, "hpa_min": 1, "hpa_max": max(2, suggested_pool)}
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--avg-gpu-hours", type=float, default=2.0)
+    p.add_argument("--desired-backlog", type=int, default=10)
+    args = p.parse_args()
+    print(json.dumps(suggest(None, args.avg_gpu_hours, args.desired_backlog), indent=2))
+
