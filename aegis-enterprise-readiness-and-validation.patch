+#!/usr/bin/env bash
+#
+# Daemon to sample GPU power via nvidia-smi and push metrics to Pushgateway
+PUSHGATEWAY=${PUSHGATEWAY:-http://pushgateway.aegis.svc:9091}
+INTERVAL=${INTERVAL:-10}
+JOB_LABEL=${JOB_LABEL:-node_gpu_power}
+
+while true; do
+  if command -v nvidia-smi >/dev/null 2>&1; then
+    PWR=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits | head -n 1)
+    # push to pushgateway
+    cat <<EOF | curl --data-binary @- "${PUSHGATEWAY}/metrics/job/${JOB_LABEL}"
+# TYPE aegis_node_gpu_power_w gauge
+aegis_node_gpu_power_w ${PWR}
+EOF
+  fi
+  sleep ${INTERVAL}
+done
