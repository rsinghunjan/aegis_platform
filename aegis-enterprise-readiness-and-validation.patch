+#!/usr/bin/env python3
+"""
+Hallucination detector placeholder:
+ - Accepts model output and retrieved docs
+ - Computes simple heuristics and returns a hallucination score (0..1)
+ - Intended to be integrated into CI and production quality gates
+"""
+import argparse, json, re
+
+def heuristic_score(output, docs):
+    # crude heuristic: fraction of sentences not containing any tokens from docs
+    sents = re.split(r'(?<=[.!?])\s+', output)
+    if not sents:
+        return 0.0
+    hits = 0
+    for s in sents:
+        for d in docs:
+            if s[:20].strip().lower() in d.lower():
+                hits += 1
+                break
+    return 1.0 - (hits / len(sents))
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--output", required=True)
+    p.add_argument("--docs", required=False)
+    args = p.parse_args()
+    out = open(args.output).read()
+    docs=[]
+    if args.docs:
+        docs = open(args.docs).read().splitlines()
+    score = heuristic_score(out, docs)
+    print(json.dumps({"hallucination_score": score}))
+    # exit non-zero if fail threshold (for CI gates)
+    if score > 0.5:
+        print("High hallucination detected; failing")
+        exit(2)
+
