+#!/usr/bin/env bash
+set -euo pipefail
+#
+# CI helper: Fail the CI promotion if an artifact lacks a Rekor entry.
+# Usage: rekor_fail_if_missing.sh <artifact-path>
+#
+ARTIFACT="${1:-}"
+REKOR_SERVER="${REKOR_SERVER:-${REKOR_SERVER:-}}"
+
+if [ -z "$ARTIFACT" ] || [ ! -f "$ARTIFACT" ]; then
+  echo "Artifact missing: $ARTIFACT" >&2
+  exit 2
+fi
+if [ -z "$REKOR_SERVER" ]; then
+  echo "REKOR_SERVER must be set in CI (example: https://rekor.example.com)" >&2
+  exit 3
+fi
+
+SHA=$(sha256sum "$ARTIFACT" | awk '{print $1}')
+echo "Checking Rekor for artifact sha256=$SHA on $REKOR_SERVER"
+
+if command -v rekor-cli >/dev/null 2>&1; then
+  if ! rekor-cli search --rekor_server "$REKOR_SERVER" --sha "$SHA" >/dev/null 2>&1; then
+    echo "No Rekor entry found for $ARTIFACT (sha256=$SHA)" >&2
+    exit 4
+  fi
+else
+  # Best-effort HTTP search; adapt to Rekor deployment's API shape.
+  RES=$(curl -sS --fail -X POST "${REKOR_SERVER%/}/api/v1/log/entries/retrieve" -H "Content-Type: application/json" -d "{\"hash\":\"$SHA\"}" || true)
+  if [ -z "$RES" ] || ! echo "$RES" | grep -q "$SHA"; then
+    echo "No Rekor entry found (HTTP search) for $ARTIFACT" >&2
+    exit 5
+  fi
+fi
+
+echo "Rekor entry found for $ARTIFACT"
+exit 0
+
