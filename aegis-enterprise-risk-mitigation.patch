+#!/usr/bin/env python3
+"""
+Monitor that checks Vault policies, last-secret-rotation markers and KMS key status.
+Should be run as a CronJob or Prometheus exporter to alert on stale rotations or disabled KMS keys.
+"""
+import os, subprocess, json, time
+
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "http://127.0.0.1:8200")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")
+COSIGN_KMS_ARN = os.environ.get("COSIGN_KMS_ARN", "")
+STALE_SECONDS = int(os.environ.get("STALE_SECONDS", 86400 * 7))  # 7 days
+
+def check_kms(key_arn):
+    if not key_arn:
+        return {"ok": False, "reason": "no_kms_arn"}
+    try:
+        out = subprocess.check_output(["aws","kms","describe-key","--key-id", key_arn])
+        info = json.loads(out)
+        state = info["KeyMetadata"]["KeyState"]
+        return {"ok": state == "Enabled", "state": state}
+    except Exception as e:
+        return {"ok": False, "reason": str(e)}
+
+def check_vault_rotation_marker(path="/secret/data/rotation/last"):
+    # This expects a key that CI or rotation job updates with timestamp
+    try:
+        out = subprocess.check_output(["vault","kv","get","-format=json", path])
+        obj = json.loads(out)
+        ts = int(obj["data"]["data"].get("ts", 0))
+        age = int(time.time()) - ts
+        return {"ok": age < STALE_SECONDS, "age": age}
+    except Exception as e:
+        return {"ok": False, "reason": str(e)}
+
+if __name__ == "__main__":
+    res_kms = check_kms(COSIGN_KMS_ARN)
+    res_vault = check_vault_rotation_marker()
+    out = {"kms": res_kms, "vault_rotation": res_vault, "ts": int(time.time())}
+    print(json.dumps(out, indent=2))
+    # Exit non-zero if problems detected (to be picked up by CronJob / alert)
+    if not res_kms.get("ok") or not res_vault.get("ok"):
+        raise SystemExit(1)
+
