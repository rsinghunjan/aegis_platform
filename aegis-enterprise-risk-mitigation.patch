+#!/usr/bin/env bash
+set -euo pipefail
+NS="${1:-aegis-system}"
+DEPLOY="${2:-jailed-executor}"
+
+echo "1) Check runtimeClass and securityContext"
+kubectl get deploy -n "$NS" "$DEPLOY" -o json | jq '.spec.template.spec.runtimeClassName, .spec.template.spec.containers[].securityContext'
+
+echo "2) Attempt to write to host (should fail)"
+kubectl exec -n "$NS" deploy/$DEPLOY -- sh -c "touch /host_escape_test 2>/dev/null || echo 'write_blocked'"
+
+echo "3) Check capabilities & /proc/self/status"
+kubectl exec -n "$NS" deploy/$DEPLOY -- sh -c "grep CapEff /proc/self/status || true"
+
+echo "4) Check for seccomp profile enforcement"
+kubectl exec -n "$NS" deploy/$DEPLOY -- sh -c "cat /proc/1/seccomp || true"
+
+echo "5) Run Falco container escape detection sample (requires Falco installed)"
+echo "   (Check Falco rules and alerts for suspicious syscalls)"
+
+echo "6) Run image CVE scan using trivy (if available)"
+if command -v trivy >/dev/null 2>&1; then
+  img=$(kubectl get deploy -n "$NS" "$DEPLOY" -o jsonpath='{.spec.template.spec.containers[0].image}')
+  echo "Scanning image $img"
+  trivy image --severity HIGH,CRITICAL --exit-code 0 "$img" || echo "trivy scan finished"
+fi
+
+echo "7) Run network egress test to ensure only allowed endpoints reachable"
+kubectl exec -n "$NS" deploy/$DEPLOY -- sh -c "curl -sS -m 5 http://approver.aegis-system.svc.cluster.local:8081/ || echo approver_unreachable"
+
+echo "Advanced pentest script completed (non-intrusive checks). Engage 3rd-party penetration test for aggressive testing."
