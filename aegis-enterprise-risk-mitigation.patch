+#!/usr/bin/env python3
+"""
+Wrap OPA quota check for QPU submissions and emit Prometheus metrics for chargeback.
+Call from qpu_queue_service before inserting job.
+"""
+import os, requests, json
+from prometheus_client import Gauge, start_http_server
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa.aegis-system.svc.cluster.local:8181/v1/data/aegis/qpu/quota/allow_submit")
+FINANCE_API = os.environ.get("FINANCE_API", "")
+
+GAUGE_TEAM_COST = Gauge("aegis_qpu_team_est_cost_check", "Estimated cost per team check", ["team"])
+
+def check_quota(team, est_cost):
+    payload = {"input": {"team": team, "est_cost": est_cost}}
+    r = requests.post(OPA_URL, json=payload, timeout=5)
+    if r.status_code != 200:
+        raise RuntimeError("OPA error")
+    allowed = r.json().get("result", False)
+    GAUGE_TEAM_COST.labels(team=team).set(est_cost)
+    return allowed
+
+def push_chargeback_item(team, est_cost):
+    if not FINANCE_API:
+        return False
+    payload = {"team": team, "est_cost_usd": est_cost}
+    try:
+        r = requests.post(FINANCE_API, json=payload, timeout=10)
+        return r.status_code == 200
+    except Exception:
+        return False
+
+if __name__ == "__main__":
+    start_http_server(9425)
+    print("OPA quota integration exporter running on :9425")
+    # example loop: in production qpu_queue_service calls check_quota() per submission
+    import time
+    while True:
+        time.sleep(60)
+
