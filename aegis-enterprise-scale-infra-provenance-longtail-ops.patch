+#!/usr/bin/env python3
+"""
+Forward critical platform incidents to PagerDuty and SIEM.
+ - Accepts a JSON alert on stdin or as a file, posts an event to PagerDuty Events API v2,
+   and writes the event to a SIEM sink (syslog/HTTP).
+ - Requires PAGEDUTY_ROUTING_KEY env var for PD integration.
+"""
+import argparse, json, os, requests, sys
+
+PD_KEY = os.environ.get("PAGERDUTY_ROUTING_KEY","")
+SIEM_URL = os.environ.get("SIEM_URL","")
+
+def pd_event(summary, source="aegis", severity="critical", details=None):
+    if not PD_KEY:
+        print("PagerDuty key not configured; skipping PD")
+        return
+    payload = {
+      "routing_key": PD_KEY,
+      "event_action": "trigger",
+      "payload": {
+        "summary": summary,
+        "source": source,
+        "severity": severity,
+        "custom_details": details or {}
+      }
+    }
+    r = requests.post("https://events.pagerduty.com/v2/enqueue", json=payload, timeout=10)
+    print("PagerDuty response:", r.status_code, r.text)
+
+def siem_forward(alert):
+    if not SIEM_URL:
+        print("SIEM_URL not configured; skipping SIEM forward")
+        return
+    try:
+        requests.post(SIEM_URL, json=alert, timeout=5)
+    except Exception as e:
+        print("SIEM forward failed:", e)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--file", default="")
+    args = p.parse_args()
+    if args.file:
+        alert = json.load(open(args.file))
+    else:
+        alert = json.load(sys.stdin)
+    summary = alert.get("summary","Aegis critical alert")
+    pd_event(summary, details=alert)
+    siem_forward(alert)
+    print("Forwarded alert to PD & SIEM (best-effort)")
+
