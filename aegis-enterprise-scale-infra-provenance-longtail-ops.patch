+#!/usr/bin/env python3
+"""
+Map Aegis run artifacts and internal telemetry to Prometheus metric labels and push metrics to a Pushgateway.
+ - Example: push total PoA duration and per-stage durations after PoA completes.
+"""
+import argparse, json, os, requests, time
+
+PUSHGATEWAY = os.environ.get("PUSHGATEWAY","http://pushgateway:9091")
+
+def push_metric(job, metric, value, labels=None):
+    labels = labels or {}
+    label_str = "".join([f'{k}="{v}",' for k,v in labels.items()])[:-1] if labels else ""
+    payload = f"# TYPE {metric} gauge\n{metric}{{{label_str}}} {value}\n"
+    url = f"{PUSHGATEWAY}/metrics/job/{job}"
+    requests.post(url, data=payload, timeout=5)
+
+def emit_from_pofa(report_path, job="aegis_pofa"):
+    r = json.load(open(report_path))
+    total = r.get("total_duration_s",0)
+    push_metric(job, "aegis_pofa_total_duration_seconds", total)
+    for s in r.get("stages", []):
+        push_metric(job, "aegis_pofa_stage_duration_seconds", s.get("duration_s",0), labels={"stage": s.get("stage","")})
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--pofa", required=True)
+    args = p.parse_args()
+    emit_from_pofa(args.pofa)
+    print("Pushed PoA metrics to Pushgateway (best-effort)")
+
