+#!/usr/bin/env python3
+"""
+Detect failed HIL/formal runs and create remediation tickets (GitHub Issue or JIRA).
+ - Placeholder: operator must configure authentication tokens and repo/project mapping.
+ - For GitHub: set GITHUB_TOKEN environment variable and REPO env var (owner/repo).
+"""
+import argparse, json, os, requests
+
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN","")
+REPO = os.environ.get("GITHUB_REPO","")
+
+def create_github_issue(title, body, labels=None):
+    if not GITHUB_TOKEN or not REPO:
+        print("GitHub token or repo not configured; skipping issue creation")
+        return None
+    url = f"https://api.github.com/repos/{REPO}/issues"
+    headers = {"Authorization": f"token {GITHUB_TOKEN}", "Accept":"application/vnd.github.v3+json"}
+    payload = {"title": title, "body": body, "labels": labels or ["remediation","aegis"]}
+    r = requests.post(url, json=payload, headers=headers, timeout=10)
+    if r.status_code in (200,201):
+        print("Created issue:", r.json().get("html_url"))
+        return r.json().get("html_url")
+    else:
+        print("Issue creation failed:", r.status_code, r.text)
+        return None
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--summary", required=True)
+    p.add_argument("--details", default="")
+    args = p.parse_args()
+    title = f"[Aegis Remediation] {args.summary}"
+    body = args.details
+    create_github_issue(title, body)
