+#!/usr/bin/env python3
+"""
+Federated server (round controller) - lightweight REST API for demonstration.
+Endpoints:
+ - POST /register  { "client_id": "...", "meta": {...}, "consent": {...} }
+ - GET  /round     -> returns current round metadata and model URL or encoded model bytes
+ - POST /submit    { "client_id": "...", "round": N, "update_bundle": <path or base64>, "signature_meta": {...} }
+ - POST /aggregate -> trigger aggregation (admin)
+ - GET  /status    -> server health & metrics
+
+State is kept in Redis; artifacts stored on disk / PVC; evidence bundling uses ops/adk/sdk/evidence.bundle_evidence
+"""
+import os, json, time, uuid, base64, tempfile, subprocess
+from flask import Flask, request, jsonify
+import redis
+from typing import List
+from ops.adk.sdk.evidence import bundle_evidence
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+r = redis.from_url(REDIS_URL)
+
+MODEL_STORE = os.environ.get("FL_MODEL_STORE", "/data/fl_models")
+os.makedirs(MODEL_STORE, exist_ok=True)
+
+CURRENT_ROUND_KEY = "fl:current_round"
+CLIENT_SET_KEY = "fl:clients"
+UPDATES_PREFIX = "fl:updates:"   # fl:updates:<round> -> list
+
+app = Flask(__name__)
+
+def get_current_round():
+    v = r.get(CURRENT_ROUND_KEY)
+    return int(v) if v else 0
+
+def increment_round():
+    return r.incr(CURRENT_ROUND_KEY)
+
+def save_model(round_num, model_bytes):
+    path = os.path.join(MODEL_STORE, f"global_round_{round_num}.bin")
+    with open(path, "wb") as fh:
+        fh.write(model_bytes)
+    return path
+
+def list_updates(round_num):
+    return r.lrange(f"{UPDATES_PREFIX}{round_num}", 0, -1)
+
+@app.route("/register", methods=["POST"])
+def register():
+    body = request.json
+    cid = body.get("client_id") or str(uuid.uuid4())
+    meta = body.get("meta", {})
+    consent = body.get("consent", {})
+    r.hset(f"client:{cid}", mapping={"meta": json.dumps(meta), "consent": json.dumps(consent)})
+    r.sadd(CLIENT_SET_KEY, cid)
+    return jsonify({"client_id": cid})
+
+@app.route("/round", methods=["GET"])
+def get_round():
+    round_num = get_current_round()
+    # Return model bytes base64 for demo; in prod use object storage URL with signed access
+    model_path = os.path.join(MODEL_STORE, f"global_round_{round_num}.bin")
+    if os.path.exists(model_path):
+        b = open(model_path, "rb").read()
+        mb64 = base64.b64encode(b).decode()
+        return jsonify({"round": round_num, "model_b64": mb64})
+    else:
+        return jsonify({"round": round_num, "model_b64": None})
+
+@app.route("/submit", methods=["POST"])
+def submit_update():
+    # Accept JSON or multipart; expect base64-encoded update bundle for this scaffold
+    body = request.json
+    cid = body.get("client_id")
+    round_num = int(body.get("round", -1))
+    bundle_b64 = body.get("update_bundle_b64")
+    signature_meta = body.get("signature_meta", {})
+    if not cid or bundle_b64 is None:
+        return jsonify({"error": "client_id and update_bundle_b64 required"}), 400
+    # save bundle
+    data = base64.b64decode(bundle_b64)
+    tmp = tempfile.mkdtemp(prefix="fl_update_")
+    bundle_path = os.path.join(tmp, f"{cid}_r{round_num}.tar.gz")
+    with open(bundle_path, "wb") as fh:
+        fh.write(data)
+    # store reference in Redis
+    r.rpush(f"{UPDATES_PREFIX}{round_num}", bundle_path)
+    # increment participation metric
+    r.incr("metrics:fl:participation_total")
+    return jsonify({"ok": True, "path": bundle_path})
+
+@app.route("/aggregate", methods=["POST"])
+def aggregate():
+    # admin trigger to aggregate current round using chosen algorithm
+    body = request.json or {}
+    alg = body.get("algorithm", "fedavg")
+    round_num = get_current_round()
+    updates = list_updates(round_num)
+    if not updates:
+        return jsonify({"error": "no updates"}), 400
+    # For demo: treats each update bundle as a JSON containing {"weights": [..]} and averages them
+    weight_lists = []
+    participant_ids = []
+    for p in updates:
+        try:
+            # try to extract a JSON file from bundle, fallback
+            import tarfile, glob
+            with tarfile.open(p, "r:gz") as tar:
+                members = tar.getmembers()
+                for m in members:
+                    if m.name.endswith("update.json"):
+                        f = tar.extractfile(m)
+                        j = json.load(f)
+                        weight_lists.append(j.get("weights", []))
+                        participant_ids.append(j.get("client_id"))
+                        break
+        except Exception as e:
+            print("Failed to read update bundle", p, e)
+    if not weight_lists:
+        return jsonify({"error": "no parseable updates"}), 400
+    # aggregate
+    if alg == "fedavg":
+        # simple element-wise average
+        import numpy as np
+        arrs = [np.array(w, dtype=float) for w in weight_lists]
+        mean = np.mean(arrs, axis=0)
+        model_bytes = json.dumps({"weights": mean.tolist()}).encode()
+    elif alg == "median":
+        import numpy as np
+        arrs = [np.array(w, dtype=float) for w in weight_lists]
+        median = np.median(arrs, axis=0)
+        model_bytes = json.dumps({"weights": median.tolist()}).encode()
+    elif alg == "krum":
+        # placeholder for robust aggregation
+        import numpy as np
+        arrs = [np.array(w, dtype=float) for w in weight_lists]
+        mean = np.mean(arrs, axis=0)
+        model_bytes = json.dumps({"weights": mean.tolist()}).encode()
+    else:
+        return jsonify({"error": "unknown algorithm"}), 400
+    new_round = increment_round()
+    model_path = save_model(new_round, model_bytes)
+    # create evidence bundle of participants and aggregated model
+    evidence_files = list(updates) + [model_path]
+    outbundle = os.path.join(MODEL_STORE, f"round_{new_round}_evidence.tar.gz")
+    bundle_evidence(evidence_files, outbundle, metadata={"round": new_round, "participants": participant_ids})
+    # clear updates list for round
+    r.delete(f"{UPDATES_PREFIX}{round_num}")
+    # metrics
+    r.set("metrics:fl:last_aggregate_round", new_round)
+    r.set("metrics:fl:last_aggregate_participants", len(participant_ids))
+    return jsonify({"ok": True, "round": new_round, "model_path": model_path, "evidence_bundle": outbundle})
+
+@app.route("/status", methods=["GET"])
+def status():
+    return jsonify({"round": get_current_round(), "clients": r.scard(CLIENT_SET_KEY), "metrics": {
+        "participation_total": int(r.get("metrics:fl:participation_total") or 0)
+    }})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 5005)))
+
