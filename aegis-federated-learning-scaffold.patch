+#!/usr/bin/env python3
+"""
+Federated client SDK (lightweight)
+ - Register with server
+ - Pull model for current round
+ - Run local training loop (placeholder) to produce update.json
+ - Bundle update and sign it (uses ops/adk/sdk/evidence.bundle_evidence for bundling + cosign in CI)
+ - Upload update bundle to server
+
+This is intended to run on edge devices or in siloed servers as a process.
+"""
+import os, sys, time, json, base64, tempfile, tarfile, subprocess
+import requests
+from typing import Dict
+
+SERVER_URL = os.environ.get("FL_SERVER_URL", "http://fl-server.aegis-app:5005")
+CLIENT_ID = os.environ.get("FL_CLIENT_ID", "")
+MODEL_DIR = os.environ.get("FL_LOCAL_MODEL_DIR", "/tmp/fl_local")
+os.makedirs(MODEL_DIR, exist_ok=True)
+
+def register(client_id=None, meta=None, consent=None):
+    payload = {"client_id": client_id, "meta": meta or {}, "consent": consent or {}}
+    r = requests.post(f"{SERVER_URL}/register", json=payload, timeout=10)
+    return r.json()
+
+def get_round():
+    r = requests.get(f"{SERVER_URL}/round", timeout=10)
+    return r.json()
+
+def local_train_simulate(model_weights, epochs=1):
+    # simple simulated training: add small noise to weights
+    import numpy as np
+    w = np.array(model_weights, dtype=float) if model_weights else np.zeros(10)
+    for _ in range(epochs):
+        w = w + (np.random.randn(*w.shape) * 0.01)
+    return w.tolist()
+
+def bundle_update(client_id, round_num, updated_weights, out_dir=None):
+    out_dir = out_dir or tempfile.mkdtemp(prefix="fl_client_")
+    update = {"client_id": client_id, "round": round_num, "weights": updated_weights}
+    update_path = os.path.join(out_dir, "update.json")
+    with open(update_path, "w") as fh:
+        json.dump(update, fh)
+    bundle_path = os.path.join(out_dir, f"{client_id}_r{round_num}.tar.gz")
+    with tarfile.open(bundle_path, "w:gz") as tar:
+        tar.add(update_path, arcname="update.json")
+    return bundle_path
+
+def sign_bundle(bundle_path, cosign_key=None):
+    # For demonstration we call cosign to sign bundle if key available (CI/hardened builders should handle)
+    if cosign_key and shutil.which("cosign"):
+        subprocess.check_call(["cosign","sign","--key",cosign_key, bundle_path])
+
+def submit_update(client_id, round_num, bundle_path):
+    with open(bundle_path, "rb") as fh:
+        data = fh.read()
+    b64 = base64.b64encode(data).decode()
+    payload = {"client_id": client_id, "round": round_num, "update_bundle_b64": b64}
+    r = requests.post(f"{SERVER_URL}/submit", json=payload, timeout=30)
+    return r.json()
+
+def run_once(client_id, epochs=1):
+    # register if no client id
+    if not client_id:
+        reg = register()
+        client_id = reg["client_id"]
+    rinfo = get_round()
+    round_num = rinfo.get("round", 0)
+    model_b64 = rinfo.get("model_b64")
+    if model_b64:
+        model_bytes = base64.b64decode(model_b64)
+        # for demo expect JSON weights
+        try:
+            mj = json.loads(model_bytes.decode())
+            weights = mj.get("weights", [])
+        except Exception:
+            weights = []
+    else:
+        weights = [0.0] * 10
+    updated = local_train_simulate(weights, epochs=epochs)
+    bundle = bundle_update(client_id, round_num, updated)
+    res = submit_update(client_id, round_num, bundle)
+    print("Submitted update:", res)
+
+if __name__ == "__main__":
+    import argparse, shutil
+    p = argparse.ArgumentParser()
+    p.add_argument("--client-id", default=os.environ.get("FL_CLIENT_ID",""))
+    p.add_argument("--epochs", type=int, default=1)
+    p.add_argument("--run-once", action="store_true")
+    args = p.parse_args()
+    run_once(args.client_id, args.epochs)
+
