+    participants = r.get("metrics:fl:last_aggregate_participants") or 0
+    body = f"# TYPE aegis_fl_round gauge\naegis_fl_round {int(rounds)}\n# TYPE aegis_fl_last_participants gauge\naegis_fl_last_participants {int(participants)}\n"
+    requests.post(f"{PUSH}/metrics/job/aegis_fl", data=body, timeout=5)
+
+if __name__=="__main__":
+    while True:
