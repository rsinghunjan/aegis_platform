+#!/usr/bin/env bash
+#
+# Sign an FL update bundle with cosign (KMS) and optionally push Rekor entry
+# Usage: sign_update.sh /path/to/update_bundle.tar.gz
+set -euo pipefail
+BUNDLE=${1:-""}
+: "${COSIGN_KMS_URI:?Set COSIGN_KMS_URI}"
+: "${REKOR_SERVER:?Set REKOR_SERVER}"
+
+if [ -z "$BUNDLE" ]; then
+  echo "Usage: $0 bundle.tar.gz"
+  exit 2
+fi
+
+echo "Signing bundle with cosign key $COSIGN_KMS_URI"
+cosign sign --key "$COSIGN_KMS_URI" "$BUNDLE"
+echo "cosign sign done. Ensure Rekor is configured in CI to capture transparency log."
