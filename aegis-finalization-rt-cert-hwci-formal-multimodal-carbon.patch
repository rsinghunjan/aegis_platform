+#!/usr/bin/env python3
+"""
+Parse Apalache outputs and produce actionable counterexample reports.
+If counterexamples found, create a GitHub issue (requires gh CLI auth) and attach artifacts.
+"""
+import os, glob, json, subprocess, sys
+
+OUTDIR = "/tmp/apalache_report_" + str(os.getpid())
+os.makedirs(OUTDIR, exist_ok=True)
+
+def find_apalache_outputs(search_dir=".", pattern="*.apalache.out"):
+    return glob.glob(os.path.join(search_dir, "**", pattern), recursive=True)
+
+def summarize(path):
+    with open(path) as fh:
+        txt = fh.read()
+    # naive detection: look for 'ERROR' or 'counterexample'
+    issues = []
+    if "counterexample" in txt.lower() or "error" in txt.lower():
+        issues.append(txt[:4000])
+    return issues
+
+def main():
+    files = find_apalache_outputs(".")
+    report = {"files": [], "issues": []}
+    for f in files:
+        iss = summarize(f)
+        report["files"].append(f)
+        if iss:
+            report["issues"].append({"file": f, "snippet": iss})
+    rpt_path = os.path.join(OUTDIR, "apalache_summary.json")
+    with open(rpt_path, "w") as fh:
+        json.dump(report, fh, indent=2)
+    print("Apalache summary written to", rpt_path)
+    if report["issues"]:
+        try:
+            subprocess.call(["gh","issue","create","--title","Formal verification counterexamples","--body",f"Apalache discovered potential issues; summary attached: {rpt_path}"])
+        except Exception:
+            pass
+        sys.exit(4)
+    sys.exit(0)
+
+if __name__=="__main__":
+    main()
+
