+#!/usr/bin/env python3
+"""
+Upload periodic checkpoints to S3 (or other object store) and record MLflow artifact links.
+Designed to be called by long-running training loops after each epoch or every N minutes.
+"""
+import os, sys, boto3, time
+from datetime import datetime
+
+S3_PREFIX = os.environ.get("S3_CHECKPOINT_PREFIX", "s3://aegis-checkpoints")
+AWS_PROFILE = os.environ.get("AWS_PROFILE")
+
+def upload(local_path, prefix=None):
+    prefix = prefix or S3_PREFIX
+    # parse prefix (s3://bucket/path)
+    if not prefix.startswith("s3://"):
+        raise RuntimeError("Only s3 supported in this helper")
+    s = prefix[5:]
+    bucket, *rest = s.split("/", 1)
+    key_prefix = rest[0] if rest else ""
+    basename = os.path.basename(local_path)
+    key = key_prefix.rstrip("/") + "/" + basename
+    session = boto3.Session(profile_name=AWS_PROFILE) if AWS_PROFILE else boto3.Session()
+    s3 = session.client("s3")
+    s3.upload_file(local_path, bucket, key)
+    url = f"s3://{bucket}/{key}"
+    print("Uploaded checkpoint to", url)
+    return url
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("Usage: checkpoint_uploader.py <local_path> [s3_prefix]")
+        sys.exit(2)
+    path = sys.argv[1]
+    pref = sys.argv[2] if len(sys.argv) > 2 else None
+    url = upload(path, pref)
+    # record evidence
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("checkpoint_uploaded", {"local": path, "url": url, "time": time.time()})
+    except Exception:
+        pass
+
