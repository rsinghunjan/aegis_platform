+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Hardening steps for a self-hosted hardware CI runner (run as root on runner host)
+# - Create limited runner user, remove interactive logins, enable disk encryption (operator-provided), lock down network egress via firewall
+# - Install and configure GitHub Actions runner as a service with least-privilege
+#
+RUNNER_DIR=${1:-/opt/actions-runner}
+RUNNER_USER=${2:-aegis-runner}
+echo "Creating runner user ${RUNNER_USER}"
+useradd -m -s /usr/sbin/nologin "$RUNNER_USER" || true
+
+echo "Installing basic hardening packages"
+apt-get update && apt-get install -y fail2ban ufw auditd jq || true
+
+echo "Configure UFW: allow ssh from admin nets and required registries only (operator to customize)"
+ufw default deny incoming
+ufw default allow outgoing
+# operator should add rules e.g. ufw allow from 10.0.0.0/8 to any port 22
+ufw --force enable || true
+
+echo "Setup runner directory and permissions"
+mkdir -p "$RUNNER_DIR"
+chown "$RUNNER_USER":"$RUNNER_USER" "$RUNNER_DIR"
+
+echo "Install runner as that user (operator must download runner tar.gz into $RUNNER_DIR first)"
+if [ ! -f "$RUNNER_DIR/config.sh" ]; then
+  echo "Runner config.sh not found; operator must download GitHub runner package into $RUNNER_DIR and extract it"
+  exit 0
+fi
+
+echo "Ensure audit rules capture cosign use and docker usage"
+auditctl -w /usr/bin/cosign -p x -k cosign_exec || true
+auditctl -w /usr/bin/docker -p x -k docker_exec || true
+
+echo "Hardening complete. Operator must register runner with a short-lived token and restrict who can trigger hardware workflows."
+
