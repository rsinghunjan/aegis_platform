+#!/usr/bin/env python3
+"""
+Simple cost monitor for long-running training jobs.
+ - Reads estimated instance hourly cost (operator-provided), tracks run time and sends alert if predicted cost exceeds budget.
+ - Records MLflow metric & evidence.
+"""
+import time, json, os
+from datetime import datetime
+
+BUDGET = float(os.environ.get("TRAINING_BUDGET_USD", "1000.0"))
+PRICE_HOUR = float(os.environ.get("INSTANCE_PRICE_PER_HOUR", "5.0"))
+POLL = int(os.environ.get("COST_MONITOR_POLL_S", "60"))
+
+def record(evidence):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("training_cost_check", evidence)
+    except Exception:
+        pass
+
+def main():
+    start = time.time()
+    while True:
+        elapsed_hours = (time.time() - start) / 3600.0
+        est_cost = elapsed_hours * PRICE_HOUR
+        evidence = {"elapsed_h": elapsed_hours, "est_cost": est_cost, "time": datetime.utcnow().isoformat()+"Z"}
+        print("Cost monitor:", evidence)
+        record(evidence)
+        if est_cost > BUDGET:
+            print("BUDGET_EXCEEDED", est_cost, BUDGET)
+            # operator action required - emit evidence and exit non-zero so orchestration can pause
+            record({"alert":"budget_exceeded","est_cost":est_cost})
+            raise SystemExit(5)
+        time.sleep(POLL)
+
+if __name__=="__main__":
+    main()
+
