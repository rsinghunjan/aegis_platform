+"""
+Promotion gate that checks recent grid average carbon intensity and (optionally) per-job emissions against thresholds.
+Used in CI to block promotions when carbon intensity is high or emissions exceed configured budgets.
+"""
+import os, sys, time, requests, json
+from datetime import datetime, timedelta
+
+WATTTIME_API_KEY = os.environ.get("WATTTIME_API_KEY")
+REGION = os.environ.get("Aegis_CARBON_REGION", "US-CA")
+THRESHOLD = float(os.environ.get("Aegis_CARBON_PROMOTE_THRESHOLD_GCO2", "300"))
+
+def get_watt():
+    try:
+        from ops.carbon.watttime_client import get_latest_intensity
+        val = get_latest_intensity(REGION)
+        return val
+    except Exception:
+        return None
+
+def main():
+    val = get_watt()
+    print("Current carbon intensity:", val)
+    if val is None:
+        print("No carbon data; operator policy required (default: block promotion)")
+        sys.exit(2)
+    if val > THRESHOLD:
+        print(f"Carbon threshold exceeded: {val} > {THRESHOLD}. Blocking promotion.")
+        sys.exit(3)
+    print("Carbon check passed; allow promotion.")
+    sys.exit(0)
+
+if __name__=="__main__":
+    main()
