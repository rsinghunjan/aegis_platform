+#!/usr/bin/env python3
+"""
+Check p99 jitter and safe-stop latency artifacts against SLOs and produce an auditor-grade report.
+Reads p99 result JSON (/tmp/rt_jitter_result.json) and safe-stop JSON produced by safe_stop_tester.py.
+Outputs report JSON and records evidence via ops.sdk.evidence_sdk.
+"""
+import json, os, sys
+from datetime import datetime
+
+DEFAULTS = {
+    "p99_slo_ms": 0.2,
+    "safe_stop_slo_ms": 50.0
+}
+
+def load_json(path):
+    try:
+        with open(path) as fh:
+            return json.load(fh)
+    except Exception as e:
+        return None
+
+def check(p99, safe_stop, slo_p99=DEFAULTS["p99_slo_ms"], slo_safe=DEFAULTS["safe_stop_slo_ms"]):
+    res = {"checked_at": datetime.utcnow().isoformat() + "Z", "p99_ok": None, "safe_stop_ok": None, "p99_ms": None, "safe_stop_ms": None}
+    if p99:
+        res["p99_ms"] = p99.get("p99_ms", p99.get("p99_s", None) and p99.get("p99_s")*1000)
+        if res["p99_ms"] is not None:
+            res["p99_ok"] = res["p99_ms"] <= slo_p99
+    if safe_stop:
+        res["safe_stop_ms"] = safe_stop.get("latency_s") * 1000 if safe_stop.get("latency_s") is not None else None
+        if res["safe_stop_ms"] is not None:
+            res["safe_stop_ok"] = res["safe_stop_ms"] <= slo_safe
+    res["overall_ok"] = all([v is not False for v in [res["p99_ok"], res["safe_stop_ok"]]])
+    return res
+
+def main():
+    p99_path = os.environ.get("P99_PATH", "/tmp/rt_jitter_result.json")
+    safe_path = os.environ.get("SAFE_STOP_PATH", "/tmp/safe_stop.json")
+    out = os.environ.get("OUT_REPORT", "/tmp/rt_slo_report.json")
+    slo_p99 = float(os.environ.get("P99_SLO_MS", DEFAULTS["p99_slo_ms"]))
+    slo_safe = float(os.environ.get("SAFE_STOP_SLO_MS", DEFAULTS["safe_stop_slo_ms"]))
+
+    p99 = load_json(p99_path)
+    safe = load_json(safe_path)
+    report = check(p99, safe, slo_p99, slo_safe)
+    with open(out, "w") as fh:
+        json.dump({"p99": p99, "safe_stop": safe, "report": report}, fh, indent=2)
+    # record evidence if available
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("rt_slo_report", {"report": out, "summary": report})
+    except Exception:
+        pass
+    print("Wrote SLO report to", out)
+    if not report["overall_ok"]:
+        sys.exit(3)
+
+if __name__ == "__main__":
+    main()
+
