+#!/usr/bin/env bash
+#
+# Inject DP wrapper import & calls into an FL orchestrator source file.
+# This is a best-effort utility: it looks for marker comments in the file and injects code.
+# Usage:
+#   ./ops/ci/inject_dp_wrapper.sh /path/to/fl_orchestrator.py
+set -euo pipefail
+
+FILE=${1:-}
+if [ -z "$FILE" ]; then
+  echo "Usage: $0 /path/to/fl_orchestrator.py"
+  exit 2
+fi
+if [ ! -f "$FILE" ]; then
+  echo "File not found: $FILE"
+  exit 2
+fi
+
+BACKUP="${FILE}.bak.$(date +%s)"
+cp "$FILE" "$BACKUP"
+echo "Backed up original to $BACKUP"
+
+# Import injection
+IMPORT_SNIPPET=$'\
+try:\n\
+    from services.fl.fl_controller_dp_wrapper import check_and_start_round, report_round\n\
+except Exception:\n\
+    # Ensure import does not crash non-Python-importing contexts\n\
+    pass\n'
+
+# Prepend import near file top (after existing imports)
+awk -v ins="$IMPORT_SNIPPET" "\
+NR==1 {print; found=0} \
+{ if (!done && /^\\s*import |^\\s*from /) { print; found=1; next } \
+    if (found && !done) { print ins; done=1 } \
+    print \
+}" "$BACKUP" > "$FILE".tmp || true
+
+# If above awk didn't insert (e.g., file had no imports), prepend the snippet
+if ! grep -q "check_and_start_round" "$FILE".tmp; then
+  (echo "$IMPORT_SNIPPET"; cat "$BACKUP") > "$FILE".tmp
+fi
+
+mv "$FILE".tmp "$FILE"
+chmod +x "$FILE" || true
+echo "Injected DP wrapper import into $FILE"
+
+echo "Next: edit the orchestrator's main loop to call check_and_start_round(...) before rounds and report_round(...) after rounds."
+echo "Example (pseudo):"
+echo "  run_id = check_and_start_round(project, noise, sample_rate, steps)"
+echo "  ... perform round with run_id ..."
+echo "  report_round(project, run_id, epsilon)"
+
