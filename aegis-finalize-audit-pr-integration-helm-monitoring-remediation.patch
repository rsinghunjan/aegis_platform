+#!/usr/bin/env python3
+"""
+Generate a remediation backlog CSV from the scorecard runner output.
+Usage:
+  python3 ops/ci/generate_remediation_backlog.py > remediation_backlog.csv
+"""
+import json, subprocess, csv, os
+
+def run_scorecard():
+    out = subprocess.check_output(["python3","ops/ci/scorecard_runner.py"])
+    j = json.loads(out)
+    return j
+
+def map_issues(details):
+    rows = []
+    for d in details:
+        if not d["exists"]:
+            rows.append({
+                "component": d["name"],
+                "path": d["path"],
+                "priority": "P1" if d["weight"]>=6 else "P2",
+                "status": "open",
+                "owner": "infra"
+            })
+    return rows
+
+def main():
+    j = run_scorecard()
+    rows = map_issues(j["details"])
+    w = csv.DictWriter(open("remediation_backlog.csv","w"), fieldnames=["component","path","priority","status","owner"])
+    w.writeheader()
+    for r in rows:
+        w.writerow(r)
+    print("Wrote remediation_backlog.csv with", len(rows), "items")
+
+if __name__=="__main__":
+    main()
+
