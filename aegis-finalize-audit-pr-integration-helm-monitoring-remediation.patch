+#!/usr/bin/env bash
+#
+# Build a full auditor packet (tar.gz) with all evidence and a short briefing.
+# Produces:
+#  - /tmp/aegis_audit_packet_<ts>.tar.gz
+#  - /tmp/aegis_audit_briefing_<ts>.md
+# Optionally uploads to evidence bucket if EVIDENCE_BUCKET env var is set.
+set -euo pipefail
+
+OUTDIR=${1:-/tmp/aegis_audit_packet}
+TS=$(date +%s)
+OUT="${OUTDIR}_${TS}"
+mkdir -p "$OUT"
+
+# Collect artifacts (best-effort)
+cp /tmp/privacy_decision.md "$OUT/" 2>/dev/null || true
+cp /tmp/canary_manifest.json "$OUT/" 2>/dev/null || true
+cp /tmp/deploy_manifest.json "$OUT/" 2>/dev/null || true
+cp /tmp/kms_rotation_*.json "$OUT/" 2>/dev/null || true
+cp /tmp/dp_check_*.json "$OUT/" 2>/dev/null || true
+cp -r ops/secure_agg/production_mpc "$OUT/production_mpc" || true
+cp -r ops/evidence "$OUT/evidence_helpers" || true
+cp security/crypto_privacy_security_audit_request_template.md "$OUT/" 2>/dev/null || true
+
+# Build briefing
+BRIEF="/tmp/aegis_audit_briefing_${TS}.md"
+cat > "$BRIEF" <<MD
+# Aegis Audit Packet (auto-generated)
+
+Timestamp: $(date -u -Iseconds)
+
+Contents:
+- privacy_decision.md (if present)
+- canary_manifest.json (if present)
+- deploy_manifest.json (if present)
+- kms rotation manifests (if present)
+- DP check/report manifests (if present)
+- MPC PoC code & tests (ops/secure_agg/production_mpc)
+- Evidence helpers (ops/evidence)
+- Audit request template (security/)
+
+Notes for auditor:
+- Rekor server (if used): ${REKOR_SERVER:-<not set>}
+- Evidence S3 bucket (if configured): ${EVIDENCE_BUCKET:-<not set>}
+- Contact: security@your-org.example
+
+Usage:
+- Inspect the tar.gz produced alongside this briefing.
+- Verify Rekor entries and S3 artifacts match manifests included.
+
+MD
+
+cp "$BRIEF" "$OUT/briefing.md"
+
+tarball="${OUT}.tar.gz"
+tar -czf "$tarball" -C "$(dirname "$OUT")" "$(basename "$OUT")"
+echo "Built audit packet: $tarball"
+
+if [ -n "${EVIDENCE_BUCKET:-}" ]; then
+  echo "Uploading to s3://${EVIDENCE_BUCKET%/}/audit_packets/"
+  aws s3 cp "$tarball" "s3://${EVIDENCE_BUCKET%/}/audit_packets/$(basename $tarball)"
+  echo "Uploaded."
+fi
+
+echo "Briefing: $BRIEF"
+echo "Done."
+
