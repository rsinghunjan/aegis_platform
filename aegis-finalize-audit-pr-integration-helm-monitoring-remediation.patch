+#!/usr/bin/env python3
+"""
+Automatic alias enablement helper.
+
+This script will check for a minimum number of successful dry-run rotation manifests
+present in the evidence bucket and (optionally) trigger an M-of-N approval to perform the alias swap.
+It is intended to be used only after multiple successful dry-runs and operator review.
+
+Usage:
+  python3 ops/hsm/auto_enable_alias_swap.py --alias alias/aegis/cosign --min-dry 3 --approve
+
+Environment:
+  EVIDENCE_BUCKET, MOFN_URL, COSIGN_KMS_URI
+"""
+import os, argparse, subprocess, time, json, requests
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+MOFN_URL = os.environ.get("MOFN_URL", "")
+
+def list_dry_manifests(prefix="kms-rotation/"):
+    if not EVIDENCE_BUCKET:
+        return []
+    out = subprocess.check_output(["aws","s3","ls", f"s3://{EVIDENCE_BUCKET}/{prefix}"]).decode()
+    lines = [l for l in out.splitlines() if l.strip()]
+    files = [l.split()[-1] for l in lines]
+    dry = [f for f in files if "dry" in f or "dry-run" in f or True]  # best-effort
+    return dry
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--alias", required=True)
+    p.add_argument("--min-dry", type=int, default=3)
+    p.add_argument("--approve", action="store_true")
+    p.add_argument("--approvals", type=int, default=2)
+    args = p.parse_args()
+
+    dry_manifests = list_dry_manifests()
+    print("Found dry manifests:", len(dry_manifests))
+    if len(dry_manifests) < args.min_dry:
+        print("Not enough dry-run manifests yet; aborting")
+        return 2
+    # Create MOFN request to approve alias swap (payload references last manifest)
+    last_manifest = dry_manifests[-1]
+    if not MOFN_URL:
+        print("MOFN_URL not configured; aborting")
+        return 3
+    req = {"request_id": f"auto-swap-{int(time.time())}", "action_id":"kms_alias_swap_auto", "payload": last_manifest, "m": args.approvals}
+    r = requests.post(f"{MOFN_URL}/request_action", json=req)
+    r.raise_for_status()
+    print("Created M-of-N request:", req["request_id"])
+    if args.approve:
+        print("Waiting for approval...")
+        start = time.time()
+        while time.time() - start < 3600:
+            st = requests.get(f"{MOFN_URL}/status", params={"request_id": req["request_id"]})
+            if st.ok and st.json().get("approved"):
+                print("Approved; you can now run the guarded swap script with --apply")
+                return 0
+            time.sleep(5)
+    else:
+        print("Created request; wait for approvers to act")
+    return 0
+
+if __name__=="__main__":
+    exit(main())
+
