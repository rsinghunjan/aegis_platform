+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run carbon monitor tuning and optionally enable a one-time enforcement check.
+# Generates a suggested threshold file and supports creating an override artifact.
+#
+# Usage:
+#  ./tune_and_enforce.sh --duration 3600 --interval 60 --region US-CA --base 300 --out /tmp/carbon_tune.json --create-override owner@example.com /tmp/override.json
+
+DURATION=${DURATION:-3600}
+INTERVAL=${INTERVAL:-60}
+REGION=${REGION:-"US-CA"}
+BASE=${BASE:-300}
+OUT=${OUT:-/tmp/carbon_tune.json}
+CREATE_OVERRIDE=${CREATE_OVERRIDE:-""}
+COSIGN=${COSIGN_KMS_URI:-}
+
+python3 ops/carbon/monitor_tune.py --duration-s "$DURATION" --interval-s "$INTERVAL" --region "$REGION" --base-threshold "$BASE" --out "$OUT"
+echo "Tuning report written to $OUT"
+
+if [ -n "$CREATE_OVERRIDE" ]; then
+  # CREATE_OVERRIDE format: "<approver_email> <out_path>"
+  APPROVER=$(echo "$CREATE_OVERRIDE" | awk '{print $1}')
+  OVOUT=$(echo "$CREATE_OVERRIDE" | awk '{print $2}')
+  if [ -z "$APPROVER" ] || [ -z "$OVOUT" ]; then
+    echo "create-override requires: --create-override '<approver_email> <out_path>'"
+    exit 1
+  fi
+  echo "Creating override artifact signed by $APPROVER -> $OVOUT"
+  python3 ops/carbon/override_signer.py --approval-id "AUTO-OVR-$(date +%s)" --approved-by "$APPROVER" --scope "{\"manifests\":\"deploy.yaml\"}" --out "$OVOUT"
+  if [ -n "$COSIGN" ]; then
+    echo "Signing override artifact with COSIGN_KMS_URI"
+    cosign sign --key "$COSIGN" "$OVOUT" || true
+  fi
+  echo "Override artifact: $OVOUT"
+fi
+
+echo "To enforce the carbon gate once tuned, add Aegis_CARBON_PROMOTE_THRESHOLD_GCO2 to CI secrets and enable the enforcement workflow."
+
