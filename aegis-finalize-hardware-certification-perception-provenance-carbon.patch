+#!/usr/bin/env python3
+"""
+Perception Scale Orchestrator
+ - Submit many sim packs to Argo (or run locally), collect failures, push failing scenarios to HIL,
+   create adversarial dataset NDJSON, trigger retrain and validate ONNX on NPU runners.
+ - Designed to be long-running / batch; use --dry-run to validate parameters.
+
+Usage:
+  python3 scale_orchestrator.py --packs 50 --per-pack 200 --parallel 8 --out /tmp/scale_run --npu-runners "npu1,npu2" --cosign kms://...
+"""
+import argparse
+import os
+import subprocess
+import time
+import json
+from datetime import datetime
+
+def gen_pack(count, outpath):
+    subprocess.check_call(["python3","ops/av/sim_hil/carla_scenario_pack_generator.py","--count",str(count),"--out",outpath])
+
+def submit_pack_to_argo(pack):
+    # Best-effort: call `argo submit` if available
+    try:
+        subprocess.check_call(["argo","submit","ops/av/sim_hil/carla_to_hil_pipeline.yaml","--parameter","scenario_pack="+pack,"--wait"])
+        return True
+    except Exception as e:
+        print("argo submit failed:", e)
+        return False
+
+def collect_failures(base_dir, out_json):
+    failures=[]
+    for root,_,files in os.walk(base_dir):
+        for f in files:
+            if f.endswith(".fail") or f.endswith(".error") or f.endswith("failures.json"):
+                failures.append(os.path.join(root,f))
+    with open(out_json,"w") as fh:
+        json.dump({"collected_at": datetime.utcnow().isoformat()+"Z", "failures": failures}, fh, indent=2)
+    return out_json
+
+def push_to_hil(pack_dir, outdir):
+    try:
+        subprocess.check_call(["python3","ops/av/sim_hil/hil_adapter_stub.py","--pack",pack_dir,"--outdir",outdir])
+        return True
+    except Exception as e:
+        print("push_to_hil failed:", e)
+        return False
+
+def trigger_retrain(ndjson, npu_runners, cosign_key):
+    cmd = ["python3","ops/av/perception/scale/auto_retrain_pipeline.py","--dataset",ndjson,"--out","./retrain_out"]
+    if npu_runners:
+        cmd += ["--npu-runners", ",".join(npu_runners)]
+    if cosign_key:
+        cmd += ["--cosign-key", cosign_key]
+    return subprocess.call(cmd)
+
+def record_manifest_safe(key, meta):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest(key, meta)
+    except Exception:
+        pass
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--packs", type=int, default=10)
+    p.add_argument("--per-pack", type=int, default=100)
+    p.add_argument("--parallel", type=int, default=4)
+    p.add_argument("--out", default=f"/tmp/scale_run_{int(time.time())}")
+    p.add_argument("--npu-runners", default="")
+    p.add_argument("--cosign", default="")
+    p.add_argument("--dry-run", action="store_true")
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    packs=[]
+    for i in range(args.packs):
+        pack_path=os.path.join(args.out, f"pack_{i}.tar.gz")
+        if args.dry_run:
+            print("DRY: generate", pack_path)
+        else:
+            gen_pack(args.per_pack, pack_path)
+        packs.append(pack_path)
+    results=[]
+    for pck in packs:
+        ok = submit_pack_to_argo(pck) if not args.dry_run else False
+        results.append({"pack": pck, "submitted": ok})
+        time.sleep(0.2)
+    results_path = os.path.join(args.out, "submission_results.json")
+    with open(results_path,"w") as fh:
+        json.dump(results, fh, indent=2)
+    failures_json = os.path.join(args.out, "failures.json")
+    collect_failures(args.out, failures_json)
+    # push failing packs to HIL for reproduction
+    hil_in = os.path.join(args.out, "hil_in")
+    push_to_hil(args.out, hil_in)
+    # build adv dataset and retrain
+    adv_ndjson = os.path.join(args.out,"adv_dataset"," " ,"adv_data.ndjson")
+    # attempt to locate adv_data.ndjson created by other steps
+    for root,_,files in os.walk(args.out):
+        for f in files:
+            if f.endswith("adv_data.ndjson"):
+                adv_ndjson = os.path.join(root,f)
+    if os.path.exists(adv_ndjson):
+        rc = trigger_retrain(adv_ndjson, args.npu_runners.split(",") if args.npu_runners else [], args.cosign)
+        record_manifest_safe("perception_retrain", {"out": args.out, "rc": rc})
+    else:
+        print("No adv_data.ndjson found; retrain not triggered.")
+    record_manifest_safe("scale_orchestrator", {"out": args.out})
+    print("Scale orchestrator finished. Results:", results_path)
+
+if __name__ == "__main__":
+    main()
