+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Auto-harden (bootstrap) builders and label them. Operator must review.
+#
+# Usage:
+#  sudo ./auto_harden_builders.sh --labels "role=builder,npu=true" --install-cosign true
+
+LABELS="role=builder"
+INSTALL_COSIGN=${INSTALL_COSIGN:-"true"}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --labels) LABELS="$2"; shift 2;;
+    --install-cosign) INSTALL_COSIGN="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+LABEL_FILE="/etc/aegis-runner-labels"
+echo "Writing labels to $LABEL_FILE"
+echo "labels=${LABELS}" > "$LABEL_FILE"
+chmod 644 "$LABEL_FILE"
+
+if [ "$INSTALL_COSIGN" = "true" ]; then
+  if ! command -v cosign >/dev/null 2>&1; then
+    echo "Installing cosign (best-effort)"
+    BIN_URL="$(curl -s https://api.github.com/repos/sigstore/cosign/releases/latest | jq -r '.assets[] | select(.name|test(\"cosign-linux-amd64$\")) | .browser_download_url')"
+    if [ -n "$BIN_URL" ]; then
+      curl -fsSL "$BIN_URL" -o /usr/local/bin/cosign || true
+      chmod +x /usr/local/bin/cosign || true
+    fi
+  else
+    echo "cosign already installed"
+  fi
+fi
+
+echo "Ensure rekor-cli is present"
+if ! command -v rekor-cli >/dev/null 2>&1; then
+  BIN_URL="$(curl -s https://api.github.com/repos/sigstore/rekor/releases/latest | jq -r '.assets[] | select(.name|test(\"rekor-cli-linux-amd64$\")) | .browser_download_url')"
+  if [ -n "$BIN_URL" ]; then
+    curl -fsSL "$BIN_URL" -o /usr/local/bin/rekor-cli || true
+    chmod +x /usr/local/bin/rekor-cli || true
+  fi
+fi
+
+echo "Finished auto-hardening (operator should verify vendor SDKs and kernel tuning manually)."
+echo "Run ops/infra/hardening/check_runner_hardening.sh to validate."
+
