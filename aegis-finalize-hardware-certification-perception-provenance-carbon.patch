+
+def run_hil(scenarios_file, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    with open(scenarios_file) as fh:
+        scenarios = [l.strip() for l in fh if l.strip()]
+    cmd = ["python3", "ops/robotics/control/certified/hil_campaign_manager.py", "--golden", args.golden, "--out", outdir]
+    for s in scenarios:
+        cmd += ["--scenarios", s]
+    return subprocess.call(cmd)
+
+def run_apalache(outdir):
+    return subprocess.call(["./ops/formal/apalache_triage_runner.sh", outdir])
+
+def package_sign_upload(outdir, cosign_key=None, cert_upload=None, api_token=None):
+    bundle = outdir.rstrip("/") + "_hil_cert_bundle.tar.gz"
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    if cert_upload:
+        try:
+            import requests
+            headers = {}
+            if api_token:
+                headers["Authorization"] = f"Bearer {api_token}"
+            files = {"file": open(bundle,"rb")}
+            resp = requests.post(cert_upload, files=files, headers=headers, timeout=120)
+            return bundle, resp.status_code, resp.text
+        except Exception as e:
+            return bundle, None, str(e)
