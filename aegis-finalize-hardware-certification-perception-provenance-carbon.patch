+#!/usr/bin/env python3
+"""
+Hardware Proofs Executor
+ - Run RT sweeps on specified targets, validate p99 & safe-stop SLOs, package & cosign evidence bundles.
+ - Emits remediation suggestions when targets fail SLOs.
+
+Usage:
+  python3 hw_proofs_executor.py --targets "ecu1:can0,ecu2:can0" --out /tmp/hw_proofs --cosign kms://... --s3 s3://...
+"""
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from datetime import datetime
+
+def run_rt_sweep_for_target(target, outdir, cosign_key=None, s3=None):
+    os.makedirs(outdir, exist_ok=True)
+    env = os.environ.copy()
+    env["TARGETS"] = target
+    if cosign_key:
+        env["COSIGN_KMS_URI"] = cosign_key
+    if s3:
+        env["S3_UPLOAD"] = s3
+    cmd = ["./ops/av/rt/run_hw_rt_sweep.sh", outdir]
+    print("Running:", " ".join(cmd), "with TARGETS=", target)
+    try:
+        subprocess.check_call(cmd, env=env)
+    except subprocess.CalledProcessError as e:
+        print("RT sweep failed for", target, ":", e)
+    proof = os.path.join(outdir, "rt_slo_proof.json")
+    return proof if os.path.exists(proof) else None
+
+def validate_proof(proof_path, p99_threshold=0.5, safe_threshold_ms=50.0):
+    if not os.path.exists(proof_path):
+        return False, ["proof_missing"]
+    try:
+        j = json.load(open(proof_path))
+    except Exception as e:
+        return False, [f"proof_read_error:{e}"]
+    suggestions = []
+    p99 = j.get("p99_ms")
+    safe = j.get("safe_ms")
+    if p99 is None:
+        suggestions.append("no_p99")
+    else:
+        if p99 > p99_threshold:
+            suggestions.append(f"p99_too_high:{p99} > {p99_threshold}")
+    if safe is None:
+        suggestions.append("no_safe")
+    else:
+        if safe > safe_threshold_ms:
+            suggestions.append(f"safe_too_high:{safe} > {safe_threshold_ms}")
+    ok = len([s for s in suggestions if not s.startswith("no_")]) == 0 and "no_p99" not in suggestions and "no_safe" not in suggestions
+    return ok, suggestions
+
+def remediate_suggestions(report_path, out_path):
+    # Reuse existing lightweight remediation agent if available
+    try:
+        subprocess.check_call(["python3", "ops/validation/rt_remediation_agent.py", "--report", report_path, "--out", out_path])
+        return True
+    except Exception:
+        # Best-effort fallback: write minimal suggestions
+        with open(out_path, "w") as fh:
+            fh.write(json.dumps({"note": "remediation_agent_missing_or_failed"}, indent=2))
+        return False
+
+def sign_and_upload(bundle, cosign_key=None, s3=None):
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    if s3:
+        try:
+            subprocess.check_call(["aws","s3","cp",bundle,s3])
+        except Exception as e:
+            print("s3 upload failed:", e)
+
+def record_manifest_safe(key, meta):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest(key, meta)
+    except Exception:
+        pass
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--targets", required=True, help="comma-separated host:iface entries")
+    p.add_argument("--out", default=f"/tmp/hw_proofs_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--cosign", default="")
+    p.add_argument("--s3", default="")
+    p.add_argument("--p99-threshold", type=float, default=0.5)
+    p.add_argument("--safe-threshold-ms", type=float, default=50.0)
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    targets = [t.strip() for t in args.targets.split(",") if t.strip()]
+    summary = {"started_at": datetime.utcnow().isoformat()+"Z", "targets": []}
+    for t in targets:
+        tid = t.replace(":", "_")
+        od = os.path.join(args.out, tid)
+        proof = run_rt_sweep_for_target(t, od, cosign_key=args.cosign, s3=args.s3)
+        ok, suggestions = validate_proof(proof or "", args.p99_threshold, args.safe_threshold_ms)
+        if not ok:
+            remediation_out = os.path.join(od, "remediation.json")
+            remediate_suggestions(proof or "", remediation_out)
+        bundle = os.path.join(args.out, f"{tid}_bundle.tar.gz")
+        # package per-target artifacts
+        try:
+            subprocess.check_call(["tar","-czf",bundle,"-C",od,"."])
+        except Exception as e:
+            print("tar failed:", e)
+        sign_and_upload(bundle, cosign_key=args.cosign, s3=(args.s3 and (args.s3.rstrip("/") + f"/rt_proofs/{os.path.basename(bundle)}")))
+        summary["targets"].append({"target": t, "proof": proof, "ok": ok, "suggestions": suggestions, "bundle": bundle})
+        record_manifest_safe("hw_proof_target", {"target": t, "bundle": bundle})
+    summary_path = os.path.join(args.out, "hw_proofs_summary.json")
+    with open(summary_path, "w") as fh:
+        json.dump(summary, fh, indent=2)
+    record_manifest_safe("hw_proofs_summary", {"summary": summary_path})
+    print("Hardware proofs summary written to", summary_path)
+
+if __name__ == "__main__":
+    from datetime import datetime
+    import json
+    main()
+
