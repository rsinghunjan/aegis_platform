+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Small helper to compute conservative alert thresholds based on sample metrics (local estimator).
+# This script is a template: run against Prometheus data and produce recommended thresholds.
+#
+PROM_URL=${PROM_URL:-http://localhost:9090}
+PROJECT=${1:-default}
+
+echo "Querying Prometheus for p95 latency sample..."
+P95=$(curl -sG "${PROM_URL}/api/v1/query" --data-urlencode 'query=histogram_quantile(0.95, sum(rate(istio_request_duration_seconds_bucket{destination_service=~"aegis-admission-webhook.*"}[5m])) by (le))' | jq -r '.data.result[0].value[1]' || echo "0")
+echo "Measured p95: $P95"
+RECOMMENDED_P95=$(python3 - <<PY
+v=$P95 if $P95 else 0.5
+print(max(0.2, float(v)*1.5))
+PY
+)
+echo "Recommended p95 alert threshold: $RECOMMENDED_P95"
+echo "You can set the PrometheusRule WebhookP95LatencyHigh threshold to ${RECOMMENDED_P95}"
+
