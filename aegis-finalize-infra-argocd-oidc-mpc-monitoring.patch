*** Add File:ops/infra/setup_evidence_bucket.sh
+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper for operators who prefer aws cli over terraform to create evidence bucket & KMS
+#
+BUCKET=${1:-aegis-evidence-bucket-$(date +%s)}
+REGION=${AWS_REGION:-us-east-1}
+
+echo "Creating S3 bucket ${BUCKET} in ${REGION}"
+aws s3api create-bucket --bucket "${BUCKET}" --region "${REGION}" --create-bucket-configuration LocationConstraint="${REGION}"
+aws s3api put-bucket-versioning --bucket "${BUCKET}" --versioning-configuration Status=Enabled
+
+echo "Creating KMS key"
+KID=$(aws kms create-key --description "Aegis evidence key" --query KeyMetadata.KeyId --output text)
+echo "Created KMS key ID: $KID"
+echo "Encrypting objects to S3 with KMS requires setting appropriate bucket policy and IAM roles: configure manually."
+echo "Bucket: ${BUCKET}  KMS Key: ${KID}"
+
