*** Add File:terraform/evidence/main.tf
+terraform {
+  required_version = ">= 1.0.0"
+}
+
+provider "aws" {
+  region = var.region
+}
+
+resource "aws_s3_bucket" "evidence" {
+  bucket = var.bucket_name
+  acl    = "private"
+
+  versioning {
+    enabled = true
+  }
+
+  server_side_encryption_configuration {
+    rule {
+      apply_server_side_encryption_by_default {
+        kms_master_key_id = aws_kms_key.evidence_key.arn
+        sse_algorithm     = "aws:kms"
+      }
+    }
+  }
+
+  tags = merge(var.tags, { Name = var.bucket_name })
+}
+
+resource "aws_kms_key" "evidence_key" {
+  description = "Aegis evidence bucket KMS key"
+  deletion_window_in_days = var.kms_deletion_window_days
+  policy = data.aws_iam_policy_document.kms_policy.json
+  tags = var.tags
+}
+
+data "aws_iam_policy_document" "kms_policy" {
+  statement {
+    sid = "AllowAccountAdmins"
+    principals {
+      type = "AWS"
+      identifiers = [var.account_root_arn]
+    }
+    actions = ["kms:*"]
+    resources = ["*"]
+  }
+}
+
+resource "aws_iam_role" "ci_uploader" {
+  name = "${var.bucket_name}-uploader-role"
+  assume_role_policy = data.aws_iam_policy_document.ci_assume_role.json
+  tags = var.tags
+}
+
+data "aws_iam_policy_document" "ci_assume_role" {
+  statement {
+    effect = "Allow"
+    principals {
+      type        = "Service"
+      identifiers = var.ci_assume_principals
+    }
+    actions = ["sts:AssumeRole"]
+  }
+}
+
+resource "aws_iam_policy" "uploader_policy" {
+  name        = "${var.bucket_name}-uploader-policy"
+  description = "Allow put/get to evidence bucket and decrypt with KMS key"
+  policy      = data.aws_iam_policy_document.uploader_policy.json
+}
+
+data "aws_iam_policy_document" "uploader_policy" {
+  statement {
+    sid = "S3Access"
+    actions = [
+      "s3:PutObject",
+      "s3:GetObject",
+      "s3:ListBucket",
+      "s3:GetBucketLocation",
+      "s3:PutObjectAcl"
+    ]
+    resources = [
+      aws_s3_bucket.evidence.arn,
+      "${aws_s3_bucket.evidence.arn}/*"
+    ]
+  }
+  statement {
+    sid = "KMSUse"
+    actions = [
+      "kms:Decrypt",
+      "kms:Encrypt",
+      "kms:GenerateDataKey*",
+      "kms:DescribeKey"
+    ]
+    resources = [aws_kms_key.evidence_key.arn]
+  }
+}
+
+resource "aws_iam_role_policy_attachment" "attach" {
+  role       = aws_iam_role.ci_uploader.name
+  policy_arn = aws_iam_policy.uploader_policy.arn
+}
+
+output "evidence_bucket_name" {
+  description = "Name of the evidence S3 bucket"
+  value       = aws_s3_bucket.evidence.bucket
+}
+
+output "evidence_kms_key_arn" {
+  description = "ARN of KMS key used to encrypt evidence"
+  value       = aws_kms_key.evidence_key.arn
+}
+
+output "uploader_role_arn" {
+  description = "IAM role ARN for CI to upload evidence"
+  value       = aws_iam_role.ci_uploader.arn
+}
+
