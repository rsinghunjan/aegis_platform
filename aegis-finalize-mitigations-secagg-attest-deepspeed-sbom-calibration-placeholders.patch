+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Bootstrap Vault PKI role and intermediate CA for client cert issuance.
+# Placeholders are used; set VAULT_ADDR and VAULT_TOKEN in environment or prefills.
+VAULT_ADDR=${VAULT_ADDR:-"${VAULT_ADDR_PLACEHOLDER:-https://vault.example.com:8200}"}
+VAULT_TOKEN=${VAULT_TOKEN:-"${VAULT_TOKEN_PLACEHOLDER:-<VAULT_TOKEN>}"} 
+PKI_MOUNT=${PKI_MOUNT:-pki}
+ROLE_NAME=${ROLE_NAME:-aegis-fl-client-role}
+
+if ! command -v vault >/dev/null 2>&1; then
+  echo "vault CLI not found; please install and authenticate first."
+  exit 2
+fi
+
+export VAULT_ADDR
+export VAULT_TOKEN
+
+echo "Enabling PKI secret engine at $PKI_MOUNT (idempotent)"
+vault secrets enable -path="$PKI_MOUNT" pki || true
+vault secrets tune -max-lease-ttl=87600h "$PKI_MOUNT" || true
+
+echo "Generate root CA (if not present) -- stored in Vault"
+vault write -field=certificate "$PKI_MOUNT/root/generate/internal" common_name="aegis.internal" ttl="87600h" >/dev/null || true
+
+echo "Create role $ROLE_NAME"
+vault write "$PKI_MOUNT/roles/$ROLE_NAME" \
+    allowed_domains="aegis.internal" \
+    allow_subdomains=true \
+    max_ttl="24h" || true
+
+echo "Vault PKI setup complete. Use ops/fl/attestation/issue_client_cert.sh to issue client certs."
+
