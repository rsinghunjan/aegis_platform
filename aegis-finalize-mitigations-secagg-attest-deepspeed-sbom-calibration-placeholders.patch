+#!/usr/bin/env bash
+set -euo pipefail
+CLIENT=${1:-client01}
+TTL=${2:-24h}
+VAULT_ADDR=${VAULT_ADDR:-"${VAULT_ADDR_PLACEHOLDER:-https://vault.example.com:8200}"}
+ROLE=${ROLE_NAME:-aegis-fl-client-role}
+
+if ! command -v vault >/dev/null 2>&1; then
+  echo "vault CLI required"
+  exit 2
+fi
+
+echo "Issuing certificate for $CLIENT via Vault PKI role $ROLE (TTL=$TTL)"
+vault write -format=json "$PKI_MOUNT/issue/$ROLE" common_name="${CLIENT}.aegis.internal" ttl="$TTL" > /tmp/cert_resp.json
+cat /tmp/cert_resp.json | jq -r '.data.certificate' > /tmp/${CLIENT}.crt
+cat /tmp/cert_resp.json | jq -r '.data.private_key' > /tmp/${CLIENT}.key
+cat /tmp/cert_resp.json | jq -r '.data.issuing_ca' > /tmp/ca.crt
+echo "Wrote /tmp/${CLIENT}.crt, /tmp/${CLIENT}.key, /tmp/ca.crt"
+
