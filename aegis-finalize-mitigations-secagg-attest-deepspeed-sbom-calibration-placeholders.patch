+#!/usr/bin/env bash
+set -euo pipefail
+NS=${1:-aegis-app}
+SECRET=${2:-aegis-webhooks-tls}
+WCONFIG=${3:-aegis-image-signature-webhook}
+
+echo "Waiting for tls secret $SECRET in namespace $NS..."
+for i in $(seq 1 12); do
+  if kubectl -n "$NS" get secret "$SECRET" >/dev/null 2>&1; then
+    break
+  fi
+  sleep 5
+done
+
+CA=$(kubectl get secret -n "$NS" "$SECRET" -o jsonpath='{.data.tls\.crt}')
+if [ -z "$CA" ]; then
+  echo "Secret missing tls.crt"
+  exit 2
+fi
+
+echo "Patching ValidatingWebhookConfiguration $WCONFIG with CA bundle"
+kubectl patch validatingwebhookconfiguration "$WCONFIG" --type='json' -p="[{'op':'replace','path':'/webhooks/0/clientConfig/caBundle','value':'$CA'}]"
+echo "Patched $WCONFIG"
+
