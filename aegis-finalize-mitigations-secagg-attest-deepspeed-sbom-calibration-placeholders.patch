+#!/usr/bin/env python3
+"""
+Compare nvidia-smi GPU power samples against PDU/IPMI or node power metric.
+Outputs a calibration JSON for use by the job_carbon_exporter.
+Placeholders used for PDU collection; replace with vendor SDK or Prometheus queries.
+"""
+import time, json, os, subprocess, argparse
+
+def sample_nvidia():
+    try:
+        out = subprocess.check_output(["nvidia-smi","--query-gpu=power.draw","--format=csv,noheader,nounits"])
+        vals = [float(x) for x in out.decode().strip().splitlines()]
+        return sum(vals)
+    except Exception:
+        return None
+
+def sample_pdu():
+    # Placeholder: implement vendor integration or Prometheus query
+    return float(os.environ.get("PDU_SIMULATED_W","0"))
+
+def main(samples=5, interval=2, out="/tmp/gpu_pdu_compare.json"):
+    pairs=[]
+    for i in range(samples):
+        nv = sample_nvidia()
+        pdu = sample_pdu()
+        pairs.append({"nv": nv, "pdu": pdu, "ts": time.time()})
+        time.sleep(interval)
+    nv_vals = [p["nv"] for p in pairs if p["nv"]]
+    pdu_vals = [p["pdu"] for p in pairs if p["pdu"]]
+    avg_nv = sum(nv_vals)/len(nv_vals) if nv_vals else None
+    avg_pdu = sum(pdu_vals)/len(pdu_vals) if pdu_vals else None
+    calib = (avg_pdu / avg_nv) if (avg_pdu and avg_nv) else 1.0
+    res = {"avg_nv": avg_nv, "avg_pdu": avg_pdu, "calib": calib, "samples": pairs, "generated_at": time.time()}
+    with open(out, "w") as fh:
+        json.dump(res, fh, indent=2)
+    print("Wrote comparison to", out)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--samples", type=int, default=5)
+    p.add_argument("--interval", type=int, default=2)
+    p.add_argument("--out", default="/tmp/gpu_pdu_compare.json")
+    args = p.parse_args()
+    main(args.samples, args.interval, args.out)
+
