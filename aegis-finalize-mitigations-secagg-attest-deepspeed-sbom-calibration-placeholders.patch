+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Assemble auditor bundle, cosign sign with KMS, upload to S3 and create Rekor entry.
+#
+ARTIFACTS_CSV=${1:-""}
+OUT=${2:-/tmp/audit_bundle_$(date +%s).tar.gz}
+COSIGN_KEY=${COSIGN_KMS_URI:-"{{COSIGN_KMS_URI_PLACEHOLDER}}"}
+REKOR_SERVER=${REKOR_SERVER:-"{{REKOR_SERVER_PLACEHOLDER}}"}
+S3=${S3_UPLOAD:-"{{S3_UPLOAD_PLACEHOLDER}}"}
+
+if [ -z "$ARTIFACTS_CSV" ]; then
+  echo "Usage: $0 artifacts_comma_separated [out.tar.gz]"
+  exit 2
+fi
+
+IFS=',' read -r -a FILES <<< "$ARTIFACTS_CSV"
+TMPDIR=$(mktemp -d)
+for f in "${FILES[@]}"; do
+  cp "$f" "$TMPDIR/" || echo "warning: could not copy $f"
+done
+tar -czf "$OUT" -C "$TMPDIR" .
+
+if [ -n "$COSIGN_KEY" ]; then
+  echo "Signing bundle with cosign key (KMS URI placeholder or set COSIGN_KMS_URI)"
+  cosign sign --key "$COSIGN_KEY" "$OUT" || echo "cosign sign failed or not configured"
+fi
+
+if [ -n "$S3" ]; then
+  aws s3 cp "$OUT" "$S3/$(basename "$OUT")" || echo "S3 upload failed (check credentials)"
+fi
+
+if [ -n "$REKOR_SERVER" ] && command -v rekor-cli >/dev/null 2>&1; then
+  rekor-cli upload --artifact "$OUT" --api-url "$REKOR_SERVER" || echo "rekor upload failed"
+fi
+
+echo "Audit bundle prepared: $OUT"
