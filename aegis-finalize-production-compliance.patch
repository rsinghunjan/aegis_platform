+Lightweight finance mock server for staging testing of reconcile flows.
+Exposes /charges endpoint that accepts posted charges and returns 200.
+"""
+from flask import Flask, request, jsonify
+app = Flask(__name__)
+received = []
+@app.route("/charges", methods=["POST"])
+def charges():
+    j = request.get_json(force=True)
+    received.append(j)
+    return jsonify({"ok": True, "received": True}), 200
+
+@app.route("/received", methods=["GET"])
+def list_received():
+    return jsonify(received)
+
+if __name__=="__main__":
