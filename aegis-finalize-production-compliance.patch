+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Store per-cloud KMS key refs and evidence bucket names in Vault (KV v2)
+# Usage: ops/vault/per-cloud-secrets.sh put aws kms_arn arn:aws:kms:... evidence_bucket s3://...
+#
+if [ $# -lt 1 ]; then
+  echo "Usage: $0 put|get <provider> <key> <value> ..."
+  exit 2
+fi
+ACTION=$1; shift
+if [ "$ACTION" = "put" ]; then
+  PROVIDER=$1; KEY=$2; VALUE=$3
+  vault kv put secret/aegis/${PROVIDER}/${KEY} value="$VALUE"
+  echo "Stored secret for $PROVIDER/$KEY"
+elif [ "$ACTION" = "get" ]; then
+  PROVIDER=$1; KEY=$2
+  vault kv get -field=value secret/aegis/${PROVIDER}/${KEY}
+else
+  echo "Unknown action"
+  exit 2
+fi
+
