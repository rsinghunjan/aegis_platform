+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Cross-cloud verification matrix:
+# Usage: ops/cloud/crosscloud_verify_matrix.sh <kms-ref-1> <kms-ref-2> ... --image IMAGE_REF --attestation s3://bucket/path/att.tar.gz
+#
+IMAGE=""
+ATTESTATION=""
+KMS_REFS=()
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --image) IMAGE="$2"; shift 2;;
+    --attestation) ATTESTATION="$2"; shift 2;;
+    *) KMS_REFS+=("$1"); shift;;
+  esac
+done
+if [ -z "$IMAGE" ] || [ ${#KMS_REFS[@]} -eq 0 ]; then
+  echo "Usage: $0 <kms-ref>... --image IMAGE_REF [--attestation ATTESTATION_URI]"
+  exit 2
+fi
+for k in "${KMS_REFS[@]}"; do
+  echo "Verifying pubkey extraction for $k..."
+  cosign public-key --key "$k" > /tmp/pubkey-$(echo "$k" | tr '/:' '_').pem
+  echo "Verifying image $IMAGE against key $k"
+  cosign verify --key /tmp/pubkey-$(echo "$k" | tr '/:' '_').pem "$IMAGE" || echo "verify failed for $k"
+  if [ -n "$ATTESTATION" ]; then
+    echo "Verifying attestation $ATTESTATION"
+    ./ops/cloud/crosscloud_verify_attestation.sh "$ATTESTATION" "$k" || echo "attestation verify failed for $k"
+  fi
+done
+
