+---
+# Ansible playbook to install and configure isolated runtimes on worker nodes
+# - Supports: Kata Containers and gVisor (runsc) installation on Ubuntu (adapt for your distro)
+# - After install, configures containerd runtimeClass entries and restarts containerd
+# Usage: ansible-playbook -i inventory ops/node_provision/ansible_provision_runtimes.yml -e "runtime=kata"
+
+- hosts: workers
+  become: true
+  vars:
+    runtime: "{{ runtime | default('kata') }}"   # kata or runsc
+  tasks:
+    - name: ensure apt cache updated
+      apt:
+        update_cache: yes
+        cache_valid_time: 3600
+
+    - name: install common deps
+      apt:
+        name:
+          - apt-transport-https
+          - ca-certificates
+          - curl
+          - gnupg
+        state: present
+
+    - name: Install Kata runtime (example)
+      when: runtime == "kata"
+      block:
+        - name: add kata repo key (example)
+          apt_key:
+            url: "https://download.opensuse.org/repositories/home:/katacontainers:/releases:/xUbuntu_20.04/Release.key"
+            state: present
+          ignore_errors: true
+
+        - name: ensure kata packages present (best-effort)
+          apt:
+            name:
+              - kata-runtime
+              - kata-proxy
+              - kata-shim
+            state: present
+          register: kata_install
+          ignore_errors: true
+
+        - name: add kata runtime to containerd config (create if missing)
+          copy:
+            dest: /etc/containerd/config.toml.d/10-kata.toml
+            content: |
+              [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata]
+                runtime_type = "io.containerd.kata.v2"
+                privileged_without_host_devices = false
+          notify: restart containerd
+
+    - name: Install gVisor/runsc (example)
+      when: runtime == "runsc"
+      block:
+        - name: download runsc binary (example)
+          get_url:
+            url: "https://storage.googleapis.com/gvisor/releases/release/latest/runsc"
+            dest: /usr/local/bin/runsc
+            mode: '0755'
+          ignore_errors: true
+
+        - name: add runsc runtime config
+          copy:
+            dest: /etc/containerd/config.toml.d/10-runsc.toml
+            content: |
+              [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runsc]
+                runtime_type = "io.containerd.runsc.v1"
+          notify: restart containerd
+
+  handlers:
+    - name: restart containerd
+      systemd:
+        name: containerd
+        state: restarted
+      become: true
+
