+name: CI build, cosign sign (KMS), deploy test & validate webhook
+on:
+  workflow_dispatch:
+jobs:
+  build_sign_deploy:
+    runs-on: ubuntu-latest
+    env:
+      IMAGE_NAME: ${{ inputs.image_name || secrets.IMAGE_NAME }}
+      KUBECONFIG_B64: ${{ secrets.KUBECONFIG_B64 }}
+      COSIGN_KEY_REF: ${{ secrets.COSIGN_KEY_REF }}
+      REGISTRY: ${{ secrets.REGISTRY }}
+    steps:
+      - uses: actions/checkout@v4
+      - name: Setup Docker
+        uses: docker/setup-buildx-action@v2
+      - name: Build and push image
+        run: |
+          docker build -t "$IMAGE_NAME" .
+          docker push "$IMAGE_NAME"
+      - name: Install cosign
+        run: |
+          curl -sSL -o cosign https://github.com/sigstore/cosign/releases/download/v2.1.0/cosign-linux-amd64
+          chmod +x cosign; sudo mv cosign /usr/local/bin/cosign
+      - name: Sign image with cosign KMS
+        run: |
+          if [ -z "$COSIGN_KEY_REF" ]; then echo "COSIGN_KEY_REF not set"; exit 1; fi
+          cosign sign --key "$COSIGN_KEY_REF" "$IMAGE_NAME"
+      - name: Extract cosign pubkey and update cluster secret
+        run: |
+          cosign public-key --key "$COSIGN_KEY_REF" > pubkey.pem
+          echo "$KUBECONFIG_B64" | base64 --decode > kubeconfig
+          kubectl --kubeconfig kubeconfig -n ml-serving delete secret aegis-cosign-pubkey --ignore-not-found
+          kubectl --kubeconfig kubeconfig -n ml-serving create secret generic aegis-cosign-pubkey --from-file=pubkey.pem=pubkey.pem
+      - name: Create unsigned pod (expect DENY)
+        run: |
+          echo "Applying unsigned pod manifest (nginx:latest) into protected namespace..."
+          echo "apiVersion: v1\nkind: Pod\nmetadata:\n  name: unsigned-test\n  namespace: ml-serving\nspec:\n  runtimeClassName: runsc\n  containers:\n  - name: nginx\n    image: nginx:latest" > unsigned.yaml
+          set +e
+          kubectl --kubeconfig kubeconfig apply -f unsigned.yaml 2>&1 | tee unsigned.out
+          rc=$?
+          set -e
+          if [ $rc -eq 0 ]; then
+            echo "ERROR: unsigned pod was admitted unexpectedly"; exit 2
+          else
+            echo "Unsigned pod denied as expected"
+          fi
+      - name: Create signed pod (expect ALLOW)
+        run: |
+          echo "Applying signed pod manifest referencing signed image into protected namespace..."
+          echo "apiVersion: v1\nkind: Pod\nmetadata:\n  name: signed-test\n  namespace: ml-serving\nspec:\n  runtimeClassName: runsc\n  containers:\n  - name: app\n    image: $IMAGE_NAME" > signed.yaml
+          kubectl --kubeconfig kubeconfig apply -f signed.yaml
+          kubectl --kubeconfig kubeconfig wait --for=condition=ready pod/signed-test -n ml-serving --timeout=120s || (kubectl --kubeconfig kubeconfig describe pod signed-test -n ml-serving; exit 2)
+          echo "Signed pod admitted and ready; webhook validation passed"
