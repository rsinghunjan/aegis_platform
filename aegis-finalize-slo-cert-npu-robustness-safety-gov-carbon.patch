+"""
+NPU Readiness Check
+ - Detects vendor runtimes presence and runs smoke compile/run if available
+ - Produces a single JSON report summarizing readiness per vendor
+ - Records evidence via ops.sdk.evidence_sdk
+"""
+import json, os, subprocess, tempfile
+from datetime import datetime
+
+VENDORS = {
+    "inferentia": {"check_cmd": ["neuron-ls"], "smoke_cmd": ["python3","ops/hw/validation/inferentia_compile_run.py","ops/dl/inference/test_models/tiny_model.onnx"]},
+    "graphcore": {"check_cmd": ["poprun","--help"], "smoke_cmd": ["python3","ops/hw/validation/graphcore_compile_run.py","ops/dl/inference/test_models/tiny_model.onnx"]},
+    "habana": {"check_cmd": ["habana_info"], "smoke_cmd": ["python3","ops/hw/validation/habana_compile_run.py","ops/dl/inference/test_models/tiny_model.onnx"]},
+}
+
+def run_check(cmd):
+    try:
+        subprocess.check_output(cmd, stderr=subprocess.STDOUT, timeout=30)
+        return True, ""
+    except Exception as e:
+        return False, str(e)
+
+def main():
+    out = {"checked_at": datetime.utcnow().isoformat()+"Z", "vendors": {}}
+    for v,meta in VENDORS.items():
+        ok, outmsg = run_check(meta["check_cmd"])
+        entry = {"runtime_present": ok, "check_message": outmsg}
+        if ok:
+            # attempt smoke run
+            try:
+                subprocess.check_call(meta["smoke_cmd"], timeout=300)
+                entry["smoke_ok"] = True
+            except Exception as e:
+                entry["smoke_ok"] = False
+                entry["smoke_err"] = str(e)
+        out["vendors"][v] = entry
+    out_path = os.environ.get("OUT_PATH","/tmp/npu_readiness.json")
+    with open(out_path,"w") as fh:
+        json.dump(out, fh, indent=2)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("npu_readiness", {"report": out_path})
+    except Exception:
+        pass
+    print("Wrote NPU readiness report to", out_path)
+
+if __name__=="__main__":
+    main()
