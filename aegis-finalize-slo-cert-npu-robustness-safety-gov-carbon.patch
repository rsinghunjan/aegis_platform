+#!/usr/bin/env python3
+"""
+Carbon Gate Validator
+ - Validates WattTime connectivity, checks meter logs if available, and decides permit/block for promotion
+ - Supports operator-signed override artifact (cosign-signed JSON containing "override":"allow")
+ - Produces JSON report and records evidence
+"""
+import os, json, subprocess, time
+from ops.carbon.watttime_client import get_latest_intensity
+
+OVERRIDE_PATH = os.environ.get("CARBON_OVERRIDE_ARTIFACT","")
+REGION = os.environ.get("Aegis_CARBON_REGION","US-CA")
+THRESHOLD = float(os.environ.get("Aegis_CARBON_PROMOTE_THRESHOLD_GCO2","300"))
+
+def verify_override(path):
+    if not path or not os.path.exists(path):
+        return False
+    try:
+        subprocess.check_call(["cosign","verify", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def main():
+    intensity = get_latest_intensity(REGION)
+    report = {"checked_at": time.time(), "intensity": intensity, "threshold": THRESHOLD, "decision": "unknown"}
+    if intensity is None:
+        report["decision"] = "block_no_data"
+    else:
+        if intensity <= THRESHOLD:
+            report["decision"] = "allow"
+        else:
+            # intensity high
+            if verify_override(OVERRIDE_PATH):
+                report["decision"] = "allow_override"
+            else:
+                report["decision"] = "block_threshold"
+    out = os.environ.get("OUT", "/tmp/carbon_gate_report.json")
+    with open(out,"w") as fh:
+        json.dump(report, fh, indent=2)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("carbon_gate_report", {"report": out})
+    except Exception:
+        pass
+    print("Wrote carbon gate report to", out)
+    if report["decision"].startswith("block"):
+        raise SystemExit(3)
+
+if __name__=="__main__":
+    main()
+
