+#!/usr/bin/env python3
+"""
+RT SLO Prover
+ - Runs the RT lab orchestrator (or consumes its artifacts)
+ - Computes p99 jitter from jitter samples and safe-stop latency distribution
+ - Produces a signed auditor-grade JSON report and optional simple HTML summary
+ - Records evidence via ops.sdk.evidence_sdk.record_manifest
+
+Usage:
+  python3 rt_slo_prover.py --bundle /path/to/artifact.tar.gz --out /tmp/rt_slo_report.json
+Or:
+  python3 rt_slo_prover.py --jitter /tmp/rt_jitter_samples.ndjson --safe /tmp/safe_stop.json --out ...
+"""
+import argparse, json, os, tarfile, tempfile, statistics, math
+from datetime import datetime
+
+def load_from_bundle(bundle_path, tmpdir):
+    files = {}
+    with tarfile.open(bundle_path, "r:gz") as t:
+        t.extractall(path=tmpdir)
+    # heuristics for filenames
+    for p in ["rt_jitter_result.json","rt_jitter_samples.ndjson","safe_stop.json","rt_slo_report.json"]:
+        fp = os.path.join(tmpdir, p)
+        if os.path.exists(fp):
+            files[p] = fp
+    return files
+
+def compute_p99_from_samples(samples):
+    # samples: list of numeric (ms)
+    if not samples:
+        return None
+    samples_sorted = sorted(samples)
+    idx = min(len(samples_sorted)-1, math.ceil(0.99*len(samples_sorted))-1)
+    return samples_sorted[idx]
+
+def parse_ndjson(path):
+    out = []
+    with open(path) as fh:
+        for line in fh:
+            try:
+                j=json.loads(line)
+                # accept keys p99_ms or jitter_ms or sample_ms list
+                if isinstance(j, dict):
+                    if "jitter_ms" in j:
+                        out.append(float(j["jitter_ms"]))
+                    elif "latencies_ms" in j and isinstance(j["latencies_ms"], list):
+                        out.extend([float(x) for x in j["latencies_ms"]])
+            except Exception:
+                continue
+    return out
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--bundle", help="artifact tar.gz from orchestrator", default=None)
+    p.add_argument("--jitter", help="jitter samples ndjson", default=None)
+    p.add_argument("--safe", help="safe_stop json", default=None)
+    p.add_argument("--out", default="/tmp/rt_slo_proof.json")
+    p.add_argument("--p99-slo-ms", type=float, default=0.2)
+    p.add_argument("--safe-slo-ms", type=float, default=50.0)
+    args = p.parse_args()
+
+    tmpdir = tempfile.mkdtemp(prefix="aegis_rt_proof_")
+    jitter_samples = []
+    safe_report = None
+
+    if args.bundle:
+        files = load_from_bundle(args.bundle, tmpdir)
+        if "rt_jitter_samples.ndjson" in files:
+            jitter_samples = parse_ndjson(files["rt_jitter_samples.ndjson"])
+        elif "rt_jitter_result.json" in files:
+            try:
+                j=json.load(open(files["rt_jitter_result.json"]))
+                if "samples_ms" in j:
+                    jitter_samples = j["samples_ms"]
+            except Exception:
+                pass
+        if "safe_stop.json" in files:
+            try:
+                safe_report=json.load(open(files["safe_stop.json"]))
+            except Exception:
+                pass
+    if args.jitter:
+        jitter_samples = parse_ndjson(args.jitter)
+    if args.safe:
+        try:
+            safe_report=json.load(open(args.safe))
+        except Exception:
+            safe_report=None
+
+    p99 = compute_p99_from_samples(jitter_samples)
+    safe_ms = None
+    if safe_report and "latency_s" in safe_report and safe_report["latency_s"] is not None:
+        safe_ms = float(safe_report["latency_s"])*1000.0
+
+    result = {
+        "checked_at": datetime.utcnow().isoformat()+"Z",
+        "p99_ms": p99,
+        "p99_slo_ms": args.p99_slo_ms,
+        "p99_ok": (p99 is not None and p99 <= args.p99_slo_ms),
+        "safe_ms": safe_ms,
+        "safe_slo_ms": args.safe_slo_ms,
+        "safe_ok": (safe_ms is not None and safe_ms <= args.safe_slo_ms),
+        "jitter_samples_count": len(jitter_samples),
+        "safe_report_raw": safe_report
+    }
+
+    with open(args.out, "w") as fh:
+        json.dump(result, fh, indent=2)
+    # record evidence
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("rt_slo_proof", {"report": args.out, "summary": {"p99_ok": result["p99_ok"], "safe_ok": result["safe_ok"]}})
+    except Exception:
+        pass
+    print("Wrote RT SLO proof to", args.out)
+    # exit non-zero if not passing
+    if not (result["p99_ok"] and result["safe_ok"]):
+        raise SystemExit(3)
+
+if __name__=="__main__":
+    main()
