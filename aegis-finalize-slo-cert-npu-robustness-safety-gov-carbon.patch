+#!/usr/bin/env python3
+"""
+Supply-chain enforcement helper for CI promotion gates.
+ - Validates every image referenced in provided manifests is cosign-signed and has a Rekor entry.
+ - Optionally enforces that the signature was produced by a builder pool (best-effort via Rekor entry analysis).
+ - Exits non-zero to block promotion if checks fail.
+
+Usage:
+  IMAGE_MANIFESTS="deploy.yaml" REKOR_SERVER="https://rekor.example" python3 enforce_supply_chain.py
+"""
+import os, sys, yaml, subprocess, json
+
+def extract_images(manifest_paths):
+    images=set()
+    for path in manifest_paths:
+        if not os.path.exists(path):
+            continue
+        with open(path) as fh:
+            docs=list(yaml.safe_load_all(fh))
+            for d in docs:
+                if not d:
+                    continue
+                def walk(obj):
+                    if isinstance(obj, dict):
+                        for k,v in obj.items():
+                            if k=="image" and isinstance(v,str):
+                                images.add(v)
+                            else:
+                                walk(v)
+                    elif isinstance(obj, list):
+                        for e in obj:
+                            walk(e)
+                walk(d)
+    return images
+
+def cosign_verify(image):
+    try:
+        subprocess.check_call(["cosign","verify",image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def rekor_search(image, rekor_server):
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--rekor_server", rekor_server, "--artifact", image], stderr=subprocess.DEVNULL)
+        return out.decode()
+    except Exception:
+        return ""
+
+def main():
+    manifests = os.environ.get("IMAGE_MANIFESTS","").split(",")
+    rekor = os.environ.get("REKOR_SERVER","")
+    images = extract_images(manifests)
+    bad = []
+    for img in images:
+        ok = cosign_verify(img)
+        if not ok:
+            bad.append((img,"cosign_missing"))
+            continue
+        if rekor:
+            out=rekor_search(img, rekor)
+            if not out.strip():
+                bad.append((img,"rekor_missing"))
+    if bad:
+        print("Supply-chain checks failed for images:")
+        for i,reason in bad:
+            print(i,reason)
+        sys.exit(4)
+    print("All referenced images are signed and Rekor-registered (if REKOR_SERVER configured).")
+
+if __name__=="__main__":
+    main()
+
