+#!/usr/bin/env python3
+"""
+Strict Rekor verification helper
+ - Query Rekor for given image and attempt to parse JSON entries for builder metadata
+ - Returns a small JSON summary (stdout)
+"""
+import argparse
+import json
+import subprocess
+
+def rekor_search_json(artifact, rekor_server):
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--artifact",artifact,"--rekor_server",rekor_server,"--output","json"])
+        return json.loads(out)
+    except Exception as e:
+        return {"error": str(e)}
+
+def summarize(artifact, rekor_server):
+    j = rekor_search_json(artifact, rekor_server)
+    if "error" in j:
+        return {"artifact": artifact, "ok": False, "error": j["error"]}
+    # best-effort: if any entry has 'integratedTime' or a 'body' that looks like provenance, mark ok
+    for k,v in j.items():
+        try:
+            body = v.get("body", {})
+            if "integratedTime" in body:
+                return {"artifact": artifact, "ok": True, "entry": k}
+        except Exception:
+            continue
+    return {"artifact": artifact, "ok": False, "note": "no obvious integratedTime/provenance found"}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifact", required=True)
+    p.add_argument("--rekor-server", required=True)
+    args = p.parse_args()
+    s = summarize(args.artifact, args.rekor_server)
+    print(json.dumps(s, indent=2))
+
+if __name__ == "__main__":
+    main()
+
