+#!/usr/bin/env python3
+"""
+Simple static instrumentation linter.
+
+Checks for common autonomous action usages (perform_action, canary_promote, kms_alias_swap,
+model_promote, fl_round, check_and_start_round) and verifies the file also references
+check_and_allow (runtime safety monitor) or explicitly records manifests.
+
+This is intentionally conservative: it runs in CI to fail PRs that introduce new
+autonomous action entrypoints without runtime safety checks.
+"""
+import sys
+from pathlib import Path
+import re
+import argparse
+
+AUTONOMOUS_MARKERS = [
+    r'perform_action\(\s*[\'"]([a-zA-Z0-9_]+)[\'"]',
+    r'\bcanary_promote\b',
+    r'\bkms_alias_swap\b',
+    r'\bmodel_promote\b',
+    r'\bfl_round\b',
+    r'\bcheck_and_start_round\b',
+]
+
+SAFETY_MARKER = r'check_and_allow\s*\('
+
+def check_file(path: Path):
+    txt = path.read_text(errors='ignore')
+    found = False
+    for pat in AUTONOMOUS_MARKERS:
+        if re.search(pat, txt):
+            found = True
+            break
+    if not found:
+        return True, ""
+    # If file contains autonomous markers, require safety monitor call or explicit record_manifest usage
+    if re.search(SAFETY_MARKER, txt) or re.search(r'record_manifest\s*\(', txt) or re.search(r'ensure_evidence\s*\(', txt):
+        return True, ""
+    return False, f"Missing safety_monitor instrumentation in {path}"
+
+def scan_paths(paths):
+    errors = []
+    for p in paths:
+        p = Path(p)
+        if p.is_file() and p.suffix == ".py":
+            ok, msg = check_file(p)
+            if not ok:
+                errors.append(msg)
+        elif p.is_dir():
+            for f in p.rglob("*.py"):
+                ok, msg = check_file(f)
+                if not ok:
+                    errors.append(msg)
+    return errors
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--paths", nargs="+", default=["services", "controllers", "ops"], help="Paths to scan")
+    args = ap.parse_args()
+    errs = scan_paths(args.paths)
+    if errs:
+        print("Instrumentation linter found issues:")
+        for e in errs:
+            print("-", e)
+        sys.exit(2)
+    print("Instrumentation linter: OK")
+
+if __name__=="__main__":
+    main()
+
