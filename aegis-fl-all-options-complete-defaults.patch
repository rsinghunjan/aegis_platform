+#!/usr/bin/env python3
+"""
+Local training example used by the FL client when no real data is present.
+Simple PyTorch classification toy; demonstrates how clients train and return updates.
+"""
+import torch, torch.nn as nn, torch.optim as optim
+from torch.utils.data import TensorDataset, DataLoader
+import numpy as np
+
+class ToyModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.net = nn.Sequential(nn.Flatten(), nn.Linear(28*28, 128), nn.ReLU(), nn.Linear(128, 10))
+    def forward(self, x):
+        return self.net(x)
+
+def get_data():
+    x = np.random.rand(200,1,28,28).astype('float32')
+    y = np.random.randint(0,10,size=(200,)).astype('int64')
+    ds = TensorDataset(torch.tensor(x), torch.tensor(y))
+    return DataLoader(ds, batch_size=32, shuffle=True)
+
+def train_one_epoch(model, loader, device):
+    model.train()
+    opt = optim.Adam(model.parameters(), lr=1e-3)
+    criterion = nn.CrossEntropyLoss()
+    for xb, yb in loader:
+        xb, yb = xb.to(device), yb.to(device)
+        opt.zero_grad()
+        out = model(xb)
+        loss = criterion(out, yb)
+        loss.backward()
+        opt.step()
+
+if __name__=="__main__":
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    model = ToyModel().to(device)
+    loader = get_data()
+    train_one_epoch(model, loader, device)
+    torch.save(model.state_dict(), "/tmp/local_toy_model.pth")
+    print("Saved local toy model to /tmp/local_toy_model.pth")
+
