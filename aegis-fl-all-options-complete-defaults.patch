+#!/usr/bin/env python3
+"""
+Custom Flower strategy helper that persists the aggregated global model to disk
+so the aggregate can be registered in MLflow and signed by ops/fl/aggregate_and_register.py.
+
+This strategy extends FedAvg to write a PyTorch state_dict to MODEL_SAVE_PATH after every round.
+"""
+import flwr as fl
+import torch
+import tempfile
+import os
+from typing import Dict, List, Tuple, Optional
+
+MODEL_SAVE_PATH = os.environ.get("FL_GLOBAL_OUT", "/tmp/global_model.pth")
+
+class PersistingFedAvg(fl.server.strategy.FedAvg):
+    def aggregate_fit(self, rnd: int, results, failures):
+        # Delegate to FedAvg for parameter aggregation
+        aggregated = super().aggregate_fit(rnd, results, failures)
+        if aggregated is None:
+            return None
+        # aggregated.parameters is a fl.common.Parameters protobuf; convert to numpy and then torch
+        try:
+            # Convert to tensors via helper
+            params = fl.common.parameters_to_ndarrays(aggregated.parameters)
+            # naive mapping to torch state_dict with ordered keys may be required by your model
+            # here we save raw numpy array list to disk as a checkpoint for aggregate_and_register.py to use
+            tmp = MODEL_SAVE_PATH
+            os.makedirs(os.path.dirname(tmp), exist_ok=True)
+            import numpy as _np
+            _np.save(tmp + ".npy", params, allow_pickle=True)
+            # If you want to convert to torch state_dict, implement mapping logic depending on model
+            print(f"Wrote aggregated params to {tmp}.npy")
+        except Exception as e:
+            print("Failed to persist aggregated params:", e)
+        return aggregated
+
