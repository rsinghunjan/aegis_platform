+#!/usr/bin/env python3
+"""
+Example ETL -> Causal pipeline:
+ - Reads raw CSV/Parquet
+ - Produces a cleaned dataset for causal analysis
+ - Optionally registers the dataset artifact to MLflow for reproducibility
+"""
+import argparse, pandas as pd, mlflow, os
+
+def etl(input_path, output_path):
+    df = pd.read_csv(input_path)
+    # basic cleaning example
+    df = df.dropna(subset=["treatment","outcome"])
+    df["treatment"] = df["treatment"].astype(int)
+    df.to_csv(output_path, index=False)
+    return output_path
+
+def register_dataset_in_mlflow(path, name):
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    mlflow.set_experiment("causal-datasets")
+    with mlflow.start_run():
+        mlflow.log_artifact(path, artifact_path="datasets")
+        print("Registered dataset in MLflow")
+
+if __name__=="__main__":
+    p=argparse.ArgumentParser()
+    p.add_argument("--in", dest="inp", required=True)
+    p.add_argument("--out", dest="out", default="/tmp/causal_ready.csv")
+    p.add_argument("--register", action="store_true")
+    args=p.parse_args()
+    outp = etl(args.inp, args.out)
+    if args.register:
+        register_dataset_in_mlflow(outp, "causal_ready")
+    print("ETL complete:", outp)
+
