+#!/usr/bin/env python3
+"""
+Edge agent (enhanced): enroll, heartbeat, model manifest fetch, and optional FL client spawn.
+This replaces the previous agent entrypoint to integrate the FL client directly when ENABLE_FL=true.
+"""
+import os, time, json, subprocess, tempfile, shutil, requests
+from urllib.parse import urljoin
+
+AGENT_ID = os.environ.get("AEGIS_AGENT_ID","")
+SERVER = os.environ.get("AEGIS_SERVER_URL","http://fleet-manager:8080/")
+POLL = int(os.environ.get("POLL_INTERVAL_SECONDS","60"))
+S3_BUCKET = os.environ.get("S3_BUCKET","")
+
+def enroll():
+    global AGENT_ID
+    if AGENT_ID:
+        return AGENT_ID
+    url = urljoin(SERVER, "agents/enroll")
+    r = requests.post(url, json={"hostname": os.uname().nodename}, timeout=10)
+    r.raise_for_status()
+    AGENT_ID = r.json().get("agent_id")
+    print("Enrolled as", AGENT_ID)
+    return AGENT_ID
+
+def heartbeat(agent_id):
+    url = urljoin(SERVER, f"agents/{agent_id}/heartbeat")
+    r = requests.post(url, json={"ts": time.time()}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def fetch_manifest(agent_id):
+    url = urljoin(SERVER, f"agents/{agent_id}/manifest")
+    r = requests.get(url, timeout=10)
+    if r.status_code == 200:
+        return r.json()
+    return None
+
+def download_and_verify(manifest):
+    # same as earlier scaffold: download model and verify cosign signature
+    model_uri = manifest.get("model_uri") or manifest.get("artifact")
+    if not model_uri:
+        return False, "no_model"
+    tmpdir = tempfile.mkdtemp()
+    local_model = os.path.join(tmpdir, os.path.basename(model_uri))
+    if model_uri.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", model_uri, local_model])
+    elif model_uri.startswith("http"):
+        r = requests.get(model_uri, timeout=30)
+        r.raise_for_status()
+        open(local_model,"wb").write(r.content)
+    else:
+        shutil.copy(model_uri, local_model)
+    cosign_key = manifest.get("cosign_key") or os.environ.get("COSIGN_KEY_REF","")
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","verify","--key", cosign_key, local_model])
+        except subprocess.CalledProcessError as e:
+            return False, f"cosign_verify_failed:{e}"
+    return True, local_model
+
+def start_fl_client_if_enabled():
+    if os.environ.get("ENABLE_FL","false").lower() in ("1","true","yes"):
+        fl_server = os.environ.get("FL_SERVER","127.0.0.1:8080")
+        dp_enable = os.environ.get("FL_DP_ENABLE","false")
+        cmd = ["python3","/app/services/fl/client.py","--server", fl_server]
+        if dp_enable.lower() in ("1","true","yes"):
+            cmd += ["--dp-enable","--dp-noise", os.environ.get("FL_DP_NOISE","1.1"), "--dp-sample-rate", os.environ.get("FL_DP_SAMPLE_RATE","0.01")]
+        # spawn in background
+        print("Spawning FL client:", " ".join(cmd))
+        subprocess.Popen(cmd)
+
+def main():
+    agent_id = enroll()
+    # Optionally start FL client
+    try:
+        start_fl_client_if_enabled()
+    except Exception as e:
+        print("Failed to start FL client:", e)
+    while True:
+        try:
+            hb = heartbeat(agent_id)
+            manifest = fetch_manifest(agent_id)
+            if manifest:
+                ok, info = download_and_verify(manifest)
+                if ok:
+                    print("Model downloaded & verified:", info)
+                else:
+                    print("Model verification failed:", info)
+            else:
+                print("No manifest assigned")
+        except Exception as e:
+            print("Agent error:", e)
+        time.sleep(POLL)
+
+if __name__=="__main__":
+    main()
+
