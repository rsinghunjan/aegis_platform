+#!/usr/bin/env python3
+"""
+Programmatic demo: start server + 3 clients as subprocesses, wait for server exit, then register model.
+"""
+import subprocess, time, os, signal
+
+PY = "python3"
+server = subprocess.Popen([PY, "services/fl/server.py", "--rounds", "2", "--host", "127.0.0.1", "--port", "8080"])
+print("Started Flower server pid", server.pid)
+time.sleep(2)
+
+clients = []
+for i in range(3):
+    p = subprocess.Popen([PY, "services/fl/client.py", "--server", "127.0.0.1:8080", "--dp-enable", "--dp-noise", "1.1", "--dp-sample-rate", "0.02"])
+    clients.append(p)
+    print("Started client", p.pid)
+    time.sleep(1)
+
+# wait for server to finish
+server.wait()
+print("Server exited, code", server.returncode)
+
+# terminate clients if still running
+for p in clients:
+    if p.poll() is None:
+        p.terminate()
+        try:
+            p.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            p.kill()
+
+# try to register model
+model_path = "/tmp/global_model.pth"
+if os.path.exists(model_path) or os.path.exists(model_path + ".npy"):
+    model = model_path if os.path.exists(model_path) else model_path + ".npy"
+    print("Registering model", model)
+    subprocess.run([PY, "ops/fl/aggregate_and_register.py", "--model-path", model, "--model-name", "aegis-fl-demo"])
+else:
+    print("Aggregated model not found; check logs.")
