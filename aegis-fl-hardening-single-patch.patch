+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Local demo to run Flower server and 3 FL clients locally (no k8s).
+# Uses services/fl/server.py and services/fl/client.py from the repo.
+#

+PYTHON=${PYTHON:-python3}
+SERVER_LOG=/tmp/flower_server.log
+CLIENT_LOG_DIR=/tmp/flower_clients
+mkdir -p "$CLIENT_LOG_DIR"

+echo "Starting Flower server (background)..."
+$PYTHON -u services/fl/server.py --rounds 2 --host 127.0.0.1 --port 8080 > "$SERVER_LOG" 2>&1 &
+SERVER_PID=$!
+sleep 2

+for i in 1 2 3; do
+  echo "Starting FL client $i..."
+  $PYTHON -u services/fl/client.py --server 127.0.0.1:8080 --dp-enable --dp-noise 1.1 --dp-sample-rate 0.02 > "${CLIENT_LOG_DIR}/client_${i}.log" 2>&1 &
+  echo $! > "${CLIENT_LOG_DIR}/client_${i}.pid"
+done

+echo "Waiting for server to finish rounds (monitor $SERVER_LOG)..."
+wait $SERVER_PID || true

+echo "Server finished. Attempting to locate aggregated model at /tmp/global_model.pth or /tmp/global_model.pth.npy"
+if [ -f /tmp/global_model.pth ]; then
+  MODEL=/tmp/global_model.pth
+elif [ -f /tmp/global_model.pth.npy ]; then
+  MODEL=/tmp/global_model.pth.npy
+else
+  echo "Aggregated model not found; check logs in $SERVER_LOG and client logs in $CLIENT_LOG_DIR"
+  exit 1
+fi

+echo "Registering & signing aggregated model (MLflow & cosign)..."
+python3 ops/fl/aggregate_and_register.py --model-path "$MODEL" --model-name "aegis-fl-demo" || true

+echo "Demo complete. Server log: $SERVER_LOG, client logs: $CLIENT_LOG_DIR"
+
