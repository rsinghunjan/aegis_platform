+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper for operator to create secrets and bootstrap certs & oauth placeholder for Flower server.
+# MUST be run by operator with kubectl access to staging cluster.
+#
+NAMESPACE=${1:-aegis}
+kubectl create ns "$NAMESPACE" || true
+echo "Creating placeholder secret aegis-core-secrets (update values with real credentials)..."
+kubectl create secret generic aegis-core-secrets -n "$NAMESPACE" \
+  --from-literal=COSIGN_KEY_REF="${COSIGN_KEY_REF:-}" \
+  --from-literal=MLFLOW_DB_URL="${MLFLOW_DB_URL:-http://mlflow:5000}" \
+  --from-literal=EVIDENCE_BUCKET="${EVIDENCE_BUCKET:-}" \
+  --from-literal=OAUTH_CLIENT_ID="${OAUTH_CLIENT_ID:-}" \
+  --from-literal=OAUTH_CLIENT_SECRET="${OAUTH_CLIENT_SECRET:-}" \
+  --from-literal=OAUTH_COOKIE_SECRET="${OAUTH_COOKIE_SECRET:-$(python3 - <<PY
+import os,base64
+print(base64.urlsafe_b64encode(os.urandom(16)).decode())
+PY
+)}" || true
+
+echo "Apply RBAC, NetworkPolicy, oauth2-proxy, Flower deployment/service, and cert manifests:"
+kubectl apply -f services/fl/secure/rbac-restricted.yaml
+kubectl apply -f services/fl/secure/networkpolicy.yaml
+kubectl apply -f services/fl/secure/oauth2-proxy-deployment.yaml
+kubectl apply -f services/fl/k8s_deploy_flower.yaml
+kubectl apply -f services/fl/secure/k8s_service.yaml || true
+echo "Bootstrap cert-manager ClusterIssuer & Certificate for flower domain (self-signed for staging):"
+kubectl apply -f services/fl/secure/clusterissuer-selfsigned.yaml
+kubectl apply -f services/fl/secure/flower-certificate.yaml
+echo "Apply ingress (will create TLS secret aegis-flower-tls):"
+kubectl apply -f services/fl/secure/flower-ingress.yaml
+echo "DONE. Note: update aegis-core-secrets with real COSIGN/Mlflow/OAuth values before production use."
