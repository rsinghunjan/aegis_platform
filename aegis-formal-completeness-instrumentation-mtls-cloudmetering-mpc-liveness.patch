+#!/usr/bin/env bash
+#
+# Bootstrap a Vault PKI role for issuing gRPC server certs and a SecretProviderClass example.
+#
+set -euo pipefail
+VAULT_ADDR="${VAULT_ADDR:-http://127.0.0.1:8200}"
+VAULT_TOKEN="${VAULT_TOKEN:-}"
+ROLE_NAME="${ROLE_NAME:-aegis-grpc-server}"
+
+if [ -z "$VAULT_TOKEN" ]; then
+  echo "Set VAULT_TOKEN to a root or policy token with pki permissions" >&2
+  exit 2
+fi
+
+export VAULT_ADDR
+export VAULT_TOKEN
+
+echo "Enable PKI engine (if not already enabled)"
+vault secrets enable -path=pki pki || true
+vault secrets tune -max-lease-ttl=87600h pki || true
+
+echo "Generate root cert (if not present)"
+if ! vault read pki/cert/ca >/dev/null 2>&1; then
+  vault write pki/root/generate/internal common_name="aegis-root-ca" ttl=87600h > /dev/null
+fi
+
+echo "Create role $ROLE_NAME"
+vault write pki/roles/$ROLE_NAME \
+    allow_any_name=true \
+    max_ttl="72h" \
+    allow_localhost=true || true
+
+echo "Bootstrap complete. Use Vault Agent / CSI to mount /etc/certs in pods. Example SecretProviderClass is ops/vault/secretproviderclass.yaml"
+
