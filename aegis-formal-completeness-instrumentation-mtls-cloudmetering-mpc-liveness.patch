+#!/usr/bin/env python3
+"""
+Run a series of chaos experiments and aggregate results for auditors.
+ - Runs the chaos harness N times, collects /tmp/chaos_report.json snapshots and aggregates success/failure rates.
+"""
+import subprocess
+import json
+import time
+from pathlib import Path
+
+HARNESS = Path("ops/chaos/chaos_harness.py")
+OUTDIR = Path("/tmp/chaos_runs")
+OUTDIR.mkdir(parents=True, exist_ok=True)
+
+def run_one(i):
+    print("Running chaos experiment", i)
+    subprocess.run(["python3", str(HARNESS)], check=False)
+    src = Path("/tmp/chaos_report.json")
+    if src.exists():
+        dst = OUTDIR / f"chaos_report_{i}.json"
+        src.replace(dst)
+        return dst
+    return None
+
+def aggregate(n=5):
+    results = []
+    for i in range(n):
+        r = run_one(i)
+        if r:
+            with open(r) as fh:
+                results.append(json.load(fh))
+        time.sleep(5)
+    summary = {"runs": len(results), "reports": [str(p) for p in OUTDIR.glob("*.json")]}
+    out = OUTDIR / "aggregate.json"
+    out.write_text(json.dumps(summary, indent=2))
+    print("Wrote aggregate:", out)
+
+if __name__=="__main__":
+    aggregate(3)
+
