+#!/usr/bin/env python3
+"""
+AWS billing/CUR adapter to provide more accurate per-job energy estimates.
+ - Best-effort: queries Cost and Usage Report (CUR) / Cost Explorer to obtain per-instance-hour costs,
+   maps to usage to estimate kWh using instance TDP heuristics + provider energy coefficients if available.
+ - Requires boto3 and permissions to query Cost Explorer and CUR S3.
+"""
+import os
+import boto3
+from datetime import datetime, timedelta
+import json
+
+ce = boto3.client("ce", region_name=os.environ.get("AWS_REGION","us-east-1"))
+
+# Simple mapping of instance types to TDP (Watts) - refine for your fleet
+INSTANCE_TDP_W = {
+    "p3.2xlarge": 300,
+    "p4d.24xlarge": 2500,
+}
+
+def estimate_kwh_from_cost(start_date, end_date, instance_type, hours):
+    # This is a heuristic: use TDP * hours as kWh, then scale by utilization if you have it.
+    tdp = INSTANCE_TDP_W.get(instance_type, 400)
+    kwh = (tdp * hours) / 1000.0
+    return {"kwh_est": kwh, "method": "tdp_estimate", "instance_type": instance_type}
+
+def get_cost_explorer_cost(start_date, end_date, granularity="DAILY", filter=None):
+    resp = ce.get_cost_and_usage(TimePeriod={"Start":start_date,"End":end_date}, Granularity=granularity, Metrics=["UnblendedCost"])
+    return resp
+
+if __name__=="__main__":
+    print(estimate_kwh_from_cost("2023-01-01","2023-01-02","p3.2xlarge", 4))
