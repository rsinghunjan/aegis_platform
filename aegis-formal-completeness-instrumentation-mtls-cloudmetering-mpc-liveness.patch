+#!/usr/bin/env python3
+"""
+Verify that running the injector would not produce unmerged instrumented files.
+ - Runs inject_safety_monitor.py into a temporary directory and compares patched files with repo
+ - Fails if injector cannot identify instrumentation locations or if repo files remain un-instrumented.
+"""
+import shutil
+import tempfile
+from pathlib import Path
+import subprocess
+import sys
+import filecmp
+
+INJECTOR = Path("ops/autonomy/inject_safety_monitor.py")
+SCAN_PATHS = ["services", "controllers"]
+
+def run_injector(outdir):
+    cmd = ["python3", str(INJECTOR), "--paths"] + SCAN_PATHS + ["--out", outdir]
+    subprocess.check_call(cmd)
+
+def compare_and_report(patched_dir):
+    patched = Path(patched_dir)
+    problems = []
+    for f in patched.rglob("*.py"):
+        repo_file = Path(f.name)
+        if not repo_file.exists():
+            problems.append(f"Patched file {f} would add new file {repo_file}; review required")
+            continue
+        if filecmp.cmp(str(f), str(repo_file)):
+            # identical: injector found instrumentation already present
+            continue
+        else:
+            # different: patched version differs; report the repo file for review
+            problems.append(f"Patched file differs: {repo_file} (instrumentation pending)")
+    return problems
+
+def main():
+    tmp = tempfile.mkdtemp(prefix="aegis_inject_")
+    try:
+        run_injector(tmp)
+        issues = compare_and_report(tmp)
+        if issues:
+            print("Injection coverage verification failed:")
+            for i in issues:
+                print("-", i)
+            sys.exit(2)
+        print("Injection coverage verification: OK (patched files either identical or repo already instrumented)")
+    finally:
+        shutil.rmtree(tmp)
+
+if __name__=="__main__":
+    main()
+
