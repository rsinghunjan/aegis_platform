+#!/usr/bin/env python3
+"""
+Produce a mapping from TLA+ actions/variables to code locations.
+ - Parses OPA rego action names and searches controllers and services for corresponding handlers.
+ - Outputs docs/formal/proof_mapping_auto.json and a human-readable Markdown file.
+
+Usage:
+  python3 ops/formal/model_code_traceability.py --out docs/formal/proof_mapping_auto.json
+"""
+import json
+from pathlib import Path
+import re
+import argparse
+
+REPO_ROOT = Path(".")
+OUT_JSON = Path("docs/formal/proof_mapping_auto.json")
+OUT_MD = Path("docs/formal/proof_mapping.md")
+
+def find_tla_actions(tla_dir="specs/safety"):
+    actions = set()
+    for p in Path(tla_dir).rglob("*.tla"):
+        txt = p.read_text(errors="ignore")
+        # heuristic: find action names used in Next definition or Append(action_log, "action_name")
+        for m in re.findall(r'"([a-zA-Z0-9_]+)"', txt):
+            actions.add(m)
+    return sorted(actions)
+
+def grep_repo(term):
+    hits = []
+    for p in REPO_ROOT.rglob("*.py"):
+        try:
+            txt = p.read_text()
+        except Exception:
+            continue
+        for i,line in enumerate(txt.splitlines(), start=1):
+            if term in line:
+                hits.append({"path": str(p), "line": i, "snippet": line.strip()[:200]})
+    return hits
+
+def main(out):
+    actions = find_tla_actions()
+    mapping = {}
+    for a in actions:
+        hits = grep_repo(a)
+        mapping[a] = hits
+    OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
+    OUT_JSON.write_text(json.dumps(mapping, indent=2))
+    # generate MD
+    lines = ["# Model → Code Mapping (auto-generated)", ""]
+    for a, hits in mapping.items():
+        lines.append(f"## Action: `{a}`")
+        if hits:
+            for h in hits:
+                lines.append(f"- {h['path']}:{h['line']} — `{h['snippet']}`")
+        else:
+            lines.append("- No matches found (review required)")
+        lines.append("")
+    OUT_MD.write_text("\n".join(lines))
+    print("Wrote mapping to", OUT_JSON, "and", OUT_MD)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", default=str(OUT_JSON))
+    args = p.parse_args()
+    main(args.out)
+
