+#!/usr/bin/env python3
+"""
+Helpers to load TLS certs for gRPC servers from Vault CSI-mounted paths.
+Expect cert files at: /etc/certs/tls.crt, /etc/certs/tls.key, /etc/certs/ca.crt
+"""
+import os
+
+CERT_DIR = os.environ.get("GRPC_CERT_DIR", "/etc/certs")
+CRT = os.path.join(CERT_DIR, "tls.crt")
+KEY = os.path.join(CERT_DIR, "tls.key")
+CA = os.path.join(CERT_DIR, "ca.crt")
+
+def has_tls_certs():
+    return all(os.path.exists(p) for p in (CRT, KEY))
+
+def server_credentials():
+    import grpc
+    with open(CRT,"rb") as f:
+        cert_chain = f.read()
+    with open(KEY,"rb") as f:
+        private_key = f.read()
+    # optional client CA for mTLS
+    root_certificates = None
+    if os.path.exists(CA):
+        with open(CA,"rb") as f:
+            root_certificates = f.read()
+    creds = grpc.ssl_server_credentials([(private_key, cert_chain)], root_certificates=root_certificates, require_client_auth=bool(root_certificates))
+    return creds
+
+def client_credentials():
+    import grpc
+    # Create secure channel credentials (trust CA)
+    root_certificates = None
+    if os.path.exists(CA):
+        with open(CA,"rb") as f:
+            root_certificates = f.read()
+    creds = grpc.ssl_channel_credentials(root_certificates=root_certificates)
+    return creds
+
