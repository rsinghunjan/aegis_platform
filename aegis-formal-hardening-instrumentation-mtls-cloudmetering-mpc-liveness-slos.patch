+#!/usr/bin/env python3
+"""
+AWS adapter to estimate host energy usage using CloudWatch metrics.
+Best-effort mapping: sample instance GPU/CPU utilization and convert to estimated watts using instance TDP heuristics.
+Requires boto3 and cloudwatch metrics permissions.
+"""
+import os
+import boto3
+import time
+from datetime import datetime, timedelta
+
+cw = boto3.client("cloudwatch", region_name=os.environ.get("AWS_REGION","us-east-1"))
+
+INSTANCE_TDP_W = {
+    # rough TDP estimates (Watts) for popular instance families; refine for your fleet
+    "p3.2xlarge": 300,
+    "p3.8xlarge": 900,
+    "p3.16xlarge": 1500,
+    "g4dn.xlarge": 150,
+    "g4dn.12xlarge": 900,
+}
+
+def get_avg_cpu_util(instance_id, minutes=5):
+    end = datetime.utcnow()
+    start = end - timedelta(minutes=minutes)
+    resp = cw.get_metric_statistics(Namespace='AWS/EC2', MetricName='CPUUtilization', StartTime=start, EndTime=end, Period=60, Statistics=['Average'], Dimensions=[{'Name':'InstanceId','Value':instance_id}])
+    points = resp.get('Datapoints', [])
+    if not points:
+        return None
+    vals = [p['Average'] for p in points]
+    return sum(vals)/len(vals)
+
+def estimate_power_w(instance_type, cpu_util_percent):
+    tdp = INSTANCE_TDP_W.get(instance_type, 400)
+    if cpu_util_percent is None:
+        return tdp * 0.5
+    return (cpu_util_percent/100.0) * tdp
+
+def estimate_kwh_for_interval(instance_id, instance_type, minutes=5):
+    util = get_avg_cpu_util(instance_id, minutes=minutes)
+    pw = estimate_power_w(instance_type, util)
+    kwh = pw * (minutes/60.0) / 1000.0
+    return {"instance": instance_id, "instance_type": instance_type, "avg_cpu_util": util, "approx_power_w": pw, "kwh": kwh}
+
+if __name__=="__main__":
+    import sys
+    iid = sys.argv[1] if len(sys.argv)>1 else "i-unknown"
+    itype = sys.argv[2] if len(sys.argv)>2 else "g4dn.xlarge"
+    print(estimate_kwh_for_interval(iid, itype))
+
