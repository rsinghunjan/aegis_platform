+#!/usr/bin/env python3
+"""
+AST-based instrumentation linter to detect missing safety_monitor.check_and_allow or evidence writes.
+More robust than regex-based linter; will run in CI and fail PRs that add autonomous actions without instrumentation.
+"""
+import ast
+import sys
+from pathlib import Path
+import argparse
+from typing import List
+
+AUTONOMOUS_FUNCTIONS = {"perform_action", "canary_promote", "kms_alias_swap", "model_promote", "fl_round", "check_and_start_round"}
+REQUIRED_CALLS = {"check_and_allow", "record_manifest", "ensure_evidence"}
+
+class InstrumentationVisitor(ast.NodeVisitor):
+    def __init__(self):
+        self.calls = set()
+        self.found_autonomous = False
+
+    def visit_Call(self, node):
+        # function name
+        fn = None
+        if isinstance(node.func, ast.Name):
+            fn = node.func.id
+        elif isinstance(node.func, ast.Attribute):
+            fn = node.func.attr
+        if fn:
+            if fn in AUTONOMOUS_FUNCTIONS:
+                self.found_autonomous = True
+            if fn in REQUIRED_CALLS:
+                self.calls.add(fn)
+        self.generic_visit(node)
+
+def check_file(path: Path):
+    try:
+        tree = ast.parse(path.read_text(), filename=str(path))
+    except Exception:
+        return True, ""
+    v = InstrumentationVisitor()
+    v.visit(tree)
+    if v.found_autonomous and not (v.calls & REQUIRED_CALLS):
+        return False, f"File {path} contains autonomous calls but no instrumentation (missing check_and_allow/record_manifest)"
+    return True, ""
+
+def scan(paths: List[str]):
+    errors = []
+    for p in paths:
+        p = Path(p)
+        if p.is_file():
+            ok,msg = check_file(p)
+            if not ok: errors.append(msg)
+        else:
+            for f in p.rglob("*.py"):
+                ok,msg = check_file(f)
+                if not ok:
+                    errors.append(msg)
+    return errors
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--paths", nargs="+", default=["services","controllers","ops"])
+    args = ap.parse_args()
+    errs = scan(args.paths)
+    if errs:
+        print("Instrumentation AST linter found issues:")
+        for e in errs:
+            print("-", e)
+        sys.exit(2)
+    print("Instrumentation AST linter: OK")
+
+if __name__=="__main__":
+    main()
+
