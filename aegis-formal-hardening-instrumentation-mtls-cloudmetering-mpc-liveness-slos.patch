+#!/usr/bin/env python3
+"""
+Fail the CI/release if MPC is enabled in the repo configuration without an approved crypto audit.
+Searches config files and environment references for MPC_ENABLED or mpc_enabled flags.
+"""
+import sys
+import yaml
+from pathlib import Path
+
+def mpc_enabled_in_config():
+    p = Path("config/audit_status.yaml")
+    if p.exists():
+        y = yaml.safe_load(p.read_text())
+        return y.get("mpc_crypto_audit", {}).get("enabled_in_config", False)
+    # fallback: search for MPC_ENABLED in repo (best-effort)
+    for f in Path(".").rglob("*.yaml"):
+        if "mpc_enabled" in f.read_text():
+            return True
+    return False
+
+def proof_approved():
+    p = Path("config/audit_status.yaml")
+    if not p.exists():
+        return False
+    y = yaml.safe_load(p.read_text())
+    return bool(y.get("mpc_crypto_audit", {}).get("approved", False))
+
+def main():
+    if mpc_enabled_in_config() and not proof_approved():
+        print("MPC enabled in configuration but cryptography audit not approved. Blocking.")
+        sys.exit(2)
+    print("MPC audit gating: OK")
+
+if __name__=="__main__":
+    main()
