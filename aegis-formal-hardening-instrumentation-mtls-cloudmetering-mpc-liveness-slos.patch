+echo "Running TLC (TLA+ model checker) for liveness checks if available..."
+if command -v tlc >/dev/null 2>&1; then
+  tlc -deadlock -checkpoint 600 -config specs/formal/induction_parameters.cfg specs/safety/safety_spec_extended.tla > "$OUT_DIR/tlc.out" 2>&1 || true
