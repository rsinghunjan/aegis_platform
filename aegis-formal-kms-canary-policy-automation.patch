+#!/usr/bin/env python3
+"""
+Simple OPA client that evaluates the auto-approve rego policy locally using `opa` binary if present.
+Falls back to a simple rule in Python if `opa` not available.
+"""
+import subprocess, json, os
+
+def evaluate_auto_approve(action_name, evidence):
+    # Prepare input
+    inp = {"action": action_name, "evidence": evidence}
+    if shutil_which("opa"):
+        cmd = ["opa", "eval", "-i", "-", "data.aegis.autoapprove.allow"]
+        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+        out,err = p.communicate(json.dumps(inp))
+        if p.returncode != 0:
+            return False
+        # parse OPA output e.g. true/false
+        return "true" in out.lower()
+    # fallback python rule
+    if "promote_model_to_prod" in action_name:
+        return False
+    if evidence and evidence.get("manifest") == "present" and evidence.get("cosign") is True:
+        return True
+    return False
+
+def shutil_which(cmd):
+    try:
+        from shutil import which
+        return which(cmd) is not None
+    except Exception:
+        return False
+
+if __name__=="__main__":
+    import sys
+    act = sys.argv[1]
+    # sample evidence from CLI: {"manifest":"present","cosign":true}
+    ev = json.loads(sys.argv[2]) if len(sys.argv)>2 else {}
+    print(evaluate_auto_approve(act, ev))
+
