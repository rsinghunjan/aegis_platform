+#!/usr/bin/env python3
+"""
+Scans repository files for known autonomous action entrypoints and generates patched copies
+that call safety_monitor.check_and_allow(action, metadata) before performing the action.
+
+This tool is conservative: it writes patched files under patched/ for operator review.
+
+Usage:
+  python3 ops/autonomy/inject_safety_monitor.py --paths services/fl controllers services/models -o patched
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+
+PATTERNS = [
+    # common action function calls
+    (re.compile(r'perform_action\(\s*["\']([a-zA-Z0-9_]+)["\']\s*(?:,\s*([^\)]*))?\)'), "perform_action"),
+    (re.compile(r'check_and_start_round\('), "check_and_start_round"),
+    (re.compile(r'canary_promote\('), "canary_promote"),
+    (re.compile(r'kms_alias_swap\('), "kms_alias_swap"),
+]
+
+SAFETY_IMPORT = "from ops.autonomy.safety_monitor import check_and_allow\n"
+
+def inject_in_file(path, outdir):
+    text = Path(path).read_text()
+    patched = text
+    injected = False
+    # ensure import exists
+    if "check_and_allow(" not in text:
+        # naive insert after imports
+        m = re.search(r'^(import .+|from .+ import .+)$', text, re.M)
+        if m:
+            idx = m.end()
+            patched = text[:idx] + "\n" + SAFETY_IMPORT + text[idx:]
+        else:
+            patched = SAFETY_IMPORT + text
+    # wrap occurrences of known action calls
+    def repl(match):
+        nonlocal injected
+        action = match.group(1) if match.groups() else None
+        if not action:
+            # fallback: insert a generic check before the line
+            injected = True
+            return "if not check_and_allow('unknown_action', {}):\n    raise RuntimeError('blocked by safety monitor')\n" + match.group(0)
+        injected = True
+        return "if not check_and_allow('{}', {{}}):\n    raise RuntimeError('blocked by safety monitor')\n{}".format(action, match.group(0))
+
+    for pat,_name in PATTERNS:
+        patched = pat.sub(repl, patched)
+
+    if injected:
+        out_path = Path(outdir) / Path(path).name
+        out_path.parent.mkdir(parents=True, exist_ok=True)
+        out_path.write_text(patched)
+        print("Wrote patched file:", out_path)
+        return True
+    return False
+
+def scan_and_inject(paths, outdir):
+    changed = []
+    for p in paths:
+        for f in Path(p).rglob("*.py"):
+            try:
+                if inject_in_file(f, outdir):
+                    changed.append(str(f))
+            except Exception as e:
+                print("Error injecting", f, e)
+    return changed
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--paths", nargs="+", required=True)
+    p.add_argument("--out", default="patched")
+    args = p.parse_args()
+    scan_and_inject(args.paths, args.out)
+
