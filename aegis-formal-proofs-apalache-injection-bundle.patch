+#!/usr/bin/env python3
+"""
+Extended Z3 bounded model checker for Aegis safety properties.
+ - Adds simple modeling of Rekor registration and per-action evidence coverage.
+ - Adds a rudimentary DP composition check (epsilon sum limited).
+ - Emits counterexample trace when safety violated.
+
+Usage:
+  python3 tools/formal/z3_bmc_extended.py --depth 6
+"""
+import argparse
+from z3 import Int, Bool, Real, Solver, And, Or, Not, sat
+import json
+
+ACTION_SET = ["canary_promote", "kms_alias_swap", "model_promote", "fl_round"]
+REQ_KMS_APPROVALS = 2
+MAX_DP_EPSILON = 2  # example global epsilon budget (scaled integer)
+
+def mk_state(i):
+    return {
+        "evidence_coverage": Int(f"evidence_coverage_{i}"),  # 0..100
+        "dp_eps_sum": Int(f"dp_eps_sum_{i}"),               # integer scaled epsilon * 100
+        "dp_budget": Int(f"dp_budget_{i}"),
+        "mpc_enabled": Bool(f"mpc_enabled_{i}"),
+        "approvals_kms": Int(f"approvals_kms_{i}"),
+        "rekor_registered": Bool(f"rekor_registered_{i}")
+    }
+
+def transition_constraints(s, s_next, act):
+    c = []
+    c.append(And(s_next["evidence_coverage"] >= 0, s_next["evidence_coverage"] <= 100))
+    c.append(s_next["dp_budget"] >= 0)
+    c.append(s_next["approvals_kms"] >= 0)
+    # Rekor registered persists unless an action requires new evidence
+    c.append(Or(s_next["rekor_registered"] == s["rekor_registered"], s_next["rekor_registered"] == True))
+
+    if act == "canary_promote":
+        # leaves DP budget unchanged, requires evidence coverage >= 100
+        c.append(s_next["evidence_coverage"] == s["evidence_coverage"])
+        c.append(s_next["dp_eps_sum"] == s["dp_eps_sum"])
+        c.append(s_next["rekor_registered"] == True)  # assume canary must have rekor entry
+        c.append(s_next["approvals_kms"] == s["approvals_kms"])
+        c.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+    elif act == "kms_alias_swap":
+        c.append(s["approvals_kms"] >= REQ_KMS_APPROVALS)
+        c.append(s_next["evidence_coverage"] == 100)
+        c.append(s_next["dp_eps_sum"] == s["dp_eps_sum"])
+        c.append(s_next["rekor_registered"] == True)
+        c.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+        c.append(s_next["approvals_kms"] == s["approvals_kms"])
+    elif act == "model_promote":
+        c.append(s_next["evidence_coverage"] == 100)
+        c.append(s_next["dp_eps_sum"] == s["dp_eps_sum"])
+        c.append(s_next["rekor_registered"] == True)
+        c.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+        c.append(s_next["approvals_kms"] == s["approvals_kms"])
+    elif act == "fl_round":
+        # for a training round, add a non-negative epsilon (0..MAX_DP_EPSILON)
+        eps = Int(f"eps_{act}")
+        c.append(And(eps >= 0, eps <= MAX_DP_EPSILON))
+        c.append(s_next["dp_eps_sum"] == s["dp_eps_sum"] + eps)
+        c.append(s_next["dp_budget"] == s["dp_budget"])  # budget concept separate
+        # evidence may or may not be rekor-registered at this moment
+        c.append(Or(s_next["rekor_registered"] == s["rekor_registered"], s_next["rekor_registered"] == True))
+        c.append(s_next["approvals_kms"] == s["approvals_kms"])
+        c.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+
+    return And(*c)
+
+def safety_property(s):
+    # Safety: dp_eps_sum <= MAX_DP_EPSILON * some factor (here 10) and evidence_coverage == 100 for rekor-registered actions
+    return And(s["dp_eps_sum"] >= 0, s["dp_eps_sum"] <= MAX_DP_EPSILON * 10, Or(s["rekor_registered"] == False, s["evidence_coverage"] == 100))
+
+def run_bmc(depth=6):
+    s_vars = [mk_state(i) for i in range(depth+1)]
+    solver = Solver()
+    # initial state constraints
+    solver.add(s_vars[0]["evidence_coverage"] == 100)
+    solver.add(s_vars[0]["dp_eps_sum"] == 0)
+    solver.add(s_vars[0]["dp_budget"] >= 0)
+    solver.add(s_vars[0]["approvals_kms"] >= 0)
+    solver.add(s_vars[0]["mpc_enabled"] == False)
+    solver.add(s_vars[0]["rekor_registered"] == True)
+
+    # transition relation: at each step, some action occurs (OR of action-specific constraints)
+    for i in range(depth):
+        sub = []
+        for act in ACTION_SET:
+            sub.append(transition_constraints(s_vars[i], s_vars[i+1], act))
+        solver.add(Or(*sub))
+
+    # Safety violation: exists k s.t. safety_property(s_k) false OR dp_eps_sum > budget
+    bad = []
+    for i in range(depth+1):
+        bad.append(Not(safety_property(s_vars[i])))
+        bad.append(s_vars[i]["dp_eps_sum"] > MAX_DP_EPSILON * 10)
+    solver.add(Or(*bad))
+
+    res = solver.check()
+    if res == sat:
+        m = solver.model()
+        trace = []
+        for i in range(depth+1):
+            st = {}
+            for k,v in s_vars[i].items():
+                try:
+                    val = m.eval(v)
+                    st[k] = int(val.as_long()) if hasattr(val, "as_long") else bool(val)
+                except Exception:
+                    st[k] = None
+            trace.append(st)
+        print("Counterexample trace (length {}):".format(len(trace)))
+        print(json.dumps(trace, indent=2))
+        return {"sat": True, "trace": trace}
+    else:
+        print("No counterexample found up to depth", depth)
+        return {"sat": False}
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--depth", type=int, default=6)
+    args = p.parse_args()
+    run_bmc(args.depth)
+
