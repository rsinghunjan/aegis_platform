+#!/usr/bin/env bash
+#
+# Build an auditor-ready proof bundle:
+# - runs Z3 BMC
+# - runs Apalache (if docker available)
+# - collects signed manifests from EVIDENCE_DIR
+# - signs and uploads bundle to EVIDENCE_BUCKET and registers with Rekor
+#
+set -euo pipefail
+OUTDIR=${1:-/tmp/aegis_formal_proofs}
+mkdir -p "$OUTDIR"
+echo "Running Z3 BMC..."
+python3 tools/formal/z3_bmc_extended.py --depth 8 > "$OUTDIR/z3_bmc_out.txt" 2>&1 || true
+echo "Attempting Apalache run (docker)..."
+if docker image inspect aegis-apalache:local >/dev/null 2>&1; then
+  ./ops/formal/run_apalache.sh aegis-apalache:local 10 > "$OUTDIR/apalache_out.txt" 2>&1 || true
+else
+  echo "Apalache image not found; skipping" > "$OUTDIR/apalache_out.txt"
+fi
+
+echo "Collecting evidence manifests..."
+EVIDENCE_DIR=${EVIDENCE_DIR:-/tmp/evidence}
+if [ -d "$EVIDENCE_DIR" ]; then
+  cp -r "$EVIDENCE_DIR"/* "$OUTDIR/" || true
+fi
+
+tar -czf "${OUTDIR}.tar.gz" -C "$(dirname "$OUTDIR")" "$(basename "$OUTDIR")"
+echo "Bundle created: ${OUTDIR}.tar.gz"
+
+if [ -n "${COSIGN_KMS_URI:-}" ]; then
+  cosign sign-blob --key "${COSIGN_KMS_URI}" "${OUTDIR}.tar.gz" || true
+fi
+if [ -n "${EVIDENCE_BUCKET:-}" ]; then
+  aws s3 cp "${OUTDIR}.tar.gz" "s3://${EVIDENCE_BUCKET%/}/formal_proofs/$(basename ${OUTDIR}.tar.gz)" || true
+fi
+if command -v rekor-cli >/dev/null 2>&1; then
+  rekor-cli upload --artifact "${OUTDIR}.tar.gz" || true
+fi
+echo "Proof bundle published (best-effort)."
+
