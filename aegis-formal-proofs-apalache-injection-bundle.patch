+  /\ UNCHANGED << dp_eps_sum, dp_budget, mpc_enabled, approvals_kms >>
+
+FLRound ==
+  /\ \E eps \in 0..MAX_DP_EPSILON: dp_eps_sum' = dp_eps_sum + eps
+  /\ action_log' = Append(action_log, "fl_round")
+  /\ UNCHANGED << evidence_coverage, dp_budget, mpc_enabled, approvals_kms, rekor_registered >>
+
+Next ==
+  \/ CanaryPromote
+  \/ KmsAliasSwap
+  \/ ModelPromote
+  \/ FLRound
+
+SafetyInvariant ==
+  /\ dp_eps_sum <= MAX_DP_EPSILON * 10
+  /\ rekor_registered => evidence_coverage = 100
+  /\ dp_eps_sum >= 0
+
+Spec == Init /\ [][Next]_<<evidence_coverage, dp_eps_sum, dp_budget, mpc_enabled, approvals_kms, rekor_registered, action_log>>
+
+THEOREM Spec => []SafetyInvariant
+
