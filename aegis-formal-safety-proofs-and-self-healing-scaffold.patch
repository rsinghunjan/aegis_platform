+  /\ dp_budget_remaining \in Nat
+  /\ mpc_enabled = FALSE
+  /\ approvals_map \in [Actions -> Nat]
+  /\ action_log = << >>
+  /\ mpc_crypto_audit_approved = FALSE
+
+CanaryPromote ==
