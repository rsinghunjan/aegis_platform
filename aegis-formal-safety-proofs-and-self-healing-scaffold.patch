+  /\ evidence_coverage' = evidence_coverage
+  /\ dp_budget_remaining' = dp_budget_remaining
+  /\ UNCHANGED << approvals_map, mpc_enabled, mpc_crypto_audit_approved >>
+
+KmsAliasSwap ==
