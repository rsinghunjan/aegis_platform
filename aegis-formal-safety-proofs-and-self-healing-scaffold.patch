+#!/usr/bin/env python3
+"""
+Bounded model checker using Z3 for a simplified Aegis state machine.
+ - Models a small set of state variables and transitions.
+ - Unrolls transitions up to depth `k` and searches for a counterexample violating safety invariants.
+ - Produces a trace (sequence of transitions and states) when a violation is found.
+
+Usage:
+  python3 tools/formal/z3_bmc.py --depth 6
+"""
+import argparse
+from z3 import Int, Bool, Solver, And, Or, Not, If, sat
+import json
+
+ACTIONS = ["canary_promote", "kms_alias_swap", "model_promote", "fl_round"]
+REQ_KMS_APPROVALS = 2
+
+def mk_state(i):
+    return {
+        "evidence_coverage": Int(f"evidence_coverage_{i}"),
+        "dp_budget": Int(f"dp_budget_{i}"),
+        "mpc_enabled": Bool(f"mpc_enabled_{i}"),
+        "approvals_kms": Int(f"approvals_kms_{i}"),
+    }
+
+def transition_constraints(s, s_next, act):
+    c = []
+    # Evidence coverage always 0..100
+    c.append(And(s_next["evidence_coverage"] >= 0, s_next["evidence_coverage"] <= 100))
+    # dp_budget stays >= 0
+    c.append(s_next["dp_budget"] >= 0)
+    # approvals non-negative
+    c.append(s_next["approvals_kms"] >= 0)
+
+    if act == "canary_promote":
+        c.append(s_next["evidence_coverage"] == s["evidence_coverage"])
+        c.append(s_next["dp_budget"] == s["dp_budget"])
+        c.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+        c.append(s_next["approvals_kms"] == s["approvals_kms"])
+    elif act == "kms_alias_swap":
+        # require approvals >= REQ_KMS_APPROVALS to perform swap; evidence coverage must be 100 after swap
+        c.append(s["approvals_kms"] >= REQ_KMS_APPROVALS)
+        c.append(s_next["evidence_coverage"] == 100)
+        c.append(s_next["dp_budget"] == s["dp_budget"])
+        c.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+        # approvals persist
+        c.append(s_next["approvals_kms"] == s["approvals_kms"])
+    elif act == "model_promote":
+        c.append(s_next["evidence_coverage"] == 100)
+        c.append(s_next["dp_budget"] == s["dp_budget"])
+        c.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+        c.append(s_next["approvals_kms"] == s["approvals_kms"])
+    elif act == "fl_round":
+        # there exists a cost between 0 and dp_budget
+        cost = Int("cost")
+        c.append(And(cost >= 0, cost <= s["dp_budget"]))
+        c.append(s_next["dp_budget"] == s["dp_budget"] - cost)
+        c.append(s_next["evidence_coverage"] == s["evidence_coverage"])
+        c.append(s_next["mpc_enabled"] == s["mpc_enabled"])
+        c.append(s_next["approvals_kms"] == s["approvals_kms"])
+    return And(*c)
+
+def safety_property(s):
+    # dp_budget >= 0 and if mpc_enabled then approvals_kms must be >=0 and (audit requirement checked elsewhere)
+    return And(s["dp_budget"] >= 0, Or(Not(s["mpc_enabled"]), s["approvals_kms"] >= 0))
+
+def run_bmc(depth=6):
+    s_vars = [mk_state(i) for i in range(depth+1)]
+    acts = [None]*depth
+    solver = Solver()
+    # initial state constraints: evidence_coverage==100, dp_budget >= 0, approvals_kms >=0
+    solver.add(s_vars[0]["evidence_coverage"] == 100)
+    solver.add(s_vars[0]["dp_budget"] >= 0)
+    solver.add(s_vars[0]["approvals_kms"] >= 0)
+    solver.add(s_vars[0]["mpc_enabled"] == False)
+
+    # transition relation
+    for i in range(depth):
+        # choice of action at step i encoded as enumerated constraints by forcing at least one action's transition to hold
+        sub = []
+        for act in ACTIONS:
+            sub.append(transition_constraints(s_vars[i], s_vars[i+1], act))
+        solver.add(Or(*sub))
+
+    # Safety violation: exists k in 0..depth such that safety_property(s_k) is false
+    bad = []
+    for i in range(depth+1):
+        bad.append(Not(safety_property(s_vars[i])))
+    solver.add(Or(*bad))
+
+    res = solver.check()
+    if res == sat:
+        m = solver.model()
+        # extract trace
+        trace = []
+        for i in range(depth+1):
+            st = {
+                "evidence_coverage": m[s_vars[i]["evidence_coverage"]].as_long() if m.eval(s_vars[i]["evidence_coverage"]) is not None else None,
+                "dp_budget": m[s_vars[i]["dp_budget"]].as_long() if m.eval(s_vars[i]["dp_budget"]) is not None else None,
+                "mpc_enabled": m[s_vars[i]["mpc_enabled"]].is_true() if m.eval(s_vars[i]["mpc_enabled"]) is not None else None,
+                "approvals_kms": m[s_vars[i]["approvals_kms"]].as_long() if m.eval(s_vars[i]["approvals_kms"]) is not None else None,
+            }
+            trace.append(st)
+        print("Counterexample trace (length {}):".format(len(trace)))
+        print(json.dumps(trace, indent=2))
+        return {"sat": True, "trace": trace}
+    else:
+        print("No counterexample found up to depth", depth)
+        return {"sat": False}
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--depth", type=int, default=6)
+    args = p.parse_args()
+    run_bmc(args.depth)
+
