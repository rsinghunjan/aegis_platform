+#!/usr/bin/env python3
+"""
+Runtime safety monitor for autonomous actions.
+ - Subscribes to an event stream (abstracted as function calls in this scaffold).
+ - Enforces invariants before allowing actions to proceed.
+ - Triggers safe_mode and automated rollback if invariants are violated.
+ - Emits proof artifacts (logs + JSON) for auditors.
+"""
+import os, json, time, threading
+from typing import Dict
+from pathlib import Path
+from subprocess import check_call, CalledProcessError
+
+EVIDENCE_DIR = os.environ.get("EVIDENCE_DIR", "/tmp/evidence")
+Path(EVIDENCE_DIR).mkdir(parents=True, exist_ok=True)
+
+# Simple in-memory state (in production replace with distributed datastore)
+STATE = {
+    "evidence_coverage": 100,
+    "dp_budget": 1000,
+    "mpc_enabled": False,
+    "approvals_kms": 0,
+    "safe_mode": False
+}
+
+REQUIRED_KMS_APPROVALS = int(os.environ.get("REQ_KMS_APPROVALS", "2"))
+
+def record_manifest(action, details):
+    ts = int(time.time())
+    manifest = {"action": action, "details": details, "ts": ts}
+    out = os.path.join(EVIDENCE_DIR, f"safety_manifest_{action}_{ts}.json")
+    with open(out, "w") as fh:
+        json.dump(manifest, fh)
+    # attempt to sign and register (best-effort)
+    if os.environ.get("COSIGN_KMS_URI"):
+        try:
+            check_call(["cosign","sign-blob","--key",os.environ["COSIGN_KMS_URI"], out])
+        except CalledProcessError:
+            pass
+    if os.environ.get("EVIDENCE_BUCKET"):
+        try:
+            check_call(["aws","s3","cp", out, f"s3://{os.environ['EVIDENCE_BUCKET'].rstrip('/')}/safety/"])
+        except CalledProcessError:
+            pass
+    # Rekor registration best-effort
+    if shutil_which("rekor-cli"):
+        try:
+            check_call(["rekor-cli","upload","--artifact", out])
+        except CalledProcessError:
+            pass
+    return out
+
+def shutil_which(cmd):
+    from shutil import which
+    return which(cmd) is not None
+
+def check_and_allow(action: str, metadata: Dict):
+    """
+    Return True if action allowed, False otherwise (and trigger safe measures).
+    """
+    print(f"[safety_monitor] checking action {action} with state {STATE}")
+    if STATE["safe_mode"]:
+        print("[safety_monitor] system in safe_mode; rejecting autonomous action")
+        return False
+    if action == "kms_alias_swap":
+        if STATE["approvals_kms"] < REQUIRED_KMS_APPROVALS:
+            print("[safety_monitor] kms_alias_swap rejected: insufficient approvals")
+            record_manifest("kms_alias_swap_rejected", {"reason":"insufficient_approvals", "state": STATE})
+            return False
+    if action == "fl_round":
+        cost = metadata.get("cost", 0)
+        if cost > STATE["dp_budget"]:
+            print("[safety_monitor] fl_round rejected: over budget")
+            record_manifest("fl_round_rejected", {"reason":"over_budget", "cost":cost, "dp_budget": STATE["dp_budget"]})
+            return False
+    # pass: record manifest (evidence coverage asserted here)
+    manifest_path = record_manifest(action, {"metadata": metadata, "state": STATE})
+    print("[safety_monitor] action allowed; evidence recorded at", manifest_path)
+    return True
+
+def engage_safe_mode(reason="unknown"):
+    STATE["safe_mode"] = True
+    record_manifest("safe_mode_engaged", {"reason": reason, "state": STATE})
+    # possible automated recovery steps would be scheduled here
+    print("[safety_monitor] safe_mode engaged:", reason)
+
+def auto_recover():
+    # Placeholder: attempt to restore DP budget or clear transient faults.
+    print("[safety_monitor] attempting auto recovery...")
+    # simple recovery example
+    STATE["dp_budget"] = max(0, STATE["dp_budget"] - 0)
+    STATE["safe_mode"] = False
+    record_manifest("auto_recover", {"state": STATE})
+    print("[safety_monitor] recovery attempted")
+
+if __name__ == "__main__":
+    # Simple interactive demo loop
+    while True:
+        cmd = input("action> ")
+        if cmd in ("quit","exit"): break
+        if cmd.startswith("set "):
+            k,v = cmd.split()[1:]
+            if k in STATE:
+                STATE[k] = type(STATE[k])(v)
+                print("set",k,"=",STATE[k])
+            continue
+        allowed = check_and_allow(cmd, {})
+        print("allowed?", allowed)
