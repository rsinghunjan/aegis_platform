+#!/usr/bin/env python3
+"""
+A conservative self-healing controller scaffold.
+ - Before performing any autonomous operation, consults safety_monitor.check_and_allow.
+ - If action proceeds and a violation is later observed (via probes), controller attempts rollback,
+   engages safe mode, and triggers a recovery plan.
+ - Records all steps as evidence manifests (signed/uploaded if configured).
+"""
+import time, subprocess, json, os
+from ops.autonomy.safety_monitor import check_and_allow, engage_safe_mode, record_manifest
+
+def perform_action(action, metadata=None):
+    metadata = metadata or {}
+    allowed = check_and_allow(action, metadata)
+    if not allowed:
+        print("[controller] action blocked by safety monitor:", action)
+        return False
+    print("[controller] performing action:", action)
+    # simulate action execution (in real system call orchestrator)
+    try:
+        # example: for canary_promote call deployment API; here we simulate success
+        time.sleep(0.5)
+        success = True
+        if not success:
+            raise RuntimeError("action failed")
+    except Exception as e:
+        print("[controller] action error:", e)
+        # attempt rollback
+        rollback_action(action)
+        engage_safe_mode(reason=f"action_error_{action}")
+        return False
+    # post-action probes
+    if not post_action_probe(action):
+        print("[controller] post-action probe failed; rolling back")
+        rollback_action(action)
+        engage_safe_mode(reason=f"post_probe_failed_{action}")
+        return False
+    print("[controller] action completed successfully:", action)
+    return True
+
+def rollback_action(action):
