+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Build, verify and publish the detector runtime image with pinned models.
+# Requirements (env):
+#   ARTIFACT_BASE - base URL for pinned model artifacts (required)
+#   IMAGE_NAME - target image name (e.g. yourregistry/aegis-detectors:sha)
+#   COSIGN_KMS_URI - optional KMS key for cosign signing of image
+#   DOCKER_BUILDKIT=1 recommended
+ART_BASE=${ARTIFACT_BASE:-}
+IMAGE=${IMAGE_NAME:-}
+DEST=${DEST:-/opt/aegis/models}
+
+if [ -z "$ART_BASE" ]; then
+  echo "ARTIFACT_BASE must point to your artifact store (e.g. https://artifacts.internal/aegis/models)"
+  exit 2
+fi
+if [ -z "$IMAGE" ]; then
+  echo "IMAGE_NAME must be set (e.g. yourregistry/aegis-detectors:sha)"
+  exit 2
+fi
+
+set -x
+mkdir -p "$DEST"
+export ARTIFACT_BASE="$ART_BASE"
+# Fetch and verify pinned models into $DEST
+./ops/serving/models/verify_and_install_models.sh "$DEST"
+
+# Build detector image (Dockerfile.detectors)
+DOCKERFILE=ops/serving/models/Dockerfile.detectors
+docker build -f "$DOCKERFILE" -t "$IMAGE" .
+
+# Generate SBOM (syft if available)
+if command -v syft >/dev/null 2>&1; then
+  syft "$IMAGE" -o json > /tmp/sbom_detectors.json || true
+fi
+
+# Push image
+docker push "$IMAGE"
+
+# Cosign sign image if KMS provided
+if [ -n "${COSIGN_KMS_URI:-}" ] && command -v cosign >/dev/null 2>&1; then
+  COSIGN_KMS_URI="${COSIGN_KMS_URI}" cosign sign --key "$COSIGN_KMS_URI" "$IMAGE"
+fi
+
+echo "Detector image published: $IMAGE"
+
