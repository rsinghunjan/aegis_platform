+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run the calibration pipeline end-to-end:
+# 1) Prepare candidates
+# 2) Label using label_tool.py (manual step)
+# 3) Run calibrate_thresholds.py to produce thresholds.json
+# 4) Upload thresholds.json to ARTIFACT_BASE (if provided)
+CANDIDATES=${1:-ops/fl/calibration/candidates.txt}
+LABELED=${2:-ops/fl/calibration/labeled.csv}
+THRESH=${3:-/opt/aegis/models/thresholds.json}
+ART_BASE=${ARTIFACT_BASE:-}
+
+mkdir -p "$(dirname "$THRESH")"
+if [ ! -f "$LABELED" ]; then
+  echo "No labeled file found at $LABELED. Run label_tool.py to create it from $CANDIDATES"
+  echo "Example: python3 ops/fl/calibration/label_tool.py --input $CANDIDATES --out $LABELED"
+  exit 2
+fi
+
+python3 ops/fl/calibration/calibrate_thresholds.py --input "$LABELED" --target-fn 0.001 --out "$THRESH"
+echo "Wrote thresholds: $THRESH"
+
+if [ -n "$ART_BASE" ]; then
+  echo "Uploading thresholds.json to artifact store"
+  # Example: upload to S3
+  if command -v aws >/dev/null 2>&1; then
+    aws s3 cp "$THRESH" "${ART_BASE}/thresholds/$(basename $THRESH)" || true
+  else
+    echo "No S3 upload performed; configure ARTIFACT_BASE and awscli"
+  fi
+fi
+
+echo "Calibration pipeline complete"
+
