+#!/usr/bin/env bash
+set -euo pipefail
+#
+# CI pre-merge check: ensure no direct Triton/vLLM calls (enforce gateway)
+python3 - <<'PY'
+import subprocess,sys
+found=0
+import os,re
+patterns=[re.compile(r"triton"), re.compile(r"v2/models"), re.compile(r"tritonclient")]
+for fname in subprocess.check_output(["git","ls-files","*.py","*.js","*.ts"]).decode().splitlines():
+    if fname.startswith("ops/serving/gateway"): continue
+    try:
+        txt=open(fname,'r',errors='ignore').read()
+    except:
+        continue
+    for p in patterns:
+        if p.search(txt):
+            print("Direct serving usage found in", fname)
+            found=1
+            break
+if found:
+    print("Direct Triton/vLLM calls detected. Fail CI.")
+    sys.exit(2)
+print("Gateway enforcement check passed")
+PY
+
