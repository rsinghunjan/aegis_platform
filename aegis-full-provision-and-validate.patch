+/*
+Production-grade provisioning scaffold (AWS) for:
+ - KMS key for cosign (locked down and rotated)
+ - Highly-available Rekor (ECS Fargate + S3 storage) with ALB
+ - IAM roles for CI runners to use KMS
+
+Customize variables for your environment (VPC, subnets, S3 bucket, regions).
+This is an operational scaffold — review and run in a controlled environment.
+*/
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = ">= 4.0" }
+  }
+}
+provider "aws" { region = var.aws_region }
+
+variable "aws_region" { default = "us-west-2" }
+variable "rekor_image" { default = "gcr.io/rekor-project/rekor-server:latest" }
+variable "rekor_s3_bucket" { description = "S3 bucket for Rekor storage" }
+variable "rekor_subnets" { type = list(string) }
+variable "rekor_security_group_ids" { type = list(string) }
+variable "ci_runner_principal" { description = "ARN of entity allowed to use KMS (CI role/user)" }
+
+data "aws_vpc" "default" { default = true }
+
+resource "aws_kms_key" "cosign_prod" {
+  description             = "Aegis production cosign KMS key"
+  enable_key_rotation     = true
+  deletion_window_in_days = 30
+  policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [
+      {
+        Sid = "Allow administration by root account",
+        Effect = "Allow",
+        Principal = { AWS = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:root" },
+        Action = "kms:*",
+        Resource = "*"
+      },
+      {
+        Sid = "Allow CI to sign",
+        Effect = "Allow",
+        Principal = { AWS = var.ci_runner_principal },
+        Action = ["kms:Sign","kms:GetPublicKey","kms:DescribeKey"],
+        Resource = "*"
+      }
+    ]
+  })
+}
+
+resource "aws_kms_alias" "cosign_prod_alias" {
+  name          = "alias/aegis-cosign-prod"
+  target_key_id = aws_kms_key.cosign_prod.key_id
+}
+
+resource "aws_iam_role" "ci_runner_role" {
+  name = "aegis-ci-runner-role"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{
+      Effect = "Allow",
+      Principal = { Service = "ec2.amazonaws.com" },
+      Action = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_policy" "ci_runner_policy" {
+  name = "aegis-ci-runner-policy"
+  policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [
+      { Effect = "Allow", Action = ["kms:Sign","kms:GetPublicKey","kms:DescribeKey"], Resource = aws_kms_key.cosign_prod.arn },
+      { Effect = "Allow", Action = ["s3:GetObject","s3:PutObject"], Resource = "*" }
+    ]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "ci_attach" {
+  role       = aws_iam_role.ci_runner_role.name
+  policy_arn = aws_iam_policy.ci_runner_policy.arn
+}
+
+# Rekor on Fargate / ECS (HA: desired_count >=2)
+resource "aws_ecs_cluster" "rekor" { name = "aegis-rekor-cluster" }
+
+resource "aws_ecs_task_definition" "rekor" {
+  family                   = "aegis-rekor-task"
+  requires_compatibilities = ["FARGATE"]
+  cpu                      = "1024"
+  memory                   = "2048"
+  network_mode             = "awsvpc"
+  execution_role_arn       = aws_iam_role.ci_runner_role.arn
+  container_definitions = jsonencode([{
+    name  = "rekor"
+    image = var.rekor_image
+    portMappings = [{ containerPort = 3000 }]
+    environment = [
+      { name = "REKOR_STORAGE_TYPE", value = "s3" },
+      { name = "REKOR_S3_BUCKET", value = var.rekor_s3_bucket }
+    ]
+  }])
+}
+
+resource "aws_ecs_service" "rekor" {
+  name            = "aegis-rekor"
+  cluster         = aws_ecs_cluster.rekor.id
+  task_definition = aws_ecs_task_definition.rekor.arn
+  desired_count   = 2
+  launch_type     = "FARGATE"
+  network_configuration {
+    subnets         = var.rekor_subnets
+    security_groups = var.rekor_security_group_ids
+    assign_public_ip = false
+  }
+}
+
+data "aws_caller_identity" "current" {}
+
+output "cosign_kms_arn" { value = aws_kms_key.cosign_prod.arn }
+output "rekor_service_name" { value = aws_ecs_service.rekor.name }
+output "rekor_recommended_endpoint" { value = "https://<ALB_DNS_NAME_OR_LOAD_BALANCER>" }
+
