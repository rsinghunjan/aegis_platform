+#!/usr/bin/env bash
+#
+# Helper: Set CI secrets in GitHub using gh CLI.
+# Usage: ./set_github_secrets.sh <org/repo> <COSIGN_KEY_KMS_ARN> <REKOR_SERVER_URL>
+set -euo pipefail
+REPO="$1"
+COSIGN_KMS_ARN="$2"
+REKOR_SERVER="$3"
+
+if ! command -v gh >/dev/null 2>&1; then
+  echo "gh CLI required: https://cli.github.com/" >&2
+  exit 2
+fi
+
+echo "Setting COSIGN_KEY and REKOR_SERVER for $REPO"
+gh secret set COSIGN_KEY --body "kms://${COSIGN_KMS_ARN}" --repo "$REPO"
+gh secret set REKOR_SERVER --body "$REKOR_SERVER" --repo "$REPO"
+echo "Done. Remember to set COSIGN_KEY in cluster/external-secrets and Vault as well."
+
