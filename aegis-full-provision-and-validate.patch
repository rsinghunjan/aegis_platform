+#!/usr/bin/env bash
+set -euo pipefail
+ARTIFACT="$1"
+REKOR_SERVER="${REKOR_SERVER:-}"
+COSIGN_KEY="${COSIGN_KEY:-}"
+
+if [ -z "$ARTIFACT" ] || [ ! -f "$ARTIFACT" ]; then echo "artifact missing"; exit 2; fi
+if [ -z "$REKOR_SERVER" ]; then echo "REKOR_SERVER required"; exit 3; fi
+if [ -z "$COSIGN_KEY" ]; then echo "COSIGN_KEY required"; exit 4; fi
+
+# Verify cosign key looks like a KMS URI
+if ! echo "$COSIGN_KEY" | grep -E -q "kms://|arn:aws:kms"; then
+  echo "COSIGN_KEY does not look like a KMS ARN/URI"; exit 5
+fi
+
+# Verify KMS key usage via aws cli
+if command -v aws >/dev/null 2>&1; then
+  aws kms describe-key --key-id "${COSIGN_KEY#kms://}" >/dev/null
+fi
+
+# Verify Rekor entry
+./ops/ci/rekor_fail_if_missing.sh "$ARTIFACT"
+echo "Artifact verification passed (signed in KMS & Rekor entry present)"
+
