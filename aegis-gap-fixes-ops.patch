+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create a GCS bucket with retentionPolicy for evidence (GCP analog of S3 Object Lock)
+if [ $# -lt 2 ]; then
+  echo "Usage: $0 <bucket-name> <retention-days>"
+  exit 2
+fi
+BUCKET=$1; DAYS=$2
+gsutil mb gs://"$BUCKET"
+gsutil retention set "${DAYS}d" gs://"$BUCKET"
+echo "GCS bucket $BUCKET created with retention ${DAYS}d"
+
