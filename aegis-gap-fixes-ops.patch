+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Build a worker image that includes Kata runtime tools and a small runtime prober.
+# Operator must run this on a trusted build host, then push image to your registry.
+#
+IMAGE=${1:-"your-registry/aegis-worker-kata:latest"}
+WORKDIR=$(mktemp -d)
+cat > "$WORKDIR"/Dockerfile <<'EOF'
+FROM ubuntu:22.04
+ENV DEBIAN_FRONTEND=noninteractive
+RUN apt-get update && apt-get install -y ca-certificates curl python3 python3-pip && rm -rf /var/lib/apt/lists/*
+# Install kata-runtime (example; adapt to your distro / version)
+RUN apt-get update && apt-get install -y software-properties-common
+# NOTE: replace with vendor-provided Kata install steps appropriate for your nodes
+RUN apt-get install -y kata-runtime || true
+# Runtime prober (used by DaemonSet)
+COPY runtime_prober.py /usr/local/bin/runtime_prober.py
+RUN chmod +x /usr/local/bin/runtime_prober.py
+CMD ["/usr/local/bin/runtime_prober.py"]
+EOF
+
+cat > "$WORKDIR"/runtime_prober.py <<'PY'
+#!/usr/bin/env python3
+import os, sys, time, subprocess, json
+from kubernetes import client, config
+
+def detect_runtime():
+    # Try to read /proc/1/status or container runtime info
+    try:
+        out = subprocess.check_output(["/bin/sh","-c","cat /proc/1/cgroup || true"], stderr=subprocess.DEVNULL)
+    except Exception:
+        out = b""
+    # heuristic: check for kata/runsc in /proc or available binaries
+    has_kata = os.path.exists("/usr/bin/kata-runtime") or os.path.exists("/usr/sbin/kata-runtime")
+    has_runsc = os.path.exists("/usr/local/bin/runsc") or os.path.exists("/usr/bin/runsc")
+    return {"kata": has_kata, "runsc": has_runsc}
+
+def main():
+    # This image is run in a DaemonSet with RBAC to patch node labels
+    try:
+        config.load_incluster_config()
+    except Exception:
+        try: config.load_kube_config()
+        except Exception: pass
+    v1 = client.CoreV1Api()
+    node = os.environ.get("NODE_NAME") or os.uname().nodename
+    rt = detect_runtime()
+    label = "runtime.aegis/has-isolation"
+    val = "true" if (rt.get("kata") or rt.get("runsc")) else "false"
+    body = {"metadata":{"labels": {label: val}}}
+    try:
+        v1.patch_node(node, body)
+        print(f"Patched node {node} label {label}={val}")
+    except Exception as e:
+        print("Failed to patch node:", e)
+    # loop sleep to keep container alive for logs
+    while True:
+        time.sleep(300)
+
+if __name__=="__main__":
+    main()
+PY
+
+docker build -t "$IMAGE" "$WORKDIR"
+echo "Built $IMAGE; push it to registry with: docker push $IMAGE"
+rm -rf "$WORKDIR"
+
