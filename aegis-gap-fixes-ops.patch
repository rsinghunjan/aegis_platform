+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to store/retrieve cosign KMS refs / provider secrets in HashiCorp Vault
+#
+ACTION=${1:-}
+KEY=${2:-}
+VALUE=${3:-}
+VAULT_ADDR=${VAULT_ADDR:-http://127.0.0.1:8200}
+if [ "$ACTION" = "put" ]; then
+  vault kv put secret/aegis/"$KEY" value="$VALUE"
+elif [ "$ACTION" = "get" ]; then
+  vault kv get -field=value secret/aegis/"$KEY"
+else
+  echo "Usage: $0 put|get <key> [value]"
+  exit 2
+fi
