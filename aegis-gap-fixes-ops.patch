+IMAGE=${2:-}
+if [ -z "$KMS_REF" ] || [ -z "$IMAGE" ]; then
+  echo "Usage: $0 <cosign-kms-ref> <image-ref>"
+  exit 2
+fi
+if ! command -v cosign >/dev/null 2>&1; then echo "install cosign"; exit 2; fi
+TMP=$(mktemp -d)
+cosign public-key --key "$KMS_REF" > "$TMP/pubkey.pem"
+echo "Public key written to $TMP/pubkey.pem"
+echo "Verifying $IMAGE"
+cosign verify --key "$TMP/pubkey.pem" "$IMAGE"
+echo "Verify OK"
