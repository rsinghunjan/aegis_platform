+#!/usr/bin/env python3
+"""
+Simulate reconcile test:
+ - read sample billing records (local dir ./sample_billing/)
+ - call finance webhook (if configured) or simulate
+ - compare ledger (Postgres reservations) vs billed amounts and report mismatches
+"""
+import os, json, requests
+SAMPLE_DIR = "./sample_billing"
+FINANCE_WEBHOOK = os.environ.get("FINANCE_WEBHOOK","")
+def run():
+    mismatches = []
+    for fn in os.listdir(SAMPLE_DIR) if os.path.isdir(SAMPLE_DIR) else []:
+        pass
+    # simple simulated check: post each sample to webhook
+    for fn in os.listdir(SAMPLE_DIR):
+        if not fn.endswith(".json"): continue
+        rec = json.load(open(os.path.join(SAMPLE_DIR,fn)))
+        if FINANCE_WEBHOOK:
+            r = requests.post(FINANCE_WEBHOOK, json=rec, timeout=10)
+            if r.status_code != 200:
+                mismatches.append({"file":fn, "status": r.status_code, "body": r.text})
+    print("Mismatches:", mismatches)
+    return mismatches
+if __name__=="__main__":
+    run()
+
