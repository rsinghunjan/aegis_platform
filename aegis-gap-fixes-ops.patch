+name: Build, push and sign image (with cosign KMS)
+on:
+  workflow_dispatch:
+jobs:
+  build_sign_push:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Setup Docker Buildx
+        uses: docker/setup-buildx-action@v2
+      - name: Login to registry
+        uses: docker/login-action@v2
+        with:
+          registry: ${{ secrets.REGISTRY_HOST }}
+          username: ${{ secrets.REGISTRY_USER }}
+          password: ${{ secrets.REGISTRY_PASS }}
+      - name: Build and push image
+        env:
+          IMAGE_NAME: ${{ inputs.image_name || secrets.IMAGE_NAME }}
+        run: |
+          docker build -t "$IMAGE_NAME" .
+          docker push "$IMAGE_NAME"
+      - name: Install cosign
+        run: |
+          curl -sSL -o cosign https://github.com/sigstore/cosign/releases/download/v2.1.0/cosign-linux-amd64
+          chmod +x cosign; sudo mv cosign /usr/local/bin/cosign
+      - name: Sign image with KMS key ref
+        env:
+          IMAGE_NAME: ${{ inputs.image_name || secrets.IMAGE_NAME }}
+          COSIGN_KEY_REF: ${{ secrets.COSIGN_KEY_REF }}
+        run: |
+          if [ -z "$COSIGN_KEY_REF" ]; then echo "COSIGN_KEY_REF not set"; exit 1; fi
+          cosign sign --key "$COSIGN_KEY_REF" "$IMAGE_NAME"
+      - name: Export cosign public key as artifact
+        env:
+          COSIGN_KEY_REF: ${{ secrets.COSIGN_KEY_REF }}
+        run: |
+          cosign public-key --key "$COSIGN_KEY_REF" > pubkey.pem
+          mkdir -p out; mv pubkey.pem out/
+      - name: Upload pubkey artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: cosign-pubkey
+          path: out/pubkey.pem
