+#!/usr/bin/env bash
+#
+# Create a PR that adds the @require_dp_check decorator to a target function in a Python file.
+# This approach is non‑intrusive (no body edits) and is recommended when the FL orchestrator can be decorated.
+#
+# Usage:
+#  ./ops/ci/create_dp_injection_pr_decorator.sh --file services/fl/orchestrator.py --function run_round --branch add/dp-decorator --pr-title "Add DP decorator to run_round"
+#
+set -euo pipefail
+
+TARGET_FILE=""
+FUNCTION_NAME=""
+BRANCH=""
+PR_TITLE=""
+BASE_BRANCH="${BASE_BRANCH:-main}"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --file) TARGET_FILE="$2"; shift 2 ;;
+    --function) FUNCTION_NAME="$2"; shift 2 ;;
+    --branch) BRANCH="$2"; shift 2 ;;
+    --pr-title) PR_TITLE="$2"; shift 2 ;;
+    --base) BASE_BRANCH="$2"; shift 2 ;;
+    -h|--help) echo "Usage: $0 --file <path> --function <name> --branch <branch> --pr-title <title>"; exit 0 ;;
+    *) echo "Unknown arg: $1"; exit 2 ;;
+  esac
+done
+
+if [ -z "$TARGET_FILE" ] || [ -z "$FUNCTION_NAME" ] || [ -z "$BRANCH" ] || [ -z "$PR_TITLE" ]; then
+  echo "Missing required arguments"
+  exit 2
+fi
+
+if [ ! -f "$TARGET_FILE" ]; then
+  echo "Target file does not exist: $TARGET_FILE"
+  exit 2
+fi
+
+BACKUP="${TARGET_FILE}.bak.$(date +%s)"
+cp "$TARGET_FILE" "$BACKUP"
+echo "Backed up original to $BACKUP"
+
+# 1) Ensure import of decorator exists
+IMPORT_LINE="from services.fl.fl_controller_dp_enforcer import require_dp_check"
+if ! grep -q "require_dp_check" "$TARGET_FILE"; then
+  # insert import after top-level imports
+  awk -v imp="$IMPORT_LINE" 'NR==1{print; seen=0} { if(!inserted && /^import |^from /){print; seen=1; next} if(seen && !inserted){print imp; inserted=1} print }' "$BACKUP" > "$TARGET_FILE".tmp || true
+  if ! grep -q "require_dp_check" "$TARGET_FILE".tmp; then
+    (echo "$IMPORT_LINE"; cat "$BACKUP") > "$TARGET_FILE".tmp
+  fi
+  mv "$TARGET_FILE".tmp "$TARGET_FILE"
+fi
+
+# 2) Add decorator above function definition
+DECO_LINE='@require_dp_check(project="default", noise=1.0, sample_rate=0.01, steps=1)'
+# Use awk to insert the decorator before the function def
+awk -v func="$FUNCTION_NAME" -v deco="$DECO_LINE" '
+  { if (!inserted && $0 ~ ("^def[[:space:]]+" func "\\(")) { print deco; inserted=1 } print }' "$TARGET_FILE" > "$TARGET_FILE".new
+mv "$TARGET_FILE".new "$TARGET_FILE"
+
+git fetch origin "$BASE_BRANCH"
+git checkout -b "$BRANCH" "origin/$BASE_BRANCH"
+git add "$TARGET_FILE"
+git commit -m "chore: add DP enforcement decorator to $FUNCTION_NAME in $TARGET_FILE"
+git push -u origin "$BRANCH"
+
+echo "Creating PR via gh..."
+gh pr create --fill --base "$BASE_BRANCH" --head "$(git rev-parse --abbrev-ref HEAD)" --title "$PR_TITLE" --body "Automated DP decorator injection for $FUNCTION_NAME" || true
+
+echo "PR created (or attempt made). Please review the branch and adjust parameters accordingly."
+
