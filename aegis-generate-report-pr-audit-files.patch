+#!/usr/bin/env bash
+#
+# Build auditor packet (tar.gz) and draft an email template to send to external auditors.
+#
+# Usage:
+#   ./ops/evidence/build_auditor_packet_and_email.sh --evidence-bucket <bucket> --output /tmp/auditor_packet --auditor-email security-audit@auditor.example
+#
+set -euo pipefail
+
+EVIDENCE_BUCKET=""
+OUT_BASE="/tmp/aegis_audit"
+AUDITOR_EMAIL=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --evidence-bucket) EVIDENCE_BUCKET="$2"; shift 2 ;;
+    --output) OUT_BASE="$2"; shift 2 ;;
+    --auditor-email) AUDITOR_EMAIL="$2"; shift 2 ;;
+    *) echo "Unknown arg: $1"; exit 2 ;;
+  esac
+done
+
+TS=$(date +%s)
+OUT="${OUT_BASE}_${TS}"
+mkdir -p "$OUT"
+
+echo "Collecting evidence artifacts..."
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/canary_evidence/" "$OUT/canary/" || true
+  aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/kms-rotation/" "$OUT/kms/" || true
+  aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/dp_evidence/" "$OUT/dp/" || true
+  aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/audit/" "$OUT/audit/" || true
+fi
+
+# include local known artifacts if present
+cp /tmp/privacy_decision.md "$OUT/" 2>/dev/null || true
+cp /tmp/deploy_manifest.json "$OUT/" 2>/dev/null || true
+cp /tmp/canary_manifest.json "$OUT/" 2>/dev/null || true
+cp /tmp/mpc_audit_package.tar.gz "$OUT/" 2>/dev/null || true
+
+BRIEF="$OUT/briefing.md"
+cat > "$BRIEF" <<MD
+# Aegis Auditor Packet
+
+Generated: $(date -u -Iseconds)
+
+Contents:
+- Canary evidence (canary/)
+- KMS rotation manifests (kms/)
+- DP manifests (dp/)
+- MPC audit package (audit/)
+- Additional artifacts: briefing.md, deploy_manifest.json
+
+Access:
+- Rekor server: ${REKOR_SERVER:-<not set>}
+- Evidence bucket: ${EVIDENCE_BUCKET:-<not set>}
+
+Notes:
+- The auditor should validate Rekor entries and cosign signatures for manifests.
+- For MPC, run the provided audit suite (run_mpc_audit_suite.sh) and verify test vectors.
+
+MD
+
+echo "Creating PDF briefing (if pandoc available)..."
+if command -v pandoc >/dev/null 2>&1; then
+  pandoc "$BRIEF" -o "$OUT/briefing.pdf" || true
+fi
+
+TARBALL="${OUT}.tar.gz"
+tar -czf "$TARBALL" -C "$(dirname "$OUT")" "$(basename "$OUT")"
+echo "Built auditor packet: $TARBALL"
+
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  aws s3 cp "$TARBALL" "s3://${EVIDENCE_BUCKET%/}/audit_packets/$(basename $TARBALL)" || true
+  echo "Uploaded to s3://${EVIDENCE_BUCKET%/}/audit_packets/"
+fi
+
+EMAIL_TEMPLATE="$OUT/email_to_auditor.md"
+cat > "$EMAIL_TEMPLATE" <<EMAIL
+To: ${AUDITOR_EMAIL:-security-audit@auditor.example}
+Subject: Audit request — Aegis Level‑4 readiness (packet attached)
+
+Hello,
+
+We are requesting a cryptography & privacy audit of the Aegis platform. Attached is an audit packet containing:
+- Evidence manifests (canary, KMS rotation, DP)
+- MPC audit package (test vectors & coordinator)
+- Briefing and instructions
+
+Rekor server: ${REKOR_SERVER:-<not set>}
+Evidence S3 bucket: ${EVIDENCE_BUCKET:-<not set>}
+
+Requested deliverables:
+1) Cryptography review of MPC implementation with severity‑ranked findings
+2) Privacy composition review of DP accounting and FL composition
+3) Security review of KMS & signing workflows
+
+Please reply with availability for a kickoff call and any access requirements.
+
+Thanks,
+Security team — Aegis
+EMAIL
+
+echo "Built email template at: $EMAIL_TEMPLATE"
+echo "Done. Auditor packet: $TARBALL"
+
