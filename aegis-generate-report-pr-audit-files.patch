+#!/usr/bin/env python3
+"""
+Convert the JSON verification report produced by ops/verify/level4_verification.sh
+into a human-readable Markdown report using the template docs/verification_report_template.md.
+
+Usage:
+  python3 ops/verify/convert_report_to_markdown.py /tmp/level4_verification_report.json /tmp/level4_report.md
+
+If the input path is omitted, defaults to /tmp/level4_verification_report.json.
+"""
+import json
+import sys
+import os
+from datetime import datetime
+
+IN_DEFAULT = "/tmp/level4_verification_report.json"
+OUT_DEFAULT = "/tmp/level4_verification_report.md"
+
+def load_report(path):
+    with open(path, "r") as fh:
+        return json.load(fh)
+
+def bool_text(v):
+    return "PASS" if v else "FAIL"
+
+def safe_get(d, *keys, default=None):
+    cur = d
+    for k in keys:
+        if cur is None:
+            return default
+        cur = cur.get(k, default) if isinstance(cur, dict) else default
+    return cur
+
+def main():
+    inp = sys.argv[1] if len(sys.argv) > 1 else IN_DEFAULT
+    out = sys.argv[2] if len(sys.argv) > 2 else OUT_DEFAULT
+    if not os.path.exists(inp):
+        print("Input report not found:", inp)
+        sys.exit(2)
+    j = load_report(inp)
+    ts = j.get("timestamp") or int(datetime.utcnow().timestamp())
+    summary = j.get("summary", {})
+    details = j.get("details", {})
+
+    lines = []
+    lines.append("# Aegis Level‑4 Verification Report")
+    lines.append("")
+    lines.append(f"- Generated: {datetime.utcfromtimestamp(ts).isoformat()}Z")
+    lines.append("")
+    lines.append("## Summary")
+    overall = "UNKNOWN"
+    # Simple heuristic: if key checks exist
+    evidence = details.get("reparsed_report", {}).get("evidence_bucket", {})
+    dp = details.get("reparsed_report", {}).get("dp_control_loop", {})
+    mofn = details.get("reparsed_report", {}).get("mofn", {})
+    if evidence and dp and mofn:
+        ok = (evidence.get("canary") and evidence.get("kms") and evidence.get("dp") and dp.get("dp_check") and mofn.get("health"))
+        overall = "PASS" if ok else "FAIL"
+    lines.append(f"- Overall result: **{overall}**")
+    lines.append("")
+    lines.append("## Detailed Checklist")
+    # Evidence
+    lines.append("### 1) Evidence coverage")
+    canary = bool(safe_get(details, "reparsed_report", "evidence_bucket", "canary"))
+    kms = bool(safe_get(details, "reparsed_report", "evidence_bucket", "kms"))
+    dp = bool(safe_get(details, "reparsed_report", "evidence_bucket", "dp"))
+    lines.append(f"- Canary evidence present: **{bool_text(canary)}**")
+    lines.append(f"- KMS rotation manifests present: **{bool_text(kms)}**")
+    lines.append(f"- DP evidence present: **{bool_text(dp)}**")
+    rekor_missing = details.get("reparsed_report", {}).get("rekor_missing", [])
+    if rekor_missing:
+        lines.append(f"- Rekor check: **FAIL** — {len(rekor_missing)} manifests missing Rekor entries (sample: {rekor_missing[:3]})")
+    else:
+        lines.append(f"- Rekor check: **PASS**")
+
+    # DP control loop
+    lines.append("")
+    lines.append("### 2) DP control loop")
+    dp_check = bool(safe_get(details, "reparsed_report", "dp_control_loop", "dp_check"))
+    dp_report = bool(safe_get(details, "reparsed_report", "dp_control_loop", "dp_report"))
+    lines.append(f"- check_and_start_round calls observed: **{bool_text(dp_check)}**")
+    lines.append(f"- report_round calls observed: **{bool_text(dp_report)}**")
+
+    # MOFN
+    lines.append("")
+    lines.append("### 3) M-of-N & IdP")
+    mofn_health = bool(safe_get(details, "reparsed_report", "mofn", "health"))
+    lines.append(f"- MOFN health endpoint: **{bool_text(mofn_health)}**")
+
+    # KMS
+    lines.append("")
+    lines.append("### 4) KMS alias & rotation")
+    alias = bool(safe_get(details, "reparsed_report", "kms_alias_present"))
+    lines.append(f"- KMS alias present: **{bool_text(alias)}**")
+
+    # MPC audit
+    lines.append("")
+    lines.append("### 5) MPC audit readiness")
+    mpc = bool(safe_get(details, "reparsed_report", "mpc_audit_present"))
+    lines.append(f"- MPC audit package present: **{bool_text(mpc)}**")
+
+    # Rollback evidence
+    lines.append("")
+    lines.append("### 6) Canary rollback evidence")
+    rollback = bool(safe_get(details, "reparsed_report", "rollback_evidence"))
+    lines.append(f"- Rollback evidence present: **{bool_text(rollback)}**")
+
+    # Failures & remediation
+    lines.append("")
+    lines.append("## Failures & Remediation")
+    if rekor_missing:
+        lines.append(f"- Some manifests are missing Rekor entries. Suggested remediation:")
+        lines.append("  1. Run ops/evidence/register_and_verify_rekor.sh for each missing manifest to sign & upload.")
+        lines.append("  2. Add CI assertion to fail when Rekor upload fails.")
+    if not dp_check or not dp_report:
+        lines.append("- DP control loop calls not observed in FL controller logs. Suggested remediation:")
+        lines.append("  1. Inject decorator or wrapper into the FL orchestrator using ops/ci/create_dp_injection_pr.sh.")
+        lines.append("  2. Add unit/integration tests to assert calls are made.")
+    if not mpc:
+        lines.append("- MPC audit package not present. Suggested remediation:")
+        lines.append("  1. Run ops/secure_agg/production_mpc/audit/run_mpc_audit_suite.sh to produce /tmp/mpc_audit_package.tar.gz.")
+        lines.append("  2. Deliver package to auditors; track findings in remediation backlog.")
+
+    lines.append("")
+    lines.append("## Artifacts")
+    lines.append("- JSON verification report: `/tmp/level4_verification_report.json`")
+    if rekor_missing:
+        lines.append(f"- Sample missing Rekor manifests: {rekor_missing[:5]}")
+
+    lines.append("")
+    lines.append("## Conclusion")
+    lines.append("- Use the remediation actions above to iteratively reach PASS. Re-run the verification script after fixes.")
+
+    with open(out, "w") as fh:
+        fh.write("\n".join(lines))
+    print("Wrote markdown report to", out)
+
+if __name__ == "__main__":
+    main()
+
