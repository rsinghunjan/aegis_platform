+#!/usr/bin/env python3
+"""
+Evidence manifest generator
+ - Walks repo and output directories to collect artifacts and generate a manifest mapping requirements -> artifact paths
+ - Output: evidence_manifest.json suitable to include in auditor bundle
+
+Usage:
+  python3 evidence_manifest_generator.py --root . --out /tmp/evidence_manifest.json --vehicle ScoutAV --s3-base s3://aegis-evidence/scoutav/run123
+"""
+import argparse, json, os
+from glob import glob
+from datetime import datetime
+
+REQS = [
+    {"req_id":"RT-001","desc":"p99 loop jitter proof","pattern":"**/rt_slo_proof.json"},
+    {"req_id":"CTRL-001","desc":"HIL cert bundles & waveform compares","pattern":"**/*hil_cert_bundle*.tar.gz"},
+    {"req_id":"FORMAL-001","desc":"TLA+ specs & Apalache outputs","pattern":"ops/formal/*.tla"},
+    {"req_id":"PER-001","desc":"Perception OOD/adversarial results","pattern":"**/perception/ood_results.json"},
+    {"req_id":"SUP-001","desc":"Builder provenance outputs","pattern":"**/rekor_search*.json"}
+]
+
+def collect(root, pattern):
+    return sorted(set(glob(os.path.join(root, pattern), recursive=True)))
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--root", default=".")
+    p.add_argument("--out", default="/tmp/evidence_manifest.json")
+    p.add_argument("--vehicle", default="Vehicle")
+    p.add_argument("--s3-base", default="")
+    args = p.parse_args()
+    manifest = {"vehicle": args.vehicle, "generated_at": datetime.utcnow().isoformat()+"Z", "artifacts": {}}
+    for r in REQS:
+        files = collect(args.root, r["pattern"])
+        manifest["artifacts"][r["req_id"]] = {"description": r["desc"], "files": files}
+    if args.s3_base:
+        manifest["s3_base"] = args.s3_base
+    with open(args.out, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    print("Wrote evidence manifest to", args.out)
+
+if __name__ == "__main__":
+    from datetime import datetime
+    main()
+
