+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click auditor bundle builder & signer
+# Usage:
+#   COSIGN_KMS_URI=... S3_UPLOAD=s3://... ./ops/certifier/one_click_auditor_bundle.sh --out /tmp/auditor_bundle.tar.gz --vehicle ScoutAV
+
+OUT=${1:-/tmp/auditor_bundle_$(date +%s).tar.gz}
+VEHICLE=${VEHICLE:-ScoutAV}
+COSIGN=${COSIGN_KMS_URI:-}
+S3=${S3_UPLOAD:-}
+
+echo "Generating evidence manifest..."
+python3 ops/certifier/evidence_manifest_generator.py --root . --out /tmp/evidence_manifest.json --vehicle "$VEHICLE" --s3-base "$S3" || true
+
+echo "Packaging bundle..."
+tar -czf "$OUT" -C /tmp evidence_manifest.json || true
+# include discovered artifacts (best-effort)
+for f in $(python3 - <<PY
+import json,glob
+try:
+  m=json.load(open('/tmp/evidence_manifest.json'))
+  files=[]
+  for k,v in m.get('artifacts',{}).items():
+    files += v.get('files',[])
+  print(" ".join(files))
+except Exception:
+  pass
+PY
+); do
+  if [ -f "$f" ]; then
+    tar --append --file "$OUT" "$f" 2>/dev/null || true
+  fi
+done
+
+if [ -n "$COSIGN" ]; then
+  echo "Signing bundle with cosign..."
+  cosign sign --key "$COSIGN" "$OUT" || true
+fi
+if [ -n "$S3" ]; then
+  echo "Uploading bundle to S3..."
+  aws s3 cp "$OUT" "$S3/$(basename $OUT)" || true
+fi
+echo "Auditor bundle ready: $OUT"
+
