+#!/usr/bin/env bash
+#
+# Build auditor packet and short PDF briefing (if pandoc available).
+# Usage:
+#  ./ops/evidence/build_auditor_packet_with_pdf.sh --output /tmp/aegis_audit --evidence-bucket <bucket>
+set -euo pipefail
+
+OUT_BASE="/tmp/aegis_audit"
+EVIDENCE_BUCKET=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output) OUT_BASE="$2"; shift 2 ;;
+    --evidence-bucket) EVIDENCE_BUCKET="$2"; shift 2 ;;
+    *) echo "Unknown arg: $1"; exit 2 ;;
+  esac
+done
+
+TS=$(date +%s)
+OUT="${OUT_BASE}_${TS}"
+mkdir -p "$OUT"
+
+echo "Collecting artifacts..."
+# copy evidence artifacts (best-effort)
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/canary_evidence/" "$OUT/canary/" || true
+  aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/kms-rotation/" "$OUT/kms/" || true
+  aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/dp_evidence/" "$OUT/dp/" || true
+  aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/audit/" "$OUT/audit/" || true
+fi
+
+# include important local artifacts if present
+cp /tmp/privacy_decision.md "$OUT/" 2>/dev/null || true
+cp /tmp/canary_manifest.json "$OUT/" 2>/dev/null || true
+cp /tmp/deploy_manifest.json "$OUT/" 2>/dev/null || true
+
+BRIEF_MD="$OUT/briefing.md"
+cat > "$BRIEF_MD" <<MD
+# Aegis Audit Packet
+
+Generated: $(date -u -Iseconds)
+
+Contents:
+- Canary evidence (canary_evidence/)
+- KMS rotation manifests (kms-rotation/)
+- DP manifests (dp_evidence/)
+- MPC audit package (audit/)
+- Additional artifacts: privacy_decision.md, deploy_manifest.json
+
+How to verify:
+1) For each manifest, confirm Rekor entry and cosign verification.
+2) Validate DP check/reports in dp_evidence/ match runtime logs.
+3) Validate MOFN approvals for key rotations.
+
+Contact: security@your-org.example
+
+MD
+
+echo "Attempting to build PDF briefing (requires pandoc)..."
+if command -v pandoc >/dev/null 2>&1; then
+  pandoc "$BRIEF_MD" -o "$OUT/briefing.pdf" || echo "pandoc failed to produce PDF"
+else
+  echo "pandoc not found; briefing available as markdown at $BRIEF_MD"
+fi
+
+tarball="${OUT}.tar.gz"
+tar -czf "$tarball" -C "$(dirname "$OUT")" "$(basename "$OUT")"
+echo "Audit packet: $tarball"
+
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  echo "Uploading audit packet to s3://${EVIDENCE_BUCKET%/}/audit_packets/"
+  aws s3 cp "$tarball" "s3://${EVIDENCE_BUCKET%/}/audit_packets/$(basename $tarball)" || true
+fi
+
+echo "Done."
+
