+name: Level‑4 Verification
+on:
+  workflow_dispatch:
+    inputs:
+      evidence_bucket:
+        description: 'S3 evidence bucket name'
+        required: true
+      mofn_url:
+        description: 'M-of-N service URL'
+        required: true
+      fl_controller:
+        description: 'FL controller deployment name'
+        required: true
+      namespace:
+        description: 'Kubernetes namespace for FL controller'
+        required: false
+  schedule:
+    - cron: '0 7 * * *' # daily 07:00 UTC
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install requirements
+        run: |
+          sudo apt-get update -y
+          sudo apt-get install -y jq
+      - name: Run level4 verification script
+        env:
+          AWS_REGION: ${{ secrets.AWS_REGION }}
+          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
+          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+          REKOR_SERVER: ${{ secrets.REKOR_SERVER }}
+        run: |
+          chmod +x ops/verify/level4_verification.sh
+          ./ops/verify/level4_verification.sh --evidence-bucket "${{ github.event.inputs.evidence_bucket }}" --mofn-url "${{ github.event.inputs.mofn_url }}" --fl-controller "${{ github.event.inputs.fl_controller }}" --namespace "${{ github.event.inputs.namespace }}" || true
+      - name: Upload report
+        uses: actions/upload-artifact@v4
+        with:
+          name: level4-verification-report
+          path: /tmp/level4_verification_report.json
