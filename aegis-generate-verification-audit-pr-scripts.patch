+#!/usr/bin/env bash
+#
+# Create a PR that injects DP check/report calls into a specified FL orchestrator file.
+# Uses the inject script already present in ops/ci/inject_dp_wrapper.sh to perform the code edit,
+# then creates a feature branch, commits, pushes and opens a PR with gh.
+#
+# Usage:
+#  ./ops/ci/create_dp_injection_pr.sh --file services/fl/orchestrator.py --branch add/dp-checks --pr-title "Add DP checks"
+
+set -euo pipefail
+
+FILE=""
+BRANCH=""
+PR_TITLE=""
+BASE_BRANCH="${BASE_BRANCH:-main}"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --file) FILE="$2"; shift 2 ;;
+    --branch) BRANCH="$2"; shift 2 ;;
+    --pr-title) PR_TITLE="$2"; shift 2 ;;
+    --base) BASE_BRANCH="$2"; shift 2 ;;
+    -h|--help) echo "Usage: $0 --file <path> --branch <branch-name> --pr-title <title>"; exit 0 ;;
+    *) echo "Unknown arg: $1"; exit 2 ;;
+  esac
+done
+
+if [ -z "$FILE" ] || [ -z "$BRANCH" ] || [ -z "$PR_TITLE" ]; then
+  echo "Missing required args"
+  exit 2
+fi
+
+if [ ! -f "$FILE" ]; then
+  echo "File not found: $FILE"
+  exit 2
+fi
+
+echo "Creating branch $BRANCH from $BASE_BRANCH"
+git fetch origin "$BASE_BRANCH"
+git checkout -b "$BRANCH" "origin/$BASE_BRANCH"
+
+echo "Running inject script to add DP wrapper import"
+chmod +x ops/ci/inject_dp_wrapper.sh
+./ops/ci/inject_dp_wrapper.sh "$FILE"
+
+git add "$FILE"
+git commit -m "chore: inject DP check/report import into $FILE (automated edit)"
+git push -u origin "$BRANCH"
+
+echo "Creating PR via gh..."
+gh pr create --fill --base "$BASE_BRANCH" --head "$(git rev-parse --abbrev-ref HEAD)" --title "$PR_TITLE" || {
+  echo "gh pr create failed; you can open a PR manually from branch $BRANCH"
+}
+
+echo "PR creation attempted. Please review the branch and the injected changes."
+
