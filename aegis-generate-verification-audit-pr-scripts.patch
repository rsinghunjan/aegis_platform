+#!/usr/bin/env bash
+#
+# Level‑4 verification script
+# Runs a set of automated checks that determine whether the deployment meets
+# the Level‑4 acceptance criteria. Produces JSON report at /tmp/level4_verification_report.json
+#
+# Usage:
+#  ./ops/verify/level4_verification.sh --evidence-bucket <bucket> --mofn-url <url> --fl-controller <k8s-deploy-name> --namespace <ns>
+#
+set -euo pipefail
+
+EVIDENCE_BUCKET=""
+MOFN_URL=""
+FL_CONTROLLER=""
+NAMESPACE="aegis"
+REKOR_CLI="${REKOR_CLI:-rekor-cli}"
+REPORT="/tmp/level4_verification_report.json"
+TMPDIR=$(mktemp -d)
+
+usage(){
+  cat <<USAGE
+Usage: $0 --evidence-bucket <bucket> --mofn-url <url> --fl-controller <name> [--namespace <ns>]
+Generates a JSON report at $REPORT
+USAGE
+  exit 2
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --evidence-bucket) EVIDENCE_BUCKET="$2"; shift 2 ;;
+    --mofn-url) MOFN_URL="$2"; shift 2 ;;
+    --fl-controller) FL_CONTROLLER="$2"; shift 2 ;;
+    --namespace) NAMESPACE="$2"; shift 2 ;;
+    -h|--help) usage ;;
+    *) echo "Unknown arg: $1"; usage ;;
+  esac
+done
+
+if [ -z "$EVIDENCE_BUCKET" ] || [ -z "$MOFN_URL" ] || [ -z "$FL_CONTROLLER" ]; then
+  usage
+fi
+
+report='{}'
+set_report(){
+  key="$1"; val="$2"
+  report=$(echo "$report" | jq --arg k "$key" --argjson v "$val" '. + {($k): $v}')
+}
+
+ok_json(){
+  echo '{"ok":true}'
+}
+fail_json(){
+  echo '{"ok":false}'
+}
+
+echo "Level‑4 verification started. This may take a few minutes..."
+
+########################
+# 1) Evidence bucket checks
+########################
+echo "Checking S3 evidence locations..."
+canary_list=$(aws s3 ls "s3://${EVIDENCE_BUCKET}/canary_evidence/" 2>/dev/null || true)
+kms_list=$(aws s3 ls "s3://${EVIDENCE_BUCKET}/kms-rotation/" 2>/dev/null || true)
+dp_list=$(aws s3 ls "s3://${EVIDENCE_BUCKET}/dp_evidence/" 2>/dev/null || true)
+
+has_canary=false
+has_kms=false
+has_dp=false
+if [ -n "$canary_list" ]; then has_canary=true; fi
+if [ -n "$kms_list" ]; then has_kms=true; fi
+if [ -n "$dp_list" ]; then has_dp=true; fi
+
+report=$(jq -n \
+  --arg canary "$has_canary" \
+  --arg kms "$has_kms" \
+  --arg dp "$has_dp" \
+  '{evidence_bucket: {canary:$canary|test("true"), kms:$kms|test("true"), dp:$dp|test("true")}}')
+
+########################
+# 2) Rekor verification (best-effort)
+########################
+echo "Attempting Rekor verification for recently uploaded manifests (best-effort)..."
+mkdir -p "$TMPDIR/evidence"
+aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/canary_evidence/" "$TMPDIR/evidence/canary/" 2>/dev/null || true
+aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/kms-rotation/" "$TMPDIR/evidence/kms/" 2>/dev/null || true
+aws s3 cp --recursive "s3://${EVIDENCE_BUCKET}/dp_evidence/" "$TMPDIR/evidence/dp/" 2>/dev/null || true
+
+rekor_missing=()
+if command -v "$REKOR_CLI" >/dev/null 2>&1; then
+  for f in $(find "$TMPDIR/evidence" -type f -name '*.json' -maxdepth 4 2>/dev/null || true); do
+    if ! rekor-cli search --artifact "$f" >/dev/null 2>&1; then
+      rekor_missing+=("$f")
+    fi
+  done
+  report=$(echo "$report" | jq --argjson missing "$(printf '%s\n' "${rekor_missing[@]}" | jq -R -s -c 'split("\n")[:-1]')" '. + {rekor_missing:$missing}')
+else
+  report=$(echo "$report" | jq '. + {rekor_check:"rekor-cli not installed"}')
+fi
+
+########################
+# 3) DP control loop logs
+########################
+echo "Checking FL controller logs for DP check/report calls..."
+dp_check_found=false
+dp_report_found=false
+if kubectl -n "$NAMESPACE" get deploy "$FL_CONTROLLER" >/dev/null 2>&1; then
+  logs=$(kubectl -n "$NAMESPACE" logs deploy/"$FL_CONTROLLER" --tail=200 || true)
+  if echo "$logs" | grep -q "dp_check_" || echo "$logs" | grep -q "check_and_start_round"; then dp_check_found=true; fi
+  if echo "$logs" | grep -q "dp_report_" || echo "$logs" | grep -q "report_round"; then dp_report_found=true; fi
+else
+  logs="(no fl controller deployment found)"
+fi
+report=$(echo "$report" | jq --arg dp_check "$dp_check_found" --arg dp_report "$dp_report_found" '. + {dp_control_loop: {dp_check:$dp_check|test("true"), dp_report:$dp_report|test("true")}}')
+
+########################
+# 4) MOFN status check (sample request)
+########################
+echo "Checking M-of-N service health..."
+mofn_healthy=false
+mofn_resp=$(curl -sS "${MOFN_URL}/health" || true)
+if [ -n "$mofn_resp" ]; then mofn_healthy=true; fi
+report=$(echo "$report" | jq --arg mofn_health "$mofn_healthy" '. + {mofn: {health:$mofn_health}}')
+
+########################
+# 5) KMS alias verification
+########################
+echo "Checking KMS alias for cosign (best-effort)..."
+kms_alias_ok=false
+alias_name="alias/aegis/cosign"
+if aws kms list-aliases --query "Aliases[?AliasName=='${alias_name}']" >/dev/null 2>&1; then
+  # If alias exists, mark true
+  if aws kms list-aliases --query "Aliases[?AliasName=='${alias_name}'] | length(@)" --output text | grep -q '[1-9]'; then
+    kms_alias_ok=true
+  fi
+fi
+report=$(echo "$report" | jq --arg kms_alias "$kms_alias_ok" '. + {kms_alias_present:$kms_alias|test("true")}')
+
+########################
+# 6) MPC audit package presence (best-effort)
+########################
+mpc_audit_present=false
+if aws s3 ls "s3://${EVIDENCE_BUCKET}/audit/mpc_audit_package.tar.gz" >/dev/null 2>&1; then
+  mpc_audit_present=true
+fi
+report=$(echo "$report" | jq --arg mpc_audit "$mpc_audit_present" '. + {mpc_audit_present:$mpc_audit|test("true")}')
+
+########################
+# 7) Canary rollback evidence (best-effort)
+########################
+rollback_evidence=false
+if aws s3 ls "s3://${EVIDENCE_BUCKET}/canary_evidence/" >/dev/null 2>&1; then
+  if find "$TMPDIR/evidence" -type f -name '*rollback*.json' | grep -q .; then
+    rollback_evidence=true
+  fi
+fi
+report=$(echo "$report" | jq --arg rollback "$rollback_evidence" '. + {rollback_evidence:$rollback|test("true")}')
+
+########################
+# Build final JSON report
+########################
+echo "$report" | jq '{timestamp: now, summary: ., details: {reparsed_report: .}}' > "$REPORT"
+echo "Report written to $REPORT"
+
+# Print short summary to stdout for operator
+cat "$REPORT" | jq -r '.summary'
+
+# Exit code: 0 if minimal checks are OK (evidence + dp loop + mofn healthy)
+evidence_ok=false
+if [ "$has_canary" = true ] && [ "$has_kms" = true ] && [ "$has_dp" = true ]; then
+  evidence_ok=true
+fi
+
+if $evidence_ok && [ "$dp_check_found" = true ] && [ "$mofn_healthy" = true ]; then
+  echo "Level‑4 verification PASS (preliminary)"
+  exit 0
+else
+  echo "Level‑4 verification FAIL (see $REPORT for details)"
+  exit 3
+fi
+
