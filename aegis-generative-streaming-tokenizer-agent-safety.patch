+syntax = "proto3";
+package aegis.generation;
+
+message GenerationRequest {
+  string prompt = 1;
+  int32 max_tokens = 2;
+  bool stream = 3;
+}
+
+message Token {
+  string token = 1;
+  int32 index = 2;
+}
+
+message GenerationResponse {
+  repeated string tokens = 1;
+  string message = 2;
+}
+
+service Generation {
+  // Server-streaming token-by-token generation
+  rpc StreamGenerate(GenerationRequest) returns (stream Token);
+  // Unary generate (non-streaming)
+  rpc Generate(GenerationRequest) returns (GenerationResponse);
+}
+
