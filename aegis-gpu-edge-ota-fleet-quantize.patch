+#!/usr/bin/env python3
+"""
+Quantize an ONNX model using ONNXRuntime dynamic quantization and upload/sign artifacts.
+Requires onnxruntime-tools or onnxruntime.quantization
+Usage:
+  python3 services/quantize/quantize_onnx.py --input /tmp/model.onnx --output /tmp/model.quant.onnx --upload-s3 s3://aegis-models --model-id mymodel-v1
+"""
+import argparse, os, subprocess, tempfile, json, time
+
+def quantize(input_path, output_path):
+    try:
+        from onnxruntime.quantization import quantize_dynamic, QuantType
+        quantize_dynamic(input_path, output_path, weight_type=QuantType.QInt8)
+        return True
+    except Exception as e:
+        print("onnxruntime quantization error:", e)
+        return False
+
+def upload_and_sign(local_path, s3_dest, cosign_key=None):
+    if s3_dest.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", local_path, s3_dest])
+    if cosign_key:
+        subprocess.check_call(["cosign","sign","--key", cosign_key, local_path])
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--input", required=True)
+    p.add_argument("--output", required=True)
+    p.add_argument("--upload-s3", default="")
+    p.add_argument("--model-id", default="model")
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KEY_REF",""))
+    args=p.parse_args()
+    ok = quantize(args.input, args.output)
+    if not ok:
+        print("Quantization failed")
+        return
+    s3_dest = ""
+    if args.upload_s3:
+        s3_dest = f"{args.upload_s3.rstrip('/')}/{args.model_id}/{os.path.basename(args.output)}"
+        upload_and_sign(args.output, s3_dest, args.cosign_key)
+        print("Uploaded and signed", s3_dest)
+    else:
+        if args.cosign_key:
+            subprocess.check_call(["cosign","sign","--key", args.cosign_key, args.output])
+    print("Quantization pipeline complete")
+
+if __name__=="__main__":
+    main()
+
