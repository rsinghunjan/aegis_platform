+#!/usr/bin/env python3
+"""
+Create a model manifest, upload model to S3 (if local), sign artifact with cosign and optionally upload manifest to evidence bucket.
+Usage:
+  python3 ops/edge/prepare_model_manifest.py --model-path /tmp/my.onnx --model-id my-model-v1 --s3-bucket s3://aegis-models --cosign-key $COSIGN_KEY_REF
+"""
+import argparse, os, subprocess, json, tempfile, boto3, time
+
+def upload_to_s3(local_path, s3_uri):
+    # s3_uri example: s3://bucket/path/
+    subprocess.check_call(["aws","s3","cp", local_path, s3_uri])
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--model-path", required=True)
+    p.add_argument("--model-id", required=True)
+    p.add_argument("--s3-bucket", default=os.environ.get("S3_BUCKET",""))
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KEY_REF",""))
+    p.add_argument("--evidence-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    args=p.parse_args()
+
+    model_basename = os.path.basename(args.model_path)
+    s3_dest = ""
+    if args.s3_bucket:
+        s3_path = f"{args.s3_bucket.rstrip('/')}/{args.model_id}/{model_basename}"
+        print("Uploading to", s3_path)
+        upload_to_s3(args.model_path, s3_path)
+        s3_dest = s3_path
+    else:
+        s3_dest = args.model_path
+
+    manifest = {
+        "model_id": args.model_id,
+        "model_uri": s3_dest,
+        "created_at": int(time.time()),
+    }
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".json")
+    json.dump(manifest, open(tmp.name,"w"), indent=2)
+    print("Wrote manifest", tmp.name)
+    if args.cosign_key:
+        subprocess.check_call(["cosign","sign","--key", args.cosign_key, tmp.name])
+        print("Signed manifest with cosign")
+    if args.evidence_bucket:
+        s3_manifest = f"{args.evidence_bucket.rstrip('/')}/models/{os.path.basename(tmp.name)}"
+        subprocess.check_call(["aws","s3","cp", tmp.name, s3_manifest])
+        print("Uploaded manifest to", s3_manifest)
+    print("Model manifest prepared:", manifest)
+
+if __name__=="__main__":
+    main()
+
