+#!/usr/bin/env python3
+"""
+Device fleet manager (simple prototype)
+ - Tracks agents, manifests and rollouts in an SQLite DB
+ - Endpoints:
+    POST /agents/enroll -> returns agent_id
+    POST /agents/<id>/heartbeat
+    GET  /agents/<id>/manifest -> returns assigned manifest or 404
+    POST /rollouts -> create rollout targeting agents or all
+    GET /status -> quick health/status
+"""
+import os, sqlite3, uuid, time, json
+from flask import Flask, request, jsonify
+
+DB = os.environ.get("FLEET_DB","/data/fleet.db")
+os.makedirs(os.path.dirname(DB), exist_ok=True)
+conn = sqlite3.connect(DB, check_same_thread=False)
+cur = conn.cursor()
+cur.execute("CREATE TABLE IF NOT EXISTS agents(id TEXT PRIMARY KEY, hostname TEXT, last_seen INTEGER, manifest TEXT)")
+cur.execute("CREATE TABLE IF NOT EXISTS manifests(id TEXT PRIMARY KEY, manifest_json TEXT)")
+cur.execute("CREATE TABLE IF NOT EXISTS rollouts(id TEXT PRIMARY KEY, payload TEXT, created_at INTEGER)")
+conn.commit()
+
+app = Flask(__name__)
+
+@app.route("/agents/enroll", methods=["POST"])
+def enroll():
+    h = request.json.get("hostname") or "unknown"
+    aid = str(uuid.uuid4())
+    cur.execute("INSERT INTO agents(id, hostname, last_seen, manifest) VALUES (?, ?, ?, ?)", (aid, h, int(time.time()), None))
+    conn.commit()
+    return jsonify({"agent_id": aid})
+
+@app.route("/agents/<aid>/heartbeat", methods=["POST"])
+def heartbeat(aid):
+    cur.execute("UPDATE agents SET last_seen = ? WHERE id = ?", (int(time.time()), aid))
+    conn.commit()
+    cur.execute("SELECT manifest FROM agents WHERE id = ?", (aid,))
+    row = cur.fetchone()
+    return jsonify({"ok": True, "manifest": json.loads(row[0]) if row and row[0] else None})
+
+@app.route("/agents/<aid>/manifest", methods=["GET"])
+def get_manifest(aid):
+    cur.execute("SELECT manifest FROM agents WHERE id = ?", (aid,))
+    row = cur.fetchone()
+    if row and row[0]:
+        return jsonify(json.loads(row[0]))
+    return ("", 404)
+
+@app.route("/manifests", methods=["POST"])
+def create_manifest():
+    m = request.json
+    mid = m.get("model_id") or str(uuid.uuid4())
+    cur.execute("INSERT OR REPLACE INTO manifests(id, manifest_json) VALUES (?, ?)", (mid, json.dumps(m)))
+    conn.commit()
+    return jsonify({"id": mid})
+
+@app.route("/rollouts", methods=["POST"])
+def rollout():
+    payload = request.json
+    rid = str(uuid.uuid4())
+    # simple: assign manifest to all agents or targeted agent ids
+    target = payload.get("target","all")
+    manifest = payload.get("manifest")
+    if target == "all":
+        cur.execute("UPDATE agents SET manifest = ?", (json.dumps(manifest),))
+    else:
+        for aid in payload.get("agent_ids",[]):
+            cur.execute("UPDATE agents SET manifest = ? WHERE id = ?", (json.dumps(manifest), aid))
+    conn.commit()
+    cur.execute("INSERT INTO rollouts(id, payload, created_at) VALUES (?, ?, ?)", (rid, json.dumps(payload), int(time.time())))
+    conn.commit()
+    return jsonify({"rollout_id": rid})
+
+@app.route("/status", methods=["GET"])
+def status():
+    cur.execute("SELECT id, hostname, last_seen FROM agents")
+    rows = cur.fetchall()
+    stats = [{"id": r[0], "host": r[1], "last_seen": r[2]} for r in rows]
+    return jsonify({"agents": stats})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("FLEET_PORT", "8080")))
+
