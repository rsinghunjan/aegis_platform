+#!/usr/bin/env python3
+"""
+Edge device agent (lightweight):
+ - Enrolls with fleet manager
+ - Heartbeats with status
+ - Polls for assigned model manifest, downloads model artifact, verifies cosign signature (requires cosign binary)
+ - Loads ONNX model with ONNXRuntime for local inference (simple smoke)
+
+Environment variables:
+ - AEGIS_AGENT_ID (unique id) or auto-assigned by enroll
+ - AEGIS_SERVER_URL (fleet manager base URL)
+ - S3_BUCKET (optional, fallback)
+ - POLL_INTERVAL_SECONDS (default 60)
+"""
+import os, time, json, subprocess, requests, tempfile, shutil
+from urllib.parse import urljoin
+
+AGENT_ID = os.environ.get("AEGIS_AGENT_ID","")
+SERVER = os.environ.get("AEGIS_SERVER_URL","http://fleet-manager:8080/")
+POLL = int(os.environ.get("POLL_INTERVAL_SECONDS","60"))
+S3_BUCKET = os.environ.get("S3_BUCKET","")
+
+def enroll():
+    global AGENT_ID
+    if AGENT_ID:
+        return AGENT_ID
+    url = urljoin(SERVER, "/agents/enroll")
+    r = requests.post(url, json={"hostname": os.uname().nodename}, timeout=10)
+    r.raise_for_status()
+    AGENT_ID = r.json().get("agent_id")
+    print("Enrolled as", AGENT_ID)
+    return AGENT_ID
+
+def heartbeat(agent_id):
+    url = urljoin(SERVER, f"/agents/{agent_id}/heartbeat")
+    r = requests.post(url, json={"ts": time.time()}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def fetch_manifest(agent_id):
+    url = urljoin(SERVER, f"/agents/{agent_id}/manifest")
+    r = requests.get(url, timeout=10)
+    if r.status_code == 200:
+        return r.json()
+    return None
+
+def download_and_verify(manifest):
+    # manifest: {model_uri: s3://..., manifest_uri: s3://..., cosign_key: "..." }
+    model_uri = manifest.get("model_uri")
+    if not model_uri:
+        return False, "no_model"
+    tmpdir = tempfile.mkdtemp()
+    local_model = os.path.join(tmpdir, os.path.basename(model_uri))
+    # support s3:// via awscli if installed, else HTTP
+    if model_uri.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", model_uri, local_model])
+    elif model_uri.startswith("http"):
+        r = requests.get(model_uri, timeout=30)
+        r.raise_for_status()
+        open(local_model,"wb").write(r.content)
+    else:
+        # treat as local path
+        shutil.copy(model_uri, local_model)
+    # Verify cosign signature if available
+    cosign_key = manifest.get("cosign_key") or os.environ.get("COSIGN_KEY_REF","")
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","verify","--key", cosign_key, local_model])
+        except subprocess.CalledProcessError as e:
+            return False, f"cosign_verify_failed:{e}"
+    # Smoke run ONNXRuntime if onnx
+    if local_model.endswith(".onnx"):
+        import onnxruntime as ort
+        sess = ort.InferenceSession(local_model)
+        print("Loaded ONNX model with", len(sess.get_inputs()), "inputs")
+    print("Model downloaded & verified at", local_model)
+    return True, local_model
+
+def main():
+    agent_id = enroll()
+    while True:
+        try:
+            hb = heartbeat(agent_id)
+            manifest = fetch_manifest(agent_id)
+            if manifest:
+                ok, info = download_and_verify(manifest)
+                if ok:
+                    print("Model ready:", info)
+                else:
+                    print("Model fetch/verify failed:", info)
+            else:
+                print("No manifest assigned")
+        except Exception as e:
+            print("Agent error:", e)
+        time.sleep(POLL)
+
+if __name__=="__main__":
+    main()
+
