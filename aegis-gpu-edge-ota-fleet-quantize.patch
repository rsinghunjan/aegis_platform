+#!/usr/bin/env python3
+"""
+Simple OTA/Model serving server for edge devices (operator-run).
+ - Serves model artifacts and manifests from S3 or local storage
+ - Minimal auth via an API key (operator sets OTA_API_KEY)
+"""
+import os, boto3, flask, tempfile, subprocess
+from flask import request, jsonify, send_file
+
+app = flask.Flask(__name__)
+S3_BUCKET = os.environ.get("S3_BUCKET","")
+OTA_API_KEY = os.environ.get("OTA_API_KEY","change-me")
+
+def auth_ok(req):
+    key = req.headers.get("X-Api-Key") or req.args.get("api_key")
+    return key == OTA_API_KEY
+
+@app.route("/models/<model_id>/manifest", methods=["GET"])
+def get_manifest(model_id):
+    if not auth_ok(request):
+        return jsonify({"error":"unauth"}), 403
+    # manifest path in S3: models/<model_id>/manifest.json
+    if S3_BUCKET:
+        s3 = boto3.client("s3")
+        bucket, _, prefix = S3_BUCKET.replace("s3://","").partition("/")
+        key = f"models/{model_id}/manifest.json"
+        tmp = tempfile.NamedTemporaryFile(delete=False)
+        s3.download_file(bucket, key, tmp.name)
+        return send_file(tmp.name, mimetype="application/json")
+    else:
+        path = f"./models/{model_id}/manifest.json"
+        if os.path.exists(path):
+            return send_file(path, mimetype="application/json")
+        return jsonify({"error":"not_found"}), 404
+
+@app.route("/models/<model_id>/artifact", methods=["GET"])
+def get_artifact(model_id):
+    if not auth_ok(request):
+        return jsonify({"error":"unauth"}), 403
+    if S3_BUCKET:
+        s3 = boto3.client("s3")
+        bucket, _, prefix = S3_BUCKET.replace("s3://","").partition("/")
+        key = f"models/{model_id}/{request.args.get('file')}"
+        tmp = tempfile.NamedTemporaryFile(delete=False)
+        s3.download_file(bucket, key, tmp.name)
+        return send_file(tmp.name, as_attachment=True)
+    else:
+        path = f"./models/{model_id}/{request.args.get('file')}"
+        if os.path.exists(path):
+            return send_file(path, as_attachment=True)
+        return jsonify({"error":"not_found"}), 404
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("OTA_PORT","8300")))
+
