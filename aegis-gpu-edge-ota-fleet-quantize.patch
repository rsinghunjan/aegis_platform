+#!/usr/bin/env bash
+set -euo pipefail
+# This script runs from an operator machine or as a Job to ensure GPU nodes are labeled consistently.
+kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{" "}{range .status.allocatable}{@}{end}{"\n"}{end}' || true
+for n in $(kubectl get nodes -o name | sed 's/node\///g'); do
+  if kubectl get node $n -o json | jq -e '.status.allocatable["nvidia.com/gpu"]' >/dev/null 2>&1; then
+    kubectl label node $n node-role.kubernetes.io/gpu=true --overwrite || true
+    kubectl label node $n node-role.aegis=gpu --overwrite || true
+    echo "Labeled node $n as GPU"
+  fi
+done
