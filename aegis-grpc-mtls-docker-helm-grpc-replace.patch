+#!/usr/bin/env python3
+"""
+GRPCServerManager
+ - Starts a gRPC server factory callable and monitors TLS cert files for changes.
+ - On cert change, gracefully stops the server and restarts it with new credentials.
+ This allows zero-touch cert rotation when cert files are replaced by Vault CSI.
+
+Usage:
+  from ops.grpc.grpc_server_manager import GRPCServerManager
+  def make_server(creds):
+      s = grpc.server(...) ; add servicer ; return (s, port)
+  mgr = GRPCServerManager(make_server, cert_dir="/etc/certs")
+  mgr.serve_forever()
+"""
+import os
+import time
+import threading
+import grpc
+from pathlib import Path
+from typing import Callable, Optional, Tuple
+
+CERT_FILES = ["tls.crt", "tls.key", "ca.crt"]
+
+def cert_mtime(cert_dir: str) -> float:
+    t = 0.0
+    for c in CERT_FILES:
+        p = Path(cert_dir) / c
+        if p.exists():
+            t = max(t, p.stat().st_mtime)
+    return t
+
+class GRPCServerManager:
+    def __init__(self, server_factory: Callable[[Optional[grpc.ServerCredentials]], Tuple[grpc.Server,int]], cert_dir: str="/etc/certs", poll_interval: float=5.0):
+        """
+        server_factory: callable that accepts server_credentials or None and returns (server, port)
+        cert_dir: directory where tls.crt, tls.key, ca.crt are mounted
+        """
+        self.server_factory = server_factory
+        self.cert_dir = cert_dir
+        self.poll_interval = poll_interval
+        self._stop = threading.Event()
+        self._server = None
+        self._port = None
+        self._mt = 0.0
+
+    def _load_credentials(self) -> Optional[grpc.ServerCredentials]:
+        from ops.grpc.tls_helpers import has_tls_certs, server_credentials
+        if has_tls_certs():
+            try:
+                return server_credentials()
+            except Exception:
+                return None
+        return None
+
+    def serve_forever(self):
+        # initial start
+        creds = self._load_credentials()
+        self._mt = cert_mtime(self.cert_dir)
+        self._server, self._port = self.server_factory(creds)
+        print(f"[grpc-manager] started server on port {self._port} (mt={self._mt})")
+
+        try:
+            while not self._stop.is_set():
+                time.sleep(self.poll_interval)
+                new_mt = cert_mtime(self.cert_dir)
+                if new_mt != self._mt:
+                    print("[grpc-manager] cert change detected; restarting server to reload TLS credentials")
+                    self._mt = new_mt
+                    # stop old server
+                    try:
+                        self._server.stop(5).wait()
+                    except Exception:
+                        pass
+                    # start new server with new creds
+                    creds = self._load_credentials()
+                    self._server, self._port = self.server_factory(creds)
+                    print(f"[grpc-manager] restarted server on port {self._port}")
+        except KeyboardInterrupt:
+            pass
+        finally:
+            try:
+                if self._server:
+                    self._server.stop(5).wait()
+            except Exception:
+                pass
+
+    def stop(self):
+        self._stop.set()
+
