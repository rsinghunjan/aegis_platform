+#!/usr/bin/env python3
+"""
+Search for common HTTP usages (DP check_run, direct POST to DP service, evidence uploader direct AWS/rekor calls)
+and produce .patch files that replace them with gRPC client calls (ops.grpc.dp_client.DPClient and ops.grpc.evidence_client.EvidenceClient).
+
+This script does NOT modify the repo; it writes patches to the output dir for review.
+
+Usage:
+  python3 ops/grpc/replace_http_with_grpc_and_generate_patches.py --out patches_grpc_replace
+"""
+import argparse
+from pathlib import Path
+import re
+import difflib
+import os
+
+REPO = Path(".")
+OUT = Path("patches_grpc_replace")
+OUT.mkdir(parents=True, exist_ok=True)
+
+# Patterns to replace: (file pattern, regex, replacement function)
+REPLACEMENTS = [
+    # Replace dp_accounting.shard_check(...) calls with DPClient().check_run(...)
+    {
+        "regex": re.compile(r"(\bshard_check\s*\()\s*([^)]*)\)"),
+        "desc": "dp_accounting.shard_check -> DPClient.check_run",
+        "file_glob": "**/services/**/*.py"
+    },
+    # Replace requests.post(.../check_run) with DPClient
+    {
+        "regex": re.compile(r"requests\.post\(\s*f?\"[^\"]*/check_run\"[^\)]*\)"),
+        "desc": "requests.post to /check_run -> DPClient.check_run",
+        "file_glob": "**/*.py"
+    },
+]
+
+def apply_replacements(text, filename):
+    new = text
+    changed = False
+    # ensure import of dp client when replacing dp usages
+    if "shard_check(" in text or "/check_run" in text:
+        if "from ops.grpc.dp_client import DPClient" not in text:
+            new = "from ops.grpc.dp_client import DPClient\n" + new
+            changed = True
+    # heuristic replacements (non-perfect)
+    new = re.sub(r'\bshard_check\s*\(\s*([^,)\n]+)\s*(?:,\s*([^,)\n]+))?\s*(?:,\s*([^,)\n]+))?\s*(?:,\s*([^,)\n]+))?\s*\)',
+                 r'DPClient().check_run(\1)', new)
+    new = re.sub(r'requests\.post\(\s*f?\"[^\"]*/check_run\"[^\)]*\)',
+                 r'DPClient().check_run(project="", modality="")', new)
+    # replace direct aws s3 cp + rekor-cli upload patterns with EvidenceClient.register usage (best-effort)
+    if "rekor-cli upload" in new or "aws s3 cp" in new:
+        if "from ops.grpc.evidence_client import EvidenceClient" not in new:
+            new = "from ops.grpc.evidence_client import EvidenceClient\n" + new
+            changed = True
+        # naive: insert placeholder usage comment
+        new = new.replace("rekor-cli upload", "# TODO: use EvidenceClient.register(...) instead of rekor-cli upload")
+    return new, changed
+
+def make_patch(path, new_text):
+    old = path.read_text()
+    if old == new_text:
+        return False
+    diff = difflib.unified_diff(old.splitlines(True), new_text.splitlines(True), fromfile=str(path), tofile=str(path)+".grpc")
+    outp = OUT / (str(path).replace("/","_") + ".patch")
+    outp.write_text("".join(diff))
+    print("Wrote patch:", outp)
+    return True
+
+def run():
+    files = list(REPO.rglob("*.py"))
+    any_patch = False
+    for f in files:
+        try:
+            txt = f.read_text()
+        except Exception:
+            continue
+        new, changed = apply_replacements(txt, f)
+        if changed:
+            ok = make_patch(f, new)
+            any_patch = any_patch or ok
+    if not any_patch:
+        print("No grpc-replacement patches generated (repo may already use gRPC clients or pattern not found)")
+
+if __name__ == "__main__":
+    run()
+
