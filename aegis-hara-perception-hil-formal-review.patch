+#!/usr/bin/env bash
+set -euo pipefail
+#
+# End-to-end test runner to execute perception redundancy tests and safe-stop campaigns, then package & sign artifacts.
+#
+DATASET=${1:-/data/synced.ndjson}
+OUTDIR=${2:-/tmp/aegis_perception_hil_$(date +%s)}
+NODE=${3:-localhost}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+REKOR_SERVER=${REKOR_SERVER:-}
+
+mkdir -p "$OUTDIR"
+echo "[1] Run perception redundancy evaluation"
+python3 ops/robotics/certification/perception_redundancy_test.py --dataset "$DATASET" --out "$OUTDIR/perception_eval"
+
+echo "[2] Run safe-stop tester against node and collect output"
+python3 ops/robotics/rt/lab_validation/safe_stop_tester.py --target "$NODE" --duration 5 --out "$OUTDIR/safe_stop.json" || true
+
+echo "[3] Collect RT jitter result if present"
+if [ -f /tmp/rt_jitter_result.json ]; then
+  cp /tmp/rt_jitter_result.json "$OUTDIR/" || true
+fi
+
+echo "[4] Package artifacts"
+tar -czf "${OUTDIR}.tar.gz" -C "$(dirname "$OUTDIR")" "$(basename "$OUTDIR")"
+echo "Artifacts packaged to ${OUTDIR}.tar.gz"
+
+if [ -n "$COSIGN_KMS_URI" ]; then
+  echo "[5] Sign artifact bundle with cosign KMS"
+  cosign sign --key "$COSIGN_KMS_URI" "${OUTDIR}.tar.gz" || true
+  if [ -n "$REKOR_SERVER" ]; then
+    echo "[6] Verify Rekor entry (best-effort)"
+    rekor-cli search --rekor_server "$REKOR_SERVER" --artifact "${OUTDIR}.tar.gz" > "$OUTDIR/rekor_search.json" 2>/dev/null || true
+  fi
+fi
+
+echo "[7] Record evidence manifest"
+python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("perception_hil_campaign", {"bundle":"${OUTDIR}.tar.gz"})
+print("Evidence recorded")
+PY
+
+echo "Perception & Safe-stop workflow finished. Artifact: ${OUTDIR}.tar.gz"
+
