+---- MODULE controller_full_spec ----
+EXTENDS Naturals, Sequences, TLC
+(* Expanded TLA+ specification for controller safety including:
+   - command bounds
+   - watchdog semantics
+   - human presence effect on command limits
+   - simple timing model for safe-stop
+*)
+CONSTANTS NumJoints, MaxCmd, MinCmd, SafetyMargin
+ASSUME NumJoints = 12
+ASSUME MaxCmd = 100
+ASSUME MinCmd = -100
+ASSUME SafetyMargin = 1
+
+VARIABLES time, joint_pos, command, last_command_time, human_present, safe_mode
+
+Init ==
+  /\ time = 0
+  /\ joint_pos = [i \in 1..NumJoints |-> 0]
+  /\ command = [i \in 1..NumJoints |-> 0]
+  /\ last_command_time = 0
+  /\ human_present = FALSE
+  /\ safe_mode = FALSE
+
+(* Next-step: commands may be issued; if no command for watchdog_timeout, safe_mode engages *)
+WatchdogTimeout == 5
+
+Next ==
+  \/ \E newCmd \in [1..NumJoints -> Int] :
+       /\ command' = newCmd
+       /\ last_command_time' = time
+       /\ time' = time + 1
+       /\ human_present' \in BOOLEAN
+       /\ safe_mode' = FALSE
+       /\ joint_pos' = [i \in 1..NumJoints |-> joint_pos[i] + command[i]]
+  \/ /\ time' = time + 1
+     /\ last_command_time' = last_command_time
+     /\ command' = command
+     /\ human_present' \in BOOLEAN
+     /\ if time - last_command_time >= WatchdogTimeout then safe_mode' = TRUE else safe_mode' = safe_mode
+     /\ joint_pos' = joint_pos
+
+(* Safety invariants *)
+CommandBounds ==
+  \A i \in 1..NumJoints :
+    IF human_present THEN command[i] >= -SafetyMargin /\ command[i] <= SafetyMargin
+    ELSE command[i] >= MinCmd /\ command[i] <= MaxCmd
+
+SafeModeImpliesZero ==
+  safe_mode => (\A i \in 1..NumJoints : command[i] = 0)
+
+Spec == Init /\ [][Next]_<<time, joint_pos, command, last_command_time, human_present, safe_mode>>
+
+THEOREM ControllerSafe == Spec => [] (CommandBounds /\ SafeModeImpliesZero)
+
+==== 
+
