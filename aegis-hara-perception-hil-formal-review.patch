+#!/usr/bin/env python3
+"""
+Perception redundancy evaluation harness.
+ - Input: synced labeled dataset (ndjson); expected fields: sensors.camera, sensors.lidar (optional), label.human_present (bool)
+ - Runs one or more detector commands (pluggable) or uses built-in heuristics to evaluate FNR/FPR at various ranges and confidences.
+ - Outputs: perception_evaluation.json, FNR/FPR CSV and records MLflow run + evidence manifest.
+
+Usage:
+  python ops/robotics/certification/perception_redundancy_test.py --dataset /data/synced.ndjson --out ./perception_eval
+"""
+import argparse, json, os, csv, time
+from ops.sdk.evidence_sdk import record_manifest
+try:
+    import mlflow
+except Exception:
+    mlflow = None
+
+def simple_detector(record, confidence_threshold=0.5):
+    # heuristic: if image size non-empty and frame_idx % 5 != 0 -> human_detected
+    # replace with real model invocation in production
+    present = record.get("meta", {}).get("caption", "") != ""
+    conf = 0.9 if present else 0.1
+    return {"human_detected": conf >= confidence_threshold, "confidence": conf}
+
+def evaluate(dataset_path, out_dir, detectors=None, confs=[0.5]):
+    os.makedirs(out_dir, exist_ok=True)
+    gt = []
+    with open(dataset_path) as fh:
+        for line in fh:
+            j = json.loads(line)
+            # ground truth: meta.human_present or label file (prefer labels)
+            human = j.get("meta", {}).get("human_present", None)
+            if human is None:
+                # fallback heuristic: caption present -> human
+                human = bool(j.get("meta", {}).get("caption"))
+            gt.append((j, human))
+
+    results = []
+    csv_path = os.path.join(out_dir, "fnr_fpr.csv")
+    with open(csv_path, "w", newline="") as csvfile:
+        writer = csv.DictWriter(csvfile, fieldnames=["conf_threshold","tp","tn","fp","fn","fnr","fpr"])
+        writer.writeheader()
+        for conf in confs:
+            tp = tn = fp = fn = 0
+            for rec, human in gt:
+                det = simple_detector(rec, confidence_threshold=conf)
+                detected = det["human_detected"]
+                if detected and human:
+                    tp += 1
+                elif (not detected) and (not human):
+                    tn += 1
+                elif detected and (not human):
+                    fp += 1
+                elif (not detected) and human:
+                    fn += 1
+            fnr = fn / (fn + tp) if (fn + tp) > 0 else 0.0
+            fpr = fp / (fp + tn) if (fp + tn) > 0 else 0.0
+            writer.writerow({"conf_threshold":conf,"tp":tp,"tn":tn,"fp":fp,"fn":fn,"fnr":fnr,"fpr":fpr})
+            results.append({"conf_threshold":conf,"tp":tp,"tn":tn,"fp":fp,"fn":fn,"fnr":fnr,"fpr":fpr})
+
+    out_json = os.path.join(out_dir, "perception_evaluation.json")
+    with open(out_json, "w") as fh:
+        json.dump({"results": results, "dataset": dataset_path, "timestamp": time.time()}, fh, indent=2)
+
+    # MLflow logging
+    if mlflow:
+        mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://localhost:5000"))
+        with mlflow.start_run(run_name=f"perception_eval_{os.path.basename(dataset_path)}") as r:
+            mlflow.log_artifact(out_json, artifact_path="perception_eval")
+            mlflow.log_artifact(csv_path, artifact_path="perception_eval")
+            run_id = r.info.run_id
+    else:
+        run_id = None
+
+    # evidence manifest
+    try:
+        record_manifest("perception_redundancy_eval", {"dataset": dataset_path, "out": out_json, "mlflow_run": run_id})
+    except Exception:
+        pass
+
+    return out_json, csv_path
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--dataset", required=True)
+    p.add_argument("--out", default="./perception_eval")
+    p.add_argument("--conf-list", default="0.3,0.5,0.7")
+    args = p.parse_args()
+    confs = [float(x) for x in args.conf_list.split(",")]
+    evaluate(args.dataset, args.out, confs=confs)
+    print("Perception redundancy evaluation completed")
+
