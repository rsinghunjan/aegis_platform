+"""
+Vendor integration adapter for vetted watermark providers.
+ - Try local vendor package (vendor_watermark). If not present, expose a clear error so operators must configure vendor.
+ - Provides a thin shim with embed/detect interfaces used by the serving code.
+"""
+import os
+import importlib
+
+VENDOR_MODE = os.environ.get("WATERMARK_VENDOR_MODE", "local")  # "local" or "remote"
+
+if VENDOR_MODE == "local":
+    try:
+        vendor = importlib.import_module("vendor_watermark")
+    except Exception as e:
+        vendor = None
+        _vendor_err = e
+else:
+    vendor = None
+
+def embed(image_bytes: bytes, payload: str, **kwargs) -> bytes:
+    if vendor:
+        return vendor.embed(image_bytes, payload, **kwargs)
+    raise RuntimeError("No local watermark vendor available; configure WATERMARK_VENDOR_MODE and vendor API.")
+
+def detect(image_bytes: bytes, payload: str, **kwargs) -> bool:
+    if vendor:
+        return vendor.detect(image_bytes, payload, **kwargs)
+    raise RuntimeError("No local watermark vendor available; configure WATERMARK_VENDOR_MODE and vendor API.")
