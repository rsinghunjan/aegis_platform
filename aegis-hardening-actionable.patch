+#!/usr/bin/env python3
+"""
+Carbon-aware node selection helper (PoC)
+ - Queries carbon intensity and node labels to suggest low-carbon nodes for scheduling or to annotate job manifests.
+ - Not a scheduler plugin; useful for preflight decisions or as a mutating webhook stub.
+"""
+import os
+import requests
+from services.telemetry.carbon_lookup import lookup_co2_intensity
+
+from kubernetes import client, config
+
+def pick_low_carbon_node(region=None, include_isolated_only=True):
+    config.load_kube_config()
+    v1 = client.CoreV1Api()
+    nodes = v1.list_node().items
+    candidates = []
+    for n in nodes:
+        labels = n.metadata.labels or {}
+        if include_isolated_only and labels.get("runtime.aegis/has-isolation") != "true":
+            continue
+        # check node location/region label if present
+        node_region = labels.get("topology.kubernetes.io/region") or region
+        intensity = lookup_co2_intensity(node_region)
+        candidates.append({"name": n.metadata.name, "region": node_region, "intensity": intensity})
+    candidates.sort(key=lambda x: x["intensity"])
+    return candidates
+
+if __name__ == "__main__":
+    import json, argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--region", default=None)
+    p.add_argument("--count", type=int, default=5)
+    args = p.parse_args()
+    lst = pick_low_carbon_node(region=args.region)
+    print(json.dumps(lst[:args.count], indent=2))
+
