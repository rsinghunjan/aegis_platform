+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Check cluster nodes for presence of isolated runtimes (runsc, kata, firecracker).
+# Print a short remediation checklist and exit non-zero if any protected nodes lack isolation.
+#
+KUBECTL=${KUBECTL:-kubectl}
+PROTECTED_LABEL=${PROTECTED_LABEL:-"protected=true"}
+
+echo "Querying nodes..."
+nodes=$($KUBECTL get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')
+miss=0
+echo
+for n in $nodes; do
+  runtime=$($KUBECTL get node "$n" -o jsonpath='{.status.nodeInfo.containerRuntimeVersion}' 2>/dev/null || echo "")
+  echo "- $n : runtime='$runtime'"
+  if [[ "$runtime" != *"runsc"* && "$runtime" != *"kata"* && "$runtime" != *"firecracker"* ]]; then
+    # check if node is in protected namespace set (label hint)
+    label_val=$($KUBECTL get node "$n" --show-labels 2>/dev/null | grep -o '\bprotected=[^, ]*' || true)
+    echo "  -> Not running an isolated runtime."
+    if [[ -n "$label_val" || $n == *"gpu"* ]]; then
+      echo "     WARNING: protected or GPU node '$n' lacks isolated runtime. Remediation required."
+      miss=$((miss+1))
+    fi
+  fi
+done
+
+echo
+if [ $miss -gt 0 ]; then
+  cat <<EOF
+Nodes lacking isolated runtimes detected: $miss
+
+Recommended remediation steps (high level):
+ - Decide on runtime technology: gVisor/runsc OR Kata Containers OR microVM (Firecracker/Kata).
+ - Provision nodes with chosen runtime (node image or kubelet flags). Example:
+     * gVisor: install runsc on host and configure containerd to use runsc runtimeClass.
+     * Kata: install kata-runtime and configure RuntimeClass entry.
+ - Ensure RuntimeClass resources are defined in cluster (yaml in deploy/runtime/).
+ - Label validated nodes: kubectl label node <node> runtime.aegis/has-isolation=true
+ - Redeploy admission webhook with COSIGN configured and set ValidatingWebhookConfiguration to protect namespaces.
+
+Run ops/cluster/runtime_validator_enhanced.py for detailed JSON report and (optionally) S3 upload.
+EOF
+  exit 2
+fi
+
+echo "All nodes report isolated runtimes where expected."
+exit 0
+
