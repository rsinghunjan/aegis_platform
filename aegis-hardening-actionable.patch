+#!/usr/bin/env python3
+"""
+PoC GitOps rollback helper.
+ - Given a GitOps repo URL and a Kustomize/Helm path, this script creates a rollback commit/PR
+   that reverts the image tag for a given deployment to the previous known-good manifest.
+ - Requires git and appropriate credentials. Designed to create a PR for operator approval.
+"""
+import os
+import subprocess
+import tempfile
+
+REPO_URL = os.environ.get("GITOPS_REPO", "")
+GIT_AUTHOR = os.environ.get("GIT_AUTHOR", "aegis-bot <aegis-bot@example.com>")
+
+def create_rollback_pr(repo_url, target_path, deployment_name, prev_image_tag):
+    if not repo_url:
+        raise RuntimeError("GITOPS_REPO not configured")
+    tmp = tempfile.mkdtemp()
+    subprocess.check_call(["git", "clone", repo_url, tmp])
+    branch = f"rollback/{deployment_name}/{int(__import__('time').time())}"
+    cwd = tmp
+    subprocess.check_call(["git", "checkout", "-b", branch], cwd=cwd)
+    # naive search/replace; real repos should be patched more carefully
+    target_file = os.path.join(cwd, target_path)
+    with open(target_file, "r") as f:
+        content = f.read()
+    # replace image tag for deployment_name (best-effort)
+    new_content = content.replace(f"{deployment_name}:latest", f"{deployment_name}:{prev_image_tag}")
+    with open(target_file, "w") as f:
+        f.write(new_content)
+    subprocess.check_call(["git", "add", target_file], cwd=cwd)
+    subprocess.check_call(["git", "commit", "-m", f"Rollback {deployment_name} to {prev_image_tag}", "--author", GIT_AUTHOR], cwd=cwd)
+    subprocess.check_call(["git", "push", "--set-upstream", "origin", branch], cwd=cwd)
+    print("Created branch", branch, "in GitOps repo; open PR via your Git hosting UI for approval.")
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", default=os.environ.get("GITOPS_REPO",""))
+    p.add_argument("--path", required=True, help="path in repo to manifest to patch")
+    p.add_argument("--deployment", required=True)
+    p.add_argument("--prev-tag", required=True)
+    args = p.parse_args()
+    create_rollback_pr(args.repo, args.path, args.deployment, args.prev_tag)
+
