+#!/usr/bin/env python3
+"""
+Large-scale adversarial validation harness for watermark detection.
+ - Orchestrates many runs of scale_test (or a worker farm) and aggregates detection rates.
+ - Usage: configure SAMPLES_DIR, TARGET_DETECTION_RATE, and optionally S3 upload for aggregated CSV.
+"""
+import os
+import csv
+import time
+import subprocess
+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+SAMPLES_DIR = os.environ.get("WATERMARK_VALIDATION_SAMPLES", "./tests/watermark_samples")
+OUT_CSV = os.environ.get("WATERMARK_VALIDATION_CSV", "/tmp/wm_validation_results.csv")
+TARGET_RATE = float(os.environ.get("WATERMARK_TARGET_RATE", "0.95"))
+
+def run_sample(image_path, payload):
+    # call existing scale_test.py for single image (it can be adapted); here we call embed+detect via python function to keep simple
+    cmd = ["python3", "services/serving/diffusers/watermark/scale_test.py"]
+    # For speed, scale_test can be extended to accept a single image env variable; use subprocess env
+    env = dict(os.environ, WATERMARK_TEST_INPUT=os.path.dirname(image_path), WATERMARK_TEST_CSV="/tmp/tmp_wm.csv")
+    subprocess.run(cmd, env=env, check=False)
+    # read CSV and compute per-image detection rate
+    rows = []
+    try:
+        with open("/tmp/tmp_wm.csv") as f:
+            rows = list(csv.DictReader(f))
+    except Exception:
+        return 0.0, 0
+    detected = sum(1 for r in rows if r.get("detected") in ("True","true","1"))
+    return detected / max(1, len(rows)), len(rows)
+
+def main():
+    images = []
+    for fn in os.listdir(SAMPLES_DIR):
+        if fn.lower().endswith((".png",".jpg",".jpeg")):
+            images.append(os.path.join(SAMPLES_DIR, fn))
+    results = []
+    with ThreadPoolExecutor(max_workers=8) as ex:
+        futures = {ex.submit(run_sample, img, f"wm-{int(time.time())}"): img for img in images}
+        for fut in as_completed(futures):
+            img = futures[fut]
+            try:
+                rate, count = fut.result()
+            except Exception as e:
+                rate, count = 0.0, 0
+            results.append({"image": os.path.basename(img), "rate": rate, "samples": count})
+    with open(OUT_CSV, "w", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=["image","rate","samples"])
+        writer.writeheader()
+        writer.writerows(results)
+    avg = sum(r["rate"] for r in results)/max(1,len(results))
+    print(f"Aggregated detection rate: {avg:.3f}")
+    if avg < TARGET_RATE:
+        print("Validation FAILED: below target")
+        raise SystemExit(2)
+    print("Validation PASSED")
+
+if __name__ == "__main__":
+    main()
+
