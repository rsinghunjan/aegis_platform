+#!/usr/bin/env python3
+"""
+Helper to sign local artifact or S3-hosted archive using cosign with KMS-backed key reference.
+ - Expects COSIGN_KEY to be a KMS reference supported by cosign (e.g. "gcpkms://...").
+ - Produces a signature file next to the artifact and can upload signature to S3.
+"""
+import os
+import subprocess
+import tempfile
+
+COSIGN_KEY = os.environ.get("COSIGN_KEY", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def sign_local(artifact_path: str):
+    if not COSIGN_KEY:
+        raise RuntimeError("COSIGN_KEY not configured")
+    cmd = ["cosign", "sign", "--key", COSIGN_KEY, artifact_path]
+    subprocess.check_call(cmd)
+    sig_path = artifact_path + ".sig"
+    return sig_path
+
+def sign_and_upload(artifact_path: str, s3_uri: str = None):
+    sig = sign_local(artifact_path)
+    if s3_uri or EVIDENCE_BUCKET:
+        import boto3
+        bucket = (s3_uri or EVIDENCE_BUCKET).replace("s3://","").split("/",1)[0]
+        key = f"signatures/{os.path.basename(sig)}"
+        s3 = boto3.client("s3")
+        s3.upload_file(sig, bucket, key)
+        return f"s3://{bucket}/{key}"
+    return None
+
