+"""
+HTTP quota service wrapping QuotaClientV2 for gateway integration.
+ - Exposes endpoints: /reserve, /release, /check
+ - Useful for decoupling quota logic from gateway process and for auditing.
+"""
+from flask import Flask, request, jsonify
+from services.serving.diffusers.quota_client_v2 import QuotaClientV2
+
+app = Flask("aegis-quota-service")
+qc = QuotaClientV2()
+
+@app.route("/reserve", methods=["POST"])
+def reserve():
+    j = request.get_json(force=True)
+    tenant = j.get("tenant")
+    amount = float(j.get("amount", 0.0))
+    idempotency_key = j.get("idempotency_key") or ""
+    try:
+        ok = qc.reserve(tenant, amount, idempotency_key)
+        return jsonify({"ok": bool(ok), "idempotency_key": idempotency_key})
+    except Exception as e:
+        return jsonify({"ok": False, "error": str(e)}), 500
+
+@app.route("/release", methods=["POST"])
+def release():
+    j = request.get_json(force=True)
+    tenant = j.get("tenant")
+    idempotency_key = j.get("idempotency_key")
+    try:
+        ok = qc.release(tenant, idempotency_key)
+        return jsonify({"ok": bool(ok)})
+    except Exception as e:
+        return jsonify({"ok": False, "error": str(e)}), 500
+
+@app.route("/healthz")
+def health():
+    return jsonify({"status":"ok"})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8082")))
