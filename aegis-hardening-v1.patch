+#!/usr/bin/env python3
+"""
+Reassign or escalate stale moderation stream items.
+ - Claims items idle > threshold and pushes them to escalation queue / reviewed stream for human triage.
+ """
+import os
+import time
+import json
+try:
+    import redis
+except Exception:
+    redis = None
+
+STREAM = os.environ.get("MODERATION_STREAM", "diffusers:moderation:stream")
+ESCALATION_STREAM = os.environ.get("MODERATION_ESCALATION_STREAM", "diffusers:moderation:escalation")
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+STALE_SEC = int(os.environ.get("MODERATION_STALE_SEC", str(60*60)))
+
+def reassign_stale():
+    if redis is None:
+        raise RuntimeError("redis required")
+    r = redis.from_url(REDIS_URL)
+    # get pending entries
+    pending = r.xpending(STREAM, "-", "+", 100)
+    now = int(time.time() * 1000)
+    to_escalate = []
+    for p in pending:
+        # format varies; safe-guarding
+        try:
+            msg_id = p[0] if isinstance(p, (list, tuple)) else p.get("message_id", None)
+            idle = p[2] if isinstance(p, (list, tuple)) else p.get("idle", 0)
+        except Exception:
+            continue
+        if idle and int(idle) > (STALE_SEC * 1000):
+            to_escalate.append(msg_id)
+    for mid in to_escalate:
+        try:
+            entries = r.xrange(STREAM, min=mid, max=mid, count=1)
+            if not entries:
+                continue
+            payload = entries[0][1].get(b"payload").decode("utf-8")
+            r.xadd(ESCALATION_STREAM, {"payload": payload})
+            r.xdel(STREAM, mid)
+        except Exception as e:
+            print("escalation error", e)
+
+if __name__ == "__main__":
+    reassign_stale()
+
