+#!/usr/bin/env python3
+"""
+Simple self-healing controller:
+ - Polls Prometheus for configured alert expressions (cost runaway, moderation backlog, repro mismatch)
+ - If any alert condition persists beyond threshold, triggers a rollback action via Kubernetes (Deployment rollback)
+ - This is a PoC; integrate with your orchestration & GitOps flow for production.
+"""
+import os
+import time
+import requests
+from urllib.parse import urljoin
+try:
+    from kubernetes import client, config
+except Exception:
+    client = None
+
+PROM_URL = os.environ.get("PROMETHEUS_URL", "http://prometheus.monitoring.svc:9090")
+CHECK_INTERVAL = int(os.environ.get("SELFHEAL_INTERVAL", "30"))
+ALERT_DURATION = int(os.environ.get("SELFHEAL_ALERT_SEC", "600"))
+
+ALERTS = {
+    "CostRunawaySuspected": "sum(rate(nvidia_gpu_utilization[5m])) by (cluster) > 0.9 and sum(redis_list_length{list='diffusers:queue'}) > 50",
+    "ModerationPendingHigh": "aegis_moderation_pending > 100"
+}
+
+def query_prom(q):
+    r = requests.get(urljoin(PROM_URL, "/api/v1/query"), params={"query": q}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def check_alert(expr):
+    try:
+        res = query_prom(expr)
+        # return True if result value > 0
+        return bool(res.get("data", {}).get("result"))
+    except Exception:
+        return False
+
+def trigger_rollback(deployment_name, namespace="ml-serving"):
+    if client is None:
+        print("kubernetes client not available; cannot roll back")
+        return False
+    config.load_kube_config()
+    apps = client.AppsV1Api()
+    try:
+        # simple approach: scale down to zero then scale back (or use rollout undo via kubectl)
+        body = {"spec": {"replicas": 0}}
+        apps.patch_namespaced_deployment_scale(deployment_name, namespace, body)
+        print("Scaled deployment", deployment_name, "to 0 as mitigation")
+        return True
+    except Exception as e:
+        print("rollback error:", e)
+        return False
+
+def main():
+    while True:
+        for name, expr in ALERTS.items():
+            ok = check_alert(expr)
+            if ok:
+                print(f"Alert {name} firing: taking mitigation")
+                # mitigation mapping (example)
+                if name == "CostRunawaySuspected":
+                    trigger_rollback("aegis-diffusers", namespace="ml-serving")
+                if name == "ModerationPendingHigh":
+                    # scale reviewer deployment up (poC)
+                    if client:
+                        try:
+                            config.load_kube_config()
+                            apps = client.AppsV1Api()
+                            apps.patch_namespaced_deployment_scale("aegis-moderation-reviewer", "ml-serving", {"spec": {"replicas": 5}})
+                            print("Scaled moderators up to 5")
+                        except Exception as e:
+                            print("scaling reviewers error", e)
+        time.sleep(CHECK_INTERVAL)
+
+if __name__ == "__main__":
+    main()
