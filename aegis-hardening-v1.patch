+#!/usr/bin/env python3
+"""
+Forensic reporter for watermarked artifacts.
+ - Runs detection across a set of transformations and records scores.
+ - Generates a signed evidence bundle (uses cosign CLI) for forensic submission.
+"""
+import os
+import io
+import json
+import tarfile
+import tempfile
+import subprocess
+from PIL import Image, ImageOps
+from services.serving.diffusers.watermark.vendor_adapter import embed, detect
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF", "")  # e.g., keyless or KMS ref
+
+def _variants(img: Image.Image):
+    v = {}
+    v["orig"] = img
+    v["resize_0.5"] = img.resize((img.width//2, img.height//2))
+    v["resize_2x"] = img.resize((img.width*2, img.height*2))
+    v["jpeg_80"] = img
+    buf = io.BytesIO(); img.save(buf, format="JPEG", quality=80)
+    v["jpeg_80"] = Image.open(io.BytesIO(buf.getvalue()))
+    v["rot_10"] = img.rotate(10).resize(img.size)
+    v["crop"] = img.crop((img.width//8, img.height//8, img.width*7//8, img.height*7//8)).resize(img.size)
+    v["flip_lr"] = ImageOps.mirror(img)
+    return v
+
+def analyze_and_bundle(image_bytes: bytes, payload: str, out_prefix: str = None):
+    im = Image.open(io.BytesIO(image_bytes)).convert("RGB")
+    embedded = embed(image_bytes, payload, strength=0.02)
+    im_emb = Image.open(io.BytesIO(embedded)).convert("RGB")
+    results = {}
+    for name, var in _variants(im_emb).items():
+        buf = io.BytesIO(); var.save(buf, format="PNG"); vb = buf.getvalue()
+        ok = False
+        try:
+            ok = detect(vb, payload)
+        except Exception:
+            ok = False
+        results[name] = {"detected": bool(ok)}
+    # create evidence archive
+    tmpdir = tempfile.mkdtemp()
+    meta = {"payload": payload, "results": results}
+    meta_path = os.path.join(tmpdir, "forensic_metadata.json")
+    with open(meta_path, "w") as f:
+        json.dump(meta, f, indent=2)
+    img_path = os.path.join(tmpdir, "embedded.png")
+    with open(img_path, "wb") as f:
+        f.write(embedded)
+    archive = os.path.join(tmpdir, f"forensic_bundle_{int(__import__('time').time())}.tar.gz")
+    with tarfile.open(archive, "w:gz") as tar:
+        tar.add(meta_path, arcname="metadata.json")
+        tar.add(img_path, arcname="embedded.png")
+    # sign with cosign (if available)
+    signed = None
+    if COSIGN_KEY_REF:
+        try:
+            cmd = ["cosign", "sign", "--key", COSIGN_KEY_REF, archive]
+            subprocess.check_call(cmd)
+            signed = archive
+        except Exception as e:
+            print("cosign sign failed:", e)
+    # upload to S3 if configured
+    s3_uri = None
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3 = boto3.client("s3")
+        bucket = EVIDENCE_BUCKET.replace("s3://","")
+        key = f"forensics/{out_prefix or 'unknown'}/{os.path.basename(archive)}"
+        s3.upload_file(archive, bucket, key)
+        s3_uri = f"s3://{bucket}/{key}"
+    return {"results": results, "archive_path": archive, "signed": bool(signed), "s3_uri": s3_uri}
+
