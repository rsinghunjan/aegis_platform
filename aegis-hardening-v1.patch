+#!/usr/bin/env python3
+"""
+Evaluate moderation models on labeled datasets and push metrics to Prometheus pushgateway or S3.
+Also exposes a simple HTTP endpoint to run evaluation on-demand.
+"""
+import os
+import json
+from typing import Dict
+from prometheus_client import CollectorRegistry, Gauge, push_to_gateway
+
+from services.serving.diffusers.moderation_multilingual import get_pipe_for_text
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+PUSHGATEWAY = os.environ.get("PROM_PUSHGATEWAY", "")
+
+def evaluate_jsonl(dataset_path: str, threshold: float = 0.6) -> Dict:
+    tp = fp = tn = fn = 0
+    per_model = {}
+    with open(dataset_path) as f:
+        for line in f:
+            j = json.loads(line)
+            text = j["text"]; label = int(j["label"])
+            pipe = get_pipe_for_text(text)
+            model = pipe.model.name_or_path if pipe else "fallback"
+            out = pipe(text, truncation=True) if pipe else [{"score": 0.0}]
+            score = float(out[0].get("score",0.0))
+            pred = 1 if score > threshold else 0
+            per_model.setdefault(model, {"tp":0,"fp":0,"tn":0,"fn":0})
+            if pred==1 and label==1:
+                tp+=1; per_model[model]["tp"]+=1
+            if pred==1 and label==0:
+                fp+=1; per_model[model]["fp"]+=1
+            if pred==0 and label==0:
+                tn+=1; per_model[model]["tn"]+=1
+            if pred==0 and label==1:
+                fn+=1; per_model[model]["fn"]+=1
+    total = {"tp":tp,"fp":fp,"tn":tn,"fn":fn,"per_model": per_model}
+    # push to pushgateway if configured
+    if PUSHGATEWAY:
+        registry = CollectorRegistry()
+        g = Gauge("aegis_moderation_eval_tp", "tp", registry=registry)
+        g.set(tp)
+        try:
+            push_to_gateway(PUSHGATEWAY, job='aegis_moderation_eval', registry=registry)
+        except Exception as e:
+            print("pushgateway push failed:", e)
+    # save to S3
+    if EVIDENCE_BUCKET:
+        import boto3, tempfile
+        s3 = boto3.client("s3")
+        bucket = EVIDENCE_BUCKET.replace("s3://","")
+        key = f"moderation/eval/results_{int(__import__('time').time())}.json"
+        tmp = tempfile.mktemp(suffix=".json")
+        json.dump(total, open(tmp,"w"))
+        s3.upload_file(tmp, bucket, key)
+    return total
+
