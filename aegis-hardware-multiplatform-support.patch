+#!/usr/bin/env python3
+"""
+Backend adapter abstractions for multiple accelerators.
+Each adapter implements async generate_batch(prompts, max_tokens) -> List[List[str]]
+so the async_batched_inference_server can call them interchangeably.
+
+Adapters included:
+ - VLLMBackend: uses vllm if available (GPU)
+ - HFBackend: uses HuggingFace pipeline (CPU/GPU fallback)
+ - TPUBackend: placeholder using JAX/XLA/libtpu (TPU VMs)
+ - InferentiaBackend: placeholder calling neuron-runtime (AWS Inferentia/Trainium)
+ - GraphcoreBackend: placeholder for Poplar SDK (Graphcore IPU)
+ - HabanaBackend: placeholder for Habana Gaudi runtime
+ - EdgeNPUBackend: generic placeholder for edge NPUs (Coral/EdgeTPU or vendor)
+
+These adapters are best-effort. Vendor runtimes must be available in the container and nodes.
+"""
+import asyncio
+import os
+from typing import List
+
+class Backend:
+    async def generate_batch(self, prompts: List[str], max_tokens: int) -> List[List[str]]:
+        raise NotImplementedError
+
+class VLLMBackend(Backend):
+    def __init__(self, model=None):
+        self.model = model or os.environ.get("VLLM_MODEL", "facebook/opt-125m")
+
+    async def generate_batch(self, prompts: List[str], max_tokens: int) -> List[List[str]]:
+        # try to use vllm in-process if available
+        try:
+            import vllm
+            # Minimal synchronous wrapper executed off the event loop
+            def sync_generate(p, max_t):
+                tokens = []
+                from vllm import LLM, SamplingParams
+                client = LLM(model=self.model)
+                params = SamplingParams(max_tokens=max_t)
+                with client.generate(p, sampling_params=params) as outputs:
+                    for output in outputs:
+                        for tok in output:
+                            tokens.append(tok.text)
+                return tokens
+            loop = asyncio.get_event_loop()
+            futs = [loop.run_in_executor(None, sync_generate, p, max_tokens) for p in prompts]
+            results = await asyncio.gather(*futs)
+            return results
+        except Exception:
+            # fall back to HFBackend
+            from .backend_adapters import HFBackend
+            return await HFBackend().generate_batch(prompts, max_tokens)
+
+class HFBackend(Backend):
+    def __init__(self, model=None):
+        self.model = model or os.environ.get("HF_MODEL", "gpt2")
+
+    async def generate_batch(self, prompts: List[str], max_tokens: int) -> List[List[str]]:
+        # execute HF pipeline in threadpool to avoid blocking loop
+        from concurrent.futures import ThreadPoolExecutor
+        def hf_sync(prompt, max_t):
+            from transformers import pipeline, AutoTokenizer, AutoModelForCausalLM
+            tok = AutoTokenizer.from_pretrained(self.model)
+            model = AutoModelForCausalLM.from_pretrained(self.model)
+            gen = pipeline("text-generation", model=model, tokenizer=tok, device=0 if os.environ.get("USE_GPU","0")=="1" else -1)
+            out = gen(prompt, max_new_tokens=max_t, return_full_text=False)[0].get("generated_text","")
+            return out.split()
+        loop = asyncio.get_event_loop()
+        with ThreadPoolExecutor(max_workers=min(4,len(prompts))) as ex:
+            futs = [loop.run_in_executor(ex, hf_sync, p, max_tokens) for p in prompts]
+            res = await asyncio.gather(*futs)
+        return res
+
+class TPUBackend(Backend):
+    def __init__(self, model=None):
+        self.model = model or os.environ.get("TPU_MODEL","tpu-model")
+
+    async def generate_batch(self, prompts: List[str], max_tokens: int) -> List[List[str]]:
+        """
+        Placeholder for TPU-backed generation. Typical approaches:
+         - use JAX/XLA with a compiled autoregressive loop on TPU VMs
+         - use TF/Serving with TPU-compiled model
+        This function should be replaced with your TPU runtime invocation.
+        """
+        # naive fallback: call HFBackend
+        return await HFBackend(self.model).generate_batch(prompts, max_tokens)
+
+class InferentiaBackend(Backend):
+    def __init__(self, model=None):
+        self.model = model or os.environ.get("INFERENTIA_MODEL","neuron-model")
+
+    async def generate_batch(self, prompts: List[str], max_tokens: int) -> List[List[str]]:
+        """
+        Placeholder for AWS Neuron runtime. Typically you'd use neuronx or neuron-cli
+        to invoke a compiled model. This stub falls back to HF.
+        """
+        return await HFBackend(self.model).generate_batch(prompts, max_tokens)
+
+class GraphcoreBackend(Backend):
+    def __init__(self, model=None):
+        self.model = model or os.environ.get("GRAPHCORE_MODEL","graphcore-model")
+
+    async def generate_batch(self, prompts: List[str], max_tokens: int) -> List[List[str]]:
+        """
+        Placeholder: integrate Poplar runtime or IPU-compiled model invocation.
+        """
+        return await HFBackend(self.model).generate_batch(prompts, max_tokens)
+
+class HabanaBackend(Backend):
+    def __init__(self, model=None):
+        self.model = model or os.environ.get("HABANA_MODEL","habana-model")
+
+    async def generate_batch(self, prompts: List[str], max_tokens: int) -> List[List[str]]:
+        """
+        Placeholder for Habana Gaudi integration; replace with HCX/ Habana runtime calls.
+        """
+        return await HFBackend(self.model).generate_batch(prompts, max_tokens)
+
+class EdgeNPUBackend(Backend):
+    def __init__(self, model=None):
+        self.model = model or os.environ.get("EDGE_MODEL","edgenpu-model")
+
+    async def generate_batch(self, prompts: List[str], max_tokens: int) -> List[List[str]]:
+        """
+        Generic edge NPU adapter (Coral EdgeTPU, etc.). Typically you'd call vendor runtime via subprocess.
+        """
+        return await HFBackend(self.model).generate_batch(prompts, max_tokens)
+
+def detect_backend():
+    """
+    Heuristic detection: choose backend class based on INFERENCE_BACKEND env or installed runtimes.
+    Priority: explicit INFERENCE_BACKEND -> detect device resources -> fallback to HFBackend.
+    """
+    be = os.environ.get("INFERENCE_BACKEND")
+    if be:
+        be = be.upper()
+        if be == "VLLM" or be == "GPU":
+            return VLLMBackend()
+        if be == "TPU":
+            return TPUBackend()
+        if be in ("INFERENTIA","NEURON"):
+            return InferentiaBackend()
+        if be == "GRAPHCORE":
+            return GraphcoreBackend()
+        if be == "HABANA":
+            return HabanaBackend()
+        if be in ("EDGE","EDGENPU"):
+            return EdgeNPUBackend()
+        if be == "HF":
+            return HFBackend()
+    # auto-detect presence of runtimes (best-effort)
+    try:
+        import vllm  # type: ignore
+        return VLLMBackend()
+    except Exception:
+        pass
+    # detect Neuron runtime
+    if os.path.exists("/opt/neuron"):
+        return InferentiaBackend()
+    # detect TPUs (libtpu or TPU env var)
+    if os.environ.get("TPU_NAME") or os.path.exists("/lib/libtpu"):
+        return TPUBackend()
+    # Graphcore/Habana detection via environment or SDK path
+    if os.path.exists("/opt/graphcore") or os.environ.get("GRAPHCORE"):
+        return GraphcoreBackend()
+    if os.path.exists("/opt/habanalabs") or os.environ.get("HABANA"):
+        return HabanaBackend()
+    # Edge NPU heuristics
+    if os.path.exists("/usr/lib/edgetpu") or os.environ.get("EDGENTPU"):
+        return EdgeNPUBackend()
+    # final fallback
+    return HFBackend()
+
+__all__ = ["Backend","VLLMBackend","HFBackend","TPUBackend","InferentiaBackend","GraphcoreBackend","HabanaBackend","EdgeNPUBackend","detect_backend"]
+
