+#!/usr/bin/env python3
+"""
+High-risk action flagging and approval checker.
+
+ - is_high_risk(action_name, meta): heuristic to decide if an action is high-risk.
+ - is_approved(action_name): consult config/audit_status.yaml to see if the specific
+   high-risk category is approved for automated execution.
+ - require_human_approval(action_name): convenience that returns (bool approved, reason)
+
+Notes:
+ - This is a lightweight policy shim. For production you should map action names to
+   explicit risk categories and implement an M-of-N approval workflow (humans sign artifacts).
+"""
+from pathlib import Path
+import yaml
+import os
+
+# Default high-risk keywords (extendable)
+HIGH_RISK_KEYWORDS = [
+    "enable_mpc",
+    "rotate_keys",
+    "promote_model_to_prod",
+    "delete_evidence",
+    "modify_pki",
+    "cosign_key_rotation"
+]
+
+AUDIT_STATUS_PATH = Path("config/audit_status.yaml")
+
+def _load_audit_status():
+    if not AUDIT_STATUS_PATH.exists():
+        return {}
+    try:
+        return yaml.safe_load(AUDIT_STATUS_PATH.read_text()) or {}
+    except Exception:
+        return {}
+
+def is_high_risk(action_name: str, meta: dict = None) -> bool:
+    if not action_name:
+        return False
+    an = action_name.lower()
+    for k in HIGH_RISK_KEYWORDS:
+        if k in an:
+            return True
+    # also accept an explicit flag in meta
+    if meta and isinstance(meta, dict) and meta.get("high_risk") is True:
+        return True
+    return False
+
+def is_approved(action_name: str) -> bool:
+    """
+    Return True if this action has been approved in config/audit_status.yaml.
+    The file should look like:
+      enable_mpc: true
+      promote_model_to_prod: false
+    """
+    status = _load_audit_status()
+    # exact match first, then keyword match
+    if action_name in status:
+        return bool(status[action_name])
+    for k,v in status.items():
+        if k in action_name:
+            return bool(v)
+    return False
+
+def require_human_approval(action_name: str, meta: dict = None):
+    hr = is_high_risk(action_name, meta)
+    if not hr:
+        return (False, "not_high_risk")
+    if is_approved(action_name):
+        return (False, "approved_by_policy")
+    return (True, "requires_human_approval")
+
+if __name__ == "__main__":
+    print("High-risk checker: HIGH_RISK_KEYWORDS=", HIGH_RISK_KEYWORDS)
+    print("Audit status path:", AUDIT_STATUS_PATH)
+
