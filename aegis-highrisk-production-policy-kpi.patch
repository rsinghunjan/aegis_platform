+#!/usr/bin/env python3
+"""
+CI check: ensure production policy artifacts are present in repository/workflow.
+ - Verifies presence of secure_client_policy.py, require_cosign_kms.py, and middleware interceptors usage.
+ - Intended to run as part of pre-release CI to prevent accidental omission of production guards.
+"""
+import sys
+from pathlib import Path
+
+checks = [
+    ("secure_client_policy", Path("ops/grpc/secure_client_policy.py").exists()),
+    ("require_cosign_kms", Path("ops/security/require_cosign_kms.py").exists()),
+    ("auth_middleware", Path("ops/grpc/middleware.py").exists()),
+    ("high_risk_policy", Path("ops/security/high_risk.py").exists())
+]
+
+failed = []
+for name, ok in checks:
+    if not ok:
+        failed.append(name)
+
+if failed:
+    print("Production policy check failed; missing:", failed)
+    sys.exit(2)
+print("Production policy checks OK")
+sys.exit(0)
+
