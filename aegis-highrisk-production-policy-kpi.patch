+#!/usr/bin/env python3
+"""
+Autonomy metrics (Prometheus) for tracking autonomous vs human-approved actions, high-risk blocks, etc.
+
+Expose:
+ - increment_autonomous_action()
+ - increment_human_approved_action()
+ - increment_high_risk_blocked()
+ - start_metrics_server(port)
+"""
+from prometheus_client import Counter, start_http_server
+import os
+
+AUTONOMOUS_ACTIONS = Counter("aegis_autonomous_actions_total", "Total actions executed autonomously", ["action"])
+HUMAN_APPROVED_ACTIONS = Counter("aegis_human_approved_actions_total", "Total high-risk actions executed after human approval", ["action"])
+HIGH_RISK_BLOCKED = Counter("aegis_high_risk_blocked_total", "High-risk actions blocked pending human approval", ["action"])
+
+_METRICS_PORT = int(os.environ.get("AUTONOMY_METRICS_PORT", "9101"))
+
+def increment_autonomous_action(action_name: str):
+    AUTONOMOUS_ACTIONS.labels(action=action_name).inc()
+
+def increment_human_approved_action(action_name: str):
+    HUMAN_APPROVED_ACTIONS.labels(action=action_name).inc()
+
+def increment_high_risk_blocked(action_name: str):
+    HIGH_RISK_BLOCKED.labels(action=action_name).inc()
+
+def start_metrics_server(port: int = None):
+    p = port or _METRICS_PORT
+    start_http_server(p)
+    print("Autonomy Prometheus metrics serving on port", p)
+
