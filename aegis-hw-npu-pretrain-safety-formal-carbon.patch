+#!/usr/bin/env python3
+"""
+Inference wrapper that calls the output safety service after model inference and enforces policy (allow/block/approval).
+Intended as an example integration for Triton / custom model servers.
+"""
+import requests, os, json, sys
+from ops.sdk.evidence_sdk import record_manifest
+
+SAFETY_URL = os.environ.get("OUTPUT_SAFETY_URL","http://localhost:8091/score")
+APPROVAL_URL = os.environ.get("APPROVAL_URL","http://localhost:8089")
+
+def check_and_maybe_hold(model_name, output, context):
+    payload = {"model": model_name, "output": output, "context": context}
+    try:
+        r = requests.post(SAFETY_URL, json=payload, timeout=5)
+        r.raise_for_status()
+        res = r.json()
+    except Exception as e:
+        # conservative: require approval if safety service not available
+        record_manifest("safety_service_unavailable", {"error": str(e)})
+        return {"action":"require_approval","reason":"safety_service_unavailable"}
+    if res["action"] == "allow":
+        record_manifest("safety_allow", {"model": model_name, "risk": res["risk"]})
+        return {"action":"allow"}
+    elif res["action"] == "block":
+        record_manifest("safety_block", {"model": model_name, "risk": res["risk"], "reasons": res.get("reasons",[])})
+        return {"action":"block","reason":"safety_block"}
+    else:
+        # request approval
+        req = {"action":{"type":"model_output_hold","params":{"model":model_name,"output": output, "risk": res["risk"]}},"context":context,"requested_by":"system"}
+        r2 = requests.post(f"{APPROVAL_URL}/request_approval", json=req, timeout=5)
+        aid = r2.json().get("approval_id")
+        record_manifest("safety_requested_approval", {"approval_id": aid, "model": model_name, "risk": res["risk"]})
+        return {"action":"approval_requested","approval_id": aid}
+
+if __name__=="__main__":
+    # demo usage: python safety_inference_hook.py model "some output string"
+    model = sys.argv[1]
+    text = sys.argv[2]
+    res = check_and_maybe_hold(model, text, {})
+    print(res)
+
