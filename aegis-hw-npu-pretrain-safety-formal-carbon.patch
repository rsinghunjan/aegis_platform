+#!/usr/bin/env python3
+"""
+Carbon-aware scheduling helper (operator-run).
+ - Queries WattTime for current intensity and uses policies to tag or pause non-critical scheduled jobs.
+ - Integrates with Kubernetes to label jobs as 'carbon-pending' or to pause them.
+"""
+import os, sys, time
+from ops.carbon.watttime_client import get_latest_intensity
+from kubernetes import client, config
+
+REGION = os.environ.get("Aegis_CARBON_REGION","US-CA")
+THRESHOLD = float(os.environ.get("Aegis_CARBON_PROMOTE_THRESHOLD_GCO2","300"))
+PAUSE_LABEL = os.environ.get("CARBON_PAUSE_LABEL","aegis/carbon_paused")
+
+def main():
+    val = get_latest_intensity(REGION)
+    if val is None:
+        print("No WattTime data; skipping")
+        return
+    print("Current carbon intensity:", val)
+    config.load_kube_config()
+    batch = client.BatchV1Api()
+    jobs = batch.list_job_for_all_namespaces(label_selector="aegis/critical!=true")
+    for j in jobs.items:
+        name = j.metadata.name; ns = j.metadata.namespace
+        labels = j.metadata.labels or {}
+        if val > THRESHOLD:
+            if labels.get("carbon-paused") != "true":
+                print("Marking job", ns, name, "as carbon-paused")
+                body = {"metadata":{"labels":{"carbon-paused":"true"}}}
+                batch.patch_namespaced_job(name, ns, body)
+        else:
+            if labels.get("carbon-paused") == "true":
+                print("Unmarking job", ns, name)
+                labels.pop("carbon-paused", None)
+                body = {"metadata":{"labels":labels}}
+                batch.patch_namespaced_job(name, ns, body)
+
+if __name__=="__main__":
+    main()
+
