+#!/usr/bin/env python3
+"""
+Improved resume manager: downloads latest checkpoint and places a lease file to prevent concurrent resume races.
+Intended to be called at container start to determine resume path.
+"""
+import os, sys, time
+from ops.dl.production.checkpoint_uploader import upload as uploader
+from ops.dl.production.checkpoint_resume import list_checkpoints as list_ckpts, download
+
+LEASE_FILE="/tmp/checkpoint_resume.lease"
+
+def acquire_lease():
+    if os.path.exists(LEASE_FILE):
+        print("Lease exists; another process may be resuming")
+        return False
+    with open(LEASE_FILE, "w") as fh:
+        fh.write(str(time.time()))
+    return True
+
+def release_lease():
+    if os.path.exists(LEASE_FILE):
+        os.remove(LEASE_FILE)
+
+def main():
+    prefix = os.environ.get("S3_CHECKPOINT_PREFIX","s3://aegis-checkpoints")
+    if not acquire_lease():
+        print("Could not acquire resume lease; exiting")
+        sys.exit(2)
+    try:
+        bucket, ckpts = list_ckpts(prefix)
+        if not ckpts:
+            print("No checkpoints available to resume")
+            release_lease()
+            sys.exit(3)
+        latest = ckpts[-1]
+        local = "/tmp/resume_checkpoint.pt"
+        download(bucket, latest, local)
+        print("Downloaded resume checkpoint to", local)
+        # leave lease until process completes startup
+    finally:
+        release_lease()
+
+if __name__=="__main__":
+    main()
+
