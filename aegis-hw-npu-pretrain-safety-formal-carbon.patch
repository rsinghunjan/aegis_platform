+#!/usr/bin/env python3
+"""
+Output Safety Service
+ - Minimal REST API that scores model outputs for safety risks (toxicity/hallucination).
+ - Returns a risk score and suggested action (allow/block/require_approval).
+ - In production, replace placeholder classifiers with real models (toxicity, fact-check, hallucination detectors).
+"""
+from fastapi import FastAPI
+from pydantic import BaseModel
+from typing import Dict, Any
+import uvicorn, time
+from ops.sdk.evidence_sdk import record_manifest
+
+app = FastAPI(title="Aegis Output Safety")
+
+class InferencePayload(BaseModel):
+    model: str
+    output: str
+    context: Dict[str, Any] = {}
+
+@app.post("/score")
+def score(payload: InferencePayload):
+    text = payload.output.lower()
+    # placeholder heuristics
+    risk = 0.0
+    reasons = []
+    banned = ["bomb","kill","poison"]
+    for b in banned:
+        if b in text:
+            risk += 0.9
+            reasons.append("contains_banned_term:"+b)
+    # heuristic: long hallucination-like markers
+    if "according to" in text and "source" not in payload.context:
+        risk += 0.2
+        reasons.append("possible_hallucination")
+    if risk >= 0.8:
+        action = "block"
+    elif risk >= 0.2:
+        action = "require_approval"
+    else:
+        action = "allow"
+    out = {"risk": risk, "action": action, "reasons": reasons, "ts": time.time()}
+    try:
+        record_manifest("output_safety_score", {"model": payload.model, "risk": risk, "action": action, "reasons": reasons})
+    except Exception:
+        pass
+    return out
+
+if __name__=="__main__":
+    uvicorn.run(app, host="0.0.0.0", port=8091)
