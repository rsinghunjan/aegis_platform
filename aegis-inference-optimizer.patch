+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple wrk-based load test for inference HTTP endpoint. Requires `wrk` installed.
+# Usage: ./tools/load/wrk_load_test.sh http://triton.inference.svc.cluster.local:8000/v2/models/<model>/infer  -c 50 -t 4 -d 60s -b 1
+
+URL=${1:-}
+CONCURRENCY=${2:-50}
+THREADS=${3:-4}
+DURATION=${4:-30s}
+DATA=${5:-./tools/load/sample_request.json}
+
+if [ -z "$URL" ]; then
+  echo "Usage: $0 <url> [concurrency] [threads] [duration] [data]"
+  exit 2
+fi
+
+if [ ! -f "$DATA" ]; then
+  echo "Sample request not found at $DATA"
+  exit 2
+fi
+
+wrk -t"$THREADS" -c"$CONCURRENCY" -d"$DURATION" -s tools/load/wrk_script.lua --latency --timeout 30s --lua-args "$DATA,$URL"
