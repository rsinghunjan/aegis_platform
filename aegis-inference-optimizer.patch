+-- wrk Lua script that posts JSON payload file read by wrapper script
+local file = nil
+local url = nil
+init = function(args)
+  file = io.open(args[1], "r")
+  payload = file:read("*a")
+  url = args[2]
+end
+request = function()
+  return wrk.format("POST", url, {["Content-Type"]="application/json"}, payload)
+end
