+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Convert a PyTorch model to ONNX then build a TensorRT engine using trtexec (requires TensorRT installed)
+# Usage: ./ops/convert/convert_to_onnx_and_tensorrt.sh <pt_model.py or traced.pt> <input_shape> <output_engine.trt>
+
+MODEL_PATH=${1:-}
+INPUT_SHAPE=${2:-"1,3,224,224"}
+OUT_ENGINE=${3:-engine.trt}
+
+if [ -z "$MODEL_PATH" ]; then
+  echo "Usage: $0 <model.pt> <input_shape> <out_engine.trt>"
+  exit 2
+fi
+
+PY_SCRIPT=$(mktemp /tmp/convert-XXXX.py)
+cat > "$PY_SCRIPT" <<PY
+import torch, sys
+model = torch.jit.load(sys.argv[1]) if sys.argv[1].endswith('.pt') else torch.load(sys.argv[1])
+model.eval()
+dummy = torch.randn(tuple(map(int, sys.argv[2].split(','))))
+torch.onnx.export(model, dummy, "model.onnx", opset_version=13, input_names=["input"], output_names=["output"])
+print("Exported model.onnx")
+PY
+
+python3 "$PY_SCRIPT" "$MODEL_PATH" "$INPUT_SHAPE"
+echo "Building TensorRT engine with trtexec..."
+trtexec --onnx=model.onnx --saveEngine="$OUT_ENGINE" --workspace=2048 --fp16 || trtexec --onnx=model.onnx --saveEngine="$OUT_ENGINE"
+echo "Built engine at $OUT_ENGINE"
+
