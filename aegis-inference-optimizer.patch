+#!/usr/bin/env python3
+"""
+Query Prometheus for latency and DCGM metrics and write a simple CSV summary.
+Requires PROM_URL env var (e.g., http://prometheus.monitoring.svc:9090)
+"""
+import os, requests, csv, time
+PROM = os.environ.get("PROM_URL","http://prometheus:9090")
+OUT = os.environ.get("OUT","/tmp/load_report.csv")
+
+def query(prom, q):
+    r = requests.get(f"{prom}/api/v1/query", params={"query": q}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def main():
+    # Example queries (adjust metric names if different)
+    q_latency_p99 = 'histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))'
+    q_gpu_util = 'avg(nvidia_gpu_utilization_gpu)'
+    now = int(time.time())
+    rows = []
+    try:
+        lat = query(PROM, q_latency_p99)
+        util = query(PROM, q_gpu_util)
+        rows.append({"ts": now, "p99_latency": lat.get("data",{}).get("result",[]), "gpu_util": util.get("data",{}).get("result",[])})
+    except Exception as e:
+        print("Prometheus query failed:", e)
+    with open(OUT, "w") as f:
+        f.write("ts,p99_latency,gpu_util_json\n")
+        for r in rows:
+            f.write(f"{r['ts']},\"{r['p99_latency']}\",\"{r['gpu_util']}\"\n")
+    print("Wrote report to", OUT)
+
+if __name__=="__main__":
+    main()
+
