+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Push a local model directory into the triton model-repo PVC using a short-lived helper pod.
+# Usage: ./ops/triton/push_model_to_repo.sh ./model-dir my_model 1
+
+LOCAL_DIR=${1:-}
+MODEL_NAME=${2:-my_model}
+MODEL_VERSION=${3:-1}
+NS=${4:-inference}
+
+if [ -z "$LOCAL_DIR" ] || [ ! -d "$LOCAL_DIR" ]; then
+  echo "Usage: $0 <local_model_dir> <model_name> <version> [namespace]"
+  exit 2
+fi
+
+POD="triton-upload-$(date +%s)"
+kubectl -n "$NS" run "$POD" --image=busybox --restart=Never -- sleep 3600
+kubectl -n "$NS" wait --for=condition=ready pod/"$POD" --timeout=30s || true
+kubectl -n "$NS" exec "$POD" -- mkdir -p /models/"$MODEL_NAME"/"$MODEL_VERSION"
+kubectl -n "$NS" cp "$LOCAL_DIR"/. "$NS"/"$POD":/models/"$MODEL_NAME"/"$MODEL_VERSION"
+kubectl -n "$NS" delete pod "$POD" --wait=true
+
+# Call Triton model control API to load model (explicit control)
+TRITON_SVC="triton.$NS.svc.cluster.local:8000"
+curl -s -X POST "http://$TRITON_SVC/v2/repository/models/${MODEL_NAME}/load" || true
+echo "Model pushed and load requested: ${MODEL_NAME}/${MODEL_VERSION}"
+
