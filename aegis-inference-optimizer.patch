+#!/usr/bin/env python3
+"""
+Lightweight Python inference proxy that forwards requests to Triton and emits OpenTelemetry traces.
+Use this when you want to instrument request-level traces across preproc -> triton -> postproc.
+"""
+from flask import Flask, request, Response, jsonify
+import requests, os, json
+from opentelemetry import trace
+from opentelemetry.sdk.resources import Resource
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import BatchSpanProcessor, ConsoleSpanExporter
+from opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter
+
+TRITON_URL = os.environ.get("TRITON_URL", "http://triton.inference.svc.cluster.local:8000")
+OTEL_COLLECTOR = os.environ.get("OTEL_COLLECTOR", "http://otel-collector.observability.svc:4317")
+
+resource = Resource.create({"service.name": "inference-proxy"})
+provider = TracerProvider(resource=resource)
+trace.set_tracer_provider(provider)
+otlp_exporter = OTLPSpanExporter(endpoint=OTEL_COLLECTOR, insecure=True)
+provider.add_span_processor(BatchSpanProcessor(otlp_exporter))
+provider.add_span_processor(BatchSpanProcessor(ConsoleSpanExporter()))
+tracer = trace.get_tracer(__name__)
+
+app = Flask(__name__)
+
+@app.route("/v2/models/<model>/infer", methods=["POST"])
+def infer(model):
+    with tracer.start_as_current_span("inference_request") as span:
+        payload = request.get_data()
+        span.set_attribute("model", model)
+        # Forward to Triton HTTP inference (simplified)
+        url = f"{TRITON_URL}/v2/models/{model}/infer"
+        headers = {"Content-Type": "application/json"}
+        r = requests.post(url, data=payload, headers=headers, timeout=60)
+        span.set_attribute("triton_status", r.status_code)
+        return Response(r.content, status=r.status_code, content_type=r.headers.get("Content-Type", "application/json"))
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=8080)
+
