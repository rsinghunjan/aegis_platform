+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to mark nodes for kata (sandbox) and preempt-rt (real-time) workloads.
+# Replace the grep filter with your cloud node names/tags when running.
+#
+ROLE=${1:-kata} # kata or preempt-rt
+LABEL="node-role.kubernetes.io/${ROLE}=true"
+
+echo "Labeling nodes for role=${ROLE}"
+for node in $(kubectl get nodes -o name); do
+  # Simple heuristic: nodes with 'infra' in name -> kata; 'rt' -> preempt-rt. Adjust as needed.
+  nodename=${node#node/}
+  if [[ "${ROLE}" == "kata" && "${nodename}" == *infra* ]] || [[ "${ROLE}" == "preempt-rt" && "${nodename}" == *rt* ]]; then
+    echo "Labeling ${nodename} with ${LABEL}"
+    kubectl label node "${nodename}" "${LABEL}" --overwrite
+  fi
+done
+
+echo "Done. Confirm with: kubectl get nodes --show-labels"
+
