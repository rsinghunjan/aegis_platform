+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Example Vault integration helper (operator-run).
+# This script demonstrates storing existing Kubernetes secrets into Vault
+# and creating Kubernetes external-secrets or rotated secrets for apps to consume.
+#
+VAULT_ADDR=${VAULT_ADDR:-http://vault.example:8200}
+SECRET_PATH=${1:-secret/data/aegis/cosign}
+K8S_SECRET_NAME=${2:-cosign-secret}
+NAMESPACE=${3:-aegis-system}
+
+echo "This script is an operator helper. It expects 'vault' CLI installed and authenticated."
+echo "Read Kubernetes secret and write to Vault (operator must ensure RBAC)."
+
+kubectl -n "${NAMESPACE}" get secret "${K8S_SECRET_NAME}" -o jsonpath='{.data}' || { echo "secret not found"; exit 1; }
+
+echo "Example flow (manual):"
+cat <<'EOF'
+1) Retrieve existing secret value locally:
+   kubectl -n aegis-system get secret cosign-secret -o jsonpath="{.data.pubkey}" | base64 --decode > cosign.pub
+2) Write to Vault:
+   vault kv put secret/aegis/cosign pubkey=@cosign.pub
+3) Configure Kubernetes external-secrets or CSI driver to mount secrets from Vault into pods.
+EOF
+
+echo "For automated rotation, use Vault's transit/PKI and Kubernetes External Secrets operator to inject rotated secrets."
+
