+        run: |
+          # Example: for each image in a manifest, run cosign verify
+          images=$(yq eval '.. | .image? // ""' -o=json k8s | jq -r '.[]' 2>/dev/null || true)
+          for img in $images; do
+            if [ -n "$img" ]; then
+              echo "Verifying $img"
