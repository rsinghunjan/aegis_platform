+#!/usr/bin/env python3
+"""
+Simple load test for moderation/verifier/PII services.
+"""
+import requests, time, threading
+import os
+
+MOD_URL = os.environ.get("MOD_URL", "http://localhost:8081/moderate_text")
+PII_URL = os.environ.get("PII_URL", "http://localhost:8082/scan_text")
+VER_URL = os.environ.get("VER_URL", "http://localhost:8083/verify")
+
+def worker(iterations=100):
+    for i in range(iterations):
+        try:
+            r = requests.post(MOD_URL, json={"text": "This is a safe test message"}, timeout=2.0)
+            r = requests.post(PII_URL, json={"text": "Contact me at alice@example.com"}, timeout=2.0)
+            r = requests.post(VER_URL, json={"text":"The sky is blue", "retrieved_docs":[{"text":"The sky appears blue during the day"}]}, timeout=5.0)
+        except Exception as e:
+            print("error", e)
+        time.sleep(0.1)
+
+threads = []
+for _ in range(int(os.environ.get("WORKERS", "4"))):
+    t = threading.Thread(target=worker, args=(int(os.environ.get("ITER", "200")),))
+    t.start()
+    threads.append(t)
+
+for t in threads:
+    t.join()
+
+print("load test complete")
+
