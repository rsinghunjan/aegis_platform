+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Upload an artifact and its cosign signature to S3 and optionally record pointer in LakeFS.
+#
+# Usage: ./scripts/save_sig_to_s3.sh <artifact-path> <s3-bucket> [s3-key-prefix]
+ARTIFACT=$1
+S3_BUCKET=$2
+PREFIX=${3:-artifacts}
+
+if [ -z "$ARTIFACT" ] || [ ! -f "$ARTIFACT" ]; then
+  echo "artifact missing"
+  exit 2
+fi
+
+SIG="${ARTIFACT}.sig"
+if [ ! -f "$SIG" ]; then
+  echo "signature ${SIG} not found"
+  exit 2
+fi
+
+KEY="$PREFIX/$(basename "$ARTIFACT")"
+aws s3 cp "$ARTIFACT" "s3://$S3_BUCKET/$KEY"
+aws s3 cp "$SIG" "s3://$S3_BUCKET/$KEY.sig"
+echo "Uploaded s3://$S3_BUCKET/$KEY and signature"
+
