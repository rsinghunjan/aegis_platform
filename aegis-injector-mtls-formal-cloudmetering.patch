+#!/usr/bin/env python3
+"""
+Render TLA+ specs into Markdown artifacts and produce a mapping of spec variables/actions to code.
+ - Produces docs/formal/spec_rendered.md containing the TLA+ spec snippets.
+ - Runs ops/formal/model_code_traceability.py to generate proof_mapping.md/json.
+ - Produces docs/formal/spec_variables.md listing variables & actions and their code hits.
+"""
+import subprocess
+from pathlib import Path
+import re
+import json
+import sys
+
+TLA_DIR = Path("specs/safety")
+OUT_DIR = Path("docs/formal")
+OUT_DIR.mkdir(parents=True, exist_ok=True)
+
+def extract_variables_and_actions(tla_text):
+    # heuristics: variables declared in VARIABLES line and actions in Next or Append/strings
+    vars_found = []
+    actions = set(re.findall(r'Append\(action_log,\s*"([a-zA-Z0-9_]+)"\)', tla_text))
+    # find VARIABLES block
+    m = re.search(r'VARIABLES\s+([a-zA-Z0-9_,\s]+)', tla_text)
+    if m:
+        vars_found = [v.strip() for v in m.group(1).split(",")]
+    return vars_found, sorted(list(actions))
+
+def render_specs():
+    aggregated = []
+    var_action_map = {}
+    for p in TLA_DIR.rglob("*.tla"):
+        txt = p.read_text(errors="ignore")
+        vars_found, actions = extract_variables_and_actions(txt)
+        aggregated.append(f"## {p}\n\n```tla\n{txt}\n```\n")
+        var_action_map[str(p)] = {"variables": vars_found, "actions": actions}
+    Path(OUT_DIR / "spec_rendered.md").write_text("\n".join(aggregated))
+    Path(OUT_DIR / "spec_variables.json").write_text(json.dumps(var_action_map, indent=2))
+    print("Wrote spec_rendered.md and spec_variables.json")
+    return var_action_map
+
+def run_traceability():
+    # reuse existing tool
+    try:
+        subprocess.check_call([sys.executable, "ops/formal/model_code_traceability.py"])
+    except subprocess.CalledProcessError:
+        print("model_code_traceability.py failed; check errors")
+
+def produce_variable_mapping():
+    var_map = {}
+    for p in TLA_DIR.rglob("*.tla"):
+        txt = p.read_text(errors="ignore")
+        vars_found, actions = extract_variables_and_actions(txt)
+        for v in vars_found:
+            # grep repo for occurrences
+            hits = []
+            for f in Path(".").rglob("*.py"):
+                try:
+                    lines = f.read_text().splitlines()
+                except Exception:
+                    continue
+                for i,l in enumerate(lines, start=1):
+                    if v in l:
+                        hits.append({"path": str(f), "line": i, "snippet": l.strip()[:200]})
+            var_map[v] = hits
+    Path(OUT_DIR / "spec_variables.md").write_text("# Spec Variables -> Code Mapping\n\n" + "\n\n".join([f"## {k}\n\n" + ("\n".join([f"- {h['path']}:{h['line']} — `{h['snippet']}`" for h in v]) if v else "- No hits found") for k,v in var_map.items()]))
+    print("Wrote docs/formal/spec_variables.md")
+
+def main():
+    run_traceability()
+    var_action_map = render_specs()
+    produce_variable_mapping()
+
+if __name__=="__main__":
+    main()
+
