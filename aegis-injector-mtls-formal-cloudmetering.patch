+#!/usr/bin/env python3
+"""
+Run the safety_monitor injector across the repository and produce unified diff patches
+for every file the injector would change. This produces reviewable .patch files under
+patches/ without modifying the working tree.
+
+Usage:
+  python3 ops/autonomy/run_injector_and_generate_diffs.py --paths services controllers --out patches
+
+Optional:
+  Set env DO_OPEN_PR=true and GH_TOKEN available to attempt to open PRs (calls `gh` CLI).
+  If used, the script will create feature branches, commit the patched files and open draft PRs.
+  (Operators must review before merging.)
+
+Notes:
+ - This script runs the existing injector: ops/autonomy/inject_safety_monitor.py
+ - It writes patched copies to a temporary directory, computes diffs against repo files,
+   and emits a .patch per file under the output directory.
+"""
+import argparse
+import tempfile
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+import difflib
+import os
+
+INJECTOR = Path("ops/autonomy/inject_safety_monitor.py")
+
+def run_injector(paths, outdir):
+    out = Path(outdir)
+    if out.exists():
+        shutil.rmtree(out)
+    out.mkdir(parents=True)
+    cmd = [sys.executable, str(INJECTOR), "--out", str(out)] + ["--paths"] + paths
+    subprocess.check_call(cmd)
+    return out
+
+def make_patch(original_path, patched_path, patch_out):
+    a = original_path.read_text(errors="ignore").splitlines(keepends=True)
+    b = patched_path.read_text(errors="ignore").splitlines(keepends=True)
+    rel = os.path.relpath(original_path, Path("."))
+    diff = difflib.unified_diff(a, b, fromfile=rel, tofile=f"{rel}.patched")
+    patch_text = "".join(diff)
+    if patch_text.strip():
+        Path(patch_out).parent.mkdir(parents=True, exist_ok=True)
+        Path(patch_out).write_text(patch_text)
+        print("Wrote patch:", patch_out)
+        return True
+    return False
+
+def create_git_branch_and_pr(patched_dir, branch_prefix="inject-safety"):
+    """
+    OPTIONAL: create a branch per top-level package present in patched_dir,
+    copy patched files into the working tree, commit, push and open a PR (draft).
+    This attempts to use the `gh` CLI and requires git auth to be configured.
+    """
+    try:
+        import json
+        patched = Path(patched_dir)
+        for pf in patched.rglob("*.py"):
+            repo_file = Path(pf.name)
+            pkg = repo_file.parent.name if repo_file.parent.name else "repo"
+            branch = f"{branch_prefix}/{pkg}"
+            subprocess.check_call(["git", "checkout", "-b", branch])
+            shutil.copy2(pf, repo_file)
+            subprocess.check_call(["git", "add", str(repo_file)])
+            try:
+                subprocess.check_call(["git", "commit", "-m", f"chore: inject safety_monitor into {repo_file} (automated)"])
+            except subprocess.CalledProcessError:
+                # nothing to commit
+                pass
+            subprocess.check_call(["git", "push", "--set-upstream", "origin", branch])
+            # open draft PR
+            try:
+                subprocess.check_call(["gh", "pr", "create", "--title", f"chore: inject safety checks into {pkg}", "--body", "Automated instrumentation. Please review.", "--base", "main", "--head", branch, "--draft"])
+            except Exception as e:
+                print("gh pr create failed:", e)
+            # switch back to main to prepare next branch
+            subprocess.check_call(["git", "checkout", "main"])
+    except Exception as e:
+        print("create_git_branch_and_pr failed:", e)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--paths", nargs="+", default=["services","controllers"], help="Paths to scan")
+    p.add_argument("--out", default="patches", help="Directory to write .patch files")
+    p.add_argument("--branch-prefix", default="inject-safety", help="Branch prefix for optional PR creation")
+    args = p.parse_args()
+
+    patched_dir = run_injector(args.paths, "/tmp/aegis_inject_patched")
+    outdir = Path(args.out)
+    outdir.mkdir(parents=True, exist_ok=True)
+    any_patch = False
+    for pf in patched_dir.rglob("*.py"):
+        repo_file = Path(pf.name)
+        if not repo_file.exists():
+            # new file; produce a patch that adds the file
+            patch_path = outdir / (pf.name + ".patch")
+            content = pf.read_text()
+            header = f"*** new file: {repo_file}\n"
+            patch_path.write_text(header + content)
+            print("Wrote new-file patch:", patch_path)
+            any_patch = True
+            continue
+        patch_path = outdir / (str(repo_file).replace("/","_") + ".patch")
+        changed = make_patch(repo_file, pf, patch_path)
+        any_patch = any_patch or changed
+
+    if not any_patch:
+        print("No instrumentation changes required; repo appears instrumented already.")
+    else:
+        print("Patches produced in:", outdir)
+
+    if os.environ.get("DO_OPEN_PR","false").lower() == "true":
+        print("DO_OPEN_PR enabled: attempting to create branches and PRs (requires git & gh configured)")
+        create_git_branch_and_pr(patched_dir, args.branch_prefix)
+
+if __name__=="__main__":
+    main()
+
