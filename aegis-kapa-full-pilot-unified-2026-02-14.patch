+#!/usr/bin/env python3
+"""
+DP aggregation example using IBM DiffPrivLib. Use to experiment with epsilon budgets.
+"""
+import numpy as np
+from diffprivlib.mechanisms import GaussianTruncated
+import json, sys
+
+def dp_vector_mean(vecs, epsilon=1.0, delta=1e-5, sensitivity=1.0):
+    arr = np.array(vecs, dtype=float)
+    mean = np.mean(arr, axis=0)
+    mech = GaussianTruncated(epsilon=epsilon, delta=delta, sensitivity=sensitivity)
+    noisy = [mech.randomise(float(x)) for x in np.atleast_1d(mean)]
+    return noisy
+
+if __name__ == "__main__":
+    vals = json.loads(sys.argv[1]) if len(sys.argv)>1 else [[0.1,0.2],[0.2,0.1]]
+    print(dp_vector_mean(vals, epsilon=0.5))
+
