+#!/usr/bin/env python3
+"""
+Pre-load attestation webhook for Kapa serving fleet (Triton or custom).
+Validates cosign/Rekor evidence before permitting model load.
+"""
+import os, requests, json
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+REKOR_URL = os.environ.get("REKOR_URL", "http://rekor.rekor.svc.cluster.local:3000")
+# Optionally COSIGN_PUBLIC_KEY or use Rekor verification
+
+def verify_rekor_index(index):
+    try:
+        r = requests.get(f"{REKOR_URL}/api/v1/log/entries?logIndex={index}", timeout=5)
+        if not r.ok:
+            return False, "rekor_unreachable"
+        j = r.json()
+        return bool(j), None
+    except Exception as e:
+        return False, str(e)
+
+@app.route("/validate_load", methods=["POST"])
+def validate_load():
+    j = request.json or {}
+    evidence = j.get("evidence") or {}
+    # evidence may contain rekor_index or attestation blob
+    ri = evidence.get("rekor_index")
+    if ri:
+        ok, reason = verify_rekor_index(ri)
+        if ok:
+            return jsonify({"ok": True})
+        else:
+            return jsonify({"ok": False, "reason": reason}), 403
+    # fallback: simple attestation presence check
+    if evidence.get("signature") or evidence.get("attestation"):
+        return jsonify({"ok": True})
+    return jsonify({"ok": False, "reason": "no_evidence"}), 400
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8600")))
+
