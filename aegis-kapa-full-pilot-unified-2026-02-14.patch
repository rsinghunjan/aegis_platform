+#!/usr/bin/env python3
+"""
+Generate evidence bundle combining receipt_signer attestation, optional MLflow run metadata,
+and Rekor index (if available). Attachable as model metadata in Kapa's registry.
+"""
+import argparse, json, os, requests, time
+
+def load_attestation(path):
+    if not path or not os.path.exists(path):
+        return None
+    return json.load(open(path))
+
+def fetch_mlflow_run(run_id, mlflow_uri):
+    if not run_id or not mlflow_uri:
+        return None
+    try:
+        r = requests.get(f"{mlflow_uri.rstrip('/')}/api/2.0/preview/mlflow/runs/get?run_id={run_id}", timeout=5.0)
+        if r.ok:
+            return r.json()
+    except Exception:
+        pass
+    return None
+
+def main(attestation, run_id, mlflow_uri, out):
+    att = load_attestation(attestation)
+    bundle = {
+        "attestation": att,
+        "rekor_index": att.get("rekor_index") if att else None,
+        "mlflow": fetch_mlflow_run(run_id, mlflow_uri),
+        "generated_at": time.time(),
+        "ci": {"job": os.environ.get("GITHUB_JOB",""), "run_id": os.environ.get("GITHUB_RUN_ID","")}
+    }
+    with open(out, "w") as f:
+        json.dump(bundle, f, indent=2)
+    print("Wrote evidence bundle to", out)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--attestation", required=True)
+    p.add_argument("--run-id", default="")
+    p.add_argument("--mlflow-uri", default=os.environ.get("MLFLOW_TRACKING_URI",""))
+    p.add_argument("--out", default="evidence_bundle.json")
+    args = p.parse_args()
+    main(args.attestation, args.run_id, args.mlflow_uri, args.out)
+
