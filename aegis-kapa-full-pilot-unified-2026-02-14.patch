+#!/usr/bin/env python3
+"""
+Simple A2A/HIL enforcer service used by Kapa to request human approval for critical actions.
+Records intents to MCP and returns a request_id for polling.
+"""
+import os, time, requests
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def post_intent(action_id, summary, owner):
+    payload = {"action_id": action_id, "summary": summary, "owner": owner, "ts": time.time()}
+    # In production, integrate with notification channels (Slack, email, SSO)
+    try:
+        r = requests.post(f"{MCP.rstrip('/')}/a2a/intents", json=payload, timeout=3.0)
+        if r.ok:
+            return r.json().get("request_id") or f"req-{int(time.time())}"
+    except Exception:
+        pass
+    return f"req-{int(time.time())}"
+
+@app.route("/intent", methods=["POST"])
+def intent():
+    j = request.json or {}
+    action_id = j.get("action_id")
+    summary = j.get("summary", "")
+    owner = j.get("owner", "unknown")
+    rid = post_intent(action_id, summary, owner)
+    return jsonify({"ok": True, "request_id": rid})
+
+@app.route("/status/<rid>", methods=["GET"])
+def status(rid):
+    # For demo: always return PENDING; operator would update to RESOLVED after manual approval
+    return jsonify({"request_id": rid, "status": "PENDING"})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8082")))
+
