+#!/usr/bin/env python3
+"""
+Lightweight Kapa client SDK for:
+- Enrollment (Vault token retrieval or device provisioning)
+- Local training stub and masked update submission
+- Evidence verification helper (pre-load)
+"""
+import requests, os, json
+
+class KapaClient:
+    def __init__(self, enroll_token=None, ork=None):
+        self.enroll_token = enroll_token
+        self.orchestrator = ork or os.environ.get("TFF_ORCHESTRATOR","http://tff-orch:8300")
+
+    def enroll(self, client_id):
+        # In production: use Vault Agent or MSK-based enrollment
+        if not self.enroll_token:
+            raise Exception("No enroll token configured")
+        return {"client_id": client_id, "token": self.enroll_token}
+
+    def submit_masked_update(self, group_id, update_blob):
+        # Post masked update to coordinator endpoint (example)
+        r = requests.post(f"{self.orchestrator}/submit_update", json={"group":group_id,"update":update_blob}, timeout=5)
+        return r.ok
+
+    def verify_evidence(self, evidence, rekor_url=None):
+        if rekor_url and evidence.get("rekor_index"):
+            r = requests.get(f"{rekor_url}/api/v1/log/entries?logIndex={evidence['rekor_index']}", timeout=5)
+            return r.ok and bool(r.json())
+        # basic presence fallback
+        return bool(evidence.get("signature") or evidence.get("attestation"))
