+#!/usr/bin/env python3
+"""
+Latency comparison test between low-latency single-sample endpoint and batched perception endpoint.
+Measures individual request latencies and produces p50/p95/p99.
+"""
+import time, statistics, requests, json
+from ops.sdk.evidence_sdk import record_manifest
+
+def measure(endpoint, payloads, headers=None):
+    latencies = []
+    for p in payloads:
+        start = time.perf_counter()
+        r = requests.post(endpoint, json=p, timeout=10, headers=headers or {})
+        dur = (time.perf_counter() - start)
+        latencies.append(dur)
+    return latencies
+
+def summarize(latencies):
+    lat_ms = [l*1000 for l in latencies]
+    return {
+        "count": len(lat_ms),
+        "p50_ms": statistics.median(lat_ms),
+        "p95_ms": sorted(lat_ms)[int(0.95*len(lat_ms))-1],
+        "p99_ms": sorted(lat_ms)[int(0.99*len(lat_ms))-1],
+        "mean_ms": statistics.mean(lat_ms),
+        "stdev_ms": statistics.stdev(lat_ms) if len(lat_ms)>1 else 0.0
+    }
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--low", default="http://aegis-low-latency.aegis.svc.cluster.local:50055/infer_low_latency")
+    p.add_argument("--perception", default="http://aegis-perception.aegis.svc.cluster.local:8080/infer")
+    p.add_argument("--requests", type=int, default=50)
+    args = p.parse_args()
+    payloads = [{"prompt":"test", "max_tokens":16} for _ in range(args.requests)]
+    print("Measuring low-latency endpoint", args.low)
+    lat_low = measure(args.low, payloads)
+    print("Measuring perception endpoint (single sample) bypass batching)", args.perception)
+    lat_perc = measure(args.perception, payloads)
+    s_low = summarize(lat_low)
+    s_perc = summarize(lat_perc)
+    print("Low-latency summary:", json.dumps(s_low, indent=2))
+    print("Perception summary:", json.dumps(s_perc, indent=2))
+    try:
+        record_manifest("latency_test", {"low": s_low, "perception": s_perc})
+    except Exception:
+        pass
+
