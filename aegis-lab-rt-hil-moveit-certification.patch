+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to bootstrap a GitHub self-hosted runner on the machine.
+# Usage: RUNNER_TOKEN=... ./ops/robotics/ci/register_runner.sh https://github.com/owner/repo labels="self-hosted,linux,hardware"
+#
+REPO_URL=${1:-}
+LABELS=${2:-"self-hosted,linux,hardware"}
+RUNNER_DIR=${3:-/opt/actions-runner}
+
+if [ -z "$REPO_URL" ]; then
+  echo "Usage: $0 <repo_url> [labels] [runner_dir]"
+  exit 2
+fi
+echo "Creating runner directory at $RUNNER_DIR"
+mkdir -p "$RUNNER_DIR"
+cd "$RUNNER_DIR"
+if [ ! -f ./config.sh ]; then
+  echo "Downloading runner package (operator must provide version)"
+  # Operator should download runner from GitHub releases and extract here
+  echo "Please download GitHub Actions runner into $RUNNER_DIR and re-run this script"
+  exit 2
+fi
+if [ -z "${RUNNER_TOKEN:-}" ]; then
+  echo "Set RUNNER_TOKEN env var (create from GitHub repo settings > Actions > Runners > New runner)"
+  exit 2
+fi
+./config.sh --url "$REPO_URL" --token "$RUNNER_TOKEN" --labels "$LABELS" --unattended
+./svc.sh install
+./svc.sh start
+echo "Runner registered and started"
+
