+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run lab RT validation steps on the target robot node (or local machine for dev).
+# This script runs IRQ/NIC tuning, runs the p99 validator, and starts jitter Prometheus exporter.
+#
+NODE=${1:-localhost}
+FREQ=${2:-1000}
+ITERS=${3:-5000}
+P99_SLO_MS=${4:-0.2}
+
+echo "Running IRQ/NIC tuning (requires root) on $NODE"
+if [ "$NODE" = "localhost" ] || [ "$NODE" = "$(hostname)" ]; then
+  sudo ./ops/robotics/rt/irq_nic_tuning.sh eth0 4
+else
+  ssh "$NODE" "sudo /opt/aegis/ops/robotics/rt/irq_nic_tuning.sh eth0 4"
+fi
+
+echo "Running p99 validator locally"
+python3 ops/robotics/rt/p99_validator.py --freq "$FREQ" --iters "$ITERS" --p99-slo-ms "$P99_SLO_MS"
+
+echo "Starting jitter Prometheus exporter in background (port 9102)"
+nohup python3 ops/robotics/rt/jitter_prometheus_exporter.py --freq "$FREQ" --iters "$ITERS" --port 9102 >/tmp/jitter_exporter.log 2>&1 &
+echo "Exporter started, logs: /tmp/jitter_exporter.log"
+
+echo "Lab validation finished. Check /tmp/rt_jitter_result.json and Prometheus scrape target for metrics."
+
