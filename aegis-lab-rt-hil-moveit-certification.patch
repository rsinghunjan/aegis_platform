+#!/usr/bin/env python3
+"""
+Generate a HARA (Hazard Analysis and Risk Assessment) skeleton CSV for the operator to fill in.
+Produces ops/robotics/certification/hara_<timestamp>.csv
+"""
+import csv, time, os
+
+OUTDIR="ops/robotics/certification"
+os.makedirs(OUTDIR, exist_ok=True)
+ts = int(time.time())
+OUT = os.path.join(OUTDIR, f"hara_{ts}.csv")
+FIELDS = ["function", "hazard", "severity", "probability", "risk_level", "mitigations", "test_cases", "evidence_refs"]
+
+with open(OUT, "w", newline="") as fh:
+    w = csv.writer(fh)
+    w.writerow(FIELDS)
+    # example row
+    w.writerow(["torque_control","loss_of_torque","catastrophic","remote","high","hw watchdog, safe-stop","jitter_test, fault_injection","/tmp/audit_bundle.tar.gz"])
+
+print("HARA skeleton written to", OUT)
+
