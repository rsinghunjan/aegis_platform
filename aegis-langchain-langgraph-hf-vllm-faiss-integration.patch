+#!/usr/bin/env python3
+"""
+Minimal RAG demo that:
+ - Builds a FAISS index from sample docs (data/sample_texts.txt)
+ - Queries the index for top-K contexts
+ - Calls the Generation service (via SimpleGenerationWrapper or LangChain LLM) to answer using retrieved context
+ - If LangChain present, demonstrates constructing a simple Retrieval QA chain (best-effort)
+"""
+from pathlib import Path
+import os
+from ops.integrations.embeddings_faiss import build_index, query_index
+from ops.integrations.langchain_llm import SimpleGenerationWrapper, GenerationLLM, LANGCHAIN_AVAILABLE
+from ops.integrations.langchain_tools import make_all_tools
+
+DOCS = Path("data/sample_texts.txt")
+
+def run_demo(prompt="What is Aegis?"):
+    if not DOCS.exists():
+        print("Sample texts not found; run tools/data/build_sample_dataset.py first")
+        return
+    texts = DOCS.read_text().splitlines()
+    print("Building index...")
+    idx = build_index(texts)
+    print("Querying index for context...")
+    top = query_index(prompt, index_path=idx, top_k=3)
+    contexts = [t[2] for t in top]
+    print("Retrieved contexts:", contexts)
+
+    # Compose prompt with contexts
+    ctx_block = "\n\n".join([f"Context {i+1}: {c}" for i,c in enumerate(contexts)])
+    full_prompt = f"{ctx_block}\n\nQuestion: {prompt}\nAnswer:"
+
+    print("Invoking Generation backend...")
+    try:
+        wrapper = SimpleGenerationWrapper()
+        ans = wrapper.generate(full_prompt, max_tokens=128)
+        print("Answer:", ans)
+    except Exception as e:
+        print("Direct generation failed:", e)
+        if LANGCHAIN_AVAILABLE and GenerationLLM is not None:
+            print("Trying via LangChain LLM integration...")
+            llm = GenerationLLM()
+            resp = llm(full_prompt)
+            print("LLM response:", resp)
+        else:
+            print("LangChain not available or GenerationLLM not configured.")
+
+if __name__=="__main__":
+    run_demo()
+
