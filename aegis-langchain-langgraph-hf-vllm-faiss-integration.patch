+#!/usr/bin/env python3
+"""
+Simple embeddings + FAISS index utilities.
+ - build_index(texts, model_name, index_path)
+ - query_index(query_text, model_name, index_path, top_k=5)
+Uses sentence-transformers for embeddings and faiss-cpu for index.
+"""
+from typing import List, Tuple
+import os
+import json
+from pathlib import Path
+
+try:
+    from sentence_transformers import SentenceTransformer
+except Exception:
+    SentenceTransformer = None
+
+try:
+    import faiss
+except Exception:
+    faiss = None
+
+INDEX_DIR = Path("data/faiss")
+INDEX_DIR.mkdir(parents=True, exist_ok=True)
+
+def _get_model(model_name: str = "all-mpnet-base-v2"):
+    if SentenceTransformer is None:
+        raise RuntimeError("sentence-transformers not installed; please install ops/integrations/requirements-langchain.txt")
+    return SentenceTransformer(model_name)
+
+def build_index(texts: List[str], model_name: str = "all-mpnet-base-v2", index_path: str = None):
+    m = _get_model(model_name)
+    embs = m.encode(texts, convert_to_numpy=True, show_progress_bar=False)
+    dim = embs.shape[1]
+    if faiss is None:
+        raise RuntimeError("faiss not installed; install faiss-cpu")
+    index = faiss.IndexFlatIP(dim)
+    faiss.normalize_L2(embs)
+    index.add(embs)
+    idx_path = index_path or str(INDEX_DIR / "index.faiss")
+    faiss.write_index(index, idx_path)
+    # Save metadata (texts)
+    meta_path = idx_path + ".meta.json"
+    Path(meta_path).write_text(json.dumps(texts, indent=2))
+    return idx_path
+
+def query_index(query: str, model_name: str = "all-mpnet-base-v2", index_path: str = None, top_k: int = 5) -> List[Tuple[int, float, str]]:
+    m = _get_model(model_name)
+    q = m.encode([query], convert_to_numpy=True)
+    faiss.normalize_L2(q)
+    idx_path = index_path or str(INDEX_DIR / "index.faiss")
+    if faiss is None:
+        raise RuntimeError("faiss not installed")
+    if not Path(idx_path).exists():
+        raise RuntimeError("index not found: " + idx_path)
+    index = faiss.read_index(idx_path)
+    D, I = index.search(q, top_k)
+    meta = json.loads(Path(idx_path + ".meta.json").read_text())
+    out = []
+    for i,score in zip(I[0], D[0]):
+        out.append((int(i), float(score), meta[i]))
+    return out
+
+__all__ = ["build_index", "query_index"]
+
