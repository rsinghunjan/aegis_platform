+#!/usr/bin/env python3
+"""
+A tiny LangGraph-like adapter: map graph nodes/actions to tool invocations and enforce safety.
+This is intentionally minimal and designed as a bridge for a real graph planner to call into.
+"""
+from typing import Dict, Any
+from ops.agent.orchestrator import run_action
+
+def execute_graph_plan(plan: Dict[str, Any]):
+    """
+    plan: {'nodes': [{'id': 'n1', 'action': 'http_get', 'args': {...}}, ...], 'edges': [...]}
+    Executes nodes in order (topological order not enforced here - simple sequential execution)
+    Returns list of node results.
+    """
+    out = []
+    for n in plan.get("nodes", []):
+        act = n.get("action")
+        args = n.get("args", {})
+        res = run_action(n.get("id","unnamed"), act, args)
+        out.append({"node": n.get("id"), "result": res})
+        if not res.get("ok"):
+            # stop on failure
+            break
+    return out
+
