+#!/usr/bin/env python3
+"""
+Convert Aegis agent tools (ops.agent.tools) into LangChain Tool objects (if langchain is available).
+Each tool wrapper enforces safety_monitor.check_and_allow before executing the tool.
+"""
+from typing import Callable, Dict, Any
+try:
+    from langchain.tools import tool
+    LANGCHAIN_TOOLS_AVAILABLE = True
+except Exception:
+    LANGCHAIN_TOOLS_AVAILABLE = False
+
+from ops.agent import tools as agent_tools
+from ops.autonomy.safety_monitor import check_and_allow, record_manifest
+
+def _wrap_tool(tool_fn: Callable, name: str, description: str):
+    def wrapped(*args, **kwargs):
+        # high-level runtime check
+        if not check_and_allow(name, {"args_preview": str(args)[:200], "kwargs_preview": str(kwargs)[:200]}):
+            m = record_manifest("tool_blocked", {"tool": name})
+            return {"error": "blocked", "manifest": m}
+        try:
+            res = tool_fn(**kwargs) if kwargs else tool_fn(*args)
+            record_manifest("tool_executed", {"tool": name, "result_preview": str(res)[:500]})
+            return res
+        except Exception as e:
+            record_manifest("tool_error", {"tool": name, "error": str(e)})
+            raise
+    return wrapped
+
+def mk_langchain_tool(name: str, tool_fn: Callable, description: str = ""):
+    """
+    Return a LangChain Tool object (if langchain installed) or a simple dict wrapper.
+    """
+    wrapped = _wrap_tool(tool_fn, name, description)
+    if LANGCHAIN_TOOLS_AVAILABLE:
+        return tool(function=wrapped, name=name, description=description)
+    # fallback: return dict-like descriptor
+    return {"name": name, "fn": wrapped, "description": description}
+
+def make_all_tools():
+    """
+    Create tools for the common agent functions.
+    """
+    out = []
+    # Example mapping; extend as needed
+    out.append(mk_langchain_tool("http_get", agent_tools.http_get, "HTTP GET tool"))
+    out.append(mk_langchain_tool("run_shell", agent_tools.run_shell, "Run shell command"))
+    out.append(mk_langchain_tool("noop", agent_tools.noop_tool, "No-op tool"))
+    return out
+
+__all__ = ["mk_langchain_tool", "make_all_tools", "LANGCHAIN_TOOLS_AVAILABLE"]
+
