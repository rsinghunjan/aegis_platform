+#!/usr/bin/env python3
+"""
+LangChain LLM adapter backed by the Aegis Generation gRPC service (ops/grpc/generation_client.py).
+Provides:
+ - GenerationLLM: Subclass of langchain LLM when available (provides _call/_generate).
+ - SimpleGenerationWrapper: fallback callable wrapper if langchain is not installed.
+
+This module degrades gracefully if langchain is not installed.
+"""
+from typing import Optional, List, Dict
+import os
+try:
+    from ops.grpc.generation_client import GenerationClient
+except Exception:
+    # generation_client not generated / available
+    GenerationClient = None
+
+try:
+    # LangChain LLM base (newer versions)
+    from langchain.llms.base import LLM
+    from langchain.schema import LLMResult, Generation
+    LANGCHAIN_AVAILABLE = True
+except Exception:
+    LANGCHAIN_AVAILABLE = False
+
+class SimpleGenerationWrapper:
+    """
+    Minimal wrapper around GenerationClient providing .generate(prompt, max_tokens) and .stream_generate
+    """
+    def __init__(self, host="127.0.0.1", port=50054, insecure=None):
+        if GenerationClient is None:
+            raise RuntimeError("GenerationClient not available; run ops/grpc/_generate_stubs.py and ensure generation_client exists")
+        self.client = GenerationClient(host=host, port=port, insecure=insecure)
+
+    def generate(self, prompt: str, max_tokens: int = 64) -> str:
+        try:
+            tokens = self.client.generate(prompt, max_tokens=max_tokens)
+            if isinstance(tokens, (list, tuple)):
+                return " ".join(tokens)
+            return str(tokens)
+        except Exception as e:
+            raise
+
+    def stream_generate(self, prompt: str, max_tokens: int = 64):
+        for token, idx in self.client.stream_generate(prompt, max_tokens=max_tokens):
+            yield token, idx
+
+if LANGCHAIN_AVAILABLE:
+    class GenerationLLM(LLM):
+        """
+        LangChain LLM adapter that calls the GenerationClient.
+        Implements _call and _generate as required by langchain.
+        """
+        def __init__(self, host="127.0.0.1", port=50054, insecure=None, **kwargs):
+            super().__init__(**kwargs)
+            self._wrapper = SimpleGenerationWrapper(host=host, port=port, insecure=insecure)
+
+        @property
+        def _identifying_params(self) -> dict:
+            return {"host": getattr(self, "_host", "127.0.0.1")}
+
+        @property
+        def _llm_type(self) -> str:
+            return "aegis-generation-grpc"
+
+        def _call(self, prompt: str, stop: Optional[List[str]] = None) -> str:
+            # unary generate
+            out = self._wrapper.generate(prompt, max_tokens=1024)
+            return out
+
+        def _generate(self, prompts: List[str], stop: Optional[List[str]] = None) -> LLMResult:
+            generations = []
+            for p in prompts:
+                text = self._wrapper.generate(p, max_tokens=1024)
+                generations.append([Generation(text=text)])
+            return LLMResult(generations=generations)
+
+else:
+    GenerationLLM = None
+
+__all__ = ["SimpleGenerationWrapper", "GenerationLLM", "LANGCHAIN_AVAILABLE"]
+
