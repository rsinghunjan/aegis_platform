+#!/usr/bin/env python3
+"""
+Lightweight SQLite persistence for LangGraph plans and traces.
+ - Stores plans, nodes, node results, status and timestamps.
+ - Simple JSON blobs in SQLite for portability.
+"""
+import sqlite3
+import json
+from pathlib import Path
+from typing import Optional, Dict, Any, List
+import time
+
+DB_PATH = Path("data/langgraph.db")
+DB_PATH.parent.mkdir(parents=True, exist_ok=True)
+
+def _conn():
+    c = sqlite3.connect(str(DB_PATH), check_same_thread=False)
+    c.row_factory = sqlite3.Row
+    return c
+
+def init_db():
+    conn = _conn()
+    cur = conn.cursor()
+    cur.execute("""
+    CREATE TABLE IF NOT EXISTS plans (
+      plan_id TEXT PRIMARY KEY,
+      plan_json TEXT,
+      status TEXT,
+      created_at REAL,
+      updated_at REAL
+    )
+    """)
+    cur.execute("""
+    CREATE TABLE IF NOT EXISTS nodes (
+      node_id TEXT PRIMARY KEY,
+      plan_id TEXT,
+      node_json TEXT,
+      status TEXT,
+      result_json TEXT,
+      attempts INTEGER DEFAULT 0,
+      last_error TEXT,
+      created_at REAL,
+      updated_at REAL
+    )
+    """)
+    conn.commit()
+    conn.close()
+
+def save_plan(plan_id: str, plan: Dict[str, Any], status: str="pending"):
+    now = time.time()
+    conn = _conn()
+    cur = conn.cursor()
+    cur.execute("INSERT OR REPLACE INTO plans(plan_id, plan_json, status, created_at, updated_at) VALUES (?,?,?,?,?)",
+                (plan_id, json.dumps(plan), status, now, now))
+    conn.commit()
+    conn.close()
+
+def set_plan_status(plan_id: str, status: str):
+    now = time.time()
+    conn = _conn()
+    cur = conn.cursor()
+    cur.execute("UPDATE plans SET status=?, updated_at=? WHERE plan_id=?", (status, now, plan_id))
+    conn.commit()
+    conn.close()
+
+def add_node(plan_id: str, node: Dict[str, Any], status: str="pending"):
+    now = time.time()
+    conn = _conn()
+    cur = conn.cursor()
+    node_id = node.get("id") or f"{plan_id}-{int(now*1000)}"
+    cur.execute("INSERT OR REPLACE INTO nodes(node_id, plan_id, node_json, status, result_json, attempts, last_error, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?)",
+                (node_id, plan_id, json.dumps(node), status, json.dumps({}), 0, "", now, now))
+    conn.commit()
+    conn.close()
+    return node_id
+
+def list_pending_plans() -> List[Dict[str,Any]]:
+    conn = _conn()
+    cur = conn.cursor()
+    cur.execute("SELECT plan_id, plan_json, status, created_at, updated_at FROM plans WHERE status='pending' ORDER BY created_at ASC")
+    rows = cur.fetchall()
+    out = []
+    for r in rows:
+        out.append({"plan_id": r["plan_id"], "plan": json.loads(r["plan_json"]), "status": r["status"], "created_at": r["created_at"], "updated_at": r["updated_at"]})
+    conn.close()
+    return out
+
+def list_nodes_for_plan(plan_id: str) -> List[Dict[str,Any]]:
+    conn = _conn()
+    cur = conn.cursor()
+    cur.execute("SELECT node_id, node_json, status, result_json, attempts, last_error FROM nodes WHERE plan_id=?", (plan_id,))
+    rows = cur.fetchall()
+    out = []
+    for r in rows:
+        out.append({"node_id": r["node_id"], "node": json.loads(r["node_json"]), "status": r["status"], "result": json.loads(r["result_json"] or "{}"), "attempts": r["attempts"], "last_error": r["last_error"]})
+    conn.close()
+    return out
+
+def update_node_result(node_id: str, status: str, result: Optional[Dict[str,Any]]=None, error: Optional[str]=None, attempt_inc: int = 1):
+    now = time.time()
+    conn = _conn()
+    cur = conn.cursor()
+    cur.execute("SELECT attempts FROM nodes WHERE node_id=?", (node_id,))
+    row = cur.fetchone()
+    attempts = (row["attempts"] if row else 0) + attempt_inc
+    cur.execute("UPDATE nodes SET status=?, result_json=?, attempts=?, last_error=?, updated_at=? WHERE node_id=?", (status, json.dumps(result or {}), attempts, error or "", now, node_id))
+    conn.commit()
+    conn.close()
+
+def get_plan(plan_id: str) -> Optional[Dict[str,Any]]:
+    conn = _conn()
+    cur = conn.cursor()
+    cur.execute("SELECT plan_json, status, created_at, updated_at FROM plans WHERE plan_id=?", (plan_id,))
+    r = cur.fetchone()
+    conn.close()
+    if not r:
+        return None
+    return {"plan": json.loads(r["plan_json"]), "status": r["status"], "created_at": r["created_at"], "updated_at": r["updated_at"]}
+
+def get_node(node_id: str):
+    conn = _conn()
+    cur = conn.cursor()
+    cur.execute("SELECT node_json, status, result_json, attempts, last_error FROM nodes WHERE node_id=?", (node_id,))
+    r = cur.fetchone()
+    conn.close()
+    if not r:
+        return None
+    return {"node": json.loads(r["node_json"]), "status": r["status"], "result": json.loads(r["result_json"] or "{}"), "attempts": r["attempts"], "last_error": r["last_error"]}
+
+if __name__=="__main__":
+    init_db()
+    print("LangGraph DB initialized at", DB_PATH)
+
