+#!/usr/bin/env python3
+"""
+LangGraph executor: durable, topology-aware execution engine.
+ - Accepts plans with nodes and edges, persists them, computes topological order and executes nodes.
+ - Executes nodes by calling ops.agent.orchestrator.run_action, which enforces safety policies and records manifests.
+ - Supports concurrency for independent nodes and per-node retries.
+"""
+import threading
+import time
+import uuid
+import json
+from typing import Dict, Any, List, Tuple, Optional, Set
+from queue import Queue, Empty
+
+from ops.langgraph import persistence as db
+from ops.agent.orchestrator import run_action
+
+WORKER_SLEEP = 0.5
+
+def topological_sort(nodes: List[Dict[str,Any]], edges: List[Tuple[str,str]]) -> List[str]:
+    # Kahn's algorithm
+    deps = {n["id"]: set() for n in nodes}
+    children = {n["id"]: set() for n in nodes}
+    for a,b in edges:
+        deps[b].add(a)
+        children[a].add(b)
+    ready = [n for n in deps if not deps[n]]
+    order = []
+    while ready:
+        n = ready.pop(0)
+        order.append(n)
+        for c in list(children[n]):
+            deps[c].remove(n)
+            children[n].remove(c)
+            if not deps[c]:
+                ready.append(c)
+    if any(deps[k] for k in deps):
+        # cycle detected; fallback to node id order
+        return [n["id"] for n in nodes]
+    return order
+
+class PlanRunner(threading.Thread):
+    def __init__(self, plan_id: str, concurrency: int = 2, max_retries: int = 1):
+        super().__init__(daemon=True)
+        self.plan_id = plan_id
+        self.concurrency = concurrency
+        self.max_retries = max_retries
+        self._stop = threading.Event()
+
+    def run(self):
+        plan_blob = db.get_plan(self.plan_id)
+        if not plan_blob:
+            return
+        plan = plan_blob["plan"]
+        nodes = plan.get("nodes", [])
+        edges = plan.get("edges", [])
+        node_map = {n["id"]: n for n in nodes}
+        order = topological_sort(nodes, edges)
+        db.set_plan_status(self.plan_id, "running")
+        # simple concurrency: worker pool execute nodes when dependencies done
+        completed: Set[str] = set()
+        in_progress: Set[str] = set()
+        while True:
+            progressed = False
+            for nid in order:
+                if nid in completed or nid in in_progress:
+                    continue
+                # check deps
+                preds = [a for (a,b) in edges if b == nid]
+                if any(p not in completed for p in preds):
+                    continue
+                # execute node
+                in_progress.add(nid)
+                node = node_map[nid]
+                try:
+                    res = run_action(nid, node.get("action"), node.get("args", {}))
+                    if res.get("ok"):
+                        db.update_node_result(nid, "succeeded", result=res)
+                        completed.add(nid)
+                    else:
+                        attempts = db.get_node(nid).get("attempts",0)
+                        if attempts < self.max_retries:
+                            db.update_node_result(nid, "retrying", result=res, error=str(res))
+                        else:
+                            db.update_node_result(nid, "failed", result=res, error=str(res))
+                            # stop execution on node failure
+                            db.set_plan_status(self.plan_id, "failed")
+                            return
+                except Exception as e:
+                    attempts = db.get_node(nid).get("attempts",0)
+                    if attempts < self.max_retries:
+                        db.update_node_result(nid, "retrying", result={}, error=str(e))
+                    else:
+                        db.update_node_result(nid, "failed", result={}, error=str(e))
+                        db.set_plan_status(self.plan_id, "failed")
+                        return
+                finally:
+                    in_progress.remove(nid)
+                    progressed = True
+            if not progressed:
+                # nothing progressed: either done or waiting on something impossible
+                break
+            if len(completed) == len(nodes):
+                db.set_plan_status(self.plan_id, "succeeded")
+                return
+            time.sleep(WORKER_SLEEP)
+        # if we exit loop: set status depending on completed nodes
+        if len(completed) == len(nodes):
+            db.set_plan_status(self.plan_id, "succeeded")
+        else:
+            db.set_plan_status(self.plan_id, "partial")
+
+class PlanManager:
+    def __init__(self):
+        self.runners: Dict[str, PlanRunner] = {}
+
+    def submit_plan(self, plan: Dict[str,Any], plan_id: Optional[str]=None) -> str:
+        pid = plan_id or plan.get("plan_id") or str(uuid.uuid4())
+        db.save_plan(pid, plan, status="pending")
+        # persist nodes
+        for n in plan.get("nodes", []):
+            db.add_node(pid, n, status="pending")
+        # start runner
+        runner = PlanRunner(pid)
+        self.runners[pid] = runner
+        runner.start()
+        return pid
+
+    def status(self, plan_id: str):
+        return db.get_plan(plan_id)
+
+    def list_pending(self):
+        return db.list_pending_plans()
+
+manager = PlanManager()
+
+if __name__ == "__main__":
+    db.init_db()
+    # simple demo runner
+    sample = {"nodes":[{"id":"n1","action":"http_get","args":{"url":"https://example.com"}},{"id":"n2","action":"noop","args":{}}],"edges":[["n1","n2"]]}
+    pid = manager.submit_plan(sample)
+    print("Submitted plan", pid)
+
