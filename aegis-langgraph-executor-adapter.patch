+#!/usr/bin/env python3
+"""
+FastAPI server that exposes APIs to submit LangGraph plans and monitor execution.
+ - /submit -> accept plan JSON, persist and start execution
+ - /status/{plan_id} -> plan status and node results
+ - /plans -> list submitted plans
+"""
+import uvicorn
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from typing import Dict, Any, List
+
+from ops.langgraph import persistence as db
+from ops.langgraph.executor import manager
+
+app = FastAPI(title="Aegis LangGraph Executor")
+
+class NodeModel(BaseModel):
+    id: str
+    action: str
+    args: Dict[str,Any] = {}
+
+class PlanModel(BaseModel):
+    plan_id: str = None
+    nodes: List[NodeModel]
+    edges: List[List[str]] = []  # [from, to] pairs
+
+@app.on_event("startup")
+def startup():
+    db.init_db()
+
+@app.post("/submit")
+def submit_plan(plan: PlanModel):
+    p = plan.dict()
+    pid = manager.submit_plan(p, plan_id=p.get("plan_id"))
+    return {"plan_id": pid}
+
+@app.get("/status/{plan_id}")
+def status(plan_id: str):
+    p = manager.status(plan_id)
+    if not p:
+        raise HTTPException(status_code=404, detail="plan not found")
+    nodes = db.list_nodes_for_plan(plan_id)
+    return {"plan": p, "nodes": nodes}
+
+@app.get("/plans")
+def list_plans():
+    return {"pending": manager.list_pending()}
+
+if __name__=="__main__":
+    uvicorn.run(app, host="0.0.0.0", port=8088)
+
