+#!/usr/bin/env python3
+"""
+Monitor moderation reviewer queue latency/backlog and alert if SLA breached.
+This script is intended to be run as a CronJob (see deploy/moderation/reviewer-sla-monitor-cronjob.yaml).
+"""
+import os, time, json
+try:
+    import redis
+except Exception:
+    redis = None
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+STREAM = os.environ.get("MODERATION_STREAM", "diffusers:moderation:stream")
+SLA_SECONDS = int(os.environ.get("MODERATION_SLA_SEC", str(60*60*4)))  # default 4 hours
+
+def check_sla():
+    if redis is None:
+        print("redis python client required")
+        return 2
+    r = redis.from_url(REDIS_URL)
+    pending = r.xpending(STREAM, "-", "+", 100)
+    now_ms = int(time.time() * 1000)
+    breaches = []
+    for p in pending:
+        try:
+            msg_id = p[0]
+            idle = int(p[2])
+        except Exception:
+            continue
+        if idle > (SLA_SECONDS * 1000):
+            breaches.append({"id": msg_id, "idle_ms": idle})
+    if breaches:
+        print("SLA breaches detected:", json.dumps(breaches, indent=2))
+        # TODO: integrate with alerting/incident system (PagerDuty/webhook)
+        return 1
+    print("No SLA breaches")
+    return 0
+
+if __name__ == "__main__":
+    exit(check_sla())
+
