+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Deploy webhook and generate cosign public key from KMS key reference.
+# Usage:
+#   ./ops/webhook/deploy_with_cosign_kms.sh --kubeconfig /path/kubeconfig --cosign-key "gcpkms://..." [--ca /path/ca.crt]
+#
+KUBECONFIG=""
+COSIGN_KEY_REF=""
+CA_PATH=""
+
+usage(){ cat <<EOF
+Usage: $0 --cosign-key COSIGN_KEY_REF [--kubeconfig KUBECONFIG] [--ca CA_PATH]
+
+This script:
+ - uses 'cosign public-key --key <COSIGN_KEY_REF>' to produce pubkey.pem
+ - creates Kubernetes secrets webhook-tls (if CA+server cert present) and aegis-cosign-pubkey
+ - applies deploy/webhook/deployment-cosign.yaml
+ - prints the base64 CA bundle for use in validatingwebhook-config.yaml
+EOF
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --kubeconfig) KUBECONFIG="$2"; shift 2;;
+    --cosign-key) COSIGN_KEY_REF="$2"; shift 2;;
+    --ca) CA_PATH="$2"; shift 2;;
+    --help) usage; exit 0;;
+    *) echo "Unknown arg $1"; usage; exit 2;;
+  esac
+done
+
+if [[ -z "$COSIGN_KEY_REF" ]]; then echo "Missing --cosign-key"; usage; exit 2; fi
+
+TMPDIR=$(mktemp -d)
+PUBKEY="$TMPDIR/pubkey.pem"
+echo "Generating cosign public key into $PUBKEY"
+if ! command -v cosign >/dev/null 2>&1; then echo "cosign required on PATH"; exit 2; fi
+cosign public-key --key "$COSIGN_KEY_REF" > "$PUBKEY"
+
+KUBE_ARGS=()
+if [[ -n "$KUBECONFIG" ]]; then KUBE_ARGS=(--kubeconfig "$KUBECONFIG"); fi
+
+kubectl "${KUBE_ARGS[@]}" create namespace ml-serving --dry-run=client -o yaml | kubectl "${KUBE_ARGS[@]}" apply -f -
+kubectl "${KUBE_ARGS[@]}" delete secret aegis-cosign-pubkey -n ml-serving --ignore-not-found
+kubectl "${KUBE_ARGS[@]}" create secret generic aegis-cosign-pubkey -n ml-serving --from-file=pubkey.pem="$PUBKEY"
+
+if [[ -n "$CA_PATH" ]]; then
+  SERVER_CRT="${CA_PATH%/*}/server.crt"
+  SERVER_KEY="${CA_PATH%/*}/server.key"
+  if [[ -f "$SERVER_CRT" && -f "$SERVER_KEY" ]]; then
+    kubectl "${KUBE_ARGS[@]}" delete secret webhook-tls -n ml-serving --ignore-not-found
+    kubectl "${KUBE_ARGS[@]}" create secret tls webhook-tls -n ml-serving --cert="$SERVER_CRT" --key="$SERVER_KEY"
+    echo "Created webhook-tls from provided CA path"
+  else
+    echo "CA provided but server.crt/server.key not found near CA; skipping TLS secret creation"
+  fi
+fi
+
+echo "Applying webhook deployment manifest"
+kubectl "${KUBE_ARGS[@]}" apply -f deploy/webhook/deployment-cosign.yaml
+
+if [[ -n "$CA_PATH" ]]; then
+  echo "CA bundle base64: (use to replace placeholder in deploy/webhook/validatingwebhook-config.yaml)"
+  base64 -w0 "$CA_PATH"
+fi
+
+echo "Done. Validate webhook by attempting to create unsigned and signed pods in protected namespace."
+
