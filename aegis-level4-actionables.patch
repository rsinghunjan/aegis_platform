+#!/usr/bin/env python3
+"""
+PoC mutating-webhook-like helper (not a real server) to annotate job manifests before submit.
+Intended to be used by orchestrator to add nodeAffinity/annotations suggesting low-carbon nodes.
+"""
+import json, sys
+from ops.monitoring.carbon_node_scheduler import pick_low_carbon_node
+
+def annotate_manifest(manifest_json):
+    js = json.loads(manifest_json)
+    top = pick_low_carbon_node()[:3]
+    nodes = [n["name"] for n in top]
+    ann = js.setdefault("metadata", {}).setdefault("annotations", {})
+    ann["aegis/low-carbon-nodes"] = json.dumps(nodes)
+    return json.dumps(js)
+
+if __name__ == "__main__":
+    inp = sys.stdin.read()
+    print(annotate_manifest(inp))
