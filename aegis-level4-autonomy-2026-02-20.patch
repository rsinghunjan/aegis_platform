+"""
+Safety Kernel
+- Integrates OPA policy checks, verifier service, and risk classification.
+- Provides: pre_check_plan, pre_check_action, post_check_action, is_low_risk
+"""
+import os
+import httpx
+import logging
+from typing import Tuple, Dict, Any, List
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa:8181")
+VERIFIER_URL = os.environ.get("AEGIS_VERIFIER_URL", "http://llm-verifier.ml.svc.cluster.local:8100/v1/verify")
+
+logger = logging.getLogger("aegis.safety")
+
+class SafetyKernel:
+    def __init__(self):
+        pass
+
+    def pre_check_plan(self, plan: List[Dict[str, Any]], metadata: Dict[str, Any]) -> Tuple[bool, List[str]]:
+        # Query OPA for plan-level allow/deny
+        try:
+            r = httpx.post(f"{OPA_URL}/v1/data/aegis/allow_plan", json={"input": {"plan": plan, "metadata": metadata}}, timeout=5.0)
+            if r.status_code == 200:
+                j = r.json()
+                allow = j.get("result", {}).get("allow", False)
+                reasons = j.get("result", {}).get("reasons", [])
+                return allow, reasons
+        except Exception as e:
+            logger.warning("OPA plan check failed: %s", e)
+        # conservative deny on failure
+        return False, ["opa_check_failed"]
+
+    def pre_check_action(self, action, metadata: Dict[str, Any]) -> Tuple[bool, List[str]]:
+        # small helper that calls OPA and optional verifier for action sanity
+        try:
+            r = httpx.post(f"{OPA_URL}/v1/data/aegis/allow_action", json={"input": {"action": action.__dict__, "metadata": metadata}}, timeout=5.0)
+            if r.status_code == 200:
+                j = r.json()
+                allow = j.get("result", {}).get("allow", False)
+                reasons = j.get("result", {}).get("reasons", [])
+                if not allow:
+                    return False, reasons
+        except Exception as e:
+            logger.warning("OPA action check failed: %s", e)
+            return False, ["opa_unavailable"]
+
+        # Run verifier for content-related actions (e.g., LLM outputs)
+        if action.name.startswith("k8s") or action.name in ("vault.sign", "argo.submit"):
+            # For these actions, do not call verifier; they are infra actions
+            return True, []
+        try:
+            resp = httpx.post(VERIFIER_URL, json={"input": action.params.get("input", ""), "output": "", "provenance": {}}, timeout=10.0)
+            if resp.status_code == 200:
+                v = resp.json()
+                if v.get("decision") == "accept":
+                    return True, []
+                elif v.get("decision") == "flag":
+                    return False, ["verifier_flagged"]
+        except Exception as e:
+            logger.warning("Verifier call failed: %s", e)
+            return False, ["verifier_unavailable"]
+        return False, ["unknown_verifier_result"]
+
+    def post_check_action(self, action, result) -> Tuple[bool, List[str]]:
+        # Placeholder: implement environment-specific validation, e.g. confirm k8s object created, metrics OK.
+        return True, []
+
+    def is_low_risk(self, plan: List[Dict[str, Any]]) -> bool:
+        # Heuristic: if all actions are idempotent and infrastructure-only, treat low-risk.
+        for a in plan:
+            if not a.get("idempotent", False):
+                return False
+            if a.get("name", "").startswith("k8s") or a.get("name","").startswith("argo"):
+                continue
+            # anything else flag as not low-risk
+            return False
+        return True
