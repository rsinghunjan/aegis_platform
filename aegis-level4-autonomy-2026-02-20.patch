+"""
+Aegis Agent Runtime (Level-4 autonomy scaffold)
+
+This service implements:
+ - Agent API: submit goals, get proposals, approve/reject actions
+ - Planner: produce candidate multi-step plans (delegates to planner module)
+ - Safety Kernel: enforces OPA policies and verifier checks before execution
+ - Executor: executes permitted actions via action registry (k8s, Argo, Kafka, Vault)
+ - Shadow mode vs Auto mode: default is SHADOW (no destructive actions). Switch to AUTO only after governance signoff.
+ - Evidence recording: persists every candidate and decision to MCP (audit trail).
+
+Critical: This is scaffolding. DO NOT enable AUTO mode in production without HSM commissioning,
+vendor DPAs, Rekor restore drills, external audits and governance board approval.
+"""
+import os
+import time
+import uuid
+import asyncio
+from typing import List, Dict, Any, Optional
+from fastapi import FastAPI, HTTPException, BackgroundTasks
+from pydantic import BaseModel
+import httpx
+import logging
+
+from agent.planner.planner import Planner
+from agent.safety.safety_kernel import SafetyKernel
+from agent.executor.executor import Executor, Action
+
+logger = logging.getLogger("aegis.agent")
+logging.basicConfig(level=os.environ.get("LOG_LEVEL", "INFO"))
+
+MCP_URL = os.environ.get("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+AGENT_MODE = os.environ.get("AEGIS_AGENT_MODE", "SHADOW")  # SHADOW | AUTO | PAUSED
+TRACE_ENABLED = os.environ.get("AEGIS_AGENT_TRACE", "true").lower() in ("1", "true", "yes")
+
+app = FastAPI(title="Aegis Agent Runtime")
+
+planner = Planner()
+safety = SafetyKernel()
+executor = Executor()
+
+class Goal(BaseModel):
+    id: Optional[str] = None
+    owner: str
+    intent: str
+    metadata: Optional[dict] = {}
+
+class Proposal(BaseModel):
+    proposal_id: str
+    goal_id: str
+    plan: List[Dict[str, Any]]
+    score: float
+    created_at: float
+
+class ActionDecision(BaseModel):
+    proposal_id: str
+    decision: str  # approve | reject | escalate
+    approver: str
+    notes: Optional[str] = None
+
+async def persist_agent_evidence(entry: dict):
+    """
+    Persist agent proposal/decision to MCP model-context for audit.
+    Best-effort; failures do not crash the agent.
+    """
+    payload = {
+        "schema_version": "1.1",
+        "model_id": "aegis-agent",
+        "version": "v1",
+        "notes": "agent evidence",
+        "llm_call": { "agent_entry": entry, "timestamp": int(time.time()) }
+    }
+    try:
+        async with httpx.AsyncClient(timeout=5.0) as c:
+            await c.post(f"{MCP_URL}/model-context", json=payload)
+    except Exception as e:
+        logger.warning("Failed to persist agent evidence: %s", e)
+
+@app.post("/v1/submit_goal", response_model=Proposal)
+async def submit_goal(goal: Goal, background_tasks: BackgroundTasks):
+    """
+    Submit a goal to the Agent.
+    Returns a top proposal (best-ranked) but also generates alternatives.
+    In SHADOW mode proposals are recorded but not executed.
+    """
+    goal.id = goal.id or f"goal-{uuid.uuid4().hex[:8]}"
+    logger.info("Received goal %s intent=%s owner=%s", goal.id, goal.intent, goal.owner)
+
+    # Generate candidate plans using planner
+    plan_candidates = planner.generate_plans(goal.intent, goal.metadata or {})
+    # Score candidates
+    scored = planner.rank_plans(plan_candidates)
+    top = scored[0]
+    proposal = Proposal(
+        proposal_id=f"prop-{uuid.uuid4().hex[:8]}",
+        goal_id=goal.id,
+        plan=top["plan"],
+        score=top["score"],
+        created_at=time.time()
+    )
+
+    # Persist evidence (proposal) asynchronously
+    background_tasks.add_task(persist_agent_evidence, {"type":"proposal","proposal":proposal.dict(),"goal":goal.dict(),"mode":AGENT_MODE})
+
+    # If agent in AUTO and the plan is low-risk and passes safety checks -> attempt auto-execution
+    if AGENT_MODE == "AUTO":
+        try:
+            # perform safety pre-checks
+            ok, reasons = safety.pre_check_plan(proposal.plan, goal.metadata)
+            if not ok:
+                logger.info("Pre-check failed for proposal %s: %s", proposal.proposal_id, reasons)
+            else:
+                # For low-risk plans, execute automatically; high-risk require approval or multi-party signing
+                if safety.is_low_risk(proposal.plan):
+                    # execute plan in background
+                    background_tasks.add_task(_execute_plan_background, proposal, goal)
+                else:
+                    logger.info("Proposal %s requires HIL or multi-party approval", proposal.proposal_id)
+        except Exception as e:
+            logger.exception("Error during AUTO pre-check/execute: %s", e)
+
+    return proposal
+
+async def _execute_plan_background(proposal: Proposal, goal: Goal):
+    entry = {"proposal_id": proposal.proposal_id, "goal_id": proposal.goal_id, "plan": proposal.plan}
+    # persist start evidence
+    await persist_agent_evidence({"type":"execution_start","proposal":entry})
+    # execute each action sequentially with safety checks and rollback support
+    executed_actions = []
+    try:
+        for step in proposal.plan:
+            action = Action.from_dict(step)
+            # policy and verifier check per action
+            ok, reasons = safety.pre_check_action(action, goal.metadata)
+            if not ok:
+                raise RuntimeError(f"Safety pre-check failed for action {action.name}: {reasons}")
+            result = executor.execute(action)
+            executed_actions.append({"action": action.name, "result": result})
+            # Post-check: validate side-effects (via safety_kernel)
+            post_ok, post_reasons = safety.post_check_action(action, result)
+            if not post_ok:
+                # attempt rollback for executed actions
+                logger.warning("Post-check failed, initiating rollback: %s", post_reasons)
+                await _rollback_actions(executed_actions)
+                raise RuntimeError(f"Post-check failed: {post_reasons}")
+        await persist_agent_evidence({"type":"execution_success","proposal":entry,"actions":executed_actions})
+    except Exception as e:
+        await persist_agent_evidence({"type":"execution_failure","proposal":entry,"error": str(e)})
+        logger.exception("Execution failed for proposal %s", proposal.proposal_id)
+
+async def _rollback_actions(executed_actions: List[dict]):
+    # best-effort rollback in reverse order
+    for a in reversed(executed_actions):
+        try:
+            logger.info("Rolling back action %s", a.get("action"))
+            executor.rollback(a.get("action"), a.get("result"))
+        except Exception as e:
+            logger.exception("Rollback failed for %s: %s", a.get("action"), e)
+
+@app.post("/v1/decide", status_code=204)
+async def decide(decision: ActionDecision, background_tasks: BackgroundTasks):
+    """
+    Record an explicit Approve/Reject decision from a human operator for a proposal.
+    If approved and running in AUTO mode, execute the plan.
+    """
+    logger.info("Received decision for %s: %s by %s", decision.proposal_id, decision.decision, decision.approver)
+    # persist decision
+    background_tasks.add_task(persist_agent_evidence, {"type":"decision","decision":decision.dict()})
+    if decision.decision == "approve" and AGENT_MODE in ("AUTO","SHADOW"):
+        # find proposal (in a real system proposals persisted in DB; here we assume client supplies plan)
+        # For scaffold: client must include plan in metadata for execution; in prod, lookup persisted proposal
+        plan = decision.__dict__.get("plan")
+        if not plan:
+            # In scaffolding, nothing to execute
+            return
+        proposal = Proposal(proposal_id=decision.proposal_id, goal_id="", plan=plan, score=1.0, created_at=time.time())
+        background_tasks.add_task(_execute_plan_background, proposal, Goal(owner=decision.approver, intent="approved-intent"))
+    return
+
+@app.get("/health")
+async def health():
+    return {"status":"ok","mode":AGENT_MODE}
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run("agent.agent_runtime.main:app", host="0.0.0.0", port=8600, log_level="info")
