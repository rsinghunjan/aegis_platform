+"""
+Executor and Action registry
+- Translates structured actions into concrete calls (K8s job submit, Argo workflow, Kafka publish, Vault sign).
+- Each action registers handlers and a rollback implementation.
+"""
+import os
+import logging
+import subprocess
+from typing import Dict, Any
+
+logger = logging.getLogger("aegis.executor")
+
+class Action:
+    def __init__(self, name: str, params: Dict[str, Any], idempotent: bool=True, rollback: Dict[str, Any]=None):
+        self.name = name
+        self.params = params
+        self.idempotent = idempotent
+        self.rollback_spec = rollback
+
+    @staticmethod
+    def from_dict(d: Dict[str, Any]) -> "Action":
+        return Action(name=d.get("name"), params=d.get("params", {}), idempotent=d.get("idempotent", True), rollback=d.get("rollback"))
+
+class Executor:
+    def __init__(self):
+        # mapping action name -> handler
+        self.handlers = {
+            "k8s.apply": self._k8s_apply,
+            "argo.submit": self._argo_submit,
+            "kafka.publish": self._kafka_publish,
+            "vault.sign": self._vault_sign,
+            "noop": self._noop,
+        }
+
+    def execute(self, action: Action) -> Dict[str, Any]:
+        handler = self.handlers.get(action.name)
+        if not handler:
+            raise RuntimeError(f"No handler for action {action.name}")
+        return handler(action.params)
+
+    def rollback(self, action_name: str, result: Dict[str, Any]):
+        # simplistic rollback: call rollback based on result metadata or action rollback spec
+        logger.info("Rollback invoked for %s (noop placeholder)", action_name)
+
+    def _k8s_apply(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        # params: { "manifest": "<yaml string>" } or {"file": "/tmp/foo.yaml"}
+        if "manifest" in params:
+            p = params["manifest"]
+            proc = subprocess.run(["kubectl", "apply", "-f", "-"], input=p.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            out = proc.stdout.decode() + proc.stderr.decode()
+            return {"status": "applied", "output": out}
+        elif "file" in params:
+            proc = subprocess.run(["kubectl", "apply", "-f", params["file"]], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            out = proc.stdout.decode() + proc.stderr.decode()
