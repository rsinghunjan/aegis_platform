+"""
+Planner module
+- Generates candidate multi-step plans given a textual intent.
+- For Level-4 bootstrap we use the LLM Adapter to produce candidates and convert to structured actions.
+"""
+import os
+import json
+import uuid
+from typing import List, Dict, Any
+import httpx
+import logging
+
+ADAPTER_URL = os.environ.get("AEGIS_LLM_ADAPTER_URL", "http://llm-adapter.ml.svc.cluster.local:8000/v1/generate")
+logger = logging.getLogger("aegis.planner")
+
+class Planner:
+    def __init__(self, adapter_url: str = ADAPTER_URL):
+        self.adapter_url = adapter_url
+
+    def generate_plans(self, intent: str, metadata: Dict[str, Any]) -> List[Dict[str, Any]]:
+        """
+        Call LLM Adapter to produce plan candidates as JSON arrays of actions.
+        Each action should include: name, params, idempotent(bool), rollback action.
+        """
+        prompt = self._build_prompt(intent, metadata)
+        try:
+            r = httpx.post(self.adapter_url, json={"task":"plan","sensitivity": "low","input": prompt, "metadata": {"role":"planner"}}, timeout=20.0)
+            r.raise_for_status()
+            resp = r.json()
+            text = resp.get("output","")
+            # Expect JSON in the output: [{ "plan": [ {action}, ... ] }, ...]
+            candidates = json.loads(text)
+            # normalize to expected structure
+            plans = []
+            for c in candidates:
+                plan = c.get("plan") if isinstance(c, dict) else c
+                plans.append({"id": str(uuid.uuid4()), "plan": plan})
+            return plans
+        except Exception as e:
+            logger.exception("Planner LLM call failed: %s", e)
+            # fallback: empty plan
+            return [{"id": str(uuid.uuid4()), "plan": []}]
+
+    def rank_plans(self, candidates: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+        """
+        Very simple ranking: prefer shorter plans and plans with idempotent actions.
+        In production use a learned scorer or verifier ensemble.
+        """
+        scored = []
+        for c in candidates:
+            plan = c.get("plan", [])
+            score = 100.0 - len(plan)
+            # reward idempotency
+            idempotent_bonus = sum(1 for a in plan if a.get("idempotent", False))
+            score += idempotent_bonus
+            scored.append({"plan": plan, "score": score})
+        # sort desc
+        scored.sort(key=lambda x: x["score"], reverse=True)
+        return scored
+
+    def _build_prompt(self, intent: str, metadata: Dict[str, Any]) -> str:
+        # Prompt instructs adapter to return JSON-encoded plan candidates
+        prompt = f"""
+You are an agent planner. Given the intent and metadata, generate up to 3 candidate plans.
+Each plan must be a JSON object with key "plan": an array of actions.
+Each action must include: name (string), params (object), idempotent (bool), rollback (object or null).
+Intent: {intent}
+Metadata: {json.dumps(metadata)}
+Return a JSON array of plan objects only.
+"""
+        return prompt
+
