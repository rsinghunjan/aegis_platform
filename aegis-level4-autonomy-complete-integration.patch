+#!/usr/bin/env bash
+set -euo pipefail
+#
+# CI helper: evaluate promotion policy by querying OPA (local) or running policy as Python/JS.
+# Expects JSON inputs: validator.json, artifact.json, sbom_grype.json
+OPA_REST=${OPA_REST:-http://localhost:8181/v1/data/aegis/promotion/allow}
+
+if [ $# -lt 3 ]; then
+  echo "Usage: $0 validator.json artifact.json sbom_grype.json"
+  exit 2
+fi
+
+validator="$1"
+artifact="$2"
+sbom="$3"
+
+payload=$(jq -n --argfile v "$validator" --argfile a "$artifact" --argfile s "$sbom" '{input:{validator:$v, artifact:$a, sbom:{vulns: ($s.matches // [])}}}')
+
+echo "Querying OPA for promotion decision..."
+res=$(curl -s -X POST -H "Content-Type: application/json" -d "$payload" "$OPA_REST")
+allowed=$(echo "$res" | jq -r '.result')
+if [ "$allowed" = "true" ]; then
+  echo "OPA: promotion allowed"
+  exit 0
+else
+  echo "OPA: promotion blocked"
+  echo "$res" | jq .
+  exit 3
+fi
+
