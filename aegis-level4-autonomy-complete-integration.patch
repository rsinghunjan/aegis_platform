+#!/usr/bin/env python3
+"""
+Assemble evidence artifacts, sign with cosign (KMS), upload to S3, and append Rekor entry.
+Intended to be invoked by automation after each critical operation (FL round, training, rollout).
+"""
+import os, json, subprocess, tempfile
+from datetime import datetime
+
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI","{{COSIGN_KMS_URI_PLACEHOLDER}}")
+S3 = os.environ.get("S3_UPLOAD","{{S3_UPLOAD_PLACEHOLDER}}")
+REKOR = os.environ.get("REKOR_SERVER","{{REKOR_SERVER_PLACEHOLDER}}")
+
+def bundle(artifacts, out=None):
+    out = out or f"/tmp/aegis_evidence_{int(time.time())}.tar.gz"
+    tmpdir = tempfile.mkdtemp()
+    for f in artifacts:
+        try:
+            subprocess.check_call(["cp","-r",f,tmpdir])
+        except Exception:
+            pass
+    subprocess.check_call(["tar","-czf",out,"-C",tmpdir,"."])
+    return out
+
+def sign_and_upload(bundle_path):
+    if COSIGN_KEY:
+        try:
+            subprocess.check_call(["cosign","sign","--key",COSIGN_KEY, bundle_path])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    if S3:
+        try:
+            subprocess.check_call(["aws","s3","cp",bundle_path, f"{S3}/{os.path.basename(bundle_path)}"])
+        except Exception as e:
+            print("s3 upload failed:", e)
+    if REKOR and shutil.which("rekor-cli"):
+        try:
+            subprocess.check_call(["rekor-cli","upload","--artifact",bundle_path,"--api-url",REKOR])
+        except Exception as e:
+            print("rekor upload failed:", e)
+
+if __name__=="__main__":
+    import sys, time, shutil
+    arts = sys.argv[1:] or ["/tmp/sample-evidence"]
+    out = f"/tmp/aegis_evidence_{int(time.time())}.tar.gz"
+    b = bundle(arts, out)
+    print("Bundle:", b)
+    sign_and_upload(b)
+
