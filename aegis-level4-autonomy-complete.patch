+#!/usr/bin/env python3
+import requests, json, base64, threading, time
+from secretsharing import SecretSharer
+import subprocess, sys, os
+
+SERVER_SCRIPT = os.path.join(os.path.dirname(__file__), "..", "secure_secretshare_aggregator.py")
+
+def start_server():
+    return subprocess.Popen([sys.executable, SERVER_SCRIPT], cwd=os.path.dirname(SERVER_SCRIPT))
+
+def make_shares_for_vector(vec, n=5, k=3):
+    # Represent vector as comma-separated ints hex-encoded
+    SCALE=1000000
+    ints = [int(round(v * SCALE)) for v in vec]
+    s = ",".join(str(x) for x in ints)
+    hexs = s.encode().hex()
+    shares = SecretSharer.split_secret(hexs, k, n)
+    return shares
+
+def test_roundtrip():
+    srv = start_server()
+    time.sleep(1)
+    try:
+        vec_a=[0.1,0.2,0.3]
+        vec_b=[0.4,0.1,0.0]
+        shares_a = make_shares_for_vector(vec_a)
+        shares_b = make_shares_for_vector(vec_b)
+        # Submit full set of shares for each client in the single-server POC
+        import requests
+        requests.post("http://127.0.0.1:8300/submit_shares", json={"client_id":"a","shares":shares_a})
+        requests.post("http://127.0.0.1:8300/submit_shares", json={"client_id":"b","shares":shares_b})
+        r = requests.post("http://127.0.0.1:8300/aggregate")
+        agg = r.json().get("aggregate")
+        assert len(agg)==3
+        assert abs(agg[0] - (vec_a[0]+vec_b[0])) < 1e-6
+    finally:
+        srv.terminate()
+
+if __name__=="__main__":
+    test_roundtrip()
+    print("secretshare test passed")
+
