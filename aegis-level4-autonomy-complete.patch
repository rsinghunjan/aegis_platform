+#!/usr/bin/env python3
+"""
+Secure aggregator using Shamir Secret Sharing over integer-quantized vectors.
+
+This POC:
+ - Clients quantize float vectors to integers (scale factor configurable) and split into shares (n, k)
+ - Share distribution: each aggregator instance receives one share per client (in this single-server POC we collect all shares)
+ - Reconstruction sums client contributions by reconstructing each client's secret and summing elementwise
+
+Note: for production, runs must be authenticated (mTLS) and shares should be distributed across aggregator replicas.
+This POC uses the `secretsharing` library and simple quantization; floats are multiplied by SCALE and cast to int.
+"""
+import os, json, base64, threading, time
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from secretsharing import SecretSharer
+import numpy as np
+
+SCALE = int(os.environ.get("SECAGG_SCALE", "1000000"))  # scale floats to integers
+STORAGE_DIR = os.environ.get("SECAGG_STORAGE", "/tmp/secagg_shares")
+os.makedirs(STORAGE_DIR, exist_ok=True)
+
+CLIENT_SHARES = {}  # client_id -> list of shares (each share is string)
+LOCK = threading.Lock()
+
+def quantize(arr):
+    return [int(round(float(x) * SCALE)) for x in arr]
+
+def dequantize(int_arr):
+    return [x / SCALE for x in int_arr]
+
+class Handler(BaseHTTPRequestHandler):
+    def _read_json(self):
+        length = int(self.headers.get("Content-Length","0"))
+        raw = self.rfile.read(length)
+        return json.loads(raw.decode())
+
+    def do_POST(self):
+        if self.path == "/submit_shares":
+            j = self._read_json()
+            client_id = j.get("client_id")
+            shares = j.get("shares")  # list of share strings
+            if not client_id or not shares:
+                self.send_response(400); self.end_headers(); return
+            with LOCK:
+                CLIENT_SHARES[client_id] = shares
+            self.send_response(200); self.end_headers(); self.wfile.write(b"ok")
+            return
+        if self.path == "/aggregate":
+            # Reconstruct each client secret and sum
+            with LOCK:
+                clients = list(CLIENT_SHARES.items())
+            total = None
+            for client_id, shares in clients:
+                try:
+                    secret_hex = SecretSharer.recover_secret(shares)
+                    # secret_hex is hex representation of bytes; decode to string of comma-separated ints
+                    secret_str = bytes.fromhex(secret_hex).decode()
+                    int_arr = [int(x) for x in secret_str.split(",")]
+                    if total is None:
+                        total = np.array(int_arr, dtype=np.int64)
+                    else:
+                        total = total + np.array(int_arr, dtype=np.int64)
+                except Exception as e:
+                    print("Failed to reconstruct for", client_id, e)
+                    continue
+            if total is None:
+                self.send_response(404); self.end_headers(); return
+            floats = dequantize(total.tolist())
+            self.send_response(200); self.end_headers()
+            self.wfile.write(json.dumps({"aggregate": floats}).encode())
+            return
+        self.send_response(404); self.end_headers()
+
+if __name__=="__main__":
+    host = os.environ.get("SECAGG_HOST","0.0.0.0")
+    port = int(os.environ.get("SECAGG_PORT","8300"))
+    server = HTTPServer((host, port), Handler)
+    print("Secret-share aggregator listening on", host, port)
+    server.serve_forever()
+
