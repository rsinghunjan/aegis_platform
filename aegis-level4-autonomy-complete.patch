+#!/usr/bin/env python3
+"""
+DP Accounting service: tracks per-run epsilon and enforces a project-level epsilon budget.
+ - POST /report_round  { "project": "...", "run_id": "...", "epsilon": 0.5 }
+ - GET  /status?project=...  -> returns {"used":sum, "budget":..., "remaining":...}
+ - POST /check_run { "project": "...", "epsilon": 0.1 } -> returns 200 if allowed, 403 if budget exceeded
+
+This service uses a simple additive composition (conservative). For production,
+integrate advanced composition (RDP accountant) from Opacus.
+"""
+from flask import Flask, request, jsonify
+import os, sqlite3, threading
+
+DB = os.environ.get("DP_DB", "/tmp/dp_accounting.db")
+BUDGET_DEFAULT = float(os.environ.get("DP_DEFAULT_BUDGET", "10.0"))
+LOCK = threading.Lock()
+
+def init_db():
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("CREATE TABLE IF NOT EXISTS runs (project TEXT, run_id TEXT PRIMARY KEY, epsilon REAL, ts INTEGER)")
+    c.execute("CREATE TABLE IF NOT EXISTS budgets (project TEXT PRIMARY KEY, budget REAL)")
+    conn.commit()
+    conn.close()
+
+init_db()
+
+app = Flask(__name__)
+
+def get_budget(project):
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("SELECT budget FROM budgets WHERE project=?", (project,))
+    r = c.fetchone()
+    conn.close()
+    return r[0] if r else BUDGET_DEFAULT
+
+def current_used(project):
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("SELECT SUM(epsilon) FROM runs WHERE project=?", (project,))
+    r = c.fetchone()[0] or 0.0
+    conn.close()
+    return float(r)
+
+@app.route("/report_round", methods=["POST"])
+def report_round():
+    j = request.get_json() or {}
+    project = j.get("project")
+    run_id = j.get("run_id")
+    eps = float(j.get("epsilon", 0.0))
+    if not project or not run_id:
+        return jsonify({"error":"project and run_id required"}), 400
+    with LOCK:
+        conn = sqlite3.connect(DB)
+        c = conn.cursor()
+        try:
+            c.execute("INSERT INTO runs (project,run_id,epsilon,ts) VALUES (?,?,?,strftime('%s','now'))", (project,run_id,eps))
+            conn.commit()
+        except sqlite3.IntegrityError:
+            conn.close()
+            return jsonify({"error":"run_id exists"}), 409
+        conn.close()
+    return jsonify({"ok": True})
+
+@app.route("/status", methods=["GET"])
+def status():
+    project = request.args.get("project")
+    if not project:
+        return jsonify({"error":"project required"}), 400
+    used = current_used(project)
+    budget = get_budget(project)
+    return jsonify({"project":project, "used":used, "budget":budget, "remaining": max(0.0, budget-used)})
+
+@app.route("/check_run", methods=["POST"])
+def check_run():
+    j = request.get_json() or {}
+    project = j.get("project")
+    eps = float(j.get("epsilon", 0.0))
+    if not project:
+        return jsonify({"error":"project required"}), 400
+    used = current_used(project)
+    budget = get_budget(project)
+    if used + eps > budget:
+        return jsonify({"allowed": False, "reason":"budget_exceeded","used":used,"budget":budget}), 403
+    return jsonify({"allowed": True, "used":used, "budget":budget})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8310")))
+
