+#!/usr/bin/env python3
+"""
+Rotate KMS key by creating a new key, attaching alias atomically (alias update),
+write an evidence manifest, upload to S3, and sign manifest using cosign with KMS key.
+
+This script performs an alias swap: creates a new key, points chosen alias to it,
+and records old key metadata in the manifest for audit.
+"""
+import argparse, boto3, time, json, os, subprocess
+
+def create_kms_key(desc, region=None):
+    client = boto3.client("kms", region_name=region) if region else boto3.client("kms")
+    resp = client.create_key(Description=desc, KeyUsage='SIGN_VERIFY', Origin='AWS_KMS')
+    return resp['KeyMetadata']
+
+def update_alias(alias, key_id, region=None):
+    client = boto3.client("kms", region_name=region) if region else boto3.client("kms")
+    try:
+        client.create_alias(AliasName=alias, TargetKeyId=key_id)
+    except client.exceptions.AlreadyExistsException:
+        client.update_alias(AliasName=alias, TargetKeyId=key_id)
+
+def upload_manifest(bucket, path):
+    if not bucket:
+        return None
+    s3 = boto3.client("s3")
+    key = f"kms-rotation/{os.path.basename(path)}"
+    s3.upload_file(path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def sign_with_cosign_kms(kms_uri, manifest_path):
+    # cosign sign-blob --key=aws-kms://<arn> <file>
+    try:
+        subprocess.check_call(["cosign","sign-blob","--key", kms_uri, manifest_path])
+        return manifest_path + ".sig"
+    except Exception as e:
+        print("cosign sign failed:", e)
+        return None
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--alias", required=True)
+    p.add_argument("--desc", default="Aegis auto rotation key")
+    p.add_argument("--evidence-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    p.add_argument("--region", default=os.environ.get("AWS_REGION",""))
+    p.add_argument("--cosign-kms-uri", default=os.environ.get("COSIGN_KMS_URI",""))
+    args = p.parse_args()
+
+    old = None
+    client = boto3.client("kms", region_name=args.region) if args.region else boto3.client("kms")
+    try:
+        alias_info = client.describe_key(KeyId=args.alias)
+        old = alias_info.get("KeyMetadata",{})
+    except Exception:
+        # alias might not exist
+        pass
+
+    new_meta = create_kms_key(args.desc, region=args.region)
+    new_key_id = new_meta['KeyId']
+    update_alias(args.alias, new_key_id, region=args.region)
+    # prepare manifest
+    manifest = {
+        "timestamp": int(time.time()),
+        "alias": args.alias,
+        "new_key_id": new_key_id,
+        "new_key_arn": new_meta.get("Arn"),
+        "old_key": old or {},
+        "rotated_by": os.environ.get("USER") or "ci"
+    }
+    path = f"/tmp/kms_rotation_{int(time.time())}.json"
+    with open(path,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+
+    s3_uri = upload_manifest(args.evidence_bucket, path)
+    if s3_uri:
+        print("Uploaded manifest to", s3_uri)
+    sig = None
+    kms_uri = args.cosign_kms_uri
+    if kms_uri:
+        sig = sign_with_cosign_kms(kms_uri, path)
+        if sig:
+            print("Signed manifest at", sig)
+    print("Rotation complete. Manifest:", path, "s3:", s3_uri, "sig:", sig)
+
+if __name__=="__main__":
+    main()
+
