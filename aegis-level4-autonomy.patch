+"""
+Continuous evaluation scheduler (in-process).
+
+This is v1: a background thread in the API process.
+For production, move to a dedicated worker (Celery/Arq/RQ) or a controller deployment.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+import time
+from datetime import datetime, timedelta
+from typing import Callable, Optional
+
+from api.db import SessionLocal
+from api.golden_models import Run
+
+
+class EvalScheduler:
+    def __init__(self, interval_s: int, tick: Callable[[], None]):
+        self.interval_s = interval_s
+        self.tick = tick
+        self._stop = threading.Event()
+        self._t = threading.Thread(target=self._loop, daemon=True)
+
+    def start(self) -> None:
+        self._t.start()
+
+    def stop(self) -> None:
+        self._stop.set()
+
+    def _loop(self) -> None:
+        # initial delay to let app start
+        time.sleep(2.0)
+        while not self._stop.is_set():
+            try:
+                self.tick()
+            except Exception:
+                pass
+            self._stop.wait(self.interval_s)
+
+
+def enabled() -> bool:
+    return os.environ.get("AEGIS_EVAL_SCHEDULER_ENABLED", "true").lower() == "true"
+
+
+def interval_s() -> int:
+    return int(os.environ.get("AEGIS_EVAL_SCHEDULER_INTERVAL_S", "60"))
diff --git a/api/golden_rollout_controller.py b/api/golden_rollout_controller.py
new file mode 100644
index 0000000..e0d3e9d
--- /dev/null
+++ b/api/golden_rollout_controller.py
@@ -0,0 +1,345 @@
+"""
+Level 4 autonomy controller: canary rollout + monitoring + auto promote/rollback.
+
+This is intentionally minimal and relies on:
+  - usage_records for latency/cost estimates
+  - audit_events / safety events hooks (future: integrate safety stream)
+  - model_versions.eval_metrics + evidence packs for offline quality gates
+
+Online checks:
+  - error rate is approximated (future: add explicit error counters)
+  - p95 latency from last N usage_records
+  - cost budget from last N usage_records
+
+Traffic shifting:
+  - uses Istio VirtualService weighted routing if enabled.
+"""
+
+from __future__ import annotations
+
+import os
+import uuid
+from datetime import datetime, timedelta
+from typing import Any, Dict, Optional, Tuple
+
+from sqlalchemy import func
+
+from api.db import SessionLocal
+from api.golden_models import Deployment, ModelVersion, Rollout, RolloutPolicy, UsageRecord
+from api.golden_traffic import upsert_virtualservice, virtualservice_body
+from api.golden_policy import require_deploy_allowed
+
+
+def _now() -> datetime:
+    return datetime.utcnow()
+
+
+def _policy_defaults(cfg: Dict[str, Any]) -> Dict[str, Any]:
+    return {
+        "canary_steps": cfg.get("canary_steps", [1, 5, 10, 25, 50]),
+        "step_minutes": int(cfg.get("step_minutes", 5)),
+        "promote_minutes": int(cfg.get("promote_minutes", 20)),
+        "slo_p95_ms_max": float(cfg.get("slo_p95_ms_max", 2500)),
+        "cost_usd_per_min_max": float(cfg.get("cost_usd_per_min_max", 5.0)),
+        "require_offline_eval_pass": bool(cfg.get("require_offline_eval_pass", True)),
+        "offline_metric_thresholds": cfg.get("offline_metric_thresholds", {}),  # e.g. {"accuracy_min":0.9}
+        "traffic": cfg.get("traffic", {"type": "istio", "host": "aegis-gateway"}),
+    }
+
+
+def _p95(values: list[float]) -> Optional[float]:
+    if not values:
+        return None
+    values = sorted(values)
+    idx = int(0.95 * (len(values) - 1))
+    return float(values[idx])
+
+
+def _online_metrics(tenant_id: str, dep_id: str, window_minutes: int = 5) -> Dict[str, Any]:
+    s = SessionLocal()
+    try:
+        since = _now() - timedelta(minutes=window_minutes)
+        rows = (
+            s.query(UsageRecord.inference_ms, UsageRecord.cost_usd)
+            .filter(UsageRecord.tenant_id == tenant_id)
+            .filter(UsageRecord.deployment_id == dep_id)
+            .filter(UsageRecord.created_at >= since)
+            .order_by(UsageRecord.created_at.desc())
+            .limit(2000)
+            .all()
+        )
+        lats = [float(r[0]) for r in rows if r[0] is not None]
+        costs = [float(r[1] or 0.0) for r in rows]
+        return {
+            "count": len(rows),
+            "p95_ms": _p95(lats),
+            "cost_usd": sum(costs),
+            "window_minutes": window_minutes,
+        }
+    finally:
+        s.close()
+
+
+def _offline_ok(mv: ModelVersion, thresholds: Dict[str, Any]) -> bool:
+    if mv is None:
+        return False
+    if mv.eval_status not in ("pass", "passed"):
+        return False
+    if not thresholds:
+        return True
+    metrics = mv.eval_metrics or {}
+    for k, v in thresholds.items():
+        if k.endswith("_min"):
+            mk = k[:-4]
+            if metrics.get(mk) is None or float(metrics.get(mk)) < float(v):
+                return False
+        if k.endswith("_max"):
+            mk = k[:-4]
+            if metrics.get(mk) is None or float(metrics.get(mk)) > float(v):
+                return False
+    return True
+
+
+def _apply_traffic(namespace: str, name: str, host: str, stable_svc: str, canary_svc: Optional[str], stable_w: int, canary_w: int) -> None:
+    body = virtualservice_body(
+        name=name,
+        namespace=namespace,
+        host=host,
+        stable_svc=stable_svc,
+        canary_svc=canary_svc,
+        stable_weight=stable_w,
+        canary_weight=canary_w,
+    )
+    upsert_virtualservice(body)
+
+
+def tick_controller() -> None:
+    """
+    Reconcile all rollouts for all tenants.
+    """
+    s = SessionLocal()
+    try:
+        rollouts = s.query(Rollout).order_by(Rollout.created_at.asc()).limit(200).all()
+        for r in rollouts:
+            pol = s.query(RolloutPolicy).filter_by(id=r.policy_id, tenant_id=r.tenant_id).one_or_none()
+            if not pol:
+                continue
+            cfg = _policy_defaults(pol.config or {})
+
+            # If no canary, nothing to do
+            if not r.canary_deployment_id:
+                continue
+
+            stable = s.query(Deployment).filter_by(id=r.stable_deployment_id, tenant_id=r.tenant_id).one_or_none()
+            canary = s.query(Deployment).filter_by(id=r.canary_deployment_id, tenant_id=r.tenant_id).one_or_none()
+            if not stable or not canary:
+                continue
+
+            # Offline gate on canary model version (if required)
+            if cfg["require_offline_eval_pass"]:
+                mv = s.query(ModelVersion).filter_by(id=canary.model_version_id, tenant_id=r.tenant_id).one_or_none()
+                if not _offline_ok(mv, cfg["offline_metric_thresholds"]):
+                    # if canary is running but offline gate fails, rollback immediately
+                    r.status = "rolled_back"
+                    r.weights = {"stable": 100, "canary": 0}
+                    r.last_transition_at = _now()
+                    r.details = {"reason": "offline_gate_failed"}
+                    s.commit()
+                    continue
+
+            # Online checks on canary window
+            online = _online_metrics(r.tenant_id, canary.id, window_minutes=cfg["step_minutes"])
+            p95 = online.get("p95_ms")
+            cost_usd = float(online.get("cost_usd") or 0.0)
+            cost_per_min = cost_usd / max(1.0, float(cfg["step_minutes"]))
+
+            if p95 is not None and p95 > cfg["slo_p95_ms_max"]:
+                r.status = "rolled_back"
+                r.weights = {"stable": 100, "canary": 0}
+                r.last_transition_at = _now()
+                r.details = {"reason": "slo_p95_exceeded", "p95_ms": p95}
+                s.commit()
+                continue
+            if cost_per_min > cfg["cost_usd_per_min_max"]:
+                r.status = "rolled_back"
+                r.weights = {"stable": 100, "canary": 0}
+                r.last_transition_at = _now()
+                r.details = {"reason": "cost_exceeded", "cost_per_min": cost_per_min}
+                s.commit()
+                continue
+
+            # Step traffic weights
+            weights = r.weights or {"stable": 100, "canary": 0}
+            current_canary = int(weights.get("canary", 0))
+            steps = list(cfg["canary_steps"])
+            # move to next step after step_minutes
+            if (_now() - r.last_transition_at) >= timedelta(minutes=cfg["step_minutes"]):
+                next_canary = None
+                for st in steps:
+                    if int(st) > current_canary:
+                        next_canary = int(st)
+                        break
+                if next_canary is None:
+                    # if we've held max step long enough, promote
+                    if (_now() - r.last_transition_at) >= timedelta(minutes=cfg["promote_minutes"]):
+                        r.status = "promoted"
+                        r.stable_deployment_id = canary.id
+                        r.canary_deployment_id = None
+                        r.weights = {"stable": 100, "canary": 0}
+                        r.last_transition_at = _now()
+                        r.details = {"reason": "promoted"}
+                        s.commit()
+                    continue
+
+                r.status = "canary"
+                r.weights = {"stable": 100 - next_canary, "canary": next_canary}
+                r.last_transition_at = _now()
+                r.details = {"reason": "step", "canary_weight": next_canary}
+                s.commit()
+
+            # Apply traffic routing (Istio)
+            traffic = cfg["traffic"] or {}
+            if traffic.get("type") == "istio":
+                host = traffic.get("host", "aegis-gateway")
+                vs_name = f"aegis-rollout-{r.id[:8]}"
+                stable_w = int((r.weights or {}).get("stable", 100))
+                canary_w = int((r.weights or {}).get("canary", 0))
+                # Use dep.service_name as destination host; in-namespace K8s service DNS is just service name
+                _apply_traffic(
+                    namespace=stable.namespace,
+                    name=vs_name,
+                    host=host,
+                    stable_svc=stable.service_name,
+                    canary_svc=canary.service_name if canary_w > 0 else None,
+                    stable_w=stable_w,
+                    canary_w=canary_w,
+                )
+    finally:
+        s.close()
