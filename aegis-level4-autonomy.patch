+"""
+Traffic shifting via Istio VirtualService (weighted routing).
+
+Why Istio:
+- clean weighted routing for canary (stable/canary services)
+- supports retries/timeouts/circuit breaking (future)
+
+This module provides:
+  - ensure_virtualservice() to upsert a VS pointing to stable+canary services
+  - set_weights() to update weights
+
+Requires:
+- Istio installed
+- Aegis API service account can create/update VirtualService in tenant namespace
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any, Dict, Optional
+
+from kubernetes import client, config
+from kubernetes.client.rest import ApiException
+
+
+def _load_k8s():
+    mode = os.environ.get("AEGIS_K8S_CONFIG", "auto")
+    if mode == "incluster":
+        config.load_incluster_config()
+        return
+    if mode == "kubeconfig":
+        config.load_kube_config()
+        return
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+
+
+def _coapi() -> client.CustomObjectsApi:
+    _load_k8s()
+    return client.CustomObjectsApi()
+
+
+ISTIO_GROUP = "networking.istio.io"
+ISTIO_VERSION = os.environ.get("AEGIS_ISTIO_VERSION", "v1beta1")
+VS_PLURAL = "virtualservices"
+
+
+def virtualservice_body(
+    name: str,
+    namespace: str,
+    host: str,
+    stable_svc: str,
+    canary_svc: Optional[str],
+    stable_weight: int,
+    canary_weight: int,
+) -> Dict[str, Any]:
+    http_routes = []
+    routes = [{"destination": {"host": stable_svc}, "weight": stable_weight}]
+    if canary_svc and canary_weight > 0:
+        routes.append({"destination": {"host": canary_svc}, "weight": canary_weight})
+    http_routes.append({"route": routes})
+    return {
+        "apiVersion": f"{ISTIO_GROUP}/{ISTIO_VERSION}",
+        "kind": "VirtualService",
+        "metadata": {"name": name, "namespace": namespace},
+        "spec": {"hosts": [host], "http": http_routes},
+    }
+
+
+def upsert_virtualservice(body: Dict[str, Any]) -> None:
+    api = _coapi()
+    ns = body["metadata"]["namespace"]
+    name = body["metadata"]["name"]
+    try:
+        api.get_namespaced_custom_object(ISTIO_GROUP, ISTIO_VERSION, ns, VS_PLURAL, name)
+        api.replace_namespaced_custom_object(ISTIO_GROUP, ISTIO_VERSION, ns, VS_PLURAL, name, body)
+    except ApiException as e:
+        if e.status != 404:
+            raise
+        api.create_namespaced_custom_object(ISTIO_GROUP, ISTIO_VERSION, ns, VS_PLURAL, body)
