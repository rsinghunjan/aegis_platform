+#!/usr/bin/env python3
+"""
+Aegis Orchestrator v2 — Level‑4 automation-ready
+
+- Accepts webhook POSTs at /webhook and NATS events on 'safety.incidents'
+- Queries OPA for a policy decision
+- Records provenance (local file + metrics)
+- Triggers Argo workflows for auto-contain/auto-remediate-retrain/canary
+- Honours autonomy mode (conservative/hybrid/aggressive) from ConfigMap path or env
+"""
+import os, json, time, logging, threading, subprocess, requests
+from flask import Flask, request, jsonify
+from prometheus_client import start_http_server, Counter
+
+LOG = logging.getLogger("aegis.orchestrator.v2")
+logging.basicConfig(level=logging.INFO)
+
+# Config
+OPA_URL = os.environ.get("OPA_URL", "http://opa:8181")
+ARGO_NS = os.environ.get("ARGO_NS", "aegis-ml")
+ARGO_CLI = os.environ.get("ARGO_CLI", "argo")
+APPROVER_NOTIFY_URL = os.environ.get("APPROVER_NOTIFY_URL", "")
+AUTONOMY_CONFIG_PATH = os.environ.get("AUTONOMY_CONFIG_PATH", "/etc/aegis/autonomy_modes.yaml")
+PROV_LOG_PATH = os.environ.get("PROV_LOG_PATH", "/var/log/aegis/orchestrator_provenance.log")
+PROM_PORT = int(os.environ.get("PROM_PORT", "9105"))
+
+# Metrics
+c_events = Counter('aegis_orch_events_total', 'Total safety events processed')
+c_decision = Counter('aegis_orch_decisions_total', 'Decisions by action', ['action'])
+
+app = Flask("aegis-orch-v2")
+
+def get_mode():
+    try:
+        import yaml
+        cfg = yaml.safe_load(open(AUTONOMY_CONFIG_PATH))
+        return cfg.get("default_mode", "hybrid")
+    except Exception:
+        return os.environ.get("AUTONOMY_MODE", "hybrid")
+
+def opa_decision(event):
+    try:
+        r = requests.post(f"{OPA_URL}/v1/data/aegis/policy/decision", json={"input": event}, timeout=5)
+        r.raise_for_status()
+        return r.json().get("result", {"action":"require_human","reason":"opa_missing"})
+    except Exception:
+        LOG.exception("OPA request failed")
+        return {"action":"require_human","reason":"opa_unavail"}
+
+def record_provenance(event, decision):
+    entry = {
+        "ts": time.time(),
+        "event": event,
+        "decision": decision
+    }
+    try:
+        with open(PROV_LOG_PATH, "a") as fh:
+            fh.write(json.dumps(entry) + "\n")
+    except Exception:
+        LOG.exception("write prov log failed")
+    c_events.inc()
+    c_decision.labels(action=decision.get("action","unknown")).inc()
+
+def submit_argo(template, params=None):
+    cmd = [ARGO_CLI, "submit", "--from", f"workflowtemplate/{template}", "-n", ARGO_NS, "--wait"]
+    if params:
+        for k,v in params.items():
+            cmd += ["--parameter", f"{k}={v}"]
+    LOG.info("Running: %s", " ".join(cmd))
+    try:
+        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True, timeout=300)
+        LOG.info("Argo submit OK: %s", out)
+        return {"ok": True, "out": out}
+    except subprocess.CalledProcessError as e:
+        LOG.exception("Argo submit failed: %s", e.output if hasattr(e,"output") else e)
+        return {"ok": False, "error": str(e)}
+
+def handle(event):
+    mode = get_mode()
+    decision = opa_decision(event)
+    # Respect mode: do not allow auto_remediate in conservative mode
+    if mode == "conservative" and decision.get("action") in ("auto_remediate","auto_block"):
+        decision = {"action":"require_human","reason":"mode_conservative_override"}
+    record_provenance(event, decision)
+    action = decision.get("action")
+    if action == "auto_block":
+        params = {"incident_id": event.get("id","evt"), "model": event.get("model","unknown")}
+        return submit_argo("aegis-auto-contain", params)
+    if action == "auto_remediate":
+        params = {"incident_id": event.get("id","evt"), "model": event.get("model","unknown")}
+        return submit_argo("aegis-auto-remediate-retrain-v2", params)
+    # require_human
+    try:
+        if APPROVER_NOTIFY_URL:
+            requests.post(APPROVER_NOTIFY_URL, json={"id": event.get("id"), "reason": decision.get("reason")}, timeout=3)
+    except Exception:
+        LOG.exception("notify failed")
+    return {"ok": True, "action": "require_human"}
+
+@app.route("/webhook", methods=["POST"])
+def webhook():
+    ev = request.get_json() or {}
+    threading.Thread(target=handle, args=(ev,)).start()
+    return jsonify({"ok": True}), 202
+
+if __name__ == "__main__":
+    start_http_server(PROM_PORT)
+    LOG.info("Orchestrator v2 starting on 0.0.0.0:8088 (metrics %d)", PROM_PORT)
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8088")))
+
