+#!/usr/bin/env bash
+# Flip the cluster to Level-4 (hybrid/aggressive) — run in a controlled maintenance window
+# 1) Preconditions: detectors deployed, dp-service healthy, OPA & orchestrator running in staging, Argo templates deployed
+# 2) Usage: set AUTONOMY_MODE=hybrid|aggressive and run (requires kubectl context)
+set -euo pipefail
+MODE="${1:-hybrid}"
+CTX="${KUBE_CONTEXT:-}"
+NAMESPACE="${NAMESPACE:-aegis-system}"
+echo "Switching autonomy mode to $MODE in namespace $NAMESPACE"
+kubectl ${CTX:+--context $CTX} -n $NAMESPACE create configmap aegis-autonomy-modes --from-file=autonomy_modes.yaml=ops/config/autonomy_modes.yaml --dry-run=client -o yaml | kubectl ${CTX:+--context $CTX} apply -f -
+# Set default_mode via sed (quick in-place)
+TMP=$(mktemp)
+python3 - <<PY > "$TMP"
+import yaml,sys
+p='ops/config/autonomy_modes.yaml'
+m=sys.argv[1]
+d=yaml.safe_load(open(p))
+d['default_mode']=m
+open(p,"w").write(yaml.dump(d))
+PY "$MODE"
+kubectl ${CTX:+--context $CTX} -n $NAMESPACE create configmap aegis-autonomy-modes --from-file=ops/config/autonomy_modes.yaml --dry-run=client -o yaml | kubectl ${CTX:+--context $CTX} apply -f -
+kubectl ${CTX:+--context $CTX} -n "$NAMESPACE" rollout restart deployment aegis-orchestrator || true
+echo "Orchestrator restarted; verify mode endpoint:"
+kubectl ${CTX:+--context $CTX} -n $NAMESPACE get pods -l app=aegis-orchestrator
+echo "Request /webhook test event to validate (inspect Argo workflows)"
+curl -s -X POST -H "Content-Type: application/json" -d '{"id":"flip-test","score":0.97,"model_env":"staging"}' "http://aegis-orchestrator.$NAMESPACE.svc.cluster.local:8088/webhook" || true
+echo "Flip script complete. Monitor orchestrator metrics and Argo workflows for expected behavior."
