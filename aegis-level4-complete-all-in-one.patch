+#!/usr/bin/env python3
+"""
+Backtest script to evaluate automation decisions on historical incidents.
+Input: JSON array where each entry has:
+  {id, score, model_env, dp_over_budget, expected_action}
+This script will evaluate OPA rego locally using 'opa' if available or approximate the decision logic.
+"""
+import json, argparse, subprocess, os, sys
+def run_opa_eval(incident, policy_path):
+    try:
+        inp = json.dumps({"input": incident})
+        out = subprocess.check_output(["opa","eval","-i","-","-d", policy_path, "data.aegis.policy.decision"], input=inp.encode(), timeout=5)
+        return out.decode()
+    except Exception:
+        return None
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--incidents", required=True)
+    ap.add_argument("--out", default="backtest_report.json")
+    ap.add_argument("--policy", default="ops/level4/opa/level4_policy.rego")
+    args = ap.parse_args()
+    incidents = json.load(open(args.incidents))
+    results = []
+    for inc in incidents:
+        # naive local heuristic mirror of policy if opa not available
+        action = "require_human"
+        score = inc.get("score",0)
+        env = inc.get("model_env","staging")
+        if env=="prod" and score>=0.98:
+            action="require_human"
+        elif env=="staging" and score>=0.95:
+            action="auto_remediate"
+        elif env!="prod" and score>=0.90:
+            action="auto_block"
+        if inc.get("dp_over_budget"):
+            action="require_human"
+        results.append({"id":inc.get("id"), "score":score, "env":env, "predicted":action, "expected":inc.get("expected_action")})
+    json.dump(results, open(args.out,"w"), indent=2)
+    print("Wrote backtest report to", args.out)
+
+if __name__=="__main__":
+    main()
+
