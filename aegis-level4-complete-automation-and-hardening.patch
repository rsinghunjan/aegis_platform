+#!/usr/bin/env python3
+"""
+Webhook receiver for Flagger canary webhooks to sign promotion evidence.
+ - Expects POST requests from Flagger's post-rollout webhook containing JSON with canary name and image
+ - Writes an evidence manifest and signs it with cosign using a KMS-backed key (COSIGN_KMS_URI env)
+"""
+import os, json, time, subprocess
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KMS_URI = os.environ.get("COSIGN_KMS_URI","")
+
+def upload_to_s3(path):
+    if not EVIDENCE_BUCKET:
+        return None
+    cmd = ["aws","s3","cp", path, f"{EVIDENCE_BUCKET.rstrip('/')}/canary_evidence/"]
+    subprocess.check_call(cmd)
+    return f"s3://{EVIDENCE_BUCKET.rstrip('/')}/canary_evidence/{os.path.basename(path)}"
+
+@app.route("/sign", methods=["POST"])
+def sign():
+    j = request.get_json() or {}
+    canary = j.get("canary")
+    image = j.get("image")
+    promoted = j.get("promoted", True)
+    manifest = {
+        "canary": canary,
+        "image": image,
+        "promoted": promoted,
+        "ts": int(time.time())
+    }
+    path = f"/tmp/canary_evidence_{int(time.time())}.json"
+    with open(path,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    s3uri = upload_to_s3(path)
+    sig = None
+    if COSIGN_KMS_URI:
+        subprocess.check_call(["cosign","sign-blob","--key", COSIGN_KMS_URI, path])
+        sig = path + ".sig"
+    return jsonify({"ok": True, "manifest": path, "s3": s3uri, "sig": sig})
+
+@app.route("/healthz")
+def health():
+    return jsonify({"ok": True})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8400")))
+
