+#!/usr/bin/env python3
+"""
+RDP accountant wrapper.
+Attempts to compute epsilon using Opacus RDP accountant for given noise, sample_rate, steps, delta.
+Falls back to a conservative additive approximation if Opacus is not available.
+"""
+import math
+def compute_epsilon_opacus(noise, sample_rate, steps, delta=1e-5):
+    try:
+        # Attempt to import opacus utilities (best-effort)
+        from opacus.accountants.analysis.rdp import compute_eps
+        # compute_eps accepts orders, and uses numerical methods; for simplicity call compute_eps
+        orders = [1 + x/10.0 for x in range(1,600)]
+        eps = compute_eps(q=sample_rate, noise_multiplier=noise, steps=steps, orders=orders, delta=delta)
+        return float(eps)
+    except Exception:
+        return None
+
+def compute_epsilon_additive(noise, sample_rate, steps, delta=1e-5):
+    # Conservative additive bound: eps ≈ sqrt(2 * steps * log(1/delta)) * sample_rate / noise
+    # Not tight; used only as fallback.
+    if noise <= 0 or sample_rate <= 0:
+        return float("inf")
+    try:
+        eps = math.sqrt(2.0 * steps * math.log(1.0/delta)) * sample_rate / noise
+        return eps
+    except Exception:
+        return float("inf")
+
+def compute_epsilon(noise, sample_rate, steps, delta=1e-5):
+    e = compute_epsilon_opacus(noise, sample_rate, steps, delta)
+    if e is not None:
+        return e, "opacus"
+    e2 = compute_epsilon_additive(noise, sample_rate, steps, delta)
+    return e2, "additive-fallback"
+
+if __name__=="__main__":
+    print(compute_epsilon(1.0, 0.01, 1000))
+
