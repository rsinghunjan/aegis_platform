+#!/usr/bin/env python3
+"""
+Generate an evidence manifest for actions (canary promotion, KMS rotation, privacy decision)
+and optionally sign it using cosign (KMS).
+"""
+import argparse, json, time, os, subprocess
+
+def upload_to_s3(path, bucket):
+    if not bucket:
+        return None
+    subprocess.check_call(["aws","s3","cp", path, f"{bucket.rstrip('/')}/evidence/"])
+    return f"s3://{bucket.rstrip('/')}/evidence/{os.path.basename(path)}"
+
+def sign_manifest(path, kms_uri):
+    subprocess.check_call(["cosign","sign-blob","--key", kms_uri, path])
+    return path + ".sig"
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--type", required=True)
+    p.add_argument("--image-tag", default="")
+    p.add_argument("--canary", default="")
+    p.add_argument("--out", default=f"/tmp/evidence_{int(time.time())}.json")
+    args = p.parse_args()
+    m = {"type": args.type, "image": args.image_tag, "canary": args.canary, "ts": int(time.time())}
+    with open(args.out, "w") as fh:
+        json.dump(m, fh, indent=2)
+    print("Wrote", args.out)
+    if os.environ.get("EVIDENCE_BUCKET"):
+        uri = upload_to_s3(args.out, os.environ.get("EVIDENCE_BUCKET"))
+        print("Uploaded to", uri)
+    if os.environ.get("COSIGN_KMS_URI"):
+        sig = sign_manifest(args.out, os.environ.get("COSIGN_KMS_URI"))
+        print("Signed manifest at", sig)
+
+if __name__=="__main__":
+    main()
+
