+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run an end-to-end canary drill:
+# 1) Deploy a canary image tag (provided or built from local build)
+# 2) Wait for Flagger analysis and either allow promotion or observe rollback
+# 3) Collect canary status, sign promotion manifest (if promoted), and record evidence
+IMAGE_TAG=${1:-""}
+if [ -z "$IMAGE_TAG" ]; then
+  echo "Usage: $0 <image-tag>"
+  exit 2
+fi
+
+NAMESPACE=${NAMESPACE:-aegis}
+CANARY_NAME=${CANARY_NAME:-aegis-admission-webhook}
+
+echo "Updating deployment image to ${IMAGE_TAG} for canary (set as new image on current deployment)"
+kubectl -n ${NAMESPACE} set image deployment/${CANARY_NAME} admission-webhook=ghcr.io/myorg/admission-webhook:${IMAGE_TAG} --record
+
+echo "Waiting for Flagger analysis (progress will be visible in canary status)"
+for i in $(seq 1 120); do
+  phase=$(kubectl -n ${NAMESPACE} get canary ${CANARY_NAME} -o jsonpath='{.status.phase}' 2>/dev/null || echo "")
+  echo "Phase: $phase"
+  if [ "$phase" = "Succeeded" ]; then
+    echo "Canary promoted successfully."
+    # create evidence manifest
+    python3 ops/evidence/generate_evidence_manifest.py --type canary_promotion --image-tag "${IMAGE_TAG}" --canary "${CANARY_NAME}" --out /tmp/canary_manifest.json
+    # optionally sign via cosign (requires COSIGN_KMS_URI env)
+    if [ -n "${COSIGN_KMS_URI:-}" ]; then
+      cosign sign-blob --key "${COSIGN_KMS_URI}" /tmp/canary_manifest.json
+    fi
+    exit 0
+  fi
+  if [ "$phase" = "Failed" ]; then
+    echo "Canary failed and Flagger rolled back the release. Collect logs for diagnosis."
+    kubectl -n ${NAMESPACE} describe canary ${CANARY_NAME} || true
+    kubectl -n ${NAMESPACE} logs deploy/${CANARY_NAME} --tail=200 || true
+    exit 1
+  fi
+  sleep 10
+done
+
+echo "Timeout waiting for canary analysis"
+exit 2
+
