+name: CI Gating — enforce cosign & MOFN approval on PR merge
+on:
+  pull_request:
+    types: [synchronize, opened, reopened]
+
+jobs:
+  verify-and-block:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Check changed images for cosign signatures
+        id: checksig
+        run: |
+          set -euo pipefail
+          # Look for files that changed referencing image tags (naive heuristic)
+          git fetch origin ${{ github.base_ref }} --depth=1 || true
+          CHANGED=$(git diff --name-only origin/${{ github.base_ref }}...HEAD || true)
+          echo "Changed files: $CHANGED"
+          # For each changed file, try to extract image references (very basic)
+          IMAGES=$(git grep -Eo "ghcr.io/[^: ]+:[a-zA-Z0-9._-]+" $(echo $CHANGED) || true)
+          if [ -z "$IMAGES" ]; then
+            echo "No image references detected; allow PR to continue"
+            exit 0
+          fi
+          echo "Found images: $IMAGES"
+          for img in $IMAGES; do
+            echo "Verifying cosign signature for $img"
+            if ! cosign verify --key "${{ secrets.COSIGN_KMS_URI }}" "$img"; then
+              echo "Image $img is not signed by cosign KMS or verification failed"
+              exit 1
+            fi
+          done
+          echo "All images are cosign-verified"
+
+      - name: Require M-of-N approval marker in PR body (for calibrator changes)
+        run: |
+          CHANGED=$(git diff --name-only origin/${{ github.base_ref }}...HEAD || true)
+          echo "$CHANGED" | grep -E "^services/safety/calibrator_pytorch_train.py|^services/safety/calibrator_pytorch_service.py|^helm/calibrator" && CHANGED_CALIBRATOR=true || CHANGED_CALIBRATOR=false
+          if [ "$CHANGED_CALIBRATOR" = "true" ]; then
+            BODY=$(gh pr view ${{ github.event.pull_request.number }} --json body -q .body)
+            echo "PR body: $BODY"
+            REQUEST_ID=$(echo "$BODY" | grep -o 'mofn-request:[^ ]*' | sed 's/mofn-request://' | head -n1 || true)
+            if [ -z "$REQUEST_ID" ]; then
+              echo "Calibrator change detected but MOFN request id not found in PR body (format: mofn-request:<id>)"
+              exit 1
+            fi
+            # Query MOFN
+            STATUS=$(curl -sS "${{ secrets.MOFN_URL }}/status?request_id=${REQUEST_ID}")
+            APPROVED=$(echo "$STATUS" | jq -r '.approved')
+            if [ "$APPROVED" != "true" ]; then
+              echo "MOFN approval not yet satisfied for request ${REQUEST_ID}"
+              exit 1
+            fi
+            echo "MOFN approval satisfied"
+          else
+            echo "No calibrator changes; skipping M-of-N gating"
+          fi
+
