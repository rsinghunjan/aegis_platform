+#!/usr/bin/env bash
+set -euo pipefail
+IMAGE="$1"
+
+echo "Enforcing cosign signature for $IMAGE"
+if ! cosign verify --key "${COSIGN_KMS_URI:-}" "$IMAGE"; then
+  echo "cosign verify failed for $IMAGE" >&2
+  exit 2
+fi
+
+echo "Optionally verify Rekor entry (best-effort)"
+if command -v rekor-cli >/dev/null 2>&1; then
+  rekor-cli search --artifact "$IMAGE" >/dev/null 2>&1 || echo "rekor: entry not found for $IMAGE (investigate)"
+fi
+
+echo "Image verification OK"
+
