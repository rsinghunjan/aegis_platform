+def run_local_aggregator_and_send_bad_shares():
+    # This test assumes the secret-share aggregator POC provides an HTTP endpoint /submit_shares and /aggregate
+    # Use requests to call endpoints (runs only if aggregator is running locally)
+    import requests
+    try:
+        # valid shares (small demo)
+        good_shares = ["1-abc","2-def","3-ghi"]
+        r = requests.post("http://127.0.0.1:8300/submit_shares", json={"client_id":"good","shares": good_shares}, timeout=3)
+        print("submitted good shares", r.status_code)
+        # malicious shares: malformed strings
+        bad_shares = ["BADSHARE", "%%%%", ""]
+        r2 = requests.post("http://127.0.0.1:8300/submit_shares", json={"client_id":"bad","shares": bad_shares}, timeout=3)
+        print("submitted bad shares", r2.status_code)
+        # attempt aggregate
+        ra = requests.post("http://127.0.0.1:8300/aggregate", timeout=3)
+        print("aggregate status", ra.status_code, ra.text)
+        # Expect aggregator to ignore or reject bad shares — assert aggregate returns 200 but result excludes bad client OR returns 400/500
+        if ra.status_code != 200:
+            print("Aggregator rejected aggregate request as expected or failed:", ra.status_code)
+        else:
+            agg = ra.json().get("aggregate")
+            print("Aggregate result:", agg)
+    except Exception as e:
+        print("Test exception (likely aggregator not running):", e)
+
+if __name__=="__main__":
+    run_local_aggregator_and_send_bad_shares()
