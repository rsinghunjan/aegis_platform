+#!/usr/bin/env python3
+"""
+Simple readiness score runner that inspects repo for key artifacts and reports a preliminary score.
+This is not a full validator; operator must confirm runtime checks (secrets, deployed endpoints).
+"""
+import os, json
+
+REPO_ROOT = os.path.join(os.path.dirname(__file__), "..", "..")
+
+CHECKS = [
+    ("flagger_canary", "ops/canary/flagger_canary.yaml", 5),
+    ("canary_signing", "helm/canary-signing/Chart.yaml", 5),
+    ("hardened_deploy_pipeline", ".github/workflows/hardened_deploy_pipeline.yml", 10),
+    ("mofn_oidc", "services/policy/m_of_n_service_oidc.py", 6),
+    ("dp_accounting", "services/privacy/dp_accounting_service.py", 6),
+    ("fl_controller_sample", "services/fl/fl_controller_dp_integration.py", 4),
+    ("mpc_headless", "ops/secure_agg/production_mpc/k8s/crypten-headless-service.yaml", 4),
+    ("mpc_statefulset", "ops/secure_agg/production_mpc/k8s/worker_statefulset.yaml", 4),
+    ("kms_rotate", "ops/hsm/rotate_kms_alias_and_sign.py", 4),
+    ("rekor_register", "ops/evidence/register_rekor.py", 3),
+    ("evidence_terraform", "terraform/evidence/main.tf", 3),
+    ("runbook_drill", ".github/workflows/runbook_drill.yml", 3),
+    ("orchestrator", "ops/orchestrator/one_click_orchestrator.sh", 3),
+]
+
+def run():
+    score = 0
+    total = sum(w for _,_,w in CHECKS)
+    results = []
+    for name, path, weight in CHECKS:
+        full = os.path.join(REPO_ROOT, path)
+        ok = os.path.exists(full)
+        results.append({"name": name, "path": path, "exists": ok, "weight": weight})
+        if ok:
+            score += weight
+    pct = (score/total)*100 if total else 0
+    out = {"score": score, "total": total, "percent": pct, "details": results}
+    print(json.dumps(out, indent=2))
+    return out
+
+if __name__=="__main__":
+    run()
+
