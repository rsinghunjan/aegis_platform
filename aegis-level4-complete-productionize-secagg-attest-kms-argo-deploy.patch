+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Strict secure-aggregation wheel build for hardened builder host.
+# Usage:
+#   OUTDIR=/out/wheels CHECKSUMS_URL=<signed-checksums-url> COSIGN_KMS_URI=<kms-uri> ./build_secagg_wheel_strict.sh <repo> <tag>
+#
+REPO=${1:-https://github.com/google/secagg.git}
+TAG=${2:-master}
+OUTDIR=${OUTDIR:-/out/wheels}
+CHECKSUMS_URL=${CHECKSUMS_URL:-""}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-""}
+
+WORKDIR=$(mktemp -d)
+echo "Working in $WORKDIR"
+git clone --depth 1 --branch "$TAG" "$REPO" "$WORKDIR" || { echo "git clone failed"; exit 2; }
+cd "$WORKDIR"
+
+# Optional: download signed checksums (provided by upstream or your supply-chain) and verify commit tarball
+if [ -n "$CHECKSUMS_URL" ]; then
+  echo "Fetching checksums from $CHECKSUMS_URL"
+  curl -fsSL "$CHECKSUMS_URL" -o /tmp/secagg_checksums.txt
+  sha256sum --check /tmp/secagg_checksums.txt || { echo "checksum verification failed"; exit 3; }
+fi
+
+# Build wheel in a clean venv (follow upstream instructions when necessary)
+if [ -f "setup.py" ] || [ -d "src" ]; then
+  python3 -m venv .venv
+  source .venv/bin/activate
+  pip install --upgrade pip wheel setuptools
+  if [ -f "setup.py" ]; then
+    python3 setup.py bdist_wheel
+    mkdir -p "$OUTDIR"
+    find dist -name "*.whl" -exec cp {} "$OUTDIR" \;
+  else
+    echo "No setup.py: follow upstream build instructions; place result wheels in $OUTDIR"
+  fi
+  deactivate
+else
+  echo "No python packaging found; build manually and copy wheels to $OUTDIR"
+fi
+
+echo "Optionally cosign the wheel artifacts with KMS"
+if [ -n "$COSIGN_KMS_URI" ]; then
+  for w in "$OUTDIR"/*.whl; do
+    if [ -f "$w" ]; then
+      echo "Signing $w"
+      cosign sign --key "$COSIGN_KMS_URI" "$w" || echo "cosign sign failed for $w"
+    fi
+  done
+fi
+
+echo "Wheel build complete. Artifacts in $OUTDIR"
+
