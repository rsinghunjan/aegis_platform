+#!/usr/bin/env python3
+"""
+Multi-model corroboration service:
+ - Runs multiple verifier models (cross-encoder, nli, binary classifier) and aggregates scores.
+ - Applies conservative aggregation (min/weighted) and returns `allow` or `needs_human`.
+ - If `needs_human`, opens an A2A approval request automatically (best-effort).
+"""
+import os, logging, requests
+from fastapi import FastAPI
+from pydantic import BaseModel
+from sentence_transformers import CrossEncoder
+
+LOG = logging.getLogger("aegis.verifier.ensemble")
+logging.basicConfig(level=logging.INFO)
+app = FastAPI()
+
+CROSS_MODEL = os.environ.get("CROSS_MODEL", "cross-encoder/ms-marco-MiniLM-L-6-v2")
+THRESH = float(os.environ.get("ENSEMBLE_THRESHOLD", "0.45"))
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+
+ce = CrossEncoder(CROSS_MODEL)
+
+class VerifyReq(BaseModel):
+    claim: str
+    docs: list
+    requestor: str = "unknown"
+
+@app.post("/verify")
+def verify(req: VerifyReq):
+    # cross-encoder scoring
+    pairs = [[d.get("text",""), req.claim] for d in req.docs]
+    try:
+        scores = ce.predict(pairs)
+        best = max(scores) if scores else 0.0
+    except Exception as e:
+        LOG.error("cross-encoder error: %s", e)
+        best = 0.0
+
+    # placeholder for other models (NLI/classifier). For now we conservatively use best score.
+    combined_score = float(best)
+    allow = combined_score >= THRESH
+    result = {"allow": allow, "score": combined_score}
+
+    if not allow:
+        # create A2A approval for human review (best-effort)
+        try:
+            req_body = {"model_id": "ensemble", "artifact_uri": "verifier_event", "approver": "oncall", "decision": "requested", "comment": "auto A2A for low-confidence verification"}
+            r = requests.post(f"{A2A_API.rstrip('/')}/request", json=req_body, timeout=5.0)
+            if r.ok:
+                result["a2a_request_id"] = r.json().get("id")
+        except Exception as e:
+            LOG.warning("failed to open A2A request: %s", e)
+
+    return result
+
+@app.get("/health")
+def health():
+    return {"ok": True}
+
