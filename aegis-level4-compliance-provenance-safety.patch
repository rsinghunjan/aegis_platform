+#!/usr/bin/env python3
+"""
+HIL Gate service:
+ - Ensures HIL evidence is present, signed, and linked to an FMEA entry before allowing promotion/actuation.
+ - Exposes /check that CD pipelines can call before promoting to production.
+"""
+import os, logging, requests
+from fastapi import FastAPI, HTTPException, Query
+
+LOG = logging.getLogger("aegis.hil")
+logging.basicConfig(level=logging.INFO)
+app = FastAPI()
+
+FMEA_API = os.environ.get("FMEA_API", "http://fmea:8080")
+RECEIPT_API = os.environ.get("RECEIPT_API", "http://receipt-signer:8080/sign")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+@app.get("/check")
+def check(evidence_id: str = Query(...), fmea_id: str = Query(...)):
+    # verify FMEA exists
+    try:
+        r = requests.get(f"{FMEA_API.rstrip('/')}/fmea/{fmea_id}", timeout=5.0)
+        if r.status_code != 200:
+            raise HTTPException(status_code=403, detail="fmea not found")
+    except HTTPException:
+        raise
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"fmea check failed: {e}")
+
+    # verify evidence receipt exists in MCP (best-effort)
+    try:
+        r2 = requests.get(f"{AEGIS_MCP.rstrip('/')}/receipts/{evidence_id}", timeout=5.0)
+        if r2.status_code != 200:
+            raise HTTPException(status_code=403, detail="evidence receipt not found")
+    except HTTPException:
+        raise
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"mcp check failed: {e}")
+
+    return {"ok": True, "evidence_id": evidence_id, "fmea_id": fmea_id}
+
