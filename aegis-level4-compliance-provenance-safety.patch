+#!/usr/bin/env python3
+"""
+Admission webhook to enforce model provenance annotations and optionally check Rekor.
+ - Validates that Deployment/StatefulSet metadata.annotations contain:
+   - mcp.provenance/signed = "true"
+   - mcp.provenance/rekor_digest = "<base64-or-hash>"
+ - If REKOR_URL is configured, attempts to query Rekor transparency log for the digest (best-effort).
+ - Controlled fail-open vs fail-closed by FAIL_ON_ERROR env var.
+"""
+import os, logging, requests
+from fastapi import FastAPI, Request
+
+LOG = logging.getLogger("aegis.model-provenance-webhook")
+logging.basicConfig(level=logging.INFO)
+app = FastAPI()
+
+REKOR_URL = os.environ.get("REKOR_URL", "")
+FAIL_ON_ERROR = os.environ.get("FAIL_ON_ERROR", "false").lower() == "true"
+
+def check_rekor(digest: str) -> bool:
+    if not REKOR_URL:
+        return True
+    try:
+        r = requests.get(f"{REKOR_URL.rstrip('/')}/api/v1/log/entries?hash={digest}", timeout=5.0)
+        if r.status_code == 200:
+            data = r.json()
+            return bool(data)
+    except Exception as e:
+        LOG.warning("rekor check failed: %s", e)
+        if FAIL_ON_ERROR:
+            return False
+    return True
+
+@app.post("/validate")
+async def validate(req: Request):
+    body = await req.json()
+    request = body.get("request", {})
+    uid = request.get("uid")
+    obj = request.get("object", {})
+    annotations = (obj.get("metadata", {}) or {}).get("annotations", {}) or {}
+
+    allowed = True
+    reason = ""
+
+    if not annotations.get("mcp.provenance/signed") == "true":
+        allowed = False
+        reason = "missing or invalid mcp.provenance/signed annotation"
+    elif not annotations.get("mcp.provenance/rekor_digest"):
+        allowed = False
+        reason = "missing mcp.provenance/rekor_digest annotation"
+    else:
+        digest = annotations.get("mcp.provenance/rekor_digest")
+        ok = check_rekor(digest)
+        if not ok:
+            allowed = False
+            reason = "rekor digest not found or Rekor unavailable"
+
+    resp = {
+        "apiVersion": "admission.k8s.io/v1",
+        "kind": "AdmissionReview",
+        "response": {
+            "uid": uid,
+            "allowed": allowed,
+            "status": {"message": reason} if not allowed else {}
+        }
+    }
+    return resp
+
+@app.get("/health")
+def health():
+    return {"ok": True}
+
