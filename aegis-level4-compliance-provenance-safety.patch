+#!/usr/bin/env python3
+"""
+Bulk re-encrypt S3 objects under a new KMS key (AWS).
+ - Usage: set AWS creds, S3_BUCKET and run with OLD_PREFIX and NEW_KMS_KEY_ID environment vars.
+ - This is a helper; in production coordinate with compliance & ensure you have access rights.
+"""
+import os, boto3, logging
+
+LOG = logging.getLogger("aegis.kms-rotate")
+logging.basicConfig(level=logging.INFO)
+
+S3_BUCKET = os.environ.get("S3_BUCKET")
+OLD_PREFIX = os.environ.get("OLD_PREFIX", "originals/")
+NEW_KMS_KEY_ID = os.environ.get("NEW_KMS_KEY_ID")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+
+s3 = boto3.client("s3", region_name=REGION)
+
+def list_objects(prefix):
+    kwargs = {"Bucket": S3_BUCKET, "Prefix": prefix}
+    while True:
+        r = s3.list_objects_v2(**kwargs)
+        for obj in r.get("Contents", []):
+            yield obj["Key"]
+        if r.get("IsTruncated"):
+            kwargs["ContinuationToken"] = r.get("NextContinuationToken")
+        else:
+            break
+
+def reencrypt_object(key):
+    # copy to same key with SSEKMS and new key id
+    try:
+        s3.copy_object(Bucket=S3_BUCKET, Key=key, CopySource={"Bucket": S3_BUCKET, "Key": key}, ServerSideEncryption="aws:kms", SSEKMSKeyId=NEW_KMS_KEY_ID)
+        LOG.info("reencrypted %s", key)
+    except Exception as e:
+        LOG.error("failed reencrypt %s: %s", key, e)
+
+def main():
+    if not (S3_BUCKET and NEW_KMS_KEY_ID):
+        LOG.error("S3_BUCKET and NEW_KMS_KEY_ID must be set")
+        return
+    for k in list_objects(OLD_PREFIX):
+        reencrypt_object(k)
+
+if __name__ == "__main__":
+    main()
+
