+#!/usr/bin/env python3
+"""
+Run Apalache on a set of invariants/specs, collect counterexamples and attempt closure
+ - Produces a formal_summary.json with counters, status and suggested mitigation actions
+ - Optionally opens remediation tickets via ops/incident/auto_remediate_and_ticket.py
+"""
+import argparse, os, subprocess, json
+from datetime import datetime
+
+def run_apalache(spec, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    cmd = ["./ops/formal/apalache_triage_runner.sh", outdir, "--spec", spec]
+    try:
+        subprocess.check_call(cmd)
+        # Expect apalache writes triage outputs inside outdir
+        return True
+    except subprocess.CalledProcessError:
+        return False
+
+def summarize(outdir):
+    # look for counterexample files or apalache outputs
+    counters = []
+    for root,_,files in os.walk(outdir):
+        for f in files:
+            if f.endswith(".counterexample.json") or "counterexample" in f.lower():
+                try:
+                    counters.append(json.load(open(os.path.join(root,f))))
+                except Exception:
+                    pass
+    return counters
+
+def record_manifest_safe(k,v):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest(k,v)
+    except Exception:
+        pass
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--specs", nargs="+", required=True, help="List of TLA+ spec/invariant files")
+    p.add_argument("--out", default=f"/tmp/apalache_run_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--auto-ticket", action="store_true")
+    args = p.parse_args()
+    results = {"run_at": datetime.utcnow().isoformat()+"Z", "specs": []}
+    for s in args.specs:
+        od = os.path.join(args.out, os.path.basename(s).replace(".tla",""))
+        ok = run_apalache(s, od)
+        counters = summarize(od)
+        status = "passed" if ok and not counters else "failed"
+        entry = {"spec": s, "outdir": od, "passed": ok and not counters, "counterexamples": counters}
+        results["specs"].append(entry)
+        record_manifest_safe(f"apalache_{os.path.basename(s)}", entry)
+        if args.auto_ticket and counters:
+            try:
+                import subprocess as sp
+                body = f"Apalache found counterexamples for {s}. See {od} for details.\n\nCounterexamples: {len(counters)}"
+                sp.check_call(["python3","ops/incident/auto_remediate_and_ticket.py","--summary",f"Apalache counterexamples for {os.path.basename(s)}","--details",body])
+            except Exception as e:
+                print("Ticketing failed:", e)
+    outpath = os.path.join(args.out, "formal_summary.json")
+    os.makedirs(args.out, exist_ok=True)
+    with open(outpath,"w") as fh:
+        json.dump(results, fh, indent=2)
+    record_manifest_safe("formal_summary", {"path": outpath})
+    print("Apalache runs complete. Summary:", outpath)
+
