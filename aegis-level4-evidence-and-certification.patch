+#!/usr/bin/env python3
+"""
+RT timing profiler
+ - Executes RT sweep script for a target and extracts p99 and safe-stop latencies from rt_slo_proof.json
+ - Produces JSON report and verifies against threshold SLOs
+"""
+import argparse, os, json, subprocess
+from datetime import datetime
+
+def run_and_collect(target, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    env = os.environ.copy()
+    env["TARGET_HOST"] = target.split(":")[0]
+    env["TARGET_IFACE"] = target.split(":")[1] if ":" in target else "can0"
+    try:
+        subprocess.check_call(["./ops/av/rt/run_hw_rt_sweep.sh", outdir], env=env)
+    except Exception:
+        pass
+    proof = os.path.join(outdir, "rt_slo_proof.json")
+    if os.path.exists(proof):
+        return json.load(open(proof))
+    return {}
+
+def evaluate(proof, p99_thresh, safe_thresh):
+    p99 = proof.get("p99_ms", None)
+    safe = proof.get("safe_ms", None)
+    return {"p99_ms": p99, "safe_ms": safe, "p99_ok": (p99 is not None and p99 <= p99_thresh), "safe_ok": (safe is not None and safe <= safe_thresh)}
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--targets", nargs="+", required=True)
+    p.add_argument("--out", default="/tmp/rt_profiler")
+    p.add_argument("--p99-threshold", type=float, default=0.5)
+    p.add_argument("--safe-threshold-ms", type=float, default=50.0)
+    args = p.parse_args()
+    report = {"run_at": datetime.utcnow().isoformat()+"Z", "results": []}
+    for t in args.targets:
+        od = os.path.join(args.out, t.replace(":","_"))
+        proof = run_and_collect(t, od)
+        evald = evaluate(proof, args.p99_threshold, args.safe_threshold_ms)
+        evald["target"] = t
+        evald["proof_path"] = os.path.join(od, "rt_slo_proof.json") if proof else None
+        report["results"].append(evald)
+    os.makedirs(args.out, exist_ok=True)
+    outpath = os.path.join(args.out, "rt_timing_report.json")
+    with open(outpath,"w") as fh:
+        json.dump(report, fh, indent=2)
+    print("Wrote RT timing report to", outpath)
+
