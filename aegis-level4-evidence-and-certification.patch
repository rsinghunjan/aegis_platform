+#!/usr/bin/env python3
+"""
+Fleet HIL campaign manager
+ - Runs RT sweeps and HIL campaigns across the exact hardware topology in conf/hw_targets_exact.yaml
+ - Packages signed evidence bundles (cosign KMS), uploads to S3 (optional), records manifest via evidence SDK (if available)
+ - Produces a run-level summary JSON suitable for PoA and safety case attachments
+"""
+import argparse
+import os
+import subprocess
+import json
+import yaml
+from datetime import datetime
+
+def load_targets(path="conf/hw_targets_exact.yaml"):
+    with open(path) as fh:
+        return yaml.safe_load(fh).get("targets", [])
+
+def run_rt_sweep(target, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    env = os.environ.copy()
+    env["TARGET_HOST"] = target["host"]
+    env["TARGET_IFACE"] = target["iface"]
+    cmd = ["./ops/av/rt/run_hw_rt_sweep.sh", outdir]
+    try:
+        subprocess.check_call(cmd, env=env)
+    except subprocess.CalledProcessError:
+        pass
+    proof = os.path.join(outdir, "rt_slo_proof.json")
+    return proof if os.path.exists(proof) else None
+
+def run_hil_campaign(target, scenarios, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    env = os.environ.copy()
+    env["TARGET_HOST"] = target["host"]
+    env["TARGET_IFACE"] = target["iface"]
+    cmd = ["python3","ops/robotics/control/certified/hil_campaign_manager.py","--scenarios-file",scenarios,"--out",outdir]
+    try:
+        subprocess.check_call(cmd, env=env)
+    except subprocess.CalledProcessError:
+        pass
+    summary = os.path.join(outdir, "hil_summary.json")
+    return summary if os.path.exists(summary) else None
+
+def package_and_sign(outdir, name_prefix, cosign_key=None):
+    bundle = os.path.join(outdir, f"{name_prefix}_evidence_{int(datetime.utcnow().timestamp())}.tar.gz")
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    return bundle
+
+def upload_s3(path, s3_uri):
+    if not s3_uri:
+        return False
+    try:
+        subprocess.check_call(["aws","s3","cp",path,s3_uri])
+        return True
+    except Exception as e:
+        print("s3 upload failed:", e)
+        return False
+
+def record_manifest(key, value):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest(key, value)
+    except Exception:
+        pass
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--targets-yaml", default="conf/hw_targets_exact.yaml")
+    p.add_argument("--scenarios", default="ops/av/certification/falcon_scenarios.txt")
+    p.add_argument("--out", default=f"/tmp/fleet_hil_run_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--cosign", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    targets = load_targets(args.targets_yaml)
+    run_summary = {"run_at": datetime.utcnow().isoformat()+"Z", "targets": []}
+    for t in targets:
+        name = t.get("name","unknown")
+        od = os.path.join(args.out, name)
+        os.makedirs(od, exist_ok=True)
+        print("Running RT sweep for", name)
+        rt_proof = run_rt_sweep(t, od)
+        print("Running HIL campaign for", name)
+        hil_sum = run_hil_campaign(t, args.scenarios, od)
