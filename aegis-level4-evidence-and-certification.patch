+"""
+Long-tail coverage manager
+ - Orchestrates sim→HIL long-tail campaigns, computes scenario coverage and reduction rates after retrain
+ - Triggers retrain via training_pipeline_launcher.py when coverage targets are not met
+"""
+import argparse, os, subprocess, json, time
+from datetime import datetime
+
+def submit_sim_packs(packs, out):
+    # Placeholder: call Argo submit or other orchestration to submit many sim packs
+    subprocess.call(["kubectl","apply","-f","argo/workflows/longtail_sim_pipeline.yaml"])
+    # In practice return a tracking id; here return timestamp
+    return f"sim_batch_{int(time.time())}"
+
+def collect_failure_manifest(sim_out_dir):
+    # scan results and collect failing scenario ids
+    fails=set()
+    for root,_,files in os.walk(sim_out_dir):
+        for f in files:
+            if f.endswith(".result.json"):
+                try:
+                    j=json.load(open(os.path.join(root,f)))
+                    if not j.get("pass",True):
+                        fails.add(j.get("scenario_id"))
+                except Exception:
+                    pass
+    return sorted(list(fails))
+
+def compute_coverage(baseline_failures, current_failures):
+    baseline_set=set(baseline_failures)
+    current_set=set(current_failures)
+    closed = baseline_set - current_set
+    opened = current_set - baseline_set
+    return {"baseline_count": len(baseline_set), "current_count": len(current_set), "closed": len(closed), "opened": len(opened), "closed_ids": list(closed)}
+
+def trigger_retrain(manifest_path, out):
+    # manifest_path points to shard_manifest or fail manifest; call training launcher
+    try:
+        subprocess.check_call(["python3","ops/llm/training_pipeline_launcher.py","--shard-manifest",manifest_path,"--out",out])
+        return True
+    except Exception:
+        return False
+
+if __name__=="__main__":
+    p=argparse.ArgumentParser()
+    p.add_argument("--packs", type=int, default=1000)
+    p.add_argument("--sim-out", default="/tmp/sim_outputs")
+    p.add_argument("--baseline-failures", default="")
+    p.add_argument("--out", default=f"/tmp/longtail_{int(time.time())}")
+    args=p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    batch_id = submit_sim_packs(args.packs, args.out)
+    time.sleep(5)  # wait for orchestration to start (placeholder)
+    current_fails = collect_failure_manifest(args.sim_out)
+    baseline_fails = json.load(open(args.baseline_failures)) if args.baseline_failures and os.path.exists(args.baseline_failures) else []
+    cov = compute_coverage(baseline_fails, current_fails)
+    report = {"batch_id": batch_id, "run_at": datetime.utcnow().isoformat()+"Z", "coverage": cov, "current_failures": current_fails}
+    outpath = os.path.join(args.out, "longtail_coverage.json")
