+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Harden builder host and run an automated cosign sign + Rekor verification test
+# Run on builder host (or by orchestration) with appropriate permissions
+#
+COSIGN_VER=${COSIGN_VER:-"v1.15.0"}
+REKOR_SERVER=${REKOR_SERVER:-"${REKOR_SERVER:-https://rekor.example.com}"}
+TEST_ARTIFACT=${1:-"/tmp/aegis_builder_test_artifact.tar.gz"}
+
+echo "Installing cosign ${COSIGN_VER}"
+curl -sSfL "https://github.com/sigstore/cosign/releases/download/${COSIGN_VER}/cosign-linux-amd64" -o /usr/local/bin/cosign
+chmod +x /usr/local/bin/cosign || true
+
+echo "Create sample artifact"
+mkdir -p /tmp/aegis_builder_test && echo "aegis-builder-test" > /tmp/aegis_builder_test/readme.txt
+tar -czf "${TEST_ARTIFACT}" -C /tmp/aegis_builder_test .
+
+echo "Attempt to sign using KMS key bound to builder (COSIGN_KMS_URI must be available in env)"
+if [ -z "${COSIGN_KMS_URI:-}" ]; then
+  echo "COSIGN_KMS_URI not set. Please set COSIGN_KMS_URI and rerun to test signing."
+  exit 2
+fi
+
+cosign sign --key "$COSIGN_KMS_URI" "$TEST_ARTIFACT" || { echo "cosign sign failed"; exit 3; }
+echo "cosign sign succeeded"
+
+echo "Verify cosign signature"
+cosign verify --key "$COSIGN_KMS_URI" "$TEST_ARTIFACT" || { echo "cosign verify failed"; exit 4; }
+echo "cosign verify succeeded"
+
+echo "Optionally confirm Rekor entry (rekor-cli must be available)"
+if command -v rekor-cli >/dev/null 2>&1; then
+  echo "Searching Rekor for artifact"
+  digest=$(sha256sum "$TEST_ARTIFACT" | awk '{print $1}')
+  rekor-cli search --sha "$digest" --server "$REKOR_SERVER" || echo "rekor search failed or no entry found"
+else
+  echo "rekor-cli not installed; skip Rekor confirmation"
+fi
+
+echo "Builder cosign+rekor test complete. Remove test artifact if desired."
+
