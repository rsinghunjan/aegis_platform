+cp services/privacy/rdp_accountant.py "$OUT/" || true
+tar -czf "${OUT}.tar.gz" -C "$(dirname "$OUT")" "$(basename "$OUT")"
+echo "Built audit packet: ${OUT}.tar.gz"
+if [ -n "${EVIDENCE_BUCKET:-}" ]; then
+  aws s3 cp "${OUT}.tar.gz" "s3://${EVIDENCE_BUCKET%/}/compliance_packets/$(basename ${OUT}).tar.gz"
+  echo "Uploaded to s3://${EVIDENCE_BUCKET%/}/compliance_packets/"
+fi
