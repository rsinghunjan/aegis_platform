+#!/usr/bin/env python3
+"""
+CrypTen worker entrypoint for multi-host production-style deployments.
+ - Expects torch.distributed env variables: MASTER_ADDR, MASTER_PORT, WORLD_SIZE, RANK
+ - Supports mTLS cert path envs (CERT_FILE, KEY_FILE, CA_FILE) to be used by transport layer if applicable.
+ - Initializes torch.distributed and CrypTen and participates in secure-sum protocol.
+"""
+import os
+import time
+import socket
+import torch
+import crypten
+from crypten.mpc import run_multiprocess
+
+def init_torch_dist():
+    # This assumes that the container environment is already set with MASTER_ADDR/PORT and RANK/WORLD_SIZE
+    master_addr = os.environ.get("MASTER_ADDR")
+    master_port = os.environ.get("MASTER_PORT")
+    rank = int(os.environ.get("RANK", "0"))
+    world_size = int(os.environ.get("WORLD_SIZE", "1"))
+    backend = os.environ.get("DIST_BACKEND", "gloo")
+    os.environ['MASTER_ADDR'] = master_addr
+    os.environ['MASTER_PORT'] = master_port
+    # torch.distributed.init_process_group would be used for multi-host; CrypTen may use it internally
+    try:
+        torch.distributed.init_process_group(backend=backend, init_method=f"tcp://{master_addr}:{master_port}", rank=rank, world_size=world_size)
+    except Exception as e:
+        # In some setups, Crypten's run_multiprocess will handle local spawning; log and continue
+        print("torch.distributed init may be handled externally:", e)
+
+def worker_fn(rank, world_size, tensors):
+    crypten.init()
+    x = torch.tensor(tensors[rank])
+    enc_x = crypten.cryptensor(x, src=rank)
+    # In a real MPC protocol we would perform secure sum across encrypted tensors.
+    enc_sum = enc_x
+    # Reveal only in demo; in production avoid revealing plaintext to unauthorized parties.
+    res = enc_sum.get_plain_text()
+    if rank == 0:
+        print("Demo aggregate at rank 0:", res)
+    return res
+
+def main():
+    # For pilot, assemble simple tensors per rank; in production each party supplies its own tensor securely
+    world_size = int(os.environ.get("WORLD_SIZE", "3"))
+    # Build example tensors using rank-specific deterministic values for test vectors
+    tensors = []
+    for i in range(world_size):
+        tensors.append([0.1 * (i+1), 0.2 * (i+1), 0.3 * (i+1)])
+    print("Starting CrypTen worker entrypoint; world_size", world_size)
+    init_torch_dist()
+    run_multiprocess(world_size, target=worker_fn, args=(world_size, tensors))
+
+if __name__=="__main__":
+    main()
+
