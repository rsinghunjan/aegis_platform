+#!/usr/bin/env python3
+"""
+M-of-N approval service with optional OIDC authentication.
+ - Requests and approvals may be authenticated via JWT Bearer tokens.
+ - Configure OIDC_JWKS_URL and OIDC_AUDIENCE to enable JWT verification.
+
+API:
+ - POST /request_action {request_id, action_id, payload, m}
+ - POST /approve {request_id} (requires Authorization: Bearer <JWT>)
+ - GET /status?request_id=...
+
+Approvals are recorded with approver identity extracted from the token's 'sub' claim.
+"""
+import os
+import sqlite3
+import threading
+import time
+from flask import Flask, request, jsonify
+import jwt
+import requests
+from jwt import PyJWKClient
+
+DB = os.environ.get("MOFN_DB", "/tmp/mofn_oidc.db")
+OIDC_JWKS_URL = os.environ.get("OIDC_JWKS_URL", "")
+OIDC_AUDIENCE = os.environ.get("OIDC_AUDIENCE", "")
+LOCK = threading.Lock()
+
+def init_db():
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("CREATE TABLE IF NOT EXISTS requests (id TEXT PRIMARY KEY, action_id TEXT, payload TEXT, m INTEGER, created_ts INTEGER, approved INTEGER DEFAULT 0)")
+    c.execute("CREATE TABLE IF NOT EXISTS approvals (id INTEGER PRIMARY KEY AUTOINCREMENT, request_id TEXT, approver TEXT, ts INTEGER)")
+    conn.commit()
+    conn.close()
+
+init_db()
+app = Flask(__name__)
+jwks_client = PyJWKClient(OIDC_JWKS_URL) if OIDC_JWKS_URL else None
+
+def verify_jwt_and_get_sub(token):
+    if not jwks_client:
+        return None
+    signing_key = jwks_client.get_signing_key_from_jwt(token)
+    data = jwt.decode(token, signing_key.key, algorithms=["RS256"], audience=OIDC_AUDIENCE, options={"verify_exp": True})
+    return data.get("sub") or data.get("email") or data.get("preferred_username")
+
+@app.route("/request_action", methods=["POST"])
+def request_action():
+    j = request.get_json() or {}
+    request_id = j.get("request_id") or f"req-{int(time.time())}"
+    action_id = j.get("action_id")
+    payload = j.get("payload","")
+    m = int(j.get("m",1))
+    with LOCK:
+        conn = sqlite3.connect(DB)
+        c = conn.cursor()
+        c.execute("INSERT INTO requests (id,action_id,payload,m,created_ts) VALUES (?,?,?,?,strftime('%s','now'))", (request_id, action_id, payload, m))
+        conn.commit(); conn.close()
+    return jsonify({"request_id": request_id})
+
+@app.route("/approve", methods=["POST"])
+def approve():
+    # Authorization header expected: Bearer <token>
+    auth = request.headers.get("Authorization","")
+    approver = None
+    if auth.startswith("Bearer "):
+        token = auth.split(" ",1)[1]
+        try:
+            approver = verify_jwt_and_get_sub(token)
+        except Exception as e:
+            return jsonify({"error":"invalid_token","detail":str(e)}), 401
+    else:
+        # fallback to approver in body (not recommended for prod)
+        approver = request.json.get("approver")
+    rid = request.json.get("request_id")
+    if not rid or not approver:
+        return jsonify({"error":"request_id and approver required"}), 400
+    with LOCK:
+        conn = sqlite3.connect(DB)
+        c = conn.cursor()
+        c.execute("INSERT INTO approvals (request_id, approver, ts) VALUES (?,?,strftime('%s','now'))", (rid, approver))
+        conn.commit()
+        c.execute("SELECT COUNT(*) FROM approvals WHERE request_id=?", (rid,))
+        count = c.fetchone()[0]
+        c.execute("SELECT m FROM requests WHERE id=?", (rid,))
+        r = c.fetchone()
+        if not r:
+            conn.close()
+            return jsonify({"error":"request_not_found"}), 404
+        m = r[0]
+        if count >= m:
+            c.execute("UPDATE requests SET approved=1 WHERE id=?", (rid,))
+            conn.commit()
+            conn.close()
+            return jsonify({"approved": True, "approvals": count})
+        conn.close()
+    return jsonify({"approved": False, "approvals": count})
+
+@app.route("/status", methods=["GET"])
+def status():
+    rid = request.args.get("request_id")
+    if not rid:
+        return jsonify({"error":"request_id required"}), 400
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("SELECT action_id,payload,m,approved FROM requests WHERE id=?", (rid,))
+    r = c.fetchone()
+    c.execute("SELECT approver,ts FROM approvals WHERE request_id=?", (rid,))
+    approvals = [{"approver":row[0],"ts":row[1]} for row in c.fetchall()]
+    conn.close()
+    if not r:
+        return jsonify({"error":"not found"}), 404
+    return jsonify({"request_id": rid, "action_id": r[0], "payload": r[1], "m": r[2], "approved": bool(r[3]), "approvals": approvals})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8320")))
+
