+name: One-Click Level-4 Staging Drill (preflight + run)
+on:
+  workflow_dispatch:
+    inputs:
+      dataset_path:
+        description: 'Path to dataset CSV for privacy tuning (relative to repo)'
+        required: false
+        default: 'data/sample_dataset.csv'
+      image_tag:
+        description: 'Image tag to deploy for webhook & services'
+        required: false
+        default: ''
+
+jobs:
+  preflight-and-run:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Preflight check required secrets
+        id: preflight
+        run: |
+          missing=0
+          for s in KUBE_CONFIG_DATA EVIDENCE_BUCKET COSIGN_KMS_URI AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION MLFLOW_TRACKING_URI GF_URL GF_API_KEY; do
+            if [ -z "${{ secrets[$s] }}" ]; then
+              echo "Secret $s is missing"
+              missing=$((missing+1))
+            fi
+          done || true
+          if [ "$missing" -ne 0 ]; then
+            echo "Preflight failed: $missing secrets missing. See repo secrets."
+            exit 1
+          fi
+          echo "Preflight ok"
+
+      - name: Run Level-4 staging drill
+        env:
+          EVIDENCE_BUCKET: ${{ secrets.EVIDENCE_BUCKET }}
+          COSIGN_KMS_URI: ${{ secrets.COSIGN_KMS_URI }}
+          KUBE_CONFIG_DATA: ${{ secrets.KUBE_CONFIG_DATA }}
+          AWS_REGION: ${{ secrets.AWS_REGION }}
+          IMAGE_REPO: ghcr.io/${{ github.repository_owner }}/admission-webhook
+          MLFLOW_TRACKING_URI: ${{ secrets.MLFLOW_TRACKING_URI }}
+        run: |
+          echo "${{ secrets.KUBE_CONFIG_DATA }}" | base64 -d > $HOME/.kube/config
+          # Kick off the existing Level-4 drill workflow locally in this runner
+          gh workflow run level4_staging_drill.yml -f dataset_path="${{ github.event.inputs.dataset_path }}" -f image_tag="${{ github.event.inputs.image_tag }}" || true
+          # Wait for the workflow to start then poll canary status as a smoke check
+          sleep 10
+          kubectl -n aegis get canary aegis-admission-webhook -o yaml || true
+
