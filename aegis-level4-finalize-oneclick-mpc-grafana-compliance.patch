+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to launch CrypTen worker processes inside each crypten worker pod by using kubectl exec.
+# This is a convenience for staging/pilot tests. For real production, run a proper entrypoint that starts the worker process directly in the container.
+#
+NAMESPACE=${1:-aegis}
+STATEFULSET=${2:-crypten-worker}
+CMD=${3:-"/app/worker.py"}
+
+pods=$(kubectl -n "$NAMESPACE" get pods -l app=crypten-worker -o jsonpath='{.items[*].metadata.name}')
+if [ -z "$pods" ]; then
+  echo "No crypten-worker pods found in namespace $NAMESPACE"
+  exit 2
+fi
+
+echo "Launching worker command in pods: $pods"
+for p in $pods; do
+  echo "Starting worker in pod $p"
+  kubectl -n "$NAMESPACE" exec "$p" -- sh -c "nohup ${CMD} > /tmp/worker.log 2>&1 &"
+done
+
+echo "Launched workers; tail logs from one pod to observe progress:"
+first=$(echo $pods | awk '{print $1}')
+kubectl -n "$NAMESPACE" exec "$first" -- tail -n +1 -f /tmp/worker.log || true
+
