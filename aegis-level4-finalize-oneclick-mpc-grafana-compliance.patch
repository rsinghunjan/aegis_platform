+#!/usr/bin/env python3
+"""
+Register an evidence manifest in Rekor and upload artifact to S3.
+Requires:
+ - rekor CLI installed and configured (REKOR_SERVER env optional)
+ - AWS CLI (if uploading to S3)
+"""
+import argparse, subprocess, os, json
+
+def upload_s3(bucket, path):
+    if not bucket:
+        return None
+    subprocess.check_call(["aws","s3","cp", path, f"{bucket.rstrip('/')}/evidence/"])
+    return f"s3://{bucket.rstrip('/')}/evidence/{os.path.basename(path)}"
+
+def rekor_upload(path, rekor_url=None):
+    cmd = ["rekor-cli","upload","--artifact", path]
+    if rekor_url:
+        cmd += ["--rekor_server", rekor_url]
+    subprocess.check_call(cmd)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--manifest", required=True)
+    p.add_argument("--evidence-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    p.add_argument("--rekor-server", default=os.environ.get("REKOR_SERVER",""))
+    args = p.parse_args()
+    s3uri = upload_s3(args.evidence_bucket, args.manifest)
+    print("Uploaded manifest to:", s3uri)
+    rekor_upload(args.manifest, args.rekor_server or None)
+    print("Registered manifest with Rekor (if available).")
+
+if __name__=="__main__":
+    main()
+
