+#!/usr/bin/env python3
+"""
+Carbon-aware scheduler helper for orchestrator:
+ - Given a list of nodes and their carbon intensity (using services.telemetry.carbon_lookup),
+   suggest node affinity or node name(s) to prefer.
+ - This is a helper used by the orchestrator to annotate job manifests before submission.
+"""
+from services.telemetry.carbon_lookup import lookup_co2_intensity
+from kubernetes import client, config
+
+def pick_nodes(count=1, region=None, isolated_only=True):
+    config.load_kube_config()
+    v1 = client.CoreV1Api()
+    nodes = v1.list_node().items
+    cand = []
+    for n in nodes:
+        labels = n.metadata.labels or {}
+        if isolated_only and labels.get("runtime.aegis/has-isolation") != "true":
+            continue
+        node_region = labels.get("topology.kubernetes.io/region") or region
+        intensity = lookup_co2_intensity(node_region)
+        cand.append({"name": n.metadata.name, "intensity": intensity})
+    cand.sort(key=lambda x: x["intensity"])
+    return [c["name"] for c in cand[:count]]
+
+if __name__ == "__main__":
+    import argparse, json
+    p = argparse.ArgumentParser()
+    p.add_argument("--count", type=int, default=1)
+    args = p.parse_args()
+    print(json.dumps(pick_nodes(args.count)))
+
