+#!/usr/bin/env python3
+"""
+Admission webhook that enforces:
+ - container images are cosign-signed (using mounted pubkey)
+ - pods in protected namespaces use an allowed RuntimeClass
+
+This is a lightweight validating webhook intended for staging acceptance testing.
+It calls out to the `cosign` CLI (must be available in the image).
+Mounts:
+ - /etc/webhook/cosign/pubkey.pem
+ - TLS certs at /etc/webhook/certs (server cert/key provided by k8s secret)
+Env:
+ - ALLOWED_RUNTIMES (comma separated, e.g. "runsc,kata")
+ - PROTECTED_NAMESPACES (comma separated list of ns to protect)
+"""
+import os
+import json
+import subprocess
+from flask import Flask, request, jsonify
+
+ALLOWED = os.environ.get("ALLOWED_RUNTIMES", "runsc,kata").split(",")
+PROTECTED = os.environ.get("PROTECTED_NAMESPACES", "ml-serving").split(",")
+PUBKEY_PATH = os.environ.get("COSIGN_PUBKEY", "/etc/webhook/cosign/pubkey.pem")
+
+app = Flask(__name__)
+
+def image_is_signed(image_ref: str) -> bool:
+    # call cosign verify --key PUBKEY_PATH image_ref
+    try:
+        subprocess.check_call(["cosign", "verify", "--key", PUBKEY_PATH, image_ref], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def runtime_allowed(runtime_class: str) -> bool:
+    if not runtime_class:
+        return False
+    return any(r.strip() == runtime_class for r in ALLOWED)
+
+@app.route("/validate", methods=["POST"])
+def validate():
+    req = request.get_json(force=True)
+    resp = {"apiVersion": "admission.k8s.io/v1", "kind": "AdmissionReview", "response": {"uid": req.get("request",{}).get("uid",""), "allowed": True}}
+    try:
+        r = req["request"]
+        kind = r.get("kind", {}).get("kind", "")
+        namespace = r.get("namespace", "")
+        # Only validate Pod creates
+        if r.get("operation") != "CREATE" or kind != "Pod":
+            return jsonify(resp)
+        # If namespace not protected, allow
+        if namespace not in PROTECTED:
+            return jsonify(resp)
+        pod = r.get("object", {})
+        runtime_class = pod.get("spec", {}).get("runtimeClassName", "")
+        # Check runtime allowed
+        if not runtime_allowed(runtime_class):
+            resp["response"]["allowed"] = False
+            resp["response"]["status"] = {"message": f"RuntimeClass '{runtime_class}' not allowed in protected namespace {namespace}"}
+            return jsonify(resp)
+        # Check images signed
+        containers = pod.get("spec", {}).get("containers", []) + pod.get("spec", {}).get("initContainers", [])
+        for c in containers:
+            img = c.get("image")
+            if not img:
+                resp["response"]["allowed"] = False
+                resp["response"]["status"] = {"message": "Container without image not allowed"}
+                return jsonify(resp)
+            if not image_is_signed(img):
+                resp["response"]["allowed"] = False
+                resp["response"]["status"] = {"message": f"Image {img} is not cosign-signed with expected key"}
+                return jsonify(resp)
+    except Exception as e:
+        # On error, be safe and reject
+        resp["response"]["allowed"] = False
+        resp["response"]["status"] = {"message": f"validation error: {str(e)}"}
+    return jsonify(resp)
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=9443, ssl_context=("/etc/webhook/certs/tls.crt","/etc/webhook/certs/tls.key"))
+
