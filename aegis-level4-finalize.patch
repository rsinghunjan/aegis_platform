+#!/usr/bin/env python3
+"""
+Simple reviewer service:
+ - Pulls from a Redis stream (MODERATION_STREAM)
+ - Exposes endpoints for reviewer UI to list next items and submit decisions
+ - Emits Prometheus metrics for backlog and reviewer latency
+"""
+import os, time, json
+from flask import Flask, jsonify, request
+try:
+    import redis
+except Exception:
+    redis = None
+from prometheus_client import Gauge, make_wsgi_app
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+STREAM = os.environ.get("MODERATION_STREAM", "diffusers:moderation:stream")
+
+app = Flask(__name__)
+backlog_gauge = Gauge("aegis_moderation_backlog", "Number of pending moderation items")
+
+def get_redis():
+    if redis is None:
+        raise RuntimeError("redis client required")
+    return redis.from_url(REDIS_URL)
+
+@app.route("/healthz")
+def health():
+    return "ok"
+
+@app.route("/next", methods=["GET"])
+def next_item():
+    r = get_redis()
+    res = r.xread({STREAM: "0-0"}, count=1, block=5000)
+    entries = []
+    if res:
+        for stream, items in res:
+            for mid, fields in items:
+                entries.append({"id": mid, "fields": fields})
+    backlog = r.xlen(STREAM)
+    backlog_gauge.set(backlog)
+    return jsonify(entries)
+
+@app.route("/review", methods=["POST"])
+def submit():
+    data = request.get_json(force=True)
+    msg_id = data.get("id")
+    decision = data.get("decision")
+    r = get_redis()
+    # Acknowledge and store decision (simplified)
+    try:
+        r.xack(STREAM, "aegis-moderation-group", msg_id)
+        r.hset("moderation:results", msg_id, json.dumps({"decision": decision, "ts": int(time.time())}))
+    except Exception as e:
+        return jsonify({"ok": False, "error": str(e)}), 500
+    return jsonify({"ok": True})
+
+# Mount Prometheus WSGI app at /metrics using a WSGI server (e.g., gunicorn)
+if __name__ == "__main__":
+    from werkzeug.middleware.dispatcher import DispatcherMiddleware
+    app.wsgi_app = DispatcherMiddleware(app.wsgi_app, {"/metrics": make_wsgi_app()})
+    app.run(host="0.0.0.0", port=8080)
