+#!/usr/bin/env python3
+"""
+Durable, idempotent quota reservation service (Redis-backed).
+API:
+ - POST /reserve {id, tenant, amount} -> {ok, reserved}
+ - GET /check?id=... -> {ok, reserved}
+ Uses Redis hashes and optimistic set-if-not-exists to ensure idempotency.
+"""
+import os, json
+from flask import Flask, request, jsonify
+try:
+    import redis
+except Exception:
+    redis = None
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+QUOTA_KEY_PREFIX = "quota:tenant:"
+
+app = Flask(__name__)
+
+def get_redis():
+    if redis is None:
+        raise RuntimeError("redis client required")
+    return redis.from_url(REDIS_URL)
+
+@app.route("/reserve", methods=["POST"])
+def reserve():
+    payload = request.get_json(force=True)
+    rid = payload.get("id")
+    tenant = payload.get("tenant")
+    amount = int(payload.get("amount", 0))
+    if not (rid and tenant):
+        return jsonify({"ok": False, "error": "id and tenant required"}), 400
+    r = get_redis()
+    # Idempotency: if reservation id exists, return existing result
+    existing = r.hgetall(f"reservation:{rid}")
+    if existing:
+        return jsonify({"ok": True, "reserved": existing.get(b"amount") and int(existing.get(b"amount"))})
+    # Check tenant quota (simple model): tenant has 'quota' key
+    quota_key = QUOTA_KEY_PREFIX + tenant
+    quota = int(r.get(quota_key) or 0)
+    used = int(r.get(f"{quota_key}:used") or 0)
+    if used + amount > quota:
+        return jsonify({"ok": False, "error": "over_quota"}), 402
+    # Reserve: atomically increment used and record reservation
+    pipe = r.pipeline()
+    pipe.incrby(f"{quota_key}:used", amount)
+    pipe.hset(f"reservation:{rid}", mapping={"tenant": tenant, "amount": amount, "ts": int(time.time())})
+    pipe.execute()
+    return jsonify({"ok": True, "reserved": amount})
+
+@app.route("/check", methods=["GET"])
+def check():
+    rid = request.args.get("id")
+    if not rid:
+        return jsonify({"ok": False, "error": "id required"}), 400
+    r = get_redis()
+    existing = r.hgetall(f"reservation:{rid}")
+    if not existing:
+        return jsonify({"ok": True, "reserved": 0})
+    return jsonify({"ok": True, "reserved": int(existing.get(b"amount"))})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=8082)
+
