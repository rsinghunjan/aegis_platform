+#!/usr/bin/env python3
+"""
+Autoscaler guard to prevent oscillation/runaway:
+ - monitors KEDA ScaledObject status and recent scale events (via Kubernetes events)
+ - if scale events exceed threshold (N events in M minutes), increases cooldown or caps maxReplicaCount temporarily
+ - writes an annotation with guard action for audit
+"""
+import time
+from datetime import datetime, timedelta
+try:
+    from kubernetes import client, config
+except Exception:
+    client = None
+
+N_EVENTS = int(__import__("os").environ.get("AUTOSCALE_GUARD_N", "5"))
+WINDOW_MIN = int(__import__("os").environ.get("AUTOSCALE_GUARD_WINDOW_MIN", "10"))
+NAMESPACE = "ml-serving"
+SCALEDOBJECT_NAME = "diffusers-queue-scaledobject"
+
+def load_kube():
+    if client is None:
+        raise RuntimeError("kubernetes client required")
+    config.load_kube_config()
+
+def recent_scale_events():
+    v1 = client.CoreV1Api()
+    events = v1.list_namespaced_event(NAMESPACE).items
+    now = datetime.utcnow()
+    cutoff = now - timedelta(minutes=WINDOW_MIN)
+    scale_events = [e for e in events if "scaled" in (e.reason or "").lower() and datetime.strptime(e.last_timestamp, "%Y-%m-%dT%H:%M:%SZ") > cutoff]
+    return scale_events
+
+def patch_scaledobject(max_replicas=None, cooldown=None):
+    api = client.CustomObjectsApi()
+    body = {"spec": {}}
+    if max_replicas:
+        body["spec"]["maxReplicaCount"] = int(max_replicas)
+    if cooldown:
+        body["spec"]["cooldownPeriod"] = int(cooldown)
+    api.patch_namespaced_custom_object(group="keda.sh", version="v1alpha1", namespace=NAMESPACE, plural="scaledobjects", name=SCALEDOBJECT_NAME, body=body)
+    print("Patched scaledobject with", body)
+
+def main():
+    load_kube()
+    while True:
+        events = recent_scale_events()
+        print("Recent scale events:", len(events))
+        if len(events) >= N_EVENTS:
+            print("Oscillation detected; applying guard")
+            # Example action: cap max replicas temporarily and increase cooldown
+            patch_scaledobject(max_replicas= max(4, N_EVENTS), cooldown=300)
+        time.sleep(60)
+
+if __name__ == "__main__":
+    main()
+
