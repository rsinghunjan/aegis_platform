+#!/usr/bin/env python3
+"""
+Run watermark analysis on a set of images, generate forensic bundles and sign them with cosign KMS key.
+Uploads artifacts to S3 evidence bucket.
+Requires: cosign on PATH and aws cli configured (or boto3 can be integrated).
+"""
+import os, subprocess, tempfile, json
+from services.serving.diffusers.forensic_reporter import analyze_and_bundle
+
+IMAGES_DIR = os.environ.get("WM_IMAGES_DIR", "./tests/watermark_samples")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def main():
+    for fn in os.listdir(IMAGES_DIR):
+        if not fn.lower().endswith((".png",".jpg",".jpeg")):
+            continue
+        path = os.path.join(IMAGES_DIR, fn)
+        with open(path, "rb") as f:
+            content = f.read()
+        payload = f"aegis-forensic-{fn}-{int(__import__('time').time())}"
+        res = analyze_and_bundle(content, payload, out_prefix=os.path.splitext(fn)[0])
+        archive = res.get("archive")
+        if COSIGN_KEY_REF and archive:
+            try:
+                subprocess.check_call(["cosign", "sign", "--key", COSIGN_KEY_REF, archive])
+            except Exception as e:
+                print("cosign sign failed:", e)
+        # upload (simple aws cli usage)
+        if EVIDENCE_BUCKET and archive:
+            key = f"forensics/{os.path.basename(archive)}"
+            subprocess.check_call(["aws", "s3", "cp", archive, f"{EVIDENCE_BUCKET}/{key}"])
+            print("Uploaded", archive, "to", EVIDENCE_BUCKET)
+    print("Forensic run complete")
+
+if __name__ == "__main__":
+    main()
