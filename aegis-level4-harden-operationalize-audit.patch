+#!/usr/bin/env python3
+"""
+Check that required KMS keys, aliases, and Vault policies exist prior to enabling automated key rotation.
+Exits non-zero if checks fail.
+"""
+import boto3, os, sys, json
+
+KMS_ALIAS = os.environ.get("KMS_ALIAS", "alias/aegis/cosign")
+AWS_REGION = os.environ.get("AWS_REGION", "us-east-1")
+
+client = boto3.client("kms", region_name=AWS_REGION)
+
+def check_alias(alias):
+    try:
+        resp = client.describe_key(KeyId=alias)
+        key_meta = resp.get("KeyMetadata",{})
+        print("Found alias:", alias, " -> keyId:", key_meta.get("KeyId"))
+        return True
+    except client.exceptions.NotFoundException:
+        print("Alias not found:", alias)
+        return False
+    except Exception as e:
+        print("KMS check error:", e)
+        return False
+
+def main():
+    ok = check_alias(KMS_ALIAS)
+    if not ok:
+        print("KMS gating check failed; do not enable automated rotation")
+        sys.exit(2)
+    print("KMS gating check passed")
+
+if __name__=="__main__":
+    main()
+
