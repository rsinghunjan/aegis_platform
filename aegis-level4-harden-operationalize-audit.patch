+#!/usr/bin/env bash
+set -euo pipefail
+RELEASE="$1"
+CHART="$2"
+IMAGE="$3"
+
+echo "Performing safe helm upgrade for $RELEASE with image $IMAGE"
+# Ensure image signature via cosign local verification (IMAGE must be in format registry/repo:tag)
+if ! ./ops/ci/verify_cosign_and_rekor.sh "$IMAGE"; then
+  echo "Image verification failed; aborting helm upgrade"
+  exit 1
+fi
+
+helm upgrade --install "$RELEASE" "$CHART" --namespace aegis --create-namespace \
+  --set image.repository="$(echo "$IMAGE" | cut -d: -f1)" \
+  --set image.tag="$(echo "$IMAGE" | cut -d: -f2)" \
+  --wait --timeout 180s
+
+echo "Helm upgrade complete"
+
