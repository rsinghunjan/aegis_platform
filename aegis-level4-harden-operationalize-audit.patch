+#!/usr/bin/env python3
+"""
+Generate audit request artifacts and create a concise audit package for external auditors.
+Produces a tar.gz with signed evidence and a JSON manifest, and (optionally) opens a GitHub issue to notify auditors.
+"""
+import os, json, subprocess, time, argparse
+
+def gather(paths, out_dir):
+    os.makedirs(out_dir, exist_ok=True)
+    for p in paths:
+        if os.path.exists(p):
+            subprocess.check_call(["cp","-r",p,out_dir])
+
+def build_manifest(out_dir, meta):
+    manifest = {"meta": meta, "files": []}
+    for root, _, files in os.walk(out_dir):
+        for f in files:
+            manifest["files"].append(os.path.relpath(os.path.join(root,f), out_dir))
+    with open(os.path.join(out_dir, "audit_manifest.json"), "w") as fh:
+        json.dump(manifest, fh, indent=2)
+
+def package(out_dir):
+    tar = out_dir.rstrip("/") + ".tar.gz"
+    subprocess.check_call(["tar","-czf",tar,"-C",os.path.dirname(out_dir), os.path.basename(out_dir)])
+    return tar
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", default="/tmp/aegis_audit_pack")
+    p.add_argument("--include", nargs="*", default=["/tmp/privacy_decision.md","/tmp/canary_manifest.json","/tmp/kms_rotation_*.json"])
+    p.add_argument("--note", default="automated-audit-request")
+    args = p.parse_args()
+    ts = int(time.time())
+    out_dir = f"{args.out}_{ts}"
+    gather(args.include, out_dir)
+    build_manifest(out_dir, {"note": args.note, "ts": ts})
+    tar = package(out_dir)
+    print("Produced audit packet:", tar)
+
+if __name__=="__main__":
+    main()
+
