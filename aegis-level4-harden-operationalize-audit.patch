+#!/usr/bin/env python3
+"""
+Example integration for an FL controller to call the DP accounting service before and after each round.
+This file is a reference patch to adapt into your FL orchestration.
+"""
+import requests, uuid, os, time
+
+DP_URL = os.environ.get("DP_ACCOUNTING_URL", "http://dp-accounting:8310")
+
+def check_and_start_round(project, noise, sample_rate, steps, delta=1e-5):
+    payload = {"project": project, "noise": noise, "sample_rate": sample_rate, "steps": steps, "delta": delta}
+    r = requests.post(f"{DP_URL}/check_run", json=payload, timeout=10)
+    if r.status_code == 200 and r.json().get("allowed"):
+        run_id = str(uuid.uuid4())
+        # start round with run_id
+        return run_id
+    else:
+        raise RuntimeError("DP budget exceeded or check failed: " + r.text)
+
+def report_round(project, run_id, epsilon):
+    payload = {"project": project, "run_id": run_id, "epsilon": epsilon}
+    r = requests.post(f"{DP_URL}/report_round", json=payload, timeout=10)
+    if r.status_code != 200:
+        raise RuntimeError("Failed to report round: " + r.text)
+
+if __name__=="__main__":
+    # Example usage
+    project="default"
+    run_id = check_and_start_round(project, noise=1.0, sample_rate=0.01, steps=100)
+    print("Starting FL round:", run_id)
+    time.sleep(1)
+    report_round(project, run_id, epsilon=0.5)
+    print("Reported epsilon for run", run_id)
+
