+name: Hardened Deploy Pipeline (verify -> approve -> deploy -> attest)
+on:
+  workflow_dispatch:
+    inputs:
+      image_tag:
+        description: 'Image tag to deploy (sha or tag)'
+        required: true
+
+permissions:
+  contents: read
+  id-token: write
+  packages: read
+
+env:
+  REKOR_SERVER: ${{ secrets.REKOR_SERVER }}
+  COSIGN_KMS_URI: ${{ secrets.COSIGN_KMS_URI }}
+  MOFN_URL: ${{ secrets.MOFN_URL }}
+  DP_CHECK_URL: ${{ secrets.DP_CHECK_URL }}
+  EVIDENCE_BUCKET: ${{ secrets.EVIDENCE_BUCKET }}
+
+jobs:
+  prechecks:
+    name: Pre-deploy checks (signatures, approvals, DP budget)
+    runs-on: ubuntu-latest
+    outputs:
+      approved: ${{ steps.approval.outputs.approved }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Verify image cosign signature and Rekor entry
+        id: verify
+        run: |
+          set -euo pipefail
+          IMAGE="ghcr.io/${{ github.repository_owner }}/admission-webhook:${{ github.event.inputs.image_tag }}"
+          echo "Verifying cosign signature for $IMAGE"
+          ./ops/ci/verify_cosign_and_rekor.sh "$IMAGE" || (echo "Signature/Rekor verification failed" && exit 1)
+
+      - name: Check M-of-N approval
+        id: approval
+        run: |
+          set -euo pipefail
+          # Expecting request_id to be created in PR or created prior by operator
+          REQUEST_ID=$(jq -r '.inputs.request_id // ""' <<<"${{ toJson(github.event) }}" 2>/dev/null || echo "")
+          if [ -z "$REQUEST_ID" ]; then
+            echo "No M-of-N request_id provided; require human approval via MOFN API"
+            # Fallback: require explicit operator approval input (fail)
+            echo "::set-output name=approved::false"
+            exit 1
+          fi
+          echo "Querying M-of-N service for $REQUEST_ID"
+          STATUS=$(curl -sS "${MOFN_URL}/status?request_id=${REQUEST_ID}")
+          APPROVED=$(echo "$STATUS" | jq -r '.approved')
+          if [ "$APPROVED" != "true" ]; then
+            echo "M-of-N approval not satisfied"
+            echo "::set-output name=approved::false"
+            exit 1
+          fi
+          echo "::set-output name=approved::true"
+
+      - name: DP budget check (conservative)
+        run: |
+          # call DP accounting service to check project budget before allowing deploy to training/FL env
+          PROJECT="default"
+          EPS=0.1
+          RES=$(curl -sS -X POST -H "Content-Type: application/json" -d "{\"project\":\"$PROJECT\",\"epsilon\":$EPS}" "${DP_CHECK_URL}/check_run" || true)
+          echo "DP check result: $RES"
+          ALLOWED=$(echo "$RES" | jq -r '.allowed // false')
+          if [ "$ALLOWED" != "true" ]; then
+            echo "DP accounting would be exceeded; aborting deployment"
+            exit 1
+          fi
+
+  deploy:
+    name: Deploy with safe defaults & attest
+    runs-on: ubuntu-latest
+    needs: prechecks
+    if: needs.prechecks.outputs.approved == 'true'
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Configure kubeconfig
+        if: ${{ secrets.KUBE_CONFIG_DATA }}
+        run: |
+          echo "${{ secrets.KUBE_CONFIG_DATA }}" | base64 -d > $HOME/.kube/config
+
+      - name: Helm safe upgrade (with image verification)
+        run: |
+          set -euo pipefail
+          IMAGE_TAG="${{ github.event.inputs.image_tag }}"
+          IMAGE="ghcr.io/${{ github.repository_owner }}/admission-webhook:${IMAGE_TAG}"
+          ./ops/ci/helm_safe_upgrade.sh aegis-admission-webhook helm/admission-webhook "$IMAGE"
+
+      - name: Generate deployment evidence manifest and sign
+        run: |
+          python3 ops/evidence/generate_evidence_manifest.py --type deploy --image-tag "${{ github.event.inputs.image_tag }}" --canary aegis-admission-webhook --out /tmp/deploy_manifest.json
+          if [ -n "${COSIGN_KMS_URI:-}" ]; then
+            cosign sign-blob --key "${COSIGN_KMS_URI}" /tmp/deploy_manifest.json
+          fi
+          aws s3 cp /tmp/deploy_manifest.json "s3://${EVIDENCE_BUCKET%/}/deploy_manifests/"
+          if command -v rekor-cli >/dev/null 2>&1; then
+            rekor-cli upload --artifact /tmp/deploy_manifest.json || true
+          fi
+
