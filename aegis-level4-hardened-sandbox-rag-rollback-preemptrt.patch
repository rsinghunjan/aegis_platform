+#!/usr/bin/env python3
+"""
+Pod-executor sandbox:
+- Creates an ephemeral pod (allowlisted image) to run a requested action.
+- Captures stdout/stderr, returns signed receipt using KMS, and stores audit record in MCP.
+Security notes:
+- The controller runs with minimal RBAC and the pods should use restricted securityContext,
+  run as non-root and leverage runtime isolation (gVisor/Kata) at cluster level.
+"""
+import os, time, uuid, json, logging
+from fastapi import FastAPI, HTTPException, BackgroundTasks
+from pydantic import BaseModel
+from kubernetes import client, config
+import boto3, requests
+
+LOG = logging.getLogger("aegis.podexec")
+app = FastAPI(title="Aegis Pod Executor Sandbox")
+
+ALLOWED_IMAGES = os.environ.get("SANDBOX_ALLOWLIST_IMAGES","alpine:3.18,busybox:1.36").split(",")
+NAMESPACE = os.environ.get("SANDBOX_NAMESPACE","sandbox")
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API","http://mcp:8082")
+KMS_KEY_ID = os.environ.get("SANDBOX_KMS_KEY_ID")
+
+# init kubernetes client
+try:
+    config.load_incluster_config()
+except Exception:
+    config.load_kube_config()
+core = client.CoreV1Api()
+
+kms = boto3.client("kms") if KMS_KEY_ID else None
+
+class RunReq(BaseModel):
+    image: str
+    cmd: list
+    timeout_s: int = 30
+    requestor: str = "unknown"
+
+def sign_payload(payload_bytes: bytes):
+    if not kms or not KMS_KEY_ID:
+        return None
+    resp = kms.sign(KeyId=KMS_KEY_ID, Message=payload_bytes, MessageType='RAW', SigningAlgorithm='RSASSA_PKCS1_V1_5_SHA_256')
+    return resp.get("Signature")
+
+def store_audit(record: dict):
+    try:
+        requests.post(f"{AEGIS_MCP_API.rstrip('/')}/sandbox/audit", json=record, timeout=5.0)
+    except Exception as e:
+        LOG.warning("failed to store audit to MCP: %s", e)
+
+def make_pod_manifest(name, image, cmd, uid):
+    return client.V1Pod(
+        metadata=client.V1ObjectMeta(name=name, labels={"aegis-sandbox": "true", "uid": uid}),
+        spec=client.V1PodSpec(
+            restart_policy="Never",
+            containers=[
+                client.V1Container(
+                    name="runner",
+                    image=image,
+                    command=cmd,
+                    security_context=client.V1SecurityContext(run_as_non_root=True, allow_privilege_escalation=False),
+                )
+            ]
+        )
+    )
+
+@app.post("/run")
+def run(req: RunReq, background: BackgroundTasks):
+    if req.image not in ALLOWED_IMAGES:
+        raise HTTPException(status_code=403, detail="image not allowed")
+    uid = str(uuid.uuid4())
+    pod_name = f"sandbox-{uid[:8]}"
+    pod = make_pod_manifest(pod_name, req.image, req.cmd, uid)
+    try:
+        core.create_namespaced_pod(namespace=NAMESPACE, body=pod)
+    except Exception as e:
+        LOG.error("pod create failed: %s", e)
+        raise HTTPException(status_code=500, detail="failed to create pod")
+    # wait for pod to finish or timeout
+    start = time.time()
+    attempt = 0
+    while True:
+        time.sleep(1)
+        attempt += 1
+        try:
+            p = core.read_namespaced_pod(name=pod_name, namespace=NAMESPACE)
+            if p.status.phase in ("Succeeded","Failed"):
+                break
+        except Exception:
+            pass
+        if time.time() - start > req.timeout_s:
+            # delete pod and mark timeout
+            try:
+                core.delete_namespaced_pod(name=pod_name, namespace=NAMESPACE)
+            except Exception:
+                pass
+            receipt = {"action_id": uid, "requestor": req.requestor, "image": req.image, "cmd": req.cmd, "status": "timeout"}
+            payload = json.dumps(receipt).encode("utf-8")
+            sig = sign_payload(payload)
+            record = {"receipt": receipt, "signature": sig.hex() if sig else None}
+            background.add_task(store_audit, record)
+            raise HTTPException(status_code=504, detail="action timed out")
+    # collect logs
+    try:
+        logs = core.read_namespaced_pod_log(name=pod_name, namespace=NAMESPACE, container="runner", tail_lines=200)
+    except Exception:
+        logs = ""
+    # capture exit code
+    try:
+        p = core.read_namespaced_pod(name=pod_name, namespace=NAMESPACE)
+        rc = p.status.container_statuses[0].state.terminated.exit_code if p.status.container_statuses else None
+    except Exception:
+        rc = None
+    receipt = {"action_id": uid, "requestor": req.requestor, "image": req.image, "cmd": req.cmd, "return_code": rc, "logs": logs[:8192], "start_ts": int(start), "end_ts": int(time.time())}
+    payload = json.dumps(receipt).encode("utf-8")
+    sig = sign_payload(payload)
+    record = {"receipt": receipt, "signature": sig.hex() if sig else None}
+    background.add_task(store_audit, record)
+    # cleanup pod
+    try:
+        core.delete_namespaced_pod(name=pod_name, namespace=NAMESPACE)
+    except Exception:
+        pass
+    return {"action_id": uid, "signed": bool(sig), "return_code": rc, "logs": receipt["logs"]}
+
+@app.get("/health")
+def health():
+    return {"ok": True}
+
