+#!/usr/bin/env python3
+"""
+RAG retriever service:
+ - embeds queries with sentence-transformers
+ - queries Milvus (vector DB) for nearest neighbors
+ - calls cross-encoder reranker to score (doc, claim) pairs and returns ranked docs + a calibrated confidence
+ - applies decision rule: if best_score < threshold => mark 'needs_human' or request async verifier
+"""
+import os, logging, json
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from sentence_transformers import SentenceTransformer
+from pymilvus import connections, Collection
+import requests
+
+LOG = logging.getLogger("aegis.rag.retriever")
+app = FastAPI(title="Aegis RAG Retriever")
+
+MILVUS_HOST = os.environ.get("MILVUS_HOST","milvus.milvus")
+MILVUS_PORT = int(os.environ.get("MILVUS_PORT","19530"))
+COLLECTION_NAME = os.environ.get("MILVUS_COLLECTION","aegis_docs")
+CROSS_ENCODER_SVC = os.environ.get("CROSS_ENCODER_SVC","http://verifier-cross-encoder:8000/verify")
+MODEL_NAME = os.environ.get("EMBED_MODEL","all-MiniLM-L6-v2")
+TOP_K = int(os.environ.get("TOP_K","10"))
+THRESH = float(os.environ.get("RERANK_MIN_SCORE","0.35"))
+
+try:
+    embedder = SentenceTransformer(MODEL_NAME)
+except Exception as e:
+    LOG.error("embedder load failed: %s", e)
+    embedder = None
+
+connections.connect(host=MILVUS_HOST, port=str(MILVUS_PORT))
+collection = Collection(COLLECTION_NAME)
+
+class QueryReq(BaseModel):
+    text: str
+
+@app.post("/retrieve")
+def retrieve(req: QueryReq):
+    if not embedder:
+        raise HTTPException(status_code=503, detail="embedder unavailable")
+    qvec = embedder.encode([req.text])[0].tolist()
+    # search
+    search_params = {"metric_type":"IP","params":{"nprobe":10}}
+    try:
+        results = collection.search([qvec], "embedding", param=search_params, limit=TOP_K, output_fields=["text","meta"])
+    except Exception as e:
+        LOG.error("milvus search failed: %s", e)
+        raise HTTPException(status_code=503, detail="vector db search failed")
+    docs = []
+    for res in results[0]:
+        docs.append({"id": res.id, "text": res.entity.get("text"), "score": float(res.score)})
+    # call cross-encoder reranker for scoring
+    try:
+        r = requests.post(CROSS_ENCODER_SVC, json={"text": req.text, "retrieved_docs": docs}, timeout=10.0)
+        r.raise_for_status()
+        verdict = r.json()
+    except Exception as e:
+        LOG.warning("reranker call failed: %s", e)
+        # fallback: pick highest similarity
+        best_score = max([d["score"] for d in docs]) if docs else 0.0
+        return {"docs": docs, "best_score": best_score, "allow": best_score >= THRESH}
+    allow = verdict.get("allow", False)
+    best_score = verdict.get("score", 0.0)
+    return {"docs": docs, "best_score": best_score, "allow": allow, "verifier": verdict}
+
