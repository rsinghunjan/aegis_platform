+#!/usr/bin/env bash
+set -euo pipefail
+ARTIFACT=$1
+KMS_URI=$2   # e.g. aws-kms://arn:aws:kms:...
+REKOR_URL=${3:-}
+
+if [ -z "$ARTIFACT" ] || [ ! -f "$ARTIFACT" ]; then
+  echo "usage: $0 artifact KMS_URI [rekor_url]"
+  exit 2
+fi
+
+cosign sign-blob --kms "$KMS_URI" --output-signature "${ARTIFACT}.sig" "$ARTIFACT"
+echo "Signed: ${ARTIFACT}.sig"
+if [ -n "$REKOR_URL" ]; then
+  cosign upload-blob --rekor-url "$REKOR_URL" --signature "${ARTIFACT}.sig" "$ARTIFACT" || true
+  echo "Uploaded to rekor: $REKOR_URL"
+fi
+
