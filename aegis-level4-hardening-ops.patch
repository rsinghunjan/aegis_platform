+#!/usr/bin/env python3
+"""
+Calibrate cross-encoder verifier thresholds.
+Input: CSV with columns: claim, doc, label (1 for supported, 0 for unsupported)
+Output: recommended threshold for desired precision/recall operating point and calibration report (ROC/PR).
+"""
+import csv, sys, json
+from sklearn.metrics import precision_recall_curve, roc_curve, auc
+from sentence_transformers import CrossEncoder
+import numpy as np
+
+MODEL = sys.argv[1] if len(sys.argv) > 1 else "cross-encoder/ms-marco-MiniLM-L-6-v2"
+DATA = sys.argv[2] if len(sys.argv) > 2 else "calibration.csv"
+TARGET_F1 = float(sys.argv[3]) if len(sys.argv) > 3 else 0.8
+
+print("Loading model", MODEL)
+ce = CrossEncoder(MODEL)
+
+claims, docs, labels = [], [], []
+with open(DATA) as f:
+    r = csv.DictReader(f)
+    for row in r:
+        claims.append(row["claim"])
+        docs.append(row["doc"])
+        labels.append(int(row["label"]))
+
+pairs = [[d,c] for d,c in zip(docs, claims)]
+scores = np.array(ce.predict(pairs))
+labels = np.array(labels)
+
+precision, recall, thresholds = precision_recall_curve(labels, scores)
+f1 = 2 * (precision * recall) / (precision + recall + 1e-12)
+idx = np.nanargmax(f1)
+best_thresh = thresholds[idx-1] if idx>0 and len(thresholds)>0 else 0.5
+
+roc_auc = auc(*roc_curve(labels, scores)[:2])
+pr_auc = auc(recall, precision)
+
+report = {"best_threshold": float(best_thresh), "best_f1": float(f1[idx]), "roc_auc": float(roc_auc), "pr_auc": float(pr_auc)}
+open("calibration_report.json","w").write(json.dumps(report, indent=2))
+print("Calibration complete. Report written to calibration_report.json")
+print(report)
+
