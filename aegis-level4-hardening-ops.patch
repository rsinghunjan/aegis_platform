+#!/usr/bin/env bash
+set -euo pipefail
+# Create a CA and a TLS cert for webhook, store in k8s secret and print base64 CA for ValidatingWebhookConfiguration.
+CA_KEY=ca.key.pem
+CA_CERT=ca.cert.pem
+WEB_KEY=web.key.pem
+WEB_CSR=web.csr.pem
+WEB_CERT=web.cert.pem
+NAMESPACE=${1:-default}
+SECRET_NAME=${2:-webhook-tls}
+
+openssl genrsa -out $CA_KEY 4096
+openssl req -x509 -new -nodes -key $CA_KEY -sha256 -days 3650 -out $CA_CERT -subj "/CN=aegis-ca"
+
+openssl genrsa -out $WEB_KEY 4096
+openssl req -new -key $WEB_KEY -out $WEB_CSR -subj "/CN=signature-validator.$NAMESPACE.svc"
+openssl x509 -req -in $WEB_CSR -CA $CA_CERT -CAkey $CA_KEY -CAcreateserial -out $WEB_CERT -days 365 -sha256 -extensions v3_req
+
+kubectl create secret tls $SECRET_NAME -n $NAMESPACE --key $WEB_KEY --cert $WEB_CERT --dry-run=client -o yaml | kubectl apply -f -
+CA_B64=$(cat $CA_CERT | base64 | tr -d '\n')
+echo "Use this CA bundle in ValidatingWebhookConfiguration caBundle:"
+echo "$CA_B64"
+
