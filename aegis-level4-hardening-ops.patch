+#!/usr/bin/env python3
+"""
+Evaluate retriever recall@k against labeled queries.
+Input: JSON file with [{"query": "...", "positive_doc_ids": [id1, id2,...]}]
+"""
+import json, sys
+from sentence_transformers import SentenceTransformer
+from pymilvus import connections, Collection
+import numpy as np
+
+MILVUS_HOST = "milvus.milvus"
+MILVUS_PORT = 19530
+COLLECTION_NAME = "aegis_docs"
+TOP_K = int(sys.argv[2]) if len(sys.argv)>2 else 10
+
+connections.connect(host=MILVUS_HOST, port=str(MILVUS_PORT))
+collection = Collection(COLLECTION_NAME)
+embedder = SentenceTransformer(sys.argv[1] if len(sys.argv)>1 else "all-MiniLM-L6-v2")
+
+data = json.load(open(sys.argv[3] if len(sys.argv)>3 else "queries.json"))
+
+recalls = []
+for q in data:
+    qvec = embedder.encode([q["query"]])[0].tolist()
+    res = collection.search([qvec], "embedding", limit=TOP_K, output_fields=["id"])
+    retrieved_ids = [r.id for r in res[0]]
+    pos = set(q.get("positive_doc_ids",[]))
+    hit = 1.0 if pos.intersection(set(retrieved_ids)) else 0.0
+    recalls.append(hit)
+
+print(f"Recall@{TOP_K}: {np.mean(recalls):.4f} over {len(recalls)} queries")
+
