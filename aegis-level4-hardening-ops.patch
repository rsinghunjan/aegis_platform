+#!/usr/bin/env bash
+set -euo pipefail
+MODE=${1:-audit}
+if [ "$MODE" != "audit" ] && [ "$MODE" != "enforce" ]; then
+  echo "Usage: $0 <audit|enforce>"
+  exit 2
+fi
+
+if [ "$MODE" = "audit" ]; then
+  kubectl label namespace default gatekeeper.sh/enabled=true --overwrite
+  echo "Gatekeeper set to audit mode (use policies with enforcement=false as needed)"
+else
+  # flip relevant constraints to enforce by setting enforcementAction=deny
+  kubectl get constraints --all-namespaces -o json | jq '.items[] | .metadata.name' -r | while read NAME; do
+    echo "Setting enforcementAction=deny for constraint $NAME"
+    kubectl patch constraint "$NAME" --type='merge' -p '{"spec":{"enforcementAction":"deny"}}' || true
+  done
+  echo "Gatekeeper constraints switched to enforce mode (best-effort)"
+fi
