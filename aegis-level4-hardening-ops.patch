+#!/usr/bin/env python3
+"""
+Improved automated remediation controller:
+ - integrates with Argo Rollouts to abort canaries, roll back to the previous stable revision,
+ - annotates deployments with evidence, and triggers runbook links / paging.
+ - conservative by default: requires both metric threshold and anomaly window before action.
+"""
+import os, time, logging, requests
+from kubernetes import client, config
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+CHECK_QUERY = os.environ.get("PROM_QUERY", 'increase(aegis_preflight_verifier_fail_total[5m])')
+THRESH = float(os.environ.get("ROLLBACK_THRESHOLD", "10"))
+TARGET_NAMESPACE = os.environ.get("TARGET_NAMESPACE", "default")
+ROLLBACK_WINDOW = int(os.environ.get("ROLLBACK_WINDOW", "300"))  # seconds
+SLEEP = int(os.environ.get("CHECK_INTERVAL", "30"))
+ARGO_SERVER = os.environ.get("ARGO_SERVER", "http://argo-rollouts:3100")
+LOG = logging.getLogger("aegis.autorollback")
+
+logging.basicConfig(level=logging.INFO)
+
+def query_prometheus(query):
+    try:
+        r = requests.get(f"{PROM_URL.rstrip('/')}/api/v1/query", params={"query": query}, timeout=5.0)
+        r.raise_for_status()
+        data = r.json()
+        if data.get("status") == "success" and data["data"]["result"]:
+            return float(data["data"]["result"][0]["value"][1])
+    except Exception as e:
+        LOG.warning("prometheus query failed: %s", e)
+    return 0.0
+
+def abort_and_rollback(rollout_name, namespace):
+    try:
+        # Abort canary analysis
+        abort_url = f"{ARGO_SERVER.rstrip('/')}/api/v1/rollouts/{namespace}/{rollout_name}/abort"
+        requests.post(abort_url, timeout=5.0)
+    except Exception:
+        LOG.warning("failed to call argo abort API (may not be available)")
+    # fallback to Kubernetes: scale down new ReplicaSet or set replicas of deployment to previous stable (conservative)
+    try:
+        config.load_incluster_config()
+    except:
+        config.load_kube_config()
+    apps = client.AppsV1Api()
+    # annotate deployment to indicate rollback
+    try:
+        apps.patch_namespaced_deployment(rollout_name, namespace, {"metadata": {"annotations": {"aegis.autorollback/rolled-back": str(int(time.time()))}}})
+        apps.patch_namespaced_deployment_scale(rollout_name, namespace, {"spec": {"replicas": 0}})
+        LOG.warning("Scaled deployment %s/%s to 0 as part of rollback", namespace, rollout_name)
+    except Exception as e:
+        LOG.error("rollback failed: %s", e)
+
+if __name__ == "__main__":
+    # TARGET_DEPLOYMENT can be a comma-separated list of rollout/deployment names to watch
+    targets = os.environ.get("TARGET_DEPLOYMENT", "")
+    if not targets:
+        LOG.error("TARGET_DEPLOYMENT not set; exiting")
+        exit(2)
+    target_list = [t.strip() for t in targets.split(",")]
+    window_start = {}
+    while True:
+        v = query_prometheus(CHECK_QUERY)
+        LOG.info("Prom query: %s", v)
+        now = int(time.time())
+        if v >= THRESH:
+            for t in target_list:
+                if t not in window_start:
+                    window_start[t] = now
+                if now - window_start[t] >= ROLLBACK_WINDOW:
+                    LOG.warning("Threshold exceeded for %s -> performing rollback", t)
+                    abort_and_rollback(t, TARGET_NAMESPACE)
+                    window_start.pop(t, None)
+        else:
+            # reset windows if metric below threshold
+            window_start = {}
+        time.sleep(SLEEP)
+
