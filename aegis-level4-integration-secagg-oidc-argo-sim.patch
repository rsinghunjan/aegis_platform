+#!/usr/bin/env python3
+"""
+Adversary simulation: run small number of malicious clients interleaved with honest clients
+to verify robust aggregator behavior (use robust_aggregator if available).
+"""
+import random, json, os
+from ops.fl.aggregator import robust_aggregator as agg
+
+honest = [[0.1]*128 for _ in range(10)]
+malicious = [[1000.0]*128 for _ in range(2)]
+data = honest + malicious
+med = agg.elementwise_median(data)
+kr = agg.krum(data, f=2)
+avg = agg.fedavg(data)
+print("median[0:3]", med[:3])
+print("krum[0:3]", kr[:3])
+print("avg[0:3]", avg[:3])
+
+with open("/tmp/secureagg_adversary_summary.json","w") as fh:
+    json.dump({"median_first3": med[:3], "krum_first3": kr[:3]}, fh)
+
