+#!/usr/bin/env python3
+"""
+Scale simulation for secure-aggregation: spawns N simulated clients that:
+ - generate keypairs via secagg_wrapper
+ - compute a synthetic update vector
+ - mask via wrapper (or additive mask if ALLOW_INSECURE_SECAGG)
+ - send serialized update to a local aggregator process
+
+This is intended to run in a CI builder or isolated host to exercise the protocol at scale.
+"""
+import multiprocessing as mp
+import time, json, os, random
+from ops.fl.integration import secagg_wrapper as wrapper
+
+NUM_CLIENTS = int(os.environ.get("SECAGG_SIM_CLIENTS","100"))
+WEIGHT_LEN = int(os.environ.get("SECAGG_WEIGHT_LEN","256"))
+
+def client_process(client_id, q):
+    try:
+        sk, pk = wrapper.client_keypair(f"cli{client_id}")
+    except Exception as e:
+        q.put({"client": client_id, "error": str(e)})
+        return
+    # synthetic weights
+    weights = [random.random() for _ in range(WEIGHT_LEN)]
+    payload = wrapper.client_mask(weights, sk, {f"cli{i}":"pk" for i in range(NUM_CLIENTS)})
+    # in real world upload to server; here push to multiprocessing queue
+    q.put({"client": client_id, "payload_len": len(payload)})
+
+def aggregator(q, n_clients):
+    received = 0
+    details = []
+    start = time.time()
+    while received < n_clients:
+        try:
+            msg = q.get(timeout=60)
+        except Exception:
+            break
+        details.append(msg)
+        received += 1
+    duration = time.time() - start
+    print(f"Aggregator received {received}/{n_clients} updates in {duration:.2f}s")
+    # write artifacts for crypto review
+    with open("/tmp/secagg_simulation_summary.json","w") as fh:
+        json.dump({"received": received, "duration": duration, "details_sample": details[:10]}, fh)
+
+if __name__=="__main__":
+    q = mp.Queue()
+    agg = mp.Process(target=aggregator, args=(q, NUM_CLIENTS))
+    agg.start()
+    procs = []
+    for i in range(NUM_CLIENTS):
+        p = mp.Process(target=client_process, args=(i,q))
+        p.start()
+        procs.append(p)
+        # small stagger so ephemeral keys differ in time
+        time.sleep(0.01)
+    for p in procs:
+        p.join(timeout=10)
+    agg.join(timeout=10)
+    print("Scale simulation complete. Summary written to /tmp/secagg_simulation_summary.json")
+
