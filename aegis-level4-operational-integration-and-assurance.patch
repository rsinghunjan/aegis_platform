+#!/usr/bin/env python3
+"""
+FL controller DP integration wrapper.
+
+This module provides helper functions the federated learning controller should call
+before starting a round (check_and_start_round) and after completing a round
+(report_round). It calls the DP accounting service, records evidence manifests,
+and raises exceptions to prevent rounds when budgets would be exceeded.
+
+Usage (example):
+  from services.fl.fl_controller_dp_wrapper import check_and_start_round, report_round
+  run_id = check_and_start_round(project="default", noise=1.0, sample_rate=0.01, steps=1)
+  ... run FL round ...
+  report_round(project="default", run_id=run_id, epsilon=0.5)
+
+This file is intended to be imported into your FL orchestrator main loop.
+"""
+import os
+import uuid
+import time
+import requests
+import json
+from services.privacy.rdp_accountant import compute_epsilon
+
+DP_URL = os.environ.get("DP_ACCOUNTING_URL", "http://dp-accounting:8310")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_KMS_URI = os.environ.get("COSIGN_KMS_URI", "")
+RETRY = int(os.environ.get("DP_RETRIES", "3"))
+TIMEOUT = int(os.environ.get("DP_TIMEOUT", "10"))
+
+def _upload_manifest(path):
+    # best-effort upload to S3 if configured
+    if not EVIDENCE_BUCKET:
+        return None
+    try:
+        import subprocess
+        subprocess.check_call(["aws","s3","cp", path, f"{EVIDENCE_BUCKET.rstrip('/')}/dp_evidence/"])
+        return f"s3://{EVIDENCE_BUCKET.rstrip('/')}/dp_evidence/{os.path.basename(path)}"
+    except Exception:
+        return None
+
+def check_and_start_round(project, noise, sample_rate, steps, delta=1e-5):
+    """Call DP /check_run; return run_id if allowed, otherwise raise."""
+    payload = {"project": project, "noise": float(noise), "sample_rate": float(sample_rate), "steps": int(steps), "delta": float(delta)}
+    last_err = None
+    for attempt in range(RETRY):
+        try:
+            r = requests.post(f"{DP_URL}/check_run", json=payload, timeout=TIMEOUT)
+            r.raise_for_status()
+            j = r.json()
+            if not j.get("allowed", False):
+                raise RuntimeError("DP budget exceeded or check rejected: " + json.dumps(j))
+            run_id = str(uuid.uuid4())
+            # Create an evidence manifest for the attempted run
+            manifest = {
+                "type": "dp_check",
+                "project": project,
+                "noise": noise,
+                "sample_rate": sample_rate,
+                "steps": steps,
+                "delta": delta,
+                "ts": int(time.time()),
+                "dp_response": j,
+                "run_id": run_id
+            }
+            out = f"/tmp/dp_check_{run_id}.json"
+            with open(out, "w") as fh:
+                json.dump(manifest, fh, indent=2)
+            _upload_manifest(out)
+            return run_id
+        except Exception as e:
+            last_err = e
+            time.sleep(1)
+    raise RuntimeError("DP check failed after retries: " + str(last_err))
+
+def report_round(project, run_id, epsilon):
+    """Report completed round to DP accounting service and record evidence."""
+    payload = {"project": project, "run_id": run_id, "epsilon": float(epsilon)}
+    try:
+        r = requests.post(f"{DP_URL}/report_round", json=payload, timeout=TIMEOUT)
+        r.raise_for_status()
+        j = r.json()
+    except Exception as e:
+        raise RuntimeError("Failed to report round: " + str(e))
+    manifest = {
+        "type": "dp_report",
+        "project": project,
+        "run_id": run_id,
+        "epsilon": epsilon,
+        "ts": int(time.time()),
+        "dp_response": j
+    }
+    out = f"/tmp/dp_report_{run_id}.json"
+    with open(out, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    _upload_manifest(out)
+    return j
