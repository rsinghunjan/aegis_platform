+#!/usr/bin/env python3
+"""
+Simple gRPC client to submit shares to the coordinator and request aggregation.
+This is a reference for clients/parties to interact with the coordinator.
+"""
+import os
+import sys
+import grpc
+from time import sleep
+
+# generate pb2 if needed (coordinator handles generation when run)
+from ops.secure_agg.production_mpc import secureagg_pb2, secureagg_pb2_grpc  # type: ignore
+
+def get_channel(target="localhost:50051", cert_dir="/etc/mpc-certs"):
+    server_cert = os.path.join(cert_dir, "server.crt")
+    ca_crt = os.path.join(cert_dir, "ca.crt")
+    client_key = os.path.join(cert_dir, "client.key")
+    client_crt = os.path.join(cert_dir, "client.crt")
+    if os.path.exists(client_key) and os.path.exists(client_crt) and os.path.exists(ca_crt):
+        with open(ca_crt, 'rb') as f:
+            trusted_certs = f.read()
+        with open(client_key, 'rb') as f:
+            key = f.read()
+        with open(client_crt, 'rb') as f:
+            cert = f.read()
+        creds = grpc.ssl_channel_credentials(root_certificates=trusted_certs, private_key=key, certificate_chain=cert)
+        return grpc.secure_channel(target, creds)
+    else:
+        return grpc.insecure_channel(target)
+
+def submit_sample_shares(target="localhost:50051"):
+    ch = get_channel(target)
+    stub = secureagg_pb2_grpc.SecureAggregatorStub(ch)
+    # demo: submit 3 shares for single vector/chunk
+    for cid, s in [("client1", b"\x01\x02\x03"), ("client2", b"\x00\xff\x00"), ("client3", b"\x01\x01\x01")]:
+        share = secureagg_pb2.Share(client_id=cid, share=s, vector_id="vec1", chunk_id=0, chunk_count=1)
+        r = stub.SubmitShare(share)
+        print("submit:", r.accepted, r.message)
+    a = secureagg_pb2.AggregateRequest(vector_id="vec1")
