+#!/usr/bin/env python3
+"""
+Flagger post-rollout webhook handler.
+
+This service listens for Flagger post-rollout webhook callbacks and:
+ - generates a signed evidence manifest describing the canary promotion outcome,
+ - signs the manifest with cosign (KMS) if configured,
+ - uploads manifest and signature to EVIDENCE_BUCKET (S3),
+ - registers the manifest in Rekor (optional).
+
+Environment:
+ FLAGGER_WEBHOOK_SECRET: optional secret to validate incoming request header "X-Flagger-Token"
+ EVIDENCE_BUCKET, COSIGN_KMS_URI, REKOR_SERVER
+
+Deploy via Helm or as a small Deployment in the aegis namespace and configure Flagger's canary postRollout webhook to call it.
+"""
+import os
+import json
+import time
+import subprocess
+from flask import Flask, request, jsonify, abort
+
+app = Flask(__name__)
+FLAGGER_WEBHOOK_SECRET = os.environ.get("FLAGGER_WEBHOOK_SECRET", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_KMS_URI = os.environ.get("COSIGN_KMS_URI", "")
+REKOR_SERVER = os.environ.get("REKOR_SERVER", "")
+
+def sign_manifest(path):
+    sig = None
+    if COSIGN_KMS_URI:
+        try:
+            subprocess.check_call(["cosign","sign-blob","--key",COSIGN_KMS_URI, path])
+            sig = path + ".sig"
+        except subprocess.CalledProcessError:
+            pass
+    return sig
+
+def upload_and_rekor(path):
+    s3uri = None
+    if EVIDENCE_BUCKET:
+        subprocess.check_call(["aws","s3","cp", path, f"{EVIDENCE_BUCKET.rstrip('/')}/canary_evidence/"])
+        s3uri = f"s3://{EVIDENCE_BUCKET.rstrip('/')}/canary_evidence/{os.path.basename(path)}"
+    if REKOR_SERVER:
+        try:
+            subprocess.check_call(["rekor-cli","upload","--artifact", path, "--rekor_server", REKOR_SERVER])
+        except Exception:
+            pass
+    return s3uri
+
+@app.route("/postroll", methods=["POST"])
+def postroll():
+    # Optional secret verification
+    if FLAGGER_WEBHOOK_SECRET:
+        token = request.headers.get("X-Flagger-Token","")
+        if token != FLAGGER_WEBHOOK_SECRET:
+            abort(401)
+    payload = request.get_json() or {}
+    ts = int(time.time())
+    manifest = {
+        "type": "canary_promotion",
+        "payload": payload,
+        "ts": ts
+    }
+    out = f"/tmp/canary_manifest_{ts}.json"
+    with open(out, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    sig = sign_manifest(out)
+    s3uri = upload_and_rekor(out)
+    return jsonify({"ok": True, "manifest": out, "sig": sig, "s3": s3uri})
+
+@app.route("/healthz")
+def health():
+    return jsonify({"ok": True})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8401")))
+
