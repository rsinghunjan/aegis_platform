+#!/usr/bin/env python3
+"""
+Guarded KMS alias rotation flow.
+
+This script performs a KMS key rotation dry-run, creates a manifest, signs it, uploads evidence,
+and then creates an M-of-N approval request. Only when the M-of-N approval is satisfied will the
+alias swap be executed. This prevents accidental alias swaps and ensures gatekeeping by approvers.
+
+Environment:
+ - EVIDENCE_BUCKET, COSIGN_KMS_URI, MOFN_URL (e.g., http://mofn.aegis.svc:8320)
+
+Usage:
+  python3 ops/hsm/rotate_kms_alias_and_sign_guarded.py --alias alias/aegis/cosign --apply
+
+The --apply flag will perform the alias swap once M-of-N approval is observed.
+Without --apply the script performs a dry-run and creates an M-of-N request to approve.
+"""
+import os
+import json
+import time
+import argparse
+import subprocess
+import requests
+import uuid
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_KMS_URI = os.environ.get("COSIGN_KMS_URI", "")
+MOFN_URL = os.environ.get("MOFN_URL", "")
+REKOR_SERVER = os.environ.get("REKOR_SERVER", "")
+
+def create_key():
+    out = subprocess.check_output(["aws","kms","create-key","--description","Aegis rotation candidate"])
+    j = json.loads(out)
+    kid = j["KeyMetadata"]["KeyId"]
+    return kid, j
+
+def build_manifest(new_key_id, alias, dry=True):
+    manifest = {
+        "ts": int(time.time()),
+        "new_key_id": new_key_id,
+        "alias": alias,
+        "dry_run": bool(dry),
+        "note": "guarded rotation - create manifest"
+    }
+    path = f"/tmp/kms_rotation_{new_key_id}.json"
+    with open(path, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return path
+
+def sign_and_upload(path):
+    sig = None
+    if COSIGN_KMS_URI:
+        subprocess.check_call(["cosign","sign-blob","--key", COSIGN_KMS_URI, path])
+        sig = path + ".sig"
+    if EVIDENCE_BUCKET:
+        subprocess.check_call(["aws","s3","cp", path, f"{EVIDENCE_BUCKET.rstrip('/')}/kms-rotation/"])
+    if REKOR_SERVER:
+        try:
+            subprocess.check_call(["rekor-cli","upload","--artifact", path, "--rekor_server", REKOR_SERVER])
+        except Exception:
+            pass
+    return sig
+
+def create_mofn_request(manifest_path, m=2):
+    if not MOFN_URL:
+        raise RuntimeError("MOFN_URL not configured")
+    req = {"request_id": str(uuid.uuid4()), "action_id": "kms_alias_rotate", "payload": manifest_path, "m": m}
+    r = requests.post(f"{MOFN_URL}/request_action", json=req, timeout=10)
+    r.raise_for_status()
+    return req["request_id"]
+
+def poll_mofn(request_id, timeout=60*60):
+    start = time.time()
+    while time.time() - start < timeout:
+        r = requests.get(f"{MOFN_URL}/status", params={"request_id": request_id}, timeout=10)
+        if r.status_code == 200:
+            j = r.json()
+            if j.get("approved"):
+                return True
+        time.sleep(5)
+    return False
+
+def swap_alias(alias, new_key_id):
+    # Perform the alias update: set-alias to new key
+    subprocess.check_call(["aws","kms","create-alias","--alias-name", alias, "--target-key-id", new_key_id])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--alias", required=True)
+    p.add_argument("--apply", action="store_true")
+    p.add_argument("--approvals", type=int, default=2)
+    args = p.parse_args()
+
+    new_key_id, key_meta = create_key()
+    manifest_path = build_manifest(new_key_id, args.alias, dry=not args.apply)
+    sig = sign_and_upload(manifest_path)
+    print("Created manifest:", manifest_path, "sig:", sig)
+    request_id = create_mofn_request(manifest_path, m=args.approvals)
+    print("Created M-of-N request:", request_id)
+    if args.apply:
+        print("Waiting for M-of-N approval...")
+        ok = poll_mofn(request_id, timeout=60*60)
+        if not ok:
+            print("Approval not received within timeout; aborting alias swap")
+            return
+        print("Approval received; performing alias swap")
+        swap_alias(args.alias, new_key_id)
+        final_manifest_path = build_manifest(new_key_id, args.alias, dry=False)
+        sign_and_upload(final_manifest_path)
+        print("Alias swap completed and final manifest signed & uploaded")
+    else:
+        print("Dry-run completed; use --apply to wait for approvals and perform alias swap")
+
+if __name__=="__main__":
+    main()
+
