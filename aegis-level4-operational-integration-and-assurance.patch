+#!/usr/bin/env python3
+"""
+gRPC coordinator for secure aggregation (reference implementation).
+
+This basic coordinator receives shares (as opaque bytes) and performs a naive
+aggregation when all expected shares are present. It demonstrates:
+ - mTLS-capable gRPC server (instructions to provide certs)
+ - streaming/chunking support via chunk_id / chunk_count in the proto
+ - simple validation and evidence logging
+
+This is a reference; a production implementation must run with hardened crypto,
+threshold secret sharing, and audited protocols.
+"""
+import os
+import time
+import logging
+from concurrent import futures
+import grpc
+from pathlib import Path
+import json
+
+# Generate gRPC code at startup if needed
+def _ensure_generated():
+    try:
+        import secureagg_pb2, secureagg_pb2_grpc  # type: ignore
+    except Exception:
+        from grpc_tools import protoc
+        proto_path = os.path.join(os.path.dirname(__file__), "secureagg.proto")
+        protoc.main((
+            "",
+            f"-I{os.path.dirname(__file__)}",
+            f"--python_out={os.path.dirname(__file__)}",
+            f"--grpc_python_out={os.path.dirname(__file__)}",
+            proto_path,
+        ))
+
+_ensure_generated()
+import secureagg_pb2, secureagg_pb2_grpc  # type: ignore
+
+EVIDENCE_DIR = os.environ.get("MPC_EVIDENCE_DIR", "/tmp/mpc_evidence")
+Path(EVIDENCE_DIR).mkdir(parents=True, exist_ok=True)
+EXPECTED_PARTIES = int(os.environ.get("MPC_EXPECTED_PARTIES", "3"))
+
+class Coordinator(secureagg_pb2_grpc.SecureAggregatorServicer):
+    def __init__(self):
+        self._store = {}  # vector_id -> { chunk_id -> list of (client_id, share_bytes) }
+
+    def SubmitShare(self, request, context):
+        vid = request.vector_id
+        chunk = request.chunk_id
+        cnt = request.chunk_count
+        self._store.setdefault(vid, {})
+        self._store[vid].setdefault(chunk, [])
+        # Basic sanity checks
+        if not request.client_id or not request.share:
+            return secureagg_pb2.ShareResponse(accepted=False, message="invalid share")
+        # Append share
+        self._store[vid][chunk].append((request.client_id, request.share))
+        # Log evidence
+        manifest = {
+            "type": "mpc_share_received",
+            "vector_id": vid,
+            "chunk_id": chunk,
+            "client_id": request.client_id,
+            "timestamp": int(time.time()),
+        }
+        out = os.path.join(EVIDENCE_DIR, f"share_{vid}_{chunk}_{int(time.time())}.json")
+        with open(out, "w") as fh:
+            json.dump(manifest, fh)
+        return secureagg_pb2.ShareResponse(accepted=True, message="ok")
+
+    def Aggregate(self, request, context):
+        vid = request.vector_id
+        if vid not in self._store:
+            return secureagg_pb2.AggregateResponse(ready=False, message="no shares")
+        # Check for completeness across chunks
+        aggregated = bytearray()
+        for chunk_id, shares in sorted(self._store[vid].items()):
+            if len(shares) < EXPECTED_PARTIES:
+                return secureagg_pb2.AggregateResponse(ready=False, message=f"chunk {chunk_id} incomplete")
+            # Naive aggregation: xor across shares (placeholder)
+            acc = bytearray(shares[0][1])
+            for _, s in shares[1:]:
+                for i, b in enumerate(s):
+                    acc[i] = acc[i] ^ b
+            aggregated.extend(acc)
+        # Record aggregate evidence
+        out = os.path.join(EVIDENCE_DIR, f"aggregate_{vid}_{int(time.time())}.bin")
+        with open(out, "wb") as fh:
+            fh.write(bytes(aggregated))
+        return secureagg_pb2.AggregateResponse(ready=True, aggregate=bytes(aggregated), message="aggregated")
+
+def serve():
+    server = grpc.server(futures.ThreadPoolExecutor(max_workers=10))
+    secureagg_pb2_grpc.add_SecureAggregatorServicer_to_server(Coordinator(), server)
+    # mTLS configuration (optional)
+    cert_dir = os.environ.get("MPC_CERT_DIR", "/etc/mpc-certs")
+    server_key = os.path.join(cert_dir, "server.key")
+    server_crt = os.path.join(cert_dir, "server.crt")
+    ca_crt = os.path.join(cert_dir, "ca.crt")
+    if os.path.exists(server_key) and os.path.exists(server_crt) and os.path.exists(ca_crt):
+        with open(server_key, 'rb') as f:
+            private_key = f.read()
+        with open(server_crt, 'rb') as f:
+            certificate_chain = f.read()
+        with open(ca_crt, 'rb') as f:
+            root_certificates = f.read()
+        server_credentials = grpc.ssl_server_credentials([(private_key, certificate_chain)], root_certificates, require_client_auth=True)
+        server.add_secure_port('[::]:50051', server_credentials)
+        print("gRPC server starting with mTLS on 0.0.0.0:50051")
+    else:
+        server.add_insecure_port('[::]:50051')
+        print("gRPC server starting insecure on 0.0.0.0:50051 (use mTLS in production)")
+    server.start()
+    try:
+        while True:
+            time.sleep(3600)
+    except KeyboardInterrupt:
+        server.stop(0)
+
+if __name__=="__main__":
+    logging.basicConfig(level=logging.INFO)
+    serve()
