+/*
+Provision KMS key, Rekor server on ECS (or EC2) and IAM roles/policies for CI runners.
+This is a production-oriented scaffold: customize networking (VPC/subnet IDs), AMIs, and security groups for your org.
+*/
+terraform {
+  required_providers {
+    aws = {
+      source  = "hashicorp/aws"
+      version = "~> 5.0"
+    }
+  }
+}
+
+provider "aws" {
+  region = var.aws_region
+}
+
+variable "aws_region" { default = "us-west-2" }
+variable "rekor_image" { default = "gcr.io/rekor-project/rekor-server:latest" }
+variable "rekor_instance_type" { default = "t3.medium" }
+variable "rekor_subnet_id" { type = string }
+variable "rekor_security_group_ids" { type = list(string) }
+
+resource "aws_kms_key" "cosign_key" {
+  description             = "Aegis cosign KMS key for signing artifacts"
+  deletion_window_in_days = 30
+  enable_key_rotation     = true
+}
+
+resource "aws_kms_alias" "cosign_alias" {
+  name          = "alias/aegis-cosign"
+  target_key_id = aws_kms_key.cosign_key.key_id
+}
+
+# Create an IAM role for CI runners to allow KMS Sign usage and S3/Secrets access
+resource "aws_iam_role" "ci_runner_role" {
+  name = "aegis-ci-runner-role"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect = "Allow"
+      Principal = { Service = "ec2.amazonaws.com" }
+      Action = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_policy" "ci_runner_policy" {
+  name = "aegis-ci-runner-policy"
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect = "Allow"
+        Action = [
+          "kms:Sign",
+          "kms:GetPublicKey",
+          "kms:DescribeKey"
+        ]
+        Resource = aws_kms_key.cosign_key.arn
+      },
+      {
+        Effect = "Allow"
+        Action = [
+          "s3:GetObject",
+          "s3:PutObject"
+        ]
+        Resource = "*"
+      }
+    ]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "ci_attach" {
+  role       = aws_iam_role.ci_runner_role.name
+  policy_arn = aws_iam_policy.ci_runner_policy.arn
+}
+
+resource "aws_security_group" "rekor_sg" {
+  name        = "aegis-rekor-sg"
+  description = "Rekor server SG"
+  vpc_id      = data.aws_vpc.default.id
+  ingress {
+    from_port   = 80
+    to_port     = 80
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  ingress {
+    from_port   = 443
+    to_port     = 443
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+data "aws_ami" "ubuntu" {
+  most_recent = true
+  owners      = ["099720109477"] # Canonical
+  filter {
+    name   = "name"
+    values = ["ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*"]
+  }
+}
+
+resource "aws_instance" "rekor_instance" {
+  ami                    = data.aws_ami.ubuntu.id
+  instance_type          = var.rekor_instance_type
+  subnet_id              = var.rekor_subnet_id
+  vpc_security_group_ids = coalesce(var.rekor_security_group_ids, [aws_security_group.rekor_sg.id])
+  tags = {
+    Name = "aegis-rekor"
+  }
+  user_data = <<-EOF
+    #!/bin/bash
+    set -e
+    apt-get update
+    apt-get install -y docker.io
+    systemctl start docker
+    docker run -d --restart unless-stopped -p 80:3000 ${rekor_image}
+  EOF
+}
+
+data "aws_vpc" "default" {
+  default = true
+}
+
+output "cosign_kms_arn" {
+  value = aws_kms_key.cosign_key.arn
+}
+output "rekor_server_url" {
+  value = "http://${aws_instance.rekor_instance.public_ip}"
+}
+output "ci_runner_role_arn" {
+  value = aws_iam_role.ci_runner_role.arn
+}
+
