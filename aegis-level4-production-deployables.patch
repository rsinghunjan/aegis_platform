- hosts: jailed-executors
+ become: yes
+ vars:
+   jailexec_namespace: aegis-system
+ tasks:
+ - name: Check runtimeClass on pods
+   shell: kubectl get deploy -n {{ jailexec_namespace }} jailed-executor -o jsonpath='{.spec.template.spec.runtimeClassName}'
+   register: runtimeclass
+ - name: Fail if runtimeClass missing or not gvisor/runsc
+   fail:
+     msg: "jailed-executor not using gVisor/runsc: {{ runtimeclass.stdout }}"
+   when: "'gvisor' not in runtimeclass.stdout and 'runsc' not in runtimeclass.stdout"
+ - name: Test write to host (should fail)
+   shell: kubectl exec -n {{ jailexec_namespace }} deploy/jailed-executor -- sh -c "touch /host_escaped_test 2>/dev/null || echo OK"
+   register: write_test
+ - debug: var=write_test.stdout
+ - name: Check network egress to approver service
+   shell: kubectl exec -n {{ jailexec_namespace }} deploy/jailed-executor -- sh -c "curl -sS -m 5 http://approver.aegis-system.svc.cluster.local:8081/ || echo unreachable"
+   register: net_test
+ - debug: var=net_test.stdout
+ - name: Run non-intrusive container escape check
+   shell: kubectl exec -n {{ jailexec_namespace }} deploy/jailed-executor -- sh -c "grep -i allowprivilege /proc/1/cgroup || true"
+   register: cap_test
+ - debug: var=cap_test.stdout
+ - name: Ensure files in /tmp/run are removed after execution
+   shell: |
+     kubectl exec -n {{ jailexec_namespace }} deploy/jailed-executor -- sh -c "test -d /tmp/run && echo exists || echo missing"
+   register: tmp_run
+ - debug: var=tmp_run.stdout
