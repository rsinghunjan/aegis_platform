+name: Continuous Canary Runner
+on:
+  workflow_dispatch:
+jobs:
+  run-canary:
+    runs-on: ubuntu-latest
+    steps:
+    - uses: actions/checkout@v4
+    - name: Trigger Argo Canary
+      env:
+        ARGO_SERVER: ${{ secrets.ARGO_SERVER }}
+      run: |
+        # Submit and wait; this action relies on `argo` cli configured with token in secrets
+        argo submit --auth-token $ARGO_TOKEN --watch k8s/argo/continuous_canary_workflow.yaml -n aegis-ml
+    - name: Poll analysis and enforce Rekor
+      run: |
+        # After workflow completes, analyze artifacts for signed evidence via rekor_enforce
+        python3 ops/security/rekor_enforce.py --artifact artifacts/bundle.json --rekor "${REKOR_SERVER:-https://rekor.example.com}" || (echo "Rekor missing, failing" && exit 1)
