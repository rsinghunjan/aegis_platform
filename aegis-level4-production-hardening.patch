+REGION = os.environ.get("AWS_REGION","us-east-1")
+
+connections.connect(host=MILVUS_HOST, port=str(MILVUS_PORT))
+for coll in utility.list_collections():
+    # simplistic: export collection meta and call it a "backup"
+    meta = utility.get_collection_info(coll)
+    key = f"milvus_backups/{coll}/{meta['created_timestamp']}.json"
+    s3 = boto3.client("s3", region_name=REGION)
+    s3.put_object(Bucket=S3_BUCKET, Key=key, Body=json.dumps(meta).encode("utf-8"))
+    print("stored", key)
