+#!/usr/bin/env python3
+"""
+Calibration helper for cross-encoder verifier.
+Usage: calculate_thresholds.py <model> <labeled_csv> <output_report.json>
+CSV columns: claim, doc, label (1/0)
+Outputs: JSON report with selected threshold for target operating points.
+"""
+import sys, csv, json
+from sentence_transformers import CrossEncoder
+from sklearn.metrics import precision_recall_curve, roc_auc_score
+import numpy as np
+
+MODEL = sys.argv[1]
+CSV = sys.argv[2]
+OUT = sys.argv[3]
+TARGET_PREC = float(sys.argv[4]) if len(sys.argv) > 4 else 0.9
+
+ce = CrossEncoder(MODEL)
+pairs = []
+labels = []
+with open(CSV) as f:
+    r = csv.DictReader(f)
+    for row in r:
+        pairs.append([row["doc"], row["claim"]])
+        labels.append(int(row["label"]))
+
+scores = ce.predict(pairs)
+precision, recall, thresholds = precision_recall_curve(labels, scores)
+# pick threshold achieving TARGET_PREC with max recall
+best_idx = None
+for i, p in enumerate(precision):
+    if p >= TARGET_PREC:
+        best_idx = i
+        break
+
+if best_idx is None:
+    # no threshold meets target precision; select highest precision
+    best_threshold = float(thresholds[0]) if len(thresholds) else 0.5
+else:
+    # thresholds array is one shorter than precision/recall arrays
+    best_threshold = float(thresholds[max(0, best_idx-1)])
+
+roc = roc_auc_score(labels, scores) if len(set(labels)) > 1 else 0.0
+report = {"model": MODEL, "roc_auc": roc, "best_threshold": best_threshold, "precision_target": TARGET_PREC}
+open(OUT,"w").write(json.dumps(report, indent=2))
+print("Wrote", OUT)
+
