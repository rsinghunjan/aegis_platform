+#!/usr/bin/env python3
+"""
+Validating admission webhook that enforces executor images are cosign-signed.
+ - Expects images in pod/deployment spec (containers[].image)
+ - Uses cosign (installed in container) to verify image signature (keyless) or via configured public key.
+ - Returns deny if image is not signed.
+CAUTION: Running cosign verify for every admission may add latency; consider local cache & Rekor integration.
+"""
+import os, subprocess, json, logging
+from fastapi import FastAPI, Request
+
+LOG = logging.getLogger("aegis.image-webhook")
+app = FastAPI()
+
+COSIGN_KEY = os.environ.get("COSIGN_PUB_KEY", "")
+REQUIRE_SIGNED = os.environ.get("REQUIRE_SIGNED_IMAGES", "true").lower() == "true"
+
+def image_signed(image: str) -> bool:
+    # Use cosign verify; prefer keyless verification (fulcio/rekor) or --key <pubkey>
+    cmd = ["cosign", "verify", image]
+    if COSIGN_KEY:
+        cmd = ["cosign", "verify", "--key", COSIGN_KEY, image]
+    try:
+        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, timeout=15)
+        LOG.debug("cosign verify output: %s", out.decode())
+        return True
+    except subprocess.CalledProcessError as e:
+        LOG.warning("cosign verify failed for %s: %s", image, e.output.decode() if e.output else e)
+        return False
+    except Exception as e:
+        LOG.error("error running cosign: %s", e)
+        return False
+
+@app.post("/validate")
+async def validate(req: Request):
+    body = await req.json()
+    request = body.get("request", {})
+    obj = request.get("object", {})
+    # search for container images
+    images = []
+    spec = obj.get("spec", {})
+    if "containers" in spec:
+        for c in spec.get("containers", []):
+            images.append(c.get("image"))
+    if "template" in spec and "spec" in spec["template"]:
+        for c in spec["template"]["spec"].get("containers", []):
+            images.append(c.get("image"))
+
+    reason = ""
+    allowed = True
+    if REQUIRE_SIGNED:
+        for im in images:
+            if not im:
+                continue
+            if not image_signed(im):
+                allowed = False
+                reason = f"image {im} is not signed/verified"
+                break
+
+    resp = {
+        "apiVersion": "admission.k8s.io/v1",
+        "kind": "AdmissionReview",
+        "response": {
+            "uid": request.get("uid"),
+            "allowed": allowed,
+            "status": {"message": reason} if not allowed else {}
+        }
+    }
+    return resp
+
