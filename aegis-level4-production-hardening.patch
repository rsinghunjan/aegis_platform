+#!/usr/bin/env python3
+"""
+Runs scheduled redaction verification:
+ - pulls sample artifacts from dataset
+ - sends to Presidio analyzer/anonymizer and asserts no PII remains in redacted output
+ - writes audit results to MCP and raises alerts if failure rate exceeds threshold
+"""
+import os, requests, json
+
+PRESIDIO_ANALYZER = os.environ.get("PRESIDIO_ANALYZER", "http://presidio-analyzer:3000")
+SAMPLE_LIST = os.environ.get("SAMPLES_FILE", "samples/pii_samples.txt")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def scan_and_check(text):
+    r = requests.post(f"{PRESIDIO_ANALYZER.rstrip('/')}/analyze", json={"text": text}, timeout=5.0)
+    if not r.ok:
+        return False, "analyzer_error"
+    entities = r.json().get("entities", [])
+    # apply anonymizer to redact
+    r2 = requests.post(f"{PRESIDIO_ANALYZER.rstrip('/')}/anonymize", json={"text": text, "entities": entities}, timeout=5.0)
+    if not r2.ok:
+        return False, "anonymizer_error"
+    redacted = r2.json().get("text", "")
+    # verify redacted contains none of the original PII tokens (simple heuristic)
+    for tok in text.split():
+        if tok in redacted:
+            return False, "redaction_failed"
+    return True, ""
+
+def main():
+    lines = open(SAMPLE_LIST).read().splitlines()
+    failures = []
+    for l in lines:
+        ok, reason = scan_and_check(l)
+        if not ok:
+            failures.append({"text": l, "reason": reason})
+    result = {"checked": len(lines), "failures": failures}
+    requests.post(f"{AEGIS_MCP.rstrip('/')}/compliance/redaction_checks", json=result, timeout=5.0)
+    print(json.dumps(result, indent=2))
+
+if __name__ == "__main__":
+    main()
+
