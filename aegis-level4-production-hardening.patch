+#!/usr/bin/env python3
+"""
+Lightweight training data sanitization pipeline:
+ - scans dataset files for PII via Presidio analyzer API
+ - redacts or masks PII and writes sanitized output to a sanitized location
+ - writes a report to MCP with counts
+"""
+import os, json, requests, glob
+
+PRESIDIO_ANALYZER = os.environ.get("PRESIDIO_ANALYZER", "http://presidio-analyzer:3000")
+INPUT_DIR = os.environ.get("TRAIN_DIR", "training_data")
+OUT_DIR = os.environ.get("SANITIZED_DIR", "training_data_sanitized")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+os.makedirs(OUT_DIR, exist_ok=True)
+report = {"files": []}
+for path in glob.glob(os.path.join(INPUT_DIR, "*.txt")):
+    text = open(path).read()
+    r = requests.post(f"{PRESIDIO_ANALYZER.rstrip('/')}/analyze", json={"text": text}, timeout=10.0)
+    entities = r.json().get("entities", [])
+    r2 = requests.post(f"{PRESIDIO_ANALYZER.rstrip('/')}/anonymize", json={"text": text, "entities": entities}, timeout=10.0)
+    redacted = r2.json().get("text","")
+    out_path = os.path.join(OUT_DIR, os.path.basename(path))
+    open(out_path,"w").write(redacted)
+    report["files"].append({"file": path, "entities": len(entities)})
+
+requests.post(f"{AEGIS_MCP.rstrip('/')}/compliance/sanitization_report", json=report, timeout=5.0)
+print(json.dumps(report, indent=2))
