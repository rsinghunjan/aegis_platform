+name: Enforce signed executor images (pre-deploy check)
+on:
+  pull_request:
+  push:
+jobs:
+  check-images:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install deps
+        run: |
+          sudo apt-get update && sudo apt-get install -y yq jq curl
+          curl -sSL -o /usr/local/bin/cosign https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64
+          chmod +x /usr/local/bin/cosign
+      - name: Extract images from manifests
+        run: |
+          images=$(git ls-files '*.yaml' '*.yml' | xargs -n1 yq eval '.. | select(has("image")) | .image' -N | sort -u || true)
+          echo "$images" > images.txt
+          echo "Found images:"
+          cat images.txt
+      - name: Verify images are cosign-signed
+        run: |
+          set -euo pipefail
+          while read -r img; do
+            if [ -z "$img" ]; then continue; fi
+            echo "Verifying $img"
+            if ! cosign verify "$img"; then
+              echo "Image $img is not signed"
+              exit 1
+            fi
+          done < images.txt
+
