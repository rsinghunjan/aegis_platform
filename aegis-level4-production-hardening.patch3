*** Add File:services/admission/image_signature_webhook.py
+#!/usr/bin/env python3
+"""
+Image signature admission webhook (cosign).
+ - Verifies images are signed (keyless or with provided pubkey).
+ - Fail-open vs fail-closed controlled by FAIL_ON_ERROR env var.
+ - Uses small LRU cache to reduce cosign invocations.
+"""
+import os, subprocess, logging
+from fastapi import FastAPI, Request
+from functools import lru_cache
+
+LOG = logging.getLogger("aegis.image-webhook")
+logging.basicConfig(level=logging.INFO)
+app = FastAPI()
+
+COSIGN_KEY = os.environ.get("COSIGN_PUB_KEY", "")
+REQUIRE_SIGNED = os.environ.get("REQUIRE_SIGNED_IMAGES", "true").lower() == "true"
+FAIL_ON_ERROR = os.environ.get("FAIL_ON_ERROR", "false").lower() == "true"
+
+@lru_cache(maxsize=1024)
+def cosign_verify(image: str):
+    cmd = ["cosign", "verify"]
+    if COSIGN_KEY:
+        cmd += ["--key", "/tmp/cosign.pub"]
+    cmd.append(image)
+    try:
+        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, timeout=20)
+        return True, out.decode()
+    except subprocess.CalledProcessError as e:
+        return False, e.output.decode() if e.output else str(e)
+    except Exception as e:
+        return False, str(e)
+
+@app.get("/health")
+def health():
+    return {"ok": True}
+
+@app.post("/validate")
+async def validate(req: Request):
+    body = await req.json()
+    request = body.get("request", {})
+    obj = request.get("object", {}) or request.get("oldObject", {})
+    images = []
+    spec = obj.get("spec", {})
+    # containers in spec
+    for c in spec.get("containers", []) + spec.get("initContainers", []):
+        if c.get("image"):
+            images.append(c["image"])
+    # template nested (Deployment/StatefulSet)
+    t = spec.get("template", {}).get("spec", {})
+    for c in t.get("containers", []) + t.get("initContainers", []):
+        if c.get("image"):
+            images.append(c["image"])
+
+    allowed = True
+    reason = ""
+    if REQUIRE_SIGNED:
+        for im in images:
+            ok, out = cosign_verify(im)
+            if not ok:
+                # cosign failure handling
+                if "timed out" in out.lower() or "error" in out.lower():
+                    if FAIL_ON_ERROR:
+                        allowed = False
+                        reason = f"cosign error verifying {im}: {out.strip()}"
+                        break
+                    else:
+                        LOG.warning("cosign transient error for %s: %s (allowing because fail-open)", im, out.strip())
+                        continue
+                else:
+                    allowed = False
+                    reason = f"image {im} failed signature verification"
+                    break
+
+    resp = {
+        "apiVersion": "admission.k8s.io/v1",
+        "kind": "AdmissionReview",
+        "response": {
+            "uid": request.get("uid"),
+            "allowed": allowed,
+            "status": {"message": reason} if not allowed else {}
+        }
+    }
+    return resp
+
