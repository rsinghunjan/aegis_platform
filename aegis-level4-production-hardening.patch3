+# AppArmor profile for sandboxed executor (name: aegis-sandbox)
+profile aegis-sandbox flags=(attach_disconnected,mediate_deleted) {
+  deny /etc/shadow r,
+  deny /etc/gshadow r,
+  deny /var/run/docker.sock rw,
+  deny /proc/sysrq-trigger rw,
+  deny /sys/firmware/** mrwklx,
+  /etc/ssl/** r,
+  /usr/bin/** mr,
+  /bin/** mr,
+  /lib/** mr,
+  /lib64/** mr,
+  /tmp/** rw,
+}
+
+# Load on nodes: sudo apparmor_parser -r /etc/apparmor.d/aegis-sandbox
