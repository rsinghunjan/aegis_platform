*** Add File:services/rag/eval_retriever.py
+#!/usr/bin/env python3
+"""
+Retriever evaluation (recall@k).
+Usage: eval_retriever.py <embed-model> <queries.json> [top_k]
+queries.json: [{"query": "...", "positive_doc_ids": [id1,...]}, ...]
+"""
+import sys, json
+from sentence_transformers import SentenceTransformer
+from pymilvus import connections, Collection
+import numpy as np
+
+EMB = sys.argv[1]
+QFILE = sys.argv[2]
+TOP_K = int(sys.argv[3]) if len(sys.argv)>3 else 10
+
+connections.connect(host="milvus.milvus", port="19530")
+collection = Collection("aegis_docs")
+embedder = SentenceTransformer(EMB)
+
+data = json.load(open(QFILE))
+recalls=[]
+for q in data:
+    qvec = embedder.encode([q["query"]])[0].tolist()
+    res = collection.search([qvec],"embedding", limit=TOP_K, output_fields=["id"])
+    retrieved = [r.id for r in res[0]]
+    pos=set(q.get("positive_doc_ids",[]))
+    recalls.append(1.0 if pos.intersection(set(retrieved)) else 0.0)
+print(f"Recall@{TOP_K}: {np.mean(recalls):.4f} over {len(recalls)} queries")
+
