+#!/usr/bin/env bash
+set -euo pipefail
+NS=${1:-kube-system}
+SECRET=${2:-webhook-tls}
+WCONFIG=${3:-image-signature-webhook-config}
+
+echo "Generating new CA and server cert..."
+openssl genrsa -out ca.key 4096
+openssl req -x509 -new -nodes -key ca.key -sha256 -days 3650 -out ca.crt -subj "/CN=aegis-webhook-ca"
+openssl genrsa -out server.key 4096
+openssl req -new -key server.key -out server.csr -subj "/CN=image-signature-webhook.$NS.svc"
+openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -days 365 -sha256
+
+kubectl create secret tls $SECRET -n $NS --key=server.key --cert=server.crt --dry-run=client -o yaml | kubectl apply -f -
+CA_B64=$(base64 -w0 ca.crt)
+echo "Patching ValidatingWebhookConfiguration $WCONFIG with new CA bundle..."
+kubectl patch validatingwebhookconfiguration $WCONFIG --type='json' -p="[{'op':'replace','path':'/webhooks/0/clientConfig/caBundle','value':'$CA_B64'}]" || true
+echo "Rotation complete."
+
