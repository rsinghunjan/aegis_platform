+#!/usr/bin/env python3
+"""
+Scheduled redaction verification: runs Presidio analyzer/anonymizer against sample corpus,
+reports failures to MCP and triggers alert if failure rate exceeds threshold.
+"""
+import os, requests, json
+
+PRESIDIO_API = os.environ.get("PRESIDIO_API", "http://presidio-analyzer:3000")
+SAMPLES_FILE = os.environ.get("SAMPLES_FILE", "tests/adversarial/corpora/pii_samples.txt")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+FAIL_THRESHOLD = float(os.environ.get("REDACTION_FAIL_THRESHOLD", "0.1"))
+
+def check_one(text):
+    r = requests.post(f"{PRESIDIO_API.rstrip('/')}/analyze", json={"text": text}, timeout=5.0)
+    if not r.ok:
+        return False, "analyzer_error"
+    entities = r.json().get("entities", [])
+    r2 = requests.post(f"{PRESIDIO_API.rstrip('/')}/anonymize", json={"text": text, "entities": entities}, timeout=10.0)
+    if not r2.ok:
+        return False, "anonymizer_error"
+    redacted = r2.json().get("text","")
+    for tok in text.split():
+        if tok and tok in redacted:
+            return False, "redaction_failed"
+    return True, ""
+
+def main():
+    lines = open(SAMPLES_FILE).read().splitlines()
+    failures = []
+    for l in lines:
+        ok, reason = check_one(l)
+        if not ok:
+            failures.append({"text": l, "reason": reason})
+    result = {"checked": len(lines), "failures": failures}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/compliance/redaction_checks", json=result, timeout=5.0)
+    except Exception:
+        pass
+    fail_rate = len(failures)/max(1,len(lines))
+    if fail_rate > FAIL_THRESHOLD:
+        # trigger alerting integration (pagerduty/webhook) - placeholder
+        print("ALERT: redaction fail rate exceeded", fail_rate)
+    print(json.dumps(result, indent=2))
+
+if __name__ == "__main__":
+    main()
+
