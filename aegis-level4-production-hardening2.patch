+#!/usr/bin/env python3
+"""
+Image signature admission webhook.
+- Verifies container images in Pod/Deployment/StatefulSet are cosign-signed.
+- Supports 'fail-open' vs 'fail-closed' policy via FAIL_ON_ERROR (default: fail-open).
+- Uses an in-memory LRU cache to reduce repeated cosign calls.
+"""
+import os, subprocess, json, logging, time
+from fastapi import FastAPI, Request
+from functools import lru_cache
+
+LOG = logging.getLogger("aegis.image-webhook")
+logging.basicConfig(level=logging.INFO)
+app = FastAPI()
+
+COSIGN_KEY = os.environ.get("COSIGN_PUB_KEY", "")  # optional public key (PEM)
+REQUIRE_SIGNED = os.environ.get("REQUIRE_SIGNED_IMAGES", "true").lower() == "true"
+FAIL_ON_ERROR = os.environ.get("FAIL_ON_ERROR", "false").lower() == "true"  # fail-closed if true
+
+@lru_cache(maxsize=1024)
+def cosign_verify_cached(image: str) -> (bool, str):
+    cmd = ["cosign", "verify"]
+    if COSIGN_KEY:
+        cmd += ["--key", "/tmp/cosign.pub"]
+    cmd.append(image)
+    try:
+        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, timeout=20)
+        return True, out.decode()
+    except subprocess.CalledProcessError as e:
+        return False, e.output.decode() if e.output else str(e)
+    except Exception as e:
+        return False, str(e)
+
+@app.post("/validate")
+async def validate(req: Request):
+    body = await req.json()
+    request = body.get("request", {})
+    obj = request.get("object", {}) or request.get("oldObject", {})
+    images = []
+    # extract images from various possible placements
+    def extract_images(spec):
+        imgs = []
+        if not spec:
+            return imgs
+        for k in ("containers","initContainers"):
+            for c in spec.get(k, []) or []:
+                if c.get("image"):
+                    imgs.append(c.get("image"))
+        # template nested for Deployment/StatefulSet
+        t = spec.get("template", {}).get("spec", {})
+        for k in ("containers","initContainers"):
+            for c in t.get(k, []) or []:
+                if c.get("image"):
+                    imgs.append(c.get("image"))
+        return imgs
+
+    spec = obj.get("spec", {})
+    images = extract_images(spec)
+
+    allowed = True
+    reason = ""
+    if REQUIRE_SIGNED and images:
+        for im in images:
+            ok, out = cosign_verify_cached(im)
+            LOG.info("verify %s -> %s", im, ok)
+            if not ok:
+                reason = f"image {im} failed signature verification: {out.strip()}"
+                allowed = False
+                # if verification failed due to process error, treat depending on FAIL_ON_ERROR
+                if "error" in out.lower() or "timed out" in out.lower():
+                    if not FAIL_ON_ERROR:
+                        # fail-open: allow on cosign runtime error, but log
+                        LOG.warning("cosign runtime error for %s, allowing due to fail-open", im)
+                        allowed = True
+                        reason = ""
+                    else:
+                        LOG.error("cosign runtime error for %s, failing due to fail-closed", im)
+                break
+
+    resp = {
+        "apiVersion": "admission.k8s.io/v1",
+        "kind": "AdmissionReview",
+        "response": {
+            "uid": request.get("uid"),
+            "allowed": allowed,
+            "status": {"message": reason} if not allowed else {}
+        }
+    }
+    return resp
+
