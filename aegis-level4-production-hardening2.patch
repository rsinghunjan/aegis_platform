+#!/usr/bin/env python3
+"""
+Calibrate cross-encoder verifier thresholds.
+Input: CSV with columns: claim, doc, label (1 supported, 0 unsupported)
+Output: JSON calibration report with suggested threshold for desired precision.
+"""
+import csv, sys, json
+from sentence_transformers import CrossEncoder
+from sklearn.metrics import precision_recall_curve, roc_auc_score
+import numpy as np
+
+if len(sys.argv) < 4:
+    print("usage: calculate_thresholds.py <model> <csv> <output.json> [target_precision]")
+    sys.exit(2)
+
+MODEL = sys.argv[1]
+CSV = sys.argv[2]
+OUT = sys.argv[3]
+TARGET_PREC = float(sys.argv[4]) if len(sys.argv) > 4 else 0.9
+
+print("Loading model", MODEL)
+ce = CrossEncoder(MODEL)
+
+pairs = []
+labels = []
+with open(CSV) as f:
+    r = csv.DictReader(f)
+    for row in r:
+        pairs.append([row["doc"], row["claim"]])
+        labels.append(int(row["label"]))
+
+scores = ce.predict(pairs)
+precision, recall, thresholds = precision_recall_curve(labels, scores)
+best_threshold = None
+best_recall = 0.0
+for i, p in enumerate(precision[:-1]):
+    if p >= TARGET_PREC:
+        if recall[i] > best_recall:
+            best_recall = recall[i]
+            best_threshold = float(thresholds[max(0,i-1)])
+
+if best_threshold is None:
+    best_threshold = float(thresholds[0]) if len(thresholds)>0 else 0.5
+
+report = {"model": MODEL, "target_precision": TARGET_PREC, "best_threshold": best_threshold,
+          "roc_auc": float(roc_auc_score(labels, scores)) if len(set(labels))>1 else 0.0}
+open(OUT,"w").write(json.dumps(report, indent=2))
+print("Wrote", OUT)
+
