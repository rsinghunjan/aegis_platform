+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to install cosign and configure CI environment variables for GitHub Actions runner or local signers.
+#
+if [ -z "${COSIGN_KMS_ARN:-}" ]; then
+  echo "Please set COSIGN_KMS_ARN (the KMS key ARN produced by terraform)"
+  exit 2
+fi
+if [ -z "${REKOR_SERVER:-}" ]; then
+  echo "Please set REKOR_SERVER (e.g., https://rekor.example.com)"
+  exit 2
+fi
+
+echo "Installing cosign..."
+curl -sSL -o /usr/local/bin/cosign https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64
+chmod +x /usr/local/bin/cosign
+
+echo "Demonstrating sign-blob using KMS key (this will produce a signature file requiring IAM perms)"
+TMP=$(mktemp)
+echo '{"test":"aegis"}' > $TMP
+cosign sign-blob --key "kms://${COSIGN_KMS_ARN}" "$TMP" || {
+  echo "cosign sign-blob failed; ensure the running identity has kms:Sign permission on the key"
+  exit 3
+}
+echo "Signed test blob: $TMP.sig"
+echo "Set CI secrets:"
+echo "  COSIGN_KEY = kms://${COSIGN_KMS_ARN}"
+echo "  REKOR_SERVER = ${REKOR_SERVER}"
+echo
+echo "Please set these in your CI (GitHub Actions secrets) and ensure the runner has AWS IAM permissions to use KMS key."
+
