+#!/usr/bin/env python3
+"""
+Push aggregate QPU estimated-cost metrics to finance/chargeback endpoint.
+This reads from Postgres (QPU DB) and POSTs to a configured billing API.
+"""
+import os
+import time
+import psycopg2
+import requests
+import json
+
+DB_DSN = os.environ.get("QPU_POSTGRES_DSN")
+BILLING_API = os.environ.get("BILLING_API")
+POLL = int(os.environ.get("CHARGEBACK_POLL", "300"))
+
+def aggregate():
+    conn = psycopg2.connect(DB_DSN)
+    cur = conn.cursor()
+    cur.execute("SELECT team, COALESCE(SUM(est_cost),0) FROM qpu_jobs WHERE status='submitted' GROUP BY team")
+    out = []
+    for team, s in cur.fetchall():
+        out.append({"team": team, "est_cost_usd": float(s)})
+    cur.close(); conn.close()
+    return out
+
+def upload(payload):
+    if not BILLING_API:
+        print("BILLING_API not set; skipping upload")
+        return
+    resp = requests.post(BILLING_API, json=payload, timeout=10)
+    print("Billing upload status", resp.status_code, resp.text[:200])
+
+if __name__ == "__main__":
+    while True:
+        data = aggregate()
+        upload({"timestamp": int(time.time()), "items": data})
+        time.sleep(POLL)
+
