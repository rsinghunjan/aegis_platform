+#!/usr/bin/env python3
+"""
+Analyze canary events and produce summary JSON with counts of denials, errors, timestamps.
+"""
+import argparse
+import json
+import os
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--input", required=True)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+    ev = json.load(open(args.input))
+    summary = {"total": len(ev), "ok":0, "denied":0, "errors":0, "first": None, "last": None}
+    for e in ev:
+        ts = e.get("ts")
+        if summary["first"] is None or ts < summary["first"]:
+            summary["first"] = ts
+        if summary["last"] is None or ts > summary["last"]:
+            summary["last"] = ts
+        st = e.get("status")
+        if st == "ok":
+            summary["ok"] += 1
+        elif st == "denied":
+            summary["denied"] += 1
+        else:
+            summary["errors"] += 1
+    open(args.out, "w").write(json.dumps(summary, indent=2))
+    print("Analysis written to", args.out)
+
+if __name__ == "__main__":
+    main()
+
