+#!/usr/bin/env python3
+"""
+Run canary workload for a period (days) by repeatedly executing plan verifier and recording events.
+Writes results to output directory for analysis.
+"""
+import argparse
+import time
+import json
+import os
+from datetime import datetime, timedelta
+import subprocess
+
+def run_plan(plan_file, namespace):
+    cmd = ["python3","ops/policy/plan_verifier_autonomy.py","--plan-file",plan_file,"--namespace",namespace]
+    try:
+        subprocess.check_call(cmd)
+        return {"ts": time.time(), "status":"ok"}
+    except subprocess.CalledProcessError as e:
+        return {"ts": time.time(), "status":"denied", "ret": e.returncode}
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--period", default="7d", help="Duration like 7d, 24h")
+    ap.add_argument("--plan", required=True)
+    ap.add_argument("--namespace", default="sandbox-ns")
+    ap.add_argument("--out", default="/work/canary")
+    args = ap.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    # parse period
+    if args.period.endswith("d"):
+        days = int(args.period[:-1])
+        end = datetime.utcnow() + timedelta(days=days)
+    elif args.period.endswith("h"):
+        hours = int(args.period[:-1])
+        end = datetime.utcnow() + timedelta(hours=hours)
+    else:
+        end = datetime.utcnow() + timedelta(days=1)
+    events = []
+    while datetime.utcnow() < end:
+        ev = run_plan(args.plan, args.namespace)
+        events.append(ev)
+        with open(os.path.join(args.out, "events.json"), "w") as fh:
+            json.dump(events, fh, indent=2)
+        time.sleep(60)  # run every minute; tune as needed
+    print("Canary run complete. Events written to", args.out)
+
+if __name__ == "__main__":
+    main()
+
