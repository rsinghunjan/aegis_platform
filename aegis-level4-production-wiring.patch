+/*
+Terraform scaffold to provision an AWS KMS key for cosign and a minimal Rekor server EC2 instance.
+
+Notes:
+ - This is a minimal, opinionated scaffold to get KMS + Rekor running for proofs-of-concept.
+ - In production prefer managed/HA Rekor (k8s Deployment + autoscaling or managed hosted Rekor).
+ - Requires AWS provider configured (credentials + region).
+*/
+terraform {
+  required_version = ">= 1.0"
+}
+
+provider "aws" {
+  region = var.aws_region
+}
+
+variable "aws_region" {
+  default = "us-west-2"
+}
+
+variable "rekor_image" {
+  description = "Container image for Rekor server (must be accessible)"
+  default     = "gcr.io/rekor-project/rekor-server:latest"
+}
+
+resource "aws_kms_key" "cosign_key" {
+  description             = "Aegis cosign KMS key for signing artifacts"
+  deletion_window_in_days = 7
+  enable_key_rotation     = true
+}
+
+resource "aws_kms_alias" "cosign_alias" {
+  name          = "alias/aegis-cosign"
+  target_key_id = aws_kms_key.cosign_key.key_id
+}
+
+# Security group for Rekor EC2
+resource "aws_security_group" "rekor_sg" {
+  name        = "rekor-sg"
+  description = "Allow HTTP/HTTPS for Rekor"
+  vpc_id      = data.aws_vpc.default.id
+
+  ingress {
+    from_port   = 80
+    to_port     = 80
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  ingress {
+    from_port   = 443
+    to_port     = 443
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+data "aws_ami" "amazon_linux_2" {
+  most_recent = true
+  owners      = ["amazon"]
+  filter {
+    name   = "name"
+    values = ["amzn2-ami-hvm-*-x86_64-ebs"]
+  }
+}
+
+data "aws_vpc" "default" {
+  default = true
+}
+
+resource "aws_instance" "rekor" {
+  ami                         = data.aws_ami.amazon_linux_2.id
+  instance_type               = "t3.medium"
+  subnet_id                   = data.aws_subnet_ids.default.ids[0]
+  vpc_security_group_ids      = [aws_security_group.rekor_sg.id]
+  associate_public_ip_address = true
+
+  user_data = <<-EOF
+    #!/bin/bash
+    yum update -y
+    amazon-linux-extras install docker -y
+    service docker start
+    docker run -d --name rekor-server -p 80:3000 ${rekor_image}
+  EOF
+
+  tags = {
+    Name = "aegis-rekor"
+  }
+}
+
+data "aws_subnet_ids" "default" {
+  vpc_id = data.aws_vpc.default.id
+}
+
+output "kms_key_arn" {
+  value = aws_kms_key.cosign_key.arn
+}
+
+output "rekor_public_ip" {
+  value = aws_instance.rekor.public_ip
+}
+
