+#!/usr/bin/env python3
+"""
+Approver service backed by PostgreSQL (production-ready skeleton).
+ - Issues signed approval tokens (cosign KMS) for auto-approvable requests
+ - Stores approvals in Postgres for audit
+"""
+import os
+import json
+import uuid
+import subprocess
+import logging
+import psycopg2
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+LOG = logging.getLogger("aegis.approver")
+APP = FastAPI()
+
+DB_DSN = os.environ.get("APPROVER_POSTGRES_DSN", "postgresql://approver:pass@postgres.aegis.svc.cluster.local:5432/approver")
+COSIGN_KEY = os.environ.get("COSIGN_KEY")  # KMS URI
+REKOR_SERVER = os.environ.get("REKOR_SERVER", "")
+
+def get_conn():
+    return psycopg2.connect(DB_DSN)
+
+class ApprovalRequest(BaseModel):
+    namespace: str
+    action: dict
+    requester: str = "unknown"
+
+@APP.post("/auto-approve")
+def auto_approve(req: ApprovalRequest):
+    # In production, call OPA to verify auto-approvable; omitted here for brevity
+    approval_id = str(uuid.uuid4())
+    payload = {"approval_id": approval_id, "namespace": req.namespace, "action": req.action, "requester": req.requester}
+    tmp = f"/tmp/approval_{approval_id}.json"
+    with open(tmp, "w") as fh:
+        json.dump(payload, fh)
+    signed = False
+    sig_path = None
+    if COSIGN_KEY:
+        try:
+            subprocess.check_call(["cosign", "sign-blob", "--key", COSIGN_KEY, tmp])
+            sig_path = tmp + ".sig"
+            signed = True
+            # optional register to Rekor
+            if REKOR_SERVER:
+                subprocess.check_call(["rekor-cli", "upload", "--rekor_server", REKOR_SERVER, "--artifact", tmp, "--signature", sig_path])
+        except Exception as e:
+            LOG.exception("Signing failed: %s", e)
+    # store in DB
+    conn = get_conn()
+    cur = conn.cursor()
+    cur.execute("INSERT INTO approvals (id, namespace, action, requester, token, signed) VALUES (%s,%s,%s,%s,%s,%s)",
+                (approval_id, req.namespace, json.dumps(req.action), req.requester, sig_path or tmp, signed))
+    conn.commit()
+    cur.close()
+    conn.close()
+    return {"approval_id": approval_id, "signed": signed, "token_path": sig_path or tmp}
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(APP, host="0.0.0.0", port=int(os.environ.get("APPROVER_PORT", 8081)))
+
