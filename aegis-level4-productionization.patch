+#!/usr/bin/env python3
+"""
+QPU Job Queue Microservice (Postgres-backed) with batching/multiplexing sketch.
+ - Accepts job submissions and enforces team quotas
+ - Background worker batches small circuits for backends that support multiplexing
+ - Uses provider adapters to submit and polls results asynchronously
+"""
+import os
+import time
+import json
+import logging
+import threading
+import uuid
+from typing import List, Dict, Any
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import psycopg2
+from psycopg2.extras import RealDictCursor
+
+from adapters.ibmq_adapter import IBMQAdapter
+from adapters.braket_adapter import BraketAdapter
+
+LOG = logging.getLogger("aegis.qpu.queue.pg")
+APP = FastAPI()
+
+DB_DSN = os.environ.get("QPU_POSTGRES_DSN", "postgresql://qpu:qpu_pass@postgres.qpu.svc.cluster.local:5432/qpu")
+PROCESS_INTERVAL = float(os.environ.get("QPU_PROCESS_INTERVAL", "5"))
+TEAM_QUOTA = {"research": 100.0, "prod": 50.0}  # dollars budget example
+COST_PER_SHOT = {"ibmq": 0.0001, "braket": 0.0002}
+
+def get_conn():
+    return psycopg2.connect(DB_DSN)
+
+class QpuJob(BaseModel):
+    circuit: str
+    backend: str
+    shots: int = 1024
+    owner: str
+    team: str = "research"
+
+def init_db():
+    conn = get_conn()
+    cur = conn.cursor()
+    cur.execute("""
+    CREATE TABLE IF NOT EXISTS qpu_jobs (
+      id UUID PRIMARY KEY,
+      circuit TEXT,
+      backend TEXT,
+      shots INTEGER,
+      owner TEXT,
+      team TEXT,
+      status TEXT,
+      submitted_at TIMESTAMP WITH TIME ZONE DEFAULT now(),
+      started_at TIMESTAMP,
+      finished_at TIMESTAMP,
+      result JSONB,
+      est_cost NUMERIC
+    );
+    """)
+    conn.commit()
+    cur.close()
+    conn.close()
+
+def estimate_cost(backend: str, shots: int) -> float:
+    key = "ibmq" if "ibmq" in backend else "braket"
+    return shots * COST_PER_SHOT.get(key, 0.0001)
+
+@APP.post("/submit")
+def submit(job: QpuJob):
+    est = estimate_cost(job.backend, job.shots)
+    conn = get_conn()
+    cur = conn.cursor(cursor_factory=RealDictCursor)
+    cur.execute("SELECT COALESCE(SUM(est_cost),0) as usage FROM qpu_jobs WHERE team=%s AND status IN ('submitted','running')", (job.team,))
+    usage = cur.fetchone()["usage"]
+    if usage + est > TEAM_QUOTA.get(job.team, 1e9):
+        cur.close(); conn.close()
+        raise HTTPException(status_code=402, detail="team quota exceeded")
+    job_id = str(uuid.uuid4())
+    cur.execute("INSERT INTO qpu_jobs (id,circuit,backend,shots,owner,team,status,est_cost) VALUES (%s,%s,%s,%s,%s,%s,%s)",
+                (job_id, job.circuit, job.backend, job.shots, job.owner, job.team, "submitted", est))
+    conn.commit()
+    cur.close(); conn.close()
+    return {"job_id": job_id, "est_cost": float(est)}
+
+def batch_and_process():
+    ibm = IBMQAdapter()
+    brk = BraketAdapter()
+    while True:
+        try:
+            conn = get_conn()
+            cur = conn.cursor(cursor_factory=RealDictCursor)
+            cur.execute("SELECT id,circuit,backend,shots FROM qpu_jobs WHERE status='submitted' ORDER BY submitted_at LIMIT 50")
+            rows = cur.fetchall()
+            if not rows:
+                cur.close(); conn.close()
+                time.sleep(PROCESS_INTERVAL); continue
+            # Group by backend
+            by_backend = {}
+            for r in rows:
+                by_backend.setdefault(r["backend"], []).append(r)
+            for backend, jobs in by_backend.items():
+                # Multiplex small jobs: if backend supports multiplexing, combine circuits (provider-specific)
+                # Here we naively submit jobs individually but show where batching would occur.
+                for j in jobs:
+                    jid = j["id"]
+                    cur.execute("UPDATE qpu_jobs SET status='running', started_at=now() WHERE id=%s", (jid,))
+                    conn.commit()
+                    try:
+                        if "ibmq" in backend:
+                            resp = ibm.submit_async(j["circuit"], shots=j["shots"])
+                            if "error" in resp:
+                                res = {"fallback":"sim","error": resp.get("error")}
+                            else:
+                                job_id = resp.get("job_id")
+                                res = ibm.poll_job(job_id, timeout_s=600)
+                        else:
+                            resp = brk.submit_async(j["circuit"], shots=j["shots"])
+                            if "error" in resp:
+                                res = {"fallback":"sim","error":resp.get("error")}
+                            else:
+                                job_id = resp.get("job_id")
+                                res = brk.poll_job(job_id, timeout_s=1800)
+                        cur.execute("UPDATE qpu_jobs SET status=%s, finished_at=now(), result=%s WHERE id=%s",
+                                    (res.get("status","finished"), json.dumps(res), jid))
+                        conn.commit()
+                    except Exception as e:
+                        LOG.exception("processing failed for %s", jid)
+                        cur.execute("UPDATE qpu_jobs SET status='error', finished_at=now(), result=%s WHERE id=%s", (json.dumps({"error":str(e)}), jid))
+                        conn.commit()
+            cur.close(); conn.close()
+        except Exception as e:
+            LOG.exception("batch processor error: %s", e)
+        time.sleep(PROCESS_INTERVAL)
+
+if __name__ == "__main__":
+    init_db()
+    t = threading.Thread(target=batch_and_process, daemon=True)
+    t.start()
+    import uvicorn
+    uvicorn.run(APP, host="0.0.0.0", port=int(os.environ.get("QPU_QUEUE_PORT", 8080)))
+
