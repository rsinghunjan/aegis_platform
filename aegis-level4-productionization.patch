+#!/usr/bin/env bash
+set -euo pipefail
+if [ "$#" -lt 1 ]; then
+  echo "Usage: $0 <file-to-sign>"
+  exit 2
+fi
+FILE="$1"
+if [ -z "${COSIGN_KEY:-}" ]; then
+  echo "COSIGN_KEY env var not set (KMS URI or key path)"
+  exit 1
+fi
+echo "Signing $FILE with cosign key $COSIGN_KEY"
+cosign sign-blob --key "${COSIGN_KEY}" "$FILE"
+SIG="$FILE.sig"
+echo "Registering with Rekor ($REKOR_SERVER)"
+if [ -n "${REKOR_SERVER:-}" ]; then
+  rekor-cli upload --rekor_server "${REKOR_SERVER}" --artifact "$FILE" --signature "$SIG" || echo "Rekor upload failed"
+else
+  echo "REKOR_SERVER not set; skipping Rekor upload"
+fi
+echo "Signed and (maybe) registered"
