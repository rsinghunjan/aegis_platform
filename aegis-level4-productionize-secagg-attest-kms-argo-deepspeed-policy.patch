+Will raise if none installed and ALLOW_INSECURE_SECAGG != "1".
+"""
+import os, logging
+from typing import Dict, List, Tuple
+LOG = logging.getLogger("aegis.secagg_wrapper")
+
+IMPLEMENTATION = None
+try:
+    import secagg  # type: ignore
+    IMPLEMENTATION = "secagg"
+    LOG.info("secagg library available")
+except Exception:
+    try:
+        import crypten  # type: ignore
+        IMPLEMENTATION = "crypten"
+        LOG.info("crypten available")
+    except Exception:
+        IMPLEMENTATION = None
+        LOG.warning("No secure aggregation library found")
+
+def require_impl():
+    if IMPLEMENTATION is None and os.environ.get("ALLOW_INSECURE_SECAGG","") != "1":
+        raise RuntimeError("No secure aggregation implementation installed. Install secagg/crypten or set ALLOW_INSECURE_SECAGG for dev only.")
+
+def server_init(round_id:int, participants:List[str]) -> Dict:
+    require_impl()
+    # TODO: call into the chosen library's server init API; placeholder returns metadata
+    return {"round": round_id, "impl": IMPLEMENTATION, "participants": participants}
+
+def client_keypair(client_id:str) -> Tuple[bytes,str]:
+    require_impl()
+    if IMPLEMENTATION == "secagg":
+        # TODO: call secagg keygen; return (sk_bytes, pk_b64)
+        return b"secagg-sk-"+client_id.encode(), "secagg-pk-placeholder"
+    if IMPLEMENTATION == "crypten":
+        # TODO: call CrypTen keygen
+        return b"crypten-sk-"+client_id.encode(), "crypten-pk-placeholder"
+    raise RuntimeError("unreachable")
+
+def client_mask(weights:List[float], sk:bytes, peers:Dict[str,str]) -> bytes:
+    require_impl()
+    # convert to library payload and return bytes to upload
+    if IMPLEMENTATION == "secagg":
+        return b"masked-bytes-secagg"
+    if IMPLEMENTATION == "crypten":
+        return b"masked-bytes-crypten"
+    raise RuntimeError("unreachable")
+
+def server_finalize(round_id:int):
+    require_impl()
+    # Finalize and return aggregated result metadata
+    return {"round": round_id, "status": "final"}
