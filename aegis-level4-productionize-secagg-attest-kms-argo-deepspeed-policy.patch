+
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "https://vault.example.com:8200")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")
+VAULT_PKI_MOUNT = os.environ.get("VAULT_PKI_MOUNT", "pki")
+VAULT_ROLE = os.environ.get("VAULT_PKI_ROLE", "aegis-fl-client-role")
+S3_BUCKET = os.environ.get("S3_UPLOAD", "")
+REKOR = os.environ.get("REKOR_SERVER", "")
+
+client = hvac.Client(url=VAULT_ADDR, token=VAULT_TOKEN)
+s3 = boto3.client("s3")
