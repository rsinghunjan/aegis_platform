+#!/usr/bin/env python3
+"""
+Alert handler that triggers Argo remediation workflows upon alerts.
+Uses kubectl to submit WorkflowTemplate for remediation and waits for completion.
+"""
+import os, json, subprocess, logging
+from flask import Flask, request, jsonify
+
+LOG = logging.getLogger("aegis.alert_handler_argo")
+app = Flask(__name__)
+
+ARGO_TEMPLATE = os.environ.get("ARGO_TEMPLATE", "aegis-remediation-template")
+NAMESPACE = os.environ.get("AEGIS_NS", "aegis-app")
+
+def submit_workflow():
+    try:
+        cmd = ["kubectl","-n",NAMESPACE,"create","workflow","-o","name","--from",f"workflowtemplate/{ARGO_TEMPLATE}"]
+        out = subprocess.check_output(cmd)
+        wf = out.decode().strip()
+        LOG.info("Submitted workflow: %s", wf)
+        wait_cmd = ["kubectl","-n",NAMESPACE,"wait","--for=condition=Succeeded",wf,"--timeout=300s"]
+        subprocess.check_call(wait_cmd)
+        return True, wf
+    except Exception as e:
+        LOG.exception("Failed to submit workflow")
+        return False, str(e)
+
+@app.route("/alert", methods=["POST"])
+def alert():
+    body = request.json
+    # basic: always launch remediation for critical alerts
+    ok, info = submit_workflow()
+    return jsonify({"ok": ok, "info": info})
+
+if __name__=="__main__":
+    logging.basicConfig(level=logging.INFO)
+    app.run(host="0.0.0.0", port=7071)
+
