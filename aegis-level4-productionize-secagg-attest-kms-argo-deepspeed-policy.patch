+#!/usr/bin/env python3
+"""
+Attempt to load ZeRO stage-3 shards and reconstruct weights across varying world sizes.
+Used to validate resharding and checkpoint portability.
+"""
+import argparse, os, torch
+
+def load_shard(path):
+    return torch.load(path, map_location="cpu")
+
+def main(checkpoint_dir):
+    files = []
+    for root,_,fn in os.walk(checkpoint_dir):
+        for f in fn:
+            if f.endswith(".pt") or f.endswith(".bin"):
+                files.append(os.path.join(root,f))
+    print("Found shard files:", len(files))
+    if not files:
+        return 2
+    # attempt load of first N shards
+    for f in files[:10]:
+        try:
+            obj = load_shard(f)
+            print("Loaded:", f, "keys:", list(obj.keys())[:5])
+        except Exception as e:
+            print("Failed to load", f, e)
+            return 3
+    print("Shard loading verification passed")
+    return 0
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--checkpoint-dir", required=True)
+    args = p.parse_args()
+    raise SystemExit(main(args.checkpoint_dir))
+
