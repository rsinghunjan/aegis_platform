+#!/usr/bin/env python3
+"""
+Validate PDU/IPMI telemetry against node-level GPU power readings and produce calibration report.
+Integrates with vendor APIs (placeholders) or Prometheus metrics.
+"""
+import argparse, json, time, os, requests
+
+def sample_nvidia():
+    try:
+        out = os.popen("nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits").read().strip().splitlines()
+        vals = [float(x) for x in out if x]
+        return sum(vals) if vals else None
+    except Exception:
+        return None
+
+def sample_pdu_prom(prom_url, query):
+    r = requests.get(prom_url + "/api/v1/query", params={"query": query}, timeout=5)
+    r.raise_for_status()
+    data = r.json()
+    try:
+        val = float(data["data"]["result"][0]["value"][1])
+        return val
+    except Exception:
+        return None
+
+def main(prom_url=None, out="/tmp/pdu_validation.json"):
+    samples = []
+    for i in range(5):
+        nv = sample_nvidia()
+        pdu = sample_pdu_prom(prom_url, 'node_power_watts') if prom_url else None
+        samples.append({"nv":nv,"pdu":pdu,"ts":time.time()})
+        time.sleep(1)
+    avg_nv = sum([s["nv"] for s in samples if s["nv"]]) / max(1, len([s for s in samples if s["nv"]]))
+    avg_pdu = sum([s["pdu"] for s in samples if s["pdu"]]) / max(1, len([s for s in samples if s["pdu"]]))
+    calib = (avg_pdu/avg_nv) if (avg_nv and avg_pdu) else 1.0
+    outj = {"avg_nv":avg_nv,"avg_pdu":avg_pdu,"calib":calib,"samples":samples}
+    with open(out,"w") as fh:
+        json.dump(outj, fh, indent=2)
+    print("Wrote validation:", out)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--prom", default=None)
+    p.add_argument("--out", default="/tmp/pdu_validation.json")
+    args = p.parse_args()
+    main(args.prom, args.out)
+
