+#!/usr/bin/env python3
+"""
+Productionized attestation service
+ - Verifies TPM2 quotes using tpm2-tools (tpm2_checkquote / tpm2_verifysignature as available)
+ - Verifies SGX DCAP quotes using intel DCAP verification tool or SGX SDK (placeholder CLI calls)
+ - Verifies AWS Nitro enclave attestation via AWS Nitro Enclaves Verify API (placeholder)
+ - Issues Vault PKI certs via hvac upon successful verification
+ - Stores attestation evidence and issues Rekor entry (where possible)
+
+This file contains concrete subprocess calls for common vendor tools; adapt paths and flags to your environment.
+Ensure the attestation verification tools are installed into the image hosting this service.
+"""
+import os, json, tempfile, logging, subprocess
+from flask import Flask, request, jsonify
+import hvac
+import boto3
+
+LOG = logging.getLogger("aegis.attest")
+app = Flask(__name__)
+
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "https://vault.example.com:8200")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")
+VAULT_PKI_MOUNT = os.environ.get("VAULT_PKI_MOUNT", "pki")
+VAULT_ROLE = os.environ.get("VAULT_PKI_ROLE", "aegis-fl-client-role")
+S3_BUCKET = os.environ.get("S3_UPLOAD", "")
+REKOR = os.environ.get("REKOR_SERVER", "")
+
+client = hvac.Client(url=VAULT_ADDR, token=VAULT_TOKEN)
+s3 = boto3.client("s3")
+
+def run_cmd(cmd, input_bytes=None):
+    try:
+        LOG.info("Running cmd: %s", " ".join(cmd))
+        res = subprocess.run(cmd, input=input_bytes, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
+        return True, res.stdout.decode()
+    except subprocess.CalledProcessError as e:
+        LOG.error("Cmd failed: %s, stderr: %s", e.cmd, e.stderr.decode())
+        return False, e.stderr.decode()
+
+def verify_tpm2_quote(quote_pem, ak_pub_pem, pcrs=None):
+    """
+    Example flow (requires tpm2-tools installed and TPM vendor support):
+    - Use tpm2_checkquote or tpm2_verifysignature depending on tool availability.
+    This is a best-effort example; adapt to your TPM provisioning.
+    """
+    # Write files
+    qf = tempfile.NamedTemporaryFile(delete=False, suffix=".bin")
+    qf.write(quote_pem.encode() if isinstance(quote_pem,str) else quote_pem)
+    qf.close()
+    akf = tempfile.NamedTemporaryFile(delete=False, suffix=".pem")
+    akf.write(ak_pub_pem.encode() if isinstance(ak_pub_pem,str) else ak_pub_pem)
+    akf.close()
+    # Try tpm2_checkquote (placeholder invocation)
+    ok, out = run_cmd(["tpm2_checkquote", "-c", akf.name, "-q", qf.name]) 
+    if ok:
+        return True, {"method":"tpm2", "tool":"tpm2_checkquote", "output": out}
+    # Fallback: tpm2_verifysignature
+    ok2, out2 = run_cmd(["tpm2_verifysignature", "-c", akf.name, "-f", qf.name])
+    if ok2:
+        return True, {"method":"tpm2", "tool":"tpm2_verifysignature", "output": out2}
+    return False, {"error": out or out2}
+
+def verify_sgx_quote(quote_blob):
+    """
+    Use Intel DCAP verifier or other vendor-provided tooling.
+    Expect a 'dcap-verify' binary or a REST verification service.
+    """
+    # Placeholder: assume binary 'dcap_quoteverify' exists
+    fn = tempfile.NamedTemporaryFile(delete=False, suffix=".bin")
+    fn.write(quote_blob.encode() if isinstance(quote_blob,str) else quote_blob)
+    fn.close()
+    ok, out = run_cmd(["dcap_quoteverify", fn.name])
+    if ok:
+        return True, {"method":"sgx", "tool":"dcap_quoteverify", "output": out}
+    return False, {"error": out}
+
+def verify_nitro_attestation(quote_json):
+    """
+    AWS Nitro Enclaves: validate attestation document via local/published CA or remote verify.
+    Example uses AWS Nitro verification APIs or local cert chain verification.
+    """
+    # Placeholder: simply check presence of expected fields
+    try:
+        doc = quote_json if isinstance(quote_json, dict) else json.loads(quote_json)
+        if "public_key" in doc:
+            return True, {"method":"nitro", "note":"basic-structure-ok"}
+    except Exception as e:
+        return False, {"error": str(e)}
+    return False, {"error":"invalid_nitro_doc"}
+
+def issue_vault_cert(common_name, ttl="24h"):
+    try:
+        resp = client.secrets.pki.issue_certificate(
+            name=VAULT_ROLE,
+            common_name=common_name,
+            ttl=ttl,
+            mount_point=VAULT_PKI_MOUNT
+        )
+        return resp.get("data", {})
+    except Exception as e:
+        LOG.exception("Vault issue cert failed")
+        return None
+
+def store_evidence_s3(path, key_prefix="attestation"):
+    if not S3_BUCKET:
+        return None
+    basename = os.path.basename(path)
+    key = f"{key_prefix}/{basename}"
+    s3.upload_file(path, S3_BUCKET, key)
+    return f"s3://{S3_BUCKET}/{key}"
+
+@app.route("/attest", methods=["POST"])
+def attest():
+    b = request.json or {}
+    client_id = b.get("client_id")
+    att_type = b.get("type")
+    report = b.get("report")
+    if not client_id or not att_type or not report:
+        return jsonify({"ok": False, "error": "client_id,type,report required"}), 400
+    ok = False
+    info = {}
+    if att_type == "tpm":
+        ok, info = verify_tpm2_quote(report.get("quote"), report.get("ak_pub"))
+    elif att_type == "sgx":
+        ok, info = verify_sgx_quote(report.get("quote"))
+    elif att_type == "nitro":
+        ok, info = verify_nitro_attestation(report)
+    else:
+        return jsonify({"ok": False, "error": "unsupported attestation type"}), 400
+    if not ok:
+        return jsonify({"ok": False, "reason": info}), 403
+    # issue cert
+    certdata = issue_vault_cert(f"{client_id}.aegis.internal")
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".json")
+    json.dump({"client_id": client_id, "attestation": info, "cert_meta": certdata}, tmp)
+    tmp.close()
+    s3uri = store_evidence_s3(tmp.name, key_prefix="attestation")
+    # Rekor upload is optional; call rekor-cli if present (best-effort)
+    if os.environ.get("REKOR_SERVER"):
+        try:
+            subprocess.run(["rekor-cli", "upload", "--artifact", tmp.name, "--api-url", os.environ.get("REKOR_SERVER")], check=True)
+        except Exception:
+            LOG.exception("rekor upload failed")
+    return jsonify({"ok": True, "cert": certdata, "evidence": s3uri})
+
+if __name__ == "__main__":
+    logging.basicConfig(level=logging.INFO)
+    app.run(host="0.0.0.0", port=6060)
+
