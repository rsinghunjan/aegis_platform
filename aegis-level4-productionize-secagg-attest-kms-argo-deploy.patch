+#!/usr/bin/env python3
+"""
+Scale secure-aggregation simulation (improved with logging and artifact outputs).
+This script depends on ops/fl/integration/secagg_wrapper.py having a real implementation.
+"""
+import multiprocessing as mp
+import time, json, os, random, logging
+from ops.fl.integration import secagg_wrapper as wrapper
+
+logging.basicConfig(level=logging.INFO)
+LOG = logging.getLogger("secagg.sim")
+
+NUM_CLIENTS = int(os.environ.get("SECAGG_SIM_CLIENTS", "100"))
+WEIGHT_LEN = int(os.environ.get("SECAGG_WEIGHT_LEN", "256"))
+
+def client_process(client_id, q):
+    try:
+        sk, pk = wrapper.client_keypair(f"cli{client_id}")
+    except Exception as e:
+        q.put({"client": client_id, "error": str(e)})
+        return
+    weights = [random.random() for _ in range(WEIGHT_LEN)]
+    try:
+        payload = wrapper.client_mask(weights, sk, {f"cli{i}":"pk" for i in range(NUM_CLIENTS)})
+        q.put({"client": client_id, "payload_len": len(payload)})
+    except Exception as e:
+        q.put({"client": client_id, "error_mask": str(e)})
+
+def aggregator(q, n_clients, out="/tmp/secagg_simulation_summary.json"):
+    received = 0
+    details = []
+    start = time.time()
+    timeout = max(60, n_clients // 2)
+    while received < n_clients:
+        try:
+            msg = q.get(timeout=timeout)
+        except Exception:
+            break
+        details.append(msg)
+        received += 1
+    duration = time.time() - start
+    summary = {"received": received, "duration": duration, "details_sample": details[:20]}
+    with open(out, "w") as fh:
+        json.dump(summary, fh, indent=2)
+    LOG.info("Wrote summary to %s", out)
+
+if __name__ == "__main__":
+    q = mp.Queue()
+    agg = mp.Process(target=aggregator, args=(q, NUM_CLIENTS))
+    agg.start()
+    procs = []
+    for i in range(NUM_CLIENTS):
+        p = mp.Process(target=client_process, args=(i,q))
+        p.start()
+        procs.append(p)
+        time.sleep(0.01)
+    for p in procs:
+        p.join(timeout=20)
+    agg.join(timeout=10)
+    print("Scale simulation complete.")
+
