*** Add File:ops/secure_agg/production_mpc/worker.py
+#!/usr/bin/env python3
+"""
+CrypTen worker intended for multi-host MPC deployments.
+Environment variables expected:
+ - MASTER_ADDR, MASTER_PORT, RANK, WORLD_SIZE
+ - TLS_* variables if using mTLS transport (implementation depends on transport backend)
+
+This worker participates in an MPC sum using CrypTen primitives.
+For production you will run one instance per party (clients or helper parties).
+"""
+import os
+import crypten
+import torch
+from crypten.mpc import run_multiprocess
+
+def run_worker(rank, world_size, tensors):
+    crypten.init()
+    x = torch.tensor(tensors[rank])
+    enc_x = crypten.cryptensor(x, src=rank)
+    # sum across parties (CrypTen handles underlying protocol)
+    s = enc_x
+    # reveal aggregate to rank 0 only (demo)
+    plain = s.get_plain_text()
+    if rank == 0:
+        print("Aggregate (rank 0):", plain)
+    return plain
+
+def main():
+    # For local testing use run_multiprocess; in k8s set MASTER_ADDR/PORT and start separate processes
+    world_size = int(os.environ.get("WORLD_SIZE", "3"))
+    # In production, parties will provide their tensors; here we demo with test vectors
+    tensors = []
+    for i in range(world_size):
+        tensors.append([0.1 * (i+1), 0.2 * (i+1), 0.3 * (i+1)])
+    run_multiprocess(world_size, target=run_worker, args=(world_size, tensors))
+
+if __name__=="__main__":
+    main()
+
