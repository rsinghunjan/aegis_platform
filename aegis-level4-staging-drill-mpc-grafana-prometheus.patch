+apiVersion: monitoring.coreos.com/v1
+kind: PrometheusRule
+metadata:
+  name: aegis-alerts
+  namespace: monitoring
+spec:
+  groups:
+    - name: aegis.rules
+      rules:
+        - alert: WebhookRequestErrorRateHigh
+          expr: 100 - (sum(rate(istio_requests_total{destination_service=~"aegis-admission-webhook.*", response_code=~"2.."}[5m])) / sum(rate(istio_requests_total{destination_service=~"aegis-admission-webhook.*"}[5m])) * 100)
+          for: 5m
+          labels:
+            severity: critical
+          annotations:
+            summary: "High request error rate for admission webhook"
+        - alert: WebhookLatencyHigh
+          expr: histogram_quantile(0.95, sum(rate(istio_request_duration_seconds_bucket{destination_service=~"aegis-admission-webhook.*"}[5m])) by (le)) > 0.5
+          for: 5m
+          labels:
+            severity: warning
+          annotations:
+            summary: "High p95 latency for admission webhook"
+        - alert: DPBudgetLow
+          expr: dp_accounting_remaining < 1
+          for: 1m
+          labels:
+            severity: critical
+          annotations:
+            summary: "DP budget remaining low"
+        - alert: CalibratorPassRateLow
+          expr: calibrator_pass_rate < 0.8
+          for: 10m
+          labels:
+            severity: warning
+          annotations:
+            summary: "Calibrator pass rate below threshold"
+        - alert: SecureAggLatencyHigh
+          expr: increase(secureagg_aggregate_latency_seconds_sum[5m]) / increase(secureagg_aggregate_latency_seconds_count[5m]) > 1.0
+          for: 5m
+          labels:
+            severity: warning
+          annotations:
+            summary: "Secure aggregation latency high"
