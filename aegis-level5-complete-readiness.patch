+#!/usr/bin/env python3
+"""
+Simple PagerDuty/Oncall notifier via generic webhook.
+Usage:
+  PAGERDUTY_WEBHOOK=https://events.pagerduty.com/v2/enqueue python3 services/ops/oncall/pagerduty_notify.py --summary "..." --details "..."
+"""
+import os, argparse, json, requests
+
+WEBHOOK = os.environ.get("PAGERDUTY_WEBHOOK", "")
+
+def notify(summary, details):
+    if not WEBHOOK:
+        print("No webhook configured, printing notification:")
+        print(summary, details)
+        return
+    payload = {"routing_key": os.environ.get("PAGERDUTY_ROUTING_KEY",""), "event_action": "trigger", "payload": {"summary": summary, "source": "aegis", "severity": "error", "custom_details": details}}
+    r = requests.post(WEBHOOK, json=payload, timeout=10)
+    r.raise_for_status()
+    print("Notified webhook, status", r.status_code)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--summary", required=True)
+    p.add_argument("--details", default="")
+    args = p.parse_args()
+    notify(args.summary, args.details)
+
