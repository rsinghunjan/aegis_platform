+#!/usr/bin/env python3
+"""
+Ingest a legal-signed delegation manifest and insurance binder, verify signatures (cosign),
+upload to evidence WORM bucket, and record metadata in Vault.
+
+Usage:
+  python3 services/legal/ingest_signed_delegation.py --manifest /path/to/delegation.json --insurance /path/to/insurance.pdf
+
+Environment:
+  EVIDENCE_BUCKET - s3:// or gs:// evidence bucket
+  VAULT_DELEGATION_PATH - vault kv v2 path (e.g. secret/data/aegis/delegations)
+  COSIGN_PUBKEY_URI - optional URI to public key for verify (s3:// or gs:// or file)
+  VAULT_TOKEN / VAULT_ADDR configured for vault CLI usage
+"""
+import os, subprocess
+import argparse
+import json
+import tempfile
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+VAULT_PATH = os.environ.get("VAULT_DELEGATION_PATH", "secret/data/aegis/delegations")
+COSIGN_PUBKEY_URI = os.environ.get("COSIGN_PUBKEY_URI", "")
+
+def cosign_verify(path, pubkey=None):
+    if pubkey:
+        try:
+            subprocess.check_call(["cosign", "verify", "--key", pubkey, path])
+            return True
+        except subprocess.CalledProcessError:
+            return False
+    # best-effort verify (may consult Rekor / default)
+    try:
+        subprocess.check_call(["cosign", "verify", path])
+        return True
+    except subprocess.CalledProcessError:
+        return False
+
+def upload(path, prefix="delegations"):
+    if not EVIDENCE_BUCKET:
+        raise RuntimeError("EVIDENCE_BUCKET not configured")
+    if EVIDENCE_BUCKET.startswith("s3://"):
+        subprocess.check_call(["aws", "s3", "cp", path, f"{EVIDENCE_BUCKET}/{prefix}/{os.path.basename(path)}"])
+        return f"{EVIDENCE_BUCKET}/{prefix}/{os.path.basename(path)}"
+    elif EVIDENCE_BUCKET.startswith("gs://"):
+        subprocess.check_call(["gsutil", "cp", path, f"{EVIDENCE_BUCKET}/{prefix}/{os.path.basename(path)}"])
+        return f"{EVIDENCE_BUCKET}/{prefix}/{os.path.basename(path)}"
+    else:
+        raise RuntimeError("Unsupported EVIDENCE_BUCKET")
+
+def vault_record(key, metadata):
+    try:
+        subprocess.check_call(["vault", "kv", "put", f"{VAULT_PATH}/{key}", f"metadata={json.dumps(metadata)}"])
+        return True
+    except Exception as e:
+        print("vault write failed:", e)
+        return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--manifest", required=True)
+    p.add_argument("--insurance", required=False)
+    args = p.parse_args()
+    manifest = args.manifest
+    insurance = args.insurance
+
+    # verify manifest signature if cosign signature exists
+    manifest_verified = False
+    if os.path.exists(manifest + ".sig") or os.path.exists(manifest + ".sig.gz"):
+        print("Found signature file; attempting cosign verify (best-effort)")
+        pubkey = None
+        if COSIGN_PUBKEY_URI:
+            tmp = tempfile.mkdtemp()
+            if COSIGN_PUBKEY_URI.startswith("s3://"):
+                subprocess.check_call(["aws","s3","cp", COSIGN_PUBKEY_URI, tmp + "/pubkey.pem"])
+                pubkey = tmp + "/pubkey.pem"
+            elif COSIGN_PUBKEY_URI.startswith("gs://"):
+                subprocess.check_call(["gsutil","cp", COSIGN_PUBKEY_URI, tmp + "/pubkey.pem"])
+                pubkey = tmp + "/pubkey.pem"
+        manifest_verified = cosign_verify(manifest, pubkey)
+        print("Manifest signature verified:", manifest_verified)
+    else:
+        print("No cosign signature found for manifest; record will be ingested but treat as unverified")
+
+    # upload manifest and insurance binder
+    uploaded_manifest = upload(manifest, prefix="delegations")
+    uploaded_insurance = None
+    if insurance:
+        uploaded_insurance = upload(insurance, prefix="insurance_binders")
+
+    # record metadata in Vault under delegation ID (manifest must contain delegation_id)
+    try:
+        m = json.load(open(manifest))
+        delegation_id = m.get("delegation_id", os.path.basename(manifest))
+    except Exception:
+        delegation_id = os.path.basename(manifest)
+        m = {}
+
+    meta = {"manifest_uploaded": uploaded_manifest, "insurance_uploaded": uploaded_insurance, "manifest_verified": manifest_verified, "manifest_meta": m}
+    ok = vault_record(delegation_id, meta)
+    print("Recorded to Vault:", ok)
+    print("Ingest completed. Manifest:", uploaded_manifest, "Insurance:", uploaded_insurance)
+
+if __name__ == "__main__":
+    main()
+
