+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Verify an attestation artifact across multiple public keys (from Vault or URIs) and produce a JSON report.
+#
+ARTIFACT=${1:-}
+shift || true
+PUBKEY_URIS=("$@")
+OUT="/tmp/crosscloud_verification_$(date +%s).json"
+TMP=$(mktemp -d)
+if [[ "$ARTIFACT" == s3://* ]]; then aws s3 cp "$ARTIFACT" "$TMP/art.tar.gz"; fi
+if [[ "$ARTIFACT" == gs://* ]]; then gsutil cp "$ARTIFACT" "$TMP/art.tar.gz"; fi
+report=[]
+for pk in "${PUBKEY_URIS[@]}"; do
+  target="$TMP/pubkey.pem"
+  if [[ "$pk" == s3://* ]]; then aws s3 cp "$pk" "$target"; fi
+  if [[ "$pk" == gs://* ]]; then gsutil cp "$pk" "$target"; fi
+  if [[ "$pk" == file://* ]]; then cp "${pk#file://}" "$target"; fi
+  if cosign verify --key "$target" "$TMP/art.tar.gz"; then
+    report+=("{\"pubkey\":\"$pk\",\"result\":\"ok\"}")
+  else
+    report+=("{\"pubkey\":\"$pk\",\"result\":\"fail\"}")
+  fi
+done
+echo "["$(IFS=,; echo "${report[*]}")"]" > "$OUT"
+echo "Wrote cross-cloud verification report to $OUT"
+
