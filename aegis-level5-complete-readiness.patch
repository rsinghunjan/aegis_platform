+#!/usr/bin/env python3
+"""
+Remediation tracker: receive findings (from red-team, scanners, auditors) and create GitHub issues,
+persist findings locally and emit metrics for SLA tracking.
+
+Usage:
+  python3 services/audit/remediation_tracker.py --findings findings.json
+
+Environment:
+  GITHUB_REPO, GITHUB_TOKEN required to open issues
+"""
+import argparse, json, os, subprocess, time
+
+OUT_DB = "/tmp/aegis_remediation_db.json"
+GITHUB_REPO = os.environ.get("GITHUB_REPO", "")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN", "")
+
+def load_db():
+    try:
+        with open(OUT_DB) as f: return json.load(f)
+    except Exception:
+        return []
+
+def save_db(db):
+    with open(OUT_DB,"w") as f: json.dump(db,f,indent=2)
+
+def create_issue(title, body):
+    if not (GITHUB_REPO and GITHUB_TOKEN):
+        return {"error":"no-gh"}
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    out = subprocess.check_output(["curl","-sS","-X","POST","-H",f"Authorization: token {GITHUB_TOKEN}","-H","Accept: application/vnd.github.v3+json","-d",json.dumps({"title":title,"body":body}), url], universal_newlines=True)
+    return json.loads(out)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--findings", required=True)
+    args = p.parse_args()
+    findings = json.load(open(args.findings))
+    db = load_db()
+    for f in findings:
+        f["created_at"] = int(time.time())
+        # open GH issue
+        title = f.get("title") or f.get("id")
+        body = f.get("description","No description")
+        issue = create_issue(title, body)
+        f["issue"] = issue
+        db.append(f)
+    save_db(db)
+    print("Recorded", len(findings), "findings to remediation DB")
+
+if __name__ == "__main__":
+    main()
+
