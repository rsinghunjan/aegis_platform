+#!/usr/bin/env python3
+"""
+Finance Shadow Orchestrator
+ - Runs reconcile in shadow mode for a configured window (default 30 days)
+ - Collects daily metrics, computes mismatch rate, writes report, and can alert or create tickets
+ - After the shadow window passes and thresholds are met, operator can trigger promotion to live mode
+"""
+import os, time, json, requests, subprocess
+from datetime import datetime, timedelta
+import psycopg2
+
+RECON_DB = os.environ.get("RECONCILE_DB","postgresql://postgres:postgres@postgres:5432/quota")
+SHADOW_DAYS = int(os.environ.get("SHADOW_DAYS","30"))
+REPORT_DIR = os.environ.get("FIN_REPORT_DIR","/tmp/aegis_finance_reports")
+PROMOTION_THRESHOLD = float(os.environ.get("FIN_PROMOTION_THRESHOLD","0.001"))  # 0.1%
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK","")
+
+os.makedirs(REPORT_DIR, exist_ok=True)
+
+def daily_reconcile_snapshot():
+    conn = psycopg2.connect(RECON_DB)
+    with conn.cursor() as cur:
+        cur.execute("SELECT count(*) FILTER (WHERE status!='ok') as bad, count(*) as total FROM reconciliation_log")
+        bad, total = cur.fetchone()
+    ts = datetime.utcnow().isoformat()
+    rec = {"ts": ts, "bad": int(bad), "total": int(total)}
+    fn = os.path.join(REPORT_DIR, f"reconcile_snapshot_{datetime.utcnow().date().isoformat()}.json")
+    with open(fn, "w") as fh:
+        json.dump(rec, fh)
+    return rec
+
+def compute_window_stats(days=SHADOW_DAYS):
+    files = sorted([os.path.join(REPORT_DIR,f) for f in os.listdir(REPORT_DIR) if f.startswith("reconcile_snapshot_")])
+    files = files[-days:]
+    bad = 0; total = 0
+    for f in files:
+        j = json.load(open(f))
+        bad += j["bad"]
+        total += j["total"]
+    rate = 0.0
+    if total > 0:
+        rate = bad / total
+    return {"bad": bad, "total": total, "mismatch_rate": rate}
+
+def alert(msg):
+    if ALERT_WEBHOOK:
+        requests.post(ALERT_WEBHOOK, json={"message": msg}, timeout=5)
+    print("ALERT:", msg)
+
+def promote_if_safe():
+    stats = compute_window_stats()
+    if stats["mismatch_rate"] <= PROMOTION_THRESHOLD:
+        return True, stats
+    return False, stats
+
+if __name__ == "__main__":
+    # run daily snapshot (cron job daily)
+    rec = daily_reconcile_snapshot()
+    print("Daily snapshot:", rec)
+    # At end of window operator runs promotion check
+    safe, stats = promote_if_safe()
+    report_path = os.path.join(REPORT_DIR, "promotion_check.json")
+    with open(report_path, "w") as fh:
+        json.dump({"safe": safe, "stats": stats}, fh, indent=2)
+    if not safe:
+        alert(f"Finance promotion blocked: mismatch_rate={stats['mismatch_rate']}")
+    else:
+        alert("Finance promotion candidate: ratified by shadow-run thresholds. Operator review required to flip FINANCE_AUTO_BLOCK.")
+    print("Wrote report:", report_path)
+
