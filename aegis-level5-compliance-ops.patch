+  if [[ "$pk" == s3://* ]]; then aws s3 cp "$pk" "$TMP/pubkey.pem"; fi
+  if [[ "$pk" == gs://* ]]; then gsutil cp "$pk" "$TMP/pubkey.pem"; fi
+  if cosign verify --key "$TMP/pubkey.pem" "$TMP/art.tar.gz"; then
+    echo "Verification OK with $pk"
+  else
+    echo "Verification FAILED with $pk"
+  fi
+done
