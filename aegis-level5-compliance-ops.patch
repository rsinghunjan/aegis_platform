+#!/usr/bin/env python3
+"""
+Policy full coverage test runner:
+ - Loads policy_catalog & delegation matrix
+ - For each action in catalog, runs policy engine simulation with representative actors
+ - Fails if observed decisions do not align with delegation_matrix automation expectations
+ - Writes coverage report and exits non-zero on failures to gate CI
+"""
+import os, yaml, requests, json, sys
+
+POLICY_CATALOG = os.environ.get("POLICY_CATALOG","policies/auto_policy_catalog.yaml")
+DELEGATION = os.environ.get("DELEGATION_MATRIX","policies/delegation_matrix.yaml")
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL","http://localhost:8085/evaluate")
+
+def load(p): return yaml.safe_load(open(p))
+
+def expected(action):
+    d = load(DELEGATION)
+    return d.get("actions",{}).get(action,{}).get("automation")
+
+def run():
+    catalog = load(POLICY_CATALOG)
+    failures = []
+    for action in catalog.get("actions",{}).keys():
+        # test with automation actor and non-admin actor
+        for actor in ["aegis-bot", "unauthorized-user"]:
+            payload = {"action": action, "actor": actor}
+            try:
+                resp = requests.post(POLICY_ENGINE, json=payload, timeout=5).json()
+            except Exception as e:
+                failures.append((action, actor, "engine-unreachable", str(e)))
+                continue
+            exp = expected(action)
+            # Map policy response to automation label
+            allow = resp.get("allow", False)
+            approval = resp.get("policy",{}).get("approval")
+            observed = "auto" if allow and approval=="auto" else ("manual" if (not allow and approval=="manual") or approval=="manual" else "auto_with_audit" if approval=="auto_with_audit" else "unknown")
+            if exp and exp != observed and not (exp=="auto_with_audit" and observed in ["auto","auto_with_audit"]):
+                failures.append((action, actor, exp, observed))
+    report = {"failures": failures, "timestamp": int(__import__("time").time())}
+    with open("/tmp/policy_full_coverage_report.json","w") as fh: json.dump(report, fh, indent=2)
+    if failures:
+        print("Policy coverage failures:", failures)
+        sys.exit(2)
+    print("Policy coverage OK")
+
+if __name__ == "__main__":
+    run()
+
