+#!/usr/bin/env python3
+"""
+Continuous red-team runner
+ - Runs selected scenarios on a schedule (staging), collects results, opens remediation issues and enforces SLAs.
+ - Integrates with remediation_tracker to open GH issues for findings.
+"""
+import os, subprocess, json, time
+from datetime import datetime
+
+SCENARIOS_DIR = "ops/redteam/redteam_scenarios"
+RESULTS_DIR = "/tmp/aegis_redteam"
+REMEDIATION_TRACKER = "ops/audit/remediation_tracker.py"
+
+os.makedirs(RESULTS_DIR, exist_ok=True)
+
+def run_scenario(script):
+    ts = datetime.utcnow().isoformat().replace(":","_")
+    out = os.path.join(RESULTS_DIR, f"{os.path.basename(script)}.{ts}.out")
+    try:
+        subprocess.check_call([script], stdout=open(out,"w"), stderr=subprocess.STDOUT, timeout=600)
+        return {"script": script, "ok": True, "out": out}
+    except Exception as e:
+        return {"script": script, "ok": False, "error": str(e), "out": out}
+
+def main():
+    scenarios = [os.path.join(SCENARIOS_DIR, f) for f in os.listdir(SCENARIOS_DIR) if f.endswith(".sh") or f.endswith(".py")]
+    results = []
+    for s in scenarios:
+        print("Running scenario", s)
+        r = run_scenario(s)
+        results.append(r)
+        if not r["ok"]:
+            # create remediation record (findings.json format)
+            findings = [{"id": f"redteam-{os.path.basename(s)}-{int(time.time())}", "severity":"high", "title": f"Redteam failure: {s}", "description": r.get("error",""), "status":"open"}]
+            subprocess.check_call(["python3", REMEDIATION_TRACKER, json.dumps(findings)])
+    with open(os.path.join(RESULTS_DIR, f"redteam_report_{int(time.time())}.json"), "w") as fh:
+        json.dump(results, fh, indent=2)
+    print("Completed redteam run; results in", RESULTS_DIR)
+
+if __name__=="__main__":
+    main()
+
