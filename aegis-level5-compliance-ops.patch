+#!/usr/bin/env python3
+"""
+Orchestrator to perform M-of-N threshold signing of an artifact using a list of cosign KMS key refs.
+ - Accepts an artifact (tar.gz/json) and a list of key refs (cloud KMS or HSM-backed).
+ - Calls cosign to sign with each key ref, collects signatures into a signed bundle and writes a manifest.
+ - Optionally uploads signatures and manifest to EVIDENCE_BUCKET and records entry in Vault.
+"""
+import os, sys, json, subprocess, tempfile
+from datetime import datetime
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+VAULT_DELEGATION_PATH = os.environ.get("VAULT_DELEGATION_PATH","secret/data/aegis/delegations")
+
+def sign_with_keys(artifact, keys):
+    tmpdir = tempfile.mkdtemp()
+    sig_files = []
+    for i, key in enumerate(keys):
+        print(f"Signing with key: {key}")
+        subprocess.check_call(["cosign","sign","--key", key, artifact])
+        # cosign writes artifact.sig -- rename to unique file
+        sig_src = artifact + ".sig"
+        dest = os.path.join(tmpdir, f"{os.path.basename(artifact)}.sig.{i}")
+        os.rename(sig_src, dest)
+        sig_files.append(dest)
+    manifest = {
+        "artifact": os.path.basename(artifact),
+        "signed_at": datetime.utcnow().isoformat() + "Z",
+        "signers": keys,
+        "signature_files": [os.path.basename(s) for s in sig_files]
+    }
+    manifest_path = os.path.join(tmpdir, "threshold_sign_manifest.json")
+    with open(manifest_path, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return tmpdir, manifest_path
+
+def upload_to_evidence(path, prefix="signatures"):
+    if not EVIDENCE_BUCKET:
+        print("EVIDENCE_BUCKET not configured; skipping upload")
+        return None
+    if EVIDENCE_BUCKET.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", path, f"{EVIDENCE_BUCKET}/{prefix}/{os.path.basename(path)}"])
+        return f"{EVIDENCE_BUCKET}/{prefix}/{os.path.basename(path)}"
+    elif EVIDENCE_BUCKET.startswith("gs://"):
+        subprocess.check_call(["gsutil","cp", path, f"{EVIDENCE_BUCKET}/{prefix}/{os.path.basename(path)}"])
+        return f"{EVIDENCE_BUCKET}/{prefix}/{os.path.basename(path)}"
+    else:
+        return None
+
+def record_vault(key, meta):
+    try:
+        subprocess.check_call(["vault","kv","put", f"{VAULT_DELEGATION_PATH}/{key}", f"metadata={json.dumps(meta)}"])
+        return True
+    except Exception as e:
+        print("Vault write failed:", e)
+        return False
+
+def main():
+    if len(sys.argv) < 3:
+        print("Usage: multi_sign_orchestrator.py <artifact> <comma-separated-key-refs>")
+        sys.exit(2)
+    artifact = sys.argv[1]
+    keys = [k.strip() for k in sys.argv[2].split(",") if k.strip()]
+    tmpdir, manifest = sign_with_keys(artifact, keys)
+    print("Created signatures in", tmpdir, "manifest:", manifest)
+    # upload manifest and signatures
+    uploaded = None
+    try:
+        uploaded = upload_to_evidence(manifest, prefix="threshold")
+    except Exception as e:
+        print("Upload failed:", e)
+    record = {"manifest_uploaded": uploaded, "local_manifest": manifest, "signers": keys}
+    record_vault(os.path.basename(manifest).replace(".json",""), record)
+    print("Done.")
+
+if __name__ == "__main__":
+    main()
+
