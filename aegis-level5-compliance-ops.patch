+#!/usr/bin/env python3
+"""
+Automated playbook runner
+ - Executes a safe, attested remediation playbook when policy allows automatic remediation.
+ - Emits an attestation bundle for the action and uploads it to evidence store before and after remediation.
+ - Creates an incident in PagerDuty/issue tracker when remediation triggers and records human-notify steps.
+"""
+import os, subprocess, json, tempfile
+from datetime import datetime
+PAGERDUTY_WEBHOOK = os.environ.get("PAGERDUTY_WEBHOOK","")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def attest(path_prefix, items):
+    tmp = tempfile.mkdtemp()
+    bundle = os.path.join(tmp, f"{path_prefix}-{int(__import__('time').time())}.tar.gz")
+    subprocess.check_call(["tar","-czf",bundle] + items)
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, bundle])
+    if EVIDENCE_BUCKET:
+        subprocess.check_call(["aws","s3","cp", bundle, f"{EVIDENCE_BUCKET}/playbooks/{os.path.basename(bundle)}"])
+    return bundle
+
+def notify_pagerduty(summary, details):
+    if PAGERDUTY_WEBHOOK:
+        subprocess.check_call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps({"summary": summary, "details": details}), PAGERDUTY_WEBHOOK])
+
+def run_playbook(playbook_script, evidence_paths):
+    # Create pre-action attestation
+    pre = attest("playbook_pre", evidence_paths)
+    # Execute playbook (must be idempotent and safe)
+    subprocess.check_call(["bash", playbook_script])
+    # Post-action attestation
+    post = attest("playbook_post", evidence_paths + [playbook_script])
+    # Notify oncall
+    notify_pagerduty(f"Automated playbook executed: {playbook_script}", {"pre": pre, "post": post, "ts": datetime.utcnow().isoformat()})
+    return {"pre": pre, "post": post}
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--playbook", required=True)
+    p.add_argument("--evidence", nargs="+", default=[])
+    args = p.parse_args()
+    print(run_playbook(args.playbook, args.evidence))
+
