+#!/usr/bin/env python3
+"""
+Enhanced production reconcile with shadow mode, thresholds and promotion gating.
+
+Environment:
+ - SHADOW_MODE=true/false (if true, do not perform real charges; only simulate/report)
+ - PROMOTION_THRESHOLD (float between 0 and 1) fraction of mismatch allowed before gating
+ - RECONCILE_DB - Postgres URL
+ - VAULT_FINANCE_PATH - vault path for finance creds
+ - FINANCE_AUTO_BLOCK (as before) - must be enabled only after promotion
+"""
+import os, subprocess, requests, psycopg2, json, time
+
+SHADOW = os.environ.get("SHADOW_MODE", "true").lower() == "true"
+PROMOTION_THRESHOLD = float(os.environ.get("PROMOTION_THRESHOLD", "0.001"))  # 0.1%
+RECON_DB = os.environ.get("RECONCILE_DB", os.environ.get("DATABASE_URL"))
+VAULT_FINANCE_PATH = os.environ.get("VAULT_FINANCE_PATH", "secret/data/aegis/finance")
+FINANCE_AUTO_BLOCK = os.environ.get("FINANCE_AUTO_BLOCK", "false").lower() == "true"
+
+def vault_get(key):
+    return subprocess.check_output(["vault", "kv", "get", "-field=value", f"{VAULT_FINANCE_PATH}/{key}"], universal_newlines=True).strip()
+
+def post_charge(finance_api, api_key, record):
+    if SHADOW:
+        return {"status":"shadow", "body":"shadow-run: not posting"}
+    headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}
+    r = requests.post(finance_api.rstrip("/") + "/charges", json=record, headers=headers, timeout=15)
+    return {"status": r.status_code, "body": r.text}
+
+def analyze_and_report():
+    conn = psycopg2.connect(RECON_DB)
+    with conn.cursor() as cur:
+        cur.execute("SELECT COUNT(*) FILTER (WHERE status!='ok') as bad, COUNT(*) as total FROM reconciliation_log")
+        bad, total = cur.fetchone()
+        conn.commit()
+    mismatch_rate = 0.0
+    if total > 0:
+        mismatch_rate = bad / float(total)
+    print("Mismatch rate:", mismatch_rate, "bad/total:", bad, total)
+    return mismatch_rate, bad, total
+
+def promote_if_safe():
+    mismatch_rate, bad, total = analyze_and_report()
+    if mismatch_rate <= PROMOTION_THRESHOLD:
+        print("Promotion allowed: mismatch_rate", mismatch_rate)
+        # operator: enable FINANCE_AUTO_BLOCK in prod (manual step) or call a secured API to flip
+        return True
+    print("Promotion blocked: mismatch_rate", mismatch_rate)
+    return False
+
+if __name__ == "__main__":
+    # used as a daily job: run analyze and optionally call promote_if_safe
+    if promote_if_safe():
+        print("Consider enabling FINANCE_AUTO_BLOCK after operator review.")
+    else:
+        print("Keep in shadow mode and investigate mismatches.")
+
