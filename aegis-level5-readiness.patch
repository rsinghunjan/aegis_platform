+#!/usr/bin/env python3
+"""
+Legal Delegation Manager
+
+Purpose:
+ - Manage legal delegation records for Aegis automated decisions.
+ - Record delegations in Vault, produce delegation manifests, and cosign-sign them.
+ - Provide an API (CLI) operators/legal can use to create/renew/revoke delegations.
+
+Notes:
+ - This is an operator-facing tool; final legal text must be provided by counsel.
+ - Delegations stored in Vault KV v2 at path: VAULT_DELEGATION_PATH (env).
+"""
+import os
+import json
+import subprocess
+import tempfile
+from datetime import datetime, timezone
+
+VAULT_PATH = os.environ.get("VAULT_DELEGATION_PATH", "secret/data/aegis/delegations")
+COSIGN_KEY_REFS = os.environ.get("COSIGN_KEY_REFS", "")  # comma-separated list for redundant signing
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def _vault_put(key, data):
+    # store JSON metadata at VAULT_PATH/<key>
+    try:
+        subprocess.check_call(["vault", "kv", "put", f"{VAULT_PATH}/{key}", f"metadata={json.dumps(data)}"])
+        return True
+    except Exception as e:
+        print("Vault write failed:", e)
+        return False
+
+def _cosign_sign(path):
+    # multi-signer: sign with each KMS key ref (if provided)
+    sigs = []
+    if not COSIGN_KEY_REFS:
+        raise RuntimeError("COSIGN_KEY_REFS not configured")
+    for ref in [r.strip() for r in COSIGN_KEY_REFS.split(",") if r.strip()]:
+        try:
+            subprocess.check_call(["cosign", "sign", "--key", ref, path])
+            sigs.append(ref)
+        except Exception as e:
+            print("cosign sign failed for", ref, ":", e)
+            raise
+    return sigs
+
+def create_delegation(delegation_id, actions, delegated_to, expires_iso, notes=""):
+    manifest = {
+        "delegation_id": delegation_id,
+        "actions": actions,
+        "delegated_to": delegated_to,
+        "created_at": datetime.now(timezone.utc).isoformat(),
+        "expires_at": expires_iso,
+        "notes": notes,
+    }
+    tmp = tempfile.mkdtemp()
+    path = os.path.join(tmp, f"delegation_{delegation_id}.json")
+    with open(path, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    # sign manifest with multi-party keys
+    sigs = _cosign_sign(path)
+    # upload to evidence store
+    uploaded = None
+    if EVIDENCE_BUCKET:
+        if EVIDENCE_BUCKET.startswith("s3://"):
+            subprocess.check_call(["aws", "s3", "cp", path, f"{EVIDENCE_BUCKET}/delegations/{os.path.basename(path)}"])
+            uploaded = f"{EVIDENCE_BUCKET}/delegations/{os.path.basename(path)}"
+        elif EVIDENCE_BUCKET.startswith("gs://"):
+            subprocess.check_call(["gsutil", "cp", path, f"{EVIDENCE_BUCKET}/delegations/{os.path.basename(path)}"])
+            uploaded = f"{EVIDENCE_BUCKET}/delegations/{os.path.basename(path)}"
+    # record in Vault
+    record = {"manifest_path": uploaded, "signers": sigs, "manifest": manifest}
+    _vault_put(delegation_id, record)
+    return record
+
+def revoke_delegation(delegation_id, revoked_by):
+    rec = {"revoked_by": revoked_by, "revoked_at": datetime.now(timezone.utc).isoformat()}
+    _vault_put(f"{delegation_id}_revocation", rec)
+    return rec
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("command", choices=["create", "revoke"])
+    p.add_argument("--id", required=True)
+    p.add_argument("--actions", help="comma-separated action keys (for create)")
+    p.add_argument("--delegated-to", help="party delegated to (for create)")
+    p.add_argument("--expires", help="ISO expiry (for create)")
+    p.add_argument("--notes", default="")
+    p.add_argument("--revoked-by", help="who revoked (for revoke)")
+    args = p.parse_args()
+    if args.command == "create":
+        out = create_delegation(args.id, args.actions.split(","), args.delegated_to, args.expires, notes=args.notes)
+        print(json.dumps(out, indent=2))
+    else:
+        out = revoke_delegation(args.id, args.revoked_by or "operator")
+        print(json.dumps(out, indent=2))
+
