+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Verify attestation bundles across multiple clouds by extracting pubkeys and running cosign verify.
+# Usage: ops/crosscloud/verify_evidence_across_clouds.sh --artifact s3://... --pubkeys "s3://...,gs://..."
+#
+ARTIFACT=${1:-}
+shift || true
+PUBKEYS=("$@")
+if [ -z "$ARTIFACT" ] || [ ${#PUBKEYS[@]} -eq 0 ]; then
+  echo "Usage: $0 <artifact-uri> <pubkey-uri> [<pubkey-uri> ...]"
+  exit 2
+fi
+tmp=$(mktemp -d)
+if [[ "$ARTIFACT" == s3://* ]]; then aws s3 cp "$ARTIFACT" "$tmp/art.tar.gz"; fi
+if [[ "$ARTIFACT" == gs://* ]]; then gsutil cp "$ARTIFACT" "$tmp/art.tar.gz"; fi
+for p in "${PUBKEYS[@]}"; do
+  if [[ "$p" == s3://* ]]; then aws s3 cp "$p" "$tmp/pubkey.pem"; fi
+  if [[ "$p" == gs://* ]]; then gsutil cp "$p" "$tmp/pubkey.pem"; fi
+  cosign verify --key "$tmp/pubkey.pem" "$tmp/art.tar.gz" && echo "Verified with $p" || echo "FAILED verify with $p"
+done
+
