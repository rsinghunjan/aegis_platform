+#!/usr/bin/env python3
+"""
+Policy test harness & coverage reporter.
+ - Loads policy catalog & delegation matrix
+ - Runs through each action and verifies policy engine returns an expected decision
+ - Produces a coverage report per action->expected automation level
+"""
+import yaml, json, os, requests
+POLICY_CATALOG = os.environ.get("POLICY_CATALOG","policies/auto_policy_catalog.yaml")
+DELEGATION = os.environ.get("DELEGATION_MATRIX","policies/delegation_matrix.yaml")
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL","http://localhost:8085/evaluate")
+
+def load(p): return yaml.safe_load(open(p))
+
+def expected_from_delegation(action_key):
+    d = load(DELEGATION)
+    return d.get("actions", {}).get(action_key, {}).get("automation")
+
+def run_test():
+    pol = load(POLICY_CATALOG)
+    results = []
+    for action in pol.get("actions", {}).keys():
+        actor = "aegis-bot"
+        payload = {"action": action, "actor": actor}
+        try:
+            r = requests.post(POLICY_ENGINE, json=payload, timeout=5)
+            r.raise_for_status()
+            resp = r.json()
+        except Exception as e:
+            resp = {"error": str(e)}
+        expected = expected_from_delegation(action)
+        results.append({"action": action, "expected": expected, "result": resp})
+    out = "/tmp/policy_test_report.json"
+    with open(out,"w") as fh: json.dump(results, fh, indent=2)
+    print("Wrote report to", out)
+    return results
+
+if __name__=="__main__":
+    run_test()
+
