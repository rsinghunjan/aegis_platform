+#!/usr/bin/env python3
+"""
+Threshold signer helper.
+
+This script performs multi-signer signing by iterating over a list of KMS key refs and invoking cosign for each.
+It produces a manifest.json that lists the signers and the resulting signature files.
+
+Usage:
+  ops/hsm/threshold_signer.py --artifact /path/to/art.tar.gz --keys "kms://aws/alias/...,gcp-kms-path,..."
+"""
+import argparse
+import os
+import subprocess
+import json
+import tempfile
+
+def sign_with_keys(artifact, keys):
+    sig_files = []
+    tmp = tempfile.mkdtemp()
+    for i, k in enumerate(keys):
+        print("Signing with", k)
+        try:
+            subprocess.check_call(["cosign", "sign", "--key", k, artifact])
+            # assume cosign writes artifact.sig; move to unique name
+            signame = f"{os.path.basename(artifact)}.sig.{i}"
+            os.rename(artifact + ".sig", os.path.join(tmp, signame))
+            sig_files.append(signame)
+        except subprocess.CalledProcessError as e:
+            print("cosign sign failed for", k, e)
+            raise
+    manifest = {"artifact": os.path.basename(artifact), "signatures": sig_files, "keys": keys}
+    manifest_path = os.path.join(tmp, "threshold_manifest.json")
+    with open(manifest_path, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return tmp, manifest_path
+
+def verify_all(artifact, manifest_path, tmpdir):
+    with open(manifest_path) as fh:
+        m = json.load(fh)
+    results = []
+    for idx, sig in enumerate(m["signatures"]):
+        sigpath = os.path.join(tmpdir, sig)
+        # cosign verify supports verifying a signature file by using --signature
+        try:
+            subprocess.check_call(["cosign", "verify-blob", "--signature", sigpath, artifact])
+            results.append(True)
+        except subprocess.CalledProcessError:
+            results.append(False)
+    return results
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--artifact", required=True)
+    ap.add_argument("--keys", required=True, help="comma-separated KMS key refs")
+    args = ap.parse_args()
+    keys = [k.strip() for k in args.keys.split(",") if k.strip()]
+    tmpdir, manifest = sign_with_keys(args.artifact, keys)
+    print("Created multi-sign manifest:", manifest)
+    print("Verifying signatures...")
+    print(verify_all(args.artifact, manifest, tmpdir))
+
