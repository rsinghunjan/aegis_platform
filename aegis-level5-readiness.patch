+#!/usr/bin/env python3
+"""
+Audit packager for third-party certification.
+ - Collects provided evidence paths, attestation bundles, reproducibility reports, policy simulation outputs,
+   red-team reports, and creates a signed archive for auditors.
+"""
+import argparse, os, tempfile, shutil, json, subprocess
+from datetime import datetime
+
+def collect(paths, outdir):
+    for p in paths:
+        if os.path.exists(p):
+            if os.path.isdir(p):
+                shutil.copytree(p, os.path.join(outdir, os.path.basename(p)), dirs_exist_ok=True)
+            else:
+                shutil.copy2(p, outdir)
+
+def sign_archive(archive_path, cosign_key_ref):
+    subprocess.check_call(["cosign", "sign", "--key", cosign_key_ref, archive_path])
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--paths", nargs="+", required=True)
+    ap.add_argument("--out", default="/tmp/aegis_audit_pkg.tar.gz")
+    ap.add_argument("--cosign-key", default=os.environ.get("COSIGN_KEY_REF",""))
+    args = ap.parse_args()
+    tmp = tempfile.mkdtemp(prefix="aegis_audit_")
+    collect(args.paths, tmp)
+    meta = {"collected_at": datetime.utcnow().isoformat(), "items": args.paths}
+    with open(os.path.join(tmp, "package_meta.json"), "w") as fh:
+        json.dump(meta, fh, indent=2)
+    subprocess.check_call(["tar","-czf", args.out, "-C", tmp, "."])
+    if args.cosign_key:
+        sign_archive(args.out, args.cosign_key)
+    print("Audit package created at", args.out)
+
+if __name__ == "__main__":
+    main()
+
