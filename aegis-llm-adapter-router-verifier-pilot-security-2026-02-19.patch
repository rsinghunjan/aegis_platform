+#!/usr/bin/env python3
+"""
+Pilot evaluation harness.
+- Loads tasks from tasks.json
+- Sends requests to the local LLM adapter router endpoint and records responses
+- Produces a CSV of results (provider, model, latency, output length, cost estimate placeholder)
+"""
+import os, json, csv, time, argparse
+import httpx
+
+ADAPTER_URL = os.environ.get("AEGIS_LLM_ADAPTER_URL", "http://localhost:8000/v1/generate")
+OUT_DIR = os.environ.get("AEGIS_PILOT_OUTDIR", "/tmp/aegis_llm_pilot")
+os.makedirs(OUT_DIR, exist_ok=True)
+
+def load_tasks(path="tasks.json"):
+    with open(path) as f:
+        return json.load(f)
+
+def run_one(task, timeout=30):
+    req = {"task": task.get("task"), "sensitivity": task.get("sensitivity","low"), "input": task["input"], "metadata": task.get("metadata",{})}
+    start = time.time()
+    try:
+        r = httpx.post(ADAPTER_URL, json=req, timeout=timeout)
+        r.raise_for_status()
+        j = r.json()
+        elapsed = time.time() - start
+        return {"ok": True, "resp": j, "latency": elapsed}
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+
+def main(tasks_path="tasks.json", out_csv=f"{OUT_DIR}/results.csv"):
+    tasks = load_tasks(tasks_path)
+    rows = []
+    for t in tasks:
+        print("Running task:", t["id"], t.get("brief",""))
+        res = run_one(t)
+        row = {
+            "task_id": t["id"],
+            "brief": t.get("brief",""),
+            "ok": res["ok"],
+            "provider": res["resp"]["provider"] if res["ok"] else "",
+            "model": res["resp"]["model"] if res["ok"] else "",
+            "latency": res["latency"] if res["ok"] else "",
+            "output": (res["resp"]["output"][:1000] + "...") if (res["ok"] and res["resp"]["output"]) else "",
+            "error": res.get("error","")
+        }
+        rows.append(row)
+        # small sleep to avoid rate-limit bursts
+        time.sleep(0.5)
+    with open(out_csv, "w") as f:
+        writer = csv.DictWriter(f, fieldnames=rows[0].keys())
+        writer.writeheader()
+        for r in rows:
+            writer.writerow(r)
+    print("Wrote results to", out_csv)
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--tasks", default="tasks.json")
+    parser.add_argument("--out", default=f"{OUT_DIR}/results.csv")
+    args = parser.parse_args()
+    main(args.tasks, args.out)
+
