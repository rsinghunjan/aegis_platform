+"""
+LLM Verifier Service
+- Accepts POST /v1/verify with {input, output, provenance} and runs:
+  - optional retrieval check (RAG source verification)
+  - secondary model verification (calls adapter /v1/generate with role=verifier)
+  - simple heuristics (PII detection, contradition)
++- Returns {decision: accept|flag|reject, reasons:[...], score: 0..1}
+
+This is a best-effort reference implementation. Integrate with n8n HIL flows for operator approvals.
+"""
+import os, time
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import httpx
+
+ADAPTER_URL = os.environ.get("AEGIS_LLM_ADAPTER_URL", "http://localhost:8000/v1/generate")
+MCP_URL = os.environ.get("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+
+app = FastAPI(title="Aegis LLM Verifier")
+
+class VerifyRequest(BaseModel):
+    input: str
+    output: str
+    provenance: dict
+    metadata: dict = {}
+
+class VerifyResponse(BaseModel):
+    decision: str
+    reasons: list
+    score: float
+
+async def call_verifier_model(text: str):
+    # call adapter with a fixed 'verifier' task; adapter routes to a small model or verifier endpoint
+    payload = {"task": "verify", "sensitivity": "medium", "input": text, "metadata": {"role":"verifier"}}
+    async with httpx.AsyncClient(timeout=20.0) as client:
+        r = await client.post(ADAPTER_URL, json=payload)
+        r.raise_for_status()
+        return r.json()
+
+def simple_pii_check(text: str):
+    # naive PII heuristics: look for emails, ssn-like patterns (placeholder)
+    reasons = []
+    if "@" in text:
+        reasons.append("contains_email_like_token")
+    if "ssn" in text.lower() or "social security" in text.lower():
+        reasons.append("contains_ssn_keyword")
+    return reasons
+
+async def persist_verifier_result(req: VerifyRequest, decision: str, score: float, reasons: list):
+    # post a small evidence entry to MCP to record verifier result
+    payload = {
+        "schema_version": "1.1",
+        "model_id": req.metadata.get("model_id","verifier"),
+        "version": req.metadata.get("model_version","v0"),
+        "notes": f"verifier_decision:{decision}",
+        "llm_call": {
+            "input": req.input,
+            "output": req.output,
+            "decision": decision,
+            "score": score,
+            "reasons": reasons,
+            "timestamp": int(time.time())
+        }
+    }
+    try:
+        async with httpx.AsyncClient(timeout=3.0) as client:
+            await client.post(f"{MCP_URL}/model-context", json=payload)
+    except Exception:
+        pass
+
+@app.post("/v1/verify", response_model=VerifyResponse)
+async def verify(req: VerifyRequest):
+    # 1) quick heuristics
+    reasons = simple_pii_check(req.output)
+    if reasons:
+        await persist_verifier_result(req, "flag", 0.0, reasons)
+        return {"decision":"flag", "reasons": reasons, "score": 0.0}
+
+    # 2) call verifier model to check for hallucination / contradictions
+    try:
+        verifier_resp = await call_verifier_model(f"Verify correctness of the following output given input:\nINPUT:\n{req.input}\nOUTPUT:\n{req.output}\nProvide 'ACCEPT' if correct, 'REJECT' if incorrect, and short reasons.")
+        vtext = verifier_resp.get("output","").lower()
+        if "accept" in vtext:
+            decision = "accept"
+            score = 0.9
+            reasons = []
+        elif "reject" in vtext:
+            decision = "reject"
+            score = 0.1
+            reasons = [vtext[:200]]
+        else:
+            decision = "flag"
+            score = 0.5
+            reasons = [vtext[:200]]
+    except Exception as e:
+        # if verifier fails, flag
+        decision = "flag"
+        score = 0.0
+        reasons = [str(e)]
+
+    await persist_verifier_result(req, decision, score, reasons)
+    return {"decision": decision, "reasons": reasons, "score": score}
+
