+"""
+LLM Adapter & Router for Aegis
+- Exposes a single HTTP endpoint (/v1/generate) that accepts a standardized request:
+  { "task": "...", "sensitivity": "low|medium|high", "input": "...", "metadata": {...} }
+- Routes requests to a selected provider (OpenAI, Anthropic, Google) according to config and rules.
+- Logs full I/O as an evidence bundle to MCP (configurable), tags with model id and cost estimate,
+  and optionally signs critical outputs using Vault (transit) and records to Rekor (placeholder).
+
+Notes:
+- This is a reference implementation: replace provider call code with vendor SDKs and secure key ways.
+- Ensure environment variables are populated for provider API keys and MCP/Vault endpoints.
+"""
+import os
+import yaml
+import time
+import json
+from typing import Optional
+from fastapi import FastAPI, HTTPException, Request
+from pydantic import BaseModel
+import httpx
+from prometheus_client import Counter, Histogram, start_http_server
+
+# Metrics
+REQS = Counter("aegis_llm_requests_total", "Total LLM adapter requests", ["provider"])
+LATENCY = Histogram("aegis_llm_latency_seconds", "LLM request latency seconds", ["provider"])
+ERRS = Counter("aegis_llm_errors_total", "LLM adapter errors", ["provider"])
+
+app = FastAPI(title="Aegis LLM Adapter")
+
+# Load config file (default path)
+CFG_PATH = os.environ.get("AEGIS_LLM_ROUTER_CONFIG", "/app/config.yaml")
+if os.path.exists(CFG_PATH):
+    with open(CFG_PATH, "r") as f:
+        ROUTER_CFG = yaml.safe_load(f)
+else:
+    ROUTER_CFG = {"default": {"provider": "openai", "model": "gpt-4o"}, "routes": []}
+
+# Environment-driven endpoints / keys (placeholders)
+OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY", "")
+ANTHROPIC_API_KEY = os.environ.get("ANTHROPIC_API_KEY", "")
+GOOGLE_API_KEY = os.environ.get("GOOGLE_API_KEY", "")
+MCP_URL = os.environ.get("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")
+REKOR_URL = os.environ.get("REKOR_URL", "")
+
+class GenerateRequest(BaseModel):
+    task: Optional[str] = None
+    sensitivity: Optional[str] = "low"   # low|medium|high
+    input: str
+    metadata: Optional[dict] = {}
+
+class GenerateResponse(BaseModel):
+    provider: str
+    model: str
+    output: str
+    provenance: dict
+
+def select_route(req: GenerateRequest):
+    # simple rule evaluator: match sensitivity or task keys
+    for route in ROUTER_CFG.get("routes", []):
+        match = route.get("match", {})
+        ok = True
+        if "sensitivity" in match:
+            ok = ok and (req.sensitivity == match["sensitivity"])
+        if "task" in match:
+            ok = ok and (req.task == match["task"])
+        if ok:
+            return route
+    return ROUTER_CFG.get("default", {"provider": "openai", "model": "gpt-4o"})
+
+async def call_openai(prompt: str, model: str):
+    if not OPENAI_API_KEY:
+        raise RuntimeError("OPENAI_API_KEY not configured")
+    url = "https://api.openai.com/v1/chat/completions"
+    headers = {"Authorization": f"Bearer {OPENAI_API_KEY}"}
+    payload = {"model": model, "messages": [{"role":"user","content":prompt}], "max_tokens": 1024}
+    async with httpx.AsyncClient(timeout=30.0) as client:
+        r = await client.post(url, headers=headers, json=payload)
+        r.raise_for_status()
+        j = r.json()
+        # Simplified extraction
+        text = j["choices"][0]["message"]["content"]
+        usage = j.get("usage", {})
+        return text, usage
+
+async def call_anthropic(prompt: str, model: str):
+    # Use Anthropic's simple completion endpoint (placeholder)
+    if not ANTHROPIC_API_KEY:
+        raise RuntimeError("ANTHROPIC_API_KEY not configured")
+    url = "https://api.anthropic.com/v1/complete"
+    headers = {"x-api-key": ANTHROPIC_API_KEY}
+    payload = {"model": model, "prompt": prompt, "max_tokens_to_sample": 1024}
+    async with httpx.AsyncClient(timeout=30.0) as client:
+        r = await client.post(url, headers=headers, json=payload)
+        r.raise_for_status()
+        j = r.json()
+        text = j.get("completion","")
+        usage = j.get("usage", {})
+        return text, usage
+
+async def call_google(prompt: str, model: str):
+    # Placeholder for Google Vertex/AIP calls (using REST). Real integration should use google cloud client libs & private endpoint.
+    if not GOOGLE_API_KEY:
+        raise RuntimeError("GOOGLE_API_KEY not configured")
+    url = f"https://us-central1-aiplatform.googleapis.com/v1/projects/YOUR_PROJECT/locations/us-central1/publishers/google/models/{model}:predict?key={GOOGLE_API_KEY}"
+    payload = {"instances": [{"content": prompt}]}
+    async with httpx.AsyncClient(timeout=30.0) as client:
+        r = await client.post(url, json=payload)
+        r.raise_for_status()
+        j = r.json()
+        text = j.get("predictions", [{}])[0].get("content", "")
+        usage = {}
+        return text, usage
+
+async def persist_evidence(request: GenerateRequest, provider: str, model: str, response: str, usage: dict, signed: bool=False, signature: Optional[str]=None):
+    # Record the interaction as an evidence entry in MCP
+    payload = {
+        "schema_version": "1.1",
+        "model_id": request.metadata.get("model_id","llm-call"),
+        "version": request.metadata.get("model_version","v0"),
+        "artifact": {"uri": "", "digest": ""},
+        "mlflow": {},
+        "build": {"ci_run_id": request.metadata.get("ci_run_id")},
+        "datasets": [],
+        "feature_store": {},
+        "lineage": {},
+        "training_job": {},
+        "explainability": {},
+        "attestations": [],
+        "hil_approvals": [],
+        "notes": "",
+        "llm_call": {
+            "input": request.input,
+            "provider": provider,
+            "model": model,
+            "response": response,
+            "usage": usage,
+            "signed": signed,
+            "signature": signature,
+            "metadata": request.metadata,
+            "timestamp": int(time.time())
+        }
+    }
+    try:
+        async with httpx.AsyncClient(timeout=5.0) as client:
+            await client.post(f"{MCP_URL}/model-context", json=payload)
+    except Exception:
+        # best-effort: do not fail the LLM call if MCP is unreachable
+        pass
+
+@app.post("/v1/generate", response_model=GenerateResponse)
+async def generate(req: GenerateRequest):
+    route = select_route(req)
+    provider = route.get("provider")
+    model = route.get("model")
+    REQS.labels(provider=provider).inc()
+    start = time.time()
+    try:
+        if provider == "openai":
+            out, usage = await call_openai(req.input, model)
+        elif provider == "anthropic":
+            out, usage = await call_anthropic(req.input, model)
+        elif provider == "google":
+            out, usage = await call_google(req.input, model)
+        else:
+            raise HTTPException(status_code=400, detail=f"unknown provider {provider}")
+    except Exception as e:
+        ERRS.labels(provider=provider).inc()
+        raise HTTPException(status_code=502, detail=str(e))
+    elapsed = time.time() - start
+    LATENCY.labels(provider=provider).observe(elapsed)
+
+    # If high sensitivity, optionally sign output (best-effort; placeholder)
+    signed = False
+    signature = None
+    if req.sensitivity == "high" and VAULT_ADDR and VAULT_TOKEN:
+        # Placeholder for Vault transit sign call
+        try:
+            async with httpx.AsyncClient(timeout=3.0) as client:
+                # This is a placeholder; in production call Vault transit/sign endpoint with proper auth
+                signature = "vault-signature-placeholder"
+                signed = True
+        except Exception:
+            signed = False
+
+    # Persist evidence (fire-and-forget)
+    try:
+        await persist_evidence(req, provider, model, out, usage, signed=signed, signature=signature)
+    except Exception:
+        pass
+
+    return {"provider": provider, "model": model, "output": out, "provenance": {"signed": signed, "signature": signature}}
+
+@app.on_event("startup")
+async def _startup():
+    # start prometheus metrics server on port from env (optional)
+    metrics_port = int(os.environ.get("AEGIS_LLM_METRICS_PORT", "9400"))
+    start_http_server(metrics_port)
+
