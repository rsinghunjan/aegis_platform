+#!/usr/bin/env python3
+"""
+Agent orchestration manager
+ - Coordinates perception -> planner -> executor loop
+ - Integrates RAG retrieval, safety checks, E-STOP/HIL safety adapter, action logging and retrying
+ - Exposes a simple REST API to submit tasks and query action logs
+"""
+from flask import Flask, request, jsonify
+import argparse, threading, json, time, os
+from ops.agent.executor_with_retries import execute_action, log_action, ActionAdapter, EStop
+
+app = Flask(__name__)
+ACTION_LOG="/tmp/agent_action_log.ndjson"
+
+@app.route("/submit", methods=["POST"])
+def submit():
+    payload = request.get_json() or {}
+    task = payload.get("task")
+    # naive planning: map task to actions; operator should integrate real planner
+    actions = payload.get("actions", [{"type":"navigate"},{"type":"align"},{"type":"act"}])
+    estop = EStop()
+    adapter = ActionAdapter()
+    results=[]
+    for a in actions:
+        res = execute_action(adapter, a, retries=3, backoff=1.0, timeout_s=5.0, estop=estop)
+        entry = {"task": task, "action": a, "result": res, "ts": time.time()}
+        log_action(ACTION_LOG, entry)
+        results.append(entry)
+        if res.get("status") != "ok":
+            break
+    return jsonify({"results": results})
+
+@app.route("/logs", methods=["GET"])
+def logs():
+    out=[]
+    if os.path.exists(ACTION_LOG):
+        with open(ACTION_LOG) as fh:
+            for l in fh:
+                out.append(json.loads(l))
+    return jsonify(out)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--host", default="0.0.0.0")
+    p.add_argument("--port", type=int, default=8300)
+    args = p.parse_args()
+    app.run(host=args.host, port=args.port)
+
+if __name__ == "__main__":
+    main()
+
