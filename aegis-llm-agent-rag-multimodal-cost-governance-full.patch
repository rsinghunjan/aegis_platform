+#!/usr/bin/env python3
+"""
+Create TFRecord shards from multimodal synthetic samples (metadata + paths to sensor files)
+ - Operator must ensure actual sensor files produced by CARLA or other sim are present
+"""
+import argparse, os, json
+import tensorflow as tf
+
+def _bytes_feature(v):
+    return tf.train.Feature(bytes_list=tf.train.BytesList(value=[v.encode() if isinstance(v,str) else v]))
+
+def sample_to_example(sample_meta):
+    # sample_meta is a dict with keys: camera, lidar, labels, timestamp
+    f = {}
+    f["id"] = _bytes_feature(str(sample_meta.get("id","")).encode())
+    f["timestamp"] = _bytes_feature(str(sample_meta.get("timestamp","")))
+    f["camera_path"] = _bytes_feature(sample_meta.get("camera",""))
+    f["lidar_path"] = _bytes_feature(sample_meta.get("lidar",""))
+    f["labels"] = _bytes_feature(json.dumps(sample_meta.get("labels",[])))
+    return tf.train.Example(features=tf.train.Features(feature=f))
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--meta-dir", required=True, help="directory containing per-sample JSON metadata")
+    p.add_argument("--out", required=True, help="output tfrecord prefix")
+    p.add_argument("--shard-size", type=int, default=1000)
+    args = p.parse_args()
+    metas = sorted([os.path.join(args.meta_dir,f) for f in os.listdir(args.meta_dir) if f.endswith(".json")])
+    shard_idx=0
+    writer=None
+    count=0
+    for m in metas:
+        s = json.load(open(m))
+        if count % args.shard_size == 0:
+            if writer:
+                writer.close()
+            shard_path = f"{args.out}_shard_{shard_idx:04d}.tfrecord"
+            writer = tf.io.TFRecordWriter(shard_path)
+            shard_idx += 1
+        ex = sample_to_example(s)
+        writer.write(ex.SerializeToString())
+        count += 1
+    if writer:
+        writer.close()
+    manifest = {"shards": shard_idx, "count": count}
+    print("Wrote tfrecord shards:", manifest)
+
+if __name__ == "__main__":
+    main()
+
