+#!/usr/bin/env python3
+"""
+Tokenizer and dataset shard preparation for LLM training.
+ - Builds tokenizer snapshot (HuggingFace tokenizers) and creates JSONL shards with optional shuffling.
+"""
+import argparse, os, json, random
+from pathlib import Path
+from tokenizers import ByteLevelBPETokenizer
+
+def build_tokenizer(files, outdir, vocab_size=52000):
+    os.makedirs(outdir, exist_ok=True)
+    tok = ByteLevelBPETokenizer()
+    tok.train(files=files, vocab_size=vocab_size, min_frequency=2)
+    tok.save_model(outdir)
+    return outdir
+
+def shard_jsonl(path, outdir, shard_size=100000, shuffle=False):
+    os.makedirs(outdir, exist_ok=True)
+    with open(path) as fh:
+        lines = fh.readlines()
+    if shuffle:
+        random.shuffle(lines)
+    manifest=[]
+    for i in range(0, len(lines), shard_size):
+        shard = lines[i:i+shard_size]
+        p = os.path.join(outdir, f"shard_{i//shard_size:05d}.jsonl")
+        with open(p, "w") as of:
+            of.writelines(shard)
+        manifest.append(p)
+    mpath = os.path.join(outdir, "shard_manifest.json")
+    with open(mpath, "w") as mh:
+        json.dump({"shards": manifest, "count": len(lines)}, mh, indent=2)
+    return mpath
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--dataset", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--shard-size", type=int, default=100000)
+    p.add_argument("--tokenizer-out", default=None)
+    p.add_argument("--shuffle", action="store_true")
+    args = p.parse_args()
+    manifest = shard_jsonl(args.dataset, args.out, args.shard_size, args.shuffle)
+    print("Shard manifest:", manifest)
+    if args.tokenizer_out:
+        tok = build_tokenizer([args.dataset], args.tokenizer_out)
+        print("Tokenizer saved to:", tok)
+
+if __name__ == "__main__":
+    main()
+
