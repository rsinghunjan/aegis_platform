+"""
+Hallucination & confidence detector
+ - Given a candidate LLM response and grounding contexts, compute a simple hallucination score
+ - This script is pluggable into RAG service or CI evaluation for generated outputs
+"""
+import argparse, json, math
+
+def score_response(response_text, contexts):
+    # Placeholder heuristic:
+    #   - penalize responses that contain low-confidence tokens like "I don't know"
+    #   - reward n-gram overlap with contexts
+    low_confidence_phrases = ["i don't know", "not sure", "i'm not sure", "cannot verify"]
+    score = 0.5
+    lt = response_text.lower()
+    for p in low_confidence_phrases:
+        if p in lt:
+            score -= 0.3
+    # overlap heuristic
+    overlap = 0
+    for c in contexts:
+        if c.lower() in lt:
+            overlap += 1
+    score += min(0.5, 0.05 * overlap)
+    return max(0.0, min(1.0, score))
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--response", required=True)
+    p.add_argument("--contexts", nargs="*", default=[])
+    args = p.parse_args()
+    s = score_response(args.response, args.contexts)
+    print(json.dumps({"score": s}))
+
+if __name__ == "__main__":
+    main()
