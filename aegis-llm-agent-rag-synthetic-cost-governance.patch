+#!/usr/bin/env python3
+"""
+Simple RAG service (Flask)
+ - Loads a vector index, retrieves top-k documents, then calls a local LLM inference endpoint
+ - Implements a simple hallucination/confidence filter based on LLM-provided score or fallback heuristics
+"""
+from flask import Flask, request, jsonify
+import argparse, json, requests, os
+
+app = Flask(__name__)
+
+def retrieve(query, index_path, k=4):
+    # Placeholder: call FAISS or vector DB; here we return empty contexts
+    return [{"text": "context for query", "score": 0.9}]
+
+def call_llm(prompt, llm_endpoint):
+    try:
+        r = requests.post(llm_endpoint, json={"prompt": prompt}, timeout=30)
+        return r.json()
+    except Exception as e:
+        return {"error": str(e)}
+
+def hallucination_check(llm_resp, threshold=0.3):
+    # Placeholder: prefer LLM to return a 'confidence' float; otherwise fallback to heuristics
+    conf = llm_resp.get("confidence", None)
+    if conf is None:
+        # fallback: if 'unknown' token or 'I don't know' in text, treat low confidence
+        txt = llm_resp.get("text","").lower()
+        if "i don't know" in txt or "i'm not sure" in txt:
+            return False
+        return True
+    return conf >= threshold
+
+@app.route("/query", methods=["POST"])
+def query():
+    data = request.get_json() or {}
+    query = data.get("query","")
+    idx = data.get("index_path","./index.faiss")
+    llm = data.get("llm_endpoint","http://localhost:8000/infer")
+    ctxs = retrieve(query, idx)
+    prompt = query + "\n\nCONTEXT:\n" + "\n\n".join([c["text"] for c in ctxs])
+    resp = call_llm(prompt, llm)
+    ok = hallucination_check(resp)
+    return jsonify({"ok": ok, "response": resp, "contexts": ctxs})
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--host", default="0.0.0.0")
+    p.add_argument("--port", type=int, default=8100)
+    args = p.parse_args()
+    app.run(host=args.host, port=args.port)
