+#!/usr/bin/env python3
+"""
+Sharded training launcher for large generative models
+ - Launches distributed training (torchrun) with dataset shard manifest
+ - Integrates simple cost quota checks and optional spot preemption/backoff
+ - Records run manifest via ops.sdk.evidence_sdk.record_manifest
+
+Usage:
+  python3 sharded_train_launcher.py --shard-manifest /path/shards/shard_manifest.json --train-script train.py --gpus-per-node 8 --nodes 4 --out /tmp/train_run --cost-slo 500
+"""
+import argparse, json, os, subprocess, time
+from datetime import datetime
+
+def load_manifest(path):
+    return json.load(open(path))
+
+def estimate_cost(nodes, gpus_per_node, hours, cost_per_gpu_hour=0.5):
+    return nodes * gpus_per_node * hours * cost_per_gpu_hour
+
+def run_distributed(train_script, node_rank, nnodes, nproc_per_node, args_env):
+    # Build torchrun command
+    cmd = ["torchrun", "--nnodes", str(nnodes), "--nproc_per_node", str(nproc_per_node), train_script]
+    print("Launching:", " ".join(cmd))
+    env = os.environ.copy()
+    env.update(args_env)
+    return subprocess.call(cmd, env=env)
+
+def record_manifest_safe(key, meta):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest(key, meta)
+    except Exception:
+        pass
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--shard-manifest", required=True)
+    p.add_argument("--train-script", required=True)
+    p.add_argument("--out", default=f"/tmp/train_{int(time.time())}")
+    p.add_argument("--gpus-per-node", type=int, default=8)
+    p.add_argument("--nodes", type=int, default=1)
+    p.add_argument("--hours", type=float, default=1.0)
+    p.add_argument("--cost-slo", type=float, default=1000.0, help="Max $ estimate for this run")
+    p.add_argument("--spot", action="store_true", help="Allow spot/preemptible instances")
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    manifest = load_manifest(args.shard_manifest)
+    est = estimate_cost(args.nodes, args.gpus_per_node, args.hours)
+    if est > args.cost_slo:
+        print(f"Estimated cost ${est:.2f} exceeds cost_slo ${args.cost_slo:.2f}. Aborting.")
+        raise SystemExit(2)
+    # Best-effort: set environment for distributed run
+    env = {"AEGIS_TRAIN_OUT": args.out, "AEGIS_SPOT_ALLOWED": str(bool(args.spot))}
+    rc = run_distributed(args.train_script, 0, args.nodes, args.gpus_per_node, env)
+    manifest_path = os.path.join(args.out, "run_manifest.json")
+    run_meta = {"started_at": datetime.utcnow().isoformat()+"Z", "rc": rc, "shard_count": len(manifest.get("shards",[]))}
+    with open(manifest_path, "w") as fh:
+        json.dump(run_meta, fh, indent=2)
+    record_manifest_safe("llm_train_run", {"out": args.out, "manifest": manifest_path})
+    print("Training finished. Manifest:", manifest_path)
+
+if __name__ == "__main__":
+    import json, time
+    main()
+
