+def build_faiss_index(embs, out_path):
+    try:
+        import faiss
+    except Exception:
+        with open(out_path+".json","w") as fh:
+            json.dump({"note":"faiss_missing","count": len(embs.tolist())}, fh)
+        return False
+    d = embs.shape[1]
+    index = faiss.IndexFlatL2(d)
+    index.add(embs)
+    faiss.write_index(index, out_path)
+    return True
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--docs", required=True, help="JSONL of documents with 'text' field")
+    p.add_argument("--out-index", required=True)
+    p.add_argument("--s3", default="")
+    args = p.parse_args()
+    texts=[]
+    with open(args.docs) as fh:
+        for l in fh:
+            j=json.loads(l)
+            texts.append(j.get("text",""))
+    embs = embed_texts(texts)
+    ok = build_faiss_index(embs, args.out_index)
+    manifest = {"index": args.out_index, "count": len(texts), "built_at": datetime.utcnow().isoformat()+"Z", "ok": ok}
+    manifest_path = args.out_index + ".manifest.json"
