+#!/usr/bin/env python3
+"""
+Prometheus exporter for LLM/diffusion inference latency & SLOs
+ - Polls model endpoints (inference /metrics or `/health`) and exports p50/p95/p99 and error rate
+"""
+from prometheus_client import start_http_server, Gauge, Counter
+import requests, time, argparse, threading
+
+P50 = Gauge("aegis_llm_p50_ms", "LLM p50 latency ms", ["service"])
+P95 = Gauge("aegis_llm_p95_ms", "LLM p95 latency ms", ["service"])
+P99 = Gauge("aegis_llm_p99_ms", "LLM p99 latency ms", ["service"])
+ERR = Counter("aegis_llm_inference_errors_total", "LLM inference errors", ["service"])
+
+def probe_loop(endpoint, service, interval):
+    while True:
+        try:
+            r = requests.get(endpoint, timeout=5)
+            if r.status_code==200:
+                j = r.json()
+                if "latencies" in j:
+                    P50.labels(service=service).set(j["latencies"].get("p50_ms",0))
+                    P95.labels(service=service).set(j["latencies"].get("p95_ms",0))
+                    P99.labels(service=service).set(j["latencies"].get("p99_ms",0))
+            else:
+                ERR.labels(service=service).inc()
+        except Exception:
+            ERR.labels(service=service).inc()
+        time.sleep(interval)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--listen", default="0.0.0.0:9202")
+    p.add_argument("--probe", action="append", help="endpoint,service,interval")
+    args = p.parse_args()
+    host, port = args.listen.split(":")
+    start_http_server(int(port), addr=host)
+    for pr in args.probe or []:
+        endpoint, service, interval = pr.split(",",2)
+        t = threading.Thread(target=probe_loop, args=(endpoint,service,int(interval)), daemon=True)
+        t.start()
+    print("Exporter running on", args.listen)
+    while True:
+        time.sleep(60)
+
+if __name__ == "__main__":
+    main()
+
