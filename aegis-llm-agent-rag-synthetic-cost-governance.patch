+#!/usr/bin/env python3
+"""
+Agent executor with retries, logged action trace and runtime constraints
+ - Executes actions via an adapter, retries on failure with backoff, logs to action log (NDJSON)
+ - Enforces per-action runtime constraint (deadline). Integrates with E-STOP adapter.
+"""
+import argparse, time, json, os, threading
+from datetime import datetime, timedelta
+
+class ActionAdapter:
+    def execute(self, action, timeout_s):
+        # Placeholder: actual adapter should call controller/HIL API
+        time.sleep(min(0.2, timeout_s))
+        return {"status":"ok", "action": action}
+
+class EStop:
+    def __init__(self, estop_endpoint=None):
+        self.endpoint = estop_endpoint
+    def engaged(self):
+        # Best-effort: query endpoint
+        return False
+
+def execute_action(adapter, action, retries, backoff, timeout_s, estop):
+    attempt = 0
+    while attempt <= retries:
+        if estop and estop.engaged():
+            return {"status":"estop", "attempt": attempt}
+        start = datetime.utcnow()
+        try:
+            res = adapter.execute(action, timeout_s)
+            if res.get("status") == "ok":
+                return {"status":"ok", "attempt": attempt, "result": res}
+            else:
+                attempt += 1
+                time.sleep(backoff * attempt)
+        except Exception as e:
+            attempt += 1
+            time.sleep(backoff * attempt)
+    return {"status":"failed", "attempts": attempt}
+
+def log_action(log_path, entry):
+    with open(log_path, "a") as fh:
+        fh.write(json.dumps(entry)+"\n")
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--actions-file", required=True, help="NDJSON list of actions")
+    p.add_argument("--out-log", default="/tmp/action_log.ndjson")
+    p.add_argument("--retries", type=int, default=3)
+    p.add_argument("--backoff", type=float, default=1.0)
+    p.add_argument("--timeout", type=float, default=5.0)
+    args = p.parse_args()
+    adapter = ActionAdapter()
+    estop = EStop()
+    with open(args.actions_file) as fh:
+        for l in fh:
+            action = json.loads(l)
+            start = datetime.utcnow().isoformat()+"Z"
+            result = execute_action(adapter, action, args.retries, args.backoff, args.timeout, estop)
+            entry = {"action": action, "started_at": start, "result": result}
+            log_action(args.out_log, entry)
+            if result.get("status") != "ok":
+                print("Action failed or aborted:", action, result)
+
+if __name__ == "__main__":
+    main()
+
