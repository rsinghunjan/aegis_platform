*** Add File:ops/ml/deepspeed/launch_deepspeed.sh
+#!/usr/bin/env bash
+set -euo pipefail
+DEEPSPEED_CONFIG=${1:-"/workspace/deepspeed_config.json"}
+SHARD_MANIFEST=${2:-"/data/shard_manifest.json"}
+NUM_NODES=${3:-1}
+GPUS_PER_NODE=${4:-8}
+
+echo "DeepSpeed launcher: num_nodes=${NUM_NODES} gpus_per_node=${GPUS_PER_NODE}"
+# set NCCL tuning envs recommended for your cloud
+export NCCL_DEBUG=${NCCL_DEBUG:-WARN}
+export NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-eth0}
+export TORCHELASTIC_RETRY=3
+
+# use deepspeed CLI to launch distributed training
+deepspeed --num_nodes ${NUM_NODES} --num_gpus ${GPUS_PER_NODE} train.py --deepspeed ${DEEPSPEED_CONFIG} --shard-manifest ${SHARD_MANIFEST}
+
