*** Add File:ops/poa/e2e_poa_demo.sh
+#!/usr/bin/env bash
+set -euo pipefail
+#
+# End-to-end PoA demo:
+# 1) Promote a prompt from Prompt Registry -> staging (bundled + signed)
+# 2) Build/run ADK sample agent using promoted prompt (sim executor)
+# 3) Run retrieval (FAISS) to collect topK docs
+# 4) Send composed prompt to model endpoint (Triton/vLLM)
+# 5) Collect outputs, make grounding check and bundle evidence (signed)
+
+PROMPT_ID=${1:-"demo_prompt"}
+PROMPT_REGISTRY=${PROMPT_REGISTRY_URL:-"http://prompt-registry:5003"}
+MODEL_ENDPOINT=${MODEL_ENDPOINT:-"http://triton:8000"}
+COSIGN=${COSIGN_KMS_URI:-""}
+OUT_DIR=${OUT_DIR:-/tmp/aegis_poa_demo_$(date +%s)}
+mkdir -p "$OUT_DIR"
+
+echo "[1] Promote prompt via registry"
+curl -s -X POST "$PROMPT_REGISTRY/prompts/$PROMPT_ID/promote" -H "Content-Type: application/json" -d '{"env":"staging"}' -o "$OUT_DIR/prompt_promote.json" || true
+
+echo "[2] Run ADK sample agent using promoted prompt"
+# For demo: sample_agent reads prompt from local file; in production map registry → runtime
+python3 ops/adk/sample_agent/sample_agent.py --goal '{"command":"status"}' --out "$OUT_DIR/adk" --cosign "$COSIGN" || true
+
+echo "[3] Retrieval: run FAISS search (placeholder)"
+# Query FAISS using local script: replace with your retriever endpoint
+python3 - <<PY
+from ops.retrieval.faiss.index_builder import build_index
+print("FAISS retrieval placeholder - point this to your retriever")
+PY
+
+echo "[4] Model inference: call Triton/vLLM"
+python3 - <<PY
+import requests, json, os
+payload = {"inputs":"Context: example\\n\\nQuestion: what is the status?\\nAnswer:"}
+try:
+    r = requests.post("${MODEL_ENDPOINT}/v2/models/aegis-llm/infer", json=payload, timeout=10)
+    open("$OUT_DIR/model_output.json","w").write(r.text)
+    print("Model output captured")
+except Exception as e:
+    print("Model call failed:", e)
+PY
+
+echo "[5] Grounding check & bundle evidence"
+python3 ops/eval/grounding/grounding_checker.py > "$OUT_DIR/grounding_check.txt" || true
+python3 - <<PY
+from ops.adk.sdk.evidence import bundle_evidence
+files = ["$OUT_DIR/model_output.json","$OUT_DIR/grounding_check.txt","$OUT_DIR/adk/trace.ndjson"]
+out = "$OUT_DIR/poa_evidence.tar.gz"
+bundle_evidence(files, out, metadata={"prompt_id":"$PROMPT_ID"}, cosign_key="${COSIGN}")
+print("Wrote evidence to", out)
+PY
+
+echo "E2E PoA demo complete. Evidence at $OUT_DIR"
+
