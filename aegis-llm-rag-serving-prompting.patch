+"""
+Dynamic context truncation helper
+ - Computes truncation budget per-request based on current tokens/sec and budget
+ - Simple policy: if global tokens/sec > threshold reduce context_length proportionally
+"""
+import os, json
+
+def compute_truncation(current_tokens_per_sec, threshold=10000, base_context=2048):
+    if current_tokens_per_sec <= threshold:
+        return base_context
+    factor = threshold / float(current_tokens_per_sec)
+    return max(256, int(base_context * factor))
+
+if __name__=="__main__":
+    print("Truncation example:", compute_truncation(15000))
+
