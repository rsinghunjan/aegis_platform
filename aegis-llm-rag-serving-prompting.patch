+"""
+Minimal Milvus connector example (pymilvus).
+Implements insert and search wrappers.
+"""
+from pymilvus import connections, CollectionSchema, FieldSchema, DataType, Collection
+import numpy as np
+
+def connect(host="localhost", port="19530"):
+    connections.connect(host=host, port=port)
+
+def create_collection(name, dim):
+    fields = [
+        FieldSchema(name="id", dtype=DataType.INT64, is_primary=True, auto_id=True),
+        FieldSchema(name="emb", dtype=DataType.FLOAT_VECTOR, dim=dim)
+    ]
+    schema = CollectionSchema(fields, description="Aegis embeddings")
+    coll = Collection(name, schema)
+    return coll
+
+def insert_vectors(collection, vectors):
+    collection.insert([vectors])
+
+def search_vectors(collection, qvecs, topk=5):
+    results = collection.search(qvecs, "emb", params={"metric_type":"L2","params":{"nprobe":10}}, limit=topk)
+    return results
+
