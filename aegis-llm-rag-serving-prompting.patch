+
+def new_session(session_id=None, persona=None):
+    sid = session_id or str(int(time.time()*1000))
+    path = os.path.join(STORE_DIR, sid + ".json")
+    state = {"session_id": sid, "persona": persona or {}, "history": [], "tokens_used": 0, "created_at": time.time()}
+    with open(path, "w") as fh:
+        json.dump(state, fh)
+    return sid
+
+def load_session(session_id):
+    path = os.path.join(STORE_DIR, session_id + ".json")
+    if not os.path.exists(path):
+        return None
+    return json.load(open(path))
+
+def append_turn(session_id, user, assistant, tokens):
+    s = load_session(session_id)
+    if not s:
+        return
+    s["history"].append({"user": user, "assistant": assistant, "ts": time.time()})
+    s["tokens_used"] += tokens
+    with open(os.path.join(STORE_DIR, session_id + ".json"), "w") as fh:
+        json.dump(s, fh)
