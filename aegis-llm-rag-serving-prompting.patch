+"""
+Tool sandboxing helper (very small example)
+ - Runs external tool commands with timeouts & resource limits (ulimit wrapper recommended)
+ - Records tool stdout/stderr and returns signed evidence reference via evidence helper
+"""
+import subprocess, shlex, tempfile, os, time
+from ops.adk.sdk.evidence import bundle_evidence
+
+def run_tool(cmd, timeout=5, outdir="/tmp/tool_sandbox"):
+    os.makedirs(outdir, exist_ok=True)
+    proc = subprocess.Popen(shlex.split(cmd), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    try:
+        out, err = proc.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        proc.kill()
+        out, err = proc.communicate()
+        return {"status":"timeout", "stdout": out.decode(), "stderr": err.decode()}
+    # write outputs
+    ofile = os.path.join(outdir, f"tool_stdout_{int(time.time())}.txt")
+    with open(ofile,"wb") as fh:
+        fh.write(out)
+    efile = os.path.join(outdir, f"tool_stderr_{int(time.time())}.txt")
+    with open(efile,"wb") as fh:
+        fh.write(err)
+    bundle = bundle_evidence([ofile, efile], os.path.join(outdir,"tool_evidence.tar.gz"))
+    return {"status":"ok","bundle":bundle}
