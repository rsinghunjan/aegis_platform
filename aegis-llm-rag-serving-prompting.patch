+"""
+Prompt templating library
+ - Versioned templates with variable substitution and rendering
+ - Stores template metadata for provenance (author, version, description)
+"""
+import json, os, uuid
+from jinja2 import Template
+
+TEMPLATES_DIR = "ops/prompt/templates_store"
+os.makedirs(TEMPLATES_DIR, exist_ok=True)
+
+def save_template(name, text, metadata=None):
+    meta = metadata or {}
+    meta.setdefault("name", name)
+    meta.setdefault("version", "v1")
+    meta.setdefault("id", str(uuid.uuid4()))
+    path = os.path.join(TEMPLATES_DIR, f"{name}.json")
+    with open(path, "w") as fh:
+        json.dump({"template": text, "meta": meta}, fh, indent=2)
+    return path
+
+def render_template(name, variables):
+    path = os.path.join(TEMPLATES_DIR, f"{name}.json")
+    with open(path) as fh:
+        obj = json.load(fh)
+    tmpl = Template(obj["template"])
+    return tmpl.render(**variables)
+
