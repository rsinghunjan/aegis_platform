+#!/usr/bin/env python3
+"""
+FAISS index builder with IVF+PQ example.
+Builds index from embeddings and persists to disk.
+"""
+import argparse, os, numpy as np
+import faiss
+
+def build_index(embeddings_path, dim, nlist=4096, m=64, out_index="faiss.index"):
+    xb = np.load(embeddings_path)  # shape (N, dim)
+    print("Loaded embeddings:", xb.shape)
+    quant = faiss.IndexFlatL2(dim)
+    index = faiss.IndexIVFPQ(quant, dim, nlist, m, 8)
+    index.train(xb)
+    index.add(xb)
+    faiss.write_index(index, out_index)
+    print("Wrote index to", out_index)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--embeddings", required=True)
+    p.add_argument("--dim", type=int, required=True)
+    p.add_argument("--out", default="faiss.index")
+    args = p.parse_args()
+    build_index(args.embeddings, args.dim, out_index=args.out)
