+#!/usr/bin/env python3
+"""
+Streaming proxy for LLM backend with incremental safety checks and token accounting.
+
+Flow:
+ - Accept client request (HTTP POST or websocket)
+ - Forward to LLM backend streaming endpoint (HTTP chunked or websockets)
+ - For each chunk/token batch:
+     - Run lightweight safety check (safety_stream_checker.check_chunk)
+     - Emit partial tokens to client
+     - Accumulate token count and periodically call DP charge endpoint
+ - If a chunk is high-confidence blocked: stop stream, log evidence and POST event to orchestrator
+"""
+import os, requests, logging, time, json
+from flask import Flask, request, Response, stream_with_context
+from safety_stream_checker import check_chunk
+
+LOG = logging.getLogger("aegis.llm.streaming")
+logging.basicConfig(level=logging.INFO)
+
+LLM_BACKEND = os.environ.get("LLM_BACKEND", "http://vllm.model-serving.svc.cluster.local:8080/generate_stream")
+DP_SERVICE = os.environ.get("DP_SERVICE_URL", "http://dp-service:8084")
+ORCH_WEBHOOK = os.environ.get("ORCH_WEBHOOK", "http://aegis-orchestrator.aegis-system.svc.cluster.local:8088/webhook")
+DP_AUTH = os.environ.get("DP_AUTH_TOKEN", "")
+CHARGE_INTERVAL_TOKENS = int(os.environ.get("CHARGE_INTERVAL_TOKENS", "128"))
+
+app = Flask("aegis-llm-proxy")
+
+def charge_dp(client_id, tokens):
+    if not client_id:
+        return False
+    headers = {"Authorization": f"Bearer {DP_AUTH}"} if DP_AUTH else {}
+    try:
+        r = requests.post(f"{DP_SERVICE}/charge", json={"client": client_id, "tokens": tokens}, headers=headers, timeout=3)
+        return r.status_code == 200
+    except Exception:
+        LOG.exception("dp charge failed")
+        return False
+
+def forward_stream(payload, headers):
+    """
+    Forward to LLM backend and yield chunks to client.
+    Backend is expected to stream newline-delimited JSON chunks with 'token' or 'text'.
+    """
+    with requests.post(LLM_BACKEND, json=payload, stream=True, headers=headers, timeout=60) as r:
+        for line in r.iter_lines(decode_unicode=True):
+            if not line:
+                continue
+            try:
+                chunk = json.loads(line)
+            except Exception:
+                chunk = {"text": line}
+            yield chunk
+
+@app.route("/generate", methods=["POST"])
+def generate():
+    req = request.get_json() or {}
+    client_id = req.get("client_id")
+    payload = req
+    headers = {}
+    token_accum = 0
+
+    def stream():
+        nonlocal token_accum
+        for chunk in forward_stream(payload, headers):
+            text = chunk.get("text","")
+            tokens = chunk.get("tokens", len(text.split()))
+            # lightweight incremental safety check
+            score, reason = check_chunk(text)
+            LOG.debug("chunk score=%s reason=%s", score, reason)
+            if score >= 0.95:
+                # high-confidence block: trigger orchestrator and stop
+                event = {"id": f"auto-{int(time.time())}", "model_env": payload.get("model_env","staging"), "score": score, "model":"llm-backend"}
+                try:
+                    requests.post(ORCH_WEBHOOK, json=event, timeout=2)
+                except Exception:
+                    LOG.exception("failed to notify orchestrator")
+                # send final block message
+                yield json.dumps({"status":"blocked","reason":reason}) + "\n"
+                return
+            # emit chunk to client
+            yield json.dumps({"status":"ok","text": text}) + "\n"
+            token_accum += tokens
+            # periodic DP charge
+            if token_accum >= CHARGE_INTERVAL_TOKENS:
+                ok = charge_dp(client_id, token_accum)
+                if not ok:
+                    LOG.warning("DP charge failed; enforcing fail-closed")
+                    # inform orchestrator
+                    try:
+                        requests.post(ORCH_WEBHOOK, json={"id":f"dp-{int(time.time())}","model_env":payload.get("model_env","prod"),"score":0.0,"dp_over_budget":True}, timeout=2)
+                    except Exception:
+                        pass
+                    yield json.dumps({"status":"blocked","reason":"dp_over_budget"}) + "\n"
+                    return
+                token_accum = 0
+
+    return Response(stream_with_context(stream()), content_type="application/x-ndjson")
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8089")), threaded=True)
+
