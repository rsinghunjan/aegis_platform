+#!/usr/bin/env python3
+"""
+Lightweight incremental safety checker for streaming tokens.
+Uses regex heuristics and a fast subset of detectors (e.g., simple PII regex + cached small model).
+For heavier analysis, the orchestrator/Argo workflows run full detectors on evidence bundles.
+"""
+import re, logging
+
+PII_RE = re.compile(r"\b(?:\d{3}-\d{2}-\d{4}|\d{4}\s?\d{4}\s?\d{4}\s?\d{4})\b")
+PROFANITY_RE = re.compile(r"\b(shit|damn|fuck)\b", re.I)
+
+LOG = logging.getLogger("aegis.safety.stream")
+logging.basicConfig(level=logging.INFO)
+
+def check_chunk(text):
+    """
+    Return (score, reason)
+    score: float 0..1 representing likelihood of disallowed content
+    reason: short string
+    """
+    if not text:
+        return 0.0, "empty"
+    if PII_RE.search(text):
+        return 0.97, "pii_detected"
+    if PROFANITY_RE.search(text):
+        return 0.6, "profanity"
+    # default low score
+    return 0.0, "ok"
+
