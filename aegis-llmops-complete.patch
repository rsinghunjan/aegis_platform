+#!/usr/bin/env python3
+"""
+Vector ingestion tool for Aegis: extracts features from artifacts and upserts to Milvus.
+Usage:
+  python3 ops/vector/ingest.py --collection models --source artifacts/model_embeddings.json
+"""
+import argparse, json, os
+from pymilvus import connections, FieldSchema, CollectionSchema, DataType, Collection
+
+def connect(uri="milvus.aegis-milvus.svc.cluster.local", port=19530):
+    connections.connect(host=uri, port=port)
+
+def ensure_collection(name, dim=1536):
+    fields = [
+        FieldSchema(name="id", dtype=DataType.INT64, is_primary=True, auto_id=False),
+        FieldSchema(name="embedding", dtype=DataType.FLOAT_VECTOR, dim=dim),
+        FieldSchema(name="meta", dtype=DataType.VARCHAR, max_length=65535)
+    ]
+    schema = CollectionSchema(fields, description="Aegis embeddings")
+    if name in Collection.list():
+        return Collection(name)
+    return Collection(name, schema)
+
+def upsert(collection_name, items):
+    col = ensure_collection(collection_name, dim=len(items[0]["embedding"]))
+    ids = [it["id"] for it in items]
+    embeddings = [it["embedding"] for it in items]
+    metas = [json.dumps(it.get("meta", {})) for it in items]
+    col.insert([ids, embeddings, metas])
+    col.flush()
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--collection", required=True)
+    ap.add_argument("--source", required=True)
+    args = ap.parse_args()
+    with open(args.source) as fh:
+        data = json.load(fh)
+    connect()
+    upsert(args.collection, data)
+    print("Upserted", len(data))
+
+if __name__ == "__main__":
+    main()
+
