+#!/usr/bin/env python3
+"""
+Data/model drift detector: compares recent inference distributions with baseline and raises alert.
+This is a minimal implementation: compute KL divergence on feature histograms or embed distances.
+"""
+import numpy as np, json, time, os
+from scipy.stats import entropy
+
+BASELINE_PATH = os.environ.get("DRIFT_BASELINE", "ops/drift/baseline.json")
+
+def load_baseline():
+    if os.path.exists(BASELINE_PATH):
+        return json.load(open(BASELINE_PATH))
+    return None
+
+def compute_hist(data, bins=50):
+    hist, _ = np.histogram(data, bins=bins, density=True)
+    hist = hist + 1e-12
+    return hist / hist.sum()
+
+def detect(current_samples):
+    baseline = load_baseline()
+    if not baseline:
+        print("No baseline; storing current as baseline")
+        json.dump({"ts": int(time.time()), "samples": current_samples[:1000]}, open(BASELINE_PATH,"w"))
+        return {"status":"baseline_created"}
+    b_hist = compute_hist(np.array(baseline["samples"]), bins=50)
+    c_hist = compute_hist(np.array(current_samples), bins=50)
+    kl = entropy(b_hist, c_hist)
+    if kl > 0.5:
+        return {"drift": True, "kl": float(kl)}
+    return {"drift": False, "kl": float(kl)}
+
+if __name__ == "__main__":
+    samples = list(np.random.randn(1000))
+    print(detect(samples))
+
