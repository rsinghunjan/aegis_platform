+#!/usr/bin/env python3
+"""
+Estimate token costs per-inference and push enriched billing records to existing chargeback pipeline.
+"""
+import os, json, requests
+
+COST_PER_1K = float(os.environ.get("COST_PER_1K_TOKENS", "0.0004"))
+FINANCE_API = os.environ.get("FINANCE_API", "")
+
+def estimate_cost(tokens):
+    return (tokens / 1000.0) * COST_PER_1K
+
+def push_record(team, model, tokens, request_id):
+    est = estimate_cost(tokens)
+    payload = {"team": team, "model": model, "tokens": tokens, "est_cost": est, "request_id": request_id}
+    # call existing chargeback uploader endpoint
+    if FINANCE_API:
+        try:
+            requests.post(FINANCE_API, json=payload, timeout=5)
+        except Exception as e:
+            print("finance push failed", e)
+    return payload
+
