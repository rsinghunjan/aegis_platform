+#!/usr/bin/env python3
+"""
+Middleware for logging per-inference telemetry: tokens, latency, model version, user/req id, cost estimate.
+Plug this into inference servers (FastAPI example below).
+"""
+import time, json, os
+from prometheus_client import Counter, Histogram
+
+INFER_COUNT = Counter("aegis_inference_total", "Total inferences", ["model","status"])
+INFER_LATENCY = Histogram("aegis_inference_latency_seconds", "Inference latency seconds", ["model"])
+INFER_TOKENS = Counter("aegis_inference_tokens_total", "Total tokens processed", ["model"])
+
+def log_inference(model, request_id, tokens_in, tokens_out, status="ok"):
+    INFER_COUNT.labels(model=model, status=status).inc()
+    INFER_TOKENS.labels(model=model).inc(tokens_in + tokens_out)
+    # Write structured log for SIEM and auditing
+    entry = {"ts": int(time.time()), "model": model, "request_id": request_id, "tokens_in": tokens_in, "tokens_out": tokens_out, "status": status}
+    print(json.dumps(entry))
+
+def inference_wrapper(model_name):
+    def decorator(fn):
+        def inner(*args, **kwargs):
+            start = time.time()
+            request_id = kwargs.get("request_id") or os.urandom(8).hex()
+            try:
+                res = fn(*args, **kwargs)
+                latency = time.time() - start
+                INFER_LATENCY.labels(model=model_name).observe(latency)
+                tokens_in = res.get("tokens_in", 0) if isinstance(res, dict) else 0
+                tokens_out = res.get("tokens_out", 0) if isinstance(res, dict) else 0
+                log_inference(model_name, request_id, tokens_in, tokens_out, status="ok")
+                return res
+            except Exception as e:
+                log_inference(model_name, request_id, 0, 0, status="error")
+                raise
+        return inner
+    return decorator
+
