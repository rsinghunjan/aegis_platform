+#!/usr/bin/env python3
+"""
+Prompt registry microservice: store, version and retrieve prompts.
+Simple FastAPI + SQLite/Postgres support via SQLAlchemy.
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from sqlalchemy import create_engine, Column, Integer, String, Text, DateTime
+from sqlalchemy.orm import sessionmaker, declarative_base
+import datetime, os
+
+DB_URL = os.environ.get("PROMPT_DB", "sqlite:///./prompts.db")
+engine = create_engine(DB_URL, connect_args={"check_same_thread": False} if DB_URL.startswith("sqlite") else {})
+Session = sessionmaker(bind=engine)
+Base = declarative_base()
+
+class Prompt(Base):
+    __tablename__ = "prompts"
+    id = Column(Integer, primary_key=True)
+    name = Column(String(200), unique=True)
+    version = Column(Integer, default=1)
+    content = Column(Text)
+    created_at = Column(DateTime, default=datetime.datetime.utcnow)
+
+Base.metadata.create_all(engine)
+
+app = FastAPI()
+
+class PromptIn(BaseModel):
+    name: str
+    content: str
+
+@app.post("/prompt")
+def create_prompt(p: PromptIn):
+    s = Session()
+    existing = s.query(Prompt).filter_by(name=p.name).order_by(Prompt.version.desc()).first()
+    v = existing.version + 1 if existing else 1
+    pr = Prompt(name=p.name, version=v, content=p.content)
+    s.add(pr); s.commit()
+    return {"ok": True, "name": p.name, "version": v}
+
+@app.get("/prompt/{name}")
+def get_prompt(name: str):
+    s = Session()
+    pr = s.query(Prompt).filter_by(name=name).order_by(Prompt.version.desc()).first()
+    if not pr:
+        raise HTTPException(status_code=404, detail="not found")
+    return {"name": pr.name, "version": pr.version, "content": pr.content}
+
