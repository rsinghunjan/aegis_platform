+#!/usr/bin/env python3
+"""
+Retrieval microservice: query Milvus and return nearest neighbors + metadata.
+Simple FastAPI service used by RAG pipeline.
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from pymilvus import connections, Collection
+import os, json
+
+app = FastAPI()
+M = os.environ.get("MILVUS_HOST", "milvus.aegis-milvus.svc.cluster.local")
+
+class QueryRequest(BaseModel):
+    embedding: list
+    top_k: int = 5
+    collection: str = "models"
+
+@app.on_event("startup")
+def startup():
+    connections.connect(host=M, port=19530)
+
+@app.post("/query")
+def query(req: QueryRequest):
+    try:
+        col = Collection(req.collection)
+        res = col.search([req.embedding], "embedding", params={"metric_type":"IP","params":{"nprobe":10}}, limit=req.top_k)
+        out = []
+        for hit in res[0]:
+            out.append({"id": hit.id, "score": float(hit.score), "meta": json.loads(hit.entity.get("meta")) if hit.entity.get("meta") else {}})
+        return {"results": out}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
+
