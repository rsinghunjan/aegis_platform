+#!/usr/bin/env python3
+"""
+Simple request batching adapter for LLM inference. Collects requests within a short window and calls backend.
+This is a simplified sketch — production requires careful batching logic and backpressure.
+"""
+import time, threading, queue
+
+class Batcher:
+    def __init__(self, backend_call, max_batch=8, window_s=0.05):
+        self.backend_call = backend_call
+        self.max_batch = max_batch
+        self.window_s = window_s
+        self.q = queue.Queue()
+        t = threading.Thread(target=self._worker, daemon=True)
+        t.start()
+
+    def submit(self, payload):
+        ev = {"payload": payload, "resp_q": queue.Queue()}
+        self.q.put(ev)
+        return ev["resp_q"].get()
+
+    def _worker(self):
+        while True:
+            try:
+                batch = [self.q.get()]
+                t0 = time.time()
+                while len(batch) < self.max_batch and (time.time() - t0) < self.window_s:
+                    try:
+                        batch.append(self.q.get(timeout=self.window_s))
+                    except queue.Empty:
+                        break
+                # construct batch payload
+                inputs = [b["payload"] for b in batch]
+                results = self.backend_call(inputs)
+                for b, r in zip(batch, results):
+                    b["resp_q"].put(r)
+            except Exception as e:
+                for b in batch:
+                    b["resp_q"].put({"error": str(e)})
+
