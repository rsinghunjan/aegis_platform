+#!/usr/bin/env python3
+"""
+Canary traffic generator — sends a mix of short prompts and RAG-enabled prompts.
+Used by Argo canary workflows to seed traffic.
+"""
+import argparse, requests, time, random
+
+def gen_prompt():
+    templates = [
+        "Summarize the following: {text}",
+        "Translate to French: {text}",
+        "Write a short email about {text}",
+        "Answer succinctly: {text}"
+    ]
+    sample = ["battery life", "privacy policy", "data pipeline", "error log"]
+    return random.choice(templates).format(text=random.choice(sample))
+
+def run(endpoint, duration=60, qps=1):
+    end = time.time() + duration
+    while time.time() < end:
+        p = gen_prompt()
+        try:
+            r = requests.post(endpoint, json={"client_id":"canary","model_env":"staging","payload":{"inputs":p}}, timeout=10)
+            print("req:", r.status_code)
+        except Exception as e:
+            print("err:", e)
+        time.sleep(1.0/qps)
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--endpoint", required=True)
+    ap.add_argument("--duration", type=int, default=60)
+    ap.add_argument("--qps", type=float, default=1.0)
+    args = ap.parse_args()
+    run(args.endpoint, args.duration, args.qps)
+
