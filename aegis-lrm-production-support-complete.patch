+#!/usr/bin/env python3
+"""
+Streaming proxy v2 — production-ready skeleton using FastAPI + WebSockets + httpx.
+
+Features:
+ - HTTP POST /generate: legacy chunked-JSON streaming (ndjson) support
+ - WebSocket endpoint /ws/generate: bidirectional streaming for low-latency clients
+ - Incremental lightweight safety checks (safety_stream_checker)
+ - Accurate token accounting (estimation; integrate tokenizer for exact counts)
+ - Periodic DP charging (per-token window)
+ - Orchestrator notification on blocks or DP over-budget
+ - Graceful backpressure and client disconnect handling
+
+IMPORTANT: Replace placeholders (LLM_BACKEND, DP service URL, ORCH_WEBHOOK, TOKENIZER) with your infra values.
+"""
+import os
+import asyncio
+import logging
+import json
+import time
+from typing import AsyncIterator
+
+from fastapi import FastAPI, Request, WebSocket, WebSocketDisconnect
+from fastapi.responses import StreamingResponse, JSONResponse
+import httpx
+
+from safety_stream_checker import check_chunk
+
+LOG = logging.getLogger("aegis.llm.proxy.v2")
+logging.basicConfig(level=logging.INFO)
+
+LLM_BACKEND_HTTP = os.environ.get("LLM_BACKEND_HTTP", "http://vllm.model-serving.svc.cluster.local:8080/generate_stream")
+LLM_BACKEND_WS = os.environ.get("LLM_BACKEND_WS", "ws://vllm.model-serving.svc.cluster.local:8080/ws_generate")
+DP_SERVICE = os.environ.get("DP_SERVICE_URL", "http://dp-service:8084")
+ORCH_WEBHOOK = os.environ.get("ORCH_WEBHOOK", "http://aegis-orchestrator.aegis-system.svc.cluster.local:8088/webhook")
+DP_AUTH = os.environ.get("DP_AUTH_TOKEN", "")
+CHARGE_INTERVAL_TOKENS = int(os.environ.get("CHARGE_INTERVAL_TOKENS", "128"))
+TOKENIZER = os.environ.get("TOKENIZER", "")  # optional tokenizer service for accurate counts
+
+app = FastAPI(title="Aegis LLM Streaming Proxy v2")
+
+async def charge_dp(client_id: str, tokens: int) -> bool:
+    if not client_id:
+        return False
+    headers = {"Authorization": f"Bearer {DP_AUTH}"} if DP_AUTH else {}
+    async with httpx.AsyncClient() as c:
+        try:
+            r = await c.post(f"{DP_SERVICE}/charge", json={"client": client_id, "tokens": tokens}, headers=headers, timeout=5.0)
+            return r.status_code == 200
+        except Exception:
+            LOG.exception("DP charge failed")
+            return False
+
+async def notify_orchestrator(event: dict):
+    async with httpx.AsyncClient() as c:
+        try:
+            await c.post(ORCH_WEBHOOK, json=event, timeout=3.0)
+        except Exception:
+            LOG.exception("orchestrator notify failed")
+
+async def stream_backend_http(payload: dict) -> AsyncIterator[dict]:
+    """
+    Connect to backend HTTP streaming endpoint (ndjson). Yields parsed JSON chunks.
+    """
+    async with httpx.AsyncClient(timeout=None) as client:
+        with client.stream("POST", LLM_BACKEND_HTTP, json=payload) as r:
+            async for raw in r.aiter_lines():
+                if not raw:
+                    continue
+                try:
+                    yield json.loads(raw)
+                except Exception:
+                    yield {"text": raw}
+
+@app.post("/generate")
+async def generate(req: Request):
+    body = await req.json()
+    client_id = body.get("client_id")
+    token_accum = 0
+
+    async def event_stream():
+        nonlocal token_accum
+        async for chunk in stream_backend_http(body):
+            text = chunk.get("text", "")
+            tokens = chunk.get("tokens", len(text.split()))
+            score, reason = check_chunk(text)
+            if score >= 0.95:
+                evt = {"id": f"auto-{int(time.time())}", "model_env": body.get("model_env", "staging"), "score": score, "model": "llm-backend"}
+                await notify_orchestrator(evt)
+                yield json.dumps({"status": "blocked", "reason": reason}) + "\n"
+                return
+            yield json.dumps({"status": "ok", "text": text}) + "\n"
+            token_accum += tokens
+            if token_accum >= CHARGE_INTERVAL_TOKENS:
+                ok = await charge_dp(client_id, token_accum)
+                if not ok:
+                    # DP over budget -> notify and block
+                    await notify_orchestrator({"id": f"dp-{int(time.time())}", "model_env": body.get("model_env","prod"), "score":0.0, "dp_over_budget": True})
+                    yield json.dumps({"status": "blocked", "reason": "dp_over_budget"}) + "\n"
+                    return
+                token_accum = 0
+
+    return StreamingResponse(event_stream(), media_type="application/x-ndjson")
+
+@app.websocket("/ws/generate")
+async def ws_generate(ws: WebSocket):
+    await ws.accept()
+    client_id = None
+    token_accum = 0
+    downstream_ws = None
+    try:
+        init = await ws.receive_json()
+        client_id = init.get("client_id")
+        # open backend websocket
+        async with httpx.AsyncClient() as client:
+            async with client.stream("POST", LLM_BACKEND_HTTP, json=init) as resp:
+                # This is HTTP streaming; for true WS backend swap to ws client (httpx doesn't support ws client in v0.23)
+                async for line in resp.aiter_lines():
+                    if not line:
+                        continue
+                    try:
+                        chunk = json.loads(line)
+                    except Exception:
+                        chunk = {"text": line}
+                    text = chunk.get("text","")
+                    tokens = chunk.get("tokens", len(text.split()))
+                    score, reason = check_chunk(text)
+                    if score >= 0.95:
+                        await notify_orchestrator({"id": f"auto-{int(time.time())}", "model_env": init.get("model_env","staging"), "score": score, "model":"llm-backend"})
+                        await ws.send_json({"status":"blocked", "reason":reason})
+                        await ws.close()
+                        return
+                    await ws.send_json({"status":"ok","text": text})
+                    token_accum += tokens
+                    if token_accum >= CHARGE_INTERVAL_TOKENS:
+                        ok = await charge_dp(client_id, token_accum)
+                        if not ok:
+                            await notify_orchestrator({"id":f"dp-{int(time.time())}","model_env":init.get("model_env","prod"),"score":0.0,"dp_over_budget":True})
+                            await ws.send_json({"status":"blocked","reason":"dp_over_budget"})
+                            await ws.close()
+                            return
+                        token_accum = 0
+    except WebSocketDisconnect:
+        LOG.info("Client disconnected")
+    except Exception:
+        LOG.exception("Streaming error")
+    finally:
+        try:
+            await ws.close()
+        except Exception:
+            pass
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", 8089)), log_level="info")
+
