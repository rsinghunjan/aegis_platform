+Adapter: reads MLflow run metadata and upserts ModelContext to MCP.
+Usage: python ingest_mlflow.py --run-id <MLFLOW_RUN_ID> --model-id <id> --version <v>
+"""
+import requests, os, argparse, json
+
+MLFLOW_URI = os.environ.get("MLFLOW_TRACKING_URI", "http://mlflow:5000")
+MCP_URL = os.environ.get("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+TOKEN = os.environ.get("MCP_TOKEN", "")
+
+def headers():
+    h = {"Content-Type": "application/json"}
+    if TOKEN:
+        h["Authorization"] = f"Bearer {TOKEN}"
+    return h
+
+def fetch_mlflow(run_id):
+    r = requests.get(f"{MLFLOW_URI}/api/2.0/preview/mlflow/runs/get?run_id={run_id}")
+    r.raise_for_status()
+    return r.json()
+
+def upsert(model_id, version, run_id):
+    run = fetch_mlflow(run_id)
+    payload = {
+        "model_id": model_id,
+        "version": version,
+        "artifact": {"uri": run.get("run").get("info").get("artifact_uri")},
+        "mlflow_run_id": run_id,
+        "build": {"commit": run.get("run").get("data",{}).get("tags",{}).get("git.commit")},
+        "eval_metrics": {}, "hyperparameters": {}
+    }
+    r = requests.post(f"{MCP_URL}/model-context", json=payload, headers=headers())
+    r.raise_for_status()
+    print("Upserted:", r.json())
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--run-id", required=True)
+    p.add_argument("--model-id", required=True)
+    p.add_argument("--version", required=True)
+    args = p.parse_args()
+    upsert(args.model_id, args.version, args.run_id)
