+func GetModelContext(modelID, version string) ([]byte, error) {
+    url := fmt.Sprintf("%s/model-context/%s/%s", MCP_URL, modelID, version)
+    req, _ := http.NewRequest("GET", url, nil)
+    getHeaders(req)
+    client := &http.Client{}
+    resp, err := client.Do(req)
+    if err != nil { return nil, err }
+    defer resp.Body.Close()
+    body, _ := ioutil.ReadAll(resp.Body)
+    if resp.StatusCode >= 400 { return nil, fmt.Errorf("error: %s", string(body)) }
+    return body, nil
+}
