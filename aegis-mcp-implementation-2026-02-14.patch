+import requests, os
+MCP_URL = os.environ.get("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+TOKEN = os.environ.get("MCP_TOKEN", "")
+
+def headers():
+    h = {"Content-Type": "application/json"}
+    if TOKEN:
+        h["Authorization"] = f"Bearer {TOKEN}"
+    return h
+
+def upsert_model_context(payload: dict):
+    r = requests.post(f"{MCP_URL}/model-context", json=payload, headers=headers(), timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def get_model_context(model_id: str, version: str):
+    r = requests.get(f"{MCP_URL}/model-context/{model_id}/{version}", headers=headers(), timeout=10)
+    if r.status_code == 404:
+        return None
+    r.raise_for_status()
+    return r.json()
+
+def list_models(limit: int = 100):
+    r = requests.get(f"{MCP_URL}/models?limit={limit}", headers=headers(), timeout=10)
+    r.raise_for_status()
+    return r.json()
