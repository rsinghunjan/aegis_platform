+from fastapi import FastAPI, Depends, HTTPException, Request, BackgroundTasks
+from fastapi.middleware.cors import CORSMiddleware
+from . import database, crud, schemas
+from .database import SessionLocal
+from fastapi.responses import JSONResponse
+import httpx, os, jwt
+
+app = FastAPI(title="Aegis MCP")
+
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=["*"],
+    allow_credentials=True,
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+def get_db():
+    db = SessionLocal()
+    try:
+        yield db
+    finally:
+        db.close()
+
+def get_subject_from_request(request: Request):
+    # Simple audit subject extraction: parse Authorization Bearer JWT and return subject claim.
+    auth = request.headers.get("Authorization")
+    if not auth:
+        return "anonymous"
+    try:
+        token = auth.split(" ", 1)[1]
+        # In production: verify token signature, issuer, audience.
+        payload = jwt.decode(token, options={"verify_signature": False})
+        return payload.get("sub") or payload.get("email") or "unknown"
+    except Exception:
+        return "invalid-token"
+
+async def notify_subscribers(db, payload):
+    subs = crud.list_subscriptions(db)
+    async with httpx.AsyncClient(timeout=10.0) as client:
+        for s in subs:
+            try:
+                await client.post(s.url, json=payload)
+            except Exception:
+                # best-effort, failures recorded in audit by caller
+                pass
+
+@app.post("/model-context", response_model=schemas.ModelContextResponse)
+async def upsert_model_context(mc: schemas.ModelContext, background_tasks: BackgroundTasks, request: Request, db=Depends(get_db)):
+    subject = get_subject_from_request(request)
+    # upsert
+    obj = crud.upsert_model_context(db, mc.dict())
+    # audit
+    crud.write_audit(db, subject, "upsert_model_context", f"{mc.model_id}:{mc.version}", metadata={"model_id": mc.model_id, "version": mc.version})
+    # notify subscribers in background
+    background_tasks.add_task(notify_subscribers, db, {"event":"model_context.upsert","model_id":mc.model_id,"version":mc.version})
+    return {"ok": True, "id": obj.id, "model_context": mc}
+
+@app.get("/model-context/{model_id}/{version}", response_model=schemas.ModelContext)
+def get_model_context(model_id: str, version: str, request: Request, db=Depends(get_db)):
+    subject = get_subject_from_request(request)
+    obj = crud.get_model_context(db, model_id, version)
+    crud.write_audit(db, subject, "get_model_context", f"{model_id}:{version}")
+    if not obj:
+        raise HTTPException(status_code=404, detail="not found")
+    # convert SQLAlchemy object to dict for pydantic
+    return {
+        "model_id": obj.model_id,
+        "version": obj.version,
+        "artifact": obj.artifact,
+        "build": obj.build,
+        "mlflow_run_id": obj.mlflow_run_id,
+        "datasets": obj.datasets,
+        "hyperparameters": obj.hyperparameters,
+        "eval_metrics": obj.eval_metrics,
+        "attestations": [ { "type": a.type, "rekor_index": a.rekor_index, "attestation_uri": a.attestation_uri, "signed_at": a.signed_at } for a in obj.attestations ],
+        "hil_approvals": [ { "approver_id": h.approver_id, "role": h.role, "receipt_rekor_index": h.receipt_rekor_index, "signed_at": h.signed_at } for h in obj.hil_approvals ],
+        "deployments": [ { "env": d.env, "cluster": d.cluster, "namespace": d.namespace, "deployment_id": d.deployment_id, "status": d.status, "deployed_at": d.deployed_at } for d in obj.deployments ],
+        "federated_rounds": [ { "round_id": r.round_id, "rekor_index": r.rekor_index, "ts": r.ts } for r in obj.federated_rounds ],
+        "owner": obj.owner,
+        "team": obj.team,
+        "tags": obj.tags,
+        "compliance": obj.compliance,
+        "created_at": obj.created_at,
+        "updated_at": obj.updated_at,
+    }
+
+@app.get("/models")
+def list_models(limit: int = 100, request: Request = None, db=Depends(get_db)):
+    subject = get_subject_from_request(request) if request else "system"
+    objs = crud.list_models(db, limit)
+    crud.write_audit(db, subject, "list_models", "models", metadata={"limit": limit})
+    return [ { "model_id": o.model_id, "version": o.version, "owner": o.owner, "updated_at": o.updated_at } for o in objs ]
+
+@app.post("/subscriptions", status_code=201)
+def create_subscription(payload: dict, request: Request, db=Depends(get_db)):
+    name = payload.get("name")
+    url = payload.get("url")
+    if not name or not url:
+        raise HTTPException(status_code=400, detail="name and url required")
+    sub = crud.create_subscription(db, name, url)
+    crud.write_audit(db, get_subject_from_request(request), "create_subscription", f"subscriber:{name}", metadata={"url": url})
+    return {"ok": True, "id": sub.id, "name": sub.name, "url": sub.url}
+
