+    # This is a heuristic: operator should map Rekor entry to model context.
+    model_id = entry.get("integrated", {}).get("payload", {}).get("model_id") or "unknown"
+    version = entry.get("integrated", {}).get("payload", {}).get("version") or "v0"
+    att = {"type": "rekor", "rekor_index": entry.get("logIndex"), "attestation_uri": entry.get("signed_entry_timestamp")}
