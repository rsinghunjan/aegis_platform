+func UpsertModelContext(payload []byte) ([]byte, error) {
+    url := fmt.Sprintf("%s/model-context", MCP_URL)
+    req, _ := http.NewRequest("POST", url, bytes.NewBuffer(payload))
+    getHeaders(req)
+    client := &http.Client{}
+    resp, err := client.Do(req)
+    if err != nil { return nil, err }
+    defer resp.Body.Close()
+    body, _ := ioutil.ReadAll(resp.Body)
+    if resp.StatusCode >= 400 { return nil, fmt.Errorf("error: %s", string(body)) }
+    return body, nil
+}
