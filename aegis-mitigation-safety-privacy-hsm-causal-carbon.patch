+#!/usr/bin/env python3
+"""
+Merge CodeCarbon estimates with local GPU power telemetry (nvidia-smi logs) to improve per-run energy accuracy.
+
+Inputs:
+ - CodeCarbon JSON record (from services/carbon/codecarbon_mlflow.py)
+ - GPU telemetry CSV: timestamp,power_w (sampled at ~1s)
+
+Output:
+ - merged JSON with averaged telemetry energy_kwh and adjusted co2_kg (replaces codecarbon energy estimate if telemetry available)
+"""
+import argparse, json, os
+from datetime import datetime
+
+def read_codecarbon(path):
+    return json.load(open(path))
+
+def read_gpu_csv(path):
+    # CSV: ts_iso,power_w
+    rows = []
+    with open(path) as fh:
+        for line in fh:
+            parts = line.strip().split(",")
+            if len(parts) < 2: continue
+            try:
+                ts = datetime.fromisoformat(parts[0])
+                pw = float(parts[1])
+                rows.append((ts, pw))
+            except Exception:
+                continue
+    return rows
+
+def compute_energy_from_samples(samples):
+    if not samples:
+        return None
+    # simple trapezoidal approx assuming ~1s sampling
+    total_j = 0.0
+    for i in range(1, len(samples)):
+        dt = (samples[i][0] - samples[i-1][0]).total_seconds()
+        avg_p = (samples[i][1] + samples[i-1][1]) / 2.0
+        total_j += avg_p * dt
+    # convert J to kWh: 1 Wh = 3600 J; 1 kWh = 3.6e6 J
+    kwh = total_j / 3.6e6
+    return kwh
+
+def merge(codecarbon_path, telemetry_csv, out_path):
+    cc = read_codecarbon(codecarbon_path)
+    samples = read_gpu_csv(telemetry_csv)
+    kwh = compute_energy_from_samples(samples)
+    if kwh is None:
+        print("No telemetry; leaving codecarbon estimate")
+        merged = cc
+    else:
+        # Replace energy_kwh and recompute co2_kg adjusting by same provider intensity ratio if available
+        provider_intensity = cc.get("emissions_provider", {}).get("intensity") if isinstance(cc.get("emissions_provider"), dict) else None
+        # best-effort: if no provider intensity, keep codecarbon co2 per kwh ratio
+        if cc.get("energy_kwh"):
+            ratio = (cc.get("co2_kg",0.0) / cc.get("energy_kwh",1.0))
+        else:
+            ratio = float(os.environ.get("DEFAULT_CO2_PER_KWH", "0.5"))
+        co2 = kwh * ratio
+        merged = cc.copy()
+        merged["energy_kwh_telemetry"] = kwh
+        merged["co2_kg_telemetry"] = co2
+    with open(out_path, "w") as fh:
+        json.dump(merged, fh, indent=2)
+    print("Wrote merged telemetry to", out_path)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--codecarbon", required=True)
+    p.add_argument("--telemetry", required=True)
+    p.add_argument("--out", default="/tmp/merged_carbon.json")
+    args = p.parse_args()
+    merge(args.codecarbon, args.telemetry, args.out)
+
