+#!/usr/bin/env python3
+"""
+Policy CI gate:
+ - Validates that a requested action appears in the delegation matrix or policy file
+ - Validates that experiments referenced have approvals and preanalysis plans
+ - Intended to be run in CI to block merges that enable high-risk agentic workflows
+"""
+import argparse, os, csv, requests, sys, json
+
+DELEGATION_CSV = os.environ.get("DELEGATION_CSV","policy/delegation_matrix.csv")
+EXPERIMENT_REG = os.environ.get("EXPERIMENT_REG","http://experiment-registry:8081")
+
+def load_delegation():
+    if not os.path.exists(DELEGATION_CSV):
+        return []
+    out=[]
+    with open(DELEGATION_CSV) as fh:
+        r = csv.DictReader(fh)
+        for row in r:
+            out.append(row)
+    return out
+
+def find_action(action_name, delegation):
+    for r in delegation:
+        if r.get("action_id")==action_name or r.get("action_name")==action_name:
+            return r
+    return None
+
+def check_experiment_approved(exp_id):
+    try:
+        r = requests.get(f"{EXPERIMENT_REG}/experiments/{exp_id}", timeout=5)
+        if r.status_code!=200:
+            return False, "not-found"
+        j = r.json()
+        approved = bool(j.get("approved_by"))
+        has_plan = bool(j.get("metadata") and j.get("metadata").get("preanalysis_plan"))
+        return (approved and has_plan), j
+    except Exception as e:
+        return False, str(e)
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--action", required=True)
+    p.add_argument("--experiment", required=False)
+    args = p.parse_args()
+
+    delegation = load_delegation()
+    act = find_action(args.action, delegation)
+    if not act:
+        print("Action not found in delegation matrix:", args.action)
+        sys.exit(1)
+    print("Found action in delegation matrix:", act)
+    if args.experiment:
+        ok, info = check_experiment_approved(args.experiment)
+        if not ok:
+            print("Experiment not approved or preanalysis missing:", info)
+            sys.exit(1)
+        print("Experiment approved and has preanalysis plan")
+    print("Policy CI gate passed")
+    sys.exit(0)
+
+if __name__=="__main__":
+    main()
+
