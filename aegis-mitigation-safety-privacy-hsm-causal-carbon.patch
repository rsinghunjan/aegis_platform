+#!/usr/bin/env python3
+"""
+Client enrollment helper for Federated Learning.
+ - Issues a client identifier and records client metadata (certificate fingerprint / owner) in Vault.
+ - This script does NOT produce cryptographic client certs automatically, but records enrollment evidence and provides a client token placeholder.
+"""
+import argparse, os, subprocess, json, time
+
+VAULT_PATH = os.environ.get("VAULT_FL_CLIENTS","secret/data/aegis/fl/clients")
+
+def vault_put(key, value):
+    subprocess.check_call(["vault","kv","put", VAULT_PATH, f"{key}={json.dumps(value)}"])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--owner", required=True)
+    p.add_argument("--metadata", default="{}")
+    args = p.parse_args()
+    client_id = f"fl-client-{int(time.time())}"
+    token = os.environ.get("FL_CLIENT_TOKEN_PLACEHOLDER", f"token-{client_id}")
+    entry = {"client_id": client_id, "owner": args.owner, "metadata": json.loads(args.metadata), "registered_at": int(time.time()), "token": token}
+    print("Registering client:", client_id)
+    vault_put(client_id, entry)
+    print("Client registered. ID:", client_id, "token:", token)
+
+if __name__=="__main__":
+    main()
