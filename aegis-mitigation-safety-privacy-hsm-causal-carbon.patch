+
+VAULT_KMS_PATH = os.environ.get("VAULT_KMS_PATH","secret/data/aegis/kms")
+ROTATION_MAX_SECONDS = int(os.environ.get("ROTATION_MAX_SECONDS", 60*60*24*90))  # default 90 days
+
+def get_key_metadata():
+    try:
+        out = subprocess.check_output(["vault","kv","get","-format=json", VAULT_KMS_PATH])
+        return json.loads(out)
+    except Exception as e:
+        print("Vault read failed:", e)
+        return None
+
+def main():
+    meta = get_key_metadata()
+    if not meta:
+        print("No metadata found; exiting")
+        return 1
+    # try to parse create_time or ts in metadata
+    ts = None
+    try:
+        data = meta.get("data",{}).get("data",{})
+        ts = int(data.get("created_at", data.get("ts", 0)))
+    except Exception:
+        ts = 0
+    age = int(time.time()) - ts
+    print("Key age (s):", age)
+    if age > ROTATION_MAX_SECONDS:
+        print("Key age exceeds threshold; alerting operator (write marker to Vault and exit 2)")
+        subprocess.call(["vault","kv","put", f"{VAULT_KMS_PATH}/rotation_alert", f"alert_ts={int(time.time())}"])
+        return 2
+    print("Key rotation age OK")
+    return 0
+
+if __name__=="__main__":
+    raise SystemExit(main())
