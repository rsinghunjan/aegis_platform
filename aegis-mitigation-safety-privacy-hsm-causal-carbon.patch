+#!/usr/bin/env python3
+"""
+Orchestrator wrapper that enforces:
+ - Experiment approval & pre-analysis plan existence
+ - RAG evidence retrieval
+ - Calibrator threshold pass
+ - Human gating: create a GitHub issue for manual review if checks fail
+
+Usage:
+  python3 services/safety/execute_with_checks.py --action-id ACTION --experiment EXID --claim "text of claim" --command "scripts/do_high_risk.sh"
+
+Exit codes:
+  0: checks passed (command executed)
+  1: checks failed and human gate created
+  2: internal error
+"""
+import argparse, subprocess, os, requests, json, sys
+from services.safety.rag_retriever import retrieve_evidence
+from services.safety.calibrator_evaluator import is_calibrator_passing
+
+EXPERIMENT_REG = os.environ.get("EXPERIMENT_REG","http://experiment-registry:8081")
+GITHUB_REPO = os.environ.get("GITHUB_REPO","")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN","")
+
+def check_experiment_approval(exp_id):
+    try:
+        r = requests.get(f"{EXPERIMENT_REG}/experiments/{exp_id}", timeout=5)
+        if r.status_code != 200:
+            return False, "experiment-not-found"
+        j = r.json()
+        approved = bool(j.get("approved_by"))
+        has_plan = bool(j.get("metadata") and j.get("metadata").get("preanalysis_plan"))
+        return approved and has_plan, j
+    except Exception as e:
+        return False, f"error-checking-experiment:{e}"
+
+def create_human_gate_issue(action_id, exp_id, claim, evidence_summary, score):
+    if not GITHUB_TOKEN or not GITHUB_REPO:
+        print("No GitHub configuration for human gate; failing.")
+        return None
+    title = f"[HUMAN GATE] Action {action_id} requires review (exp {exp_id})"
+    body = f"""Automated checks failed for action `{action_id}` in experiment `{exp_id}`.
+
+Claim: {claim}
+Calibrator score: {score}
+Evidence summary: {evidence_summary}
+
+Please review and either approve or provide remediation steps.
+"""
+    headers = {"Authorization": f"token {GITHUB_TOKEN}", "Accept": "application/vnd.github+json"}
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    r = requests.post(url, json={"title":title, "body": body, "labels":["human-gate"]}, headers=headers, timeout=10)
+    if r.status_code in (200,201):
+        return r.json().get("html_url")
+    else:
+        print("Failed to create GitHub issue:", r.status_code, r.text)
+        return None
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--action-id", required=True)
+    p.add_argument("--experiment", required=True)
+    p.add_argument("--claim", required=True)
+    p.add_argument("--command", required=False, default=None)
+    args = p.parse_args()
+
+    ok, exp_or_err = check_experiment_approval(args.experiment)
+    if not ok:
+        print("Experiment approval/preanalysis check failed:", exp_or_err)
+        # create human gate
+        issue = create_human_gate_issue(args.action_id, args.experiment, args.claim, "no approval or preanalysis plan", 0.0)
+        print("Created human gate issue:", issue)
+        sys.exit(1)
+
+    # retrieve RAG evidence
+    evidence = retrieve_evidence(args.claim, top_k=5)
+    evidence_summary = "; ".join([e.get("source","") for e in evidence[:3]])
+
+    # calibrator check
+    passed, score = is_calibrator_passing(args.claim, evidence)
+    print("Calibrator result:", passed, score)
+    if not passed:
+        issue = create_human_gate_issue(args.action_id, args.experiment, args.claim, evidence_summary, score)
+        print("Created human gate issue:", issue)
+        sys.exit(1)
+
+    # All checks passed -> execute command (if provided) or report allow
+    if args.command:
+        print("Executing command:", args.command)
+        rc = subprocess.call(args.command, shell=True)
+        sys.exit(rc)
+    else:
+        print("Checks passed: action allowed")
+        sys.exit(0)
+
+if __name__=="__main__":
+    main()
+
