+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Ensure Vault Kubernetes auth role & policy exist for the aegis namespace/serviceaccount.
+#
+VAULT_ADDR=${VAULT_ADDR:-https://vault.example.local}
+ROLE_NAME=${1:-aegis-app-role}
+NAMESPACE=${2:-aegis}
+SERVICE_ACCOUNT=${3:-calibrator-csi-sa}
+
+echo "Creating policy 'aegis-calibrator' with limited read to secret/data/aegis/calibrator"
+cat > /tmp/aegis-calibrator-policy.hcl <<'EOF'
+path "secret/data/aegis/calibrator" {
+  capabilities = ["read"]
+}
+EOF
+vault policy write aegis-calibrator /tmp/aegis-calibrator-policy.hcl
+
+echo "Configuring Kubernetes auth role $ROLE_NAME for namespace $NAMESPACE and SA $SERVICE_ACCOUNT"
+vault auth enable -path=k8s-kv kubernetes || true
+vault write auth/kubernetes/role/"${ROLE_NAME}" \
+  bound_service_account_names="${SERVICE_ACCOUNT}" \
+  bound_service_account_namespaces="${NAMESPACE}" \
+  policies=aegis-calibrator \
+  ttl=24h
+
+echo "Done. Role ${ROLE_NAME} configured."
+
