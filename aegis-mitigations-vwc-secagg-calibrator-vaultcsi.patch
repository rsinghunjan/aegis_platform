+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Retrain calibrator, push artifact to S3 (optional) and update Vault with model metadata and threshold.
+# Also writes an audit manifest to the evidence bucket.
+#
+DATA_CSV=${1:-/data/calib_labels.csv}
+OUT_DIR=${2:-/tmp/calibrator_out}
+VAULT_PATH=${3:-secret/data/aegis/calibrator}
+THRESH=${4:-0.8}
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+
+echo "Retraining calibrator with data $DATA_CSV -> $OUT_DIR"
+python3 services/safety/calibrator_pytorch_train.py --in "$DATA_CSV" --out-dir "$OUT_DIR"
+
+# Push model to S3 if EVIDENCE_BUCKET set
+if [ -n "$EVIDENCE_BUCKET" ] && command -v aws >/dev/null 2>&1; then
+  echo "Uploading calibrator artifact to $EVIDENCE_BUCKET"
+  aws s3 cp "${OUT_DIR}/calibrator.pt" "${EVIDENCE_BUCKET%/}/calibrators/calibrator_$(date +%s).pt"
+  MODEL_URI="${EVIDENCE_BUCKET%/}/calibrators/$(basename ${OUT_DIR}/calibrator.pt)"
+else
+  MODEL_URI="file://${OUT_DIR}/calibrator.pt"
+fi
+
+echo "Writing metadata to Vault at $VAULT_PATH"
+vault kv put "$VAULT_PATH" model_uri="$MODEL_URI" threshold="$THRESH" trained_at="$(date +%s)"
+
+# Write audit manifest and upload
+MANIFEST="/tmp/calibrator_manifest_$(date +%s).json"
+cat > "$MANIFEST" <<EOF
+{
+  "model_uri": "${MODEL_URI}",
+  "threshold": ${THRESH},
+  "trained_at": $(date +%s),
+  "trained_by": "$(whoami)"
+}
+EOF
+
+if [ -n "$EVIDENCE_BUCKET" ] && command -v aws >/dev/null 2>&1; then
+  aws s3 cp "$MANIFEST" "${EVIDENCE_BUCKET%/}/calibrator_manifests/$(basename $MANIFEST)"
+  echo "Uploaded audit manifest to ${EVIDENCE_BUCKET%/}/calibrator_manifests/$(basename $MANIFEST)"
+else
+  echo "Audit manifest saved to $MANIFEST"
+fi
+
+echo "Retrain & audit complete."
+
