+#!/usr/bin/env python3
+"""
+Benchmark the secure-aggregator prototype to measure latency and throughput.
+
+ - Starts the local prototype aggregator (if present)
+ - Sends N simulated client shares of a given size
+ - Measures request latency and reports summary statistics
+
+Usage:
+  python3 ops/secure_agg/benchmark.py --clients 50 --size-kb 64 --rounds 5
+"""
+import argparse, subprocess, time, requests, base64, shutil, os
+from statistics import mean, median
+
+AGG_HOST = os.environ.get("SECAGG_HOST","127.0.0.1")
+AGG_PORT = int(os.environ.get("SECAGG_PORT","8202"))
+AGG_URL = f"http://{AGG_HOST}:{AGG_PORT}"
+SERVER_SCRIPT = os.path.join(os.path.dirname(__file__), "pysyft_secure_aggregator.py")
+
+def start_server():
+    if not os.path.exists(SERVER_SCRIPT):
+        raise RuntimeError("Server script not found: " + SERVER_SCRIPT)
+    proc = subprocess.Popen(["python3", SERVER_SCRIPT])
+    time.sleep(1.0)
+    return proc
+
+def stop_server(proc):
+    try:
+        proc.terminate()
+        proc.wait(timeout=5)
+    except Exception:
+        proc.kill()
+
+def send_share(client_id, payload_bytes):
+    b64 = base64.b64encode(payload_bytes).decode()
+    r = requests.post(AGG_URL + "/submit_share", json={"client_id": client_id, "share": b64}, timeout=30)
+    r.raise_for_status()
+    return r.elapsed.total_seconds()
+
+def run_round(clients, size_kb):
+    payload = b"0" * (size_kb * 1024)
+    latencies = []
+    for i in range(clients):
+        t = send_share(f"c{i}", payload)
+        latencies.append(t)
+    # request aggregation
+    start = time.time()
+    r = requests.post(AGG_URL + "/aggregate", json={}, timeout=60)
+    r.raise_for_status()
+    agg_time = time.time() - start
+    return latencies, agg_time
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--clients", type=int, default=10)
+    p.add_argument("--size-kb", type=int, default=16)
+    p.add_argument("--rounds", type=int, default=3)
+    args = p.parse_args()
+
+    srv = start_server()
+    try:
+        all_lat = []
+        agg_times = []
+        for r in range(args.rounds):
+            print(f"Round {r+1}/{args.rounds} clients={args.clients} size_kb={args.size_kb}")
+            latencies, agg_time = run_round(args.clients, args.size_kb)
+            all_lat.extend(latencies)
+            agg_times.append(agg_time)
+            print(f"Round {r+1} median latency {median(latencies):.3f}s agg_time {agg_time:.3f}s")
+        print("Summary:")
+        print("requests median:", median(all_lat), "mean:", mean(all_lat))
+        print("agg median:", median(agg_times), "mean:", mean(agg_times))
+    finally:
+        stop_server(srv)
+
+if __name__=="__main__":
+    main()
+
