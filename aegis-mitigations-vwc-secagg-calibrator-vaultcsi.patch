+#!/usr/bin/env bash
+set -euo pipefail
+#
+# vwc_rollback.sh
+# Safely toggle ValidatingWebhookConfiguration failurePolicy to "Ignore" (safe rollback)
+# or delete the VWC if requested. Use this when a misconfigured VWC is blocking workloads.
+#
+# Usage:
+#   ./ops/webhook/vwc_rollback.sh ignore aegis-validating-webhook    # set failurePolicy to Ignore
+#   ./ops/webhook/vwc_rollback.sh fail   aegis-validating-webhook    # restore failurePolicy to Fail
+#   ./ops/webhook/vwc_rollback.sh delete aegis-validating-webhook    # delete the VWC
+#
+NAME=${2:-aegis-validating-webhook}
+CMD=${1:-}
+
+if [ -z "$CMD" ]; then
+  echo "Usage: $0 <ignore|fail|delete> [vwc-name]"
+  exit 2
+fi
+
+case "$CMD" in
+  ignore)
+    echo "Patching ValidatingWebhookConfiguration $NAME failurePolicy -> Ignore"
+    kubectl patch validatingwebhookconfiguration "$NAME" --type='json' -p '[{"op":"replace","path":"/webhooks/0/failurePolicy","value":"Ignore"}]'
+    ;;
+  fail)
+    echo "Patching ValidatingWebhookConfiguration $NAME failurePolicy -> Fail"
+    kubectl patch validatingwebhookconfiguration "$NAME" --type='json' -p '[{"op":"replace","path":"/webhooks/0/failurePolicy","value":"Fail"}]'
+    ;;
+  delete)
+    echo "Deleting ValidatingWebhookConfiguration $NAME"
+    kubectl delete validatingwebhookconfiguration "$NAME" || true
+    ;;
+  *)
+    echo "Unknown command $CMD"
+    exit 2
+    ;;
+esac
+
+echo "Done."
+
