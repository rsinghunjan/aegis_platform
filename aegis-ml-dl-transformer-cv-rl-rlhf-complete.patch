+#!/usr/bin/env python3
+"""
+Helper to download an MLflow artifact and cosign it using configured COSIGN_KEY_REF.
+Usage:
+  python3 services/mlflow/register_and_sign.py --run-id <run> --artifact-path hf_hf_archive/hf_model.tar.gz --cosign-key $COSIGN_KEY_REF
+"""
+import argparse, os, mlflow, subprocess, tempfile
+
