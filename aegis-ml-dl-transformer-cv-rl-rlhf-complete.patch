+#!/usr/bin/env python3
+"""
+Helpers to prepare model artifacts for Triton model repository:
+ - Convert a TorchScript/ONNX into a model folder with config.pbtxt
+ - Example usage:
+     python3 services/serving/export_to_triton.py --onnx /tmp/model.onnx --out /models/my_model/1
+"""
+import argparse, os, shutil, textwrap
+
+def write_config(model_name, input_shape=(1,3,224,224), dtype="FP32", out_dir="."):
+    conf = f"""
+name: "{model_name}"
+platform: "onnxruntime_onnx"
+max_batch_size: 8
+input [
+  {{
+    name: "input"
+    data_type: TYPE_{dtype}
+    dims: [{", ".join(map(str,input_shape[1:]))}]
+  }}
+]
+output [
+  {{
+    name: "output"
+    data_type: TYPE_{dtype}
+    dims: [ -1 ]
+  }}
+]
+instance_group [
+  {{
+    kind: KIND_GPU
+    count: 1
+  }}
+]
+"""
+    with open(os.path.join(out_dir, "config.pbtxt"), "w") as fh:
+        fh.write(textwrap.dedent(conf))
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--onnx", required=True)
+    p.add_argument("--out", required=True, help="target model version directory (e.g., /models/<model>/1)")
+    p.add_argument("--name", default="aegis_model")
+    args=p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    shutil.copy(args.onnx, os.path.join(args.out, "model.onnx"))
+    write_config(args.name, out_dir=args.out)
+    print("Wrote triton model in", args.out)
+
+if __name__=="__main__":
+    main()
+
