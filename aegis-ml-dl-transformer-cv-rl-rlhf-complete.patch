+#!/usr/bin/env python3
+"""
+Fine-tune a transformer model on a text classification task and register it to MLflow.
+Usage:
+  python3 services/train/finetune_transformer.py --dataset glue --task mrpc --model_name_or_path roberta-base --output_dir /tmp/ft
+
+This script:
+ - Loads HF dataset (or local CSV) and tokenizer/model
+ - Trains with Hugging Face Trainer
+ - Logs metrics and model artifacts to MLflow
+ - Optionally registers the model in MLflow model registry and cosign-signs the artifact
+"""
+import argparse, os, tempfile, subprocess, json
+from datasets import load_dataset, load_metric
+from transformers import (AutoTokenizer, AutoModelForSequenceClassification, TrainingArguments, Trainer)
+import numpy as np
+import mlflow, mlflow.pytorch
+
+def compute_metrics(eval_pred):
+    logits, labels = eval_pred
+    preds = np.argmax(logits, axis=-1)
+    acc = (preds == labels).mean()
+    return {"accuracy": float(acc)}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--dataset", default="glue")
+    p.add_argument("--task", default="mrpc")
+    p.add_argument("--model_name_or_path", default="roberta-base")
+    p.add_argument("--output_dir", default="/tmp/ft_model")
+    p.add_argument("--per_device_train_batch_size", type=int, default=8)
+    p.add_argument("--num_train_epochs", type=int, default=3)
+    p.add_argument("--mlflow_experiment", default="transformer-finetune")
+    p.add_argument("--register_name", default="")
+    args = p.parse_args()
+
+    ds = load_dataset(args.dataset, args.task)
+    tokenizer = AutoTokenizer.from_pretrained(args.model_name_or_path)
+
+    def tokenize_fn(ex):
+        return tokenizer(ex["sentence1"], ex.get("sentence2", None), truncation=True, padding="max_length", max_length=128)
+
+    tokenized = ds.map(tokenize_fn, batched=True)
+    tokenized = tokenized.remove_columns([c for c in tokenized["train"].column_names if c not in ("label","input_ids","attention_mask","token_type_ids")])
+    tokenized.set_format(type="torch")
+
+    model = AutoModelForSequenceClassification.from_pretrained(args.model_name_or_path, num_labels=len(set(ds["train"]["label"])))
+
+    training_args = TrainingArguments(
+        output_dir=args.output_dir,
+        evaluation_strategy="epoch",
+        save_strategy="epoch",
+        per_device_train_batch_size=args.per_device_train_batch_size,
+        per_device_eval_batch_size=32,
+        num_train_epochs=args.num_train_epochs,
+        logging_dir=f"{args.output_dir}/logs",
+        report_to="none",
+    )
+
+    trainer = Trainer(
+        model=model,
+        args=training_args,
+        train_dataset=tokenized["train"],
+        eval_dataset=tokenized["validation"] if "validation" in tokenized else tokenized["test"],
+        tokenizer=tokenizer,
+        compute_metrics=compute_metrics
+    )
+
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI", "http://mlflow:5000"))
+    mlflow.set_experiment(args.mlflow_experiment)
+    with mlflow.start_run():
+        trainer.train()
+        metrics = trainer.evaluate()
+        mlflow.log_metrics(metrics)
+        # Save model as HF format and as PyTorch for MLflow
+        save_dir = os.path.join(args.output_dir, "hf_model")
+        os.makedirs(save_dir, exist_ok=True)
+        trainer.save_model(save_dir)
+        # log model
+        mlflow.pytorch.log_model(model, artifact_path="pytorch_model")
+        # log HF model archive
+        arch_dir = tempfile.mkdtemp()
+        arch_path = os.path.join(arch_dir, "hf_model.tar.gz")
+        subprocess.check_call(["tar","-czf", arch_path, "-C", save_dir, "."])
+        mlflow.log_artifact(arch_path, artifact_path="hf_hf_archive")
+        # register if requested
+        if args.register_name:
+            # register the last logged pytorch model
+            run_id = mlflow.active_run().info.run_id
+            model_uri = f"runs:/{run_id}/pytorch_model"
+            mv = mlflow.register_model(model_uri, args.register_name)
+            print("Registered model:", mv.name, mv.version)
+            # optional cosign sign (operator must set COSIGN_KEY_REF)
+            cosign_key = os.environ.get("COSIGN_KEY_REF","")
+            if cosign_key:
+                # sign the archived hf tarball artifact (download from mlflow first)
+                local_art = "/tmp/hf_arch.tar.gz"
+                mlflow.artifacts.download_artifacts(artifact_uri=f"runs:/{run_id}/hf_hf_archive/hf_model.tar.gz", dst_path="/tmp")
+                try:
+                    subprocess.check_call(["cosign","sign","--key", cosign_key, local_art])
+                except Exception as e:
+                    print("Cosign sign failed:", e)
+    print("Fine-tune complete. Metrics:", metrics)
+
+if __name__=="__main__":
+    main()
+
