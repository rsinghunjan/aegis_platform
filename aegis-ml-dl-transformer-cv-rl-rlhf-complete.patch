+#!/usr/bin/env python3
+"""
+PPO trainer using Stable-Baselines3 for a Gym environment.
+ - Logs training metrics and checkpointed policy to MLflow
+ - Saves model artifact for later deployment in a policy registry
+Usage:
+  python3 services/rl/ppo_trainer.py --env CartPole-v1 --timesteps 100000
+"""
+import argparse, os, mlflow, gym, tempfile
+from stable_baselines3 import PPO
+from stable_baselines3.common.callbacks import BaseCallback
+
+class MLflowCallback(BaseCallback):
+    def __init__(self, log_interval=1000):
+        super().__init__(verbose=0)
+        self.log_interval = log_interval
+    def _on_step(self) -> bool:
+        if self.n_calls % self.log_interval == 0:
+            mlflow.log_metric("timestep", self.num_timesteps)
+        return True
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--env", default="CartPole-v1")
+    p.add_argument("--timesteps", type=int, default=100000)
+    p.add_argument("--mlflow_experiment", default="rl-ppo")
+    args=p.parse_args()
+
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    mlflow.set_experiment(args.mlflow_experiment)
+    env = gym.make(args.env)
+    model = PPO("MlpPolicy", env, verbose=1)
+    with mlflow.start_run():
+        cb = MLflowCallback()
+        model.learn(total_timesteps=args.timesteps, callback=cb)
+        # Save model
+        tmp = tempfile.mkdtemp()
+        path = os.path.join(tmp, "ppo_model.zip")
+        model.save(path)
+        mlflow.log_artifact(path, artifact_path="rl_policy")
+        print("Saved RL policy to", path)
+
+if __name__=="__main__":
+    main()
+
