+#!/usr/bin/env python3
+"""
+Basic PyTorch image classification training script using torchvision.
+ - Logs metrics and artifacts to MLflow
+ - Exports a TorchScript and ONNX artifact suitable for Triton/ONNXRuntime
+Usage:
+  python3 services/train/cv_train.py --data_dir ./data --epochs 10 --model resnet18
+"""
+import argparse, os, time, torch, torchvision
+import torch.nn as nn
+import torch.optim as optim
+from torchvision import transforms, datasets, models
+import mlflow, mlflow.pytorch, tempfile, subprocess
+
+def train_loop(model, loader, loss_fn, optimizer, device):
+    model.train()
+    total_loss=0.0
+    correct=0
+    total=0
+    for x,y in loader:
+        x,y = x.to(device), y.to(device)
+        optimizer.zero_grad()
+        out = model(x)
+        loss = loss_fn(out, y)
+        loss.backward()
+        optimizer.step()
+        total_loss += loss.item()*x.size(0)
+        preds = out.argmax(dim=1)
+        correct += (preds==y).sum().item()
+        total += x.size(0)
+    return total_loss/total, correct/total
+
+def eval_loop(model, loader, loss_fn, device):
+    model.eval()
+    total_loss=0.0
+    correct=0
+    total=0
+    with torch.no_grad():
+        for x,y in loader:
+            x,y = x.to(device), y.to(device)
+            out = model(x)
+            loss = loss_fn(out, y)
+            total_loss += loss.item()*x.size(0)
+            preds = out.argmax(dim=1)
+            correct += (preds==y).sum().item()
+            total += x.size(0)
+    return total_loss/total, correct/total
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--data_dir", required=True)
+    p.add_argument("--model", default="resnet18")
+    p.add_argument("--epochs", type=int, default=5)
+    p.add_argument("--batch_size", type=int, default=32)
+    p.add_argument("--mlflow_experiment", default="cv-train")
+    args=p.parse_args()
+
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    transform = transforms.Compose([transforms.Resize(224), transforms.CenterCrop(224), transforms.ToTensor()])
+    train_ds = datasets.ImageFolder(os.path.join(args.data_dir,"train"), transform=transform)
+    val_ds = datasets.ImageFolder(os.path.join(args.data_dir,"val"), transform=transform)
+    train_loader = torch.utils.data.DataLoader(train_ds, batch_size=args.batch_size, shuffle=True, num_workers=4)
+    val_loader = torch.utils.data.DataLoader(val_ds, batch_size=args.batch_size, shuffle=False, num_workers=4)
+
+    if args.model=="resnet18":
+        model = models.resnet18(pretrained=True)
+        model.fc = nn.Linear(model.fc.in_features, len(train_ds.classes))
+    else:
+        raise NotImplementedError("Only resnet18 scaffold implemented")
+    model = model.to(device)
+    loss_fn = nn.CrossEntropyLoss()
+    optimizer = optim.Adam(model.parameters(), lr=1e-4)
+
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    mlflow.set_experiment(args.mlflow_experiment)
+    with mlflow.start_run():
+        for e in range(args.epochs):
+            train_loss, train_acc = train_loop(model, train_loader, loss_fn, optimizer, device)
+            val_loss, val_acc = eval_loop(model, val_loader, loss_fn, device)
+            mlflow.log_metrics({"train_loss":train_loss,"train_acc":train_acc,"val_loss":val_loss,"val_acc":val_acc}, step=e)
+            print(f"Epoch {e}: train_acc={train_acc} val_acc={val_acc}")
+        # save PyTorch model
+        model_path = "/tmp/cv_model.pt"
+        torch.save(model.state_dict(), model_path)
+        mlflow.log_artifact(model_path, artifact_path="cv_model")
+        # export TorchScript
+        example = torch.rand(1,3,224,224).to(device)
+        traced = torch.jit.trace(model, example)
+        ts_path = "/tmp/cv_model_ts.pt"
+        traced.save(ts_path)
+        mlflow.log_artifact(ts_path, artifact_path="cv_model")
+        # export ONNX
+        onnx_path = "/tmp/cv_model.onnx"
+        torch.onnx.export(model, example, onnx_path, input_names=["input"], output_names=["output"], opset_version=12)
+        mlflow.log_artifact(onnx_path, artifact_path="cv_model")
+    print("CV training complete and logged to MLflow")
+
+if __name__=="__main__":
+    main()
+
