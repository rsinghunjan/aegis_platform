+    p.add_argument("--run-id", required=True)
+    p.add_argument("--artifact-path", required=True)
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KEY_REF",""))
+    p.add_argument("--mlflow-tracking-uri", default=os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    args=p.parse_args()
+    mlflow.set_tracking_uri(args.mlflow_tracking_uri)
+    tmp = tempfile.mkdtemp()
+    local = mlflow.artifacts.download_artifacts(artifact_uri=f"runs:/{args.run_id}/{args.artifact_path}", dst_path=tmp)
+    print("Downloaded artifact to", local)
+    if args.cosign_key:
+        subprocess.check_call(["cosign","sign","--key", args.cosign_key, local])
+        print("Signed artifact with", args.cosign_key)
+    else:
+        print("No COSIGN_KEY provided; skipping sign")
+
+if __name__=="__main__":
