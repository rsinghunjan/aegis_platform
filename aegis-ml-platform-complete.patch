+#!/usr/bin/env python3
+"""
+Example canary controller:
+ - monitors a canary deployment endpoint
+ - runs acceptance tests (simple HTTP checks)
+ - if healthy, posts a comment to the PR and optionally merges per policy (shown as placeholder)
+ - if unhealthy, creates a rollback PR via ops/self_heal/gitops_rollback helper
+"""
+import os, requests, time, sys, subprocess
+
+CANARY_URL = os.environ.get("CANARY_HEALTH_URL","http://canary.svc/health")
+PR_NUMBER = os.environ.get("CANARY_PR","")
+GITHUB_REPO = os.environ.get("GITHUB_REPO","owner/repo")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN","")
+
+def run_acceptance():
+    try:
+        r = requests.get(CANARY_URL, timeout=5)
+        return r.status_code == 200
+    except Exception:
+        return False
+
+def post_comment(pr, body):
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues/{pr}/comments"
+    r = requests.post(url, headers={"Authorization":f"token {GITHUB_TOKEN}"}, json={"body":body}, timeout=10)
+    return r.status_code
+
+def merge_pr(pr):
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/pulls/{pr}/merge"
+    r = requests.put(url, headers={"Authorization":f"token {GITHUB_TOKEN}"}, json={"merge_method":"squash"}, timeout=10)
+    return r.status_code == 200
+
+if __name__ == "__main__":
+    ok = run_acceptance()
+    if ok:
+        print("Canary healthy")
+        if PR_NUMBER:
+            post_comment(PR_NUMBER, "Canary healthy: promoting to main per policy.")
+            # Optionally merge if policy allowed - keep placeholder
+            # merge_pr(PR_NUMBER)
+    else:
+        print("Canary failed: creating rollback PR and generating attestation (placeholder)")
+        if PR_NUMBER:
+            post_comment(PR_NUMBER, "Canary failed: rollback initiated and attestation generated.")
+        # create rollback PR logic omitted - use existing gitops rollback helper
