+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple script to push model files into Triton model repo and create a canary commit branch.
+# This assumes the Triton model repo is a git repo with manifests under manifests/
+MODEL_DIR=${1:-}
+MODEL_NAME=${2:-my_model}
+GITOPS_REPO=${3:-git@github.com:owner/gitops-repo.git}
+WORKDIR=$(mktemp -d)
+git clone "$GITOPS_REPO" "$WORKDIR"
+cp -r "$MODEL_DIR" "$WORKDIR/manifests/models/${MODEL_NAME}"
+cd "$WORKDIR"
+git checkout -b "canary/${MODEL_NAME}/$(date +%s)"
+git add manifests/
+git commit -m "Canary deploy ${MODEL_NAME}"
+git push origin HEAD
+echo "Created canary branch and pushed to repo; open PR to trigger GitOps"
