+#!/usr/bin/env python3
+"""
+Simple drift detector using Evidently (if installed) or a fallback distribution check.
+Runs periodically, compares a baseline dataset (from storage) vs recent predictions, and writes report + alert.
+"""
+import os, json, pandas as pd, time, subprocess
+EVIDENTLY_OK = False
+try:
+    from evidently.report import Report
+    from evidently.metrics import ColumnDriftMetric
+    EVIDENTLY_OK = True
+except Exception:
+    EVIDENTLY_OK = False
+
+BASELINE = os.environ.get("DRIFT_BASELINE","/data/baseline.csv")
+RECENT = os.environ.get("DRIFT_RECENT","/data/recent.csv")
+ALERT_WEBHOOK = os.environ.get("DRIFT_ALERT_WEBHOOK","")
+
+def send_alert(msg):
+    if ALERT_WEBHOOK:
+        subprocess.call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps({"msg":msg}), ALERT_WEBHOOK])
+    else:
+        print("DRIFT ALERT:", msg)
+
+def run_evidently_check():
+    baseline = pd.read_csv(BASELINE)
+    recent = pd.read_csv(RECENT)
+    report = Report(metrics=[ColumnDriftMetric()])
+    report.run(reference_data=baseline, current_data=recent)
+    json_path = "/tmp/drift_report.json"
+    report.save_html("/tmp/drift_report.html")
+    # rudimentary: if any metric flagged as drift -> alert
+    # For simplicity, always post basic notification
+    send_alert("Evidently run complete; check /tmp/drift_report.html")
+
+def fallback_check():
+    # compute simple KL or distribution differences on a numeric column "pred"
+    import numpy as np
+    b = pd.read_csv(BASELINE)
+    r = pd.read_csv(RECENT)
+    if "pred" not in b.columns or "pred" not in r.columns:
+        print("No pred column; skipping drift")
+        return
+    kb = np.histogram(b["pred"], bins=20, density=True)[0]
+    kr = np.histogram(r["pred"], bins=20, density=True)[0]
+    # add small epsilon
+    kb = kb + 1e-9; kr = kr + 1e-9
+    kl = (kb * (kb / kr)).sum()
+    if kl > 0.5:
+        send_alert(f"Drift detected: KL={kl}")
+    else:
+        print("No drift detected, KL=", kl)
+
+if __name__ == "__main__":
+    if EVIDENTLY_OK:
+        run_evidently_check()
+    else:
+        fallback_check()
+
