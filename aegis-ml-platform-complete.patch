+#!/usr/bin/env bash
+set -euo pipefail
+if [ "$#" -lt 2 ]; then
+  echo "Usage: cosign_utils.sh sign <path> OR cosign_utils.sh verify <path> <pubkey>"
+  exit 2
+fi
+cmd="$1"; shift
+if [ "$cmd" = "sign" ]; then
+  PATH_TO="$1"
+  COSIGN_KEY=${COSIGN_KEY_REF:-}
+  if [ -z "$COSIGN_KEY" ]; then echo "COSIGN_KEY_REF not set"; exit 2; fi
+  if [ -d "$PATH_TO" ]; then
+    tar -czf /tmp/obj.tar.gz -C "$(dirname "$PATH_TO")" "$(basename "$PATH_TO")"
+    cosign sign --key "$COSIGN_KEY" /tmp/obj.tar.gz
+  else
+    cosign sign --key "$COSIGN_KEY" "$PATH_TO"
+  fi
+elif [ "$cmd" = "verify" ]; then
+  PATH_TO="$1"; PUB="$2"
+  cosign verify --key "$PUB" "$PATH_TO"
+else
+  echo "Unknown command"
+fi
+
