+#!/usr/bin/env python3
+"""
+Simple model prediction server exposing Prometheus metrics and logging predictions to MLflow for monitoring.
+"""
+from flask import Flask, request, jsonify
+from prometheus_client import Counter, Histogram, generate_latest, CONTENT_TYPE_LATEST
+import time, os, mlflow
+
+PRED_COUNTER = Counter("aegis_model_predictions_total", "Total predictions", ["model"])
+LATENCY_HIST = Histogram("aegis_model_predict_latency_seconds", "Prediction latency", ["model"])
+
+app = Flask(__name__)
+mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+
+@app.route("/predict", methods=["POST"])
+def predict():
+    model = request.args.get("model","default")
+    start = time.time()
+    # Placeholder prediction
+    data = request.json
+    result = {"pred": 0.5, "meta": {"received": True}}
+    elapsed = time.time() - start
+    PRED_COUNTER.labels(model=model).inc()
+    LATENCY_HIST.labels(model=model).observe(elapsed)
+    # Log metric to mlflow - lightweight
+    try:
+        with mlflow.start_run(nested=True):
+            mlflow.log_metric("prediction_latency", elapsed)
+    except Exception:
+        pass
+    return jsonify(result)
+
+@app.route("/metrics")
+def metrics():
+    return generate_latest(), 200, {"Content-Type": CONTENT_TYPE_LATEST}
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=8080)
