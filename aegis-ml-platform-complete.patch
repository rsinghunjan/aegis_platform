+#!/usr/bin/env python3
+"""
+Register a trained model artifact with MLflow Model Registry and cosign/sign the artifact.
+Usage:
+  python3 register_and_sign.py --artifact-path ./models/my_model --model-name my-model --version-desc "v1"
+
+Environment:
+  MLFLOW_TRACKING_URI (e.g., http://mlflow:5000)
+  COSIGN_KEY_REF (KMS key ref)
+  EVIDENCE_BUCKET (s3://... for artifact copy)
+"""
+import os, argparse, shutil, subprocess, tempfile
+import mlflow
+from mlflow import pyfunc
+
+def upload_to_evidence(path, bucket):
+    if bucket.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", path, bucket.rstrip("/") + "/" + os.path.basename(path), "--recursive" if os.path.isdir(path) else ""])
+        return f"{bucket}/{os.path.basename(path)}"
+    # Add GCS if needed
+    return None
+
+def cosign_sign(path):
+    key = os.environ.get("COSIGN_KEY_REF","")
+    if not key:
+        raise RuntimeError("COSIGN_KEY_REF not set")
+    # cosign sign for files/archives; for directories create tarball
+    if os.path.isdir(path):
+        tar = tempfile.mktemp(suffix=".tar.gz")
+        subprocess.check_call(["tar","-czf",tar,"-C",os.path.dirname(path),os.path.basename(path)])
+        target = tar
+    else:
+        target = path
+    subprocess.check_call(["cosign","sign","--key", key, target])
+    return target
+
+def register_model(artifact_path, model_name, version_desc):
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    # use pyfunc.save_model for a directory artifact or log_artifact
+    if os.path.isdir(artifact_path):
+        # package as artifact and register
+        with mlflow.start_run() as run:
+            mlflow.log_artifacts(artifact_path, artifact_path="model_artifact")
+            artifact_uri = mlflow.get_artifact_uri("model_artifact")
+    else:
+        with mlflow.start_run() as run:
+            mlflow.log_artifact(artifact_path, artifact_path="model_artifact")
+            artifact_uri = mlflow.get_artifact_uri("model_artifact")
+    # create model version in registry
+    client = mlflow.tracking.MlflowClient()
+    mv = client.create_model_version(name=model_name, source=artifact_uri, run_id=run.info.run_id)
+    client.set_model_version_tag(model_name, mv.version, "description", version_desc)
+    return mv
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifact-path", required=True)
+    p.add_argument("--model-name", required=True)
+    p.add_argument("--version-desc", default="")
+    args = p.parse_args()
+    mv = register_model(args.artifact_path, args.model_name, args.version_desc)
+    print("Registered model version:", mv.name, mv.version)
+    signed = cosign_sign(args.artifact_path)
+    print("Signed artifact at:", signed)
+    # optionally upload to evidence bucket
+    EB = os.environ.get("EVIDENCE_BUCKET","")
+    if EB:
+        uri = upload_to_evidence(args.artifact_path if not os.path.isdir(args.artifact_path) else signed, EB)
+        print("Uploaded artifact to evidence:", uri)
+
+if __name__ == "__main__":
+    main()
+
