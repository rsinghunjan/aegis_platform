+#!/usr/bin/env python3
+"""
+A/B Canary controller:
+ - Configured via environment with PR branch and canary service details
+ - Pulls metrics from Prometheus (latency & error rate)
+ - Applies a simple statistical rule to decide promotion/rollback
+ - Calls Policy Engine before promote for high-risk checks
+ - Produces attestation pre/post promotion and uploads to evidence store
+"""
+import os, time, json, subprocess, requests
+from datetime import datetime
+
+PROM = os.environ.get("PROM_URL","http://prometheus.monitoring.svc:9090")
+CANARY_METRIC_QUERY = os.environ.get("CANARY_QUERY","histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"canary\"}[2m])) by (le))")
+PROM_THRESHOLD = float(os.environ.get("CANARY_LATENCY_THRESHOLD","1.0"))  # seconds p95
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL","http://policy-engine:8085/evaluate")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def prom_query(q):
+    r = requests.get(PROM + "/api/v1/query", params={"query": q}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def create_attestation(obj, name="canary"):
+    tmp = f"/tmp/{name}-{int(time.time())}.json"
+    with open(tmp,"w") as fh:
+        json.dump(obj, fh, indent=2)
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key",COSIGN_KEY_REF,tmp])
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp",tmp,f"{EVIDENCE_BUCKET}/canary/{os.path.basename(tmp)}"])
+    return tmp
+
+def evaluate_canary():
+    j = prom_query(CANARY_METRIC_QUERY)
+    try:
+        val = float(j["data"]["result"][0]["value"][1])
+    except Exception:
+        val = 999.0
+    return val
+
+def policy_check(action, actor="automation"):
+    p = {"action": action, "actor": actor}
+    r = requests.post(POLICY_ENGINE, json=p, timeout=5)
+    r.raise_for_status()
+    return r.json()
+
+if __name__ == "__main__":
+    val = evaluate_canary()
+    obj = {"p95_latency": val, "ts": datetime.utcnow().isoformat()}
+    create_attestation(obj, name="canary-observation")
+    if val <= PROM_THRESHOLD:
+        # policy check for promote
+        dec = policy_check("deploy_low_risk")
+        if dec.get("allow"):
+            print("Promote canary - policy allowed")
+            create_attestation({"action":"promote","ts":datetime.utcnow().isoformat()},"canary-promote")
+            # Promotion mechanics: merge gitops PR or update manifests (omitted)
+        else:
+            print("Policy denied promote:", dec)
+    else:
+        print("Canary failed (p95)", val, "rollback")
+        create_attestation({"action":"rollback","reason":"latency","value":val},"canary-rollback")
+        # Rollback mechanics: create rollback PR (omitted)
+
