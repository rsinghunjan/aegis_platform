+#!/usr/bin/env python3
+"""
+Optuna hyperparameter tuning example with MLflow integration.
+ - Runs a simple trial loop and logs best parameters to MLflow
+"""
+import os, optuna, mlflow
+from mlflow.tracking import MlflowClient
+import random, time
+
+MLFLOW_URI = os.environ.get("MLFLOW_TRACKING_URI", "http://mlflow:5000")
+mlflow.set_tracking_uri(MLFLOW_URI)
+
+def objective(trial):
+    lr = trial.suggest_float("lr", 1e-5, 1e-1, log=True)
+    depth = trial.suggest_int("depth", 1, 6)
+    # Simulate training; replace with real training that logs artifacts
+    metric = (0.2 / lr) * random.random() + depth * 0.01
+    time.sleep(0.5)
+    return metric
+
+def run_study(n_trials=20, experiment_name="optuna-experiment"):
+    client = MlflowClient()
+    study = optuna.create_study(direction="minimize")
+    with mlflow.start_run(run_name="optuna_run") as run:
+        mlflow.log_param("study_name", study.study_name)
+        study.optimize(objective, n_trials=n_trials)
+        best = study.best_params
+        mlflow.log_params(best)
+        mlflow.set_tag("optuna_best", str(best))
+    print("Best params:", best)
+    return best
+
+if __name__ == "__main__":
+    run_study()
+
