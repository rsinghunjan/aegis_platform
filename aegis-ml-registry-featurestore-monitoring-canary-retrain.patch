+"""
+Feast feature ingestion and dataset versioning helper (local provider).
+ - Writes feature parquet files with dataset version metadata
+ - Registers dataset version metadata in a simple JSON registry for lineage
+"""
+import os, json, pandas as pd
+from datetime import datetime
+
+DATA_DIR = os.environ.get("FEAST_DATA_DIR", "/data/feast")
+REGISTRY = os.environ.get("FEAST_LINEAGE_REGISTRY", "/data/feast/lineage_registry.json")
+
+def write_versioned_dataset(df: pd.DataFrame, dataset_name: str):
+    os.makedirs(DATA_DIR, exist_ok=True)
+    ts = datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
+    fname = f"{dataset_name}-{ts}.parquet"
+    path = os.path.join(DATA_DIR, fname)
+    df.to_parquet(path, index=False)
+    # record lineage
+    rec = {"dataset": dataset_name, "path": path, "ts": ts}
+    try:
+        reg = json.load(open(REGISTRY))
+    except Exception:
+        reg = []
+    reg.append(rec)
+    with open(REGISTRY, "w") as fh:
+        json.dump(reg, fh, indent=2)
+    return path
+
+def example_ingest():
+    df = pd.DataFrame({"user_id":[1,2,3], "ctr":[0.1,0.5,0.9], "ts":[datetime.utcnow()]*3})
+    p = write_versioned_dataset(df, "user_ctr")
+    print("Wrote dataset:", p)
+
+if __name__ == "__main__":
+    example_ingest()
