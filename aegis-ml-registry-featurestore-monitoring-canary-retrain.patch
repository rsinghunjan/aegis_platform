+#!/usr/bin/env python3
+"""
+Model registry integration:
+ - Register model with MLflow Model Registry
+ - Verify artifact cosign signature
+ - Post registration event to Policy Engine to decide auto-promotion (deploy)
+ - Produce a signed attestation bundle for registry events and upload to evidence store
+
+Environment:
+ - MLFLOW_TRACKING_URI
+ - COSIGN_KEY_REF (for signing attestation)
+ - POLICY_ENGINE_URL (http://policy-engine:8085/evaluate)
+ - EVIDENCE_BUCKET (s3://... or gs://...)
+ - VAULT_DELEGATION_PATH (optional)
+"""
+import os, json, subprocess, tempfile
+from datetime import datetime
+import mlflow
+from mlflow.tracking import MlflowClient
+import requests
+
+MLFLOW_URI = os.environ.get("MLFLOW_TRACKING_URI", "http://mlflow:5000")
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL", "http://policy-engine:8085/evaluate")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF", "")
+
+def cosign_verify(artifact_path, pubkey=None):
+    # best-effort verify; caller must ensure cosign is installed
+    cmd = ["cosign", "verify"]
+    if pubkey:
+        cmd += ["--key", pubkey]
+    cmd.append(artifact_path)
+    try:
+        subprocess.check_call(cmd)
+        return True
+    except subprocess.CalledProcessError:
+        return False
+
+def sign_and_upload_manifest(manifest):
+    tmpdir = tempfile.mkdtemp()
+    path = os.path.join(tmpdir, f"registry_attestation_{int(__import__('time').time())}.json")
+    with open(path, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    # sign
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign", "sign", "--key", COSIGN_KEY_REF, path])
+    # upload
+    if EVIDENCE_BUCKET:
+        if EVIDENCE_BUCKET.startswith("s3://"):
+            subprocess.check_call(["aws","s3","cp", path, f"{EVIDENCE_BUCKET}/registry/{os.path.basename(path)}"])
+            return f"{EVIDENCE_BUCKET}/registry/{os.path.basename(path)}"
+        elif EVIDENCE_BUCKET.startswith("gs://"):
+            subprocess.check_call(["gsutil","cp", path, f"{EVIDENCE_BUCKET}/registry/{os.path.basename(path)}"])
+            return f"{EVIDENCE_BUCKET}/registry/{os.path.basename(path)}"
+    return None
+
+def register_model(artifact_uri, model_name, actor="automation"):
+    mlflow.set_tracking_uri(MLFLOW_URI)
+    client = MlflowClient()
+    # create model version (artifact_uri should be MLflow artifact URI or accessible location)
+    mv = client.create_model_version(name=model_name, source=artifact_uri, run_id=None)
+    manifest = {
+        "event": "model_registered",
+        "model_name": model_name,
+        "version": mv.version,
+        "artifact": artifact_uri,
+        "registered_by": actor,
+        "ts": datetime.utcnow().isoformat() + "Z"
+    }
+    signed_uri = sign_and_upload_manifest(manifest)
+    # call policy engine to evaluate deploy action
+    payload = {"action": "deploy_low_risk", "actor": actor}
+    try:
+        r = requests.post(POLICY_ENGINE, json=payload, timeout=5)
+        r.raise_for_status()
+        decision = r.json()
+    except Exception as e:
+        decision = {"allow": False, "reason": "policy_error", "error": str(e)}
+    # record decision in manifest and re-upload
+    manifest["policy_decision"] = decision
+    sign_and_upload_manifest(manifest)
+    return {"model_version": mv.version, "policy": decision, "manifest_uri": signed_uri}
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifact-uri", required=True)
+    p.add_argument("--model-name", required=True)
+    p.add_argument("--actor", default="automation")
+    args = p.parse_args()
+    print(register_model(args.artifact_uri, args.model_name, actor=args.actor))
+
