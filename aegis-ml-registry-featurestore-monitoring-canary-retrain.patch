+#!/usr/bin/env python3
+"""
+Drift detector that triggers retrain:
+ - Checks drift via Evidently or simple distribution test
+ - On drift detection, creates an attestation bundle (pre-retrain evidence), calls a CI retrain webhook,
+   and posts incident to policy engine for approval if required.
+Environment:
+ - DRIFT_BASELINE, DRIFT_RECENT (CSV paths)
+ - RETRAIN_WEBHOOK (CI endpoint to dispatch retrain job)
+ - POLICY_ENGINE_URL
+ - EVIDENCE_BUCKET, COSIGN_KEY_REF
+"""
+import os, json, subprocess, tempfile
+from datetime import datetime
+import requests, pandas as pd
+
+DRIFT_BASELINE = os.environ.get("DRIFT_BASELINE", "/data/baseline.csv")
+DRIFT_RECENT = os.environ.get("DRIFT_RECENT", "/data/recent.csv")
+RETRAIN_WEBHOOK = os.environ.get("RETRAIN_WEBHOOK", "")
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL", "http://policy-engine:8085/evaluate")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF", "")
+
+def detect_drift():
+    # simple mean difference on "pred" column
+    if not (os.path.exists(DRIFT_BASELINE) and os.path.exists(DRIFT_RECENT)):
+        return False, "no_data"
+    b = pd.read_csv(DRIFT_BASELINE)
+    r = pd.read_csv(DRIFT_RECENT)
+    if "pred" not in b.columns or "pred" not in r.columns:
+        return False, "no_pred"
+    diff = abs(b["pred"].mean() - r["pred"].mean())
+    # threshold heuristic
+    return diff > 0.1, diff
+
+def create_attestation(event_name, details):
+    tmp = tempfile.mkdtemp()
+    path = os.path.join(tmp, f"{event_name}-{int(__import__('time').time())}.json")
+    with open(path, "w") as fh: json.dump(details, fh, indent=2)
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, path])
+    if EVIDENCE_BUCKET:
+        if EVIDENCE_BUCKET.startswith("s3://"):
+            subprocess.check_call(["aws","s3","cp", path, f"{EVIDENCE_BUCKET}/retrain/{os.path.basename(path)}"])
+            return f"{EVIDENCE_BUCKET}/retrain/{os.path.basename(path)}"
+    return None
+
+def trigger_retrain(model_name):
+    payload = {"model": model_name, "reason": "drift_detected", "ts": datetime.utcnow().isoformat()}
+    # policy eval: some retrains may require manual approval
+    pol = {"action": "deploy_high_risk", "actor": "automation"}
+    try:
+        r = requests.post(POLICY_ENGINE, json=pol, timeout=5)
+        r.raise_for_status()
+        decision = r.json()
+    except Exception as e:
+        decision = {"allow": False, "reason": "policy_error", "error": str(e)}
+    att = create_attestation("pre_retrain", {"model": model_name, "decision": decision})
+    if not decision.get("allow", False):
+        # open manual ticket or notify
+        return {"ok": False, "decision": decision, "attestation": att}
+    # call retrain webhook (CI) to start retrain pipeline
+    if RETRAIN_WEBHOOK:
+        r = requests.post(RETRAIN_WEBHOOK, json=payload, timeout=5)
+        return {"ok": r.status_code in (200,201), "response": r.text, "attestation": att}
+    return {"ok": False, "reason": "no_retrain_webhook", "attestation": att}
+
+if __name__ == "__main__":
+    drift, info = detect_drift()
+    if drift:
+        print("Drift detected:", info)
+        res = trigger_retrain("default-model")
+        print("Retrain trigger result:", res)
+    else:
+        print("No drift:", info)
+
