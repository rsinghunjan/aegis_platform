+#!/usr/bin/env python3
+"""
+Compute SHAP explanations for a model and attach the explanation artifact to MCP evidence bundle.
+Requires model inference function that loads the model artifact.
+"""
+import os, json, requests
+import shap, numpy as np
+from joblib import load
+
+MCP_URL = os.environ.get("MCP_URL","http://mcp.mcp.svc.cluster.local:8000")
+MCP_TOKEN = os.environ.get("MCP_TOKEN","")
+MODEL_ARTIFACT = os.environ.get("MODEL_ARTIFACT","/tmp/model.joblib")
+S3_UPLOAD_CMD = os.environ.get("S3_UPLOAD_CMD","aws s3 cp {file} s3://aegis-explainability/{file}")
+
+def headers():
+    h = {"Content-Type":"application/json"}
+    if MCP_TOKEN: h["Authorization"] = f"Bearer {MCP_TOKEN}"
+    return h
+
+def load_model(path):
+    return load(path)
+
+def compute_shap(model, X_sample):
+    explainer = shap.Explainer(model.predict, X_sample)
+    shap_values = explainer(X_sample)
+    return shap_values
+
+def upload_and_record(model_id, version, shap_values, out_file="/tmp/shap.json"):
+    # Serialize shap values (simplified)
+    with open(out_file, "w") as f:
+        json.dump({"shap_mean": shap_values.values.mean(axis=0).tolist()}, f)
+    # Upload to object store (placeholder)
+    dest = out_file  # in prod run S3 upload
+    try:
+        os.system(S3_UPLOAD_CMD.format(file=out_file))
+        shap_uri = f"s3://aegis-explainability/{os.path.basename(out_file)}"
+    except Exception:
+        shap_uri = f"file://{out_file}"
+    evidence = {
+        "schema_version":"1.1",
+        "model_id": model_id,
+        "version": version,
+        "explainability": { "shap_uri": shap_uri, "explain_tool": "shap" }
+    }
+    requests.post(f"{MCP_URL}/model-context", json=evidence, headers=headers())
+
+if __name__ == "__main__":
+    model = load_model(MODEL_ARTIFACT)
+    # Generate synthetic sample or read a representative sample
+    X = np.random.rand(100, model.n_features_in_) if hasattr(model, "n_features_in_") else np.random.rand(100, 10)
+    sv = compute_shap(model, X)
+    upload_and_record(os.environ.get("MODEL_ID","demo"), os.environ.get("MODEL_VERSION","v1"), sv)
+
