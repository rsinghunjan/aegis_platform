+#!/usr/bin/env python3
+"""
+Canary evaluation script:
+ - fetch canary metrics (simulated)
+ - compare against baseline SLOs and decide whether to promote or signal rollback via MCP/Gatekeeper
+"""
+import os, requests, json, random, sys
+
+MCP_URL = os.environ.get("MCP_URL","http://mcp.mcp.svc.cluster.local:8000")
+GATEKEEPER_URL = os.environ.get("GATEKEEPER_URL","http://gatekeeper.k8s.svc:8080")
+
+def fetch_canary_metrics():
+    # Simulate metrics fetch; replace with real queries to monitoring backend
+    return {"latency_p95": random.uniform(50,120), "error_rate": random.uniform(0,0.05)}
+
+def check_slo(metrics):
+    if metrics["latency_p95"] > 100 or metrics["error_rate"] > 0.02:
+        return False
+    return True
+
+def record_decision(decision, model_id, version):
+    payload = {"model_id":model_id,"version":version,"decision":decision}
+    requests.post(f"{MCP_URL}/model-context", json={"model_id":model_id,"version":version,"notes":f"canary_decision:{decision}"})
+
+if __name__ == "__main__":
+    model_id = os.environ.get("MODEL_ID","demo")
+    version = os.environ.get("MODEL_VERSION","new")
+    metrics = fetch_canary_metrics()
+    ok = check_slo(metrics)
+    if ok:
+        record_decision("promote", model_id, version)
+        print("Canary OK, promote")
+        sys.exit(0)
+    else:
+        record_decision("rollback", model_id, version)
+        # call Gatekeeper or deployment API to rollback
+        try:
+            requests.post(f"{GATEKEEPER_URL}/v1/policies/rollback", json={"model_id":model_id,"version":version}, timeout=5)
+        except Exception:
+            pass
+        print("Canary failed, rollback triggered")
+        sys.exit(2)
+
