+"""
+Ray Tune example integrated with MCP: runs hyperparameter search and upserts tuning metadata.
+"""
+import os
+from ray import tune
+import requests, json
+
+MCP_URL = os.environ.get("MCP_URL","http://mcp.mcp.svc.cluster.local:8000")
+MCP_TOKEN = os.environ.get("MCP_TOKEN","")
+
+def train_fn(config):
+    x = config["x"]
+    tune.report(loss=(x - 3) ** 2)
+
+def headers():
+    h = {"Content-Type":"application/json"}
+    if MCP_TOKEN: h["Authorization"] = f"Bearer {MCP_TOKEN}"
+    return h
+
+def run_tune(model_id, version):
+    analysis = tune.run(train_fn, config={"x": tune.uniform(-10,10)}, num_samples=20)
+    best = analysis.get_best_config(metric="loss", mode="min")
+    evidence = {"schema_version":"1.1","model_id":model_id,"version":version,"training_job":{"orchestrator":"raytune","tuning":{"strategy":"raytune","study_id": analysis._experiment_tag}}}
+    requests.post(f"{MCP_URL}/model-context", json=evidence, headers=headers())
+    print("Ray Tune complete. Best config:", best)
+
+if __name__ == "__main__":
+    run_tune("ray-demo","v0")
+
