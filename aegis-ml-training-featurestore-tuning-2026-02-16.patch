+#!/usr/bin/env python3
+"""
+Ingest feature snapshots into Feast and record lineage into MCP evidence bundle.
+"""
+import os, json, requests, datetime
+from feast import FeatureStore
+
+MCP_URL = os.environ.get("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+MCP_TOKEN = os.environ.get("MCP_TOKEN", "")
+
+def headers():
+    h = {"Content-Type":"application/json"}
+    if MCP_TOKEN:
+        h["Authorization"] = f"Bearer {MCP_TOKEN}"
+    return h
+
+def ingest_snapshot(feature_repo_path, snapshot_uri, model_id, version):
+    fs = FeatureStore(repo_path=feature_repo_path)
+    # This is an example; actual ingestion depends on Feast version and infra
+    # Assume snapshot stored in snapshot_uri (parquet/csv) and ingested with offline store
+    now = datetime.datetime.utcnow().isoformat() + "Z"
+    evidence = {
+        "schema_version": "1.1",
+        "model_id": model_id,
+        "version": version,
+        "feature_store": { "provider": "feast", "repo": feature_repo_path, "snapshot_uri": snapshot_uri },
+        "lineage": {
+            "produced_at": now,
+            "producer": "feature_pipeline",
+            "datasets": [ { "id": "orders", "uri": "s3://data/orders/2026-02" } ]
+        }
+    }
+    r = requests.post(f"{MCP_URL}/model-context", json=evidence, headers=headers(), timeout=10)
+    r.raise_for_status()
+    print("Ingested evidence to MCP:", r.json())
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 5:
+        print("usage: ingest_features.py <repo_path> <snapshot_uri> <model_id> <version>")
+    else:
+        ingest_snapshot(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4])
