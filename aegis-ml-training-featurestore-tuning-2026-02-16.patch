+#!/usr/bin/env python3
+"""
+Simple Optuna integration that runs trials and posts summary to MCP as evidence (tuning metadata).
+"""
+import os, optuna, requests, json
+MCP_URL = os.environ.get("MCP_URL","http://mcp.mcp.svc.cluster.local:8000")
+MCP_TOKEN = os.environ.get("MCP_TOKEN","")
+
+def headers():
+    h = {"Content-Type":"application/json"}
+    if MCP_TOKEN: h["Authorization"] = f"Bearer {MCP_TOKEN}"
+    return h
+
+def objective(trial):
+    x = trial.suggest_float("x", -10, 10)
+    return (x - 2) ** 2
+
+def run_study(model_id, version):
+    study = optuna.create_study(direction="minimize")
+    study.optimize(objective, n_trials=20)
+    summary = {
+        "study_name": study.study_name,
+        "best_params": study.best_params,
+        "best_value": study.best_value,
+        "n_trials": len(study.trials)
+    }
+    evidence = {
+        "schema_version":"1.1",
+        "model_id": model_id,
+        "version": version,
+        "training_job": { "orchestrator":"optuna", "tuning": {"strategy":"optuna", "study_id": study.study_name} },
+        "notes": "Optuna tuning summary"
+    }
+    r = requests.post(f"{MCP_URL}/model-context", json=evidence, headers=headers())
+    r.raise_for_status()
+    print("Posted study summary to MCP:", summary)
+
+if __name__ == "__main__":
+    import sys
+    mid = sys.argv[1] if len(sys.argv)>1 else "optuna-demo"
+    ver = sys.argv[2] if len(sys.argv)>2 else "v0"
+    run_study(mid, ver)
+
