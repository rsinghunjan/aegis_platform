+#!/usr/bin/env python3
+"""
+Lightweight drift detector:
+ - Fetches baseline feature statistics from feature store metadata
+ - Computes current batch statistics and compares (JS divergence, mean/var differences)
+ - Emits a drift score and exposes a Prometheus metric push gateway or MCP webhook
+"""
+import os
+import json
+import numpy as np
+import boto3
+import requests
+from prometheus_client import CollectorRegistry, Gauge, push_to_gateway
+
+S3_BUCKET = os.environ.get("FEATURE_STORE_BUCKET", "aegis-features")
+PUSHGATEWAY = os.environ.get("PROM_PUSHGATEWAY", "")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+
+s3 = boto3.client("s3", region_name=REGION)
+
+def compute_stats(arr):
+    a = np.array(arr)
+    return {"mean": float(a.mean()), "var": float(a.var())}
+
+def compare_stats(base, current):
+    # simple metric: normalized difference in means + variance
+    dm = abs(current["mean"] - base["mean"]) / (abs(base["mean"]) + 1e-6)
+    dv = abs(current["var"] - base["var"]) / (abs(base["var"]) + 1e-6)
+    return float(dm + dv)
+
+def main():
+    # placeholder: read baseline JSON from S3 key baseline/stats.json
+    try:
+        baseline_obj = s3.get_object(Bucket=S3_BUCKET, Key="baseline/stats.json")
+        baseline = json.loads(baseline_obj["Body"].read().decode())
+    except Exception:
+        baseline = {"feature1":{"mean":0.0,"var":1.0}}
+
+    # get a sample current batch from S3 (placeholder)
+    try:
+        curr_obj = s3.get_object(Bucket=S3_BUCKET, Key="samples/current_batch.json")
+        current_batch = json.loads(curr_obj["Body"].read().decode())
+    except Exception:
+        current_batch = {"feature1":[0.1,0.2,0.15,0.05]}
+
+    scores = {}
+    for f, vals in current_batch.items():
+        base = baseline.get(f, {"mean":0.0,"var":1.0})
+        cur = compute_stats(vals)
+        score = compare_stats(base, cur)
+        scores[f] = score
+
+    drift_score = max(scores.values()) if scores else 0.0
+    print("drift_score", drift_score, scores)
+
+    # push to metrics (Prometheus pushgateway) if configured
+    if PUSHGATEWAY:
+        registry = CollectorRegistry()
+        g = Gauge('aegis_model_drift_score', 'Drift score for model', registry=registry)
+        g.set(drift_score)
+        push_to_gateway(PUSHGATEWAY, job='drift_detector', registry=registry)
+
+    # Also post to MCP
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/monitoring/drift", json={"score":drift_score,"per_feature":scores}, timeout=3.0)
+    except Exception:
+        pass
+
+if __name__ == "__main__":
+    main()
+
