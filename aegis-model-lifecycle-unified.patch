+#!/usr/bin/env python3
+"""
+Minimal dataset-versioning helper (DVC-lite):
+ - snapshot local dataset dir to object store and record a manifest in sqlite
+ - can list snapshots and get presigned URLs
+"""
+import os
+import uuid
+import sqlite3
+import json
+from datetime import datetime
+import boto3
+
+DB_PATH = os.environ.get("DATASET_DB", "/data/dataset_versions.db")
+S3_BUCKET = os.environ.get("DATASET_BUCKET", "aegis-datasets")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+
+os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+conn = sqlite3.connect(DB_PATH, check_same_thread=False)
+cur = conn.cursor()
+cur.execute("CREATE TABLE IF NOT EXISTS snapshots (id TEXT PRIMARY KEY, path TEXT, s3_prefix TEXT, metadata TEXT, ts INTEGER)")
+conn.commit()
+
+s3 = boto3.client("s3", region_name=REGION)
+
+def snapshot(local_dir: str, metadata: dict = None):
+    sid = str(uuid.uuid4())
+    prefix = f"datasets/{sid}/"
+    for root, _, files in os.walk(local_dir):
+        for f in files:
+            lp = os.path.join(root, f)
+            rel = os.path.relpath(lp, local_dir)
+            s3_key = prefix + rel
+            s3.upload_file(lp, S3_BUCKET, s3_key)
+    ts = int(datetime.utcnow().timestamp())
+    cur.execute("INSERT INTO snapshots (id,path,s3_prefix,metadata,ts) VALUES (?,?,?,?,?)", (sid, local_dir, prefix, json.dumps(metadata or {}), ts))
+    conn.commit()
+    return sid
+
+def list_snapshots():
+    cur.execute("SELECT id, path, s3_prefix, metadata, ts FROM snapshots ORDER BY ts DESC")
+    return [{"id": r[0], "path": r[1], "s3_prefix": r[2], "metadata": json.loads(r[3]), "ts": r[4]} for r in cur.fetchall()]
+
+def presign_object(s3_key: str, expires=3600):
+    return s3.generate_presigned_url('get_object', Params={'Bucket': S3_BUCKET, 'Key': s3_key}, ExpiresIn=expires)
+
