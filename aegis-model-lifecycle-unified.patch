+#!/usr/bin/env python3
+"""
+Promotion guard script:
+ - Fetches latest staging model metrics from MLflow
+ - Compares against baseline thresholds and required tests (drift detector),
+ - If checks pass, either transitions model to production or opens an A2A approval request.
+"""
+import os
+import sys
+import requests
+from services.mlflow.mlflow_client import get_latest_model_metrics
+
+MODEL_NAME = os.environ.get("MODEL_NAME", "aegis-model")
+REQUIRED_ACCURACY = float(os.environ.get("REQUIRED_ACCURACY", "0.80"))
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def check_and_promote():
+    metrics = get_latest_model_metrics(MODEL_NAME, stage="Staging")
+    if not metrics:
+        print("no staging model found")
+        return 1
+    acc = float(metrics.get("accuracy", 0.0))
+    print("staging accuracy", acc)
+    if acc >= REQUIRED_ACCURACY:
+        # optionally auto promote via MLflow client (left as operator decision)
+        print("meets threshold: request promotion approval via A2A")
+        body = {"action_id":"promote-"+MODEL_NAME, "artifact_uri": f"mlflow://{MODEL_NAME}", "approver":"mlops", "decision":"requested", "comment":"auto-promotion request"}
+        try:
+            r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+            if r.ok:
+                print("A2A request opened", r.json().get("id"))
+                requests.post(f"{AEGIS_MCP.rstrip('/')}/promotion/events", json={"model":MODEL_NAME,"accuracy":acc,"a2a":r.json().get("id")}, timeout=3.0)
+                return 0
+        except Exception as e:
+            print("failed to open A2A", e)
+            return 1
+    else:
+        print("does not meet required accuracy")
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/promotion/events", json={"model":MODEL_NAME,"accuracy":acc,"promote":False}, timeout=3.0)
+        return 2
+
+if __name__ == "__main__":
+    sys.exit(check_and_promote())
+
