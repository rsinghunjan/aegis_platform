+#!/usr/bin/env python3
+"""
+Simple feature store service that stores feature tables (parquet/csv)
+to an object store and keeps a small sqlite index for versioning.
+Provides:
+ - create_table(name, dataframe/bytes, metadata) -> version
+ - get_table(name, version=None) -> presigned_url / local download
+ - list_versions(name)
+"""
+import os
+import sqlite3
+import uuid
+import json
+from datetime import datetime
+import boto3
+
+DB_PATH = os.environ.get("FEATURE_STORE_DB", "/data/feature_store.db")
+S3_BUCKET = os.environ.get("FEATURE_STORE_BUCKET", "aegis-features")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+
+os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+conn = sqlite3.connect(DB_PATH, check_same_thread=False)
+cur = conn.cursor()
+cur.execute("CREATE TABLE IF NOT EXISTS tables (id TEXT PRIMARY KEY, name TEXT, s3_key TEXT, metadata TEXT, created_ts INTEGER)")
+conn.commit()
+
+s3 = boto3.client("s3", region_name=REGION)
+
+def create_table(name: str, local_path: str, metadata: dict = None):
+    vid = str(uuid.uuid4())
+    key = f"features/{name}/{vid}/{os.path.basename(local_path)}"
+    s3.upload_file(local_path, S3_BUCKET, key)
+    ts = int(datetime.utcnow().timestamp())
+    cur.execute("INSERT INTO tables (id,name,s3_key,metadata,created_ts) VALUES (?,?,?,?,?)", (vid, name, key, json.dumps(metadata or {}), ts))
+    conn.commit()
+    return vid
+
+def list_versions(name: str):
+    cur.execute("SELECT id, s3_key, metadata, created_ts FROM tables WHERE name=?", (name,))
+    return [{"id": r[0], "s3_key": r[1], "metadata": json.loads(r[2]), "created_ts": r[3]} for r in cur.fetchall()]
+
+def get_presigned_url(s3_key: str, expires=3600):
+    return s3.generate_presigned_url('get_object', Params={'Bucket': S3_BUCKET, 'Key': s3_key}, ExpiresIn=expires)
+
