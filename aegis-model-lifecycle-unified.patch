+#!/usr/bin/env python3
+"""
+Key rotation helper (high-level):
+ - Demonstrates pattern for rotating secrets used by Aegis (cosign pubkey secret example).
+ - Operator must ensure atomic rollout: create new secret, update deployments to reference new secret,
+   validate, and then delete old secret.
+"""
+import os
+import sys
+import subprocess
+import time
+
+NAMESPACE = os.environ.get("NAMESPACE", "aegis-system")
+OLD_SECRET = os.environ.get("OLD_SECRET", "cosign-key-old")
+NEW_SECRET = os.environ.get("NEW_SECRET", "cosign-key")
+NEW_PUBKEY_FILE = os.environ.get("NEW_PUBKEY_FILE")
+
+def rotate():
+    if not NEW_PUBKEY_FILE or not os.path.exists(NEW_PUBKEY_FILE):
+        print("NEW_PUBKEY_FILE must point to a file with the new public key")
+        sys.exit(1)
+    # create new temp secret
+    subprocess.check_call(["kubectl","-n",NAMESPACE,"create","secret","generic",NEW_SECRET,"--from-file=pubkey="+NEW_PUBKEY_FILE,"--dry-run=client","-o","yaml","|","kubectl","apply","-f","-"], shell=True)
+    print("New secret applied. Now rollout deployments referencing the new secret (operator step).")
+    # operator must patch deployments, wait for rollout and validate
+    time.sleep(1)
+
+if __name__ == "__main__":
+    rotate()
+
