+#!/usr/bin/env python3
+"""
+NSFW Moderation microservice (text + image heuristics).
+ - POST /moderate_text  {"text": "..."}
+ - POST /moderate_image {"image_b64": "..."}  (very basic heuristics here)
+
+Expose Prometheus metrics:
+ - aegis_moderation_requests_total{type="text|image"}
+ - aegis_moderation_blocked_total{type="text|image"}
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from prometheus_client import Counter, generate_latest, CONTENT_TYPE_LATEST
+from fastapi.responses import Response
+import os, re, base64, hashlib
+
+app = FastAPI(title="Aegis Moderation Service")
+
+# Simple heuristics: banned tokens (extend in production)
+BANNED_WORDS = set(w.strip().lower() for w in os.environ.get("MOD_BANNED_WORDS", "porn,sex,nude,xxx").split(","))
+
+REQ_COUNTER = Counter("aegis_moderation_requests_total", "Moderation requests", ["type"])
+BLOCK_COUNTER = Counter("aegis_moderation_blocked_total", "Moderation blocked", ["type"])
+
+class TextReq(BaseModel):
+    text: str
+
+class ImageReq(BaseModel):
+    image_b64: str
+
+@app.get("/metrics")
+def metrics():
+    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+def text_is_nsfw(text: str) -> (bool, list):
+    lowered = text.lower()
+    hits = [w for w in BANNED_WORDS if w and w in lowered]
+    return (len(hits) > 0, hits)
+
+@app.post("/moderate_text")
+def moderate_text(req: TextReq):
+    REQ_COUNTER.labels(type="text").inc()
+    nsfw, hits = text_is_nsfw(req.text)
+    if nsfw:
+        BLOCK_COUNTER.labels(type="text").inc()
+    return {"nsfw": nsfw, "hits": hits}
+
+@app.post("/moderate_image")
+def moderate_image(req: ImageReq):
+    REQ_COUNTER.labels(type="image").inc()
+    # Very basic heuristic: check image size and simple base64 signature to detect likely obscene small payloads.
+    try:
+        b = base64.b64decode(req.image_b64)
+        if len(b) < 512:
+            # too small -> likely invalid or thumbnail; treat as not flagged
+            return {"nsfw": False, "reason": "small_image"}
+        # heuristic: if filename-like bytes contain "porn" etc (not reliable)
+        if any(x.encode("utf-8") in b.lower() for x in BANNED_WORDS):
+            BLOCK_COUNTER.labels(type="image").inc()
+            return {"nsfw": True, "reason": "heuristic_bytes_hit"}
+        # default: not flagged
+        return {"nsfw": False}
+    except Exception as e:
+        raise HTTPException(status_code=400, detail="invalid base64")
+
