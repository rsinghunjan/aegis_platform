+"""
+Small helper to create A2A approval requests from services.
+"""
+import os, requests, uuid, time
+
+A2A_API = os.environ.get("A2A_API", "http://approver:8085")
+
+def request_approval(model_id: str, artifact_uri: str, reason: str, metadata: dict = None):
+    payload = {
+        "id": str(uuid.uuid4()),
+        "type": "approval_request",
+        "model_id": model_id,
+        "artifact_uri": artifact_uri,
+        "reason": reason,
+        "metadata": metadata or {},
+        "ts": int(time.time())
+    }
+    try:
+        r = requests.post(f"{A2A_API.rstrip('/')}/request", json=payload, timeout=5.0)
+        r.raise_for_status()
+        return payload["id"]
+    except Exception:
+        # best-effort: return request id (untracked) even on failure
+        return payload["id"]
