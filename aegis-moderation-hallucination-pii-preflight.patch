+"""
+Enhanced preflight: runs moderation (NSFW), hallucination verifier, PII scan/redaction,
+OPA policy check and optionally creates A2A approval requests when human signoff is required.
+
+This file implements:
+ - run_preflight(...) which accepts model_id, model_version, input_text, generated_output, retrieved_docs, options
+ - returns dict {allow: bool, reason: str, output: <possibly redacted output>, pending: bool, approval_id: str}
+"""
+import os, requests, json, logging
+from prometheus_client import Counter
+
+LOG = logging.getLogger("aegis.preflight")
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa:8181/v1/data/aegis/preflight")
+MODERATION_SVC = os.environ.get("MODERATION_SVC", "http://moderation:8080")
+PII_SVC = os.environ.get("PII_SVC", "http://pii:8080")
+VERIFIER_SVC = os.environ.get("VERIFIER_SVC", "http://verifier:8080")
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+# metrics
+PRE_FLIGHT_COUNTER = Counter("aegis_preflight_requests_total", "preflight requests", ["result"])
+MOD_BLOCKED_COUNTER = Counter("aegis_preflight_mod_blocked_total", "preflight moderation blocked", ["stage"])
+VERIFIER_FAIL_COUNTER = Counter("aegis_preflight_verifier_fail_total", "preflight verifier failures")
+PII_REDACT_COUNTER = Counter("aegis_preflight_pii_redact_total", "PII redactions performed")
+
+from .a2a_client import request_approval
+
+def run_opa_check(model_id, text, options):
+    payload = {"input": {"model_id": model_id, "input": text, "options": options or {}}}
+    try:
+        r = requests.post(OPA_URL, json=payload, timeout=5.0)
+        r.raise_for_status()
+        return r.json().get("result", {"allow": True, "reason": "opa missing result"})
+    except Exception as e:
+        LOG.warning("OPA check failed: %s", e)
+        return {"allow": True, "reason": f"opa error: {e}"}
+
+def call_moderation(text=None, image_b64=None):
+    try:
+        if text is not None:
+            r = requests.post(f"{MODERATION_SVC.rstrip('/')}/moderate_text", json={"text": text}, timeout=3.0)
+            r.raise_for_status()
+            return r.json()
+        if image_b64 is not None:
+            r = requests.post(f"{MODERATION_SVC.rstrip('/')}/moderate_image", json={"image_b64": image_b64}, timeout=3.0)
+            r.raise_for_status()
+            return r.json()
+    except Exception as e:
+        LOG.warning("moderation call failed: %s", e)
+        return {"nsfw": False, "reason": "moderation_error"}
+
+def call_verifier(output_text, retrieved_docs):
+    try:
+        r = requests.post(f"{VERIFIER_SVC.rstrip('/')}/verify", json={"text": output_text, "retrieved_docs": retrieved_docs}, timeout=5.0)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        LOG.warning("verifier call failed: %s", e)
+        # default to allow (fail-open) but mark reason
+        return {"allow": True, "score": 1.0, "reasons": ["verifier_unavailable"]}
+
+def call_pii_scan(text):
+    try:
+        r = requests.post(f"{PII_SVC.rstrip('/')}/scan_text", json={"text": text}, timeout=3.0)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        LOG.warning("pii scan failed: %s", e)
+        return {"count": 0, "pii": []}
+
+def call_pii_redact(text):
+    try:
+        r = requests.post(f"{PII_SVC.rstrip('/')}/redact_text", json={"text": text}, timeout=5.0)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        LOG.warning("pii redact failed: %s", e)
+        return {"redacted": text, "pii": []}
+
+def attach_mcp_evidence(model_id, run_id, artifact_uri, meta):
+    try:
+        rec = {"model_id": model_id, "version": "", "artifacts": [{"uri": artifact_uri}], "evaluation": {"run_id": run_id, "meta": meta}, "approvals": []}
+        requests.post(f"{AEGIS_MCP_API.rstrip('/')}/models/{model_id}/context", json=rec, timeout=5.0)
+    except Exception:
+        LOG.warning("failed attaching MCP evidence")
+
+def run_preflight(model_id, model_version, input_text, generated_output, retrieved_docs, options=None):
+    """
+    Perform moderation, verification and PII redaction for a generated output.
+    Returns:
+      {"allow": bool, "reason": str, "output": <possibly redacted output>, "pending": bool, "approval_id": str}
+    """
+    options = options or {}
+    PRE_FLIGHT_COUNTER.labels(result="started").inc()
+
+    # 1) Input moderation (block early)
+    mod_in = call_moderation(text=input_text)
+    if mod_in.get("nsfw", False):
+        MOD_BLOCKED_COUNTER.labels(stage="input").inc()
+        PRE_FLIGHT_COUNTER.labels(result="blocked_input").inc()
+        # Create an evidence + approval for human review
+        approval_id = request_approval(model_id, "", "input contains NSFW", {"stage": "input", "hits": mod_in.get("hits")})
+        return {"allow": False, "reason": "input_nsfw", "pending": True, "approval_id": approval_id}
+
+    # 2) Verifier: check generated output against retrieved docs
+    verifier_res = call_verifier(generated_output, retrieved_docs or [])
+    if not verifier_res.get("allow", True) or verifier_res.get("score", 1.0) < float(os.environ.get("VERIFIER_MIN_SCORE", "0.2")):
+        VERIFIER_FAIL_COUNTER.inc()
+        PRE_FLIGHT_COUNTER.labels(result="verifier_failed").inc()
+        approval_id = request_approval(model_id, "", "verifier_reject", {"score": verifier_res.get("score"), "reasons": verifier_res.get("reasons")})
+        return {"allow": False, "reason": "verifier_reject", "pending": True, "approval_id": approval_id}
+
+    # 3) PII scan and redact if needed
+    pii_scan = call_pii_scan(generated_output)
+    if pii_scan.get("count", 0) > 0:
+        PII_REDACT_COUNTER.inc()
+        redact_res = call_pii_redact(generated_output)
+        redacted_output = redact_res.get("redacted", generated_output)
+        PRE_FLIGHT_COUNTER.labels(result="pii_redacted").inc()
+    else:
+        redacted_output = generated_output
+
+    # 4) Output moderation on redacted output
+    mod_out = call_moderation(text=redacted_output)
+    if mod_out.get("nsfw", False):
+        MOD_BLOCKED_COUNTER.labels(stage="output").inc()
+        PRE_FLIGHT_COUNTER.labels(result="blocked_output").inc()
+        approval_id = request_approval(model_id, "", "output contains NSFW", {"stage": "output", "hits": mod_out.get("hits")})
+        return {"allow": False, "reason": "output_nsfw", "pending": True, "approval_id": approval_id}
+
+    # 5) OPA policy check (optional reinforcement)
+    opa_res = run_opa_check(model_id, redacted_output, options)
+    if not opa_res.get("allow", True):
+        PRE_FLIGHT_COUNTER.labels(result="opa_denied").inc()
+        approval_id = request_approval(model_id, "", "OPA denied output", {"reason": opa_res.get("reason")})
+        return {"allow": False, "reason": "opa_denied", "pending": True, "approval_id": approval_id}
+
+    PRE_FLIGHT_COUNTER.labels(result="allow").inc()
+    return {"allow": True, "reason": "preflight_passed", "output": redacted_output, "pending": False}
