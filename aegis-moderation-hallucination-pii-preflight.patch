+#!/usr/bin/env python3
+"""
+Simple hallucination verifier already present as a stub in repo; ensure service runs with /verify.
+We slightly extend to add Prometheus metrics and accept an optional confidence threshold param.
+"""
+from fastapi import FastAPI
+from pydantic import BaseModel
+from prometheus_client import Counter, generate_latest, CONTENT_TYPE_LATEST
+from fastapi.responses import Response
+import difflib
+
+app = FastAPI(title="Aegis Hallucination Verifier")
+
+VERIFY_COUNTER = Counter("aegis_verifier_requests_total", "Verifier requests")
+VERIFY_FAIL_COUNTER = Counter("aegis_verifier_fail_total", "Verifier failures")
+
+class VerifyReq(BaseModel):
+    text: str
+    retrieved_docs: list
+
+@app.get("/metrics")
+def metrics():
+    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+@app.post("/verify")
+def verify(req: VerifyReq):
+    VERIFY_COUNTER.inc()
+    doc_text = " ".join([d.get("text","") for d in req.retrieved_docs])
+    if not doc_text:
+        VERIFY_FAIL_COUNTER.inc()
+        return {"allow": False, "score": 0.0, "reasons": ["no supporting docs"]}
+    matcher = difflib.SequenceMatcher(None, req.text, doc_text)
+    score = matcher.ratio()
+    allow = score >= float(0.15)
+    if not allow:
+        VERIFY_FAIL_COUNTER.inc()
+    return {"allow": allow, "score": score, "reasons": []}
+
