+#!/usr/bin/env python3
+"""
+Extended jailed executor: before launching a job, verifies the signed tool manifest
+and checks that the requested tool is listed. It then launches a k8s Job from the template.
+"""
+import os, yaml, time, json, tempfile, subprocess
+from flask import Flask, request, jsonify
+from kubernetes import client, config
+from jinja2 import Template
+
+app = Flask(__name__)
+JOB_TEMPLATE_PATH = os.environ.get("JOB_TEMPLATE_PATH", "/workspace/k8s_job_template.yaml")
+MANIFEST_PATH = os.environ.get("TOOL_MANIFEST_PATH", "/workspace/tool_manifest/tool_manifest.json")
+
+config.load_incluster_config()
+batch = client.BatchV1Api()
+core = client.CoreV1Api()
+
+JOB_TMPL = open(JOB_TEMPLATE_PATH).read()
+
+def load_and_verify_manifest():
+    # call cosign verify; raises on failure
+    subprocess.check_call(["cosign","verify", MANIFEST_PATH])
+    with open(MANIFEST_PATH) as fh:
+        return json.load(fh)
+
+def render_job(job_name, image, command):
+    t = Template(JOB_TMPL)
+    txt = t.render(JOB_NAME=job_name, TOOL_IMAGE=image, TOOL_COMMAND=command)
+    return yaml.safe_load(txt)
+
+@app.route("/exec", methods=["POST"])
+def exec_tool():
+    body = request.json or {}
+    tool = body.get("tool")
+    if not tool:
+        return jsonify({"error":"tool required"}), 400
+    # verify manifest
+    try:
+        manifest = load_and_verify_manifest()
+    except Exception as e:
+        return jsonify({"error":"manifest_verify_failed", "detail": str(e)}), 500
+    lookup = {t["name"]: t for t in manifest.get("tools", [])}
+    if tool not in lookup:
+        return jsonify({"error":"tool_not_allowed"}), 403
+    tooldef = lookup[tool]
+    job_name = f"{tool}-{int(time.time())}"
+    job_spec = render_job(job_name, tooldef["image"], tooldef["command"])
+    # create job
+    try:
+        resp = batch.create_namespaced_job(namespace=os.environ.get("JOB_NAMESPACE","aegis-agent"), body=job_spec)
+    except Exception as e:
+        return jsonify({"error":"k8s_create_failed","detail":str(e)}),500
+    # wait (short) and collect logs (simplified)
+    time.sleep(3)
+    return jsonify({"job": resp.metadata.name})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8080")))
+
