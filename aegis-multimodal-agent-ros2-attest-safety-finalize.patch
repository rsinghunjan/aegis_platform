+"""
+Verify the cosign signature on the tool manifest and return JSON manifest if valid.
+Requires cosign CLI available on PATH.
+"""
+import subprocess, json, sys
+MANIFEST = sys.argv[1] if len(sys.argv)>1 else "ops/agents/tool_manifest/tool_manifest.json"
+
+def verify(manifest):
+    try:
+        out = subprocess.check_output(["cosign", "verify", manifest], stderr=subprocess.STDOUT)
+        print(out.decode())
+        # If verify succeeds, load manifest
+        with open(manifest) as fh:
+            return json.load(fh)
+    except subprocess.CalledProcessError as e:
+        print("cosign verify failed:", e.output.decode())
+        raise
+
+if __name__=="__main__":
+    m = verify(MANIFEST)
+    print("Manifest ok. tools:", [t["name"] for t in m["tools"]])
