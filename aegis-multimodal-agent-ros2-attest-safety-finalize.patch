+#!/usr/bin/env python3
+"""
+Agent service using an LLM planner (placeholder for LangChain integration).
+ - Receives task descriptions, requests a plan from the LLM, validates each action with OPA,
+   and submits approved tool calls to the jailed executor.
+ - Produces signed action logs (cosign) and uploads to S3.
+"""
+import os, json, time, requests, subprocess
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+OPA_URL = os.environ.get("OPA_URL","http://opa:8181/v1/data/aegis/agent/allow")
+JAILED_EXECUTOR_URL = os.environ.get("JAILED_EXECUTOR_URL","http://jailed-executor:8080/exec")
+TOOL_MANIFEST_PATH = os.environ.get("TOOL_MANIFEST_PATH","/workspace/tool_manifest/tool_manifest.json")
+S3_BUCKET = os.environ.get("S3_UPLOAD","")
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI","")
+
+def ask_llm_for_plan(prompt):
+    # Placeholder LLM planner: in production use LangChain/OpenAI/Local LLM.
+    # For now return a deterministic plan for known prompts.
+    if "list" in prompt.lower():
+        return [{"tool":"list_datasets","args":{}}]
+    return [{"tool":"list_datasets","args":{}},{"tool":"train","args":{"dataset":"demo"}}]
+
+def opa_check(action):
+    payload = {"input":{"action":action}}
+    r = requests.post(OPA_URL, json=payload, timeout=5)
+    r.raise_for_status()
+    return bool(r.json().get("result", False))
+
+def submit_to_executor(action):
+    r = requests.post(JAILED_EXECUTOR_URL, json=action, timeout=300)
+    r.raise_for_status()
+    return r.json()
+
+def sign_and_upload(path):
+    if COSIGN_KEY:
+        try:
+            subprocess.check_call(["cosign","sign","--key",COSIGN_KEY, path])
+        except Exception:
+            pass
+    if S3_BUCKET:
+        import boto3
+        s3 = boto3.client("s3")
+        s3.upload_file(path, S3_BUCKET, f"agent_logs/{os.path.basename(path)}")
+
+@app.route("/run", methods=["POST"])
+def run():
+    body = request.json or {}
+    prompt = body.get("prompt","run task")
+    plan = ask_llm_for_plan(prompt)
+    session = int(time.time())
+    logs = []
+    for step in plan:
+        action = {"tool": step["tool"], "args": step.get("args",{}), "session": session, "ts": time.time()}
+        allowed = opa_check({"type":"read" if step["tool"]=="list_datasets" else "write", "resource": step["tool"]})
+        if not allowed:
+            action["status"]="blocked"
+            logs.append(action)
+            break
+        try:
+            res = submit_to_executor(action)
+            action["status"]="ok"
+            action["result"]=res
+        except Exception as e:
+            action["status"]="error"
+            action["error"]=str(e)
+        logs.append(action)
+    # write log
+    path = f"/tmp/agent_{session}.json"
+    with open(path,"w") as fh:
+        json.dump(logs, fh, indent=2)
+    sign_and_upload(path)
+    return jsonify({"session": session, "logs": logs})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8081")))
+
