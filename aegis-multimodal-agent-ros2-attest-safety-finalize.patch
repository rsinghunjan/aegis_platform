+#!/usr/bin/env python3
+"""
+Lightweight attestation registry service for gating tests.
+ - Provides /register to register an attested client (returns token)
+ - Provides /verify to check token validity
+This is a test/development registry to support ROS2 adapter gating in staging.
+In production integrate with attestation_service and Vault.
+"""
+import os, json, uuid
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+DB = {}  # in-memory; for prod persist to Vault/S3/DB
+
+@app.route("/register", methods=["POST"])
+def register():
+    body = request.json or {}
+    client_id = body.get("client_id")
+    if not client_id:
+        return jsonify({"error":"client_id required"}), 400
+    token = str(uuid.uuid4())
+    DB[token] = {"client_id": client_id, "issued_at": int(__import__("time").time())}
+    return jsonify({"ok":True, "token":token})
+
+@app.route("/verify", methods=["POST"])
+def verify():
+    body = request.json or {}
+    token = body.get("token")
+    if not token:
+        return jsonify({"ok":False, "error":"token missing"}), 400
+    if token in DB:
+        return jsonify({"ok":True, "client":DB[token]["client_id"]})
+    return jsonify({"ok":False}), 404
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "6061")))
+
