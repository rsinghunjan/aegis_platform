+#!/usr/bin/env python3
+"""
+Simple Triton HTTP client to call the multimodal ensemble.
+Requires tritonclient (pip install nvidia-pyindex tritonclient[http]).
+"""
+import sys, numpy as np
+from PIL import Image
+from tritonclient.http import InferenceServerClient, InferInput, InferRequestedOutput
+
+TRITON_URL = sys.argv[1] if len(sys.argv)>1 else "localhost:8000"
+IMG = sys.argv[2] if len(sys.argv)>2 else "tests/data/sample.jpg"
+
+client = InferenceServerClient(TRITON_URL, verbose=False)
+
+# load image and preprocess to float32 array [3,224,224]
+img = Image.open(IMG).convert("RGB").resize((224,224))
+arr = np.array(img).astype(np.float32) / 255.0
+# Triton model expects CHW
+arr = np.transpose(arr, (2,0,1)).astype(np.float32)
+arr = np.expand_dims(arr, axis=0)  # batch
+
+inputs = [InferInput("IMAGE_BYTES", arr.shape, "FP32")]
+inputs[0].set_data_from_numpy(arr)
+outputs = [InferRequestedOutput("TOKENS")]
+result = client.infer(model_name="multimodal_ensemble", inputs=inputs, outputs=outputs)
+tokens = result.as_numpy("TOKENS")
+print("Got tokens:", tokens)
+
