+#!/usr/bin/env python3
+"""
+Example multimodal training script (vision-language) using Hugging Face & PyTorch.
+This is a minimal example showing dataset loader, preprocessing, and training loop.
+To run at scale, wrap with DeepSpeed using deepspeed --num_nodes ... train_multimodal.py
+"""
+import os
+import torch
+from torch.utils.data import Dataset, DataLoader
+from transformers import CLIPProcessor, CLIPModel, AutoTokenizer, AutoModelForCausalLM
+from tqdm import tqdm
+
+DATA_PATH = os.environ.get("MM_DATA_PATH", "/data/mm-dataset")
+BATCH_SIZE = int(os.environ.get("BATCH_SIZE", "8"))
+EPOCHS = int(os.environ.get("EPOCHS", "1"))
+
+class MMImageTextDataset(Dataset):
+    def __init__(self, metadata_file):
+        import json
+        self.items = json.load(open(metadata_file))
+        self.processor = CLIPProcessor.from_pretrained("openai/clip-vit-base-patch32")
+
+    def __len__(self):
+        return len(self.items)
+
+    def __getitem__(self, idx):
+        import requests
+        it = self.items[idx]
+        img_bytes = open(it["image_path"], "rb").read()
+        text = it.get("caption","")
+        inputs = self.processor(images=img_bytes, text=text, return_tensors="pt", padding=True)
+        return inputs
+
+def collate_fn(batch):
+    # simple collate for CLIP processor outputs
+    import torch
+    pixel_values = torch.cat([b['pixel_values'] for b in batch], dim=0)
+    input_ids = torch.cat([b['input_ids'] for b in batch], dim=0)
+    attention_mask = torch.cat([b['attention_mask'] for b in batch], dim=0)
+    return {"pixel_values": pixel_values, "input_ids": input_ids, "attention_mask": attention_mask}
+
+def train():
+    ds_meta = os.path.join(DATA_PATH, "meta.json")
+    dataset = MMImageTextDataset(ds_meta)
+    dl = DataLoader(dataset, batch_size=BATCH_SIZE, collate_fn=collate_fn)
+    model = CLIPModel.from_pretrained("openai/clip-vit-base-patch32")
+    model.train()
+    optim = torch.optim.AdamW(model.parameters(), lr=1e-5)
+    for epoch in range(EPOCHS):
+        for batch in tqdm(dl, desc=f"epoch-{epoch}"):
+            optim.zero_grad()
+            outputs = model(pixel_values=batch["pixel_values"], input_ids=batch["input_ids"], attention_mask=batch["attention_mask"])
+            loss = outputs.loss if hasattr(outputs, "loss") else outputs.logits.norm()
+            loss.backward()
+            optim.step()
+    torch.save(model.state_dict(), "/tmp/clip_finetuned.pt")
+
+if __name__ == "__main__":
+    train()
+
