+#!/usr/bin/env python3
+"""
+Service to accept tool execution requests and launch jailed k8s Jobs.
+ - Receives JSON with {tool, args, session_id}
+ - Renders a k8s Job from template with strict securityContext
+ - Waits for job completion and returns logs
+ - This service runs with a ServiceAccount that only permits job creation in a dedicated namespace
+"""
+import os
+import yaml
+import time
+import json
+from flask import Flask, request, jsonify
+from kubernetes import client, config, utils
+from jinja2 import Template
+
+JOB_TEMPLATE_PATH = os.environ.get("JOB_TEMPLATE_PATH", "/workspace/k8s_job_template.yaml")
+NAMESPACE = os.environ.get("JOB_NAMESPACE", "aegis-agent")
+
+app = Flask(__name__)
+config.load_incluster_config()
+k8s = client.BatchV1Api()
+core = client.CoreV1Api()
+
+JOB_TMPL = open(JOB_TEMPLATE_PATH).read()
+
+def render_job(job_name, image, command):
+    t = Template(JOB_TMPL)
+    txt = t.render(JOB_NAME=job_name, TOOL_IMAGE=image, TOOL_COMMAND=command)
+    return yaml.safe_load(txt)
+
+@app.post("/exec")
+def exec_tool():
+    body = request.json or {}
+    tool = body.get("tool")
+    args = body.get("args", {})
+    session_id = body.get("session_id", str(int(time.time())))
+    job_name = f"{tool}-{session_id}"
+    # map tool -> image/command via a safe registry (in prod use signed tool manifest)
+    TOOL_MAP = {
+        "list_datasets": {"image":"alpine:3.18", "cmd":"ls -1 /data || echo no-data"},
+        "train": {"image":"<YOUR_REGISTRY>/aegis-trainer:latest", "cmd":"python3 /workspace/train_multimodal.py"}
+    }
+    if tool not in TOOL_MAP:
+        return jsonify({"error":"unknown tool"}), 400
+    job_spec = render_job(job_name, TOOL_MAP[tool]["image"], TOOL_MAP[tool]["cmd"])
+    try:
+        resp = k8s.create_namespaced_job(namespace=NAMESPACE, body=job_spec)
+    except Exception as e:
+        return jsonify({"error":"k8s_create_failed", "detail":str(e)}), 500
+    # wait for completion (simple polling)
+    for _ in range(0, 300):
+        j = k8s.read_namespaced_job(name=resp.metadata.name, namespace=NAMESPACE)
+        if j.status.succeeded and j.status.succeeded >= 1:
+            break
+        if j.status.failed and j.status.failed > 0:
+            break
+        time.sleep(2)
+    # collect pod logs
+    pods = core.list_namespaced_pod(namespace=NAMESPACE, label_selector=f"job-name={resp.metadata.name}")
+    logs = []
+    for p in pods.items:
+        try:
+            l = core.read_namespaced_pod_log(name=p.metadata.name, namespace=NAMESPACE)
+            logs.append({"pod": p.metadata.name, "log": l})
+        except Exception:
+            pass
+    return jsonify({"job": resp.metadata.name, "logs": logs})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
