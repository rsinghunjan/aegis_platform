+#!/usr/bin/env python3
+"""
+Simple agent scaffold inspired by LangChain design:
+ - Plans using a prompt (stubbed / could use LLM)
+ - Before executing a tool, calls OPA policy endpoint to validate action
+ - Executes tools via a jailed Kubernetes Job executor service
+ - Writes signed action logs (cosign) and uploads to S3 if configured
+
+This is a scaffold and should be adapted to your organization's LLM and tools.
+"""
+import os
+import json
+import time
+import requests
+from typing import Dict, Any
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa:8181/v1/data/aegis/agent/allow")
+JAILED_EXECUTOR_URL = os.environ.get("JAILED_EXECUTOR_URL", "http://jailed-executor.aegis-app.svc:8080/exec")
+S3_BUCKET = os.environ.get("S3_UPLOAD", "")
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI", "")
+
+def opa_check(action: Dict[str,Any]) -> bool:
+    payload = {"input": {"action": action}}
+    r = requests.post(OPA_URL, json=payload, timeout=5)
+    r.raise_for_status()
+    res = r.json()
+    return bool(res.get("result", False))
+
+def submit_tool_call(action: Dict[str,Any]) -> Dict[str,Any]:
+    # send to jailed executor which will create a k8s Job with restricted permissions
+    r = requests.post(JAILED_EXECUTOR_URL, json=action, timeout=300)
+    r.raise_for_status()
+    return r.json()
+
+def sign_and_upload_log(log_path: str):
+    # use cosign CLI to sign logs if COSIGN_KEY provided, then upload to S3
+    if COSIGN_KEY:
+        try:
+            os.system(f"cosign sign --key {COSIGN_KEY} {log_path}")
+        except Exception as e:
+            print("cosign sign failed:", e)
+    if S3_BUCKET:
+        import boto3
+        s3 = boto3.client("s3")
+        s3.upload_file(log_path, S3_BUCKET, f"agent_logs/{os.path.basename(log_path)}")
+
+def run_agent_cycle(prompt: str):
+    # Plan (placeholder - in prod call LLM to produce plan & tool calls)
+    # Example plan: [{"tool":"list_datasets","args":{}}, {"tool":"train","args":{"dataset":"ds1"}}]
+    plan = [{"tool":"list_datasets","args":{}}, {"tool":"train","args":{"dataset":"ds1"}}]
+    session_id = str(int(time.time()))
+    action_logs = []
+    for step in plan:
+        action = {"tool": step["tool"], "args": step.get("args",{}), "session_id": session_id, "timestamp": time.time()}
+        # OPA pre-check
+        allowed = opa_check({"type":"read" if step["tool"]=="list_datasets" else "write", "resource": step["tool"]})
+        if not allowed:
+            action["status"]="blocked_by_policy"
+            action_logs.append(action)
+            break
+        # execute via jailed executor
+        try:
+            result = submit_tool_call(action)
+            action["status"]="executed"
+            action["result"]=result
+        except Exception as e:
+            action["status"]="error"
+            action["error"]=str(e)
+        action_logs.append(action)
+    # write action log and sign
+    log_path = f"/tmp/agent_action_{session_id}.json"
+    with open(log_path, "w") as fh:
+        json.dump(action_logs, fh, indent=2)
+    sign_and_upload_log(log_path)
+    return action_logs
+
+if __name__ == "__main__":
+    print("Running sample agent cycle")
+    logs = run_agent_cycle("List datasets and run training on ds1")
+    print(json.dumps(logs, indent=2))
+
