+#!/usr/bin/env python3
+"""
+ROS2 adapter service scaffold
+ - subscribes to /aegis/commands topic (expected JSON commands)
+ - checks simple safety rules before publishing to a robot command topic
+ - publishes status on /aegis/commands/status
+
+This node must run on a controller host that also enforces hardware-level interlocks.
+"""
+import os
+import json
+import rclpy
+from rclpy.node import Node
+from std_msgs.msg import String
+
+SAFE_GEOFENCE = os.environ.get("SAFE_GEOFENCE", "true").lower() == "true"
+
+class AegisRosAdapter(Node):
+    def __init__(self):
+        super().__init__('aegis_ros_adapter')
+        self.sub = self.create_subscription(String, '/aegis/commands', self.on_command, 10)
+        self.pub = self.create_publisher(String, '/robot/command', 10)
+        self.status_pub = self.create_publisher(String, '/aegis/commands/status', 10)
+
+    def on_command(self, msg):
+        try:
+            cmd = json.loads(msg.data)
+        except Exception as e:
+            self.get_logger().error("invalid json command")
+            return
+        # Basic safety checks
+        if SAFE_GEOFENCE and cmd.get("action") == "move" and abs(cmd.get("params", {}).get("x",0)) > 10:
+            self.get_logger().warn("move exceeds geofence, rejecting")
+            self.status_pub.publish(String(data=json.dumps({"status":"rejected","reason":"geofence"})))
+            return
+        # In production, this must call a hardware-interlock service and require attested controller
+        # Forward command to robot topic
+        self.pub.publish(String(data=json.dumps(cmd)))
+        self.status_pub.publish(String(data=json.dumps({"status":"accepted","command":cmd})))
+
+def main(args=None):
+    rclpy.init(args=args)
+    node = AegisRosAdapter()
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        pass
+    node.destroy_node()
+    rclpy.shutdown()
+
+if __name__ == "__main__":
+    main()
+
