+#!/usr/bin/env python3
+"""
+Multimodal ingestion microservice (FastAPI).
+- Accepts images, audio, and sensor payloads.
+- Stores files to local path or S3 (if S3_UPLOAD env set).
+- Emits metadata messages to Redis (or Kafka) for downstream processing.
+
+This is lightweight, meant to be deployed as a k8s Deployment behind an ingress.
+"""
+import os
+import uuid
+import json
+from pathlib import Path
+from typing import Optional
+from fastapi import FastAPI, UploadFile, File, Form
+import boto3
+
+S3_BUCKET = os.environ.get("S3_UPLOAD", "")
+STORAGE_PATH = os.environ.get("INGEST_LOCAL_PATH", "/data/ingest")
+REDIS_URL = os.environ.get("REDIS_URL", "")
+
+app = FastAPI(title="Aegis Multimodal Ingest")
+
+if S3_BUCKET:
+    s3 = boto3.client("s3")
+
+Path(STORAGE_PATH).mkdir(parents=True, exist_ok=True)
+
+def save_file_local(kind: str, filename: str, content: bytes) -> str:
+    out_dir = Path(STORAGE_PATH) / kind
+    out_dir.mkdir(parents=True, exist_ok=True)
+    path = out_dir / filename
+    path.write_bytes(content)
+    return str(path)
+
+def upload_s3(key: str, data: bytes):
+    if not S3_BUCKET:
+        raise RuntimeError("S3_UPLOAD not set")
+    s3.put_object(Bucket=S3_BUCKET, Key=key, Body=data)
+    return f"s3://{S3_BUCKET}/{key}"
+
+def publish_meta(meta: dict):
+    # Minimal: write metadata file; extend to push to Redis/Kafka
+    meta_path = Path(STORAGE_PATH) / "meta"
+    meta_path.mkdir(parents=True, exist_ok=True)
+    out = meta_path / (meta["id"] + ".json")
+    out.write_text(json.dumps(meta))
+
+@app.post("/ingest/image")
+async def ingest_image(file: UploadFile = File(...), dataset: Optional[str] = Form(None)):
+    content = await file.read()
+    id = str(uuid.uuid4())
+    filename = f"{id}_{file.filename}"
+    if S3_BUCKET:
+        key = f"images/{dataset or 'default'}/{filename}"
+        uri = upload_s3(key, content)
+    else:
+        uri = save_file_local("images", filename, content)
+    meta = {"id": id, "type": "image", "filename": file.filename, "uri": uri, "dataset": dataset}
+    publish_meta(meta)
+    return meta
+
+@app.post("/ingest/audio")
+async def ingest_audio(file: UploadFile = File(...), dataset: Optional[str] = Form(None)):
+    content = await file.read()
+    id = str(uuid.uuid4())
+    filename = f"{id}_{file.filename}"
+    if S3_BUCKET:
+        key = f"audio/{dataset or 'default'}/{filename}"
+        uri = upload_s3(key, content)
+    else:
+        uri = save_file_local("audio", filename, content)
+    meta = {"id": id, "type": "audio", "filename": file.filename, "uri": uri, "dataset": dataset}
+    publish_meta(meta)
+    return meta
+
+@app.post("/ingest/sensor")
+async def ingest_sensor(payload: dict):
+    id = str(uuid.uuid4())
+    meta = {"id": id, "type": "sensor", "payload": payload}
+    publish_meta(meta)
+    return meta
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
