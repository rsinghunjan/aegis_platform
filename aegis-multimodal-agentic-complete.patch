+#!/usr/bin/env python3
+"""
+Safety filter for agent outputs that map to physical actions.
+ - Applies a set of checks: simple safety classifier, bounds checking, and spec compliance.
+ - Returns (allowed:bool, reason:str). Records evidence using evidence_sdk.
+"""
+from ops.sdk.evidence_sdk import record_manifest
+import json
+
+def toxicity_check(text):
+    # Placeholder: integrate real toxicity model (e.g., Detoxify) in production
+    banned = ["self-harm","illicit"]
+    for b in banned:
+        if b in text.lower():
+            return False, f"toxicity_match:{b}"
+    return True, "ok"
+
+def numeric_bounds_check(command, bounds):
+    # Example: command = {"joint": [0.1, -0.2, ...]}; bounds {"joint": {"min": -3.14, "max": 3.14}}
+    for k,v in command.items():
+        if k in bounds:
+            vals = v
+            mini = bounds[k]["min"]; maxi = bounds[k]["max"]
+            for x in vals:
+                if x < mini or x > maxi:
+                    return False, f"out_of_bounds:{k}"
+    return True, "ok"
+
+def run_safety_checks(action_payload, classifier_text=None, bounds=None):
+    allowed = True
+    reasons = []
+    if classifier_text:
+        ok, r = toxicity_check(classifier_text)
+        if not ok:
+            allowed = False; reasons.append(r)
+    if bounds:
+        ok, r = numeric_bounds_check(action_payload, bounds)
+        if not ok:
+            allowed = False; reasons.append(r)
+    record_manifest("action_safety_check", {"allowed": allowed, "reasons": reasons, "action": action_payload})
+    return allowed, reasons
+
