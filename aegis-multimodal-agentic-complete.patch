+#!/usr/bin/env python3
+"""
+Adapter that receives high-level agent actions, runs safety filters, and then publishes to ROS2 action topics.
+ - Example usage: agent calls adapter via HTTP (or internal function call)
+ - This adapter uses ros2_bridge if available, otherwise falls back to UDP for real-time controller.
+"""
+import os, json
+from ops.agents.action_safety_filter import run_safety_checks
+from ops.sdk.evidence_sdk import record_manifest
+
+try:
+    import requests
+except Exception:
+    requests = None
+
+def send_to_ros2(action_topic, payload):
+    # Use existing ros2_bridge HTTP endpoint
+    bridge_url = os.environ.get("ROS2_BRIDGE_URL", "http://localhost:8080/command")
+    data = {"topic": action_topic, "msg": payload}
+    if requests:
+        r = requests.post(bridge_url, json=data, timeout=5)
+        return r.status_code == 200
+    else:
+        # UDP fallback to RT controller
+        import socket
+        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        s.sendto(json.dumps(payload).encode('utf-8'), ('127.0.0.1',15000))
+        return True
+
+def adapter_handle(action_topic, action_payload, text_context=None, bounds=None):
+    allowed, reasons = run_safety_checks(action_payload, classifier_text=text_context, bounds=bounds)
+    if not allowed:
+        record_manifest("adapter_reject", {"topic": action_topic, "reasons": reasons})
+        return {"ok": False, "reasons": reasons}
