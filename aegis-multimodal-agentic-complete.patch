+#!/usr/bin/env python3
+"""
+Runtime monitor for agent executions:
+ - Observes issued actions, verifies invariants (e.g., joint limits, safe zones), and triggers safe-stop if invariants violated.
+ - Records incidents as evidence manifests and emits OpenLineage events (optional).
+"""
+import time, json
+from ops.sdk.evidence_sdk import record_manifest
+
+INVARIANTS = {
+    "joint_limits": {"min": -3.14, "max": 3.14},
+    "max_effort": 100.0
+}
+
+def check_invariants(action_event):
+    # action_event: {"topic":"...", "payload":{...}, "telemetry":{...}}
+    payload = action_event.get("payload", {})
+    # Example simple check: joint positions within range
+    joints = payload.get("joint_positions")
+    if joints:
+        for v in joints:
+            if v < INVARIANTS["joint_limits"]["min"] or v > INVARIANTS["joint_limits"]["max"]:
+                return False, "joint_limit_violation"
+    return True, "ok"
+
+def monitor_loop(get_events_callable, poll_interval=0.1):
+    while True:
+        events = get_events_callable()
+        for ev in events:
+            ok, reason = check_invariants(ev)
+            if not ok:
+                record_manifest("runtime_monitor_violation", {"event": ev, "reason": reason})
+                # Trigger safe-stop (operator must implement safe-stop hook)
+                try:
+                    # Placeholder: call safe-stop endpoint or system command
+                    print("Triggering safe-stop due to", reason)
+                except Exception:
+                    pass
+        time.sleep(poll_interval)
