+#!/usr/bin/env python3
+"""
+Lightweight multimodal training example (image + text fusion).
+ - Uses torchvision ResNet18 image encoder and HuggingFace DistilBERT text encoder (frozen or finetuned).
+ - Trains a small fusion head for classification/regression.
+ - Logs model, hyperparams and metrics to MLflow and records evidence.
+"""
+import os, argparse, json
+import torch, torch.nn as nn, torch.optim as optim
+from torch.utils.data import Dataset, DataLoader
+from torchvision import models
+from transformers import DistilBertModel, DistilBertTokenizerFast
+import mlflow
+from ops.sdk.evidence_sdk import record_manifest
+from ops.multimodal.preproc.preprocess import image_preprocess, imu_preprocess
+
+class MultiModalDataset(Dataset):
+    def __init__(self, ndjson_path, tokenizer, max_text_len=32):
+        import json
+        self.rows = []
+        with open(ndjson_path) as fh:
+            for line in fh:
+                self.rows.append(json.loads(line))
+        self.tokenizer = tokenizer
+
+    def __len__(self):
+        return len(self.rows)
+
+    def __getitem__(self, i):
+        r = self.rows[i]
+        img_arr, _ = image_preprocess(r["sensors"]["camera"]["image_b64"])
+        # example text: metadata / label (if present)
+        txt = r.get("meta", {}).get("caption", "")
+        tokens = self.tokenizer(txt, truncation=True, padding="max_length", max_length=32, return_tensors="pt")
+        x_img = torch.tensor(img_arr.transpose(2,0,1)).float()
+        return x_img, tokens["input_ids"].squeeze(0), torch.tensor([0])  # dummy label
+
+class FusionModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.img_enc = models.resnet18(pretrained=True)
+        self.img_enc.fc = nn.Identity()
+        self.txt_enc = DistilBertModel.from_pretrained("distilbert-base-uncased")
+        self.fusion = nn.Sequential(
+            nn.Linear(512+768, 512),
+            nn.ReLU(),
+            nn.Linear(512, 1)
+        )
+
+    def forward(self, img, input_ids):
+        b = img.shape[0]
+        img_feat = self.img_enc(img)
+        txt_out = self.txt_enc(input_ids=input_ids).last_hidden_state[:,0,:]
+        x = torch.cat([img_feat, txt_out], dim=1)
+        return self.fusion(x).squeeze(1)
+
+def train(args):
+    tokenizer = DistilBertTokenizerFast.from_pretrained("distilbert-base-uncased")
+    ds = MultiModalDataset(args.dataset, tokenizer)
+    dl = DataLoader(ds, batch_size=args.batch, shuffle=True, num_workers=2)
+    model = FusionModel()
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    model.to(device)
+    opt = optim.Adam(model.parameters(), lr=1e-4)
+    mlflow.set_tracking_uri(args.mlflow_uri)
+    with mlflow.start_run(run_name=f"multimodal_train_{os.path.basename(args.dataset)}") as r:
+        mlflow.log_param("batch", args.batch)
+        for epoch in range(args.epochs):
+            model.train()
+            loss_sum = 0.0
+            for img, input_ids, label in dl:
+                img = img.to(device)
+                input_ids = input_ids.to(device)
+                pred = model(img, input_ids)
+                loss = ((pred - label.float().to(device))**2).mean()
+                opt.zero_grad()
+                loss.backward()
+                opt.step()
+                loss_sum += loss.item()
+            mlflow.log_metric("train_loss", loss_sum)
+        # save checkpoint
+        ckpt = "/tmp/multimodal_model.pt"
+        torch.save(model.state_dict(), ckpt)
+        mlflow.log_artifact(ckpt, artifact_path="models")
+        record_manifest("multimodal_training_complete", {"dataset": args.dataset, "mlflow_run": r.info.run_id})
+        print("Training complete, model saved to", ckpt)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--dataset", required=True)
+    p.add_argument("--epochs", type=int, default=1)
+    p.add_argument("--batch", type=int, default=8)
+    p.add_argument("--mlflow-uri", default=os.environ.get("MLFLOW_TRACKING_URI","http://localhost:5000"))
+    args = p.parse_args()
+    train(args)
+
