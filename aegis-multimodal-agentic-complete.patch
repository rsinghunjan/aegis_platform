+"""
+Deterministic preprocessing utilities for images/audio/sensor that must be identical in train/infer.
+ - Provide a versioned API and fixed RNG seeds for deterministic aug pipeline.
+"""
+from PIL import Image
+import numpy as np
+import hashlib
+
+PREPROC_VERSION = "v1.0"
+
+def image_preprocess(image_b64, size=(224,224), mean=(0.485,0.456,0.406), std=(0.229,0.224,0.225)):
+    import base64, io
+    data = base64.b64decode(image_b64)
+    img = Image.open(io.BytesIO(data)).convert("RGB")
+    img = img.resize(size, Image.BILINEAR)
+    arr = np.array(img).astype("float32") / 255.0
+    # normalize
+    arr = (arr - np.array(mean)) / np.array(std)
+    # ensure deterministic ordering by hashing
+    h = hashlib.sha256(data).hexdigest()
+    return arr, {"preproc_version": PREPROC_VERSION, "hash": h}
+
+def imu_preprocess(samples):
+    # stack and zero-center
+    import numpy as _np
+    arr = _np.array(samples, dtype=_np.float32)
+    if arr.ndim == 1:
+        arr = arr.reshape(1,-1)
+    arr = arr - arr.mean(axis=0, keepdims=True)
+    return arr, {"preproc_version": PREPROC_VERSION}
+
