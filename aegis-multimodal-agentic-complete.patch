+#!/usr/bin/env python3
+"""
+Frame alignment utility:
+ - Reads ndjson capture file with mixed sensor entries (if produced by multiple recorders)
+ - Outputs synchronized ndjson using camera timestamps as primary clock
+ - Usage: python frame_align.py --in raw.ndjson --out synced.ndjson
+"""
+import json, argparse
+from bisect import bisect_right
+
+def load_all(infile):
+    cam = []
+    imu = []
+    with open(infile) as fh:
+        for line in fh:
+            j = json.loads(line)
+            ts = j.get("timestamp_ns")
+            if "camera" in j.get("sensors", {}):
+                cam.append((ts, j))
+            elif "imu" in j.get("sensors", {}):
+                imu.append((ts, j))
+    return cam, imu
+
+def align(cam, imu, outpath):
+    imu_ts = [t for t,_ in imu]
+    with open(outpath, "w") as out:
+        for idx,(cts,cj) in enumerate(cam):
+            i = bisect_right(imu_ts, cts)
+            imu_samples = [entry for _,entry in imu[max(0,i-5):i+1]]
+            record = {
+                "capture_id": cj["capture_id"],
+                "frame_idx": idx,
+                "timestamp_ns": cts,
+                "sensors": {
+                    "camera": cj["sensors"]["camera"],
+                    "imu": {"samples": [s["sensors"]["imu"] for s in imu_samples if "sensors" in s]}
+                }
+            }
+            out.write(json.dumps(record) + "\n")
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="infile", required=True)
+    p.add_argument("--out", dest="out", required=True)
+    args = p.parse_args()
+    cam, imu = load_all(args.infile)
+    align(cam, imu, args.out)
+
