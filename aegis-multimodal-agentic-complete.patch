+#!/usr/bin/env python3
+"""
+Synchronized capture daemon for camera + IMU + Lidar (best-effort).
+ - Uses system time (preferably PTP-synced) to timestamp frames with ns precision.
+ - Writes newline-delimited JSON (ndjson) using schema ops/multimodal/schema/multimodal_schema_v1.json
+ - Example: python3 ptp_capture.py --out /data/capture.ndjson --capture-id run123 --camera-device 0
+"""
+import argparse, time, base64, json, threading
+from datetime import datetime
+try:
+    import cv2
+except Exception:
+    cv2 = None
+
+def now_ns():
+    return int(time.time() * 1e9)
+
+def capture_camera(frame_queue, device=0, rate_hz=30):
+    if cv2 is None:
+        raise RuntimeError("OpenCV required")
+    cap = cv2.VideoCapture(device)
+    interval = 1.0/float(rate_hz)
+    while True:
+        ret, frame = cap.read()
+        if not ret:
+            time.sleep(interval)
+            continue
+        _, enc = cv2.imencode('.jpg', frame, [int(cv2.IMWRITE_JPEG_QUALITY), 80])
+        b64 = base64.b64encode(enc.tobytes()).decode('ascii')
+        ts = now_ns()
+        frame_queue.append(("camera", ts, {"image_b64": b64}))
+        time.sleep(interval)
+
+def capture_dummy_imu(frame_queue, rate_hz=200):
+    import random
+    interval = 1.0/float(rate_hz)
+    while True:
+        ts = now_ns()
+        imu = {"accel": [random.random(),random.random(),random.random()], "gyro":[random.random(),random.random(),random.random()]}
+        frame_queue.append(("imu", ts, imu))
+        time.sleep(interval)
+
+def align_and_write(out_path, capture_id, frame_queue, flush_interval=1.0):
+    """
+    Simple aligner: collects latest sensor samples and writes synchronized frames at camera timestamps.
+    For production use, replace with more robust buffer and PTP-based hardware timestamps.
+    """
+    buf = {"camera": [], "imu": [], "lidar": []}
+    last_flush = time.time()
+    f = open(out_path, "a")
+    frame_idx = 0
+    try:
+        while True:
+            while frame_queue:
+                sensor, ts, payload = frame_queue.pop(0)
+                buf.setdefault(sensor, []).append((ts, payload))
+            # If camera sample available, generate synced record
+            if buf.get("camera"):
+                cam_ts, cam_payload = buf["camera"].pop(0)
+                # collect IMU samples nearest before cam_ts
+                imu_samples = []
+                while buf.get("imu") and buf["imu"][0][0] <= cam_ts:
+                    imu_samples.append(buf["imu"].pop(0)[1])
+                record = {
+                    "capture_id": capture_id,
+                    "frame_idx": frame_idx,
+                    "timestamp_ns": cam_ts,
+                    "sensors": {
+                        "camera": cam_payload,
+                        "imu": {"samples": imu_samples}
+                    },
+                    "meta": {"ptp_synced": True}
+                }
+                f.write(json.dumps(record) + "\n")
+                f.flush()
+                frame_idx += 1
+            time.sleep(0.001)
+    except KeyboardInterrupt:
+        f.close()
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", required=True)
+    p.add_argument("--capture-id", required=True)
+    p.add_argument("--camera-device", type=int, default=0)
+    args = p.parse_args()
+    queue = []
+    cam_t = threading.Thread(target=capture_camera, args=(queue, args.camera_device, 30), daemon=True)
+    imu_t = threading.Thread(target=capture_dummy_imu, args=(queue,200), daemon=True)
+    cam_t.start()
+    imu_t.start()
+    align_and_write(args.out, args.capture_id, queue)
+
+if __name__=="__main__":
+    main()
+
