+#!/usr/bin/env python3
+"""
+Multimodal evaluation harness:
+ - computes CLIPScore for image+caption pairs
+ - computes BLEU for captioning, WER for audio transcripts
+ - logs metrics to MLflow and writes a summary JSON
+"""
+import os, json, tempfile, math
+from PIL import Image
+import mlflow
+from services.multimodal.embeddings import image_to_embedding, text_to_embedding
+try:
+    from jiwer import wer
+except Exception:
+    def wer(a,b): return 1.0
+
+def clip_score(image_path, caption):
+    emb_img = image_to_embedding(open(image_path,"rb").read())
+    emb_txt = text_to_embedding(caption)
+    # cosine
+    import numpy as np
+    cos = float((emb_img @ emb_txt) / ((np.linalg.norm(emb_img)*np.linalg.norm(emb_txt))+1e-12))
+    return cos
+
+def eval_dataset(dataset_json, mlflow_experiment="multimodal-eval"):
+    """
+    dataset_json: list of {"image": "/path/to/img", "caption": "expected caption", "pred": "model caption", "audio_expected": "", "audio_pred": ""}
+    """
+    data = json.load(open(dataset_json))
+    scores = []
+    clip_scores = []
+    bleu_scores = []
+    wer_scores = []
+    for r in data:
+        img = r.get("image")
+        gold = r.get("caption","")
+        pred = r.get("pred","")
+        if img:
+            cs = clip_score(img, pred)
+            clip_scores.append(cs)
+        # BLEU - simple: token overlap
+        try:
+            from nltk.translate.bleu_score import sentence_bleu
+            bleu = sentence_bleu([gold.split()], pred.split())
+        except Exception:
+            bleu = 0.0
+        bleu_scores.append(bleu)
+        # WER
+        if r.get("audio_expected") and r.get("audio_pred"):
+            wer_v = wer(r["audio_expected"], r["audio_pred"])
+        else:
+            wer_v = None
+        wer_scores.append(wer_v)
+    # aggregate
+    agg = {
+        "clip_mean": sum(clip_scores)/len(clip_scores) if clip_scores else None,
+        "bleu_mean": sum(bleu_scores)/len(bleu_scores) if bleu_scores else None,
+        "wer_mean": sum([w for w in wer_scores if w is not None])/len([w for w in wer_scores if w is not None]) if any(w is not None for w in wer_scores) else None,
+        "n": len(data)
+    }
+    # log to mlflow
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    with mlflow.start_run(experiment_name=mlflow_experiment):
+        for k,v in agg.items():
+            if v is not None:
+                mlflow.log_metric(k, v)
+    out = "/tmp/multimodal_eval_summary.json"
+    json.dump(agg, open(out,"w"), indent=2)
+    return agg
+
+if __name__=="__main__":
+    import sys
+    print(eval_dataset(sys.argv[1]))
+
