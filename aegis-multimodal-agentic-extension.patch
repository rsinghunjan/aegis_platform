+#!/usr/bin/env python3
+"""
+Multimodal model proxy that routes to appropriate model backends (text LLMs, multimodal transformers, diffusion)
+Manages a simple warm-pool of worker processes (stub) and implements per-tenant cost accounting.
+"""
+import os, time, requests, threading, queue
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+BACKENDS = {
+    "text": os.environ.get("LLM_UPSTREAM","http://localhost:8083"),
+    "image": os.environ.get("DIFFUSION_UPSTREAM","http://localhost:8090"),
+    "multimodal": os.environ.get("MULTIMODAL_UPSTREAM","http://localhost:8100"),
+}
+
+# Simple warm pool stub: pre-warm python worker threads that maintain a connection handle
+class WorkerPool:
+    def __init__(self, size=2):
+        self.size = size
+        self.q = queue.Queue()
+        for i in range(size):
+            t = threading.Thread(target=self._worker, daemon=True)
+            t.start()
+    def _worker(self):
+        while True:
+            task = self.q.get()
+            if task is None:
+                break
+            func, args, kwargs, out_q = task
+            try:
+                res = func(*args, **kwargs)
+                out_q.put(("ok", res))
+            except Exception as e:
+                out_q.put(("err", str(e)))
+            self.q.task_done()
+    def submit(self, func, *args, **kwargs):
+        out_q = queue.Queue()
+        self.q.put((func, args, kwargs, out_q))
+        status, res = out_q.get()
+        if status=="ok":
+            return res
+        else:
+            raise RuntimeError(res)
+
+POOL = WorkerPool(size=int(os.environ.get("WARM_POOL_SIZE","2")))
+
+def route_to_backend(kind, payload):
+    url = BACKENDS.get(kind)
+    if not url:
+        raise RuntimeError("no backend")
+    r = requests.post(url.rstrip("/") + "/generate", json=payload, timeout=120)
+    r.raise_for_status()
+    return r.json()
+
+@app.route("/generate", methods=["POST"])
+def generate():
+    body = request.get_json(force=True)
+    kind = body.get("kind","text")
+    # quota checks happen at LLM proxy layer
+    try:
+        res = POOL.submit(route_to_backend, kind, body)
+    except Exception as e:
+        return jsonify({"error":"backend_error","detail": str(e)}), 502
+    return jsonify(res)
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("MM_PROXY_PORT","8101")))
+
