+#!/usr/bin/env python3
+"""
+Multimodal embedding helpers:
+ - Image embeddings using CLIP (Hugging Face transformers)
+ - Text embeddings using sentence-transformers
+ - Audio -> transcript -> text embedding (Whisper + sentence-transformers)
+ - Video frame extraction + embedding (ffmpeg)
+
+Exports convenient functions to compute embeddings suitable for Milvus upsert.
+"""
+import os, io, numpy as np
+from PIL import Image
+
+# Optional imports (install via services/requirements-multimodal.txt)
+try:
+    from transformers import CLIPProcessor, CLIPModel
+    _HAS_CLIP = True
+except Exception:
+    _HAS_CLIP = False
+
+try:
+    from sentence_transformers import SentenceTransformer
+    _HAS_ST = True
+except Exception:
+    _HAS_ST = False
+
+try:
+    import whisper
+    _HAS_WHISPER = True
+except Exception:
+    _HAS_WHISPER = False
+
+CLIP_MODEL = None
+CLIP_PROCESSOR = None
+TEXT_MODEL = None
+WHISPER_MODEL = None
+
+def ensure_models(clip_name="openai/clip-vit-base-patch32", text_model="sentence-transformers/all-MiniLM-L6-v2", whisper_model="small"):
+    global CLIP_MODEL, CLIP_PROCESSOR, TEXT_MODEL, WHISPER_MODEL
+    if _HAS_CLIP and CLIP_MODEL is None:
+        CLIP_MODEL = CLIPModel.from_pretrained(clip_name)
+        CLIP_PROCESSOR = CLIPProcessor.from_pretrained(clip_name)
+    if _HAS_ST and TEXT_MODEL is None:
+        TEXT_MODEL = SentenceTransformer(text_model)
+    if _HAS_WHISPER and WHISPER_MODEL is None:
+        WHISPER_MODEL = whisper.load_model(whisper_model)
+
+def image_to_embedding(image_bytes, clip_name=None):
+    """
+    Input: bytes (image file) or PIL Image
+    Return: numpy array embedding (float32)
+    """
+    if not _HAS_CLIP:
+        raise RuntimeError("transformers CLIP not available")
+    ensure_models()
+    if isinstance(image_bytes, (bytes, bytearray)):
+        image = Image.open(io.BytesIO(image_bytes)).convert("RGB")
+    elif isinstance(image_bytes, Image.Image):
+        image = image_bytes.convert("RGB")
+    else:
+        raise ValueError("image_bytes must be bytes or PIL.Image")
+    inputs = CLIP_PROCESSOR(images=image, return_tensors="pt")
+    with CLIP_MODEL.device_placement():
+        outputs = CLIP_MODEL.get_image_features(**inputs)
+    emb = outputs.detach().cpu().numpy()[0]
+    emb = emb / (np.linalg.norm(emb) + 1e-12)
+    return emb.astype(np.float32)
+
+def text_to_embedding(text):
+    if not _HAS_ST:
+        raise RuntimeError("sentence-transformers not available")
+    ensure_models()
+    emb = TEXT_MODEL.encode(text, convert_to_numpy=True)
+    emb = emb / (np.linalg.norm(emb) + 1e-12)
+    return emb.astype(np.float32)
+
+def audio_to_transcript(audio_path):
+    if not _HAS_WHISPER:
+        raise RuntimeError("whisper not installed")
+    ensure_models()
+    # whisper returns a dict with 'text'
+    res = WHISPER_MODEL.transcribe(audio_path)
+    return res.get("text","")
+
+def video_extract_frames(video_path, fps=1, out_dir="/tmp/video_frames"):
+    """
+    Extract frames with ffmpeg at 1 fps by default. Writes to out_dir and returns list of file paths.
+    Requires ffmpeg installed.
+    """
+    import subprocess, os
+    os.makedirs(out_dir, exist_ok=True)
+    out_pattern = os.path.join(out_dir, "frame_%04d.jpg")
+    cmd = ["ffmpeg","-i",video_path,"-vf",f"fps={fps}", out_pattern, "-hide_banner","-loglevel","error"]
+    subprocess.check_call(cmd)
+    files = sorted([os.path.join(out_dir,f) for f in os.listdir(out_dir) if f.startswith("frame_")])
+    return files
+
