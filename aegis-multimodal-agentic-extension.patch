+"""
+RAG service extension to support multimodal context composition:
+ - retrieve multimodal hits (text, image snippets, audio transcripts)
+ - compose multimodal prompt payload that includes text context + image captions/links
+Endpoint:
+ - POST /compose_multimodal { "query": "...", "embedding": [...], "top_k": 5, "include_images": true }
+"""
+from flask import Flask, request, jsonify
+import os, requests, json
+from services.rag.milvus_client import query_similar
+
+app = Flask(__name__)
+COLLECTION = os.environ.get("RAG_COLLECTION","aegis_docs")
+
+@app.route("/compose_multimodal", methods=["POST"])
+def compose_multimodal():
+    body = request.get_json()
+    query_embedding = body.get("embedding")
+    top_k = int(body.get("top_k", 5))
+    include_images = bool(body.get("include_images", True))
+    hits = query_similar(COLLECTION, query_embedding, top_k)
+    # Build a composite context: text snippets (ocr/transcript), plus image references for possible display
+    text_contexts = []
+    images = []
+    for h in hits:
+        meta = h.get("meta",{})
+        if meta.get("type") in ("text","audio","image","video_frame"):
+            if meta.get("type") in ("text","audio"):
+                text_contexts.append(meta.get("text") or meta.get("transcript") or meta.get("ocr") or "")
+            elif meta.get("type") == "image" or meta.get("type")=="video_frame":
+                if include_images:
+                    # Provide image id or S3 path if available
+                    images.append({"id": meta.get("id"), "note": meta.get("source_meta",{})})
+                    # include captions if OCR present
+                    if meta.get("ocr"):
+                        text_contexts.append(meta.get("ocr"))
+    context = "\n\n".join([t for t in text_contexts if t])
+    # Template: caller (LLM proxy) may accept a structured multimodal payload
+    payload = {"context": context, "images": images, "hits": hits}
+    return jsonify(payload)
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("RAG_MM_PORT","8086")))
