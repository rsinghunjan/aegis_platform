+#!/usr/bin/env python3
+"""
+Simple image watermarking and provenance manifest writer.
+ - watermark_image: draws a visible text watermark on image
+ - sign_provenance: writes a JSON manifest (operator to sign with cosign)
+"""
+from PIL import Image, ImageDraw, ImageFont
+import json, time, os
+
+def watermark_image(pil_image, text="Aegis Generated", opacity=128):
+    img = pil_image.convert("RGBA")
+    txt = Image.new("RGBA", img.size, (255,255,255,0))
+    draw = ImageDraw.Draw(txt)
+    # simple font - rely on system default
+    try:
+        font = ImageFont.truetype("DejaVuSans.ttf", 24)
+    except Exception:
+        font = ImageFont.load_default()
+    w,h = img.size
+    draw.text((10, h-40), text, fill=(255,255,255,opacity), font=font)
+    out = Image.alpha_composite(img, txt).convert("RGB")
+    return out
+
+def sign_provenance(artifact_path, metadata, out_manifest=None):
+    if out_manifest is None:
+        out_manifest = artifact_path + ".manifest.json"
+    manifest = {"artifact": artifact_path, "metadata": metadata, "ts": time.time()}
+    with open(out_manifest,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    # operator should cosign this manifest and upload to evidence
+    return out_manifest
+
