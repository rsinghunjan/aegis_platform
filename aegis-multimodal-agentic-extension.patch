+#!/usr/bin/env python3
+"""
+Lightweight planner service:
+ - Accepts a goal and uses heuristics + optional LLM call to decompose into ordered tasks
+ - Supports plan revision and fallback strategies
+ - Produces structured plan steps consumable by agent orchestrator
+"""
+from flask import Flask, request, jsonify
+import os, requests, time
+
+app = Flask(__name__)
+LLM_PROXY = os.environ.get("LLM_PROXY_URL","http://llm-proxy:8083")
+
+def heuristic_split(goal):
+    # naive heuristics: split sentences, each becomes a step
+    import re
+    sents = [s.strip() for s in re.split(r'[.?!\n]+', goal) if s.strip()]
+    steps = [{"step": i+1, "task": s, "tool": "search" if "find" in s.lower() or "what" in s.lower() else "exec"} for i,s in enumerate(sents)]
+    return steps
+
+def llm_plan(goal):
+    prompt = f"Decompose the goal into an ordered list of actionable steps. Respond JSON: {{'steps': [{{'task':'...','tool':'search|exec|other'}}]}}. Goal: {goal}"
+    try:
+        r = requests.post(LLM_PROXY.rstrip("/") + "/v1/generate", json={"prompt": prompt, "max_tokens": 400}, timeout=30)
+        r.raise_for_status()
+        j = r.json()
+        text = j.get("text") or j.get("result") or r.text
+        import json as _json
+        out = _json.loads(text)
+        return out.get("steps", [])
+    except Exception:
+        return heuristic_split(goal)
+
+@app.route("/plan", methods=["POST"])
+def plan():
+    body = request.get_json()
+    goal = body.get("goal","")
+    mode = body.get("mode","llm")
+    if mode=="llm":
+        steps = llm_plan(goal)
+    else:
+        steps = heuristic_split(goal)
+    plan = {"goal": goal, "steps": steps, "ts": time.time()}
+    return jsonify(plan)
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PLANNER_PORT","8110")))
+
