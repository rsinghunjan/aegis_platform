+#!/usr/bin/env python3
+"""
+Execution verifier:
+ - After a tool call with side-effects (e.g., "create-file", "apply-config"), captures expected state and verifies that the state matches expectation.
+ - For demo, supports HTTP-based state checkers and filesystem checks.
+ - Produces an attestation bundle and flags mismatches.
+"""
+import os, json, subprocess, time
+
+def verify_filesystem(path, expected_files):
+    missing = []
+    for f in expected_files:
+        if not os.path.exists(os.path.join(path, f)):
+            missing.append(f)
+    return {"missing": missing, "ok": len(missing)==0}
+
+def verify_http(url, expected_status=200):
+    import requests
+    r = requests.get(url, timeout=5)
+    return {"status": r.status_code, "ok": r.status_code==expected_status}
+
+def attestation_write(event):
+    out = "/tmp/execution_verif_"+str(int(time.time()))+".json"
+    json.dump(event, open(out,"w"), indent=2)
+    # optionally sign with cosign (operator-run)
+    return out
