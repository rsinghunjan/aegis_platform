+#!/usr/bin/env python3
+"""
+Multimodal ingestion service:
+ - Accepts image/audio/video uploads and metadata
+ - Runs preprocessing: OCR (pytesseract), Whisper transcription for audio, frame extraction for video
+ - Computes embeddings (image/text) and upserts into Milvus with metadata for lineage
+ - Records dataset versioning & lineage in a simple JSON registry
+
+Endpoints:
+ - POST /ingest/image  (multipart/form-data: file, id, metadata JSON)
+ - POST /ingest/audio  (file, id, metadata)
+ - POST /ingest/video  (file, id, metadata)
+
+Requires: pymilvus, pytesseract (for OCR), services/multimodal/embeddings.py
+"""
+import os, json, tempfile, time
+from flask import Flask, request, jsonify
+from services.multimodal.embeddings import image_to_embedding, audio_to_transcript, text_to_embedding, video_extract_frames
+from services.rag.milvus_client import upsert_documents, ensure_collection
+try:
+    import pytesseract
+    _HAS_OCR = True
+except Exception:
+    _HAS_OCR = False
+
+STORE = os.environ.get("MM_STORE_DIR","/data/multimodal")
+COLLECTION = os.environ.get("RAG_COLLECTION","aegis_docs")
+LINEAGE_REG = os.path.join(STORE, "lineage_registry.json")
+
+os.makedirs(STORE, exist_ok=True)
+
+def record_lineage(entry):
+    try:
+        lst = json.load(open(LINEAGE_REG))
+    except Exception:
+        lst = []
+    lst.append(entry)
+    with open(LINEAGE_REG, "w") as fh:
+        json.dump(lst, fh, indent=2)
+
+app = Flask(__name__)
+
+@app.route("/ingest/image", methods=["POST"])
+def ingest_image():
+    f = request.files.get("file")
+    item_id = request.form.get("id") or f"img-{int(time.time())}"
+    meta = json.loads(request.form.get("metadata","{}"))
+    data = f.read()
+    # OCR
+    ocr_text = None
+    if _HAS_OCR:
+        from PIL import Image
+        im = Image.open(tempfile.NamedTemporaryFile(delete=False))
+        im = Image.open(io.BytesIO(data))
+        ocr_text = pytesseract.image_to_string(im)
+    emb = image_to_embedding(data)
+    # Upsert to Milvus: store embedding and metadata (text, ocr, original_uri placeholder)
+    meta_record = {"type":"image", "source_meta": meta, "ocr": ocr_text, "ingested_at": time.time(), "id": item_id}
+    pk = upsert_documents(COLLECTION, [(emb.tolist(), meta_record)])
+    # Save original file for lineage
+    path = os.path.join(STORE, f"{item_id}.jpg")
+    open(path, "wb").write(data)
+    record_lineage({"id": item_id, "type":"image", "path": path, "meta": meta_record})
+    return jsonify({"ok": True, "pk": pk})
+
+@app.route("/ingest/audio", methods=["POST"])
+def ingest_audio():
+    f = request.files.get("file")
+    item_id = request.form.get("id") or f"aud-{int(time.time())}"
+    meta = json.loads(request.form.get("metadata","{}"))
+    path = os.path.join(STORE, f"{item_id}.wav")
+    f.save(path)
+    # Transcribe
+    transcript = audio_to_transcript(path)
+    emb = text_to_embedding(transcript)
+    meta_record = {"type":"audio", "source_meta": meta, "transcript": transcript, "ingested_at": time.time(), "id": item_id}
+    pk = upsert_documents(COLLECTION, [(emb.tolist(), meta_record)])
+    record_lineage({"id": item_id, "type":"audio", "path": path, "meta": meta_record})
+    return jsonify({"ok": True, "pk": pk, "transcript": transcript})
+
+@app.route("/ingest/video", methods=["POST"])
+def ingest_video():
+    f = request.files.get("file")
+    item_id = request.form.get("id") or f"vid-{int(time.time())}"
+    meta = json.loads(request.form.get("metadata","{}"))
+    tmp = tempfile.mkdtemp()
+    vpath = os.path.join(tmp, f"{item_id}.mp4")
+    f.save(vpath)
+    # extract frames & compute embeddings for a subset
+    frames = video_extract_frames(vpath, fps=int(request.form.get("fps",1)))
+    pks = []
+    for i, frame_path in enumerate(frames):
+        with open(frame_path,"rb") as fh:
+            data = fh.read()
+        emb = image_to_embedding(data)
+        frame_meta = {"video_id": item_id, "frame_index": i, "type":"video_frame", "ingested_at": time.time(), "source_meta": meta}
+        pk = upsert_documents(COLLECTION, [(emb.tolist(), frame_meta)])
+        pks.extend(pk)
+    record_lineage({"id": item_id, "type":"video", "path": vpath, "frames": len(frames), "meta": meta})
+    return jsonify({"ok": True, "frame_pks": pks, "frames": len(frames)})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("MM_PORT","8095")))
