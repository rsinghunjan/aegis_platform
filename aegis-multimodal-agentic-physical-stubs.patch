+#!/usr/bin/env python3
+"""
+A simple verifier service that accepts generated text and checks overlap with retrieved docs.
+ - POST /verify  {"text":"...","retrieved_docs":[{"id":..,"text":...}]}
+ Returns {"allow": bool, "score": float, "reasons": [...]}
+This is a heuristic stub; replace with fact-checking models or retrieval-augmented verification in prod.
+"""
+from fastapi import FastAPI
+from pydantic import BaseModel
+import difflib
+
+app = FastAPI(title="Aegis Hallucination Verifier")
+
+class VerifyReq(BaseModel):
+    text: str
+    retrieved_docs: list
+
+@app.post("/verify")
+def verify(req: VerifyReq):
+    # naive: compute longest common subsequence ratio vs top-k docs combined
+    doc_text = " ".join([d.get("text","") for d in req.retrieved_docs])
+    if not doc_text:
+        return {"allow": False, "score": 0.0, "reasons": ["no supporting docs"]}
+    matcher = difflib.SequenceMatcher(None, req.text, doc_text)
+    score = matcher.ratio()
+    allow = score >= 0.15  # very permissive; tune per use-case
+    reasons = []
+    if not allow:
+        reasons.append("low overlap with retrieved evidence")
+    return {"allow": allow, "score": score, "reasons": reasons}
+
