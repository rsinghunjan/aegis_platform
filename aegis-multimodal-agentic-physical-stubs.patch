+#!/usr/bin/env python3
+"""
+HIL runner: orchestrates a hardware-in-the-loop execution, collects logs, computes basic metrics,
+and attaches signed evidence to MCP (evidence packaging handled by existing evidence pack tooling).
+"""
+import os, time, json, subprocess, uuid, requests
+from pathlib import Path
+
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+ARTIFACT_DIR = Path(os.environ.get("HIL_OUTPUT_DIR", "/tmp/hil_runs"))
+ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)
+
+def run_hil_scenario(scenario_id: str, test_script: str):
+    run_id = f"{scenario_id}-{int(time.time())}"
+    out_file = ARTIFACT_DIR / f"{run_id}.json"
+    # operator-supplied script should drive hardware, collect logs, etc.
+    try:
+        # Example: run a test script and capture output
+        if test_script:
+            subprocess.check_call(test_script, shell=True, timeout=300)
+        result = {"status":"ok","run_id":run_id,"scenario":scenario_id}
+    except Exception as e:
+        result = {"status":"failed","error":str(e),"run_id":run_id}
+    with open(out_file, "w") as f:
+        json.dump(result, f)
+    # attach MCP record
+    mcp = {"model_id": scenario_id, "version":"hil-1", "artifacts":[{"uri": f"file://{out_file}"}], "evaluation":{"run_id":run_id,"type":"hil"}}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/models/{scenario_id}/context", json=mcp, timeout=5.0)
+    except Exception:
+        pass
+    return str(out_file)
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("usage: hil_runner.py <scenario_id> [test_script]")
+        raise SystemExit(2)
+    print(run_hil_scenario(sys.argv[1], sys.argv[2] if len(sys.argv)>2 else ""))
