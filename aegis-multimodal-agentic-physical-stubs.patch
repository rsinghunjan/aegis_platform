+"""
+Simple TimescaleDB ingest stub for sensor metadata and telemetry.
+Requires POSTGRES_DSN env var (postgres with Timescale extension).
+"""
+import os, time, json
+import psycopg2
+from psycopg2.extras import Json
+
+DSN = os.environ.get("POSTGRES_DSN", "")
+
+def ensure_table():
+    with psycopg2.connect(DSN) as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+            CREATE TABLE IF NOT EXISTS sensor_telemetry (
+              id SERIAL PRIMARY KEY,
+              sensor_id TEXT,
+              ts BIGINT,
+              meta JSONB
+            );
+            SELECT create_hypertable('sensor_telemetry','ts', if_not_exists => TRUE);
+            """)
+            conn.commit()
+
+def insert_telemetry(sensor_id: str, meta: dict):
+    with psycopg2.connect(DSN) as conn:
+        with conn.cursor() as cur:
+            cur.execute("INSERT INTO sensor_telemetry (sensor_id, ts, meta) VALUES (%s,%s,%s)",
+                        (sensor_id, int(time.time()*1000), Json(meta)))
+            conn.commit()
+
+if __name__ == "__main__":
+    if not DSN:
+        print("Set POSTGRES_DSN")
+        raise SystemExit(2)
+    ensure_table()
