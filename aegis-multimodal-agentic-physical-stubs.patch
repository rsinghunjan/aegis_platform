+#!/usr/bin/env python3
+"""
+Extract frames from video and upload frame pointers (S3/LakeFS) for downstream indexing.
+Requires OpenCV (cv2) and boto3 if using S3.
+"""
+import os, cv2, uuid
+import boto3
+from pathlib import Path
+
+S3_BUCKET = os.environ.get("S3_BUCKET", "")
+AWS_REGION = os.environ.get("AWS_REGION", "us-east-1")
+
+def upload_bytes(b: bytes, key: str):
+    if not S3_BUCKET:
+        raise RuntimeError("S3_BUCKET not configured")
+    s3 = boto3.client("s3", region_name=AWS_REGION)
+    s3.put_object(Bucket=S3_BUCKET, Key=key, Body=b)
+    return f"s3://{S3_BUCKET}/{key}"
+
+def extract_frames(video_path: str, out_prefix: str = "frames", fps_step: int = 30):
+    cap = cv2.VideoCapture(video_path)
+    frame_idx = 0
+    saved = []
+    while True:
+        ret, frame = cap.read()
+        if not ret:
+            break
+        if frame_idx % fps_step == 0:
+            _, buf = cv2.imencode('.jpg', frame)
+            key = f"{out_prefix}/{uuid.uuid4().hex}.jpg"
+            uri = upload_bytes(buf.tobytes(), key)
+            saved.append(uri)
+        frame_idx += 1
+    cap.release()
+    return saved
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("usage: extract_frames.py <video>")
+        raise SystemExit(2)
+    print(extract_frames(sys.argv[1]))
+
