+#!/usr/bin/env python3
+"""
+Action-execution sandbox for agents.
+ - POST /action  {"agent":"...", "action":"...","params":{...}}
+ The sandbox validates via OPA (if configured), logs to MCP, and enqueues work (stub).
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import requests, os, uuid, time, subprocess
+
+app = FastAPI(title="Aegis Agent Sandbox")
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+OPA_URL = os.environ.get("OPA_URL", "")  # e.g., http://opa:8181/v1/data/aegis/allow
+
+class ActionReq(BaseModel):
+    agent: str
+    action: str
+    params: dict
+
+def opa_check(agent, action, params):
+    if not OPA_URL:
+        return {"allow": True, "reason": "opa not configured"}
+    payload = {"input": {"agent": agent, "action": action, "params": params}}
+    try:
+        r = requests.post(OPA_URL, json=payload, timeout=3.0)
+        return r.json().get("result", {"allow": False, "reason": "opa error"})
+    except Exception:
+        return {"allow": False, "reason": "opa unreachable"}
+
+def log_to_mcp(action_id, agent, action, params, result):
+    rec = {"model_id": "agent-actions", "version": "", "artifacts": [{"uri": f"action://{action_id}"}], "evaluation": {"action_id": action_id, "agent": agent, "action": action, "params": params, "result": result}, "approvals": []}
+    try:
+        requests.post(f"{MCP_API.rstrip('/')}/models/agent-actions/context", json=rec, timeout=5.0)
+    except Exception:
+        pass
+
+@app.post("/action")
+def do_action(req: ActionReq):
+    check = opa_check(req.agent, req.action, req.params)
+    if not check.get("allow", False):
+        raise HTTPException(status_code=403, detail=f"action denied by OPA: {check.get('reason')}")
+    # enqueue / run action (stub): we run a dry-run command or echo
+    action_id = uuid.uuid4().hex
+    # In production, push to a queue (Celery/Kafka) and run worker in isolated sandbox
+    try:
+        # simple local execution example (VERY limited)
+        if req.action == "run_shell":
+            cmd = req.params.get("cmd", "echo no-op")
+            output = subprocess.check_output(cmd, shell=True, timeout=10).decode("utf-8")
+            result = {"status": "ok", "output": output}
+        else:
+            result = {"status": "queued", "note": "action enqueued (stub)"}
+    except Exception as e:
+        result = {"status": "error", "error": str(e)}
+    log_to_mcp(action_id, req.agent, req.action, req.params, result)
+    return {"action_id": action_id, "result": result}
+
