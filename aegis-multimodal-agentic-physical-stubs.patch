+#!/usr/bin/env python3
+"""
+Lightweight embedding service with a FAISS-backed index.
+ - POST /embed  {"type":"text"|"image","data": "<text or base64 image>"}
+ - POST /index  {"id":"<artifact-id>","embedding":[...]}
+ - GET  /search?k=10&q=<text>
+
+This is a pragmatic starter: in production replace the embedding model with a GPU-backed model
+and the FAISS index with a managed vector DB (Milvus/Weaviate/Elastic).
+"""
+from typing import List
+import os, json, base64
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import numpy as np
+
+try:
+    import faiss
+except Exception:
+    faiss = None
+
+try:
+    from sentence_transformers import SentenceTransformer
+    EMB_MODEL = SentenceTransformer('all-MiniLM-L6-v2')
+except Exception:
+    EMB_MODEL = None
+
+INDEX_FILE = os.environ.get("EMB_INDEX_FILE", "/tmp/faiss.index")
+META_FILE = os.environ.get("EMB_META_FILE", "/tmp/faiss.meta.json")
+
+app = FastAPI(title="Aegis Embedding Service")
+
+class EmbedReq(BaseModel):
+    type: str
+    data: str
+
+class IndexReq(BaseModel):
+    id: str
+    embedding: List[float]
+
+def make_embedding(text: str):
+    if EMB_MODEL:
+        v = EMB_MODEL.encode([text])[0].astype("float32")
+        return v
+    # fallback: deterministic hash vector
+    h = np.frombuffer(text.encode("utf-8")[:512].ljust(512, b'\0'), dtype=np.uint8).astype("float32")
+    v = h / (np.linalg.norm(h) + 1e-6)
+    return v
+
+# initialize index
+DIM = int(os.environ.get("EMB_DIM", "384"))
+if faiss:
+    if os.path.exists(INDEX_FILE):
+        index = faiss.read_index(INDEX_FILE)
+    else:
+        index = faiss.IndexFlatL2(DIM)
+else:
+    index = None
+
+meta = {}
+if os.path.exists(META_FILE):
+    try:
+        with open(META_FILE, "r") as f:
+            meta = json.load(f)
+    except Exception:
+        meta = {}
+
+@app.post("/embed")
+def embed(req: EmbedReq):
+    if req.type == "text":
+        v = make_embedding(req.data).tolist()
+        return {"embedding": v}
+    elif req.type == "image":
+        # For demo: return a fake embedding based on base64 bytes
+        try:
+            b = base64.b64decode(req.data)
+            v = make_embedding("img:"+str(len(b))).tolist()
+            return {"embedding": v}
+        except Exception:
+            raise HTTPException(status_code=400, detail="invalid base64 image")
+    else:
+        raise HTTPException(status_code=400, detail="type must be text or image")
+
+@app.post("/index")
+def index_doc(req: IndexReq):
+    vec = np.array(req.embedding, dtype="float32")
+    if index is None:
+        raise HTTPException(status_code=500, detail="FAISS not available")
+    # add id as meta
+    idx = index.ntotal
+    index.add(vec.reshape(1, -1))
+    meta[str(idx)] = {"id": req.id}
+    with open(META_FILE, "w") as f:
+        json.dump(meta, f)
+    if faiss:
+        faiss.write_index(index, INDEX_FILE)
+    return {"ok": True, "index": idx}
+
+@app.get("/search")
+def search(q: str, k: int = 10):
+    v = make_embedding(q)
+    if index is None:
+        raise HTTPException(status_code=500, detail="FAISS not available")
+    D, I = index.search(np.array([v], dtype="float32"), k)
+    results = []
+    for i, dist in zip(I[0].tolist(), D[0].tolist()):
+        if str(i) in meta:
+            results.append({"id": meta[str(i)]["id"], "distance": float(dist)})
+    return {"results": results}
+
