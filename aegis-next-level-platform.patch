+    Submit a Kubeflow PyTorchJob for distributed training.
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "tenant_developer", "platform_admin"])
+    validate_data_ref(data_ref)
+    ns = ensure_tenant_namespace(actor.tenant_id)
+    run_id = str(uuid.uuid4())
+    # Compose env contract: evidence + callback handled by your image + callback token
