@@ -0,0 +1,263 @@
+"""
+Stronger tenant isolation automation:
+  - ResourceQuota + LimitRange per tenant namespace
+  - NetworkPolicy default deny + allow within namespace
+  - Optional: node pool segregation is infra-specific; we provide labels/tolerations hooks only.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Optional
+
+from kubernetes import client
+from kubernetes.client.rest import ApiException
+
+from api.golden_k8s import _core, _networking, _load_k8s
+
+
+def ensure_default_network_policy(namespace: str) -> None:
+    net = _networking()
+    name = "aegis-default-deny"
+    body = client.V1NetworkPolicy(
+        metadata=client.V1ObjectMeta(name=name, namespace=namespace),
+        spec=client.V1NetworkPolicySpec(
+            pod_selector=client.V1LabelSelector(match_labels={}),
+            policy_types=["Ingress", "Egress"],
+            ingress=[client.V1NetworkPolicyIngressRule(from_=[client.V1NetworkPolicyPeer(pod_selector=client.V1LabelSelector(match_labels={}))])],
+            egress=[client.V1NetworkPolicyEgressRule(to=[client.V1NetworkPolicyPeer(pod_selector=client.V1LabelSelector(match_labels={}))])],
+        ),
+    )
+    try:
+        net.create_namespaced_network_policy(namespace=namespace, body=body)
+    except ApiException as e:
+        if e.status != 409:
+            raise
+
+
+def ensure_resource_quota(namespace: str) -> None:
+    core = _core()
+    name = "aegis-tenant-quota"
+    # Defaults are conservative and should be overridden via env if desired.
+    rq = client.V1ResourceQuota(
+        metadata=client.V1ObjectMeta(name=name, namespace=namespace),
+        spec=client.V1ResourceQuotaSpec(
+            hard={
+                "requests.cpu": os.environ.get("AEGIS_TENANT_QUOTA_REQ_CPU", "8"),
+                "requests.memory": os.environ.get("AEGIS_TENANT_QUOTA_REQ_MEM", "32Gi"),
+                "limits.cpu": os.environ.get("AEGIS_TENANT_QUOTA_LIM_CPU", "16"),
+                "limits.memory": os.environ.get("AEGIS_TENANT_QUOTA_LIM_MEM", "64Gi"),
+                "pods": os.environ.get("AEGIS_TENANT_QUOTA_PODS", "50"),
+            }
+        ),
+    )
+    try:
+        core.create_namespaced_resource_quota(namespace=namespace, body=rq)
+    except ApiException as e:
+        if e.status != 409:
+            raise
