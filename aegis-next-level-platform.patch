+@app.post("/v1/runs/distributed/pytorchjob")
+async def create_distributed_pytorchjob(
+    request: Request,
+    project_id: str = Form(...),
+    model_id: str = Form(...),
+    model_version_id: str = Form(...),
+    train_image: str = Form(...),
+    data_ref: str = Form(...),
