+"""
+Experiment tracking integration (MLflow/W&B).
+
+This module does not vendor either system; it provides:
+  - standardized env variables passed into training containers
+  - optional server-side recording of run pointers/URLs into Aegis Run.output
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Dict, Optional
+
+
+def experiment_env(run_id: str, tenant_id: str, project_id: str) -> Dict[str, str]:
+    env: Dict[str, str] = {
+        "AEGIS_RUN_ID": run_id,
+        "AEGIS_TENANT_ID": tenant_id,
+        "AEGIS_PROJECT_ID": project_id,
+    }
+
+    # MLflow
+    mlflow_uri = os.environ.get("AEGIS_MLFLOW_TRACKING_URI", "").strip()
+    if mlflow_uri:
+        env["MLFLOW_TRACKING_URI"] = mlflow_uri
+        env["MLFLOW_EXPERIMENT_NAME"] = f"aegis/{tenant_id}/{project_id}"
+        env["MLFLOW_RUN_NAME"] = run_id
+
+    # Weights & Biases
+    wandb_proj = os.environ.get("AEGIS_WANDB_PROJECT", "").strip()
+    if wandb_proj:
+        env["WANDB_PROJECT"] = wandb_proj
+        env["WANDB_NAME"] = run_id
+        env["WANDB_ENTITY"] = os.environ.get("AEGIS_WANDB_ENTITY", "").strip()
+        env["WANDB_MODE"] = os.environ.get("AEGIS_WANDB_MODE", "online")
+
+    return env
