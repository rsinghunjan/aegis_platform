@@ -0,0 +1,218 @@
+"""
+Dataset / feature store integration (Feast + data version pointers).
+
+This module defines "data references" as stable URIs that can be recorded in Aegis
+and passed into training/eval containers.
+
+Supported patterns:
+  - s3://bucket/prefix@version (string convention)
+  - lakefs://repo/branch/path (string convention)
+  - feast://feature_view:version (string convention)
+
+This is v1: Aegis records these references and includes them in evidence manifests
+and run inputs. Actual ingestion is done by your training code.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Dict
+
+
+def validate_data_ref(ref: str) -> None:
+    if not ref or not isinstance(ref, str):
+        raise ValueError("data_ref must be a non-empty string")
+    ok = (
+        ref.startswith("s3://")
+        or ref.startswith("lakefs://")
+        or ref.startswith("feast://")
+        or ref.startswith("gs://")
+        or ref.startswith("abfs://")
+    )
+    if not ok:
+        raise ValueError("unsupported data_ref scheme (use s3://, lakefs://, feast://, gs://, abfs://)")
+
+
+def data_env(data_ref: str) -> Dict[str, str]:
+    validate_data_ref(data_ref)
+    return {"AEGIS_DATA_REF": data_ref}
