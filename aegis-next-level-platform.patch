diff --git a/api/golden_training_distributed.py b/api/golden_training_distributed.py
new file mode 100644
index 0000000..e0c0c4b
--- /dev/null
+++ b/api/golden_training_distributed.py
@@ -0,0 +1,300 @@
+"""
+Distributed training orchestration helpers.
+
+This module supports two "operators" commonly used in Kubernetes:
+  1) Kubeflow PyTorchJob (pytorch.org/v1)
+  2) RayJob (ray.io/v1) for distributed training or tuning
+
+These are submitted via Kubernetes CustomObjects API.
+
+This is intentionally minimal and generic: you provide your training image/args,
+and Aegis provides standard env + evidence/callback contract.
+"""
+
+from __future__ import annotations
+
+import os
+import uuid
+from typing import Any, Dict, List, Optional
+
+from kubernetes import client, config
+
+
+def _load_k8s():
+    mode = os.environ.get("AEGIS_K8S_CONFIG", "auto")  # auto|incluster|kubeconfig
+    if mode == "incluster":
+        config.load_incluster_config()
+        return
+    if mode == "kubeconfig":
+        config.load_kube_config()
+        return
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+
+
+def _coapi() -> client.CustomObjectsApi:
+    _load_k8s()
+    return client.CustomObjectsApi()
+
+
+def submit_pytorchjob(namespace: str, name_prefix: str, job: Dict[str, Any]) -> str:
+    api = _coapi()
+    name = f"{name_prefix}-{uuid.uuid4().hex[:8]}"
+    job = dict(job)
+    job.setdefault("metadata", {})
+    job["metadata"]["name"] = name
+    api.create_namespaced_custom_object(
+        group="kubeflow.org",
+        version=os.environ.get("AEGIS_PYTORCHJOB_VERSION", "v1"),
+        namespace=namespace,
+        plural="pytorchjobs",
+        body=job,
+    )
+    return name
+
+
+def pytorchjob_template(
+    train_image: str,
+    train_args: List[str],
+    env: Dict[str, str],
+    worker_replicas: int = 2,
+    master_replicas: int = 1,
+    gpu_per_worker: int = 1,
+) -> Dict[str, Any]:
+    def env_list(d): return [{"name": k, "value": v} for k, v in d.items()]
+    return {
+        "apiVersion": f"kubeflow.org/{os.environ.get('AEGIS_PYTORCHJOB_VERSION', 'v1')}",
+        "kind": "PyTorchJob",
+        "spec": {
+            "pytorchReplicaSpecs": {
+                "Master": {
+                    "replicas": master_replicas,
+                    "restartPolicy": "OnFailure",
+                    "template": {
+                        "spec": {
+                            "containers": [{
+                                "name": "pytorch",
+                                "image": train_image,
+                                "args": train_args,
+                                "env": env_list(env),
+                            }]
+                        }
+                    },
+                },
+                "Worker": {
+                    "replicas": worker_replicas,
+                    "restartPolicy": "OnFailure",
+                    "template": {
+                        "spec": {
+                            "containers": [{
+                                "name": "pytorch",
+                                "image": train_image,
+                                "args": train_args,
+                                "env": env_list(env),
+                                "resources": {
+                                    "limits": {"nvidia.com/gpu": gpu_per_worker}
+                                } if gpu_per_worker else {},
+                            }]
+                        }
+                    },
+                },
+            }
+        },
+    }
+
+
+def submit_rayjob(namespace: str, name_prefix: str, job: Dict[str, Any]) -> str:
+    api = _coapi()
+    name = f"{name_prefix}-{uuid.uuid4().hex[:8]}"
+    job = dict(job)
+    job.setdefault("metadata", {})
+    job["metadata"]["name"] = name
+    api.create_namespaced_custom_object(
+        group="ray.io",
+        version=os.environ.get("AEGIS_RAYJOB_VERSION", "v1"),
+        namespace=namespace,
+        plural="rayjobs",
+        body=job,
+    )
+    return name
+
+
+def rayjob_template(
+    image: str,
+    entrypoint: str,
+    env: Dict[str, str],
+    head_cpu: int = 2,
+    worker_replicas: int = 2,
+    worker_cpu: int = 4,
+    worker_gpu: int = 1,
+) -> Dict[str, Any]:
+    def env_list(d): return [{"name": k, "value": v} for k, v in d.items()]
+    return {
+        "apiVersion": f"ray.io/{os.environ.get('AEGIS_RAYJOB_VERSION', 'v1')}",
+        "kind": "RayJob",
+        "spec": {
+            "entrypoint": entrypoint,
+            "rayClusterSpec": {
+                "headGroupSpec": {
+                    "rayStartParams": {"dashboard-host": "0.0.0.0"},
+                    "template": {"spec": {"containers": [{"name": "ray-head", "image": image, "env": env_list(env)}]}},
+                },
+                "workerGroupSpecs": [{
+                    "replicas": worker_replicas,
+                    "groupName": "workers",
+                    "rayStartParams": {},
+                    "template": {
+                        "spec": {
+                            "containers": [{
+                                "name": "ray-worker",
+                                "image": image,
+                                "env": env_list(env),
+                                "resources": {
+                                    "limits": {"cpu": str(worker_cpu), "nvidia.com/gpu": worker_gpu}
+                                },
+                            }]
+                        }
+                    },
+                }],
+            },
+        },
+    }
