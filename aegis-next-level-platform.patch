@@ -0,0 +1,204 @@
+"""
+Triton schema correctness helpers.
+
+Goal:
+  - standardize JSON shapes for Triton v2 inference
+  - enforce minimal model repo conventions on artifact init
+
+This does not attempt to cover all Triton tensor modes. It provides a safer baseline
+for text models using BYTES input.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List
+
+
+def triton_text_infer_body(model_name: str, text: str, input_name: str = "TEXT", output_name: str = "OUTPUT") -> Dict[str, Any]:
+    """
+    Build Triton HTTP/JSON infer request.
+    """
+    return {
+        "inputs": [
+            {
+                "name": input_name,
+                "datatype": "BYTES",
+                "shape": [1],
+                "data": [text],
+            }
+        ],
+        "outputs": [{"name": output_name}],
+    }
+
+
+def validate_triton_model_repo_layout(files: List[str]) -> None:
+    """
+    Validate model repository contains at least:
+      - config.pbtxt OR config.json (some setups)
+      - versioned subdir like 1/model.plan or 1/model.onnx etc.
+
+    Caller supplies a list of extracted file paths relative to model root.
+    """
+    has_config = any(p.endswith("config.pbtxt") or p.endswith("config.json") for p in files)
+    has_versioned = any(p.split("/")[0].isdigit() for p in files if "/" in p)
+    if not has_config or not has_versioned:
+        raise ValueError("Invalid Triton model repo layout: missing config and/or versioned subdir")
