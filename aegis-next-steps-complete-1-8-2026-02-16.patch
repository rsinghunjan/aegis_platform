+"""
+DLQ consumer that retries messages to a configured retry endpoint and logs failures.
+"""
+from confluent_kafka import Consumer, KafkaError
+import os, requests, time, json
+
+BOOT = os.environ.get("KAFKA_BOOTSTRAP_SERVERS","kafka.bootstrap.svc:9093")
+DLQ = os.environ.get("KAFKA_DLQ_TOPIC","mcp-events-dlq")
+RETRY_EP = os.environ.get("DLQ_RETRY_ENDPOINT","http://mcp.mcp.svc.cluster.local:8000/retry")
+
+consumer = Consumer({
+  'bootstrap.servers': BOOT,
+  'group.id': 'mcp-dlq-retry',
+  'auto.offset.reset': 'earliest'
+})
+consumer.subscribe([DLQ])
+
+while True:
+    msg = consumer.poll(1.0)
+    if msg is None: continue
+    if msg.error():
+        if msg.error().code() == KafkaError._PARTITION_EOF:
+            continue
+        print("Kafka error", msg.error()); break
+    try:
+        payload = json.loads(msg.value().decode())
+        r = requests.post(RETRY_EP, json=payload, timeout=5)
+        if r.status_code >= 400:
+            print("Retry failed, leaving in DLQ: ", r.status_code, r.text)
+    except Exception as e:
+        print("Exception while retrying:", e)
+    time.sleep(0.1)
+
