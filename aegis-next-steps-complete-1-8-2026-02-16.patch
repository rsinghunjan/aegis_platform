+"""
+Example Gatekeeper subscriber that listens to model promotion events and triggers policy refresh.
+"""
+import os, requests, json
+from confluent_kafka import Consumer, KafkaError
+
+BOOT = os.environ.get("KAFKA_BOOTSTRAP_SERVERS","kafka.bootstrap.svc:9093")
+TOPIC = os.environ.get("KAFKA_TOPIC","mcp-events")
+GATEKEEPER_URL = os.environ.get("GATEKEEPER_URL","http://gatekeeper.k8s.svc:8080")
+
+consumer = Consumer({'bootstrap.servers':BOOT, 'group.id':'gatekeeper-subscriber','auto.offset.reset':'earliest'})
+consumer.subscribe([TOPIC])
+
+while True:
+    msg = consumer.poll(1.0)
+    if msg is None: continue
+    if msg.error():
+        if msg.error().code() == KafkaError._PARTITION_EOF: continue
+        print("Error", msg.error()); break
+    payload = json.loads(msg.value().decode())
+    if payload.get("event") == "model_context.upsert":
+        model = payload.get("model_id")
+        try:
+            requests.post(f"{GATEKEEPER_URL}/v1/policies/refresh", json={"model_id":model}, timeout=5)
+        except Exception as e:
+            print("notify gatekeeper failed", e)
+
