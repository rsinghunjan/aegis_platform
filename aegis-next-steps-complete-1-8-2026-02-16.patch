+#!/usr/bin/env bash
+set -euo pipefail
+VAULT_ADDR=${VAULT_ADDR:-https://vault.internal}
+KEY_NAME=${1:-aegis-signing-key}
+# Rotate transit key (creates new version and publishes public key)
+echo "Rotating transit key ${KEY_NAME}"
+vault write -address=${VAULT_ADDR} -format=json transit/keys/${KEY_NAME}/rotate | jq .
+echo "Exporting public key for verification"
+vault read -address=${VAULT_ADDR} -format=json transit/keys/${KEY_NAME} > /tmp/${KEY_NAME}.json
+cat /tmp/${KEY_NAME}.json | jq '.keys' > /tmp/${KEY_NAME}_pubkeys.json
+echo "Upload the public keys to consumers (cosign verification points)"
+
