+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Orchestrated deployment script (opinionated) to provision core infra:
+# 1) Terraform: CloudHSM + Rekor RDS
+# 2) Helm: Vault (HSM), Kafka (Strimzi), Rekor, MCP
+#
+TF_DIR=${1:-.}
+echo "1) Run terraform init & apply for HSM and Rekor (edit tfvars)"
+(cd ${TF_DIR}/vault/terraform && terraform init && terraform apply -auto-approve)
+(cd ${TF_DIR}/rekor/terraform && terraform init && terraform apply -auto-approve)
+
+echo "2) Install Strimzi (Kafka) - operator"
+kubectl apply -f kafka/strimzi/strimzi-cluster-operator.yaml || echo "Apply Strimzi operator manually if not present"
+
+echo "3) Deploy Vault via Helm"
+helm upgrade --install vault hashicorp/vault -n vault -f vault/helm/values-production.yaml --create-namespace
+
+echo "4) Deploy Rekor (ensure TLS Secret exists)"
+helm upgrade --install rekor aegis/rekor -n rekor --create-namespace
+
+echo "5) Deploy MCP (Helm)"
+helm upgrade --install mcp ./mcp/helm -n mcp --create-namespace -f mcp/helm/values.yaml
+
+echo "Deployment started. Monitor pods and logs for success."
+
