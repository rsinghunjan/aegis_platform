+/*
+Terraform skeleton to provision an AWS CloudHSM cluster and supporting IAM resources
+for Vault PKCS#11 auto-unseal and BYOK signing keys.
+
+IMPORTANT:
+- This is a starting template. Work with your Security/HSM vendor before applying.
+- Fill in variables (vpc_id, subnet_ids, key_admin_arn) and review IAM policies.
+*/
+provider "aws" {
+  region = var.aws_region
+}
+
+resource "aws_cloudhsm_v2_cluster" "aegis_cloudhsm" {
+  hsm_type  = var.hsm_type
+  subnet_ids = var.hsm_subnet_ids
+  tags = {
+    Name = "aegis-cloudhsm"
+    Owner = "Aegis Platform"
+  }
+}
+
+resource "aws_cloudhsm_v2_hsm" "primary_hsm" {
+  cluster_id = aws_cloudhsm_v2_cluster.aegis_cloudhsm.id
+  subnet_id  = element(var.hsm_subnet_ids, 0)
+}
+
+resource "aws_security_group" "cloudhsm_sg" {
+  name        = "aegis-cloudhsm-sg"
+  description = "SG for CloudHSM to allow Vault hosts"
+  vpc_id      = var.vpc_id
+  ingress {
+    from_port   = 2224
+    to_port     = 2224
+    protocol    = "tcp"
+    cidr_blocks = var.vault_allowed_cidrs
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+output "cloudhsm_cluster_id" {
+  value = aws_cloudhsm_v2_cluster.aegis_cloudhsm.id
+}
+output "cloudhsm_hsm_id" {
+  value = aws_cloudhsm_v2_hsm.primary_hsm.id
+}
