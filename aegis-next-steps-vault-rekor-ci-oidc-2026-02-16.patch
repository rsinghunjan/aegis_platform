+#!/usr/bin/env bash
+set -euo pipefail
+NAMESPACE=${1:-vault}
+POD_TO_DELETE=${2:-}
+
+if [ -z "$POD_TO_DELETE" ]; then
+  POD_TO_DELETE=$(kubectl -n ${NAMESPACE} get pods -l app=vault -o jsonpath='{.items[0].metadata.name}')
+fi
+
+echo "Deleting pod ${POD_TO_DELETE} in namespace ${NAMESPACE} to simulate failover..."
+kubectl -n ${NAMESPACE} delete pod ${POD_TO_DELETE}
+echo "Waiting for replacement pod..."
+sleep 5
+NEWPOD=""
+for i in $(seq 1 60); do
+  NEWPOD=$(kubectl -n ${NAMESPACE} get pods -l app=vault -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
+  if [ ! -z "$NEWPOD" ]; then
+    echo "Found pod: $NEWPOD"
+    break
+  fi
+  sleep 2
+done
+echo "Streaming logs (30s) from $NEWPOD..."
+kubectl -n ${NAMESPACE} logs -f $NEWPOD --since=30s & sleep 30; pkill -P $$ kubectl || true
+echo "Validating unseal status..."
+kubectl -n ${NAMESPACE} exec -it $NEWPOD -- vault status
+echo "Done."
+
