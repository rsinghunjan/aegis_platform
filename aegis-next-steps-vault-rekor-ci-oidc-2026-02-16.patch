+#!/usr/bin/env bash
+set -euo pipefail
+S3_BUCKET=${S3_BUCKET:-"s3://aegis-rekor-backups"}
+LATEST=$(aws s3 ls ${S3_BUCKET}/ | sort | tail -n1 | awk '{print $4}')
+if [ -z "${LATEST}" ]; then echo "No backups found in ${S3_BUCKET}"; exit 1; fi
+TMP=/tmp/rekor.restore.dump
+echo "Downloading ${LATEST}..."
+aws s3 cp "${S3_BUCKET}/${LATEST}" "${TMP}"
+echo "Restoring to ${STAGING_PG_HOST}..."
+export PGPASSWORD=${STAGING_PG_PASSWORD}
+pg_restore -h ${STAGING_PG_HOST} -U ${STAGING_PG_USER} -d rekor --clean "${TMP}"
+echo "Restarting rekor deployment in staging..."
+kubectl -n rekor rollout restart deployment/rekor-server
+sleep 8
+echo "Validating Rekor API (staging)..."
+curl -sS --insecure "https://rekor.staging.internal/api/v1/log/log_info" | jq .
+echo "Test entry listing:"
+curl -sS --insecure "https://rekor.staging.internal/api/v1/log/entries?logIndex=0" || true
+echo "Restore & validation complete."
+
