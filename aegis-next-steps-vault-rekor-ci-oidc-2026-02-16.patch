+#!/usr/bin/env bash
+set -euo pipefail
+DOMAIN=${1:-rekor.internal}
+OUT_DIR=${2:-/tmp/rekor-certs}
+mkdir -p ${OUT_DIR}
+echo "Generating self-signed cert for ${DOMAIN} into ${OUT_DIR}"
+openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
+  -subj "/CN=${DOMAIN}" \
+  -keyout ${OUT_DIR}/rekor.key \
+  -out ${OUT_DIR}/rekor.crt
+echo "To upload to k8s: kubectl -n rekor create secret tls rekor-tls --cert=${OUT_DIR}/rekor.crt --key=${OUT_DIR}/rekor.key"
