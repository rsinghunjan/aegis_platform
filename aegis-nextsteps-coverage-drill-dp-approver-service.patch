+#!/usr/bin/env python3
+"""
+Deployment & code coverage checker
+
+Checks:
+ - No direct Triton/vLLM client usage in repository (enforce gateway).
+ - Kubernetes cluster deployments reference gateway (env var or annotation).
+ - Warn if any deployments/services expose Triton/vLLM endpoints directly.
+
+Usage:
+  python3 ops/automation/deployment_coverage_check.py [--kube-context CONTEXT]
+
+This script is intended to be run by CI or an operator with kubectl access.
+"""
+import subprocess
+import argparse
+import sys
+import re
+import json
+
+def check_codebase():
+    print("Checking source for direct Triton/vLLM usage...")
+    found = []
+    patterns = [re.compile(r"\btriton\b", re.I), re.compile(r"v2/models", re.I), re.compile(r"tritonclient", re.I), re.compile(r"vllm", re.I)]
+    files = subprocess.check_output(["git", "ls-files", "*.py", "*.js", "*.ts", "*.go"], text=True).splitlines()
+    for f in files:
+        if f.startswith("ops/serving/gateway"):  # skip gateway sources
+            continue
+        try:
+            txt = open(f, "r", errors="ignore").read()
+        except Exception:
+            continue
+        for p in patterns:
+            if p.search(txt):
+                found.append((f, p.pattern))
+                break
+    if found:
+        print("Direct calls/patterns detected (file, pattern):")
+        for f,pat in found:
+            print(" -", f, pat)
+    else:
+        print("No direct Triton/vLLM patterns found in source (quick scan).")
+    return found
+
+def kubectl(ctx=None, args=None):
+    cmd = ["kubectl"]
+    if ctx:
+        cmd += ["--context", ctx]
+    cmd += args
+    return subprocess.check_output(cmd, text=True)
+
+def check_k8s(ctx=None, namespace=None):
+    print("Checking Kubernetes deployments/services for gateway coverage...")
+    problems = []
+    ns_args = ["--all-namespaces"] if not namespace else ["-n", namespace]
+    # List deployments
+    deps = json.loads(kubectl(ctx, ["get","deployments"] + ns_args + ["-o","json"]))
+    for item in deps.get("items", []):
+        name = item["metadata"]["name"]
+        ns = item["metadata"]["namespace"]
+        # Check env vars for TRITON_GATEWAY_URL or annotation indicating uses gateway
+        uses_gateway = False
+        spec = item.get("spec",{})
+        for c in spec.get("template",{}).get("spec",{}).get("containers",[]):
+            for env in c.get("env",[]):
+                if env.get("name") in ("TRITON_GATEWAY_URL","TRITON_GATEWAY") or env.get("value","").find("triton-gateway")!=-1:
+                    uses_gateway = True
+            # check image name for gateway proxy (heuristic)
+            img = c.get("image","")
+            if "gateway" in img or "triton-gateway" in img:
+                uses_gateway = True
+        # If deployment is model-serving-like (heuristic by name) and does not use gateway, warn
+        if re.search(r"(model|serving|inference|triton)", name, re.I) and not uses_gateway:
+            problems.append(f"Deployment {ns}/{name} looks like a serving deployment but no gateway env found.")
+    # Services exposing triton/vllm ports
+    svcs = json.loads(kubectl(ctx, ["get","services"] + ns_args + ["-o","json"]))
+    for s in svcs.get("items", []):
+        name = s["metadata"]["name"]
+        ns = s["metadata"]["namespace"]
+        for p in s.get("spec",{}).get("ports",[]):
+            port = p.get("port")
+            if port in (8000,8001,8002,8080,8081,8082):
+                # these ports commonly used by Triton/vLLM; report for operator review
+                problems.append(f"Service {ns}/{name} exposes port {port} (check that it is not direct Triton endpoint).")
+    if problems:
+        print("Kubernetes coverage issues found:")
+        for p in problems:
+            print(" -", p)
+    else:
+        print("Kubernetes coverage checks passed (no obvious direct serving endpoints detected).")
+    return problems
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--kube-context", help="kubectl context to use")
+    ap.add_argument("--namespace", help="namespace to limit checks")
+    args = ap.parse_args()
+    code_issues = check_codebase()
+    try:
+        k8s_issues = check_k8s(ctx=args.kube_context, namespace=args.namespace)
+    except subprocess.CalledProcessError as e:
+        print("kubectl failed - cluster checks skipped. Ensure kubectl works and you have access.", file=sys.stderr)
+        k8s_issues = ["kubectl-failed"]
+    report = {
+        "code_issues": [i[0] for i in code_issues],
+        "k8s_issues": k8s_issues
+    }
+    print("\nSummary report:")
+    print(json.dumps(report, indent=2))
+    if code_issues or k8s_issues:
+        sys.exit(2)
+    sys.exit(0)
+
+if __name__=="__main__":
+    main()
+
