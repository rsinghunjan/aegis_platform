+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Automated incident drill runner:
+# 1) Runs the red-team full suite locally (or via GitHub Actions) to produce a simulated alert.
+# 2) If red-team detects an issue, calls the content-alert-handler to create remediation Argo workflow.
+# 3) Waits for the Argo workflow to finish, verifies model deployment scaled to 0, and checks evidence artifact uploaded.
+#
+# Requirements:
+# - kubectl and argo CLI configured for the cluster
+# - awscli configured (if S3 evidence upload is used)
+# - CONTENT_ALERT_HANDLER (URL), ARGO_NS, MODEL_DEPLOYMENT, S3_AUDIT_BUCKET environment variables
+
+CONTENT_ALERT_HANDLER=${CONTENT_ALERT_HANDLER:-http://content-alert-handler:7072/alert}
+ARGO_NS=${ARGO_NS:-aegis-ml}
+MODEL_DEPLOYMENT=${MODEL_DEPLOYMENT:-model-serving}
+S3_AUDIT_BUCKET=${S3_AUDIT_BUCKET:-}
+
+echo "Step 1: Run red-team full suite"
+set +e
+python3 ops/tests/redteam/prompt_injection_tests.py "${MODEL_ENDPOINT:-http://localhost:8080/generate}"
+RT_RC=$?
+python3 ops/tests/redteam/multi_step_agent_exfiltration.py "${AGENT_URL:-http://localhost:8081/run}"
+RT2_RC=$?
+set -e
+
+if [ $RT_RC -ne 0 ] || [ $RT2_RC -ne 0 ]; then
+  echo "Red-team detected issues; calling remediation handler..."
+  RESP=$(curl -s -X POST -H "Content-Type: application/json" -d "{\"alert\":\"drill_failure\",\"source\":\"incident_drill\",\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" "$CONTENT_ALERT_HANDLER")
+  echo "Remediation handler response: $RESP"
+else
+  echo "Red-team passed; for drill, still invoking remediation handler in dry-run mode."
+  RESP=$(curl -s -X POST -H "Content-Type: application/json" -d "{\"alert\":\"drill_dryrun\",\"source\":\"incident_drill\",\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" "$CONTENT_ALERT_HANDLER")
+  echo "Handler response (dry-run): $RESP"
+fi
+
+echo "Step 2: Identify created Argo workflow (sleep 5s then list recent workflows)"
+sleep 5
+argo list -n "$ARGO_NS" --sort-by=startTime | head -n 20
+WF_NAME=$(argo list -n "$ARGO_NS" --output json | jq -r '.[0].metadata.name')
+if [ -z "$WF_NAME" ] || [ "$WF_NAME" = "null" ]; then
+  echo "No workflow found in namespace $ARGO_NS. Exiting."
+  exit 2
+fi
+echo "Monitoring Argo workflow: $WF_NAME"
+argo watch -n "$ARGO_NS" "$WF_NAME" || true
+
+echo "Step 3: Verify model deployment scaled to 0 (or remediated)"
+REPLICAS=$(kubectl -n "$ARGO_NS" get deployment "$MODEL_DEPLOYMENT" -o jsonpath='{.spec.replicas}' 2>/dev/null || echo "n/a")
+echo "Model deployment replicas: $REPLICAS"
+
+if [ -n "$S3_AUDIT_BUCKET" ]; then
+  echo "Step 4: Check S3 for evidence artifacts"
+  aws s3 ls "${S3_AUDIT_BUCKET}/content_incident/" || echo "No evidence objects found or access denied"
+fi
+
+echo "Incident drill complete. Please review Argo workflow and evidence bundle for completeness."
+
