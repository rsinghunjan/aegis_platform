+        env:
+        - name: COSIGN_KMS_URI
+          valueFrom:
+            secretKeyRef:
+              name: cosign-kms-secret
+              key: kms_uri
+        - name: ALLOWED_APPROVER_TOKENS
+          valueFrom:
+            secretKeyRef:
+              name: approver-tokens
+              key: tokens
+        ports:
+        - containerPort: 8086
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: approver-signing
+  namespace: aegis-system
+spec:
+  ports:
+  - port: 8086
+    targetPort: 8086
+  selector:
+    app: approver-signing-service
