+#!/usr/bin/env python3
+"""
+Approver signing service (minimal, opinionated)
+
+ - Receives approval payloads (raw bytes) via POST /sign (content-type: application/octet-stream)
+ - Requires header X-Approver-Token for simple auth (in prod, integrate with SSO/OIDC)
+ - Signs the blob using cosign sign-blob with COSIGN_KMS_URI and returns hex-encoded signature
+
+Security notes:
+ - This service is a mediator. In production you should gate signing via an approval workflow,
+   short-lived grants, and strict audit logging. Do NOT expose KMS keys to approvers directly.
+ - The service calls cosign locally; cosign must be available in the container and COSIGN_KMS_URI set.
+"""
+from flask import Flask, request, jsonify
+import os, tempfile, subprocess, binascii, time, logging
+
+APP = Flask(__name__)
+logging.basicConfig(level=logging.INFO)
+
+# Simple approver token list (in prod, validate via OIDC or an access control service)
+ALLOWED_TOKENS = os.environ.get("ALLOWED_APPROVER_TOKENS", "")  # comma-separated tokens
+ALLOWED = [t.strip() for t in ALLOWED_TOKENS.split(",") if t.strip()]
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI", "")
+
+def verify_token(tok: str) -> bool:
+    if not ALLOWED:
+        # No config -> deny by default
+        return False
+    return tok in ALLOWED
+
+@APP.route("/sign", methods=["POST"])
+def sign_blob():
+    approver_token = request.headers.get("X-Approver-Token","")
+    if not verify_token(approver_token):
+        return jsonify({"ok":False, "error":"unauthorized"}), 401
+    data = request.get_data()
+    if not data:
+        return jsonify({"ok":False, "error":"empty payload"}), 400
+    # write blob to temp file
+    with tempfile.NamedTemporaryFile(delete=False) as bfh:
+        bfh.write(data)
+        bpath = bfh.name
+    sigpath = bpath + ".sig"
+    try:
+        if not COSIGN_KEY:
+            return jsonify({"ok":False, "error":"COSIGN_KMS_URI not configured"}), 500
+        # cosign sign-blob --key <KMS> --output-signature <sig> <blob>
+        cmd = ["cosign", "sign-blob", "--key", COSIGN_KEY, "--output-signature", sigpath, bpath]
+        subprocess.check_call(cmd)
+        with open(sigpath, "rb") as fh:
+            sig = fh.read()
+        hex_sig = binascii.hexlify(sig).decode()
+        # audit log (simple)
+        logging.info("signed blob by token=%s size=%d ts=%s", approver_token[:6] if approver_token else "nil", len(data), time.time())
+        return jsonify({"ok":True, "signature_hex": hex_sig})
+    except subprocess.CalledProcessError as e:
+        logging.exception("cosign failed")
+        return jsonify({"ok":False, "error":"signing_failed"}), 500
+    finally:
+        try:
+            os.unlink(bpath)
+            if os.path.exists(sigpath):
+                os.unlink(sigpath)
+        except Exception:
+            pass
+
+if __name__=="__main__":
+    APP.run(host="0.0.0.0", port=int(os.environ.get("PORT","8086")))
+
