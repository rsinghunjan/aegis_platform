+#!/usr/bin/env bash
+set -euo pipefail
+ACTION=${1:-}
+NAME=${2:-}
+VALUE=${3:-}
+if [ -z "$(command -v vault)" ]; then echo "Vault CLI required"; exit 2; fi
+case "$ACTION" in
+  put)
+    if [ -z "$VALUE" ]; then echo "Usage: $0 put <key> <value>"; exit 2; fi
+    vault kv put secret/aegis/"$NAME" value="$VALUE"
+    ;;
+  get)
+    vault kv get -field=value secret/aegis/"$NAME"
+    ;;
+  *)
+    echo "Usage: $0 put|get <key> [value]"
+    exit 2
+    ;;
