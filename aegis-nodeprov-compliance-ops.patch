+#!/usr/bin/env python3
+"""
+Finance reconcile worker:
+ - Pulls reservations from Postgres quota DB and posted charges from finance endpoint
+ - Reconciles mismatches and writes results to a reconciliation table; emits alerts if mismatch exceeds threshold.
+"""
+import os, requests, psycopg2, json
+DATABASE_URL = os.environ.get("DATABASE_URL","postgresql://postgres:postgres@postgres:5432/quota")
+FINANCE_API = os.environ.get("FINANCE_API","")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK","")
+
+def get_reservations(conn):
+    with conn.cursor() as cur:
+        cur.execute("SELECT rid, tenant, amount, created_at FROM reservations")
+        return cur.fetchall()
+
+def post_to_finance(record):
+    if not FINANCE_API:
+        return {"status":"skipped"}
+    r = requests.post(FINANCE_API+"/charges", json=record, timeout=10)
+    return {"status": r.status_code, "body": r.text}
+
+def run():
+    conn = psycopg2.connect(DATABASE_URL)
+    recs = get_reservations(conn)
+    mismatches=[]
+    for rid,tenant,amount,created_at in recs:
+        rec={"id": rid, "tenant": tenant, "amount": amount}
+        res = post_to_finance(rec)
+        if res.get("status") not in (200,201,"skipped"):
+            mismatches.append({"rid":rid,"status":res})
+    if mismatches:
+        if ALERT_WEBHOOK:
+            requests.post(ALERT_WEBHOOK, json={"mismatches": mismatches}, timeout=10)
+        print("Mismatches:", mismatches)
+    else:
+        print("Reconcile OK")
+
+if __name__=="__main__":
+    run()
+
