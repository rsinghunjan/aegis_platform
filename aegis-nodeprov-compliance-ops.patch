*** Add File:ops/legal/generate_legal_packet.py
+#!/usr/bin/env python3
+"""
+Collect evidence artifacts into a legal packet, compute hashes, add chain-of-custody metadata,
+sign the bundle with cosign (KMS ref) and prepare an uploadable artifact for legal review.
+"""
+import os, hashlib, json, subprocess, tempfile
+from datetime import datetime
+
+EVIDENCE_PATHS = ["./attestations", "./forensics", "./build.log"]
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+OUT_DIR = os.environ.get("OUT_DIR","/tmp/aegis_legal_packet")
+
+def sha256(path):
+    h=hashlib.sha256()
+    with open(path,"rb") as f:
+        for chunk in iter(lambda: f.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+def collect():
+    os.makedirs(OUT_DIR, exist_ok=True)
+    metadata = {"collected_at": datetime.utcnow().isoformat(), "items": []}
+    bundle = os.path.join(OUT_DIR, "legal_packet.tar.gz")
+    files=[]
+    for p in EVIDENCE_PATHS:
+        if os.path.exists(p):
+            files.append(p)
+    if not files:
+        print("No evidence files found in", EVIDENCE_PATHS)
+        return
+    subprocess.check_call(["tar","-czf",bundle]+files)
+    metadata["bundle_sha256"] = sha256(bundle)
+    metadata_path=os.path.join(OUT_DIR,"metadata.json")
+    with open(metadata_path,"w") as f:
+        json.dump(metadata,f,indent=2)
+    if COSIGN_KEY_REF:
+        try:
+            subprocess.check_call(["cosign","sign","--key",COSIGN_KEY_REF,bundle])
+            print("Signed bundle with cosign KMS key")
+        except Exception as e:
+            print("Cosign sign failed:", e)
+    print("Legal packet created at", OUT_DIR)
+
+if __name__=="__main__":
+    collect()
+
