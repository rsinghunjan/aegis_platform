+#!/usr/bin/env bash
+set -euo pipefail
+ATTESTATION_S3_URI=${1:-}
+KMS_REF=${2:-}
+WORKDIR=$(mktemp -d)
+if [ -z "$ATTESTATION_S3_URI" ] || [ -z "$KMS_REF" ]; then
+  echo "Usage: $0 s3://bucket/path/attestation.tar.gz <cosign-kms-ref>"
+  exit 2
+fi
+echo "Downloading attestation to $WORKDIR"
+if [[ "$ATTESTATION_S3_URI" == s3://* ]]; then
+  aws s3 cp "$ATTESTATION_S3_URI" "$WORKDIR/att.tar.gz"
+elif [[ "$ATTESTATION_S3_URI" == gs://* ]]; then
+  gsutil cp "$ATTESTATION_S3_URI" "$WORKDIR/att.tar.gz"
+else
+  curl -sSfL "$ATTESTATION_S3_URI" -o "$WORKDIR/att.tar.gz"
+fi
+if ! command -v cosign >/dev/null 2>&1; then
+  echo "cosign required in PATH"; exit 2
+fi
+echo "Extracting public key from KMS ref"
+cosign public-key --key "$KMS_REF" > "$WORKDIR/pubkey.pem"
+echo "Verifying signature"
+cosign verify --key "$WORKDIR/pubkey.pem" "$WORKDIR/att.tar.gz"
+echo "Verification succeeded"
+
