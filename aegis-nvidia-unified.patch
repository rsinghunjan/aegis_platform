+        r = requests.get(f"{A2A_API.rstrip('/')}/pending", timeout=5.0)
+        if r.ok:
+            for a in r.json():
+                # apply business logic, then record to MCP
+                requests.post(f"{AEGIS_MCP.rstrip('/')}/a2a/outcomes", json=a, timeout=3.0)
