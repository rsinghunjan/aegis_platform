+jobs:
+  build-and-sign:
+    runs-on: ubuntu-latest
+    env:
+      REGISTRY: ${{ secrets.REGISTRY_URL }}
+      REKOR_URL: ${{ secrets.REKOR_URL }}
+    steps:
+      - uses: actions/checkout@v4
+      - name: Set up QEMU
+        uses: docker/setup-qemu-action@v2
+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@v2
+      - name: Log in to registry
+        uses: docker/login-action@v2
+        with:
+          registry: ${{ secrets.REGISTRY_URL }}
+          username: ${{ secrets.REGISTRY_USER }}
+          password: ${{ secrets.REGISTRY_TOKEN }}
+      - name: Build Triton model container
+        run: |
+          docker build -t "${{ secrets.REGISTRY_URL }}/aegis/triton-model:latest" -f services/triton/Dockerfile services/triton
+          docker push "${{ secrets.REGISTRY_URL }}/aegis/triton-model:latest"
+      - name: Cosign sign image
+        env:
+          COSIGN_PASSWORD: ${{ secrets.COSIGN_PASSWORD }}
+        run: |
+          echo "$COSIGN_PRIVATE_KEY" > cosign.key
+          cosign sign --key cosign.key "${{ secrets.REGISTRY_URL }}/aegis/triton-model:latest"
+      - name: Rekor attest (optional)
+        if: ${{ secrets.REKOR_URL != '' }}
+        run: |
+          printf '{"type":"aegis.triton.build","image":"%s"}' "${{ secrets.REGISTRY_URL }}/aegis/triton-model:latest" > att.json
+          cosign attest --key cosign.key --predicate att.json "${{ secrets.REGISTRY_URL }}/aegis/triton-model:latest" || true
