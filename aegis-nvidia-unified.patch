+#!/usr/bin/env python3
+"""
+Register MLflow model artifacts into a Triton model-repo layout and optionally push to a model-repo volume.
+This script runs inside the Triton model-build container (CI / deploy task).
+It fetches an MLflow run artifact, converts if needed (e.g., ONNX/TensorRT) and writes the model repo.
+In production tie this into your model build/promotion pipeline.
+"""
+import os
+import sys
+import mlflow
+import shutil
+import tempfile
+import subprocess
+
+MLFLOW_URI = os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000")
+MODEL_NAME = os.environ.get("MODEL_NAME","aegis-triton-model")
+TRITON_MODEL_REPO_DIR = os.environ.get("TRITON_MODEL_REPO_DIR","/opt/triton-model-repo")
+
+mlflow.set_tracking_uri(MLFLOW_URI)
+
+def fetch_and_prepare():
+    # In practice, query MLflow for the model run and artifact. Here we look for local artifact for demo.
+    src = os.environ.get("LOCAL_MODEL_ARTIFACT","/workspace/model")
+    version_dir = os.path.join(TRITON_MODEL_REPO_DIR, MODEL_NAME, "1")
+    os.makedirs(version_dir, exist_ok=True)
+    # copy artifacts
+    if os.path.exists(src):
+        for f in os.listdir(src):
+            shutil.copy(os.path.join(src,f), version_dir)
+    # create config.pbtxt if missing (very simple)
+    cfg = os.path.join(TRITON_MODEL_REPO_DIR, MODEL_NAME, "config.pbtxt")
+    if not os.path.exists(cfg):
+        with open(cfg,"w") as f:
+            f.write('name: "{}"\nplatform: "onnx_runtime"\nmax_batch_size: 8\n'.format(MODEL_NAME))
+    print("Prepared triton model repo at", TRITON_MODEL_REPO_DIR)
+
+if __name__ == "__main__":
+    fetch_and_prepare()
+    # in CI container, we might exit after preparing
+    sys.exit(0)
+
