+#!/usr/bin/env python3
+"""
+Connector that receives Morpheus detection events and forwards them into Aegis:
+ - writes an evidence entry to Milvus/MCP
+ - invokes verifier ensemble to get a verdict
+ - opens A2A if incident severity high
+"""
+import os
+import requests
+import json
+from services.morpheus.verifier_stub import verify_event
+
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+
+def handle_morpheus_event(evt_json: dict):
+    # persist evidence to MCP (best-effort)
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/evidence", json=evt_json, timeout=3.0)
+    except Exception:
+        pass
+    # run verifier
+    verdict = verify_event(evt_json)
+    # If verdict severity high, open A2A
+    if verdict.get("severity","low") in ("high","critical"):
+        body = {"action_id": f"morpheus-{evt_json.get('id')}", "approver":"security", "decision":"requested", "comment":"Morpheus detection requires review", "evidence": verdict}
+        try:
+            r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+            return {"status":"a2a_opened","a2a": r.json() if r.ok else None}
+        except Exception:
+            return {"status":"a2a_failed"}
+    return {"status":"ok","verdict":verdict}
+
+if __name__ == "__main__":
+    import sys
+    sample = {"id":"evt-123","type":"suspicious-io","payload":{"score":0.92}}
+    print(handle_morpheus_event(sample))
+
