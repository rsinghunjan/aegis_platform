+#!/usr/bin/env python3
+"""
+Federated orchestrator with client enrollment/auth and DP aggregation.
+Prototype: uses JWT for client auth and applies Gaussian DP via dp_utils.
+Production: replace or augment with secure aggregation libraries (e.g., PySyft / TF Federated secure aggregation).
+"""
+import os
+import time
+import json
+from flask import Flask, request, jsonify
+import jwt
+import numpy as np
+from services.dp.dp_utils import add_gaussian_noise
+import requests
+
+app = Flask(__name__)
+SECRET = os.environ.get("FED_JWT_SECRET", "dev-fed-secret")  # replace with Vault secret
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+GLOBAL_WEIGHTS_PATH = "/data/federated/global.json"
+DP_EPSILON = float(os.environ.get("DP_EPSILON", "1.0"))
+
+def load_global():
+    if os.path.exists(GLOBAL_WEIGHTS_PATH):
+        return np.array(json.load(open(GLOBAL_WEIGHTS_PATH)))
+    return None
+
+def save_global(arr):
+    os.makedirs(os.path.dirname(GLOBAL_WEIGHTS_PATH), exist_ok=True)
+    json.dump(arr.tolist(), open(GLOBAL_WEIGHTS_PATH, "w"))
+
+def verify_jwt(token):
+    try:
+        payload = jwt.decode(token, SECRET, algorithms=["HS256"])
+        return payload
+    except Exception:
+        return None
+
+@app.route("/enroll", methods=["POST"])
+def enroll():
+    j = request.json or {}
+    client_id = j.get("client_id")
+    if not client_id:
+        return jsonify({"error":"client_id required"}), 400
+    # issue a short-lived JWT for client
+    token = jwt.encode({"client_id": client_id, "iat": int(time.time()), "exp": int(time.time()) + 3600}, SECRET, algorithm="HS256")
+    return jsonify({"token": token})
+
+@app.route("/submit", methods=["POST"])
+def submit():
+    auth = request.headers.get("Authorization", "")
+    if not auth.startswith("Bearer "):
+        return jsonify({"error":"missing auth"}), 401
+    token = auth.split(" ",1)[1]
+    payload = verify_jwt(token)
+    if not payload:
+        return jsonify({"error":"invalid auth"}), 401
+    j = request.json or {}
+    weights = np.array(j.get("weights", []), dtype=float)
+    scale = float(j.get("scale", 1.0))
+    if weights.size == 0:
+        return jsonify({"error":"no weights"}), 400
+    # simple aggregation: running mean with DP noise
+    global_w = load_global()
+    if global_w is None:
+        agg = weights * scale
+    else:
+        agg = (global_w + weights * scale) / 2.0
+    noisy = add_gaussian_noise(agg, epsilon=DP_EPSILON)
+    save_global(noisy)
+    # record round to MCP for auditing
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/federated/rounds", json={"client":payload.get("client_id"), "ts": time.time()}, timeout=2.0)
+    except Exception:
+        pass
+    return jsonify({"status":"ok"})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8085")))
+
