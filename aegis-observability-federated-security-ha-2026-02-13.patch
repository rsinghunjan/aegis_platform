+#!/usr/bin/env python3
+"""
+Client stub to enroll and submit a small model update using JWT auth.
+Demonstrates client enrollment and authenticated submission for secure federated flow.
+"""
+import os, requests, time, json
+import numpy as np
+
+ORCH = os.environ.get("ORCH", "http://orchestrator:8085")
+CLIENT_ID = os.environ.get("CLIENT_ID", "client-demo")
+
+def enroll():
+    r = requests.post(f"{ORCH.rstrip('/')}/enroll", json={"client_id": CLIENT_ID}, timeout=5.0)
+    r.raise_for_status()
+    return r.json()["token"]
+
+def submit_update(token, weights):
+    headers = {"Authorization": f"Bearer {token}"}
+    body = {"weights": weights, "scale": 1.0}
+    r = requests.post(f"{ORCH.rstrip('/')}/submit", json=body, headers=headers, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+if __name__ == "__main__":
+    t = enroll()
+    print("Got token, submitting update")
+    w = [0.01, -0.02, 0.005]
+    print(submit_update(t, w))
+
