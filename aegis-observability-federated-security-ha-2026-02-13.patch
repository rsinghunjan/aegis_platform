+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple scale test generator for webhook using curl in parallel. Use in staging.
+CONCURRENCY=${1:-50}
+TOTAL=${2:-2000}
+URL=${3:-http://model-provenance-webhook.aegis-system.svc.cluster.local:8443/validate}
+echo "Running $TOTAL requests at concurrency $CONCURRENCY against $URL"
+for i in $(seq 1 $CONCURRENCY); do
+  ( for j in $(seq 1 $(($TOTAL / $CONCURRENCY))); do
+      curl -s -o /dev/null -w "%{http_code} " -X POST -H "Content-Type: application/json" -d '{"test":"payload"}' "$URL"
+    done ) &
+done
+wait
+echo "Scale test complete."
+
