+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Install the kube-prometheus-stack (Prometheus Operator + Grafana + Alertmanager) via Helm.
+# Usage: ./install_kube_prometheus_stack.sh <namespace>
+NAMESPACE=${1:-monitoring}
+RELEASE=${2:-kube-prom-stack}
+
+echo "Creating namespace ${NAMESPACE}"
+kubectl create ns "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
+
+helm repo add prometheus-community https://prometheus-community.github.io/helm-charts || true
+helm repo add grafana https://grafana.github.io/helm-charts || true
+helm repo update
+
+cat > /tmp/values-kube-prom.yaml <<EOF
+prometheus:
+  prometheusSpec:
+    serviceMonitorSelectorNilUsesHelmValues: false
+    ruleSelectorNilUsesHelmValues: false
+    retention: 15d
+grafana:
+  adminUser: admin
+  adminPassword: changeme  # override in production via secrets
+  sidecar:
+    dashboards:
+      enabled: true
+EOF
+
+echo "Installing kube-prometheus-stack into ${NAMESPACE}"
+helm upgrade --install "${RELEASE}" prometheus-community/kube-prometheus-stack -n "${NAMESPACE}" -f /tmp/values-kube-prom.yaml
+
+echo "kube-prometheus-stack install requested. Wait for pods to be ready and secure Grafana admin password."
+
