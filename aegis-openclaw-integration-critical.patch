+from __future__ import annotations
+
+from typing import Any, Dict, Optional, Tuple
+
+from fastapi import HTTPException
+
+from api.golden_agent_tools import registry as internal_tool_registry, run_tool
+from api.golden_external_policy import enforce_tool_allowlist, enforce_budgets, load_external_client, require_approval_if_needed
+
+
+def tool_risk(tool_name: str) -> str:
+    t = internal_tool_registry().get(tool_name)
+    if not t:
+        raise HTTPException(status_code=400, detail="unknown tool")
+    return str(t.risk or "low")
+
+
+def execute_external_tool(
+    tenant_id: str,
+    client_id: str,
+    actor_sub: str,
+    tool: str,
+    args: Dict[str, Any],
+    *,
+    estimated_cost_usd: float = 0.0,
+    started_at_ts: float,
+    approval_id: Optional[str],
+) -> Dict[str, Any]:
+    c = load_external_client(tenant_id, client_id)
+    enforce_tool_allowlist(c, tool)
+    enforce_budgets(c, float(estimated_cost_usd or 0.0), started_at_ts)
+    risk = tool_risk(tool)
+    require_approval_if_needed(tenant_id, client_id, tool, risk=risk, approval_id=approval_id)
+    # Even if approved, keep high-risk disabled unless explicitly allowed via Aegis env/policy; for now use allow_high_risk=True only if approval exists.
+    allow_high_risk = True if (risk == "high" and approval_id) else False
+    return run_tool(tenant_id, actor_sub, tool, args, allow_high_risk=allow_high_risk)
