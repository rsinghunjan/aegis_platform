+from __future__ import annotations
+
+import time
+from typing import Any, Dict, List, Optional
+
+from fastapi import HTTPException
+
+from api.db import SessionLocal
+from api.golden_external_models import ExternalClient, ExternalApproval
+
+
+def load_external_client(tenant_id: str, client_id: str) -> ExternalClient:
+    s = SessionLocal()
+    try:
+        c = s.query(ExternalClient).filter_by(tenant_id=tenant_id, id=client_id).one_or_none()
+        if not c or c.status != "active":
+            raise HTTPException(status_code=403, detail="external client not allowed")
+        return c
+    finally:
+        s.close()
+
+
+def enforce_tool_allowlist(c: ExternalClient, tool: str) -> None:
+    allowed = c.allowed_tools or []
+    if tool not in allowed:
+        raise HTTPException(status_code=403, detail="tool not allowed for external client")
+
+
+def enforce_budgets(c: ExternalClient, estimated_cost_usd: float, started_at_ts: float, *, max_minutes_fallback: int = 30) -> None:
+    b = c.budgets or {}
+    max_cost = float(b.get("max_cost_usd", 10.0))
+    max_minutes = float(b.get("max_minutes", max_minutes_fallback))
+    if estimated_cost_usd > max_cost:
+        raise HTTPException(status_code=402, detail="budget exceeded: cost")
+    elapsed_min = (time.time() - started_at_ts) / 60.0
+    if elapsed_min > max_minutes:
+        raise HTTPException(status_code=408, detail="budget exceeded: time")
+
+
+def require_approval_if_needed(
+    tenant_id: str,
+    client_id: str,
+    tool: str,
+    risk: str,
+    approval_id: Optional[str],
+) -> None:
+    if risk != "high":
+        return
+    if not approval_id:
+        raise HTTPException(status_code=403, detail="high-risk tool requires approval_id")
+    s = SessionLocal()
+    try:
+        a = (
+            s.query(ExternalApproval)
+            .filter_by(id=approval_id, tenant_id=tenant_id, client_id=client_id)
+            .one_or_none()
+        )
+        if not a or a.status != "approved":
+            raise HTTPException(status_code=403, detail="approval not granted")
+        if a.requested_tool != tool:
+            raise HTTPException(status_code=403, detail="approval tool mismatch")
+    finally:
+        s.close()
