+@app.post("/v1/external/clients")
+async def external_create_client(
+    request: Request,
+    client_id: str = Form(...),
+    name: str = Form(...),
+    allowed_tools: str = Form(...),  # JSON list
+    budgets: Optional[str] = Form(None),  # JSON object
+):
+    """
+    Register an external client (e.g., OpenClaw) for this tenant.
+    This does not authenticate the client by itself; authentication is via existing OIDC/workload identity.
+    This is an authorization control-plane object.
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "platform_admin"])
+    s = SessionLocal()
+    try:
+        at = json.loads(allowed_tools)
+        if not isinstance(at, list) or not all(isinstance(x, str) for x in at):
+            raise HTTPException(status_code=400, detail="allowed_tools must be JSON list[str]")
+        bd = json.loads(budgets) if budgets else None
+        c = ExternalClient(
+            id=client_id,
+            tenant_id=actor.tenant_id,
+            name=name,
+            allowed_tools=at,
+            budgets=bd,
+            status="active",
+        )
+        s.add(c)
+        s.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "external.client.create", "external_client", client_id, decision="allow", details={"name": name})
+        return {"client_id": client_id, "status": "active"}
+    finally:
+        s.close()
+
+
+@app.post("/v1/external/approvals")
+async def external_request_approval(
+    request: Request,
+    client_id: str = Form(...),
+    tool: str = Form(...),
+    args: Optional[str] = Form(None),  # JSON object
+    external_user_id: str = Form(...),
+    external_context: Optional[str] = Form(None),  # JSON object: channel/thread/message ids
+):
+    """
+    Create an approval request for a high-risk tool.
+    This can be displayed in OpenClaw (approve/deny buttons).
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_user", "tenant_developer", "tenant_admin", "platform_admin"])
+
+    risk = tool_risk(tool)
+    if risk != "high":
+        raise HTTPException(status_code=400, detail="approval is only required for high-risk tools")
+
+    s = SessionLocal()
+    try:
+        aid = str(uuid.uuid4())
+        a = ExternalApproval(
+            id=aid,
+            tenant_id=actor.tenant_id,
+            client_id=client_id,
+            requested_by=external_user_id,
+            requested_tool=tool,
+            requested_args=json.loads(args) if args else {},
+            context=json.loads(external_context) if external_context else {},
+            status="pending",
+        )
+        s.add(a)
+        s.commit()
+        record_audit_event(
+            actor.tenant_id,
+            actor.sub,
+            "external.approval.request",
+            "external_approval",
+            aid,
+            decision="allow",
+            details={"client_id": client_id, "tool": tool},
+            external_context=a.context,
+        )
+        return {"approval_id": aid, "status": "pending"}
+    finally:
+        s.close()
+
+
+@app.post("/v1/external/approvals/{approval_id}/approve")
+async def external_approve(
+    request: Request,
+    approval_id: str,
+    reason: Optional[str] = Form(None),
+):
+    """
+    Approve an external tool request. Must be tenant_admin or platform_admin.
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "platform_admin"])
+    s = SessionLocal()
+    try:
+        a = s.query(ExternalApproval).filter_by(id=approval_id, tenant_id=actor.tenant_id).one_or_none()
+        if not a:
+            raise HTTPException(status_code=404, detail="approval not found")
+        if a.status != "pending":
+            raise HTTPException(status_code=409, detail="approval not pending")
+        a.status = "approved"
+        a.approved_by = actor.sub
+        a.approved_at = datetime.utcnow()
+        a.decision_reason = reason
+        s.commit()
+        record_audit_event(
+            actor.tenant_id,
+            actor.sub,
+            "external.approval.approve",
+            "external_approval",
+            approval_id,
+            decision="allow",
+            details={"tool": a.requested_tool, "client_id": a.client_id, "reason": reason},
+            external_context=a.context,
+        )
+        return {"approval_id": approval_id, "status": "approved"}
+    finally:
+        s.close()
+
+
+@app.post("/v1/external/approvals/{approval_id}/deny")
+async def external_deny(
+    request: Request,
+    approval_id: str,
+    reason: Optional[str] = Form(None),
+):
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "platform_admin"])
+    s = SessionLocal()
+    try:
+        a = s.query(ExternalApproval).filter_by(id=approval_id, tenant_id=actor.tenant_id).one_or_none()
+        if not a:
+            raise HTTPException(status_code=404, detail="approval not found")
+        if a.status != "pending":
+            raise HTTPException(status_code=409, detail="approval not pending")
+        a.status = "denied"
+        a.approved_by = actor.sub
+        a.approved_at = datetime.utcnow()
+        a.decision_reason = reason
+        s.commit()
+        record_audit_event(
+            actor.tenant_id,
+            actor.sub,
+            "external.approval.deny",
+            "external_approval",
+            approval_id,
+            decision="deny",
+            details={"tool": a.requested_tool, "client_id": a.client_id, "reason": reason},
+            external_context=a.context,
+        )
+        return {"approval_id": approval_id, "status": "denied"}
+    finally:
+        s.close()
+
+
+@app.post("/v1/external/tools/execute")
+async def external_tools_execute(
+    request: Request,
+    client_id: str = Form(...),
+    tool: str = Form(...),
+    args: str = Form("{}"),  # JSON
+    estimated_cost_usd: float = Form(0.0),
+    approval_id: Optional[str] = Form(None),
+    external_user_id: Optional[str] = Form(None),
+    external_context: Optional[str] = Form(None),  # JSON object: channel/thread/message ids
+):
+    """
+    External execution endpoint for OpenClaw-like clients.
+
+    Enforces:
+      - tenant delegation via external_clients
+      - strict allowlist per client
+      - budgets (max cost/time)
+      - approval object required for high-risk tools
+      - audit log contains external context
+    """
+    actor = actor_from_request(request)
+    # External runtimes should have tenant_developer/tenant_admin or dedicated workload role.
+    require_any_role(actor, ["tenant_developer", "tenant_admin", "platform_admin"])
+
+    started = time.time()
+    a = json.loads(args) if args else {}
+    ctx = json.loads(external_context) if external_context else {}
+    # Use a stable "impersonation" sub for audit clarity; include external end-user if provided.
+    ext_user = external_user_id or ""
+    actor_sub = f"{actor.sub}:external:{client_id}" + (f":user:{ext_user}" if ext_user else "")
+
+    out = execute_external_tool(
+        tenant_id=actor.tenant_id,
+        client_id=client_id,
+        actor_sub=actor_sub,
+        tool=tool,
+        args=a,
+        estimated_cost_usd=float(estimated_cost_usd or 0.0),
+        started_at_ts=started,
+        approval_id=approval_id,
+    )
+    record_audit_event(
+        actor.tenant_id,
+        actor_sub,
+        "external.tool.execute",
+        "tool",
+        tool,
+        decision="allow",
+        details={"client_id": client_id, "estimated_cost_usd": estimated_cost_usd},
+        external_context=ctx,
+    )
+    return {"ok": True, "tool": tool, "result": out}
