+from __future__ import annotations
+
+from datetime import datetime
+
+from sqlalchemy import Column, DateTime, Integer, String, Text, JSON, Index, UniqueConstraint
+
+from api.db import Base
+
+
+class ExternalClient(Base):
+    """
+    Represents an external agent runtime (e.g., OpenClaw) that can call Aegis.
+    Auth is still via OIDC/workload identity; this object governs tenancy + allowlists + budgets.
+    """
+    __tablename__ = "external_clients"
+
+    id = Column(String(100), primary_key=True)  # e.g. "openclaw"
+    tenant_id = Column(String(100), nullable=False, index=True)
+    name = Column(String(200), nullable=False)
+    allowed_tools = Column(JSON, nullable=False, default=list)  # list[str]
+    budgets = Column(JSON, nullable=True)  # {"max_cost_usd":10,"max_minutes":30,"max_high_risk_per_day":0}
+    status = Column(String(50), nullable=False, default="active")  # active|disabled
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (
+        UniqueConstraint("tenant_id", "id", name="uq_external_client_tenant_id"),
+        Index("ix_external_clients_tenant_created", "tenant_id", "created_at"),
+    )
+
+
+class ExternalApproval(Base):
+    """
+    Approval object for high-risk tool execution.
+    Intended to be surfaced in OpenClaw UI (buttons) or Aegis UI.
+    """
+    __tablename__ = "external_approvals"
+
+    id = Column(String(100), primary_key=True)
+    tenant_id = Column(String(100), nullable=False, index=True)
+    client_id = Column(String(100), nullable=False, index=True)
+    requested_by = Column(String(200), nullable=False)  # external_user_id or actor_sub
+    requested_tool = Column(String(200), nullable=False)
+    requested_args = Column(JSON, nullable=True)
+    context = Column(JSON, nullable=True)  # {"channel":"...","thread":"...","message":"..."}
+
+    status = Column(String(50), nullable=False, default="pending")  # pending|approved|denied|expired
+    approved_by = Column(String(200), nullable=True)
+    approved_at = Column(DateTime, nullable=True)
+    decision_reason = Column(Text, nullable=True)
+
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (
+        Index("ix_external_approvals_tenant_status", "tenant_id", "status"),
+        Index("ix_external_approvals_tenant_created", "tenant_id", "created_at"),
+    )
