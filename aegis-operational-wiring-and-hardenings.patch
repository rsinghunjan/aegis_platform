+#!/usr/bin/env bash
+set -euo pipefail
+# Creates a KMS key to be used with cosign (example for AWS)
+# Requires AWS CLI configured with privileges to create keys and grants.
+
+KEY_ALIAS="${1:-alias/aegis-cosign}"
+POLICY_FILE=$(mktemp)
+cat > "${POLICY_FILE}" <<EOF
+{
+  "Version": "2012-10-17",
+  "Statement": [
+    {
+      "Sid": "AllowUseKeyForCosign",
+      "Effect": "Allow",
+      "Principal": {"AWS": "arn:aws:iam::123456789012:role/aegis-approver-role"},
+      "Action": [
+        "kms:Sign",
+        "kms:GetPublicKey"
+      ],
+      "Resource": "*"
+    }
+  ]
+}
+EOF
+
+echo "Creating KMS key and alias ${KEY_ALIAS} (example AWS). Edit the policy as needed."
+KEY_ID=$(aws kms create-key --description "Aegis cosign key" --policy "file://${POLICY_FILE}" --query KeyMetadata.KeyId --output text)
+aws kms create-alias --alias-name "${KEY_ALIAS}" --target-key-id "${KEY_ID}"
+echo "KMS key created: ${KEY_ID}. Use cosign with key URI: awskms://${KEY_ALIAS}"
+rm -f "${POLICY_FILE}"
+
