+import os, requests, logging
+
+TOKENIZER_URL = os.environ.get("TOKENIZER_URL", "http://tokenizer.aegis-system.svc.cluster.local:8090/count")
+LOG = logging.getLogger("aegis.tokenizer.client")
+
+def count_tokens(text, model="default"):
+    try:
+        r = requests.post(TOKENIZER_URL, json={"text": text, "model": model}, timeout=2)
+        r.raise_for_status()
+        return int(r.json().get("tokens", 0))
+    except Exception:
+        LOG.exception("tokenizer call failed; falling back to whitespace heuristic")
+        return len(text.split())
+
