+#!/usr/bin/env python3
+"""
+Simple tokenizer/ token counting service.
+ - POST /count with {"text": "...", "model": "gpt-..." }
+ - Returns {"tokens": int}
+For production, replace whitespace heuristic with a real tokenizer (tiktoken, transformers)
+or call a centralized tokenizer microservice.
+"""
+from fastapi import FastAPI, Request
+from pydantic import BaseModel
+import uvicorn
+
+app = FastAPI()
+
+class CountReq(BaseModel):
+    text: str
+    model: str = "default"
+
+@app.post("/count")
+async def count(req: CountReq):
+    # very simple whitespace token estimate fallback
+    tokens = len(req.text.split())
+    return {"tokens": tokens}
+
+if __name__ == "__main__":
+    uvicorn.run(app, host="0.0.0.0", port=8090)
+
