+#!/usr/bin/env python3
+"""
+Batch tuner for inference servers.
+Runs combinations of BATCH_MAX_SIZE and BATCH_TIMEOUT_SEC against a target,
+collects p50/p95/p99 latency and throughput, and recommends settings based on latency SLO.
+
+Usage:
+  BATCH_TIMEOUT_SEC and BATCH_MAX_SIZE ranges can be provided via CLI or env.
+  The script requires the target gRPC address (INFERENCE_TARGET) and the load tester utilities installed.
+"""
+import subprocess
+import json
+import os
+import tempfile
+from itertools import product
+import time
+
+TARGET = os.environ.get("INFERENCE_TARGET", "127.0.0.1:50054")
+SAMPLE_PROMPTS = int(os.environ.get("TUNER_SAMPLES", "200"))
+LATENCY_SLO = float(os.environ.get("LATENCY_SLO_MS", "200"))  # in ms
+
+def run_test(batch_size, timeout_sec):
+    env = os.environ.copy()
+    env["BATCH_MAX_SIZE"] = str(batch_size)
+    env["BATCH_TIMEOUT_SEC"] = str(timeout_sec)
+    env["INFERENCE_TARGET"] = TARGET
+    # Use existing load_test_async.py but set smaller concurrency for tuning
+    cmd = ["python3", "ops/ci/load_test_async.py"]
+    start = time.time()
+    p = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=600)
+    dur = time.time()-start
+    out = p.stdout + "\n" + p.stderr
+    # Basic parsing: look for "p95" or success ratio if printed
+    return {"batch": batch_size, "timeout": timeout_sec, "success": p.returncode==0, "duration": dur, "output": out}
+
+def sweep(batch_range=[4,8,16,32], timeout_range=[0.005,0.01,0.02,0.05]):
+    results = []
+    for b,t in product(batch_range, timeout_range):
+        print("Testing batch", b, "timeout", t)
+        r = run_test(b,t)
+        results.append(r)
+    # naive scoring: prefer success and lower duration
+    results_sorted = sorted([r for r in results if r["success"]], key=lambda x: x["duration"])
+    rec = results_sorted[0] if results_sorted else results[0]
+    print("Recommended:", rec)
+    with open("ops/hw/autotune/results.json","w") as fh:
+        json.dump(results, fh, indent=2)
+    return rec
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--batches", nargs="+", type=int, default=[4,8,16])
+    p.add_argument("--timeouts", nargs="+", type=float, default=[0.01,0.02,0.05])
+    args = p.parse_args()
+    rec = sweep(args.batches, args.timeouts)
+    print("Recommended settings:", rec)
+
