+#!/usr/bin/env bash
+set -euo pipefail
+if [ -z "${DATABASE_URL:-}" ]; then
+  echo "DATABASE_URL required"; exit 2
+fi
+if [ -z "${BACKUP_FILE:-}" ]; then
+  echo "Provide BACKUP_FILE env path, e.g., s3://bucket/backup.sql.gz"; exit 2
+fi
+TMP=/tmp/langgraph_restore.sql.gz
+echo "Fetching backup $BACKUP_FILE"
+if [[ "$BACKUP_FILE" == s3://* ]]; then
+  aws s3 cp "$BACKUP_FILE" "$TMP"
+else
+  cp "$BACKUP_FILE" "$TMP"
+fi
+echo "Restoring to $DATABASE_URL"
+gunzip -c "$TMP" | psql "$DATABASE_URL"
+echo "Restore completed"
+
