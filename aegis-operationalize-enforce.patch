+#!/usr/bin/env python3
+"""
+Postgres-backed durable quota reservation service with idempotency.
+Simple API:
+ - POST /reserve {id, tenant, amount}
+ - GET /check?id=...
+"""
+import os, json
+from flask import Flask, request, jsonify
+import psycopg2
+
+DATABASE_URL = os.environ.get("DATABASE_URL","postgresql://postgres:postgres@postgres:5432/quota")
+
+app = Flask(__name__)
+
+def get_conn():
+    return psycopg2.connect(DATABASE_URL)
+
+def init_db():
+    sql = """
+    CREATE TABLE IF NOT EXISTS tenants (tenant text PRIMARY KEY, quota bigint, used bigint DEFAULT 0);
+    CREATE TABLE IF NOT EXISTS reservations (rid text PRIMARY KEY, tenant text, amount bigint, created_at bigint);
+    """
+    with get_conn() as conn:
+        with conn.cursor() as cur:
+            cur.execute(sql)
+        conn.commit()
+
+@app.route("/reserve", methods=["POST"])
+def reserve():
+    p = request.get_json(force=True)
+    rid = p.get("id"); tenant = p.get("tenant"); amount = int(p.get("amount",0))
+    if not (rid and tenant):
+        return jsonify({"ok":False,"error":"id,tenant required"}), 400
+    with get_conn() as conn:
+        with conn.cursor() as cur:
+            cur.execute("SELECT tenant, amount FROM reservations WHERE rid=%s", (rid,))
+            if cur.fetchone():
+                cur.execute("SELECT amount FROM reservations WHERE rid=%s", (rid,))
+                amount_existing = cur.fetchone()[0]
+                return jsonify({"ok":True,"reserved":amount_existing})
+            cur.execute("SELECT quota, used FROM tenants WHERE tenant=%s FOR UPDATE", (tenant,))
+            row = cur.fetchone()
+            if not row:
+                return jsonify({"ok":False,"error":"unknown tenant"}), 404
+            quota, used = row
+            if used + amount > quota:
+                return jsonify({"ok":False,"error":"over_quota"}), 402
+            cur.execute("UPDATE tenants SET used = used + %s WHERE tenant=%s", (amount,tenant))
+            cur.execute("INSERT INTO reservations (rid, tenant, amount, created_at) VALUES (%s,%s,%s,extract(epoch from now())::bigint)", (rid,tenant,amount))
+        conn.commit()
+    return jsonify({"ok":True,"reserved":amount})
+
+@app.route("/check", methods=["GET"])
+def check():
+    rid = request.args.get("id")
+    if not rid: return jsonify({"ok":False,"error":"id required"}), 400
+    with get_conn() as conn:
+        with conn.cursor() as cur:
+            cur.execute("SELECT amount FROM reservations WHERE rid=%s", (rid,))
+            row = cur.fetchone()
+            if not row: return jsonify({"ok":True,"reserved":0})
+            return jsonify({"ok":True,"reserved":row[0]})
+
+if __name__=="__main__":
+    init_db()
+    app.run(host="0.0.0.0", port=8082)
+
