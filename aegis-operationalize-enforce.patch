+#!/usr/bin/env python3
+"""
+Lightweight attestation pipeline:
+ - collects evidence artifacts (build logs, cosign signatures, validation reports)
+ - bundles them, cosign-signs the bundle using KMS key reference (via cosign CLI), uploads to WORM S3 bucket
+ - writes metadata (retention, legal tags) as object metadata
+"""
+import os, tempfile, json, subprocess
+from datetime import datetime
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def bundle_and_sign(paths, out_prefix="attestation"):
+    tmp = tempfile.mkdtemp()
+    bundle = os.path.join(tmp, f"{out_prefix}-{int(__import__('time').time())}.tar.gz")
+    subprocess.check_call(["tar","-czf",bundle] + paths)
+    # sign bundle (cosign KMS)
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, bundle])
+    return bundle
+
+def upload(bundle, key_prefix="attestations", retention_days=3650):
+    if not EVIDENCE_BUCKET:
+        print("No EVIDENCE_BUCKET configured; skipping upload")
+        return None
+    key = f"{key_prefix}/{os.path.basename(bundle)}"
+    subprocess.check_call(["aws","s3","cp", bundle, f"{EVIDENCE_BUCKET}/{key}", "--metadata", f"retention-days={retention_days}"])
+    return f"{EVIDENCE_BUCKET}/{key}"
+
+def main():
+    # discover local artifacts (placeholders)
+    artifacts = []
+    for p in ["./build.log","./watermark_validation.csv","./moderation_eval.json"]:
+        if os.path.exists(p):
+            artifacts.append(p)
+    if not artifacts:
+        print("No artifacts found; create the expected artifacts first")
+        return
+    b = bundle_and_sign(artifacts, out_prefix="aegis-attestation")
+    uri = upload(b)
+    print("Uploaded attestation bundle to:", uri)
+
+if __name__=="__main__":
+    main()
+
