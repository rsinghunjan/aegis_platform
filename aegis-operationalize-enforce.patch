+#!/usr/bin/env python3
+"""
+Collect Kubernetes audit logs (assumes audit logs are available in /var/log/kubernetes/audit.log or via API),
+compute a SHA256 manifest, and upload to evidence bucket with object-lock metadata.
+"""
+import os, hashlib, subprocess, tempfile
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+
+def sha256_file(path):
+    h = hashlib.sha256()
+    with open(path,"rb") as f:
+        for chunk in iter(lambda: f.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+def main():
+    src = "/var/log/kubernetes/audit.log"
+    if not os.path.exists(src):
+        print("Audit log not found at /var/log/kubernetes/audit.log; operator must provide path")
+        return
+    h = sha256_file(src)
+    print("SHA256:", h)
+    if not EVIDENCE_BUCKET:
+        print("No EVIDENCE_BUCKET configured; not uploading")
+        return
+    key = f"audit/audit-{int(__import__('time').time())}.log"
+    subprocess.check_call(["aws","s3","cp", src, f"{EVIDENCE_BUCKET}/{key}", "--metadata", f"sha256={h}"])
+    print("Uploaded audit log to", f"{EVIDENCE_BUCKET}/{key}")
+
+if __name__=="__main__":
+    main()
+
