+#!/usr/bin/env python3
+"""
+Helpers for constructing labeled moderation datasets (JSONL) and sampling by language.
+"""
+import json, langdetect
+from collections import defaultdict
+
+def sample_by_language(input_jsonl, out_prefix, per_lang=1000):
+    counts = defaultdict(int)
+    out_files = {}
+    with open(input_jsonl) as f:
+        for line in f:
+            obj = json.loads(line)
+            text = obj.get("text","")
+            try:
+                lang = langdetect.detect(text)
+            except Exception:
+                lang = "en"
+            if counts[lang] < per_lang:
+                if lang not in out_files:
+                    out_files[lang] = open(f"{out_prefix}.{lang}.jsonl","w")
+                out_files[lang].write(json.dumps(obj)+"\n")
+                counts[lang]+=1
+    for fh in out_files.values():
+        fh.close()
+    return counts
+
+if __name__=="__main__":
+    import argparse
+    p=argparse.ArgumentParser(); p.add_argument("--in"); p.add_argument("--out"); p.add_argument("--per", type=int, default=1000)
+    args=p.parse_args(); print(sample_by_language(args.in, args.out, args.per))
