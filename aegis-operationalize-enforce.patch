+name: Sign built container images with Cosign (KMS)
+on:
+  workflow_dispatch:
+jobs:
+  sign:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Setup cosign
+        run: |
+          curl -sSfL https://github.com/sigstore/cosign/releases/download/v2.1.0/cosign-linux-amd64 -o cosign
+          chmod +x cosign
+          sudo mv cosign /usr/local/bin/cosign
+      - name: Sign image using KMS key reference
+        env:
+          IMAGE_REF: ${{ inputs.image_ref || secrets.IMAGE_REF }}
+          COSIGN_KEY_REF: ${{ secrets.COSIGN_KEY_REF }}
+        run: |
+          if [ -z "$IMAGE_REF" ] || [ -z "$COSIGN_KEY_REF" ]; then echo "Set IMAGE_REF and COSIGN_KEY_REF"; exit 1; fi
+          cosign sign --key "$COSIGN_KEY_REF" "$IMAGE_REF"
+      - name: Verify signature
+        env:
+          IMAGE_REF: ${{ inputs.image_ref || secrets.IMAGE_REF }}
+        run: |
+          cosign verify --key <(cosign public-key --key "${{ secrets.COSIGN_KEY_REF }}" | sed -n '1,$p') "$IMAGE_REF" || true
