+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate cosign key reference used by the cluster webhook and CI (update K8s secrets).
+# Usage: rotate_cosign_ref.sh --new-key-ref "gcpkms://..."
+
+NEW_REF=""
+KUBECTL=${KUBECTL:-kubectl}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --new-key-ref) NEW_REF="$2"; shift 2;;
+    --kubeconfig) KUBECTL="$2"; shift 2;;
+    *) echo "Unknown arg $1"; exit 2;;
+  esac
+done
+
+if [ -z "$NEW_REF" ]; then echo "Provide --new-key-ref"; exit 2; fi
+TMPDIR=$(mktemp -d)
+PUBKEY="$TMPDIR/pubkey.pem"
+cosign public-key --key "$NEW_REF" > "$PUBKEY"
+kubectl delete secret aegis-cosign-pubkey -n ml-serving --ignore-not-found
+kubectl create secret generic aegis-cosign-pubkey -n ml-serving --from-file=pubkey.pem="$PUBKEY"
+echo "Updated aegis-cosign-pubkey secret in ml-serving. Restart webhook pods to pick up new key."
+
