+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create an S3 bucket with Object Lock (WORM) enabled for evidence retention.
+# WARNING: Bucket-level ObjectLock must be set at creation and cannot be disabled later.
+#
+if [ $# -lt 2 ]; then
+  echo "Usage: $0 <bucket-name> <region>"
+  exit 2
+fi
+BUCKET=$1; REGION=$2
+aws s3api create-bucket --bucket "$BUCKET" --region "$REGION" --create-bucket-configuration LocationConstraint="$REGION"
+aws s3api put-object-lock-configuration --bucket "$BUCKET" --object-lock-configuration '{
+  "ObjectLockEnabled": "Enabled",
+  "Rule": {"DefaultRetention": {"Mode": "GOVERNANCE", "Days": 3650}}
+}'
+echo "Created bucket $BUCKET with Object Lock (GOVERNANCE, 10 years). Ensure your AWS account allows this and that you understand legal implications."
+
