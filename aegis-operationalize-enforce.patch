+-- Envoy/Lua filter sample (call this from gateway to enforce quota)
+-- expects AEGIS_QUOTA_URL env var or configured upstream cluster
+local http = require "resty.http"
+local cjson = require "cjson"
+local function must_reserve(id, tenant, amount)
+  local qurl = os.getenv("AEGIS_QUOTA_URL") or "http://aegis-quota.ml-serving.svc:8082/reserve"
+  local client = http.new()
+  local res, err = client:request_uri(qurl, {
+    method = "POST",
+    body = cjson.encode({id=id, tenant=tenant, amount=amount}),
+    headers = { ["Content-Type"] = "application/json" },
+    keepalive_timeout = 60,
+  })
+  if not res then
+    ngx.log(ngx.ERR, "quota call failed: ", err)
+    return false, "quota-service-unavailable"
+  end
+  if res.status == 200 then
+    local j = cjson.decode(res.body)
+    if j.ok then return true end
+    return false, j.error
+  else
+    return false, "quota-service-error"
+  end
+end
+
