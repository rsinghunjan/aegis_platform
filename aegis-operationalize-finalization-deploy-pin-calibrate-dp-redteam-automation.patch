+"""
+DP enforcer helper: ensure dp charge succeeds before allowing model outputs.
+Use in triton_gateway handler: if ENABLE_DP_FAIL_CLOSED true, block responses on DP failures.
+"""
+import os, requests, logging
+
+DP_SERVICE = os.environ.get("DP_SERVICE_URL", "http://dp-service:8084")
+DP_AUTH = os.environ.get("DP_AUTH_TOKEN", "")
+ENABLE_FAIL_CLOSED = os.environ.get("ENABLE_DP_FAIL_CLOSED", "true").lower() == "true"
+LOG = logging.getLogger("aegis.dp.enforcer")
+
+def charge_and_enforce(client_id: str, eps: float) -> bool:
+    """
+    Charge DP service; return True if allowed to proceed; False means block.
+    """
+    if not client_id:
+        LOG.warning("No client_id provided for DP charge; failing closed.")
+        return False if ENABLE_FAIL_CLOSED else True
+    try:
+        headers = {"Authorization": f"Bearer {DP_AUTH}"} if DP_AUTH else {}
+        r = requests.post(f"{DP_SERVICE}/charge", json={"client": client_id, "eps": eps}, headers=headers, timeout=3)
+        if r.status_code == 200:
+            return True
+        LOG.error("DP charge returned non-200: %s %s", r.status_code, r.text)
+        return False if ENABLE_FAIL_CLOSED else True
+    except Exception:
+        LOG.exception("DP charge failed")
+        return False if ENABLE_FAIL_CLOSED else True
+
