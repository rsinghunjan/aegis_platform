+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Builder rollout manager
+# - Bootstraps builder hardening on new hosts, verifies cosign & rekor tooling, enforces labeling and test-sign pipeline.
+# - Intended to be run by Infra Operator when onboarding builders.
+#
+# Usage:
+#   ./builder_rollout_manager.sh --hosts "builder1,builder2" --labels "role=builder,npu=true"
+
+HOSTS=${1:-}
+LABELS=${LABELS:-"role=builder"}
+if [ -z "$HOSTS" ]; then
+  echo "Usage: $0 --hosts builder1,builder2"
+  exit 1
+fi
+IFS=',' read -r -a hosts <<< "$HOSTS"
+
+for h in "${hosts[@]}"; do
+  echo "Onboarding builder: $h"
+  # best-effort: copy or run remote provisioning scripts (operator must ensure SSH access)
+  scp ops/infra/hardening/provision_and_label_runners.sh "$h":/tmp/
+  ssh "$h" "sudo bash /tmp/provision_and_label_runners.sh LABELS=\"$LABELS\""
+  # test cosign & rekor presence
+  ssh "$h" "which cosign || true; which rekor-cli || true"
+  # run builder smoke: build minimal artifact and sign (operator must supply builder CI script)
+  echo "Request builder to run smoke build and produce cosign+rekor evidence"
+done
