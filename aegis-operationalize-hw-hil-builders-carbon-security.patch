+#!/usr/bin/env python3
+"""
+HIL + formal closure runner
+ - Run exhaustive HIL campaigns, run Apalache triage, collect counterexamples, produce signed HIL cert bundles.
+ - Stops and requests operator triage if problems encountered.
+"""
+import argparse, os, subprocess, json
+from datetime import datetime
+
+def record_manifest_safe(k,m):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest(k,m)
+    except Exception:
+        pass
+
+def run_campaign(scenarios_file, golden, outdir):
+    cmd = ["python3","ops/robotics/control/certified/hil_campaign_manager.py","--golden",golden,"--out",outdir]
+    with open(scenarios_file) as fh:
+        for l in fh:
+            s=l.strip()
+            if s:
+                cmd += ["--scenarios", s]
+    return subprocess.call(cmd)
+
+def run_apalache(outdir):
+    return subprocess.call(["./ops/formal/apalache_triage_runner.sh", outdir])
+
+def package_and_sign(outdir, cosign_key=None):
+    bundle = outdir.rstrip("/") + "_hil_cert_bundle.tar.gz"
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception:
+            pass
+    return bundle
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--scenarios-file", required=True)
+    p.add_argument("--golden", required=True)
+    p.add_argument("--out", default=f"/tmp/hil_closure_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--cosign", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--cert-upload", default="")
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    rc = run_campaign(args.scenarios_file, args.golden, args.out)
+    if rc != 0:
+        print("HIL campaign returned non-zero; operator triage needed.")
+        record_manifest_safe("hil_campaign_failed", {"out": args.out})
+        raise SystemExit(2)
+    ap_rc = run_apalache(args.out)
+    if ap_rc != 0:
+        print("Apalache reported issues; operator must triage counterexamples.")
+        record_manifest_safe("apalache_issues", {"out": args.out})
+        raise SystemExit(3)
+    bundle = package_and_sign(args.out, cosign_key=args.cosign)
+    record_manifest_safe("hil_cert_bundle", {"bundle": bundle})
+    if args.cert_upload:
+        try:
+            import requests
+            resp = requests.post(args.cert_upload, files={"file": open(bundle,"rb")}, timeout=120)
+            record_manifest_safe("certifier_upload", {"status": resp.status_code})
+        except Exception as e:
+            print("Certifier upload failed:", e)
+    print("HIL + formal closure complete. Bundle:", bundle)
+
