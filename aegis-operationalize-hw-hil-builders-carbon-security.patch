+#!/usr/bin/env python3
+"""
+Run hardware validation pipeline
+ - Run RT sweeps for a set of targets, validate p99 & safe-stop SLOs, sign and upload proof bundles
+ - Emits remediation suggestions and records evidence via ops.sdk.evidence_sdk.record_manifest
+
+Usage:
+  python3 run_hw_validation_pipeline.py --targets "ecu1:can0,ecu2:can0" --out /tmp/hw_run --cosign kms://... --s3 s3://...
+"""
+import argparse, os, subprocess, json
+from datetime import datetime
+
+def run_target(target, outdir, cosign_key=None, s3=None):
+    os.makedirs(outdir, exist_ok=True)
+    env = os.environ.copy()
+    env["TARGETS"] = target
+    if cosign_key:
+        env["COSIGN_KMS_URI"] = cosign_key
+    if s3:
+        env["S3_UPLOAD"] = s3
+    cmd = ["./ops/av/rt/run_hw_rt_sweep.sh", outdir]
+    print("Running RT sweep:", target, "->", outdir)
+    try:
+        subprocess.check_call(cmd, env=env)
+    except subprocess.CalledProcessError as e:
+        print("RT sweep failed:", e)
+    proof = os.path.join(outdir, "rt_slo_proof.json")
+    return proof if os.path.exists(proof) else None
+
+def validate(proof_path, p99_thresh, safe_thresh):
+    if not proof_path or not os.path.exists(proof_path):
+        return False, ["proof_missing"]
+    with open(proof_path) as fh:
+        j = json.load(fh)
+    issues = []
+    p99 = j.get("p99_ms")
+    safe = j.get("safe_ms")
+    if p99 is None:
+        issues.append("p99_missing")
+    elif p99 > p99_thresh:
+        issues.append(f"p99_too_high:{p99}>{p99_thresh}")
+    if safe is None:
+        issues.append("safe_missing")
+    elif safe > safe_thresh:
+        issues.append(f"safe_too_high:{safe}>{safe_thresh}")
+    return len(issues)==0, issues
+
+def remediate(proof_path, out_remed):
+    try:
+        subprocess.check_call(["python3","ops/validation/rt_remediation_agent.py","--report",proof_path,"--out",out_remed])
+        return True
+    except Exception:
+        with open(out_remed,"w") as fh:
+            json.dump({"note":"remediation_agent_failed"}, fh)
+        return False
+
+def sign_and_upload(bundle, cosign_key=None, s3=None):
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception as e:
+            print("cosign sign failed (best-effort):", e)
+    if s3:
+        try:
+            subprocess.check_call(["aws","s3","cp",bundle,s3])
+        except Exception as e:
+            print("s3 upload failed (best-effort):", e)
+
+def record_manifest(key, meta):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest(key, meta)
+    except Exception as e:
+        print("record_manifest failed (best-effort):", e)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--targets", required=True, help="comma-separated host:iface entries")
+    p.add_argument("--out", default=f"/tmp/hw_validation_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--cosign", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    p.add_argument("--p99-threshold", type=float, default=0.5)
+    p.add_argument("--safe-threshold-ms", type=float, default=50.0)
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    targets = [t.strip() for t in args.targets.split(",") if t.strip()]
+    summary = {"started_at": datetime.utcnow().isoformat()+"Z", "results": []}
+    for t in targets:
+        tid = t.replace(":","_")
+        od = os.path.join(args.out, tid)
+        proof = run_target(t, od, cosign_key=args.cosign, s3=args.s3)
+        ok, issues = validate(proof, args.p99_threshold, args.safe_threshold_ms)
+        rem_out = os.path.join(od,"remediation.json")
+        if not ok:
+            remediate(proof or "", rem_out)
+        # package target artifacts
+        bundle = os.path.join(args.out, f"{tid}_proof_bundle.tar.gz")
+        try:
+            subprocess.check_call(["tar","-czf",bundle,"-C",od,"."])
+        except Exception:
+            pass
+        sign_and_upload(bundle, cosign_key=args.cosign, s3=(args.s3.rstrip("/") + f"/{os.path.basename(bundle)}" if args.s3 else None))
+        summary["results"].append({"target": t, "proof": proof, "ok": ok, "issues": issues, "bundle": bundle})
+        record_manifest("hw_proof_target", {"target": t, "bundle": bundle})
+    summary_path = os.path.join(args.out,"summary.json")
+    with open(summary_path,"w") as fh:
+        json.dump(summary, fh, indent=2)
+    record_manifest("hw_proof_summary", {"summary": summary_path})
+    print("Hardware validation finished. Summary:", summary_path)
+
+if __name__=="__main__":
+    main()
+
