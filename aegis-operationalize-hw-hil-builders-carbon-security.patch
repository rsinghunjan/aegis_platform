+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Lightweight vulnerability scan runner (best-effort)
+# - Runs container image scan (trivy) and basic host checks
+#
+IMG=${1:-}
+OUT=${2:-/tmp/vuln_scan_$(date +%s).json}
+
+if ! command -v trivy >/dev/null 2>&1; then
+  echo "trivy not installed; install trivy on host or CI runner"
+  exit 2
+fi
+
+if [ -n "$IMG" ]; then
+  echo "Scanning image: $IMG"
+  trivy image --format json -o "$OUT" "$IMG"
+else
+  echo "No image provided; scanning host (root filesystem) - best effort"
+  trivy filesystem --format json -o "$OUT" /
+fi
+
+echo "Vulnerability scan written to $OUT"
+python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("vuln_scan", {"path":"$OUT"})
+print("recorded vuln_scan manifest")
+PY
