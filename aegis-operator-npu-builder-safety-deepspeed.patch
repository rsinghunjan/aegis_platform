+#!/usr/bin/env python3
+"""
+Evaluation harness for the output safety ensemble.
+ - Input: ndjson file with {"output": "...", "label": "allow|block|approval"}
+ - Produces a small metrics JSON and records to MLflow and evidence SDK.
+"""
+import argparse, json, os, csv
+from ops.agents.safety.ensemble_scorer import ensemble_score
+try:
+    import mlflow
+except Exception:
+    mlflow = None
+from ops.sdk.evidence_sdk import record_manifest
+
+def evaluate(inpath, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    tp = tn = fp = fn = 0
+    total = 0
+    with open(inpath) as fh:
+        for line in fh:
+            j = json.loads(line)
+            out = j["output"]
+            label = j.get("label","allow")
+            res = ensemble_score(out, j.get("context",{}))
+            pred = res["action"]
+            total += 1
+            if pred == "allow" and label == "allow":
+                tp += 1
+            if pred == "block" and label == "block":
+                tn += 1
+            if pred == "block" and label != "block":
+                fp += 1
+            if pred != "block" and label == "block":
+                fn += 1
+    metrics = {"total": total, "tp": tp, "tn": tn, "fp": fp, "fn": fn}
+    with open(os.path.join(outdir,"ensemble_eval.json"), "w") as fh:
+        json.dump(metrics, fh, indent=2)
+    if mlflow:
+        mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+        with mlflow.start_run(run_name="ensemble_eval"):
+            mlflow.log_artifact(os.path.join(outdir,"ensemble_eval.json"))
+    record_manifest("ensemble_eval", {"out": outdir})
+    print("Eval metrics:", metrics)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", required=True, dest="inpath")
+    p.add_argument("--outdir", default="/tmp/ensemble_eval")
+    args = p.parse_args()
+    evaluate(args.inpath, args.outdir)
+
