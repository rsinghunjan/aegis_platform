+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simulate preemption of a training pod: create a job, wait, then send TERM to container (requires privileged kubectl access).
+# This script is a test harness to validate preemption handlers and resume behavior.
+JOB_NAME=aegis-deepspeed-test
+kubectl apply -f ops/dl/production/deepspeed_deploy/deepspeed_job.yaml || true
+echo "Waiting 30s for pod to start..."
+sleep 30
+POD=$(kubectl get pods --selector=job-name=aegis-deepspeed-pretrain -o jsonpath='{.items[0].metadata.name}')
+echo "Found pod: $POD"
+echo "Simulate preemption by sending KILL to the main container (graceful TERM)"
+kubectl exec -it "$POD" -- bash -lc "kill -SIGTERM 1" || true
+echo "Wait 10s then check for checkpoint upload evidence"
+sleep 10
+kubectl logs "$POD" || true
+
