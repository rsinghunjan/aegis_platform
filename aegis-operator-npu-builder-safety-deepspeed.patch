+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One‑shot operator script to:
+#  - run vendor NPU smoke/compile tests on the local host (Inferentia/Graphcore/Habana)
+#  - run iterative RT validator to meet p99/safe-stop SLOs
+#  - run formal packaging (Apalache/TLA+) and collect outputs
+#  - package, cosign (KMS) and optionally upload the auditor bundle to S3
+#  - record an evidence manifest via ops/sdk/evidence_sdk.record_manifest
+#
+# Usage:
+#   COSIGN_KMS_URI=kms://... S3_UPLOAD=s3://bucket/path ./ops/operator/run_full_validation_and_package.sh --node robot-host --out /tmp/aegis_audit
+
+NODE="localhost"
+OUT_BASE=${OUT:-/tmp/aegis_audit_$(date +%s)}
+MAX_RT_ATTEMPTS=3
+S3_UPLOAD=${S3_UPLOAD:-""}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --node) NODE="$2"; shift 2;;
+    --out) OUT_BASE="$2"; shift 2;;
+    --attempts) MAX_RT_ATTEMPTS="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+mkdir -p "$OUT_BASE"
+echo "Operator audit run starting: node=$NODE out=$OUT_BASE"
+
+echo "1) Run NPU vendor smoke tests (best-effort)."
+# Inferentia
+if command -v neuron-ls >/dev/null 2>&1; then
+  echo "- Running Inferentia smoke"
+  ./ops/hw/validation/inferentia_compile_run.sh ops/dl/inference/test_models/tiny_model.onnx || true
+  cp /tmp/inferentia_*.json "$OUT_BASE/" 2>/dev/null || true
+fi
+# Graphcore
+if python3 -c "import os,sys; sys.exit(0)" 2>/dev/null; then
+  echo "- Running Graphcore smoke"
+  python3 ops/hw/validation/graphcore_compile_run.py ops/dl/inference/test_models/tiny_model.onnx || true
+  cp /tmp/graphcore_smoke.json "$OUT_BASE/" 2>/dev/null || true
+fi
+# Habana
+echo "- Running Habana smoke (best-effort)"
+python3 ops/hw/validation/habana_compile_run.py ops/dl/inference/test_models/tiny_model.onnx || true
+cp /tmp/habana_smoke.json "$OUT_BASE/" 2>/dev/null || true
+
+echo "2) Run iterative RT validator (attempts=$MAX_RT_ATTEMPTS)"
+./ops/robotics/rt/lab_validation/iterative_rt_validator.sh "$NODE" "${OUT_BASE}/rt" || true
+cp "${OUT_BASE}/rt"* "${OUT_BASE}/" 2>/dev/null || true
+
+echo "3) Run formal reviewer packaging (Apalache runs & package)"
+./ops/formal/formal_reviewer_package.sh "${OUT_BASE}/formal" || true
+
+echo "4) Collect logs & artifacts (best-effort)"
+# copy common artifacts (if present)
+for f in /tmp/rt_jitter_result.json /tmp/safe_stop.json /tmp/rt_slo_report.json; do
+  [ -f "$f" ] && cp "$f" "$OUT_BASE/" || true
+done
+
+echo "5) Package auditor bundle"
+BUNDLE="${OUT_BASE}.tar.gz"
+tar -czf "$BUNDLE" -C "$(dirname "$OUT_BASE")" "$(basename "$OUT_BASE")"
+echo "Bundle created: $BUNDLE"
+
+if [ -n "$COSIGN_KMS_URI" ]; then
+  echo "6) Sign bundle with cosign (KMS)"
+  COSIGN_EXE=${COSIGN_EXE:-cosign}
+  $COSIGN_EXE sign --key "$COSIGN_KMS_URI" "$BUNDLE" || true
+fi
+
+if [ -n "$S3_UPLOAD" ]; then
+  echo "7) Uploading bundle to $S3_UPLOAD"
+  aws s3 cp "$BUNDLE" "${S3_UPLOAD}" || true
+fi
+
+echo "8) Record evidence manifest"
+python3 - <<PY || true
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("operator_full_audit_run", {"bundle":"$BUNDLE", "node":"$NODE"})
+print("Manifest recorded")
+PY
+
+echo "Operator audit run completed. Bundle: $BUNDLE"
+
