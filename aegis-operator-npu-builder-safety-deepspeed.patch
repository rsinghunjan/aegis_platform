+"""
+Ensemble scorer for model outputs.
+ - Runs multiple lightweight detectors (toxicity heuristic, hallucination heuristic, offensive-word list)
+ - Aggregates scores to produce risk and suggested action
+ - Plug-in points exist for real classifiers (toxicity model, fact-checker, NLI, semantic similarity)
+"""
+from typing import Dict, List
+import re
+
+OFFENSIVE = {"bomb","kill","poison","terror"}
+
+def toxicity_heuristic(text: str) -> float:
+    # naive heuristic: presence of extreme words
+    t = text.lower()
+    score = 0.0
+    if any(w in t for w in ["kill","bomb","murder","attack"]):
+        score += 0.8
+    if "suicide" in t:
+        score += 0.6
+    return min(score, 1.0)
+
+def hallucination_heuristic(text: str, context: Dict) -> float:
+    # naive: statements with "according to" but no sources -> potential hallucination
+    t = text.lower()
+    score = 0.0
+    if "according to" in t and not context.get("sources"):
+        score += 0.4
+    # numeric claims with no source
+    if re.search(r"\d{3,}", t) and not context.get("sources"):
+        score += 0.2
+    return min(score, 1.0)
+
+def offensive_list(text: str) -> float:
+    t = text.lower()
+    for w in OFFENSIVE:
+        if w in t:
+            return 0.9
+    return 0.0
+
+def ensemble_score(text: str, context: Dict=None) -> Dict:
+    context = context or {}
+    scores = {}
+    scores["toxicity"] = toxicity_heuristic(text)
+    scores["hallucination"] = hallucination_heuristic(text, context)
+    scores["offensive"] = offensive_list(text)
+    # simple aggregation: max of components
+    risk = max(scores.values())
+    action = "allow"
+    if risk >= 0.8:
+        action = "block"
+    elif risk >= 0.2:
+        action = "require_approval"
+    return {"risk": risk, "action": action, "scores": scores}
+
+if __name__ == "__main__":
+    print(ensemble_score("According to sources, there will be 123000 casualties", {}))
+
