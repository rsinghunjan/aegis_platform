+#!/usr/bin/env bash
+set -euo pipefail
+MCP_API="${MCP_API:-${MCP_API}}"
+KAFKA_BOOTSTRAP="${KAFKA_BOOTSTRAP:-}"
+
+echo "MCP API check..."
+if [ -n "$MCP_API" ]; then
+  if curl -fsS "${MCP_API}/models" >/dev/null; then
+    echo "MCP API reachable"
+  else
+    echo "MCP API unreachable" >&2
+    exit 2
+  fi
+else
+  echo "MCP_API not configured; skip"
+fi
+
+if [ -n "$KAFKA_BOOTSTRAP" ]; then
+  echo "Kafka bootstrap configured: $KAFKA_BOOTSTRAP"
+  if command -v kafka-topics >/dev/null 2>&1; then
+    kafka-topics --bootstrap-server "$KAFKA_BOOTSTRAP" --list | grep aegis-a2a || echo "a2a topics missing"
+  else
+    echo "No kafka-topics tool in PATH; skip listing topics"
+  fi
+else
+  echo "KAFKA_BOOTSTRAP not set; skip Kafka checks"
+fi
+
+echo "A2A/MCP health check complete"
+
