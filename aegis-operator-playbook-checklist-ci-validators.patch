+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click operator playbook (idempotent-ish) to provision Option A surfaces, deploy core services,
+# wire GitHub secrets, deploy MCP/A2A/n8n, and run validation checks.
+#
+# Usage:
+#   CLOUD=aws REPO=owner/repo ./ops/playbooks/operator_one_click.sh
+#   CLOUD=gcp REPO=owner/repo ./ops/playbooks/operator_one_click.sh
+#   CLOUD=azure REPO=owner/repo ./ops/playbooks/operator_one_click.sh
+#
+# Prereqs: terraform, helm, kubectl, gh, vault (CLI), jq installed and authenticated.
+
+REPO="${REPO:-}"
+CLOUD="${CLOUD:-aws}"
+set -x
+
+if [ -z "$REPO" ]; then
+  echo "REPO env required (owner/repo)"; exit 2
+fi
+
+case "$CLOUD" in
+  aws)
+    dir="terraform/aws"
+    ;;
+  gcp)
+    dir="terraform/gcp"
+    ;;
+  azure)
+    dir="terraform/azure"
+    ;;
+  *)
+    echo "Unsupported cloud $CLOUD"; exit 3
+    ;;
+esac
+
+echo "1) Terraform apply for $CLOUD (review plan output if desired)"
+(cd "$dir" && terraform init && terraform apply -auto-approve)
+
+echo "2) Capture cosign KMS ARN & Rekor endpoint (cloud-specific outputs)"
+COSIGN_KEY=$(cd "$dir" && terraform output -raw | sed -n 's/.*cosign.*arn[^[:alnum:]]*\(arn:[^ ]*\).*/\1/p' || true)
+REKOR_EP=$(cd "$dir" && terraform output -raw | sed -n 's/.*rekor.*http[^ ]*/&/p' || true)
+echo "COSIGN_KEY: ${COSIGN_KEY:-<not-found>}"
+echo "REKOR_SERVER: ${REKOR_EP:-<not-found>}"
+
+echo "3) Wire GitHub secrets (COSIGN_KEY, REKOR_SERVER, MCP_API placeholder)"
+if command -v gh >/dev/null 2>&1; then
+  if [ -n "$COSIGN_KEY" ]; then gh secret set COSIGN_KEY --repo "$REPO" --body "$COSIGN_KEY"; fi
+  if [ -n "$REKOR_EP" ]; then gh secret set REKOR_SERVER --repo "$REPO" --body "$REKOR_EP"; fi
+  # MCP_API should point to the eventual MCP service URL (set after deploy)
+else
+  echo "gh CLI not found; skip GitHub secret wiring. Run ops/ci/set_github_secrets_allclouds.sh manually."
+fi
+
+echo "4) Deploy Rekor Helm (k8s preferred) and Vault + ExternalSecrets + n8n + MCP + A2A consumer"
+echo "   Ensure you have current KUBECONFIG pointing to the target cluster."
+
+# Rekor (Helm) - if using Helm chart included
+helm upgrade --install rekor helm/rekor -f helm/rekor/values.yaml --namespace aegis-system --create-namespace || true
+
+# Vault HA
+helm upgrade --install vault hashicorp/vault -f ops/vault/vault-ha-values.yaml --namespace vault --create-namespace || true
+
+# ExternalSecrets (assumes ExternalSecrets operator is installed)
+kubectl apply -f k8s/external-secrets/secretstore-vault.yaml || true
+kubectl apply -f k8s/external-secrets/externalsecret-cosign.yaml || true
+
+# Deploy n8n (helm chart location: helm/n8n)
+helm upgrade --install n8n helm/n8n -f helm/n8n/values.yaml --namespace aegis-ops --create-namespace || true
+kubectl apply -f k8s/n8n/external-secret-n8n.yaml || true
+
+# Deploy MCP service (simple file-based stub containerization expected)
+kubectl -n aegis-system create configmap mcp-server --from-file=mcp/server/main.py --dry-run=client -o yaml | kubectl apply -f - || true
+# NOTE: In production, build and deploy container image for MCP; this is a placeholder to show configmap existence.
+
+# Deploy A2A Strimzi topics if Strimzi exists
+kubectl apply -f a2a/strimzi/topics.yaml || true
+
+echo "5) Deploy approver consumer (containerize a2a/consumer/approver_consumer.py and create deployment) - manual step"
+echo "   See a2a/consumer/approver_consumer.py for code. You can build container and deploy as a k8s Deployment pointing at approver Postgres DSN."
+
+echo "6) Run validation checks"
+./ops/validation/readiness_check.py || true
+
+echo "7) Run test sign + rekor workflow (manually trigger in GitHub Actions) OR run local test:"
+echo "   echo test > /tmp/test.bin; cosign sign-blob --key \"${COSIGN_KEY}\" /tmp/test.bin"
+echo "   rekor-cli search --rekor_server \"${REKOR_EP}\" --sha $(sha256sum /tmp/test.bin | awk '{print $1}')"
+
+echo "Operator one-click finished (some steps require manual review/credentials). Review the docs/runbooks/operator_checklist.md for verification steps."
+
