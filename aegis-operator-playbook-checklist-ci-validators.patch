+    - name: Deploy Rekor Helm
+      shell: helm upgrade --install rekor helm/rekor -f helm/rekor/values.yaml --namespace aegis-system --create-namespace
+
+    - name: Deploy Vault HA
+      shell: helm upgrade --install vault hashicorp/vault -f ops/vault/vault-ha-values.yaml --namespace vault --create-namespace
+
+    - name: Deploy n8n
+      shell: helm upgrade --install n8n helm/n8n -f helm/n8n/values.yaml --namespace aegis-ops --create-namespace
+
+    - name: Apply ExternalSecrets for cosign
+      shell: kubectl apply -f k8s/external-secrets/externalsecret-cosign.yaml
+
+    - name: Run readiness check and collect report
+      shell: ./ops/validation/readiness_check.py
+      register: readiness
+      ignore_errors: true
+
+    - name: Upload readiness report artifact (local)
