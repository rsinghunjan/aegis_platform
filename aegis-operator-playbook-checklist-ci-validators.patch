+        content: "{{ readiness.stdout }}"
+        dest: ./readiness_report_from_ansible.txt
+
+    - name: Final pause - operator verification before ending playbook
+      pause:
+        prompt: "Review readiness report: ./readiness_report_from_ansible.txt. Type 'done' to finish"
