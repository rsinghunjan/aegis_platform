+#!/usr/bin/env python3
+"""
+Load test harness for Triton/vLLM endpoints.
+ - Sends concurrent requests to a generation endpoint and measures latency / throughput / batch sizes.
+ - Useful to tune warm-pool size and batching windows.
+
+Usage:
+  python3 services/tests/triton_vllm_loadtest.py --url http://triton:8000/infer --concurrency 8 --requests 1000 --payload '{"input":"hello"}'
+"""
+import argparse, time, threading, requests, statistics, json, queue
+
+results_q = queue.Queue()
+
+def worker(url, payload, iters, delay):
+    sess = requests.Session()
+    for i in range(iters):
+        start = time.time()
+        try:
+            r = sess.post(url, json=payload, timeout=60)
+            lat = time.time() - start
+            status = r.status_code
+            results_q.put((lat, status))
+        except Exception as e:
+            results_q.put((None, str(e)))
+        if delay:
+            time.sleep(delay)
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--url", required=True)
+    p.add_argument("--payload", default='{"input":"hello"}')
+    p.add_argument("--concurrency", type=int, default=8)
+    p.add_argument("--requests", type=int, default=1000)
+    p.add_argument("--delay", type=float, default=0.0, help="delay between requests per thread")
+    args=p.parse_args()
+    payload = json.loads(args.payload)
+    per_thread = max(1, args.requests // args.concurrency)
+    threads=[]
+    start_all=time.time()
+    for i in range(args.concurrency):
+        t=threading.Thread(target=worker, args=(args.url, payload, per_thread, args.delay))
+        t.start()
+        threads.append(t)
+    for t in threads:
+        t.join()
+    latencies=[]
+    errors=[]
+    statuses={}
+    while not results_q.empty():
+        lat, status = results_q.get()
+        if lat is None:
+            errors.append(status)
+        else:
+            latencies.append(lat)
+            statuses[status]=statuses.get(status,0)+1
+    end_all=time.time()
+    total = len(latencies) + len(errors)
+    print("Requests:", total, "Success:", len(latencies), "Errors:", len(errors))
+    if latencies:
+        print("Latency ms: p50:", statistics.median(latencies)*1000,
+              "p95:", (sorted(latencies)[int(len(latencies)*0.95)]*1000 if len(latencies)>1 else latencies[0]*1000),
+              "p99:", (sorted(latencies)[int(len(latencies)*0.99)]*1000 if len(latencies)>1 else latencies[0]*1000))
+        print("Avg latency ms:", statistics.mean(latencies)*1000)
+    if statuses:
+        print("Status codes:", statuses)
+    if errors:
+        print("Errors sample:", errors[:5])
+    print("Total time (s):", end_all - start_all)
+
+if __name__=="__main__":
+    main()
+
