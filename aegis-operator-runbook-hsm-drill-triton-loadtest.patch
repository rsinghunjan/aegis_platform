+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Hands-on operator script to guide HSM activation and run a rotation drill for AWS CloudHSM + KMS.
+# WARNING: This script performs non-destructive automation (create CMK, write Vault paths, sign sample artifacts)
+# but requires human operator presence for sensitive steps (CloudHSM initialization, auditor approvals).
+#
+# Prereqs:
+# - AWS CLI configured with operator credentials
+# - vault CLI configured (VAULT_ADDR, VAULT_TOKEN)
+# - cosign installed and operator can use cosign with AWS KMS (or local key for tests)
+# - jq, aws, cosign, vault available
+#
+# Usage:
+#   ./aws_hsm_activation_and_rotation_drill.sh <cloudhsm-cluster-id> <aws-region> <artifacts-list.txt>
+CLUSTER_ID=${1:-}
+REGION=${2:-us-west-2}
+ARTIFACT_LIST=${3:-ops/hsm/sample_resign_list.txt}
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+VAULT_KMS_PATH=${VAULT_KMS_PATH:-secret/data/aegis/kms}
+
+if [ -z "$CLUSTER_ID" ]; then
+  echo "Usage: $0 <cloudhsm-cluster-id> <region> <artifact-list>"
+  exit 2
+fi
+
+echo "Step 0: Validate environment"
+command -v aws >/dev/null || { echo "aws cli missing"; exit 2; }
+command -v cosign >/dev/null || { echo "cosign missing"; exit 2; }
+command -v vault >/dev/null || { echo "vault missing"; exit 2; }
+
+echo "Step 1: Describe CloudHSM cluster"
+aws cloudhsmv2 describe-clusters --cluster-id "$CLUSTER_ID" --region "$REGION"
+
+echo "Step 2: Ensure cluster is initialized (manual). Follow AWS docs to initialize CloudHSM cluster."
+read -p "Press ENTER after cluster initialization is complete (or Ctrl-C to abort)..."
+
+echo "Step 3: Create KMS Custom Key Store (manual via console) and create CMK in the custom key store."
+read -p "Press ENTER once you have created the KMS Custom Key Store and CMK... "
+
+read -p "Enter the created KMS CMK ARN (arn:aws:kms:...): " CMK_ARN
+if [ -z "$CMK_ARN" ]; then echo "No CMK ARN provided; aborting"; exit 3; fi
+
+echo "Recording issuance manifest via ops/hsm/issue_key_manifest.py"
+python3 ops/hsm/issue_key_manifest.py --key-ref "$CMK_ARN" --operator "$(whoami)" --notes "activation via drill"
+
+echo "Staging key ref into Vault staging: $VAULT_KMS_PATH/staging"
+vault kv put "${VAULT_KMS_PATH}/staging" cosign_key_refs="aws-kms://$CMK_ARN"
+echo "Notify auditor to review issuance manifest and approve staging entry."
+read -p "Press ENTER after auditor approves and signs (manual) ... "
+
+echo "Promote staging to active (operator confirmation)"
+vault kv put "$VAULT_KMS_PATH" cosign_key_refs="aws-kms://$CMK_ARN"
+echo "Active key refs updated in Vault: $(vault kv get -field=cosign_key_refs ${VAULT_KMS_PATH})"
+
+echo "Smoke test: sign a sample artifact using the new KMS key"
+TEST_ART=/tmp/aegis_hsm_test_$(date +%s).txt
+echo "aegis-hsm-test $(date -u)" > "$TEST_ART"
+cosign sign --key "aws-kms://$CMK_ARN" "$TEST_ART"
+cosign verify --key "aws-kms://$CMK_ARN" "$TEST_ART"
+echo "Signed & verified sample artifact"
+if [ -n "$EVIDENCE_BUCKET" ] && [[ $EVIDENCE_BUCKET == s3://* ]]; then
+  aws s3 cp "$TEST_ART" "$EVIDENCE_BUCKET/hsm-tests/$(basename $TEST_ART)"
+fi
+
+#################################
+echo "Rotation drill: create a new CMK, stage it, re-sign artifacts, retire old key"
+read -p "Press ENTER to create a new CMK (rotation) via KMS CLI (requires Custom Key Store name)..."
+read -p "Enter the Key Store id or leave blank if you will create the key manually: " CKS_ID
+if [ -n "$CKS_ID" ]; then
+  echo "Creating CMK in custom key store $CKS_ID"
+  NEW_KEY_JSON=$(aws kms create-key --customer-master-key-spec RSA_3072 --key-usage SIGN_VERIFY --origin AWS_CLOUDHSM --region "$REGION" --output json)
+  NEW_ARN=$(echo "$NEW_KEY_JSON" | jq -r '.KeyMetadata.Arn')
+  echo "Created new key: $NEW_ARN"
+else
+  read -p "Enter new CMK ARN (created manually): " NEW_ARN
+fi
+
+echo "Record issuance manifest for new key"
+python3 ops/hsm/issue_key_manifest.py --key-ref "$NEW_ARN" --operator "$(whoami)" --notes "rotation drill"
+
+echo "Stage new key into Vault staging"
+vault kv put "${VAULT_KMS_PATH}/staging" cosign_key_refs="aws-kms://$NEW_ARN"
+echo "Obtain Key Officer approval (manual). Press ENTER once approvals recorded in Vault staging..."
+read -p "Press ENTER to continue and promote new key to active..."
+vault kv put "${VAULT_KMS_PATH}" cosign_key_refs="aws-kms://$NEW_ARN"
+
+echo "Now re-sign listed artifacts with new key. Artifact list: $ARTIFACT_LIST"
+if [ ! -f "$ARTIFACT_LIST" ]; then
+  echo "Artifact list missing; create file with one URI per line"; exit 3
+fi
+
+python3 ops/hsm/rotate_keys_prod.sh "$ARTIFACT_LIST"
+
+echo "Verify sample artifact with new key"
+cosign verify --key "aws-kms://$NEW_ARN" "$TEST_ART" || echo "Verification with new key failed; check re-signing process"
+
+echo "Retire old key: (manual step) remove CMK from rotation and update Vault to remove old ARN"
+echo "If retiring via KMS schedule key deletion, follow KMS deletion policies. Record retirement in ops/hsm/audit_rotation_log.py"
+echo "Rotation drill complete."
+
