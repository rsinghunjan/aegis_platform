+#!/usr/bin/env python3
+"""
+Utility to re-sign a list of artifacts with the new cosign key and verify signatures.
+Intended to be called by ops/hsm/aws_hsm_activation_and_rotation_drill.sh as part of rotation.
+
+Usage:
+  python3 ops/hsm/rotate_and_resign.py --artifact-list artifacts.txt --new-key aws-kms://arn:...
+
+Notes:
+ - Requires cosign binary able to sign using the provided key (KMS role permissions for AWS).
+ - Artifacts may be local paths or HTTP/S/S3 URIs (this script will download S3/http content to temp file).
+ - Optionally records re-sign events to Vault at secret/data/aegis/kms/rotations
+"""
+import argparse, tempfile, subprocess, os, sys, time
+import boto3, requests, json
+
+def download(uri):
+    if uri.startswith("s3://"):
+        tmp = tempfile.NamedTemporaryFile(delete=False)
+        subprocess.check_call(["aws","s3","cp", uri, tmp.name])
+        return tmp.name
+    elif uri.startswith("http://") or uri.startswith("https://"):
+        r = requests.get(uri, timeout=30)
+        r.raise_for_status()
+        tmp = tempfile.NamedTemporaryFile(delete=False)
+        tmp.write(r.content)
+        tmp.flush()
+        return tmp.name
+    elif os.path.exists(uri):
+        return uri
+    else:
+        raise RuntimeError("Unsupported artifact URI: " + uri)
+
+def sign_and_verify(local_path, key_ref):
+    subprocess.check_call(["cosign","sign","--key", key_ref, local_path])
+    # optionally verify (cosign verify will consult Rekor if configured)
+    subprocess.check_call(["cosign","verify","--key", key_ref, local_path])
+
+def record_vault(record, vault_path="secret/data/aegis/kms/rotations"):
+    try:
+        subprocess.check_call(["vault","kv","put", vault_path, f"record={json.dumps(record)}"])
+    except Exception as e:
+        print("Vault record failed:", e)
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--artifact-list", required=True)
+    p.add_argument("--new-key", required=True, help="cosign key ref e.g. aws-kms://arn:...")
+    args=p.parse_args()
+    with open(args.artifact_list) as fh:
+        uris=[l.strip() for l in fh if l.strip()]
+    for u in uris:
+        print("Processing", u)
+        try:
+            local = download(u)
+            sign_and_verify(local, args.new_key)
+            rec = {"artifact": u, "signed_with": args.new_key, "ts": int(time.time())}
+            print("Signed:", u)
+            record_vault(rec)
+        except Exception as e:
+            print("Error processing", u, e)
+    print("Rotation re-sign complete")
+
+if __name__=="__main__":
+    main()
+
