+"""
+Instrumentation helper that centralizes calls to Arize & Fiddler from serving/adapter code.
+Call `emit_model_telemetry` with features, predictions, labels and metadata.
+"""
+from integrations.arize.arize_client import log_prediction, log_label
+from integrations.fiddler.fiddler_client import send_prediction_event, send_label_event
+import uuid
+
+def emit_model_telemetry(features, prediction, metadata=None, register_label=None):
+    pid = metadata.get("prediction_id") if metadata and metadata.get("prediction_id") else str(uuid.uuid4())
+    meta = metadata or {}
+    # fire-and-forget best-effort
+    try:
+        log_prediction(pid, features, prediction, meta)
+    except Exception:
+        pass
+    try:
+        send_prediction_event(pid, features, prediction, meta)
+    except Exception:
+        pass
+    if register_label:
+        try:
+            log_label(pid, register_label)
+        except Exception:
+            pass
+        try:
+            send_label_event(pid, register_label)
+        except Exception:
+            pass
+
