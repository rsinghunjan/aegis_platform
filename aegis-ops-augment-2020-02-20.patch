+"""
+Small helper to ingest third-party attestation artifacts (pentest reports, SOC2 letter)
+and attach them to MCP and GitHub for traceable evidence.
+"""
+import os
+import requests
+import json
+
+MCP_URL = os.environ.get("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+GITHUB_REPO = os.environ.get("GITHUB_REPO", "")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN", "")
+
+def upload_to_mcp(file_path, title):
+    with open(file_path, "rb") as f:
+        # For simplicity we post metadata pointing to an S3/GCS upload step.
+        payload = {"schema_version":"1.1","model_id":"aegis-compliance","version":"v1","notes": title}
+        try:
+            requests.post(f"{MCP_URL}/model-context", json=payload, timeout=10)
+        except Exception:
+            pass
+
+def create_github_issue(title, body):
+    if not GITHUB_TOKEN or not GITHUB_REPO:
+        return None
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    r = requests.post(url, json={"title": title, "body": body}, headers={"Authorization": f"token {GITHUB_TOKEN}"}, timeout=10)
+    if r.ok:
+        return r.json().get("html_url")
+    return None
+
+def ingest_attestation(file_path, title, create_issue=False):
+    upload_to_mcp(file_path, title)
+    if create_issue:
+        issue_url = create_github_issue(f"Attestation ingested: {title}", f"Attestation file {file_path} uploaded to MCP.")
+        return issue_url
+    return None
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("Usage: attestation_collector.py <file> [create_issue]")
+        raise SystemExit(2)
+    fp = sys.argv[1]
+    ci = len(sys.argv) > 2 and sys.argv[2] == "true"
+    print("Ingesting attestation", fp)
+    print("Issue:", ingest_attestation(fp, os.path.basename(fp), create_issue=ci))
+
