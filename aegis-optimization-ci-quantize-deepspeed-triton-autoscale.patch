+#!/usr/bin/env python3
+"""
+Simple Optuna study to tune batch sizes and sequence length for throughput/latency tradeoffs.
+ - This script runs a local experiment; integrate with Argo/K8s to run in-cluster.
+"""
+import optuna
+import random, time, requests, os
+
+ENDPOINT = os.environ.get("MODEL_BENCH_ENDPOINT", "http://vllm-bench.local/generate")
+
+def objective(trial):
+    batch_size = trial.suggest_categorical("batch_size", [1,2,4,8,16,32])
+    seq_len = trial.suggest_categorical("seq_len", [32,64,128,256,512])
+    qps = 10.0
+    # Very simple synthetic workload: send batch_size concurrent requests and measure avg latency
+    latencies = []
+    for _ in range(10):
+        start = time.time()
+        payload = {"client_id":"optuna","model_env":"staging","payload":{"inputs":"x"*seq_len}}
+        try:
+            requests.post(ENDPOINT, json=payload, timeout=10)
+            lat = time.time() - start
+        except Exception:
+            lat = 10.0
+        latencies.append(lat)
+    avg = sum(latencies)/len(latencies)
+    # objective: minimize latency while penalizing large batch sizes that exceed memory (proxy)
+    return avg + 0.01 * batch_size
+
+def main():
+    study = optuna.create_study(direction="minimize")
+    study.optimize(objective, n_trials=20)
+    print("Best params:", study.best_params)
+
+if __name__ == "__main__":
+    main()
+
