+#!/usr/bin/env python3
+"""
+Simple adaptive batching controller for vLLM-style backends.
+ - Collects incoming requests and forms batches with timeout/backpressure.
+ - This is a reference implementation; production should integrate with gateway and vLLM native batching.
+"""
+import time
+import threading
+from queue import Queue, Empty
+
+class AdaptiveBatcher:
+    def __init__(self, max_batch=32, max_wait_ms=20):
+        self.max_batch = max_batch
+        self.max_wait_ms = max_wait_ms
+        self.q = Queue()
+        self.running = True
+        threading.Thread(target=self._worker, daemon=True).start()
+
+    def submit(self, item):
+        self.q.put(item)
+
+    def _worker(self):
+        while self.running:
+            batch = []
+            start = time.time()
+            while (time.time() - start) * 1000 < self.max_wait_ms and len(batch) < self.max_batch:
+                try:
+                    item = self.q.get(timeout=self.max_wait_ms / 1000.0)
+                    batch.append(item)
+                except Empty:
+                    break
+            if batch:
+                # forward batch to vLLM backend (placeholder)
+                self._send_batch(batch)
+
+    def _send_batch(self, batch):
+        # Implement backpressure and retries here
+        print("Sending batch of size", len(batch))
+
+if __name__ == "__main__":
+    b = AdaptiveBatcher()
