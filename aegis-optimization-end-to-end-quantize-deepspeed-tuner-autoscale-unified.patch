+#!/usr/bin/env python3
+"""
+TensorRT conversion wrapper with optional INT8 calibration using trtexec or Python TRT API.
+
+This script:
+ - Accepts an ONNX model and produces a TensorRT engine (plan)
+ - Supports FP16 and INT8 flags. For INT8 you must provide calibration dataset or calibration cache.
+
+Note: In CI you can skip INT8 if hardware does not support calibration.
+"""
+import argparse
+import os
+import logging
+import subprocess
+
+LOG = logging.getLogger("aegis.trt")
+logging.basicConfig(level=logging.INFO)
+
+
+def build_with_trtexec(onnx_path, engine_out, fp16=False, int8=False, calib_cache=None, workspace=4096):
+    cmd = ["trtexec", f"--onnx={onnx_path}", f"--saveEngine={engine_out}", f"--workspace={workspace}"]
+    if fp16:
+        cmd.append("--fp16")
+    if int8:
+        cmd.append("--int8")
+        if calib_cache:
+            cmd.append(f"--int8Calibration={calib_cache}")
+    LOG.info("Running: %s", " ".join(cmd))
+    subprocess.check_call(cmd)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--onnx", required=True)
+    ap.add_argument("--engine", required=True)
+    ap.add_argument("--fp16", action="store_true")
+    ap.add_argument("--int8", action="store_true")
+    ap.add_argument("--calib-cache", default=None)
+    ap.add_argument("--workspace", type=int, default=4096)
+    args = ap.parse_args()
+    os.makedirs(os.path.dirname(args.engine), exist_ok=True)
+    build_with_trtexec(args.onnx, args.engine, fp16=args.fp16, int8=args.int8, calib_cache=args.calib_cache, workspace=args.workspace)
+
+
+if __name__ == "__main__":
+    main()
