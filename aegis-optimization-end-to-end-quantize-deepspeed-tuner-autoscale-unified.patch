+#!/usr/bin/env python3
+"""
+Triton dynamic batching config updater.
+
+- Reads suggestions (from auto_batch_tuner or profiler analyzer)
+- Patches a Triton model config (model_config.pbtxt) to update dynamic_batching preferred sizes and max_queue_delay_microseconds
+- In production integrate with CI/Argo to apply config safely and trigger rolling restart of Triton pods
+"""
+import os
+import re
+import json
+import logging
+from pathlib import Path
+
+LOG = logging.getLogger("aegis.triton.tuner")
+logging.basicConfig(level=logging.INFO)
+
+
+def update_model_config(path, preferred_sizes, max_delay_ms):
+    p = Path(path)
+    text = p.read_text()
+    # Very simple text replacement: assumes template contains the dynamic_batching block
+    new_block = "dynamic_batching {\n  preferred_batch_sizes: [ " + ", ".join(map(str, preferred_sizes)) + " ]\n  max_queue_delay_microseconds: " + str(int(max_delay_ms*1000)) + "\n}\n"
+    text = re.sub(r"dynamic_batching \{[\s\S]*?\}\n", new_block, text, flags=re.M)
+    p.write_text(text)
+    LOG.info("Updated model config %s with preferred=%s delay_ms=%s", path, preferred_sizes, max_delay_ms)
+
+
+def main():
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--sizes", default="8,16,32")
+    ap.add_argument("--delay-ms", type=int, default=50)
+    args = ap.parse_args()
+    sizes = [int(x) for x in args.sizes.split(",")]
+    update_model_config(args.config, sizes, args.delay_ms)
+
+
+if __name__ == "__main__":
+    main()
+
