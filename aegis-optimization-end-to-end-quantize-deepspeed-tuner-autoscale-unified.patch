+#!/usr/bin/env python3
+"""
+Node-local cache prefetcher with LRU eviction.
+
+- Prefetches model shards from object store (S3/GCS) into /var/local/models/<model>
+- Maintains an LRU index (simple file-based) and evicts least-recently-used models when capacity exceeded
+- Exposes a small HTTP health/status endpoint to show cached models and used bytes
+
+Configuration via env:
+ - MODEL_SOURCE_URL (s3://...)
+ - CACHE_PATH (/var/local/models)
+ - MAX_BYTES (e.g., 200000000000)
+"""
+import os
+import time
+import json
+import logging
+from pathlib import Path
+from http.server import BaseHTTPRequestHandler, HTTPServer
+import threading
+import shutil
+
+LOG = logging.getLogger("aegis.nodecache")
+logging.basicConfig(level=logging.INFO)
+
+CACHE_PATH = Path(os.environ.get("CACHE_PATH", "/var/local/models"))
+MAX_BYTES = int(os.environ.get("MAX_BYTES", str(200 * 1024 * 1024 * 1024)))  # default 200GB
+INDEX_FILE = CACHE_PATH / ".index.json"
+
+
+def ensure_cache():
+    CACHE_PATH.mkdir(parents=True, exist_ok=True)
+    if not INDEX_FILE.exists():
+        INDEX_FILE.write_text(json.dumps({}))
+
+
+def get_cache_usage():
+    total = 0
+    for p in CACHE_PATH.rglob("*"):
+        if p.is_file():
+            total += p.stat().st_size
+    return total
+
+
+def evict_if_needed():
+    idx = json.loads(INDEX_FILE.read_text())
+    usage = get_cache_usage()
+    if usage <= MAX_BYTES:
+        return
+    # sort by last_access ascending
+    items = sorted(idx.items(), key=lambda kv: kv[1].get("last_access", 0))
+    for key, meta in items:
+        path = CACHE_PATH / meta["path"]
+        try:
+            if path.exists():
+                if path.is_dir():
+                    shutil.rmtree(path)
+                else:
+                    path.unlink()
+            LOG.info("Evicted %s to free space", key)
+            idx.pop(key, None)
+            INDEX_FILE.write_text(json.dumps(idx))
+            usage = get_cache_usage()
+            if usage <= MAX_BYTES:
+                break
+        except Exception:
+            LOG.exception("Evict failed for %s", key)
+
+
+def prefetch_model(model_name: str, object_uri: str):
+    # Placeholder: replace with real S3/GCS download and cosign verification
+    target = CACHE_PATH / model_name
+    if target.exists():
+        # update index
+        idx = json.loads(INDEX_FILE.read_text())
+        idx[model_name] = {"path": model_name, "last_access": int(time.time())}
+        INDEX_FILE.write_text(json.dumps(idx))
+        return
+    LOG.info("Prefetching %s from %s (placeholder)", model_name, object_uri)
+    target.mkdir(parents=True, exist_ok=True)
+    # Pretend to download small file
+    (target / "placeholder.bin").write_text("prefetched")
+    idx = json.loads(INDEX_FILE.read_text())
+    idx[model_name] = {"path": model_name, "last_access": int(time.time())}
+    INDEX_FILE.write_text(json.dumps(idx))
+    evict_if_needed()
+
+
+class HealthHandler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        idx = json.loads(INDEX_FILE.read_text())
+        resp = {"cached": list(idx.keys()), "usage_bytes": get_cache_usage()}
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.end_headers()
+        self.wfile.write(json.dumps(resp).encode("utf-8"))
+
+
+def run_http():
+    server = HTTPServer(("0.0.0.0", 8080), HealthHandler)
+    server.serve_forever()
+
+
+def main():
+    ensure_cache()
+    # start health server
+    t = threading.Thread(target=run_http, daemon=True)
+    t.start()
+    # simple loop: read desired prefetch list from file or env (placeholder)
+    while True:
+        desired = os.environ.get("PREFETCH_MODELS", "")
+        if desired:
+            for m in desired.split(","):
+                prefetch_model(m.strip(), "")
+        time.sleep(60)
+
+
+if __name__ == "__main__":
+    main()
