+#!/usr/bin/env python3
+"""
+ONNX static quantization wrapper (PTQ) using onnxruntime tools.
+
+This is a convenience wrapper that:
+ - Converts a PyTorch trace/onnx export (assumes you already have an ONNX)
+ - Calls onnxruntime.quantization tools (via python bindings if available)
+ - Produces a quantized ONNX artifact suitable for ONNXRuntime/TensorRT conversion
+
+Requires: onnx, onnxruntime, onnxruntime-tools (optional)
+"""
+import os
+import logging
+import argparse
+import subprocess
+from pathlib import Path
+
+LOG = logging.getLogger("aegis.onnx.quant")
+logging.basicConfig(level=logging.INFO)
+
+
+def quantize_static_via_ort(onnx_in: str, onnx_out: str, calib_data_dir: str = None):
+    """
+    Try using onnxruntime.quantization (python) if available, otherwise fall back to CLI.
+    """
+    try:
+        from onnxruntime.quantization import quantize_static, CalibrationDataReader, QuantFormat, QuantType
+        LOG.info("Running onnxruntime.quantize_static via python API")
+        class DummyReader(CalibrationDataReader):
+            def __init__(self, data_path):
+                self.data_path = data_path
+                self.enum_data = [{"input": (0,)}]  # placeholder
+
+            def get_next(self):
+                try:
+                    return self.enum_data.pop(0)
+                except Exception:
+                    return None
+
+        reader = DummyReader(calib_data_dir)
+        quantize_static(onnx_in, onnx_out, reader, quant_format=QuantFormat.QDQ, activation_type=QuantType.QInt8, weight_type=QuantType.QInt8)
+        LOG.info("Quantized ONNX written to %s", onnx_out)
+        return onnx_out
+    except Exception:
+        LOG.info("onnxruntime python quantize not available; falling back to shell tool (if present)")
+        # Attempt polygraphy / onnxruntime-tools CLI placeholder
+        cli = "python -m onnxruntime.quantization.onnx_quantizer"
+        cmd = f"{cli} --input {onnx_in} --output {onnx_out} --mode static --per-channel True"
+        LOG.info("Running: %s", cmd)
+        subprocess.check_call(cmd, shell=True)
+        return onnx_out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--onnx-in", required=True)
+    ap.add_argument("--onnx-out", required=True)
+    ap.add_argument("--calib-data", default=None)
