+#!/usr/bin/env python3
+"""
+CI helper to block promotion when perf or safety regressions exceed thresholds.
+
+Uses a simple JSON baseline stored in repo or artifact store:
+  baseline.json = {"p95_latency_s": 0.45, "safety_block_rate_per_1k": 0.5}
+
+This script queries Prometheus and compares candidate results (provided via environment or params).
+Exits non-zero to fail CI if thresholds are violated.
+"""
+import os
+import json
+import logging
+import requests
+import sys
+
+LOG = logging.getLogger("aegis.ci")
+logging.basicConfig(level=logging.INFO)
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+BASELINE_FILE = os.environ.get("BASELINE_FILE", "./ops/ci/baseline.json")
+
+
+def prom_query(q):
+    r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": q}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+
+def load_baseline(path):
+    if not os.path.exists(path):
+        return {}
+    return json.load(open(path))
+
+
+def main():
+    baseline = load_baseline(BASELINE_FILE)
+    p95_baseline = baseline.get("p95_latency_s", 1.0)
+    max_blocks = baseline.get("max_blocked_incidents", 5)
+    # Query p95 latency for candidate period (example)
+    try:
+        res = prom_query('histogram_quantile(0.95, sum(rate(aegis_request_latency_seconds_bucket[5m])) by (le))')
+        p95 = float(res["data"]["result"][0]["value"][1])
+    except Exception:
+        LOG.exception("p95 query failed; failing safe")
+        sys.exit(2)
+    LOG.info("candidate p95=%s baseline=%s", p95, p95_baseline)
+    if p95 > p95_baseline * 1.2:
+        LOG.error("Latency regression exceeds 20%%")
+        sys.exit(2)
+    # Safety check: blocked incidents
+    try:
+        res = prom_query('increase(aegis_safety_filter_blocked_total[10m])')
+        blocked = float(res["data"]["result"][0]["value"][1]) if res["data"]["result"] else 0.0
+    except Exception:
+        LOG.exception("blocked query failed; failing safe")
+        sys.exit(2)
+    LOG.info("blocked incidents in window: %s", blocked)
+    if blocked > max_blocks:
+        LOG.error("Too many blocked incidents for candidate")
+        sys.exit(2)
