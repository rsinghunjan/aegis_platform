*** Add File:ops/vault/enable_audit_forwarding.sh
+#!/usr/bin/env bash
+set -euo pipefail
+VAULT_ADDR="${VAULT_ADDR:-http://127.0.0.1:8200}"
+VAULT_TOKEN="${VAULT_TOKEN:-}"
+SIEM_ENDPOINT="${SIEM_ENDPOINT:-http://siem.example/api/logs}"
+export VAULT_ADDR VAULT_TOKEN
+
+if [ -z "$VAULT_TOKEN" ]; then echo "VAULT_TOKEN required"; exit 2; fi
+
+vault audit enable file file_path=/vault/logs/vault_audit.log || true
+vault audit enable syslog tag="vault" || true
+
+cat > /tmp/fluentbit_vault.conf <<'EOF'
+[INPUT]
+    Name    tail
+    Path    /vault/logs/vault_audit.log
+[OUTPUT]
+    Name    http
+    Match   *
+    Host    siem.example
+    Port    80
+    URI     /api/logs
+    Format  json
+EOF
+
+echo "Created Fluent Bit config /tmp/fluentbit_vault.conf - deploy into logging DaemonSet to forward audit logs to SIEM ($SIEM_ENDPOINT)"
+
