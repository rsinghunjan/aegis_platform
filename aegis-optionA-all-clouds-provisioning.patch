+/*
+AWS: Provision KMS key for cosign and a minimal Rekor server EC2 instance (demo/HA note).
+Customize region, instance_type, subnet_ids and security groups for your environment.
+This is an operational scaffold — for production prefer Rekor on k8s with autoscaling or a managed Rekor.
+*/
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = ">= 4.0" }
+  }
+}
+provider "aws" { region = var.aws_region }
+
+variable "aws_region" { default = "us-west-2" }
+variable "rekor_image" { default = "gcr.io/rekor-project/rekor-server:latest" }
+variable "rekor_subnet_id" { type = string, default = "" }
+
+data "aws_vpc" "default" { default = true }
+data "aws_subnet_ids" "default" { vpc_id = data.aws_vpc.default.id }
+
+resource "aws_kms_key" "cosign" {
+  description             = "Aegis cosign production KMS key"
+  enable_key_rotation     = true
+  deletion_window_in_days = 30
+}
+
+resource "aws_kms_alias" "cosign_alias" {
+  name          = "alias/aegis-cosign-prod"
+  target_key_id = aws_kms_key.cosign.key_id
+}
+
+resource "aws_security_group" "rekor_sg" {
+  name        = "aegis-rekor-sg"
+  description = "Rekor access"
+  vpc_id      = data.aws_vpc.default.id
+  ingress { from_port=80; to_port=80; protocol="tcp"; cidr_blocks=["0.0.0.0/0"] }
+  egress  { from_port=0; to_port=0; protocol="-1"; cidr_blocks=["0.0.0.0/0"] }
+}
+
+data "aws_ami" "amazon_linux_2" {
+  most_recent = true
+  owners      = ["amazon"]
+  filter { name = "name"; values = ["amzn2-ami-hvm-*-x86_64-ebs"] }
+}
+
+resource "aws_instance" "rekor" {
+  ami                         = data.aws_ami.amazon_linux_2.id
+  instance_type               = "t3.small"
+  subnet_id                   = var.rekor_subnet_id != "" ? var.rekor_subnet_id : data.aws_subnet_ids.default.ids[0]
+  vpc_security_group_ids      = [aws_security_group.rekor_sg.id]
+  associate_public_ip_address = true
+  user_data = <<-EOF
+    #!/bin/bash
+    yum update -y
+    amazon-linux-extras install docker -y
+    service docker start
+    docker run -d --name rekor -p 80:3000 ${rekor_image}
+  EOF
+  tags = { Name = "aegis-rekor" }
+}
+
+output "aws_cosign_kms_arn" { value = aws_kms_key.cosign.arn }
+output "aws_rekor_endpoint" { value = "http://${aws_instance.rekor.public_ip}" }
+
