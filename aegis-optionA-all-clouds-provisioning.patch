*** Add File:ops/ci/rekor_fail_if_missing.sh
+#!/usr/bin/env bash
+set -euo pipefail
+ART="${1:-}"
+REKOR_SERVER="${REKOR_SERVER:-${REKOR_SERVER}}"
+
+if [ -z "$ART" ] || [ ! -f "$ART" ]; then echo "artifact missing: $ART" >&2; exit 2; fi
+if [ -z "$REKOR_SERVER" ]; then echo "REKOR_SERVER env required" >&2; exit 3; fi
+
+SHA=$(sha256sum "$ART" | awk '{print $1}')
+if command -v rekor-cli >/dev/null 2>&1; then
+  if ! rekor-cli search --rekor_server "$REKOR_SERVER" --sha "$SHA" >/dev/null 2>&1; then
+    echo "No Rekor entry for $ART (sha=$SHA)" >&2
+    exit 4
+  fi
+else
+  # best-effort HTTP, adapt to your Rekor deployment
+  RES=$(curl -sS --fail -X POST "${REKOR_SERVER%/}/api/v1/log/entries/retrieve" -H "Content-Type: application/json" -d "{\"hash\":\"$SHA\"}" || true)
+  if [ -z "$RES" ] || ! echo "$RES" | grep -q "$SHA"; then
+    echo "No Rekor entry found (http) for $ART" >&2
+    exit 5
+  fi
+fi
+echo "Found Rekor entry for $ART"
+
