+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Set GitHub repository secrets for COSIGN_KEY and REKOR_SERVER using gh CLI.
+# Usage: ./set_github_secrets_allclouds.sh <repo> <COSIGN_KMS_URI> <REKOR_ENDPOINT>
+#
+REPO="${1:-}"
+COSIGN_KEY="${2:-}"
+REKOR_SERVER="${3:-}"
+
+if [ -z "$REPO" ] || [ -z "$COSIGN_KEY" ] || [ -z "$REKOR_SERVER" ]; then
+  echo "Usage: $0 <owner/repo> <COSIGN_KEY_URI> <REKOR_ENDPOINT>"
+  exit 2
+fi
+
+if ! command -v gh >/dev/null 2>&1; then
+  echo "gh CLI required: https://cli.github.com/" >&2
+  exit 3
+fi
+
+echo "Setting secrets in $REPO"
+gh secret set COSIGN_KEY --repo "$REPO" --body "$COSIGN_KEY"
+gh secret set REKOR_SERVER --repo "$REPO" --body "$REKOR_SERVER"
+echo "Secrets set. Update ExternalSecrets/Vault secrets suppliers as needed."
+
