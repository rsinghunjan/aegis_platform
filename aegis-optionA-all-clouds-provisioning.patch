+name: Enforce Rekor on Promotion
+on:
+  workflow_run:
+    workflows: ["Build and Package"]
+    types: [completed]
+jobs:
+  verify:
+    if: ${{ github.event.workflow_run.conclusion == 'success' }}
+    runs-on: ubuntu-latest
+    steps:
+    - uses: actions/checkout@v4
+    - name: Install rekor-cli & cosign
+      run: |
+        curl -sSL -o /usr/local/bin/rekor-cli https://github.com/sigstore/rekor/releases/latest/download/rekor-cli_linux_amd64 && chmod +x /usr/local/bin/rekor-cli
+        curl -sSL -o /usr/local/bin/cosign https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64 && chmod +x /usr/local/bin/cosign
+    - name: Verify artifacts registered in Rekor
+      env:
+        REKOR_SERVER: ${{ secrets.REKOR_SERVER }}
+      run: |
+        for ART in $(find ./artifacts -type f -name '*.plan' -o -name '*.tar.gz' -o -name '*.zip'); do
+          ./ops/ci/rekor_fail_if_missing.sh "$ART"
+        done
+
