+/*
+Azure: Provision Key Vault + Key and run Rekor in an Azure Container Instance (ACI) group (demo).
+For production consider AKS + Helm Rekor chart.
+*/
+terraform {
+  required_providers {
+    azurerm = { source = "hashicorp/azurerm", version = ">= 3.0" }
+  }
+}
+provider "azurerm" { features = {} }
+
+variable "azure_region" { default = "eastus" }
+variable "rekor_image" { default = "gcr.io/rekor-project/rekor-server:latest" }
+
+resource "azurerm_resource_group" "rg" {
+  name     = "aegis-rg"
+  location = var.azure_region
+}
+
+resource "azurerm_key_vault" "kv" {
+  name                        = "aegis-kv-${random_integer.suffix.result}"
+  location                    = azurerm_resource_group.rg.location
+  resource_group_name         = azurerm_resource_group.rg.name
+  sku_name                    = "standard"
+  tenant_id                   = data.azurerm_client_config.current.tenant_id
+  soft_delete_retention_days  = 7
+  purge_protection_enabled    = false
+}
+
+resource "random_integer" "suffix" { min = 1000; max = 9999 }
+data "azurerm_client_config" "current" {}
+
+resource "azurerm_key_vault_key" "cosign_key" {
+  name         = "aegis-cosign"
+  key_vault_id = azurerm_key_vault.kv.id
+  key_type     = "RSA"
+  key_size     = 2048
+}
+
+resource "azurerm_container_group" "rekor" {
+  name                = "aegis-rekor-acigroup"
+  location            = azurerm_resource_group.rg.location
+  resource_group_name = azurerm_resource_group.rg.name
+  os_type             = "Linux"
+  container {
+    name   = "rekor"
+    image  = var.rekor_image
+    cpu    = "0.5"
+    memory = "1.5"
+    ports { port = 80 }
+  }
+  ip_address_type = "Public"
+  dns_name_label  = "aegis-rekor-${random_integer.suffix.result}"
+}
+
+output "azure_key_vault_key_id" { value = azurerm_key_vault_key.cosign_key.id }
+output "azure_rekor_endpoint" { value = "http://${azurerm_container_group.rekor.fqdn}" }
