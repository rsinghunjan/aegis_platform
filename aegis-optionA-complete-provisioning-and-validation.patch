*** Add File:.github/workflows/test_sign_and_rekor.yml
+name: Test Sign (KMS) + Rekor Verification
+on:
+  workflow_dispatch:
+jobs:
+  test-sign:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      id-token: write
+    steps:
+    - uses: actions/checkout@v4
+    - name: Install cosign & rekor-cli
+      run: |
+        curl -sSL -o /usr/local/bin/cosign https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64 && chmod +x /usr/local/bin/cosign
+        curl -sSL -o /usr/local/bin/rekor-cli https://github.com/sigstore/rekor/releases/latest/download/rekor-cli_linux_amd64 && chmod +x /usr/local/bin/rekor-cli
+    - name: Prepare test artifact
+      run: |
+        mkdir -p artifacts
+        echo "aegis test $(date -u)" > artifacts/test.bin
+    - name: Configure cloud auth (AWS example via OIDC)
+      if: ${{ env.CLOUD == 'aws' || github.event.inputs.cloud == 'aws' }}
+      env:
+        AWS_ROLE_ARN: ${{ secrets.AWS_OIDC_ROLE_ARN }}
+      run: |
+        echo "Assuming AWS role via OIDC (runner must be configured for OIDC trust)"
+        # Provided as documentation; actual role assumption handled by actions/checkout OIDC + sts:assume-role-with-web-identity or using aws-actions/configure-aws-credentials
+    - name: Sign artifact with cosign (KMS)
+      env:
+        COSIGN_KEY: ${{ secrets.COSIGN_KEY }}
+      run: |
+        cosign sign-blob --key "${COSIGN_KEY}" artifacts/test.bin
+    - name: Search Rekor for artifact
+      env:
+        REKOR_SERVER: ${{ secrets.REKOR_SERVER }}
+      run: |
+        sha256sum artifacts/test.bin | awk '{print $1}' > /tmp/art.sha
+        rekor-cli search --rekor_server "${REKOR_SERVER}" --sha $(cat /tmp/art.sha)
+    - name: Show rekor-cli entries (if any)
+      env:
+        REKOR_SERVER: ${{ secrets.REKOR_SERVER }}
+      run: |
+        rekor-cli search --rekor_server "${REKOR_SERVER}" --artifact artifacts/test.bin || true
+
