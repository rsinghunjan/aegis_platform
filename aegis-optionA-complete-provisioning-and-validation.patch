+#!/usr/bin/env bash
+set -euo pipefail
+ART="$1"
+REKOR="${REKOR_SERVER:-}"
+if [ -z "$ART" ]; then echo "Usage: $0 <artifact>"; exit 2; fi
+if [ -z "$REKOR" ]; then echo "REKOR_SERVER env missing"; exit 3; fi
+sha=$(sha256sum "$ART" | awk '{print $1}')
+echo "Searching Rekor for $sha"
+rekor-cli search --rekor_server "$REKOR" --sha "$sha"
+echo "Done"
+
