+#!/usr/bin/env bash
+#
+# Create an OIDC app in Okta via Okta Management API (requires OKTA_DOMAIN and OKTA_API_TOKEN env vars)
+# This is a template: review and adapt scopes / redirectUris / settings to your org policy.
+#
+set -euo pipefail
+OKTA_DOMAIN="${OKTA_DOMAIN:-}"
+OKTA_TOKEN="${OKTA_API_TOKEN:-}"
+if [ -z "$OKTA_DOMAIN" ] || [ -z "$OKTA_TOKEN" ]; then
+  echo "Set OKTA_DOMAIN and OKTA_API_TOKEN env vars before running"
+  exit 2
+fi
+
+API="https://${OKTA_DOMAIN}/api/v1/apps"
+
+read -p "Enter app name (eg: aegis-mofn): " APPNAME
+cat > /tmp/okta_oidc.json <<JSON
+{
+  "name": "oidc_client",
+  "label": "${APPNAME}",
+  "signOnMode": "OPENID_CONNECT",
+  "credentials": { "oauthClient": { "autoKeyRotation": true } },
+  "settings": {
+    "oauthClient": {
+      "client_uri": "https://aegis.example",
+      "logo_uri": "https://aegis.example/logo.png",
+      "grant_types": ["client_credentials","authorization_code"],
+      "response_types": ["token","id_token","code"],
+      "redirect_uris": ["https://aegis.example/oauth2/callback"],
+      "application_type": "web"
+    }
+  }
+}
+JSON
+
+curl -sS -X POST "$API" \
+  -H "Authorization: SSWS ${OKTA_TOKEN}" \
+  -H "Content-Type: application/json" \
+  -d @/tmp/okta_oidc.json | jq .
+
+echo "Okta app creation response above. JWKS URL will be: https://${OKTA_DOMAIN}/oauth2/default/v1/keys (or check the created authorization server)."
+echo "Set OIDC_JWKS_URL and OIDC_AUDIENCE in Helm values / GitHub secrets accordingly."
+
