+#!/usr/bin/env python3
+"""
+Specialized evidence bundle for PAN pilots: collects MLflow run metadata (optional),
+receipt_signer attestation (required), Rekor index (if present), and CI metadata.
+"""
+import argparse, json, os, requests, time
+
+def load_att(path):
+    if not path or not os.path.exists(path):
+        return None
+    return json.load(open(path))
+
+def fetch_mlflow(run_id, mlflow_uri):
+    if not run_id or not mlflow_uri:
+        return None
+    try:
+        r = requests.get(f"{mlflow_uri.rstrip('/')}/api/2.0/preview/mlflow/runs/get?run_id={run_id}", timeout=5.0)
+        if r.ok:
+            return r.json()
+    except Exception:
+        pass
+    return None
+
+def main(attestation, run_id, mlflow_uri, out):
+    att = load_att(attestation)
+    bundle = {
+        "attestation": att,
+        "rekor_index": (att.get("rekor_index") if att else None),
+        "mlflow": fetch_mlflow(run_id, mlflow_uri),
+        "ci": {"timestamp": time.time(), "job": os.environ.get("GITHUB_JOB","")},
+    }
+    with open(out, "w") as f:
+        json.dump(bundle, f, indent=2)
+    print("Wrote", out)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--attestation", required=True)
+    p.add_argument("--run-id", default="")
+    p.add_argument("--mlflow-uri", default=os.environ.get("MLFLOW_TRACKING_URI",""))
+    p.add_argument("--out", default="evidence_bundle_pan.json")
+    args = p.parse_args()
+    main(args.attestation, args.run_id, args.mlflow_uri, args.out)
+
