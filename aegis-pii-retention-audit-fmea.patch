+#!/usr/bin/env python3
+"""
+Scheduled sanitization job:
+ - Scans training data files for PII, redacts, writes sanitized copies, and logs sanitization events to MCP.
+ - Enforces retention annotations by adding 'retention_expires' metadata if missing.
+"""
+import os, json, glob, requests
+from datetime import datetime, timedelta
+
+PRESIDIO_API = os.environ.get("PRESIDIO_API", "http://presidio-analyzer:3000")
+TRAIN_DIR = os.environ.get("TRAIN_DIR", "training_data")
+SANITIZED_DIR = os.environ.get("SANITIZED_DIR", "training_data_sanitized")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+DEFAULT_RETENTION_DAYS = int(os.environ.get("DEFAULT_RETENTION_DAYS", "365"))
+
+os.makedirs(SANITIZED_DIR, exist_ok=True)
+
+def analyze_and_anonymize(text):
+    r = requests.post(f"{PRESIDIO_API.rstrip('/')}/analyze", json={"text": text}, timeout=10.0)
+    r.raise_for_status()
+    entities = r.json().get("entities", [])
+    r2 = requests.post(f"{PRESIDIO_API.rstrip('/')}/anonymize", json={"text": text, "entities": entities}, timeout=10.0)
+    r2.raise_for_status()
+    return r2.json().get("text", ""), entities
+
+def main():
+    report = {"sanitized": [], "errors": []}
+    for path in glob.glob(os.path.join(TRAIN_DIR, "*.txt")):
+        try:
+            text = open(path).read()
+            redacted, entities = analyze_and_anonymize(text)
+            out_path = os.path.join(SANITIZED_DIR, os.path.basename(path))
+            open(out_path, "w").write(redacted)
+            # annotate retention
+            retention_expires = (datetime.utcnow() + timedelta(days=DEFAULT_RETENTION_DAYS)).isoformat() + "Z"
+            ev = {"file": path, "sanitized_path": out_path, "entities": len(entities), "retention_expires": retention_expires}
+            requests.post(f"{AEGIS_MCP.rstrip('/')}/compliance/sanitization", json=ev, timeout=5.0)
+            report["sanitized"].append(ev)
+        except Exception as e:
+            report["errors"].append({"file": path, "error": str(e)})
+    print(json.dumps(report, indent=2))
+
+if __name__ == "__main__":
+    main()
+
