+#!/usr/bin/env python3
+"""
+Encrypt + store original artifacts in S3 with KMS encryption and annotated metadata.
+- Must be called only after PII scanning (or from trusted ingest pipeline).
+- Stores metadata & retention policy annotations and writes MCP audit entry.
+"""
+import os, logging, json, uuid, boto3, requests
+from fastapi import FastAPI, UploadFile, File, Form, HTTPException
+
+LOG = logging.getLogger("aegis.encrypt-store")
+APP = FastAPI(title="Aegis Encrypt Store")
+S3_BUCKET = os.environ.get("ORIGINALS_S3_BUCKET", "aegis-originals")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+KMS_KEY_ID = os.environ.get("ORIGINALS_KMS_KEY_ID")
+
+s3 = boto3.client("s3", region_name=REGION)
+kms = boto3.client("kms", region_name=REGION) if KMS_KEY_ID else None
+
+@APP.post("/store")
+def store_original(filename: str = Form(...), retention_days: int = Form(365), source: str = Form("unknown"), file: UploadFile = File(...)):
+    oid = str(uuid.uuid4())
+    key = f"originals/{oid}/{filename}"
+    body = file.file.read()
+    # Server-side encryption: use SSE-KMS with provided KMS key
+    try:
+        extra = {}
+        if KMS_KEY_ID:
+            extra = {"ServerSideEncryption": "aws:kms", "SSEKMSKeyId": KMS_KEY_ID}
+        s3.put_object(Bucket=S3_BUCKET, Key=key, Body=body, **extra)
+    except Exception as e:
+        LOG.error("s3 put failed: %s", e)
+        raise HTTPException(status_code=500, detail="store failed")
+
+    # write MCP audit with retention and provenance placeholder
+    audit = {"artifact_id": oid, "s3_key": key, "source": source, "retention_days": retention_days}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/pii/originals", json=audit, timeout=5.0)
+    except Exception as e:
+        LOG.warning("failed writing originals audit to MCP: %s", e)
+
+    return {"artifact_id": oid, "s3_key": key}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
