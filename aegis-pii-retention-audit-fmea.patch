+#!/usr/bin/env python3
+"""
+Receipt signer: accepts event payloads (side effects, retrievals) and returns a KMS-signed receipt.
+Writes the receipt to MCP and (optionally) Rekor can be invoked by caller.
+"""
+import os, time, json, logging, boto3, requests
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+LOG = logging.getLogger("aegis.receipt")
+APP = FastAPI(title="Aegis Receipt Signer")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+KMS_KEY_ID = os.environ.get("RECEIPT_KMS_KEY_ID")
+
+kms = boto3.client("kms") if KMS_KEY_ID else None
+
+class Event(BaseModel):
+    event_type: str
+    artifact: str
+    requestor: str
+    approval_id: str = None
+    evidence: dict = {}
+
+def sign(payload: bytes):
+    if not kms:
+        return None
+    resp = kms.sign(KeyId=KMS_KEY_ID, Message=payload, MessageType='RAW', SigningAlgorithm='RSASSA_PKCS1_V1_5_SHA_256')
+    return resp.get("Signature")
+
+@APP.post("/sign")
+def sign_event(ev: Event):
+    record = {"event": ev.dict(), "ts": int(time.time())}
+    payload = json.dumps(record).encode("utf-8")
+    sig = None
+    try:
+        sig = sign(payload)
+    except Exception as e:
+        LOG.error("kms sign failed: %s", e)
+        raise HTTPException(status_code=500, detail="sign failed")
+    rec = {"receipt": record, "signature": sig.hex() if sig else None}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/receipts", json=rec, timeout=5.0)
+    except Exception as e:
+        LOG.warning("failed to post receipt to MCP: %s", e)
+    return {"signed": True, "receipt": rec}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
