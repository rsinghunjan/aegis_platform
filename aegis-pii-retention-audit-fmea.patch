+#!/usr/bin/env python3
+"""
+Presidio adapter: enforce scanning & redaction before ingestion.
+- Exposes a small HTTP API to analyze and anonymize text payloads.
+- Writes an audit record to MCP for every item scanned.
+"""
+import os, logging, json, requests
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+LOG = logging.getLogger("aegis.presidio")
+APP = FastAPI(title="Aegis Presidio Adapter")
+PRESIDIO_API = os.environ.get("PRESIDIO_API", "http://presidio-analyzer:3000")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+class ScanReq(BaseModel):
+    id: str
+    text: str
+    source: str = "unknown"
+    metadata: dict = {}
+
+@APP.post("/scan")
+def scan_and_redact(req: ScanReq):
+    # call Presidio analyzer
+    try:
+        r = requests.post(f"{PRESIDIO_API.rstrip('/')}/analyze", json={"text": req.text}, timeout=10.0)
+        r.raise_for_status()
+        entities = r.json().get("entities", [])
+        # anonymize / redact
+        r2 = requests.post(f"{PRESIDIO_API.rstrip('/')}/anonymize", json={"text": req.text, "entities": entities}, timeout=10.0)
+        r2.raise_for_status()
+        redacted = r2.json().get("text", "")
+    except Exception as e:
+        LOG.error("Presidio error: %s", e)
+        raise HTTPException(status_code=503, detail="presidio unavailable")
+
+    audit = {
+        "artifact_id": req.id,
+        "source": req.source,
+        "entities": entities,
+        "redacted_text_snippet": redacted[:512],
+        "metadata": req.metadata
+    }
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/pii/scan", json=audit, timeout=5.0)
+    except Exception as e:
+        LOG.warning("failed to write PII audit to MCP: %s", e)
+
+    return {"id": req.id, "redacted_text": redacted, "entities": entities}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
