+#!/usr/bin/env python3
+"""
+A2A Approver (strict): enforces JWKS verification, issues KMS-signed approval records,
+and links approvals to actions and optional FMEA IDs.
+"""
+import os, time, uuid, json, logging, requests
+from fastapi import FastAPI, Header, HTTPException
+from pydantic import BaseModel
+import psycopg2
+from psycopg2.extras import Json
+from services.a2a.jwks_jwt_verify import verify_jwt
+import boto3
+
+LOG = logging.getLogger("aegis.a2a.strict")
+APP = FastAPI(title="Aegis A2A Approver Strict")
+DB_DSN = os.environ.get("APPROVER_POSTGRES_DSN")
+JWKS_URL = os.environ.get("APPROVER_JWKS_URL")
+KMS_KEY_ID = os.environ.get("APPROVER_KMS_KEY_ID")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def get_db_conn():
+    if not DB_DSN:
+        raise RuntimeError("APPROVER_POSTGRES_DSN not set")
+    return psycopg2.connect(DB_DSN)
+
+def sign_payload(payload_bytes: bytes):
+    kms = boto3.client("kms")
+    resp = kms.sign(KeyId=KMS_KEY_ID, Message=payload_bytes, MessageType='RAW', SigningAlgorithm='RSASSA_PKCS1_V1_5_SHA_256')
+    return resp.get("Signature")
+
+class ApprovalReq(BaseModel):
+    action_id: str
+    artifact_uri: str
+    approver: str
+    decision: str  # "approved" or "denied"
+    fmea_id: str = None
+    comment: str = ""
+
+@APP.post("/request")
+def request_approval(req: ApprovalReq, authorization: str = Header(None)):
+    if not authorization:
+        raise HTTPException(status_code=401, detail="missing auth")
+    token = authorization.split("Bearer ")[-1]
+    # verify JWT signature and audience via JWKS
+    try:
+        claims = verify_jwt(token, JWKS_URL, audience=None)
+    except Exception as e:
+        raise HTTPException(status_code=403, detail=f"invalid token: {e}")
+
+    approval_id = str(uuid.uuid4())
+    ts = int(time.time())
+    record = {"id": approval_id, "action_id": req.action_id, "artifact_uri": req.artifact_uri, "approver": req.approver, "decision": req.decision, "fmea_id": req.fmea_id, "comment": req.comment, "ts": ts, "claims": claims}
+    payload = json.dumps(record).encode("utf-8")
+    signature = None
+    if KMS_KEY_ID:
+        try:
+            signature = sign_payload(payload)
+        except Exception as e:
+            LOG.error("kms sign failed: %s", e)
+    # persist to DB
+    with get_db_conn() as conn:
+        with conn.cursor() as cur:
+            cur.execute("INSERT INTO a2a_approvals (id, payload, signature, ts) VALUES (%s, %s, %s, %s)", (approval_id, Json(record), signature, ts))
+            conn.commit()
+
+    # write to MCP for auditing
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/a2a/approvals", json={"id": approval_id, "record": record, "signature": signature.hex() if signature else None}, timeout=5.0)
+    except Exception:
+        LOG.warning("failed to write approval to MCP")
+
+    return {"id": approval_id, "signed": signature is not None}
+
+@APP.get("/approve_status/{id}")
+def approve_status(id: str):
+    with get_db_conn() as conn:
+        with conn.cursor() as cur:
+            cur.execute("SELECT payload, signature FROM a2a_approvals WHERE id=%s", (id,))
+            row = cur.fetchone()
+            if not row:
+                raise HTTPException(status_code=404, detail="not found")
+            payload, signature = row
+            return {"id": id, "payload": payload, "signature": signature.hex() if signature else None, "decision": payload.get("decision")}
+
