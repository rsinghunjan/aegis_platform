+#!/usr/bin/env python3
+"""
+Guarded retrieval of encrypted originals:
+ - Requires an approval_id obtained from A2A (approver service).
+ - Confirms approval maps to artifact and decision is 'approved', then returns a presigned URL.
+ - Logs retrieval action to MCP and emits KMS-signed receipt via receipt_signer service.
+"""
+import os, logging, requests, boto3
+from fastapi import FastAPI, HTTPException, Query
+
+APP = FastAPI(title="Aegis Originals Retrieval Guard")
+S3_BUCKET = os.environ.get("ORIGINALS_S3_BUCKET", "aegis-originals")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+APPROVER_API = os.environ.get("A2A_API", "http://approver:8080")
+RECEIPT_SIGNER_API = os.environ.get("RECEIPT_SIGNER_API", "http://receipt-signer:8080/sign")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+s3 = boto3.client("s3", region_name=REGION)
+
+@APP.get("/get_original")
+def get_original(s3_key: str = Query(...), approval_id: str = Query(...), requestor: str = Query("unknown")):
+    # verify approval exists and matches artifact
+    try:
+        r = requests.get(f"{APPROVER_API.rstrip('/')}/approve_status/{approval_id}", timeout=5.0)
+        r.raise_for_status()
+        data = r.json()
+        if data.get("artifact_uri") != s3_key or data.get("decision") != "approved":
+            raise HTTPException(status_code=403, detail="invalid or not-approved")
+    except HTTPException:
+        raise
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"approver check failed: {e}")
+
+    # generate presigned URL
+    try:
+        url = s3.generate_presigned_url('get_object', Params={'Bucket': S3_BUCKET, 'Key': s3_key}, ExpiresIn=3600)
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"presign failed: {e}")
+
+    # write MCP retrieval audit
+    audit = {"s3_key": s3_key, "approval_id": approval_id, "requestor": requestor}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/pii/retrievals", json=audit, timeout=5.0)
+    except Exception as e:
+        logging.warning("failed writing retrieval audit to MCP: %s", e)
+
+    # request receipt signer to sign this retrieval event
+    try:
+        r2 = requests.post(RECEIPT_SIGNER_API, json={"event_type": "retrieval", "artifact": s3_key, "requestor": requestor, "approval_id": approval_id}, timeout=5.0)
+        r2.raise_for_status()
+    except Exception as e:
+        LOG.warning("failed to get signed receipt: %s", e)
+
+    return {"presigned_url": url}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
