+#!/usr/bin/env python3
+"""
+Lightweight FMEA service:
+ - Stores FMEA entries and allows linking HIL evidence IDs to FMEA item IDs.
+ - Writes all events to MCP for traceability.
+"""
+import os, time, json, logging
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import sqlite3, uuid, requests
+
+LOG = logging.getLogger("aegis.fmea")
+APP = FastAPI(title="Aegis FMEA Service")
+DB_PATH = os.environ.get("FMEA_DB", "/data/fmea.db")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def init_db():
+    conn = sqlite3.connect(DB_PATH)
+    c = conn.cursor()
+    c.execute("CREATE TABLE IF NOT EXISTS fmea (id TEXT PRIMARY KEY, title TEXT, description TEXT, mitigations TEXT, created_ts INTEGER)")
+    c.execute("CREATE TABLE IF NOT EXISTS hil_links (id TEXT PRIMARY KEY, fmea_id TEXT, evidence_id TEXT, ts INTEGER)")
+    conn.commit()
+    conn.close()
+
+init_db()
+
+class FMEAEntry(BaseModel):
+    title: str
+    description: str
+    mitigations: str = ""
+
+class LinkReq(BaseModel):
+    fmea_id: str
+    evidence_id: str
+
+@APP.post("/fmea")
+def create_fmea(e: FMEAEntry):
+    fid = str(uuid.uuid4())
+    ts = int(time.time())
+    conn = sqlite3.connect(DB_PATH)
+    c = conn.cursor()
+    c.execute("INSERT INTO fmea (id,title,description,mitigations,created_ts) VALUES (?,?,?,?,?)", (fid, e.title, e.description, e.mitigations, ts))
+    conn.commit()
+    conn.close()
+    # log to MCP
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/fmea", json={"id": fid, "title": e.title, "ts": ts}, timeout=5.0)
+    except Exception:
+        LOG.warning("failed writing fmea to MCP")
+    return {"id": fid}
+
+@APP.post("/link")
+def link_evidence(l: LinkReq):
+    lid = str(uuid.uuid4())
+    ts = int(time.time())
+    conn = sqlite3.connect(DB_PATH)
+    c = conn.cursor()
+    c.execute("INSERT INTO hil_links (id,fmea_id,evidence_id,ts) VALUES (?,?,?,?)", (lid, l.fmea_id, l.evidence_id, ts))
+    conn.commit()
+    conn.close()
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/fmea/links", json={"id": lid, "fmea_id": l.fmea_id, "evidence_id": l.evidence_id, "ts": ts}, timeout=5.0)
+    except Exception:
+        LOG.warning("failed writing fmea link to MCP")
+    return {"linked": True, "link_id": lid}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
