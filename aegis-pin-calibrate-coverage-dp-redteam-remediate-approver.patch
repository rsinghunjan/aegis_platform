+#!/usr/bin/env python3
+"""
+Simple blacklist service for tokens/phrases/IOCs discovered by red-team or operations.
+ - POST /blacklist {type,pattern} to add
+ - GET /blacklist returns list
+ - POST /check {text} returns matches
+Stored in Redis (REDIS_URL) for persistence.
+"""
+import os, json
+from flask import Flask, request, jsonify
+import redis
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+r = redis.from_url(REDIS_URL)
+KEY = "aegis:blacklist"
+app = Flask("blacklist")
+
+@app.route("/blacklist", methods=["POST"])
+def add():
+    b = request.json or {}
+    pat = b.get("pattern")
+    if not pat:
+        return jsonify({"error":"pattern required"}),400
+    r.hset(KEY, pat, json.dumps({"pattern":pat, "ts": int(__import__("time").time())}))
+    return jsonify({"ok":True})
+
+@app.route("/blacklist", methods=["GET"])
+def list_bl():
+    items = []
+    for k,v in r.hgetall(KEY).items():
+        items.append(json.loads(v))
+    return jsonify({"items": items})
+
+@app.route("/check", methods=["POST"])
+def check():
+    text = (request.json or {}).get("text","")
+    matches = []
+    for k,v in r.hgetall(KEY).items():
+        pat = k.decode()
+        if pat in text:
+            matches.append(pat)
+    return jsonify({"matches": matches})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8093")))
+
