+#!/usr/bin/env python3
+"""
+Simple terminal labeling helper for building a calibration dataset.
+Usage:
+  python3 label_tool.py --input candidate_texts.txt --out labeled.csv
+Each line in candidate_texts.txt is a sample to label; the tool prompts the user to enter 0/1 label.
+"""
+import argparse, csv
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--input", required=True)
+parser.add_argument("--out", required=True)
+args = parser.parse_args()
+
+with open(args.input) as fh, open(args.out, "w", newline="") as outfh:
+    w = csv.writer(outfh)
+    for ln in fh:
+        txt = ln.strip()
+        if not txt: continue
+        print("----")
+        print(txt)
+        while True:
+            lab = input("Label (1=positive contains PII/NSFW, 0=negative): ").strip()
+            if lab in ("0","1"):
+                break
+        w.writerow([txt, lab])
+
+print("Wrote labeled dataset to", args.out)
+
