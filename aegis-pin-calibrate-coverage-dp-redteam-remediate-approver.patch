+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Wrapper to fetch pinned models and verify their checksums and signatures.
+# Expects ARTIFACT_BASE (https://...) and COSIGN_KMS_URI (optional) in env.
+DEST=${1:-/opt/aegis/models}
+ART_BASE=${ARTIFACT_BASE:-""}
+mkdir -p "$DEST"
+if [ -z "$ART_BASE" ]; then
+  echo "Set ARTIFACT_BASE to your private artifact store (S3/GCS/HTTP) and re-run"
+  exit 2
+fi
+
+set -x
+# Example: fetch classifier artifact and signature
+curl -fsSL "$ART_BASE/nudenet/classifier-0.2.4.pkl" -o "$DEST/nudenet/classifier-0.2.4.pkl"
+curl -fsSL "$ART_BASE/nudenet/checksum.sha256" -o "$DEST/nudenet/checksum.sha256"
+(cd "$DEST/nudenet" && sha256sum -c checksum.sha256) || (echo "checksum failed" && exit 3)
+
+# Optional: verify cosign signature if signature artifact present (.sig or signed artifact)
+if command -v cosign >/dev/null 2>&1; then
+  if curl -fsSL --head "$ART_BASE/nudenet/classifier-0.2.4.pkl.sig" >/dev/null 2>&1; then
+    curl -fsSL "$ART_BASE/nudenet/classifier-0.2.4.pkl.sig" -o "$DEST/nudenet/classifier-0.2.4.pkl.sig"
+    cosign verify-blob --signature "$DEST/nudenet/classifier-0.2.4.pkl.sig" "$DEST/nudenet/classifier-0.2.4.pkl" || (echo "cosign-blob verify failed" && exit 4)
+  fi
+fi
+
+echo "Pinned models installed at $DEST"
+
