+from __future__ import annotations
+
+import json
+import time
+from datetime import datetime, timedelta
+from typing import Any, Dict, List
+
+from api.db import SessionLocal
+from api.golden_models import AuditEvent, UsageRecord, Run, ModelVersion
+from api.golden_store import put_json
+from api.golden_policy_versioning import policy_fingerprint, current_policy_bundle
+
+
+def export_compliance_bundle(tenant_id: str, days: int = 7) -> str:
+    """
+    Export an "audit bundle" to S3 for WORM-style retention (bucket policies can enforce immutability).
+    """
+    since = datetime.utcnow() - timedelta(days=days)
+    s = SessionLocal()
+    try:
+        audits = (
+            s.query(AuditEvent)
+            .filter(AuditEvent.tenant_id == tenant_id)
+            .filter(AuditEvent.created_at >= since)
+            .order_by(AuditEvent.created_at.asc())
+            .all()
+        )
+        usage = (
+            s.query(UsageRecord)
+            .filter(UsageRecord.tenant_id == tenant_id)
+            .filter(UsageRecord.created_at >= since)
+            .order_by(UsageRecord.created_at.asc())
+            .all()
+        )
+        runs = (
+            s.query(Run)
+            .filter(Run.tenant_id == tenant_id)
+            .filter(Run.created_at >= since)
+            .order_by(Run.created_at.asc())
+            .all()
+        )
+        mvs = s.query(ModelVersion).filter(ModelVersion.tenant_id == tenant_id).all()
+
+        payload: Dict[str, Any] = {
+            "schema": "aegis.compliance.bundle.v1",
+            "tenant_id": tenant_id,
+            "export_days": days,
+            "exported_at": time.time(),
+            "policy_fingerprint": policy_fingerprint(),
+            "policy_bundle": current_policy_bundle(),
+            "audit_events": [
+                {
+                    "id": a.id,
+                    "action": a.action,
+                    "entity_type": a.entity_type,
+                    "entity_id": a.entity_id,
+                    "actor": a.actor_sub,
+                    "decision": a.decision,
+                    "details": a.details,
+                    "created_at": a.created_at.isoformat() if a.created_at else None,
+                }
+                for a in audits
+            ],
+            "usage_records": [
+                {
+                    "id": u.id,
+                    "deployment_id": u.deployment_id,
+                    "backend": u.backend,
+                    "units": u.units,
+                    "input_tokens": u.input_tokens,
+                    "output_tokens": u.output_tokens,
+                    "cost_usd": u.cost_usd,
+                    "inference_ms": u.inference_ms,
+                    "created_at": u.created_at.isoformat() if u.created_at else None,
+                }
+                for u in usage
+            ],
+            "runs": [
+                {
+                    "id": r.id,
+                    "kind": r.kind,
+                    "status": r.status,
+                    "evidence_uri": r.evidence_uri,
+                    "metrics": r.metrics,
+                    "created_at": r.created_at.isoformat() if r.created_at else None,
+                }
+                for r in runs
+            ],
+            "model_versions": [
+                {
+                    "id": mv.id,
+                    "model_id": mv.model_id,
+                    "version": mv.version,
+                    "eval_status": mv.eval_status,
+                    "approved": mv.approved,
+                    "eval_evidence_uri": mv.eval_evidence_uri,
+                    "eval_metrics": mv.eval_metrics,
+                    "model_card_uri": mv.model_card_uri,
+                    "artifact_uri": mv.artifact_uri,
+                    "artifact_sha256": mv.artifact_sha256,
+                    "signature_type": mv.signature_type,
+                }
+                for mv in mvs
+            ],
+        }
+
+        # Store under an evidence-style path using put_json (same bucket)
+        # Place under synthetic project/model/version to reuse helper:
+        uri = put_json(
+            tenant_id=tenant_id,
+            project_id="_compliance",
+            model_id="_bundle",
+            version=str(int(time.time())),
+            name="bundle.json",
+            obj=payload,
+        )
+        return uri
+    finally:
+        s.close()
