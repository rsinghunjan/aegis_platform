+"""
+Opinionated Argo Workflow templates for HF fine-tuning.
+
+This provides a multi-step workflow:
+  1) train (container)
+  2) eval  (container)
+  3) callback to Aegis with evidence URI + metrics
+
+This is still v1: you supply container images that implement these behaviors.
+"""
+
+from __future__ import annotations
+
+import uuid
+from typing import Any, Dict, Optional
+
+
+def hf_finetune_workflow(
+    name_prefix: str,
+    train_image: str,
+    eval_image: str,
+    callback_url: str,
+    env: Dict[str, str],
+) -> Dict[str, Any]:
+    wf_name = f"{name_prefix}-{uuid.uuid4().hex[:8]}"
+    def env_list(d): return [{"name": k, "value": v} for k, v in d.items()]
+    return {
+        "apiVersion": "argoproj.io/v1alpha1",
+        "kind": "Workflow",
+        "metadata": {"name": wf_name},
+        "spec": {
+            "entrypoint": "main",
+            "templates": [
+                {
+                    "name": "main",
+                    "steps": [
+                        [{"name": "train", "template": "train"}],
+                        [{"name": "eval", "template": "eval"}],
+                        [{"name": "callback", "template": "callback"}],
+                    ],
+                },
+                {
+                    "name": "train",
+                    "container": {
+                        "image": train_image,
+                        "env": env_list(env),
+                    },
+                },
+                {
+                    "name": "eval",
+                    "container": {
+                        "image": eval_image,
+                        "env": env_list(env),
+                    },
+                },
+                {
+                    "name": "callback",
+                    "container": {
+                        "image": "curlimages/curl:8.6.0",
+                        "command": ["sh", "-lc"],
+                        "args": [
+                            "set -euo pipefail; "
+                            "echo '{\"status\":\"succeeded\",\"metrics\":{},\"evidence_uri\":\"'\"${AEGIS_EVIDENCE_URI:-}\"'\",\"model_version_id\":\"'\"${AEGIS_MODEL_VERSION_ID:-}\"'\"}' "
+                            "| curl -sS -X POST -H 'Content-Type: application/json' -H \"Authorization: Bearer ${AEGIS_JOB_JWT}\" "
+                            f" --data-binary @- {callback_url}"
+                        ],
+                        "env": env_list(env),
+                    },
+                },
+            ],
+        },
+    }
