+from __future__ import annotations
+
+from typing import Optional, Tuple
+
+from kubernetes import client
+from kubernetes.client.rest import ApiException
+
+from api.golden_k8s import _apps, _load_k8s
+
+
+def deployment_ready(namespace: str, deployment_name: str) -> Tuple[bool, str]:
+    """
+    Check if a deployment has available replicas.
+    """
+    apps = _apps()
+    try:
+        d = apps.read_namespaced_deployment(name=deployment_name, namespace=namespace)
+    except ApiException as e:
+        if e.status == 404:
+            return False, "not_found"
+        raise
+    st = d.status
+    if (st.available_replicas or 0) >= 1:
+        return True, "ready"
+    return False, "not_ready"
