+from __future__ import annotations
+
+import os
+import hashlib
+import json
+from typing import Any, Dict
+
+
+def current_policy_bundle() -> Dict[str, Any]:
+    """
+    Represent the current effective policy configuration as a dict.
+    This allows you to store a policy fingerprint in audit/evidence records.
+    """
+    return {
+        "require_eval_evidence": os.environ.get("AEGIS_REQUIRE_EVAL_EVIDENCE", "true"),
+        "metrics_thresholds": os.environ.get("AEGIS_DEPLOY_METRICS_THRESHOLDS", ""),
+        "sign_mode": os.environ.get("AEGIS_SIGN_MODE", "hmac"),
+        "tokenizer": os.environ.get("AEGIS_TOKENIZER", "tiktoken"),
+    }
+
+
+def policy_fingerprint() -> str:
+    b = json.dumps(current_policy_bundle(), sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(b).hexdigest()
