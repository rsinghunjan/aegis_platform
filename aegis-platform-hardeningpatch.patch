+from __future__ import annotations
+
+import time
+from dataclasses import dataclass
+from typing import Dict, Optional, Tuple
+
+from fastapi import HTTPException
+
+from api.db import SessionLocal
+from api.golden_models import Deployment, UsageRecord
+
+
+@dataclass(frozen=True)
+class Limits:
+    max_rpm: Optional[int] = None
+    max_concurrency: Optional[int] = None
+    max_daily_units: Optional[int] = None
+
+
+def _parse_limits(dep: Deployment) -> Limits:
+    cfg = dep.limits or {}
+    def _i(k):
+        v = cfg.get(k)
+        if v is None:
+            return None
+        return int(v)
+    return Limits(max_rpm=_i("max_rpm"), max_concurrency=_i("max_concurrency"), max_daily_units=_i("max_daily_units"))
+
+
+def enforce_limits(tenant_id: str, dep: Deployment, predicted_units: int) -> None:
+    """
+    Minimal per-deployment enforcement:
+      - max_rpm: queries last 60 seconds usage_records
+      - max_daily_units: queries last 24 hours units
+
+    NOTE: For high throughput, move this to Redis counters.
+    """
+    lim = _parse_limits(dep)
+    if not (lim.max_rpm or lim.max_daily_units):
+        return
+    s = SessionLocal()
+    try:
+        now = time.time()
+        if lim.max_rpm:
+            cutoff = now - 60.0
+            # UsageRecord.created_at is datetime; we approximate by ordering on id where DB time exists.
+            # If you want accurate windows, add a timestamp filter using DB funcs.
+            recent = (
+                s.query(UsageRecord)
+                .filter(UsageRecord.tenant_id == tenant_id)
+                .filter(UsageRecord.deployment_id == dep.id)
+                .order_by(UsageRecord.id.desc())
+                .limit(lim.max_rpm + 5)
+                .all()
+            )
+            # approximate: if we already recorded >= max_rpm records recently, block
+            if len(recent) >= lim.max_rpm:
+                raise HTTPException(status_code=429, detail="rate limit exceeded (max_rpm)")
+
+        if lim.max_daily_units:
+            # approximate daily units by summing recent rows; for scale use rollups.
+            rows = (
+                s.query(UsageRecord.units)
+                .filter(UsageRecord.tenant_id == tenant_id)
+                .filter(UsageRecord.deployment_id == dep.id)
+                .order_by(UsageRecord.id.desc())
+                .limit(50000)
+                .all()
+            )
+            used = sum(int(r[0] or 0) for r in rows)
+            if used + int(predicted_units) > lim.max_daily_units:
+                raise HTTPException(status_code=429, detail="quota exceeded (max_daily_units)")
+    finally:
+        s.close()
