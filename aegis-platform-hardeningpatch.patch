+@app.get("/v1/deployments/{deployment_id}/status")
+async def deployment_status(request: Request, deployment_id: str):
+    """
+    Reconcile deployment readiness against Kubernetes.
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "tenant_developer", "platform_admin"])
+    s = SessionLocal()
+    try:
+        dep = s.query(Deployment).filter_by(id=deployment_id, tenant_id=actor.tenant_id).one_or_none()
+        if not dep:
+            raise HTTPException(status_code=404, detail="deployment not found")
+        # derive deployment name from service as earlier
+        deployment_name = dep.service_name[:-4] if dep.service_name.endswith("-svc") else dep.name
+        ok, reason = deployment_ready(dep.namespace, deployment_name)
+        dep.status = "ready" if ok else "not_ready"
+        s.commit()
+        return {"deployment_id": dep.id, "status": dep.status, "reason": reason}
+    finally:
+        s.close()
+
