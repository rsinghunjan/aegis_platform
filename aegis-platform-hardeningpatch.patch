@@ -0,0 +1,252 @@
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Any, AsyncIterator, Dict, Optional, Tuple
+
+from api.golden_tokenizer import TokenCounter
+
+
+@dataclass
+class StreamMeter:
+    """
+    Robust-ish SSE metering:
+      - buffers partial lines across chunks
+      - extracts delta.content from OpenAI-style events
+      - tokenizes emitted content
+    """
+    counter: TokenCounter
+    buffer: str = ""
+    emitted_text: str = ""
+    done: bool = False
+
+    def feed(self, chunk: bytes) -> None:
+        s = chunk.decode("utf-8", errors="ignore")
+        self.buffer += s
+
+        # SSE events separated by double newline. Keep tail in buffer.
+        parts = self.buffer.split("\n\n")
+        self.buffer = parts[-1]
+        for evt in parts[:-1]:
+            for line in evt.splitlines():
+                line = line.strip()
+                if not line.startswith("data:"):
+                    continue
+                payload = line[len("data:") :].strip()
+                if payload == "[DONE]":
+                    self.done = True
+                    continue
+                try:
+                    j = json.loads(payload)
+                except Exception:
+                    continue
+                delta = _extract_delta_text(j)
+                if delta:
+                    self.emitted_text += delta
+
+    def output_tokens(self) -> int:
+        return self.counter.count(self.emitted_text)
+
+
+def _extract_delta_text(j: Dict[str, Any]) -> str:
+    try:
+        choices = j.get("choices") or []
+        if not choices:
+            return ""
+        delta = (choices[0] or {}).get("delta") or {}
+        c = delta.get("content")
+        return c if isinstance(c, str) else ""
+    except Exception:
+        return ""
