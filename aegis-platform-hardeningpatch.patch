+@app.post("/v1/argo/workflows/hf_finetune")
+async def argo_submit_hf_finetune(
+    request: Request,
+    namespace: Optional[str] = Form(None),
+    train_image: str = Form(...),
+    eval_image: str = Form(...),
+    run_id: str = Form(...),
+):
+    """
+    Opinionated HF fine-tuning pipeline (train->eval->callback) using Argo steps.
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "tenant_developer", "platform_admin"])
+    ns = namespace or ensure_tenant_namespace(actor.tenant_id)
+    callback_url = os.environ.get("AEGIS_PUBLIC_BASE_URL", "").rstrip("/") + f"/v1/runs/{run_id}/callback"
+    if not callback_url.strip():
+        raise HTTPException(status_code=500, detail="AEGIS_PUBLIC_BASE_URL required for hf_finetune workflow callback")
+    wf = hf_finetune_workflow(
+        name_prefix="aegis-hf-finetune",
+        train_image=train_image,
+        eval_image=eval_image,
+        callback_url=callback_url,
+        env={"AEGIS_TENANT_ID": actor.tenant_id, "AEGIS_RUN_ID": run_id},
+    )
+    name = submit_workflow(namespace=ns, workflow=wf)
+    record_audit_event(actor.tenant_id, actor.sub, "argo.workflow.submit", "workflow", name, decision="allow", details={"namespace": ns, "template": "hf_finetune"})
+    return {"workflow_name": name, "namespace": ns}
+
