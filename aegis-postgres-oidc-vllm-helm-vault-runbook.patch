+#!/usr/bin/env python3
+"""
+Run SQL migrations against a Postgres database using DATABASE_URL env var.
+Looks for SQL files in ops/langgraph/db_migrations sorted lexicographically.
+"""
+import os
+import sys
+from pathlib import Path
+import psycopg2
+
+MIGRATIONS_DIR = Path(__file__).resolve().parent / "db_migrations"
+
+def get_db_conn():
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        print("DATABASE_URL not set", file=sys.stderr)
+        sys.exit(2)
+    return psycopg2.connect(url)
+
+def apply_migrations():
+    sql_files = sorted([p for p in MIGRATIONS_DIR.iterdir() if p.suffix == ".sql"])
+    if not sql_files:
+        print("No migrations found")
+        return
+    conn = get_db_conn()
+    cur = conn.cursor()
+    for f in sql_files:
+        print("Applying", f.name)
+        sql = f.read_text()
+        cur.execute(sql)
+        conn.commit()
+    cur.close()
+    conn.close()
+    print("Migrations applied")
+
+if __name__ == "__main__":
+    apply_migrations()
+
