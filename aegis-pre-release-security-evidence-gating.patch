+#!/usr/bin/env python3
+"""
+CI guard: require COSIGN_KMS_URI (or equivalent HSM-backed signing) and forbid checked-in private cosign keys.
+
+Usage: run in CI before releasing artifacts that must be cosign-signed.
+ - Exits 0 if COSIGN_KMS_URI present and no obvious private key files found.
+ - Exits 2 (failure) otherwise.
+"""
+import os
+import sys
+from pathlib import Path
+
+FILES_TO_FORBID = [
+    "cosign.key",
+    "cosign.key.pem",
+    "cosign.key.json",
+    "cosign-private-key.pem",
+    "cosign_private_key.pem",
+    "cosign.private",
+]
+
+def check_env():
+    uri = os.environ.get("COSIGN_KMS_URI") or os.environ.get("COSIGN_KEY")
+    if not uri:
+        print("ERROR: COSIGN_KMS_URI (or COSIGN_KEY) not found in environment. Requiring HSM/KMS-backed cosign key for production signing.")
+        return False
+    # simple heuristic: if it's a file path on CI agent, fail (we require KMS/HSM style URIs such as 'kms://...' or 'awskms://...' or 'gcpkms://...')
+    if os.path.exists(uri) and Path(uri).is_file():
+        print("ERROR: COSIGN_KMS_URI appears to point to a local file - disallowed for production signing. Use KMS/HSM-backed key.")
+        return False
+    # Accept typical KMS prefixes
+    allowed_prefixes = ["awskms://", "gcpkms://", "azurekms://", "kms://", "pkcs11://", "vault://"]
+    if not any(uri.startswith(p) for p in allowed_prefixes):
+        print("WARNING: COSIGN_KMS_URI does not use a recognized KMS/HSM prefix. Ensure this is a KMS/HSM URI. Prefixes recognized:", ", ".join(allowed_prefixes))
+    print("COSIGN_KMS_URI present:", uri)
+    return True
+
+def check_repo_for_private_keys():
+    # scan repo for obvious cosign private keys
+    repo = Path(".")
+    found = []
+    for p in repo.rglob("*"):
+        if p.is_file():
+            name = p.name.lower()
+            if name in FILES_TO_FORBID:
+                found.append(str(p))
+            # also check for '-----BEGIN PRIVATE KEY-----' in checked in text files
+            try:
+                txt = p.read_text(errors="ignore")
+            except Exception:
+                continue
+            if "-----BEGIN PRIVATE KEY-----" in txt or "PRIVATE KEY" in txt and "cosign" in name:
+                found.append(str(p))
+    if found:
+        print("ERROR: Found potential private key files in repository (these must not be committed):")
+        for f in found:
+            print(" -", f)
+        return False
+    return True
+
+def main():
+    ok_env = check_env()
+    ok_repo = check_repo_for_private_keys()
+    if not ok_env or not ok_repo:
+        print("Cosign KMS/HSM requirement failed.")
+        sys.exit(2)
+    print("Cosign KMS/HSM requirement satisfied.")
+    sys.exit(0)
+
+if __name__ == "__main__":
+    main()
+
