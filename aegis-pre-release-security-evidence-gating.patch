+#!/usr/bin/env python3
+"""
+Helper to automate parts of manual recovery for evidence pipeline outages.
+ - Lists pending manifests, attempts re-sign and re-upload, and records actions in a local recovery log.
+"""
+import os
+import subprocess
+from pathlib import Path
+import time
+
+PENDING_DIR = Path(os.environ.get("EVIDENCE_PENDING_DIR", "/tmp/evidence_pending"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+RECOVERY_LOG = Path("/tmp/evidence_recovery.log")
+
+def list_pending():
+    return sorted(PENDING_DIR.glob("*.json"))
+
+def attempt_recover(p):
+    try:
+        # try cosign sign-blob via KMS
+        if os.environ.get("COSIGN_KMS_URI"):
+            subprocess.check_call(["cosign","sign-blob","--key",os.environ["COSIGN_KMS_URI"], str(p)])
+        if EVIDENCE_BUCKET:
+            subprocess.check_call(["aws","s3","cp", str(p), f"s3://{EVIDENCE_BUCKET.rstrip('/')}/evidence/"])
+        # try rekor
+        try:
+            subprocess.check_call(["rekor-cli","upload","--artifact", str(p)])
+        except Exception:
+            pass
+        return True, ""
+    except Exception as e:
+        return False, str(e)
+
+def main():
+    pend = list_pending()
+    with open(RECOVERY_LOG, "a") as fh:
+        fh.write(f"Recovery run at {time.asctime()}\n")
+        for p in pend:
+            ok, msg = attempt_recover(p)
+            if ok:
+                fh.write(f"Recovered {p}\n")
+                try: p.unlink()
+                except Exception: pass
+            else:
+                fh.write(f"Failed {p}: {msg}\n")
+    print("Recovery helper run complete; log:", RECOVERY_LOG)
+
+if __name__=="__main__":
+    main()
+
