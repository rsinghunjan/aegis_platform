+#!/usr/bin/env python3
+"""
+Lightweight key-usage monitor for AWS KMS (best-effort).
+ - Verifies KMS key exists and, if requested, queries CloudTrail for recent usage of the key.
+ - Intended to run as a periodic check in monitoring or a CI job (requires AWS creds).
+
+Usage:
+  python3 ops/security/key_usage_monitor.py --key-id alias/my-cosign-key --lookback-hours 72
+"""
+import argparse
+import os
+import time
+from datetime import datetime, timedelta
+
+def aws_kms_check(key_id, lookback_hours=72):
+    try:
+        import boto3
+    except Exception:
+        print("boto3 not installed; cannot query AWS KMS/CloudTrail")
+        return 1
+    kms = boto3.client("kms", region_name=os.environ.get("AWS_REGION"))
+    try:
+        resp = kms.describe_key(KeyId=key_id)
+        key_state = resp.get("KeyMetadata", {}).get("KeyState", "UNKNOWN")
+        print("KMS key state:", key_state)
+    except Exception as e:
+        print("Failed to describe KMS key:", e)
+        return 2
+    # optional: query CloudTrail for usage of the key
+    try:
+        ct = boto3.client("cloudtrail", region_name=os.environ.get("AWS_REGION"))
+        end = datetime.utcnow()
+        start = end - timedelta(hours=lookback_hours)
+        events = ct.lookup_events(
+            LookupAttributes=[{"AttributeKey":"ResourceName","AttributeValue": key_id}],
+            StartTime=start, EndTime=end, MaxResults=50
+        )
+        evs = events.get("Events", [])
+        print(f"Found {len(evs)} CloudTrail events referencing key {key_id} in last {lookback_hours} hours")
+    except Exception:
+        # CloudTrail may be unavailable or no permissions; it's optional
+        pass
+    return 0
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--key-id", required=True)
+    p.add_argument("--lookback-hours", type=int, default=72)
+    args = p.parse_args()
+    rc = aws_kms_check(args.key_id, args.lookback_hours)
+    raise SystemExit(rc)
+
+if __name__ == "__main__":
+    main()
+
