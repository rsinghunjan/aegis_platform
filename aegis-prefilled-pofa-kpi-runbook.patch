+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Prefilled One‑Click PoA (placeholder values; replace env or args before run)
+# Expects the following environment variables (or pass via CLI args):
+#   TARGETS             - comma-separated target host:iface (e.g. falcon-ecu-01:can0)
+#   INVARIANT           - path to TLA+ invariant file (repo path)
+#   NPU_RUNNERS         - comma-separated NPU runner hostnames
+#   GPU_FAMILY          - e.g., a100, p4d
+#   CLOUD_PROVIDER      - e.g., aws, gcp, azure
+#   COSIGN_KMS_URI      - cosign KMS URI (placeholder)
+#   REKOR_SERVER        - rekor server URL (placeholder)
+#   S3_UPLOAD           - s3://bucket/path (optional)
+# Usage:
+#   TARGETS=falcon-ecu-01:can0 INVARIANT=ops/formal/specs/safety.tla ./ops/runbooks/prefilled_one_click_pofa.sh
+
+OUT=${OUT:-/tmp/pofa_prefilled_$(date +%s)}
+mkdir -p "$OUT"
+echo "Prefilled PoA starting — OUT=$OUT"
+
+# 1) Tokenize/shard or data package step (perception or LLM)
+echo "[stage] data_prep"
+if [ -n "${DATASET:-}" ]; then
+  python3 ops/llm/tokenizer_prep.py --dataset "${DATASET}" --out "$OUT/shards" --tokenizer-out "$OUT/tokenizer" --shard-size 20000 --shuffle || true
+else
+  echo "No DATASET set; skipping LLM tokenize/shard"
+fi
+
+# 2) Validate GPU cluster (best effort)
+echo "[stage] gpu_validate"
+./ops/llm/validate_gpu_cluster.sh || true
+
+# 3) Sharded training smoke
+echo "[stage] sharded_train_smoke"
+python3 ops/llm/training_pipeline_launcher.py --shard-manifest "${OUT}/shards/shard_manifest.json" --train-cmd "${TRAIN_CMD:-./train.py}" --nodes 1 --gpus-per-node 1 --hours 0.5 --cost-slo 200 --out "$OUT/train" || true
+
+# 4) Sim + voice injection (if present)
+echo "[stage] sim_and_voice_injection"
+if [ -n "${VOICE_AUDIOS:-}" ]; then
+  python3 ops/voice/voice_poA_injector.py --sim-pack "$OUT/sim_pack" --audios $VOICE_AUDIOS --out-manifest "$OUT/voice_manifest.json" || true
+fi
+
+# 5) Run RT sweeps for targets
+echo "[stage] rt_sweeps"
+if [ -n "${TARGETS:-}" ]; then
+  python3 ops/validation/run_hw_rt_sweep_fleet.py --targets-yaml conf/hw_targets_exact.yaml --out "$OUT/rt" --cosign "${COSIGN_KMS_URI:-}" --s3 "${S3_UPLOAD:-}" || true
+else
+  echo "No TARGETS set; skipping RT sweeps"
+fi
+
+# 6) HIL + Apalache invariant closure
+echo "[stage] hil_apalache"
+if [ -n "${INVARIANT:-}" ]; then
+  python3 ops/robotics/control/hil_apalache_pipeline.py --scenarios ops/av/certification/falcon_scenarios.txt --spec "$INVARIANT" --out "$OUT/hil" --cosign "${COSIGN_KMS_URI:-}" || true
+else
+  echo "No INVARIANT set; skipping Apalache run"
+fi
+
+# 7) Bundle and sign auditor bundle
+echo "[stage] auditor_bundle"
+python3 ops/certifier/auditor_package_allinone.py --root . --vehicle "Prefilled-PoA" --out "$OUT/auditor_bundle.tar.gz" --cosign-key "${COSIGN_KMS_URI:-}" --s3 "${S3_UPLOAD:-}" || true
+
+# 8) Emit PoA report placeholder (pofa_report.json expected to be created by substeps)
+echo "[stage] finalize_report"
+if [ ! -f "$OUT/pofa_report.json" ]; then
+  cat > "$OUT/pofa_report.json" <<JSON
+{
+  "started_at":"$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
+  "ended_at":"$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
+  "total_duration_s": 0,
+  "stages": []
+}
+JSON
+fi
+
+echo "Prefilled PoA finished. Outputs in $OUT"
+echo "Next: run python3 ops/metrics/kpi_baseline_template.py --report $OUT/pofa_report.json --out $OUT/pofa_kpi_baseline.json"
+
