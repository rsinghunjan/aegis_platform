+#!/usr/bin/env python3
+"""
+Compare two KPI baseline JSONs (before and after) and produce a small report.
+Usage:
+  python3 ops/metrics/compare_kpi_reports.py --before before.json --after after.json --out diff.json
+"""
+import argparse, json, os
+
+def load(path):
+    return json.load(open(path)) if os.path.exists(path) else {}
+
+def compare(b,a):
+    diff={}
+    diff["delta_total_duration_s"] = a.get("pofa_total_duration_s",0) - b.get("pofa_total_duration_s",0)
+    diff["delta_stage_count"] = a.get("pofa_stage_count",0) - b.get("pofa_stage_count",0)
+    diff["delta_human_hours_saved"] = b.get("human_hours_before",0) - a.get("human_hours_after",0)
+    return diff
+
+if __name__=="__main__":
+    p=argparse.ArgumentParser()
+    p.add_argument("--before", required=True)
+    p.add_argument("--after", required=True)
+    p.add_argument("--out", required=True)
+    args=p.parse_args()
+    before=load(args.before)
+    after=load(args.after)
+    diff=compare(before,after)
+    with open(args.out,"w") as fh:
+        json.dump({"before":before,"after":after,"diff":diff}, fh, indent=2)
+    print("Wrote comparison to", args.out)
+
