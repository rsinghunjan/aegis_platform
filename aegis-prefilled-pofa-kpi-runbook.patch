+#!/usr/bin/env python3
+"""
+Produce a KPI baseline JSON from a PoA report.
+Usage:
+  python3 ops/metrics/kpi_baseline_template.py --report /path/to/pofa_report.json --out /path/to/baseline.json
+"""
+import argparse, json, os, time
+
+def load_report(path):
+    if not os.path.exists(path):
+        return {}
+    return json.load(open(path))
+
+def synthesize_baseline(report):
+    r = report or {}
+    total = r.get("total_duration_s", 0)
+    stages = r.get("stages", [])
+    human_before = r.get("human_hours_before", 0)
+    human_after = r.get("human_hours_after", 0)
+    baseline = {
+        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "pofa_total_duration_s": total,
+        "pofa_stage_count": len(stages),
+        "human_hours_before": human_before,
+        "human_hours_after": human_after,
+        "stages": stages
+    }
+    return baseline
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--report", required=True)
+    p.add_argument("--out", required=True)
+    args = p.parse_args()
+    report = load_report(args.report)
+    baseline = synthesize_baseline(report)
+    with open(args.out,"w") as fh:
+        json.dump(baseline, fh, indent=2)
+    print("Wrote KPI baseline to", args.out)
+
