+#!/usr/bin/env python3
+"""
+Run a grid sweep over Opacus DP parameters (noise_multiplier, sample_rate) using a small local training job.
+Logs results to MLflow and writes CSV summary with epsilon vs accuracy.
+
+Usage:
+  python3 services/fl/privacy_tune/tune_runner.py --out results.csv --noise 0.5 1.0 1.5 --sr 0.01 0.02
+
+Notes:
+ - Uses local training (services/fl/examples/local_train.py model) for speed and repeatability.
+ - Requires opacus installed. Computes epsilon via privacy_engine.get_privacy_spent(delta).
+"""
+import argparse, itertools, csv, time, os, subprocess, json
+import mlflow
+from math import isfinite
+
+def run_trial(noise, sample_rate, epochs=3, batch_size=32):
+    # Run the built-in local trainer script modified to accept DP params and print epsilon/accuracy to stdout as JSON
+    cmd = f"python3 services/fl/privacy_tune/local_dp_train.py --noise {noise} --sample-rate {sample_rate} --epochs {epochs} --batch-size {batch_size}"
+    print("Running:", cmd)
+    proc = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+    out = proc.stdout + proc.stderr
+    # Look for JSON line in output
+    j = None
+    for line in out.splitlines()[::-1]:
+        if line.strip().startswith("{") and line.strip().endswith("}"):
+            try:
+                j = json.loads(line.strip())
+                break
+            except Exception:
+                continue
+    if j is None:
+        raise RuntimeError("Trial did not output JSON result. Full output:\n" + out)
+    return j
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--noise", nargs="+", type=float, required=True)
+    p.add_argument("--sr", "--sample-rate", dest="srs", nargs="+", type=float, required=True)
+    p.add_argument("--out", default="/tmp/privacy_tune_results.csv")
+    p.add_argument("--mlflow-expt", default="fl-privacy-tuning")
+    args = p.parse_args()
+    mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+    mlflow.set_experiment(args.mlflow_expt)
+    rows=[]
+    for noise, sr in itertools.product(args.noise, args.srs):
+        try:
+            res = run_trial(noise, sr)
+            # res expected: {"epsilon":.., "accuracy":.., "noise":.., "sample_rate":..}
+            with mlflow.start_run(run_name=f"noise{noise}_sr{sr}"):
+                mlflow.log_param("noise", noise)
+                mlflow.log_param("sample_rate", sr)
+                mlflow.log_metric("epsilon", res.get("epsilon"))
+                mlflow.log_metric("accuracy", res.get("accuracy"))
+                mlflow.log_artifact(res.get("record_path"), artifact_path="privacy_records")
+            rows.append(res)
+        except Exception as e:
+            print("Trial failed for noise", noise, "sr", sr, e)
+    # write CSV
+    with open(args.out, "w", newline="") as fh:
+        writer = csv.DictWriter(fh, fieldnames=["noise","sample_rate","epsilon","accuracy","record_path"])
+        writer.writeheader()
+        for r in rows:
+            writer.writerow({"noise": r.get("noise"), "sample_rate": r.get("sample_rate"), "epsilon": r.get("epsilon"), "accuracy": r.get("accuracy"), "record_path": r.get("record_path")})
+    print("Wrote", args.out)
+
+if __name__=="__main__":
+    main()
+
