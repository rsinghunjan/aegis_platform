+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Generate CA and server cert for admission webhook; stores K8s secret and prints base64 CA bundle for VWC.
+# Usage: ops/webhook/generate_ca.sh <namespace> <svc-name> <secret-name>
+NAMESPACE=${1:-aegis}
+SVC=${2:-aegis-webhook}
+SECRET=${3:-aegis-webhook-tls}
+COMMON_NAME="${SVC}.${NAMESPACE}.svc"
+TMP=$(mktemp -d)
+cd "$TMP"
+cat > ca.conf <<EOF
+[req]
+distinguished_name = req_distinguished_name
+prompt = no
+[req_distinguished_name]
+CN = Aegis Test CA
+EOF
+
+openssl genrsa -out ca.key 2048
+openssl req -x509 -new -nodes -key ca.key -days 3650 -out ca.crt -config ca.conf
+
+cat > server.conf <<EOF
+[req]
+distinguished_name = req_distinguished_name
+prompt = no
+[req_distinguished_name]
+CN = ${COMMON_NAME}
+[SAN]
+subjectAltName = DNS:${SVC},DNS:${SVC}.${NAMESPACE}.svc,DNS:${SVC}.${NAMESPACE}.svc.cluster.local
+EOF
+
+openssl genrsa -out server.key 2048
+openssl req -new -key server.key -out server.csr -config server.conf
+openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -days 365 -sha256 -extfile <(printf "subjectAltName=DNS:%s,DNS:%s.svc,DNS:%s.svc.cluster.local" "${SVC}" "${SVC}.${NAMESPACE}" "${SVC}.${NAMESPACE}.svc.cluster.local")
+
+kubectl create secret tls "${SECRET}" -n "${NAMESPACE}" --cert=server.crt --key=server.key --dry-run=client -o yaml | kubectl apply -f -
+kubectl create secret generic "${SECRET}-ca" -n "${NAMESPACE}" --from-file=ca.crt --dry-run=client -o yaml | kubectl apply -f -
+
+echo "CA bundle (base64) to paste into ValidatingWebhookConfiguration:"
+cat ca.crt | base64 | tr -d '\n'
+echo
+echo "Wrote k8s secrets: ${SECRET}, ${SECRET}-ca in namespace ${NAMESPACE}"
+rm -rf "$TMP"
+
