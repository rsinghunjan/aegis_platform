+#!/usr/bin/env bash
+set -euo pipefail
+# Template generator: produce ValidatingWebhookConfiguration YAML using CA bundle
+NAMESPACE=${1:-aegis}
+SVC=${2:-aegis-admission-webhook}
+CA_BUNDLE=${3:-}
+if [ -z "$CA_BUNDLE" ]; then
+  echo "Usage: $0 <namespace> <service> <ca-bundle-base64>"
+  exit 2
+fi
+cat > /tmp/vwc.yaml <<EOF
+apiVersion: admissionregistration.k8s.io/v1
+kind: ValidatingWebhookConfiguration
+metadata:
+  name: aegis-validating-webhook
+webhooks:
+  - name: aegis.aegis.local
+    clientConfig:
+      service:
+        name: ${SVC}
+        namespace: ${NAMESPACE}
+        path: "/validate-job"
+      caBundle: ${CA_BUNDLE}
+    sideEffects: None
+    admissionReviewVersions: ["v1"]
+    failurePolicy: Fail
+    rules:
+      - operations: ["CREATE","UPDATE"]
+        apiGroups: ["batch"]
+        apiVersions: ["v1"]
+        resources: ["jobs"]
+EOF
+echo "Generated /tmp/vwc.yaml; apply with kubectl apply -f /tmp/vwc.yaml"
