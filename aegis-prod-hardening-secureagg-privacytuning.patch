+#!/usr/bin/env python3
+"""
+Local DP training harness used by privacy_tune.tune_runner.
+Trains a tiny model with Opacus and prints JSON result: epsilon & accuracy & record path.
+"""
+import argparse, json, os, torch, numpy as np
+from torch.utils.data import TensorDataset, DataLoader
+import torch.nn as nn, torch.optim as optim
+from opacus import PrivacyEngine
+
+def get_data(n=500):
+    x = np.random.rand(n,1,28,28).astype('float32')
+    y = np.random.randint(0,10,size=(n,)).astype('int64')
+    ds = TensorDataset(torch.tensor(x), torch.tensor(y))
+    return ds
+
+class ToyModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.net = nn.Sequential(nn.Flatten(), nn.Linear(28*28, 128), nn.ReLU(), nn.Linear(128, 10))
+    def forward(self,x): return self.net(x)
+
+def train(noise, sample_rate, epochs, batch_size):
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    ds = get_data(1000)
+    loader = DataLoader(ds, batch_size=batch_size, shuffle=True)
+    model = ToyModel().to(device)
+    opt = optim.Adam(model.parameters(), lr=1e-3)
+    criterion = nn.CrossEntropyLoss()
+    privacy_engine = PrivacyEngine(
+        model,
+        sample_rate=sample_rate,
+        noise_multiplier=noise,
+        max_grad_norm=1.0,
+    )
+    privacy_engine.attach(opt)
+    for epoch in range(epochs):
+        for xb,yb in loader:
+            xb,yb = xb.to(device), yb.to(device)
+            opt.zero_grad()
+            out = model(xb)
+            loss = criterion(out,yb)
+            loss.backward()
+            opt.step()
+    # compute epsilon for delta = 1e-5
+    try:
+        eps, best_alpha = privacy_engine.get_privacy_spent(delta=1e-5)
+    except Exception:
+        try:
+            eps = privacy_engine.accountant.get_epsilon(delta=1e-5)
+        except Exception:
+            eps = None
+    # evaluate accuracy on small holdout
+    acc = 0.0
+    model.eval()
+    with torch.no_grad():
+        xb,yb = next(iter(loader))
+        preds = model(xb.to(device)).argmax(dim=1)
+        acc = (preds.cpu() == yb).float().mean().item()
+    # write record
+    rec = {"epsilon": eps, "accuracy": acc, "noise": noise, "sample_rate": sample_rate}
+    outdir = "/tmp/privacy_tune"
+    os.makedirs(outdir, exist_ok=True)
+    path = os.path.join(outdir, f"record_{int(time.time())}.json")
+    with open(path,"w") as fh:
+        json.dump(rec, fh)
+    # print JSON to stdout (tune_runner will parse)
+    print(json.dumps({"epsilon": eps, "accuracy": acc, "noise": noise, "sample_rate": sample_rate, "record_path": path}))
+    return rec
+
+if __name__=="__main__":
+    p=argparse.ArgumentParser()
+    p.add_argument("--noise", type=float, required=True)
+    p.add_argument("--sample-rate", type=float, required=True)
+    p.add_argument("--epochs", type=int, default=3)
+    p.add_argument("--batch-size", type=int, default=32)
+    args=p.parse_args()
+    train(args.noise, args.sample_rate, args.epochs, args.batch_size)
+
