+#!/usr/bin/env python3
+"""
+Invalidation / Tag indexing service.
+- Maintains mapping from tag -> set(keys) in Redis for O(1) invalidation of tagged cache entries.
+- Audit logs each invalidation event (to file or S3 if configured).
+Usage:
+  POST /set_key_tags {"key": "<cache_key>", "tags": ["model:v1","policy:p123"]}
+  POST /invalidate_tags {"tags": ["model:v1"]}
+  POST /invalidate_key {"key": "<cache_key>"}
+  GET  /status
+"""
+import os
+import json
+import logging
+import time
+from typing import List
+from fastapi import FastAPI, Request
+import redis
+
+LOG = logging.getLogger("aegis.cache.index")
+logging.basicConfig(level=logging.INFO)
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://localhost:6379/0")
+AUDIT_PATH = os.environ.get("AUDIT_PATH", "/var/lib/aegis/cache_audit")
+NAMESPACE = os.environ.get("CACHE_NAMESPACE", "aegis:cache")
+
+r = redis.from_url(REDIS_URL, decode_responses=True)
+
+app = FastAPI(title="Aegis Cache Index / Invalidator")
+
+def audit_record(event: dict):
+    os.makedirs(AUDIT_PATH, exist_ok=True)
+    ts = int(time.time())
+    fname = os.path.join(AUDIT_PATH, f"audit_{ts}.json")
+    with open(fname, "w") as fh:
+        fh.write(json.dumps(event))
+    # Placeholder: cosign sign the artifact or upload to S3 if configured.
+    LOG.info("Wrote audit: %s", fname)
+
+@app.post("/set_key_tags")
+async def set_key_tags(req: Request):
+    body = await req.json()
+    key = body["key"]
+    tags: List[str] = body.get("tags", [])
+    for t in tags:
+        # store set of keys per tag
+        try:
+            r.sadd(f"{NAMESPACE}:tag:{t}", key)
+        except Exception:
+            LOG.exception("sadd failed")
+    # Optionally store key->tags mapping for cleanup
+    try:
+        r.set(f"{NAMESPACE}:key:{key}:tags", json.dumps(tags))
+    except Exception:
+        LOG.exception("set key tags failed")
+    audit_record({"action":"set_key_tags","key":key,"tags":tags,"ts":int(time.time())})
+    return {"status":"ok"}
+
+@app.post("/invalidate_tags")
+async def invalidate_tags(req: Request):
+    body = await req.json()
+    tags: List[str] = body.get("tags", [])
+    evicted = 0
+    affected_keys = []
+    for t in tags:
+        set_key = f"{NAMESPACE}:tag:{t}"
+        try:
+            members = r.smembers(set_key) or []
+            for k in members:
+                # delete actual cache key namespaced in Redis (convention)
+                try:
+                    r.delete(f"{NAMESPACE}:entry:{k}")
+                    evicted += 1
+                    affected_keys.append(k)
+                except Exception:
+                    LOG.exception("delete entry failed for %s", k)
+            # remove tag set
+            r.delete(set_key)
+        except Exception:
+            LOG.exception("scan tag failed %s", t)
+    audit_record({"action":"invalidate_tags","tags":tags,"evicted":evicted,"keys":affected_keys,"ts":int(time.time())})
+    return {"status":"ok","evicted":evicted,"keys":affected_keys}
+
+@app.post("/invalidate_key")
+async def invalidate_key(req: Request):
+    body = await req.json()
+    key = body["key"]
+    # delete entry and remove from tag sets if key->tags mapping present
+    try:
+        r.delete(f"{NAMESPACE}:entry:{key}")
+        tags_json = r.get(f"{NAMESPACE}:key:{key}:tags")
+        if tags_json:
+            tags = json.loads(tags_json)
+            for t in tags:
+                r.srem(f"{NAMESPACE}:tag:{t}", key)
+        r.delete(f"{NAMESPACE}:key:{key}:tags")
+    except Exception:
+        LOG.exception("invalidate_key failed")
+    audit_record({"action":"invalidate_key","key":key,"ts":int(time.time())})
+    return {"status":"ok"}
+
+@app.get("/status")
+async def status():
+    try:
+        pong = r.ping()
+    except Exception:
+        pong = False
+    return {"redis": bool(pong)}
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", "8082")), log_level="info")
+
