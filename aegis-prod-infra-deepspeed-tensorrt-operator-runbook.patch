+"""Helper utilities for audit logging and optional cosign signing (placeholder)."""
+import os, subprocess, logging
+
+LOG = logging.getLogger("aegis.cache.audit")
+logging.basicConfig(level=logging.INFO)
+
+def sign_artifact(path: str, cosign_kms_uri: str = None):
+    if not cosign_kms_uri:
+        LOG.info("No cosign KMS provided; skipping sign")
+        return
+    try:
+        subprocess.run(["cosign", "sign-blob", "--key", cosign_kms_uri, path], check=True)
+        LOG.info("Signed artifact %s", path)
+    except Exception:
+        LOG.exception("cosign sign failed")
