+#!/usr/bin/env python3
+"""
+Minimal example training script intended to be run with DeepSpeed.
+Replace model/data logic with real training code.
+"""
+import argparse
+import torch
+import torch.nn as nn
+import deepspeed
+
+class DummyModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.lin = nn.Linear(768, 768)
+    def forward(self, x):
+        return self.lin(x)
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--local_rank", type=int, default=0)
+    parser.add_argument("--train-steps", type=int, default=100)
+    args = parser.parse_args()
+
+    model = DummyModel()
+    parameters = filter(lambda p: p.requires_grad, model.parameters())
+    model_engine, optimizer, _, _ = deepspeed.initialize(args=args, model=model, model_parameters=parameters)
+
+    for step in range(args.train_steps):
+        x = torch.randn(4, 768).cuda()
+        loss = model_engine(x).norm()
+        model_engine.backward(loss)
+        model_engine.step()
+        if step % 10 == 0:
+            print(f"step {step} loss={loss.item()}")
+
+if __name__ == "__main__":
+    main()
+
