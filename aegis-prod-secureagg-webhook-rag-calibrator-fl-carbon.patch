+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Provision an FL client: create keypair (ed25519), create a simple CSR (self-signed), and store metadata in Vault.
+#
+OWNER=${1:-operator@example.com}
+VAULT_PATH=${VAULT_FL_CLIENTS:-secret/data/aegis/fl/clients}
+CLIENT_ID=${2:-"client-$(date +%s)"}
+TMP=$(mktemp -d)
+cd "$TMP"
+openssl genpkey -algorithm ED25519 -out key.pem
+openssl req -new -key key.pem -subj "/CN=${CLIENT_ID}/O=${OWNER}" -out req.csr
+openssl x509 -req -in req.csr -signkey key.pem -out cert.pem -days 365
+kubectl create secret generic "fl-client-${CLIENT_ID}" -n aegis --from-file=key.pem --from-file=cert.pem --dry-run=client -o yaml | kubectl apply -f -
+echo "Storing registration record to Vault (requires vault CLI configured)..."
+vault kv put "${VAULT_PATH}/${CLIENT_ID}" client_id="${CLIENT_ID}" owner="${OWNER}" cert_b64="$(base64 -w 0 cert.pem)" registered_at="$(date +%s)"
+echo "Provisioned client ${CLIENT_ID}, certificate stored in k8s secret fl-client-${CLIENT_ID}"
+rm -rf "$TMP"
+
