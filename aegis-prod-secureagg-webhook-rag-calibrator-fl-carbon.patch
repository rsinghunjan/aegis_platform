+#!/usr/bin/env python3
+"""
+Utility to map Flower Parameters (ndarray list) to a PyTorch state_dict.
+Assumes you provide an example model_state_dict keys ordering via
+ a JSON file listing the state_dict keys in order.
+
+Usage:
+  python3 services/fl/param_mapper.py --params params.npy --keys keys.json --out /tmp/state_dict.pth
+
+Note: mapping depends on the model architecture. For robust mapping:
+ - Save and reuse key order from a canonical model instance
+ - Ensure dtype/shape matching
+"""
+import argparse, json, numpy as np
+import torch, os
+
+def map_params(params_npy, keys_json, out_path):
+    params = np.load(params_npy, allow_pickle=True)
+    keys = json.load(open(keys_json))
+    if len(params) != len(keys):
+        raise RuntimeError("Params length != keys length")
+    state = {}
+    for k, arr in zip(keys, params):
+        state[k] = torch.tensor(arr)
+    torch.save(state, out_path)
+    print("Wrote torch state_dict to", out_path)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--params", required=True)
+    p.add_argument("--keys", required=True)
+    p.add_argument("--out", required=True)
+    args = p.parse_args()
+    map_params(args.params, args.keys, args.out)
+
