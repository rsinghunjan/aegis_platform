+#!/usr/bin/env python3
+"""
+Calibrator inference service:
+ - Loads joblib pipeline (TFIDF + LogisticRegression) and exposes /score endpoint.
+ - Returns JSON {"score": float} where score is the calibrated probability [0,1].
+ - Thresholds can be stored in Vault (not implemented here) or passed via env (CALIBRATOR_THRESHOLD).
+"""
+import os, joblib, json
+from flask import Flask, request, jsonify
+
+MODEL_PATH = os.environ.get("CALIBRATOR_MODEL_PATH","/models/calibrator.joblib")
+THRESH = float(os.environ.get("CALIBRATOR_THRESHOLD","0.8"))
+
+app = Flask(__name__)
+model = None
+
+def load_model():
+    global model
+    model = joblib.load(MODEL_PATH)
+
+@app.route("/score", methods=["POST"])
+def score():
+    body = request.get_json()
+    text = body.get("text","")
+    if model is None:
+        return jsonify({"error":"model not loaded"}), 500
+    prob = float(model.predict_proba([text])[0,1])
+    ok = prob >= THRESH
+    return jsonify({"score": prob, "pass": ok, "threshold": THRESH})
+
+@app.route("/healthz", methods=["GET"])
+def health():
+    return jsonify({"ok": True})
+
+if __name__=="__main__":
+    if not os.path.exists(MODEL_PATH):
+        raise SystemExit("Model not found at " + MODEL_PATH)
+    load_model()
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8201")))
