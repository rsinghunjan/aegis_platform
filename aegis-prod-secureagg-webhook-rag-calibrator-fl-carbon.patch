+#!/usr/bin/env python3
+"""
+Small helper to sample GPU power via nvidia-smi and write CSV telemetry.
+ - Requires nvidia-smi on path
+ - Writes: iso_ts,power_w per line
+ - Use this output with services/carbon/merge_telemetry.py
+"""
+import subprocess, time, csv, argparse, datetime, os
+
+def sample(output_csv, interval=1, duration=60):
+    end = time.time() + duration
+    with open(output_csv, "w", newline="") as fh:
+        w = csv.writer(fh)
+        while time.time() < end:
+            ts = datetime.datetime.utcnow().isoformat()
+            try:
+                out = subprocess.check_output(["nvidia-smi","--query-gpu=power.draw","--format=csv,noheader,nounits"], timeout=2)
+                power = float(out.decode().strip().splitlines()[0])
+            except Exception:
+                power = 0.0
+            w.writerow([ts, power])
+            fh.flush()
+            time.sleep(interval)
+    print("Wrote telemetry to", output_csv)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", required=True)
+    p.add_argument("--interval", type=int, default=1)
+    p.add_argument("--duration", type=int, default=60)
+    args = p.parse_args()
+    sample(args.out, args.interval, args.duration)
