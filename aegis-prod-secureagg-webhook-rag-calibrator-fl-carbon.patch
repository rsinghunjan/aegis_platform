+#!/usr/bin/env python3
+"""
+Production-ready admission webhook server skeleton.
+ - Implements Kubernetes AdmissionReview v1 request/response
+ - Loads TLS cert/key from /etc/webhook/certs/tls.crt / tls.key (mounted secret)
+ - Endpoint: POST /validate-job
+
+The server validates Job manifests for carbon scheduling and high-risk annotations.
+"""
+import os
+import json
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+GREEN_LABEL_KEY = os.environ.get("GREEN_LABEL_KEY","carbon")
+GREEN_LABEL_VAL = os.environ.get("GREEN_LABEL_VAL","green")
+
+def is_job_carbon_heavy(job):
+    # Heuristic: annotation carbon/sensitivity == "high" OR cpu limit >= 8
+    ann = job.get("metadata",{}).get("annotations",{})
+    if ann and ann.get("carbon/sensitivity","").lower() == "high":
+        return True
+    spec = job.get("spec",{}).get("template",{}).get("spec",{})
+    for c in spec.get("containers",[]):
+        limits = c.get("resources",{}).get("limits",{})
+        cpu = limits.get("cpu")
+        try:
+            if cpu:
+                if str(cpu).endswith("m"):
+                    cpu_val = float(cpu[:-1]) / 1000.0
+                else:
+                    cpu_val = float(cpu)
+                if cpu_val >= 8:
+                    return True
+        except Exception:
+            continue
+    return False
+
+def admission_response(uid, allowed, status_message=None):
+    resp = {
+        "apiVersion": "admission.k8s.io/v1",
+        "kind": "AdmissionReview",
+        "response": {
+            "uid": uid,
+            "allowed": allowed,
+        }
+    }
+    if status_message is not None:
+        resp["response"]["status"] = {"message": status_message}
+    return resp
+
+@app.route("/validate-job", methods=["POST"])
+def validate_job():
+    body = request.get_json()
+    req = body.get("request", {})
+    uid = req.get("uid")
+    obj = req.get("object", {})
+    # If annotated allow_anywhere => allow
+    ann = obj.get("metadata",{}).get("annotations",{})
+    if ann and ann.get("carbon/allow_anywhere","").lower() in ("1","true","yes"):
+        return jsonify(admission_response(uid, True, "explicit allow"))
+    heavy = is_job_carbon_heavy(obj)
+    if not heavy:
+        return jsonify(admission_response(uid, True, "not carbon-heavy"))
+    # require nodeSelector carbon=green
+    spec = obj.get("spec",{}).get("template",{}).get("spec",{})
+    node_sel = spec.get("nodeSelector",{}) or {}
+    if node_sel.get(GREEN_LABEL_KEY) == GREEN_LABEL_VAL:
+        return jsonify(admission_response(uid, True, "targeting green nodepool"))
+    return jsonify(admission_response(uid, False, "carbon-heavy job must target green nodepool or set allow_anywhere"))
+
+@app.route("/healthz", methods=["GET"])
+def health():
+    return jsonify({"ok": True})
+
+if __name__=="__main__":
+    # When run directly, Flask will use its builtin server (not suitable for prod).
+    # In k8s, container should be served behind a WSGI server (gunicorn) using mounted TLS secrets.
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8443")))
+
