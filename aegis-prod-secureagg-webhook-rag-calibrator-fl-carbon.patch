+#!/usr/bin/env python3
+"""
+Lightweight Kubernetes controller that watches Job creations and automatically
+patches carbon-heavy jobs to target green nodepools if available.
+
+This is a convenience controller; for production, implement as a proper controller-runtime operator.
+"""
+import os, time, threading
+from kubernetes import client, config, watch
+
+NAMESPACE = os.environ.get("NAMESPACE","aegis")
+GREEN_LABEL_KEY = os.environ.get("GREEN_LABEL_KEY","carbon")
+GREEN_LABEL_VAL = os.environ.get("GREEN_LABEL_VAL","green")
+
+def find_green_node():
+    v1 = client.CoreV1Api()
+    nodes = v1.list_node().items
+    for n in nodes:
+        if n.metadata.labels and n.metadata.labels.get(GREEN_LABEL_KEY) == GREEN_LABEL_VAL:
+            return n.metadata.name
+    return None
+
+def patch_job_node_selector(api, job):
+    name = job.metadata.name
+    body = {"spec":{"template":{"spec":{"nodeSelector": {GREEN_LABEL_KEY: GREEN_LABEL_VAL}}}}}
+    try:
+        api.patch_namespaced_job(name=name, namespace=NAMESPACE, body=body)
+        print("Patched job", name, "to nodeSelector", GREEN_LABEL_KEY,"=",GREEN_LABEL_VAL)
+    except Exception as e:
+        print("Failed to patch job", name, e)
+
+def main():
+    config.load_incluster_config()
+    batch = client.BatchV1Api()
+    w = watch.Watch()
+    for ev in w.stream(batch.list_namespaced_job, namespace=NAMESPACE, timeout_seconds=0):
+        typ = ev['type']
+        obj = ev['object']
+        if typ == "ADDED":
+            ann = obj.metadata.annotations or {}
+            if ann.get("carbon/sensitivity","").lower() == "high":
+                # attempt to patch to green nodepool
+                node = find_green_node()
+                if node:
+                    patch_job_node_selector(batch, obj)
+                else:
+                    print("No green node available for job", obj.metadata.name)
+
+if __name__=="__main__":
+    try:
+        config.load_kube_config()
+    except Exception:
+        config.load_incluster_config()
+    main()
+
