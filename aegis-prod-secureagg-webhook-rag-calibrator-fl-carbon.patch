+#!/usr/bin/env python3
+"""
+RAG retriever integrated with embedding service and Milvus vector store.
+ - Uses embedding HTTP API or local embedder and pymilvus client.
+ - Returns top-k documents with scores and metadata.
+
+Config (env):
+ - EMBEDDING_API (http endpoint that returns embeddings for texts)
+ - MILVUS_HOST, MILVUS_PORT, MILVUS_COLLECTION (for pymilvus)
+"""
+import os
+import requests
+from typing import List, Dict
+
+MILVUS_HOST = os.environ.get("MILVUS_HOST","localhost")
+MILVUS_PORT = int(os.environ.get("MILVUS_PORT","19530"))
+MILVUS_COLLECTION = os.environ.get("MILVUS_COLLECTION","aegis_docs")
+EMBEDDING_API = os.environ.get("EMBEDDING_API","http://embedder:8000/embed")
+
+def embed_text(text: str):
+    r = requests.post(EMBEDDING_API, json={"texts":[text]}, timeout=10)
+    r.raise_for_status()
+    embs = r.json().get("embeddings", [])
+    return embs[0] if embs else None
+
+def query_milvus_vector(vector, k=5):
+    try:
+        from pymilvus import connections, utility, Collection
+        connections.connect(host=MILVUS_HOST, port=str(MILVUS_PORT))
+        if not utility.has_collection(MILVUS_COLLECTION):
+            return []
+        coll = Collection(MILVUS_COLLECTION)
+        res = coll.search([vector], "embedding", param={"metric_type":"L2"}, limit=k)
+        # res: list of lists of Hits
+        docs=[]
+        for hit in res[0]:
+            docs.append({"score": float(hit.distance), "text": hit.entity.get("text",""), "source": hit.entity.get("source","")})
+        return docs
+    except Exception as e:
+        # fallback to HTTP milvus proxy if available
+        proxy = os.environ.get("MILVUS_HTTP_PROXY")
+        if proxy:
+            r = requests.post(proxy, json={"vector": vector, "k": k}, timeout=10)
+            r.raise_for_status()
+            return r.json().get("results", [])
+        print("Milvus query failed:", e)
+        return []
+
+def retrieve(query: str, k: int = 5) -> List[Dict]:
+    vec = embed_text(query)
+    if vec is None:
+        return []
+    return query_milvus_vector(vec, k)
+
+if __name__=="__main__":
+    print(retrieve("What is the refund policy?", k=3))
+
