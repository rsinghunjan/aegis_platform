+#!/usr/bin/env python3
+"""
+Train a calibrator (simple logistic regression) on embedding-level features.
+ - Input: labeled CSV with columns: text,label (0/1)
+ - Outputs: joblib model at out_path and an MLflow artifact registration optional
+"""
+import argparse, pandas as pd, joblib, os
+from sklearn.linear_model import LogisticRegression
+from sklearn.feature_extraction.text import TfidfVectorizer
+from sklearn.pipeline import Pipeline
+import mlflow
+
+def train(in_csv, out_path, mlflow_expt=None):
+    df = pd.read_csv(in_csv)
+    X = df["text"].astype(str).tolist()
+    y = df["label"].astype(int).tolist()
+    pipe = Pipeline([("tfidf", TfidfVectorizer(max_features=10000)), ("clf", LogisticRegression(max_iter=1000))])
+    pipe.fit(X, y)
+    os.makedirs(os.path.dirname(out_path), exist_ok=True)
+    joblib.dump(pipe, out_path)
+    if mlflow_expt:
+        mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI","http://mlflow:5000"))
+        mlflow.set_experiment(mlflow_expt)
+        with mlflow.start_run():
+            mlflow.log_param("model", "logistic_tfidf")
+            mlflow.log_artifact(out_path, artifact_path="calibrators")
+    print("Wrote calibrator to", out_path)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="inp", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--mlflow-expt", default=None)
+    args = p.parse_args()
+    train(args.inp, args.out, args.mlflow_expt)
