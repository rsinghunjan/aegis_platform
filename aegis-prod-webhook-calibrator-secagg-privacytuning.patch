+#!/usr/bin/env python3
+"""
+Simple unit test for the secure aggregation additive-share prototype.
+Starts the pysecure_server in a subprocess, submits shares from two clients and asserts the aggregate matches expected.
+"""
+import subprocess, time, requests, json, base64
+from multiprocessing import Process
+import os, sys
+
+SRV = "http://127.0.0.1:8202"
+
+def start_server():
+    p = subprocess.Popen([sys.executable, "ops/secure_agg/pysyft_secure_aggregator.py"])
+    return p
+
+def submit_share(client_id, arr):
+    b = base64.b64encode(json.dumps(arr).encode()).decode()
+    r = requests.post(SRV + "/submit_share", json={"client_id": client_id, "share": b}, timeout=5)
+    return r.status_code
+
+def aggregate():
+    r = requests.post(SRV + "/aggregate", json={}, timeout=5)
+    return r.json()
+
+def main():
+    srv = start_server()
+    time.sleep(1)
+    # client A and B each will submit their full updates (prototype)
+    submit_share("a", [0.1, 0.2, 0.3])
+    submit_share("b", [0.4, 0.1, 0.0])
+    res = aggregate()
+    print("Aggregate:", res)
+    srv.terminate()
+
+if __name__=="__main__":
+    main()
+
