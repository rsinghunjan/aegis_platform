+#!/usr/bin/env python3
+"""
+Calibrator inference service using the PyTorch model trained by calibrator_pytorch_train.py.
+Exposes /score which accepts JSON: {"text": "..."} and returns {"score":float,"pass":bool,"threshold":float}
+"""
+import os, json, joblib, torch
+from flask import Flask, request, jsonify
+
+MODEL_DIR = os.environ.get("CALIBRATOR_MODEL_DIR","/models")
+MODEL_PATH = os.path.join(MODEL_DIR, "calibrator.pt")
+VEC_PATH = os.path.join(MODEL_DIR, "vectorizer.joblib")
+THRESH = float(os.environ.get("CALIBRATOR_THRESHOLD", "0.8"))
+
+app = Flask(__name__)
+model = None
+vectorizer = None
+
+class CalibratorWrapper(torch.nn.Module):
+    def __init__(self, input_dim):
+        super().__init__()
+        self.net = torch.nn.Sequential(
+            torch.nn.Linear(input_dim, 64),
+            torch.nn.ReLU(),
+            torch.nn.Linear(64, 1),
+            torch.nn.Sigmoid()
+        )
+    def forward(self, x):
+        return self.net(x)
+
+def load():
+    global model, vectorizer
+    vectorizer = joblib.load(VEC_PATH)
+    inp_dim = len(vectorizer.get_feature_names_out())
+    wrapper = CalibratorWrapper(inp_dim)
+    wrapper.load_state_dict(torch.load(MODEL_PATH, map_location="cpu"))
+    wrapper.eval()
+    model = wrapper
+
+@app.route("/score", methods=["POST"])
+def score():
+    body = request.get_json() or {}
+    text = body.get("text","")
+    vec = vectorizer.transform([text]).toarray().astype("float32")
+    x = torch.from_numpy(vec)
+    with torch.no_grad():
+        prob = float(model(x).numpy().squeeze().tolist())
+    ok = prob >= THRESH
+    return jsonify({"score": prob, "pass": ok, "threshold": THRESH})
+
+@app.route("/healthz", methods=["GET"])
+def health():
+    return jsonify({"ok": True})
+
+if __name__=="__main__":
+    if not os.path.exists(MODEL_PATH) or not os.path.exists(VEC_PATH):
+        raise SystemExit("Model or vectorizer not found; run calibrator_pytorch_train.py first.")
+    load()
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8201")))
+
