+#!/usr/bin/env bash
+set -euo pipefail
+MODEL_DIR=${1:-/models}
+VAULT_PATH=${2:-secret/data/aegis/calibrator}
+THRESH=${3:-0.8}
+if [ ! -f "${MODEL_DIR}/calibrator.pt" ]; then
+  echo "Calibrator model not found in ${MODEL_DIR}"
+  exit 2
+fi
+# Upload model artifact to an object store and push metadata to Vault. This script assumes `aws` and `vault` CLIs configured.
+ARTIFACT_S3=${EVIDENCE_BUCKET:-""}
+if [ -n "$ARTIFACT_S3" ]; then
+  aws s3 cp "${MODEL_DIR}/calibrator.pt" "${ARTIFACT_S3}/calibrators/calibrator.pt"
+  MODEL_URI="${ARTIFACT_S3}/calibrators/calibrator.pt"
+else
+  MODEL_URI="file://${MODEL_DIR}/calibrator.pt"
+fi
+echo "Storing calibrator metadata in Vault at ${VAULT_PATH}"
+vault kv put "${VAULT_PATH}" model_uri="${MODEL_URI}" threshold="${THRESH}" recorded_at="$(date +%s)"
+echo "Pushed calibrator model metadata to Vault"
+
