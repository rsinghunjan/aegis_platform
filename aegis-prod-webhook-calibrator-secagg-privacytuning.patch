+#!/usr/bin/env python3
+"""
+Train a lightweight PyTorch calibrator using TF-IDF features.
+Input CSV: text,label
+Saves:
+ - /models/calibrator.pt  (state_dict)
+ - /models/vectorizer.joblib (sklearn TfidfVectorizer)
+ - /models/calibrator_meta.json (vocab/info)
+"""
+import argparse, os, json
+import joblib
+import pandas as pd
+import numpy as np
+import torch
+import torch.nn as nn
+from torch.utils.data import TensorDataset, DataLoader
+from sklearn.feature_extraction.text import TfidfVectorizer
+
+class CalibratorNN(nn.Module):
+    def __init__(self, input_dim):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(input_dim, 64),
+            nn.ReLU(),
+            nn.Linear(64, 1),
+            nn.Sigmoid()
+        )
+    def forward(self, x):
+        return self.net(x)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="inp", required=True)
+    p.add_argument("--out-dir", default="/models")
+    p.add_argument("--max-features", type=int, default=10000)
+    p.add_argument("--epochs", type=int, default=5)
+    args = p.parse_args()
+
+    os.makedirs(args.out_dir, exist_ok=True)
+    df = pd.read_csv(args.inp)
+    texts = df["text"].astype(str).tolist()
+    labels = df["label"].astype(int).values
+    vectorizer = TfidfVectorizer(max_features=args.max_features, ngram_range=(1,2))
+    X = vectorizer.fit_transform(texts).astype(np.float32)
+    X_arr = X.toarray()
+    X_tensor = torch.from_numpy(X_arr)
+    y_tensor = torch.from_numpy(labels.reshape(-1,1).astype(np.float32))
+    ds = TensorDataset(X_tensor, y_tensor)
+    loader = DataLoader(ds, batch_size=64, shuffle=True)
+
+    model = CalibratorNN(X_arr.shape[1])
+    opt = torch.optim.Adam(model.parameters(), lr=1e-3)
+    loss_fn = nn.BCELoss()
+    for epoch in range(args.epochs):
+        for xb,yb in loader:
+            pred = model(xb).squeeze(1)
+            loss = loss_fn(pred, yb.squeeze(1))
+            opt.zero_grad(); loss.backward(); opt.step()
+    # Save
+    torch.save(model.state_dict(), os.path.join(args.out_dir, "calibrator.pt"))
+    joblib.dump(vectorizer, os.path.join(args.out_dir, "vectorizer.joblib"))
+    meta = {"max_features": args.max_features}
+    with open(os.path.join(args.out_dir, "calibrator_meta.json"), "w") as fh:
+        json.dump(meta, fh)
+    print("Saved calibrator to", args.out_dir)
+
+if __name__=="__main__":
+    main()
+
