+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Operator playbook: create k8s TLS secrets (placeholders), install Helm charts, and run basic smoke tests.
+#
+# Prereqs: helm, kubectl, jq, env vars:
+#   DOCKER_REGISTRY, AEGIS_NAMESPACE (default aegis-system), MCP_API_TOKEN, MCP_POSTGRES_SECRET, APPROVER_POSTGRES_SECRET
+
+NAMESPACE="${AEGIS_NAMESPACE:-aegis-system}"
+REG="${DOCKER_REGISTRY:-<YOUR_REGISTRY>}"
+
+echo "Creating namespace ${NAMESPACE}"
+kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Creating placeholder mTLS secrets (replace with real certs)"
+kubectl create secret tls aegis-mtls-ca --cert=/dev/null --key=/dev/null --namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
+kubectl create secret generic aegis-langchain-tls --from-literal=cert="REPLACE_ME" --from-literal=key="REPLACE_ME" --namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
+kubectl create secret generic aegis-langgraph-tls --from-literal=cert="REPLACE_ME" --from-literal=key="REPLACE_ME" --namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Installing MCP (Helm)"
+helm upgrade --install mcp helm/mcp -n "${NAMESPACE}" --set image.repository="${REG}/mcp" --set image.tag=latest --wait
+
+echo "Installing langchain-runtime (Helm)"
+helm upgrade --install langchain-runtime helm/langchain_runtime -n "${NAMESPACE}" --set image.repository="${REG}/langchain-runtime" --set image.tag=latest --wait
+
+echo "Installing langgraph (Helm)"
+helm upgrade --install langgraph helm/langgraph -n "${NAMESPACE}" --set image.repository="${REG}/langgraph" --set image.tag=latest --wait
+
+echo "Deploy approver consumer as a Deployment (simple)"
+kubectl -n "${NAMESPACE}" apply -f - <<EOF
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: approver-consumer
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: approver-consumer
+  template:
+    metadata:
+      labels:
+        app: approver-consumer
+    spec:
+      containers:
+      - name: approver
+        image: "${REG}/approver-consumer:latest"
+        ports:
+        - containerPort: 8085
+EOF
+
+echo "Waiting for deployments to become ready..."
+kubectl -n "${NAMESPACE}" rollout status deployment/mcp --timeout=120s || true
+kubectl -n "${NAMESPACE}" rollout status deployment/langchain-runtime --timeout=120s || true
+kubectl -n "${NAMESPACE}" rollout status deployment/langgraph --timeout=120s || true
+
+echo "Running basic smoke tests"
+MCP_SVC=$(kubectl -n "${NAMESPACE}" get svc mcp -o jsonpath='{.metadata.name}' 2>/dev/null || true)
+if [ -n "$MCP_SVC" ]; then
+  echo "MCP appears deployed in ${NAMESPACE}"
+fi
+
+echo "Deployment script finished - replace placeholder secrets with real certs and DB credentials."
+
