 app = FastAPI(title="Aegis MCP Service", version="0.1.0")
 
+# Simple token-based auth (optional, production needs OAuth/JWT)
+MCP_API_TOKEN = os.environ.get("MCP_API_TOKEN", "")
+
+from fastapi import Header, Depends
+
+def _check_token(authorization: str | None = Header(default=None)):
+    if not MCP_API_TOKEN:
+        return True
+    if not authorization:
+        raise HTTPException(status_code=401, detail="Authorization required")
+    # Expect header "Bearer <token>"
+    parts = authorization.split()
+    if len(parts) != 2 or parts[0].lower() != "bearer" or parts[1] != MCP_API_TOKEN:
+        raise HTTPException(status_code=403, detail="invalid token")
+    return True
