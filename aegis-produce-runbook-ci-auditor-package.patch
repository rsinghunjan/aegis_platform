+#!/usr/bin/env python3
+"""
+Auditor package builder
+ - Collects required artifacts (RT proofs, HIL cert bundles, Apalache outputs, perception evals, builder provenance)
+ - Builds an evidence manifest mapping requirements -> tests -> artifact paths
+ - Packages tar.gz bundle, cosign-signs it and optionally uploads to S3
+ - Prints checklist for the certifier
+
+Usage:
+  python3 auditor_package_builder.py --artifacts-root . --out /tmp/scout_bundle.tar.gz --cosign-key "$COSIGN_KMS_URI" --s3 s3://...
+"""
+import argparse
+import json
+import os
+import subprocess
+import tarfile
+from datetime import datetime
+
+DEFAULT_REQUIREMENTS = [
+    {"req_id":"RT-001","description":"Control loop p99 jitter proof","expected":"rt_slo_proof.json"},
+    {"req_id":"CTRL-001","description":"HIL certification bundle","expected":"hil_cert_bundle*.tar.gz"},
+    {"req_id":"FORMAL-001","description":"Apalache outputs & TLA+ specs","expected":"ops/formal/*.tla"},
+    {"req_id":"PER-001","description":"Perception OOD/adversarial eval","expected":"*/perception/ood_results.json"},
+    {"req_id":"SUP-001","description":"Builder provenance (cosign + Rekor)","expected":"CI logs / rekor search outputs"}
+]
+
+def collect_artifacts(root, patterns):
+    found=[]
+    for p in patterns:
+        # support simple globbing
+        for path in __import__("glob").glob(os.path.join(root, p), recursive=True):
+            found.append(path)
+    return sorted(set(found))
+
+def build_manifest(root, vehicle, outpath):
+    manifest = {"generated_at": datetime.utcnow().isoformat()+"Z", "vehicle": vehicle, "artifacts": {}}
+    # RT proofs
+    rt = collect_artifacts(root, ["**/rt_slo_proof.json"])
+    manifest["artifacts"]["rt_slo_proofs"] = rt
+    # HIL bundles
+    hil = collect_artifacts(root, ["**/*hil_cert_bundle*.tar.gz","**/*cert*.tar.gz"])
+    manifest["artifacts"]["hil_bundles"] = hil
+    # Apalache / formal
+    formal = collect_artifacts(root, ["ops/formal/*.tla","**/apalache*"])
+    manifest["artifacts"]["formal"] = formal
+    # perception
+    perception = collect_artifacts(root, ["**/perception/ood_results.json","**/adv_eval/**"])
+    manifest["artifacts"]["perception"] = perception
+    # provenance: best-effort include rekor search outputs & cosign verify outputs if present
+    repro = collect_artifacts(root, ["**/rekor_search*.json","**/cosign_verify*.txt"])
+    manifest["artifacts"]["provenance"] = repro
+    with open(outpath, "w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return outpath
+
+def package_bundle(root_files, out_bundle):
+    with tarfile.open(out_bundle, "w:gz") as t:
+        for p in root_files:
+            if os.path.exists(p):
+                t.add(p, arcname=os.path.relpath(p, "."))
+    return out_bundle
+
+def sign_bundle(bundle, cosign_key):
+    try:
+        subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        return True
+    except Exception as e:
+        print("cosign sign failed:", e)
+        return False
+
+def upload_bundle(bundle, s3_target):
+    try:
+        subprocess.check_call(["aws","s3","cp",bundle,s3_target])
+        return True
+    except Exception as e:
+        print("s3 upload failed:", e)
+        return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifacts-root", default=".")
+    p.add_argument("--out", default=f"/tmp/aegis_auditor_bundle_{int(datetime.utcnow().timestamp())}.tar.gz")
+    p.add_argument("--manifest-out", default=f"/tmp/aegis_evidence_manifest_{int(datetime.utcnow().timestamp())}.json")
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    p.add_argument("--vehicle", default="ScoutAV")
+    args = p.parse_args()
+    manifest_path = build_manifest(args.artifacts_root, args.vehicle, args.manifest_out)
+    print("Built evidence manifest:", manifest_path)
+    bundle = package_bundle([manifest_path], args.out)
+    print("Packaged bundle:", bundle)
+    signed = False
+    if args.cosign_key:
+        signed = sign_bundle(bundle, args.cosign_key)
+        print("Signed bundle:", signed)
+    if args.s3:
+        ok = upload_bundle(bundle, args.s3)
+        print("Uploaded bundle to S3:", ok)
+    # print checklist
+    print("\nAuditor checklist:")
+    print(" - Evidence manifest:", manifest_path)
+    print(" - RT proofs (search for rt_slo_proof.json)")
+    print(" - HIL bundles (hil_cert_bundle*.tar.gz)")
+    print(" - Formal artifacts: ops/formal/*.tla and Apalache outputs")
+    print(" - Perception evals: ood_results.json and adv_eval artifacts")
+    print(" - Builder provenance: cosign + Rekor outputs")
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("auditor_package", {"bundle": bundle, "manifest": manifest_path})
+    except Exception:
+        pass
+    print("\nDone.")
+
+if __name__ == "__main__":
+    main()
+
