*** Add File:ops/certifier/one_click_certifier_submit.sh
+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click certifier submission
+#  - Build safety case
+#  - Collect artifacts (RT proofs, HIL bundles, perception results, formal outputs)
+#  - Sign bundle with cosign (KMS)
+#  - Upload to S3 and print checklist for certifier
+#
+# Usage:
+#  COSIGN_KMS_URI=kms://... S3_UPLOAD=s3://aegis-evidence/<run-id>/ ./ops/certifier/one_click_certifier_submit.sh --out /tmp/cert_submit.tar.gz
+
+OUT=${1:-/tmp/certifier_submission_$(date +%s).tar.gz}
+S3=${S3_UPLOAD:-}
+COSIGN=${COSIGN_KMS_URI:-}
+
+echo "[1] Building safety case"
+python3 ops/av/ops/safety_case_builder.py --base . --out /tmp/safety_case_bundle.tar.gz || true
+
+echo "[2] Collecting artifacts & building submission package"
+python3 ops/av/certifier/submission_package.py --out "$OUT" --cosign-key "$COSIGN" --s3 "$S3" || true
+
+echo "[3] Post-submit checklist"
+echo " - Submission bundle: $OUT"
+if [ -n "$COSIGN" ]; then
+  echo " - Cosign key used: $COSIGN"
+else
+  echo " - Warning: no COSIGN_KMS_URI present; submission not signed"
+fi
+if [ -n "$S3" ]; then
+  echo " - Uploaded to: $S3"
+fi
+echo " - Evidence to include for certifier:"
+echo "    * RT SLO proofs (p99 & safe-stop) -> search for rt_slo_proof.json"
+echo "    * HIL bundles & waveform compare outputs -> cert/*.tar.gz, waveform_compare.json"
+echo "    * Perception OOD & adversarial eval -> perception/ood_results.json, adv_eval"
+echo "    * Formal specs & Apalache outputs -> ops/formal/*.tla, apalache outputs"
+echo "    * Builder provenance (cosign signatures & Rekor entries) -> CI logs"
+echo ""
+echo "If you want me to also open a GH issue for submission and notify a reviewer, run with GH auth present and call ops/certifier/submit_to_certifier.sh"
+
*** End File
*** Add File:ops/certifier/README_CERTIFIER_SUBMISSION.md
+Certifier submission: how to use the one-click submit tool
+
+1) Preconditions
+ - Ensure safety case is up-to-date: golden traces, rt_slo_proof.json, HIL bundles are present in repo workspace or referenced S3.
+ - Set COSIGN_KMS_URI and REKOR_SERVER environment variables for signing & evidence.
+ - Ensure S3_UPLOAD points to your evidence bucket.
+
+2) Run submission
+ - COSIGN_KMS_URI=kms://... S3_UPLOAD=s3://aegis-evidence/$(date +%Y%m%d)/ ./ops/certifier/one_click_certifier_submit.sh /tmp/cert_submit.tar.gz
+
+3) Deliver to certifier
+ - Provide the S3 path or upload the generated tar.gz to the certifier's secure portal.
+ - Attach assenting documentation: ops/governance/auditor_cover_letter.md and test_matrix CSV.
+
+4) Audit support
+ - Keep a copy of cosign signatures and Rekor verification outputs.
+ - Retain evidence per ops/governance/evidence_retention_policy.md.
+
