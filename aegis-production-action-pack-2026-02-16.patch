+"""
+OIDC + RBAC middleware for MCP with Prometheus metrics integration.
+Enforces JWT validation (via JWKS) and role checks.
+Environment variables:
+ - OIDC_ISSUER
+ - OIDC_AUDIENCE
+ - MCP_JWKS_URL (optional)
+ - RBAC_POLICY_FILE (optional path to JSON role->permissions mapping)
+"""
+import os, time, json, requests
+from jose import jwt, JWTError
+from fastapi import Request, HTTPException
+from prometheus_client import Counter, Gauge
+
+OIDC_ISSUER = os.environ.get("OIDC_ISSUER", "https://issuer.example.com")
+OIDC_AUDIENCE = os.environ.get("OIDC_AUDIENCE", "mcp")
+JWKS_URL = os.environ.get("MCP_JWKS_URL", f"{OIDC_ISSUER.rstrip('/')}/.well-known/jwks.json")
+RBAC_POLICY_FILE = os.environ.get("RBAC_POLICY_FILE", "/etc/mcp/rbac_policy.json")
+
+# Metrics
+MET_AUTH_VALID = Counter("mcp_auth_valid_total", "Valid auths")
+MET_AUTH_INVALID = Counter("mcp_auth_invalid_total", "Invalid auths")
+MET_RBAC_DENY = Counter("mcp_rbac_deny_total", "RBAC denies")
+MET_RBAC_ALLOW = Counter("mcp_rbac_allow_total", "RBAC allows")
+
+_JWKS_CACHE = {"jwks": None, "fetched_at": 0}
+_RBAC_POLICY = None
+
+def load_rbac_policy():
+    global _RBAC_POLICY
+    try:
+        with open(RBAC_POLICY_FILE, "r") as f:
+            _RBAC_POLICY = json.load(f)
+    except Exception:
+        _RBAC_POLICY = {}
+
+def fetch_jwks(force=False):
+    if _JWKS_CACHE["jwks"] and not force and time.time() - _JWKS_CACHE["fetched_at"] < 3600:
+        return _JWKS_CACHE["jwks"]
+    r = requests.get(JWKS_URL, timeout=5)
+    r.raise_for_status()
+    _JWKS_CACHE["jwks"] = r.json()
+    _JWKS_CACHE["fetched_at"] = time.time()
+    return _JWKS_CACHE["jwks"]
+
+def validate_jwt(token: str):
+    try:
+        jwks = fetch_jwks()
+        payload = jwt.decode(token, jwks, algorithms=["RS256"], audience=OIDC_AUDIENCE, issuer=OIDC_ISSUER)
+        MET_AUTH_VALID.inc()
+        return payload
+    except JWTError:
+        MET_AUTH_INVALID.inc()
+        raise HTTPException(status_code=401, detail="Invalid JWT")
+
+def get_token_from_request(request: Request):
+    auth = request.headers.get("Authorization")
+    if not auth:
+        return None
+    parts = auth.split()
+    if len(parts) != 2 or parts[0].lower() != "bearer":
+        return None
+    return parts[1]
+
+def has_role(payload, required_roles):
+    roles = payload.get("roles") or payload.get("groups") or []
+    if isinstance(required_roles, str):
+        required_roles = [required_roles]
+    for r in required_roles:
+        if r in roles:
+            MET_RBAC_ALLOW.inc()
+            return True
+    MET_RBAC_DENY.inc()
+    return False
+
+def require_roles(request: Request, required_roles):
+    token = get_token_from_request(request)
+    if not token:
+        raise HTTPException(status_code=401, detail="Missing token")
+    payload = validate_jwt(token)
+    if not has_role(payload, required_roles):
+        raise HTTPException(status_code=403, detail="Insufficient role")
+    # attach subject for downstream audit
+    request.state.subject = payload.get("sub") or payload.get("email") or "unknown"
+    return payload
+
+# Load RBAC policy at module import if provided
+load_rbac_policy()
+
