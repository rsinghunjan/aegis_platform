+"""
+Consumer that subscribes to a DLQ topic and logs/retries messages to a retry endpoint.
+"""
+from confluent_kafka import Consumer, KafkaError
+import os, time, requests, json
+
+BOOTSTRAP = os.environ.get("KAFKA_BOOTSTRAP_SERVERS","kafka.bootstrap.svc:9093")
+DLQ_TOPIC = os.environ.get("KAFKA_DLQ_TOPIC","mcp-events-dlq")
+RETRY_ENDPOINT = os.environ.get("DLQ_RETRY_ENDPOINT","http://mcp.mcp.svc.cluster.local:8000/retry-handler")
+
+consumer = Consumer({
+    'bootstrap.servers': BOOTSTRAP,
+    'group.id': 'mcp-dlq-consumer',
+    'auto.offset.reset': 'earliest'
+})
+consumer.subscribe([DLQ_TOPIC])
+
+while True:
+    msg = consumer.poll(1.0)
+    if msg is None:
+        continue
+    if msg.error():
+        if msg.error().code() == KafkaError._PARTITION_EOF:
+            continue
+        print("Error", msg.error())
+        break
+    try:
+        payload = json.loads(msg.value().decode())
+        # attempt to POST to retry handler
+        requests.post(RETRY_ENDPOINT, json=payload, timeout=5)
+    except Exception as e:
+        print("Retry failed", e)
+    time.sleep(0.1)
+
