+"""
+Scan multiple repos for static secrets and generate a suggested PR patch that replaces secret usage
+with OIDC-based Vault login instructions. This script creates a local branch and outputs a patch file.
+It does NOT push or create the PR automatically (operator must review / push).
+Usage:
+  python3 scan_and_propose_oidc_prs.py repos.txt
+"""
+import os, subprocess, sys, tempfile, shutil
+from pathlib import Path
+import re
+
+GITHUB_ORG = os.environ.get("GITHUB_ORG","yourorg")
+REPOS_LIST = sys.argv[1] if len(sys.argv)>1 else "repos.txt"
+
+SECRET_PATTERNS = [re.compile(r'VAULT_TOKEN'), re.compile(r'AWS_SECRET_ACCESS_KEY'), re.compile(r'PRIVATE KEY'), re.compile(r'GITHUB_TOKEN')]
+
+def scan_repo(path):
+    findings = []
+    for f in Path(path).rglob('*'):
+        if f.is_file() and f.suffix in ['.yml','.yaml','.env','.sh','.py','.tf','Dockerfile','.json','.js']:
+            txt = f.read_text(errors='ignore')
+            for p in SECRET_PATTERNS:
+                if p.search(txt):
+                    findings.append(str(f))
+                    break
+    return findings
+
+def propose_changes(repo):
+    tmp = tempfile.mkdtemp()
+    try:
+        subprocess.run(["git","clone","--depth","1",f"git@github.com:{GITHUB_ORG}/{repo}.git", tmp], check=True)
+    except Exception as e:
+        print("clone failed", repo, e); shutil.rmtree(tmp); return
+    finds = scan_repo(tmp)
+    if not finds:
+        print("No secrets found in", repo)
+        shutil.rmtree(tmp); return
+    branch = f"aegis/oidc-migration-proposal-{int(time.time())}"
+    subprocess.run(["git","-C", tmp, "checkout", "-b", branch], check=True)
+    # Add a README migration plan
+    mig = Path(tmp) / "MIGRATE_TO_OIDC.md"
+    mig.write_text("# Migration to OIDC for CI\n\nThis repo has static secrets. Proposed steps: ...")
+    subprocess.run(["git","-C", tmp, "add", "MIGRATE_TO_OIDC.md"], check=True)
+    subprocess.run(["git","-C", tmp, "commit", "-m", "chore(ci): propose OIDC migration and migration plan"], check=True)
+    patchfile = Path.cwd() / f"{repo}-oidc-proposal.patch"
+    subprocess.run(["git","-C", tmp, "format-patch", "-1", "--stdout"], stdout=open(patchfile,"wb"))
+    print("Wrote proposal patch for", repo, "->", patchfile)
+    shutil.rmtree(tmp)
+
+if __name__ == "__main__":
+    with open(REPOS_LIST) as f:
+        for r in [l.strip() for l in f if l.strip()]:
+            propose_changes(r)
+
