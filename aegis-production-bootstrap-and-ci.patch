+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Verify that a prompt bundle or evidence bundle is cosign-signed and has a Rekor entry.
+# Usage:
+#   ./ops/ci/verify_promotion.sh --bundle /path/to/prompt_X.tar.gz --cosign-key "$COSIGN_KMS_URI" --rekor "$REKOR_SERVER"
+#
+BUNDLE=""
+COSIGN_KEY="${COSIGN_KMS_URI:-}"
+REKOR_SERVER="${REKOR_SERVER:-}"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --bundle) BUNDLE="$2"; shift 2;;
+    --cosign-key) COSIGN_KEY="$2"; shift 2;;
+    --rekor) REKOR_SERVER="$2"; shift 2;;
+    *) echo "Unknown arg: $1"; exit 2;;
+  esac
+done
+
+if [ -z "$BUNDLE" ]; then
+  echo "bundle path is required (--bundle)"
+  exit 2
+fi
+
+if [ ! -f "$BUNDLE" ]; then
+  echo "Bundle file not found: $BUNDLE"
+  exit 2
+fi
+
+echo "1) Verify cosign signature (KMS key: ${COSIGN_KEY:-<env>})"
+if command -v cosign >/dev/null 2>&1; then
+  if [ -n "$COSIGN_KEY" ]; then
+    cosign verify --key "$COSIGN_KEY" "$BUNDLE" || { echo "cosign verify failed"; exit 3; }
+  else
+    cosign verify "$BUNDLE" || { echo "cosign verify failed"; exit 3; }
+  fi
+else
+  echo "cosign not installed; cannot verify signature locally. Skipping."
+fi
+
+echo "2) Check Rekor for artifact digest (if rekor-cli available and REKOR_SERVER provided)"
+if command -v rekor-cli >/dev/null 2>&1 && [ -n "$REKOR_SERVER" ]; then
+  DIGEST=$(sha256sum "$BUNDLE" | awk '{print $1}')
+  echo "Searching Rekor for digest: $DIGEST"
+  rekor-cli search --sha "$DIGEST" --server "$REKOR_SERVER" || { echo "Rekor entry not found"; exit 4; }
+else
+  echo "rekor-cli not installed or REKOR_SERVER not set; skipping Rekor check"
+fi
+
+echo "Promotion verification complete: cosign+rekor checks passed (if run)."
+
