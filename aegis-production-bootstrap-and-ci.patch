+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Build an auditor package containing specified artifacts, sign with cosign, push to S3 and emit Rekor/manifest info.
+# Usage:
+#   ./ops/audit/auditor_package_template.sh --out /tmp/auditor_bundle.tar.gz --artifacts /path/a.json,/path/b.json
+OUT=""
+ARTIFACTS_CSV=""
+COSIGN_KEY="${COSIGN_KMS_URI:-}"
+S3_UPLOAD="${S3_UPLOAD:-}"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --out) OUT="$2"; shift 2;;
+    --artifacts) ARTIFACTS_CSV="$2"; shift 2;;
+    --cosign-key) COSIGN_KEY="$2"; shift 2;;
+    --s3) S3_UPLOAD="$2"; shift 2;;
+    *) echo "Unknown arg: $1"; exit 2;;
+  esac
+done
+
+: "${OUT:?--out required}"
+if [ -z "$ARTIFACTS_CSV" ]; then
+  echo "--artifacts required (comma-separated paths)"
+  exit 2
+fi
+
+TMPDIR=$(mktemp -d)
+IFS=',' read -r -a FILES <<< "$ARTIFACTS_CSV"
+MANIFEST="$TMPDIR/manifest.json"
+echo "{" > "$MANIFEST"
+echo "\"generated_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"," >> "$MANIFEST"
+echo "\"files\":[" >> "$MANIFEST"
+FIRST=true
+for f in "${FILES[@]}"; do
+  if [ ! -f "$f" ]; then
+    echo "Artifact missing: $f" >&2
+    exit 3
+  fi
+  cp "$f" "$TMPDIR/"
+  DIG=$(sha256sum "$f" | awk '{print $1}')
+  if [ "$FIRST" = true ]; then
+    FIRST=false
+  else
+    echo "," >> "$MANIFEST"
+  fi
+  echo "{\"name\":\"$(basename "$f")\",\"sha256\":\"$DIG\"}" >> "$MANIFEST"
+done
+echo "]}" >> "$MANIFEST"
+
+tar -czf "$OUT" -C "$TMPDIR" .
+echo "Created auditor bundle: $OUT"
+
+if command -v cosign >/dev/null 2>&1 && [ -n "$COSIGN_KEY" ]; then
+  cosign sign --key "$COSIGN_KEY" "$OUT" || echo "cosign sign failed"
+fi
+
+if [ -n "$S3_UPLOAD" ]; then
+  aws s3 cp "$OUT" "$S3_UPLOAD/$(basename "$OUT")" || echo "s3 upload failed"
+fi
+
+echo "Auditor package finished. bundle=$OUT"
+
