+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click PoA production-style test harness
+# Requires environment variables per docs/runbooks/environment_prefill_instructions.md
+#
+: "${PROMPT_ID:=demo_prompt}"
+: "${MODEL_ENDPOINT:=http://triton:8000}"
+: "${OUT_DIR:=/tmp/aegis_poa_prod_$(date +%s)}"
+mkdir -p "$OUT_DIR"
+
+echo "[0] Validate envs"
+: "${COSIGN_KMS_URI:?Set COSIGN_KMS_URI}"
+: "${REKOR_SERVER:?Set REKOR_SERVER}"
+: "${S3_UPLOAD:?Set S3_UPLOAD}"
+
+echo "[1] Promote prompt via registry (assumes prompt exists)"
+PROM_REG_URL="${PROMPT_REGISTRY_URL:-http://prompt-registry:5003}"
+curl -s -X POST "$PROM_REG_URL/prompts/$PROMPT_ID/promote" -H "Content-Type: application/json" -d '{"env":"staging"}' -o "$OUT_DIR/prompt_promote.json" || true
+cat "$OUT_DIR/prompt_promote.json"
+
+echo "[2] Run ADK sample agent to generate traces/evidence"
+python3 ops/adk/sample_agent/sample_agent.py --goal '{"command":"status"}' --out "$OUT_DIR/adk" --cosign "$COSIGN_KMS_URI" || true
+
+echo "[3] Run retrieval (FAISS) smoke (placeholder)"
+python3 - <<PY
+from ops.prompt.context.context_composer_v2 import compose
+print("Compose placeholder for retrieval + prompt")
+PY
+
+echo "[4] Call model endpoint"
+python3 - <<PY
+import requests, json, os
+payload = {"inputs":"Context: example\n\nQuestion: what is the status?\nAnswer:"}
+try:
+    r = requests.post("${MODEL_ENDPOINT}/v2/models/aegis-llm/infer", json=payload, timeout=10)
+    open("${OUT_DIR}/model_output.json","w").write(r.text)
+    print("Model output captured to ${OUT_DIR}/model_output.json")
+except Exception as e:
+    print("Model call failed:", e)
+PY
+
+echo "[5] Grounding check"
+python3 ops/eval/grounding/grounding_checker.py > "$OUT_DIR/grounding_check.json" || true
+
+echo "[6] Bundle & sign evidence"
+python3 - <<PY
+from ops.adk.sdk.evidence import bundle_evidence
+files = ["${OUT_DIR}/model_output.json","${OUT_DIR}/grounding_check.json","${OUT_DIR}/adk/trace.ndjson"]
+out = "${OUT_DIR}/poa_evidence.tar.gz"
+bundle_evidence(files, out, metadata={"prompt_id":"${PROMPT_ID}","run_by":"one_click_poa_prod_test"}, cosign_key="${COSIGN_KMS_URI}")
+print("Evidence bundled at", out)
+PY
+
+echo "[7] Upload evidence to S3"
+aws s3 cp "${OUT_DIR}/poa_evidence.tar.gz" "${S3_UPLOAD}/poa_evidence_$(date +%s).tar.gz" || echo "s3 upload may have failed"
+
+echo "[8] Verify promotion bundle & evidence via verify_promotion.sh"
+BUNDLE_PATH=$(jq -r '.bundle // empty' "$OUT_DIR/prompt_promote.json" || echo "")
+if [ -n "$BUNDLE_PATH" ] && [ -f "$BUNDLE_PATH" ]; then
+  bash ops/ci/verify_promotion.sh --bundle "$BUNDLE_PATH" --cosign-key "$COSIGN_KMS_URI" --rekor "$REKOR_SERVER" || echo "verify_promotion failed"
+else
+  echo "Prompt promote bundle path not found locally; skipping verification"
+fi
+
+echo "One-click PoA production test finished. Outputs under $OUT_DIR"
+
