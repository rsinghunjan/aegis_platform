+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Bootstrap a minimal production-ready Aegis environment.
+# Reads environment variables described in docs/runbooks/environment_prefill_instructions.md
+#
+echo "Aegis minimal production bootstrap starting..."
+
+: "${CLUSTER_CONTEXT:?Set CLUSTER_CONTEXT (kubectl context)}"
+: "${REGISTRY:?Set REGISTRY (container registry)}"
+: "${COSIGN_KMS_URI:?Set COSIGN_KMS_URI (KMS URI for cosign)}"
+: "${REKOR_SERVER:?Set REKOR_SERVER (rekor server url)}"
+: "${S3_UPLOAD:?Set S3_UPLOAD (s3 uri for evidence)}"
+: "${REDIS_URL:?Set REDIS_URL (redis session store)}"
+: "${OIDC_ISSUER_URL:?Set OIDC_ISSUER_URL (OIDC issuer)}"
+: "${OIDC_CLIENT_ID:?Set OIDC_CLIENT_ID (OIDC client id)}"
+
+echo "Using kubectl context: $CLUSTER_CONTEXT"
+kubectl config use-context "$CLUSTER_CONTEXT"
+
+echo "1/8 - Create namespace(s)"
+kubectl create ns aegis-app || true
+kubectl create ns aegis-ml || true
+kubectl create ns aegis-system || true
+
+echo "2/8 - Install Redis (session store)"
+helm repo add bitnami https://charts.bitnami.com/bitnami || true
+helm upgrade --install aegis-redis bitnami/redis --namespace aegis-app --set auth.enabled=false || true
+
+echo "3/8 - Deploy Prompt Registry (Helm chart placeholder)"
+if [ -n "${PROMPT_REGISTRY_HELM_VALUES:-}" ] && [ -f "${PROMPT_REGISTRY_HELM_VALUES}" ]; then
+  helm upgrade --install aegis-prompt-registry ops/prompt/registry/helm -n aegis-app -f "${PROMPT_REGISTRY_HELM_VALUES}"
+else
+  helm upgrade --install aegis-prompt-registry ops/prompt/registry/helm -n aegis-app \
+    --set image.repository="${REGISTRY}/aegis-prompt-registry" --set image.tag="latest"
+fi
+
+echo "4/8 - Deploy oauth2-proxy (OIDC) for Prompt Registry"
+kubectl apply -f ops/security/oidc/oauth2-proxy-deployment.yaml -n aegis-system || true
+echo "   Note: ensure Kubernetes secrets (oidc-secrets, oauth-cookie) are created via Vault or k8s secrets"
+
+echo "5/8 - Deploy Triton & vLLM sample servers (model repo PVCs required)"
+kubectl apply -f ops/serving/triton/deployment.yaml -n aegis-ml || true
+kubectl apply -f ops/serving/vllm/deployment.yaml -n aegis-ml || true
+
+echo "6/8 - Install Fluentd for cluster log forwarding (modify host in configmap)"
+kubectl apply -f ops/logging/fluentd/fluentd-configmap.yaml
+kubectl apply -f ops/logging/fluentd/fluentd-daemonset.yaml
+
+echo "7/8 - Configure Vault K8s auth role for prompt-registry (assumes Vault is reachable)"
+if command -v vault >/dev/null 2>&1; then
+  bash ops/secrets/vault/vault_k8s_auth_setup.sh || echo "vault setup skipped or failed (requires Vault access)"
+else
+  echo "vault CLI not found; skip K8s auth setup. Use Vault UI or install vault CLI."
+fi
+
+echo "8/8 - Configure GitHub OIDC / CI signing guidance (manual step)"
+cat <<EOF
+Now:
+ - Add COSIGN_KMS_URI and REKOR_SERVER as GitHub repository secrets.
+ - Configure OIDC trust between GitHub and your cloud provider and bind roles to CI builders.
+ - Run ops/ci/builder_harden_and_cosign_automate.sh on at least one builder host.
+ - Populate Prompt Registry with initial templates via ops/prompt/registry/cli.py
+EOF
+
+echo "Bootstrap complete. Validate services and run the one-click PoA harness for an end-to-end smoke."
+
