+#!/usr/bin/env bash
+set -euo pipefail
+OUT=${1:-/tmp/aegis_crypto_audit}
+mkdir -p "$OUT"
+echo "Collecting cosign, Rekor and KMS metadata for auditor"
+cosign version > "$OUT/cosign_version.txt" 2>/dev/null || true
+if [ -n "${REKOR_SERVER:-}" ]; then
+  echo "Rekor server: $REKOR_SERVER" > "$OUT/rekor_info.txt"
+  curl -s "${REKOR_SERVER}/api/v1/log/entries" > "$OUT/rekor_entries.json" || true
+fi
+if command -v aws >/dev/null 2>&1; then
+  echo "Collecting AWS KMS keys (caller identity must have permissions)"
+  aws kms list-keys > "$OUT/aws_kms_list.json" || true
+fi
+if command -v gcloud >/dev/null 2>&1; then
+  gcloud kms keys list --location global --keyring aegis  > "$OUT/gcp_kms_list.txt" 2>/dev/null || true
+fi
+tar -czf "${OUT}.tar.gz" -C "$(dirname "$OUT")" "$(basename "$OUT")"
+echo "Crypto audit bundle: ${OUT}.tar.gz"
+python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("crypto_audit_collected", {"bundle":"${OUT}.tar.gz"})
+PY
