+#!/usr/bin/env python3
+"""
+Sign a container image (or other artifact) using cosign + KMS, verify the signature, and optionally query Rekor.
+Records an evidence manifest on success.
+"""
+import os, subprocess, sys, json
+from ops.sdk.evidence_sdk import record_manifest
+
+IMAGE = os.environ.get("IMAGE")
+KMS = os.environ.get("COSIGN_KMS_URI")
+REKOR = os.environ.get("REKOR_SERVER", "")
+
+if not IMAGE or not KMS:
+    print("IMAGE and COSIGN_KMS_URI environment variables required", file=sys.stderr)
+    sys.exit(2)
+
+print("Signing image", IMAGE)
+subprocess.check_call(["cosign", "sign", "--key", KMS, IMAGE])
+print("Verifying signature")
+subprocess.check_call(["cosign", "verify", "--key", KMS, IMAGE])
+
+rekor_entry = None
+if REKOR:
+    try:
+        out = subprocess.check_output(["rekor-cli", "search", "--rekor_server", REKOR, "--artifact", IMAGE])
+        rekor_entry = out.decode("utf-8")
+    except Exception:
+        rekor_entry = None
+
+record_manifest("artifact_signed", {"image": IMAGE, "kms": KMS, "rekor": rekor_entry})
+print("Recorded evidence manifest for image", IMAGE)
+
