+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate cosign KMS key pointer in Vault and run smoke-sign verification + Rekor snapshot for audit.
+#
+# Usage:
+#   COSIGN_KMS_URI=awskms://... VAULT_ADDR=https://vault:8200 VAULT_TOKEN=... ./ops/security/kms/rotate_and_audit.sh new-kms-uri
+#
+NEW_KMS_URI=${1:-}
+if [ -z "$NEW_KMS_URI" ]; then
+  echo "Usage: $0 <NEW_COSIGN_KMS_URI>"
+  exit 2
+fi
+
+echo "Rotating COSIGN_KMS_URI to $NEW_KMS_URI in Vault..."
+if [ -z "${VAULT_ADDR:-}" ] || [ -z "${VAULT_TOKEN:-}" ]; then
+  echo "VAULT_ADDR and VAULT_TOKEN must be set in env"
+  exit 2
+fi
+
+# Write to KV path secret/aegis/cosign_kms (example)
+vault kv put secret/aegis/cosign_kms uri="$NEW_KMS_URI"
+echo "Updated Vault secret: secret/aegis/cosign_kms"
+
+echo "Performing smoke sign & verify test with cosign..."
+TMPFILE=$(mktemp /tmp/cosign-smoke.XXXX)
+echo "aegis-cosign-rotation-test" > "$TMPFILE"
+cosign sign --key "$NEW_KMS_URI" "$TMPFILE"
+cosign verify --key "$NEW_KMS_URI" "$TMPFILE"
+echo "cosign sign/verify OK"
+
+echo "Collecting Rekor entries related to the signature..."
+if [ -z "${REKOR_SERVER:-}" ]; then
+  echo "REKOR_SERVER not set (optional). Skipping Rekor collection."
+else
+  rekor-cli search --rekor_server "${REKOR_SERVER}" --type signature --signature-file "$TMPFILE.sig" >/tmp/rekor_search.json 2>/dev/null || true
+  echo "Saved Rekor search to /tmp/rekor_search.json"
+fi
+
+echo "Recording evidence manifest"
+python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("kms_rotation", {"new_kms": "$NEW_KMS_URI", "smoke_signed_file": "$TMPFILE"})
+PY
+
+echo "Rotation and smoke signing complete. Keep $TMPFILE for audit if needed."
+
