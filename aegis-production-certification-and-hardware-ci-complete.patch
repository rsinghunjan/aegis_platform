+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run hardware validation sequence on a self-hosted runner with attached accelerator device(s).
+# Steps:
+#  - Build image (Dockerfile path provided)
+#  - Run smoke tests that exercise the device runtime
+#  - If successful, push image, sign with cosign (KMS), and verify Rekor entry (optional)
+#
+IMAGE_TAG=${1:-internal-registry/aegis/hw-image:latest}
+DOCKERFILE=${2:-ops/hw/inferentia/Dockerfile.neuron}
+SMOKE_CMD=${3:-"/workspace/ops/hw/ci/hardware_smoke_test.sh"}
+
+echo "Building image $IMAGE_TAG from $DOCKERFILE"
+docker build -f "$DOCKERFILE" -t "$IMAGE_TAG" .
+
+echo "Running smoke test container"
+docker run --rm --privileged "$IMAGE_TAG" bash -lc "$SMOKE_CMD"
+
+echo "Pushing image to registry"
+docker push "$IMAGE_TAG"
+
+if [ -z "${COSIGN_KMS_URI:-}" ]; then
+  echo "COSIGN_KMS_URI not set; skipping cosign sign"
+else
+  echo "Signing with cosign (KMS=$COSIGN_KMS_URI)"
+  cosign sign --key "$COSIGN_KMS_URI" "$IMAGE_TAG"
+  cosign verify --key "$COSIGN_KMS_URI" "$IMAGE_TAG"
+fi
+
+echo "Recording evidence manifest for validated hardware image"
+python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("hardware_image_validated_runner", {"image":"$IMAGE_TAG"})
+PY
+
