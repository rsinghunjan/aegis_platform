+"""
+Simple permission check helper for route-level enforcement.
+"""
+from fastapi import Request, HTTPException
+import json, os
+
+RBAC_PATH = os.environ.get("RBAC_POLICY_FILE", "/etc/mcp/rbac_policy.json")
+
+def load_policy():
+    try:
+        with open(RBAC_PATH) as f:
+            return json.load(f)
+    except Exception:
+        return {"roles": {}, "mappings": {}}
+
+POLICY = load_policy()
+
+def check_permission(request: Request, permission: str):
+    sub = getattr(request.state, "subject", None)
+    if not sub:
+        raise HTTPException(status_code=401, detail="unauthenticated")
+    # JWT should have roles in request.state.roles set by middleware
+    roles = getattr(request.state, "roles", [])
+    for r in roles:
+        perms = POLICY.get("roles", {}).get(r, {}).get("permissions", [])
+        if "*" in perms or permission in perms:
+            return True
+    raise HTTPException(status_code=403, detail="forbidden")
+
