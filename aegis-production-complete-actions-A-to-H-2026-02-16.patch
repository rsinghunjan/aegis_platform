+#!/usr/bin/env bash
+# Simple pre-commit scan to block SECRET keywords (example)
+FILES=$(git diff --cached --name-only)
+for f in $FILES; do
+  if grep -E -n "VAULT_TOKEN|AWS_SECRET_ACCESS_KEY|PRIVATE KEY|GITHUB_TOKEN" "$f" >/dev/null 2>&1; then
+    echo "Potential secret in $f - aborting commit. Run migration scripts to remove static secrets."
+    exit 1
+  fi
+done
+exit 0
