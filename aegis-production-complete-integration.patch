+"""
+import json, os, tempfile
+from ops.sdk.evidence_sdk import record_manifest, sign_and_publish_model
+
+def record_approval_evidence(action_name, approver, note=None):
+    manifest_payload = {"action": action_name, "approver": approver, "note": note}
+    # record manifest via evidence SDK (local pending queue or safety_monitor integration)
+    mpath = record_manifest("approval_recorded", manifest_payload)
+    # if cosign available, write a small artifact and sign/upload
+    cosign = os.environ.get("COSIGN_KMS_URI")
+    bucket = os.environ.get("EVIDENCE_BUCKET") or os.environ.get("MODEL_ARTIFACT_BUCKET")
+    if cosign and bucket:
+        with tempfile.NamedTemporaryFile("w", delete=False, suffix=".json") as fh:
+            fh.write(json.dumps(manifest_payload))
+            fh.flush()
+            res = sign_and_publish_model(fh.name, {"approval": action_name, "approver": approver}, bucket=bucket, cosign_kms_uri=cosign, rekor_server=os.environ.get("REKOR_SERVER"))
+        return {"manifest_path": mpath, "publish_result": res}
+    return {"manifest_path": mpath}
