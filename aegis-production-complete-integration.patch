+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: aegis-vllm-throughput-test
+spec:
+  template:
+    spec:
+      containers:
+        - name: load
+          image: python:3.10-slim
+          command: ["bash", "-c"]
+          args:
+            - pip install grpcio && python3 - <<PY
+import grpc, time, concurrent.futures, os
+from ops.proto import generation_pb2, generation_pb2_grpc
+def call_once(i):
+    ch = grpc.insecure_channel("aegis-vllm:50054")
+    stub = generation_pb2_grpc.GenerationStub(ch)
+    req = generation_pb2.GenerationRequest(prompt=f"throughput test {i}", max_tokens=32, stream=True)
+    try:
+        for tok in stub.StreamGenerate(req, timeout=60):
+            pass
+        return True
+    except Exception as e:
+        return False
+with concurrent.futures.ThreadPoolExecutor(max_workers=10) as ex:
+    futures = [ex.submit(call_once, i) for i in range(200)]
+    results = [f.result() for f in futures]
+print("success_ratio:", sum(results)/len(results))
+PY
+      restartPolicy: Never
+  backoffLimit: 2
+
