+#!/usr/bin/env python3
+"""
+Conversation persistence via Chroma for LangChain demo.
+ - store_conversation(session_id, message, role)
+ - load_conversation(session_id)
+ - snapshot/restore helpers rely on ops/backup/chroma_snapshot.sh
+"""
+from typing import List, Dict
+try:
+    import chromadb
+    from chromadb.config import Settings
+except Exception:
+    chromadb = None
+
+COL_DIR = "data/chroma"
+
+def _get_client(persist_directory=COL_DIR):
+    if chromadb is None:
+        raise RuntimeError("chromadb not installed")
+    return chromadb.Client(Settings(persist_directory=persist_directory, anonymized_telemetry=False))
+
+def store_conversation(session_id: str, message: str, role: str = "user"):
+    client = _get_client()
+    col = client.get_or_create_collection("conversations")
+    # use id: session_id + timestamp
+    import time
+    sid = f"{session_id}-{int(time.time()*1000)}"
+    col.add(ids=[sid], documents=[message], metadatas=[{"session": session_id, "role": role, "ts": int(time.time())}])
+    client.persist()
+    return sid
+
+def load_conversation(session_id: str, limit: int = 50) -> List[Dict]:
+    client = _get_client()
+    col = client.get_collection("conversations")
+    res = col.query(query_texts=[""], where={"session": session_id}, n_results=limit)
+    # chroma query with where may vary; fallback to retrieving all docs and filtering
+    # Best-effort: return latest items by metadata timestamp
+    docs = []
+    for i,doc in enumerate(res.get("documents",[[]])[0]):
+        docs.append({"id": res["ids"][0][i], "doc": doc})
+    return docs
+
