+#!/usr/bin/env python3
+"""
+AWS Rekognition + Comprehend based moderation provider adapter.
+ - Image moderation via Rekognition DetectModerationLabels
+ - Text PII detection via Comprehend PII detection
+Requires AWS CLI credentials or IAM role on host.
+"""
+import os, boto3, json
+
+def moderate_image_bytes_aws(image_bytes, min_confidence=70):
+    rek = boto3.client("rekognition", region_name=os.environ.get("AWS_REGION","us-west-2"))
+    resp = rek.detect_moderation_labels(Image={'Bytes': image_bytes}, MinConfidence=min_confidence)
+    labels = resp.get("ModerationLabels", [])
+    # Map to verdict
+    block_reasons = [l for l in labels if l.get("Confidence",0) >= min_confidence]
+    if block_reasons:
+        return {"verdict":"block","reasons":[l["Name"] for l in block_reasons],"confidence": max(l["Confidence"] for l in block_reasons)/100.0}
+    return {"verdict":"allow","reasons":[],"confidence": 1.0}
+
+def moderate_text_pii_aws(text):
+    comp = boto3.client("comprehend", region_name=os.environ.get("AWS_REGION","us-west-2"))
+    resp = comp.detect_pii_entities(Text=text, LanguageCode="en")
+    ents = resp.get("Entities", [])
+    if ents:
+        return {"verdict":"review","reasons":[e["Type"] for e in ents], "confidence": 0.5}
+    return {"verdict":"allow","reasons":[], "confidence": 0.99}
+
+if __name__=="__main__":
+    print("aws moderation adapter")
+
