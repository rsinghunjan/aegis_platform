+#!/usr/bin/env bash
+set -euo pipefail
+# Advanced script to provision and harden a self-hosted runner for TPU/Neuron hosts
+# - Installs vendor runtimes if specified (placeholders)
+# - Creates a minimal dedicated user, configures docker, registers runner with GitHub
+
+USER=${1:-aegis-runner}
+REPO=${2:-owner/repo}
+TOKEN=${3:-}
+LABELS=${4:-"self-hosted,neuron,tpu"}
+RUNNER_VER=${5:-"2.303.0"}
+
+if [ -z "$TOKEN" ]; then
+  echo "Usage: $0 <user> <owner/repo> <runner_token> [labels] [runner_version]"
+  exit 2
+fi
+
+echo "Creating dedicated user"
+adduser --system --group --home /home/$USER $USER || true
+
+echo "Install minimal tools"
+apt-get update
+apt-get install -y docker.io curl ca-certificates apt-transport-https gnupg lsb-release
+systemctl enable docker
+
+echo "Configure docker daemon for security"
+cat > /etc/docker/daemon.json <<EOF
+{
+  "userns-remap": "default",
+  "icc": false,
+  "no-new-privileges": true,
+  "live-restore": true
+}
+EOF
+systemctl restart docker
+
+echo "Install runner"
+mkdir -p /opt/actions-runner
+chown $USER:$USER /opt/actions-runner
+cd /opt/actions-runner
+curl -O -L https://github.com/actions/runner/releases/download/v${RUNNER_VER}/actions-runner-linux-x64-${RUNNER_VER}.tar.gz
+tar xzf actions-runner-linux-x64-${RUNNER_VER}.tar.gz
+sudo -u $USER ./config.sh --url "https://github.com/${REPO}" --token "${TOKEN}" --labels "${LABELS}" --unattended
+sudo -u $USER ./svc.sh install
+sudo -u $USER ./svc.sh start
+
+echo "Runner installed. Next steps (operator):"
+echo "- Install vendor-specific runtime (Neuron, TPU) following vendor docs."
+echo "- Lock down instance with host firewall and minimal open ports."
+echo "- Attach instance to monitoring and alerting (Prometheus node exporter)."
