+#!/usr/bin/env python3
+"""
+Google Cloud Vision + DLP moderation adapter (example)
+ - Requires GOOGLE_APPLICATION_CREDENTIALS env var set to service account JSON
+"""
+import os, json
+from google.cloud import vision, dlp_v2
+
+def moderate_image_bytes_google(image_bytes):
+    client = vision.ImageAnnotatorClient()
+    image = vision.Image(content=image_bytes)
+    resp = client.safe_search_detection(image=image)
+    ss = resp.safe_search_annotation
+    # simple mapping: if adult/violence likelihood >= VERY_LIKELY => block
+    thresholds = ["UNKNOWN","VERY_UNLIKELY","UNLIKELY","POSSIBLE","LIKELY","VERY_LIKELY"]
+    if thresholds.index(str(ss.adult)) >= thresholds.index("VERY_LIKELY"):
+        return {"verdict":"block","reasons":["adult"], "confidence": 0.9}
+    return {"verdict":"allow","reasons":[], "confidence": 0.99}
+
+def moderate_text_pii_google(text):
+    dlp = dlp_v2.DlpServiceClient()
+    parent = f"projects/{os.environ.get('GOOGLE_PROJECT')}"
+    inspect_config = {"info_types": [{"name":"US_SOCIAL_SECURITY_NUMBER"}, {"name":"EMAIL_ADDRESS"}], "include_quote": True}
+    item = {"value": text}
+    resp = dlp.inspect_content(request={"parent": parent, "inspect_config": inspect_config, "item": item})
+    findings = resp.result.findings
+    if findings:
+        return {"verdict":"review","reasons":[f.finding_type.name for f in findings], "confidence": 0.5}
+    return {"verdict":"allow","reasons":[], "confidence": 0.99}
+
+if __name__=="__main__":
+    print("google moderation adapter")
+
