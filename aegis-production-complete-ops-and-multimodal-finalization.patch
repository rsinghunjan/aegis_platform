+/*
+Operator-ready Terraform template: AWS CloudHSM cluster + guidance to register a KMS Custom Key Store.
+
+WARNING: This file is a template and many steps require manual operator intervention (CloudHSM initialization,
+KMS Custom Key Store creation in console, and key material creation). Use only after security review.
+
+Steps:
+ 1. Populate variables for VPC/subnet ids where HSMs will be placed (private subnets).
+ 2. Apply to create CloudHSM cluster resources. Follow AWS docs to initialize HSM cluster via CLI/console.
+ 3. Create KMS Custom Key Store pointing to the CloudHSM cluster (console/CLI). Create asymmetric signing keys.
+ 4. Record resulting key ARN/refs, run ops/hsm/issue_key_manifest.py to create issuance manifest and upload to evidence bucket.
+ 5. Sync key refs to Vault using ops/hsm/sync_keys_to_vault.sh.
+*/
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = ">= 4.0" }
+  }
+}
+
+provider "aws" {
+  region = var.aws_region
+}
+
+variable "aws_region" { type = string, default = "us-west-2" }
+variable "hsm_subnet_ids" { type = list(string), default = [] }
+variable "vpc_id" { type = string, default = "" }
+
+resource "aws_cloudhsm_v2_cluster" "aegis_cloudhsm" {
+  # Operator must provide subnet_ids with at least two private subnets in different AZs
+  subnet_ids = var.hsm_subnet_ids
+  hsm_type = "hsm1.medium"
+  # Note: on create you'll receive a cluster_id and HSMs; operator must initialize cluster manually
+}
+
+# Output cluster id and ENIs to help ops team finalize network steps
+output "cloudhsm_cluster_id" {
+  value = aws_cloudhsm_v2_cluster.aegis_cloudhsm.cluster_id
+}
+
+output "cloudhsm_subnet_ids" {
+  value = aws_cloudhsm_v2_cluster.aegis_cloudhsm.hsm_ips
+  description = "IP addresses of HSMs (useful for operator verification)"
+}
+
+/*
+Operator runbook (quick):
+ - After terraform apply, run: aws cloudhsmv2 initialize-cluster --cluster-id <id> ...
+ - Follow AWS CloudHSM docs to activate the cluster and the HSMs.
+ - In KMS console, create a Custom Key Store backed by the CloudHSM cluster.
+ - Create an asymmetric key (sign/verify) in the custom key store; record the key ARN.
+ - Use ops/hsm/issue_key_manifest.py to record issuance, then ops/hsm/sync_keys_to_vault.sh to save refs to Vault.
+ - Test signing via cosign using aws-kms key reference (cosign supports aws-kms).
+*/
