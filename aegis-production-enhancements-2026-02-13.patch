+#!/usr/bin/env python3
+"""
+Simple Consent Manager service.
+Stores user/player consent records and retention policies.
+This is a minimal implementation for demo; use a proper DB and authentication in production.
+"""
+from flask import Flask, request, jsonify
+import sqlite3
+import os
+from datetime import datetime, timedelta
+
+DB_PATH = os.environ.get("CONSENT_DB", "/data/consent.db")
+app = Flask(__name__)
+os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+conn = sqlite3.connect(DB_PATH, check_same_thread=False)
+conn.execute("""CREATE TABLE IF NOT EXISTS consents (
+    id TEXT PRIMARY KEY,
+    subject_id TEXT,
+    purpose TEXT,
+    granted INTEGER,
+    granted_ts TEXT,
+    expires_ts TEXT
+)""")
+conn.commit()
+
+@app.route("/consent", methods=["POST"])
+def grant_consent():
+    j = request.json or {}
+    subject = j.get("subject_id")
+    purpose = j.get("purpose", "general")
+    duration_days = int(j.get("duration_days", 365))
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    uid = f"{subject}-{purpose}"
+    now = datetime.utcnow()
+    expires = now + timedelta(days=duration_days)
+    conn.execute("REPLACE INTO consents (id,subject_id,purpose,granted,granted_ts,expires_ts) VALUES (?,?,?,?,?,?)",
+                 (uid, subject, purpose, 1, now.isoformat()+"Z", expires.isoformat()+"Z"))
+    conn.commit()
+    return jsonify({"status":"granted","subject_id":subject,"purpose":purpose,"expires":expires.isoformat()+"Z"})
+
+@app.route("/consent", methods=["GET"])
+def check_consent():
+    subject = request.args.get("subject_id")
+    purpose = request.args.get("purpose","general")
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    uid = f"{subject}-{purpose}"
+    cur = conn.execute("SELECT granted,expires_ts FROM consents WHERE id=?", (uid,))
+    row = cur.fetchone()
+    if not row:
+        return jsonify({"consent": False})
+    granted, expires_ts = row
+    if not granted:
+        return jsonify({"consent": False})
+    if expires_ts and datetime.fromisoformat(expires_ts.replace("Z","")) < datetime.utcnow():
+        return jsonify({"consent": False})
+    return jsonify({"consent": True, "expires": expires_ts})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
