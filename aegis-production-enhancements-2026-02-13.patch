+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Label nodes for PREEMPT_RT and kata runtime scheduling and provide basic checks.
+#
+if [ $# -lt 1 ]; then
+  echo "usage: provision_preempt_nodes.sh <node-name> [<node-name>...]"
+  exit 2
+fi
+for node in "$@"; do
+  echo "Labeling ${node} as edge and preempt-rt"
+  kubectl label node "${node}" node-role.kubernetes.io/edge=true --overwrite || true
+  kubectl label node "${node}" runtime/preempt-rt=true --overwrite || true
+  echo "Tainting ${node} to prefer edge workloads"
+  kubectl taint nodes "${node}" dedicated=edge:NoSchedule- || true
+  echo "Checking kernel version for PREEMPT_RT"
+  echo "ssh to ${node} and verify PREEMPT_RT patching (operator action)"
+done
+echo "Provisioning complete. Ensure node images include PREEMPT_RT and kata runtime installed."
