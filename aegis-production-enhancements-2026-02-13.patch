+#!/usr/bin/env python3
+"""
+encrypt_store_kms.py
+Production-ready helper to encrypt and store artifacts using KMS (Vault Transit or cloud KMS)
+and upload to S3 or MinIO. Also tags objects with consent/retention metadata.
+
+Environment:
+ - STORAGE_BACKEND: s3|minio
+ - S3_BUCKET: bucket name
+ - AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (if using AWS)
+ - MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY (if using MinIO)
+ - SIGNER_BACKEND: vault|aws (used for recording envelope key if needed)
+ - KMS_KEY_ID: AWS KMS key id (if using AWS)
+ - VAULT_ADDR, VAULT_TOKEN, VAULT_TRANSIT_KEY (if using Vault transit)
+ - CONSENT_API: http://consent-service:8080 to verify consent before storing originals
+ - RETENTION_DAYS_DEFAULT: default retention
+"""
+import os
+import json
+import base64
+import boto3
+from botocore.client import Config
+import requests
+
+STORAGE_BACKEND = os.environ.get("STORAGE_BACKEND", "s3")
+S3_BUCKET = os.environ.get("S3_BUCKET", "aegis-artifacts")
+KMS_KEY_ID = os.environ.get("KMS_KEY_ID", "")
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")
+VAULT_TRANSIT_KEY = os.environ.get("VAULT_TRANSIT_KEY", "aegis-encrypt")
+CONSENT_API = os.environ.get("CONSENT_API", "http://consent-service.aegis-system.svc.cluster.local:8080")
+RETENTION_DEFAULT = int(os.environ.get("RETENTION_DAYS_DEFAULT", "365"))
+
+def check_consent(subject_id: str, purpose: str) -> bool:
+    try:
+        r = requests.get(f"{CONSENT_API}/consent?subject_id={subject_id}&purpose={purpose}", timeout=3.0)
+        if r.ok:
+            j = r.json()
+            return bool(j.get("consent", False))
+    except Exception:
+        # Fail closed: if consent API not reachable, deny
+        return False
+    return False
+
+def upload_with_ssekms(key: str, data: bytes, metadata: dict):
+    if STORAGE_BACKEND == "minio":
+        s3 = boto3.client("s3",
+                          endpoint_url=os.environ.get("MINIO_ENDPOINT"),
+                          aws_access_key_id=os.environ.get("MINIO_ACCESS_KEY"),
+                          aws_secret_access_key=os.environ.get("MINIO_SECRET_KEY"),
+                          config=Config(signature_version="s3v4"),
+                          region_name=os.environ.get("AWS_REGION"))
+        # MinIO may not support SSE-KMS; use server-side encryption not enforced here
+        extra_args = {"Metadata": metadata or {}}
+    else:
+        s3 = boto3.client("s3", region_name=os.environ.get("AWS_REGION"))
+        extra_args = {"ServerSideEncryption": "aws:kms", "SSEKMSKeyId": KMS_KEY_ID, "Metadata": metadata or {}}
+
+    s3.put_object(Bucket=S3_BUCKET, Key=key, Body=data, **extra_args)
+    return {"bucket": S3_BUCKET, "key": key}
+
+def encrypt_and_store(artifact_id: str, data: bytes, subject_id: str, purpose: str, retention_days: int = None):
+    """
+    Validate consent, then store redacted + encrypted original.
+    Returns metadata dict for audit.
+    """
+    if not check_consent(subject_id, purpose):
+        raise PermissionError("No consent for subject/purpose")
+
+    retention = retention_days or RETENTION_DEFAULT
+    metadata = {"subject_id": subject_id, "purpose": purpose, "retention_days": str(retention)}
+
+    # Upload encrypted original using SSE-KMS or MinIO
+    key = f"originals/{artifact_id}.bin"
+    res = upload_with_ssekms(key, data, metadata)
+
+    # Record audit to MCP (best-effort)
+    try:
+        mcp = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+        requests.post(f"{mcp.rstrip('/')}/artifacts", json={"id": artifact_id, "bucket": res["bucket"], "key": res["key"], "metadata": metadata}, timeout=3.0)
+    except Exception:
+        pass
+
+    return {"artifact_id": artifact_id, "bucket": res["bucket"], "key": res["key"], "metadata": metadata}
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 4:
+        print("usage: encrypt_store_kms.py <artifact_id> <subject_id> <file>")
+        raise SystemExit(2)
+    aid = sys.argv[1]
+    subject = sys.argv[2]
+    with open(sys.argv[3], "rb") as f:
+        data = f.read()
+    print(encrypt_and_store(aid, data, subject, "research"))
+
