+#!/usr/bin/env python3
+"""
+Enhanced retrieval guard:
+ - Checks consent via Consent Manager
+ - Verifies A2A approval if required
+ - Logs retrieval audit events to MCP
+"""
+import os
+import requests
+
+CONSENT_API = os.environ.get("CONSENT_API", "http://consent-service.aegis-system.svc.cluster.local:8080")
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def has_consent(subject_id: str, purpose: str) -> bool:
+    try:
+        r = requests.get(f"{CONSENT_API}/consent?subject_id={subject_id}&purpose={purpose}", timeout=3.0)
+        if r.ok:
+            return r.json().get("consent", False)
+    except Exception:
+        return False
+    return False
+
+def check_a2a(artifact_id: str, requester: str) -> bool:
+    try:
+        r = requests.get(f"{A2A_API.rstrip('/')}/approval?artifact_id={artifact_id}&requester={requester}", timeout=3.0)
+        if r.ok:
+            return r.json().get("approved", False)
+    except Exception:
+        return False
+    return False
+
+def audit_retrieval(artifact_id: str, requester: str, granted: bool, reason: str = ""):
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/audit/retrieval", json={"artifact_id":artifact_id,"requester":requester,"granted":granted,"reason":reason}, timeout=2.0)
+    except Exception:
+        pass
+
+def can_retrieve_original(artifact_id: str, subject_id: str, requester: str, purpose: str="research"):
+    # consent check
+    if not has_consent(subject_id, purpose):
+        audit_retrieval(artifact_id, requester, granted=False, reason="no_consent")
+        return False
+    # check A2A or offline fetchtoken logic (delegated)
+    if not check_a2a(artifact_id, requester):
+        audit_retrieval(artifact_id, requester, granted=False, reason="no_a2a")
+        return False
+    audit_retrieval(artifact_id, requester, granted=True, reason="consent_and_a2a")
+    return True
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 4:
+        print("usage: retrieval_guard_enforce.py <artifact_id> <subject_id> <requester>")
+        raise SystemExit(2)
+    print(can_retrieve_original(sys.argv[1], sys.argv[2], sys.argv[3]))
+
