+#!/usr/bin/env python3
+"""
+Collect Gatekeeper constraint violations and post a remediation report to MCP (or print CSV).
+Requires kubectl on PATH with cluster access.
+"""
+import os
+import subprocess
+import json
+import csv
+import tempfile
+import requests
+
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def kubectl_json(path):
+    r = subprocess.run(["kubectl","get",path,"-o","json"], capture_output=True, text=True, check=False)
+    if r.returncode != 0:
+        return None
+    return json.loads(r.stdout)
+
+def collect_violations():
+    # Gatekeeper uses 'constraints' of various kinds; fetch all constraints and look for status.violations
+    kinds = ["constraints.gatekeeper.sh/v1beta1"]  # generic fetch; we'll get all constraint CRDs via 'kubectl get --raw'
+    out = subprocess.run(["kubectl","get","--raw","/apis/constraints.gatekeeper.sh/v1beta1"], capture_output=True, text=True, check=False)
+    if out.returncode != 0:
+        print("Failed to query Gatekeeper constraints API")
+        return []
+    j = json.loads(out.stdout)
+    # The above returns constraint types; we will attempt a broad query via 'kubectl get' for known constraints from the repo
+    # For simplicity, query all CRs in all namespaces
+    r = subprocess.run(["kubectl","get","constraints","--all-namespaces","-o","json"], capture_output=True, text=True, check=False)
+    if r.returncode != 0:
+        # fallback: try 'kubectl get pod -A' to at least produce an empty list
+        return []
+    cj = json.loads(r.stdout)
+    violations = []
+    for item in cj.get("items", []):
+        status = item.get("status", {})
+        vs = status.get("violations", [])
+        for v in vs:
+            violations.append({
+                "constraint": item.get("metadata",{}).get("name"),
+                "namespace": v.get("namespace"),
+                "message": v.get("message"),
+                "resource": v.get("kind") + "/" + v.get("name"),
+            })
+    return violations
+
+def post_report(violations):
+    if not violations:
+        print("No gatekeeper violations found.")
+        return
+    payload = {"ts": __import__("time").time(), "violations": violations}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/governance/gatekeeper_violations", json=payload, timeout=5.0)
+        print("Posted violations to MCP")
+    except Exception:
+        # write to temp CSV
+        fd, path = tempfile.mkstemp(prefix="gatekeeper_violations_", suffix=".csv")
+        with os.fdopen(fd,"w",newline="") as csvfile:
+            w = csv.DictWriter(csvfile, fieldnames=["constraint","namespace","resource","message"])
+            w.writeheader()
+            for v in violations:
+                w.writerow(v)
+        print("Wrote violations CSV to", path)
+
+if __name__ == "__main__":
+    v = collect_violations()
+    post_report(v)
+
