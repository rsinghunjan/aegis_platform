+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Install HashiCorp Vault via Helm in HA mode and bootstrap Kubernetes auth, transit and KV for cosign keys.
+# Operator MUST run this from a machine with kubectl/helm configured to the target cluster.
+#
+NAMESPACE=${1:-aegis-system}
+HELM_RELEASE=${2:-vault}
+VAULT_ADDR="http://vault.${NAMESPACE}.svc.cluster.local:8200"
+
+echo "Creating namespace ${NAMESPACE} (if missing)"
+kubectl create ns ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Adding HashiCorp Helm repo"
+helm repo add hashicorp https://helm.releases.hashicorp.com || true
+helm repo update
+
+cat <<EOF > /tmp/vault-values.yaml
+server:
+  ha:
+    enabled: true
+  dataStorage:
+    enabled: true
+service:
+  type: ClusterIP
+ui:
+  enabled: true
+injector:
+  enabled: true
+initContainers:
+  enabled: false
+EOF
+
+echo "Installing Vault Helm release ${HELM_RELEASE} into ${NAMESPACE}"
+helm upgrade --install ${HELM_RELEASE} hashicorp/vault -n ${NAMESPACE} -f /tmp/vault-values.yaml
+
+echo "Waiting for Vault pods to be ready..."
+kubectl -n ${NAMESPACE} rollout status deployment/${HELM_RELEASE}-server --timeout=5m || true
+
+echo "Initialize/Unseal (if using dev mode you can skip)."
+echo "To initialize VAULT in HA, follow HashiCorp docs. This script assumes Vault is ready and reachable at ${VAULT_ADDR}."
+
+cat <<'DOC'
+Next manual bootstrap steps (operator):
+1) Initialize/unseal Vault or configure auto-unseal with cloud KMS.
+2) Create a policy allowing transit/encrypt/sign and kv read/write for a Kubernetes role:
+   - Policy JSON example:
+     path "transit/*" { capabilities = ["encrypt","decrypt","sign","verify","read"] }
+     path "kv/data/cosign" { capabilities = ["create","read","update","delete"] }
+3) Enable Kubernetes auth and create a role bound to a ServiceAccount so pods can use Vault (see Vault docs).
+4) Store cosign keys into kv or use transit to hold signing keys:
+   - kubectl exec -n aegis-system <vault-pod> -- vault kv put kv/cosign private_key="$(cat cosign.key)"
+   - Or use transit: vault write -f transit/keys/cosign-signing
+5) Configure your services to use Vault (VAULT_ADDR, and Kubernetes service account token) and ensure RBAC is minimal.
+DOC
+
+echo "Vault Helm install done. Remember to perform init/unseal and create policies/roles."
+
