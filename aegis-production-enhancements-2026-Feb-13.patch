+#!/usr/bin/env python3
+"""
+encrypt_store_vault.py
+Encrypts artifacts using Vault Transit then stores ciphertext in object storage (S3/MinIO).
+This avoids storing plaintext in the cluster or object-store.
+
+Environment:
+ - VAULT_ADDR, VAULT_TOKEN
+ - TRANSIT_KEY_NAME: previously created transit key (must allow encrypt)
+ - STORAGE_BACKEND: s3|minio
+ - S3_BUCKET, MINIO_ENDPOINT, etc.
+ - AWS_REGION/AWS creds for S3
+ - AEGIS_MCP_API for audit recording
+"""
+import os
+import requests
+import base64
+import boto3
+from botocore.client import Config
+
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "http://vault.aegis-system.svc.cluster.local:8200")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")
+TRANSIT_KEY = os.environ.get("TRANSIT_KEY_NAME", "aegis-transit")
+STORAGE_BACKEND = os.environ.get("STORAGE_BACKEND", "s3")
+S3_BUCKET = os.environ.get("S3_BUCKET", "aegis-artifacts")
+
+def vault_encrypt(data: bytes) -> str:
+    url = f"{VAULT_ADDR.rstrip('/')}/v1/transit/encrypt/{TRANSIT_KEY}"
+    b64 = base64.b64encode(data).decode()
+    body = {"plaintext": b64}
+    headers = {"X-Vault-Token": VAULT_TOKEN} if VAULT_TOKEN else {}
+    r = requests.post(url, json=body, headers=headers, timeout=10)
+    r.raise_for_status()
+    return r.json()["data"]["ciphertext"]
+
+def upload_ciphertext(artifact_id: str, ciphertext: str, metadata: dict = None):
+    key = f"originals/{artifact_id}.enc"
+    if STORAGE_BACKEND == "minio":
+        s3 = boto3.client("s3",
+                          endpoint_url=os.environ.get("MINIO_ENDPOINT"),
+                          aws_access_key_id=os.environ.get("MINIO_ACCESS_KEY"),
+                          aws_secret_access_key=os.environ.get("MINIO_SECRET_KEY"),
+                          config=Config(signature_version="s3v4"),
+                          region_name=os.environ.get("AWS_REGION"))
+        s3.put_object(Bucket=S3_BUCKET, Key=key, Body=ciphertext.encode(), Metadata=metadata or {})
+    else:
+        s3 = boto3.client("s3", region_name=os.environ.get("AWS_REGION"))
+        # store ciphertext as object; lifecycle and access controlled via S3 policies
+        s3.put_object(Bucket=S3_BUCKET, Key=key, Body=ciphertext.encode(), Metadata=metadata or {})
+    return {"bucket": S3_BUCKET, "key": key}
+
+def encrypt_store(artifact_id: str, data: bytes, metadata: dict = None):
+    ct = vault_encrypt(data)
+    res = upload_ciphertext(artifact_id, ct, metadata)
+    # record to MCP
+    try:
+        mcp = os.environ.get("AEGIS_MCP_API", "")
+        if mcp:
+            requests.post(f"{mcp.rstrip('/')}/artifacts", json={"id":artifact_id,"bucket":res["bucket"],"key":res["key"],"metadata":metadata or {}}, timeout=3.0)
+    except Exception:
+        pass
+    return res
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("usage: encrypt_store_vault.py <artifact_id> <file>")
+        raise SystemExit(2)
+    aid = sys.argv[1]
+    with open(sys.argv[2],"rb") as f:
+        data = f.read()
+    print(encrypt_store(aid, data, {"uploaded-by":"encrypt_store_vault"}))
+
