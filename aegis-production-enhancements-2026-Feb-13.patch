+#!/usr/bin/env python3
+"""
+WSGI middleware to expose Prometheus metrics and instrument request durations.
+Usage: wrap Flask/WSGI app with MetricsMiddleware(app, service_name="webhook")
+"""
+from prometheus_client import Counter, Histogram, generate_latest, CONTENT_TYPE_LATEST
+from time import time
+from wsgiref.util import setup_testing_defaults
+
+REQUEST_LATENCY = Histogram("aegis_request_latency_seconds", "Request latency", ["service","path"])
+REQUEST_COUNT = Counter("aegis_request_count_total", "Request count", ["service","path","status"])
+
+class MetricsMiddleware:
+    def __init__(self, app, service_name="aegis-service"):
+        self.app = app
+        self.service = service_name
+
+    def __call__(self, environ, start_response):
+        path = environ.get("PATH_INFO", "/")
+        if path == "/metrics":
+            data = generate_latest()
+            start_response("200 OK", [("Content-Type", CONTENT_TYPE_LATEST)])
+            return [data]
+        start = time()
+        def custom_start_response(status, headers, exc_info=None):
+            status_code = int(status.split()[0])
+            duration = time() - start
+            REQUEST_LATENCY.labels(self.service, path).observe(duration)
+            REQUEST_COUNT.labels(self.service, path, status_code).inc()
+            return start_response(status, headers, exc_info)
+        return self.app(environ, custom_start_response)
+
