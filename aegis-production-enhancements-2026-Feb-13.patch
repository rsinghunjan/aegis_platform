+#!/usr/bin/env python3
+"""
+Simple retry worker for edge -> central sync failures.
+This script watches a local directory for failed sync items and retries with exponential backoff.
+
+Configuration:
+ - FAILED_DIR (default /data/sync_failed)
+ - RETRY_INTERVAL_BASE (seconds)
+ - MAX_ATTEMPTS
+ - CENTRAL_UPLOAD_URL (where to POST payloads)
+"""
+import os
+import time
+import json
+import requests
+
+FAILED_DIR = os.environ.get("FAILED_DIR", "/data/sync_failed")
+BASE = int(os.environ.get("RETRY_INTERVAL_BASE", "5"))
+MAX_ATTEMPTS = int(os.environ.get("MAX_ATTEMPTS", "6"))
+CENTRAL_UPLOAD = os.environ.get("CENTRAL_UPLOAD_URL", "http://milvus.central.svc.cluster.local:19530/sync")
+
+os.makedirs(FAILED_DIR, exist_ok=True)
+
+def backoff(attempt):
+    return BASE * (2 ** attempt)
+
+def retry_loop():
+    while True:
+        for fn in os.listdir(FAILED_DIR):
+            path = os.path.join(FAILED_DIR, fn)
+            try:
+                with open(path,"rb") as f:
+                    payload = f.read()
+                meta_path = path + ".meta"
+                attempts = 0
+                if os.path.exists(meta_path):
+                    with open(meta_path,"r") as m:
+                        attempts = int(m.read().strip())
+                if attempts >= MAX_ATTEMPTS:
+                    print("Max attempts reached for", fn, "- leaving for operator remediaton")
+                    continue
+                # attempt upload
+                r = requests.post(CENTRAL_UPLOAD, data=payload, timeout=10)
+                if r.ok:
+                    print("Resync success", fn)
+                    os.remove(path)
+                    if os.path.exists(meta_path):
+                        os.remove(meta_path)
+                else:
+                    attempts += 1
+                    with open(meta_path,"w") as m:
+                        m.write(str(attempts))
+                    sleep = backoff(attempts)
+                    print("Resync failed, will retry after", sleep, "s")
+                    time.sleep(sleep)
+            except Exception as e:
+                print("Error handling", fn, e)
+        time.sleep(10)
+
+if __name__ == "__main__":
+    retry_loop()
+
