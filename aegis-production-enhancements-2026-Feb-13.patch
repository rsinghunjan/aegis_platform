+#!/usr/bin/env python3
+"""
+Production receipt signer that uses Vault Transit to sign payloads and records a minimal entry to Rekor.
+
+Expected environment:
+ - VAULT_ADDR (e.g., https://vault.aegis-system.svc:8200)
+ - VAULT_TOKEN or use Kubernetes ServiceAccount + Vault Agent sidecar (recommended)
+ - TRANSIT_KEY_NAME: transit key name created in Vault (e.g., "cosign-signing")
+ - REKOR_URL (optional) to record entries
+ - TIMEOUT_SECONDS optional
+"""
+import os
+import json
+import base64
+import requests
+from typing import Dict
+
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "http://vault.aegis-system.svc.cluster.local:8200")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")
+TRANSIT_KEY = os.environ.get("TRANSIT_KEY_NAME", "cosign-signing")
+REKOR_URL = os.environ.get("REKOR_URL", "")
+TIMEOUT = int(os.environ.get("TIMEOUT_SECONDS", "5"))
+
+def vault_sign(payload: Dict) -> Dict:
+    """
+    Calls Vault Transit sign endpoint. Returns the Vault response (signature blob).
+    """
+    url = f"{VAULT_ADDR.rstrip('/')}/v1/transit/sign/{TRANSIT_KEY}"
+    b64 = base64.b64encode(json.dumps(payload, separators=(",", ":")).encode()).decode()
+    body = {"input": b64, "prehashed": False}
+    headers = {"X-Vault-Token": VAULT_TOKEN} if VAULT_TOKEN else {}
+    r = requests.post(url, json=body, headers=headers, timeout=TIMEOUT)
+    r.raise_for_status()
+    return r.json()
+
+def record_rekor(payload: Dict, signature_blob: Dict):
+    if not REKOR_URL:
+        return
+    entry = {"payload": payload, "signature": signature_blob}
+    try:
+        requests.post(f"{REKOR_URL.rstrip('/')}/api/v1/log/entries", json=entry, timeout=TIMEOUT)
+    except Exception:
+        # best-effort; do not fail signing if Rekor unreachable
+        pass
+
+def sign_and_record(payload: Dict) -> Dict:
+    """
+    Signs payload in Vault and records to Rekor. Returns a dict with signature metadata.
+    """
+    sig = vault_sign(payload)
+    record_rekor(payload, sig)
+    return {"vault_signature": sig}
+
+if __name__ == "__main__":
+    import sys, time
+    obj = {"event":"test-sign", "ts": time.time()}
+    print("Signing payload via Vault Transit...")
+    print(sign_and_record(obj))
+
