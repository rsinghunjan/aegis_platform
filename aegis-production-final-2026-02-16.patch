+#!/usr/bin/env python3
+"""
+Validate Vault unseal/auto-unseal status across pods and ensure HSM-related audit entries exist.
+
+Requires: kubectl in PATH and vault CLI (or use API).
+"""
+import subprocess, json, sys
+def k(cmd):
+    return subprocess.check_output(cmd, shell=True).decode()
+
+def list_pods(ns="vault"):
+    return json.loads(k(f"kubectl -n {ns} get pods -l app=vault -o json"))
+
+def check_vault_status(pod, ns="vault"):
+    try:
+        out = k(f"kubectl -n {ns} exec -it {pod} -- vault status -format=json")
+        return json.loads(out)
+    except Exception as e:
+        return {"error": str(e)}
+
+def main():
+    ns = "vault"
+    pods = list_pods(ns)
+    for item in pods.get("items", []):
+        name = item["metadata"]["name"]
+        status = check_vault_status(name, ns)
+        print(f"Pod: {name} -> {status.get('sealed')=}, ha_enabled={status.get('ha_enabled')}, leader={status.get('is_self')} ")
+    print("Manual check: Inspect Vault audit logs for PKCS11/HSM key usage.")
+
+if __name__ == "__main__":
+    main()
+
