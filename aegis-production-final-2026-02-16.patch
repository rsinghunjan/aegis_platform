+#!/usr/bin/env python3
+"""
+Edge pre-load verifier:
+ - verifies cosign signature
+ - checks Rekor entry exists
+ - verifies TPM2 quote via tpm2-tools (local command)
+ - pin cosign pubkey fingerprint to prevent key swap attacks
+"""
+import os, subprocess, requests, json, hashlib, sys, time
+
+REKOR_URL = os.environ.get("REKOR_URL", "https://rekor.internal")
+PINNED_PUBLIC_KEY_FINGERPRINT = os.environ.get("PINNED_COSIGN_PUBKEY_SHA256","")
+
+def sha256_of_file(path):
+    import hashlib
+    h = hashlib.sha256()
+    with open(path,"rb") as f:
+        h.update(f.read())
+    return h.hexdigest()
+
+def verify_cosign(artifact, pubkey="public.pem"):
+    # verify key fingerprint matches pinned
+    if PINNED_PUBLIC_KEY_FINGERPRINT:
+        fp = sha256_of_file(pubkey)
+        if fp != PINNED_PUBLIC_KEY_FINGERPRINT:
+            print("Pinned public key mismatch", fp)
+            return False
+    try:
+        subprocess.run(["cosign","verify","--key", pubkey, artifact], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        return True
+    except Exception as e:
+        print("cosign verify failed:", e)
+        return False
+
+def verify_rekor(index):
+    try:
+        r = requests.get(f"{REKOR_URL}/api/v1/log/entries?logIndex={index}", timeout=5)
+        return r.ok and bool(r.json())
+    except Exception as e:
+        print("rekor query failed", e)
+        return False
+
+def verify_tpm_quote(quote_file="/tmp/quote.bin", qualifying_data_file="/tmp/qd.bin"):
+    # Placeholder: expects tpm2-tools installed and PCRs/keys configured.
+    # Example flow:
+    #   tpm2_checkquote -c pubkey.pem -m quote.bin -s signature.bin -f rsassa -g sha256 -q qc.bin
+    try:
+        # this is an example; adapt to vendor tpm2-tools usage
+        subprocess.run(["tpm2_checkquote","-c","/etc/keys/ek.pub","-m",quote_file,"-s","/tmp/signature.bin"], check=True)
+        return True
+    except Exception as e:
+        print("tpm2_checkquote failed", e)
+        return False
+
+def main(artifact, manifest):
+    m = json.load(open(manifest))
+    att = m.get("attestation") or {}
+    rekor_idx = att.get("rekor_index") or att.get("rekorIndex")
+    if not verify_cosign(artifact):
+        print("cosign failed"); sys.exit(2)
+    if not verify_rekor(rekor_idx):
+        print("rekor proof missing"); sys.exit(3)
+    if not verify_tpm_quote():
+        print("tpm quote failed"); sys.exit(4)
+    print("verification OK")
+    sys.exit(0)
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        print("usage: preload_verifier_tpm.py <artifact> <manifest>")
+        sys.exit(1)
+    main(sys.argv[1], sys.argv[2])
