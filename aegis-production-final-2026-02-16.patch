+package mcpclient
+
+import (
+    "bytes"
+    "fmt"
+    "io/ioutil"
+    "net/http"
+    "os"
+)
+
+var MCP_URL = getEnv("MCP_URL", "http://mcp.mcp.svc.cluster.local:8000")
+var TOKEN = os.Getenv("MCP_TOKEN")
+
+func getHeaders(req *http.Request) {
+    req.Header.Set("Content-Type", "application/json")
+    if TOKEN != "" {
+        req.Header.Set("Authorization", "Bearer "+TOKEN)
+    }
+}
+
+func UpsertModelContext(payload []byte) ([]byte, error) {
+    url := fmt.Sprintf("%s/model-context", MCP_URL)
+    req, _ := http.NewRequest("POST", url, bytes.NewBuffer(payload))
+    getHeaders(req)
+    client := &http.Client{}
+    resp, err := client.Do(req)
+    if err != nil { return nil, err }
+    defer resp.Body.Close()
+    body, _ := ioutil.ReadAll(resp.Body)
+    if resp.StatusCode >= 400 { return nil, fmt.Errorf("error: %s", string(body)) }
+    return body, nil
+}
+
+func GetModelContext(modelID, version string) ([]byte, error) {
+    url := fmt.Sprintf("%s/model-context/%s/%s", MCP_URL, modelID, version)
+    req, _ := http.NewRequest("GET", url, nil)
+    getHeaders(req)
+    client := &http.Client{}
+    resp, err := client.Do(req)
+    if err != nil { return nil, err }
+    defer resp.Body.Close()
+    body, _ := ioutil.ReadAll(resp.Body)
+    if resp.StatusCode >= 400 { return nil, fmt.Errorf("error: %s", string(body)) }
+    return body, nil
+}
+
+func getEnv(k, d string) string {
+    if v := os.Getenv(k); v != "" { return v }
+    return d
+}
