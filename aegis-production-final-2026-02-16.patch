+from sqlalchemy.orm import Session
+from . import models
+from datetime import datetime
+
+def upsert_model_context(db: Session, mc: dict):
+    # simple upsert by model_id+version
+    obj = db.query(models.ModelContext).filter(models.ModelContext.model_id==mc["model_id"], models.ModelContext.version==mc["version"]).one_or_none()
+    if obj is None:
+        obj = models.ModelContext(
+            model_id=mc["model_id"],
+            version=mc["version"],
+            artifact=mc.get("artifact"),
+            build=mc.get("build"),
+            mlflow_run_id=mc.get("mlflow_run_id"),
+            datasets=mc.get("datasets"),
+            hyperparameters=mc.get("hyperparameters"),
+            eval_metrics=mc.get("eval_metrics"),
+            owner=mc.get("owner"),
+            team=mc.get("team"),
+            tags=mc.get("tags"),
+            compliance=mc.get("compliance"),
+        )
+        db.add(obj)
+        db.flush()
+    else:
+        obj.artifact = mc.get("artifact")
+        obj.build = mc.get("build")
+        obj.mlflow_run_id = mc.get("mlflow_run_id")
+        obj.datasets = mc.get("datasets")
+        obj.hyperparameters = mc.get("hyperparameters")
+        obj.eval_metrics = mc.get("eval_metrics")
+        obj.owner = mc.get("owner")
+        obj.team = mc.get("team")
+        obj.tags = mc.get("tags")
+        obj.compliance = mc.get("compliance")
+        obj.updated_at = datetime.utcnow()
+
+    # replace nested lists (simple approach)
+    obj.attestations = []
+    for a in mc.get("attestations", []):
+        newa = models.Attestation(type=a.get("type"), rekor_index=str(a.get("rekor_index")), attestation_uri=a.get("attestation_uri"), signed_at=a.get("signed_at"))
+        obj.attestations.append(newa)
+    obj.hil_approvals = []
+    for h in mc.get("hil_approvals", []):
+        newh = models.HILApproval(approver_id=h.get("approver_id"), role=h.get("role"), receipt_rekor_index=str(h.get("receipt_rekor_index")), signed_at=h.get("signed_at"))
+        obj.hil_approvals.append(newh)
+    obj.deployments = []
+    for d in mc.get("deployments", []):
+        newd = models.Deployment(env=d.get("env"), cluster=d.get("cluster"), namespace=d.get("namespace"), deployment_id=d.get("deployment_id"), status=d.get("status"), deployed_at=d.get("deployed_at"))
+        obj.deployments.append(newd)
+    obj.federated_rounds = []
+    for r in mc.get("federated_rounds", []):
+        nr = models.FederatedRound(round_id=r.get("round_id"), rekor_index=str(r.get("rekor_index")), ts=r.get("ts"))
+        obj.federated_rounds.append(nr)
+
+    db.commit()
+    db.refresh(obj)
+    return obj
+
+def get_model_context(db: Session, model_id: str, version: str):
+    return db.query(models.ModelContext).filter(models.ModelContext.model_id==model_id, models.ModelContext.version==version).one_or_none()
+
+def list_models(db: Session, limit: int = 100):
+    return db.query(models.ModelContext).order_by(models.ModelContext.updated_at.desc()).limit(limit).all()
+
+def create_subscription(db: Session, name: str, url: str):
+    sub = db.query(models.Subscriber).filter(models.Subscriber.name==name).one_or_none()
+    if sub:
+        sub.url = url
+        sub.active = True
+    else:
+        sub = models.Subscriber(name=name, url=url, active=True)
+        db.add(sub)
+    db.commit()
+    db.refresh(sub)
+    return sub
+
+def list_subscriptions(db: Session):
+    return db.query(models.Subscriber).filter(models.Subscriber.active==True).all()
+
+def write_audit(db: Session, subject: str, action: str, resource: str, metadata: dict = None):
+    al = models.AuditLog(subject=subject, action=action, resource=resource, metadata=metadata or {})
+    db.add(al); db.commit(); db.refresh(al)
+    return al
