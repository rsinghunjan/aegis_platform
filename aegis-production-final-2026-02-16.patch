+"""
+Export audit logs from the MCP DB to a SIEM endpoint periodically (simple script).
+Configure:
+ - MCP_DATABASE_URL
+ - SIEM_ENDPOINT (HTTP)
+ - SIEM_API_KEY
+"""
+import os, requests, json
+from mcp.server.database import engine
+from sqlalchemy import text
+import time
+
+DB = os.environ.get("MCP_DATABASE_URL","postgresql://mcp:mcp@postgres.mcp.svc.cluster.local:5432/mcp")
+SIEM = os.environ.get("SIEM_ENDPOINT","https://siem.example.com/events")
+API_KEY = os.environ.get("SIEM_API_KEY","")
+
+def fetch_new_audit(last_ts):
+    with engine.connect() as conn:
+        q = text("SELECT id, subject, action, resource, timestamp, metadata FROM audit_log WHERE timestamp > :t ORDER BY timestamp ASC")
+        res = conn.execute(q, {"t": last_ts}).fetchall()
+        return [dict(r) for r in res]
+
+def post_to_siem(events):
+    headers = {"Content-Type":"application/json"}
+    if API_KEY:
+        headers["Authorization"] = f"Bearer {API_KEY}"
+    r = requests.post(SIEM, json={"events": events}, headers=headers, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+if __name__ == "__main__":
+    last = "1970-01-01T00:00:00Z"
+    while True:
+        events = fetch_new_audit(last)
+        if events:
+            post_to_siem(events)
+            last = events[-1]["timestamp"].isoformat()
+        time.sleep(60)
