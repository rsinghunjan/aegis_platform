+            producer.flush(timeout=5.0)
+            return
+        except Exception:
+            # fallthrough to webhook fanout
+            pass
+    subs = crud.list_subscriptions(db)
+    async with httpx.AsyncClient(timeout=10.0) as client:
+        for s in subs:
+            try:
+                await client.post(s.url, json=payload, timeout=5.0)
+            except Exception:
+                pass
