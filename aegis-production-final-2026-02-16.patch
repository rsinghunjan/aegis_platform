+"""
+OIDC / JWT validation and RBAC helpers for MCP.
+Configure via env:
+ - OIDC_ISSUER
+ - OIDC_AUDIENCE
+ - MCP_JWKS_URL (optional; will be fetched from issuer/.well-known/jwks.json)
+ - MCP_RBAC_POLICY (optional JSON path or external RBAC service)
+"""
+from jose import jwt, JWTError
+import requests, os, time
+from functools import wraps
+from fastapi import HTTPException, Request
+
+OIDC_ISSUER = os.environ.get("OIDC_ISSUER", "https://issuer.example.com")
+OIDC_AUDIENCE = os.environ.get("OIDC_AUDIENCE", "mcp")
+JWKS_URL = os.environ.get("MCP_JWKS_URL", f"{OIDC_ISSUER.rstrip('/')}/.well-known/jwks.json")
+
+_JWKS_CACHE = {"jwks": None, "fetched_at": 0}
+
+def fetch_jwks(force=False):
+    if _JWKS_CACHE["jwks"] and not force and time.time() - _JWKS_CACHE["fetched_at"] < 3600:
+        return _JWKS_CACHE["jwks"]
+    r = requests.get(JWKS_URL, timeout=5)
+    r.raise_for_status()
+    _JWKS_CACHE["jwks"] = r.json()
+    _JWKS_CACHE["fetched_at"] = time.time()
+    return _JWKS_CACHE["jwks"]
+
+def validate_jwt(token: str):
+    jwks = fetch_jwks()
+    try:
+        # NOTE: python-jose accepts jwk keys as dict
+        payload = jwt.decode(token, jwks, algorithms=["RS256"], audience=OIDC_AUDIENCE, issuer=OIDC_ISSUER)
+        return payload
+    except JWTError as e:
+        raise HTTPException(status_code=401, detail=f"Invalid token: {e}")
+
+def get_bearer_token_from_request(request: Request):
+    auth = request.headers.get("Authorization")
+    if not auth:
+        return None
+    parts = auth.split()
+    if len(parts) != 2 or parts[0].lower() != "bearer":
+        return None
+    return parts[1]
+
+def require_role(required_roles):
+    if isinstance(required_roles, str):
+        required_roles = [required_roles]
+    def decorator(func):
+        @wraps(func)
+        async def wrapper(*args, **kwargs):
+            # FastAPI passes Request in kwargs when annotated; try to extract
+            request = kwargs.get("request") or (args[0] if args else None)
+            if not request:
+                raise HTTPException(status_code=400, detail="request not found for auth")
+            token = get_bearer_token_from_request(request)
+            if not token:
+                raise HTTPException(status_code=401, detail="missing bearer token")
+            payload = validate_jwt(token)
+            roles = payload.get("roles") or payload.get("groups") or []
+            # allow if any required role in roles
+            if any(r in roles for r in required_roles):
+                # attach subject to request.state for audit downstream
+                request.state.subject = payload.get("sub") or payload.get("email") or "unknown"
+                return await func(*args, **kwargs)
+            raise HTTPException(status_code=403, detail="insufficient role")
+        return wrapper
+    return decorator
+
