*** Add File:rekor/scripts/cert_rotate.sh
+#!/usr/bin/env bash
+set -euo pipefail
+NAMESPACE=${1:-rekor}
+CRT_PATH=${2:-./rekor.crt}
+KEY_PATH=${3:-./rekor.key}
+
+if [ ! -f "$CRT_PATH" ] || [ ! -f "$KEY_PATH" ]; then
+  echo "Provide paths to new cert and key"
+  exit 2
+fi
+
+kubectl -n ${NAMESPACE} create secret tls rekor-tls --cert=${CRT_PATH} --key=${KEY_PATH} --dry-run=client -o yaml | kubectl apply -f -
+kubectl -n ${NAMESPACE} rollout restart deployment/rekor-server
+echo "Waiting for deployment to become ready..."
+kubectl -n ${NAMESPACE} rollout status deployment/rekor-server --timeout=120s
+echo "Rotation complete. Validate endpoint TLS and Rekor log operations."
+
