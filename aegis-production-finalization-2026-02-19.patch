+/*
+Full AWS CloudHSM + IAM skeleton for Vault PKCS#11 commissioning and dual-control signing operations.
+Fill variables in a tfvars file and review IAM policies with Security prior to apply.
+*/
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = "~> 4.0" }
+  }
+}
+provider "aws" { region = var.aws_region }
+
+variable "aws_region" { type = string, default = "us-west-2" }
+variable "vpc_id" { type = string }
+variable "hsm_subnet_ids" { type = list(string) }
+variable "vault_server_ips" { type = list(string) }
+
+resource "aws_cloudhsm_v2_cluster" "aegis_hsm" {
+  hsm_type  = "hsm1.medium"
+  subnet_ids = var.hsm_subnet_ids
+  tags = { Name = "aegis-cloudhsm" }
+}
+
+resource "aws_cloudhsm_v2_hsm" "hsm" {
+  count = length(var.hsm_subnet_ids)
+  cluster_id = aws_cloudhsm_v2_cluster.aegis_hsm.id
+  subnet_id  = element(var.hsm_subnet_ids, count.index)
+}
+
+resource "aws_security_group" "cloudhsm_sg" {
+  name = "aegis-cloudhsm-sg"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port = 2225
+    to_port   = 2225
+    protocol  = "tcp"
+    cidr_blocks = var.vault_server_ips
+  }
+  egress { from_port = 0 to_port = 0 protocol = "-1" cidr_blocks = ["0.0.0.0/0"] }
+}
+
+/* Dual-control IAM role for HSM operators. Two distinct principals should be assigned:
+   - cloudhsm_admin_a
+   - cloudhsm_admin_b
+   Both must collaborate to perform key import / activation operations documented in runbooks.
+*/
+resource "aws_iam_role" "cloudhsm_admin_role" {
+  name = "aegis-cloudhsm-admin"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{
+      Action = "sts:AssumeRole"
+      Effect = "Allow"
+      Principal = { AWS = var.hsm_admin_arns }
+    }]
+  })
+}
+
+output "cloudhsm_cluster_id" { value = aws_cloudhsm_v2_cluster.aegis_hsm.id }
+output "cloudhsm_hsm_ids" { value = [for h in aws_cloudhsm_v2_hsm.hsm : h.id] }
+
