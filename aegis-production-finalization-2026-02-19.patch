+#!/usr/bin/env python3
+"""
+Create remediation issues from pentest findings JSON and assign to triage board.
+"""
+import os, sys, json, requests
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN")
+REPO = os.environ.get("REPO","yourorg/aegis")
+API = "https://api.github.com"
+
+def create_issue(title, body, labels):
+    url = f"{API}/repos/{REPO}/issues"
+    r = requests.post(url, json={"title":title,"body":body,"labels":labels}, headers={"Authorization":f"token {GITHUB_TOKEN}"})
+    r.raise_for_status()
+    return r.json()
+
+if __name__ == "__main__":
+    findings = json.load(open(sys.argv[1]))
+    for f in findings.get("findings",[]):
+        title = f"[PENTEST] {f.get('title')}"
+        body = f.get("description","")
+        labels = ["security","pentest", f.get("severity","medium")]
+        create_issue(title, body, labels)
+        print("Created issue:", title)
+
