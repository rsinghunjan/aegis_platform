+#!/usr/bin/env python3
+"""
+HIL waveform capture and comparison tool.
+ - Captures joint commands / efforts from UDP or socket during tests and saves as ndjson.
+ - Compares captured traces with golden traces (if provided) and computes simple error metrics.
+ - Records evidence manifest with summary.
+"""
+import json, time, argparse, math
+from pathlib import Path
+from ops.sdk.evidence_sdk import record_manifest
+
+def load_ndjson(path):
+    out = []
+    with open(path) as fh:
+        for l in fh:
+            out.append(json.loads(l))
+    return out
+
+def compare_traces(gold, measured):
+    # simple sample-to-sample MSE on matching length
+    n = min(len(gold), len(measured))
+    if n == 0:
+        return {"error":"no_samples"}
+    total = 0.0
+    for i in range(n):
+        g = gold[i].get("values", [])
+        m = measured[i].get("values", [])
+        for j in range(min(len(g), len(m))):
+            d = g[j] - m[j]
+            total += d*d
+    mse = total / n
+    return {"mse": mse, "samples": n}
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--measured", required=True)
+    p.add_argument("--gold", required=False)
+    p.add_argument("--campaign", required=True)
+    args = p.parse_args()
+    measured = load_ndjson(args.measured)
+    gold = load_ndjson(args.gold) if args.gold else []
+    res = compare_traces(gold, measured)
+    print("Compare result:", res)
+    record_manifest("hil_waveform_compare", {"campaign": args.campaign, "result": res})
+
