+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate KMS pointer stored in Vault and perform smoke sign + Rekor collection for audit.
+#
+# Usage:
+#   VAULT_ADDR=https://vault:8200 VAULT_TOKEN=... COSIGN_TEST_FILE=/tmp/test.file ./ops/security/kms/rotate_kms_with_vault.sh awskms://<new-key-id>
+#
+NEW_KMS_URI=${1:-}
+if [ -z "$NEW_KMS_URI" ]; then
+  echo "Usage: $0 <NEW_COSIGN_KMS_URI>"
+  exit 2
+fi
+if [ -z "${VAULT_ADDR:-}" ] || [ -z "${VAULT_TOKEN:-}" ]; then
+  echo "Set VAULT_ADDR and VAULT_TOKEN to update Vault"
+  exit 2
+fi
+
+set -x
+TMPDIR=$(mktemp -d /tmp/aegis_kms_rotate.XXXX)
+trap "rm -rf $TMPDIR" EXIT
+
+echo "Writing new KMS URI to Vault"
+vault kv put secret/aegis/cosign_kms uri="$NEW_KMS_URI" >/dev/null
+
+TESTFILE=${COSIGN_TEST_FILE:-$TMPDIR/cosign-smoke.txt}
+echo "Aegis cosign rotation smoke test at $(date -u)" > "$TESTFILE"
+
+echo "Signing test file with cosign (KMS=$NEW_KMS_URI)"
+cosign sign --key "$NEW_KMS_URI" "$TESTFILE"
+
+echo "Verifying signature"
+cosign verify --key "$NEW_KMS_URI" "$TESTFILE" > "$TMPDIR/cosign_verify.txt" 2>&1 || true
+cp "$TESTFILE" "$TMPDIR/"
+cp "$TESTFILE.sig" "$TMPDIR/" || true
+
+if [ -n "${REKOR_SERVER:-}" ]; then
+  echo "Querying Rekor for recent entries (best-effort)"
+  rekor-cli search --rekor_server "${REKOR_SERVER}" --artifact "$TESTFILE" > "$TMPDIR/rekor_search.json" || true
+fi
+
+echo "Recording evidence manifest"
+python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("kms_rotate_and_smoke", {"new_kms":"$NEW_KMS_URI", "bundle":"$TMPDIR"})
+PY
+
+echo "KMS rotation complete, artifacts in $TMPDIR (operator should archive for auditors)"
+
