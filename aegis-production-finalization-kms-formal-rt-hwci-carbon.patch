+#!/usr/bin/env python3
+"""
+Helper to sign an artifact (image or file) with cosign (KMS) and register/verify Rekor entry.
+Records evidence manifest.
+"""
+import os, subprocess, sys
+from ops.sdk.evidence_sdk import record_manifest
+
+ARTIFACT = os.environ.get("ARTIFACT")
+COSIGN_KMS = os.environ.get("COSIGN_KMS_URI")
+REKOR = os.environ.get("REKOR_SERVER","")
+
+if not ARTIFACT or not COSIGN_KMS:
+    print("ARTIFACT and COSIGN_KMS_URI required", file=sys.stderr)
+    sys.exit(2)
+
+print("Signing", ARTIFACT)
+subprocess.check_call(["cosign","sign","--key",COSIGN_KMS,ARTIFACT])
+print("Verify")
+subprocess.check_call(["cosign","verify","--key",COSIGN_KMS,ARTIFACT])
+
+rekor_out = None
+if REKOR:
+    try:
+        rekor_out = subprocess.check_output(["rekor-cli","search","--rekor_server",REKOR,"--artifact",ARTIFACT]).decode("utf-8")
+    except Exception:
+        rekor_out = None
+
+record_manifest("artifact_signed_and_rekored", {"artifact":ARTIFACT, "rekor": rekor_out})
+print("Done")
