+#!/usr/bin/env python3
+"""
+Power meter adapter:
+ - Attempts to read instantaneous power from common interfaces:
+   - NVIDIA GPUs via nvidia-smi (power.draw)
+   - IPMI if ipmitool present (example, needs BMC access)
+   - RAPL via linux perf/sysfs (placeholder)
+ - Returns average power in Watts for provided sampling window if available, else None.
+"""
+import shutil, subprocess, time, json, os
+
+def nvidia_power_sample():
+    if not shutil.which("nvidia-smi"):
+        return None
+    try:
+        out = subprocess.check_output(["nvidia-smi", "--query-gpu=power.draw", "--format=csv,noheader,nounits"])
+        vals = [float(x) for x in out.decode().strip().splitlines() if x.strip()]
+        if not vals:
+            return None
+        return sum(vals)  # total GPU power in W across GPUs
+    except Exception:
+        return None
+
+def ipmi_power_sample():
+    if not shutil.which("ipmitool"):
+        return None
+    bmc = os.environ.get("BMC_HOST")
+    if not bmc:
+        return None
+    # Placeholder: requires IPMI credentials and sensor mapping
+    try:
+        out = subprocess.check_output(["ipmitool", "-H", bmc, "sdr", "elist"])
+        # parse power sensor (operator-specific)
+        return None
+    except Exception:
+        return None
+
+def sample_avg_power(duration_s=60, interval_s=1):
+    samples = []
+    end = time.time() + duration_s
+    while time.time() < end:
+        p = nvidia_power_sample() or ipmi_power_sample()
+        if p is not None:
+            samples.append(p)
+        time.sleep(interval_s)
+    if not samples:
+        return None
+    return sum(samples) / len(samples)
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--duration", type=int, default=60)
+    args = p.parse_args()
+    avg = sample_avg_power(args.duration, 1)
+    print(json.dumps({"avg_power_w": avg}))
+
