+echo "Validating ONNXRuntime"
+python3 - <<PY
+import onnxruntime as ort, numpy as np, os, json
+out = {}
+for provider in ["CUDAExecutionProvider","CPUExecutionProvider"]:
+    try:
+        sess = ort.InferenceSession("$ONNX_MODEL", providers=[provider])
+        inp = np.random.randn(1,3,224,224).astype('float32')
+        ids = np.random.randint(0,1000,(1,32)).astype('int64')
+        r = sess.run(None, {"image": inp, "input_ids": ids})
+        out[provider] = {"ok": True, "shapes": [o.shape for o in r]}
+    except Exception as e:
+        out[provider] = {"ok": False, "error": str(e)}
+with open("$OUTDIR/onnxruntime_results.json","w") as fh:
+    json.dump(out, fh, indent=2)
+print("ONNXRuntime results written to $OUTDIR/onnxruntime_results.json")
