+fi
+
+echo "[step 4] Ensure RT controller running (systemd unit name: aegis-rt-controller.service)"
+if [ "$NODE" = "localhost" ]; then
+  sudo systemctl restart aegis-rt-controller.service || true
+else
+  ssh "${NODE}" "sudo systemctl restart aegis-rt-controller.service || true"
+fi
+
+echo "[step 5] Run p99 validator"
