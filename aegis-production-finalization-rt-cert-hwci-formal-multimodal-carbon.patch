+#!/usr/bin/env python3
+"""
+Run Apalache (if available) on TLA+ specs, parse output and open a GitHub issue if counterexamples are found.
+Records evidence manifest and saves apalache output for audit.
+"""
+import os, subprocess, sys, json, glob
+
+SPECS = ["ops/formal/expanded_controller_spec.tla","ops/formal/proofs/controller_spec_with_human.tla"]
+OUTDIR = os.environ.get("FORMAL_OUTDIR","/tmp/aegis_formal_$(date +%s)")
+
+def run_apalache(spec, outdir):
+    try:
+        os.makedirs(outdir, exist_ok=True)
+        out = subprocess.check_output(["apalache-mc","check", spec], stderr=subprocess.STDOUT, timeout=600)
+        with open(os.path.join(outdir, os.path.basename(spec)+".apalache.out"), "wb") as fh:
+            fh.write(out)
+        return True, out.decode("utf-8")
+    except Exception as e:
+        # save exception output if any
+        with open(os.path.join(outdir, os.path.basename(spec)+".apalache.err"), "w") as fh:
+            fh.write(str(e))
+        return False, str(e)
+
+def record_evidence(bundle):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("formal_apalache_ci", {"bundle":bundle})
+    except Exception:
+        pass
+
+def main():
+    outdir = "/tmp/aegis_formal_ci_"+str(os.getpid())
+    ok_any = True
+    for s in SPECS:
+        ok, out = run_apalache(s, outdir)
+        if not ok:
+            ok_any = False
+    bundle = outdir + ".tar.gz"
+    subprocess.call(["tar","-czf",bundle,"-C",outdir,"."])
+    record_evidence(bundle)
+    if not ok_any:
+        print("Apalache reported issues; operator should review artifacts at", bundle)
+        # Optionally open a GH issue (requires gh CLI auth)
+        try:
+            import subprocess
+            subprocess.call(["gh","issue","create","--title","Formal verification counterexamples","--body",f"Apalache run produced errors. Artifacts: {bundle}"])
+        except Exception:
+            pass
+        sys.exit(4)
+    print("Apalache runs OK; artifacts at", bundle)
+
+if __name__=="__main__":
+    main()
+
