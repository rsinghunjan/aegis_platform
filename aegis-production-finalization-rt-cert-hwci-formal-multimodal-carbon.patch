+#!/usr/bin/env bash
+set -euo pipefail
+#
+# End-to-end RT lab validation orchestrator:
+# - Installs/validates PREEMPT_RT (Ansible playbook expected)
+# - Applies IRQ/NIC tuning
+# - Starts RT controller and jitter exporter
+# - Runs p99 validator and safe-stop tester
+# - Collects artifacts, signs bundle (cosign KMS) and records evidence
+#
+# Usage:
+#   ./ops/robotics/rt/lab_validation/orchestrate_rt_full.sh --node <host> --out /tmp/aegis_rt_run --upload-s3 s3://bucket/path/ (optional)
+#
+NODE=${1:-localhost}
+OUTDIR=${2:-/tmp/aegis_rt_run_$(date +%s)}
+UPLOAD_S3=""
+shift || true
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --node) NODE=$2; shift 2;;
+    --out) OUTDIR=$2; shift 2;;
+    --upload-s3) UPLOAD_S3=$2; shift 2;;
+    *) shift;;
+  esac
+done
+
+mkdir -p "$OUTDIR"
+echo "RT lab: node=$NODE out=$OUTDIR"
+
+echo "[step 1] Run Ansible PREEMPT_RT playbook (operator review required)"
+ansible-playbook -i "${NODE}," ops/robotics/rt/ansible/install_preempt_rt.yml || true
+
+echo "[step 2] Apply IRQ/NIC tuning (eth0 used as default)"
+if [ "$NODE" = "localhost" ]; then
+  sudo bash ops/robotics/rt/irq_nic_tuning.sh eth0 4 || true
+else
+  scp ops/robotics/rt/irq_nic_tuning.sh "${NODE}":/tmp/
+  ssh "${NODE}" "sudo /tmp/irq_nic_tuning.sh eth0 4" || true
+fi
+
+echo "[step 3] Start jitter exporter/systemd on node"
+if [ "$NODE" = "localhost" ]; then
+  nohup python3 ops/robotics/rt/jitter_prometheus_exporter.py --port 9102 >/tmp/jitter_exporter.log 2>&1 &
+else
+  scp ops/robotics/rt/jitter_prometheus_exporter.py "${NODE}":/tmp/
