+#!/usr/bin/env python3
+"""
+CI helper that verifies all container images referenced in a Kubernetes manifest are cosign-signed
+and have Rekor entries. Exits non-zero if any image lacks required signatures/rekor (used in CI gates).
+
+Usage:
+  IMAGE_MANIFESTS="deploy.yaml,helm-values.yaml" python verify_and_block_if_unsigned.py
+"""
+import os, sys, subprocess, yaml
+
+def extract_images_from_yaml(path):
+    images = set()
+    with open(path) as fh:
+        docs = list(yaml.safe_load_all(fh))
+        for d in docs:
+            if not d:
+                continue
+            # naive traversal to find container images
+            def walk(obj):
+                if isinstance(obj, dict):
+                    for k,v in obj.items():
+                        if k == "image" and isinstance(v, str):
+                            images.add(v)
+                        else:
+                            walk(v)
+                elif isinstance(obj, list):
+                    for e in obj:
+                        walk(e)
+            walk(d)
+    return images
+
+def cosign_verify(image):
+    try:
+        subprocess.check_call(["cosign","verify",image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def rekor_has_entry(image, rekor_server):
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--rekor_server", rekor_server, "--artifact", image])
+        return bool(out.strip())
+    except Exception:
+        return False
+
+def main():
+    manifests = os.environ.get("IMAGE_MANIFESTS","").split(",")
+    if manifests == [""] or not manifests:
+        print("Set IMAGE_MANIFESTS env var to comma-separated YAML files", file=sys.stderr)
+        sys.exit(2)
+    rekor = os.environ.get("REKOR_SERVER","")
+    bad = []
+    for m in manifests:
+        imgs = extract_images_from_yaml(m)
+        for img in imgs:
+            ok = cosign_verify(img)
+            if not ok:
+                bad.append((img,"cosign_missing"))
+                continue
+            if rekor:
+                if not rekor_has_entry(img, rekor):
+                    bad.append((img,"rekor_missing"))
+    if bad:
+        print("Unsigned or unregistered images detected:")
+        for b in bad:
+            print(b[0], b[1])
+        sys.exit(3)
+    print("All images verified with cosign and Rekor (if configured).")
+
+if __name__=="__main__":
+    main()
+
