+#!/usr/bin/env python3
+"""
+Parse Apalache outputs and automatically create a GitHub issue with attachments for counterexamples.
+Requires `gh` CLI configured with permissions. Records evidence manifest for the run.
+"""
+import glob, json, os, subprocess, sys, tempfile
+from datetime import datetime
+
+OUTDIR = "/tmp/apalache_report_" + datetime.utcnow().strftime("%Y%m%d%H%M%S")
+os.makedirs(OUTDIR, exist_ok=True)
+
+def find_outputs():
+    return glob.glob("**/*.apalache.out", recursive=True) + glob.glob("**/*.apalache.err", recursive=True)
+
+def summarize(path):
+    try:
+        txt = open(path).read()
+    except Exception:
+        return None
+    ok = "counterexample" in txt.lower() or "error" in txt.lower()
+    snippet = txt[:4000]
+    return {"path": path, "has_issue": ok, "snippet": snippet}
+
+def main():
+    files = find_outputs()
+    issues = []
+    for f in files:
+        s = summarize(f)
+        if s and s["has_issue"]:
+            issues.append(s)
+    bundle = os.path.join(OUTDIR, "aplalche_artifacts.tar.gz")
+    subprocess.call(["tar","-czf",bundle,"-C","."] + files)
+    # record manifest
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("apalache_automated_run", {"bundle": bundle, "issues": len(issues)})
+    except Exception:
+        pass
+    if issues:
+        title = "Apalache: Formal verification counterexamples detected"
+        body = "Apalache produced counterexamples or errors. Summary:\n\n"
+        for i in issues:
+            body += f"- {i['path']}: snippet (first 200 chars):\n```\n{i['snippet'][:200]}\n```\n\n"
+        body += f"\nArtifacts bundle: {bundle}\n\nPlease investigate and attach updated models/specs."
+        try:
+            subprocess.check_call(["gh","issue","create","--title",title,"--body",body])
+            print("Created GH issue for Apalache counterexamples")
+        except Exception:
+            print("Failed to create GH issue; please run `gh issue create` manually.")
+        sys.exit(4)
+    else:
+        print("No Apalache issues found; bundle recorded:", bundle)
+
+if __name__=="__main__":
+    main()
+
