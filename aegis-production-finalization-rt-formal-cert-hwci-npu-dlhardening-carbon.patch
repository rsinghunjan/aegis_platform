+#!/usr/bin/env python3
+"""
+Enhanced carbon promotion gate:
+ - Checks current grid carbon intensity via WattTime
+ - Allows a signed approval override artifact path (cosign signed approval JSON) to permit promotion despite high carbon
+ - Exit codes:
+    0 -> allow
+    2 -> missing data (block)
+    3 -> carbon threshold exceeded (block)
+    4 -> override invalid (block)
+"""
+import os, sys, json, base64, subprocess
+from ops.carbon.watttime_client import get_latest_intensity
+
+REGION = os.environ.get("Aegis_CARBON_REGION","US-CA")
+THRESHOLD = float(os.environ.get("Aegis_CARBON_PROMOTE_THRESHOLD_GCO2","300"))
+APPROVAL_PATH = os.environ.get("CARBON_APPROVAL_ARTIFACT","")  # path to approval JSON (cosign-signed)
+
+def verify_approval(path):
+    # Verify cosign signature exists for artifact (best-effort). Requires cosign in PATH.
+    if not path or not os.path.exists(path):
+        return False
+    try:
+        subprocess.check_call(["cosign","verify-blob","--key","$COSIGN_PUBKEY","--signature", path + ".sig", path], shell=False)
+        return True
+    except Exception:
+        # attempt cosign verify default (artifact was signed with KMS and signature embedded)
+        try:
+            subprocess.check_call(["cosign","verify", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            return True
+        except Exception:
+            return False
+
+def main():
+    val = get_latest_intensity(REGION)
+    if val is None:
+        print("No carbon intensity data; blocking promotion by default")
+        sys.exit(2)
+    print("Carbon intensity:", val, "threshold:", THRESHOLD)
+    if val <= THRESHOLD:
+        print("Carbon within threshold; allow promotion")
+        sys.exit(0)
+    # carbon above threshold; check approval artifact
+    if APPROVAL_PATH:
+        ok = verify_approval(APPROVAL_PATH)
+        if ok:
+            print("Valid approval artifact present; allow promotion despite carbon")
+            sys.exit(0)
+        else:
+            print("Approval artifact invalid or verification failed")
+            sys.exit(4)
+    print("Carbon threshold exceeded; block promotion")
+    sys.exit(3)
+
+if __name__=="__main__":
+    main()
+
