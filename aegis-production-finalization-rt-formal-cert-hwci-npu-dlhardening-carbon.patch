+#!/usr/bin/env python3
+"""
+Contact injection harness for HIL tests.
+ - Sends simulated contact events to the controller via UDP or HTTP test endpoint.
+ - Captures waveform traces and produces a comparison report using waveform_compare utility.
+ - Records evidence manifest.
+"""
+import argparse, json, socket, time, os
+from ops.sdk.evidence_sdk import record_manifest
+
+def send_contact_event(host, port, payload):
+    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    s.sendto(json.dumps(payload).encode('utf-8'), (host, port))
+    s.close()
+
+def run_campaign(host, port, measured_out, gold=None, iterations=5, interval_s=0.5):
+    for i in range(iterations):
+        ev = {"type":"contact_inject","level": i+1, "time": time.time()}
+        send_contact_event(host, port, ev)
+        time.sleep(interval_s)
+    # assume measured traces already collected by waveform capture at /tmp/measured.ndjson
+    measured = measured_out
+    # run comparator
+    if gold and os.path.exists(gold):
+        cmd = ["python3","ops/robotics/control/validation/hil_waveform_capture.py","--measured",measured,"--gold",gold,"--campaign","contact_injection"]
+        os.system(" ".join(cmd))
+    record_manifest("contact_injection_campaign", {"host":host,"port":port,"measured":measured,"gold":gold})
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--host", default="127.0.0.1")
+    p.add_argument("--port", type=int, default=15000)
+    p.add_argument("--measured", default="/tmp/measured.ndjson")
+    p.add_argument("--gold", default=None)
+    p.add_argument("--iters", type=int, default=5)
+    args = p.parse_args()
+    run_campaign(args.host, args.port, args.measured, args.gold, iterations=args.iters)
+
