+"""
+Compile a tiny ONNX model for AWS Inferentia using neuron-cc (best-effort) and run a smoke inference.
+Operator must have Neuron SDK & neuron-cc installed on the runner.
+"""
+import os, subprocess, sys, json, tempfile
+
+MODEL = sys.argv[1] if len(sys.argv)>1 else "model.onnx"
+
+def compile_model(onnx, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    out_model = os.path.join(outdir, "model_neuron")
+    try:
+        subprocess.check_call(["neuron-cc","compile","-s", "1", "-o", out_model, onnx])
+        return out_model
+    except Exception as e:
+        print("Compilation failed:", e)
+        return None
+
+def run_neuron_model(model_path):
+    # placeholder: run neuron runtime invocation
+    try:
+        r = subprocess.check_output(["neuron-run", model_path], stderr=subprocess.STDOUT, timeout=30)
+        print("Neuron run output:", r.decode()[:400])
+    except Exception as e:
+        print("Neuron run failed:", e)
+
+if __name__=="__main__":
+    if not os.path.exists(MODEL):
+        print("ONNX model not found:", MODEL); sys.exit(2)
+    with tempfile.TemporaryDirectory() as tmp:
+        compiled = compile_model(MODEL, tmp)
+        if compiled:
+            run_neuron_model(compiled)
+        else:
+            sys.exit(3)
