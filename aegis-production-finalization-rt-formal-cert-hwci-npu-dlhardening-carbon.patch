+#!/usr/bin/env python3
+"""
+Helper to find latest checkpoint in S3 and download it for resume.
+Used by training entrypoints to resume from last saved state.
+"""
+import boto3, os, sys, re
+
+S3_PREFIX = os.environ.get("S3_CHECKPOINT_PREFIX","s3://aegis-checkpoints")
+
+def list_checkpoints(prefix):
+    assert prefix.startswith("s3://")
+    s = prefix[5:]
+    bucket, *rest = s.split("/",1)
+    key_prefix = rest[0] if rest else ""
+    s3 = boto3.client("s3")
+    resp = s3.list_objects_v2(Bucket=bucket, Prefix=key_prefix)
+    items = resp.get("Contents",[])
+    ckpts = [i['Key'] for i in items if i['Key'].endswith(".pt")]
+    ckpts_sorted = sorted(ckpts, key=lambda k: k)  # simple lexicographic sort; operator may want timestamp keys
+    return bucket, ckpts_sorted
+
+def download(bucket, key, local):
+    s3 = boto3.client("s3")
+    s3.download_file(bucket, key, local)
+    return local
+
+if __name__=="__main__":
+    out = sys.argv[1] if len(sys.argv)>1 else "/tmp/resume_checkpoint.pt"
+    bucket, ckpts = list_checkpoints(S3_PREFIX)
+    if not ckpts:
+        print("No checkpoints found in", S3_PREFIX); sys.exit(2)
+    latest = ckpts[-1]
+    print("Latest checkpoint:", latest)
+    download(bucket, latest, out)
+    print("Downloaded to", out)
+
