+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Iteratively run RT lab orchestrator until SLOs met or max attempts reached.
+# - Runs ops/robotics/rt/lab_validation/orchestrate_rt_full.sh
+# - Runs p99_slo_checker.py to evaluate p99/safe-stop SLOs
+# - Uploads signed bundle to S3 (optional) and records manifest
+#
+NODE=${1:-localhost}
+OUT_BASE=${2:-/tmp/aegis_rt_iter}
+MAX_ATTEMPTS=${MAX_ATTEMPTS:-5}
+S3_UPLOAD=${S3_UPLOAD:-""}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+RETRY_DELAY=${RETRY_DELAY:-60}
+
+attempt=0
+while [ $attempt -lt "$MAX_ATTEMPTS" ]; do
+  attempt=$((attempt+1))
+  OUTDIR="${OUT_BASE}_attempt_${attempt}_$(date +%s)"
+  mkdir -p "$OUTDIR"
+  echo "RT Iteration $attempt -> $OUTDIR"
+  ./ops/robotics/rt/lab_validation/orchestrate_rt_full.sh --node "$NODE" --out "$OUTDIR" || true
+  # run SLO checker
+  P99_PATH="${OUTDIR}/rt_jitter_result.json"
+  SAFE_PATH="${OUTDIR}/safe_stop.json"
+  REPORT_PATH="${OUTDIR}/rt_slo_report.json"
+  P99_SLO_MS=${P99_SLO_MS:-0.2}
+  SAFE_SLO_MS=${SAFE_SLO_MS:-50.0}
+  python3 ops/robotics/rt/lab_validation/p99_slo_checker.py \
+    --P99_PATH "$P99_PATH" --SAFE_STOP_PATH "$SAFE_PATH" --OUT_REPORT "$REPORT_PATH" 2>/dev/null || true
+
+  # read overall_ok if present
+  overall_ok=false
+  if [ -f "$REPORT_PATH" ]; then
+    overall_ok=$(python3 - <<PY
+import json,sys
+try:
+    r=json.load(open("$REPORT_PATH"))
+    print(str(r.get("report",{}).get("overall_ok",False)).lower())
+except Exception:
+    print("false")
+PY
+)
+  fi
+
+  if [ "$overall_ok" = "true" ]; then
+    echo "SLOs met on attempt $attempt"
+    BUNDLE="${OUTDIR}.tar.gz"
+    if [ -n "${S3_UPLOAD}" ]; then
+      echo "Uploading bundle to ${S3_UPLOAD}"
+      aws s3 cp "$BUNDLE" "${S3_UPLOAD}" || true
+    fi
+    # record evidence manifest
+    python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("rt_iterative_success", {"attempt": $attempt, "bundle":"$BUNDLE", "node":"$NODE"})
+print("Recorded evidence")
+PY
+    exit 0
+  fi
+
+  echo "SLOs not met on attempt $attempt; sleeping $RETRY_DELAY seconds before retry"
+  sleep "$RETRY_DELAY"
+done
+
+echo "Max attempts reached; failing and recording evidence"
+python3 - <<PY
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("rt_iterative_failure", {"attempts": $MAX_ATTEMPTS, "node":"$NODE"})
+print("Recorded failure evidence")
+PY
+exit 1
+
