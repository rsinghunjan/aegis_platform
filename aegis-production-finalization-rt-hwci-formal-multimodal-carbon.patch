+inp = np.random.randn(1,3,224,224).astype('float32')
+ids = np.random.randint(0,1000,(1,32)).astype('int64')
+try:
+    out = sess.run(None, {"image": inp, "input_ids": ids})
+    print("ONNXRuntime OK, output shapes:", [o.shape for o in out])
+except Exception as e:
+    print("ONNXRuntime failed:", e)
+    sys.exit(2)
+PY
+
