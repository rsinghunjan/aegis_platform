+#!/usr/bin/env python3
+"""
+Verify that a container image has a cosign signature (KMS) and a Rekor entry before promotion.
+Exits non-zero if verification fails.
+
+Environment:
+ - IMAGE (required): image URI to verify
+ - COSIGN_KMS_URI (optional for key-based verify)
+ - REKOR_SERVER (optional)
+"""
+import os, subprocess, sys, json
+
+IMAGE = os.environ.get("IMAGE")
+if not IMAGE:
+    print("IMAGE env required", file=sys.stderr); sys.exit(2)
+
+def cosign_verify(image):
+    try:
+        subprocess.check_call(["cosign","verify",image])
+        return True
+    except Exception:
+        return False
+
+def rekor_search(image, rekor_server):
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--rekor_server", rekor_server, "--artifact", image])
+        return out.decode("utf-8")
+    except Exception:
+        return None
+
+ok = cosign_verify(IMAGE)
+if not ok:
+    print("cosign verify failed for", IMAGE); sys.exit(3)
+rekor = os.environ.get("REKOR_SERVER")
+rekor_entry = None
+if rekor:
+    rekor_entry = rekor_search(IMAGE, rekor)
+    if not rekor_entry:
+        print("Rekor entry not found for", IMAGE); sys.exit(4)
+print("Image verified and Rekor entry present.")
+print("Rekor search output (truncated):")
+print((rekor_entry or "")[:1000])
+sys.exit(0)
+
