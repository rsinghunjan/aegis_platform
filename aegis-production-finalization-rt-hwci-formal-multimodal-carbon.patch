+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <arpa/inet.h>
+
+static std::atomic<bool> keep_running(true);
+
+void sigint_handler(int) { keep_running = false; }
+
+int set_realtime(int prio) {
+  struct sched_param p; p.sched_priority = prio;
+  return sched_setscheduler(0, SCHED_FIFO, &p);
+}
+
+// Example watchdog: if no commands received within timeout, engage safe-stop
+int main() {
+  signal(SIGINT, sigint_handler);
+  mlockall(MCL_CURRENT | MCL_FUTURE);
+  if (set_realtime(80) != 0) perror("sched");
+
+  const int recv_port = 15000;
+  int fd = socket(AF_INET, SOCK_DGRAM, 0);
+  struct sockaddr_in addr; memset(&addr,0,sizeof(addr));
+  addr.sin_family=AF_INET; addr.sin_addr.s_addr=INADDR_ANY; addr.sin_port=htons(recv_port);
+  bind(fd,(struct sockaddr*)&addr,sizeof(addr));
+  struct timeval tv; tv.tv_sec=0; tv.tv_usec=100000;
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, (const char*)&tv, sizeof tv);
+
+  auto last_cmd = std::chrono::steady_clock::now();
+  const auto watchdog_ms = std::chrono::milliseconds(200);
+
+  while(keep_running) {
