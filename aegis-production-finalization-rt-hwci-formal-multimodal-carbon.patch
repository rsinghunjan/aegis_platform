+#!/usr/bin/env python3
+"""
+Safe-stop latency tester:
+ - Sends a 'fault' injection message (UDP) to the RT controller and listens for actuator commands to drop to safe values (near zero).
+ - Measures latency from fault command to first observed safe command and writes a JSON report.
+
+This assumes the RT controller echoes actuator commands on SEND_PORT (15001) as comma-separated floats (see ops/robotics/rt_controller/rt_controller.cpp).
+"""
+import socket, time, json, argparse
+from statistics import median
+
+RECV_PORT = 15000
+SEND_PORT = 15001
+SEND_ADDR = "127.0.0.1"
+
+def send_fault(target_host="127.0.0.1", target_port=15000, mode="drop", duration=2.0):
+    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    payload = json.dumps({"fault": mode, "duration": duration})
+    s.sendto(payload.encode("utf-8"), (target_host, target_port))
+    s.close()
+
+def listen_for_actuator(host="0.0.0.0", port=SEND_PORT, timeout=10.0):
+    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    s.bind((host, port))
+    s.settimeout(timeout)
+    start = time.time()
+    samples = []
+    try:
+        while True:
+            data, addr = s.recvfrom(4096)
+            t = time.time()
+            text = data.decode('utf-8', errors='ignore')
+            samples.append({"t": t, "data": text})
+    except socket.timeout:
+        pass
+    s.close()
+    return samples
+
+def parse_last_command(cmd_str):
+    try:
+        vals = [float(x) for x in cmd_str.split(",") if x.strip()]
+        return vals
+    except Exception:
+        return None
+
+def first_safe_time(samples, baseline_time, threshold=1e-3):
+    # consider safe when all command values are near zero (abs < threshold)
+    for s in samples:
+        vals = parse_last_command(s["data"])
+        if vals is None:
+            continue
+        if all(abs(v) < threshold for v in vals):
+            return s["t"] - baseline_time
+    return None
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--target", default="127.0.0.1")
+    p.add_argument("--mode", default="drop")
+    p.add_argument("--duration", type=float, default=2.0)
+    p.add_argument("--out", default="/tmp/safe_stop.json")
+    args = p.parse_args()
+    start = time.time()
+    send_fault(target_host=args.target, target_port=RECV_PORT, mode=args.mode, duration=args.duration)
+    samples = listen_for_actuator(host="0.0.0.0", port=SEND_PORT, timeout=args.duration + 3.0)
+    latency = first_safe_time(samples, start, threshold=1e-3)
+    report = {"target": args.target, "mode": args.mode, "duration": args.duration, "latency_s": latency, "samples": len(samples)}
+    with open(args.out, "w") as fh:
+        json.dump(report, fh, indent=2)
+    # record manifest if SDK present
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("safe_stop_test", report)
+    except Exception:
+        pass
+    print(json.dumps(report, indent=2))
+
