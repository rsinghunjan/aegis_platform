+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Orchestrate HSM (Terraform) provisioning + Vault PKCS#11 Helm upgrade + dual-control activation guide.
+# This script must be run interactively with Security present. It does not automate operator secrets or PGP signing.
+#
+# Usage:
+#   ./ops/run_hsm_vault_commission.sh /path/to/terraform.tfvars
+#
+TFVARS=${1:-}
+if [ -z "${TFVARS}" ]; then
+  echo "Usage: $0 /path/to/terraform.tfvars"
+  exit 2
+fi
+
+echo "=== Step 1: Terraform plan & apply for CloudHSM ==="
+pushd vault/terraform >/dev/null
+terraform init
+terraform plan -var-file="${TFVARS}" -out=hsm.plan
+echo "Review the plan above. Type 'apply' to continue or anything else to abort."
+read -p "> " CONF
+if [ "${CONF}" != "apply" ]; then
+  echo "Aborted by operator."
+  popd >/dev/null
+  exit 1
+fi
+terraform apply "hsm.plan"
+terraform output -json > /tmp/cloudhsm_outputs.json
+popd >/dev/null
+
+echo "=== Step 2: Mount PKCS#11 lib and upgrade Vault Helm release ==="
+echo "Ensure the PKCS#11 library is available on Vault nodes at /opt/cloudhsm/lib (hostPath)."
+echo "Applying Helm values (production):"
+helm upgrade --install vault hashicorp/vault -f vault/helm/values-pkcs11-production.yaml --namespace vault
+
+echo "Waiting for Vault to become ready..."
+kubectl -n vault rollout status deployment/vault --timeout=180s || true
+
+echo "=== Step 3: Dual-control key activation ==="
+echo "Follow vendor-specific steps. Use vault/scripts/dual_control_activate.sh to record artifacts."
+echo "Operator A: create/import key in HSM and save fingerprint to a file."
+echo "Operator B: independently verify fingerprint and create a PGP-signed approval artifact."
+echo "Then run (example):"
+echo "  ./vault/scripts/dual_control_activate.sh aegis-transit-key /path/operatorA.fp /path/operatorB.approval"
+
+echo "=== Step 4: Validate Vault signing (after activation) ==="
+echo "Run the signing test (vault/scripts/test_sign_with_vault.sh) to confirm transit sign works and is HSM-backed."
+echo "Example: ./vault/scripts/test_sign_with_vault.sh vault-0 'hello world'"
+
+echo "Save all CLI outputs, fingerprints and approval artifacts to ticketing/evidence and then continue with Rekor drill."
+
