+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run Rekor restore drill, rotate TLS certs, validate API and record RTO/RPO into a simple report JSON.
+#
+OUTDIR=${1:-/tmp/rekor_drill_$(date +%s)}
+mkdir -p "${OUTDIR}"
+
+echo "Starting Rekor restore drill..."
+START_TS=$(date +%s)
+./rekor/restore/automated_restore_and_validate.sh | tee "${OUTDIR}/restore_output.txt"
+END_TS=$(date +%s)
+RTO=$((END_TS - START_TS))
+
+echo "Running post-restore verification (sample entry read/write)..."
+./rekor/scripts/rekor_verify_sample_entry.sh | tee "${OUTDIR}/verify_output.txt" || true
+
+cat > "${OUTDIR}/rekor_drill_report.json" <<JSON
+{
+  "started_at": $(date +%s -d "@${START_TS}"),
+  "completed_at": $(date +%s -d "@${END_TS}"),
+  "rto_seconds": ${RTO},
+  "notes": "See restore_output.txt and verify_output.txt for details"
+}
+JSON
+
+echo "Rekor drill complete. Report: ${OUTDIR}/rekor_drill_report.json"
+echo "Upload the report and the artifacts to your DR binder / ticketing system for governance review."
