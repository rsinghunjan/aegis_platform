+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Convenience wrapper: validate Vault transit signing and optionally record a Rekor attestation.
+#
+VAULT_POD=${1:-vault-0}
+REKOR_URL=${REKOR_URL:-https://rekor.staging.internal}
+TMPDATA=${TMPDATA:-/tmp/aegis-sign-test.txt}
+
+echo "Writing test payload..."
+echo -n "aegis-sign-test-$(date -u +%s)" > ${TMPDATA}
+
+echo "Attempting sign via Vault transit..."
+kubectl -n vault exec -i ${VAULT_POD} -- sh -c "vault write -format=json transit/sign/aegis-transit input=\$(base64 -w0 ${TMPDATA})" > /tmp/vault_sign_resp.json || { echo "Vault sign failed"; exit 2; }
+
+cat /tmp/vault_sign_resp.json | jq .
+
+SIG=$(cat /tmp/vault_sign_resp.json | jq -r '.data.signature' || true)
+if [ -z "${SIG}" ]; then
+  echo "No signature returned. Check transit key and HSM linkage."
+  exit 3
+fi
+
+echo "Optionally register signature to Rekor for attestation (requires Rekor write permissions)."
+read -p "Register to Rekor? (yes/no) " reg
+if [ "${reg}" = "yes" ]; then
+  # Construct a minimal hashedrekord (placeholder) — in production use rekor client with proper format
+  HASH=$(sha256sum ${TMPDATA} | awk '{print $1}')
+  PAYLOAD=$(jq -n --arg h "$HASH" '{"apiVersion":"0.0.1","kind":"hashedrekord","spec":{"data":{"hash":{"algorithm":"sha256","value":$h}}}}')
+  curl -sSk -X POST -H "Content-Type: application/json" -d "${PAYLOAD}" ${REKOR_URL}/api/v1/log | jq .
+fi
+
+echo "Persist the vault_sign_resp.json and any Rekor receipts into MCP evidence and ticketing."
+
