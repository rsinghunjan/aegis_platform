+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Sync key refs (AWS/GCP/Azure) into Vault production path.
+# Usage:
+#   ./ops/hsm/sync_keys_to_vault.sh --aws-arn <arn> [--gcp-id <gcp_id>] [--azure-id <azure_id>]
+
+VAULT_PATH=${VAULT_PATH:-secret/data/aegis/kms}
+AWS_ARN=""
+GCP_ID=""
+AZURE_ID=""
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --aws-arn) AWS_ARN="$2"; shift 2;;
+    --gcp-id) GCP_ID="$2"; shift 2;;
+    --azure-id) AZURE_ID="$2"; shift 2;;
+    *) echo "Unknown arg $1"; exit 2;;
+  esac
+done
+
+if [ -z "$AWS_ARN" ] && [ -z "$GCP_ID" ] && [ -z "$AZURE_ID" ]; then
+  echo "Provide at least one key ref"
+  exit 2
+fi
+
+JSON="{"
+[ -n "$AWS_ARN" ] && JSON+="\"aws\":\"aws-kms://$AWS_ARN\""
+[ -n "$GCP_ID" ] && JSON+=",\"gcp\":\"gcpkms://$GCP_ID\""
+[ -n "$AZURE_ID" ] && JSON+=",\"azure\":\"azurekms://$AZURE_ID\""
+JSON+="}"
+
+echo "Putting key refs into Vault at $VAULT_PATH"
+vault kv put "$VAULT_PATH" cosign_key_refs="$JSON"
+echo "Done."
+
