+#!/usr/bin/env bash
+set -euo pipefail
+# Deploy core infrastructure with Helm and use Vault CSI to populate secrets (defaults used)
+NS=${1:-aegis}
+STORAGE_CLASS=${2:-standard-ssd}
+GPU_NODE_LABEL=${3:-node-role.kubernetes.io/gpu=true}
+
+kubectl create ns "$NS" || true
+
+echo "Ensure SecretProviderClass 'aegis-vault-spc' exists and is configured per ops/k8s/vault_csi.md"
+echo "Installing Prometheus & Grafana via helm"
+helm repo add prometheus-community https://prometheus-community.github.io/helm-charts || true
+helm repo add grafana https://grafana.github.io/helm-charts || true
+helm repo update
+helm upgrade --install aegis-prom kube-prometheus-stack -n "$NS" -f ops/helm/production_values_prometheus.yml
+helm upgrade --install aegis-grafana grafana/grafana -n "$NS" -f ops/helm/production_values_grafana.yml
+
+echo "Installing Milvus via helm with production values"
+helm repo add milvus https://milvus-io.github.io/milvus-helm || true
+helm repo update
+helm upgrade --install aegis-milvus milvus/milvus -n "$NS" -f ops/helm/production_values_milvus.yml
+
+echo "Install Redis (bitnami chart recommended) with persistence"
+helm repo add bitnami https://charts.bitnami.com/bitnami || true
+helm upgrade --install aegis-redis bitnami/redis -n "$NS" -f ops/helm/production_values_redis.yml
+
+echo "Deploy application-level workloads (MLflow, moderation, warm-pool, triton/vllm templates)"
+kubectl apply -f ops/k8s/secrets_template.yaml -n "$NS" || true
+kubectl apply -f ops/k8s/networkpolicies_prod.yaml -n "$NS" || true
+kubectl apply -f ops/k8s/rbac_prod.yaml -n "$NS" || true
+kubectl apply -f ops/k8s/mlflow-deployment.yaml -n "$NS" || true
+kubectl apply -f ops/k8s/redis-statefulset.yaml -n "$NS" || true
+
+echo "Deploy moderation (ClusterIP) and warm-pool"
+kubectl apply -f services/moderation/k8s_deploy_mod_service.yaml -n "$NS" || true
+kubectl apply -f services/serving/warm_pool_k8s.yaml -n "$NS" || true
+
+echo "Post-deploy: verify pods and run ops/backup/drill_restore.sh in staging"
+kubectl get pods -n "$NS"
+
