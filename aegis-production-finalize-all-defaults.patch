+#!/usr/bin/env python3
+"""
+Integration smoke test for the moderation service and attestation pipeline.
+Uses MODERATION_SERVICE_URL env var and expects COSIGN_KEY_REF to be valid in the cluster.
+"""
+import os, requests, json, sys, time
+
+MOD_URL = os.environ.get("MODERATION_SERVICE_URL","http://localhost:8200")
+
+def test_text():
+    r = requests.post(f"{MOD_URL}/moderate/text", json={"text":"This is a harmless test", "id":"test-text-1"}, timeout=10)
+    r.raise_for_status()
+    j = r.json()
+    print("Text moderation returned:", j)
+    return j
+
+def test_image():
+    with open("/tmp/test.png","wb") as fh:
+        fh.write(b"\x89PNG\r\n\x1a\n" + os.urandom(256))
+    files={"file": open("/tmp/test.png","rb")}
+    r = requests.post(f"{MOD_URL}/moderate/image", files=files, data={"id":"test-img-1"}, timeout=20)
+    r.raise_for_status()
+    j = r.json()
+    print("Image moderation returned:", j)
+    return j
+
+if __name__=="__main__":
+    print("Testing moderation endpoints...")
+    try:
+        print(test_text())
+        print(test_image())
+        print("Moderation integration smoke test passed")
+    except Exception as e:
+        print("Moderation integration test failed:", e)
+        sys.exit(2)
+
