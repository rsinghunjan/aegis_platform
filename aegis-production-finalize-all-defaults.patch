+#!/usr/bin/env bash
+set -euo pipefail
+#
+# End-to-end AWS CloudHSM + KMS Custom Key Store activation helper (operator-driven).
+# This script is an operator checklist + smoke-test helper. It intentionally requires
+# human confirmation for critical steps (initialization, key creation).
+#
+# Defaults used by this repository:
+#  - storageClass: standard-ssd
+#  - Vault CSI expected (see ops/k8s/vault_csi.md)
+#  - cosign key usage: KMS-backed (aws-kms://...)
+#  - container registry: ghcr.io/aegis
+#
+# Usage:
+#   ./ops/hsm/aws_hsm_activation_full.sh <cloudhsm-cluster-id> <aws-region>
+CLUSTER_ID=${1:-}
+REGION=${2:-us-west-2}
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+
+if [ -z "$CLUSTER_ID" ]; then
+  echo "Usage: $0 <cloudhsm-cluster-id> [aws-region]"
+  exit 2
+fi
+
+echo "1) Describe CloudHSM cluster"
+aws cloudhsmv2 describe-clusters --cluster-id "$CLUSTER_ID" --region "$REGION"
+
+echo
+echo "2) Initialize cluster (manual step)"
+echo "   Follow AWS docs: https://docs.aws.amazon.com/cloudhsm/latest/userguide/initialize-cluster.html"
+echo "   Example operator steps (manual):"
+echo "     - Generate CSR and complete trust-anchor exchange"
+echo "     - aws cloudhsmv2 initialize-cluster --cluster-id $CLUSTER_ID --signed-cert file://clusterCert.pem"
+read -p "Press ENTER when cluster initialization is complete..."
+
+echo
+echo "3) Create KMS Custom Key Store in the KMS console pointing to this CloudHSM cluster."
+echo "   After that, create an asymmetric CMK in KMS with origin AWS_CLOUDHSM (RSA_3072 recommended)."
+read -p "Press ENTER when KMS Custom Key Store + CMK are created..."
+
+read -p "Enter the created KMS CMK ARN (full ARN, e.g. arn:aws:kms:...): " KEY_ARN
+if [ -z "$KEY_ARN" ]; then
+  echo "No key ARN provided - aborting"
+  exit 3
+fi
+
+echo "4) Create issuance manifest and upload it to evidence & Vault staging"
+python3 ops/hsm/issue_key_manifest.py --key-ref "$KEY_ARN" --operator "$(whoami)" --notes "Initial activation"
+echo "Now place key ref into Vault staging path (operator):"
+echo "  vault kv put secret/data/aegis/kms/staging cosign_key_refs=\"aws-kms://$KEY_ARN\""
+read -p "Press ENTER when Vault staging updated..."
+
+echo "5) Auditor review: obtain auditor signature on the issuance manifest (manual)."
+read -p "Press ENTER when auditor signoff complete..."
+
+echo "6) Promote staging -> active (operator):"
+echo "  vault kv put secret/data/aegis/kms cosign_key_refs=\"aws-kms://$KEY_ARN\""
+read -p "Press ENTER when promoted..."
+
+echo "7) Smoke test cosign sign/verify"
+TMP_ART=/tmp/aegis_cosign_test_"$(date +%s)".txt
+echo "Aegis cosign test $(date -u)" > "$TMP_ART"
+cosign sign --key "aws-kms://$KEY_ARN" "$TMP_ART"
+cosign verify --key "aws-kms://$KEY_ARN" "$TMP_ART"
+echo "cosign sign/verify OK"
+
+if [ -n "$EVIDENCE_BUCKET" ] && [[ $EVIDENCE_BUCKET == s3://* ]]; then
+  aws s3 cp "$TMP_ART" "$EVIDENCE_BUCKET/hsm-tests/$(basename $TMP_ART)"
+  echo "Uploaded sample artifact to $EVIDENCE_BUCKET/hsm-tests/"
+fi
+
+echo "8) Add the new key-refs into production Vault path for use by services (if not done earlier)."
+echo "Operational notes: schedule and practice rotation using ops/hsm/rotation_ceremony.md and ops/hsm/rotate_keys_prod.sh"
+echo "Done."
+
