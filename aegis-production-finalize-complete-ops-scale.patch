+#!/usr/bin/env python3
+"""
+Validate a trained calibrator model for factuality on a holdout set and assert min precision at operating threshold.
+If validation fails, exit non-zero (used in CI gating before threshold push).
+"""
+import argparse, joblib, csv, numpy as np
+from sklearn.metrics import precision_recall_curve, roc_auc_score
+
+def load_data(csv_path):
+    X=[]; y=[]
+    with open(csv_path) as fh:
+        reader=csv.DictReader(fh)
+        for r in reader:
+            X.append([float(r.get("ratio",0.0)), float(r.get("clip",0.0)), float(len(r.get("response","").split()))])
+            y.append(int(r.get("label",0)))
+    return np.array(X), np.array(y)
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--model", required=True)
+    p.add_argument("--holdout", required=True)
+    p.add_argument("--min_precision", type=float, default=0.9)
+    args=p.parse_args()
+    clf=joblib.load(args.model)
+    X,y=load_data(args.holdout)
+    probs=clf.predict_proba(X)[:,1]
+    precision, recall, thresholds = precision_recall_curve(y, probs)
+    # choose threshold maximizing recall subject to precision >= min_precision
+    candidate=None
+    for p_val, r_val, th in zip(precision, recall, list(thresholds)+[thresholds[-1] if len(thresholds) else 0.0]):
+        if p_val >= args.min_precision:
+            candidate={"threshold":float(th),"precision":float(p_val),"recall":float(r_val)}
+            break
+    if not candidate:
+        print("Validation failed: no threshold meets precision", args.min_precision)
+        exit(2)
+    print("Validation passed. candidate:", candidate)
+    # store recommended threshold artifact for operator
+    import json
+    open("/tmp/calibrator_validation_result.json","w").write(json.dumps(candidate))
+    print("Wrote /tmp/calibrator_validation_result.json")
+
+if __name__=="__main__":
+    main()
+
