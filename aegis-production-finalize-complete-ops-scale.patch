+#!/usr/bin/env python3
+"""
+Prepare and sign an audit binder for finance shadow-run results and remediation evidence.
+Uploads binder to evidence bucket and notifies auditor/insurer webhooks.
+"""
+import os, json, subprocess, tempfile, argparse, time
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+AUDITOR_WEBHOOK = os.environ.get("AUDITOR_WEBHOOK","")
+INSURER_WEBHOOK = os.environ.get("INSURER_WEBHOOK","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def package(paths):
+    tmp=tempfile.mkdtemp()
+    for p in paths:
+        if os.path.exists(p):
+            subprocess.check_call(["cp","-r",p,tmp])
+    meta={"ts":int(time.time()), "items":paths}
+    with open(tmp+"/meta.json","w") as fh: json.dump(meta, fh)
+    archive=f"/tmp/aegis_fin_binder_{int(time.time())}.tar.gz"
+    subprocess.check_call(["tar","-czf",archive,"-C",tmp,"."])
+    return archive
+
+def sign(archive):
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key",COSIGN_KEY_REF, archive])
+        return True
+    return False
+
+def upload(archive):
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        dest=f"{EVIDENCE_BUCKET}/finance/{os.path.basename(archive)}"
+        subprocess.check_call(["aws","s3","cp", archive, dest])
+        return dest
+    return None
+
+def notify(uri):
+    payload={"binder": uri}
+    if AUDITOR_WEBHOOK:
+        subprocess.check_call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps(payload), AUDITOR_WEBHOOK])
+    if INSURER_WEBHOOK:
+        subprocess.check_call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps(payload), INSURER_WEBHOOK])
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--paths", nargs="+", default=["services/finance","policies","ops/repro"])
+    args=p.parse_args()
+    arc=package(args.paths)
+    signed=sign(arc)
+    uri=upload(arc)
+    notify(uri)
+    print("Binder prepared:", uri, "signed:", signed)
+
+if __name__=="__main__":
+    main()
+
