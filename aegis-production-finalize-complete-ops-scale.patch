+    echo "4) Smoke-test cosign sign/verify using KMS key"
+    echo "Create sample artifact"
+    echo "aegis-cosign-test" > "$COSIGN_TEST_ARTIFACT"
+    cosign sign --key "aws-kms://$KEY_ARN" "$COSIGN_TEST_ARTIFACT" || { echo "cosign sign failed"; exit 3; }
+    cosign verify --key "aws-kms://$KEY_ARN" "$COSIGN_TEST_ARTIFACT" || { echo "cosign verify failed"; exit 4; }
+    echo "Signed and verified with KMS key"
+    ;;
+  gcp)
+    echo "GCP: ensure key created in KMS and grant signer identity roles/cloudkms.signerVerifier"
+    read -p "Enter GCP KMS key resource id (projects/...): " GCP_KEY_ID
+    echo "Smoke-test: cosign sign --key gcpkms://$GCP_KEY_ID <artifact>"
+    ;;
+  azure)
+    echo "Azure: ensure KeyVault HSM key created and access policy applied for signer identity"
+    read -p "Enter Azure key id (https://.../keys/...): " AZ_KEY_ID
+    echo "Smoke-test: cosign sign --key azurekms://$AZ_KEY_ID <artifact>"
