+#!/usr/bin/env python3
+"""
+Adapter example for a vetted external moderation API (e.g., OpenAI moderation) with attested verdicts.
+Operators must provide MODERATION_API_URL and MODERATION_API_KEY or configure a specific provider client.
+"""
+import os, requests, json
+from services.safety.moderation_attest import create_manifest, sign_manifest, upload_manifest, record_in_vault
+
+MODERATION_API_URL = os.environ.get("MODERATION_API_URL","")
+MODERATION_API_KEY = os.environ.get("MODERATION_API_KEY","")
+
+def moderate_text_external(text):
+    if not MODERATION_API_URL:
+        return {"verdict":"review", "reasons":["no_provider"], "confidence":0.0}
+    headers = {"Authorization": f"Bearer {MODERATION_API_KEY}"} if MODERATION_API_KEY else {}
+    r = requests.post(f"{MODERATION_API_URL}/moderate/text", json={"text": text}, headers=headers, timeout=15)
+    r.raise_for_status()
+    resp = r.json()
+    return resp
+
+def moderate_image_external(image_bytes, filename="img.png"):
+    if not MODERATION_API_URL:
+        return {"verdict":"review", "reasons":["no_provider"], "confidence":0.0}
+    files = {"file": (filename, image_bytes)}
+    headers = {"Authorization": f"Bearer {MODERATION_API_KEY}"} if MODERATION_API_KEY else {}
+    r = requests.post(f"{MODERATION_API_URL}/moderate/image", files=files, headers=headers, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def moderate_and_attest_text(text, item_id):
+    res = moderate_text_external(text)
+    manifest_path = create_manifest(item_id, res.get("verdict","review"), res)
+    sign_manifest(manifest_path)
+    uri = upload_manifest(manifest_path)
+    record_in_vault(item_id, uri or manifest_path)
+    return {"verdict": res.get("verdict"), "manifest": uri}
+
+def moderate_and_attest_image(image_bytes, item_id):
+    res = moderate_image_external(image_bytes)
+    manifest_path = create_manifest(item_id, res.get("verdict","review"), res)
+    sign_manifest(manifest_path)
+    uri = upload_manifest(manifest_path)
+    record_in_vault(item_id, uri or manifest_path)
+    return {"verdict": res.get("verdict"), "manifest": uri}
+
+if __name__=="__main__":
+    print("Moderation OpenAPI adapter")
