+#!/usr/bin/env python3
+"""
+Hardware/Runtime diagnostics for vendor runners (GPU/TPU/Neuron).
+Runs a set of checks and emits a JSON report for CI consumption.
+"""
+import json, subprocess, os, time, argparse
+
+def run_cmd(cmd):
+    try:
+        out = subprocess.check_output(cmd, shell=True, stderr=subprocess.STDOUT, universal_newlines=True, timeout=20)
+    except Exception as e:
+        out = str(e)
+    return out
+
+def gpu_checks():
+    checks = {}
+    checks["nvidia_smi"] = run_cmd("nvidia-smi -L || true")
+    checks["cuda_version"] = run_cmd("cat /usr/local/cuda/version.txt || true")
+    return checks
+
+def neuron_checks():
+    checks = {}
+    checks["neuron_runtimes"] = run_cmd("neuron-cli --version || true")
+    checks["dmesg_neuron"] = run_cmd("dmesg | tail -n 50 || true")
+    return checks
+
+def tpu_checks():
+    checks = {}
+    checks["tpu_status"] = run_cmd("ls /dev | grep tpu || true")
+    checks["tpu_libs"] = run_cmd("python3 -c 'import jax; print(jax.lib.xla_bridge.get_backend())' || true")
+    return checks
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", default="/tmp/runner_diag.json")
+    args = p.parse_args()
+    report = {"ts": int(time.time()), "host": os.uname()[1], "checks": {}}
+    report["checks"].update(gpu_checks())
+    report["checks"].update(neuron_checks())
+    report["checks"].update(tpu_checks())
+    with open(args.out,"w") as fh:
+        json.dump(report, fh, indent=2)
+    print("Wrote diagnostics to", args.out)
+
+if __name__ == "__main__":
+    main()
+
