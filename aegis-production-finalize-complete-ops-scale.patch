+#
+# This script guides operators and runs a few non-destructive checks. Many steps remain manual
+# and must be performed by custodians (initialization, trust establishment, key creation).
+#
+# Usage: ./ops/hsm/initialize_and_test.sh <provider> <cluster-or-key-ref-if-applicable>
+# Example: ./ops/hsm/initialize_and_test.sh aws <cloudhsm-cluster-id>
+
+PROVIDER=${1:-}
+REF=${2:-}
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+COSIGN_TEST_ARTIFACT=${COSIGN_TEST_ARTIFACT:-"/tmp/aegis_cosign_test.txt"}
+
+if [ -z "$PROVIDER" ]; then
+  echo "Usage: $0 <aws|gcp|azure> [cluster-or-key-ref]"
+  exit 2
+fi
+
+echo "Aegis HSM initialization & smoke-test helper"
+echo "Provider: $PROVIDER"
+
+case "$PROVIDER" in
+  aws)
+    CLUSTER_ID="$REF"
+    echo "1) Verify CloudHSM cluster exists:"
+    aws cloudhsmv2 describe-clusters --cluster-id "$CLUSTER_ID" || true
+    echo "2) Ensure cluster initialized per runbook ops/hsm/rotation_ceremony.md"
+    echo "3) Ensure KMS Custom Key Store created and a signing key ARN available"
