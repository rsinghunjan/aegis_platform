+#!/usr/bin/env python3
+"""
+Scan repository for policy_action keys and tool IDs to auto-generate a CSV scaffold
+that operators can use to expand delegation_matrix coverage.
+"""
+import os, re, csv, argparse
+
+def scan_repo(root="."):
+    actions=set()
+    for dirpath, _, filenames in os.walk(root):
+        for fn in filenames:
+            if fn.endswith((".py",".yaml",".yml",".json")):
+                path=os.path.join(dirpath,fn)
+                try:
+                    txt=open(path,errors="ignore").read()
+                    for m in re.findall(r'policy_action["\']?\s*[:=]\s*["\']([^"\']+)["\']', txt):
+                        actions.add(m)
+                    for m in re.findall(r'\"tool\"\s*:\s*\"([a-zA-Z0-9_/-]+)\"', txt):
+                        actions.add(m)
+                except Exception:
+                    continue
+    return sorted(actions)
+
+def write_csv(actions,out):
+    with open(out,"w",newline="") as fh:
+        w=csv.writer(fh)
+        w.writerow(["action","automation","roles","evidence"])
+        for a in actions:
+            w.writerow([a,"human_required","platform_lead",""])
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--root", default=".")
+    p.add_argument("--out", default="policies/generated_actions.csv")
+    args=p.parse_args()
+    acts=scan_repo(args.root)
+    write_csv(acts,args.out)
+    print("Wrote", args.out)
+
+if __name__=="__main__":
+    main()
+
