+#!/usr/bin/env python3
+"""
+Record key rotation and custody events to the audit ledger and optionally upload to evidence bucket.
+This script is called by operators during rotation ceremonies.
+"""
+import os, json, time, subprocess, argparse
+
+VAULT_PATH = os.environ.get("VAULT_KMS_ISSUANCE_PATH", "secret/data/aegis/kms_issuance")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+
+def write_local(manifest):
+    ts = int(time.time())
+    fn = f"/tmp/kms_rotation_{ts}.json"
+    with open(fn,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return fn
+
+def upload(fn):
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        dest = f"{EVIDENCE_BUCKET}/kms_rotations/{os.path.basename(fn)}"
+        subprocess.check_call(["aws","s3","cp", fn, dest])
+        return dest
+    return None
+
+def vault_record(key, metadata):
+    subprocess.check_call(["vault","kv","put", f"{VAULT_PATH}/{key}", f"metadata={json.dumps(metadata)}"])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--key-ref", required=True)
+    p.add_argument("--operator", required=True)
+    p.add_argument("--notes", default="")
+    args = p.parse_args()
+    manifest = {"key_ref": args.key_ref, "operator": args.operator, "notes": args.notes, "ts": int(time.time())}
+    fn = write_local(manifest)
+    uri = upload(fn)
+    vault_key = f"rotation-{int(time.time())}"
+    metadata = {"manifest_uri": uri or fn, **manifest}
+    vault_record(vault_key, metadata)
+    print("Rotation logged:", vault_key, uri or fn)
+
+if __name__ == "__main__":
+    main()
+
