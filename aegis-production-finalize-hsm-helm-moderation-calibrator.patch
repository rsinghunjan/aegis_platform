+#!/usr/bin/env python3
+"""
+Helper: verify that a cosign-signed moderation manifest has an entry in Rekor.
+Uses cosign verify --rekor-server to ensure transparency log presence.
+"""
+import subprocess, sys, os
+
+def verify_with_rekor(manifest_path, rekor_url=None):
+    cmd = ["cosign","verify","--key","/dev/null", manifest_path]
+    # cosign verify without key will check rekor signatures; alternatively use `cosign verify-blob --rekor-server`
+    try:
+        subprocess.check_call(["cosign","verify","--rekor-url", rekor_url or "", manifest_path])
+        return True
+    except subprocess.CalledProcessError:
+        return False
+
+if __name__=="__main__":
+    print(verify_with_rekor(sys.argv[1], os.environ.get("REKOR_URL")))
+
