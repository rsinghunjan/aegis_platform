+#!/usr/bin/env python3
+"""
+Run-end calibrator script: convert labels, train calibrator, validate, and push threshold to Vault.
+This script ties the earlier pipelines together for CI or operator runs.
+"""
+import os, subprocess, json, argparse
+
+VAULT_PATH = os.environ.get("VAULT_THRESHOLD_PATH","secret/data/aegis/factuality")
+
+def convert_labels(infile, outfile):
+    subprocess.check_call(["python3","services/factuality/labeling/convert_to_dataset.py", infile, outfile])
+
+def train(csv_in, model_out, report_out):
+    subprocess.check_call(["python3","services/factuality/train_threshold.py","--csv",csv_in,"--out_model",model_out,"--out_report",report_out])
+
+def push_threshold_to_vault(report):
+    r = json.load(open(report))
+    thr = r.get("recommended")
+    if thr:
+        subprocess.check_call(["vault","kv","put", VAULT_PATH, f"threshold={json.dumps(thr)}"])
+        return True
+    return False
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--labels", required=True)
+    args = p.parse_args()
+    tmpcsv = "/tmp/labels.csv"
+    convert_labels(args.labels, tmpcsv)
+    train(tmpcsv, "/tmp/calibrator.pkl", "/tmp/calibrator_report.json")
+    ok = push_threshold_to_vault("/tmp/calibrator_report.json")
+    print("Calibration completed, threshold pushed:", ok)
+
