+#!/usr/bin/env python3
+"""
+Moderation + attestation:
+ - Uses AWS Rekognition (and Comprehend for text PII) to moderate content
+ - Creates a moderation manifest and signs it with cosign (using KMS key refs or local key)
+ - Optionally uploads the manifest to EVIDENCE_BUCKET and records in Vault
+ - Cosign will also record the signature in Rekor transparency log (if configured)
+
+Environment:
+ - AWS_REGION, EVIDENCE_BUCKET (s3://...), COSIGN_KEY_REF (KMS or file), VAULT_MODERATION_PATH
+"""
+import os, json, subprocess, time, boto3
+from base64 import b64encode
+
+AWS_REGION = os.environ.get("AWS_REGION","us-west-2")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")  # e.g., "aws-kms://arn:aws:kms:..."
+VAULT_MODERATION_PATH = os.environ.get("VAULT_MODERATION_PATH","secret/data/aegis/moderation")
+
+def moderate_image_bytes_aws(image_bytes, min_confidence=70):
+    rek = boto3.client("rekognition", region_name=AWS_REGION)
+    resp = rek.detect_moderation_labels(Image={'Bytes': image_bytes}, MinConfidence=min_confidence)
+    labels = resp.get("ModerationLabels", [])
+    return labels
+
+def moderate_text_pii_aws(text):
+    comp = boto3.client("comprehend", region_name=AWS_REGION)
+    resp = comp.detect_pii_entities(Text=text, LanguageCode="en")
+    return resp.get("Entities", [])
+
+def create_manifest(artifact_id, verdict, details):
+    manifest = {
+        "artifact_id": artifact_id,
+        "verdict": verdict,
+        "details": details,
+        "ts": int(time.time())
+    }
+    fn = f"/tmp/mod_manifest_{artifact_id}_{int(time.time())}.json"
+    with open(fn,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    return fn, manifest
+
+def sign_and_upload(manifest_path):
+    # Sign manifest using cosign (supports aws-kms and other key refs)
+    if not COSIGN_KEY_REF:
+        raise RuntimeError("COSIGN_KEY_REF not set")
+    subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, manifest_path])
+    uploaded = None
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", manifest_path, f"{EVIDENCE_BUCKET}/moderation/{os.path.basename(manifest_path)}"])
+        uploaded = f"{EVIDENCE_BUCKET}/moderation/{os.path.basename(manifest_path)}"
+    return uploaded
+
+def moderate_and_attest_image(image_bytes, artifact_id):
+    labels = moderate_image_bytes_aws(image_bytes)
+    verdict = "allow"
+    reasons = []
+    for l in labels:
+        if l.get("ParentName") in ("Explicit Nudity", "Violence") or l.get("Name") in ("Explicit Nudity","Violence"):
+            verdict = "block"
+            reasons.append(l.get("Name"))
+    manifest_path, manifest = create_manifest(artifact_id, verdict, {"labels": labels})
+    uploaded = sign_and_upload(manifest_path)
+    # record to Vault (operator must have VAULT configured)
+    try:
+        subprocess.check_call(["vault","kv","put", f"{VAULT_MODERATION_PATH}/{artifact_id}", f"manifest_uri={uploaded}"])
+    except Exception:
+        pass
+    return {"verdict": verdict, "reasons": reasons, "manifest": uploaded}
+
+if __name__=="__main__":
+    import sys
+    img_path = sys.argv[1]
+    aid = os.path.basename(img_path)
+    b = open(img_path,"rb").read()
+    print(moderate_and_attest_image(b, aid))
+
