"""
JWT/OIDC middleware helper for LangChain runtime.
Validates incoming Authorization header using JWKS from OIDC_ISSUER.
"""
import os, logging, requests
from jose import jwt, JWTError
from fastapi import HTTPException, Header

logger = logging.getLogger("langchain.auth")

OIDC_ISSUER = os.environ.get("AEGIS_OIDC_ISSUER", "")
OIDC_AUDIENCE = os.environ.get("AEGIS_OIDC_AUDIENCE", "")

_JWKS = {}

def get_jwks():
    global _JWKS
    if _JWKS:
        return _JWKS
    if not OIDC_ISSUER:
        return None
    try:
        cfg = requests.get(f"{OIDC_ISSUER.rstrip('/')}/.well-known/openid-configuration", timeout=3.0).json()
        jwks_uri = cfg.get("jwks_uri")
        _JWKS = requests.get(jwks_uri, timeout=3.0).json()
        return _JWKS
    except Exception as e:
        logger.warning("Failed to fetch JWKS: %s", e)
        return None

def validate_token(auth_header: str | None = Header(default=None)):
    if not OIDC_ISSUER:
        return True
    if not auth_header:
        raise HTTPException(status_code=401, detail="Authorization header required")
    token = auth_header.split()[1]
    jwks = get_jwks()
    if not jwks:
        raise HTTPException(status_code=500, detail="OIDC not available")
    try:
        headers = jwt.get_unverified_header(token)
        kid = headers.get("kid")
        key_entry = None
        for k in jwks.get("keys", []):
            if k.get("kid") == kid:
                key_entry = k
                break
        if not key_entry:
            raise HTTPException(status_code=401, detail="invalid token key")
        claims = jwt.decode(token, key_entry, audience=OIDC_AUDIENCE or None, issuer=OIDC_ISSUER or None)
        return True
    except JWTError:
        raise HTTPException(status_code=401, detail="token invalid")
