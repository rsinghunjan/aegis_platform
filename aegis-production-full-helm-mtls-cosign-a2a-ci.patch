#!/usr/bin/env python3
"""
Demo script:
 - Assumes MCP service, LangChain runtime, Retriever and approver are deployed locally or in cluster.
 - Calls LangChain runtime to run a RetrievalQA and a LangGraph plan run that requests approval.
"""
import requests, os, json, time

LANGCHAIN_URL = os.environ.get("LANGCHAIN_URL", "http://localhost:8080/v1/chain/run")

def run_retrieval_qa():
    payload = {
        "chain_type": "retrieval_qa",
        "model_id": "multimodal_demo",
        "model_version": "v1",
        "input": "What are the top-3 risks of deploying LLMs?",
        "options": {}
    }
    r = requests.post(LANGCHAIN_URL, json=payload, timeout=60)
    print("RetrievalQA:", r.status_code, r.json())

def run_graph_plan():
    payload = {
        "chain_type": "graph_plan",
        "model_id": "multimodal_demo",
        "model_version": "v1",
        "input": "Find relationships between data sources and summarize potential compliance issues.",
        "options": {"request_approval": True, "artifact_uri": "s3://aegis-artifacts/graph-plan-1.plan"}
    }
    r = requests.post(LANGCHAIN_URL, json=payload, timeout=60)
    print("GraphPlan:", r.status_code, r.json())

if __name__ == "__main__":
    print("Running RetrievalQA demo")
    run_retrieval_qa()
    time.sleep(1)
    print("Running GraphPlan demo (will request approval)")
    run_graph_plan()
