     """
     Adapter that provides a LangChain-compatible interface while preserving existing audit hooks.
     Use this to call your existing AgentRunner or to call into the LangChain runtime.
     """
     def __init__(self, api_base: str = None, mcp_api: str = None, a2a_api: str = None):
         self.api_base = api_base or os.environ.get("AEGIS_API_BASE", "http://localhost:8081")
         self.mcp_api = mcp_api or os.environ.get("AEGIS_MCP_API", "http://localhost:8082")
         self.a2a_api = a2a_api or os.environ.get("A2A_API", "http://approver:8085")
         self.logger = logging.getLogger("aegis.langchain_wrapper")
 
     def run_chain(self, model_id: str, model_version: str, prompt: str, request_approval: bool = False, artifact_uri: str = "") -> str:
         run_id = str(uuid.uuid4())
         # attach MCP minimal trace
         try:
             rec = {"model_id": model_id, "version": model_version, "artifacts":[{"uri": artifact_uri}], "evaluation":{"run_id": run_id}}
             httpx.post(f"{self.mcp_api.rstrip('/')}/models/{model_id}/context", json=rec, timeout=3.0)
         except Exception:
             self.logger.debug("MCP attach failed (continuing)")
 
         # Use existing AgentRunner to execute (non-blocking replacement)
         try:
             ar = AgentRunner()
             result = ar.run(prompt)
         except Exception as e:
             self.logger.exception("AgentRunner execution failed")
             raise
 
         if request_approval:
             try:
                 payload = {"id": str(uuid.uuid4()), "type":"approval_request", "model_id": model_id, "artifact_uri": artifact_uri, "requester":"langchain-wrapper", "ts": int(time.time())}
                 httpx.post(f"{self.a2a_api.rstrip('/')}/request", json=payload, timeout=2.0)
             except Exception:
                 self.logger.debug("A2A approval request failed (continuing)")
 
         return result
