+        return _JWKS_CACHE
+    try:
+        openid_cfg = requests.get(f"{OIDC_ISSUER.rstrip('/')}/.well-known/openid-configuration", timeout=5.0).json()
+        jwks_uri = openid_cfg.get("jwks_uri")
+        if not jwks_uri:
+            return None
+        jwks = requests.get(jwks_uri, timeout=5.0).json()
+        _JWKS_CACHE = jwks
+        return jwks
+    except Exception as e:
+        logger.warning("Failed to fetch JWKS: %s", e)
+        return None
+
+def _validate_jwt(auth_header: str | None = Header(default=None)):
+    # If no OIDC configured and no token required, allow
+    if not OIDC_ISSUER and not MCP_API_TOKEN:
+        return True
+    # Token-based fallback
+    if MCP_API_TOKEN:
+        if not auth_header:
+            raise HTTPException(status_code=401, detail="Authorization required")
+        parts = auth_header.split()
+        if len(parts) != 2 or parts[0].lower() != "bearer" or parts[1] != MCP_API_TOKEN:
+            # Not matching static token — try JWT next
+            pass
+        else:
+            return True
+    # JWT Path
+    if not auth_header:
+        raise HTTPException(status_code=401, detail="Authorization required")
+    token = auth_header.split()[1]
+    jwks = _get_jwks()
+    if not jwks:
+        raise HTTPException(status_code=500, detail="OIDC not available")
+    try:
+        headers = jwt.get_unverified_header(token)
+        kid = headers.get("kid")
+        key_entry = None
+        for k in jwks.get("keys", []):
+            if k.get("kid") == kid:
+                key_entry = k
+                break
+        if not key_entry:
+            raise HTTPException(status_code=401, detail="invalid token key")
+        # build rsa key
+        # python-jose accepts the jwk dict directly
+        claims = jwt.decode(token, key_entry, audience=OIDC_AUDIENCE or None, issuer=OIDC_ISSUER or None)
+        return True
+    except JWTError as e:
+        raise HTTPException(status_code=401, detail="token invalid")
