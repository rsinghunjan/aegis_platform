from fastapi import FastAPI, HTTPException, Request, Depends, Header
from pydantic import BaseModel
import os, time, json, logging, uuid
import httpx
from prometheus_client import Counter, Histogram
# Attempt to import LangChain; if not present, fallback to local Aegis AgentRunner
try:
    from langchain.chains import LLMChain
    from langchain.chains.qa_with_sources import load_qa_with_sources_chain
    from langchain.llms.base import LLM
    from langchain.prompts import PromptTemplate
    LANGCHAIN_AVAILABLE = True
except Exception:
    LANGCHAIN_AVAILABLE = False

# Use existing Aegis LLM adapter if LangChain not installed / for integration
from api.langchain_adapter import AegisLLM, AgentRunner

logger = logging.getLogger("langchain_runtime")
logging.basicConfig(level=logging.INFO)

REQUEST_COUNT = Counter("langchain_requests_total", "Total LangChain runtime requests", ["chain"])
REQUEST_LATENCY = Histogram("langchain_request_latency_seconds", "Latency for chain runs", ["chain"])

AEGIS_API = os.environ.get("AEGIS_API_BASE", "http://localhost:8081")
MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
A2A_API = os.environ.get("A2A_API", "http://approver:8085")
DEFAULT_MODEL = os.environ.get("AEGIS_DEFAULT_MODEL", "multimodal_demo")
DEFAULT_VERSION = os.environ.get("AEGIS_DEFAULT_MODEL_VERSION", "v1")

app = FastAPI(title="Aegis LangChain Runtime")

# import auth helper (JWT/OIDC) if present
try:
    from .auth import validate_token
except Exception:
    def validate_token(authorization: str | None = Header(default=None)):
        return True

class ChainRequest(BaseModel):
    chain_type: str = "retrieval_qa"  # retrieval_qa | graph_plan | agent
    model_id: str = DEFAULT_MODEL
    model_version: str = DEFAULT_VERSION
    input: str
    tenant_id: str | None = None
    options: dict | None = {}

# Minimal LangChain LLM wrapper that delegates to Aegis predict endpoint
class AegisLLMForLangchain(object):
    def __init__(self, api_base=None, model=None, version=None, token=None):
        # delegate to existing AegisLLM
        self.client = AegisLLM(api_base=api_base or AEGIS_API, api_token=token or "", model=model, version=version)

    def _call(self, prompt, stop=None):
        # LangChain-style call
        resp = self.client.generate(prompt)
        return resp

# helper: attach MCP context
def attach_mcp_context(model_id, model_version, run_id, extra):
    try:
        rec = {
            "model_id": model_id,
            "version": model_version,
            "artifacts": [{"uri": extra.get("artifact_uri",""), "hash": extra.get("artifact_hash","")}],
            "evaluation": {"run_id": run_id},
            "approvals": []
        }
        httpx.post(f"{MCP_API.rstrip('/')}/models/{model_id}/context", json=rec, timeout=5.0)
    except Exception as e:
        logger.warning("MCP attach failed: %s", e)

# helper: optional approval request via A2A
def maybe_request_approval(model_id, artifact_uri, requester="langchain-runtime"):
    try:
        payload = {
            "id": str(uuid.uuid4()),
            "type": "approval_request",
            "model_id": model_id,
            "artifact_uri": artifact_uri,
            "requester": requester,
            "ts": int(time.time())
        }
        httpx.post(f"{A2A_API.rstrip('/')}/request", json=payload, timeout=5.0)
    except Exception as e:
        logger.warning("A2A approval request failed: %s", e)

@app.post("/v1/chain/run")
def run_chain(req: ChainRequest, _auth: bool = Depends(validate_token), authorization: str | None = Header(default=None)):
    chain = req.chain_type
    REQUEST_COUNT.labels(chain).inc()
    start = time.time()
    run_id = str(uuid.uuid4())
    try:
        # create LLM wrapper
        if LANGCHAIN_AVAILABLE:
            llm = AegisLLMForLangchain(api_base=AEGIS_API, model=req.model_id, version=req.model_version)
            # Example: retrieval_qa uses a simple prompt chain (customize as needed)
            if req.chain_type == "retrieval_qa":
                # Call your retrieval service to get context
                try:
                    r = httpx.post(os.environ.get("AEGIS_RETRIEVAL_API", "http://retriever:8080/retrieve"), json={"q": req.input}, timeout=10.0)
                    ctx = r.json()
                    context_text = "\n".join([d.get("text","") for d in ctx.get("docs", [])])
                except Exception:
                    context_text = ""
                prompt = f"Answer the question using the context below.\n\nContext:\n{context_text}\n\nQuestion:\n{req.input}"
                if LANGCHAIN_AVAILABLE:
                    prompt_template = PromptTemplate(template=prompt, input_variables=[])
                    chain_obj = LLMChain(llm=llm, prompt=prompt_template)
                    out = chain_obj.run("")
                else:
                    out = llm._call(prompt)
            elif req.chain_type == "graph_plan":
                # Ask LangGraph or fallback planner (agent-runner) via agent
                # For simplicity, call Aegis AgentRunner if available
                ar = AgentRunner()
                out = ar.run(req.input)
            else:
                # generic agent
                ar = AgentRunner()
                out = ar.run(req.input)
        else:
            # no langchain installed: fallback to AgentRunner
            ar = AgentRunner()
            out = ar.run(req.input)

        # attach MCP context and optionally request approval
        attach_mcp_context(req.model_id, req.model_version, run_id, req.options or {})
        if (req.options or {}).get("request_approval"):
            maybe_request_approval(req.model_id, (req.options or {}).get("artifact_uri",""))

        REQUEST_LATENCY.labels(chain).observe(time.time() - start)
        return {"run_id": run_id, "result": out}
    except Exception as e:
        REQUEST_LATENCY.labels(chain).observe(time.time() - start)
        logger.exception("Chain run failed")
        raise HTTPException(status_code=500, detail=str(e))
