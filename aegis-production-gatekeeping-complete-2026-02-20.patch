+set -euo pipefail
+#
+# Rekor full restore + validation + RTO measurement script.
+#
+S3_BUCKET=${S3_BUCKET:-s3://aegis-rekor-backups}
+STAGING_DB_HOST=${STAGING_DB_HOST:-postgres-staging.rekor.svc.cluster.local}
+STAGING_DB_USER=${STAGING_DB_USER:-rekor}
+STAGING_DB_PASSWORD=${STAGING_DB_PASSWORD:-password}
+NAMESPACE=${NAMESPACE:-rekor}
+
+START_TS=$(date +%s)
+TMP="/tmp/rekor.restore.$(date +%s).dump"
+
+echo "Finding latest backup in ${S3_BUCKET}"
+LATEST=$(aws s3 ls ${S3_BUCKET}/ | sort | tail -n1 | awk '{print $4}')
+if [ -z "${LATEST}" ]; then
+  echo "No backups found in ${S3_BUCKET}"
+  exit 2
+fi
+echo "Using backup: ${LATEST}"
+
+aws s3 cp "${S3_BUCKET}/${LATEST}" "${TMP}"
+echo "Downloaded to ${TMP}"
+
+export PGPASSWORD=${STAGING_DB_PASSWORD}
+echo "Restoring into ${STAGING_DB_HOST} ..."
+pg_restore -h ${STAGING_DB_HOST} -U ${STAGING_DB_USER} -d rekor --clean "${TMP}"
+
+echo "Restarting rekor-server deployment"
+kubectl -n ${NAMESPACE} rollout restart deployment/rekor-server
+kubectl -n ${NAMESPACE} rollout status deployment/rekor-server --timeout=120s
+
+echo "Validating API: /api/v1/log/log_info"
+curl -sSk https://rekor.staging.internal/api/v1/log/log_info | jq .
+
+END_TS=$(date +%s)
+ELAPSED=$((END_TS - START_TS))
+echo "Restore complete. Total elapsed seconds: ${ELAPSED}"
+echo "Record RTO = ${ELAPSED} seconds in DR binder and document data integrity checks."
