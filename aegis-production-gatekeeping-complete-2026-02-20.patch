+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Interactive helper to capture the auditable steps required to commission HSM keys and produce dual-control artifacts.
+# Operators A and B must run the indicated steps out-of-band and produce signed approval artifacts (PGP or ticket).
+#
+WORKDIR="${WORKDIR:-/tmp/aegis-hsm}"
+mkdir -p "${WORKDIR}"
+
+echo "=== Aegis HSM Commissioning Helper ==="
+echo "Step 1: Operator A - create or import the HSM key (follow vendor docs). Save the key fingerprint."
+read -p "Enter key label you created: " KEY_LABEL
+read -p "Enter key fingerprint (hex): " KEY_FP
+echo "${KEY_FP}" > "${WORKDIR}/${KEY_LABEL}.fp"
+echo "Fingerprint stored at ${WORKDIR}/${KEY_LABEL}.fp"
+
+echo "Step 2: Operator B - verify fingerprint and create signed approval."
+echo "Operator B should independently verify the fingerprint and produce an approval artifact (PGP-signed file)."
+read -p "Enter approver id (operatorB) : " OP_B
+read -p "Enter path to approval artifact (PGP signed text) : " APPROVAL_PATH
+if [ ! -f "$APPROVAL_PATH" ]; then
+  echo "Approval artifact not found at $APPROVAL_PATH"
+  exit 2
+fi
+cp "$APPROVAL_PATH" "${WORKDIR}/${KEY_LABEL}.approval"
+echo "Approval artifact copied to ${WORKDIR}/${KEY_LABEL}.approval"
+
+echo "Step 3: Operator A - finalize activation using vendor CLI referencing approval artifact."
+echo "Example (AWS CloudHSM placeholder): cloudhsm-cli activate-key --label ${KEY_LABEL} --approval-file ${WORKDIR}/${KEY_LABEL}.approval"
+echo "After activation, test signing operation and save logs to the ticket."
+
+echo "Record artifacts into ticketing system and persist in secure evidence store (do not check into git)."
+echo "Files under ${WORKDIR}:"
+ls -la "${WORKDIR}"
