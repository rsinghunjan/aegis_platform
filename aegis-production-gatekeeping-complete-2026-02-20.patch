+#!/usr/bin/env python3
+"""
+Dual-control enforcer for enabling AUTO mode.
+Requires two signed approval artifacts (operator A, operator B) and a ticket reference.
+Writes evidence to MCP and flips the ConfigMap to AUTO (Kubernetes).
+"""
+import os, sys, json, subprocess, requests
+MCP_URL = os.environ.get("MCP_URL","http://mcp.mcp.svc.cluster.local:8000")
+CONFIGMAP_NAME = os.environ.get("AGENT_CFG","aegis-agent-control")
+NAMESPACE = os.environ.get("NAMESPACE","ml")
+
+def validate_approval(path):
+    if not os.path.exists(path):
+        raise RuntimeError(f"approval artifact {path} missing")
+    with open(path) as f:
+        txt = f.read()
+    # In production verify PGP signature & identity. Here we only check presence.
+    return txt[:200]
+
+def persist_evidence(ticket_id, op_a_art, op_b_art):
+    payload = {"schema_version":"1.1","model_id":"aegis-agent","version":"v1","notes":"dual_control_enable","llm_call":{"ticket":ticket_id,"op_a":op_a_art[:200],"op_b":op_b_art[:200]}}
+    requests.post(f"{MCP_URL}/model-context", json=payload, timeout=5)
+
+def enable_auto():
+    subprocess.run(["kubectl","-n",NAMESPACE,"patch","configmap",CONFIGMAP_NAME,"-p","{\"data\":{\"mode\":\"AUTO\"}}"], check=True)
+
+if __name__=="__main__":
+    if len(sys.argv) < 4:
+        print("Usage: dual_control_enforce.py <ticket_id> <opA_artifact_path> <opB_artifact_path>")
+        sys.exit(2)
+    ticket = sys.argv[1]
+    op_a = sys.argv[2]
+    op_b = sys.argv[3]
+    a_txt = validate_approval(op_a)
+    b_txt = validate_approval(op_b)
+    persist_evidence(ticket, a_txt, b_txt)
+    enable_auto()
+    print("AUTO mode enabled and evidence persisted.")
+
