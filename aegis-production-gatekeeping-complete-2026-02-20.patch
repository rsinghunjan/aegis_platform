+#!/usr/bin/env python3
+"""
+Import external pentest findings, create triage issues and (optionally) set a temporary block state
+that prevents enabling AUTO mode while critical/high vulnerabilities exist.
+"""
+import os, sys, json, requests
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN")
+REPO = os.environ.get("REPO","yourorg/aegis")
+API = "https://api.github.com"
+BLOCK_FILE = os.environ.get("PENTEST_BLOCK_FILE","/tmp/aegis_pentest_block.json")
+
+def create_issue(title, body, labels):
+    url = f"{API}/repos/{REPO}/issues"
+    r = requests.post(url, json={"title":title,"body":body,"labels":labels}, headers={"Authorization":f"token {GITHUB_TOKEN}"})
+    r.raise_for_status()
+    return r.json()
+
+def import_findings(path):
+    data = json.load(open(path))
+    block_required = False
+    for f in data.get("findings",[]):
+        sev = f.get("severity","medium").lower()
+        title = f"[PENTEST] {f.get('title')}"
+        body = f.get("description","")
+        labels = ["security","pentest", sev]
+        issue = create_issue(title, body, labels)
+        print("Created issue:", issue.get("html_url"))
+        if sev in ("critical","high"):
+            block_required = True
+    if block_required:
+        with open(BLOCK_FILE,"w") as f:
+            json.dump({"blocked": True, "reason": "critical/high pentest findings"}, f)
+        print("AUTO mode blocked until issues resolved. Block file:", BLOCK_FILE)
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("Usage: auto_import_and_block.py findings.json")
+        sys.exit(2)
+    import_findings(sys.argv[1])
+
