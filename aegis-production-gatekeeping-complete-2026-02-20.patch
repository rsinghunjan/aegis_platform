+"""
+Small service to record vendor DPAs / BYOK agreements and provide an enforcement API.
+ - Stores DPA metadata in a local JSON DB (replace with real DB)
+ - Provides an endpoint to assert that vendor has approved required clauses (non-training, BYOK)
+ - Adapter and Agent can call this service before making vendor calls.
+"""
+import os, json, datetime
+from flask import Flask, request, jsonify
+
+DB_FILE = os.environ.get("DPA_DB", "/data/dpa_registry.json")
+os.makedirs(os.path.dirname(DB_FILE), exist_ok=True)
+if not os.path.exists(DB_FILE):
+    with open(DB_FILE, "w") as f:
+        json.dump({}, f)
+
+app = Flask("dpa-registry")
+
+def load_db():
+    with open(DB_FILE) as f:
+        return json.load(f)
+
+def save_db(d):
+    with open(DB_FILE, "w") as f:
+        json.dump(d, f, indent=2)
+
+@app.route("/v1/register", methods=["POST"])
+def register():
+    body = request.json
+    vendor = body["vendor"]
+    entry = {
+        "vendor": vendor,
+        "dpa_signed": body.get("dpa_signed", False),
+        "dpa_url": body.get("dpa_url",""),
+        "byok_enabled": body.get("byok_enabled", False),
+        "private_endpoint": body.get("private_endpoint", False),
+        "updated_at": datetime.datetime.utcnow().isoformat()
+    }
+    db = load_db()
+    db[vendor] = entry
+    save_db(db)
+    return jsonify({"ok": True, "entry": entry})
+
+@app.route("/v1/status/<vendor>", methods=["GET"])
+def status(vendor):
+    db = load_db()
+    return jsonify(db.get(vendor, {}))
+
+@app.route("/v1/require/<vendor>", methods=["GET"])
+def require(vendor):
+    db = load_db()
+    e = db.get(vendor)
+    if not e:
+        return jsonify({"ok": False, "error": "vendor not registered"}), 404
+    if not (e.get("dpa_signed") and e.get("private_endpoint")):
+        return jsonify({"ok": False, "error": "vendor not compliant"}), 403
+    return jsonify({"ok": True})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8500")))
+
