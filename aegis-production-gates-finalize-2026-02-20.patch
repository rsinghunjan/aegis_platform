+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rekor restore automation: download latest backup, restore into staging RDS, restart Rekor, validate API and measure RTO/RPO.
+#
+S3_BUCKET=${S3_BUCKET:-s3://aegis-rekor-backups}
+STAGING_PG_HOST=${STAGING_PG_HOST:-postgres-staging.rekor.svc.cluster.local}
+STAGING_PG_USER=${STAGING_PG_USER:-rekor}
+STAGING_PG_PASSWORD=${STAGING_PG_PASSWORD:-password}
+NAMESPACE=${NAMESPACE:-rekor}
+TMP_DIR=${TMP_DIR:-/tmp/rekor_restore}
+mkdir -p "${TMP_DIR}"
+
+START_TS=$(date +%s)
+
+LATEST=$(aws s3 ls ${S3_BUCKET}/ | sort | tail -n1 | awk '{print $4}')
+if [ -z "${LATEST}" ]; then echo "No backups found"; exit 1; fi
+echo "Downloading backup: ${LATEST}"
+aws s3 cp "${S3_BUCKET}/${LATEST}" "${TMP_DIR}/${LATEST}"
+
+echo "Restoring into ${STAGING_PG_HOST}..."
+export PGPASSWORD=${STAGING_PG_PASSWORD}
+pg_restore -h ${STAGING_PG_HOST} -U ${STAGING_PG_USER} -d rekor --clean "${TMP_DIR}/${LATEST}"
+
+echo "Restarting rekor-server"
+kubectl -n ${NAMESPACE} rollout restart deployment/rekor-server
+kubectl -n ${NAMESPACE} rollout status deployment/rekor-server --timeout=120s
+
+echo "Validating API"
+RESPONSE=$(curl -sSk https://rekor.staging.internal/api/v1/log/log_info)
+echo "${RESPONSE}" | jq .
+
+END_TS=$(date +%s)
+ELAPSED=$((END_TS - START_TS))
+echo "Restore took ${ELAPSED} seconds (RTO). Document this in DR binder."
+
+# Basic RPO check: attempt to read a recently created known test entry (if you maintain one)
+echo "If you maintain test entries, validate presence; otherwise consider adding a synthetic test entry pre-backup next run for RPO measurement."
