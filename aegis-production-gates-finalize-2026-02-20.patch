+"""
+Helpers to propagate OpenTelemetry context and persist trace_id into MCP evidence bundles.
+Use these helpers in adapter, agent and MCP code paths to ensure trace correlation.
+"""
+from opentelemetry import trace
+from opentelemetry.propagate import inject
+import httpx
+import os
+
+TRACER = trace.get_tracer(__name__)
+
+def inject_trace_headers(headers: dict):
+    inject(headers)
+    return headers
+
+def current_trace_id_hex():
+    span = trace.get_current_span()
+    ctx = span.get_span_context()
+    if not ctx.trace_id:
+        return None
+    return format(ctx.trace_id, "032x")
+
+def persist_trace_in_mcp(mcp_url: str, evidence: dict):
+    """
+    Add trace_id to evidence and persist to MCP. Best-effort.
+    """
+    tid = current_trace_id_hex()
+    if tid:
+        evidence.setdefault("llm_call", {})["trace_id"] = tid
+    try:
+        httpx.post(f"{mcp_url}/model-context", json=evidence, timeout=5.0)
+    except Exception:
+        pass
+
