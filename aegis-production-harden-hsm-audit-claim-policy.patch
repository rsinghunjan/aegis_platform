+fi
+
+adduser --system --group --home /home/$USER $USER || true
+apt-get update
+apt-get install -y docker.io apt-transport-https ca-certificates curl gnupg
+# configure Docker daemon with user namespaces and seccomp
+cat > /etc/docker/daemon.json <<EOF
+{
+  "userns-remap": "default",
+  "icc": false,
+  "no-new-privileges": true
+}
+EOF
+systemctl restart docker
+
+mkdir -p /opt/actions-runner
+chown $USER:$USER /opt/actions-runner
+cd /opt/actions-runner
+RUNNER_VER="2.303.0"
