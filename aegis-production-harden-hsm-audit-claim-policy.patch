+#!/usr/bin/env python3
+"""
+LLM-based claim extraction + evidence scoring for factuality verification.
+ - Calls an LLM (via LLM_PROXY service) to extract candidate claims from a response text.
+ - For each claim, queries RAG to get supporting documents and computes embedding similarity-based support score.
+ - Returns structured verdict and per-claim support metadata.
+
+Environment:
+ - LLM_PROXY_URL (e.g., http://llm-proxy:8083) - must support /v1/chat or /v1/generate for prompt-based extraction
+ - RAG_URL (http://rag:8082)
+ - EMBEDDING_MODEL (used by RAG upstream to compute query embedding if needed)
+ - SUPPORT_THRESHOLD (0.5 default)
+"""
+import os, requests, json, time
+import numpy as np
+
+LLM_PROXY = os.environ.get("LLM_PROXY_URL", "http://llm-proxy:8083")
+RAG_URL = os.environ.get("RAG_URL", "http://rag:8082")
+SUPPORT_THRESHOLD = float(os.environ.get("SUPPORT_THRESHOLD", "0.5"))
+
+def extract_claims_with_llm(text: str) -> list:
+    """
+    Ask LLM to extract atomic factual claims from a response.
+    The prompt should instruct the model to return a JSON array of short claims.
+    """
+    prompt = f"""Extract a JSON array of atomic factual claims from the following text. Each claim should be a single short sentence.
+
+Text:
+\"\"\"{text}\"\"\"
+
+Return:
+[
+  "claim one",
+  "claim two",
+]
+"""
+    try:
+        r = requests.post(f"{LLM_PROXY.rstrip('/')}/v1/generate", json={"prompt": prompt, "max_tokens": 512}, timeout=20)
+        r.raise_for_status()
+        body = r.json() if r.headers.get("content-type","").startswith("application/json") else {"text": r.text}
+        out = body.get("text") or body.get("result") or ""
+        # try to parse JSON in output
+        try:
+            claims = json.loads(out)
+            if isinstance(claims, list):
+                return [c.strip() for c in claims if isinstance(c, str) and c.strip()]
+        except Exception:
+            # fallback: simple heuristics split sentences
+            import re
+            sents = [s.strip() for s in re.split(r'[.?!\n]+', text) if s.strip()]
+            return sents[:10]
+    except Exception:
+        # fallback
+        import re
+        sents = [s.strip() for s in re.split(r'[.?!\n]+', text) if s.strip()]
+        return sents[:10]
+
+def score_claim_with_rag(claim: str, top_k: int = 5) -> dict:
+    """
+    Use RAG service to retrieve supporting docs, then compute a pseudo-support score.
+    If RAG returns embeddings/scores, use them; otherwise treat returned hits as weak support.
+    """
+    try:
+        r = requests.post(f"{RAG_URL}/retrieve", json={"query": claim, "top_k": top_k}, timeout=6)
+        r.raise_for_status()
+        hits = r.json().get("hits", [])
+        if not hits:
+            return {"claim": claim, "support": 0.0, "evidence": []}
+        # try to use hit.score if present (assume cosine 0..1)
+        supports = []
+        for h in hits:
+            score = h.get("score")
+            meta = h.get("meta", {})
+            if score is None:
+                # try to estimate by sending embedding to LLM? skip
+                supports.append(0.2)
+            else:
+                try:
+                    val = float(score)
+                    # heuristics: if seems like distance >1 treat as inverse
+                    if val < 0:
+                        val = 0.0
+                    supports.append(min(1.0, max(0.0, val)))
+                except Exception:
+                    supports.append(0.2)
+        best = max(supports) if supports else 0.0
+        return {"claim": claim, "support": best, "evidence": hits}
+    except Exception:
+        return {"claim": claim, "support": 0.0, "evidence": []}
+
+def verify_response_llm(response_text: str, min_support_ratio: float = 0.6):
+    claims = extract_claims_with_llm(response_text)
+    scored = [score_claim_with_rag(c) for c in claims]
+    supported = [s for s in scored if s["support"] >= SUPPORT_THRESHOLD]
+    ratio = (len(supported) / len(scored)) if scored else 0.0
+    verdict = "supported" if ratio >= min_support_ratio else "hallucination"
+    return {"claims": scored, "supported": len(supported), "total": len(scored), "ratio": ratio, "verdict": verdict}
+
+if __name__ == "__main__":
+    import sys
+    txt = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
+    print(json.dumps(verify_response_llm(txt), indent=2))
+
