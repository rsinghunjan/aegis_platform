+#!/usr/bin/env python3
+"""
+Automation to prepare an audit package and send an authenticated request to an auditor.
+ - Packages artifacts (attestations, reproducibility logs, policy simulation, remediation backlog)
+ - Signs the archive with cosign (requires COSIGN_KEY_REF)
+ - Uploads to EVIDENCE_BUCKET and optionally POSTs a notification to AUDITOR_WEBHOOK with signed metadata
+"""
+import os, subprocess, tempfile, json
+from datetime import datetime
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+AUDITOR_WEBHOOK = os.environ.get("AUDITOR_WEBHOOK","")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF","")
+
+def package(paths, out="/tmp/aegis_audit_pkg.tar.gz"):
+    tmp = tempfile.mkdtemp()
+    for p in paths:
+        if os.path.exists(p):
+            subprocess.check_call(["cp","-r",p,tmp])
+    meta = {"collected_at": datetime.utcnow().isoformat(), "items": paths}
+    with open(tmp + "/meta.json","w") as fh: json.dump(meta, fh)
+    subprocess.check_call(["tar","-czf", out, "-C", tmp, "."])
+    return out
+
+def sign_and_upload(archive):
+    if COSIGN_KEY_REF:
+        subprocess.check_call(["cosign","sign","--key", COSIGN_KEY_REF, archive])
+    if EVIDENCE_BUCKET:
+        if EVIDENCE_BUCKET.startswith("s3://"):
+            subprocess.check_call(["aws","s3","cp", archive, f"{EVIDENCE_BUCKET}/audits/{os.path.basename(archive)}"])
+            return f"{EVIDENCE_BUCKET}/audits/{os.path.basename(archive)}"
+    return None
+
+def notify_auditor(uri, metadata):
+    if AUDITOR_WEBHOOK:
+        subprocess.check_call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps({"archive": uri, "metadata": metadata}), AUDITOR_WEBHOOK])
+
+if __name__=="__main__":
+    import sys
+    paths = sys.argv[1:] or ["ops/attestation","policies","ops/repro","ops/redteam"]
+    archive = package(paths)
+    uri = sign_and_upload(archive)
+    notify_auditor(uri, {"archive": uri})
+    print("Audit package prepared and notified auditor:", uri)
+
