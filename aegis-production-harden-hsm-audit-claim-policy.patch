+"""
+Populate policy engine with action-specific rules derived from the delegation matrix and expected automation mapping.
+Generates a policy catalog and a CI expectations file used by policy_full_coverage_test.py
+"""
+import yaml, json, os
+
+DELEGATION_PATH = os.environ.get("DELEGATION_MATRIX","policies/delegation_matrix.yaml")
+OUTPUT_POLICY = os.environ.get("OUTPUT_POLICY","policies/auto_policy_catalog_from_delegation.yaml")
+OUTPUT_EXPECT = os.environ.get("OUTPUT_EXPECT","policies/tests/expected_policy_coverage_generated.yaml")
+
+def load_yaml(p):
+    with open(p) as f: return yaml.safe_load(f)
+
+def main():
+    d = load_yaml(DELEGATION_PATH)
+    actions = d.get("actions", {})
+    policy = {"actions": {}}
+    expect = {"actions": {}}
+    for k, v in actions.items():
+        automation = v.get("automation","human_required")
+        # map delegation automation to a policy approval mode
+        if automation == "auto":
+            approval = "auto"
+            roles = ["automation"]
+        elif automation == "auto_with_audit":
+            approval = "auto_with_audit"
+            roles = ["automation","sre"]
+        else:
+            approval = "manual"
+            roles = v.get("required_roles", ["platform_lead"])
+        policy["actions"][k] = {"required_roles": roles, "approval": approval, "evidence_requirements": v.get("required_evidence",[])}
+        expect["actions"][k] = automation
+    os.makedirs(os.path.dirname(OUTPUT_POLICY), exist_ok=True)
+    with open(OUTPUT_POLICY, "w") as fh: yaml.safe_dump(policy, fh)
+    os.makedirs(os.path.dirname(OUTPUT_EXPECT), exist_ok=True)
+    with open(OUTPUT_EXPECT, "w") as fh: yaml.safe_dump(expect, fh)
+    print("Wrote policy:", OUTPUT_POLICY)
+    print("Wrote expected coverage:", OUTPUT_EXPECT)
+
+if __name__ == "__main__":
+    main()
