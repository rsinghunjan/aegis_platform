+/*
+Terraform template (examples) to provision KMS/HSM keys across AWS, GCP and Azure.
+This is a starting template — adapt for your org's terraform setups, state backends, IAM, and compliance controls.
+Provisioning HSM-backed keys (AWS CloudHSM / AWS KMS with multi-region keys / GCP Cloud KMS / Azure Key Vault)
+is vendor-specific and must be reviewed by your security team.
+*/
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws" }
+    google = { source = "hashicorp/google" }
+    azurerm = { source = "hashicorp/azurerm" }
+  }
+}
+
+provider "aws" {
+  region = var.aws_region
+}
+
+provider "google" {
+  project = var.gcp_project
+  region  = var.gcp_region
+}
+
+provider "azurerm" {
+  features = {}
+}
+
+variable "aws_region" { default = "us-west-2" }
+variable "gcp_project" { default = "" }
+variable "gcp_region" { default = "us-central1" }
+variable "azure_location" { default = "eastus" }
+
+############################################
+# AWS KMS CMK (example - use HSM-protected keys, enable multi-region replicas if required)
+resource "aws_kms_key" "aegis_cosign" {
+  description         = "KMS key for cosign signing - aegis"
+  deletion_window_in_days = 30
+  policy              = data.aws_iam_policy_document.kms_policy.json
+  key_usage           = "SIGN_VERIFY"
+  customer_master_key_spec = "RSA_2048"
+  # For HSM use AWS CloudHSM + AWS KMS custom key store (requires additional setup) - omitted here
+}
+
+data "aws_iam_policy_document" "kms_policy" {
+  statement {
+    principals { type = "AWS"; identifiers = ["arn:aws:iam::123456789012:role/aegis-signers"] }
+    actions = ["kms:Sign", "kms:GetPublicKey", "kms:DescribeKey"]
+    resources = ["*"]
+  }
+}
+
+resource "aws_kms_alias" "aegis_alias" {
+  name          = "alias/aegis-cosign"
+  target_key_id = aws_kms_key.aegis_cosign.key_id
+}
+
+############################################
+# GCP KMS (example)
+resource "google_kms_key_ring" "aegis_ring" {
+  name     = "aegis-keyring"
+  location = var.gcp_region
+  project  = var.gcp_project
+}
+
+resource "google_kms_crypto_key" "aegis_key" {
+  name            = "aegis-cosign"
+  key_ring        = google_kms_key_ring.aegis_ring.id
+  rotation_period = "2592000s" # 30 days as example; adjust per policy
+  lifecycle {
+    prevent_destroy = true
+  }
+}
+
+############################################
+# Azure Key Vault + Key (example)
