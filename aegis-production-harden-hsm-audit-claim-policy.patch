+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate cosign signing keys across clouds and update Vault records, then re-sign critical manifests.
+# This script is a coordinated operator-run playbook: must be executed with appropriate IAM credentials.
+#
+# ENV:
+#   VAULT_ADDR, VAULT_TOKEN required & aws/gcloud/az CLI configured
+#   COSIGN_KEY_REFS_VAULT_PATH : path in Vault to update (e.g., secret/data/aegis/keys)
+#   RE_SIGN_LIST: newline-separated list file of artifacts to re-sign (local paths or s3:// URIs)
+#
+VAULT_PATH="${VAULT_PATH:-secret/data/aegis/keys}"
+RE_SIGN_LIST="${RE_SIGN_LIST:-/tmp/re_sign_list.txt}"
+
+echo "Rotate keys playbook - manual steps required. This script will guide you."
+echo "1) Create new keys in target KMS/HSM per provider using provider consoles/CLIs."
+echo "2) Populate temporary Vault path with new key refs (do not delete old refs yet)."
+echo "3) Run re-sign for artifacts listed in $RE_SIGN_LIST to add signatures with new keys."
+
+if [ ! -f "$RE_SIGN_LIST" ]; then
+  echo "No re-sign list found at $RE_SIGN_LIST. Create file with artifact URIs to re-sign."
+  exit 2
+fi
+
+echo "Fetching key refs from Vault (operator confirmation required)"
+vault kv get -format=json "${VAULT_PATH}" || { echo "Vault read failed"; exit 1; }
+
+echo "For each artifact in $RE_SIGN_LIST, perform re-sign with the new COSIGN_KEY_REFS (from Vault)."
+while read -r ART; do
+  [ -z "$ART" ] && continue
+  echo "Processing $ART"
+  # Download artifact if remote
+  TMPDIR=$(mktemp -d)
+  if [[ "$ART" =~ ^s3:// ]]; then
+    aws s3 cp "$ART" "$TMPDIR/artifact.bin"
+    ART_LOCAL="$TMPDIR/artifact.bin"
+  elif [[ "$ART" =~ ^gs:// ]]; then
+    gsutil cp "$ART" "$TMPDIR/artifact.bin"
+    ART_LOCAL="$TMPDIR/artifact.bin"
+  else
+    ART_LOCAL="$ART"
+  fi
+  # fetch COSIGN_KEY_REFS from Vault
+  KEYS_JSON=$(vault kv get -format=json "${VAULT_PATH}" | jq -r '.data.data.cosign_key_refs // ""')
+  # call ops/hsm/multi_sign_orchestrator.py to sign with keys
+  python3 ops/hsm/multi_sign_orchestrator.py "$ART_LOCAL" "$KEYS_JSON"
+done < "$RE_SIGN_LIST"
+
+echo "Re-sign complete. Confirm verification for a sample artifact with cosign verify and Rekor entry checks."
+
