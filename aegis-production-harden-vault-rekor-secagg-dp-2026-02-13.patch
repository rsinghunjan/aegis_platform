+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Configure Vault: enable Kubernetes auth, create policies for transit & kv, create role bound to a ServiceAccount.
+# Requires: vault CLI authenticated as an operator with privileges (or run inside a pod with proper env).
+VAULT_ADDR=${VAULT_ADDR:-http://vault.aegis-system.svc.cluster.local:8200}
+ROLE_NAME=${1:-aegis-ci-role}
+K8S_SA=${2:-aegis-ci-sa}
+K8S_NAMESPACE=${3:-aegis-system}
+
+echo "Enabling kubernetes auth in Vault (if not already enabled)"
+vault auth enable kubernetes || true
+
+echo "Configuring K8s auth role ${ROLE_NAME} -> SA ${K8S_SA} in ${K8S_NAMESPACE}"
+vault write auth/kubernetes/role/${ROLE_NAME} \
+    bound_service_account_names=${K8S_SA} \
+    bound_service_account_namespaces=${K8S_NAMESPACE} \
+    policies="aegis-transit,aegis-kv" \
+    ttl="1h"
+
+echo "Creating transit policy (aegis-transit)"
+vault policy write aegis-transit - <<'POLICY'
+path "transit/*" {
+  capabilities = ["encrypt","decrypt","sign","verify","read"]
+}
+POLICY
+
+echo "Creating kv policy (aegis-kv)"
+vault policy write aegis-kv - <<'POLICY'
+path "kv/data/*" {
+  capabilities = ["create","read","update","delete","list"]
+}
+POLICY
+
+echo "Create serviceaccount ${K8S_SA} in ${K8S_NAMESPACE} and annotate for Vault Agent if desired (operator action)"
+cat <<EOF | kubectl apply -f -
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: ${K8S_SA}
+  namespace: ${K8S_NAMESPACE}
+EOF
+
+echo "Done. In production, prefer Vault Agent injector or GitHub OIDC for CI to avoid long-lived tokens."
+
