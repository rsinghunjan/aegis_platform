+#!/usr/bin/env python3
+"""
+DP integration example using IBM's diffprivlib for numeric aggregation.
+Install: pip install diffprivlib
+This demonstrates rigorous DP aggregation with epsilon parameterization.
+"""
+import numpy as np
+from diffprivlib.mechanisms import GaussianTruncated
+
+def dp_mean(values, epsilon=1.0, sensitivity=1.0):
+    # Using Gaussian mechanism (truncated) from diffprivlib as an example
+    values = np.array(values, dtype=float)
+    mean = float(np.mean(values))
+    mech = GaussianTruncated(epsilon=epsilon, delta=1e-5, sensitivity=sensitivity)
+    noisy = mech.randomise(mean)
+    return noisy
+
+if __name__ == "__main__":
+    import sys
+    vals = [float(x) for x in sys.argv[1].split(",")] if len(sys.argv)>1 else [0.1,0.2,0.3]
+    print(dp_mean(vals, epsilon=0.5))
+
