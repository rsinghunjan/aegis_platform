+#!/usr/bin/env python3
+"""
+Advanced SLO reporter:
+ - Queries Prometheus for SLO metrics
+ - Computes burn rates and posts summary to MCP and triggers escalation via Alertmanager webhook / PagerDuty
+"""
+import os, requests, time, json
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK", "")
+
+def query(q):
+    r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": q}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def report():
+    q = 'job:webhook:error_ratio:ratio5m'
+    v = 0.0
+    try:
+        r = query(q)
+        v = float(r.get("data", {}).get("result", [])[0]["value"][1]) if r.get("data", {}).get("result") else 0.0
+    except Exception:
+        v = -1.0
+    payload = {"slo":"webhook_error_ratio","value": v, "ts": time.time()}
+    try:
+        requests.post(f"{MCP_API.rstrip('/')}/observability/slo", json=payload, timeout=5.0)
+    except Exception:
+        pass
+    if v > 0.05 and ALERT_WEBHOOK:
+        try:
+            requests.post(ALERT_WEBHOOK, json={"summary":"SLO breach","value":v}, timeout=3.0)
+        except Exception:
+            pass
+
+if __name__ == "__main__":
+    report()
+
