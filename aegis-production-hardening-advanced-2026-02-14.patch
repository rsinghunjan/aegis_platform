+"""
+Example Kafka consumer that receives MCP events and calls Gatekeeper or n8n.
+Requires confluent-kafka Python.
+"""
+from confluent_kafka import Consumer, KafkaError
+import os, requests, json
+
+KAFKA_BOOTSTRAP = os.environ.get("KAFKA_BOOTSTRAP_SERVERS","kafka.bootstrap.svc:9092")
+TOPIC = os.environ.get("KAFKA_TOPIC","mcp-events")
+GROUP = os.environ.get("KAFKA_GROUP","gatekeeper-subscriber")
+GATEKEEPER_API = os.environ.get("GATEKEEPER_API","http://gatekeeper.k8s.svc")
+
+consumer = Consumer({
+    'bootstrap.servers': KAFKA_BOOTSTRAP,
+    'group.id': GROUP,
+    'auto.offset.reset': 'earliest'
+})
+consumer.subscribe([TOPIC])
+
+def handle_message(msg):
+    try:
+        payload = json.loads(msg.value().decode())
+        # Example: if model promoted -> call gatekeeper to refresh policy or annotate
+        if payload.get("event") == "model_context.upsert":
+            model_id = payload.get("model_id")
+            # call Gatekeeper or other system as needed
+            requests.post(f"{GATEKEEPER_API}/refresh", json={"model_id": model_id}, timeout=5)
+    except Exception as e:
+        print("handle error", e)
+
+try:
+    while True:
+        msg = consumer.poll(1.0)
+        if msg is None:
+            continue
+        if msg.error():
+            if msg.error().code() == KafkaError._PARTITION_EOF:
+                continue
+            else:
+                print("Consumer error: {}".format(msg.error()))
+                break
+        handle_message(msg)
+except KeyboardInterrupt:
+    pass
+finally:
+    consumer.close()
