+#!/usr/bin/env python3
+"""
+Orchestrate a rollback drill across a simulated fleet:
+ - publish rollback manifest to OTA server
+ - poll device status endpoints and verify they switched back
+ - measure time to rollback for SLA reporting
+"""
+import requests, time, os, json
+
+OTA_SERVER = os.environ.get("OTA_SERVER","https://ota.internal")
+DEVICES = os.environ.get("DEVICE_LIST","testbed-1,testbed-2").split(",")
+ROLLBACK_MANIFEST_URL = os.environ.get("ROLLBACK_MANIFEST_URL","https://ota.internal/manifests/rollback.json")
+
+def publish_rollback(manifest_url):
+    r = requests.post(f"{OTA_SERVER}/admin/publish", json={"manifest": manifest_url}, timeout=5)
+    r.raise_for_status()
+    return r.json()
+
+def poll_devices(timeout_minutes=30):
+    start = time.time()
+    deadline = start + timeout_minutes*60
+    statuses = {d: False for d in DEVICES}
+    while time.time() < deadline:
+        for d in DEVICES:
+            try:
+                r = requests.get(f"{OTA_SERVER}/devices/{d}/status", timeout=3)
+                r.raise_for_status()
+                s = r.json().get("current_manifest")
+                if "rollback" in s:
+                    statuses[d] = True
+            except Exception:
+                pass
+        if all(statuses.values()):
+            return True, time.time()-start
+        time.sleep(5)
+    return False, time.time()-start
+
+if __name__ == "__main__":
+    print("Publishing rollback manifest...")
+    publish_rollback(ROLLBACK_MANIFEST_URL)
+    ok, elapsed = poll_devices()
+    if ok:
+        print(f"All devices rolled back in {elapsed} seconds")
+    else:
+        print(f"Rollback incomplete after {elapsed} seconds")
+
