+"""
+Flower custom strategy with trimmed-mean aggregation to improve robustness to poison.
+This replaces naive FedAvg prototype.
+"""
+from typing import List, Tuple, Optional
+import flwr as fl
+import numpy as np
+
+def trimmed_mean(weights_list: List[np.ndarray], trim_fraction: float = 0.1):
+    # weights_list: list of 1D arrays or flattened arrays
+    arr = np.stack(weights_list, axis=0)
+    n = arr.shape[0]
+    k = int(np.floor(trim_fraction * n))
+    if k == 0:
+        return np.mean(arr, axis=0)
+    arr_sorted = np.sort(arr, axis=0)
+    trimmed = arr_sorted[k:n-k,:,:] if arr.ndim==3 else arr_sorted[k:n-k,:]
+    return np.mean(trimmed, axis=0)
+
+class RobustFedAvg(fl.server.strategy.FedAvg):
+    def aggregate_fit(self, rnd, results, failures):
+        # results: List[Tuple[ClientProxy, FitRes]]
+        if not results:
+            return None
+        # extract params as numpy arrays
+        weights = [fl.common.parameters_to_ndarrays(r[1].parameters) for r in results]
+        # simple per-parameter trimmed mean
+        agg = []
+        for i in range(len(weights[0])):
+            layer_stack = [w[i] for w in weights]
+            agg_layer = trimmed_mean(layer_stack, trim_fraction=0.15)
+            agg.append(agg_layer)
+        return fl.common.ndarrays_to_parameters(agg)
+
