+#!/usr/bin/env bash
+set -euo pipefail
+CMD=${1:-backup}
+S3_BUCKET=${S3_BUCKET:-"s3://aegis-rekor-backups"}
+DUMP_FILE="/tmp/rekor-$(date +%F-%s).dump"
+
+if [ "$CMD" = "backup" ]; then
+  echo "Performing pg_dump to ${DUMP_FILE}"
+  pg_dump -h "${POSTGRES_HOST}" -U "${POSTGRES_USER}" -Fc -f "${DUMP_FILE}" rekor
+  echo "Uploading to ${S3_BUCKET}"
+  aws s3 cp "${DUMP_FILE}" "${S3_BUCKET}/"
+  echo "Backup complete"
+elif [ "$CMD" = "restore" ]; then
+  FILE=${2:-}
+  if [ -z "${FILE}" ]; then
+    echo "Usage: $0 restore <s3-uri-to-dump>"
+    exit 2
+  fi
+  echo "Downloading ${FILE}"
+  aws s3 cp "${FILE}" /tmp/rekor.restore.dump
+  echo "Restoring to database (postgres)"
+  pg_restore -h "${POSTGRES_HOST}" -U "${POSTGRES_USER}" -d rekor /tmp/rekor.restore.dump
+  echo "Restore complete"
+else
+  echo "Unknown command: ${CMD}"
+  exit 2
+fi
