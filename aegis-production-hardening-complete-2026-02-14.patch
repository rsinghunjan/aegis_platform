+#!/usr/bin/env python3
+"""
+Post-aggregation DP harness example (Gaussian mechanism).
+In production, use established libraries and tune epsilon/delta and sensitivity.
+"""
+import numpy as np, json, sys
+
+def dp_gaussian(aggregate, epsilon=1.0, sensitivity=1.0):
+    sigma = sensitivity / epsilon
+    noise = np.random.normal(0, sigma, size=np.array(aggregate).shape)
+    return (np.array(aggregate) + noise).tolist()
+
+if __name__ == "__main__":
+    agg = json.loads(sys.argv[1]) if len(sys.argv) > 1 else [0.0]*10
+    print(json.dumps({"dp_agg": dp_gaussian(agg, epsilon=0.5)}))
+
