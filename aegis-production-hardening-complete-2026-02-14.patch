+#!/usr/bin/env python3
+"""
+Hardened pre-load verifier:
+ - verifies cosign signature (calls cosign)
+ - verifies Rekor entry
+ - performs TPM2 quote verification placeholder (requires tpm2-tools or vendor attestation)
+ - supports caching of recent verified artifacts for offline speed
+"""
+import os, subprocess, requests, json, hashlib, time
+
+REKOR_URL = os.environ.get("REKOR_URL","https://rekor.aegis.example.com")
+CACHE_DIR = os.environ.get("VERIFIER_CACHE","/var/cache/aegis_verifier")
+os.makedirs(CACHE_DIR, exist_ok=True)
+
+def verify_cosign(artifact, key="public.pem"):
+    try:
+        subprocess.run(["cosign","verify","--key", key, artifact], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        return True
+    except Exception as e:
+        print("cosign verify failed:", e)
+        return False
+
+def verify_rekor_index(index):
+    try:
+        r = requests.get(f"{REKOR_URL}/api/v1/log/entries?logIndex={index}", timeout=5)
+        return r.ok and bool(r.json())
+    except Exception as e:
+        print("rekor query failed:", e)
+        return False
+
+def verify_tpm_quote():
+    # Placeholder: integrate with tpm2-tools or vendor SDK to verify quote against known AI device key
+    # Example: run tpm2_quote and verify signature via a verifier service
+    return True
+
+def cache_verified(artifact_digest):
+    path = os.path.join(CACHE_DIR, artifact_digest)
+    with open(path,"w") as f:
+        f.write(str(int(time.time())))
+
+def is_cached(artifact_digest, ttl=3600):
+    path = os.path.join(CACHE_DIR, artifact_digest)
+    if not os.path.exists(path):
+        return False
+    age = int(time.time()) - int(open(path).read())
+    return age < ttl
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path,"rb") as f:
+        h.update(f.read())
+    return h.hexdigest()
+
+def main(artifact, manifest):
+    digest = sha256(artifact)
+    if is_cached(digest):
+        print("Artifact cached as verified")
+        return 0
+    m = json.load(open(manifest))
+    att = m.get("attestation",{}) or {}
+    rekor_idx = att.get("rekorIndex") or att.get("rekor_index")
+    if not verify_cosign(artifact):
+        print("cosign verification failed")
+        return 2
+    if not verify_rekor_index(rekor_idx):
+        print("rekor verification failed")
+        return 3
+    if not verify_tpm_quote():
+        print("tpm quote verification failed")
+        return 4
+    cache_verified(digest)
+    print("Pre-load verification passed")
+    return 0
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("usage: preload_verifier_hardened.py <artifact> <manifest>")
+        sys.exit(1)
+    sys.exit(main(sys.argv[1], sys.argv[2]))
+
