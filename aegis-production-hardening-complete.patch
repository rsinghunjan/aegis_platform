+#!/usr/bin/env python3
+"""
+FastAPI service to record and query human approvals for high-risk actions.
+ - POST /approve { action_name, note, ttl_seconds }  - requires auth and approver claim
+ - GET  /approvals[?action_name=...] - list approvals
+
+This service is lightweight and intended to run behind the cluster ingress, authenticated via OIDC.
+"""
+import uvicorn
+from fastapi import FastAPI, HTTPException, Depends
+from pydantic import BaseModel
+from typing import Optional
+from ops.approvals import db as approvals_db
+from ops.langgraph.server import verify_jwt_creds  # reuse JWT verification
+
+app = FastAPI(title="Aegis Approvals Service")
+
+class ApproveRequest(BaseModel):
+    action_name: str
+    note: Optional[str] = None
+    ttl_seconds: Optional[int] = None
+
+@app.post("/approve")
+def approve(req: ApproveRequest, payload=Depends(verify_jwt_creds)):
+    # payload from JWT may have 'preferred_username' or 'email'
+    approver = "unknown"
+    if isinstance(payload, dict):
+        approver = payload.get("preferred_username") or payload.get("email") or payload.get("sub") or approver
+    if not approvals_db.add_approval(req.action_name, approver, note=req.note, ttl_seconds=req.ttl_seconds):
+        raise HTTPException(status_code=500, detail="failed to add approval")
+    return {"ok": True, "action": req.action_name, "approver": approver}
+
+@app.get("/approvals")
+def get_approvals(action_name: Optional[str] = None, payload=Depends(verify_jwt_creds)):
+    items = approvals_db.list_approvals(action_name)
+    return {"approvals": items}
+
+if __name__ == "__main__":
+    uvicorn.run(app, host="0.0.0.0", port=8090)
+
