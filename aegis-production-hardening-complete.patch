+#!/usr/bin/env python3
+"""
+Database helper for approvals.
+ - Uses DATABASE_URL if present (Postgres).
+ - Exposes: is_action_approved(action_name), add_approval(...), list_approvals(...)
+"""
+import os
+import json
+from typing import Optional, List, Dict, Any
+
+USE_POSTGRES = bool(os.environ.get("DATABASE_URL"))
+
+if USE_POSTGRES:
+    import psycopg2
+    from psycopg2.extras import RealDictCursor
+
+def _pg_conn():
+    return psycopg2.connect(os.environ["DATABASE_URL"])
+
+def is_action_approved(action_name: str) -> bool:
+    """
+    Return True if there's a non-expired approval for action_name.
+    Exact match or substring match considered.
+    """
+    if not USE_POSTGRES:
+        return False
+    q = """
+    SELECT 1 FROM approvals
+    WHERE (action_name = %s OR %s LIKE ('%' || action_name || '%'))
+      AND (expires_at IS NULL OR expires_at > extract(epoch from now()))
+    LIMIT 1
+    """
+    conn = _pg_conn()
+    cur = conn.cursor()
+    cur.execute(q, (action_name, action_name))
+    r = cur.fetchone()
+    cur.close()
+    conn.close()
+    return bool(r)
+
+def add_approval(action_name: str, approver: str, note: Optional[str] = None, ttl_seconds: Optional[int] = None, metadata: Optional[Dict[str,Any]] = None):
+    if not USE_POSTGRES:
+        raise RuntimeError("Postgres not configured (DATABASE_URL)")
+    expires = None
+    if ttl_seconds:
+        import time
+        expires = time.time() + int(ttl_seconds)
+    conn = _pg_conn()
+    cur = conn.cursor()
+    cur.execute(
+        "INSERT INTO approvals(action_name, approver, note, created_at, expires_at, metadata) VALUES (%s,%s,%s,extract(epoch from now()),%s,%s)",
+        (action_name, approver, note or "", expires, json.dumps(metadata or {}))
+    )
+    conn.commit()
+    cur.close()
+    conn.close()
+    return True
+
+def list_approvals(action_name: Optional[str] = None) -> List[Dict[str,Any]]:
+    if not USE_POSTGRES:
+        return []
+    conn = _pg_conn()
+    cur = conn.cursor(cursor_factory=RealDictCursor)
+    if action_name:
+        cur.execute("SELECT * FROM approvals WHERE action_name = %s ORDER BY created_at DESC", (action_name,))
+    else:
+        cur.execute("SELECT * FROM approvals ORDER BY created_at DESC LIMIT 100")
+    rows = cur.fetchall()
+    cur.close()
+    conn.close()
+    return [dict(r) for r in rows]
+
