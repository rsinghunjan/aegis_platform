+#!/usr/bin/env bash
+set -euo pipefail
+# Simple Postgres backup script: pg_dump -> gz -> aws s3 cp
+# Requires: DATABASE_URL env, AWS CLI configured (or customize).
+if [ -z "${DATABASE_URL:-}" ]; then
+  echo "DATABASE_URL not set"; exit 2
+fi
+OUT_DIR=${OUT_DIR:-/tmp}
+TS=$(date -u +"%Y%m%dT%H%M%SZ")
+OUT_FILE="${OUT_DIR}/langgraph-backup-${TS}.sql.gz"
+echo "Dumping DB to ${OUT_FILE}"
+pg_dump "$DATABASE_URL" | gzip > "$OUT_FILE"
+if [ -n "${S3_URI:-}" ]; then
+  echo "Uploading to S3 ${S3_URI}"
+  aws s3 cp "$OUT_FILE" "$S3_URI"
+fi
+echo "Backup complete: $OUT_FILE"
+
