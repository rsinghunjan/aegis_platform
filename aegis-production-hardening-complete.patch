+#!/usr/bin/env python3
+"""
+Assemble an auditor-ready bundle:
+ - collect TLA+/Apalache/TLC logs, model↔code mapping, signed evidence manifests, and CI artifacts
+ - produce a tar.gz for transfer to auditors
+"""
+import tarfile
+from pathlib import Path
+import os
+ARTIFACTS = [
+    "docs/formal",
+    "ops/formal",
+    "evidence",  # local evidence dir if present
+    "ops/autonomy/generate_auditor_zip.py",
+]
+
+OUT = os.environ.get("AUDIT_BUNDLE_OUT", "/tmp/aegis_audit_bundle.tar.gz")
+
+def collect_files(tar_path=OUT):
+    with tarfile.open(tar_path, "w:gz") as tf:
+        for p in ARTIFACTS:
+            pp = Path(p)
+            if pp.exists():
+                tf.add(str(pp), arcname=str(pp))
+    print("Audit bundle written to", OUT)
+
+if __name__=="__main__":
+    collect_files()
+
