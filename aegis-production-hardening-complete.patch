+#!/usr/bin/env python3
+"""
+CLI helper to call approvals service or write a fallback local approval.
+Usage:
+  python3 ops/approvals/cli.py approve --action promote_model_to_prod --note "security ok" --ttl 86400 --service http://approvals.svc.cluster.local:8090
+"""
+import argparse
+import requests
+import os
+import json
+from getpass import getpass
+
+def approve_via_service(url, action, note=None, ttl=None, token=None):
+    headers = {}
+    if token:
+        headers["Authorization"] = f"Bearer {token}"
+    resp = requests.post(f"{url.rstrip('/')}/approve", json={"action_name": action, "note": note, "ttl_seconds": ttl}, headers=headers)
+    print(resp.status_code, resp.text)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("cmd", choices=["approve"])
+    p.add_argument("--action", required=True)
+    p.add_argument("--note")
+    p.add_argument("--ttl", type=int)
+    p.add_argument("--service", default=os.environ.get("APPROVALS_SERVICE","http://localhost:8090"))
+    p.add_argument("--token", default=os.environ.get("APPROVALS_TOKEN"))
+    args = p.parse_args()
+    if args.cmd == "approve":
+        tok = args.token
+        if not tok:
+            tok = getpass("Approval bearer token (paste): ")
+        approve_via_service(args.service, args.action, note=args.note, ttl=args.ttl, token=tok)
+
+if __name__=="__main__":
+    main()
+
