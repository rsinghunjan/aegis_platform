+if [ -n "$KEY_ID" ] && [ "$KEY_ID" != "None" ]; then
+  aws kms describe-key --key-id "$KEY_ID" --output json
+else
+  echo "Alias ${TARGET_ALIAS} not found in this account."
+  exit 2
