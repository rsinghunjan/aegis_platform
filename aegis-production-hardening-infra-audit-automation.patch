+#!/usr/bin/env bash
+#
+# Collect node & workload attestations, sign and upload to evidence S3 and Rekor.
+#
+set -euo pipefail
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-}
+OUT="/tmp/aegis_attestation_$(date +%s).tar.gz"
+TMPDIR=$(mktemp -d)
+
+echo "Collecting attestations..."
+python3 - <<PY
+import json, time, os, subprocess
+att = {"ts": int(time.time())}
+try:
+    out = subprocess.check_output(["kubectl","get","nodes","-o","json"])
+    att["nodes_json_len"] = len(out)
+except Exception:
+    att["nodes_json_len"] = 0
+open(os.path.join("$TMPDIR","attestation.json"),"w").write(json.dumps(att))
+PY
+
+tar -czf "$OUT" -C "$TMPDIR" .
+echo "Attestation bundle: $OUT"
+
+if [ -n "$COSIGN_KMS_URI" ]; then
+  cosign sign-blob --key "$COSIGN_KMS_URI" "$OUT" || true
+fi
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  aws s3 cp "$OUT" "s3://${EVIDENCE_BUCKET%/}/attestations/$(basename $OUT)" || true
+fi
+if command -v rekor-cli >/dev/null 2>&1; then
+  rekor-cli upload --artifact "$OUT" || true
+fi
+echo "Attestation uploaded and (best-effort) registered with Rekor."
+
