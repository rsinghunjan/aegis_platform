+
+echo "Create a SecretProviderClass example for Vault (operator must configure auth method separately)"
+cat <<'YAML' > /tmp/secretproviderclass.yaml
+apiVersion: secrets-store.csi.x-k8s.io/v1
+kind: SecretProviderClass
+metadata:
+  name: vault-aegis
+spec:
+  provider: vault
+  parameters:
+    vaultAddress: "https://vault.default.svc.cluster.local"
+YAML
+
+kubectl apply -f /tmp/secretproviderclass.yaml
+echo "Vault + CSI installed (dev mode). Configure production Vault and auth methods per documentation."
