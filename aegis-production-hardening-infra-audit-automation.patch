+#!/usr/bin/env python3
+"""
+Patch Helm-rendered manifests (or raw manifests) to inject Vault CSI, mTLS and network policies,
+then apply them to the cluster. Operators must review diffs before running in production.
+
+Usage:
+  python3 ops/helm/patch_and_apply_all.py --manifests rendered/ --out patched/ --apply
+"""
+import argparse, os, yaml, subprocess
+from pathlib import Path
+
+def patch_manifest_file(path, outdir):
+    docs = list(yaml.safe_load_all(Path(path).read_text()))
+    modified = False
+    for d in docs:
+        if not isinstance(d, dict): continue
+        kind = d.get("kind","")
+        if kind in ("Deployment","StatefulSet","DaemonSet"):
+            spec = d.setdefault("spec",{})
+            tpl = spec.setdefault("template",{})
+            pod = tpl.setdefault("spec",{})
+            vols = pod.setdefault("volumes", [])
+            vols.append({"name":"vault-csi","csi":{"driver":"secrets-store.csi.k8s.io","readOnly":True,"volumeAttributes":{"secretProviderClass":"vault-aegis"}}})
+            vols.append({"name":"mtls-secret","secret":{"secretName":"crypten-mtls"}})
+            for c in pod.get("containers",[]):
+                mounts = c.setdefault("volumeMounts",[])
+                mounts.append({"name":"vault-csi","mountPath":"/mnt/secrets"})
+                mounts.append({"name":"mtls-secret","mountPath":"/etc/tls","readOnly":True})
+            meta = d.setdefault("metadata",{})
+            ann = meta.setdefault("annotations",{})
+            ann["sidecar.istio.io/inject"] = "true"
+            modified = True
+    outp = Path(outdir) / Path(path).name
+    Path(outdir).mkdir(parents=True, exist_ok=True)
+    Path(outp).write_text("\n---\n".join(yaml.safe_dump(d) for d in docs))
+    return modified
+
+def apply_manifest(path):
+    subprocess.check_call(["kubectl","apply","-f", path])
+
+def main(manifests_dir, out_dir, do_apply=False):
+    for root,_,files in os.walk(manifests_dir):
+        for f in files:
+            if f.endswith((".yaml",".yml")):
+                p = os.path.join(root,f)
+                patch_manifest_file(p, out_dir)
+    print("Patched manifests written to", out_dir)
+    if do_apply:
+        for root,_,files in os.walk(out_dir):
+            for f in files:
+                fp = os.path.join(root,f)
+                print("Applying", fp)
+                apply_manifest(fp)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--manifests", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--apply", action="store_true")
+    args = p.parse_args()
+    main(args.manifests, args.out, args.apply)
+
