+#!/usr/bin/env bash
+#
+# Close audit findings by uploading remediation evidence (signed) and marking issues via GitHub new comment/close (uses gh).
+#
+set -euo pipefail
+FINDINGS_JSON=${1:-}
+if [ -z "$FINDINGS_JSON" ]; then
+  echo "Usage: $0 findings.json"
+  exit 2
+fi
+
+echo "Creating remediation issues for audit findings..."
+python3 - <<PY
+import json, os, requests, sys, subprocess
+f = "$FINDINGS_JSON"
+j = json.load(open(f))
+for fin in j.get("findings",[]):
+    title = "[AUDIT][REMEDIATION] "+fin.get("title","untitled")
+    body = fin.get("remediation","") + "\n\nEvidence will be uploaded to evidence S3 and registered with Rekor."
+    # use GitHub CLI to create issue
+    subprocess.check_call(["gh","issue","create","--title",title,"--body",body,"--label","audit","remediation"])
+print("Created issues for findings.")
+PY
+
+echo "Operator: implement remediation, then run ops/audit/mark_remediated.sh <issue-number> <evidence-path>"
+
