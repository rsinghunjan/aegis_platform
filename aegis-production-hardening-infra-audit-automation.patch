+#!/usr/bin/env bash
+#
+# Deploy Rekor to your Kubernetes cluster using the official Helm chart (best-practice for self-host).
+# This script is a convenience wrapper — operators should review values and certs.
+#
+set -euo pipefail
+RELEASE_NAME=${1:-rekor}
+NAMESPACE=${2:-rekor}
+VALUES_FILE=${3:-/tmp/rekor-values.yaml}
+
+cat > "$VALUES_FILE" <<EOF
+server:
+  service:
+    type: ClusterIP
+  resources:
+    requests:
+      cpu: "100m"
+      memory: "256Mi"
+    limits:
+      cpu: "500m"
+      memory: "512Mi"
+persistence:
+  enabled: true
+  size: 1Gi
+EOF
+
+kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -
+helm repo add sigstore https://sigstore.github.io/helm-charts || true
+helm repo update
+helm upgrade --install "$RELEASE_NAME" sigstore/rekor --namespace "$NAMESPACE" -f "$VALUES_FILE"
+
+echo "Rekor deployed to namespace $NAMESPACE. Set REKOR_SERVER to http://<service>:3000 or use ingress."
+
