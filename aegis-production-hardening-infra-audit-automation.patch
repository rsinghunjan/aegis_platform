+#!/usr/bin/env bash
+#
+# Package MPC artifacts for external crypto audit, sign the package, upload to evidence S3 and register to Rekor.
+#
+set -euo pipefail
+
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+OUT_DIR=${1:-/tmp/mpc_audit_package}
+TS=$(date +%s)
+TARBALL="${OUT_DIR}_${TS}.tar.gz"
+
+mkdir -p "$OUT_DIR"
+
+echo "Collecting MPC artifacts..."
+cp -r ops/secure_agg/production_mpc "$OUT_DIR/production_mpc" 2>/dev/null || true
+cp ops/secure_agg/production_mpc/audit/generate_test_vectors.py "$OUT_DIR/" 2>/dev/null || true
+cp ops/secure_agg/production_mpc/enhanced_coordinator.py "$OUT_DIR/" 2>/dev/null || true
+cp ops/secure_agg/production_mpc/shamir_integration.py "$OUT_DIR/" 2>/dev/null || true
+
+echo "Including deterministic test vectors..."
+python3 ops/secure_agg/production_mpc/audit/generate_test_vectors.py || true
+cp /tmp/mpc_audit_vectors.json "$OUT_DIR/" 2>/dev/null || true
+
+echo "Creating tarball..."
+tar -czf "$TARBALL" -C "$(dirname "$OUT_DIR")" "$(basename "$OUT_DIR")"
+echo "Tarball: $TARBALL"
+
+if [ -n "${COSIGN_KMS_URI:-}" ]; then
+  echo "Signing with cosign (KMS)..."
+  cosign sign-blob --key "${COSIGN_KMS_URI}" "$TARBALL" || echo "cosign sign failed"
+fi
+
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  echo "Uploading to s3://${EVIDENCE_BUCKET%/}/audit/mpc/"
+  aws s3 cp "$TARBALL" "s3://${EVIDENCE_BUCKET%/}/audit/mpc/$(basename $TARBALL)"
+fi
+
+# Rekor registration (best-effort)
+if command -v rekor-cli >/dev/null 2>&1; then
+  echo "Registering tarball with Rekor..."
+  rekor-cli upload --artifact "$TARBALL" || echo "rekor upload failed"
+else
+  echo "rekor-cli not present; use ops/evidence/register_rekor.py if available"
+fi
+
+echo "Prepared MPC audit package: $TARBALL"
