+#!/usr/bin/env python3
+"""
+Fetch carbon intensity from CO2Signal and write a small metric file for Prometheus node_textfile collector.
+Requires CO2SIGNAL_API_KEY env var.
+"""
+import os, requests, json, time
+
+API_KEY = os.environ.get("CO2SIGNAL_API_KEY","")
+OUT_DIR = os.environ.get("PROM_TEXT_DIR","/var/lib/node_exporter/textfile_collector")
+
+def get_carbon(country="US"):
+    if not API_KEY:
+        raise RuntimeError("CO2SIGNAL_API_KEY not set")
+    r = requests.get("https://api.co2signal.com/v1/latest", params={"countryCode": country}, headers={"auth-token":API_KEY}, timeout=10)
+    r.raise_for_status()
+    return r.json().get("data",{})
+
+def write_metric(job_id, est):
+    os.makedirs(OUT_DIR, exist_ok=True)
+    path = os.path.join(OUT_DIR, f"carbon_job_{job_id}.prom")
+    with open(path,"w") as fh:
+        fh.write("# HELP aegis_job_co2e_estimate Estimated CO2e grams for job\n")
+        fh.write("# TYPE aegis_job_co2e_estimate gauge\n")
+        fh.write(f'aegis_job_co2e_estimate{{job="{job_id}"}} {est}\n')
+    print("Wrote", path)
+
+if __name__=="__main__":
+    import sys
+    country = sys.argv[1] if len(sys.argv)>1 else "US"
+    job_id = f"co2-{int(time.time())}"
+    data = get_carbon(country)
+    ci = data.get("carbonIntensity", 0)
+    est = ci * 10.0
+    write_metric(job_id, est)
+    print("Carbon intensity", ci)
+
