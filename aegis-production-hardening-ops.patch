+#!/usr/bin/env python3
+"""
+Extended schema registry:
+ - supports versioning and basic compatibility check (backward/forward naive)
+ - simple token-based RBAC via ADMIN_TOKEN env var for write operations
+"""
+from fastapi import FastAPI, HTTPException, Header
+from pydantic import BaseModel
+from pathlib import Path
+import json
+import os
+
+BASE = Path("config/schemas_v2")
+BASE.mkdir(parents=True, exist_ok=True)
+ADMIN_TOKEN = os.environ.get("SCHEMA_ADMIN_TOKEN")
+
+app = FastAPI(title="Aegis Schema Registry v2")
+
+class SchemaIn(BaseModel):
+    name: str
+    version: int
+    schema: dict
+    compatibility: str = "backward"  # naive: "backward" or "none"
+
+def _schema_file(name, version):
+    return BASE / f"{name}_v{version}.json"
+
+def _latest_version(name):
+    files = sorted(BASE.glob(f"{name}_v*.json"))
+    if not files:
+        return 0
+    return int(files[-1].stem.split("_v")[-1])
+
+def _compatible(new_schema, old_schema, mode="backward"):
+    # Naive compatibility: ensure all fields in old are present in new for backward
+    if mode=="none":
+        return True
+    old_fields = set(old_schema.get("properties",{}).keys())
+    new_fields = set(new_schema.get("properties",{}).keys())
+    return old_fields.issubset(new_fields)
+
+@app.post("/schema")
+def add_schema(s: SchemaIn, authorization: str = Header(None)):
+    if ADMIN_TOKEN:
+        if not authorization or not authorization.startswith("Bearer ") or authorization.split(" ",1)[1] != ADMIN_TOKEN:
+            raise HTTPException(status_code=403, detail="admin token required")
+    latest = _latest_version(s.name)
+    if s.version <= latest:
+        raise HTTPException(status_code=400, detail="version must be greater than latest")
+    if latest > 0 and not _compatible(s.schema, json.loads(_schema_file(s.name, latest).read_text()), s.compatibility):
+        raise HTTPException(status_code=409, detail="compatibility check failed")
+    p = _schema_file(s.name, s.version)
+    p.write_text(json.dumps(s.schema, indent=2))
+    return {"ok":True}
+
+@app.get("/schema/{name}/{version}")
+def get_schema(name: str, version: int):
+    p = _schema_file(name, version)
+    if not p.exists():
+        raise HTTPException(status_code=404, detail="not found")
+    return json.loads(p.read_text())
+
+if __name__=="__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=8101)
+
