+#!/usr/bin/env python3
+"""
+Retrain trigger that polls Prometheus for drift metric and triggers an Argo workflow via its API.
+Requires PROM_URL and ARGO_SERVER (with token).
+"""
+import os, time, requests, json
+PROM_URL = os.environ.get("PROM_URL")
+DRIFT_QUERY = os.environ.get("DRIFT_QUERY","max_over_time(model_drift_kl[1h])")
+THRESHOLD = float(os.environ.get("DRIFT_THRESHOLD","0.5"))
+ARGO_SERVER = os.environ.get("ARGO_SERVER")
+ARGO_TOKEN = os.environ.get("ARGO_TOKEN")
+WORKFLOW_TEMPLATE = os.environ.get("RETRAIN_WORKFLOW","aegis-retrain")
+
+def query_prom(query):
+    r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": query}, timeout=5)
+    r.raise_for_status()
+    j = r.json()
+    try:
+        v = float(j["data"]["result"][0]["value"][1])
+        return v
+    except Exception:
+        return 0.0
+
+def trigger_retrain():
+    url = f"{ARGO_SERVER}/api/v1/workflows/aegis/submit"
+    headers = {"Authorization": f"Bearer {ARGO_TOKEN}", "Content-Type":"application/json"}
+    payload = {"template": WORKFLOW_TEMPLATE, "parameters":{}}
+    r = requests.post(url, headers=headers, json=payload, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+if __name__=="__main__":
+    while True:
+        try:
+            v = query_prom(DRIFT_QUERY)
+            print("Drift metric:", v)
+            if v > THRESHOLD:
+                print("Drift exceeded; triggering retrain")
+                r = trigger_retrain()
+                print("Triggered:", r)
+            else:
+                print("Within threshold")
+        except Exception as e:
+            print("Error querying Prometheus or triggering retrain:", e)
+        time.sleep(int(os.environ.get("TRIGGER_INTERVAL", "300")))
+
