+#!/usr/bin/env python3
+"""
+Canary promotion automation:
+ - Deploys a model image/artifact to a canary Deployment (k8s),
+ - Runs smoke tests, checks Prometheus metrics for errors/latency,
+ - If pass -> promote to stable (update stable Deployment); else rollback and record evidence.
+Requires: kubectl, curl, prometheus API endpoint set via PROM_URL env var.
+"""
+import os, subprocess, time, json, sys
+PROM_URL = os.environ.get("PROM_URL")
+NAMESPACE = os.environ.get("NAMESPACE","aegis")
+CANARY_DEPLOY = os.environ.get("CANARY_DEPLOY","aegis-inference-canary")
+STABLE_DEPLOY = os.environ.get("STABLE_DEPLOY","aegis-inference")
+SMOKE_URL = os.environ.get("SMOKE_URL","http://aegis-inference-canary:50054/health")
+MODEL_IMAGE = os.environ.get("MODEL_IMAGE")
+PROM_QUERY_ERROR = 'sum(rate(aegis_inference_errors_total[1m]))'
+ERROR_THRESHOLD = float(os.environ.get("CANARY_ERROR_THRESHOLD","0.01"))
+SLEEP_AFTER_DEPLOY = int(os.environ.get("CANARY_SLEEP", "30"))
+
+def kubectl_patch_image(deploy, image):
+    cmd = ["kubectl","set","image","deploy",deploy,f"*={image}","-n",NAMESPACE]
+    subprocess.check_call(cmd)
+
+def run_smoke():
+    try:
+        r = subprocess.run(["curl","-sS","-f",SMOKE_URL], capture_output=True, text=True, timeout=10)
+        return r.returncode==0
+    except Exception:
+        return False
+
+def prometheus_error_rate():
+    if not PROM_URL:
+        return 0.0
+    q = PROM_QUERY_ERROR
+    try:
+        r = subprocess.getoutput(f"curl -sG '{PROM_URL}/api/v1/query' --data-urlencode 'query={q}'")
+        j = json.loads(r)
+        val = float(j.get("data",{}).get("result",[{"value":[0,0]}])[0]["value"][1])
+        return val
+    except Exception:
+        return 0.0
+
+def promote_canary():
+    if not MODEL_IMAGE:
+        print("MODEL_IMAGE env required"); sys.exit(2)
+    print("Deploying canary image:", MODEL_IMAGE)
+    kubectl_patch_image(CANARY_DEPLOY, MODEL_IMAGE)
+    print("Sleeping for stabilization...")
+    time.sleep(SLEEP_AFTER_DEPLOY)
+    print("Running smoke tests...")
+    if not run_smoke():
+        print("Smoke failed; rolling back canary")
+        # ideally track previous image; here we abort
+        sys.exit(2)
+    err = prometheus_error_rate()
+    print("Prometheus error rate:", err)
+    if err > ERROR_THRESHOLD:
+        print("Errors too high; aborting promotion")
+        sys.exit(2)
+    # promote: set stable image to canary image
+    kubectl_patch_image(STABLE_DEPLOY, MODEL_IMAGE)
+    print("Promotion complete")
+
+if __name__=="__main__":
+    promote_canary()
+
