+#!/usr/bin/env python3
+"""
+Simple probe to detect queuing/backpressure on async server by sending burst and measuring time-to-first-token.
+"""
+import time
+import grpc
+import os
+from ops.proto import generation_pb2, generation_pb2_grpc
+
+TARGET = os.environ.get("INFERENCE_TARGET", "127.0.0.1:50054")
+BURST = int(os.environ.get("BACKPRESSURE_BURST", "40"))
+
+def time_to_first_token():
+    ch = grpc.insecure_channel(TARGET)
+    stub = generation_pb2_grpc.GenerationStub(ch)
+    req = generation_pb2.GenerationRequest(prompt="probe backpressure", max_tokens=8, stream=True)
+    start = time.time()
+    try:
+        for tok in stub.StreamGenerate(req, timeout=30):
+            ttf = time.time() - start
+            return ttf
+    except Exception:
+        return None
+
+def run_burst():
+    import concurrent.futures
+    with concurrent.futures.ThreadPoolExecutor(max_workers=BURST) as ex:
+        futs = [ex.submit(time_to_first_token) for _ in range(BURST)]
+        results = [f.result() for f in futs]
+    succ = [r for r in results if r is not None]
+    print("Sent", BURST, "got", len(succ), "responses. sample ttf:", sorted(succ)[:5])
+
+if __name__=="__main__":
+    run_burst()
+
