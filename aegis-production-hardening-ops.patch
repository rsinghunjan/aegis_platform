+#!/usr/bin/env python3
+"""
+Async load tester for the async_batched_inference_server.
+Simulates concurrent streaming clients and records latencies and failures.
+"""
+import asyncio
+import time
+import os
+import statistics
+import grpc
+from ops.proto import generation_pb2, generation_pb2_grpc
+
+TARGET = os.environ.get("INFERENCE_TARGET", "127.0.0.1:50054")
+CONCURRENCY = int(os.environ.get("LOAD_CONCURRENCY", "50"))
+REQUESTS = int(os.environ.get("LOAD_REQUESTS", "200"))
+MAX_TOKENS = int(os.environ.get("LOAD_MAX_TOKENS", "32"))
+
+async def call_once(i, loop):
+    ch = grpc.aio.insecure_channel(TARGET)
+    stub = generation_pb2_grpc.GenerationStub(ch)
+    req = generation_pb2.GenerationRequest(prompt=f"load test {i}", max_tokens=MAX_TOKENS, stream=True)
+    start = loop.time()
+    try:
+        async for tok in stub.StreamGenerate(req, timeout=30):
+            pass
+        dur = loop.time() - start
+        return True, dur
+    except Exception as e:
+        return False, None
+
+async def run_all():
+    loop = asyncio.get_event_loop()
+    tasks = []
+    sem = asyncio.Semaphore(CONCURRENCY)
+
+    async def _wrapped(i):
+        async with sem:
+            return await call_once(i, loop)
+
+    for i in range(REQUESTS):
+        tasks.append(asyncio.create_task(_wrapped(i)))
+    res = await asyncio.gather(*tasks)
+    succ = [r[1] for r in res if r[0]]
+    fails = sum(1 for r in res if not r[0])
+    print("Success:", len(succ), "Fails:", fails)
+    if succ:
+        print("p50", statistics.median(succ), "p95", sorted(succ)[int(0.95*len(succ))-1])
+    return res
+
+if __name__=="__main__":
+    asyncio.run(run_all())
+
