+#!/usr/bin/env python3
+"""
+Job carbon exporter (updated to consume calibration file).
+Reads /etc/aegis/gpu_power_calibration.json for calibration factor and applies to measured power.
+"""
+import argparse, time, json, os, subprocess
+from datetime import datetime
+
+CAL_FILE = os.environ.get("AEGIS_GPU_CALIBRATION","/etc/aegis/gpu_power_calibration.json")
+
+def load_calibration():
+    try:
+        j = json.load(open(CAL_FILE))
+        return float(j.get("calibration_factor",1.0)), float(j.get("avg_nvidia_power_w",0.0))
+    except Exception:
+        return 1.0, None
+
+def sample_gpu_power(samples=5, interval_s=1):
+    powers = []
+    for _ in range(samples):
+        try:
+            out = subprocess.check_output(["nvidia-smi","--query-gpu=power.draw","--format=csv,noheader,nounits"], stderr=subprocess.DEVNULL)
+            for line in out.decode().strip().splitlines():
+                powers.append(float(line.strip()))
+        except Exception:
+            return None
+    return sum(powers)/len(powers) if powers else None
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--job-id", required=True)
+    p.add_argument("--start", type=int, required=True)
+    p.add_argument("--end", type=int, required=True)
+    p.add_argument("--region", required=True)
+    p.add_argument("--instance-type", required=True)
+    p.add_argument("--gpu-hours", type=float, default=0.0)
+    p.add_argument("--pushgateway", default=os.environ.get("PUSHGATEWAY",""))
+    p.add_argument("--out", default=f"/tmp/carbon_job_{{}}.json")
+    args = p.parse_args()
+
+    runtime_hours = max(1e-6, (args.end - args.start) / 3600.0)
+    measured_power_w = sample_gpu_power()
+    cal_factor, avg_nv = load_calibration()
+    if measured_power_w and cal_factor:
+        measured_power_w = measured_power_w * cal_factor
+
+    # Fallback/estimation uses avg_nv if present or instance mapping
+    if not measured_power_w and avg_nv:
+        measured_power_w = avg_nv
+
+    # Reuse estimate_co2_for_job if available
+    try:
+        from ops.carbon.convert.energy_to_co2 import estimate_co2_for_job
+        energy_kwh, co2e_kg, details = estimate_co2_for_job(
+            region=args.region,
+            instance_type=args.instance_type,
+            runtime_hours=runtime_hours,
+            gpu_hours=args.gpu_hours,
+            measured_power_w=measured_power_w
+        )
+    except Exception as e:
+        # basic fallback
+        energy_kwh = (measured_power_w or 300) * runtime_hours / 1000.0 * float(os.environ.get("AEGIS_PUE", "1.2"))
+        co2e_kg = energy_kwh * 0.4
+        details = {"fallback": True, "err": str(e)}
+
+    outpath = args.out.format(args.job_id)
+    payload = {
+        "job_id": args.job_id,
+        "start": args.start,
+        "end": args.end,
+        "runtime_hours": runtime_hours,
+        "instance_type": args.instance_type,
+        "region": args.region,
+        "gpu_hours": args.gpu_hours,
+        "measured_power_w": measured_power_w,
+        "energy_kwh": energy_kwh,
+        "co2e_kg": co2e_kg,
+        "details": details,
+        "generated_at": datetime.utcnow().isoformat() + "Z"
+    }
+    os.makedirs(os.path.dirname(outpath), exist_ok=True)
+    with open(outpath, "w") as fh:
+        json.dump(payload, fh, indent=2)
+    print("Wrote carbon artifact:", outpath)
+
+if __name__=="__main__":
+    main()
+
