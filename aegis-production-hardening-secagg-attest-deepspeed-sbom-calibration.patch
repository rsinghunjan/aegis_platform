+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Bootstrap Vault PKI role for issuing client certificates used in mTLS/attestation
+#
+VAULT_ADDR=${VAULT_ADDR:-http://vault.default.svc:8200}
+ROLE_NAME=${ROLE_NAME:-aegis-fl-client-role}
+PKI_MOUNT=${PKI_MOUNT:-pki}
+TTL=${TTL:-"24h"}
+
+if ! command -v vault >/dev/null 2>&1; then
+  echo "vault cli required; install and authenticate (VAULT_TOKEN env)"
+  exit 2
+fi
+
+echo "Enable PKI at mount $PKI_MOUNT"
+vault secrets enable -path="$PKI_MOUNT" pki || true
+vault secrets tune -max-lease-ttl=87600h "$PKI_MOUNT" || true
+
+echo "Generate root CA (if none exists)"
+vault write -format=json "$PKI_MOUNT/root/generate/internal" common_name="aegis.internal" ttl="87600h" >/dev/null || true
+
+echo "Create role $ROLE_NAME"
+vault write "$PKI_MOUNT/roles/$ROLE_NAME" \
+    allowed_domains="aegis.internal" \
+    allow_subdomains=true \
+    max_ttl="$TTL" || true
+
+echo "Example issuance: vault write $PKI_MOUNT/issue/$ROLE_NAME common_name=\"client01.aegis.internal\""
+echo "Use ops/fl/attestation/vault_attestation.py to request certs programmatically."
