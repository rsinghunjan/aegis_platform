+#!/usr/bin/env python3
+"""
+Chroma-backed persistent vectorstore utilities with optional S3 snapshot/restore.
+ - build_chroma_index(texts, persist_directory)
+ - query_chroma(query, persist_directory, top_k)
+ - snapshot_to_s3(persist_directory, s3_uri)
+ - restore_from_s3(s3_uri, persist_directory)
+Requires chromadb (pip install chromadb) and AWS CLI for s3 snapshot commands (or boto3).
+"""
+import os
+import shutil
+from pathlib import Path
+from typing import List, Tuple
+
+try:
+    import chromadb
+    from chromadb.config import Settings
+except Exception:
+    chromadb = None
+
+def build_chroma_index(texts: List[str], persist_directory: str = "data/chroma"):
+    if chromadb is None:
+        raise RuntimeError("chromadb not installed; install ops/integrations/requirements-langchain.txt")
+    client = chromadb.Client(Settings(persist_directory=persist_directory, anonymized_telemetry=False))
+    col = client.create_collection("aegis_docs")
+    ids = [str(i) for i in range(len(texts))]
+    col.add(ids=ids, documents=texts)
+    client.persist()
+    return persist_directory
+
+def query_chroma(query: str, persist_directory: str = "data/chroma", top_k: int = 5):
+    if chromadb is None:
+        raise RuntimeError("chromadb not installed")
+    client = chromadb.Client(Settings(persist_directory=persist_directory, anonymized_telemetry=False))
+    col = client.get_collection("aegis_docs")
+    res = col.query(query_texts=[query], n_results=top_k)
+    # return list of (id, score, doc)
+    out = []
+    for i,doc in enumerate(res["documents"][0]):
+        out.append((res["ids"][0][i], 0.0, doc))
+    return out
+
+def snapshot_to_s3(persist_directory: str, s3_uri: str):
+    # simple approach: tar the directory and upload via aws CLI or boto3
+    import tarfile, subprocess
+    p = Path(persist_directory)
+    tar = str(p.with_suffix(".tar.gz"))
+    with tarfile.open(tar, "w:gz") as tf:
+        tf.add(p, arcname=p.name)
+    # upload
+    subprocess.check_call(["aws","s3","cp", tar, s3_uri])
+    return s3_uri
+
+def restore_from_s3(s3_uri: str, persist_directory: str):
+    import subprocess, tarfile
+    tar = "/tmp/chroma_restore.tar.gz"
+    subprocess.check_call(["aws","s3","cp", s3_uri, tar])
+    with tarfile.open(tar, "r:gz") as tf:
+        tf.extractall(Path(persist_directory).parent)
+    return persist_directory
+
