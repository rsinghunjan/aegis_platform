+#!/usr/bin/env python3
+"""
+gRPC aio interceptors for authentication, rate limiting, provenance logging and evidence recording.
+ - Auth interceptor: validates bearer token header (simple pluggable check).
+ - Rate limiting: optional Redis-backed token bucket; falls back to in-memory per-process limiter.
+ - Provenance: logs prompt/request metadata (not full content) into evidence manifests and increments metrics.
+"""
+import os
+import time
+import asyncio
+from typing import Callable
+from grpc import aio
+from ops.autonomy.safety_monitor import record_manifest
+
+try:
+    import aioredis
+except Exception:
+    aioredis = None
+
+# Simple in-memory token-bucket store per client identity
+class InMemoryLimiter:
+    def __init__(self, rate: float = 1.0, capacity: int = 5):
+        self.rate = rate
+        self.capacity = capacity
+        self.tokens = {}
+        self.timestamps = {}
+
+    def allow(self, key: str) -> bool:
+        now = time.time()
+        tokens = self.tokens.get(key, self.capacity)
+        last = self.timestamps.get(key, now)
+        # replenish
+        tokens += (now - last) * self.rate
+        if tokens > self.capacity:
+            tokens = self.capacity
+        if tokens >= 1:
+            tokens -= 1
+            self.tokens[key] = tokens
+            self.timestamps[key] = now
+            return True
+        self.tokens[key] = tokens
+        self.timestamps[key] = now
+        return False
+
+_limiter = InMemoryLimiter(rate=float(os.environ.get("RATE_PER_SEC","0.2")), capacity=int(os.environ.get("RATE_CAP","10")))
+
+class AuthInterceptor(aio.ServerInterceptor):
+    def __init__(self, validator: Callable[[str], bool]=None):
+        self.validator = validator or (lambda t: True)
+
+    async def intercept_service(self, continuation, handler_call_details):
+        md = dict(handler_call_details.invocation_metadata or [])
+        auth = md.get("authorization") or md.get("Authorization")
+        if not auth or not auth.startswith("Bearer "):
+            # reject without valid bearer token
+            async def abort_behavior(request, context):
+                context.abort(aio.StatusCode.UNAUTHENTICATED, "Missing bearer token")
+            return abort_behavior
+        token = auth.split(" ",1)[1]
+        if not self.validator(token):
+            async def abort_behavior(request, context):
+                context.abort(aio.StatusCode.PERMISSION_DENIED, "Invalid token")
+            return abort_behavior
+        return await continuation(handler_call_details)
+
+class RateLimitInterceptor(aio.ServerInterceptor):
+    def __init__(self, limiter=None):
+        self.limiter = limiter or _limiter
+
+    async def intercept_service(self, continuation, handler_call_details):
+        md = dict(handler_call_details.invocation_metadata or [])
+        auth = md.get("authorization") or md.get("Authorization") or ""
+        key = auth.split(" ",1)[1] if auth.startswith("Bearer ") else handler_call_details.method
+        if not self.limiter.allow(key):
+            async def abort_behavior(request, context):
+                context.abort(aio.StatusCode.RESOURCE_EXHAUSTED, "Rate limit exceeded")
+            return abort_behavior
+        return await continuation(handler_call_details)
+
+class ProvenanceInterceptor(aio.ServerInterceptor):
+    async def intercept_service(self, continuation, handler_call_details):
+        # record a lightweight provenance manifest per request (method + timestamp + peer)
+        record_manifest("request_provenance", {"method": handler_call_details.method, "ts": int(time.time())})
+        return await continuation(handler_call_details)
+
+__all__ = ["AuthInterceptor", "RateLimitInterceptor", "ProvenanceInterceptor"]
+
