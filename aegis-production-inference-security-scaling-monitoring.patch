+#!/usr/bin/env python3
+"""
+Rotate certs in Vault PKI and annotate deployments to trigger restart.
+ - Requests a certificate for the role and writes to a k8s Secret via kubectl (or uses CSI to refresh)
+ - Annotates deployments with a rotation timestamp to force rollout when certs rotate.
+Requires vault CLI or hvac, and kubectl access.
+"""
+import os
+import subprocess
+import json
+import time
+from datetime import datetime
+
+ROLE = os.environ.get("VAULT_ROLE", "aegis-grpc-server")
+K8S_NAMESPACE = os.environ.get("K8S_NAMESPACE", "aegis")
+DEPLOYMENTS_TO_TOUCH = os.environ.get("DEPLOYMENTS", "aegis-evidence-grpc,aegis-dp-grpc,aegis-serve-grpc").split(",")
+
+def request_cert_and_write_secret():
+    # This is operator-run code; adapt to your Vault setup. Example uses vault CLI to generate a cert as JSON.
+    out = subprocess.check_output(["vault", "write", f"pki/issue/{ROLE}", "common_name=aegis-server", "-format=json"])
+    j = json.loads(out)
+    cert = j["data"]["certificate"]
+    key = j["data"]["private_key"]
+    ca = j["data"].get("issuing_ca","")
+    # write secret to k8s (best-effort)
+    secret_yaml = f"""apiVersion: v1
+kind: Secret
+metadata:
+  name: aegis-grpc-certs
+  namespace: {K8S_NAMESPACE}
+type: Opaque
+data:
+  tls.crt: {cert.encode('utf-8').hex()}
+  tls.key: {key.encode('utf-8').hex()}
+  ca.crt: {ca.encode('utf-8').hex()}
+"""
+    p = "/tmp/aegis_cert_secret.yaml"
+    open(p,"w").write(secret_yaml)
+    subprocess.check_call(["kubectl","apply","-f", p])
+    return True
+
+def annotate_rollouts():
+    ts = datetime.utcnow().isoformat()
+    for d in DEPLOYMENTS_TO_TOUCH:
+        subprocess.check_call(["kubectl","patch","deploy", d, "-n", K8S_NAMESPACE, "--type=json", "-p", f"[{{\"op\":\"add\",\"path\":\"/spec/template/metadata/annotations/aegis.cert-rotate\",\"value\":\"{ts}\"}}]"])
+
+def main():
+    request_cert_and_write_secret()
+    annotate_rollouts()
+    print("Rotation complete at", time.asctime())
+
+if __name__=="__main__":
+    main()
+
