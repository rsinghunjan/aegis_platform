+#!/usr/bin/env python3
+"""
+Enforce secure channels for clients in production.
+ - In production (PRODUCTION=true) clients must not fall back to insecure channels.
+ - Provide helper to create channels that error if insecure in production.
+"""
+import os
+import grpc
+from ops.grpc.tls_helpers import client_credentials, has_tls_certs
+
+PRODUCTION = os.environ.get("PRODUCTION","false").lower() in ("1","true","yes")
+
+def make_channel(target: str, insecure: bool = None):
+    """
+    Create a grpc channel. If PRODUCTION is true and insecure is None, prefer secure and fail if no creds.
+    If insecure=True forces insecure (not recommended).
+    """
+    if insecure is True:
+        return grpc.insecure_channel(target)
+    if insecure is False:
+        creds = client_credentials()
+        return grpc.secure_channel(target, creds)
+    # default behavior
+    if PRODUCTION:
+        if not has_tls_certs():
+            raise RuntimeError("Production requires TLS certs; client cannot create insecure channel")
+        creds = client_credentials()
+        return grpc.secure_channel(target, creds)
+    else:
+        # non-production: prefer secure if creds available, otherwise insecure
+        if has_tls_certs():
+            creds = client_credentials()
+            return grpc.secure_channel(target, creds)
+        return grpc.insecure_channel(target)
+
