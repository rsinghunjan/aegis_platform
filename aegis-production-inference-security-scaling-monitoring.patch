+#!/usr/bin/env python3
+"""
+Backup and restore helpers for FAISS index to S3.
+ - backup_index(index_path, s3_uri)
+ - restore_index(s3_uri, index_path)
+"""
+import subprocess
+from pathlib import Path
+
+def backup_index(index_path: str, s3_uri: str):
+    p = Path(index_path)
+    if not p.exists():
+        raise FileNotFoundError(index_path)
+    subprocess.check_call(["aws","s3","cp", str(p), s3_uri])
+    # also metadata
+    meta = p.with_suffix(p.suffix + ".meta.json")
+    if meta.exists():
+        subprocess.check_call(["aws","s3","cp", str(meta), s3_uri + ".meta.json"])
+    return True
+
+def restore_index(s3_uri: str, index_path: str):
+    subprocess.check_call(["aws","s3","cp", s3_uri, index_path])
+    try:
+        subprocess.check_call(["aws","s3","cp", s3_uri + ".meta.json", index_path + ".meta.json"])
+    except Exception:
+        pass
+    return True
