+#!/usr/bin/env python3
+"""
+convert_to_tensorrt.py
+Wraps trtexec (TensorRT) to convert an ONNX model into a TensorRT engine.
+Environment:
+ - TRITON_MODEL_DIR: target model repo directory (e.g., /opt/triton-model-repo/<model>/1/)
+ - ONNX_PATH: path to input ONNX file
+ - MAX_BATCH: optional
+Requires: trtexec available in PATH (NVIDIA TensorRT).
+"""
+import os
+import subprocess
+import sys
+
+ONNX_PATH = os.environ.get("ONNX_PATH")
+TRITON_MODEL_DIR = os.environ.get("TRITON_MODEL_DIR", "/models")
+MAX_BATCH = os.environ.get("MAX_BATCH", "8")
+
+def convert(onnx_path, out_dir, max_batch=8):
+    os.makedirs(out_dir, exist_ok=True)
+    engine_file = os.path.join(out_dir, "model.trt")
+    cmd = [
+        "trtexec",
+        f"--onnx={onnx_path}",
+        f"--saveEngine={engine_file}",
+        f"--maxBatch={max_batch}",
+        "--workspace=2048",
+        "--fp16"
+    ]
+    print("Running:", " ".join(cmd))
+    subprocess.check_call(cmd)
+    return engine_file
+
+if __name__ == "__main__":
+    if not ONNX_PATH:
+        print("set ONNX_PATH env var")
+        sys.exit(2)
+    out = convert(ONNX_PATH, TRITON_MODEL_DIR, int(MAX_BATCH))
+    print("wrote engine:", out)
+
