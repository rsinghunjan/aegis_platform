+#!/usr/bin/env python3
+"""
+receipt_signer.py
+Sign a JSON payload using Vault Transit (preferred) or AWS KMS.
+Environment:
+ - SIGNER_BACKEND: vault|aws
+ - VAULT_ADDR, VAULT_TOKEN (if vault)
+ - KMS_KEY_ID, AWS credentials (if aws)
+ - REKOR_URL (optional) to push transparency log entries
+"""
+import os
+import json
+import base64
+import requests
+
+BACKEND = os.environ.get("SIGNER_BACKEND", "vault")
+
+def sign_with_vault(payload: dict) -> dict:
+    addr = os.environ.get("VAULT_ADDR", "http://vault.aegis-system.svc.cluster.local:8200")
+    token = os.environ.get("VAULT_TOKEN", "")
+    key_name = os.environ.get("VAULT_TRANSIT_KEY", "aegis-sign")
+    url = f"{addr}/v1/transit/sign/{key_name}"
+    j = {"input": base64.b64encode(json.dumps(payload).encode()).decode()}
+    r = requests.post(url, json=j, headers={"X-Vault-Token": token}, timeout=5.0)
+    r.raise_for_status()
+    return r.json()
+
+def sign_with_aws(payload: dict) -> dict:
+    import boto3, hashlib
+    kms = boto3.client("kms", region_name=os.environ.get("AWS_REGION"))
+    data = json.dumps(payload).encode()
+    # KMS Sign uses asymmetric CMKs; for demo we hash and call sign if key supports
+    digest = hashlib.sha256(data).digest()
+    key_id = os.environ.get("KMS_KEY_ID")
+    r = kms.sign(KeyId=key_id, Message=digest, MessageType="DIGEST", SigningAlgorithm="RSASSA_PKCS1_V1_5_SHA_256")
+    sig = base64.b64encode(r["Signature"]).decode()
+    return {"signature": sig}
+
+def record_to_rekor(payload: dict, signature: dict) -> None:
+    rekor = os.environ.get("REKOR_URL", "")
+    if not rekor:
+        return
+    entry = {"payload": payload, "signature": signature}
+    try:
+        requests.post(f"{rekor.rstrip('/')}/api/v1/log/entries", json=entry, timeout=5.0)
+    except Exception:
+        pass
+
+def sign(payload: dict) -> dict:
+    if BACKEND == "vault":
+        out = sign_with_vault(payload)
+        record_to_rekor(payload, out)
+        return out
+    else:
+        out = sign_with_aws(payload)
+        record_to_rekor(payload, out)
+        return out
+
+if __name__ == "__main__":
+    import sys
+    payload = {"event":"test","ts":__import__("time").time()}
+    print(sign(payload))
+
