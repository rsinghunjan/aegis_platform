+
+# Example: patch a constraint to add enforcementAction (if using Gatekeeper v3+)
+cat <<'YAML' > /tmp/patch-constraint.yaml
+spec:
+  enforcementAction: deny
+YAML
+
+for c in $(kubectl get constraints --all-namespaces -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'); do
+  echo "Patching constraint $c to enforcementAction=deny (if API supports it)"
+  kubectl patch constraint $c --type merge --patch-file /tmp/patch-constraint.yaml || true
+done
+
+echo "Flip complete. Verify Gatekeeper logs and attempt an unsigned deploy to confirm deny behavior."
