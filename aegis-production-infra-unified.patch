+#!/usr/bin/env python3
+"""
+encrypt_store_aws.py
+Utility to encrypt bytes with AWS KMS and upload to S3 (or MinIO if configured).
+Environment variables:
+ - STORAGE_BACKEND: s3|minio
+ - S3_BUCKET: bucket name
+ - AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (or use instance role)
+ - KMS_KEY_ID: KMS key ARN/ID
+ - MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY (if STORAGE_BACKEND=minio)
+"""
+import os
+import boto3
+import botocore
+from botocore.client import Config
+
+STORAGE_BACKEND = os.environ.get("STORAGE_BACKEND", "s3")
+S3_BUCKET = os.environ.get("S3_BUCKET", "aegis-artifacts")
+KMS_KEY_ID = os.environ.get("KMS_KEY_ID", "")
+
+def encrypt_and_upload(artifact_id: str, data: bytes, metadata: dict = None):
+    # Encrypt with KMS (Envelope encryption)
+    kms = boto3.client("kms", region_name=os.environ.get("AWS_REGION"))
+    # Generate a data key
+    resp = kms.generate_data_key(KeyId=KMS_KEY_ID, KeySpec="AES_256")
+    plaintext_key = resp["Plaintext"]
+    encrypted_key = resp["CiphertextBlob"]
+    # Symmetric encryption using AWS SDK (S3 client can do SSE-KMS directly, but we demonstrate envelope)
+    # For simplicity, use S3 SSE-KMS server-side encryption
+    s3_conf = {}
+    if STORAGE_BACKEND == "minio":
+        s3 = boto3.client("s3",
+                          endpoint_url=os.environ.get("MINIO_ENDPOINT"),
+                          aws_access_key_id=os.environ.get("MINIO_ACCESS_KEY"),
+                          aws_secret_access_key=os.environ.get("MINIO_SECRET_KEY"),
+                          config=Config(signature_version="s3v4"),
+                          region_name=os.environ.get("AWS_REGION"))
+        extra_args = {}
+    else:
+        s3 = boto3.client("s3", region_name=os.environ.get("AWS_REGION"))
+        extra_args = {"ServerSideEncryption": "aws:kms", "SSEKMSKeyId": KMS_KEY_ID}
+
+    key = f"originals/{artifact_id}.bin"
+    try:
+        s3.put_object(Bucket=S3_BUCKET, Key=key, Body=data, Metadata=metadata or {}, **extra_args)
+        return {"bucket": S3_BUCKET, "key": key, "encrypted_key": encrypted_key.hex()}
+    except botocore.exceptions.ClientError as e:
+        raise
+
+if __name__ == "__main__":
+    # Demo: read file and upload
+    import sys
+    if len(sys.argv) < 3:
+        print("usage: encrypt_store_aws.py <artifact_id> <file>")
+        raise SystemExit(2)
+    aid = sys.argv[1]
+    with open(sys.argv[2], "rb") as f:
+        data = f.read()
+    print(encrypt_and_upload(aid, data, {"uploaded-by":"encrypt_store_aws"}))
+
