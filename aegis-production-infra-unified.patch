+#!/usr/bin/env python3
+"""
+Enhanced promotion guard that reads MLflow metrics, emissions, and drift signals.
+It consults:
+ - MLflow registry for staging model metrics (accuracy)
+ - MCP / monitoring endpoint for latest drift_score
+ - MLflow metric 'emissions_kgco2e' for the run
+If policy fails, raises A2A and records event to MCP.
+"""
+import os
+import sys
+import requests
+from mlflow.tracking import MlflowClient
+
+MODEL_NAME = os.environ.get("MODEL_NAME", "aegis-model")
+MLFLOW_URI = os.environ.get("MLFLOW_TRACKING_URI", "http://mlflow:5000")
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+DRIFT_API = os.environ.get("DRIFT_API", "http://mcp:8082/monitoring/drift")
+REQUIRED_ACCURACY = float(os.environ.get("REQUIRED_ACCURACY", "0.80"))
+MIN_GAIN_PER_KG = float(os.environ.get("MIN_GAIN_PER_KG", "0.01"))
+MAX_EMISSIONS_PER_PROMOTION = float(os.environ.get("MAX_EMISSIONS_PER_PROMOTION", "100.0"))
+
+client = MlflowClient(tracking_uri=MLFLOW_URI)
+
+def latest_metric_for_model(model_name, stage="Staging"):
+    # Query MLflow Model Registry for latest version in stage and its run metrics
+    try:
+        versions = client.get_latest_versions(name=model_name, stages=[stage])
+        if not versions:
+            return None
+        v = versions[0]
+        run_id = v.run_id
+        metrics = client.get_run(run_id).data.metrics
+        return metrics
+    except Exception:
+        return None
+
+def get_latest_drift_score():
+    try:
+        r = requests.get(DRIFT_API, timeout=3.0)
+        if r.ok:
+            j = r.json()
+            return float(j.get("drift_score", 0.0))
+    except Exception:
+        pass
+    return 0.0
+
+def check_and_promote():
+    metrics = latest_metric_for_model(MODEL_NAME, stage="Staging")
+    if not metrics:
+        print("no staging model metrics")
+        return 1
+    acc = float(metrics.get("accuracy", 0.0))
+    emissions = float(metrics.get("emissions_kgco2e", 0.0))
+    print("staging accuracy", acc, "emissions", emissions)
+    drift = get_latest_drift_score()
+    print("current drift_score", drift)
+
+    if acc < REQUIRED_ACCURACY:
+        print("does not meet required accuracy")
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/promotion/events", json={"model":MODEL_NAME,"accuracy":acc,"promote":False}, timeout=3.0)
+        return 2
+
+    # Combine rules: emissions budget and drift threshold
+    if emissions <= MAX_EMISSIONS_PER_PROMOTION and drift < 1.0:
+        # open A2A to request tracked promotion (auditable)
+        body = {"action_id": "promote-"+MODEL_NAME, "artifact_uri": f"mlflow://{MODEL_NAME}", "approver":"mlops", "decision":"requested", "comment":"auto-promotion candidate"}
+        try:
+            r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+            if r.ok:
+                requests.post(f"{AEGIS_MCP.rstrip('/')}/promotion/events", json={"model":MODEL_NAME,"accuracy":acc,"emissions_kg":emissions,"a2a":r.json().get("id")}, timeout=3.0)
+                print("A2A request opened", r.json().get("id"))
+                return 0
+        except Exception as e:
+            print("failed to open A2A", e)
+            return 1
+    else:
+        # require human approval due to emissions/drift
+        body = {"action_id":"promote-"+MODEL_NAME, "artifact_uri": f"mlflow://{MODEL_NAME}", "approver":"mlops", "decision":"requested", "comment":"promotion requires human review - emissions/drift", "meta":{"emissions":emissions,"drift":drift}}
+        try:
+            r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+            if r.ok:
+                requests.post(f"{AEGIS_MCP.rstrip('/')}/promotion/events", json={"model":MODEL_NAME,"accuracy":acc,"emissions_kg":emissions,"a2a":r.json().get("id"),"carbon_policy":"requires_human"}, timeout=3.0)
+                print("A2A carbon advisory opened", r.json().get("id"))
+                return 0
+        except Exception as e:
+            print("failed to open A2A", e)
+            return 1
+
+if __name__ == "__main__":
+    sys.exit(check_and_promote())
+
