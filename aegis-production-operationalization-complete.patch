+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Production HSM/KMS key rotation orchestration (operator-run)
+# Usage:
+#   export VAULT_ADDR=... VAULT_TOKEN=...
+#   ./ops/hsm/rotate_keys_prod.sh <re-sign-list.txt>
+RE_SIGN_LIST=${1:-/tmp/re_sign_list.txt}
+VAULT_KMS_PATH=${VAULT_KMS_PATH:-secret/data/aegis/kms}
+
+if [ ! -f "$RE_SIGN_LIST" ]; then
+  echo "Create re-sign list at $RE_SIGN_LIST (one artifact URI per line)."
+  exit 2
+fi
+
+echo "Step 1: PUT new key refs into Vault temporary staging (operator must do this manually/CI)."
+echo "Step 2: Confirm new key refs are present at ${VAULT_KMS_PATH}/staging"
+vault kv get -format=json "${VAULT_KMS_PATH}/staging" || { echo "staging path missing"; exit 1; }
+
+NEW_KEYS=$(vault kv get -format=json "${VAULT_KMS_PATH}/staging" | jq -r '.data.data.cosign_key_refs // empty')
+if [ -z "$NEW_KEYS" ]; then
+  echo "No new keys found in staging. Aborting."
+  exit 1
+fi
+
+echo "Backing up current keys to /tmp/aegis_kms_backup.json"
+vault kv get -format=json "${VAULT_KMS_PATH}" > /tmp/aegis_kms_backup.json || true
+
+echo "Promoting staging keys to active (operator confirm Y/N):"
+read -p "Proceed to promote new keys to active? (Y/N): " yn
+if [ "$yn" != "Y" ]; then
+  echo "Aborting"
+  exit 1
+fi
+
+vault kv put "${VAULT_KMS_PATH}" cosign_key_refs="$NEW_KEYS"
+echo "Active keys updated in Vault."
+
+echo "Re-signing artifacts listed in $RE_SIGN_LIST"
+while IFS= read -r ART || [ -n "$ART" ]; do
+  [ -z "$ART" ] && continue
+  echo "Re-signing $ART"
+  python3 ops/hsm/multi_sign_orchestrator.py "$ART" "$NEW_KEYS"
+done < "$RE_SIGN_LIST"
+
+echo "Verify a sample artifact with ops/hsm/multi_sign_verify.py"
+echo "After verification, retire old keys per key-retirement policy and record rotation event in audit ledger."
+
