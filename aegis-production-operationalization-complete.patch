+#!/usr/bin/env python3
+"""
+Create an auditable key-issuance manifest and optionally upload to evidence bucket and record in Vault.
+Operators run this whenever creating a new signing key so issuance is recorded.
+"""
+import os, json, time, subprocess, argparse
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+VAULT_PATH = os.environ.get("VAULT_KMS_ISSUANCE_PATH","secret/data/aegis/kms_issuance")
+
+def make_manifest(key_ref, operator, notes=""):
+    manifest = {"key_ref": key_ref, "issued_by": operator, "ts": int(time.time()), "notes": notes}
+    fn = f"/tmp/key_issuance_{int(time.time())}.json"
+    with open(fn,"w") as fh: json.dump(manifest, fh, indent=2)
+    return fn, manifest
+
+def upload(fn):
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        dest = f"{EVIDENCE_BUCKET}/kms_issuance/{os.path.basename(fn)}"
+        subprocess.check_call(["aws","s3","cp", fn, dest])
+        return dest
+    return None
+
+def record_vault(key, manifest):
+    subprocess.check_call(["vault","kv","put", f"{VAULT_PATH}/{key}", f"metadata={json.dumps(manifest)}"])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--key-ref", required=True)
+    p.add_argument("--operator", required=True)
+    p.add_argument("--notes", default="")
+    args = p.parse_args()
+    fn, manifest = make_manifest(args.key_ref, args.operator, args.notes)
+    uri = upload(fn)
+    vault_key = f"issuance-{int(time.time())}"
+    record_vault(vault_key, {"manifest_uri": uri or fn, **manifest})
+    print("Issued manifest recorded:", vault_key, uri or fn)
+
+if __name__=="__main__":
+    main()
+
