+#!/usr/bin/env python3
+"""
+Production moderation wrapper:
+ - If MODERATION_API_URL is configured, calls external moderation endpoint (recommended for scaled trust)
+ - Else optionally calls a local model endpoint (MODERATION_LOCAL_URL)
+ - Returns standardized verdicts and confidence
+This replaces safety stubs with a production integration point.
+"""
+import os, requests, json
+
+MODERATION_API_URL = os.environ.get("MODERATION_API_URL","")
+MODERATION_LOCAL_URL = os.environ.get("MODERATION_LOCAL_URL","")
+
+def moderate_image_bytes(image_bytes):
+    """
+    Send image bytes to moderation endpoint; endpoint should accept multipart/form-data 'file'
+    and return JSON: {verdict: 'allow'|'block'|'review', reasons:[], confidence:0.9}
+    """
+    if MODERATION_API_URL:
+        files = {"file": ("img.png", image_bytes)}
+        r = requests.post(MODERATION_API_URL + "/moderate/image", files=files, timeout=30)
+        r.raise_for_status()
+        return r.json()
+    elif MODERATION_LOCAL_URL:
+        files = {"file": ("img.png", image_bytes)}
+        r = requests.post(MODERATION_LOCAL_URL + "/moderate/image", files=files, timeout=30)
+        r.raise_for_status()
+        return r.json()
+    else:
+        # fallback conservative: request human review
+        return {"verdict":"review", "reasons":["no_moderation_pipeline"], "confidence": 0.0}
+
+def moderate_text(text):
+    if MODERATION_API_URL:
+        r = requests.post(MODERATION_API_URL + "/moderate/text", json={"text": text}, timeout=10)
+        r.raise_for_status()
+        return r.json()
+    elif MODERATION_LOCAL_URL:
+        r = requests.post(MODERATION_LOCAL_URL + "/moderate/text", json={"text": text}, timeout=10)
+        r.raise_for_status()
+        return r.json()
+    else:
+        # fallback: simple keyword heuristic (very conservative)
+        banned=["ssn","credit card","social security"]
+        for b in banned:
+            if b in text.lower():
+                return {"verdict":"block","reasons":[f"contains_{b}"], "confidence": 0.6}
+        return {"verdict":"allow","reasons":[], "confidence": 0.99}
+
