+#!/usr/bin/env python3
+"""
+Track insurer and legal signoffs:
+ - record signoff events in Vault and optionally notify auditor/insurer webhooks
+ - used by finance promotion flows to gate auto-block activation
+"""
+import os, subprocess, json, argparse
+
+VAULT_PATH = os.environ.get("VAULT_INSURANCE_PATH","secret/data/aegis/insurance_signoffs")
+AUDITOR_WEBHOOK = os.environ.get("AUDITOR_WEBHOOK","")
+INSURER_WEBHOOK = os.environ.get("INSURER_WEBHOOK","")
+
+def record_signoff(kind, signer, notes=""):
+    key = f"{kind}-signoff-{int(__import__('time').time())}"
+    payload = {"signer": signer, "kind": kind, "notes": notes}
+    subprocess.check_call(["vault","kv","put", f"{VAULT_PATH}/{key}", f"metadata={json.dumps(payload)}"])
+    return key
+
+def notify(kind, key, metadata):
+    payload = {"kind": kind, "key": key, "metadata": metadata}
+    if AUDITOR_WEBHOOK:
+        subprocess.call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps(payload), AUDITOR_WEBHOOK])
+    if INSURER_WEBHOOK:
+        subprocess.call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps(payload), INSURER_WEBHOOK])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--kind", required=True)
+    p.add_argument("--signer", required=True)
+    p.add_argument("--notes", default="")
+    args = p.parse_args()
+    key = record_signoff(args.kind, args.signer, args.notes)
+    notify(args.kind, key, {"signer": args.signer, "notes": args.notes})
+    print("Recorded signoff", key)
+
+if __name__=="__main__":
+    main()
+
