+#!/usr/bin/env python3
+"""
+Orchestrates factuality tuning:
+ - Ingests labeled CSV produced by labelers
+ - Trains calibrator (train_threshold / train_calibrator)
+ - Validates precision/recall and writes chosen thresholds to Vault (or config file)
+"""
+import os, json, subprocess, argparse, tempfile
+
+VAULT_THRESHOLD_PATH = os.environ.get("VAULT_THRESHOLD_PATH","secret/data/aegis/factuality")
+
+def run_convert(label_csv, out_csv):
+    subprocess.check_call(["python3","services/factuality/labeling/convert_to_dataset.py", label_csv, out_csv])
+
+def run_train(csv_in, out_model, out_report):
+    subprocess.check_call(["python3","services/factuality/train_threshold.py","--csv",csv_in,"--out_model",out_model,"--out_report",out_report])
+
+def put_threshold_in_vault(report_path):
+    import json, subprocess
+    r = json.load(open(report_path))
+    thr = r.get("recommended",{})
+    if thr:
+        subprocess.check_call(["vault","kv","put", VAULT_THRESHOLD_PATH, f"threshold={json.dumps(thr)}"])
+        return True
+    return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--labels", required=True, help="labels.json or CSV path")
+    args = p.parse_args()
+    tmpcsv = "/tmp/labels_converted.csv"
+    run_convert(args.labels, tmpcsv)
+    out_model = "/tmp/factuality_calibrator.pkl"
+    out_report = "/tmp/factuality_report.json"
+    run_train(tmpcsv, out_model, out_report)
+    ok = put_threshold_in_vault(out_report)
+    print("Calibrator completed. threshold stored in Vault:", ok)
+
+if __name__=="__main__":
+    main()
+
