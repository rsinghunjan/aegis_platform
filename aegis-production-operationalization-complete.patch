+/*
+Production-ready Terraform for HSM-backed KMS provisioning.
+This is an operator template. Review with your cloud security and networking teams.
+It includes:
+ - AWS: CloudHSM cluster + guidance to create KMS Custom Key Store (manual step) + CMK scaffold
+ - GCP: KMS key ring + asymmetric key
+ - Azure: Key Vault (HSM-protected) + key
+Outputs: key identifiers to sync into Vault.
+
+IMPORTANT: Many CloudHSM/CMS steps require manual operator configuration (initialization, cluster activation).
+*/
+terraform {
+  required_providers {
+    aws   = { source = "hashicorp/aws" }
+    google = { source = "hashicorp/google" }
+    azurerm = { source = "hashicorp/azurerm" }
+  }
+}
+
+provider "aws" { region = var.aws_region }
+provider "google" { project = var.gcp_project, region = var.gcp_region }
+provider "azurerm" { features = {} }
+
+variable "aws_region" { type = string, default = "us-west-2" }
+variable "gcp_project" { type = string, default = "" }
+variable "gcp_region" { type = string, default = "us-central1" }
+variable "azure_location" { type = string, default = "eastus" }
+variable "hsm_subnet_ids" { type = list(string), default = [] }
+variable "signer_principals" { type = list(string), default = [] }
+
+###########################
+# AWS CloudHSM cluster (operator must initialize & activate)
+resource "aws_cloudhsm_v2_cluster" "aegis_hsm" {
+  cluster_id = null
+  hsm_type   = "hsm1.medium"
+  subnet_ids = var.hsm_subnet_ids
+  # NOTE: Terraform will attempt creation; operator must complete cluster initialization
+}
+
+###########################
+# AWS KMS CMK (example). For HSM protection use KMS Custom Key Store linking to CloudHSM (manual steps).
+data "aws_iam_policy_document" "kms_policy" {
+  statement {
+    sid = "AllowAegisSigners"
+    principals {
+      type = "AWS"
+      identifiers = var.signer_principals
+    }
+    actions = ["kms:Sign", "kms:GetPublicKey", "kms:DescribeKey"]
+    resources = ["*"]
+  }
+}
+
+resource "aws_kms_key" "aegis_key" {
+  description = "Aegis cosign signing key (operator-managed)"
+  deletion_window_in_days = 30
+  key_usage = "SIGN_VERIFY"
+  customer_master_key_spec = "RSA_3072"
+  policy = data.aws_iam_policy_document.kms_policy.json
+  tags = { "service" = "aegis", "purpose" = "cosign" }
+}
+
+resource "aws_kms_alias" "aegis_alias" {
+  name = "alias/aegis-cosign"
+  target_key_id = aws_kms_key.aegis_key.key_id
+}
+
+output "aws_kms_key_arn" {
+  value = aws_kms_key.aegis_key.arn
+}
+
+###########################
+# GCP KMS
+resource "google_kms_key_ring" "aegis_ring" {
+  name = "aegis-keyring"
+  location = var.gcp_region
+}
+
+resource "google_kms_crypto_key" "aegis_key" {
+  name = "aegis-cosign"
+  key_ring = google_kms_key_ring.aegis_ring.id
+  rotation_period = "7776000s" # 90d
+  labels = { "service" = "aegis" }
+}
+
+output "gcp_kms_key_id" {
+  value = google_kms_crypto_key.aegis_key.id
+}
+
+###########################
+# Azure Key Vault + HSM protected key
+resource "azurerm_resource_group" "rg" {
+  name     = "aegis-rg"
+  location = var.azure_location
+}
+
+resource "azurerm_key_vault" "aegis_vault" {
+  name                = "aegis-kv-${replace(uuid(),\"-\",\"\")}"
+  location            = azurerm_resource_group.rg.location
+  resource_group_name = azurerm_resource_group.rg.name
+  tenant_id           = data.azurerm_client_config.current.tenant_id
+  sku_name            = "premium" # premium for HSM-backed keys
+  soft_delete_enabled = true
+}
+
+resource "azurerm_key_vault_key" "aegis_key" {
+  name         = "aegis-cosign"
+  key_vault_id = azurerm_key_vault.aegis_vault.id
+  key_type     = "RSA"
+  key_size     = 3072
+}
+
+data "azurerm_client_config" "current" {}
+
+output "azure_key_id" {
+  value = azurerm_key_vault_key.aegis_key.id
+}
+
+/*
+Operator next steps (after terraform apply):
+ - For AWS: create or attach KMS Custom Key Store using CloudHSM cluster; optionally create HSM-backed CMK and record ARN.
+ - For GCP: grant signer service accounts roles/cloudkms.signerVerifier and record key id.
+ - For Azure: set Key Vault access policies for signer managed identities.
+ - Run ops/hsm/sync_keys_to_vault.sh with outputs to populate Vault for Aegis services.
+*/
+
