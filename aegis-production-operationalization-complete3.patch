+#
+# Validated CUDA inference image Dockerfile (template)
+# - Built FROM NVIDIA CUDA runtime image
+# - Installs minimal dependencies and vLLM/transformers
+# - Intended to be built in a secure CI runner with access to required registries
+#
+FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04
+LABEL maintainer="aegis@example.com"
+
+ENV DEBIAN_FRONTEND=noninteractive
+RUN apt-get update && apt-get install -y --no-install-recommends \
+    python3 python3-pip python3-distutils git ca-certificates && \
+    rm -rf /var/lib/apt/lists/*
+
+# Python packages - pin to tested versions in your environment
+RUN python3 -m pip install --upgrade pip setuptools wheel
+RUN pip install --no-cache-dir vllm==0.4.4 transformers[sentencepiece]==4.34.0 accelerate==1.18.0 \
+    protobuf==4.24.3 grpcio==1.58.0
+
+# Create app user
+RUN useradd --create-home --shell /bin/bash aegis
+WORKDIR /workspace
+COPY . /workspace
+RUN chown -R aegis:aegis /workspace
+USER aegis
+
+ENV USE_GPU=1
+# Default values can be overridden by env vars at runtime/helm
+ENV BATCH_MAX_SIZE=16
+ENV BATCH_TIMEOUT_SEC=0.02
+
+EXPOSE 50054
+CMD ["python3","ops/grpc/async_batched_inference_server.py"]
+
+# Notes:
+# - Build this image in a secure builder (with network access to pip and registries).
+# - Ensure the target cluster has NVIDIA drivers (NVIDIA GPU Operator recommended).
+# - Test images on a staging GPU node before promoting to production.
+
