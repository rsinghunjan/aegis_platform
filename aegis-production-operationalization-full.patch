+#!/usr/bin/env python3
+"""
+Request insurer signoff helper:
+ - Uploads provided audit package to evidence bucket (if local)
+ - Stores binder reference in Vault (vault kv put ...)
+ - Notifies insurer webhook with metadata and requested action (sign / review)
+"""
+import os, subprocess, json, sys
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+INSURER_WEBHOOK = os.environ.get("INSURER_WEBHOOK","")
+VAULT_INSURANCE_PATH = os.environ.get("VAULT_INSURANCE_PATH","secret/data/aegis/insurance")
+
+def upload_binder(path):
+    if path.startswith("s3://") or path.startswith("gs://"):
+        return path
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        dest = f"{EVIDENCE_BUCKET}/insurance/{os.path.basename(path)}"
+        subprocess.check_call(["aws","s3","cp", path, dest])
+        return dest
+    return None
+
+def store_vault(key, metadata):
+    subprocess.check_call(["vault","kv","put", f"{VAULT_INSURANCE_PATH}/{key}", f"metadata={json.dumps(metadata)}"])
+
+def notify_insurer(payload):
+    if INSURER_WEBHOOK:
+        subprocess.check_call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps(payload), INSURER_WEBHOOK])
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("Usage: request_insurer_signoff.py <binder.pdf> [notes]")
+        sys.exit(2)
+    binder = sys.argv[1]
+    notes = sys.argv[2] if len(sys.argv)>2 else ""
+    uri = upload_binder(binder)
+    meta = {"binder_uri": uri, "submitted_at": subprocess.check_output(["date","-u"]).decode().strip(), "notes": notes}
+    key = f"binder-{int(__import__('time').time())}"
+    store_vault(key, meta)
+    notify_insurer({"binder": meta})
+    print("Notified insurer and stored binder metadata in Vault under", key)
+
