+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Operator-run HSM KMS rotation orchestration
+# Steps:
+#  1) Create new key(s) in KMS/HSM (via cloud console or CLI) — operator task
+#  2) Put new key refs into Vault under secret/data/aegis/kms/tmp
+#  3) Run this script to atomically update COSIGN_KEY_REFS and re-sign critical artifacts
+#  4) Verify new signatures; retire old keys when safe
+VAULT_TMP_PATH=${VAULT_TMP_PATH:-secret/data/aegis/kms/tmp}
+VAULT_MAIN_PATH=${VAULT_MAIN_PATH:-secret/data/aegis/kms}
+RE_SIGN_LIST=${RE_SIGN_LIST:-/tmp/re_sign_list.txt}
+
+if [ ! -f "$RE_SIGN_LIST" ]; then
+  echo "Create $RE_SIGN_LIST with list of artifacts to re-sign (one per line)."
+  exit 2
+fi
+
+echo "Confirming tmp key refs in Vault at $VAULT_TMP_PATH"
+vault kv get -format=json "${VAULT_TMP_PATH}" || { echo "tmp keys not found"; exit 1; }
+
+echo "Reading new key refs..."
+KEYS_JSON=$(vault kv get -format=json "${VAULT_TMP_PATH}" | jq -r '.data.data.cosign_key_refs // ""')
+if [ -z "$KEYS_JSON" ]; then
+  echo "No cosign_key_refs in tmp path; aborting"
+  exit 1
+fi
+
+echo "Backing up existing keys to ${VAULT_MAIN_PATH}/backup-$(date +%s)"
+vault kv get -format=json "${VAULT_MAIN_PATH}" > /tmp/aegis_keys_backup.json || true
+
+echo "Updating main Vault entry with new keys (operator confirm required)"
+vault kv put "${VAULT_MAIN_PATH}" cosign_key_refs="$KEYS_JSON"
+
+echo "Re-signing artifacts listed in $RE_SIGN_LIST"
+while IFS= read -r ART || [ -n "$ART" ]; do
+  [ -z "$ART" ] && continue
+  echo "Processing $ART"
+  # download if remote
+  TMPDIR=$(mktemp -d)
+  if [[ "$ART" == s3://* ]]; then
+    aws s3 cp "$ART" "$TMPDIR/art" || true
+    ART_LOCAL="$TMPDIR/art"
+  elif [[ "$ART" == gs://* ]]; then
+    gsutil cp "$ART" "$TMPDIR/art" || true
+    ART_LOCAL="$TMPDIR/art"
+  else
+    ART_LOCAL="$ART"
+  fi
+  python3 ops/hsm/multi_sign_orchestrator.py "$ART_LOCAL" "$KEYS_JSON"
+done < "$RE_SIGN_LIST"
+
+echo "Re-sign complete — please verify a sample artifact and then retire old keys per policy."
+
