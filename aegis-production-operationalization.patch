+#!/usr/bin/env bash
+set -euo pipefail
+CLUSTER_PROVIDER=${1:-gke} # gke | eks | aks
+
+case "$CLUSTER_PROVIDER" in
+  gke)
+    echo "GKE: enable cluster autoscaler via GKE nodepool autoscaling or install cluster-autoscaler helm chart"
+    ;;
+  eks)
+    echo "EKS: Install cluster-autoscaler helm chart and configure IAM role for autoscaler"
+    helm repo add autoscaler https://kubernetes.github.io/autoscaler
+    helm repo update
+    helm install cluster-autoscaler autoscaler/cluster-autoscaler --namespace kube-system
+    ;;
+  aks)
+    echo "AKS: use AKS nodepool autoscaling or install cluster-autoscaler with appropriate cloud provider settings"
+    ;;
+  *)
+    echo "Provider not supported"
+    exit 2
+    ;;
+esac
+
+echo "After install: configure cloud autoscaler group to allow GPU node scale-up for load."
+
