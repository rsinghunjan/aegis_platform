+set -euo pipefail
+echo "Runtime validation summary:"
+if command -v nvidia-smi >/dev/null 2>&1; then
+  echo "NVIDIA GPU detected"
+fi
+if [ -d /opt/neuron ] || command -v neuron-rtr >/dev/null 2>&1; then
+  echo "AWS Neuron runtime detected"
+fi
+if [ -d /opt/graphcore ] || [ -n "${GRAPHCORE:-}" ]; then
+  echo "Graphcore Poplar runtime hint detected"
+fi
+if [ -d /opt/habanalabs ] || [ -n "${HABANA:-}" ]; then
+  echo "Habana runtime hint detected"
+fi
+if [ -d /usr/lib/edgetpu ] || [ -n "${EDGENTPU:-}" ]; then
+  echo "Edge NPU runtime hint detected"
