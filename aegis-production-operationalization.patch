+#!/usr/bin/env bash
+set -euo pipefail
+NEW_KMS_URI=${1:-}
+if [ -z "$NEW_KMS_URI" ]; then
+  echo "Usage: $0 <NEW_COSIGN_KMS_URI>"
+  exit 2
+fi
+echo "Storing new KMS URI into Vault (operator must set VAULT_ADDR and VAULT_TOKEN)"
+vault kv put secret/aegis/cosign_kms uri="$NEW_KMS_URI"
+echo "Trigger CI job or rotate secrets to point to $NEW_KMS_URI"
+echo "Smoke-sign test artifact:"
+echo "test" > /tmp/cosign_rotate_test.txt
+cosign sign --key "$NEW_KMS_URI" /tmp/cosign_rotate_test.txt
+cosign verify --key "$NEW_KMS_URI" /tmp/cosign_rotate_test.txt && echo "Sign/Verify OK"
+
