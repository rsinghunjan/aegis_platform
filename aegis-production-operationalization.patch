+#!/usr/bin/env bash
+set -euo pipefail
+IMAGE=${1:-aegis/async-inference:gpu-validated}
+REGISTRY=${2:-}
+
+echo "Building CUDA-enabled inference image: $IMAGE"
+docker build -f ops/hw/dockerfiles/Dockerfile.cuda -t "$IMAGE" .
+if [ -n "$REGISTRY" ]; then
+  docker tag "$IMAGE" "$REGISTRY/$IMAGE"
+  docker push "$REGISTRY/$IMAGE"
+fi
+echo "Done. Ensure target nodes have matching NVIDIA drivers (GPU Operator recommended)."
+
