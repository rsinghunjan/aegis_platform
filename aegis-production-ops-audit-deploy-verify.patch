+#!/usr/bin/env bash
+#
+# Run IAM linter against provided terraform output or policy files and create GH issues for findings.
+#
+set -euo pipefail
+if [ $# -lt 1 ]; then
+  echo "Usage: $0 <policy-file-1.json> [policy-file-2.json ...]"
+  exit 2
+fi
+FILES=("$@")
+
+python3 - <<PY
+import subprocess, json, sys
+files = ${json.dumps(FILES)}
+findings = []
+for f in files:
+    try:
+        out = subprocess.check_output(["python3","ops/security/iam_linter.py",f], stderr=subprocess.STDOUT)
+    except subprocess.CalledProcessError as e:
+        findings.append((f, e.output.decode()))
+if findings:
+    for f,txt in findings:
+        print("Found issues in",f)
+        print(txt)
+        # create GitHub issue for each (best-effort)
+        try:
+            subprocess.check_call(["gh","issue","create","--title",f"IAM policy issue: {f}","--body",txt,"--label","security"])
+        except Exception as e:
+            print("gh issue create failed:", e)
+    sys.exit(1)
+print("No IAM wildcard findings (basic check)")
+PY
