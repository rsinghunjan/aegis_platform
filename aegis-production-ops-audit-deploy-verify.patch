+#!/usr/bin/env bash
+#
+# Ingest auditor findings JSON, create remediation issues and optionally attach remediation evidence.
+#
+set -euo pipefail
+FINDINGS_JSON=${1:-}
+if [ -z "$FINDINGS_JSON" ]; then
+  echo "Usage: $0 findings.json"
+  exit 2
+fi
+
+echo "Uploading findings JSON to evidence bucket and creating remediation issues..."
+if [ -n "${EVIDENCE_BUCKET:-}" ]; then
+  aws s3 cp "$FINDINGS_JSON" "s3://${EVIDENCE_BUCKET%/}/audit/findings/$(basename $FINDINGS_JSON)" || true
+fi
+
+# create issues using existing script
+python3 - <<PY
+import json, subprocess, os
+j = json.load(open("$FINDINGS_JSON"))
+for f in j.get("findings", []):
+    title = "[AUDIT] " + f.get("title", "Unnamed")
+    body = f.get("description","") + "\n\nEvidence: " + ", ".join(f.get("evidence",[]))
+    try:
+        subprocess.check_call(["gh","issue","create","--title",title,"--body",body,"--label","audit"])
+    except Exception as e:
+        print("Failed to create issue:", e)
+print("Audit findings ingested.")
+PY
+
+echo "Done."
+
