+#!/usr/bin/env bash
+#
+# Run the large scenario simulator, execute the rollback proof against the provided cluster,
+# collect all evidence artifacts, sign & upload them to evidence S3 and register with Rekor.
+#
+set -euo pipefail
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+MOFN_URL=${MOFN_URL:-}
+FL_CONTROLLER=${FL_CONTROLLER:-}
+CANARY_NAME=${CANARY_NAME:-}
+NAMESPACE=${NAMESPACE:-aegis}
+
+echo "Running large scenario simulator..."
+python3 ops/simulation/large_scenario_simulator.py || true
+
+echo "Running automated rollback proof against cluster..."
+bash ops/safety/automated_rollback_proof.sh "${CANARY_NAME}" "${NAMESPACE}" 300 || true
+
+TMP=/tmp/aegis_full_proof_$(date +%s)
+mkdir -p "$TMP"
+cp /tmp/sim_*.json "$TMP/" 2>/dev/null || true
+cp /tmp/mofn_req_*.json "$TMP/" 2>/dev/null || true
+tar -czf "${TMP}.tar.gz" -C /tmp "$(basename "$TMP")"
+
+if [ -n "${COSIGN_KMS_URI:-}" ]; then
+  cosign sign-blob --key "${COSIGN_KMS_URI}" "${TMP}.tar.gz" || true
+fi
+
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  aws s3 cp "${TMP}.tar.gz" "s3://${EVIDENCE_BUCKET%/}/proofs/$(basename "${TMP}.tar.gz")" || true
+fi
+
+if command -v rekor-cli >/dev/null 2>&1; then
+  rekor-cli upload --artifact "${TMP}.tar.gz" || true
+fi
+
+echo "Full proof artifacts packaged: ${TMP}.tar.gz"
+
