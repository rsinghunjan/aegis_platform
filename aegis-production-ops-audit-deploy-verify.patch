+#!/usr/bin/env python3
+"""
+Toggle DP-first enforcement for production and record stakeholder sign-off.
+
+Usage:
+  python3 ops/audit/enforce_dp_first_and_record_signoff.py --env production --approvers alice@example.com,bob@example.com --approver-note "Approved to enforce DP-first until MPC audit complete"
+
+Behavior:
+ - Edits config/dp_policy.yaml to set dp_first: true for the specified environment (creates backup).
+ - Generates a signed manifest describing the change, uploads to evidence S3 (if EVIDENCE_BUCKET set) and registers with Rekor (if rekor-cli available).
+ - Creates a GitHub issue requesting stakeholder sign-off and records approvers in issue body.
+ - Outputs the path to the manifest and Rekor UUID (if registered).
+
+Requirements:
+ - GITHUB_TOKEN or gh authenticated
+ - Optional: COSIGN_KMS_URI for cosign signing, EVIDENCE_BUCKET for S3 upload, rekor-cli for Rekor registration.
+"""
+import argparse
+import os
+import yaml
+import json
+import subprocess
+import time
+from pathlib import Path
+
+DP_POLICY_PATH = "config/dp_policy.yaml"
+
+def backup_file(path):
+    p = Path(path)
+    b = p.with_suffix(p.suffix + f".bak.{int(time.time())}")
+    p.replace(b)
+    return b
+
+def write_policy(path, dp_first):
+    d = {}
+    if Path(path).exists():
+        d = yaml.safe_load(Path(path).read_text()) or {}
+    d["dp_first"] = bool(dp_first)
+    Path(path).write_text(yaml.safe_dump(d))
+    return d
+
+def create_manifest(action, details):
+    ts = int(time.time())
+    m = {"action": action, "details": details, "ts": ts}
+    out = f"/tmp/dp_first_manifest_{ts}.json"
+    Path(out).write_text(json.dumps(m, indent=2))
+    return out
+
+def sign_and_upload(manifest_path, evidence_bucket=None):
+    rekor_uuid = None
+    if os.environ.get("COSIGN_KMS_URI"):
+        try:
+            subprocess.check_call(["cosign","sign-blob","--key",os.environ["COSIGN_KMS_URI"], manifest_path])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    if evidence_bucket:
+        try:
+            s3uri = f"s3://{evidence_bucket.rstrip('/')}/dp_policy/"
+            subprocess.check_call(["aws","s3","cp",manifest_path, s3uri])
+        except Exception as e:
+            print("s3 upload failed:", e)
+    try:
+        if subprocess.call(["which","rekor-cli"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
+            out = subprocess.check_output(["rekor-cli","upload","--artifact",manifest_path])
+            try:
+                j = json.loads(out.decode())
+                rekor_uuid = j.get("uuid") or list(j.keys())[0] if isinstance(j, dict) else None
+            except Exception:
+                rekor_uuid = None
+    except Exception as e:
+        print("rekor upload failed:", e)
+    return rekor_uuid
+
+def create_github_issue(title, body):
+    try:
+        subprocess.check_call(["gh","issue","create","--title", title, "--body", body, "--label", "dp-first"])
+    except Exception as e:
+        print("gh issue create failed:", e)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--env", default="production")
+    p.add_argument("--approvers", required=True, help="comma-separated approver emails")
+    p.add_argument("--approver-note", default="DP-first enforced per policy")
+    args = p.parse_args()
+
+    backup = None
+    if Path(DP_POLICY_PATH).exists():
+        backup = backup_file(DP_POLICY_PATH)
+        print("Backed up", DP_POLICY_PATH, "->", backup)
+
+    policy = write_policy(DP_POLICY_PATH, True)
+    print("Wrote dp_policy:", policy)
+
+    manifest = create_manifest("enforce_dp_first", {"env": args.env, "approvers": args.approvers.split(","), "note": args.approver_note})
+    print("Created manifest:", manifest)
+
+    rekor_uuid = sign_and_upload(manifest, os.environ.get("EVIDENCE_BUCKET"))
+    if rekor_uuid:
+        print("Registered manifest in Rekor:", rekor_uuid)
+
+    issue_title = f"[DP-FIRST] Enforce DP-first in {args.env} (stakeholder sign-off required)"
+    issue_body = f"""We have enabled DP-first in {args.env} to disable MPC until an external crypto audit is complete.

+Approvers requested:
+{args.approvers}
+
+Note: {args.approver_note}
+
+Manifest: {manifest}
+Rekor UUID: {rekor_uuid or '<not-registered>'}
+
+Please respond to this issue with approval (comment 'approve' or attach signed approval).
+"""
+    create_github_issue(issue_title, issue_body)
+    print("Created GitHub issue requesting sign-off (or attempted).")
+
+if __name__=="__main__":
+    main()
+
