+STAGING_DB_USER=${STAGING_DB_USER:-rekor}
+STAGING_DB_PASSWORD=${STAGING_DB_PASSWORD:-password}
+NAMESPACE=${NAMESPACE:-rekor}
+
+echo "Starting Rekor restore drill..."
+TMP=/tmp/rekor.restore.dump
+LATEST=$(aws s3 ls ${S3_BUCKET}/ | sort | tail -n1 | awk '{print $4}')
+if [ -z "${LATEST}" ]; then echo "No backup found in ${S3_BUCKET}"; exit 2; fi
+echo "Found backup: ${LATEST}"
+aws s3 cp "${S3_BUCKET}/${LATEST}" "${TMP}"
+export PGPASSWORD=${STAGING_DB_PASSWORD}
+pg_restore -h ${STAGING_DB_HOST} -U ${STAGING_DB_USER} -d rekor --clean "${TMP}"
+
+echo "Restarting Rekor in namespace ${NAMESPACE}"
+kubectl -n ${NAMESPACE} rollout restart deployment/rekor-server
+kubectl -n ${NAMESPACE} rollout status deployment/rekor-server --timeout=120s
+
+echo "Validating Rekor API"
+curl -sSk https://rekor.staging.internal/api/v1/log/log_info | jq .
+
+echo "Rotating TLS certificate: generate new cert (or use cert-manager) and apply"
+if [ -f ./rekor.crt ] && [ -f ./rekor.key ]; then
+  kubectl -n ${NAMESPACE} create secret tls rekor-tls --cert=./rekor.crt --key=./rekor.key --dry-run=client -o yaml | kubectl apply -f -
+  kubectl -n ${NAMESPACE} rollout restart deployment/rekor-server
+  echo "TLS secret updated from ./rekor.crt/./rekor.key"
+else
+  echo "No ./rekor.crt or ./rekor.key found; skipping TLS secret rotation step."
+fi
+
+echo "Verify TLS handshake using curl with CA (adjust CA path if internal CA used):"
+curl -sSk https://rekor.staging.internal/api/v1/log/log_info | jq .
