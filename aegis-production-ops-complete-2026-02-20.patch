+#!/usr/bin/env python3
+"""
+Feast consistency validation:
+ - For a sample set of entity keys, compare offline batch-joined features (from snapshot) to online store retrievals.
+ - Report mismatches and percent agreement.
+"""
+import os, pandas as pd
+from feast import FeatureStore
+import json
+
+REPO_PATH = os.environ.get("FEAST_REPO","./featurestore/feast")
+KEYS_SAMPLE_CSV = os.environ.get("KEYS_SAMPLE","/tmp/keys_sample.csv")
+OFFLINE_SNAPSHOT_JSON = os.environ.get("OFFLINE_SNAPSHOT","/tmp/offline_snapshot.json")
+
+def run_check():
+    fs = FeatureStore(repo_path=REPO_PATH)
+    keys = pd.read_csv(KEYS_SAMPLE_CSV)
+    with open(OFFLINE_SNAPSHOT_JSON) as f:
+        offline = pd.DataFrame(json.load(f))
+    entity_rows = [{"customer_id": int(r.customer_id)} for _, r in keys.iterrows()]
+    online = fs.get_online_features(features=["customer:avg_order_value","customer:order_count"], entity_rows=entity_rows).to_df()
+    merged = keys.merge(online.reset_index(), left_on="customer_id", right_on="customer_id", how="left")
+    merged = merged.merge(offline, on="customer_id", how="left", suffixes=("_online","_offline"))
+    merged["match"] = merged["customer:avg_order_value_online"] == merged["customer:avg_order_value_offline"]
+    matches = merged["match"].sum()
+    total = len(merged)
+    print(f"Matches: {matches}/{total} ({(matches/total)*100:.2f}%)")
+    mismatches = merged[~merged["match"]]
+    if not mismatches.empty:
+        print("Mismatches sample:")
+        print(mismatches.head().to_dict(orient="records"))
+    return merged
+
+if __name__ == "__main__":
+    run_check()
+
