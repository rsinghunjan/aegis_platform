+#!/usr/bin/env python3
+"""
+Produce messages to a topic at high rate to test DLQ behavior under failure.
+"""
+from confluent_kafka import Producer
+import os, time, json
+
+BOOT = os.environ.get("KAFKA_BOOTSTRAP_SERVERS","kafka.bootstrap.svc:9093")
+TOPIC = os.environ.get("KAFKA_TOPIC","mcp-events")
+RATE = int(os.environ.get("DLQ_TEST_RATE", 1000))  # messages per second approx
+NUM = int(os.environ.get("DLQ_TEST_COUNT", 10000))
+
+conf = {'bootstrap.servers': BOOT}
+p = Producer(conf)
+
+def delivery(err, msg):
+    if err:
+        print("Delivery failed:", err)
+
+for i in range(NUM):
+    payload = {"id": i, "payload": "x" * 2000}
+    p.produce(TOPIC, json.dumps(payload).encode(), callback=delivery)
+    p.poll(0)
+    if i % 1000 == 0:
+        print("Produced", i)
+    time.sleep(1.0/RATE)
+
+p.flush()
+print("Load test complete.")
+
