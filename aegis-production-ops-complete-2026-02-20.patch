+#!/usr/bin/env python3
+"""
+Automate import of external pentest findings (JSON) into the issue tracker and generate triage tickets with templated metadata.
+"""
+import os, sys, json, requests
+
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN")
+REPO = os.environ.get("REPO","yourorg/aegis")
+API = "https://api.github.com"
+
+def create_issue(title, body, labels, assignees=None):
+    url = f"{API}/repos/{REPO}/issues"
+    payload = {"title": title, "body": body, "labels": labels or []}
+    if assignees:
+        payload["assignees"] = assignees
+    r = requests.post(url, json=payload, headers={"Authorization": f"token {GITHUB_TOKEN}"})
+    r.raise_for_status()
+    return r.json()
+
+def import_findings(path):
+    data = json.load(open(path))
+    for f in data.get("findings", []):
+        title = f"[PENTEST] {f.get('title')}"
+        severity = f.get("severity","medium")
+        body = f"**Severity:** {severity}\n\n**Description:**\n{f.get('description','')}\n\n**POC:**\n```\n{f.get('poc','')}\n```"
+        labels = ["security","pentest", severity]
+        owner = f.get("owner")
+        assignees = [owner] if owner else []
+        issue = create_issue(title, body, labels, assignees)
+        print("Created issue:", issue.get("html_url"))
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        print("Usage: import_and_triage.py findings.json")
+        sys.exit(2)
+    import_findings(sys.argv[1])
+
