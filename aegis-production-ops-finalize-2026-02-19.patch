+#!/usr/bin/env python3
+"""
+Durable DLQ consumer with exponential backoff retry to primary endpoint, dead-letter to S3 on persistent failure,
+and metrics for monitoring.
+"""
+import os, json, time, math, logging
+import requests
+from confluent_kafka import Consumer, KafkaError
+from prometheus_client import start_http_server, Counter, Gauge
+
+BOOT = os.environ.get("KAFKA_BOOTSTRAP_SERVERS","kafka.bootstrap.svc:9093")
+DLQ = os.environ.get("KAFKA_DLQ_TOPIC","mcp-events-dlq")
+RETRY_EP = os.environ.get("DLQ_RETRY_ENDPOINT","http://mcp.mcp.svc.cluster.local:8000/retry")
+MAX_RETRIES = int(os.environ.get("DLQ_MAX_RETRIES","5"))
+S3_BUCKET = os.environ.get("DLQ_S3_BUCKET","s3://aegis-dlq-deadletters")
+
+c_success = Counter("dlq_retry_success_total","DLQ retry successes")
+c_failure = Counter("dlq_retry_failure_total","DLQ retry permanent failures")
+g_backlog = Gauge("dlq_backlog","Number of messages currently in DLQ backlog")
+
+consumer = Consumer({
+  'bootstrap.servers': BOOT,
+  'group.id': 'mcp-dlq-retry',
+  'auto.offset.reset': 'earliest'
+})
+consumer.subscribe([DLQ])
+start_http_server(9401)
+
+def deadletter_to_s3(payload, prefix="deadletter"):
+    # Placeholder: use AWS SDK to upload JSON with metadata
+    key = f"{prefix}/{int(time.time())}.json"
+    print(f"Would upload to S3: {S3_BUCKET}/{key}")
+
+while True:
+    msg = consumer.poll(1.0)
+    if msg is None:
+        continue
+    if msg.error():
+        if msg.error().code() == KafkaError._PARTITION_EOF:
+            continue
+        logging.error("Kafka error: %s", msg.error()); break
+    payload = json.loads(msg.value().decode())
+    attempts = payload.get("_dlq_attempts", 0)
+    success = False
+    try:
+        backoff = math.pow(2, attempts)
+        time.sleep(min(backoff, 30))
+        r = requests.post(RETRY_EP, json=payload, timeout=10)
+        if r.status_code < 400:
+            c_success.inc()
+            success = True
+        else:
+            attempts += 1
+    except Exception as e:
+        attempts += 1
+    if not success:
+        if attempts >= MAX_RETRIES:
+            c_failure.inc()
+            deadletter_to_s3(payload)
+        else:
+            # re-publish with attempts metadata to a retry topic or leave in DLQ depending on broker semantics
+            payload["_dlq_attempts"] = attempts
+            print("Would requeue with attempts", attempts)
+    g_backlog.set(0)  # Placeholder for actual backlog gauge
+
