+#!/usr/bin/env bash
+set -euo pipefail
+S3_BUCKET=${1:-s3://aegis-rekor-backups}
+STAGING_PG_HOST=${STAGING_PG_HOST:-postgres-staging.rekor.svc.cluster.local}
+STAGING_PG_USER=${STAGING_PG_USER:-rekor}
+STAGING_PG_PASSWORD=${STAGING_PG_PASSWORD:-password}
+
+TMP=/tmp/rekor.restore.dump
+LATEST=$(aws s3 ls ${S3_BUCKET}/ | sort | tail -n1 | awk '{print $4}')
+if [ -z "${LATEST}" ]; then echo "No backups found"; exit 1; fi
+aws s3 cp "${S3_BUCKET}/${LATEST}" "${TMP}"
+export PGPASSWORD=${STAGING_PG_PASSWORD}
+pg_restore -h ${STAGING_PG_HOST} -U ${STAGING_PG_USER} -d rekor --clean "${TMP}"
+kubectl -n rekor rollout restart deployment/rekor-server
+sleep 8
+curl -sSk "https://rekor.staging.internal/api/v1/log/log_info" | jq .
+echo "Restore automation complete."
+
