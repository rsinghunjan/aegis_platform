+#!/usr/bin/env python3
+"""
+Federated orchestrator prototype: accepts JSON weight vectors, aggregates with DP, records to MCP.
+Production: replace with secure aggregation library and authenticated enrollment.
+"""
+import os, json, time
+from flask import Flask, request, jsonify
+import numpy as np, requests
+
+app = Flask(__name__)
+MODEL_STORE = "/data/federated"
+os.makedirs(MODEL_STORE, exist_ok=True)
+GLOBAL = None; ROUND = 0
+
+def save_global(arr):
+    json.dump(arr.tolist(), open(os.path.join(MODEL_STORE,"global.json"),"w"))
+
+@app.route("/submit", methods=["POST"])
+def submit():
+    global GLOBAL, ROUND
+    j = request.json or {}
+    update = np.array(j.get("weights", []))
+    scale = float(j.get("scale", 1.0))
+    if GLOBAL is None:
+        GLOBAL = update * scale
+    else:
+        GLOBAL = (GLOBAL + update * scale)/2.0
+    # apply Gaussian noise
+    eps = float(os.environ.get("DP_EPSILON", "1.0"))
+    sigma = 1.0 / max(eps, 1e-6)
+    noisy = GLOBAL + np.random.normal(0,sigma,GLOBAL.shape)
+    save_global(noisy)
+    ROUND += 1
+    try:
+        mcp = os.environ.get("AEGIS_MCP_API","")
+        if mcp:
+            requests.post(f"{mcp.rstrip('/')}/federated/rounds", json={"round":ROUND,"ts":time.time()}, timeout=2.0)
+    except Exception:
+        pass
+    return jsonify({"status":"ok","round":ROUND})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8085")))
+
