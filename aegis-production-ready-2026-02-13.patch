+#!/usr/bin/env python3
+import os, time, requests
+
+FAILED_DIR = os.environ.get("FAILED_DIR", "/data/sync_failed")
+BASE = int(os.environ.get("RETRY_INTERVAL_BASE", "5"))
+MAX_ATTEMPTS = int(os.environ.get("MAX_ATTEMPTS", "6"))
+CENTRAL_UPLOAD = os.environ.get("CENTRAL_UPLOAD_URL", "https://milvus.central.svc.cluster.local/sync")
+os.makedirs(FAILED_DIR, exist_ok=True)
+
+def backoff(attempt): return BASE * (2 ** attempt)
+
+def retry_loop():
+    while True:
+        for fn in os.listdir(FAILED_DIR):
+            path = os.path.join(FAILED_DIR, fn)
+            meta = path + ".meta"
+            attempts = int(open(meta).read()) if os.path.exists(meta) else 0
+            if attempts >= MAX_ATTEMPTS:
+                print("Max attempts reached for", fn); continue
+            try:
+                data = open(path,"rb").read()
+                r = requests.post(CENTRAL_UPLOAD, data=data, timeout=10)
+                if r.ok:
+                    os.remove(path); os.path.exists(meta) and os.remove(meta); print("Resync success", fn)
+                else:
+                    attempts += 1; open(meta,"w").write(str(attempts)); time.sleep(backoff(attempts))
+            except Exception as e:
+                print("Error", e); time.sleep(5)
+        time.sleep(10)
+
+if __name__ == "__main__":
+    retry_loop()
+
