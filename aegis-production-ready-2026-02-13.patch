+helm repo update
+
+cat > /tmp/vault-values.yaml <<EOF
+server:
+  ha:
+    enabled: true
+  extraEnvironmentVars:
+    VAULT_AWSKMS_KEY_ID: "${AWS_KMS_KEY_ID}"
+  dataStorage:
+    enabled: true
+  standalone:
+    enabled: false
+autoUnseal:
+  enabled: true
+  awsKms:
+    kmsKeyId: "${AWS_KMS_KEY_ID}"
+service:
+  type: ClusterIP
+ui:
+  enabled: true
+injector:
+  enabled: true
+EOF
