+#!/usr/bin/env python3
+"""Collect Gatekeeper violations and post remediation report to MCP."""
+import os, subprocess, json, tempfile, csv, requests
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def collect_violations():
+    r = subprocess.run(["kubectl","get","constraints","--all-namespaces","-o","json"], capture_output=True, text=True)
+    if r.returncode != 0:
+        return []
+    cj = json.loads(r.stdout)
+    violations = []
+    for item in cj.get("items", []):
+        for v in item.get("status", {}).get("violations", []):
+            violations.append({
+                "constraint": item["metadata"]["name"],
+                "namespace": v.get("namespace"),
+                "resource": f'{v.get("kind")}/{v.get("name")}',
+                "message": v.get("message")
+            })
+    return violations
+
+def post_to_mcp(violations):
+    if not violations:
+        print("No violations")
+        return
+    payload = {"ts": __import__("time").time(), "violations": violations}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/governance/gatekeeper_violations", json=payload, timeout=5.0)
+        print("Posted to MCP")
+    except Exception:
+        fd, path = tempfile.mkstemp(prefix="gatekeeper_", suffix=".csv")
+        with os.fdopen(fd,"w",newline="") as csvfile:
+            w = csv.DictWriter(csvfile, fieldnames=["constraint","namespace","resource","message"])
+            w.writeheader()
+            for v in violations:
+                w.writerow(v)
+        print("Wrote CSV to", path)
+
+if __name__ == "__main__":
+    vs = collect_violations()
+    post_to_mcp(vs)
+
