+#!/usr/bin/env python3
+"""
+Advanced claim extractor and factuality scorer using an LLM-based claim extraction + embedding similarity.
+ - Uses LLM_PROXY to extract atomic claims from a response.
+ - Uses EMBEDDING_ENDPOINT to compute embeddings for claims and then compares them to RAG retrieved contexts' embeddings.
+ - Produces per-claim support scores and an explainable verdict to drive escalation or auto-acceptance.
+
+Environment:
+ - LLM_PROXY_URL (for claim extraction)
+ - EMBEDDING_URL (service that returns embeddings for a text)
+ - RAG_URL (retrieve supporting docs)
+ - SUPPORT_THRESHOLD (0..1)
+"""
+import os, requests, json, time
+
+LLM_PROXY = os.environ.get("LLM_PROXY_URL", "http://llm-proxy:8083")
+EMBEDDING_URL = os.environ.get("EMBEDDING_URL", "http://embeddings:8087/encode")
+RAG_URL = os.environ.get("RAG_URL", "http://rag:8082")
+SUPPORT_THRESHOLD = float(os.environ.get("SUPPORT_THRESHOLD", "0.6"))
+
+def call_llm_extract(text: str):
+    prompt = f"Extract a JSON array of atomic factual claims from the following text:\n\n{text}\n\nReturn JSON array."
+    r = requests.post(f"{LLM_PROXY.rstrip('/')}/v1/generate", json={"prompt": prompt, "max_tokens": 512}, timeout=20)
+    r.raise_for_status()
+    out = r.json().get("text") if r.headers.get("content-type","").startswith("application/json") else r.text
+    try:
+        claims = json.loads(out)
+        if isinstance(claims, list):
+            return [c.strip() for c in claims if isinstance(c, str)]
+    except Exception:
+        # fallback: naive sentence split
+        import re
+        return [s.strip() for s in re.split(r'[.?!\n]+', text) if s.strip()][:20]
+
+def get_embedding(text):
+    r = requests.post(EMBEDDING_URL, json={"text": text}, timeout=10)
+    r.raise_for_status()
+    return r.json().get("embedding", [])
+
+def score_claim_with_evidence(claim: str, top_k=5):
+    # compute claim embedding
+    emb = get_embedding(claim)
+    # ask RAG for top_k docs (RAG may accept embedding or text)
+    r = requests.post(f"{RAG_URL}/retrieve", json={"embedding": emb, "top_k": top_k}, timeout=6)
+    r.raise_for_status()
+    hits = r.json().get("hits", [])
+    # compute similarity between claim emb and each hit's embedding (if provided)
+    best = 0.0
+    evidence = []
+    for h in hits:
+        meta = h.get("meta", {})
+        hit_emb = h.get("embedding")
+        score = 0.0
+        if hit_emb:
+            # cosine similarity
+            import math
+            dot = sum(a*b for a,b in zip(emb, hit_emb))
+            na = math.sqrt(sum(a*a for a in emb))
+            nb = math.sqrt(sum(b*b for b in hit_emb))
+            if na>0 and nb>0:
+                score = dot / (na*nb)
+        else:
+            # fallback: use hit.score if present
+            score = float(h.get("score", 0.0))
+        if score > best:
+            best = score
+        evidence.append({"meta": meta, "score": score})
+    return {"claim": claim, "support": best, "evidence": evidence}
+
+def verify_response(response_text: str, min_support_ratio: float = 0.6):
+    claims = call_llm_extract(response_text)
+    scored = [score_claim_with_evidence(c) for c in claims]
+    supported = [s for s in scored if s["support"] >= SUPPORT_THRESHOLD]
+    ratio = (len(supported)/len(scored)) if scored else 0.0
+    verdict = "supported" if ratio >= min_support_ratio else "hallucination"
+    return {"verdict": verdict, "ratio": ratio, "claims": scored}
+
+if __name__ == "__main__":
+    import sys
+    txt = sys.stdin.read() if not sys.stdin.isatty() else " ".join(sys.argv[1:])
+    print(json.dumps(verify_response(txt), indent=2))
+
