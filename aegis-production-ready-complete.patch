+#!/usr/bin/env bash
+set -euo pipefail
+# Sync produced key refs (from Terraform outputs) into Vault for consumption by cosign helpers and services.
+#
+# Usage:
+#  export VAULT_ADDR=... VAULT_TOKEN=...
+#  ops/hsm/sync_keys_to_vault.sh aws_key_arn gcp_key_id azure_key_id
+AWS_KEY_REF=${1:-}
+GCP_KEY_REF=${2:-}
+AZ_KEY_REF=${3:-}
+VAULT_PATH=${VAULT_PATH:-secret/data/aegis/kms}
+
+if [ -z "$AWS_KEY_REF" ] || [ -z "$GCP_KEY_REF" ] || [ -z "$AZ_KEY_REF" ]; then
+  echo "Usage: $0 <aws_key_ref> <gcp_key_ref> <azure_key_ref>"
+  exit 2
+fi
+
+echo "Writing KMS refs to Vault at $VAULT_PATH"
+vault kv put "${VAULT_PATH}/aws" key_ref="${AWS_KEY_REF}"
+vault kv put "${VAULT_PATH}/gcp" key_ref="${GCP_KEY_REF}"
+vault kv put "${VAULT_PATH}/azure" key_ref="${AZ_KEY_REF}"
+echo "Done. Operators: update COSIGN_KEY_REFS in Vault or service configurations to include these refs."
+
