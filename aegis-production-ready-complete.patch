+#!/usr/bin/env python3
+"""
+Extended audit requester:
+ - Builds audit package
+ - Signs package with cosign (multi-sign optional)
+ - Uploads to evidence bucket and notifies insurer & auditor webhook endpoints with signed provenance
+"""
+import os, subprocess, tempfile, json
+from datetime import datetime
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+AUDITOR_WEBHOOK = os.environ.get("AUDITOR_WEBHOOK","")
+INSURER_WEBHOOK = os.environ.get("INSURER_WEBHOOK","")
+COSIGN_KEY_REFS = os.environ.get("COSIGN_KEY_REFS","") # comma-separated
+
+def package(paths, out="/tmp/aegis_audit_pkg.tar.gz"):
+    tmp = tempfile.mkdtemp()
+    for p in paths:
+        if os.path.exists(p):
+            subprocess.check_call(["cp","-r",p,tmp])
+    meta = {"collected_at": datetime.utcnow().isoformat(), "items": paths}
+    with open(tmp + "/meta.json","w") as fh: json.dump(meta, fh)
+    subprocess.check_call(["tar","-czf", out, "-C", tmp, "."])
+    return out
+
+def multi_sign(archive, keyrefs):
+    sigs = []
+    for i, k in enumerate(keyrefs.split(",")):
+        k = k.strip()
+        if not k:
+            continue
+        subprocess.check_call(["cosign","sign","--key", k, archive])
+        sigs.append(k)
+    return sigs
+
+def upload(archive):
+    if EVIDENCE_BUCKET:
+        if EVIDENCE_BUCKET.startswith("s3://"):
+            subprocess.check_call(["aws","s3","cp", archive, f"{EVIDENCE_BUCKET}/audits/{os.path.basename(archive)}"])
+            return f"{EVIDENCE_BUCKET}/audits/{os.path.basename(archive)}"
+    return None
+
+def notify(webhook, payload):
+    if webhook:
+        subprocess.check_call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps(payload), webhook])
+
+if __name__=="__main__":
+    import sys
+    paths = sys.argv[1:] or ["ops/attestation","policies","ops/repro","ops/redteam"]
+    archive = package(paths)
+    keys = COSIGN_KEY_REFS
+    sigs = multi_sign(archive, keys) if keys else []
+    uri = upload(archive)
+    payload = {"archive": uri, "signatures": sigs}
+    notify(AUDITOR_WEBHOOK, payload)
+    notify(INSURER_WEBHOOK, payload)
+    print("Audit package prepared:", uri)
+
