+#!/usr/bin/env python3
+"""
+Validate that policy engine decisions align with delegation matrix expectations.
+Produces a CI-friendly report and exits non-zero on mismatches.
+"""
+import os, yaml, requests, json, sys
+
+DELEGATION = os.environ.get("DELEGATION_MATRIX","policies/delegation_matrix.yaml")
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL","http://localhost:8085/evaluate")
+
+def load(p): return yaml.safe_load(open(p))
+
+def expected_automation(action):
+    d = load(DELEGATION)
+    return d.get("actions",{}).get(action,{}).get("automation","human_required")
+
+def map_response_to_automation(resp):
+    allow = resp.get("allow", False)
+    approval = resp.get("policy",{}).get("approval")
+    if allow and approval == "auto":
+        return "auto"
+    if approval == "auto_with_audit":
+        return "auto_with_audit"
+    return "human_required"
+
+def main():
+    pol = load(DELEGATION)
+    failures = []
+    for action in pol.get("actions",{}).keys():
+        payload = {"action": action, "actor": "aegis-test"}
+        try:
+            r = requests.post(POLICY_ENGINE, json=payload, timeout=5).json()
+        except Exception as e:
+            failures.append({"action": action, "error": str(e)})
+            continue
+        obs = map_response_to_automation(r)
+        exp = expected_automation(action)
+        if obs != exp:
+            failures.append({"action": action, "expected": exp, "observed": obs, "response": r})
+    out = {"failures": failures}
+    print(json.dumps(out, indent=2))
+    if failures:
+        sys.exit(2)
+
+if __name__=="__main__":
+    main()
+
