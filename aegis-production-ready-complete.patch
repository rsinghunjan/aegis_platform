*** Add File:ops/hsm/rotate_and_rekey.sh
+#!/usr/bin/env bash
+set -euo pipefail
+# Re-sign artifacts workflow for rotating keys (operator-driven)
+# Expects:
+#  - VAULT_ADDR/VAULT_TOKEN present
+#  - New key refs stored in Vault at secret/data/aegis/kms (aws/gcp/azure)
+#  - Re-sign list (/tmp/re_sign_list.txt) containing URIs to artifacts to re-sign
+
+VAULT_PATH=${VAULT_PATH:-secret/data/aegis/kms}
+RE_SIGN_LIST=${RE_SIGN_LIST:-/tmp/re_sign_list.txt}
+
+if [ ! -f "$RE_SIGN_LIST" ]; then
+  echo "Create $RE_SIGN_LIST with artifacts (s3:// or gs:// or local paths) to re-sign."
+  exit 2
+fi
+
+echo "Fetching new cosign refs from Vault..."
+AWS_REF=$(vault kv get -format=json "${VAULT_PATH}/aws" | jq -r '.data.data.key_ref // empty')
+GCP_REF=$(vault kv get -format=json "${VAULT_PATH}/gcp" | jq -r '.data.data.key_ref // empty')
+AZ_REF=$(vault kv get -format=json "${VAULT_PATH}/azure" | jq -r '.data.data.key_ref // empty')
+
+NEW_KEYS=$(jq -n --arg a "$AWS_REF" --arg g "$GCP_REF" --arg z "$AZ_REF" '$a + "," + $g + "," + $z')
+echo "New keys: $NEW_KEYS"
+
+while IFS= read -r ART || [ -n "$ART" ]; do
+  [ -z "$ART" ] && continue
+  echo "Re-signing $ART"
+  # download artifact to temp if remote
+  TMPDIR=$(mktemp -d)
+  if [[ "$ART" == s3://* ]]; then
+    aws s3 cp "$ART" "$TMPDIR/art" || true
+    LOCAL="$TMPDIR/art"
+  elif [[ "$ART" == gs://* ]]; then
+    gsutil cp "$ART" "$TMPDIR/art" || true
+    LOCAL="$TMPDIR/art"
+  else
+    LOCAL="$ART"
+  fi
+  python3 ops/hsm/multi_sign_orchestrator.py "$LOCAL" "$NEW_KEYS"
+done < "$RE_SIGN_LIST"
+
+echo "Re-sign finished. Verify a sample artifact with ops/hsm/multi_sign_verify.py"
+
