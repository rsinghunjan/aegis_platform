+"""
+Extended finance shadow-run orchestrator:
+ - Runs daily snapshots, computes window stats, produces a human-friendly HTML report,
+   and posts to FINANCE_WEBHOOK on promotion candidates or alerts.
+"""
+import os, json, time
+from datetime import datetime
+import psycopg2, requests
+
+RECON_DB = os.environ.get("RECONCILE_DB","")
+REPORT_DIR = os.environ.get("FIN_REPORT_DIR","/tmp/aegis_fin_reports")
+SHADOW_DAYS = int(os.environ.get("SHADOW_DAYS","30"))
+PROMOTION_THRESHOLD = float(os.environ.get("FIN_PROMOTION_THRESHOLD","0.001"))
+FINANCE_WEBHOOK = os.environ.get("FINANCE_WEBHOOK","")
+
+os.makedirs(REPORT_DIR, exist_ok=True)
+
+def daily_snapshot():
+    conn = psycopg2.connect(RECON_DB)
+    with conn.cursor() as cur:
+        cur.execute("SELECT count(*) FILTER (WHERE status!='ok') as bad, count(*) as total FROM reconciliation_log")
+        bad, total = cur.fetchone()
+    rec = {"ts": datetime.utcnow().isoformat(), "bad": int(bad), "total": int(total)}
+    fn = f"{REPORT_DIR}/snapshot_{datetime.utcnow().date().isoformat()}.json"
+    with open(fn,"w") as fh: json.dump(rec, fh)
+    return rec
+
+def window_stats(days=SHADOW_DAYS):
+    import glob
+    files = sorted(glob.glob(f"{REPORT_DIR}/snapshot_*.json"))[-days:]
+    bad = total = 0
+    for f in files:
+        j = json.load(open(f))
+        bad += j["bad"]; total += j["total"]
+    rate = bad/total if total else 0.0
+    return {"bad": bad, "total": total, "rate": rate}
+
+def publish_report(stats):
+    report = {"ts": datetime.utcnow().isoformat(), "stats": stats}
+    if FINANCE_WEBHOOK:
+        requests.post(FINANCE_WEBHOOK, json=report, timeout=5)
+    open(f"{REPORT_DIR}/summary_{int(time.time())}.json","w").write(json.dumps(report))
+
+if __name__=="__main__":
+    s = daily_snapshot()
+    stats = window_stats()
+    publish_report(stats)
+    if stats["rate"] <= PROMOTION_THRESHOLD:
+        print("Promotion candidate; notify finance lead")
+    else:
+        print("Not eligible for promotion; mismatch_rate=", stats["rate"])
