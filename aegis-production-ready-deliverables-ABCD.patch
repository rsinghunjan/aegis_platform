+"""
+import argparse, json, os, requests, time
+
+GITHUB_REPO = os.environ.get("GITHUB_REPO","")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN","")
+RAG_URL = os.environ.get("RAG_URL","http://rag:8082")
+
+def fetch_issue(issue_num):
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues/{issue_num}"
+    r = requests.get(url, headers={"Authorization": f"token {GITHUB_TOKEN}"}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def collect_from_issue(issue_num, out):
+    issue = fetch_issue(issue_num)
+    body = issue.get("body","")
+    # operator must embed structured JSON in issue body or include links
+    # For demo: create a simple record
+    record = {"id": f"issue-{issue_num}", "query": "extracted query", "response": body, "hits": [], "label": None, "annotator": None, "ts": int(time.time())}
+    if os.path.exists(out):
+        data = json.load(open(out))
+    else:
+        data = []
+    data.append(record)
+    with open(out,"w") as fh:
+        json.dump(data, fh, indent=2)
+    print("Appended record to", out)
+
+if __name__=="__main__":
