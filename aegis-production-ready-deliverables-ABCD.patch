+/*
+Production-ready Terraform scaffold for provisioning KMS/HSM keys and IAM bindings.
+This file provides provider-agnostic examples for AWS KMS (CMK), GCP KMS, and Azure Key Vault HSM-backed keys,
+and includes example IAM bindings for "signer" roles used by Aegis cosign signing agents.
+
+IMPORTANT:
+ - This is a template and MUST be reviewed by security/compliance teams before applying.
+ - Use a secure Terraform state backend (e.g., remote S3 + DynamoDB or Terraform Cloud).
+ - Provisioning HSM appliances (on-prem) or cloud-managed HSMs requires additional steps not fully captured here.
+*/
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws" }
+    google = { source = "hashicorp/google" }
+    azurerm = { source = "hashicorp/azurerm" }
+  }
+}
+
+variable "aws_region" { type = string, default = "us-west-2" }
+variable "gcp_project" { type = string, default = "" }
+variable "gcp_region" { type = string, default = "us-central1" }
+variable "azure_location" { type = string, default = "eastus" }
+variable "signer_principals" { type = list(string), default = [] }
+
+provider "aws" { region = var.aws_region }
+provider "google" { project = var.gcp_project, region = var.gcp_region }
+provider "azurerm" { features = {} }
+
+##### AWS KMS (example CMK + key policy granting sign to operator role(s))
+resource "aws_kms_key" "aegis_cosign" {
+  description             = "Aegis cosign signing key (HSM-backed CMK if using custom key store)"
+  deletion_window_in_days = 30
+  key_usage               = "SIGN_VERIFY"
+  customer_master_key_spec = "RSA_2048"
+  policy = data.aws_iam_policy_document.kms_policy.json
+  tags = { "service" = "aegis", "purpose" = "cosign" }
+}
+
+data "aws_iam_policy_document" "kms_policy" {
+  statement {
+    sid = "AllowSigners"
+    principals {
+      type = "AWS"
+      identifiers = var.signer_principals
+    }
+    actions = [
+      "kms:Sign",
+      "kms:GetPublicKey",
+      "kms:DescribeKey",
+    ]
+    resources = ["*"]
+  }
+  # Add administrative principals as needed
+}
+
+resource "aws_kms_alias" "aegis_alias" {
+  name          = "alias/aegis-cosign"
+  target_key_id = aws_kms_key.aegis_cosign.key_id
+}
+
+output "aws_cosign_key_arn" {
+  value = aws_kms_key.aegis_cosign.arn
+}
+
+##### GCP KMS
+resource "google_kms_key_ring" "aegis_ring" {
+  name     = "aegis-keyring"
+  location = var.gcp_region
+}
+
+resource "google_kms_crypto_key" "aegis_key" {
+  name     = "aegis-cosign"
+  key_ring = google_kms_key_ring.aegis_ring.id
+  rotation_period = "7776000s" # 90 days - operator should set per policy
+}
+
+output "gcp_cosign_key_id" {
+  value = google_kms_crypto_key.aegis_key.id
+}
+
+##### Azure Key Vault + HSM-protected key (example)
+resource "azurerm_resource_group" "rg" {
+  name     = "aegis-rg"
+  location = var.azure_location
+}
+
+resource "azurerm_key_vault" "aegis_vault" {
+  name                        = "aegis-kv-${replace(uuid(),"-","")}"
+  location                    = azurerm_resource_group.rg.location
+  resource_group_name         = azurerm_resource_group.rg.name
+  sku_name                    = "standard"
+  tenant_id                   = data.azurerm_client_config.current.tenant_id
+  soft_delete_enabled         = true
+  purge_protection_enabled    = false
+}
+
+resource "azurerm_key_vault_key" "aegis_key" {
+  name         = "aegis-cosign"
+  key_vault_id = azurerm_key_vault.aegis_vault.id
+  key_type     = "RSA"
+  key_size     = 2048
+  # for HSM protection use "kty" and "hsm" options where supported by provider
+}
+
+data "azurerm_client_config" "current" {}
+
+output "azure_key_id" {
+  value = azurerm_key_vault_key.aegis_key.id
+}
+
+/*
+Notes and next steps for operators:
+ - Populate variable signer_principals with exact IAM role/user ARNs that are allowed to sign (e.g., pipeline roles).
+ - For stronger protection, use provider-specific HSM offerings (AWS CloudHSM with custom key store, HSM-backed KeyVault keys, GCP CMEK with HSM).
+ - Implement Terraform state locking & secure storage, review key rotation cadence and automated re-sign playbooks.
+ - Integrate outputs with ops/hsm/sync_keys_to_vault.sh to publish key refs into Vault for services.
