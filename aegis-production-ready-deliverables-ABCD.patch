+#!/usr/bin/env python3
+"""
+Threshold tuning for claim_extractor_advanced:
+ - Loads labeled dataset (CSV with response,label)
+ - Runs claim_extractor_advanced.verify_response against each response to compute support ratio
+ - Computes ROC/Precision-Recall and recommends threshold(s) for desired precision/recall operating point
+ - Outputs metrics and a JSON thresholds file
+"""
+import argparse, csv, json, numpy as np
+from sklearn.metrics import precision_recall_curve, roc_curve, auc
+import requests, time
+
+CLAIM_SERVICE = "http://localhost:8000/verify"  # or call python module directly
+
+def score_response(response_text):
+    # call local claim_extractor_advanced endpoint if running as a service
+    try:
+        r = requests.post(CLAIM_SERVICE, json={"text": response_text}, timeout=20)
+        r.raise_for_status()
+        j = r.json()
+        return float(j.get("ratio", 0.0))
+    except Exception:
+        # fallback: return 0.0
+        return 0.0
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--csv", required=True)
+    p.add_argument("--out", default="/tmp/threshold_recommendation.json")
+    args = p.parse_args()
+    y = []
+    scores = []
+    with open(args.csv) as fh:
+        reader = csv.DictReader(fh)
+        for r in reader:
+            lbl = int(r["label"])
+            txt = r["response"]
+            s = score_response(txt)
+            y.append(lbl)
+            scores.append(s)
+    y = np.array(y)
+    scores = np.array(scores)
+    if len(y)==0:
+        print("No labeled data")
+        return
+    precision, recall, thresholds_pr = precision_recall_curve(y, scores)
+    fpr, tpr, thresholds_roc = roc_curve(y, scores)
+    roc_auc = auc(fpr, tpr)
+    # choose threshold where precision >= 0.9 and recall maximized
+    recommended = None
+    for p_val, r_val, th in zip(precision, recall, list(thresholds_pr)+[thresholds_pr[-1] if len(thresholds_pr) else 0.0]):
+        if p_val >= 0.9:
+            recommended = {"threshold": float(th), "precision": float(p_val), "recall": float(r_val)}
+            break
+    out = {"roc_auc": float(roc_auc), "recommended": recommended}
+    with open(args.out,"w") as fh: json.dump(out, fh, indent=2)
+    print("Wrote recommendation:", args.out)
+
+if __name__=="__main__":
+    main()
+
