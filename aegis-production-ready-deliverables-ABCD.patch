+#!/usr/bin/env python3
+"""
+Convert raw labels.json to training/eval dataset for threshold tuning.
+Output format: CSV with columns: id, query, response, label (1=SUPPORTED,0=HALLUCINATION)
+"""
+import json, csv, argparse
+
+def convert(infile, outfile):
+    data = json.load(open(infile))
+    with open(outfile, "w", newline='') as fh:
+        writer = csv.writer(fh)
+        writer.writerow(["id","query","response","label"])
+        for r in data:
+            lbl = r.get("label")
+            if lbl is None: continue
+            val = 1 if str(lbl).lower() in ("supported","1","true","yes") else 0
+            writer.writerow([r.get("id"), r.get("query"), r.get("response"), val])
+    print("Wrote CSV:", outfile)
+
+if __name__=="__main__":
+    import sys
+    infile = sys.argv[1]
+    outfile = sys.argv[2]
+    convert(infile, outfile)
+
