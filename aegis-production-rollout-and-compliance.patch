+# Ansible playbook to perform safe canary rollout of new worker images
+# Usage:
+#  - Update inventory groups: [workers_canary] [workers_remaining]
+#  - ansible-playbook -i inventory ops/ansible/rollout_canary_nodes.yml -e "image=ami-xxxxx"
+
+- hosts: workers_canary
+  become: true
+  tasks:
+    - name: Cordon node (via kubectl on control host)
+      local_action:
+        module: command
+        cmd: kubectl cordon {{ inventory_hostname }}
+      ignore_errors: true
+
+    - name: Drain node (evict pods safely)
+      local_action:
+        module: command
+        cmd: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data --force --grace-period=60
+      ignore_errors: true
+
+    - name: Launch new instance from AMI/image (cloud-specific step)
+      debug:
+        msg: "PROVIDE CLOUD-SPECIFIC LAUNCH STEP FOR {{ inventory_hostname }} using new image '{{ image }}'"
+
+    - name: Wait for node to become Ready (operator must ensure new node registers)
+      local_action:
+        module: command
+        cmd: kubectl wait --for=condition=ready node/{{ inventory_hostname }} --timeout=300s
+      register: wait_out
+      failed_when: wait_out.rc != 0
+
+    - name: Uncordon node
+      local_action:
+        module: command
+        cmd: kubectl uncordon {{ inventory_hostname }}
+
+    - name: Run runtime validation on node (remote)
+      local_action:
+        module: command
+        cmd: python3 ops/cluster/runtime_validator_enhanced.py --kubeconfig ~/.kube/config --label-nodes
+
+- hosts: workers_remaining
+  become: true
+  tasks:
+    - name: Pause for operator validation on canary
