+#!/usr/bin/env python3
+"""
+Produce a legal packet containing forensic bundles, validation CSVs, chain-of-custody manifests,
+cosign verification outputs and a signoff form template for Legal to complete.
+"""
+import os, json, hashlib, subprocess, tempfile
+from datetime import datetime
+
+EVIDENCE_DIRS = ["forensics", "attestations", "build_artifacts"]
+OUT_DIR = os.environ.get("OUT_DIR", "/tmp/aegis_legal_packet")
+COSIGN_KEY_REF = os.environ.get("COSIGN_KEY_REF", "")
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+def collect_items():
+    os.makedirs(OUT_DIR, exist_ok=True)
+    meta = {"collected_at": datetime.utcnow().isoformat(), "items": []}
+    for d in EVIDENCE_DIRS:
+        if not os.path.isdir(d):
+            continue
+        for root, _, files in os.walk(d):
+            for fn in files:
+                p = os.path.join(root, fn)
+                dest = os.path.join(OUT_DIR, os.path.relpath(p, d).replace("/","_"))
+                try:
+                    subprocess.check_call(["cp", p, dest])
+                except Exception:
+                    pass
+                meta["items"].append({"path": p, "sha256": sha256(p)})
+    with open(os.path.join(OUT_DIR, "metadata.json"), "w") as fh:
+        json.dump(meta, fh, indent=2)
+    bundle = os.path.join(OUT_DIR, "legal_packet.tar.gz")
+    subprocess.check_call(["tar", "-czf", bundle, "-C", OUT_DIR, "."])
+    if COSIGN_KEY_REF:
+        try:
+            subprocess.check_call(["cosign", "sign", "--key", COSIGN_KEY_REF, bundle])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    # produce signoff template
+    signoff = {
+        "legal_reviewed_by": "",
+        "legal_comments": "",
+        "jurisdictions_considered": [],
+        "compliance_decision": "PENDING"
+    }
+    with open(os.path.join(OUT_DIR, "legal_signoff_template.json"), "w") as fh:
+        json.dump(signoff, fh, indent=2)
+    print("Legal packet produced at", OUT_DIR)
+
+if __name__ == "__main__":
+    collect_items()
+
