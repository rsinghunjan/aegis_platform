+#!/usr/bin/env python3
+"""
+Remediation tracker for pentest/audit findings.
+ - Accepts a JSON list of findings and opens GitHub Issues (requires GH_TOKEN env var) or writes CSV.
+"""
+import os, json, csv, requests
+GH_TOKEN = os.environ.get("GH_TOKEN","")
+REPO = os.environ.get("REPO","")
+
+def open_issue(title, body):
+    if not GH_TOKEN or not REPO:
+        print("GH_TOKEN or REPO not set; writing to stdout")
+        print("ISSUE:", title)
+        print(body)
+        return
+    url = f"https://api.github.com/repos/{REPO}/issues"
+    headers = {"Authorization": f"token {GH_TOKEN}", "Accept":"application/vnd.github.v3+json"}
+    r = requests.post(url, json={"title": title, "body": body}, headers=headers, timeout=10)
+    print("Opened issue:", r.status_code, r.text)
+
+def track(findings_json, csv_out="/tmp/remediation.csv"):
+    findings = json.load(open(findings_json))
+    with open(csv_out, "w", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=["id","severity","title","description","status"])
+        writer.writeheader()
+        for fnd in findings:
+            writer.writerow({"id": fnd.get("id"), "severity": fnd.get("severity"), "title": fnd.get("title"), "description": fnd.get("description"), "status":"open"})
+            open_issue(f"[Pentest] {fnd.get('title')}", fnd.get("description"))
+    print("Wrote remediation CSV to", csv_out)
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("usage: remediation_tracker.py findings.json")
+        raise SystemExit(2)
+    track(sys.argv[1])
+
