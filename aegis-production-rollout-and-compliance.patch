+#!/usr/bin/env python3
+"""
+Production-ready finance integration:
+ - Posts reservation/charge records to finance endpoint with batching, retry and idempotency support.
+ - Writes reconcile logs to Postgres reconciliation table for audit.
+"""
+import os, time, json, requests, psycopg2
+DATABASE_URL = os.environ.get("DATABASE_URL","postgresql://postgres:postgres@postgres:5432/quota")
+FINANCE_API = os.environ.get("FINANCE_API","https://finance.example.com/api")
+API_KEY = os.environ.get("FINANCE_API_KEY","")
+RETRY_MAX = int(os.environ.get("FINANCE_RETRY_MAX","3"))
+
+def get_conn():
+    return psycopg2.connect(DATABASE_URL)
+
+def post_charge(record):
+    headers = {"Content-Type":"application/json", "Authorization": f"Bearer {API_KEY}"}
+    url = FINANCE_API.rstrip("/") + "/charges"
+    for attempt in range(1, RETRY_MAX+1):
+        try:
+            r = requests.post(url, json=record, headers=headers, timeout=15)
+            r.raise_for_status()
+            return r.json()
+        except Exception as e:
+            print("Finance post attempt", attempt, "failed:", e)
+            time.sleep(2 ** attempt)
+    raise RuntimeError("Failed to post to finance after retries")
+
+def reconcile_once():
+    conn = get_conn()
+    with conn.cursor() as cur:
+        cur.execute("SELECT rid, tenant, amount, created_at FROM reservations")
+        rows = cur.fetchall()
+        for rid, tenant, amount, created_at in rows:
+            rec = {"id": rid, "tenant": tenant, "amount": int(amount), "ts": int(created_at)}
+            try:
+                res = post_charge(rec)
+                cur.execute("INSERT INTO reconciliation_log (rid, status, response, created_at) VALUES (%s,%s,%s,extract(epoch from now())::bigint)", (rid, "ok", json.dumps(res)))
+                conn.commit()
+            except Exception as e:
+                cur.execute("INSERT INTO reconciliation_log (rid, status, response, created_at) VALUES (%s,%s,%s,extract(epoch from now())::bigint)", (rid, "error", str(e)))
+                conn.commit()
+
+if __name__=="__main__":
+    reconcile_once()
+
