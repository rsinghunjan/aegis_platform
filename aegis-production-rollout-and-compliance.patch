+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Sync a secret from Vault kv v2 to Kubernetes secret (avoid storing plaintext in Git).
+# Usage: ops/vault/sync_secret_to_k8s.sh <vault-path> <k8s-secret-name> <namespace>
+VAULT_PATH=${1:-}
+K8S_SECRET=${2:-}
+NAMESPACE=${3:-ml-serving}
+if [ -z "$VAULT_PATH" ] || [ -z "$K8S_SECRET" ]; then
+  echo "Usage: $0 <vault-path> <k8s-secret-name> [namespace]"
+  exit 2
+fi
+VAL=$(vault kv get -field=value "${VAULT_PATH}")
+kubectl -n "$NAMESPACE" delete secret "$K8S_SECRET" --ignore-not-found
+kubectl -n "$NAMESPACE" create secret generic "$K8S_SECRET" --from-literal=value="$VAL"
+echo "Secret synced to k8s: $K8S_SECRET in namespace $NAMESPACE"
+
