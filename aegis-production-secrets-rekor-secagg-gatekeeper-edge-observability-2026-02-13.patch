+#!/usr/bin/env python3
+"""
+Receipt signer that uses Vault Transit to sign payloads and writes Rekor entries.
+This is the trusted signing service CI should call (no static VAULT_TOKEN in CI).
+In production, run this in a secure namespace and use Kubernetes auth or Vault Agent.
+"""
+import os, json, base64, requests, time
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+VAULT_ADDR = os.environ.get("VAULT_ADDR", "http://vault.aegis-system.svc.cluster.local:8200")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN", "")  # in prod use Vault Agent/Kubernetes auth
+TRANSIT_KEY = os.environ.get("TRANSIT_KEY_NAME", "cosign-signing")
+REKOR_URL = os.environ.get("REKOR_URL", "")
+
+def vault_sign(payload):
+    url = f"{VAULT_ADDR.rstrip('/')}/v1/transit/sign/{TRANSIT_KEY}"
+    b64 = base64.b64encode(json.dumps(payload, separators=(",", ":")).encode()).decode()
+    body = {"input": b64}
+    headers = {"X-Vault-Token": VAULT_TOKEN} if VAULT_TOKEN else {}
+    r = requests.post(url, json=body, headers=headers, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def post_rekor(payload, sig):
+    if not REKOR_URL:
+        return
+    try:
+        requests.post(f"{REKOR_URL.rstrip('/')}/api/v1/log/entries", json={"payload": payload, "signature": sig}, timeout=8)
+    except Exception:
+        pass
+
+@app.route("/sign", methods=["POST"])
+def sign_endpoint():
+    j = request.json or {}
+    artifact = j.get("artifact", {})
+    signer_meta = {"ts": time.time(), "service":"receipt_signer_vault"}
+    payload = {"artifact": artifact, "meta": signer_meta}
+    sig = vault_sign(payload)
+    # best-effort Rekor
+    post_rekor(artifact, sig)
+    return jsonify({"signature": sig})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
