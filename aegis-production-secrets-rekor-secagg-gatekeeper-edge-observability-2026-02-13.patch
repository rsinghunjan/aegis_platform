+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run the Gatekeeper audit collection and, if audit period passed and violations reduced below threshold,
+# flip enforcementAction to "deny".
+#
+# Usage: tools/auto_gatekeeper_flip.sh <audit_days> <max_violations_allowed>
+
+AUDIT_DAYS=${1:-3}
+MAX_VIOL=${2:-5}
+MCP_API=${AEGIS_MCP_API:-http://mcp:8082}
+
+echo "Starting Gatekeeper audit window for ${AUDIT_DAYS} days..."
+echo "Run tools/gatekeeper_audit_to_mcp.py as a cron job during audit window to collect violations."
+echo "After audit window, fetch violation summary from MCP and decide whether to flip."
+echo "This script only performs the flip based on MCP report (operator review recommended)."
+
+# Placeholder: operator should inspect report. Here we simulate check by querying MCP (must implement endpoint there).
+echo "Fetching violation count from MCP (operator: ensure MCP exposes governance/gatekeeper_violations_summary)"
+VCOUNT=$(curl -s "${MCP_API}/governance/gatekeeper_violations_summary" | jq -r .count 2>/dev/null || echo "999")
+echo "Violation count reported: ${VCOUNT}"
+if [ "${VCOUNT}" -le "${MAX_VIOL}" ]; then
+  echo "Violations under threshold (${MAX_VIOL}), flipping constraints to enforcement=deny"
+  for c in $(kubectl get constraints --all-namespaces -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'); do
+    echo "Patching $c enforcementAction=deny"
+    kubectl patch constraint "$c" --type merge -p '{"spec":{"enforcementAction":"deny"}}' || true
+  done
+  echo "Flip complete. Notify oncall and monitor for false positives."
+else
+  echo "Violations exceed threshold; aborting flip. Operator intervention required."
+fi
+
