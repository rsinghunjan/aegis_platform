+#!/usr/bin/env python3
+"""
+SLO reporter: queries Prometheus for SLO burn rate and posts summaries to MCP/oncall.
+Requires Prometheus HTTP API available.
+"""
+import os, requests, time, json
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def query_prom(q):
+    r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": q}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def compute_and_report():
+    # Example: fetch webhook error ratio
+    q = 'job:webhook:error_ratio:ratio5m'
+    try:
+        res = query_prom(q)
+        val = res.get("data", {}).get("result", [])
+        v = float(val[0]["value"][1]) if val else 0.0
+    except Exception:
+        v = -1.0
+    payload = {"slo":"webhook_error_ratio","value": v, "ts": time.time()}
+    try:
+        requests.post(f"{MCP_API.rstrip('/')}/observability/slo", json=payload, timeout=5.0)
+    except Exception:
+        pass
+    # Also notify if breaching
+    if v > 0.05:
+        try:
+            requests.post(f"{MCP_API.rstrip('/')}/alerts", json={"summary":"Webhook SLO breach","value":v}, timeout=3.0)
+        except Exception:
+            pass
+
+if __name__ == "__main__":
+    compute_and_report()
