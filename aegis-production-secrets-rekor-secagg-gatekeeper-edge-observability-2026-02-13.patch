+#!/usr/bin/env python3
+"""
+Prototype secure aggregation using additive masking (client-server coordinated).
+This is an educational prototype — for production use vetted secure aggregation libraries.
+
+Protocol (simplified):
+ - Each client generates a random mask and sends masked_update = update + mask to server.
+ - Clients also send mask_shares to other participants through server (or via direct channels).
+ - Server aggregates masked_updates, and after collecting mask_shares from clients, removes sum(masks) to reveal aggregate.
+
+This file implements a coordinator for small groups. Not resilient to malicious clients.
+"""
+import os, json, time
+from flask import Flask, request, jsonify
+import numpy as np
+
+app = Flask(__name__)
+GROUPS = {}  # group_id -> {clients: set, masked_updates: {client:vec}, mask_shares: {client: [shares]}, expected: n_clients}
+
+@app.route("/group/create", methods=["POST"])
+def create_group():
+    j = request.json or {}
+    gid = j.get("group_id") or f"group-{int(time.time()*1000)}"
+    expected = int(j.get("expected_clients", 3))
+    GROUPS[gid] = {"clients": set(), "masked_updates": {}, "mask_shares": {}, "expected": expected}
+    return jsonify({"group_id": gid, "expected": expected})
+
+@app.route("/group/join", methods=["POST"])
+def join_group():
+    j = request.json or {}
+    gid = j["group_id"]; cid = j["client_id"]
+    g = GROUPS.get(gid)
+    if not g: return jsonify({"error":"no group"}), 404
+    g["clients"].add(cid)
+    return jsonify({"status":"joined","group_id":gid})
+
+@app.route("/submit_masked", methods=["POST"])
+def submit_masked():
+    j = request.json or {}
+    gid = j["group_id"]; cid = j["client_id"]; masked = j["masked"]
+    g = GROUPS.get(gid)
+    if not g: return jsonify({"error":"no group"}), 404
+    g["masked_updates"][cid] = np.array(masked)
+    # If all masked updates received and mask_shares present, attempt aggregation
+    if len(g["masked_updates"]) == g["expected"] and sum(len(v) for v in g["mask_shares"].values()) >= g["expected"]:
+        return jsonify({"status":"received","ready":True})
+    return jsonify({"status":"received","ready":False})
+
+@app.route("/submit_shares", methods=["POST"])
+def submit_shares():
+    j = request.json or {}
+    gid = j["group_id"]; cid = j["client_id"]; shares = j["shares"]
+    g = GROUPS.get(gid)
+    if not g: return jsonify({"error":"no group"}), 404
+    g["mask_shares"][cid] = shares
+    if len(g["mask_shares"]) == g["expected"] and len(g["masked_updates"]) == g["expected"]:
+        # reconstruct sum of masks: here shares are additive so sum all shares
+        summed_masks = None
+        for s_list in g["mask_shares"].values():
+            for s in s_list:
+                arr = np.array(s)
+                if summed_masks is None:
+                    summed_masks = arr
+                else:
+                    summed_masks += arr
+        total_mask = summed_masks
+        total_masked = None
+        for v in g["masked_updates"].values():
+            if total_masked is None: total_masked = v
+            else: total_masked += v
+        aggregate = total_masked - total_mask
+        # cleanup group for next round
+        g["masked_updates"].clear(); g["mask_shares"].clear()
+        return jsonify({"status":"aggregated","aggregate": aggregate.tolist()})
+    return jsonify({"status":"shares_received"})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8100")))
+
