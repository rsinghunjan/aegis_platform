+#!/usr/bin/env python3
+"""
+Client stub that demonstrates masking approach: generates random mask and mask shares,
+submits masked update and shares to coordinator. For demo/education only.
+"""
+import os, json, requests, numpy as np
+
+COORD = os.environ.get("COORD", "http://orchestrator-secagg:8100")
+CLIENT_ID = os.environ.get("CLIENT_ID", "client-demo")
+
+def enroll(gid):
+    requests.post(f"{COORD}/group/join", json={"group_id": gid, "client_id": CLIENT_ID})
+
+def submit(gid, update):
+    # generate random mask
+    mask = np.random.normal(0,1,size=len(update))
+    masked = (np.array(update) + mask).tolist()
+    # simple shares: for demo, split mask into equal shares (not secure)
+    shares = [ (mask / 1.0).tolist() ]  # single share list per client in this naive demo
+    requests.post(f"{COORD}/submit_masked", json={"group_id":gid,"client_id":CLIENT_ID,"masked": masked})
+    requests.post(f"{COORD}/submit_shares", json={"group_id":gid,"client_id":CLIENT_ID,"shares": shares})
+
