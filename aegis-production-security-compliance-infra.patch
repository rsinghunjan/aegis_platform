+#!/usr/bin/env bash
+set -euo pipefail
+#
+# CI step: ensure artifact has a Rekor entry (fail if missing).
+# Usage: rekor_enforce_action.sh <artifact-path>
+ART="$1"
+REKOR_SERVER="${REKOR_SERVER:-${REKOR_SERVER}}"
+if [ -z "$REKOR_SERVER" ]; then
+  echo "REKOR_SERVER not set"
+  exit 2
+fi
+if [ ! -f "$ART" ]; then
+  echo "Artifact not found: $ART"
+  exit 3
+fi
+HASH=$(sha256sum "$ART" | awk '{print $1}')
+echo "Checking Rekor for artifact sha256:$HASH"
+# Try Rekor search API, fallback to rekor-cli if available
+if command -v rekor-cli >/dev/null 2>&1; then
+  set +e
+  rekor-cli search --rekor_server "$REKOR_SERVER" --artifact "$ART" >/dev/null 2>&1
+  OK=$?
+  set -e
+  if [ $OK -ne 0 ]; then
+    echo "No Rekor entry found (rekor-cli). Failing."
+    exit 4
+  fi
+else
+  # HTTP search (endpoint may vary; this is a generic attempt)
+  RESP=$(curl -sS -X POST "$REKOR_SERVER/api/v1/log/entries/retrieve" -H "Content-Type: application/json" -d "{\"hash\":\"$HASH\"}" || true)
+  if echo "$RESP" | grep -q "$HASH"; then
+    echo "Found Rekor entry"
+  else
+    echo "No Rekor entry found via HTTP search. Fail."
+    exit 5
+  fi
+fi
+echo "Rekor enforcement passed"
+
