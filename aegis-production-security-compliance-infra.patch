+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Enable Vault audit device (file and syslog) and apply hardening policies for quantum & approver secrets.
+VAULT_ADDR="${VAULT_ADDR:-http://127.0.0.1:8200}"
+VAULT_TOKEN="${VAULT_TOKEN:-}"
+if [ -z "$VAULT_TOKEN" ]; then echo "VAULT_TOKEN required"; exit 2; fi
+export VAULT_ADDR VAULT_TOKEN
+
+vault audit enable file file_path=/var/log/vault_audit.log
+vault audit enable syslog tag="vault"
+
+# Create policy for quantum secrets (read-only for specific role)
+cat > /tmp/policy_quantum.hcl <<'HCL'
+path "secret/data/quantum/*" {
+  capabilities = ["read"]
+}
+path "transit/keys/*" {
+  capabilities = ["encrypt"]
+}
+HCL
+vault policy write quantum /tmp/policy_quantum.hcl
+
+# Create policy for approver DB access (read-only)
+cat > /tmp/policy_approver.hcl <<'HCL'
+path "secret/data/approver/*" {
+  capabilities = ["read"]
+}
+HCL
+vault policy write approver /tmp/policy_approver.hcl
+
+echo "Enable kubernetes auth and map service accounts to Vault roles (assumes k8s auth configured)"
+vault auth enable kubernetes || true
+vault write auth/kubernetes/role/aegis-quantum bound_service_account_names=qpu-adapter-sa bound_service_account_namespaces=aegis-ml policies=quantum ttl=1h
+vault write auth/kubernetes/role/approver bound_service_account_names=approver-sa bound_service_account_namespaces=aegis-system policies=approver ttl=1h
+echo "Vault audit enabled and policies created."
+
