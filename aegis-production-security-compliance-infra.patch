+#!/usr/bin/env python3
+"""
+Collect evidence artifacts for audit: Rekor entries, cosign signatures, MLflow run ids, approver DB extracts.
+Writes a ZIP suitable for SOC review.
+"""
+import os, json, subprocess, tempfile, shutil
+OUT="evidence_bundle.zip"
+tmpdir = tempfile.mkdtemp()
+
+def collect_artifacts(paths, outdir):
+    for p in paths:
+        if os.path.exists(p):
+            shutil.copy(p, outdir)
+
+def export_rekor_entries(artifact_hash, rekor_server, outdir):
+    # simple: call rekor-cli to fetch entry
+    try:
+        subprocess.check_call(["rekor-cli","search","--rekor_server",rekor_server,"--sha",artifact_hash,"--output","json"], cwd=outdir)
+    except Exception:
+        pass
+
+if __name__ == "__main__":
+    # Sample usage; in production call with parameters
+    collect_artifacts(["./artifacts/bundle.json","./artifacts/bundle.json.sig"], tmpdir)
+    shutil.make_archive("evidence_bundle", "zip", tmpdir)
