+/*
+Minimal Terraform scaffold to deploy a highly-available Rekor cluster on AWS ECS (Fargate) with ALB.
+This is an example — adapt networking, logging, storage, and HA zones to your org standards.
+Requires: aws provider configured, an ECR image for rekor-server, an s3 bucket for rekor storage (or RDS)
+*/
+terraform {
+  required_providers { aws = { source = "hashicorp/aws" } }
+}
+provider "aws" { region = var.aws_region }
+variable "aws_region" { default = "us-west-2" }
+variable "rekor_ecr_image" { description = "ECR image for rekor server" }
+variable "rekor_s3_bucket" { description = "S3 bucket for Rekor storage" }
+
+resource "aws_iam_role" "ecs_task_exec" {
+  name = "aegis-rekor-ecs-task-exec"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [{ Effect = "Allow", Principal = { Service = "ecs-tasks.amazonaws.com" }, Action = "sts:AssumeRole" }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "ecs_exec_attach" {
+  role       = aws_iam_role.ecs_task_exec.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+# ECS cluster
+resource "aws_ecs_cluster" "rekor" {
+  name = "aegis-rekor-cluster"
+}
+
+# Task definition for Rekor (uses Fargate)
+resource "aws_ecs_task_definition" "rekor_task" {
+  family                   = "rekor-task"
+  requires_compatibilities = ["FARGATE"]
+  cpu                      = "512"
+  memory                   = "1024"
+  network_mode             = "awsvpc"
+  execution_role_arn       = aws_iam_role.ecs_task_exec.arn
+  container_definitions    = jsonencode([{
+    name  = "rekor"
+    image = var.rekor_ecr_image
+    essential = true
+    portMappings = [{ containerPort = 3000, hostPort = 3000 }]
+    environment = [
+      { name = "REKOR_STORAGE_TYPE", value = "s3" },
+      { name = "REKOR_S3_BUCKET", value = var.rekor_s3_bucket }
+    ]
+  }])
+}
+
+resource "aws_ecs_service" "rekor_svc" {
+  name            = "rekor-service"
+  cluster         = aws_ecs_cluster.rekor.id
+  task_definition = aws_ecs_task_definition.rekor_task.arn
+  desired_count   = 2
+  launch_type     = "FARGATE"
+  network_configuration {
+    subnets         = data.aws_subnet_ids.private.ids
+    assign_public_ip = false
+    security_groups = [aws_security_group.rekor_sg.id]
+  }
+  deployment_maximum_percent         = 200
+  deployment_minimum_healthy_percent = 50
+}
+
+resource "aws_security_group" "rekor_sg" {
+  name        = "rekor-sg"
+  description = "Allow ingress for Rekor ALB"
+  vpc_id      = data.aws_vpc.default.id
+  ingress {
+    from_port   = 80
+    to_port     = 80
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  egress { from_port = 0; to_port = 0; protocol = "-1"; cidr_blocks = ["0.0.0.0/0"] }
+}
+
+data "aws_vpc" "default" { default = true }
+data "aws_subnet_ids" "private" { vpc_id = data.aws_vpc.default.id }
+
+output "rekor_service" { value = aws_ecs_service.rekor_svc.name }
