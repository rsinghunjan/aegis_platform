+#!/usr/bin/env python3
+"""
+Production approver requiring N-of-M human approvals for high-risk operations.
+Stores approvals in Postgres, emits audit logs to stdout (to be scraped by fluentd/ELK/SIEM).
+"""
+import os, json, time, uuid, subprocess
+import psycopg2
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+APP = FastAPI()
+DB_DSN = os.environ.get("APPROVER_POSTGRES_DSN")
+REQUIRED_APPROVALS = int(os.environ.get("REQUIRED_APPROVALS", "2"))
+
+def get_conn(): return psycopg2.connect(DB_DSN)
+
+class ApprovalRequest(BaseModel):
+    namespace: str
+    action: dict
+    requester: str
+
+@APP.post("/request")
+def request_approval(req: ApprovalRequest):
+    approval_id = str(uuid.uuid4())
+    conn = get_conn(); cur = conn.cursor()
+    cur.execute("INSERT INTO approvals (id, namespace, action, requester, signed) VALUES (%s,%s,%s,%s,%s)",
+                (approval_id, req.namespace, json.dumps(req.action), req.requester, False))
+    conn.commit(); cur.close(); conn.close()
+    # emit audit event
+    print(json.dumps({"event":"approval_requested","id":approval_id,"namespace":req.namespace,"action":req.action,"requester":req.requester,"ts":int(time.time())}))
+    return {"approval_id": approval_id, "status": "pending"}
+
+@APP.post("/approve/{approval_id}")
+def approve(approval_id: str, approver: dict):
+    conn = get_conn(); cur = conn.cursor()
+    # store approver entry
+    cur.execute("INSERT INTO approval_signatures (approval_id, approver, ts) VALUES (%s,%s,now())", (approval_id, json.dumps(approver)))
+    conn.commit()
+    cur.execute("SELECT COUNT(*) FROM approval_signatures WHERE approval_id=%s", (approval_id,))
+    count = cur.fetchone()[0]
+    if count >= REQUIRED_APPROVALS:
+        # mark approved, issue signed token via cosign if configured
+        cur.execute("UPDATE approvals SET signed=true WHERE id=%s", (approval_id,))
+        conn.commit()
+        # create approval token artifact
+        token = {"approval_id": approval_id, "approved_by": count, "ts": int(time.time())}
+        token_file = f"/tmp/approval_{approval_id}.json"
+        with open(token_file, "w") as fh: json.dump(token, fh)
+        # Attempt to sign token (cosign KMS)
+        COSIGN_KEY = os.environ.get("COSIGN_KEY")
+        if COSIGN_KEY:
+            try:
+                subprocess.check_call(["cosign","sign-blob","--key",COSIGN_KEY, token_file])
+                print(json.dumps({"event":"approval_issued","id":approval_id,"signed":True}))
+            except Exception as e:
+                print(json.dumps({"event":"approval_sign_failed","id":approval_id,"err":str(e)}))
+        else:
+            print(json.dumps({"event":"approval_issued","id":approval_id,"signed":False}))
+    cur.close(); conn.close()
+    return {"status":"ok","signatures": count}
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(APP, host="0.0.0.0", port=int(os.environ.get("APPROVER_PORT",8081)))
+
