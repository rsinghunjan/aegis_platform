+#!/usr/bin/env python3
+"""
+A2A Approver service.
+- Requires JWT Bearer token for requests (approver client must hold token).
+- Persists approvals to Postgres and stores a KMS-backed signature of the approval entry (AWS KMS example).
+"""
+import os, time, uuid, json
+from fastapi import FastAPI, Header, HTTPException, Request
+from pydantic import BaseModel
+import psycopg2
+from psycopg2.extras import Json
+import boto3
+from jose import jwt, JWTError
+
+APP = FastAPI(title="Aegis A2A Approver")
+DB_DSN = os.environ.get("APPROVER_POSTGRES_DSN")
+JWT_ISSUER = os.environ.get("APPROVER_JWT_ISSUER")
+JWT_AUDIENCE = os.environ.get("APPROVER_JWT_AUDIENCE")
+KMS_KEY_ID = os.environ.get("APPROVER_KMS_KEY_ID")  # AWS KMS key id for signing approval payload
+
+class ApprovalReq(BaseModel):
+    model_id: str
+    artifact_uri: str
+    approver: str
+    decision: str
+    comment: str = ""
+
+def get_db_conn():
+    if not DB_DSN:
+        raise RuntimeError("APPROVER_POSTGRES_DSN not set")
+    return psycopg2.connect(DB_DSN)
+
+def sign_payload_aws(payload_bytes: bytes):
+    if not KMS_KEY_ID:
+        return None
+    kms = boto3.client("kms")
+    resp = kms.sign(KeyId=KMS_KEY_ID, Message=payload_bytes, MessageType='RAW', SigningAlgorithm='RSASSA_PKCS1_V1_5_SHA_256')
+    return resp.get("Signature")
+
+def verify_jwt(token: str):
+    # In production use JWKS / OIDC discovery; here we verify signature-less placeholder by issuer
+    try:
+        # try to parse (no verification for example)
+        return jwt.decode(token, options={"verify_signature": False, "verify_aud": False})
+    except JWTError:
+        raise
+
+@APP.post("/request")
+def request_approval(req: ApprovalReq, authorization: str = Header(None)):
+    if not authorization:
+        raise HTTPException(status_code=401, detail="missing auth")
+    token = authorization.split("Bearer ")[-1]
+    try:
+        claims = verify_jwt(token)
+    except Exception:
+        raise HTTPException(status_code=403, detail="invalid token")
+    approval_id = str(uuid.uuid4())
+    ts = int(time.time())
+    record = {"id": approval_id, "model_id": req.model_id, "artifact_uri": req.artifact_uri, "approver": req.approver, "decision": req.decision, "comment": req.comment, "ts": ts}
+    record_bytes = json.dumps(record).encode("utf-8")
+    signature = sign_payload_aws(record_bytes)
+    # persist to Postgres
+    with get_db_conn() as conn:
+        with conn.cursor() as cur:
+            cur.execute("INSERT INTO a2a_approvals (id, payload, signature, ts) VALUES (%s, %s, %s, %s)", (approval_id, Json(record), signature, ts))
+            conn.commit()
+    return {"id": approval_id, "signed": signature is not None}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
