+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Encrypt a file with AWS KMS and upload to S3. Store pointer for audit.
+#
+FILE=$1
+S3_BUCKET=$2
+KMS_KEY_ID=$3
+PREFIX=${4:-originals}
+
+if [ ! -f "$FILE" ]; then
+  echo "file missing"
+  exit 2
+fi
+
+ENC_FILE="${FILE}.enc"
+aws kms encrypt --key-id "$KMS_KEY_ID" --plaintext fileb://"$FILE" --output text --query CiphertextBlob | base64 --decode > "$ENC_FILE"
+
+KEY="$PREFIX/$(basename "$FILE").enc"
+aws s3 cp "$ENC_FILE" "s3://$S3_BUCKET/$KEY"
+echo "Encrypted original stored at s3://$S3_BUCKET/$KEY"
+echo "$KEY"
+
