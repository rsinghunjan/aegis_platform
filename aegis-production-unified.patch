+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create AWS KMS key (asymmetric for signing) and output the ARN.
+#
+USAGE="usage: $0 <alias-name> <description>"
+if [ $# -lt 1 ]; then
+  echo "$USAGE"
+  exit 2
+fi
+ALIAS=${1}
+DESC=${2:-"Aegis signing key"}
+
+KEY_ID=$(aws kms create-key --description "$DESC" --query KeyMetadata.KeyId --output text)
+echo "Created KMS key: $KEY_ID"
+aws kms create-alias --alias-name "alias/$ALIAS" --target-key-id "$KEY_ID"
+ARN=$(aws kms describe-key --key-id "$KEY_ID" --query KeyMetadata.Arn --output text)
+echo "KMS key ARN: $ARN"
+echo "Use COSIGN_KMS_URI=aws-kms://$ARN"
+
