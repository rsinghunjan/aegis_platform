+#!/usr/bin/env python3
+"""
+Simple Validating Admission Webhook that enforces:
+- Pod/Deployment must have annotation mcp.provenance/signed=true (REQUIRED) OR
+- If REKOR_SERVER provided and mcp.provenance/rekor_digest provided, verify Rekor entry exists for that digest.
+
+This is a best-effort validator; operators must provide CA certificate and webhook config.
+"""
+import os, json, base64, hashlib, requests
+from fastapi import FastAPI, Request
+from pydantic import BaseModel
+
+app = FastAPI()
+REKOR = os.environ.get("REKOR_SERVER", "")
+REQUIRE_ANNOT = os.environ.get("REQUIRE_SIGNATURE_ANNOTATION", "true").lower() == "true"
+
+@app.post("/validate")
+async def validate(req: Request):
+    body = await req.json()
+    # admissionReview request
+    reqobj = body.get("request", {})
+    obj = reqobj.get("object", {})
+    meta = obj.get("metadata", {})
+    ann = meta.get("annotations", {}) or {}
+    allowed = True
+    reason = ""
+    signed = ann.get("mcp.provenance/signed", "false").lower() == "true"
+    if REQUIRE_ANNOT and not signed:
+        reason = "missing mcp.provenance/signed=true annotation"
+        allowed = False
+    # If rekor check requested
+    rekor_digest = ann.get("mcp.provenance/rekor_digest", "")
+    if allowed and rekor_digest and REKOR:
+        # call Rekor retrieve endpoint
+        try:
+            url = f"{REKOR.rstrip('/')}/api/v1/index/retrieve?hash={rekor_digest}"
+            r = requests.get(url, timeout=3.0)
+            if not r.ok or r.text in ("null","[]",""):
+                allowed = False
+                reason = "rekor entry not found for provided digest"
+        except Exception as e:
+            allowed = False
+            reason = f"rekor_check_error: {e}"
+
+    resp = {
+        "apiVersion": "admission.k8s.io/v1",
+        "kind": "AdmissionReview",
+        "response": {
+            "uid": reqobj.get("uid"),
+            "allowed": allowed,
+            "status": {"message": reason} if not allowed else {}
+        }
+    }
+    return resp
+
