+#!/usr/bin/env python3
+"""
+DynamoDB-backed retrain guard (alternative to Redis).
+ - Uses a DynamoDB table to store retrain events (PK: dataset_id, SK: ts#requestor)
+ - Requires AWS credentials and table name in environment:DYNAMO_TABLE
+ - This is a simple implementation; for production use conditional writes or transactional API for atomicity.
+"""
+import os
+import json
+import time
+import logging
+import boto3
+from botocore.exceptions import ClientError
+import subprocess
+
+LOG = logging.getLogger("aegis.retrain.guard.dynamo")
+logging.basicConfig(level=logging.INFO)
+
+DYNAMO_TABLE = os.environ.get("DYNAMO_TABLE")
+MULTISIG_CMD = os.environ.get("MULTISIG_VERIFY_CMD", "/app/multisig_verify.py")
+MULTISIG_THRESHOLD = int(os.environ.get("MULTISIG_THRESHOLD", "2"))
+COOLDOWN_SECONDS = int(os.environ.get("COOLDOWN_SECONDS", "3600"))
+MAX_PER_24H = int(os.environ.get("MAX_RETRAINS_PER_24H", "3"))
+
+def verify_multisig(approvals):
+    if not approvals or len(approvals) < MULTISIG_THRESHOLD:
+        return False
+    try:
+        args = [MULTISIG_CMD, "--threshold", str(MULTISIG_THRESHOLD)] + [f"--sig={s}" for s in approvals]
+        subprocess.check_call(args)
+        return True
+    except Exception:
+        LOG.exception("Multisig verification failed")
+        return False
+
+def retrain_allowed_dynamo(dataset_meta, requestor):
+    if not DYNAMO_TABLE:
+        LOG.error("DYNAMO_TABLE not set")
+        return False, "no_table"
+    dynamo = boto3.resource("dynamodb")
+    table = dynamo.Table(DYNAMO_TABLE)
+    now = int(time.time())
+    cutoff = now - 24*3600
+    dataset_id = dataset_meta.get("dataset_id", "default")
+    # Query recent events (inefficient for large tables; add GSI for timestamp)
+    try:
+        resp = table.query(KeyConditionExpression="dataset_id = :d and begins_with(event_ts, :p)", ExpressionAttributeValues={":d": dataset_id, ":p": ""}, Limit=1000)
+        items = resp.get("Items", [])
+    except ClientError:
+        LOG.exception("dynamo query failed")
+        return False, "dynamo_error"
+
+    last_ts = max((int(i.get("ts",0)) for i in items), default=0)
+    if last_ts and now - last_ts < COOLDOWN_SECONDS:
+        return False, "cooldown_active"
+    recent_count = sum(1 for i in items if int(i.get("ts",0)) >= cutoff)
+    if recent_count >= MAX_PER_24H:
+        return False, "rate_limit_exceeded"
+
+    if dataset_meta.get("sensitivity") == "high":
+        if not verify_multisig(dataset_meta.get("approvals", [])):
+            return False, "multisig_required_or_failed"
+
+    if not dataset_meta.get("curated_examples_path"):
+        return False, "no_curated_examples"
+
+    # record event
+    try:
+        table.put_item(Item={"dataset_id": dataset_id, "event_ts": f"{now}#{requestor}", "ts": now, "requestor": requestor})
+    except ClientError:
+        LOG.exception("dynamo put failed")
+    return True, "allowed"
+
