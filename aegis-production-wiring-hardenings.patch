+#!/usr/bin/env python3
+"""
+Retrain guard using Redis for HA counters and cooldowns.
+
+Behavior:
+ - Uses a Redis sorted set per "project" to store timestamps of retrain events.
+ - Atomic Lua script checks cooldown and daily rate limit and records the new event when allowed.
+ - Requires: REDIS_URL environment variable (e.g., redis://aegis-redis:6379/0)
+ - Falls back to file-backed behavior only if Redis is unavailable (logged).
+
+Inputs:
+ - dataset_meta: dict with sensitivity, curated_examples_path, approvals (list of sigs)
+ - requestor: string identity
+
+Return:
+ - JSON: {"allowed": bool, "reason": "..."}
+"""
+import os
+import json
+import time
+import logging
+import redis
+import subprocess
+
+LOG = logging.getLogger("aegis.retrain.guard.redis")
+logging.basicConfig(level=logging.INFO)
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://localhost:6379/0")
+MULTISIG_CMD = os.environ.get("MULTISIG_VERIFY_CMD", "/app/multisig_verify.py")
+MULTISIG_THRESHOLD = int(os.environ.get("MULTISIG_THRESHOLD", "2"))
+COOLDOWN_SECONDS = int(os.environ.get("COOLDOWN_SECONDS", "3600"))
+MAX_PER_24H = int(os.environ.get("MAX_RETRAINS_PER_24H", "3"))
+
+# Lua script: atomically check last timestamp and count in 24h window, then add new timestamp if allowed.
+LUA_CHECK_AND_ADD = r"""
+local key = KEYS[1]
+local now = tonumber(ARGV[1])
+local cooldown = tonumber(ARGV[2])
+local cutoff = tonumber(ARGV[3])
+local max24 = tonumber(ARGV[4])
+
+-- remove old entries < cutoff (defensive)
+redis.call("ZREMRANGEBYSCORE", key, 0, cutoff - 86400)
+
+local last = redis.call("ZREVRANGE", key, 0, 0, "WITHSCORES")
+if #last > 0 then
+  local last_ts = tonumber(last[2])
+  if now - last_ts < cooldown then
+    return cjson.encode({allowed=false, reason="cooldown_active", last=last_ts})
+  end
+end
+
+local count = redis.call("ZCOUNT", key, cutoff, now)
+if count >= max24 then
+  return cjson.encode({allowed=false, reason="rate_limit_exceeded", count=count})
+end
+
+redis.call("ZADD", key, now, tostring(now) .. ":" .. ARGV[5])
+redis.call("EXPIRE", key, 3600*48)
+return cjson.encode({allowed=true})
+"""
+
+def get_redis():
+    try:
+        return redis.from_url(REDIS_URL, decode_responses=True)
+    except Exception:
+        LOG.exception("Failed to connect to Redis")
+        return None
+
+def verify_multisig(approvals):
+    if not approvals or len(approvals) < MULTISIG_THRESHOLD:
+        return False
+    try:
+        args = [MULTISIG_CMD, "--threshold", str(MULTISIG_THRESHOLD)] + [f"--sig={s}" for s in approvals]
+        LOG.info("Calling multisig verifier: %s", args)
+        subprocess.check_call(args)
+        return True
+    except Exception:
+        LOG.exception("Multisig verification failed")
+        return False
+
+def retrain_allowed_redis(dataset_meta, requestor):
+    """
+    dataset_meta: dict with keys sensitivity, curated_examples_path, approvals (list)
+    Returns: (allowed: bool, reason: str)
+    """
+    r = get_redis()
+    if r is None:
+        LOG.warning("Redis unavailable; falling back to conservative deny")
+        return False, "redis_unavailable"
+
+    now = int(time.time())
+    cutoff = now - 24*3600
+    key = f"aegis:retrain:{dataset_meta.get('dataset_id','default')}:history"
+    try:
+        res = r.eval(LUA_CHECK_AND_ADD, 1, key, now, COOLDOWN_SECONDS, cutoff, MAX_PER_24H, requestor)
+        out = json.loads(res)
+        if not out.get("allowed", False):
+            return False, out.get("reason", "denied")
+    except Exception:
+        LOG.exception("Redis eval failed")
+        return False, "redis_error"
+
+    # If dataset sensitive, require multisig approvals
+    if dataset_meta.get("sensitivity") == "high":
+        if not verify_multisig(dataset_meta.get("approvals", [])):
+            return False, "multisig_required_or_failed"
+
+    # curated examples must be present
+    if not dataset_meta.get("curated_examples_path"):
+        return False, "no_curated_examples"
+
+    return True, "allowed"
+
+def main():
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dataset-meta", required=True)
+    ap.add_argument("--requestor", required=True)
+    args = ap.parse_args()
+    try:
+        if os.path.exists(args.dataset_meta):
+            ds = json.load(open(args.dataset_meta))
+        else:
+            ds = json.loads(args.dataset_meta)
+    except Exception:
+        LOG.exception("Failed to load dataset meta")
+        print(json.dumps({"allowed": False, "reason": "bad_dataset_meta"}))
+        return 2
+    allowed, reason = retrain_allowed_redis(ds, args.requestor)
+    print(json.dumps({"allowed": allowed, "reason": reason}))
+    return 0 if allowed else 1
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
