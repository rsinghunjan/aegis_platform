+#!/usr/bin/env python3
+"""
+Remediation helper: takes Gatekeeper violations CSV and attempts to annotate Deployments with a remediation note
+or open a ticket via an API (placeholder).
+"""
+import csv, sys, subprocess, json, requests
+
+def annotate_deployment(ns, name, note):
+    patch = {"metadata": {"annotations": {"aegis.remediation.note": note}}}
+    subprocess.run(["kubectl", "patch", "deployment", name, "-n", ns, "--type=merge", "-p", json.dumps(patch)], check=False)
+
+def main(csvfile):
+    with open(csvfile) as f:
+        r = csv.DictReader(f)
+        for row in r:
+            ns = row.get("namespace") or "default"
+            name = row.get("name")
+            msg = row.get("message")
+            if name:
+                annotate_deployment(ns, name, f"Gatekeeper dry-run violation: {msg}")
+                print(f"Annotated {ns}/{name}")
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        print("usage: remediate_violations.py violations.csv")
+        sys.exit(1)
+    main(sys.argv[1])
