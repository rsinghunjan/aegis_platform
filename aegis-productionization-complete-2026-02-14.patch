+#!/usr/bin/env python3
+"""
+Generate evidence bundle combining Vault transit attestation, optional MLflow run metadata,
+and Rekor index. Designed for attaching to model metadata.
+"""
+import argparse, json, os, requests, time
+
+def load_attestation(path):
+    return json.load(open(path)) if path and os.path.exists(path) else None
+
+def fetch_mlflow_run(run_id, mlflow_uri):
+    if not run_id or not mlflow_uri:
+        return None
+    try:
+        r = requests.get(f"{mlflow_uri.rstrip('/')}/api/2.0/preview/mlflow/runs/get?run_id={run_id}", timeout=5.0)
+        return r.json() if r.ok else None
+    except Exception:
+        return None
+
+def main(attestation, run_id, mlflow_uri, out):
+    att = load_attestation(attestation)
+    bundle = {
+        "attestation": att,
+        "rekor_index": (att.get("rekorIndex") if isinstance(att, dict) else None),
+        "mlflow": fetch_mlflow_run(run_id, mlflow_uri),
+        "generated_at": time.time(),
+        "ci": {"run_id": os.environ.get("GITHUB_RUN_ID","")}
+    }
+    with open(out, "w") as f:
+        json.dump(bundle, f, indent=2)
+    print("Wrote evidence bundle to", out)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
