+#!/usr/bin/env python3
+"""
+Pre-load attestation webhook: validates Rekor index or attestation before allowing model load.
+"""
+import os, requests
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+REKOR_URL = os.environ.get("REKOR_URL", "https://rekor.aegis.example.com")
+
+def verify_rekor_index(index):
+    try:
+        r = requests.get(f"{REKOR_URL}/api/v1/log/entries?logIndex={index}", timeout=5)
+        return r.ok and bool(r.json())
+    except Exception:
+        return False
+
+@app.route("/validate_load", methods=["POST"])
+def validate_load():
+    req = request.json or {}
+    evidence = req.get("evidence", {})
+    ri = evidence.get("rekor_index")
+    if ri and verify_rekor_index(ri):
+        return jsonify({"ok": True})
+    # additional cosign sig or attestation checks could be added
+    return jsonify({"ok": False, "reason": "missing_or_invalid_attestation"}), 403
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8600")))
+
