+#!/usr/bin/env python3
+"""
+DP experiment harness using a simple Gaussian mechanism.
+Replace with PyDP/diffprivlib for production grade evaluation.
+"""
+import numpy as np, json, sys, time
+
+def dp_aggregate(vectors, epsilon=1.0, sensitivity=1.0):
+    mean = np.mean(np.array(vectors), axis=0)
+    sigma = sensitivity / epsilon
+    noise = np.random.normal(0, sigma, size=mean.shape)
+    return (mean + noise).tolist()
+
+if __name__ == "__main__":
+    data = json.loads(sys.argv[1]) if len(sys.argv)>1 else [[0.2,0.1],[0.1,0.2],[0.3,0.0]]
+    out = dp_aggregate(data, epsilon=float(sys.argv[2]) if len(sys.argv)>2 else 0.5)
+    print(json.dumps({"dp_result": out}))
+
