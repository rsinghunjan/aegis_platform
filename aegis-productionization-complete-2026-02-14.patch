+#!/usr/bin/env python3
+"""
+Simple HIL enforcer service used by Aegis to request human approval for critical actions.
+Records intents and provides request_id for polling/approval.
+"""
+from flask import Flask, request, jsonify
+import time, os
+
+app = Flask(__name__)
+STORE = {}
+
+@app.route("/intent", methods=["POST"])
+def intent():
+    j = request.json or {}
+    rid = f"req-{int(time.time())}"
+    STORE[rid] = {"status":"PENDING", "summary": j.get("summary","")}
+    return jsonify({"ok": True, "request_id": rid})
+
+@app.route("/status/<rid>", methods=["GET"])
+def status(rid):
+    v = STORE.get(rid, {"status":"UNKNOWN"})
+    return jsonify({"request_id": rid, "status": v.get("status")})
+
+@app.route("/approve/<rid>", methods=["POST"])
+def approve(rid):
+    if rid in STORE:
+        STORE[rid]["status"] = "APPROVED"
+        return jsonify({"ok": True})
+    return jsonify({"ok": False}), 404
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8082")))
+
