+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Orchestrate exhaustive HIL campaigns + Apalache triage until either:
+#  - HIL scenarios pass and Apalache produces no counterexamples, or
+#  - max iterations reached.
+#
+# Usage:
+#  ./run_exhaustive_hil_and_close_formal.sh --scenarios-file ops/av/certification/default_scenarios.txt --golden /opt/aegis/golden_trace.ndjson --out /tmp/hil_cert --cosign kms://...
+
+SCENARIOS_FILE="ops/av/certification/default_scenarios.txt"
+GOLDEN="/opt/aegis/golden_trace.ndjson"
+OUT=${1:-/tmp/hil_cert_$(date +%s)}
+COSIGN=${COSIGN_KMS_URI:-}
+MAX_ITER=${MAX_ITER:-5}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --scenarios-file) SCENARIOS_FILE="$2"; shift 2;;
+    --golden) GOLDEN="$2"; shift 2;;
+    --out) OUT="$2"; shift 2;;
+    --cosign) COSIGN="$2"; shift 2;;
+    --max-iter) MAX_ITER="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+mkdir -p "$OUT"
+
+echo "Starting exhaustive HIL + formal run"
+iter=0
+while [ "$iter" -lt "$MAX_ITER" ]; do
+  iter=$((iter+1))
+  run_out="$OUT/iter_$iter"
+  mkdir -p "$run_out"
+  echo "HIL Campaign iteration $iter"
+  python3 ops/robotics/control/certified/hil_certification_runner.py --scenarios-file "$SCENARIOS_FILE" --golden "$GOLDEN" --out "$run_out" --cosign-key "$COSIGN" || true
+  # Check Apalache outputs presence
+  # apalache outputs expected in run_out/apalache* or recorded in manifest
+  apalache_ok=false
+  if grep -q '"apalache_ok": true' "$run_out/cert_manifest.json" 2>/dev/null || [ -f "$run_out/apalache_clean.marker" ]; then
+    apalache_ok=true
+  else
+    echo "Apalache indicates issues; operator must triage counterexamples (see $run_out)"
+  fi
+  # HIL pass check: find campaign_summary.json
+  hil_pass=false
+  if [ -f "$run_out/campaign_summary.json" ]; then
+    fails=$(jq '[.scenarios[] | select(.compare_ok==false or .ran_ok==false)] | length' "$run_out/campaign_summary.json" 2>/dev/null || echo 1)
+    if [ "$fails" -eq 0 ]; then
+      hil_pass=true
+    fi
+  fi
+  echo "Iteration $iter: apalache_ok=$apalache_ok hil_pass=$hil_pass"
+  if [ "$apalache_ok" = "true" ] && [ "$hil_pass" = "true" ]; then
+    echo "Certification conditions met on iteration $iter"
+    bundle="$OUT/hil_cert_bundle_$(date +%s).tar.gz"
+    tar -czf "$bundle" -C "$run_out" . || true
+    if [ -n "$COSIGN" ]; then
+      cosign sign --key "$COSIGN" "$bundle" || true
+    fi
+    echo "Produced signed HIL cert bundle: $bundle"
+    exit 0
+  fi
+  # Pause for operator triage
+  echo "Pausing for operator triage and fixes before next iteration. Inspect $run_out"
+  exit 1
+done
+
+echo "Max iterations reached without meeting certification conditions. Inspect outputs under $OUT"
+exit 2
+
