+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Provision and label self-hosted runners / builder hosts.
+# - Installs minimum toolchain: cosign, rekor-cli, apalache (if available), and vendor SDK placeholders.
+# - Writes label file /etc/aegis-runner-labels with provided labels.
+#
+# Usage (run on each runner as root or via sudo):
+#   sudo COSIGN_VERSION=v1.15.0 REKOR_VERSION=v0.12.0 LABELS="role=builder,npu=graphcore" ./provision_and_label_runners.sh
+
+COSIGN_VERSION=${COSIGN_VERSION:-"latest"}
+REKOR_VERSION=${REKOR_VERSION:-"latest"}
+LABELS=${LABELS:-"role=generic"}
+LABEL_FILE=${LABEL_FILE:-"/etc/aegis-runner-labels"}
+
+echo "Provisioning runner: installing tools & writing labels"
+
+install_cosign() {
+  if command -v cosign >/dev/null 2>&1; then
+    echo "cosign present"
+    return
+  fi
+  echo "Installing cosign..."
+  # try release binary install (best-effort)
+  if [ "$COSIGN_VERSION" = "latest" ]; then
+    BIN_URL="$(curl -s https://api.github.com/repos/sigstore/cosign/releases/latest | jq -r '.assets[] | select(.name|test(\"cosign-linux-amd64$\")) | .browser_download_url')"
+  else
+    BIN_URL="https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-linux-amd64"
+  fi
+  if [ -n "$BIN_URL" ]; then
+    curl -fsSL "$BIN_URL" -o /usr/local/bin/cosign || true
+    chmod +x /usr/local/bin/cosign || true
+  fi
+}
+
+install_rekor() {
+  if command -v rekor-cli >/dev/null 2>&1; then
+    echo "rekor-cli present"
+    return
+  fi
+  echo "Installing rekor-cli..."
+  # best-effort binary install
+  if [ "$REKOR_VERSION" = "latest" ]; then
+    BIN_URL="$(curl -s https://api.github.com/repos/sigstore/rekor/releases/latest | jq -r '.assets[] | select(.name|test(\"rekor-cli-linux-amd64$\")) | .browser_download_url')"
+  else
+    BIN_URL="https://github.com/sigstore/rekor/releases/download/${REKOR_VERSION}/rekor-cli-linux-amd64"
+  fi
+  if [ -n "$BIN_URL" ]; then
+    curl -fsSL "$BIN_URL" -o /usr/local/bin/rekor-cli || true
+    chmod +x /usr/local/bin/rekor-cli || true
+  fi
+}
+
+install_apalache() {
+  if command -v apalache-mc >/dev/null 2>&1; then
+    echo "Apalache present"
+    return
+  fi
+  echo "Apalache not found — skip (operator should install apalache on formal hosts)"
+}
+
+install_vendor_sdks_placeholder() {
+  echo "Vendor SDK installation is vendor- and hardware-specific."
+  echo "Place vendor SDK install steps here (neuron-cc, poplar, habana tools)."
+}
+
+write_labels() {
+  echo "labels=${LABELS}" > "$LABEL_FILE"
+  chmod 644 "$LABEL_FILE"
+  echo "Wrote labels to $LABEL_FILE:"
+  cat "$LABEL_FILE"
+}
