+#!/usr/bin/env python3
+"""
+Submit evidence bundle to certifier and track findings.
+ - POSTs bundle to certifier upload URL (if provided) and polls a findings endpoint (best-effort).
+ - Stores certifier response and findings in ./certifier_findings/<run-id>/
+ - Records manifest via evidence_sdk.
+"""
+import argparse, os, time, json
+from datetime import datetime
+
+def upload_bundle(bundle_path, upload_url, api_token=None):
+    if not upload_url:
+        print("No upload URL provided; skipping upload")
+        return None
+    import requests
+    headers = {}
+    if api_token:
+        headers["Authorization"] = f"Bearer {api_token}"
+    files = {"file": open(bundle_path,"rb")}
+    resp = requests.post(upload_url, files=files, headers=headers, timeout=120)
+    try:
+        return resp.json()
+    except Exception:
+        return {"status": resp.status_code, "text": resp.text}
+
+def poll_findings(findings_url, api_token=None, poll_interval=60, timeout_s=3600):
+    import requests
+    headers = {}
+    if api_token:
+        headers["Authorization"] = f"Bearer {api_token}"
+    start=time.time()
+    while time.time() - start < timeout_s:
+        try:
+            r=requests.get(findings_url, headers=headers, timeout=30)
+            if r.status_code==200:
+                j=r.json()
+                # Best-effort: if findings list empty -> done
+                if not j.get("findings"):
+                    print("No findings returned yet; continue polling")
+                else:
+                    return j
+        except Exception as e:
+            print("poll error:", e)
+        time.sleep(poll_interval)
+    return {"error":"timeout"}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--bundle", required=True)
+    p.add_argument("--upload-url", default="")
+    p.add_argument("--findings-url", default="")
+    p.add_argument("--api-token", default=os.environ.get("CERTIFIER_API_TOKEN",""))
+    p.add_argument("--outdir", default=f"./certifier_findings_{int(datetime.utcnow().timestamp())}")
+    args = p.parse_args()
+    os.makedirs(args.outdir, exist_ok=True)
+    upload_resp = upload_bundle(args.bundle, args.upload_url, args.api_token)
+    with open(os.path.join(args.outdir,"upload_response.json"), "w") as fh:
+        json.dump(upload_resp, fh, indent=2)
+    if args.findings_url:
+        findings = poll_findings(args.findings_url, args.api_token)
+        with open(os.path.join(args.outdir,"findings.json"), "w") as fh:
+            json.dump(findings, fh, indent=2)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("certifier_submission_and_findings", {"bundle": args.bundle, "outdir": args.outdir})
+    except Exception:
+        pass
+    print("Submission and findings collection complete. Artifacts in", args.outdir)
+
+if __name__ == "__main__":
+    main()
+
