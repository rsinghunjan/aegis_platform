+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Orchestrate large sim batches -> HIL -> field triage pipeline
+#  1) Generate scenario packs and submit to sim cluster (Argo)
+#  2) Run HIL jobs against failing sim scenarios via hil_adapter_stub
+#  3) Collect failing cases and prepare adversarial datasets for retrain
+#  4) Trigger retrain + NPU validation
+#
+# Usage:
+#  ./run_sim_hil_field_pipeline.sh --packs 20 --per-pack 200 --out /tmp/perception_pipeline --npu-runners runner1,runner2 --cosign kms://...
+
+PACKS=10
+PER_PACK=100
+PARALLEL=4
+OUT=${1:-/tmp/perception_pipeline_$(date +%s)}
+NPU_RUNNERS=${NPU_RUNNERS:-}
+COSIGN=${COSIGN_KMS_URI:-}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --packs) PACKS="$2"; shift 2;;
+    --per-pack) PER_PACK="$2"; shift 2;;
+    --parallel) PARALLEL="$2"; shift 2;;
+    --out) OUT="$2"; shift 2;;
+    --npu-runners) NPU_RUNNERS="$2"; shift 2;;
+    --cosign) COSIGN="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+mkdir -p "$OUT"
+
+echo "Generating and running sim cluster packs..."
+python3 ops/av/perception/scale/run_simulation_cluster.py --packs "$PACKS" --scenarios-per-pack "$PER_PACK" --parallel "$PARALLEL" --out "$OUT/sim_cluster"
+
+FAILURES="$OUT/sim_cluster/failures.json"
+if [ -f "$FAILURES" ]; then
+  echo "Sim failures collected: $FAILURES"
+  echo "Submitting failing scenarios to HIL runner (stub)"
+  python3 ops/av/sim_hil/hil_adapter_stub.py --pack "$OUT/sim_cluster" --outdir "$OUT/hil_in"
+  echo "Running HIL tests..."
+  # operator to map scenarios to real HIL runner commands; we call hil_campaign_manager for demo
+  python3 ops/robotics/control/certified/hil_campaign_manager.py --scenarios "run_hil_scenario.sh" --golden /opt/aegis/golden_trace.ndjson --out "$OUT/hil_campaign"
+  echo "Collect OOD failures and create adv dataset"
+  python3 ops/av/perception/scale/ood_failure_collector.py --failures "$FAILURES" --out "$OUT/adv_dataset"
+  echo "Trigger retrain + test on NPU"
+  python3 ops/av/perception/scale/auto_retrain_pipeline.py --dataset "$OUT/adv_dataset/adv_data.ndjson" --out "$OUT/retrain" --npu-runners "$NPU_RUNNERS" --cosign-key "$COSIGN" || true
+else
+  echo "No failures produced by sim cluster; inspect sim outputs"
+fi
+
+echo "Sim->HIL->Field pipeline complete. Output under $OUT"
