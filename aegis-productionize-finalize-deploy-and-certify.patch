+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run RT sweep on provided target(s) and produce signed rt_slo_proof bundles.
+# Accepts TARGETS env var or single argument as comma-separated host:iface entries.
+#
+# Example:
+#  TARGETS="ecu1:can0,ecu2:eth1" COSIGN_KMS_URI=kms://... S3_UPLOAD=s3://aegis-evidence/run123 ./run_rt_sweep_and_sign.sh /tmp/rt_out
+
+OUT=${1:-/tmp/aegis_rt_sweep_$(date +%s)}
+TARGETS=${TARGETS:-}
+COSIGN=${COSIGN_KMS_URI:-}
+S3=${S3_UPLOAD:-}
+
+mkdir -p "$OUT"
+
+if [ -z "$TARGETS" ]; then
+  echo "No TARGETS env set; defaulting to localhost:can0"
+  TARGETS="localhost:can0"
+fi
+
+IFS="," read -r -a tarr <<< "$TARGETS"
+for t in "${tarr[@]}"; do
+  host=${t%%:*}
+  iface=${t#*:}
+  id="${host}_${iface}_$(date +%s)"
+  od="$OUT/$id"
+  mkdir -p "$od"
+  echo "Running RT sweep for $host:$iface -> $od"
+  TARGETS="$host:$iface" COSIGN_KMS_URI="$COSIGN" S3_UPLOAD="$S3" ./ops/av/rt/run_hw_rt_sweep.sh "$od" || true
+  proof="$od/rt_slo_proof.json"
+  if [ -f "$proof" ]; then
+    echo "Found proof: $proof"
+    if [ -n "$COSIGN" ]; then
+      echo "Signing proof bundle"
+      bundle="$od/rt_slo_bundle.tar.gz"
+      tar -czf "$bundle" -C "$od" .
+      cosign sign --key "$COSIGN" "$bundle" || true
+      if [ -n "$S3" ]; then
+        aws s3 cp "$bundle" "$S3/rt_proofs/$(basename $bundle)" || true
+      fi
+    fi
+  else
+    echo "No proof for $t — check run logs"
+  fi
+done
+
+echo "RT sweep run complete. Output under $OUT"
+
