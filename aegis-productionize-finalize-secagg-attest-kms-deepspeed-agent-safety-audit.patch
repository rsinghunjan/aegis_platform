+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Deploy a cosign-signed tool manifest to the jailed executor by creating/updating a k8s ConfigMap.
+# Requires kubectl context for cluster and MANIFEST path.
+MANIFEST=${1:-ops/agents/tool_manifest/tool_manifest.json}
+NAMESPACE=${NAMESPACE:-aegis-agent}
+CM_NAME=${CM_NAME:-aegis-tool-manifest}
+
+if ! command -v cosign >/dev/null 2>&1; then
+  echo "cosign required"
+  exit 2
+fi
+
+echo "Verifying manifest signature"
+cosign verify "$MANIFEST" || (echo "manifest verify failed" && exit 3)
+
+echo "Applying manifest as ConfigMap"
+kubectl -n "$NAMESPACE" create configmap "$CM_NAME" --from-file=tool_manifest.json="$MANIFEST" -o yaml --dry-run=client | kubectl apply -f -
+
+echo "Restart jailed executor deployment to pick up manifest"
+kubectl -n "$NAMESPACE" rollout restart deployment/jailed-executor || true
+echo "Manifest deployed"
+
