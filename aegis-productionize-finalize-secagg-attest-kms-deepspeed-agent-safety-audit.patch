+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Validate AWS CloudTrail for KMS Sign activity for cosign usage in the last 7 days.
+# Requires awscli configured with read privileges for CloudTrail events.
+START=$(date -u -d '7 days ago' +"%Y-%m-%dT%H:%M:%SZ")
+END=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
