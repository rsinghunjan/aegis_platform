+#!/usr/bin/env python3
+"""
+Simple watchdog daemon that expects periodic heartbeats from robot controllers.
+If heartbeat stops, it triggers the E-STOP endpoint.
+Run this on a controller-management host with network access to estop_service.
+"""
+import os, time, requests, signal, sys
+
+HEARTBEAT_FILE = os.environ.get("HEARTBEAT_FILE", "/tmp/robot_heartbeat.json")
+ESTOP_URL = os.environ.get("ESTOP_URL", "http://estop-service:8085/estop")
+TIMEOUT = int(os.environ.get("WATCHDOG_TIMEOUT", "10"))
+
+def read_heartbeat():
+    try:
+        import json
+        return json.load(open(HEARTBEAT_FILE))
+    except Exception:
+        return {"ts": 0}
+
+def trigger_estop():
+    try:
+        requests.post(ESTOP_URL, json={"estop": True}, timeout=5)
+    except Exception:
+        pass
+
+def main():
+    while True:
+        hb = read_heartbeat()
+        age = time.time() - float(hb.get("ts", 0))
+        if age > TIMEOUT:
+            print("Watchdog: heartbeat stale (age)", age, "triggering E-STOP")
+            trigger_estop()
+        time.sleep(2)
+
+if __name__=="__main__":
+    main()
+
