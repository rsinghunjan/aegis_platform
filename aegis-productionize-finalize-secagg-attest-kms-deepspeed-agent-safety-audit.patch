+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Drive attestation E2E verification using real quote files produced by hardware or enclaves.
+# Usage:
+#   ATTEST_SERVICE=http://attest:6060 ./attestation_e2e_test.sh tpm quote.bin ak_pub.pem
+#   ATTEST_SERVICE=http://attest:6060 ./attestation_e2e_test.sh sgx quote.bin
+#   ATTEST_SERVICE=http://attest:6060 ./attestation_e2e_test.sh nitro attestation.json
+ATTEST=${ATTEST_SERVICE:-http://localhost:6060}
+TYPE=${1:?type required: tpm|sgx|nitro}
+FILE=${2:?quote file}
+AK=${3:-}
+
+if [ "$TYPE" = "tpm" ]; then
+  QUOTE=$(base64 -w0 "$FILE")
+  AK_PUB=$(base64 -w0 "$AK")
+  JSON=$(jq -n --arg q "$QUOTE" --arg ak "$AK_PUB" '{quote:$q, ak_pub:$ak}')
+  curl -s -X POST "$ATTEST/attest" -H "Content-Type: application/json" -d "{\"client_id\":\"test-client\",\"type\":\"tpm\",\"report\":$JSON}" | jq .
+elif [ "$TYPE" = "sgx" ]; then
+  QUOTE=$(base64 -w0 "$FILE")
+  curl -s -X POST "$ATTEST/attest" -H "Content-Type: application/json" -d "{\"client_id\":\"test-sgx\",\"type\":\"sgx\",\"report\":{\"quote\":\"$QUOTE\"}}" | jq .
+elif [ "$TYPE" = "nitro" ]; then
+  BODY=$(cat "$FILE")
+  curl -s -X POST "$ATTEST/attest" -H "Content-Type: application/json" -d "{\"client_id\":\"test-nitro\",\"type\":\"nitro\",\"report\":$BODY}" | jq .
+else
+  echo "unknown type"
+  exit 2
+fi
+
