+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Orchestrate strict secure-aggregation production build, test, adversary sim and package for auditor.
+# Requires:
+#  - Hardened self-hosted runner (ephemeral) with docker, git, cosign and network access limited.
+#  - Environment: OUTDIR, COSIGN_KMS_URI, S3_UPLOAD, REKOR_SERVER (optional)
+#
+REPO=${1:-https://github.com/google/secagg.git}
+TAG=${2:-master}
+OUTDIR=${OUTDIR:-/tmp/secagg_build}
+WORKDIR=$(mktemp -d)
+mkdir -p "$OUTDIR"
+
+echo "1) Build wheel in ephemeral hardened builder"
+echo "Cloning $REPO@$TAG"
+git clone --depth 1 --branch "$TAG" "$REPO" "$WORKDIR"
+cd "$WORKDIR"
+COMMIT=$(git rev-parse --verify HEAD)
+echo "commit:$COMMIT" > "$OUTDIR/provenance.txt"
+
+if [ -f "setup.py" ]; then
+  python3 -m venv .venv
+  source .venv/bin/activate
+  pip install --upgrade pip setuptools wheel
+  python3 setup.py bdist_wheel
+  mkdir -p "$OUTDIR/wheels"
+  cp dist/*.whl "$OUTDIR/wheels/" || true
+  deactivate
+else
+  echo "No setup.py: follow upstream build docs and put wheel(s) in $OUTDIR/wheels"
+fi
+
+echo "2) Checksums & provenance"
+cd "$OUTDIR/wheels" || true
+sha256sum *.whl > "$OUTDIR/checksums.sha256" || true
+echo "provenance_commit:$COMMIT" >> "$OUTDIR/provenance.txt"
+
+if [ -n "${COSIGN_KMS_URI:-}" ]; then
+  echo "3) Sign wheels with cosign KMS"
+  for w in *.whl; do
+    cosign sign --key "${COSIGN_KMS_URI}" "$w" || echo "cosign sign failed for $w"
+  done
+fi
+
+echo "4) Build runtime image with wheel(s)"
+RUNTIME_IMG=${RUNTIME_IMG:-aegis-fl:secagg-prod}
+DOCKERCTX=$(mktemp -d)
+mkdir -p "$DOCKERCTX/tmp/wheels"
+cp -r "$OUTDIR/wheels/"* "$DOCKERCTX/tmp/wheels/" || true
+cp -r ops/fl "$DOCKERCTX/ops/fl"
+cat > "$DOCKERCTX/Dockerfile" <<'EOF'
+FROM python:3.11-slim
+WORKDIR /workspace
+COPY tmp/wheels /tmp/wheels
+RUN pip install --no-cache-dir /tmp/wheels/* || true
+COPY ops/fl /workspace/ops/fl
+RUN pip install --no-cache-dir -r /workspace/ops/fl/requirements.txt || true
+ENTRYPOINT ["python3"]
+EOF
+
+docker build -t "${RUNTIME_IMG}" "$DOCKERCTX"
+echo "Runtime image built: ${RUNTIME_IMG}"
+
+echo "5) Run runtime import validation"
+docker run --rm "${RUNTIME_IMG}" python3 - <<'PY' || true
+try:
+    import secagg
+    print("secagg import OK")
+except Exception as e:
+    try:
+        import crypten
+        print("crypten import OK")
+    except Exception as e2:
+        print("No secure-aggregation lib present", e, e2)
+        raise SystemExit(2)
+PY
+
+echo "6) Run >100-client scale simulation and adversary test (self-hosted runner required)"
+export SECAGG_SIM_CLIENTS=${SECAGG_SIM_CLIENTS:-150}
+python3 ops/fl/tests/scale_secagg_simulation.py || echo "scale sim had issues (inspect /tmp/secagg_simulation_summary.json)"
+python3 ops/tests/secureagg_adversary_summary.py || true
+
+echo "7) Collect artifacts and prepare audit package"
+mkdir -p "$OUTDIR/audit"
+cp -r "$OUTDIR/wheels" "$OUTDIR/audit/" || true
+cp "$OUTDIR/checksums.sha256" "$OUTDIR/audit/" || true
+cp "$OUTDIR/provenance.txt" "$OUTDIR/audit/" || true
+cp /tmp/secagg_simulation_summary.json "$OUTDIR/audit/" || true
+cp /tmp/secureagg_adversary_summary.json "$OUTDIR/audit/" || true
+tar -czf "$OUTDIR/audit_bundle.tar.gz" -C "$OUTDIR" audit
+
+if [ -n "${COSIGN_KMS_URI:-}" ]; then
+  cosign sign --key "${COSIGN_KMS_URI}" "$OUTDIR/audit_bundle.tar.gz" || echo "cosign sign failed"
+fi
+if [ -n "${S3_UPLOAD:-}" ]; then
+  aws s3 cp "$OUTDIR/audit_bundle.tar.gz" "${S3_UPLOAD}/secagg_audit/$(basename $OUTDIR).tar.gz" || echo "s3 upload failed"
+fi
+if [ -n "${REKOR_SERVER:-}" ] && command -v rekor-cli >/dev/null 2>&1; then
+  rekor-cli upload --artifact "$OUTDIR/audit_bundle.tar.gz" --api-url "${REKOR_SERVER}" || echo "rekor upload failed"
+fi
+
+echo "Build & test complete. Artifacts in $OUTDIR. Deliver $OUTDIR/audit_bundle.tar.gz to independent crypto reviewer."
+echo "END"
