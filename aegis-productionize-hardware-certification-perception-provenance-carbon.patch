+#!/usr/bin/env python3
+"""
+Enforce builder provenance:
+ - Verify builder hardening and that all images in manifests are cosign-signed and have Rekor entries.
+ - Fail fast to block promotions if any check is missing.
+ - Use ensure_builder_hardening.py and strict_rekor_verify.py as helpers.
+"""
+import os, sys, subprocess, json
+
+MANIFESTS = os.environ.get("IMAGE_MANIFESTS","").split(",")
+REKOR_SERVER = os.environ.get("REKOR_SERVER","")
+BUILDERS = os.environ.get("BUILDERS","")
+
+def verify_builders():
+    cmd = ["python3","ops/ci/promotion_gate/ensure_builder_hardening.py"]
+    rc = subprocess.call(cmd)
+    return rc == 0
+
+def verify_images():
+    bad = []
+    for m in MANIFESTS:
+        if not m:
+            continue
+        try:
+            import yaml
+            docs = yaml.safe_load_all(open(m))
+            for d in docs:
+                def walk(o):
+                    if isinstance(o, dict):
+                        for k,v in o.items():
+                            if k=="image" and isinstance(v,str):
+                                img=v
+                                # cosign verify
+                                try:
+                                    subprocess.check_call(["cosign","verify",img], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+                                except Exception:
+                                    bad.append((img,"cosign_missing"))
+                                # rekor verify
+                                if REKOR_SERVER:
+                                    try:
+                                        subprocess.check_call(["python3","ops/ci/promotion_gate/strict_rekor_verify.py","--artifact",img,"--rekor-server",REKOR_SERVER])
+                                    except Exception:
+                                        bad.append((img,"rekor_missing_or_invalid"))
+                            else:
+                                walk(v)
+                    elif isinstance(o, list):
+                        for e in o:
+                            walk(e)
+                walk(d)
+        except Exception as e:
+            print("Failed parsing manifest", m, e)
+            bad.append((m,"parse_failed"))
+    return bad
+
+def main():
+    if not verify_builders():
+        print("Builder hardening verification failed. Block promotion.")
+        sys.exit(10)
+    bad = verify_images()
+    if bad:
+        print("Provenance failures found:")
+        for i,r in bad:
+            print(i,r)
+        sys.exit(11)
+    print("Builder provenance enforcement passed.")
+    sys.exit(0)
+
+if __name__=="__main__":
+    main()
+
