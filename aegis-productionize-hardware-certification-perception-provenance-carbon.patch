+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run deterministic hardware proofs across provided targets and fail if any target doesn't meet SLOs.
+# - Uses existing vehicle_rt_validation.sh / run_hw_rt_sweep.sh to produce rt_slo_proof.json per target.
+# - Calls rt_remediation_agent.py to emit remediation recommendations on failures.
+#
+# Usage:
+#   TARGETS="ecu1:can0,ecu2:eth0" COSIGN_KMS_URI=kms://... S3_UPLOAD=s3://aegis-evidence/run123 \
+#     ./ops/validation/hardware_proof_runner.sh --out /tmp/hw_proofs
+
+OUT=${1:-/tmp/aegis_hw_proofs_$(date +%s)}
+TARGETS=${TARGETS:-localhost:can0}
+COSIGN=${COSIGN_KMS_URI:-}
+S3=${S3_UPLOAD:-}
+
+mkdir -p "$OUT"
+
+echo "Starting hardware proof run -> $OUT"
+IFS="," read -r -a targets <<< "$TARGETS"
+failed=0
+for t in "${targets[@]}"; do
+  host=${t%%:*}
+  iface=${t#*:}
+  id="${host}_${iface}_$(date +%s)"
+  od="$OUT/$id"
+  mkdir -p "$od"
+  echo "[run] Target: $host iface: $iface -> $od"
+  # call run_hw_rt_sweep.sh for this single target (it accepts TARGETS env)
+  TARGETS="$host:$iface" COSIGN_KMS_URI="$COSIGN" S3_UPLOAD="$S3" ./ops/av/rt/run_hw_rt_sweep.sh "$od" || true
+  proof="$od/rt_slo_proof.json"
+  if [ ! -f "$proof" ]; then
+    echo "No rt_slo_proof.json for $t; marking failed"
+    failed=1
+    continue
+  fi
+  p99_ok=$(jq -r '.p99_ok // false' "$proof")
+  safe_ok=$(jq -r '.safe_ok // false' "$proof")
+  echo "Results for $t: p99_ok=$p99_ok safe_ok=$safe_ok"
+  if [ "$p99_ok" != "true" ] || [ "$safe_ok" != "true" ]; then
+    echo "SLOs failed for $t; running remediation suggestion"
+    python3 ops/validation/rt_remediation_agent.py --report "$proof" --out "$od/remediation.json" || true
+    failed=1
+  fi
+done
+
+if [ "$failed" -ne 0 ]; then
+  echo "Hardware proof run had failures. Inspect $OUT"
+  exit 2
+fi
+
+echo "All hardware proofs passed. Bundling and signing."
+bundle="$OUT/hw_proofs_$(date +%s).tar.gz"
+tar -czf "$bundle" -C "$OUT" .
+if [ -n "$COSIGN" ]; then
+  cosign sign --key "$COSIGN" "$bundle" || true
+fi
+if [ -n "$S3" ]; then
+  aws s3 cp "$bundle" "$S3" || true
+fi
+python3 - <<PY || true
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("hardware_proof_bundle", {"bundle":"$bundle"})
+print("recorded")
+PY
+echo "Hardware proof run complete. Bundle: $bundle"
+
