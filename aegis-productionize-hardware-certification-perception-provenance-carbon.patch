+#!/usr/bin/env python3
+"""
+Carbon monitor + threshold tuner
+ - Runs carbon monitor for a configured observation window (secs), computes rolling mean/variance
+ - Suggests a tuned threshold and writes override policy guidance
+ - Does not enforce; operators must adopt suggested thresholds into CI
+"""
+import argparse, time, json, statistics
+from datetime import datetime
+from ops.carbon.watttime_client import get_latest_intensity
+
+def collect(duration_s, interval_s, region):
+    samples=[]
+    end = time.time() + duration_s
+    while time.time() < end:
+        val = get_latest_intensity(region)
+        samples.append(val)
+        time.sleep(interval_s)
+    return [v for v in samples if v is not None]
+
+def suggest_threshold(samples, base_threshold):
+    if not samples:
+        return base_threshold
+    mean = statistics.mean(samples)
+    stdev = statistics.pstdev(samples)
+    # suggested: base + stdev factor
+    factor = 1.0 + min(1.0, stdev / (mean+1e-6))
+    return mean * factor
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--duration-s", type=int, default=3600, help="Observation duration in seconds")
+    p.add_argument("--interval-s", type=int, default=60, help="Poll interval seconds")
+    p.add_argument("--region", default="US-CA")
+    p.add_argument("--base-threshold", type=float, default=300.0)
+    p.add_argument("--out", default="/tmp/carbon_tune.json")
+    args = p.parse_args()
+    print("Collecting carbon data for", args.duration_s, "s...")
+    samples = collect(args.duration_s, args.interval_s, args.region)
+    suggested = suggest_threshold(samples, args.base_threshold)
+    report = {"collected_at": datetime.utcnow().isoformat()+"Z", "samples_count": len(samples), "mean": statistics.mean(samples) if samples else None, "stdev": statistics.pstdev(samples) if len(samples)>1 else 0.0, "suggested_threshold": suggested}
+    with open(args.out,"w") as fh:
+        json.dump(report, fh, indent=2)
+    print("Wrote tuning report to", args.out)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("carbon_tune_report", {"out": args.out})
+    except Exception:
+        pass
+
+if __name__=="__main__":
+    main()
+
