+#!/usr/bin/env python3
+"""
+Lightweight RT remediation agent (companion to hardware_proof_runner.sh)
+ - Parses rt_slo_proof.json and emits prioritized remediation actions.
+ - Intended to be run by operators after a failing SLO. Does not run changes automatically.
+"""
+import argparse, json, sys
+
+def remediate_suggestions(report):
+    s = []
+    if not report:
+        return ["No report data found"]
+    p99 = report.get("p99_ms")
+    p99_slo = report.get("p99_slo_ms", 0.2)
+    safe = report.get("safe_ms")
+    safe_slo = report.get("safe_slo_ms", 50.0)
+    if p99 is None:
+        s.append("No jitter samples found — ensure jitter sampler ran and produced rt_jitter_samples.ndjson")
+    else:
+        if p99 > p99_slo:
+            s.append(f"p99 ({p99} ms) > target ({p99_slo} ms): prioritize CPU isolation / IRQ affinity / raise control thread RTF priority.")
+            s.append("Check: PREEMPT_RT kernel, chrt/chrt -f for control process, cset shield, irqbalance disabled for critical NICs.")
+    if safe is None:
+        s.append("No safe-stop sample found — ensure safe-stop trace capture on HIL.")
+    else:
+        if safe > safe_slo:
+            s.append(f"safe-stop ({safe} ms) > target ({safe_slo} ms): investigate actuator chain latency & control loop deadlines.")
+            s.append("Check: command queuing, CAN/CAN-FD bus congestion, actuator firmware delays.")
+    return s
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--report", required=True)
+    p.add_argument("--out", default=None)
+    args = p.parse_args()
+    try:
+        r = json.load(open(args.report))
+    except Exception as e:
+        print("Failed to read report:", e)
+        sys.exit(3)
+    suggestions = remediate_suggestions(r)
+    output = {"report": args.report, "suggestions": suggestions}
+    if args.out:
+        with open(args.out, "w") as fh:
+            json.dump(output, fh, indent=2)
+        print("Wrote remediation to", args.out)
+    else:
+        print(json.dumps(output, indent=2))
+
+if __name__ == "__main__":
+    import json
+    main()
+
