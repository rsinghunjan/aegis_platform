+#!/usr/bin/env python3
+"""
+HIL Certification Runner
+ - Executes HIL campaign manager, runs Apalache triage until either clean or max attempts reached,
+   packages signed HIL bundles and optionally POSTs to a certifier endpoint.
+ - Records artifacts with evidence_sdk.
+"""
+import argparse, os, subprocess, json
+from datetime import datetime
+
+def run_campaign(scenarios, golden, outdir):
+    cmd = ["python3","ops/robotics/control/certified/hil_campaign_manager.py","--golden",golden,"--out",outdir]
+    for s in scenarios:
+        cmd += ["--scenarios", s]
+    return subprocess.call(cmd)
+
+def run_apalache(outdir):
+    return subprocess.call(["./ops/formal/apalache_triage_runner.sh", outdir])
+
+def package_and_sign(outdir, cosign_key):
+    bundle = outdir + ".tar.gz"
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception:
+            print("cosign signing failed (best-effort)")
+    return bundle
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--scenarios-file", required=True, help="file with one scenario runner command per line")
+    p.add_argument("--golden", required=True)
+    p.add_argument("--out", default=f"/tmp/hil_cert_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--cert-upload-url", default="")
+    p.add_argument("--max-apalache-attempts", type=int, default=5)
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    with open(args.scenarios_file) as fh:
+        scenarios = [l.strip() for l in fh if l.strip()]
+    rc = run_campaign(scenarios, args.golden, args.out)
+    ap_attempts = 0
+    ap_rc = 1
+    while ap_attempts < args.max_apalache_attempts:
+        ap_rc = run_apalache(args.out)
+        if ap_rc == 0:
+            print("Apalache checks clean")
+            break
+        ap_attempts += 1
+        print(f"Apalache had issues; attempt {ap_attempts}/{args.max_apalache_attempts}. Triage and fix, then retry.")
+        # Operator must triage; we pause after attempt
+        break
+    bundle = package_and_sign(args.out, args.cosign_key)
+    # optional upload to certifier
+    if args.cert_upload_url:
+        try:
+            import requests
+            with open(bundle,"rb") as fh:
+                r = requests.post(args.cert_upload_url, files={"file": fh}, timeout=120)
+                print("Certifier upload status:", r.status_code)
+        except Exception as e:
+            print("Failed to upload to certifier endpoint:", e)
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("hil_cert_bundle", {"bundle": bundle})
+    except Exception:
+        pass
+    print("HIL certification runner complete. Bundle:", bundle)
+
+if __name__=="__main__":
+    main()
+
