+#!/usr/bin/env python3
+"""
+Perception validation runner
+ - Orchestrates large-scale sim -> HIL -> retrain -> NPU validation cycle
+ - Produces signed model artifacts and evidence manifests
+"""
+import argparse, os, subprocess
+from datetime import datetime
+
+def generate_and_run(packs, per_pack, parallel, outdir):
+    cmd = ["python3","ops/av/perception/scale/run_simulation_cluster.py",
+           "--packs", str(packs), "--scenarios-per-pack", str(per_pack),
+           "--parallel", str(parallel), "--out", outdir]
+    return subprocess.call(cmd)
+
+def collect_and_retrain(failures_file, outdir, npu_runners, cosign_key):
+    coll_cmd = ["python3","ops/av/perception/scale/ood_failure_collector.py","--failures", failures_file, "--out", outdir]
+    rc = subprocess.call(coll_cmd)
+    if rc != 0:
+        return False
+    ndjson = os.path.join(outdir, "adv_data.ndjson")
+    retrain_cmd = ["python3","ops/av/perception/scale/auto_retrain_pipeline.py","--dataset", ndjson, "--out", outdir]
+    if npu_runners:
+        retrain_cmd += ["--npu-runners", ",".join(npu_runners)]
+    if cosign_key:
+        retrain_cmd += ["--cosign-key", cosign_key]
+    rc2 = subprocess.call(retrain_cmd)
+    return rc2 == 0
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--packs", type=int, default=10)
+    p.add_argument("--per-pack", type=int, default=100)
+    p.add_argument("--parallel", type=int, default=4)
+    p.add_argument("--out", default=f"/tmp/perception_val_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--npu-runners", default=os.environ.get("NPU_RUNNERS",""))
+    p.add_argument("--cosign-key", default=os.environ.get("COSIGN_KMS_URI",""))
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    print("Running simulation cluster...")
+    rc = generate_and_run(args.packs, args.per_pack, args.parallel, args.out)
+    failures = os.path.join(args.out, "failures.json")
+    if os.path.exists(failures):
+        print("Collected failures; starting retrain pipeline")
+        ok = collect_and_retrain(failures, os.path.join(args.out, "retrain"), args.npu_runners.split(",") if args.npu_runners else [], args.cosign_key)
+        if not ok:
+            print("Retrain pipeline failed; inspect artifacts")
+    else:
+        print("No failures.json produced by sim cluster; inspect sim outputs")
+    # record manifest
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest("perception_validation_run", {"out": args.out})
+    except Exception:
+        pass
+    print("Perception validation runner done. Output:", args.out)
+
+if __name__=="__main__":
+    main()
