+                      key: user
+                - name: PGPASSWORD
+                  valueFrom:
+                    secretKeyRef:
+                      name: {{ .Values.postgres.secretName }}
+                      key: password
+                - name: S3_BUCKET
+                  value: "{{ .Values.postgres.backupBucket | default "" }}"
+              command:
+                - /bin/sh
+                - -c
+                - |
+                  apk add --no-cache postgresql-client gzip py3-pip || true
+                  DUMP="/tmp/mcp-$(date +%Y%m%d%H%M).sql.gz"
+                  PGPASSWORD="$PGPASSWORD" pg_dump -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d {{ .Values.postgres.database }} | gzip > "$DUMP"
