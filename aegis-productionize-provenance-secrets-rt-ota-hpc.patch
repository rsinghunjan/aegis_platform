+name: Sign artifact with KMS and upload to Rekor
+on:
+  workflow_dispatch:
+jobs:
+  sign-and-upload:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Install cosign
+        run: |
+          curl -sSL -o cosign https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64
+          chmod +x cosign
+          sudo mv cosign /usr/local/bin/cosign
+
+      - name: Sign artifact with KMS
+        env:
+          COSIGN_KMS_URI: ${{ secrets.COSIGN_KMS_URI }}
+          ARTIFACT_PATH: ${{ github.event.inputs.artifact_path || 'artifact.bin' }}
+          REKOR_URL: ${{ secrets.REKOR_SERVER || '' }}
+        run: |
+          if [ -z "$COSIGN_KMS_URI" ]; then
+            echo "COSIGN_KMS_URI not set. Abort."
+            exit 1
+          fi
+          if [ ! -f "$ARTIFACT_PATH" ]; then
+            echo "Artifact not found: $ARTIFACT_PATH"
+            exit 1
+          fi
+          echo "Signing $ARTIFACT_PATH with KMS $COSIGN_KMS_URI"
+          cosign sign-blob --kms "$COSIGN_KMS_URI" --output-signature "${ARTIFACT_PATH}.sig" "$ARTIFACT_PATH"
+          echo "Signature: ${ARTIFACT_PATH}.sig"
+          if [ -n "$REKOR_URL" ]; then
+            echo "Attaching to Rekor using cosign upload (best-effort)"
+            cosign upload-blob --rekor-url "$REKOR_URL" --signature "${ARTIFACT_PATH}.sig" "$ARTIFACT_PATH" || true
+          fi
+
