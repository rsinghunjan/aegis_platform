+#!/usr/bin/env bash
+set -euo pipefail
+# CI helper: sign a given file with KMS and verify Rekor presence (best-effort)
+ARTIFACT=${1:-}
+KMS_URI=${COSIGN_KMS_URI:-}
+REKOR_URL=${REKOR_URL:-}
+
+if [ -z "$ARTIFACT" ] || [ ! -f "$ARTIFACT" ]; then
+  echo "usage: $0 <artifact>"
+  exit 2
+fi
+if [ -z "$KMS_URI" ]; then
+  echo "COSIGN_KMS_URI not set; cannot sign"
+  exit 2
+fi
+
+cosign sign-blob --kms "$KMS_URI" --output-signature "${ARTIFACT}.sig" "$ARTIFACT"
+echo "Signed artifact: ${ARTIFACT}.sig"
+
+if [ -n "$REKOR_URL" ]; then
+  # Attempt to upload signature/artifact to Rekor using cosign upload-blob (best-effort)
+  cosign upload-blob --rekor-url "$REKOR_URL" --signature "${ARTIFACT}.sig" "$ARTIFACT" || true
+  echo "Requested Rekor upload (best-effort)"
+fi
+
