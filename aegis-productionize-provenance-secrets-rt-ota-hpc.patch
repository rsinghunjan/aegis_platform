+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Device-side OTA manifest verifier and applier (simplified).
+# Expects a manifest JSON and corresponding .sig (cosign sign-blob produced).
+#
+MANIFEST_URL=${1:-}
+SIG_URL=${2:-}
+COSIGN_PUB=${COSIGN_PUB:-}
+WORKDIR=${WORKDIR:-/tmp/ota}
+
+if [ -z "$MANIFEST_URL" ] || [ -z "$SIG_URL" ]; then
+  echo "usage: $0 <manifest_url> <sig_url>"
+  exit 2
+fi
+
+mkdir -p "$WORKDIR"
+MANIFEST_FILE="$WORKDIR/manifest.json"
+SIG_FILE="$MANIFEST_FILE.sig"
+curl -sS -o "$MANIFEST_FILE" "$MANIFEST_URL"
+curl -sS -o "$SIG_FILE" "$SIG_URL"
+
+if [ -z "$COSIGN_PUB" ]; then
+  echo "COSIGN_PUB not configured; cannot verify"
+  exit 1
+fi
+
+cosign verify-blob --key "$COSIGN_PUB" --signature "$SIG_FILE" "$MANIFEST_FILE"
+echo "Manifest verified"
+
+IMG_URL=$(jq -r '.image' "$MANIFEST_FILE")
+if [ -z "$IMG_URL" ] || [ "$IMG_URL" == "null" ]; then
+  echo "manifest missing image field"
+  exit 1
+fi
+
+echo "Downloading image $IMG_URL"
+curl -sS -o "$WORKDIR/image.tar.gz" "$IMG_URL"
+# Example apply: extract & run install script (operator-defined)
+tar -xzvf "$WORKDIR/image.tar.gz" -C "$WORKDIR"
+if [ -x "$WORKDIR/install.sh" ]; then
+  "$WORKDIR/install.sh"
+fi
+echo "OTA applied (device should validate runtime health and report)"
+
