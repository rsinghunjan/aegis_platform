+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Example helper to write Postgres credentials into Vault at path secret/data/mcp/postgres
+# Requires VAULT_ADDR and VAULT_TOKEN in env
+#
+if [ -z "${VAULT_ADDR:-}" ] || [ -z "${VAULT_TOKEN:-}" ]; then
+  echo "Set VAULT_ADDR and VAULT_TOKEN env variables"
+  exit 2
+fi
+
+POSTGRES_USER=${1:-mcpuser}
+POSTGRES_PASS=${2:-mcppassword}
+POSTGRES_HOST=${3:-postgres.example.com}
+POSTGRES_PORT=${4:-5432}
+POSTGRES_DB=${5:-mcpdb}
+
+curl --header "X-Vault-Token: $VAULT_TOKEN" --request POST \
+  --data "{\"data\":{\"username\":\"$POSTGRES_USER\",\"password\":\"$POSTGRES_PASS\",\"host\":\"$POSTGRES_HOST\",\"port\":\"$POSTGRES_PORT\",\"db\":\"$POSTGRES_DB\"}}" \
+  $VAULT_ADDR/v1/secret/data/mcp/postgres
+
+echo "Wrote secrets to Vault at secret/data/mcp/postgres"
+
