+#!/usr/bin/env python3
+"""
+Multipart upload helper using boto3 for very large checkpoint files.
+Uploads in chunks and returns s3:// URI. Retries simple and resumable.
+"""
+import os
+import math
+import boto3
+from botocore.exceptions import ClientError
+
+S3_BUCKET = os.environ.get("S3_BUCKET")
+CHUNK_SIZE = int(os.environ.get("MULTIPART_CHUNK_SIZE", str(50 * 1024 * 1024)))  # 50MB
+
+def multipart_upload(file_path, key):
+    s3 = boto3.client("s3")
+    file_size = os.path.getsize(file_path)
+    part_count = math.ceil(file_size / CHUNK_SIZE)
+    mpu = s3.create_multipart_upload(Bucket=S3_BUCKET, Key=key)
+    upload_id = mpu["UploadId"]
+    parts = []
+    try:
+        with open(file_path, "rb") as fh:
+            part_num = 1
+            while True:
+                data = fh.read(CHUNK_SIZE)
+                if not data:
+                    break
+                resp = s3.upload_part(Bucket=S3_BUCKET, Key=key, PartNumber=part_num, UploadId=upload_id, Body=data)
+                parts.append({"PartNumber": part_num, "ETag": resp["ETag"]})
+                part_num += 1
+        s3.complete_multipart_upload(Bucket=S3_BUCKET, Key=key, UploadId=upload_id, MultipartUpload={"Parts": parts})
+        return f"s3://{S3_BUCKET}/{key}"
+    except Exception as e:
+        s3.abort_multipart_upload(Bucket=S3_BUCKET, Key=key, UploadId=upload_id)
+        raise
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("usage: multipart_upload.py <file> <key>")
+        raise SystemExit(2)
+    print(multipart_upload(sys.argv[1], sys.argv[2]))
+
