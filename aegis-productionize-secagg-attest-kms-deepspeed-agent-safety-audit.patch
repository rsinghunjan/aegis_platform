+#!/usr/bin/env python3
+"""
+Verify approvals that accompany multi-party override requests.
+This script expects each approval as a separate signed blob (manifest.approvalX) that was signed
+with cosign (KMS) using cosign sign-blob. For each approval we run `cosign verify-blob`.
+
+Note: cosign verify-blob returns 0 if signature valid/verified. This script returns non-zero on any failure.
+"""
+import sys, subprocess, json
+
+if len(sys.argv) < 2:
+    print("Usage: verify_approvals.py approval1.bin approval2.bin ...")
+    sys.exit(2)
+
+failed = False
+for ap in sys.argv[1:]:
+    try:
+        subprocess.check_call(["cosign", "verify-blob", ap])
+        print(f"{ap}: ok")
+    except subprocess.CalledProcessError:
+        print(f"{ap}: verify failed")
+        failed = True
+
+sys.exit(1 if failed else 0)
+
