+#!/usr/bin/env python3
+"""
+E-STOP provisioning service (soft/hardware interface).
+ - Exposes HTTP endpoints to query and toggle E-STOP state (protected by RBAC in prod)
+ - Emits Kubernetes Event or writes to a monitored topic when E-STOP triggers
+ - In production, integrate with hardware GPIO or controller API and require multi-party confirmation
+"""
+import os, time, json
+from flask import Flask, jsonify, request
+
+app = Flask(__name__)
+ESTOP_FILE = os.environ.get("ESTOP_FILE", "/tmp/aegis_estop_state.json")
+
+def read_state():
+    if not os.path.exists(ESTOP_FILE):
+        return {"estop": False, "ts": time.time()}
+    return json.load(open(ESTOP_FILE))
+
+def write_state(s):
+    open(ESTOP_FILE, "w").write(json.dumps(s))
+
+@app.route("/estop", methods=["GET"])
+def get_estop():
+    return jsonify(read_state())
+
+@app.route("/estop", methods=["POST"])
+def set_estop():
+    body = request.json or {}
+    state = bool(body.get("estop", True))
+    # In prod require approvals - placeholder enforced outside this service
+    write_state({"estop": state, "ts": time.time()})
+    return jsonify({"ok": True, "estop": state})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8085")))
+
