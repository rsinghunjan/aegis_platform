+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Hardened builder steps to produce an audited secure-aggregation wheel.
+# Intended to run on ephemeral, isolated build host. Produces wheel(s), checksums,
+# provenance.json and (optionally) cosign signs the wheel.
+#
+# Usage:
+#   OUTDIR=/out/wheels CHECKSUMS_URL=... COSIGN_KMS_URI=... ./production_builder_hardened.sh <repo> <tag>
+REPO=${1:-https://github.com/google/secagg.git}
+TAG=${2:-master}
+OUTDIR=${OUTDIR:-/out/wheels}
+CHECKSUMS_URL=${CHECKSUMS_URL:-""}
+COSIGN_KMS_URI=${COSIGN_KMS_URI:-""}
+PROVFILE=${PROVFILE:-/out/provenance.json}
+
+mkdir -p "$OUTDIR"
+WORKDIR=$(mktemp -d)
+echo "builder: workdir=$WORKDIR" > "$PROVFILE"
+echo "builder: repo=$REPO tag=$TAG" >> "$PROVFILE"
+cd "$WORKDIR"
+
+# Clone pinned commit
+git clone --depth 1 --branch "$TAG" "$REPO" src || { echo "git clone failed"; exit 2; }
+cd src
+COMMIT=$(git rev-parse --verify HEAD)
+echo "commit:$COMMIT" >> "$PROVFILE"
+
+# Optional: verify upstream-supplied checksums (signed) if provided via secure channel
+if [ -n "$CHECKSUMS_URL" ]; then
+  curl -fsSL "$CHECKSUMS_URL" -o /tmp/secagg_checksums.txt
+  sha256sum --check /tmp/secagg_checksums.txt || (echo "checksum failed" && exit 3)
+  echo "checksums_verified:true" >> "$PROVFILE"
+fi
+
+# Build wheel(s) according to project instructions
+if [ -f "setup.py" ]; then
+  python3 -m venv .venv
+  source .venv/bin/activate
+  pip install --upgrade pip setuptools wheel
+  python3 setup.py bdist_wheel
+  mkdir -p "$OUTDIR"
+  find dist -name "*.whl" -exec cp {} "$OUTDIR" \;
+  deactivate
+else
+  echo "No Python packaging found; follow upstream build docs and place wheel(s) in $OUTDIR"
+fi
+
+# Record checksums & provenance
+cd "$OUTDIR"
+sha256sum *.whl > checksums.sha256 || true
+echo "artifact_count: $(ls -1 *.whl | wc -l)" >> "$PROVFILE"
+echo "checksums_file: $OUTDIR/checksums.sha256" >> "$PROVFILE"
+echo "provenance: $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$PROVFILE"
+
+# Optionally sign artifacts with cosign via KMS
+if [ -n "$COSIGN_KMS_URI" ]; then
+  for w in *.whl; do
+    echo "Signing $w with cosign KMS"
+    cosign sign --key "$COSIGN_KMS_URI" "$w" || echo "cosign sign failed for $w"
+  done
+fi
+
+echo "Build complete. Wheels and provenance are in $OUTDIR"
+
