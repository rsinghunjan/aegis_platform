+#!/usr/bin/env python3
+"""
+CLI for prompt registry: create, list, promote and sign prompt bundles.
+Intended for CI use and operator automation.
+"""
+import argparse, json, requests, os, subprocess, tempfile
+
+SERVICE_URL = os.environ.get("PROMPT_REGISTRY_URL","http://localhost:5003")
+COSIGN_KMS = os.environ.get("COSIGN_KMS_URI","")
+
+def create(args):
+    doc = {"id": args.id, "name": args.name, "version": args.version, "template": open(args.file).read(), "metadata": {"author": args.author}, "status":"draft"}
+    r = requests.post(f"{SERVICE_URL}/prompts", json=doc)
+    print(r.status_code, r.text)
+
+def list_(args):
+    r = requests.get(f"{SERVICE_URL}/prompts")
+    print(r.json())
+
+def promote(args):
+    r = requests.post(f"{SERVICE_URL}/prompts/{args.id}/promote", json={"env": args.env})
+    print(r.status_code, r.text)
+
+def main():
+    p = argparse.ArgumentParser()
+    sp = p.add_subparsers(dest="cmd")
+    c = sp.add_parser("create")
+    c.add_argument("--id", required=True)
+    c.add_argument("--name", required=True)
+    c.add_argument("--version", default="v1")
+    c.add_argument("--file", required=True)
+    c.add_argument("--author", default="ci")
+    sp.add_parser("list")
+    pr = sp.add_parser("promote")
+    pr.add_argument("--id", required=True)
+    pr.add_argument("--env", default="staging")
+    args = p.parse_args()
+    if args.cmd == "create":
+        create(args)
+    elif args.cmd == "list":
+        list_(args)
+    elif args.cmd == "promote":
+        promote(args)
+    else:
+        p.print_help()
+
+if __name__=="__main__":
+    main()
+
