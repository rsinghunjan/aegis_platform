+#!/usr/bin/env python3
+"""
+Summarizer wrapper: calls an LLM summarizer endpoint if configured, otherwise falls back to simple extractive summary.
+Configure SUMMARIZER_ENDPOINT (HTTP) to use a hosted summarizer.
+"""
+import os, requests
+
+SUMMARIZER_ENDPOINT = os.environ.get("SUMMARIZER_ENDPOINT","")
+
+def summarize_text(text, max_tokens=256):
+    if SUMMARIZER_ENDPOINT:
+        try:
+            r = requests.post(SUMMARIZER_ENDPOINT, json={"text": text, "max_tokens": max_tokens}, timeout=10)
+            return r.json().get("summary","")
+        except Exception:
+            pass
+    # simple fallback: return first N chars
+    return text[: max_tokens * 4 ]
+
