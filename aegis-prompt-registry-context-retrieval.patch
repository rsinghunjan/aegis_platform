+#!/usr/bin/env python3
+"""
+FAISS tuning script: sweeps nlist and nprobe values and reports recall/latency on a small eval set.
+Requires numpy embeddings file and eval queries with ground-truth ids.
+"""
+import argparse, numpy as np, time, faiss, json, os
+
+def evaluate(index, qvecs, gt_ids, topk=10):
+    t0 = time.time()
+    D, I = index.search(qvecs, topk)
+    latency = (time.time() - t0) / len(qvecs)
+    # compute recall@k
+    hits = 0
+    for i, row in enumerate(I):
+        if gt_ids[i] in row:
+            hits += 1
+    return {"recall_at_k": hits/len(gt_ids), "latency_s_per_query": latency}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--embeddings", required=True)
+    p.add_argument("--queries", required=True)
+    p.add_argument("--gt", required=True)
+    p.add_argument("--dim", type=int, required=True)
+    args = p.parse_args()
+    xb = np.load(args.embeddings)
+    qv = np.load(args.queries)
+    gt = json.load(open(args.gt))
+    results = {}
+    for nlist in [256, 1024, 4096]:
+        quant = faiss.IndexFlatL2(args.dim)
+        index = faiss.IndexIVFFlat(quant, args.dim, nlist, faiss.METRIC_L2)
+        index.train(xb)
+        index.add(xb)
+        res = evaluate(index, qv, gt, topk=10)
+        results[str(nlist)] = res
+    out = os.path.join("/tmp","faiss_tune_results.json")
+    with open(out, "w") as fh:
+        json.dump(results, fh, indent=2)
+    print("Wrote results to", out)
+
+if __name__=="__main__":
+    main()
+
