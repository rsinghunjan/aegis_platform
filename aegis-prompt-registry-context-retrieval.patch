+#!/usr/bin/env python3
+"""
+Improved context composer:
+ - semantic chunking (ops/prompt/context/semantic_chunker.py)
+ - summarization per chunk
+ - retrieval of relevant chunks via provided retriever interface
+ - token budget enforcement via dynamic_truncation helper
+"""
+from ops.prompt.context.semantic_chunker import chunk_text_semantic
+from ops.prompt.context.summarizer import summarize_text
+from ops.serving.autoscaler.dynamic_truncation import compute_truncation
+import os, json
+
+def compose(document_texts, query, retriever, budget_tokens=None, topk=5):
+    budget_tokens = budget_tokens or compute_truncation(current_tokens_per_sec=0)
+    # chunk docs
+    chunks = []
+    for d in document_texts:
+        chunks.extend(chunk_text_semantic(d, max_tokens= max(256, budget_tokens//4), stride=64))
+    # get embeddings/retrieval scores via retriever
+    # retriever.query_texts(query, texts) -> list of (text, score)
+    candidates = retriever.query_texts(query, chunks, topk=topk) if hasattr(retriever, "query_texts") else chunks[:topk]
+    # summarize candidates to reduce tokens
+    summaries = [summarize_text(c if isinstance(c,str) else c[0], max_tokens=128) for c in candidates]
+    context = "\n\n".join(summaries)
+    prompt = f"Context:\n{context}\n\nQuestion: {query}\nAnswer:"
+    return prompt
+
