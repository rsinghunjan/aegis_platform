+#!/usr/bin/env python3
+"""
+Prompt Registry Service (lightweight)
+ - Stores prompts with metadata, parent lineage, A/B test tags and rollout status (draft/promoted/retired)
+ - Exposes simple CRUD + promote endpoint which bundles and signs prompt artifacts if COSIGN_KMS_URI available
+"""
+import os, sqlite3, json, tempfile, subprocess
+from flask import Flask, request, jsonify, g
+from datetime import datetime
+
+DB_PATH = os.environ.get("AEGIS_PROMPT_DB", "/var/lib/aegis/prompt_registry.db")
+COSIGN_KMS = os.environ.get("COSIGN_KMS_URI", "")
+
+app = Flask(__name__)
+
+def get_db():
+    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+    db = getattr(g, "_database", None)
+    if db is None:
+        db = g._database = sqlite3.connect(DB_PATH, check_same_thread=False)
+        db.row_factory = sqlite3.Row
+    return db
+
+def init_db():
+    db = get_db()
+    db.execute("""
+    CREATE TABLE IF NOT EXISTS prompts (
+      id TEXT PRIMARY KEY,
+      name TEXT,
+      version TEXT,
+      template TEXT,
+      metadata TEXT,
+      lineage TEXT,
+      status TEXT,
+      created_at TEXT
+    )
+    """)
+    db.commit()
+
+@app.before_first_request
+def _init():
+    init_db()
+
+@app.route("/prompts", methods=["POST"])
+def create_prompt():
+    doc = request.json
+    pid = doc.get("id")
+    if not pid:
+        return jsonify({"error":"id required"}), 400
+    db = get_db()
+    db.execute("INSERT OR REPLACE INTO prompts (id,name,version,template,metadata,lineage,status,created_at) VALUES (?,?,?,?,?,?,?,?)",
+               (pid, doc.get("name"), doc.get("version","v1"), doc.get("template",""), json.dumps(doc.get("metadata",{})), json.dumps(doc.get("lineage",[])), doc.get("status","draft"), datetime.utcnow().isoformat()+"Z"))
+    db.commit()
+    return jsonify({"ok":True})
+
+@app.route("/prompts/<pid>", methods=["GET"])
+def get_prompt(pid):
+    db = get_db()
+    r = db.execute("SELECT * FROM prompts WHERE id=?", (pid,)).fetchone()
+    if not r:
+        return jsonify({"error":"not found"}), 404
+    return jsonify(dict(r))
+
+@app.route("/prompts", methods=["GET"])
+def list_prompts():
+    db = get_db()
+    rows = db.execute("SELECT id,name,version,status,created_at FROM prompts").fetchall()
+    return jsonify([dict(r) for r in rows])
+
+def bundle_and_sign_prompt(id, out_dir="/tmp"):
+    db = get_db()
+    r = db.execute("SELECT * FROM prompts WHERE id=?", (id,)).fetchone()
+    if not r:
+        raise RuntimeError("prompt not found")
+    tmp = tempfile.mkdtemp(prefix="prompt_bundle_")
+    path = os.path.join(tmp, f"{id}.json")
+    with open(path, "w") as fh:
+        fh.write(json.dumps(dict(r), indent=2))
+    tar = os.path.join(out_dir, f"prompt_{id}.tar.gz")
+    subprocess.check_call(["tar","-czf",tar,"-C", tmp, "."])
+    if COSIGN_KMS:
+        try:
+            subprocess.check_call(["cosign","sign","--key",COSIGN_KMS,tar])
+        except Exception as e:
+            # log and continue: signing may fail in dev
+            print("cosign sign failed:", e)
+    return tar
+
+@app.route("/prompts/<pid>/promote", methods=["POST"])
+def promote_prompt(pid):
+    body = request.json or {}
+    target_env = body.get("env","staging")
+    # update status
+    db = get_db()
+    db.execute("UPDATE prompts SET status=? WHERE id=?", ("promoted", pid))
+    db.commit()
+    # bundle and sign
+    try:
+        bundle = bundle_and_sign_prompt(pid)
+    except Exception as e:
+        return jsonify({"error":"bundle failed", "detail": str(e)}), 500
+    return jsonify({"ok":True, "bundle": bundle, "env": target_env})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "5003")))
+
