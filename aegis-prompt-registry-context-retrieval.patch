+#!/usr/bin/env python3
+"""
+Semantic chunker: chunk documents into overlapping chunks with approximate token counts.
+This is lightweight and avoids external tokenizer dependencies; swap in tiktoken for token-accurate counts.
+"""
+import math, re
+
+def sentence_tokenize(text):
+    # naive sentence splitter
+    return re.split(r'(?<=[.!?])\s+', text)
+
+def chunk_text_semantic(text, max_tokens=800, stride=128):
+    sentences = sentence_tokenize(text)
+    chunks = []
+    cur = []
+    cur_len = 0
+    for s in sentences:
+        s_len = len(s.split())
+        if cur_len + s_len > max_tokens:
+            chunks.append(" ".join(cur))
+            # start new window with stride overlap
+            cur = cur[-max(0, int(stride/10)):]  # overlap approx by sentences
+            cur_len = sum(len(x.split()) for x in cur)
+        cur.append(s)
+        cur_len += s_len
+    if cur:
+        chunks.append(" ".join(cur))
+    return chunks
+
+if __name__=="__main__":
+    txt = "This is a sentence. " * 200
+    cs = chunk_text_semantic(txt, max_tokens=50, stride=20)
+    print(len(cs), cs[0][:200])
+
