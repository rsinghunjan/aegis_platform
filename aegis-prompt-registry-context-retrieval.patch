+#!/usr/bin/env python3
+"""
+Basic grounding checker:
+ - Given model output and topK retrieved docs, compute simple grounding_precision:
+   fraction of factual claims in text that are present (keyword match) in at least one doc.
+ - This is a heuristic check for CI/monitoring and should be extended with NLP-based claim detection.
+"""
+import json, re, os
+
+def extract_claims(text):
+    # naive: return sentences that contain verbs and nouns; in practice use NLP/NER + claim detection
+    sents = re.split(r'(?<=[.!?])\s+', text)
+    return [s.strip() for s in sents if len(s.split())>3][:20]
+
+def check_grounding(output_text, docs):
+    claims = extract_claims(output_text)
+    hits = 0
+    for c in claims:
+        for d in docs:
+            if c.split()[0].lower() in d.lower() or c[:10].lower() in d.lower():
+                hits += 1
+                break
+    gp = hits/len(claims) if claims else 0.0
+    return {"claims": len(claims), "hits": hits, "grounding_precision": gp}
+
+if __name__=="__main__":
+    out = "The device uses a 400Hz sampling and GPS position is fused."
+    docs = ["GPS position is fused using sensor fusion", "sampling at 400Hz is used in pipeline"]
+    print(check_grounding(out, docs))
