+#!/usr/bin/env python3
+"""
+Redis-backed session store for conversation state and token accounting.
+Requires REDIS_URL env variable.
+"""
+import redis, os, json, time
+
+REDIS_URL = os.environ.get("REDIS_URL","redis://redis:6379/0")
+TTL_SECONDS = int(os.environ.get("SESSION_TTL_SEC","86400"))
+
+r = redis.from_url(REDIS_URL)
+
+def new_session(session_id, persona=None):
+    key = f"session:{session_id}"
+    data = {"session_id": session_id, "persona": persona or {}, "history": [], "tokens_used": 0, "created_at": time.time()}
+    r.set(key, json.dumps(data), ex=TTL_SECONDS)
+    return session_id
+
+def load_session(session_id):
+    key = f"session:{session_id}"
+    v = r.get(key)
+    if not v:
+        return None
+    return json.loads(v)
+
+def append_turn(session_id, user, assistant, tokens):
+    key = f"session:{session_id}"
+    s = load_session(session_id)
+    if not s:
+        new_session(session_id)
+        s = load_session(session_id)
+    s["history"].append({"user": user, "assistant": assistant, "ts": time.time()})
+    s["tokens_used"] += tokens
+    r.set(key, json.dumps(s), ex=TTL_SECONDS)
+
