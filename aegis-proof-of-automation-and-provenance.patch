+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click Proof-of-Automation (PoA)
+# Runs: tokenize/shard -> sharded-train (smoke) -> sim (optional) -> RT sweeps -> HIL + Apalache invariant closure -> build auditor bundle
+# Measures time-to-evidence and writes KPI report
+#
+# Usage:
+#   COSIGN_KMS_URI=... REKOR_SERVER=... S3_UPLOAD=s3://... ./ops/runbooks/one_click_pofa.sh --dataset /data/train.jsonl --invariant ops/formal/specs/safety.tla --targets "ecu1:can0" --scenarios ops/av/certification/falcon_scenarios.txt --out /tmp/pofa_run
+
+DATASET=""
+INVARIANT=""
+TARGETS=""
+SCENARIOS=""
+OUT=${OUT:-/tmp/pofa_run_$(date +%s)}
+COSIGN=${COSIGN_KMS_URI:-}
+S3=${S3_UPLOAD:-}
+HUMAN_HOURS_BEFORE=${HUMAN_HOURS_BEFORE:-0}
+HUMAN_HOURS_AFTER=${HUMAN_HOURS_AFTER:-0}
+DO_SIM=true
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --dataset) DATASET="$2"; shift 2;;
+    --invariant) INVARIANT="$2"; shift 2;;
+    --targets) TARGETS="$2"; shift 2;;
+    --scenarios) SCENARIOS="$2"; shift 2;;
+    --out) OUT="$2"; shift 2;;
+    --no-sim) DO_SIM=false; shift;;
+    *) shift;;
+  esac
+done
+
+mkdir -p "$OUT"
+echo "One-click PoA starting. OUT=$OUT"
+START_TS=$(date +%s)
+REPORT="$OUT/pofa_report.json"
+STAGES=()
+
+stage_start() {
+  STAGE_NAME="$1"
+  echo "=== START STAGE: $STAGE_NAME ==="
+  eval "STAGE_${STAGE_NAME}_START=$(date +%s)"
+}
+
+stage_end() {
+  STAGE_NAME="$1"
+  eval "STAGE_${STAGE_NAME}_END=$(date +%s)"
+  start=$(eval "echo \$STAGE_${STAGE_NAME}_START")
+  end=$(eval "echo \$STAGE_${STAGE_NAME}_END")
+  dur=$((end-start))
+  STAGES+=("{\"stage\":\"$STAGE_NAME\",\"start\":$start,\"end\":$end,\"duration_s\":$dur}")
+  echo "=== END STAGE: $STAGE_NAME (duration ${dur}s) ==="
+}
+
+# 1) Tokenize & shard
+stage_start "tokenize_shard"
+if [ -z "$DATASET" ]; then
+  echo "No dataset provided; skipping tokenization/shard stage"
+else
+  python3 ops/llm/tokenizer_prep.py --dataset "$DATASET" --out "$OUT/shards" --tokenizer-out "$OUT/tokenizer" --shard-size 20000 --shuffle
+fi
+stage_end "tokenize_shard"
+
+# 2) Validate GPU cluster (best-effort)
+stage_start "gpu_validate"
+./ops/llm/validate_gpu_cluster.sh || true
+stage_end "gpu_validate"
+
+# 3) Sharded training (smoke)
+stage_start "sharded_train_smoke"
+if [ -f "$OUT/shards/shard_manifest.json" ]; then
+  python3 ops/llm/training_pipeline_launcher.py --shard-manifest "$OUT/shards/shard_manifest.json" --train-cmd "${TRAIN_CMD:-./train.py}" --nodes 1 --gpus-per-node 1 --hours 0.5 --cost-slo 200 --out "$OUT/train" || true
+else
+  echo "Shard manifest not found; running training launcher with placeholder manifest"
+  python3 ops/llm/training_pipeline_launcher.py --shard-manifest /dev/null --train-cmd "${TRAIN_CMD:-./train.py}" --nodes 1 --gpus-per-node 1 --hours 0.5 --cost-slo 200 --out "$OUT/train" || true
+fi
+stage_end "sharded_train_smoke"
+
+# 4) (Optional) Sim packs & collect failures (light)
+if [ "$DO_SIM" = "true" ]; then
+  stage_start "sim_run"
+  mkdir -p "$OUT/sim"
+  # Run a small sim pack run (best-effort)
+  python3 ops/av/perception/scale/scale_orchestrator.py --packs 2 --per-pack 50 --parallel 1 --out "$OUT/sim" --dry-run || true
+  stage_end "sim_run"
+fi
+
+# 5) RT sweeps & hardware proofs
+stage_start "hw_rt_sweeps"
+if [ -n "$TARGETS" ]; then
+  python3 ops/validation/run_hw_validation_pipeline.py --targets "$TARGETS" --out "$OUT/hw" --cosign "$COSIGN" --s3 "$S3" --p99-threshold 0.5 --safe-threshold-ms 50 || true
+else
+  echo "No hardware targets provided; skipping RT sweeps"
+fi
+stage_end "hw_rt_sweeps"
+
+# 6) HIL + Apalache invariant closure
+stage_start "hil_formal_closure"
+if [ -n "$SCENARIOS" ] && [ -n "$INVARIANT" ]; then
+  python3 ops/robotics/control/hil_invariant_closure.py --scenarios-file "$SCENARIOS" --invariant "$INVARIANT" --golden /opt/aegis/golden_trace.ndjson --out "$OUT/hil" --cosign "$COSIGN" || true
+else
+  echo "Scenarios or invariant not provided; running hil_formal_closure_runner default (if present)"
+  python3 ops/robotics/control/hil_formal_closure_runner.py --scenarios-file "${SCENARIOS:-ops/av/certification/falcon_scenarios.txt}" --golden /opt/aegis/golden_trace.ndjson --out "$OUT/hil" --cosign "$COSIGN" || true
+fi
+stage_end "hil_formal_closure"
+
+# 7) Build auditor bundle & sign
+stage_start "auditor_bundle"
+python3 ops/certifier/auditor_package_allinone.py --root . --vehicle "PoA-Vehicle" --out "$OUT/auditor_bundle.tar.gz" --cosign-key "$COSIGN" --s3 "$S3" || true
+stage_end "auditor_bundle"
+
+END_TS=$(date +%s)
+TOTAL_DURATION=$((END_TS-START_TS))
+
+# Compose report
+python3 - <<PY > "$REPORT"
+import json, sys, os, time
+stages = [$(','.join(STAGES))]
+report = {
+  "started_at": $START_TS,
+  "ended_at": $END_TS,
+  "total_duration_s": $TOTAL_DURATION,
+  "human_hours_before": float($HUMAN_HOURS_BEFORE),
+  "human_hours_after": float($HUMAN_HOURS_AFTER),
+  "stages": stages
+}
+json.dump(report, sys.stdout, indent=2)
+PY
+
+echo "PoA report written to $REPORT"
+# Record manifest best-effort
+python3 - <<PY || true
+try:
+  from ops.sdk.evidence_sdk import record_manifest
+  record_manifest("pofa_report", {"path":"$REPORT"})
+  print("Recorded pofa_report manifest")
+except Exception:
+  print("Could not record manifest (ops.sdk.evidence_sdk missing)")
+PY
+
+echo "One-click PoA finished (total ${TOTAL_DURATION}s). See $REPORT"
+
