+#!/usr/bin/env python3
+"""
+Run HIL campaign and Apalache triage focused on a single safety invariant.
+ - Invokes HIL campaign manager and runs Apalache on provided TLA+ invariant file.
+ - Produces signed HIL cert bundle when successful.
+"""
+import argparse, os, subprocess, sys, json
+from datetime import datetime
+
+def run_hil(scenarios_file, golden, outdir):
+    os.makedirs(outdir, exist_ok=True)
+    cmd = ["python3","ops/robotics/control/certified/hil_campaign_manager.py","--golden",golden,"--out",outdir,"--scenarios-file",scenarios_file]
+    print("Running HIL campaign:", " ".join(cmd))
+    return subprocess.call(cmd)
+
+def run_apalache(spec_file, outdir):
+    # Apalache triage wrapper: expects spec file path and will output apalache_outputs under outdir
+    cmd = ["./ops/formal/apalache_triage_runner.sh", outdir, "--spec", spec_file]
+    print("Running Apalache triage:", " ".join(cmd))
+    return subprocess.call(cmd)
+
+def package_and_sign(outdir, cosign_key=None):
+    bundle = outdir.rstrip("/") + "_hil_cert_bundle.tar.gz"
+    subprocess.check_call(["tar","-czf",bundle,"-C",outdir,"."])
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    return bundle
+
+def record_manifest_safe(k,v):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest
+        record_manifest(k,v)
+    except Exception:
+        pass
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--scenarios-file", required=True)
+    p.add_argument("--invariant", required=True, help="Path to TLA+ spec/invariant file")
+    p.add_argument("--golden", required=True)
+    p.add_argument("--out", default=f"/tmp/hil_invariant_closure_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--cosign", default=os.environ.get("COSIGN_KMS_URI",""))
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    rc = run_hil(args.scenarios_file, args.golden, args.out)
+    if rc != 0:
+        print("HIL campaign failed. Operator triage required.")
+        sys.exit(2)
+    ap_rc = run_apalache(args.invariant, args.out)
+    if ap_rc != 0:
+        print("Apalache found issues with the invariant. Operator triage required.")
+        sys.exit(3)
+    bundle = package_and_sign(args.out, cosign_key=args.cosign)
+    record_manifest_safe("hil_invariant_bundle", {"bundle": bundle})
+    print("Invariant closure successful. Bundle:", bundle)
+    sys.exit(0)
+
