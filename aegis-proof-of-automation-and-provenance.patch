+#!/usr/bin/env python3
+"""
+KPI collector for Proof-of-Automation runs
+ - Reads PoA report JSON and optional baseline report
+ - Emits a simple before/after summary and a human-readable report plus JSON
+
+Usage:
+  python3 ops/metrics/kpi_collector.py --report /tmp/pofa_run/pofa_report.json --baseline /tmp/baseline.json --out /tmp/pofa_kpi_summary.json
+"""
+import argparse, json, os, statistics
+
+def load(path):
+    if not path or not os.path.exists(path):
+        return None
+    return json.load(open(path))
+
+def summarize(report):
+    out = {}
+    out["total_duration_s"] = report.get("total_duration_s")
+    out["stages"] = report.get("stages", [])
+    out["human_hours_before"] = report.get("human_hours_before", 0)
+    out["human_hours_after"] = report.get("human_hours_after", 0)
+    return out
+
+def compare(curr, baseline):
+    comp = {}
+    if not baseline:
+        comp["note"] = "no_baseline"
+        return comp
+    comp["total_duration_s_delta"] = curr["total_duration_s"] - baseline.get("total_duration_s", 0)
+    comp["human_hours_delta"] = curr.get("human_hours_after",0) - baseline.get("human_hours_after",0)
+    return comp
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--report", required=True)
+    p.add_argument("--baseline", default="")
+    p.add_argument("--out", default="/tmp/pofa_kpi_summary.json")
+    args = p.parse_args()
+    rep = load(args.report)
+    base = load(args.baseline) if args.baseline else None
+    summary = summarize(rep) if rep else {}
+    comp = compare({"total_duration_s": summary.get("total_duration_s",0),"human_hours_after": summary.get("human_hours_after",0)}, base)
+    out = {"summary": summary, "comparison": comp}
+    with open(args.out, "w") as fh:
+        json.dump(out, fh, indent=2)
+    print("Wrote KPI summary to", args.out)
+
