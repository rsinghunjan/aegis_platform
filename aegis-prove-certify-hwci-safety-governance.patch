+#!/usr/bin/env python3
+"""
+NPU readiness check that tries to detect vendor runtimes and run per-vendor smoke compile/run.
+Writes /tmp/npu_readiness.json and records an evidence manifest.
+"""
+import json, subprocess, os, time
+
+out = {"checked_at": time.time(), "vendors": {}}
+
+def run(cmd):
+    try:
+        subprocess.check_output(cmd, stderr=subprocess.STDOUT, timeout=60)
+        return True, ""
+    except Exception as e:
+        return False, str(e)
+
+# Inferentia
+inf_ok, inf_msg = run(["neuron-ls"])
+if inf_ok:
+    try:
+        subprocess.call(["python3","ops/hw/validation/inferentia_compile_run.py","ops/dl/inference/test_models/tiny_model.onnx"], timeout=300)
+        inf_smoke = True
+    except Exception as e:
+        inf_smoke = False
+        inf_msg = str(e)
+else:
+    inf_smoke = False
+out["vendors"]["inferentia"] = {"runtime_present": inf_ok, "smoke_ok": inf_smoke, "msg": inf_msg}
+
+# Graphcore
+gc_ok, gc_msg = run(["poprun","--help"])
+if gc_ok:
+    try:
+        subprocess.call(["python3","ops/hw/validation/graphcore_compile_run.py","ops/dl/inference/test_models/tiny_model.onnx"], timeout=300)
+        gc_smoke = True
+    except Exception as e:
+        gc_smoke = False
+        gc_msg = str(e)
+else:
+    gc_smoke = False
+out["vendors"]["graphcore"] = {"runtime_present": gc_ok, "smoke_ok": gc_smoke, "msg": gc_msg}
+
+# Habana
+hb_ok, hb_msg = run(["habana_info"])
+if hb_ok:
+    try:
+        subprocess.call(["python3","ops/hw/validation/habana_compile_run.py","ops/dl/inference/test_models/tiny_model.onnx"], timeout=300)
+        hb_smoke = True
+    except Exception as e:
+        hb_smoke = False
+        hb_msg = str(e)
+else:
+    hb_smoke = False
+out["vendors"]["habana"] = {"runtime_present": hb_ok, "smoke_ok": hb_smoke, "msg": hb_msg}
+
+path = os.environ.get("OUT_PATH", "/tmp/npu_readiness.json")
+with open(path, "w") as fh:
+    json.dump(out, fh, indent=2)
+try:
+    from ops.sdk.evidence_sdk import record_manifest
+    record_manifest("npu_readiness_check", {"report": path})
+except Exception:
+    pass
+print("Wrote NPU readiness report to", path)
+
