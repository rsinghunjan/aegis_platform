+#!/usr/bin/env python3
+"""
+Stricter supply-chain enforcement for CI promotion gates:
+ - Validates cosign signatures for images referenced in manifests
+ - Validates Rekor entries exist and attempts to confirm builder provenance
+ - Blocks promotion on any failure
+"""
+import os, sys, subprocess, yaml, json
+
+MANIFESTS = os.environ.get("IMAGE_MANIFESTS","").split(",")
+REKOR = os.environ.get("REKOR_SERVER","")
+
+def extract_images(paths):
+    images=set()
+    for p in paths:
+        if not p or not os.path.exists(p):
+            continue
+        for d in yaml.safe_load_all(open(p)):
+            def walk(obj):
+                if isinstance(obj, dict):
+                    for k,v in obj.items():
+                        if k=="image" and isinstance(v,str):
+                            images.add(v)
+                        else:
+                            walk(v)
+                elif isinstance(obj, list):
+                    for e in obj:
+                        walk(e)
+            walk(d)
+    return images
+
+def cosign_verify(img):
+    try:
+        subprocess.check_call(["cosign","verify",img], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True
+    except Exception:
+        return False
+
+def rekor_has(img):
+    if not REKOR:
+        return False
+    try:
+        out = subprocess.check_output(["rekor-cli","search","--rekor_server",REKOR,"--artifact",img])
+        return bool(out.strip())
+    except Exception:
+        return False
+
+def main():
+    imgs = extract_images(MANIFESTS)
+    bad=[]
+    for img in imgs:
+        if not cosign_verify(img):
+            bad.append((img,"cosign_missing"))
+            continue
+        if REKOR and not rekor_has(img):
+            bad.append((img,"rekor_missing"))
+    if bad:
+        print("Supply-chain enforcement failed:")
+        for i,r in bad:
+            print(i,r)
+        sys.exit(5)
+    print("Supply-chain enforcement passed for all images.")
+
+if __name__=="__main__":
+    main()
+
