+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run vendor NPU smoke tests, then run iterative RT validator on representative robot,
+# collect artifacts, sign bundle and record evidence.
+#
+# Usage:
+#   COSIGN_KMS_URI=kms://... REKOR_SERVER=https://rekor ... ./run_vendor_and_rt_validation.sh --node robot-host --out /tmp/aegis_audit_run --s3 s3://bucket/path/
+
+NODE=localhost
+OUTDIR=${OUT:-/tmp/aegis_audit_run_$(date +%s)}
+S3_UPLOAD=${S3_UPLOAD:-""}
+MAX_RT_ATTEMPTS=${MAX_RT_ATTEMPTS:-3}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --node) NODE="$2"; shift 2;;
+    --out) OUTDIR="$2"; shift 2;;
+    --s3) S3_UPLOAD="$2"; shift 2;;
+    --attempts) MAX_RT_ATTEMPTS="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+mkdir -p "$OUTDIR"
+echo "Audit run: node=$NODE out=$OUTDIR"
+
+echo "[1] Vendor NPU smoke tests (best-effort)"
+./ops/hw/validation/inferentia_compile_run.sh ops/dl/inference/test_models/tiny_model.onnx || true
+python3 ops/hw/validation/graphcore_compile_run.py ops/dl/inference/test_models/tiny_model.onnx || true
+python3 ops/hw/validation/habana_compile_run.py ops/dl/inference/test_models/tiny_model.onnx || true
+cp /tmp/*_smoke.json "$OUTDIR/" 2>/dev/null || true
+
+echo "[2] Run iterative RT validator"
+./ops/robotics/rt/lab_validation/iterative_rt_validator.sh "$NODE" "$OUTDIR/rt" || true
+cp "$OUTDIR"/rt* "$OUTDIR/" 2>/dev/null || true
+
+echo "[3] Run RT SLO prover to produce p99/safe-stop proof"
+python3 ops/robotics/rt/lab_validation/rt_slo_prover.py --bundle "${OUTDIR}.tar.gz" --out "$OUTDIR/rt_slo_proof.json" || true
+cp /tmp/rt_slo_proof.json "$OUTDIR/" 2>/dev/null || true
+
+echo "[4] Run NPU readiness summary"
+python3 ops/hw/validation/npu_readiness_check.py || true
+cp /tmp/npu_readiness.json "$OUTDIR/" 2>/dev/null || true
+
+echo "[5] Run formal packaging for controller artifacts"
+./ops/formal/formal_reviewer_package.sh "$OUTDIR/formal" || true
+
+echo "[6] Run controller certification harness (HIL)"
+python3 ops/robotics/control/certified/certification_harness.py --out "$OUTDIR/cert" --cosign-key "${COSIGN_KMS_URI:-}" || true
+
+echo "[7] Package and sign auditor bundle"
+tar -czf "${OUTDIR}.tar.gz" -C "$(dirname "$OUTDIR")" "$(basename "$OUTDIR")"
+if [ -n "${COSIGN_KMS_URI:-}" ]; then
+  cosign sign --key "${COSIGN_KMS_URI}" "${OUTDIR}.tar.gz" || true
+fi
+
+if [ -n "$S3_UPLOAD" ]; then
+  aws s3 cp "${OUTDIR}.tar.gz" "${S3_UPLOAD}" || true
+fi
+
+echo "[8] Record evidence manifest (best-effort)"
+python3 - <<PY || true
+from ops.sdk.evidence_sdk import record_manifest
+record_manifest("operator_audit_run", {"bundle":"${OUTDIR}.tar.gz","node":"$NODE"})
+print("manifest recorded")
+PY
+
+echo "Audit run complete. Bundle: ${OUTDIR}.tar.gz"
+
