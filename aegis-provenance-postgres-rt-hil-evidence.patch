+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create Kubernetes secret for MCP Postgres (from environment) and run Alembic migrations in-cluster (Job)
+#
+NAMESPACE=${1:-aegis-system}
+SECRET_NAME=${2:-mcp-postgres-secret}
+
+if [ -z "${MCP_POSTGRES_DSN:-}" ]; then
+  echo "Set MCP_POSTGRES_DSN environment variable to the Postgres DSN (postgresql://user:pass@host:5432/db)"
+  exit 1
+fi
+
+echo "Creating secret $SECRET_NAME in namespace $NAMESPACE"
+# Parse DSN (very basic)
+PY=$(python3 - <<PY
+import os, urllib.parse, sys
+dsn=os.environ.get("MCP_POSTGRES_DSN")
+u=dsn.split("://",1)[1]
+# user:pass@host:port/db
+userpass, hostdb = u.split("@",1)
+user, pwd = userpass.split(":",1)
+hostport, db = hostdb.split("/",1)
+host, port = hostport.split(":",1)
+print(user)
+print(pwd)
+print(host)
+print(port)
+print(db)
+PY
+)
+read -r USER PASS HOST PORT DB <<<"$PY"
+
+kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -
+kubectl -n "$NAMESPACE" create secret generic "$SECRET_NAME" --from-literal=user="$USER" --from-literal=password="$PASS" --from-literal=host="$HOST" --from-literal=port="$PORT" --from-literal=db="$DB" --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Triggering Helm upgrade (assumes helm chart helm/mcp exists)"
+helm upgrade --install mcp helm/mcp -n "$NAMESPACE" --set postgres.enabled=true --wait
+
+echo "Waiting for mcp-db-migrate job to finish..."
+kubectl -n "$NAMESPACE" wait --for=condition=complete job/mcp-db-migrate --timeout=300s || true
+
+echo "MCP Postgres setup complete"
+
