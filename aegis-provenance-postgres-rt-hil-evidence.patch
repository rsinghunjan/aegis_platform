+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Instructions / helper to build a PREEMPT_RT enabled kernel image for an Ubuntu-based node.
+# This script is a convenience; building kernels and re-imaging nodes is operator work and must be
+# validated on test hardware before production use.
+#
+KERNEL_VERSION=${1:-"6.1.0-rt"}
+OUT_IMG=${2:-"/tmp/preempt_rt_image.tar.gz"}
+
+echo "This script will not perform the full kernel build in CI. It prints steps for the operator."
+cat <<'DOC'
+Operator steps:
+1) On a build host:
+   apt-get install -y build-essential libncurses-dev bison flex libssl-dev libelf-dev \
+      bc kmod cpio
+2) Download Linux stable + PREEMPT_RT patch corresponding to your distro/kernel.
+3) Apply rt patch, configure (make menuconfig) enabling PREEMPT_RT_FULL or PREEMPT_RT
+4) Build kernel and modules: make -j$(nproc)
+5) Package kernel into a node image, push to your image registry or prepare a boot ISO
+6) Re-image test nodes, set sysctl tuned values (sched_rt_runtime_us, cpu isolation, irq affinity)
+7) Label nodes in Kubernetes: kubectl label node <node> aegis/rt=true
+8) Use RuntimeClass and nodeSelector to schedule RT pods
+DOC
+
+echo "Example sysctl tuning to apply on RT node (run as root):"
+echo "  sysctl -w kernel.sched_rt_runtime_us=950000"
+echo "  echo 2 > /proc/sys/kernel/softirqs_disable"
+echo "  # pin critical processes to isolated CPUs"
+
+echo "After preparing nodes, create a RuntimeClass and schedule pods using nodeSelector aegis/rt=true"
+
