+#!/usr/bin/env bash
+set -euo pipefail
+MCP_JSON=${1:-mcp_record.json}
+SIG_FILE="${MCP_JSON}.sig"
+COSIGN_PUB=${COSIGN_PUB:-}
+REKOR_SERVER=${REKOR_SERVER:-}
+
+if [ ! -f "$MCP_JSON" ] || [ ! -f "$SIG_FILE" ]; then
+  echo "Missing files: $MCP_JSON or $SIG_FILE"
+  exit 2
+fi
+
+if [ -z "$COSIGN_PUB" ]; then
+  echo "COSIGN_PUB not set; cannot verify signature"
+  exit 2
+fi
+
+cosign verify-blob --key "$COSIGN_PUB" --signature "$SIG_FILE" "$MCP_JSON"
+echo "cosign verified"
+
+if [ -n "$REKOR_SERVER" ]; then
+  DIGEST=$(openssl dgst -sha256 -binary "$MCP_JSON" | openssl base64 -A)
+  echo "Searching Rekor for artifact digest (base64): $DIGEST"
+  # best-effort Rekor API query - may require different encodings per Rekor version
+  RESP=$(curl -s "${REKOR_SERVER}/api/v1/log/entries?hash=${DIGEST}" || true)
+  if [ -z "$RESP" ] || [ "$RESP" = "null" ]; then
+    echo "No Rekor entry found - failing"
+    exit 2
+  fi
+  echo "Rekor entry found"
+fi
+
+echo "Provenance checks passed"
+
