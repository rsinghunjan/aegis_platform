+#!/usr/bin/env python3
+"""
+Enhanced evidence pack builder:
+ - collects model artifact references, MCP JSON(s), SLSA attestation(s), cosign signature(s),
+   simulation logs, HIL logs, test results
+ - creates a manifest (JSON) describing all files and metadata
+ - signs the manifest (if COSIGN_KEY available) producing <manifest>.sig
+ - optionally uploads to compliance vault
+"""
+import os
+import json
+import zipfile
+from pathlib import Path
+import subprocess
+import requests
+
+MCP_JSON = os.environ.get("MCP_JSON_PATH", "mcp_record.json")
+SLSA_PATH = os.environ.get("SLSA_PATH", "slsa-attestation.json")
+COSIGN_SIG = os.environ.get("COSIGN_SIG_PATH", "")
+SIM_DIR = Path(os.environ.get("SIM_LOG_DIR", "/tmp/carla_runs"))
+HIL_DIR = Path(os.environ.get("HIL_LOG_DIR", "/tmp/hil_runs"))
+TEST_RESULTS = os.environ.get("TEST_RESULTS_PATH", "")
+OUT_ZIP = Path(os.environ.get("EVIDENCE_OUT", "/tmp/evidence_enhanced.zip"))
+MANIFEST = Path(str(OUT_ZIP) + ".manifest.json")
+COMPLIANCE_UPLOAD_URL = os.environ.get("COMPLIANCE_UPLOAD_URL", "")
+COSIGN_KEY = os.environ.get("COSIGN_KEY", "")
+REKOR_SERVER = os.environ.get("REKOR_SERVER", "")
+
+def collect_files():
+    files = {}
+    if Path(MCP_JSON).exists():
+        files["mcp"] = str(Path(MCP_JSON).resolve())
+    if Path(SLSA_PATH).exists():
+        files["slsa"] = str(Path(SLSA_PATH).resolve())
+    if COSIGN_SIG and Path(COSIGN_SIG).exists():
+        files["cosign_sig"] = str(Path(COSIGN_SIG).resolve())
+    files["simulation"] = []
+    if SIM_DIR.exists():
+        for f in SIM_DIR.glob("**/*"):
+            if f.is_file():
+                files["simulation"].append(str(f.resolve()))
+    files["hil"] = []
+    if HIL_DIR.exists():
+        for f in HIL_DIR.glob("**/*"):
+            if f.is_file():
+                files["hil"].append(str(f.resolve()))
+    if TEST_RESULTS and Path(TEST_RESULTS).exists():
+        files["tests"] = str(Path(TEST_RESULTS).resolve())
+    return files
+
+def build_manifest(files):
+    manifest = {
+        "generated_at": int(__import__("time").time()),
+        "files": files,
+        "environment": {"rekor": REKOR_SERVER if REKOR_SERVER else None}
+    }
+    with open(MANIFEST, "w") as f:
+        json.dump(manifest, f, indent=2)
+    return MANIFEST
+
+def sign_manifest(manifest_path: Path):
+    if not COSIGN_KEY:
+        print("COSIGN_KEY not set, skipping manifest signing")
+        return None
+    sig_path = str(manifest_path) + ".sig"
+    try:
+        subprocess.check_call(["cosign", "sign-blob", "--key", COSIGN_KEY, str(manifest_path)])
+        # cosign creates <file>.sig next to the file
+        return sig_path
+    except Exception as e:
+        print("cosign sign-blob failed:", e)
+        return None
+
+def package_and_upload(files, manifest_path: Path, sig_path: str = None):
+    with zipfile.ZipFile(OUT_ZIP, "w") as z:
+        for k, v in files.items():
+            if isinstance(v, list):
+                for p in v:
+                    z.write(p, arcname=f"{k}/{Path(p).name}")
+            else:
+                z.write(v, arcname=f"{k}/{Path(v).name}")
+        z.write(manifest_path, arcname=manifest_path.name)
+        if sig_path and Path(sig_path).exists():
+            z.write(sig_path, arcname=Path(sig_path).name)
+    print("Packaged evidence at", OUT_ZIP)
+    if COMPLIANCE_UPLOAD_URL:
+        with open(OUT_ZIP, "rb") as fh:
+            try:
+                r = requests.post(COMPLIANCE_UPLOAD_URL, files={"file": fh}, timeout=30)
+                r.raise_for_status()
+                print("Uploaded evidence pack to compliance vault")
+            except Exception as e:
+                print("Upload failed:", e)
+
+def main():
+    files = collect_files()
+    manifest_path = build_manifest(files)
+    sig = sign_manifest(manifest_path)
+    package_and_upload(files, manifest_path, sig)
+
+if __name__ == "__main__":
+    main()
+
