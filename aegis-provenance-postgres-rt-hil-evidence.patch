+name: Enforce MCP Cosign + Rekor Presence (CI)
+on:
+  workflow_dispatch:
+  pull_request:
+    paths:
+      - '**/mcp_record.json'
+jobs:
+  enforce:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Install cosign and jq
+        run: |
+          curl -sSfL https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64 -o cosign
+          chmod +x cosign
+          sudo mv cosign /usr/local/bin/
+          sudo apt-get update && sudo apt-get install -y jq openssl
+
+      - name: Verify MCP JSON signature with cosign
+        env:
+          MCP_JSON_PATH: ${{ github.event.pull_request.head.repo.full_name && github.event.pull_request.head.repo.full_name || 'mcp_record.json' }}
+          COSIGN_PUB: ${{ secrets.COSIGN_PUB || '' }}
+        run: |
+          # Allow MCP JSON path override via workflow dispatch input
+          MCP_JSON=${{ github.event.inputs.mcp_json_path || 'mcp_record.json' }}
+          echo "Checking for MCP JSON at $MCP_JSON"
+          if [ ! -f "$MCP_JSON" ]; then
+            echo "MCP JSON not found at $MCP_JSON - failing"
+            exit 1
+          fi
+          SIG_FILE="${MCP_JSON}.sig"
+          if [ ! -f "$SIG_FILE" ]; then
+            echo "Signature file $SIG_FILE not found - failing"
+            exit 1
+          fi
+          if [ -z "$COSIGN_PUB" ]; then
+            echo "COSIGN_PUB secret not set - failing to enforce provenance"
+            exit 1
+          fi
+          cosign verify-blob --key "$COSIGN_PUB" --signature "$SIG_FILE" "$MCP_JSON"
+
+      - name: Check Rekor for entry (best-effort)
+        env:
+          REKOR_SERVER: ${{ secrets.REKOR_SERVER || '' }}
+        run: |
+          if [ -z "$REKOR_SERVER" ]; then
+            echo "REKOR_SERVER not set - skipping Rekor check"
+            exit 0
+          fi
+          MCP_JSON=${{ github.event.inputs.mcp_json_path || 'mcp_record.json' }}
+          DIGEST=$(openssl dgst -sha256 -binary "$MCP_JSON" | openssl base64 -A)
+          # Rekor API search by artifact hash (note: different Rekor versions vary; this is best-effort)
+          RESP=$(curl -s -X GET "${REKOR_SERVER}/api/v1/log/entries?hash=${DIGEST}" || true)
+          if [ -z "$RESP" ] || [ "$RESP" = "null" ]; then
+            echo "No Rekor entry found for artifact digest - failing provenance gate"
+            exit 1
+          fi
+          echo "Found Rekor entry"
+
