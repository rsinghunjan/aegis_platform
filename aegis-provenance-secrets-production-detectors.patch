+name: Sign with KMS (multi-provider) and upload to Rekor
+on:
+  workflow_dispatch:
+jobs:
+  sign-rekor:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Install cosign & jq
+        run: |
+          sudo apt-get update -y
+          sudo apt-get install -y jq
+          curl -sSL -o cosign https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64
+          chmod +x cosign
+          sudo mv cosign /usr/local/bin/cosign
+
+      - name: Sign artifact with KMS (COSIGN_KMS_URI must be set in secrets or input)
+        env:
+          COSIGN_KMS_URI: ${{ secrets.COSIGN_KMS_URI || github.event.inputs.cosign_kms_uri || '' }}
+          ARTIFACT_PATH: ${{ github.event.inputs.artifact_path || 'artifact.bin' }}
+          REKOR_URL: ${{ secrets.REKOR_SERVER || github.event.inputs.rekor_url || '' }}
+        run: |
+          if [ -z "$COSIGN_KMS_URI" ]; then
+            echo "COSIGN_KMS_URI is not set. Provide a KMS URI (aws-kms://..., gcp-kms://..., azure-kv://..., vault://...)"
+            exit 1
+          fi
+          if [ ! -f "$ARTIFACT_PATH" ]; then
+            echo "Artifact not found: $ARTIFACT_PATH"
+            exit 1
+          fi
+          echo "Signing $ARTIFACT_PATH with cosign KMS $COSIGN_KMS_URI"
+          cosign sign-blob --kms "$COSIGN_KMS_URI" --output-signature "${ARTIFACT_PATH}.sig" "$ARTIFACT_PATH"
+          echo "Signature written to ${ARTIFACT_PATH}.sig"
+          if [ -n "$REKOR_URL" ]; then
+            echo "Uploading to Rekor (best-effort)"
+            cosign upload-blob --rekor-url "$REKOR_URL" --signature "${ARTIFACT_PATH}.sig" "$ARTIFACT_PATH" || true
+          else
+            echo "REKOR_URL not provided; skipping Rekor upload"
+          fi
+
+      - name: Output signature path
+        run: |
+          ls -l ${{ github.event.inputs.artifact_path || 'artifact.bin' }}*
+
