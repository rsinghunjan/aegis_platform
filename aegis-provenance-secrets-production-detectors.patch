+from fastapi import FastAPI
+from pydantic import BaseModel
+from transformers import pipeline
+from prometheus_client import Counter, generate_latest, CONTENT_TYPE_LATEST
+from fastapi.responses import Response
+import os
+
+app = FastAPI(title="Aegis NLI Verifier")
+
+REQ_COUNTER = Counter("aegis_verifier_requests_total", "Verifier requests")
+FAIL_COUNTER = Counter("aegis_verifier_fail_total", "Verifier failures")
+
+# use a standard NLI model
+_model = os.environ.get("NLI_MODEL", "roberta-large-mnli")
+nli = pipeline("text-classification", model=_model, return_all_scores=True)
+
+class VerifyReq(BaseModel):
+    text: str
+    retrieved_docs: list
+
+@app.get("/metrics")
+def metrics():
+    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+@app.post("/verify")
+def verify(req: VerifyReq):
+    REQ_COUNTER.inc()
+    # heuristic: compute best entailment score across docs
+    best_score = 0.0
+    for d in req.retrieved_docs:
+        premise = d.get("text", "")
+        # use text-pair support (some tokenizer/pipelines accept dict with text/text_pair)
+        try:
+            out = nli({"text": premise, "text_pair": req.text})
+            # out is list of scores per label; model labels order may be [CONTRADICTION, NEUTRAL, ENTAILMENT] or similar
+            # find ENTAILMENT score if label present
+            for label_scores in out if isinstance(out, list) else [out]:
+                for entry in label_scores:
+                    lbl = entry.get("label","").lower()
+                    if "entail" in lbl:
+                        best_score = max(best_score, entry.get("score",0.0))
+        except Exception:
+            continue
+    allow = best_score >= float(os.environ.get("NLI_MIN_SCORE", "0.3"))
+    if not allow:
+        FAIL_COUNTER.inc()
+    return {"allow": allow, "score": best_score}
+
