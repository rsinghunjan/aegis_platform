+from fastapi import FastAPI
+from pydantic import BaseModel
+import os, requests
+from prometheus_client import Counter, generate_latest, CONTENT_TYPE_LATEST
+from fastapi.responses import Response
+
+app = FastAPI(title="Aegis PII Presidio Adapter")
+
+SCAN_COUNTER = Counter("aegis_pii_scan_total", "PII scans", ["type"])
+REDACT_COUNTER = Counter("aegis_pii_redact_total", "PII redactions", ["type"])
+
+PRESIDIO_URL = os.environ.get("PRESIDIO_ANALYZER", "http://presidio-analyzer:3000")
+
+class TextReq(BaseModel):
+    text: str
+
+@app.get("/metrics")
+def metrics():
+    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+@app.post("/scan_text")
+def scan_text(req: TextReq):
+    SCAN_COUNTER.labels(type="text").inc()
+    try:
+        r = requests.post(f"{PRESIDIO_URL}/api/v1/analyze", json={"text": req.text}, timeout=5.0)
+        r.raise_for_status()
+        return {"count": len(r.json()), "pii": r.json()}
+    except Exception:
+        # fallback: return empty
+        return {"count": 0, "pii": []}
+
+@app.post("/redact_text")
+def redact_text(req: TextReq):
+    REDACT_COUNTER.labels(type="text").inc()
+    try:
+        r = requests.post(f"{PRESIDIO_URL}/api/v1/analyze", json={"text": req.text}, timeout=5.0)
+        entities = r.json()
+        if not entities:
+            return {"redacted": req.text, "pii": []}
+        # Use Presidio's redact endpoint (if available) or naive masking
+        rr = requests.post(f"{PRESIDIO_URL}/api/v1/anonymize", json={"text": req.text, "anonymizers": {}}, timeout=5.0)
+        rr.raise_for_status()
+        return {"redacted": rr.json().get("text", req.text), "pii": entities}
+    except Exception:
+        return {"redacted": req.text, "pii": []}
+
