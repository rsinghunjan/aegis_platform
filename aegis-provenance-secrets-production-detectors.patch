+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from detoxify import Detoxify
+from prometheus_client import Counter, generate_latest, CONTENT_TYPE_LATEST
+from fastapi.responses import Response
+import os, base64
+
+app = FastAPI(title="Aegis Prod Moderation (Detoxify)")
+
+REQ_COUNTER = Counter("aegis_moderation_requests_total", "Moderation requests", ["type"])
+BLOCK_COUNTER = Counter("aegis_moderation_blocked_total", "Moderation blocked", ["type"])
+
+detox = None
+try:
+    detox = Detoxify('original')  # fallback model; ensure GPU where desired
+except Exception:
+    detox = None
+
+class TextReq(BaseModel):
+    text: str
+
+class ImageReq(BaseModel):
+    image_b64: str
+
+@app.get("/metrics")
+def metrics():
+    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+@app.post("/moderate_text")
+def moderate_text(req: TextReq):
+    REQ_COUNTER.labels(type="text").inc()
+    if detox:
+        res = detox.predict(req.text)
+        # Detoxify returns a dict with toxicity scores; thresholding example
+        toxic_score = max(res.get("toxicity", 0.0), res.get("sexual", 0.0))
+        nsfw = toxic_score > float(os.environ.get("MOD_TOXICITY_THRESHOLD", "0.5"))
+        if nsfw:
+            BLOCK_COUNTER.labels(type="text").inc()
+        return {"nsfw": nsfw, "scores": res}
+    # fallback simple heuristic
+    lowered = req.text.lower()
+    banned = os.environ.get("MOD_BANNED_WORDS", "porn,sex,nude,xxx").split(",")
+    hits = [w for w in banned if w and w in lowered]
+    nsfw = len(hits) > 0
+    if nsfw:
+        BLOCK_COUNTER.labels(type="text").inc()
+    return {"nsfw": nsfw, "hits": hits}
+
+@app.post("/moderate_image")
+def moderate_image(req: ImageReq):
+    REQ_COUNTER.labels(type="image").inc()
+    try:
+        b = base64.b64decode(req.image_b64)
+        # Production: call a vision moderation model or cloud API
+        # Example heuristic: very small/broken images => not flagged; otherwise return unknown
+        if len(b) < 1024:
+            return {"nsfw": False, "reason": "small_image"}
+        return {"nsfw": False, "reason": "needs_vision_model"}
+    except Exception:
+        raise HTTPException(status_code=400, detail="invalid base64")
+
