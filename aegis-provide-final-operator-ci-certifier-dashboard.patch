+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click submit (prefilled) for ScoutAV certifier flow.
+# Usage:
+#   COSIGN_KMS_URI=... S3_UPLOAD=... CERT_UPLOAD_URL=... ./ops/certifier/one_click_submit_prefilled.sh /tmp/scout_bundle.tar.gz
+
+OUT_BUNDLE=${1:-/tmp/scout_auditor_bundle_$(date +%s).tar.gz}
+COSIGN=${COSIGN_KMS_URI:-}
+S3=${S3_UPLOAD:-}
+CERT_URL=${CERT_UPLOAD_URL:-}
+CERT_TOKEN=${CERTIFIER_API_TOKEN:-}
+VEHICLE=${VEHICLE:-ScoutAV}
+
+echo "[1] Build auditor package (manifest + bundle)"
+python3 ops/certifier/auditor_package_builder.py --artifacts-root . --out "$OUT_BUNDLE" --manifest-out "${OUT_BUNDLE%.tar.gz}_manifest.json" --cosign-key "$COSIGN" --s3 "$S3" --vehicle "$VEHICLE"
+
+if [ -n "$CERT_URL" ]; then
+  echo "[2] Submit bundle to certifier endpoint"
+  python3 ops/certifier/submit_and_track_findings.py --bundle "$OUT_BUNDLE" --upload-url "$CERT_URL" --findings-url "${CERT_URL%/upload}/findings" --api-token "$CERT_TOKEN" --outdir "./certifier_findings_$(date +%s)"
+else
+  echo "No CERT_UPLOAD_URL provided; bundle built at $OUT_BUNDLE"
+fi
+
+echo "One-click submit complete. Bundle: $OUT_BUNDLE"
+
