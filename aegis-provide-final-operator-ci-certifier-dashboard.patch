+        run: |
+          python3 ops/ci/promotion_gate/ensure_builder_hardening.py
+
+  provenance_gate:
+    name: Provenance Gate (staging -> prod)
+    runs-on: [self-hosted, linux]
+    needs: ensure_builders
+    steps:
+      - uses: actions/checkout@v4
+      - name: Enforce builder provenance & Rekor evidence
+        env:
+          IMAGE_MANIFESTS: ${{ github.event.inputs.manifests }}
+          REKOR_SERVER: ${{ secrets.REKOR_SERVER }}
+        run: |
+          python3 ops/ci/promotion_gate/enforce_builder_provenance.py
+
+  carbon_gate:
+    name: Carbon Gate (enforce with optional override)
+    runs-on: [self-hosted, linux]
