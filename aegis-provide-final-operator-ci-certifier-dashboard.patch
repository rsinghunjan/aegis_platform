+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Prefilled operator run script for ScoutAV (parameterized).
+# Runs: RT sweep -> HIL certification -> Perception pipeline -> Provenance check -> Carbon tune -> Build & submit cert bundle
+#
+# Usage (example):
+#   VEHICLE=ScoutAV \
+#   ECUS="scout-ecu1:can0,scout-ecu2:can0" \
+#   NPU_RUNNERS="npu1,npu2" \
+#   COSIGN_KMS_URI="kms://..." \
+#   REKOR_SERVER="https://rekor.example" \
+#   S3_UPLOAD="s3://aegis-evidence/scoutav/run123" \
+#   CERT_UPLOAD_URL="https://certifier.example/upload" \
+#     ./ops/runbooks/operator_run_prefilled_scoutav.sh --out /tmp/scoutav_run
+
+OUT=${1:-/tmp/aegis_scoutav_run_$(date +%s)}
+VEHICLE=${VEHICLE:-ScoutAV}
+ECUS=${ECUS:-"localhost:can0"}
+NPU_RUNNERS=${NPU_RUNNERS:-""}
+COSIGN=${COSIGN_KMS_URI:-}
+REKOR=${REKOR_SERVER:-}
+S3=${S3_UPLOAD:-}
+CERT_URL=${CERT_UPLOAD_URL:-}
+CERT_TOKEN=${CERTIFIER_API_TOKEN:-}
+
+mkdir -p "$OUT"
+echo "ScoutAV operator run starting. OUT=$OUT"
+
+echo "[1] Hardware RT sweep & sign proofs"
+export TARGETS="$ECUS"
+export COSIGN_KMS_URI="$COSIGN"
+export S3_UPLOAD="$S3"
+./ops/validation/run_rt_sweep_and_sign.sh "$OUT/rt_proofs" || true
+
+echo "[2] HIL exhaustive certification & formal closure"
+SCENARIOS_FILE=${SCENARIOS_FILE:-ops/av/certification/scout_scenarios.txt}
+./ops/robotics/control/certified/run_exhaustive_hil_and_close_formal.sh --scenarios-file "$SCENARIOS_FILE" --golden /opt/aegis/golden_trace.ndjson --out "$OUT/hil_cert" --cosign "$COSIGN" || true
+
+echo "[3] Perception sim -> HIL -> retrain -> NPU validation"
+./ops/av/perception/scale/run_sim_hil_field_pipeline.sh --packs 20 --per-pack 200 --parallel 6 --out "$OUT/perception" --npu-runners "$NPU_RUNNERS" --cosign "$COSIGN" || true
+
+echo "[4] Verify builder hardening & provenance"
+IMAGE_MANIFESTS=${IMAGE_MANIFESTS:-"deploy.yaml"}
+REKOR_SERVER=$REKOR IMAGE_MANIFESTS="$IMAGE_MANIFESTS" python3 ops/ci/promotion_gate/enforce_builder_provenance.py || true
+
+echo "[5] Carbon tuning (monitor short-run) and override guidance"
+python3 ops/carbon/monitor_tune.py --duration-s 600 --interval-s 30 --region US-CA --out "$OUT/carbon_tune.json" || true
+echo "Suggested threshold report: $OUT/carbon_tune.json"
+
+echo "[6] Build auditor package and sign"
+python3 ops/certifier/auditor_package_builder.py --artifacts-root . --out "$OUT/${VEHICLE}_auditor_bundle.tar.gz" --manifest-out "$OUT/evidence_manifest.json" --cosign-key "$COSIGN" --s3 "$S3" --vehicle "$VEHICLE" || true
+
+if [ -n "$CERT_URL" ]; then
+  echo "[7] Submit to certifier and poll findings"
+  python3 ops/certifier/submit_and_track_findings.py --bundle "$OUT/${VEHICLE}_auditor_bundle.tar.gz" --upload-url "$CERT_URL" --findings-url "${CERT_URL%/upload}/findings" --api-token "$CERT_TOKEN" --outdir "$OUT/certifier_findings" || true
+fi
+
+echo "Operator run complete. Inspect $OUT for artifacts and evidence manifests."
+echo "If any critical failures occurred, follow ops/runbooks/incident_triage_playbook.md"
+
