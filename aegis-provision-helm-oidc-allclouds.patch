+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create Azure AD application and federated credential for GitHub OIDC.
+#
+# Usage: ./scripts/create_github_oidc_azure.sh <OWNER/REPO> <APP_NAME>
+
+REPO="${1:?}"
+APP_NAME="${2:-aegis-github-app}"
+
+APP_ID=$(az ad app create --display-name "${APP_NAME}" --query appId -o tsv)
+az ad app federated-credential create --id "${APP_ID}" --parameters "{
+  \"name\": \"github_oidc\",
+  \"issuer\": \"https://token.actions.githubusercontent.com\",
+  \"subject\": \"repo:${REPO}:*\",
+  \"audiences\": [\"api://AzureADTokenExchange\"]
+}"
+
+echo "Created AAD app ${APP_NAME} (${APP_ID}). Create service principal and grant Key Vault sign permissions to the SP."
