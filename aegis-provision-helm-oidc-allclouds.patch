+#!/usr/bin/env bash
+set -euo pipefail
+# Create Workload Identity Pool/Provider and bind to a Service Account (GCP)
+#
+# Usage: ./scripts/create_github_oidc_gcp.sh <PROJECT> <OWNER/REPO> <SA_EMAIL>
+
+PROJECT="${1:?}"
+REPO="${2:?}"
+SA_EMAIL="${3:?}"
+
+POOL_ID="github-pool"
+PROVIDER_ID="github-provider"
+
+gcloud iam workload-identity-pools create "${POOL_ID}" --project="${PROJECT}" --location="global" --display-name="GitHub Pool"
+
+gcloud iam workload-identity-pools providers create-oidc "${PROVIDER_ID}" --project="${PROJECT}" --location="global" --workload-identity-pool="${POOL_ID}" --issuer-uri="https://token.actions.githubusercontent.com" --attribute-mapping="google.subject=assertion.sub"
+
+PRINCIPAL="principalSet://iam.googleapis.com/projects/${PROJECT}/locations/global/workloadIdentityPools/${POOL_ID}/attribute.repository/${REPO}"
+
+gcloud iam service-accounts add-iam-policy-binding "${SA_EMAIL}" --project="${PROJECT}" --role="roles/iam.workloadIdentityUser" --member="${PRINCIPAL}"
+
+echo "Bound SA ${SA_EMAIL} to workload identity provider for repo ${REPO}."
+
