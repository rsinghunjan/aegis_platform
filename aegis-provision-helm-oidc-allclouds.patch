+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run this from the repo root to provision AWS KMS + Rekor (terraform/aws) and wire GitHub secrets.
+# Prereqs: terraform, awscli, gh (GitHub CLI), jq installed and configured.
+#
+# Usage: ./docs/runbooks/provision_aws_commands.sh <owner/repo> <aws-region> <rekor-subnet-id>
+
+REPO="${1:?owner/repo}"
+AWS_REGION="${2:-us-west-2}"
+REKOR_SUBNET="${3:-}"
+
+echo "1) Terraform init & apply (AWS)"
+pushd terraform/aws >/dev/null
+terraform init
+terraform apply -auto-approve -var="aws_region=${AWS_REGION}" $( [ -n "$REKOR_SUBNET" ] && echo "-var=reker_subnet_id=${REKOR_SUBNET}" || echo "")
+popd >/dev/null
+
+echo "2) Capture outputs"
+COSIGN_ARN=$(terraform -chdir=terraform/aws output -raw aws_cosign_kms_arn)
+REKOR_EP=$(terraform -chdir=terraform/aws output -raw aws_rekor_endpoint)
+echo "COSIGN_ARN=$COSIGN_ARN"
+echo "REKOR_EP=$REKOR_EP"
+
+echo "3) Set GitHub secrets (requires gh auth login)"
+gh secret set COSIGN_KEY --repo "$REPO" --body "kms://${COSIGN_ARN}"
+gh secret set REKOR_SERVER --repo "$REPO" --body "$REKOR_EP"
+
+cat <<EOF
+Done.
+Next:
+- Deploy Rekor on k8s or use the terraform VM output temporarily.
+- Deploy Vault HA and put the COSIGN_KMS ARN into Vault at secret/data/cosign/prod/key
+  e.g.: vault kv put secret/data/cosign/prod/key kms_arn="${COSIGN_ARN}"
+EOF
+
