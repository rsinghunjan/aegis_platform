+#!/usr/bin/env python3
+"""
+Simple Prometheus metrics helper for quantum jobs.
+
+Expose:
+ - aegis_quantum_jobs_total{status}
+ - aegis_quantum_job_duration_seconds (summary)
+"""
+from prometheus_client import Counter, Summary, start_http_server
+import threading
+import time
+
+JOBS = Counter("aegis_quantum_jobs_total", "Quantum jobs total", ["status"])
+DURATION = Summary("aegis_quantum_job_duration_seconds", "Quantum job durations")
+
+class QuantumMetrics:
+    def __init__(self, port=9400):
+        # Start exporter in background if not already running
+        t = threading.Thread(target=start_http_server, args=(port,), daemon=True)
+        t.start()
+
+    def record_job(self, status: str, duration_s: float):
+        JOBS.labels(status=status).inc()
+        DURATION.observe(duration_s)
+
