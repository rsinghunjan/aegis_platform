+#!/usr/bin/env python3
+"""
+Simple simulator benchmarking utility to measure runtime for circuits.
+Outputs JSON with runtime statistics suitable for CI/perf baselines.
+"""
+import time
+import json
+from qiskit import QuantumCircuit
+from qiskit.providers.aer import AerSimulator
+
+def bench(qasm_str, shots=1024, repeat=3):
+    backend = AerSimulator()
+    durations = []
+    for _ in range(repeat):
+        qc = QuantumCircuit.from_qasm_str(qasm_str)
+        start = time.time()
+        backend.run(qc, shots=shots).result()
+        durations.append(time.time() - start)
+    return {"durations": durations, "mean_s": sum(durations)/len(durations)}
+
+if __name__ == "__main__":
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--qasm-file", required=True)
+    args = ap.parse_args()
+    qasm = open(args.qasm_file).read()
+    stats = bench(qasm)
+    print(json.dumps(stats, indent=2))
+
