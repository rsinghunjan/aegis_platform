+#!/usr/bin/env python3
+"""
+Provenance bundler for quantum runs.
+
+Creates a JSON bundle with metadata, circuit, results and environment info.
+Optionally signs the bundle with cosign if COSIGN_KEY env var is present.
+"""
+import os
+import json
+import time
+import socket
+import subprocess
+from pathlib import Path
+
+OUT_DIR_DEFAULT = os.environ.get("QUANTUM_EVIDENCE_DIR", "/tmp/quantum_evidence")
+Path(OUT_DIR_DEFAULT).mkdir(parents=True, exist_ok=True)
+
+def bundle_provenance(metadata: dict, circuit: dict, result: dict, out_dir: str = None):
+    out_dir = out_dir or OUT_DIR_DEFAULT
+    Path(out_dir).mkdir(parents=True, exist_ok=True)
+    ts = int(time.time())
+    host = socket.gethostname()
+    bundle = {
+        "metadata": metadata,
+        "circuit": circuit,
+        "result": result,
+        "env": {
+            "host": host,
+            "ts": ts,
+        }
+    }
+    fname = os.path.join(out_dir, f"quantum_run_{metadata.get('run_id','run')}_{ts}.json")
+    with open(fname, "w") as fh:
+        json.dump(bundle, fh, indent=2)
+    # optionally sign
+    cosign_key = os.environ.get("COSIGN_KEY")
+    if cosign_key:
+        try:
+            subprocess.run(["cosign", "sign-blob", "--key", cosign_key, fname], check=True)
+        except Exception:
+            # non-fatal; signing failures logged but do not block result recording
+            print("Warning: cosign sign-blob failed")
+    return fname
+
