+#!/usr/bin/env python3
+"""
+Quantum job runner (Qiskit-focused).
+
+Modes:
+ - sim : run on local Aer simulator
+ - qpu : submit to an external QPU provider (IBMQ/Braket) via a provider stub (requires credentials)
+
+Behavior:
+ - Loads a circuit description (JSON or OpenQASM) and runs it.
+ - Records provenance and signs evidence (if COSIGN_KEY set).
+ - Emits lightweight Prometheus metrics via metrics_exporter.
+"""
+import os
+import json
+import time
+import argparse
+import uuid
+from pathlib import Path
+from quantum_provenance import bundle_provenance
+from metrics_exporter import QuantumMetrics
+
+MODE_SIM = "sim"
+MODE_QPU = "qpu"
+
+def load_circuit_from_json(path):
+    with open(path, "r") as fh:
+        payload = json.load(fh)
+    return payload
+
+def run_on_sim(circuit_json, shots=1024):
+    # Minimal qiskit Aer run; import inside to keep module import optional
+    from qiskit import QuantumCircuit, transpile
+    from qiskit.providers.aer import AerSimulator
+    qc = QuantumCircuit.from_qasm_str(circuit_json.get("qasm", "")) if circuit_json.get("qasm") else QuantumCircuit.from_dict(circuit_json)
+    backend = AerSimulator()
+    tqc = transpile(qc, backend)
+    job = backend.run(tqc, shots=shots)
+    result = job.result()
+    counts = result.get_counts()
+    return {"counts": counts, "shots": shots}
+
+def submit_to_qpu(circuit_json, provider_stub, shots=1024):
+    # provider_stub is an object implementing submit(circuit_qasm, shots) -> dict
+    qasm = circuit_json.get("qasm")
+    if not qasm:
+        raise RuntimeError("QASM required for QPU submission in this stub")
+    job_info = provider_stub.submit(qasm, shots)
+    return job_info
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--circuit", required=True, help="Path to circuit JSON or QASM")
+    ap.add_argument("--mode", choices=[MODE_SIM, MODE_QPU], default=MODE_SIM)
+    ap.add_argument("--shots", type=int, default=1024)
+    ap.add_argument("--out-dir", default="/tmp/quantum_results")
+    args = ap.parse_args()
+
+    Path(args.out_dir).mkdir(parents=True, exist_ok=True)
+    if args.circuit.endswith(".json"):
+        circ = load_circuit_from_json(args.circuit)
+    else:
+        # read QASM
+        circ = {"qasm": open(args.circuit).read()}
+
+    run_id = str(uuid.uuid4())
+    metrics = QuantumMetrics()
+    start = time.time()
+    try:
+        if args.mode == MODE_SIM:
+            res = run_on_sim(circ, shots=args.shots)
+            status = "ok"
+        else:
+            # attempt to load provider stub
+            from ibmq_integration_stub import IBMQProviderStub
+            stub = IBMQProviderStub()
+            res = submit_to_qpu(circ, stub, shots=args.shots)
+            status = "submitted"
+    except Exception as e:
+        res = {"error": str(e)}
+        status = "error"
+    duration = time.time() - start
+
+    # Provenance and evidence bundling (signed if COSIGN_KEY)
+    meta = {
+        "run_id": run_id,
+        "mode": args.mode,
+        "shots": args.shots,
+        "status": status,
+        "duration_s": duration,
+    }
+    ev_path = bundle_provenance(meta, circ, res, out_dir=args.out_dir)
+    metrics.record_job(status, duration)
+    print("Result:", res)
+    print("Evidence:", ev_path)
+
+if __name__ == "__main__":
+    main()
+
