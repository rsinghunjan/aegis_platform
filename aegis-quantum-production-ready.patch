+#!/usr/bin/env python3
+"""
+QPU Job Queue Microservice
+
+ - FastAPI service that accepts job submissions (circuit, backend, shots, owner, team)
+ - Enforces simple per-team quotas and estimated-cost checks
+ - Background worker dequeues jobs and calls provider adapters with rate limiting and batching hooks
+ - Supports fallback to simulator if provider unavailable
+
+Simple DB: SQLite for demo (switch to Postgres in production)
+"""
+import os
+import time
+import json
+import threading
+import uuid
+import logging
+from typing import Optional, Dict, Any, List
+from fastapi import FastAPI, HTTPException, BackgroundTasks
+from pydantic import BaseModel
+import sqlite3
+
+from adapters.ibmq_adapter import IBMQAdapter
+from adapters.braket_adapter import BraketAdapter
+from adapters.azure_adapter import AzureAdapter
+from qiskit import QuantumCircuit, transpile
+
+LOG = logging.getLogger("aegis.quantum.qpu_queue")
+LOG.setLevel(logging.INFO)
+
+DB_PATH = os.environ.get("QPU_DB", "/tmp/qpu_queue.db")
+PROCESS_INTERVAL = float(os.environ.get("QPU_PROCESS_INTERVAL", "5.0"))
+TEAM_QUOTA = {"research": 1000000, "prod": 100000}  # example quota in $-cents or arbitrary units
+COST_PER_SHOT = {"ibmq": 0.0001, "braket": 0.0002, "azure": 0.00015}  # dollars per shot
+
+app = FastAPI()
+
+class QpuJob(BaseModel):
+    circuit: str  # qasm or JSON representation
+    backend: str
+    shots: int = 1024
+    owner: str
+    team: str = "research"
+    priority: int = 5
+
+
+def init_db():
+    conn = sqlite3.connect(DB_PATH)
+    c = conn.cursor()
+    c.execute("""CREATE TABLE IF NOT EXISTS jobs (
+        id TEXT PRIMARY KEY,
+        circuit TEXT,
+        backend TEXT,
+        shots INTEGER,
+        owner TEXT,
+        team TEXT,
+        status TEXT,
+        submitted_at REAL,
+        started_at REAL,
+        finished_at REAL,
+        result TEXT,
+        est_cost REAL
+    )""")
+    conn.commit()
+    conn.close()
+
+
+def estimate_cost(backend: str, shots: int) -> float:
+    key = "ibmq" if "ibmq" in backend else ("braket" if "braket" in backend else "azure")
+    return shots * COST_PER_SHOT.get(key, 0.0001)
+
+
+@app.post("/submit")
+def submit_job(job: QpuJob, background_tasks: BackgroundTasks):
+    # simple quota enforcement (sum of estimated cost of running jobs in DB for the team)
+    est = estimate_cost(job.backend, job.shots)
+    # compute team usage
+    conn = sqlite3.connect(DB_PATH)
+    c = conn.cursor()
+    c.execute("SELECT SUM(est_cost) FROM jobs WHERE team = ? AND status IN ('submitted','running')", (job.team,))
+    row = c.fetchone()
+    team_usage = row[0] or 0.0
+    if team_usage + est > TEAM_QUOTA.get(job.team, 1e9):
+        conn.close()
+        raise HTTPException(status_code=402, detail="Team quota exceeded")
+    job_id = str(uuid.uuid4())
+    c.execute("INSERT INTO jobs (id,circuit,backend,shots,owner,team,status,submitted_at,est_cost) VALUES (?,?,?,?,?,?,?,?,?)",
+              (job_id, job.circuit, job.backend, job.shots, job.owner, job.team, "submitted", time.time(), est))
+    conn.commit()
+    conn.close()
+    return {"job_id": job_id, "est_cost": est}
+
+
+@app.get("/status/{job_id}")
+def status(job_id: str):
+    conn = sqlite3.connect(DB_PATH)
+    c = conn.cursor()
+    c.execute("SELECT status,result,est_cost FROM jobs WHERE id = ?", (job_id,))
+    row = c.fetchone()
+    conn.close()
+    if not row:
+        raise HTTPException(status_code=404, detail="Not found")
+    return {"status": row[0], "result": json.loads(row[1]) if row[1] else None, "est_cost": row[2]}
+
+
+def process_loop():
+    # adapters instances
+    ibm = IBMQAdapter()
+    brk = BraketAdapter()
+    az = AzureAdapter()
+    while True:
+        try:
+            conn = sqlite3.connect(DB_PATH)
+            c = conn.cursor()
+            c.execute("SELECT id,circuit,backend,shots FROM jobs WHERE status = 'submitted' ORDER BY submitted_at LIMIT 5")
+            rows = c.fetchall()
+            if not rows:
+                conn.close()
+                time.sleep(PROCESS_INTERVAL)
+                continue
+            # naive batching: group by backend
+            by_backend = {}
+            for r in rows:
+                jid, circ, backend, shots = r
+                by_backend.setdefault(backend, []).append((jid, circ, shots))
+            for backend, jobs in by_backend.items():
+                # simple rate limiting: only process one batch per backend per loop
+                for jid, circ, shots in jobs:
+                    c.execute("UPDATE jobs SET status = 'running', started_at = ? WHERE id = ?", (time.time(), jid))
+                    conn.commit()
+                    # submit to provider
+                    try:
+                        if "ibmq" in backend:
+                            resp = ibm.submit_async(circ, shots=shots)
+                            if "error" in resp:
+                                # fallback: run on simulator
+                                LOG.warning("IBMQ submit failed, falling back to sim for job %s", jid)
+                                sim_res = run_simulator(circ, shots)
+                                c.execute("UPDATE jobs SET status='finished', finished_at=?, result=? WHERE id=?", (time.time(), json.dumps(sim_res), jid))
+                                conn.commit()
+                                continue
+                            job_id = resp.get("job_id")
+                            poll = ibm.poll_job(job_id, timeout_s=600)
+                            c.execute("UPDATE jobs SET status=?, finished_at=?, result=? WHERE id=?", (poll.get("status","unknown"), time.time(), json.dumps(poll), jid))
+                            conn.commit()
+                        elif "braket" in backend:
+                            resp = brk.submit_async(circ, shots=shots)
+                            if "error" in resp:
+                                sim_res = run_simulator(circ, shots)
+                                c.execute("UPDATE jobs SET status='finished', finished_at=?, result=? WHERE id=?", (time.time(), json.dumps(sim_res), jid))
+                                conn.commit()
+                                continue
+                            job_id = resp.get("job_id")
+                            poll = brk.poll_job(job_id, timeout_s=1800)
+                            c.execute("UPDATE jobs SET status=?, finished_at=?, result=? WHERE id=?", (poll.get("status","unknown"), time.time(), json.dumps(poll), jid))
+                            conn.commit()
+                        else:
+                            # unknown backend: run on simulator
+                            sim_res = run_simulator(circ, shots)
+                            c.execute("UPDATE jobs SET status='finished', finished_at=?, result=? WHERE id=?", (time.time(), json.dumps(sim_res), jid))
+                            conn.commit()
+                    except Exception as e:
+                        LOG.exception("Processing job %s failed: %s", jid, e)
+                        c.execute("UPDATE jobs SET status='error', finished_at=?, result=? WHERE id=?", (time.time(), json.dumps({"error": str(e)}), jid))
+                        conn.commit()
+            conn.close()
+        except Exception as e:
+            LOG.exception("Process loop failed: %s", e)
+        time.sleep(PROCESS_INTERVAL)
+
+
+def run_simulator(qasm: str, shots: int = 1024):
+    # Very small simulator fallback using qiskit Aer if available
+    try:
+        from qiskit import QuantumCircuit
+        from qiskit.providers.aer import AerSimulator
+        qc = QuantumCircuit.from_qasm_str(qasm) if qasm.strip().startswith("OPENQASM") else QuantumCircuit.from_qasm_str(qasm)
+        backend = AerSimulator()
+        job = backend.run(qc, shots=shots)
+        result = job.result()
+        counts = result.get_counts()
+        return {"counts": counts, "shots": shots, "source": "sim"}
+    except Exception as e:
+        LOG.exception("Simulator fallback failed: %s", e)
+        return {"error": str(e)}
+
+
+if __name__ == "__main__":
+    init_db()
+    # start background processor thread
+    t = threading.Thread(target=process_loop, daemon=True)
+    t.start()
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("QPU_QUEUE_PORT", 8080)))
+
