*** Add File:ops/quantum/deterministic_circuit_snapshot.py
+#!/usr/bin/env python3
+"""
+Write deterministic circuit snapshot and optional DVC add.
+Records circuit hash, seed, and metadata for reproducibility.
+"""
+import os
+import argparse
+import json
+import hashlib
+import time
+import subprocess
+
+def snapshot_circuit(path, out_dir):
+    with open(path, "r") as fh:
+        data = fh.read()
+    h = hashlib.sha256(data.encode("utf-8")).hexdigest()
+    ts = int(time.time())
+    os.makedirs(out_dir, exist_ok=True)
+    out_path = os.path.join(out_dir, f"circuit_{h[:8]}_{ts}.json")
+    with open(out_path, "w") as fh:
+        json.dump({"circuit": data, "sha256": h, "ts": ts}, fh)
+    try:
+        subprocess.run(f"dvc add {out_path}", shell=True, check=True)
+    except Exception:
+        # DVC optional
+        pass
+    print("Wrote snapshot", out_path)
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--circuit", required=True)
+    ap.add_argument("--out", default="./artifacts")
+    args = ap.parse_args()
+    snapshot_circuit(args.circuit, args.out)
+
