+#!/usr/bin/env python3
+"""
+Exporter that scrapes provider adapters for calibration metrics and exposes Prometheus metrics.
+Run this as a deployment (one instance) or as a daemonset per-region/backend.
+"""
+import os
+import time
+import logging
+from prometheus_client import start_http_server, Gauge
+
+LOG = logging.getLogger("aegis.quantum.metrics")
+
+# Gauges for backend fidelity
+T1 = Gauge("aegis_quantum_t1_seconds", "QPU T1 (s)", ["backend", "qubit"])
+T2 = Gauge("aegis_quantum_t2_seconds", "QPU T2 (s)", ["backend", "qubit"])
+SINGLE_Q_GATE_ERROR = Gauge("aegis_quantum_single_qubit_error", "Single qubit gate error", ["backend", "qubit"])
+TWO_Q_GATE_ERROR = Gauge("aegis_quantum_two_qubit_error", "Two qubit gate error", ["backend", "qubits"])
+
+def scrape_and_export(adapters: dict, poll_interval: int = 300):
+    start_http_server(int(os.environ.get("QUANTUM_METRICS_PORT", 9410)))
+    while True:
+        for name, adapter in adapters.items():
+            try:
+                props = adapter.fetch_calibration()
+                # props parsing heuristics; adapters should return structured dict
+                if "properties" in props and isinstance(props["properties"], dict):
+                    p = props["properties"]
+                    # parse qubit metrics if present
+                    qubits = p.get("qubits", {})
+                    for q_idx, qinfo in qubits.items():
+                        if "t1" in qinfo:
+                            T1.labels(backend=name, qubit=str(q_idx)).set(float(qinfo["t1"]))
+                        if "t2" in qinfo:
+                            T2.labels(backend=name, qubit=str(q_idx)).set(float(qinfo["t2"]))
+                        if "single_error" in qinfo:
+                            SINGLE_Q_GATE_ERROR.labels(backend=name, qubit=str(q_idx)).set(float(qinfo["single_error"]))
+                    # two-qubit errors: p.get("two_qubit", {}) -> map of (q1,q2) -> error
+                    two = p.get("two_qubit", {})
+                    for k, v in two.items():
+                        TWO_Q_GATE_ERROR.labels(backend=name, qubits=str(k)).set(float(v))
+            except Exception as e:
+                LOG.exception("Metric scrape for %s failed: %s", name, e)
+        time.sleep(poll_interval)
+
+if __name__ == "__main__":
+    # Adapters to poll (modify as you deploy)
+    from adapters.ibmq_adapter import IBMQAdapter
+    adapters = {"ibmq": IBMQAdapter(backend_name=os.environ.get("IBMQ_BACKEND", "ibmq_quito"))}
+    scrape_and_export(adapters)
