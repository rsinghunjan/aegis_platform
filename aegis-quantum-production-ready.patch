+#!/usr/bin/env python3
+"""
+Noise-aware transpiler utilities for Qiskit circuits.
+
+ - fetch_backend_properties(): wrapper that calls provider adapter to get calibration/properties
+ - transpile_for_backend(): use coupling_map, basis_gates and set optimization level based on noise
+
+This module requires qiskit installed; it's written defensively so adapters can be used as stubs.
+"""
+import logging
+from qiskit import transpile, QuantumCircuit
+from typing import Dict, Any
+
+LOG = logging.getLogger("aegis.quantum.transpile")
+
+
+def fetch_backend_properties(adapter, backend_name: str) -> Dict[str, Any]:
+    try:
+        props = adapter.fetch_calibration()
+        return props.get("properties", {}) if isinstance(props, dict) else props
+    except Exception as e:
+        LOG.exception("fetch_backend_properties error: %s", e)
+        return {}
+
+
+def transpile_for_backend(qc: QuantumCircuit, adapter, backend_name: str, shots: int = 1024):
+    """
+    Use simplistic heuristics:
+     - if gate error high -> use lower optimization to be conservative
+     - if coupling_map present -> use it
+    """
+    props = fetch_backend_properties(adapter, backend_name)
+    # parse props (stub normalization)
+    coupling_map = props.get("coupling_map") if isinstance(props, dict) else None
+    avg_gate_error = float(props.get("avg_gate_error", 0.001)) if isinstance(props, dict) else 0.001
+    if avg_gate_error > 0.01:
+        opt_level = 0
+    elif avg_gate_error > 0.002:
+        opt_level = 1
+    else:
+        opt_level = 3
+    try:
+        if coupling_map:
+            tqc = transpile(qc, basis_gates=None, coupling_map=coupling_map, optimization_level=opt_level)
+        else:
+            tqc = transpile(qc, optimization_level=opt_level)
+        return {"transpiled_qc": tqc, "opt_level": opt_level}
+    except Exception as e:
+        LOG.exception("transpile failed: %s", e)
+        return {"error": str(e)}
+
