+#!/usr/bin/env python3
+"""
+IBMQ provider adapter (production-oriented sketch).
+
+Responsibilities:
+ - Read credentials from in-cluster secret (mounted by ExternalSecrets)
+ - Submit circuits asynchronously to IBMQ (using Qiskit provider)
+ - Poll jobs, fetch results, fetch calibration/properties
+ - Handle errors, backoff, and optionally fall back to simulator
+"""
+import os
+import time
+import json
+import logging
+from typing import Dict, Any
+
+LOG = logging.getLogger("aegis.quantum.ibmq")
+
+try:
+    from qiskit import QuantumCircuit
+    from qiskit_ibm_runtime import IBMQProvider, Session, QiskitRuntimeError
+except Exception:
+    IBMQProvider = None
+    Session = None
+
+
+def _read_token_from_secret():
+    # Assumes ExternalSecret wrote a k8s secret 'ibmq-credentials' with 'token' key
+    path = "/var/secrets/ibmq/token"
+    if os.path.exists(path):
+        return open(path).read().strip()
+    return os.environ.get("IBMQ_TOKEN")
+
+
+class IBMQAdapter:
+    def __init__(self, backend_name: str = "ibmq_qasm_simulator"):
+        self.backend_name = backend_name
+        self.token = _read_token_from_secret()
+        self.provider = None
+        if IBMQProvider is not None and self.token:
+            try:
+                self.provider = IBMQProvider(instance="https://auth.quantum-computing.ibm.com/api")
+            except Exception as e:
+                LOG.exception("IBMQProvider init failed: %s", e)
+
+    def submit_async(self, qasm: str, shots: int = 1024) -> Dict[str, Any]:
+        """
+        Submit a QASM string asynchronously. Returns job metadata with job_id or error.
+        """
+        if not self.provider:
+            raise RuntimeError("IBMQ provider not configured")
+        try:
+            backend = self.provider.backend(self.backend_name)
+            job = backend.run(qasm, shots=shots) if hasattr(backend, "run") else backend.run(qasm, shots=shots)
+            job_id = job.job_id() if hasattr(job, "job_id") else getattr(job, "id", None)
+            return {"job_id": job_id, "status": "submitted"}
+        except Exception as e:
+            LOG.exception("IBMQ submit failed: %s", e)
+            return {"error": str(e)}
+
+    def poll_job(self, job_id: str, timeout_s: int = 600, poll_interval: float = 5.0) -> Dict[str, Any]:
+        """
+        Poll job until completion or timeout. Returns result or error dict.
+        """
+        if not self.provider:
+            return {"error": "provider_not_configured"}
+        try:
+            backend = self.provider.backend(self.backend_name)
+            start = time.time()
+            while time.time() - start < timeout_s:
+                # backend.status? or provider.job(job_id)
+                job = backend.job(job_id) if hasattr(backend, "job") else None
+                if job:
+                    st = job.status().name if hasattr(job, "status") else getattr(job, "status", "UNKNOWN")
+                    if st in ("DONE", "COMPLETED"):
+                        result = job.result() if hasattr(job, "result") else {"info": "result"}
+                        return {"status": "completed", "result": result}
+                    elif st in ("ERROR", "CANCELLED", "FAILED"):
+                        return {"status": "error", "error": str(st)}
+                time.sleep(poll_interval)
+            return {"status": "timeout", "error": "timed out"}
+        except Exception as e:
+            LOG.exception("poll_job failed: %s", e)
+            return {"error": str(e)}
+
+    def fetch_calibration(self) -> Dict[str, Any]:
+        """
+        Fetch backend calibration/properties: T1/T2/gate errors/coupling map.
+        """
+        if not self.provider:
+            return {}
+        try:
+            backend = self.provider.backend(self.backend_name)
+            props = backend.properties() if hasattr(backend, "properties") else {}
+            # normalize to dict and return
+            return {"properties": str(props)}
+        except Exception as e:
+            LOG.exception("fetch_calibration failed: %s", e)
+            return {"error": str(e)}
