+name: Verify MCP Cosign & OPA pre-deploy
+on:
+  workflow_dispatch:
+jobs:
+  verify-mcp:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Install cosign
+        run: |
+          curl -sSfL https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64 -o cosign
+          chmod +x cosign
+          sudo mv cosign /usr/local/bin/
+
+      - name: Verify MCP JSON signature
+        env:
+          MCP_JSON_PATH: ${{ github.event.inputs.mcp_json_path || 'mcp_record.json' }}
+          COSIGN_PUB: ${{ secrets.COSIGN_PUB || '' }}
+        run: |
+          if [ ! -f "$MCP_JSON_PATH" ]; then
+            echo "MCP JSON not found at $MCP_JSON_PATH — failing"
+            exit 1
+          fi
+          SIG_FILE="${MCP_JSON_PATH}.sig"
+          if [ ! -f "$SIG_FILE" ]; then
+            echo "Signature file $SIG_FILE not found — failing"
+            exit 1
+          fi
+          if [ -z "$COSIGN_PUB" ]; then
+            echo "COSIGN_PUB not configured in secrets — skipping verification (set COSIGN_PUB to enforce)"
+            exit 0
+          fi
+          cosign verify-blob --key "$COSIGN_PUB" --signature "$SIG_FILE" "$MCP_JSON_PATH"
+
+      - name: OPA policy pre-deploy check (placeholder)
+        run: |
+          echo "Running OPA pre-deploy policy check (placeholder)"
+          # Example: call OPA server or run 'opa eval' with bundle to validate deployment constraints
+          echo '{"result":{"allow": true}}'
+
