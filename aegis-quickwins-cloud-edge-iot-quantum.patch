+#!/usr/bin/env python3
+"""
+Lightweight MQTT edge agent that:
+ - subscribes to a sensor topic
+ - uploads frames to S3 (or LakeFS via HTTP) and publishes a small MCP-lite metadata JSON to MCP
+
+Environment:
+ - MQTT_BROKER, MQTT_TOPIC
+ - S3_BUCKET, AWS_REGION (optional)
+ - AEGIS_MCP_API
+ - DEVICE_ID (used in metadata)
+"""
+import os
+import time
+import json
+import uuid
+import boto3
+import paho.mqtt.client as mqtt
+import requests
+
+MQTT_BROKER = os.environ.get("MQTT_BROKER", "localhost")
+MQTT_TOPIC = os.environ.get("MQTT_TOPIC", "sensors/camera")
+S3_BUCKET = os.environ.get("S3_BUCKET", "")
+AWS_REGION = os.environ.get("AWS_REGION", "us-east-1")
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+DEVICE_ID = os.environ.get("DEVICE_ID", "edge-device-1")
+
+if S3_BUCKET:
+    s3 = boto3.client("s3", region_name=AWS_REGION)
+else:
+    s3 = None
+
+def upload_bytes(b: bytes, key: str):
+    if s3:
+        s3.put_object(Bucket=S3_BUCKET, Key=key, Body=b)
+        return f"s3://{S3_BUCKET}/{key}"
+    raise RuntimeError("S3 not configured")
+
+def make_mcp_lite(model_id, artifact_uri):
+    return {"model_id": model_id, "artifact_uri": artifact_uri, "device_id": DEVICE_ID, "ts": int(time.time())}
+
+def on_message(client, userdata, msg):
+    try:
+        # payload is assumed bytes of small image or pointer; in constrained devices prefer pointers
+        key = f"iot/{DEVICE_ID}/{int(time.time())}-{uuid.uuid4().hex}.bin"
+        uri = upload_bytes(msg.payload, key)
+        meta = make_mcp_lite(model_id="edge-model", artifact_uri=uri)
+        requests.post(f"{AEGIS_MCP_API.rstrip('/')}/ingest-lite", json=meta, timeout=3.0)
+        print("Uploaded and posted MCP-lite", uri)
+    except Exception as e:
+        print("ingest failed", e)
+
+def main():
+    client = mqtt.Client()
+    client.on_message = on_message
+    client.connect(MQTT_BROKER)
+    client.subscribe(MQTT_TOPIC)
+    client.loop_forever()
+
+if __name__ == "__main__":
+    main()
+
