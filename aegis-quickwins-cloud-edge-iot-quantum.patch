+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import os, time, uuid, json, requests
+from qiskit import QuantumCircuit, Aer, execute
+
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+app = FastAPI(title="Aegis Quantum Runner")
+
+class QuantumJob(BaseModel):
+    name: str
+    shots: int = 1024
+    circuit: dict  # simple serialized circuit description or qasm
+    backend: str = "qasm_simulator"
+
+@app.post("/run")
+def run_job(job: QuantumJob):
+    # This is a pragmatic example: accept qasm text in job.circuit['qasm']
+    qasm = job.circuit.get("qasm")
+    if not qasm:
+        raise HTTPException(status_code=400, detail="qasm required")
+    try:
+        qc = QuantumCircuit.from_qasm_str(qasm)
+        backend = Aer.get_backend(job.backend)
+        job_id = str(uuid.uuid4())
+        result = execute(qc, backend=backend, shots=job.shots).result()
+        counts = result.get_counts()
+        mcp_rec = {
+            "model_id": job.name,
+            "version": "quantum-0",
+            "artifacts": [{"uri": f"quantum://{job_id}"}],
+            "evaluation": {"run_id": job_id, "counts": counts, "shots": job.shots},
+            "meta": {"backend": job.backend, "timestamp": int(time.time())}
+        }
+        try:
+            requests.post(f"{MCP_API.rstrip('/')}/models/{job.name}/context", json=mcp_rec, timeout=5.0)
+        except Exception:
+            pass
+        return {"job_id": job_id, "counts": counts}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
+
