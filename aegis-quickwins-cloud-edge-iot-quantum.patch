+#!/usr/bin/env python3
+"""
+Convert an ONNX model to TensorRT engine (if trtexec is available) and/or layout for Triton.
+This script is a pragmatic bridge: if trtexec exists it will generate an engine; otherwise it will
+place the ONNX into a Triton model repository layout so Triton can serve it via ONNX runtime.
+
+Usage:
+  python scripts/push_onnx_to_trt.py --model-name mymodel --onnx /path/to/model.onnx --out-dir /tmp/models
+"""
+import argparse
+import os
+import shutil
+from pathlib import Path
+import subprocess
+
+def layout_for_triton(model_name, onnx_path, out_dir):
+    base = Path(out_dir) / model_name
+    version_dir = base / "1"
+    version_dir.mkdir(parents=True, exist_ok=True)
+    shutil.copy(onnx_path, version_dir / "model.onnx")
+    # minimal config: Triton will infer using onnxruntime if no config provided in many cases
+    print(f"Copied ONNX to {version_dir}")
+
+def try_trtexec(onnx_path, out_engine_path):
+    trtexec = shutil.which("trtexec")
+    if not trtexec:
+        return False
+    cmd = [trtexec, f"--onnx={onnx_path}", f"--saveEngine={out_engine_path}", "--explicitBatch"]
+    print("Running trtexec:", " ".join(cmd))
+    subprocess.check_call(cmd)
+    return True
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--model-name", required=True)
+    p.add_argument("--onnx", required=True)
+    p.add_argument("--out-dir", required=True)
+    args = p.parse_args()
+    out_engine = os.path.join(args.out_dir, args.model_name, "1", "model.plan")
+    try:
+        ok = try_trtexec(args.onnx, out_engine)
+        if ok:
+            print("TensorRT engine created at", out_engine)
+            return
+    except Exception as e:
+        print("trtexec failed:", e)
+    layout_for_triton(args.model_name, args.onnx, args.out_dir)
+
+if __name__ == "__main__":
+    main()
+
