+#!/usr/bin/env bash
+set -euo pipefail
+if [ "$(id -u)" -ne 0 ]; then
+  echo "Please run as root (or with sudo)"
+  exit 2
+fi
+NIC=${1:-eth0}
+CPU_MASK=${2:-4} # default pin to CPU index 2 -> mask 1<<2 = 4
+echo "Tuning NIC $NIC and pinning IRQs to CPU mask 0x$(printf "%x" "$CPU_MASK")"
+command -v ethtool >/dev/null 2>&1 || { echo "ethtool required"; exit 2; }
+ethtool -G "$NIC" rx 4096 tx 4096 || true
+ethtool -C "$NIC" rx-usecs 5 rx-frames 64 || true
+for irq in $(grep "$NIC" /proc/interrupts | awk '{print $1}' | sed 's/://'); do
+  echo "$CPU_MASK" > /proc/irq/"$irq"/smp_affinity || echo "failed to set irq $irq"
+done
+sysctl -w net.core.busy_poll=50
+sysctl -w net.core.busy_read=50
+echo "NIC tuning complete. Validate with: cat /proc/interrupts | grep $NIC"
+
