+#!/usr/bin/env python3
+"""
+Small Prometheus exporter for jitter_test.py summary metrics.
+ - Runs jitter test, publishes p50/p95/p99 and loop stats as Prometheus metrics
+ - Records evidence manifest on each run
+"""
+from prometheus_client import start_http_server, Gauge
+import time, json
+from ops.robotics.rt.jitter_test import measure as measure_jitter
+from ops.sdk.evidence_sdk import record_manifest
+
+P50 = Gauge("rt_loop_p50_seconds", "RT loop p50")
+P95 = Gauge("rt_loop_p95_seconds", "RT loop p95")
+P99 = Gauge("rt_loop_p99_seconds", "RT loop p99")
+MEAN = Gauge("rt_loop_mean_seconds", "RT loop mean")
+
+def run_and_export(freq=1000, iterations=2000, port=9102):
+    start_http_server(port)
+    while True:
+        stats = measure_jitter(freq=freq, iterations=iterations)
+        P50.set(stats["p50_s"])
+        P95.set(stats["p95_s"])
+        P99.set(stats["p99_s"])
+        MEAN.set(stats["mean_s"])
+        try:
+            record_manifest("rt_jitter_export", stats)
+        except Exception:
+            pass
+        time.sleep(60)
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--freq", type=int, default=1000)
+    p.add_argument("--iters", type=int, default=2000)
+    p.add_argument("--port", type=int, default=9102)
+    args = p.parse_args()
+    run_and_export(args.freq, args.iters, args.port)
+
