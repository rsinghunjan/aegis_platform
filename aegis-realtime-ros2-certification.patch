+#!/usr/bin/env bash
+set -euo pipefail
+cat <<'EOF'
+Aegis RT kernel & system preparation helper (interactive guidance + optional automation).
+
+USAGE:
+  sudo ./ops/robotics/rt/rt_kernel_automation.sh [--dry-run] [--distro ubuntu|debian|centos]
+
+WHAT IT DOES (recommended operator steps - this script prints commands and can optionally run them):
+ - Detects OS and suggests an RT-capable kernel package (PREEMPT_RT / vendor kernel) and kernel boot configuration.
+ - Prints sample grub/kernel params for CPU isolation: isolcpus, nohz_full, rcu_nocbs.
+ - Shows steps to set up mlock, CAP_SYS_NICE, and systemd unit tweaks for RT processes.
+ - Recommends NIC tuning commands and points to ops/robotics/rt/irq_nic_tuning.sh for IRQ pinning.
+
+IMPORTANT:
+ - Kernel changes and grub edits require a reboot. Validate in a lab environment first.
+ - This script does NOT automatically update grub unless --apply is provided and operator confirms.
+
+EOF
+
+DRY_RUN=1
+DISTRO=""
+if [ "${1:-}" = "--dry-run" ]; then
+  DRY_RUN=1
+  shift || true
+fi
+if [ "${1:-}" = "--apply" ]; then
+  DRY_RUN=0
+  shift || true
+fi
+DISTRO=${1:-}
+
+OS=$(cat /etc/os-release | grep '^ID=' | cut -d= -f2 | tr -d '"')
+echo "Detected OS: $OS"
+if [ -z "$DISTRO" ]; then DISTRO=$OS; fi
+
+echo "Suggested steps (operator review required):"
+echo
+echo "1) Install RT kernel (example for Ubuntu / Debian):"
+echo "   sudo apt-get update"
+echo "   sudo apt-get install -y linux-image-rt-amd64 linux-headers-rt-amd64  # package names vary by distro"
+echo
+echo "2) Update GRUB to add kernel boot params for CPU isolation. Example kernel params:"
+echo "   isolcpus=2,3 nohz_full=2,3 rcu_nocbs=2,3 tsc=reliable"
+echo "   Edit /etc/default/grub -> GRUB_CMDLINE_LINUX_DEFAULT and run: sudo update-grub"
+echo
+echo "3) Reboot into RT kernel and validate:"
+echo "   uname -a  # should show PREEMPT_RT or vendor RT kernel"
+echo
+echo "4) Enable memlock and CAP_SYS_NICE for controller binary (systemd unit example included in repo):"
+echo "   setcap 'cap_sys_nice=eip' /opt/aegis/bin/rt_controller || true"
+echo "   or use systemd LimitMEMLOCK=infinity and TasksMax/inotify settings in service file."
+echo
+echo "5) NIC tuning & IRQ pinning (see ops/robotics/rt/irq_nic_tuning.sh):"
+echo "   sudo ./ops/robotics/rt/irq_nic_tuning.sh eth0"
+echo
+echo "6) Measure jitter (run ops/robotics/rt/jitter_test.py and inspect /tmp/jitter_test_summary.json)"
+echo
+if [ "$DRY_RUN" -eq 0 ]; then
+  echo "Operator elected to apply some steps automatically (limited)."
+  # Note: Minimal safe actions only (no kernel install). Operators should do kernel install manually.
+  echo "Setting sysctl busy_poll defaults (requires sudo)"
+  sudo sysctl -w net.core.busy_poll=50
+  sudo sysctl -w net.core.busy_read=50
+  echo "Done."
+fi
