+kind: Deployment
+metadata:
+  name: aegis-redis
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: aegis-redis
+  template:
+    metadata:
+      labels:
+        app: aegis-redis
+    spec:
+      containers:
+      - name: redis
+        image: redis:7.2-alpine
+        ports:
+        - containerPort: 6379
+        args: ["--save", "", "--appendonly", "no"]
+---
