 @dataclass(frozen=True)
 class Limits:
     max_rpm: Optional[int] = None
     max_concurrency: Optional[int] = None
     max_daily_units: Optional[int] = None
 
 
 def _parse_limits(dep: Deployment) -> Limits:
     cfg = dep.limits or {}
     def _i(k):
         v = cfg.get(k)
         if v is None:
             return None
         return int(v)
     return Limits(max_rpm=_i("max_rpm"), max_concurrency=_i("max_concurrency"), max_daily_units=_i("max_daily_units"))
 
+def _redis_client():
+    """
+    Lazy import to keep redis optional for dev.
+    """
+    import os
+    url = os.environ.get("AEGIS_REDIS_URL", "").strip()
+    if not url:
+        return None
+    try:
+        import redis  # type: ignore
+        return redis.Redis.from_url(url, decode_responses=True)
+    except Exception:
+        return None
+
+
+def _key(prefix: str, tenant_id: str, dep_id: str, suffix: str) -> str:
+    return f"aegis:{prefix}:tenant:{tenant_id}:dep:{dep_id}:{suffix}"
+
+
+def _window_bucket(now: float, window_s: int) -> int:
+    return int(now // window_s)
+
+
+def _enforce_limits_db(tenant_id: str, dep: Deployment, predicted_units: int) -> None:
+    """
+    Old DB-backed enforcement retained as fallback if Redis is unavailable.
+    """
+    lim = _parse_limits(dep)
+    if not (lim.max_rpm or lim.max_daily_units):
+        return
+    s = SessionLocal()
+    try:
+        if lim.max_rpm:
+            recent = (
+                s.query(UsageRecord)
+                .filter(UsageRecord.tenant_id == tenant_id)
+                .filter(UsageRecord.deployment_id == dep.id)
+                .order_by(UsageRecord.id.desc())
+                .limit(lim.max_rpm + 5)
+                .all()
+            )
+            if len(recent) >= lim.max_rpm:
+                raise HTTPException(status_code=429, detail="rate limit exceeded (max_rpm)")
+
+        if lim.max_daily_units:
+            rows = (
+                s.query(UsageRecord.units)
+                .filter(UsageRecord.tenant_id == tenant_id)
+                .filter(UsageRecord.deployment_id == dep.id)
+                .order_by(UsageRecord.id.desc())
+                .limit(50000)
+                .all()
+            )
+            used = sum(int(r[0] or 0) for r in rows)
+            if used + int(predicted_units) > lim.max_daily_units:
+                raise HTTPException(status_code=429, detail="quota exceeded (max_daily_units)")
+    finally:
+        s.close()
+
+
+def _enforce_limits_redis(tenant_id: str, dep: Deployment, predicted_units: int) -> None:
+    """
+    Redis-backed enforcement:
+      - max_rpm: fixed window counter per 60s bucket
+      - max_daily_units: fixed window counter per day bucket
+
+    This is accurate under load and O(1) per request.
+
+    NOTE:
+      - For best results, call enforce_limits() before doing expensive inference work.
+      - This does not implement concurrency limiting yet (requires token bucket / semaphore pattern).
+    """
+    r = _redis_client()
+    if r is None:
+        _enforce_limits_db(tenant_id, dep, predicted_units)
+        return
+
+    lim = _parse_limits(dep)
+    if not (lim.max_rpm or lim.max_daily_units):
+        return
+
+    now = time.time()
+    pipe = r.pipeline()
+    checks = []
+
+    # RPM
+    if lim.max_rpm:
+        bucket = _window_bucket(now, 60)
+        k = _key("rl", tenant_id, dep.id, f"rpm:{bucket}")
+        pipe.incr(k, 1)
+        # expire a little after the window
+        pipe.expire(k, 90)
+        checks.append(("rpm", lim.max_rpm, k))
+
+    # Daily units
+    if lim.max_daily_units:
+        day_bucket = _window_bucket(now, 86400)
+        k = _key("quota", tenant_id, dep.id, f"day:{day_bucket}")
+        pipe.incrby(k, int(predicted_units))
+        pipe.expire(k, 86400 + 3600)
+        checks.append(("daily_units", lim.max_daily_units, k))
+
+    res = pipe.execute()
+
+    # res contains [incrVal, expireBool, incrVal, expireBool,...] in the same order
+    # We evaluate only incr values.
+    idx = 0
+    for typ, limit, keyname in checks:
+        current = res[idx]
+        idx += 2
+        try:
+            current_i = int(current)
+        except Exception:
+            current_i = 0
+        if typ == "rpm" and lim.max_rpm and current_i > lim.max_rpm:
+            raise HTTPException(status_code=429, detail="rate limit exceeded (max_rpm)")
+        if typ == "daily_units" and lim.max_daily_units and current_i > lim.max_daily_units:
+            raise HTTPException(status_code=429, detail="quota exceeded (max_daily_units)")
+
 
