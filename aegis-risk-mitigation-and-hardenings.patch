+#!/usr/bin/env python3
+"""
+Enhanced streaming safety checker:
+ - fast regex and heuristic detectors
+ - RAG provenance fingerprint check (if retrieval metadata attached)
+ - chain-of-thought / covert channel heuristics
+ - returns score (0..1) and reason
+"""
+import re, logging, hashlib
+
+LOG = logging.getLogger("aegis.safety.stream.v2")
+logging.basicConfig(level=logging.INFO)
+
+PII_RE = re.compile(r"\b(?:\d{3}-\d{2}-\d{4}|\d{16}|\b\d{4}\s?\d{4}\s?\d{4}\s?\d{4})\b")
+PROFANITY_RE = re.compile(r"\b(shit|damn|fuck|bitch|asshole)\b", re.I)
+COHERENCE_EXFIL_RE = re.compile(r"(secret|password|ssn|credit card|api key|flag)", re.I)
+COT_RE = re.compile(r"(think step|chain of thought|step-by-step|first|then|finally)", re.I)
+
+def check_retrieval_provenance(retrieval_meta):
+    """
+    Ensure retrieval metadata contains doc_id and a signed_hash (or fingerprint).
+    If missing, increase the score (suspicious).
+    """
+    if not retrieval_meta:
+        return 0.0, "no_retrieval_provenance"
+    doc_id = retrieval_meta.get("doc_id")
+    hash_f = retrieval_meta.get("hash")
+    signed = retrieval_meta.get("signed")
+    if not doc_id or not hash_f:
+        return 0.6, "incomplete_retrieval_provenance"
+    if signed is not True:
+        return 0.5, "unverified_retrieval"
+    return 0.0, "provenance_ok"
+
+def check_chunk(text, retrieval_meta=None):
+    """
+    Return (score, reason)
+    """
+    score = 0.0
+    reasons = []
+    if not text:
+        return 0.0, "empty"
+    if PII_RE.search(text):
+        score = max(score, 0.98)
+        reasons.append("pii_detected")
+    if PROFANITY_RE.search(text):
+        score = max(score, 0.6)
+        reasons.append("profanity")
+    if COHERENCE_EXFIL_RE.search(text):
+        score = max(score, 0.9)
+        reasons.append("sensitive_word")
+    if COT_RE.search(text):
+        # chain-of-thought style responses may indicate exfil via covert channels
+        score = max(score, 0.5)
+        reasons.append("cot_like")
+    if retrieval_meta:
+        rscore, rreason = check_retrieval_provenance(retrieval_meta)
+        if rscore > 0:
+            score = max(score, rscore)
+            reasons.append(rreason)
+    if not reasons:
+        return 0.0, "ok"
+    return score, ",".join(reasons)
+
