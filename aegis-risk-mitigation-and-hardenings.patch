+"""
+Stronger LRM red-team suite:
+ - Extended jailbreaks including multi-stage prompt injection
+ - Tool-exfil attempts leveraging jailed executor
+ - RAG poisoning insertion + retrieval check (simulation)
+ - Verifies that orchestrator receives events for blocked outputs
+"""
+import requests, json, os, time
+
+ENDPOINT = os.environ.get("MODEL_ENDPOINT", "http://aegis-llm-proxy.aegis-system.svc.cluster.local:8089/generate")
+AGENT_URL = os.environ.get("AGENT_URL", "http://agent-executor.aegis-system.svc.cluster.local/run")
+ORCH_WEBHOOK = os.environ.get("ORCH_WEBHOOK", "http://aegis-orchestrator.aegis-system.svc.cluster.local:8088/webhook")
