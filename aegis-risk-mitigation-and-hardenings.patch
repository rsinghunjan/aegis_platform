+#!/usr/bin/env python3
+"""
+Retrain guard service / helper
+ - Enforces curated sample selection policy (only curated_examples path used)
+ - Checks cooldown and rate limits (via Redis or simple file-backed store)
+ - Verifies that sensitive datasets have human cosign multisig approval (calls multisig verifier)
+ - Intended to be called by Orchestrator before submitting Argo retrain workflows
+
+Environment:
+ - REDIS_URL (optional) for production counters
+ - COOLDOWN_SECONDS (default 3600)
+ - MAX_RETRAINS_PER_24H (default 3)
+ - MULTISIG_THRESHOLD (default 2)
+ - MULTISIG_VERIFY_CMD (path to multisig verification helper)
+"""
+import os, time, json, logging, subprocess
+from datetime import datetime, timedelta
+
+LOG = logging.getLogger("aegis.retrain.guard")
+logging.basicConfig(level=logging.INFO)
+
+COOLDOWN = int(os.environ.get("COOLDOWN_SECONDS", "3600"))
+MAX_PER_24H = int(os.environ.get("MAX_RETRAINS_PER_24H", "3"))
+MULTISIG_THRESHOLD = int(os.environ.get("MULTISIG_THRESHOLD", "2"))
+MULTISIG_CMD = os.environ.get("MULTISIG_VERIFY_CMD", "/app/multisig_verify.py")
+STATE_PATH = os.environ.get("RETRAIN_STATE_PATH", "/var/lib/aegis/retrain_state.json")
+
+def load_state():
+    try:
+        with open(STATE_PATH, "r") as fh:
+            return json.load(fh)
+    except Exception:
+        return {"history": []}
+
+def save_state(state):
+    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
+    with open(STATE_PATH, "w") as fh:
+        json.dump(state, fh)
+
+def retrain_allowed(dataset_meta, requestor):
+    """
+    dataset_meta: dict, expected keys: sensitivity (low/medium/high), curated_examples_path (optional)
+    requestor: identity string
+    Returns (allowed:bool, reason:str)
+    """
+    state = load_state()
+    now_ts = int(time.time())
+
+    # cooldown check
+    last_ts = max((h["ts"] for h in state["history"]), default=0)
+    if last_ts and (now_ts - last_ts) < COOLDOWN:
+        return False, f"cooldown_active:{COOLDOWN - (now_ts - last_ts)}s"
+
+    # count in last 24h
+    cutoff = now_ts - 24*3600
+    recent = [h for h in state["history"] if h["ts"] >= cutoff]
+    if len(recent) >= MAX_PER_24H:
+        return False, f"rate_limit_exceeded:{len(recent)}/{MAX_PER_24H}"
+
+    # sensitive dataset -> require multisig approvals
+    if dataset_meta.get("sensitivity") == "high":
+        sigs = dataset_meta.get("approvals", [])
+        if len(sigs) < MULTISIG_THRESHOLD:
+            # Attempt to call verifier if provided with sig locations
+            # multisig_verify returns 0 on success
+            try:
+                args = [MULTISIG_CMD, "--threshold", str(MULTISIG_THRESHOLD)] + [f"--sig={s}" for s in sigs]
+                LOG.info("Invoking multisig verifier: %s", args)
+                subprocess.check_call(args)
+            except subprocess.CalledProcessError:
+                return False, "multisig_verification_failed"
+
+    # curated samples present?
+    if not dataset_meta.get("curated_examples_path"):
+        return False, "no_curated_examples"
+
+    # Passed all checks; record tentative execution
+    state["history"].append({"ts": now_ts, "requestor": requestor})
+    # keep history bounded
+    state["history"] = [h for h in state["history"] if h["ts"] >= cutoff]
+    save_state(state)
+    return True, "allowed"
+
+def main():
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dataset-meta", required=True, help="JSON string or path to file")
+    ap.add_argument("--requestor", required=True)
+    args = ap.parse_args()
+    # load dataset_meta
+    try:
+        if os.path.exists(args.dataset_meta):
+            dataset_meta = json.load(open(args.dataset_meta))
+        else:
+            dataset_meta = json.loads(args.dataset_meta)
+    except Exception as e:
+        LOG.exception("failed to load dataset meta")
+        print(json.dumps({"allowed": False, "reason": "bad_dataset_meta"}))
+        return 2
+    allowed, reason = retrain_allowed(dataset_meta, args.requestor)
+    print(json.dumps({"allowed": allowed, "reason": reason}))
+    return 0 if allowed else 1
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
