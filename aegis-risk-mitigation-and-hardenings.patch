+#!/usr/bin/env python3
+"""
+Jailed executor output scanner:
+ - Runs simple scanning & redaction on tool outputs before returning them to callers
+ - Ensures outputs do not contain secrets or high-risk tokens
+ - Stores a signed evidence bundle for any blocked outputs
+"""
+import os, re, json, hashlib, logging, subprocess
+from datetime import datetime
+
+LOG = logging.getLogger("aegis.jailed.scan")
+logging.basicConfig(level=logging.INFO)
+
+SECRETS_RE = re.compile(r"(api[_-]?key|secret|password|-----BEGIN PRIVATE KEY-----)", re.I)
+
+def redact_output(text):
+    return SECRETS_RE.sub("[REDACTED]", text)
+
+def scan_output(text):
+    if SECRETS_RE.search(text):
+        return False, "contains_secrets"
+    # other heuristics can be added here
+    return True, "ok"
+
+def store_evidence(incident_id, output_text, metadata, outdir="/var/lib/aegis/evidence"):
+    os.makedirs(outdir, exist_ok=True)
+    fname = f"{incident_id}_{int(time.time())}.json"
+    path = os.path.join(outdir, fname)
+    bundle = {"ts": datetime.utcnow().isoformat()+"Z", "incident": incident_id, "metadata": metadata, "output": output_text}
+    with open(path, "w") as fh:
+        json.dump(bundle, fh)
+    # sign with cosign if available (placeholder)
+    try:
+        subprocess.run(["cosign", "sign-blob", "--key", os.environ.get("COSIGN_KMS_URI",""), path], check=True)
+    except Exception:
+        LOG.exception("cosign sign failed (optional)")
+    return path
+
+def process_output(incident_id, output_text, metadata):
+    ok, reason = scan_output(output_text)
+    if ok:
+        safe_text = redact_output(output_text)
+        return {"status":"ok", "text": safe_text}
+    # blocked: store evidence and return blocked marker
+    path = store_evidence(incident_id, output_text, metadata)
+    return {"status":"blocked", "reason": reason, "evidence": path}
+
+if __name__ == "__main__":
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--incident", required=True)
+    ap.add_argument("--input-file", required=True)
+    args = ap.parse_args()
+    txt = open(args.input_file).read()
+    res = process_output(args.incident, txt, {"source":"test"})
+    print(json.dumps(res, indent=2))
+
