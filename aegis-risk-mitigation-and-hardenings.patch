+#!/usr/bin/env python3
+"""
+Simple multisig verifier wrapper for cosign signed blobs.
+Usage:
+  multisig_verify.py --threshold 2 --sig sig1.sig --sig sig2.sig --blob payload.bin --key awskms://alias/...
+
+This script calls `cosign verify-blob` for each signature and returns 0 only when
+the number of valid signatures >= threshold.
+Note: Requires cosign installed and COSIGN_EXPERIMENTAL=1 if using KMS URIs.
+"""
+import argparse, subprocess, logging, sys
+
+logging.basicConfig(level=logging.INFO)
+LOG = logging.getLogger("aegis.multisig")
+
+def verify_one(sig, blob, key=None):
+    cmd = ["cosign", "verify-blob", "--signature", sig, blob]
+    if key:
+        cmd += ["--key", key]
+    try:
+        subprocess.check_call(cmd)
+        return True
+    except subprocess.CalledProcessError:
+        return False
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--threshold", type=int, required=True)
+    ap.add_argument("--sig", action="append", default=[])
+    ap.add_argument("--blob", required=False)
+    ap.add_argument("--key", required=False)
+    args = ap.parse_args()
+    valid = 0
+    for s in args.sig:
+        ok = verify_one(s, args.blob or "payload.bin", args.key)
+        LOG.info("sig %s ok=%s", s, ok)
+        if ok:
+            valid += 1
+    LOG.info("valid signatures: %d (threshold %d)", valid, args.threshold)
+    if valid >= args.threshold:
+        return 0
+    return 2
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
