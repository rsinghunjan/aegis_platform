+#!/usr/bin/env python3
+"""
+policy_enforcer.py
+Enforces secure-aggregation policy: require min group size, require client enrollment,
+and prevent direct non-masked submissions to the central aggregator.
+This is a lightweight policy gate to reduce risk of naive aggregation.
+"""
+import os, requests, time
+from flask import Flask, request, jsonify
+import jwt
+
+app = Flask(__name__)
+SECRET = os.environ.get("FED_JWT_SECRET", "dev-fed-secret")
+MIN_GROUP = int(os.environ.get("SECAGG_MIN_GROUP", "3"))
+
+def verify_token(token):
+    try:
+        return jwt.decode(token, SECRET, algorithms=["HS256"])
+    except Exception:
+        return None
+
+@app.route("/submit_check", methods=["POST"])
+def submit_check():
+    auth = request.headers.get("Authorization","")
+    if not auth.startswith("Bearer "):
+        return jsonify({"ok": False, "reason": "missing_auth"}), 401
+    token = auth.split(" ",1)[1]
+    payload = verify_token(token)
+    if not payload:
+        return jsonify({"ok": False, "reason": "invalid_token"}), 401
+    group = request.json.get("group_id")
+    # check group membership and expected size via coordinator (simplified)
+    coord = os.environ.get("SECAGG_COORD", "http://secagg-coord:8100")
+    try:
+        r = requests.get(f"{coord}/group/info?group_id={group}", timeout=5.0)
+        if not r.ok:
+            return jsonify({"ok": False, "reason": "group_unknown"}), 400
+        info = r.json()
+        if info.get("expected",0) < MIN_GROUP:
+            return jsonify({"ok": False, "reason": "group_too_small"}), 400
+    except Exception:
+        return jsonify({"ok": False, "reason": "coord_unreachable"}), 503
+    # If checks pass, allow submission to coordinator URL (client should post there)
+    return jsonify({"ok": True})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8110")))
+
