+#!/usr/bin/env python3
+"""
+retrieval_guard_audit.py
+Enforces retrieval guard checks and writes audited retrieval events to MCP.
+Prevents retrieval if no consent or no HIL approval; integrates with A2A service for final approvals.
+"""
+import os, requests, time
+
+CONSENT_API = os.environ.get("CONSENT_API", "http://consent-service:8080")
+A2A_API = os.environ.get("A2A_API", "http://a2a:8082")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def has_consent(subject_id, scope="medical"):
+    try:
+        r = requests.get(f"{CONSENT_API}/consent?subject_id={subject_id}&scope={scope}", timeout=3.0)
+        return r.ok and r.json().get("consent", False)
+    except Exception:
+        return False
+
+def check_hil(artifact_id, requester):
+    try:
+        r = requests.post(f"{A2A_API}/request", json={"action_id":f"retrieve-{artifact_id}","summary":"Request original retrieval","requester":requester}, timeout=5.0)
+        if not r.ok:
+            return False, None
+        rid = r.json().get("request_id")
+        # Wait or poll for approval in production; here we require explicit approval step
+        return True, rid
+    except Exception:
+        return False, None
+
+def audit_event(artifact_id, subject_id, requester, granted, reason="", evidence=None):
+    payload = {"artifact_id":artifact_id,"subject_id":subject_id,"requester":requester,"granted":granted,"reason":reason,"evidence":evidence,"ts":time.time()}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/audit/retrieval", json=payload, timeout=3.0)
+    except Exception:
+        pass
+
+def retrieve_original(artifact_id, subject_id, requester):
+    if not has_consent(subject_id, scope="medical"):
+        audit_event(artifact_id, subject_id, requester, False, "no_consent")
+        return {"ok": False, "reason": "no_consent"}
+    ok, rid = check_hil(artifact_id, requester)
+    if not ok:
+        audit_event(artifact_id, subject_id, requester, False, "no_hil")
+        return {"ok": False, "reason": "no_hil"}
+    # operator must approve in A2A; fetch evidence later
+    audit_event(artifact_id, subject_id, requester, True, "hil_requested", evidence={"request_id": rid})
+    return {"ok": True, "request_id": rid}
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv)<4:
+        print("usage: retrieve <artifact_id> <subject_id> <requester>")
+    else:
+        print(retrieve_original(sys.argv[1], sys.argv[2], sys.argv[3]))
+
