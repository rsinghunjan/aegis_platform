+#!/usr/bin/env python3
+"""
+fairness_audit.py
+Compute simple fairness metrics (demographic parity, equalized odds) and log to MCP/MLflow.
+Input: CSV with columns: prediction (0/1), label (0/1), sensitive_attribute (e.g., impairment)
+"""
+import argparse
+import pandas as pd
+import numpy as np
+import requests
+import os
+import json
+import mlflow
+
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def demographic_parity(df, attr):
+    groups = df[attr].unique()
+    rates = {}
+    for g in groups:
+        rates[g] = df[df[attr] == g]["prediction"].mean()
+    return rates
+
+def equalized_odds(df, attr):
+    groups = df[attr].unique()
+    metrics = {}
+    for g in groups:
+        sub = df[df[attr] == g]
+        tpr = sub[(sub["label"]==1)]["prediction"].mean() if len(sub[sub["label"]==1])>0 else np.nan
+        fpr = sub[(sub["label"]==0)]["prediction"].mean() if len(sub[sub["label"]==0])>0 else np.nan
+        metrics[g] = {"tpr": tpr, "fpr": fpr}
+    return metrics
+
+def run_audit(path, sensitive):
+    df = pd.read_csv(path)
+    dp = demographic_parity(df, sensitive)
+    eo = equalized_odds(df, sensitive)
+    report = {"demographic_parity": dp, "equalized_odds": eo, "sensitive": sensitive}
+    # log to MLflow if configured
+    if os.environ.get("MLFLOW_TRACKING_URI"):
+        mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI"))
+        with mlflow.start_run(run_name="fairness-audit"):
+            mlflow.log_param("sensitive_attribute", sensitive)
+            mlflow.log_metric("groups", len(dp))
+            mlflow.log_artifact(path)
+    # post to MCP
+    try:
+        requests.post(f"{MCP_API.rstrip('/')}/governance/fairness_audit", json=report, timeout=5.0)
+    except Exception:
+        pass
+    return report
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--data", required=True)
+    p.add_argument("--sensitive", default="impairment")
+    args = p.parse_args()
+    r = run_audit(args.data, args.sensitive)
+    print(json.dumps(r, indent=2))
+
