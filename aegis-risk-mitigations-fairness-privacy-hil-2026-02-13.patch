+#!/usr/bin/env python3
+"""
+edge_case_sampler.py
+Selects edge-case examples from embeddings stored in Milvus by combining
+uncertainty scores and diversity sampling to prioritize human annotation.
+"""
+import os
+from pymilvus import connections, Collection
+import numpy as np
+import random
+import json
+
+MILVUS_HOST = os.environ.get("MILVUS_HOST", "milvus.default.svc.cluster.local")
+MILVUS_PORT = int(os.environ.get("MILVUS_PORT", 19530))
+COLLECTION_NAME = os.environ.get("MILVUS_COLLECTION", "aegis_active")
+
+def connect():
+    connections.connect(host=MILVUS_HOST, port=str(MILVUS_PORT))
+
+def top_uncertain_diverse(k=100, diversity_k=10):
+    connect()
+    coll = Collection(COLLECTION_NAME)
+    # fetch top uncertain via expr
+    rows = coll.query(expr="uncertainty > 0", output_fields=["id","uncertainty","embedding","payload"], limit=k*5)
+    # sort by uncertainty desc
+    rows = sorted(rows, key=lambda r: float(r["uncertainty"]), reverse=True)
+    # diversity sampling: cluster by simple random sampling / kmeans placeholder
+    selected = []
+    embeddings = [np.array(r["embedding"]) for r in rows]
+    if not embeddings:
+        return []
+    idxs = list(range(len(embeddings)))
+    random.shuffle(idxs)
+    for idx in idxs:
+        if len(selected) >= k:
+            break
+        candidate = rows[idx]
+        # ensure diversity by simple distance threshold against selected embeddings
+        keep = True
+        cand_emb = np.array(candidate["embedding"])
+        for s in selected[-diversity_k:]:
+            if np.linalg.norm(cand_emb - np.array(s["embedding"])) < 0.1:
+                keep = False
+                break
+        if keep:
+            selected.append(candidate)
+    # return top-k selected payloads
+    return [{"id": r["id"], "uncertainty": r["uncertainty"], "payload": json.loads(r["payload"])} for r in selected[:k]]
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--k", type=int, default=50)
+    args = p.parse_args()
+    out = top_uncertain_diverse(k=args.k)
+    print(json.dumps(out, indent=2))
+
