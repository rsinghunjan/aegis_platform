+#!/usr/bin/env python3
+"""
+domain_randomization_enhanced.py
+Enhanced domain randomization to generate diverse synthetic scenarios,
+support class-balance augmentation, and produce datasets for fairness testing.
+
+Usage:
+  python domain_randomization_enhanced.py --n 1000 --out synthetic.jsonl --balance "gender:0.5"
+"""
+import argparse
+import json
+import random
+from datetime import datetime
+from collections import Counter
+
+BASE_RANGES = {
+    "temperature_c": (-20.0, 10.0),
+    "humidity": (5.0, 95.0),
+    "wind_m_s": (0.0, 15.0),
+    "snow_grain_size_mm": (0.05, 4.0),
+    "altitude_m": (0.0, 4500.0),
+    "surface_roughness": (0.0, 1.5),
+}
+
+DEMOGRAPHICS = {
+    "gender": ["male", "female", "nonbinary"],
+    "body_type": ["slim","average","stocky","tall"],
+    "impairment": ["none","vision","limb","balance"]
+}
+
+def synthesize(params, demo):
+    # Very small toy physics-like features — replace with digital twin for production
+    temp = params["temperature_c"]
+    grain = params["snow_grain_size_mm"]
+    rough = params["surface_roughness"]
+    altitude = params["altitude_m"]
+    # base friction
+    friction = 0.15 + 0.01*(0 - temp) + 0.05*grain + 0.02*rough + 0.001*(altitude/100)
+    # simple bias factors for demo demographics to simulate real-world measurement differences
+    if demo["body_type"] == "stocky":
+        friction *= 1.03
+    if demo["impairment"] != "none":
+        stability = max(0.0, 0.6 - 0.1*("limb" in demo["impairment"]))
+    else:
+        stability = max(0.0, 1.0 - 0.1*rough)
+    glide = max(0.0, 1.0 - friction - 0.01*abs(params["wind_m_s"] - 3.0))
+    # add gaussian noise
+    friction *= random.uniform(0.98, 1.02)
+    glide *= random.uniform(0.98, 1.02)
+    stability *= random.uniform(0.97, 1.03)
+    return {"friction": friction, "glide": glide, "stability": stability}
+
+def sample_one(ranges, demographic=None):
+    params = {k: random.uniform(v[0], v[1]) for k, v in ranges.items()}
+    demo = demographic or {k: random.choice(v) for k,v in DEMOGRAPHICS.items()}
+    features = synthesize(params, demo)
+    return {"ts": datetime.utcnow().isoformat()+"Z", "params": params, "demo": demo, "features": features}
+
+def stratified_generate(n, out, balance_spec=None):
+    """
+    balance_spec: e.g. "gender:0.5,body_type:0.25" - simple weighted sampling for primary axis
+    """
+    balances = {}
+    if balance_spec:
+        for token in balance_spec.split(","):
+            k,v = token.split(":")
+            balances[k.strip()] = float(v.strip())
+    records = []
+    for i in range(n):
+        # sample demographic with optional bias to improve minority representation
+        demo = {}
+        for k, vals in DEMOGRAPHICS.items():
+            if k in balances:
+                if random.random() < balances[k]:
+                    # pick first value as prioritized group
+                    demo[k] = vals[0]
+                else:
+                    demo[k] = random.choice(vals)
+            else:
+                demo[k] = random.choice(vals)
+        rec = sample_one(BASE_RANGES, demo)
+        records.append(rec)
+    with open(out, "w") as f:
+        for r in records:
+            f.write(json.dumps(r) + "\n")
+    print(f"Wrote {len(records)} synthetic records to {out}")
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--n", type=int, default=1000)
+    p.add_argument("--out", default="synthetic.jsonl")
+    p.add_argument("--balance", default="")
+    args = p.parse_args()
+    stratified_generate(args.n, args.out, args.balance)
+
