+#!/usr/bin/env python3
+"""
+require_hil_enforcer.py
+Middleware/service to gate critical automated actions. Any critical action must be pre-approved by A2A HIL.
+This service exposes an API to register an intent and to check approval before execution.
+"""
+import os, time, requests, json
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+A2A_API = os.environ.get("A2A_API", "http://a2a:8082")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def request_hil(action_id, summary, owner):
+    try:
+        r = requests.post(f"{A2A_API}/request", json={"action_id":action_id,"summary":summary,"requester":owner}, timeout=5.0)
+        if r.ok:
+            return r.json().get("request_id")
+    except Exception:
+        pass
+    return None
+
+def check_status(request_id):
+    try:
+        r = requests.get(f"{A2A_API}/status/{request_id}", timeout=5.0)
+        if r.ok:
+            return r.json().get("status")
+    except Exception:
+        pass
+    return None
+
+@app.route("/intent", methods=["POST"])
+def intent():
+    j = request.json or {}
+    action_id = j.get("action_id")
+    summary = j.get("summary")
+    owner = j.get("owner","unknown")
+    # register HIL request
+    rid = request_hil(action_id, summary, owner)
+    if not rid:
+        return jsonify({"ok": False, "reason": "failed_to_register"}), 500
+    # record audit
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/a2a/intents", json={"request_id":rid,"action_id":action_id,"summary":summary,"owner":owner,"ts":time.time()}, timeout=3.0)
+    except Exception:
+        pass
+    return jsonify({"ok": True, "request_id": rid})
+
+@app.route("/can_execute/<rid>", methods=["GET"])
+def can_execute(rid):
+    status = check_status(rid)
+    if status == "RESOLVED":
+        return jsonify({"ok": True})
+    return jsonify({"ok": False, "status": status})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT","8083")))
+
