+#!/usr/bin/env python3
+"""
+Validating webhook that checks container images in Pod/Job specs are signed with cosign.
+ - For each image, runs 'cosign verify' (optionally with KMS key) and fails admission if any image fails verification.
+ - This should be deployed as a TLS webhook (see ops/webhook/cert-manager/*).
+
+Notes:
+ - This is a best-effort local verifier and relies on cosign being available in the webhook container.
+ - For scale/robustness, consider calling an internal verification service rather than running cosign per request.
+"""
+import os, json, subprocess
+from flask import Flask, request, jsonify
+
+COSIGN_KEY = os.environ.get("COSIGN_KMS_URI", "")
+COSIGN_ALLOW_INSECURE = os.environ.get("COSIGN_ALLOW_INSECURE", "0")  # set to 1 to allow unsigned images (dev)
+
+app = Flask(__name__)
+
+def verify_image(image):
+    """
+    Return (True, msg) if cosign verify passes, else (False, err).
+    Supports images with remote signatures.
+    """
+    try:
+        if COSIGN_KEY:
+            subprocess.check_call(["cosign","verify","--key",COSIGN_KEY, image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        else:
+            subprocess.check_call(["cosign","verify", image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        return True, "verified"
+    except subprocess.CalledProcessError as e:
+        return False, str(e)
+    except FileNotFoundError:
+        return False, "cosign not installed"
+
+def extract_images_from_admission(admission_req):
+    img_list = []
+    try:
+        obj = admission_req.get("request",{}).get("object",{})
+        spec = obj.get("spec", {})
+        containers = spec.get("containers",[]) + spec.get("initContainers",[])
+        for c in containers:
+            img_list.append(c.get("image"))
+    except Exception:
+        pass
+    return img_list
+
+@app.route("/validate", methods=["POST"])
+def validate():
+    adreq = request.get_json(force=True)
+    images = extract_images_from_admission(adreq)
+    details = {}
+    for img in images:
+        ok, msg = verify_image(img)
+        details[img] = {"ok": ok, "msg": msg}
+        if not ok and COSIGN_ALLOW_INSECURE != "1":
+            resp = {"response": {"allowed": False, "status": {"message": f"Image {img} failed cosign verify: {msg}"}}}
+            return jsonify(resp)
+    return jsonify({"response": {"allowed": True, "status": {"message": "All images verified", "details": details}}})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 8443)))
+
