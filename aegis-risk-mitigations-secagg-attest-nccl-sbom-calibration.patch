+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Pre-deploy check: verify all images referenced in Kubernetes manifests are cosign-signed.
+# Usage: ops/ci/check_signed_images_before_deploy.sh <manifests-dir>
+MANIFEST_DIR=${1:-manifests}
+COSIGN_KEY=${COSIGN_KMS_URI:-}
+
+images=$(grep -R "image:" -n "$MANIFEST_DIR" | awk -F: '{print $3}' | tr -d ' ' | sort -u)
+if [ -z "$images" ]; then
+  echo "No images found in manifests under $MANIFEST_DIR"
+  exit 0
+fi
+for img in $images; do
+  echo "Verifying image: $img"
+  if command -v cosign >/dev/null 2>&1; then
+    if [ -n "$COSIGN_KEY" ]; then
+      cosign verify --key "$COSIGN_KEY" "$img"
+    else
+      cosign verify "$img"
+    fi
+  else
+    echo "cosign not installed; failing deployment check"
+    exit 2
+  fi
+done
+echo "All images verified"
+
