+#!/usr/bin/env python3
+"""
+Robust aggregation utilities for federated learning.
+
+Provides:
+ - fedavg(weights_list)
+ - elementwise_median(weights_list)
+ - krum(weights_list, f=1)  # robust to up to f Byzantine clients
+ - outlier_detection(weights_list) -> indices flagged as outliers (norm-based)
+
+Weights are lists (or numpy arrays) of equal length.
+"""
+import numpy as np
+from typing import List
+
+def fedavg(weights_list: List[List[float]]):
+    arrs = [np.array(w, dtype=float) for w in weights_list]
+    return np.mean(arrs, axis=0).tolist()
+
+def elementwise_median(weights_list: List[List[float]]):
+    arrs = np.array(weights_list, dtype=float)
+    return np.median(arrs, axis=0).tolist()
+
+def krum(weights_list: List[List[float]], f: int = 1):
+    """
+    Krum implementation (simplified).
+    Selects one update that is closest to others after removing f outliers.
+    Returns aggregate as that selected vector (not average of many).
+    """
+    arrs = [np.array(w, dtype=float) for w in weights_list]
+    n = len(arrs)
+    if n == 0:
+        return []
+    scores = []
+    for i in range(n):
+        dists = []
+        for j in range(n):
+            if i == j:
+                continue
+            dists.append(np.linalg.norm(arrs[i] - arrs[j])**2)
+        dists.sort()
+        # sum of n-f-2 smallest distances
+        nb = n - f - 2
+        nb = max(0, nb)
+        score = sum(dists[:nb]) if nb>0 else sum(dists)
+        scores.append((score, i))
+    scores.sort()
+    chosen_idx = scores[0][1]
+    return arrs[chosen_idx].tolist()
+
+def outlier_detection(weights_list: List[List[float]], z_thresh: float = 3.0):
+    """
+    Simple outlier detection using vector norms: flag updates whose norm
+    is more than z_thresh standard deviations from mean norm.
+    Returns list of indices flagged as outliers.
+    """
+    arrs = [np.array(w, dtype=float) for w in weights_list]
+    norms = np.array([np.linalg.norm(a) for a in arrs])
+    mu = norms.mean()
+    sigma = norms.std()
+    if sigma == 0:
+        return []
+    z = (norms - mu) / sigma
+    return [int(i) for i,zi in enumerate(z) if abs(zi) > z_thresh]
+
+if __name__ == "__main__":
+    # quick demo
+    w1 = [0.1]*10
+    w2 = [0.2]*10
+    w3 = [50.0]*10  # malicious
+    print("fedavg:", fedavg([w1,w2,w3])[:3])
+    print("median:", elementwise_median([w1,w2,w3])[:3])
+    print("krum:", krum([w1,w2,w3], f=1)[:3])
+    print("outliers:", outlier_detection([w1,w2,w3]))
+
