+#!/usr/bin/env python3
+"""
+Compare sampled GPU power via nvidia-smi against PDU/IPMI readings.
+This script is a template: integrate with your PDU/IPMI API or Prometheus node-exporter metrics.
+Produces a small calibration suggestion used by gpu_power_calibrator.
+"""
+import time, json, os, subprocess
+
+def sample_nvidia():
+    try:
+        out = subprocess.check_output(["nvidia-smi","--query-gpu=power.draw","--format=csv,noheader,nounits"])
+        vals = [float(x) for x in out.decode().strip().splitlines()]
+        return sum(vals)
+    except Exception:
+        return None
+
+def sample_pdu():
+    """
+    Placeholder: fetch PDU/IPMI power reading (Watts) for node.
+    Implement vendor SDK or prometheus query here.
+    """
+    # example: read env var or dummy
+    return float(os.environ.get("PDU_SIMULATED_W", "0"))
+
+def main(samples=5, interval=5, out="/tmp/gpu_pdu_compare.json"):
+    pairs=[]
+    for i in range(samples):
+        nv = sample_nvidia()
+        pdu = sample_pdu()
+        pairs.append({"nv": nv, "pdu": pdu, "ts": time.time()})
+        time.sleep(interval)
+    # compute avg
+    nv_vals = [p["nv"] for p in pairs if p["nv"]]
+    pdu_vals = [p["pdu"] for p in pairs if p["pdu"]]
+    avg_nv = sum(nv_vals)/len(nv_vals) if nv_vals else None
+    avg_pdu = sum(pdu_vals)/len(pdu_vals) if pdu_vals else None
+    # simple calibration factor: pdu / nv (if both present)
+    calib = (avg_pdu / avg_nv) if (avg_pdu and avg_nv) else 1.0
+    res = {"avg_nv": avg_nv, "avg_pdu": avg_pdu, "calib": calib, "samples": pairs}
+    with open(out, "w") as fh:
+        json.dump(res, fh, indent=2)
+    print("Wrote comparison to", out)
+
+if __name__=="__main__":
+    main()
+
