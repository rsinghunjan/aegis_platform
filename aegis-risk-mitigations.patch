+#!/usr/bin/env python3
+"""
+Verify a delegation/manifest meets an M-of-N signature requirement.
+ - Downloads manifest from evidence bucket (s3:// or gs://)
+ - Attempts cosign verify with each provided public key URI
+ - Requires `required` successful verifications to pass
+
+Usage:
+  multi_sign_verify.verify(manifest_uri, pubkey_uris, required=2)
+"""
+import os, subprocess, tempfile
+
+def fetch_uri(uri, dest):
+    if uri.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", uri, dest])
+    elif uri.startswith("gs://"):
+        subprocess.check_call(["gsutil","cp", uri, dest])
+    elif uri.startswith("file://"):
+        src = uri[len("file://"):]
+        subprocess.check_call(["cp", src, dest])
+    else:
+        raise RuntimeError("Unsupported URI scheme")
+
+def verify(manifest_uri, pubkey_uris, required=2):
+    tmp = tempfile.mkdtemp()
+    manifest_local = os.path.join(tmp, "manifest.json")
+    fetch_uri(manifest_uri, manifest_local)
+    ok_count = 0
+    for pk in pubkey_uris:
+        try:
+            pk_local = os.path.join(tmp, os.path.basename(pk))
+            fetch_uri(pk, pk_local)
+            # try cosign verify with key
+            subprocess.check_call(["cosign", "verify", "--key", pk_local, manifest_local])
+            ok_count += 1
+        except subprocess.CalledProcessError:
+            continue
+    return {"ok_count": ok_count, "required": required, "passed": ok_count >= required}
+
+if __name__ == "__main__":
+    import sys, json
+    m = sys.argv[1]
+    pks = sys.argv[2].split(",")
+    req = int(sys.argv[3]) if len(sys.argv) > 3 else 2
+    print(json.dumps(verify(m, pks, req), indent=2))
+
