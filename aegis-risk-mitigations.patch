+#!/usr/bin/env python3
+"""
+Secure LLM proxy with Redis-backed token accounting and rate limiting.
+ - Uses Redis to maintain per-tenant token budgets and sliding-window rate limits.
+ - If Redis is not available falls back to in-memory (best effort).
+
+Environment:
+ - REDIS_URL: redis://host:6379/0
+ - LLM_UPSTREAM: upstream LLM endpoint
+ - QUOTA_PER_WINDOW: integer tokens per window
+ - WINDOW_SECS: window duration in seconds
+ - RATE_LIMIT_PER_SEC: requests/sec allowed per tenant
+"""
+from flask import Flask, request, jsonify
+import os, requests, time
+from prometheus_client import Counter, Histogram
+
+app = Flask(__name__)
+UPSTREAM = os.environ.get("LLM_UPSTREAM","http://localhost:8000")
+TOKEN_COUNTER = Counter("aegis_llm_tokens_total", "Tokens consumed", ["tenant"])
+REQ_LATENCY = Histogram("aegis_llm_request_latency_seconds", "LLM request latency")
+
+QUOTA = int(os.environ.get("QUOTA_PER_WINDOW", "100000"))
+WINDOW_SECS = int(os.environ.get("WINDOW_SECS", "3600"))
+RATE_LIMIT_PER_SEC = float(os.environ.get("RATE_LIMIT_PER_SEC", "5.0"))
+REDIS_URL = os.environ.get("REDIS_URL", "")
+
+use_redis = False
+if REDIS_URL:
+    try:
+        import redis
+        rconn = redis.from_url(REDIS_URL)
+        use_redis = True
+    except Exception:
+        use_redis = False
+
+# in-memory fallback
+quota_window = {}
+req_timestamps = {}
+
+def count_tokens(text):
+    return max(1, len(text.split()))
+
+def consume_tokens(tenant, tokens):
+    now = int(time.time())
+    if use_redis:
+        key = f"aegis:quota:{tenant}:{now // WINDOW_SECS}"
+        used = int(rconn.get(key) or 0)
+        if used + tokens > QUOTA:
+            return False
+        rconn.incrby(key, tokens)
+        rconn.expire(key, WINDOW_SECS * 2)
+        return True
+    else:
+        window = quota_window.get(tenant, {"start": now, "used": 0})
+        if now - window["start"] >= WINDOW_SECS:
+            window = {"start": now, "used": 0}
+        if window["used"] + tokens > QUOTA:
+            quota_window[tenant] = window
+            return False
+        window["used"] += tokens
+        quota_window[tenant] = window
+        return True
+
+def rate_limit_ok(tenant):
+    now = time.time()
+    if use_redis:
+        # naive per-second window
+        key = f"aegis:rate:{tenant}:{int(now)}"
+        v = int(rconn.incr(key))
+        if v == 1:
+            rconn.expire(key, 2)
+        return v <= RATE_LIMIT_PER_SEC
+    else:
+        ts = req_timestamps.get(tenant, [])
+        ts = [t for t in ts if now - t <= 1.0]
+        if len(ts) >= RATE_LIMIT_PER_SEC:
+            return False
+        ts.append(now)
+        req_timestamps[tenant] = ts
+        return True
+
+@app.route("/v1/generate", methods=["POST"])
+def generate():
+    t0 = time.time()
+    body = request.get_json(force=True)
+    tenant = body.get("tenant","default")
+    prompt = body.get("prompt","")
+    if not rate_limit_ok(tenant):
+        return jsonify({"error":"rate_limited"}), 429
+    tokens = count_tokens(prompt)
+    if not consume_tokens(tenant, tokens):
+        return jsonify({"error":"quota_exceeded"}), 429
+    TOKEN_COUNTER.labels(tenant=tenant).inc(tokens)
+    try:
+        r = requests.post(UPSTREAM.rstrip("/") + "/generate", json=body, timeout=60)
+    except Exception as e:
+        return jsonify({"error":"upstream_error", "detail": str(e)}), 502
+    REQ_LATENCY.observe(time.time() - t0)
+    return (r.content, r.status_code, r.headers.items())
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("LLM_PROXY_SECURE_PORT","8084")))
+
