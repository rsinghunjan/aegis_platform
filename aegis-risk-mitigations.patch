+#!/usr/bin/env python3
+"""
+Estimate token cost for prompt files under a given directory and fail CI if estimated cost exceeds budget.
+ - Uses crude token estimate: tokens ~= words / 0.75 (approx)
+ - Config via env:
+   - TOKEN_PRICE_PER_1K: cost per 1k tokens (float)
+   - BUDGET_DOLLARS: maximum allowed dollars for this change
+
+Usage:
+  python3 tools/ci/estimate_token_cost.py --dir prompts/
+"""
+import os, sys, argparse, glob, json
+
+def estimate_tokens(text: str) -> int:
+    words = len(text.split())
+    tokens = int(words / 0.75)
+    return tokens
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--dir", required=True)
+    args = p.parse_args()
+    files = glob.glob(os.path.join(args.dir, "**/*.txt"), recursive=True)
+    total_tokens = 0
+    for f in files:
+        with open(f) as fh:
+            total_tokens += estimate_tokens(fh.read())
+    price_per_1k = float(os.environ.get("TOKEN_PRICE_PER_1K","0.002"))  # example $0.002 / 1k tokens
+    budget = float(os.environ.get("BUDGET_DOLLARS","1.0"))
+    cost = (total_tokens / 1000.0) * price_per_1k
+    print(f"Found {len(files)} prompt files, estimated tokens={total_tokens}, estimated_cost=${cost:.4f}, budget=${budget}")
+    if cost > budget:
+        print("Token budget exceeded — failing CI")
+        sys.exit(2)
+    print("Within budget")
+
+if __name__=="__main__":
+    main()
+
