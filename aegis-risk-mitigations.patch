+"""
+Escalation helpers:
+ - Create a human review ticket (GitHub issue or PagerDuty webhook)
+ - Record escalation in remediation tracker
+"""
+import os, subprocess, json, time
+
+GITHUB_REPO = os.environ.get("GITHUB_REPO", "")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN", "")
+PAGERDUTY_WEBHOOK = os.environ.get("PAGERDUTY_WEBHOOK", "")
+REMEDIATION_TRACKER = os.environ.get("REMEDIATION_TRACKER_SCRIPT", "services/audit/remediation_tracker.py")
+
+def create_github_issue(title: str, body: str):
+    if not (GITHUB_REPO and GITHUB_TOKEN):
+        return {"error":"no_gh"}
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    payload = {"title": title, "body": body, "labels": ["human-review", "escalation"]}
+    out = subprocess.check_output(["curl","-sS","-X","POST","-H",f"Authorization: token {GITHUB_TOKEN}","-H","Accept: application/vnd.github.v3+json","-d", json.dumps(payload), url], universal_newlines=True)
+    return json.loads(out)
+
+def notify_pagerduty(summary, details):
+    if not PAGERDUTY_WEBHOOK:
+        return {"error":"no_pd"}
+    subprocess.check_call(["curl","-sS","-X","POST","-H","Content-Type: application/json","-d", json.dumps({"summary": summary, "details": details}), PAGERDUTY_WEBHOOK])
+    return {"ok": True}
+
+def record_remediation(finding):
+    # finding is a list of dicts compatible with remediation_tracker.py
+    try:
+        subprocess.check_call(["python3", REMEDIATION_TRACKER, json.dumps(finding)])
+        return {"ok": True}
+    except Exception as e:
+        return {"error": str(e)}
+
+def escalate_for_review(model, query, response, evidence, reasons, metadata=None):
+    title = f"Human review: possible hallucination / policy issue - model={model}"
+    body = f"""Detected an automated escalation for model `{model}`.
+
+Query:
+{query}
+
+Response:
+{response}
+
+Reasons: {reasons}
+
+Support evidence summary:
+{json.dumps(evidence, indent=2)}
+
+Metadata:
+{json.dumps(metadata, indent=2)}
+"""
+    gh = create_github_issue(title, body)
+    notify = notify_pagerduty(title, {"issue": gh} if isinstance(gh, dict) else {"issue": str(gh)})
+    # create remediation tracker entry
+    finding = [{"id": f"escalation-{int(time.time())}", "severity":"high", "title": title, "description": body, "status":"open"}]
+    rec = record_remediation(finding)
+    return {"github": gh, "pagerduty": notify, "remediation": rec}
+
+if __name__=="__main__":
+    print("Escalation helper")
