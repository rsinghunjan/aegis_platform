+#!/usr/bin/env python3
+"""
+Simple factuality verifier for Aegis:
+ - Splits a response into candidate claims (sentences)
+ - For each claim, queries RAG (vector DB retriever) for supporting documents
+ - Produces a support score per claim and an overall support ratio
+ - Used by post-filters to decide human escalation
+
+Config via env:
+ - RAG_URL: URL to RAG service (compose/retrieve endpoints)
+ - SUPPORT_SCORE_THRESHOLD: minimal similarity score (lower means less support). Default 0.5 (adjust per embedding metric)
+"""
+import os, requests, math
+from typing import List
+
+RAG_URL = os.environ.get("RAG_URL", "http://rag:8082")
+SUPPORT_THRESHOLD = float(os.environ.get("SUPPORT_SCORE_THRESHOLD", "0.5"))
+
+def split_into_claims(text: str) -> List[str]:
+    # Very small heuristic splitter — replace with NLP claim extraction for production
+    import re
+    sentences = [s.strip() for s in re.split(r'[.?!\n]+', text) if s.strip()]
+    return sentences
+
+def support_for_claim(claim: str, top_k: int = 3) -> float:
+    """
+    Ask RAG for nearest documents for the claim (we use claim text as "query" and rely on RAG to embed).
+    Expects RAG /retrieve to optionally accept `text` fallback when an embedding is not provided.
+    Returns best support score (lower is better for L2, higher for cosine depending on RAG index); here we expect
+    RAG to return meta.score where lower is better (e.g., L2). We convert to a normalized support in [0,1].
+    """
+    try:
+        r = requests.post(f"{RAG_URL}/retrieve", json={"text": claim, "top_k": top_k}, timeout=5)
+        r.raise_for_status()
+        hits = r.json().get("hits", [])
+        if not hits:
+            return 0.0
+        # Best hit score extraction using heuristics:
+        # If RAG returns "score" where higher is better (cosine), use directly; else invert L2 distances.
+        scores = []
+        for h in hits:
+            s = h.get("score", None)
+            if s is None:
+                # try embedding distance -> assume none
+                continue
+            scores.append(float(s))
+        if not scores:
+            return 0.0
+        best = max(scores)
+        # Heuristic normalize: if RAG returns cosine (0..1) best is already good
+        # If best appears negative or >1, we clamp - keep simple: scale between 0..1
+        normalized = min(1.0, max(0.0, best))
+        return normalized
+    except Exception:
+        return 0.0
+
+def verify_response(response_text: str, min_support_ratio: float = 0.6) -> dict:
+    claims = split_into_claims(response_text)
+    if not claims:
+        return {"claims": [], "support_ratio": 0.0, "verdict": "no_claims"}
+    supports = []
+    for c in claims:
+        s = support_for_claim(c)
+        supports.append({"claim": c, "support": s})
+    # A claim is supported if normalized support >= SUPPORT_THRESHOLD
+    supported = [s for s in supports if s["support"] >= SUPPORT_THRESHOLD]
+    ratio = len(supported) / len(supports)
+    verdict = "supported" if ratio >= min_support_ratio else "hallucination"
+    return {"claims": supports, "supported_count": len(supported), "total_claims": len(supports), "support_ratio": ratio, "verdict": verdict}
+
+if __name__ == "__main__":
+    import sys, json
+    txt = sys.stdin.read() if not sys.stdin.isatty() else " ".join(sys.argv[1:])
+    print(json.dumps(verify_response(txt), indent=2))
+
