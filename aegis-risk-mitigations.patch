+#!/usr/bin/env python3
+"""
+Post-filter service that:
+ - Runs factuality verification on model outputs
+ - Applies simple rule-based post-filters (banlist, short-response, numeric-checks)
+ - Escalates to human-in-loop if verdict indicates hallucination or if postfilters trigger
+
+Endpoints:
+ - POST /filter  { "model": "...", "response": "...", "query": "...", "metadata": {...} }
+
+Escalation:
+ - On escalation, calls services/escalation/escalate.py::escalate_for_review
+"""
+from flask import Flask, request, jsonify
+import os, json
+from services.factuality.verifier import verify_response
+from services.escalation.escalate import escalate_for_review
+
+app = Flask(__name__)
+HUMAN_ESCALATION_MIN_SUPPORT = float(os.environ.get("HUMAN_ESCALATION_MIN_SUPPORT","0.6"))
+MAX_RESPONSE_LENGTH = int(os.environ.get("MAX_RESPONSE_LENGTH","10000"))
+BANLIST = set([w.strip().lower() for w in os.environ.get("POSTFILTER_BANLIST","").split(",") if w.strip()])
+
+def run_postfilters(response: str) -> list:
+    violations = []
+    if len(response) > MAX_RESPONSE_LENGTH:
+        violations.append("length_exceeded")
+    if BANLIST:
+        rlow = response.lower()
+        for b in BANLIST:
+            if b and b in rlow:
+                violations.append(f"banlist_{b}")
+    # numeric-check heuristic: if response claims numeric value but it's not numeric -> flag? (simple)
+    return violations
+
+@app.route("/filter", methods=["POST"])
+def filter_route():
+    body = request.get_json()
+    resp = body.get("response","")
+    query = body.get("query","")
+    model = body.get("model","")
+    meta = body.get("metadata",{})
+    post_violations = run_postfilters(resp)
+    fact = verify_response(resp, min_support_ratio=HUMAN_ESCALATION_MIN_SUPPORT)
+    escalate = False
+    reasons = []
+    if post_violations:
+        escalate = True
+        reasons += post_violations
+    if fact.get("verdict") == "hallucination":
+        escalate = True
+        reasons.append("factuality_fail")
+    if escalate:
+        ticket = escalate_for_review(model=model, query=query, response=resp, evidence=fact, reasons=reasons, metadata=meta)
+        return jsonify({"ok": False, "escalated": True, "reasons": reasons, "ticket": ticket}), 200
+    return jsonify({"ok": True, "escalated": False, "support": fact}), 200
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("POSTFILTER_PORT","8092")))
