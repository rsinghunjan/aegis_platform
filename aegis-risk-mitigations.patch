+#!/usr/bin/env python3
+"""
+Local enforcement utility: assert that a delegation manifest for an action exists and is M-of-N signed
+before allowing automated legal/finance actions.
+ - Leverages services/agent/multi_sign_verify.py
+ - Example usage: called by orchestrators before running finance/legal tools
+"""
+import os
+from services.agent.multi_sign_verify import verify
+
+DELEGATION_MANIFEST_URI = os.environ.get("DELEGATION_MANIFEST_URI","")
+DELEGATION_PUBKEYS = os.environ.get("DELEGATION_PUBKEYS","")
+DELEGATION_REQUIRED = int(os.environ.get("DELEGATION_REQUIRED","2"))
+
+def enforce():
+    if not DELEGATION_MANIFEST_URI or not DELEGATION_PUBKEYS:
+        return {"passed": False, "reason": "delegation_config_missing"}
+    pubkeys = [p.strip() for p in DELEGATION_PUBKEYS.split(",") if p.strip()]
+    return verify(DELEGATION_MANIFEST_URI, pubkeys, DELEGATION_REQUIRED)
+
+if __name__=="__main__":
+    import json
+    print(json.dumps(enforce(), indent=2))
+
