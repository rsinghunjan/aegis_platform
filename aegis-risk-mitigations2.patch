+#!/usr/bin/env python3
+"""
+Run adversarial prompts through the RAG + LLM + postfilter pipeline and record failures.
+ - Loads prompts from adversarial/prompts.txt
+ - For each prompt:
+    * create embedding via embedding endpoint (or text_to_embedding)
+    * call RAG compose_multimodal (if available) or RAG.retrieve
+    * call LLM proxy to generate response
+    * call postfilter / claim_extractor endpoint to compute support ratio
+    * if verdict == 'hallucination' or support ratio < threshold, record to failures
+ - Upload failures to remediation tracker (creates GitHub issue if configured)
+"""
+import os, requests, json, time
+
+LLM_PROXY = os.environ.get("LLM_PROXY_URL","http://llm-proxy:8083")
+RAG_COMPOSE = os.environ.get("RAG_COMPOSE_URL","http://rag:8086/compose_multimodal")
+CLAIM_VERIF = os.environ.get("CLAIM_SERVICE_URL","http://claim-service:8000/verify")
+REMEDIATION_WEBHOOK = os.environ.get("REMEDIATION_WEBHOOK","")
+THRESH = float(os.environ.get("ADVERSARIAL_THRESHOLD","0.6"))
+
+def run_prompt(prompt):
+    # get rag context
+    try:
+        emb = None
+        # call compose endpoint which can accept a text query (it may compute embedding server-side)
+        r = requests.post(RAG_COMPOSE, json={"query": prompt, "top_k": 5}, timeout=10)
+        r.raise_for_status()
+        context = r.json().get("context","")
+    except Exception:
+        context = ""
+    # call LLM proxy
+    payload = {"prompt": prompt + "\n\nContext:\n" + context, "max_tokens": 512}
+    r = requests.post(f"{LLM_PROXY.rstrip('/')}/v1/generate", json=payload, timeout=30)
+    r.raise_for_status()
+    resp_text = r.json().get("text") or r.text
+    # call claim verifier
+    v = requests.post(CLAIM_VERIF, json={"text": resp_text}, timeout=20).json()
+    return {"prompt":prompt, "response": resp_text, "verif": v}
+
+def post_failure(record):
+    print("Recording failure:", record.get("prompt")[:80])
+    if REMEDIATION_WEBHOOK:
+        try:
+            requests.post(REMEDIATION_WEBHOOK, json=record, timeout=5)
+        except Exception:
+            pass
+
+def main():
+    fails=[]
+    with open("adversarial/prompts.txt") as fh:
+        prompts=[l.strip() for l in fh if l.strip()]
+    for p in prompts:
+        try:
+            r = run_prompt(p)
+            ver = r["verif"]
+            ratio = float(ver.get("ratio",0.0))
+            if ver.get("verdict")=="hallucination" or ratio < THRESH:
+                r["flagged"]=True
+                fails.append(r)
+                post_failure(r)
+            else:
+                r["flagged"]=False
+        except Exception as e:
+            fails.append({"prompt":p, "error": str(e)})
+    if fails:
+        open("/tmp/adversarial_failures.json","w").write(json.dumps(fails, indent=2))
+        print("Failures written to /tmp/adversarial_failures.json")
+    else:
+        print("No adversarial failures detected")
+
+if __name__=="__main__":
+    main()
+
