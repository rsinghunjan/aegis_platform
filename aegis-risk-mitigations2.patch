+#!/usr/bin/env python3
+"""
+Runtime token budget enforcer for prompts: periodically scans MLflow prompt changes or prompt registry
+and alerts/creates issue if budgets exceed configured thresholds. Also exposes an HTTP endpoint to query current tenant token usage.
+"""
+import os, time, json, threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+import redis
+
+REDIS_URL = os.environ.get("REDIS_URL","redis://localhost:6379/0")
+BUDGET_THRESHOLD = int(os.environ.get("PROMPT_BUDGET_THRESHOLD", "1000000"))
+CHECK_INTERVAL = int(os.environ.get("PROMPT_BUDGET_CHECK_SECS", "3600"))
+GITHUB_REPO = os.environ.get("GITHUB_REPO","")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN","")
+
+r = redis.Redis.from_url(REDIS_URL)
+
+def scan_and_alert():
+    # example: scan Redis keys for 'tokens:tenant:*' sums and alert if above threshold
+    keys = r.keys("tokens:tenant:*")
+    for k in keys:
+        try:
+            v = int(r.get(k) or 0)
+            if v > BUDGET_THRESHOLD:
+                tenant = k.decode().split(":")[-1]
+                body = f"Tenant {tenant} exceeded token budget: {v} tokens"
+                create_issue(f"Budget alert: {tenant}", body)
+        except Exception:
+            continue
+
+def create_issue(title, body):
+    if not (GITHUB_REPO and GITHUB_TOKEN):
+        print("No GitHub configured; would create issue:", title)
+        return
+    import requests
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    hdr = {"Authorization": f"token {GITHUB_TOKEN}"}
+    data = {"title": title, "body": body, "labels": ["cost","alert"]}
+    requests.post(url, json=data, headers=hdr, timeout=10)
+
+class ReqHandler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        if self.path.startswith("/usage/"):
+            tenant = self.path.split("/usage/")[-1]
+            v = int(r.get(f"tokens:tenant:{tenant}") or 0)
+            self.send_response(200)
+            self.end_headers()
+            self.wfile.write(str(v).encode())
+        else:
+            self.send_response(404)
+            self.end_headers()
+
+def start_http():
+    server = HTTPServer(('0.0.0.0', 9102), ReqHandler)
+    server.serve_forever()
+
+if __name__=="__main__":
+    import threading
+    t = threading.Thread(target=start_http, daemon=True)
+    t.start()
+    while True:
+        scan_and_alert()
+        time.sleep(CHECK_INTERVAL)
+
