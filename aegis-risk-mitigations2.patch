+#!/usr/bin/env python3
+"""
+Enforce delegation (M-of-N) before executing high-risk actions.
+This script is intended to be called by orchestrators before executing sensitive tools.
+It will:
+ - check kill-switch vault flags
+ - check m-of-n approvals for the given action_id
+ - fail (exit non-zero) unless both pass
+"""
+import os, sys, json, subprocess
+from services.security.split_custody_checker import check_m_of_n
+
+FLAG_PATH = os.environ.get("FLAG_PATH","secret/data/aegis/flags")
+
+def vault_flag_enabled():
+    try:
+        out = subprocess.check_output(["vault","kv","get","-format=json", FLAG_PATH])
+        data = json.loads(out)
+        val = data["data"]["data"].get("signing_enabled","true")
+        return str(val).lower() in ("1","true","yes")
+    except Exception:
+        # Conservative: if we cannot read flag assume disabled
+        return False
+
+def main():
+    if len(sys.argv) < 2:
+        print("Usage: delegation_enforcer.py <action_id>")
+        sys.exit(2)
+    action_id = sys.argv[1]
+    if not vault_flag_enabled():
+        print("Automated signing/actions are currently DISABLED via kill-switch. Abort.")
+        sys.exit(3)
+    ok, details = check_m_of_n(action_id)
+    if not ok:
+        print("M-of-N requirement NOT satisfied for action:", action_id)
+        print(json.dumps(details, indent=2))
+        sys.exit(4)
+    print("Delegation verified. Proceeding.")
+    sys.exit(0)
+
+if __name__=="__main__":
+    main()
