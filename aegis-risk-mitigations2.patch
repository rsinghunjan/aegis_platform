+  echo "vault kv put failed; ensure VAULT_ADDR and VAULT_TOKEN are set and you have permissions"
+  exit 3
+}
+
+echo "Kill-switch updated. Services should read $FLAG_PATH to decide whether to proceed with automated signing/actions."
