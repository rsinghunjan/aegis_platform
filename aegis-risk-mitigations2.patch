+#!/usr/bin/env python3
+"""
+Require M-of-N signatures / approvals recorded in Vault before allowing sensitive actions.
+
+Assumes Vault kv entries under secret/data/aegis/m_of_n/<action_id> with keys:
+  - required: integer
+  - approvers: map of approver -> signature metadata (json)
+
+This helper provides `check_m_of_n(action_id)` -> (ok:bool, details:dict)
+"""
+import os, json, subprocess
+
+VAULT_BASE=${ 'VAULT_BASE' if False else 'VAULT_BASE' }  # placeholder, not used
+VAULT_PREFIX = os.environ.get("VAULT_MOFN_PREFIX","secret/data/aegis/m_of_n")
+
+def _vault_get(path):
+    try:
+        out = subprocess.check_output(["vault","kv","get","-format=json", path], stderr=subprocess.DEVNULL)
+        return json.loads(out)
+    except subprocess.CalledProcessError:
+        return None
+
+def check_m_of_n(action_id):
+    path = f"{VAULT_PREFIX}/{action_id}"
+    data = _vault_get(path)
+    if not data:
+        return False, {"reason":"no_manifest","path":path}
+    # Vault kv get JSON structure: {data:{data:{...}}}
+    try:
+        payload = data["data"]["data"]
+    except Exception:
+        return False, {"reason":"malformed_vault_entry","raw":data}
+    required = int(payload.get("required", 2))
+    approvers = payload.get("approvers", {})
+    count = len([k for k in approvers.keys() if approvers.get(k)])
+    ok = count >= required
+    return ok, {"required": required, "approver_count": count, "approvers": approvers}
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("Usage: split_custody_checker.py <action_id>")
+        raise SystemExit(2)
+    ok, d = check_m_of_n(sys.argv[1])
+    print("ok:", ok)
+    print(json.dumps(d, indent=2))
+
