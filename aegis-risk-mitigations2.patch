+#!/usr/bin/env python3
+"""
+Autoscale guard daemon:
+ - polls Prometheus for key signals (GPU utilization, pod count, queue lengths)
+ - if runaway conditions detected, writes a Kubernetes ConfigMap 'aegis-autoscale-guard' in namespace aegis
+   which downstream controllers/readers can consult to pause autoscaling or shrink warm-pool
+ - uses kubectl CLI to apply ConfigMap (operator must have kubeconfig)
+"""
+import os, time, requests, json, subprocess
+
+PROM_URL = os.environ.get("PROM_URL","http://prometheus-operated:9090")
+NAMESPACE = os.environ.get("AEGIS_NAMESPACE","aegis")
+GUARD_CM_NAME = os.environ.get("AUTOSCALE_GUARD_CM","aegis-autoscale-guard")
+GPU_UTIL_THRESHOLD = float(os.environ.get("GPU_UTIL_THRESHOLD","0.95"))
+POLL_INTERVAL = int(os.environ.get("AUTOSCALE_POLL_SECS","30"))
+
+def query_prom(query):
+    r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": query}, timeout=10)
+    r.raise_for_status()
+    data = r.json()
+    return data.get("data",{}).get("result",[])
+
+def check_runaway():
+    # example: check average GPU utilization across last 5m
+    try:
+        res = query_prom('avg_over_time(nvidia_gpu_utilization_gpu[5m])')
+        if res:
+            val = float(res[0]["value"][1])
+            return val >= GPU_UTIL_THRESHOLD, val
+    except Exception:
+        return False, 0.0
+    return False, 0.0
+
+def apply_guard(reason, value):
+    cm = {
+        "apiVersion": "v1",
+        "kind": "ConfigMap",
+        "metadata": {"name": GUARD_CM_NAME, "namespace": NAMESPACE},
+        "data": {"guard": "true", "reason": reason, "value": str(value), "ts": str(int(time.time()))}
+    }
+    fn = "/tmp/aegis_autoscale_guard.yaml"
+    with open(fn,"w") as fh:
+        fh.write(json.dumps(cm))
+    subprocess.check_call(["kubectl","apply","-f",fn])
+    print("Applied autoscale guard:", reason, value)
+
+def clear_guard():
+    subprocess.call(["kubectl","delete","configmap", GUARD_CM_NAME, "-n", NAMESPACE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    print("Cleared autoscale guard")
+
+def main():
+    while True:
+        try:
+            runaway, val = check_runaway()
+            if runaway:
+                apply_guard("gpu_util_runaway", val)
+            else:
+                clear_guard()
+        except Exception as e:
+            print("Autoscale guard error:", e)
+        time.sleep(POLL_INTERVAL)
+
+if __name__=="__main__":
+    main()
+
