+"""
+Monitor warm-pool utilization and recommend/act on warm-pool sizing.
+ - reads warm pool metrics from Prometheus
+ - writes recommended size to ConfigMap aegis-warm-pool-config
+ - optional: patch deployment replica count
+"""
+import os, time, requests, json, subprocess
+
+PROM_URL = os.environ.get("PROM_URL","http://prometheus-operated:9090")
+NAMESPACE = os.environ.get("AEGIS_NAMESPACE","aegis")
+CM_NAME = os.environ.get("WARM_POOL_CM","aegis-warm-pool-config")
+POLL= int(os.environ.get("WARM_POOL_POLL_SECS","60"))
+
+def query_prom(query):
+    r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": query}, timeout=10)
+    r.raise_for_status()
+    return r.json().get("data",{}).get("result",[])
+
+def recommend_size():
+    # placeholder metric: avg batch size over last minute
+    try:
+        res = query_prom('avg_over_time(aegis_warm_pool_batch_size[1m])')
+        if res:
+            val = float(res[0]["value"][1])
+            # simple heuristic: recommend ceil(val / 4) workers
+            import math
+            return max(1, int(math.ceil(val/4.0)))
+    except Exception:
+        return 2
+
+def apply_config(size):
+    cm = {
+        "apiVersion": "v1",
+        "kind": "ConfigMap",
+        "metadata": {"name": CM_NAME, "namespace": NAMESPACE},
+        "data": {"recommended_warm_pool_size": str(size)}
+    }
+    fn="/tmp/warm_pool_cfg.json"
+    with open(fn,"w") as fh: fh.write(json.dumps(cm))
+    subprocess.check_call(["kubectl","apply","-f", fn])
+    print("Wrote warm-pool recommended size:", size)
+
+def main():
+    while True:
+        try:
+            size = recommend_size()
+            apply_config(size)
+        except Exception as e:
+            print("Warm pool monitor error:", e)
+        time.sleep(POLL)
+
+if __name__=="__main__":
+    main()
