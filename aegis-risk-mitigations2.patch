+  exit 2
+fi
+
+VALUE="true"
+if [[ "$ACTION" == "disable" ]]; then
+  VALUE="false"
+fi
+
+echo "Setting signing_enabled=$VALUE at Vault path $FLAG_PATH (reason: $REASON)"
