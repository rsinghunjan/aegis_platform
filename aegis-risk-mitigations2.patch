+#!/usr/bin/env python3
+"""
+Simple per-tenant quota middleware for LLM proxy.
+Integrates with Redis to track token usage and per-tenant quotas.
+
+Usage:
+ - Call check_and_consume(tenant_id, tokens) before forwarding request to LLM backend.
+ - Configure REDIS_URL and DEFAULT_QUOTA_TOKENS (per window) via env.
+"""
+import os, time, redis
+
+REDIS_URL = os.environ.get("REDIS_URL","redis://localhost:6379/0")
+WINDOW_SECONDS = int(os.environ.get("QUOTA_WINDOW_SECONDS","3600"))
+DEFAULT_QUOTA = int(os.environ.get("DEFAULT_QUOTA_TOKENS","100000"))  # tokens per window
+
+r = redis.Redis.from_url(REDIS_URL)
+
+def _key(tenant_id):
+    return f"aegis:quota:{tenant_id}:{int(time.time()//WINDOW_SECONDS)}"
+
+def check_and_consume(tenant_id, tokens):
+    """
+    Atomically check and consume tokens. Returns (ok:bool, remaining:int)
+    """
+    k = _key(tenant_id)
+    pipe = r.pipeline()
+    try:
+        pipe.setnx(k, DEFAULT_QUOTA)
+        pipe.expire(k, WINDOW_SECONDS+10)
+        pipe.get(k)
+        # execute
+        res = pipe.execute()
+        current = int(res[-1])
+    except Exception:
+        # if Redis not reachable, be conservative: deny
+        return False, 0
+    if current < tokens:
+        return False, current
+    # decrement
+    try:
+        new = r.decrby(k, tokens)
+        return True, int(new)
+    except Exception:
+        return False, int(current)
+
+if __name__=="__main__":
+    import sys
+    tenant = sys.argv[1] if len(sys.argv)>1 else "default"
+    tok = int(sys.argv[2]) if len(sys.argv)>2 else 100
+    ok, rem = check_and_consume(tenant, tok)
+    print("ok:", ok, "remaining:", rem)
+
