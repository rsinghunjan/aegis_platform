+          IMAGE="${{ inputs.image_tag }}"
+          docker build -f ops/hw/inferentia/Dockerfile.neuron -t "$IMAGE" .
+      - name: Run smoke tests on attached hardware
+        run: |
+          docker run --rm --privileged "$IMAGE" /bin/bash -c "python3 ops/hw/ci/hardware_smoke_test.sh || exit 1"
+      - name: Push image to internal registry
+        run: |
+          docker push "$IMAGE"
+      - name: Cosign sign using KMS
+        env:
+          COSIGN_KMS_URI: ${{ secrets.COSIGN_KMS_URI }}
+        run: |
+          cosign sign --key $COSIGN_KMS_URI "$IMAGE"
+          cosign verify --key $COSIGN_KMS_URI "$IMAGE"
