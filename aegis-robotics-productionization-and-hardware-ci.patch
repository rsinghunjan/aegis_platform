+#!/usr/bin/env python3
+"""
+Measure jitter and validate against target SLO.
+Writes results to /tmp/rt_jitter_result.json and returns non-zero exit if SLO violated.
+"""
+import json, time, statistics, sys
+from ops.sdk.evidence_sdk import record_manifest
+
+def measure(freq=1000, iterations=5000):
+    period = 1.0 / freq
+    ts = []
+    next_t = time.perf_counter()
+    for _ in range(iterations):
+        next_t += period
+        now = time.perf_counter()
+        sleep = next_t - now
+        if sleep > 0:
+            time.sleep(sleep)
+        actual = time.perf_counter()
+        ts.append(actual)
+    diffs = [ts[i] - ts[i - 1] for i in range(1, len(ts))]
+    return {
+        "freq": freq,
+        "iters": iterations,
+        "p50_s": statistics.median(diffs),
+        "p95_s": sorted(diffs)[int(0.95 * len(diffs)) - 1],
+        "p99_s": sorted(diffs)[int(0.99 * len(diffs)) - 1],
+        "mean_s": statistics.mean(diffs),
+        "stdev_s": statistics.stdev(diffs) if len(diffs) > 1 else 0.0
+    }
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--freq", type=int, default=1000)
+    p.add_argument("--iters", type=int, default=5000)
+    p.add_argument("--p99-slo-ms", type=float, default=0.2)
+    args = p.parse_args()
+    stats = measure(freq=args.freq, iterations=args.iters)
+    stats["p99_ms"] = stats["p99_s"] * 1000.0
+    with open("/tmp/rt_jitter_result.json", "w") as fh:
+        json.dump(stats, fh, indent=2)
+    try:
+        record_manifest("rt_jitter_result", stats)
+    except Exception:
+        pass
+    print(json.dumps(stats, indent=2))
+    if stats["p99_ms"] > args.p99_slo_ms:
+        print(f"p99 {stats['p99_ms']}ms exceeds SLO {args.p99_slo_ms}ms", file=sys.stderr)
+        sys.exit(2)
+    sys.exit(0)
+
