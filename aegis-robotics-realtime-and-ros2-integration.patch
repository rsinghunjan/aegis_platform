+#!/usr/bin/env python3
+"""
+Low-latency single-sample inference service.
+ - Provides a small FastAPI endpoint /infer_low_latency that bypasses the batching queue
+ - Intended for control-related inference where 1-sample, low-latency response is required
+ - Ensure this service runs on an isolated CPU/GPU and uses detect_backend() for direct calls
+"""
+import os
+import asyncio
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from ops.hw.backend_adapters import detect_backend
+
+app = FastAPI(title="Aegis Low-Latency Inference")
+
+class InferRequest(BaseModel):
+    prompt: str
+    max_tokens: int = 16
+
+@app.post("/infer_low_latency")
+async def infer(req: InferRequest):
+    backend = detect_backend()
+    # For greatest determinism, run in threadpool / executor pinned to CPU affinity if needed
+    try:
+        res = await backend.generate_batch([req.prompt], req.max_tokens)
+        return {"result": res[0]}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
+
+if __name__=="__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("LOW_LATENCY_PORT", "50055")), workers=1)
+
