+#!/usr/bin/env bash
+set -euo pipefail
+if [ "$(id -u)" -ne 0 ]; then
+  echo "Please run as root (or with sudo)"
+  exit 2
+fi
+NIC=${1:-eth0}
+echo "Disabling irqbalance (if running)"
+systemctl stop irqbalance.service 2>/dev/null || true
+systemctl disable irqbalance.service 2>/dev/null || true
+
+echo "Show current IRQs for $NIC"
+grep $NIC /proc/interrupts || true
+
+echo "Set NIC ring sizes (rx/tx) if supported"
+if command -v ethtool >/dev/null 2>&1; then
+  ethtool -G $NIC rx 4096 tx 4096 || true
+  ethtool -C $NIC rx-usecs 5 rx-frames 64 || true
+fi
+
+echo "Pin NIC IRQs to CPU 2 (example). Adjust CPU mask per your isolated CPUs."
+CPU_MASK="4"  # CPU bitmask (1<<2)
+for irq in $(grep $NIC /proc/interrupts | awk '{print $1}' | sed 's/://'); do
+  echo "$CPU_MASK" > /proc/irq/$irq/smp_affinity || true
+done
+
+echo "Enable busy-poll to reduce latency for sockets (tunable)"
+sysctl -w net.core.busy_poll=50
+sysctl -w net.core.busy_read=50
+
+echo "Completed NIC & IRQ tuning suggestions. Reboot recommended after kernel changes."
+
