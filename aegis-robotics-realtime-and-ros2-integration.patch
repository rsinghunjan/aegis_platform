+#!/usr/bin/env python3
+"""
+Micro-jitter/stability test for real-time loop.
+ - Measures loop period jitter for a target frequency and reports statistics.
+ - Outputs JSON summary and records an evidence manifest (best-effort).
+"""
+import time, statistics, json
+from ops.sdk.evidence_sdk import record_manifest
+
+def measure(freq=1000, iterations=10000):
+    period = 1.0 / freq
+    ts = []
+    next_t = time.perf_counter()
+    for i in range(iterations):
+        next_t += period
+        now = time.perf_counter()
+        sleep = next_t - now
+        if sleep > 0:
+            time.sleep(sleep)
+        actual = time.perf_counter()
+        ts.append(actual)
+    diffs = [ (ts[i]-ts[i-1]) for i in range(1,len(ts)) ]
+    stats = {
+        "freq": freq,
+        "iterations": iterations,
+        "p50_s": statistics.median(diffs),
+        "p95_s": sorted(diffs)[int(0.95*len(diffs))-1],
+        "p99_s": sorted(diffs)[int(0.99*len(diffs))-1],
+        "mean_s": statistics.mean(diffs),
+        "stdev_s": statistics.stdev(diffs) if len(diffs)>1 else 0.0
+    }
+    with open("/tmp/jitter_test_summary.json","w") as fh:
+        json.dump(stats, fh, indent=2)
+    try:
+        record_manifest("jitter_test", stats)
+    except Exception:
+        pass
+    print(json.dumps(stats, indent=2))
+    return stats
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--freq", type=int, default=1000)
+    p.add_argument("--iters", type=int, default=5000)
+    args = p.parse_args()
+    measure(freq=args.freq, iterations=args.iters)
+
