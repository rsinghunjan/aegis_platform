+// Simple POSIX real-time controller example
+// - Runs a hard real-time loop at a target frequency using SCHED_FIFO
+// - Receives desired torques/commands via UDP (trusted network/local loopback) and writes actuator outputs via UDP
+// - Intended as a reference/harness for on-robot real-time process (not a production controller)
+//
+// Build with: mkdir build && cd build && cmake .. && make
+
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sched.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <iostream>
+#include <thread>
+#include <vector>
+
+static constexpr int RECV_PORT = 15000;
+static constexpr int SEND_PORT = 15001;
+static constexpr const char* SEND_ADDR = "127.0.0.1";
+
+void set_realtime() {
+  struct sched_param p;
+  p.sched_priority = 80;
+  if (sched_setscheduler(0, SCHED_FIFO, &p) != 0) {
+    perror("sched_setscheduler");
+    std::cerr << "Failed to set SCHED_FIFO (requires CAP_SYS_NICE). Continue as best-effort.\n";
+  }
+  if (mlockall(MCL_CURRENT | MCL_FUTURE) != 0) {
+    perror("mlockall");
+  }
+}
+
+int make_udp_socket(int port, bool bind_socket=true) {
+  int fd = socket(AF_INET, SOCK_DGRAM, 0);
+  if (fd < 0) { perror("socket"); return -1; }
+  int flags = fcntl(fd, F_GETFL, 0);
+  fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+  if (bind_socket) {
+    struct sockaddr_in addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = INADDR_ANY;
+    addr.sin_port = htons(port);
+    if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
+      perror("bind");
+      close(fd);
+      return -1;
+    }
+  }
+  return fd;
+}
+
+int main(int argc, char** argv) {
+  std::cout << "RT controller starting...\n";
+  set_realtime();
+  const int frequency = 1000; // Hz typical servo loop
+  const std::chrono::nanoseconds period_ns((long)(1e9 / frequency));
+
+  int recv_fd = make_udp_socket(RECV_PORT);
+  if (recv_fd < 0) return 2;
+  int send_fd = socket(AF_INET, SOCK_DGRAM, 0);
+  struct sockaddr_in send_addr;
+  memset(&send_addr, 0, sizeof(send_addr));
+  send_addr.sin_family = AF_INET;
+  inet_pton(AF_INET, SEND_ADDR, &send_addr.sin_addr);
+  send_addr.sin_port = htons(SEND_PORT);
+
+  std::vector<double> desired(12, 0.0);
+  std::vector<double> command(12, 0.0);
+
+  auto next = std::chrono::high_resolution_clock::now() + period_ns;
+  while (true) {
+    // recv desired torques (best-effort non-blocking)
+    char buf[1024];
+    ssize_t n = recv(recv_fd, buf, sizeof(buf), 0);
+    if (n > 0) {
+      // very simple parse: comma-separated doubles
+      std::string s(buf, buf + n);
+      size_t i = 0;
+      size_t pos = 0;
+      while (pos < s.size() && i < desired.size()) {
+        size_t comma = s.find(',', pos);
+        std::string token = (comma==std::string::npos) ? s.substr(pos) : s.substr(pos, comma-pos);
+        try {
+          desired[i++] = std::stod(token);
+        } catch (...) { }
+        if (comma==std::string::npos) break;
+        pos = comma+1;
+      }
+    }
+
+    // simplistic control law: command = desired (pass-through) but could call MPC or low-level controller
+    for (size_t i=0;i<command.size();++i) command[i] = desired[i];
+
+    // send command back (best-effort)
+    std::string out;
+    for (size_t i=0;i<command.size();++i) {
+      if (i) out.push_back(',');
+      out += std::to_string(command[i]);
+    }
+    sendto(send_fd, out.data(), out.size(), 0, (struct sockaddr*)&send_addr, sizeof(send_addr));
+
+    // sleep until next period using busy-wait + nanosleep fallback for best jitter characteristics
+    std::this_thread::sleep_until(next);
+    next += period_ns;
+  }
+
+  close(recv_fd);
+  close(send_fd);
+  return 0;
+}
+
