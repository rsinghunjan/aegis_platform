+"""
+Run a simple PyBullet episode and record trajectories to disk / MLflow.
+Useful as a local sim-to-real pipeline prototype.
+"""
+import argparse
+import time
+import json
+try:
+    import pybullet as p
+    import pybullet_data
+except Exception:
+    p = None
+
+def run_episode(steps=500, out="/tmp/episode.json"):
+    if p is None:
+        raise RuntimeError("pybullet not installed")
+    p.connect(p.DIRECT)
+    p.setAdditionalSearchPath(pybullet_data.getDataPath())
+    plane = p.loadURDF("plane.urdf")
+    kuka = p.loadURDF("kuka_iiwa/model.urdf", [0,0,0])
+    traj = []
+    for t in range(steps):
+        # simple random action
+        p.stepSimulation()
+        pos, orn = p.getBasePositionAndOrientation(kuka)
+        traj.append({"t": t, "pos": pos, "orn": orn})
+    p.disconnect()
+    with open(out, "w") as fh:
+        json.dump(traj, fh)
+    print("Wrote", out)
+
+if __name__=="__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--steps", type=int, default=500)
+    ap.add_argument("--out", default="/tmp/episode.json")
+    args = ap.parse_args()
+    run_episode(args.steps, args.out)
