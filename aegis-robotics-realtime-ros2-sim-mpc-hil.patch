+"""
+Capture camera frames via OpenCV, timestamp them with system clock or PTP and publish via UDP with metadata.
+Example for building low-latency sensor capture pipelines.
+"""
+import cv2
+import time
+import json
+import socket
+
+def capture_loop(device=0, out_host="127.0.0.1", out_port=16000):
+    cap = cv2.VideoCapture(device)
+    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    while True:
+        ret, frame = cap.read()
+        if not ret:
+            break
+        ts = time.time_ns()  # prefer PTP-synced systemclock if available
+        # encode JPEG to reduce packet sizes
+        _, enc = cv2.imencode('.jpg', frame, [int(cv2.IMWRITE_JPEG_QUALITY), 80])
+        payload_meta = json.dumps({"ts_ns": ts, "shape": frame.shape}).encode('utf-8')
+        # send meta then payload (simple protocol; replace with RTP/RTPS in production)
+        sock.sendto(payload_meta, (out_host, out_port))
+        sock.sendto(enc.tobytes(), (out_host, out_port))
+
+if __name__=="__main__":
+    capture_loop()
+
