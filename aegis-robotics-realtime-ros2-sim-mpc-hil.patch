+"""
+Lightweight ROS2 <-> HTTP bridge for high-level commands.
+ - Receives JSON HTTP POST /command with {"topic": "...", "msg": {...}} and publishes to ROS2 topic
+ - Subscribes to specified ROS2 topics and exposes a simple websocket endpoint for low-latency telemetry
+
+This is a high-level bridge. Use it as a development shim to connect Aegis planners (gRPC/HTTP) to ROS2 systems.
+"""
+import asyncio
+import json
+import os
+from fastapi import FastAPI, HTTPException, WebSocket
+import uvicorn
+
+try:
+    import rclpy
+    from rclpy.node import Node
+    from std_msgs.msg import String
+    ROS2_AVAILABLE = True
+except Exception:
+    ROS2_AVAILABLE = False
+
+app = FastAPI()
+
+class RosNode(Node):
+    def __init__(self):
+        super().__init__('aegis_bridge_node')
+        self.publishers = {}
+        self.subscriptions = {}
+
+    def publish(self, topic, data):
+        if topic not in self.publishers:
+            self.publishers[topic] = self.create_publisher(String, topic, 10)
+        msg = String()
+        msg.data = json.dumps(data)
+        self.publishers[topic].publish(msg)
+
+    def add_subscription(self, topic, callback):
+        if topic in self.subscriptions:
+            return
+        self.subscriptions[topic] = self.create_subscription(String, topic, lambda msg: callback(json.loads(msg.data)), 10)
+
+bridge_node = None
+ws_connections = []
+
+@app.on_event("startup")
+async def startup_event():
+    global bridge_node
+    if ROS2_AVAILABLE:
+        rclpy.init()
+        bridge_node = RosNode()
+        loop = asyncio.get_event_loop()
+        loop.create_task(_spin_ros())
+    else:
+        print("ROS2 not available in this environment. Bridge will operate in limited mode.")
+
+async def _spin_ros():
+    while rclpy.ok():
+        rclpy.spin_once(bridge_node, timeout_sec=0.01)
+        await asyncio.sleep(0.001)
+
+@app.post("/command")
+async def send_command(payload: dict):
+    topic = payload.get("topic")
+    msg = payload.get("msg")
+    if not topic or msg is None:
+        raise HTTPException(status_code=400, detail="topic and msg required")
+    if ROS2_AVAILABLE and bridge_node:
+        bridge_node.publish(topic, msg)
+    else:
+        # fallback: write to a local UDP port that on-robot real-time controller can listen to
+        import socket
+        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        s.sendto(json.dumps(msg).encode('utf-8'), ('127.0.0.1', 15000))
+    return {"ok": True}
+
+@app.websocket("/telemetry")
+async def telemetry_ws(ws: WebSocket):
+    await ws.accept()
+    ws_connections.append(ws)
+    try:
+        while True:
+            await ws.receive_text()  # simple ping to keep connection
+    except Exception:
+        pass
+    finally:
+        ws_connections.remove(ws)
+
+def ros_topic_callback(data):
+    # broadcast to websockets
+    for ws in list(ws_connections):
+        try:
+            asyncio.create_task(ws.send_text(json.dumps(data)))
+        except Exception:
+            pass
+
+@app.post("/subscribe")
+async def subscribe_topic(payload: dict):
+    topic = payload.get("topic")
+    if not topic:
+        raise HTTPException(status_code=400, detail="topic required")
+    if ROS2_AVAILABLE and bridge_node:
+        bridge_node.add_subscription(topic, ros_topic_callback)
+    return {"ok": True, "topic": topic}
+
+if __name__ == "__main__":
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("ROS2_BRIDGE_PORT", 8080)))
+
