+"""
+HIL fault injector for testing controllers.
+ - Connects to real-time controller via UDP and injects sensor faults or packet loss patterns.
+ - Records evidence manifest for each injected fault.
+"""
+import argparse
+import socket
+import time
+import random
+from ops.sdk.evidence_sdk import record_manifest
+
+def inject_fault(target_host="127.0.0.1", target_port=15000, mode="drop", duration=5.0):
+    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    # simple: send special messages the controller understands as fault commands
+    payload = {"fault": mode, "duration": duration}
+    s.sendto(str(payload).encode('utf-8'), (target_host, target_port))
+    record_manifest("hil_fault_injected", {"target": f"{target_host}:{target_port}", "mode": mode, "duration": duration})
+    print("Injected", payload)
+
+if __name__=="__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--mode", choices=["drop","noise","delay"], default="drop")
+    ap.add_argument("--duration", type=float, default=5.0)
+    args = ap.parse_args()
+    inject_fault(mode=args.mode, duration=args.duration)
