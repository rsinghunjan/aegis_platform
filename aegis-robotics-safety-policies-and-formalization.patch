+#!/usr/bin/env python3
+"""
+Adapter updated to consult OPA policy and approval service before dispatching actions.
+ - Queries OPA (local endpoint) for decision
+ - If OPA returns approval required, calls the Approval service to request approval and polls for result
+ - If allowed, dispatches to ros2 bridge or RT controller
+"""
+import os, json, time, requests
+from ops.agents.action_safety_filter import evaluate
+from ops.sdk.evidence_sdk import record_manifest
+
+OPA_URL = os.environ.get("OPA_URL", "http://localhost:8181/v1/data/aegis/robotics/safety/decision")
+APPROVAL_URL = os.environ.get("APPROVAL_URL", "http://localhost:8089")
+
+def query_opa(action, context):
+    payload = {"input": {"action": action, "context": context}}
+    try:
+        r = requests.post(OPA_URL, json=payload, timeout=5)
+        r.raise_for_status()
+        return r.json().get("result")
+    except Exception as e:
+        return None
+
+def request_approval(action, context, requested_by="agent"):
+    try:
+        r = requests.post(f"{APPROVAL_URL}/request_approval", json={"action":action,"context":context,"requested_by":requested_by}, timeout=5)
+        r.raise_for_status()
+        return r.json()["approval_id"]
+    except Exception:
+        return None
+
+def poll_approval(approval_id, timeout=300, poll_interval=5):
+    start = time.time()
+    while time.time() - start < timeout:
+        try:
+            r = requests.get(f"{APPROVAL_URL}/status/{approval_id}", timeout=5)
+            r.raise_for_status()
+            s = r.json()
+            if s.get("state") in ("approved","denied"):
+                return s
+        except Exception:
+            pass
+        time.sleep(poll_interval)
+    return {"state":"timeout"}
+
+def send_to_ros2(action_topic, payload):
+    bridge_url = os.environ.get("ROS2_BRIDGE_URL", "http://localhost:8080/command")
+    try:
+        r = requests.post(bridge_url, json={"topic": action_topic, "msg": payload}, timeout=5)
+        return r.status_code == 200
+    except Exception:
+        # UDP fallback for local RT controller
+        import socket
+        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        s.sendto(json.dumps(payload).encode('utf-8'), ('127.0.0.1',15000))
+        return True
+
+def adapter_handle(action_topic, action_payload, context=None, bounds=None):
+    # 0) local safety filter heuristics
+    sf = evaluate(action_payload, context or {}, bounds_config=bounds)
+    if sf["decision"] == "deny":
+        record_manifest("adapter_reject", {"topic": action_topic, "reasons": sf["reasons"]})
+        return {"ok": False, "reasons": sf["reasons"]}
+
+    # 1) ask OPA policy
+    opa_res = query_opa(action_payload, context or {})
+    if opa_res is None:
+        # conservative: require approval if OPA not reachable
+        record_manifest("adapter_opa_error", {"topic": action_topic})
+        return {"ok": False, "reasons": ["opa_unreachable"]}
+
+    mode = opa_res.get("mode")
+    reason = opa_res.get("reason")
+    if mode == "deny":
+        record_manifest("adapter_policy_deny", {"topic": action_topic, "reason": reason})
+        return {"ok": False, "reasons": [reason]}
+    if mode == "approval":
+        # request human approval
+        aid = request_approval(action_payload, context or {}, requested_by="agent")
+        if not aid:
+            record_manifest("adapter_approval_request_failed", {"topic": action_topic})
+            return {"ok": False, "reasons": ["approval_request_failed"]}
+        record_manifest("adapter_approval_requested", {"approval_id": aid, "topic": action_topic})
+        status = poll_approval(aid, timeout=300)
+        if status.get("state") != "approved":
+            record_manifest("adapter_approval_denied", {"approval_id": aid, "topic": action_topic, "status": status})
+            return {"ok": False, "reasons": ["approval_denied_or_timeout"]}
+        # proceed after approval
+        record_manifest("adapter_approval_granted", {"approval_id": aid, "topic": action_topic})
+
+    # 2) dispatch
+    ok = send_to_ros2(action_topic, action_payload)
+    record_manifest("adapter_dispatch", {"topic": action_topic, "ok": ok})
+    return {"ok": ok, "reasons": []}
+
