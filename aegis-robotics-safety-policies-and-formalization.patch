+#!/usr/bin/env python3
+"""
+Extended safety filter:
+ - Integrated perceptual human-detection confidence check (stubbed)
+ - Returns decision: allow|deny|approval along with reasons
+ - Records evidence at each decision
+"""
+from ops.sdk.evidence_sdk import record_manifest
+import json, os
+
+def perceptual_human_confidence(perception_context):
+    # Stub: integrate real human detector that returns confidence [0..1]
+    # Example perception_context: {"human_detected": True, "confidence": 0.92, "distance_m": 1.5}
+    return perception_context.get("confidence", 0.0) if perception_context else 0.0
+
+def action_bounds_check(action, bounds):
+    # Numeric bounds check; returns True if within bounds
+    for k,v in action.get("params", {}).items():
+        if k in bounds:
+            minv = bounds[k].get("min", -1e9)
+            maxv = bounds[k].get("max", 1e9)
+            try:
+                # support lists
+                if isinstance(v, list):
+                    for x in v:
+                        if x < minv or x > maxv:
+                            return False, f"{k} out_of_bounds"
+                else:
+                    if v < minv or v > maxv:
+                        return False, f"{k} out_of_bounds"
+            except Exception:
+                return False, f"{k} invalid_value"
+    return True, "ok"
+
+def evaluate(action, context, bounds_config=None):
+    """
+    Returns: {"decision": "allow|deny|approval", "reasons": [...], "confidence": float}
+    """
+    reasons = []
+    # 1) Perception-based human risk
+    human_conf = perceptual_human_confidence(context.get("perception") if context else None)
+    if context and context.get("human_present") and human_conf > 0.95 and context.get("human_distance_m", 10) < 0.5:
+        # high risk when very close to human
+        reasons.append("human_too_close")
+        record_manifest("safety_decision", {"action": action, "decision": "deny", "reasons": reasons})
+        return {"decision":"deny","reasons":reasons,"confidence":human_conf}
+
+    # 2) Bounds checks
+    if bounds_config:
+        ok, msg = action_bounds_check(action, bounds_config)
+        if not ok:
+            reasons.append(msg)
+            record_manifest("safety_decision", {"action": action, "decision": "deny", "reasons": reasons})
+            return {"decision":"deny","reasons":reasons,"confidence":human_conf}
+
+    # 3) Risk model heuristics: use provided estimated_risk
+    risk = action.get("estimated_risk", 0.0)
+    if context and context.get("human_present"):
+        if risk >= 0.1:
+            reasons.append(f"risk_high:{risk}")
+            record_manifest("safety_decision", {"action": action, "decision": "deny", "reasons": reasons})
+            return {"decision":"deny","reasons":reasons,"confidence":human_conf}
+        if risk >= 0.01:
+            reasons.append(f"risk_medium:{risk}")
+            record_manifest("safety_decision", {"action": action, "decision": "approval", "reasons": reasons})
+            return {"decision":"approval","reasons":reasons,"confidence":human_conf}
+
+    # default allow
+    record_manifest("safety_decision", {"action": action, "decision": "allow", "reasons": reasons})
+    return {"decision":"allow","reasons":reasons,"confidence":human_conf}
+
