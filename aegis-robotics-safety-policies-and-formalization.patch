+#!/usr/bin/env python3
+"""
+Simple Approval Service for human-in-the-loop decisions.
+ - Exposes /request_approval -> returns approval_id, records manifest, and waits for operator to approve via /approve
+ - On approval, produces a signed approval artifact using cosign KMS (operator must set COSIGN_KMS_URI)
+ - For audit, approvals and reasons are recorded via evidence_sdk
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import uuid, os, json, subprocess, threading, time
+from typing import Dict
+
+app = FastAPI(title="Aegis Approval Service")
+STORAGE = "/tmp/aegis_approvals"
+os.makedirs(STORAGE, exist_ok=True)
+
+class ApprovalRequest(BaseModel):
+    action: Dict
+    context: Dict
+    requested_by: str = "unknown"
+
+def record_manifest(payload):
+    try:
+        from ops.sdk.evidence_sdk import record_manifest as _r
+        _r("approval_event", payload)
+    except Exception:
+        pass
+
+@app.post("/request_approval")
+def request_approval(req: ApprovalRequest):
+    aid = str(uuid.uuid4())
+    obj = {"id": aid, "action": req.action, "context": req.context, "requested_by": req.requested_by, "state": "pending", "created": time.time()}
+    path = os.path.join(STORAGE, f"{aid}.json")
+    with open(path, "w") as fh:
+        json.dump(obj, fh)
+    record_manifest({"event":"approval_requested","id":aid,"action":req.action})
+    return {"approval_id": aid, "status": "pending"}
+
+@app.post("/approve/{approval_id}")
+def approve(approval_id: str, approver: Dict):
+    path = os.path.join(STORAGE, f"{approval_id}.json")
+    if not os.path.exists(path):
+        raise HTTPException(status_code=404, detail="approval not found")
+    obj = json.load(open(path))
+    if obj.get("state") != "pending":
+        raise HTTPException(status_code=400, detail="already decided")
+    obj["state"] = "approved"
+    obj["approver"] = approver
+    obj["approved_at"] = time.time()
+    # persist
+    with open(path, "w") as fh:
+        json.dump(obj, fh)
+    # create an approval artifact and sign with cosign KMS (best-effort)
+    artifact = path + ".approval.json"
+    with open(artifact, "w") as fh:
+        json.dump(obj, fh)
+    kms = os.environ.get("COSIGN_KMS_URI")
+    sig_path = artifact + ".sig"
+    if kms:
+        try:
+            subprocess.check_call(["cosign", "sign", "--key", kms, artifact])
+        except Exception:
+            # don't fail approvals if signing unavailable; but record manifest
+            pass
+    record_manifest({"event":"approval_granted","id":approval_id,"approver":approver})
+    return {"approval_id": approval_id, "state": "approved"}
+
+@app.post("/deny/{approval_id}")
+def deny(approval_id: str, approver: Dict):
+    path = os.path.join(STORAGE, f"{approval_id}.json")
+    if not os.path.exists(path):
+        raise HTTPException(status_code=404, detail="approval not found")
+    obj = json.load(open(path))
+    obj["state"] = "denied"
+    obj["approver"] = approver
+    obj["approved_at"] = time.time()
+    with open(path, "w") as fh:
+        json.dump(obj, fh)
+    record_manifest({"event":"approval_denied","id":approval_id})
+    return {"approval_id": approval_id, "state": "denied"}
+
+@app.get("/status/{approval_id}")
+def status(approval_id: str):
+    path = os.path.join(STORAGE, f"{approval_id}.json")
+    if not os.path.exists(path):
+        raise HTTPException(status_code=404, detail="approval not found")
+    return json.load(open(path))
+
+if __name__=="__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("APPROVAL_PORT", "8089")))
+
