+#!/usr/bin/env python3
+"""
+Runtime monitor extended:
+ - On invariant violation triggers hardware E-STOP hook (HTTP / system command)
+ - Records evidence and emits an alert
+"""
+import time, json, requests
+from ops.sdk.evidence_sdk import record_manifest
+
+E_STOP_ENDPOINT = None  # e.g., http://localhost:8090/estop or system command via ENV
+E_STOP_CMD = None
+
+def set_estop(endpoint=None, cmd=None):
+    global E_STOP_ENDPOINT, E_STOP_CMD
+    E_STOP_ENDPOINT = endpoint
+    E_STOP_CMD = cmd
+
+def trigger_estop(reason):
+    record_manifest("runtime_estop_trigger", {"reason": reason, "time": time.time()})
+    if E_STOP_ENDPOINT:
+        try:
+            requests.post(E_STOP_ENDPOINT, json={"reason": reason}, timeout=2)
+        except Exception:
+            pass
+    if E_STOP_CMD:
+        try:
+            import subprocess
+            subprocess.call(E_STOP_CMD, shell=True)
+        except Exception:
+            pass
+
+INVARIANTS = {
+    "joint_limits": {"min": -3.14, "max": 3.14},
+    "max_effort": 100.0
+}
+
+def check_invariants(action_event):
+    payload = action_event.get("payload", {})
+    joints = payload.get("joint_positions")
+    if joints:
+        for v in joints:
+            if v < INVARIANTS["joint_limits"]["min"] or v > INVARIANTS["joint_limits"]["max"]:
+                return False, "joint_limit_violation"
+    return True, "ok"
+
+def monitor_loop(get_events_callable, poll_interval=0.1):
+    while True:
+        events = get_events_callable()
+        for ev in events:
+            ok, reason = check_invariants(ev)
+            if not ok:
+                record_manifest("runtime_monitor_violation", {"event": ev, "reason": reason})
+                # Trigger E-STOP immediately
+                trigger_estop(reason)
+        time.sleep(poll_interval)
+
