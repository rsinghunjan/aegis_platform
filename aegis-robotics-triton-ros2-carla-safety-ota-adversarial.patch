+#!/usr/bin/env python3
+"""
+Minimal ROS2 -> Aegis bridge.
+ - subscribes to sensor topics (e.g., /camera/image_raw, /lidar/points)
+ - forwards time-stamped payloads (or metadata pointers) to Aegis ingestion endpoint or Kafka
+ - demonstrates lifecycle hooks for safety: on_shutdown publish "node_down" and last-state.
+"""
+import os
+import json
+import base64
+import time
+import requests
+import rclpy
+from rclpy.node import Node
+from sensor_msgs.msg import Image, PointCloud2
+
+AEGIS_INGEST_URL = os.environ.get("AEGIS_INGEST_URL", "http://aegis-ingest:8080/ingest")
+KAFKA_BOOTSTRAP = os.environ.get("KAFKA_BOOTSTRAP", "")
+
+def encode_img(msg: Image) -> str:
+    # minimal encoding of bytes to base64 (for small demo; in prod prefer object store + pointer)
+    b = bytes(msg.data)
+    return base64.b64encode(b).decode("utf-8")
+
+class BridgeNode(Node):
+    def __init__(self):
+        super().__init__("aegis_ros2_bridge")
+        self.create_subscription(Image, "/camera/image_raw", self.on_image, 10)
+        self.create_subscription(PointCloud2, "/lidar/points", self.on_lidar, 10)
+        self.get_logger().info("Aegis ROS2 bridge started")
+
+    def on_image(self, msg: Image):
+        ts = self.get_clock().now().to_msg().sec_nsec if hasattr(self.get_clock().now(), "to_msg") else time.time()
+        payload = {"topic": "/camera/image_raw", "ts": time.time(), "frame_id": msg.header.frame_id, "encoding": msg.encoding}
+        try:
+            # For high-throughput use: upload to object store (S3) and send pointer instead
+            payload["data_b64"] = encode_img(msg)
+            requests.post(AEGIS_INGEST_URL, json=payload, timeout=1.0)
+        except Exception as e:
+            self.get_logger().warning(f"ingest post failed: {e}")
+
+    def on_lidar(self, msg: PointCloud2):
+        payload = {"topic": "/lidar/points", "ts": time.time(), "frame_id": msg.header.frame_id}
+        try:
+            # In production: convert to file and store in object store; send pointer
+            requests.post(AEGIS_INGEST_URL, json=payload, timeout=1.0)
+        except Exception as e:
+            self.get_logger().warning(f"ingest post failed: {e}")
+
+def main(args=None):
+    rclpy.init(args=args)
+    node = BridgeNode()
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        node.get_logger().info("Shutting down bridge")
+    finally:
+        node.destroy_node()
+        rclpy.shutdown()
+
+if __name__ == "__main__":
+    main()
+
