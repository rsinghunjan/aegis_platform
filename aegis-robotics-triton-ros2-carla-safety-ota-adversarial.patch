+#!/usr/bin/env python3
+"""
+Collect an evidence pack for a model promotion:
+ - MCP JSON
+ - cosign signature(s)
+ - SLSA attestation(s)
+ - simulation run logs (CARLA/Gazebo)
+ - test results
+ - zip and optionally upload to compliance vault
+"""
+import os, json, zipfile
+from pathlib import Path
+import requests
+
+MCP_PATH = os.environ.get("MCP_JSON_PATH", "mcp_record.json")
+SLSA_PATH = os.environ.get("SLSA_PATH", "slsa-attestation.json")
+SIM_LOG_DIR = os.environ.get("SIM_LOG_DIR", "/tmp/carla_runs")
+OUTPUT_ZIP = os.environ.get("EVIDENCE_OUT", "/tmp/evidence_pack.zip")
+COMPLIANCE_UPLOAD = os.environ.get("COMPLIANCE_UPLOAD_URL", "")
+
+def collect():
+    p = Path(OUTPUT_ZIP)
+    with zipfile.ZipFile(p, "w") as z:
+        if Path(MCP_PATH).exists():
+            z.write(MCP_PATH, arcname="mcp.json")
+        if Path(SLSA_PATH).exists():
+            z.write(SLSA_PATH, arcname="slsa-attestation.json")
+        simdir = Path(SIM_LOG_DIR)
+        if simdir.exists():
+            for f in simdir.glob("*.json"):
+                z.write(f, arcname=f"simulation/{f.name}")
+    if COMPLIANCE_UPLOAD:
+        with open(p, "rb") as fh:
+            try:
+                requests.post(COMPLIANCE_UPLOAD, files={"file": fh}, timeout=10)
+            except Exception as e:
+                print("upload failed", e)
+    print("Evidence pack created at", p)
+
+if __name__ == "__main__":
+    collect()
+
