+#!/usr/bin/env python3
+"""
+Simple adversarial perturbation harness (FGSM) for image models (PyTorch).
+Use as a CI job to run adversarial regression tests and collect metrics.
+"""
+import os
+import torch
+import torchvision.transforms as T
+from torchvision.models import resnet18
+import numpy as np
+from PIL import Image
+
+EPS = float(os.environ.get("ADV_EPS", "0.01"))
+MODEL_PATH = os.environ.get("ADV_MODEL_PATH", "")
+
+def fgsm_attack(image, epsilon, data_grad):
+    sign_data_grad = data_grad.sign()
+    perturbed_image = image + epsilon * sign_data_grad
+    return torch.clamp(perturbed_image, 0, 1)
+
+def run_adv(image_path):
+    device = torch.device("cpu")
+    model = resnet18(pretrained=True).to(device).eval()
+    img = Image.open(image_path).convert("RGB")
+    transform = T.Compose([T.Resize(224), T.CenterCrop(224), T.ToTensor()])
+    input = transform(img).unsqueeze(0).to(device)
+    input.requires_grad = True
+    output = model(input)
+    init_pred = output.max(1, keepdim=True)[1]
+    loss = torch.nn.functional.nll_loss(torch.log_softmax(output, dim=1), init_pred.view(-1))
+    model.zero_grad()
+    loss.backward()
+    data_grad = input.grad.data
+    perturbed = fgsm_attack(input, EPS, data_grad)
+    adv_output = model(perturbed)
+    adv_pred = adv_output.max(1, keepdim=True)[1]
+    return init_pred.item(), adv_pred.item()
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("usage: adversarial_test.py <image_file>")
+        raise SystemExit(2)
+    print(run_adv(sys.argv[1]))
+
