+#!/usr/bin/env python3
+"""
+Run a CARLA scenario headless, collect logs and metrics, and upload logs to object store (S3 / LakeFS).
+This is a lightweight orchestrator for CI usage.
+Requires CARLA server running or use Docker image in CI.
+"""
+import os, time, json, requests
+from pathlib import Path
+
+CARLA_HOST = os.environ.get("CARLA_HOST", "localhost")
+CARLA_PORT = int(os.environ.get("CARLA_PORT", "2000"))
+OUTPUT_DIR = os.environ.get("CARLA_OUTPUT_DIR", "/tmp/carla_runs")
+S3_UPLOAD_URL = os.environ.get("ARTIFACT_UPLOAD_URL", "")
+
+def run_scenario(scenario_name: str, duration: int = 30):
+    Path(OUTPUT_DIR).mkdir(parents=True, exist_ok=True)
+    run_id = f"{scenario_name}-{int(time.time())}"
+    out_file = Path(OUTPUT_DIR) / f"{run_id}.json"
+    # Placeholder: in production call the CARLA python API to run scenario, spawn actors, etc.
+    metrics = {"scenario": scenario_name, "run_id": run_id, "status": "ok", "timestamp": time.time()}
+    with open(out_file, "w") as f:
+        json.dump(metrics, f)
+    if S3_UPLOAD_URL:
+        try:
+            files = {"file": open(out_file, "rb")}
+            requests.post(S3_UPLOAD_URL, files=files, timeout=10)
+        except Exception as e:
+            print("upload failed", e)
+    print("Scenario run complete:", out_file)
+    return out_file
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("usage: run_carla_scenario.py <scenario_name>")
+        raise SystemExit(2)
+    run_scenario(sys.argv[1], duration=60)
