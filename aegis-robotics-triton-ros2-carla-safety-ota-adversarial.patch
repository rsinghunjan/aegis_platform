+#!/usr/bin/env bash
+set -euo pipefail
+IMAGE=$1
+TARGET_DEVICE_GROUP=${2:-"fleet-group-a"}
+COSIGN_KEY=${COSIGN_KEY:-""}
+REKOR_SERVER=${REKOR_SERVER:-""}
+
+if [ -z "$IMAGE" ]; then
+  echo "usage: ota_sign_and_deploy.sh <image> [device_group]"
+  exit 2
+fi
+
+echo "Signing image with cosign..."
+if [ -z "$COSIGN_KEY" ]; then
+  echo "COSIGN_KEY not set; aborting"
+  exit 1
+fi
+
+cosign sign --key "$COSIGN_KEY" "$IMAGE"
+if [ -n "$REKOR_SERVER" ]; then
+  echo "Uploading attestation to Rekor..."
+  # cosign upload-attestation or rekor client steps could be used here
+fi
+
+echo "Creating OTA manifest (signed)"
+MANIFEST="/tmp/ota-manifest-$(basename $IMAGE).json"
+cat > "$MANIFEST" <<EOF
+{
+  "image": "$IMAGE",
+  "device_group": "$TARGET_DEVICE_GROUP",
+  "timestamp": "$(date --iso-8601=seconds)"
+}
+EOF
+
+cosign sign-blob --key "$COSIGN_KEY" "$MANIFEST"
+echo "OTA manifest signed at $MANIFEST"
+
+echo "Triggering OTA deployment (operator must implement handler to pick up manifest and roll out)"
+# Example: POST to operator API
+# curl -X POST https://ota.operator.example/api/deploy -F "manifest=@${MANIFEST}"
+
+echo "Done"
