+#!/usr/bin/env python3
+"""
+High-throughput sensor event producer example using kafka-python.
+In production prefer batching, compression, and direct object-store pointers for large frames.
+"""
+import os, json, time
+from kafka import KafkaProducer
+
+KAFKA_BOOTSTRAP = os.environ.get("KAFKA_BOOTSTRAP", "kafka:9092")
+TOPIC = os.environ.get("KAFKA_TOPIC", "aegis-sensor-events")
+
+producer = KafkaProducer(bootstrap_servers=KAFKA_BOOTSTRAP, value_serializer=lambda v: json.dumps(v).encode("utf-8"), linger_ms=5, compression_type='gzip')
+
+def publish_event(topic, payload):
+    producer.send(topic, payload)
+    producer.flush()
+
+def main():
+    # simple demo: stream synthetic events
+    for i in range(100):
+        ev = {"ts": time.time(), "sensor":"camera", "frame_id": i}
+        publish_event(TOPIC, ev)
+        time.sleep(0.01)
+
+if __name__ == "__main__":
+    main()
+
