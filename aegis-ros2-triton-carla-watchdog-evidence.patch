+#!/usr/bin/env python3
+"""
+Push an ONNX model directory into Triton's model-repository layout.
+Example usage:
+  python push_onnx_model.py --model-name mymodel --onnx model.onnx --out-dir /tmp/models
+"""
+import os, argparse, shutil, json
+from pathlib import Path
+
+def layout_model(model_name: str, onnx_path: str, out_dir: str):
+    base = Path(out_dir) / model_name
+    version_dir = base / "1"
+    version_dir.mkdir(parents=True, exist_ok=True)
+    shutil.copy(onnx_path, version_dir / "model.onnx")
+    # create config.pbtxt (simplified)
+    config = {
+        "name": model_name,
+        "platform": "onnxruntime_onnx",
+        "max_batch_size": 1,
+        "input": [{"name": "INPUT__0", "data_type": "TYPE_FP32", "dims": [-1, 3, 224, 224]}],
+        "output": [{"name": "OUTPUT__0", "data_type": "TYPE_FP32", "dims": [-1, 1000]}]
+    }
+    with open(base / "config.pbtxt", "w") as f:
+        f.write(json.dumps(config))
+    print("Model laid out at", base)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--model-name", required=True)
+    p.add_argument("--onnx", required=True)
+    p.add_argument("--out-dir", required=True)
+    args = p.parse_args()
+    layout_model(args.model_name, args.onnx, args.out_dir)
+
