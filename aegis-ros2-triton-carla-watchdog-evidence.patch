+#!/usr/bin/env python3
+"""
+Simple Triton latency tester (HTTP inference) and Prometheus metrics exporter (Pushgateway optional).
+Requires python-requests.
+"""
+import os, time, requests
+from statistics import mean, median
+
+TRITON_URL = os.environ.get("TRITON_URL", "http://triton-inference:8000/v2/models/mymodel/infer")
+PUSHGATEWAY = os.environ.get("PUSHGATEWAY", "")
+
+def measure(n=50):
+    latencies = []
+    for i in range(n):
+        t0 = time.time()
+        try:
+            r = requests.post(TRITON_URL, json={"inputs": []}, timeout=5.0)
+        except Exception:
+            latencies.append(9999.0)
+            continue
+        latencies.append((time.time() - t0) * 1000.0)
+    return latencies
+
+if __name__ == "__main__":
+    l = measure(20)
+    print("p95 ~", sorted(l)[int(len(l) * 0.95)])
+    print("p99 ~", sorted(l)[int(len(l) * 0.99)])
+    if PUSHGATEWAY:
+        try:
+            requests.post(f"http://{PUSHGATEWAY}/metrics/job/triton_latency", data=f"triton_p95 {sorted(l)[int(len(l)*0.95)]}\n")
+        except Exception:
+            pass
