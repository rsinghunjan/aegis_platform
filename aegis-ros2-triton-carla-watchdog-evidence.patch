+#!/usr/bin/env python3
+"""
+Build an evidence pack for compliance containing:
+ - model artifact (URI)
+ - MCP JSON (local path or URL)
+ - cosign signature file(s)
+ - SLSA attestation file(s)
+ - simulation logs and scenario IDs
+ - test results (adversarial / regression)
+ - produce a zip and optionally upload to compliance vault
+
+Environment:
+ - MCP_JSON_PATH, SLSA_PATH, COSIGN_SIG_PATH, SIM_LOG_DIR, TEST_RESULTS_PATH
+ - COMPLIANCE_UPLOAD_URL (optional)
+"""
+import os
+import zipfile
+from pathlib import Path
+import requests
+
+MCP_JSON_PATH = os.environ.get("MCP_JSON_PATH", "mcp_record.json")
+SLSA_PATH = os.environ.get("SLSA_PATH", "slsa-attestation.json")
+COSIGN_SIG_PATH = os.environ.get("COSIGN_SIG_PATH", "")
+SIM_LOG_DIR = os.environ.get("SIM_LOG_DIR", "/tmp/carla_runs")
+TEST_RESULTS_PATH = os.environ.get("TEST_RESULTS_PATH", "")
+OUTPUT_ZIP = os.environ.get("EVIDENCE_OUT", "/tmp/evidence_pack.zip")
+COMPLIANCE_UPLOAD_URL = os.environ.get("COMPLIANCE_UPLOAD_URL", "")
+
+def collect_and_zip():
+    out = Path(OUTPUT_ZIP)
+    with zipfile.ZipFile(out, "w") as z:
+        if Path(MCP_JSON_PATH).exists():
+            z.write(MCP_JSON_PATH, arcname="mcp.json")
+        if Path(SLSA_PATH).exists():
+            z.write(SLSA_PATH, arcname="slsa-attestation.json")
+        if COSIGN_SIG_PATH and Path(COSIGN_SIG_PATH).exists():
+            z.write(COSIGN_SIG_PATH, arcname=Path(COSIGN_SIG_PATH).name)
+        simdir = Path(SIM_LOG_DIR)
+        if simdir.exists():
+            for f in simdir.glob("**/*"):
+                if f.is_file():
+                    z.write(f, arcname=f"simulation/{f.relative_to(simdir)}")
+        if TEST_RESULTS_PATH and Path(TEST_RESULTS_PATH).exists():
+            z.write(TEST_RESULTS_PATH, arcname=Path(TEST_RESULTS_PATH).name)
+    print("Evidence pack created at", out)
+    if COMPLIANCE_UPLOAD_URL:
+        with open(out, "rb") as fh:
+            try:
+                r = requests.post(COMPLIANCE_UPLOAD_URL, files={"file": fh}, timeout=20)
+                r.raise_for_status()
+                print("Uploaded evidence pack to compliance vault")
+            except Exception as e:
+                print("Upload failed:", e)
+
+if __name__ == "__main__":
+    collect_and_zip()
+
