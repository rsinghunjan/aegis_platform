+#!/usr/bin/env python3
+"""
+Run a CARLA scenario and store logs to S3/LakeFS. Attach scenario metadata to MCP record.
+Usage:
+  python run_carla_scenario.py --scenario safety_scenario --model-id <model_id>
+"""
+import os, time, json, argparse
+from pathlib import Path
+import requests
+import boto3
+
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+S3_BUCKET = os.environ.get("S3_BUCKET", "")
+AWS_REGION = os.environ.get("AWS_REGION", "us-east-1")
+ARTIFACT_UPLOAD_URL = os.environ.get("ARTIFACT_UPLOAD_URL", "")
+
+if S3_BUCKET:
+    s3 = boto3.client("s3", region_name=AWS_REGION)
+else:
+    s3 = None
+
+def upload_file(path: str, key: str):
+    if s3:
+        s3.upload_file(path, S3_BUCKET, key)
+        return f"s3://{S3_BUCKET}/{key}"
+    if ARTIFACT_UPLOAD_URL:
+        with open(path, "rb") as fh:
+            r = requests.post(ARTIFACT_UPLOAD_URL, files={"file": fh}, timeout=20)
+            r.raise_for_status()
+            return r.json().get("url", "")
+    return ""
+
+def run_scenario(scenario: str, model_id: str, duration: int = 30):
+    out_dir = Path("/tmp/carla_runs")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    run_id = f"{scenario}-{int(time.time())}"
+    metrics_path = out_dir / f"{run_id}.json"
+    # placeholder: integrate with CARLA Python API in production
+    metrics = {"scenario": scenario, "run_id": run_id, "model_id": model_id, "status": "completed", "timestamp": time.time()}
+    with open(metrics_path, "w") as f:
+        json.dump(metrics, f)
+    key = f"simulation/{model_id}/{run_id}.json"
+    uri = upload_file(str(metrics_path), key)
+    # attach to MCP
+    try:
+        rec = {"model_id": model_id, "version": "", "artifacts": [{"uri": uri}], "evaluation": {"run_id": run_id, "scenario": scenario}, "approvals": []}
+        r = requests.post(f"{AEGIS_MCP_API.rstrip('/')}/models/{model_id}/context", json=rec, timeout=10)
+        r.raise_for_status()
+    except Exception as e:
+        print("Failed to post MCP record:", e)
+    print("Scenario finished, artifacts:", uri)
+    return uri
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--scenario", required=True)
+    p.add_argument("--model-id", required=True)
+    p.add_argument("--duration", type=int, default=30)
+    args = p.parse_args()
+    run_scenario(args.scenario, args.model_id, args.duration)
+
