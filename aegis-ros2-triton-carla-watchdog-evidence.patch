+#!/usr/bin/env python3
+"""
+Runtime watchdog: polls inference health and model confidence metrics,
+and triggers a safe-stop via operator API if thresholds breached.
+Environment:
+ - HEALTH_ENDPOINT (e.g. http://triton-inference:8000/v2/health/ready)
+ - METRICS_ENDPOINT (Prometheus /metrics or pushgateway)
+ - SAFE_STOP_API (operator endpoint to request safe stop)
+ - CONFIDENCE_THRESHOLD (float)
+"""
+import os, time, requests
+import logging
+
+logging.basicConfig(level=logging.INFO)
+LOG = logging.getLogger("aegis.watchdog")
+
+HEALTH_ENDPOINT = os.environ.get("HEALTH_ENDPOINT", "http://triton-inference:8000/v2/health/ready")
+SAFE_STOP_API = os.environ.get("SAFE_STOP_API", "")
+CONF_THRESHOLD = float(os.environ.get("CONFIDENCE_THRESHOLD", "0.5"))
+
+def check_health():
+    try:
+        r = requests.get(HEALTH_ENDPOINT, timeout=2.0)
+        return r.status_code == 200
+    except Exception:
+        return False
+
+def get_confidence():
+    # placeholder: in production query Prometheus or model metrics endpoint for recent confidence
+    # For demo, read env override
+    v = os.environ.get("LATEST_CONFIDENCE", None)
+    if v:
+        return float(v)
+    return 1.0
+
+def request_safe_stop(reason: str):
+    if not SAFE_STOP_API:
+        LOG.warning("SAFE_STOP_API not configured, cannot request safe stop: %s", reason)
+        return
+    try:
+        r = requests.post(SAFE_STOP_API, json={"reason": reason}, timeout=5.0)
+        r.raise_for_status()
+        LOG.info("Safe-stop requested: %s", reason)
+    except Exception as e:
+        LOG.error("Safe-stop request failed: %s", e)
+
+def main():
+    while True:
+        healthy = check_health()
+        if not healthy:
+            LOG.error("Health check failed; requesting safe-stop")
+            request_safe_stop("health_check_failed")
+            time.sleep(5)
+            continue
+        conf = get_confidence()
+        if conf < CONF_THRESHOLD:
+            LOG.error("Confidence %s below threshold %s; requesting safe-stop", conf, CONF_THRESHOLD)
+            request_safe_stop(f"low_confidence_{conf}")
+        time.sleep(2)
+
+if __name__ == "__main__":
+    main()
+
