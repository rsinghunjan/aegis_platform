+#!/usr/bin/env python3
+"""
+ROS2 -> Aegis bridge
+ - subscribes to sensor topics and uploads payloads to object store (LakeFS/S3)
+ - writes per-run metadata to MCP
+ - publishes approval requests to A2A when human sign-off is needed
+
+Environment variables:
+ - AEGIS_MCP_API (e.g. http://mcp:8082)
+ - AEGIS_INGEST_API (optional HTTP ingest receiver)
+ - A2A_API (e.g. http://approver:8085)
+ - S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION (for S3)
+ - LAKEFS_ENDPOINT, LAKEFS_ACCESS_KEY, LAKEFS_SECRET_KEY, LAKEFS_REPO, LAKEFS_BRANCH (optional)
+"""
+import os
+import time
+import json
+import uuid
+import base64
+import logging
+import requests
+import boto3
+import rclpy
+from rclpy.node import Node
+from sensor_msgs.msg import Image, PointCloud2
+
+logging.basicConfig(level=logging.INFO)
+LOG = logging.getLogger("aegis.ros2_bridge")
+
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+AEGIS_INGEST_API = os.environ.get("AEGIS_INGEST_API", "")
+A2A_API = os.environ.get("A2A_API", "http://approver:8085")
+
+S3_BUCKET = os.environ.get("S3_BUCKET", "")
+AWS_REGION = os.environ.get("AWS_REGION", "us-east-1")
+LAKEFS_ENDPOINT = os.environ.get("LAKEFS_ENDPOINT", "")
+LAKEFS_REPO = os.environ.get("LAKEFS_REPO", "aegis-data")
+LAKEFS_BRANCH = os.environ.get("LAKEFS_BRANCH", "main")
+
+if S3_BUCKET:
+    s3 = boto3.client("s3", region_name=AWS_REGION)
+else:
+    s3 = None
+
+def upload_to_s3_bytes(key: str, b: bytes) -> str:
+    """Upload bytes to S3 and return s3://bucket/key"""
+    if not s3:
+        raise RuntimeError("S3 not configured")
+    s3.put_object(Bucket=S3_BUCKET, Key=key, Body=b)
+    return f"s3://{S3_BUCKET}/{key}"
+
+def make_mcp_record(model_id: str, run_id: str, artifact_uri: str, meta: dict):
+    return {
+        "model_id": model_id,
+        "version": meta.get("model_version", ""),
+        "artifacts": [{"uri": artifact_uri}],
+        "evaluation": {"run_id": run_id, "meta": meta},
+        "approvals": []
+    }
+
+class AegisBridge(Node):
+    def __init__(self):
+        super().__init__("aegis_ros2_bridge")
+        qos = 10
+        self.create_subscription(Image, "/camera/image_raw", self.on_image, qos)
+        self.create_subscription(PointCloud2, "/lidar/points", self.on_lidar, qos)
+        LOG.info("Aegis ROS2 bridge started")
+
+    def _store_payload(self, topic: str, data: bytes, meta: dict) -> str:
+        """Store to S3 (preferred) and return URI; try LAKEFS if configured via API (simple stub)"""
+        ts = int(time.time() * 1000)
+        run_id = meta.get("run_id", str(uuid.uuid4()))
+        key = f"ingest/{topic}/{run_id}-{ts}.bin"
+        try:
+            uri = upload_to_s3_bytes(key, data)
+            LOG.info("Uploaded payload to %s", uri)
+            return uri
+        except Exception as e:
+            LOG.warning("S3 upload failed: %s", e)
+            # fallback: attempt to POST to ingest endpoint
+            if AEGIS_INGEST_API:
+                try:
+                    r = requests.post(AEGIS_INGEST_API, json={"topic": topic, "meta": meta, "data_b64": base64.b64encode(data).decode("ascii")}, timeout=3.0)
+                    r.raise_for_status()
+                    return r.json().get("uri", "")
+                except Exception as e2:
+                    LOG.warning("HTTP ingest failed: %s", e2)
+            raise
+
+    def _publish_mcp(self, model_id: str, run_id: str, artifact_uri: str, meta: dict):
+        rec = make_mcp_record(model_id, run_id, artifact_uri, meta)
+        try:
+            url = f"{AEGIS_MCP_API.rstrip('/')}/models/{model_id}/context"
+            r = requests.post(url, json=rec, timeout=5.0)
+            r.raise_for_status()
+            LOG.info("Posted MCP record for %s", model_id)
+        except Exception as e:
+            LOG.warning("MCP publish failed: %s", e)
+
+    def _request_approval(self, model_id: str, artifact_uri: str, requester: str = "ros2-bridge"):
+        try:
+            payload = {"id": str(uuid.uuid4()), "type": "approval_request", "model_id": model_id, "artifact_uri": artifact_uri, "requester": requester, "ts": int(time.time())}
+            r = requests.post(f"{A2A_API.rstrip('/')}/request", json=payload, timeout=5.0)
+            r.raise_for_status()
+            LOG.info("Approval request posted for %s", model_id)
+        except Exception as e:
+            LOG.warning("Approval request failed: %s", e)
+
+    def on_image(self, msg: Image):
+        meta = {"frame_id": msg.header.frame_id, "encoding": msg.encoding, "topic": "/camera/image_raw", "timestamp": int(time.time())}
+        try:
+            data = bytes(msg.data)
+            uri = self._store_payload("camera", data, {"run_id": str(uuid.uuid4()), **meta})
+            # attach MCP record for a per-capture artifact (lightweight)
+            self._publish_mcp(model_id="unknown-model", run_id=meta.get("run_id",""), artifact_uri=uri, meta=meta)
+            # request approval if configured (example: human-in-the-loop trigger)
+            if os.environ.get("A2A_AUTO_REQ", "false").lower() == "true":
+                self._request_approval("unknown-model", uri)
+        except Exception as e:
+            LOG.warning("on_image error: %s", e)
+
+    def on_lidar(self, msg: PointCloud2):
+        meta = {"frame_id": msg.header.frame_id, "topic": "/lidar/points", "timestamp": int(time.time())}
+        try:
+            # convert PointCloud2 raw to bytes; for demo we don't parse layout
+            raw = bytes(msg.data) if hasattr(msg, "data") else b""
+            uri = self._store_payload("lidar", raw, {"run_id": str(uuid.uuid4()), **meta})
+            self._publish_mcp(model_id="unknown-model", run_id=meta.get("run_id",""), artifact_uri=uri, meta=meta)
+        except Exception as e:
+            LOG.warning("on_lidar error: %s", e)
+
+def main():
+    rclpy.init()
+    node = AegisBridge()
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        LOG.info("Shutdown requested")
+    finally:
+        node.destroy_node()
+        rclpy.shutdown()
+
+if __name__ == "__main__":
+    main()
+
