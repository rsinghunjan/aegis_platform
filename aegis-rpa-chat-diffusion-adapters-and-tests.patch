+#!/usr/bin/env python3
+"""
+End-to-end diffusion smoke test:
+ - Calls a diffusion generation endpoint (local or remote)
+ - Receives image bytes, uploads to moderation service for attestation
+ - Validates moderation manifest presence and stores result locally / optionally in S3
+
+Environment:
+ - DIFFUSION_API_URL (POST /generate -> returns image bytes or base64 payload)
+ - MODERATION_SERVICE_URL (the moderation service deployed in cluster)
+ - EVIDENCE_BUCKET (optional s3://...)
+"""
+import os, requests, base64, tempfile, time, json, subprocess
+
+DIFF_API = os.environ.get("DIFFUSION_API_URL","http://diffusion:9000/generate")
+MOD_API = os.environ.get("MODERATION_SERVICE_URL","http://aegis-moderation:8200")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+COSIGN_KEY = os.environ.get("COSIGN_KEY_REF","")
+
+def generate_image(prompt):
+    r = requests.post(DIFF_API, json={"prompt": prompt, "height":512, "width":512}, timeout=60)
+    r.raise_for_status()
+    j = r.json()
+    img_b64 = j.get("image_base64")
+    if not img_b64:
+        raise RuntimeError("Generation API returned no image")
+    img = base64.b64decode(img_b64)
+    return img
+
+def moderate_image_and_get_manifest(image_bytes, item_id):
+    files = {"file": ("img.png", image_bytes)}
+    r = requests.post(f"{MOD_API}/moderate/image", files=files, data={"id": item_id}, timeout=60)
+    r.raise_for_status()
+    return r.json()
+
+def upload_evidence(local_path, dest_prefix):
+    if EVIDENCE_BUCKET and EVIDENCE_BUCKET.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp", local_path, f"{EVIDENCE_BUCKET}/{dest_prefix}/{os.path.basename(local_path)}"])
+        return f"{EVIDENCE_BUCKET}/{dest_prefix}/{os.path.basename(local_path)}"
+    return None
+
+def main():
+    prompt = "A serene landscape with mountains and a sunrise, photorealistic"
+    print("Generating image for prompt:", prompt)
+    img = generate_image(prompt)
+    ts = int(time.time())
+    local = f"/tmp/diff_img_{ts}.png"
+    open(local,"wb").write(img)
+    print("Image written to", local)
+    print("Calling moderation service for attestation")
+    manifest = moderate_image_and_get_manifest(img, f"gen-{ts}")
+    print("Moderation manifest:", manifest)
+    if EVIDENCE_BUCKET:
+        upl = upload_evidence(local, "generated_images")
+        print("Uploaded image to", upl)
+    print("Smoke test complete")
+
+if __name__=="__main__":
+    main()
+
