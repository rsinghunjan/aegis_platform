+#!/usr/bin/env python3
+"""
+Sample RPA flow that demonstrates how the planner / orchestrator can call a registered RPA tool adapter.
+ - Uses delegation_enforcer to ensure M-of-N where required
+ - Calls selenium_adapter.fill_and_submit as a sandboxed tool execution (here executed locally for demo)
+
+This is a small example showing input->plan->execute->attest pattern.
+"""
+import os, json, subprocess, uuid, time
+from services.rpa import selenium_adapter
+from services.policy.delegation_enforcer import delegation_enforcer
+
+def require_delegation(action_id):
+    # call the delegation enforcer script; will exit non-zero if M-of-N not satisfied or kill-switch off
+    try:
+        subprocess.check_call(["python3","services/policy/delegation_enforcer.py", action_id])
+        return True
+    except subprocess.CalledProcessError:
+        return False
+
+def run_flow_fill_customer_portal(name, url):
+    action_id = f"rpa:fill_customer_portal:{uuid.uuid4()}"
+    print("Checking delegation for action:", action_id)
+    if not require_delegation("rpa_fill_customer_portal"):
+        raise RuntimeError("Delegation check failed - aborting RPA flow")
+    print("Delegation ok; executing selenium adapter")
+    evidence = selenium_adapter.fill_and_submit(url, "#name", name, submit_selector="#submit")
+    # produce an attestation (signed manifest) by calling moderation_attest as an example of attestation flow
+    manifest = {"flow_id": action_id, "operator": os.environ.get("USER","operator"), "evidence": {"title": evidence.get("title")}}
+    fn = f"/tmp/rpa_manifest_{int(time.time())}.json"
+    with open(fn,"w") as fh:
+        json.dump(manifest, fh)
+    # sign manifest (operator must have COSIGN_KEY_REF set in env); best practice is to call Cosign via secure host
+    cosign_key = os.environ.get("COSIGN_KEY_REF","")
+    if cosign_key:
+        subprocess.check_call(["cosign","sign","--key", cosign_key, fn])
+    print("RPA Flow completed; manifest:", fn)
+    return {"manifest": fn, "evidence": evidence}
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--name", default="Test User")
+    p.add_argument("--url", default="https://example.com/form")
+    args = p.parse_args()
+    print(run_flow_fill_customer_portal(args.name, args.url))
+
