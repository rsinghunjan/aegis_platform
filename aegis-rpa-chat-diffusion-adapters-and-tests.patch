+#!/usr/bin/env python3
+"""
+Selenium adapter for RPA tool registry.
+ - Minimal adapter that launches a headless browser, navigates, fills a form, and extracts a result.
+ - Intended to be used by the orchestrator as a tool with inputs/outputs and to be sandboxed (run in a k8s Job or dedicated pod).
+
+Environment:
+ - SELENIUM_REMOTE_URL (optional): remote WebDriver URL (e.g., selenium grid). If unset, runs local webdriver (requires chromedriver in PATH).
+ - HEADLESS (default: "true")
+
+Usage (example):
+  python3 services/rpa/selenium_adapter.py --action fill_form --url "https://example.com" --selector "#name" --value "Alice"
+"""
+import os, argparse, time, json
+from typing import Dict
+
+try:
+    from selenium import webdriver
+    from selenium.webdriver.chrome.options import Options
+    from selenium.webdriver.common.by import By
+except Exception:
+    webdriver = None
+
+def create_driver():
+    remote = os.environ.get("SELENIUM_REMOTE_URL","")
+    headless = os.environ.get("HEADLESS","true").lower() in ("1","true","yes")
+    if remote:
+        caps = {}
+        return webdriver.Remote(command_executor=remote, desired_capabilities=caps)
+    # local Chrome
+    opt = Options()
+    if headless:
+        opt.add_argument("--headless=new")
+    opt.add_argument("--no-sandbox")
+    opt.add_argument("--disable-dev-shm-usage")
+    return webdriver.Chrome(options=opt)
+
+def fill_and_submit(url: str, selector: str, value: str, submit_selector: str = None, wait: float = 2.0) -> Dict:
+    if webdriver is None:
+        raise RuntimeError("selenium not installed in runtime. Add selenium and a webdriver to run this adapter.")
+    drv = create_driver()
+    try:
+        drv.get(url)
+        time.sleep(1.0)
+        el = drv.find_element(By.CSS_SELECTOR, selector)
+        el.clear()
+        el.send_keys(value)
+        if submit_selector:
+            drv.find_element(By.CSS_SELECTOR, submit_selector).click()
+        time.sleep(wait)
+        # return a screenshot and page title for evidence
+        screenshot = drv.get_screenshot_as_base64()
+        title = drv.title
+        return {"title": title, "screenshot_b64": screenshot}
+    finally:
+        try:
+            drv.quit()
+        except Exception:
+            pass
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--action", default="fill_form")
+    p.add_argument("--url", required=True)
+    p.add_argument("--selector", required=True)
+    p.add_argument("--value", default="")
+    p.add_argument("--submit-selector", default=None)
+    args = p.parse_args()
+    out = fill_and_submit(args.url, args.selector, args.value, args.submit_selector)
+    print(json.dumps(out))
+
+if __name__=="__main__":
+    main()
+
