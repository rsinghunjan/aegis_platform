+#!/usr/bin/env python3
+"""
+Very small WebSocket adapter that accepts client connections and proxies messages to the LLM proxy HTTP endpoint.
+This is intended to provide a simple real-time channel for conversational UIs.
+
+Dependencies: websockets, requests
+"""
+import os, asyncio, json, requests
+import websockets
+
+LLM_PROXY_URL = os.environ.get("LLM_PROXY_URL","http://llm-proxy:8083/v1/generate")
+WS_HOST = os.environ.get("WS_HOST","0.0.0.0")
+WS_PORT = int(os.environ.get("WS_PORT","8765"))
+
+async def handler(websocket, path):
+    async for message in websocket:
+        try:
+            payload = json.loads(message)
+            prompt = payload.get("prompt")
+            r = requests.post(LLM_PROXY_URL, json={"prompt": prompt, "max_tokens": payload.get("max_tokens",256)}, timeout=30)
+            r.raise_for_status()
+            resp = r.json()
+            await websocket.send(json.dumps(resp))
+        except Exception as e:
+            await websocket.send(json.dumps({"error": str(e)}))
+
+def start_server():
+    return websockets.serve(handler, WS_HOST, WS_PORT)
+
+if __name__=="__main__":
+    loop = asyncio.get_event_loop()
+    srv = start_server()
+    loop.run_until_complete(srv)
+    print(f"WebSocket adapter listening on ws://{WS_HOST}:{WS_PORT}")
+    loop.run_forever()
+
