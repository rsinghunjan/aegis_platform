+#!/usr/bin/env python3
+"""
+Simple session store using Redis for conversational state.
+ - set_session(session_id, data, ttl)
+ - get_session(session_id)
+ - append_message(session_id, role, text)
+
+Env:
+ - REDIS_URL
+"""
+import os, json, redis
+
+REDIS_URL = os.environ.get("REDIS_URL","redis://localhost:6379/0")
+r = redis.Redis.from_url(REDIS_URL, decode_responses=True)
+
+def set_session(session_id, data, ttl=3600):
+    r.setex(f"aegis:session:{session_id}", ttl, json.dumps(data))
+
+def get_session(session_id):
+    v = r.get(f"aegis:session:{session_id}")
+    return json.loads(v) if v else None
+
+def append_message(session_id, role, text):
+    key = f"aegis:session:{session_id}:messages"
+    r.rpush(key, json.dumps({"role": role, "text": text, "ts": int(__import__('time').time())}))
+    r.expire(key, 3600)
+
+if __name__=="__main__":
+    sid = "demo"
+    set_session(sid, {"user":"alice"}, ttl=60)
+    append_message(sid, "user", "hello")
+    print(get_session(sid))
+
