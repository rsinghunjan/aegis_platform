+#!/usr/bin/env python3
+"""
+Simple Slack outgoing adapter: posts messages to a Slack channel via webhook or chat.postMessage (using token).
+Also shows how to forward inbound events to the orchestrator via an HTTP endpoint (example only).
+
+Environment:
+ - SLACK_WEBHOOK_URL: for incoming webhook posting (simpler)
+ - SLACK_BOT_TOKEN: optional, for chat.postMessage via Web API
+"""
+import os, json, requests
+
+SLACK_WEBHOOK = os.environ.get("SLACK_WEBHOOK_URL","")
+SLACK_TOKEN = os.environ.get("SLACK_BOT_TOKEN","")
+
+def post_via_webhook(text, channel=None):
+    if not SLACK_WEBHOOK:
+        raise RuntimeError("SLACK_WEBHOOK_URL not configured")
+    payload = {"text": text}
+    if channel:
+        payload["channel"] = channel
+    r = requests.post(SLACK_WEBHOOK, json=payload, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def post_via_token(channel, text):
+    if not SLACK_TOKEN:
+        raise RuntimeError("SLACK_BOT_TOKEN not configured")
+    url = "https://slack.com/api/chat.postMessage"
+    hdr = {"Authorization": f"Bearer {SLACK_TOKEN}", "Content-Type": "application/json"}
+    payload = {"channel": channel, "text": text}
+    r = requests.post(url, json=payload, headers=hdr, timeout=10)
+    r.raise_for_status()
+    j = r.json()
+    if not j.get("ok"):
+        raise RuntimeError("Slack API error: " + str(j))
+    return j
+
+if __name__=="__main__":
+    import sys
+    txt = " ".join(sys.argv[1:]) or "Hello from Aegis Slack Adapter"
+    print(post_via_webhook(txt))
+
