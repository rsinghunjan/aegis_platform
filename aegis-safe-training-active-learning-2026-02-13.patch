+#!/usr/bin/env python3
+"""
+active_loop_api.py
+Flask API for active learning annotation loop.
+ - GET /samples?k=...  returns top-k uncertain samples (payloads) for annotation
+ - POST /annotate  submits labeled items and updates Milvus (uncertainty -> low)
+"""
+from flask import Flask, request, jsonify
+from services.active_learning.milvus_sampler import ensure_collection, topk_uncertain, upsert_sample, ensure_connection
+import json, os
+
+app = Flask(__name__)
+COLL = None
+
+@app.before_first_request
+def init():
+    global COLL
+    ensure_connection()
+    COLL = ensure_collection(dim=int(os.environ.get("EMBED_DIM", "64")))
+
+@app.route("/samples", methods=["GET"])
+def samples():
+    k = int(request.args.get("k", "50"))
+    rows = topk_uncertain(COLL, k=k)
+    # return payloads + ids
+    out = [{"id": r["id"], "uncertainty": r["uncertainty"], "payload": json.loads(r["payload"])} for r in rows]
+    return jsonify({"samples": out})
+
+@app.route("/annotate", methods=["POST"])
+def annotate():
+    j = request.json or {}
+    annotations = j.get("annotations", [])
+    for a in annotations:
+        sid = a["id"]
+        label = a["label"]
+        # Upsert sample with uncertainty very low to indicate annotated
+        payload = {"label": label, "annotated_by": j.get("annotator", "human"), "ts": a.get("ts")}
+        # Embedding is optional; reuse previous or store placeholder zero vector if absent
+        emb = a.get("embedding", [0.0]*int(os.environ.get("EMBED_DIM","64")))
+        upsert_sample(COLL, sid, emb, 0.0, payload)
+    return jsonify({"status":"ok","processed": len(annotations)})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8091")))
+
