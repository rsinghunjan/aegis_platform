+#!/usr/bin/env python3
+"""
+milvus_sampler.py
+Active learning sampler using Milvus to store embeddings + uncertainty metadata.
+Provides functions to upsert embeddings with a computed uncertainty score and to fetch top-K
+samples with highest uncertainty for human annotation.
+"""
+import os
+from pymilvus import connections, FieldSchema, CollectionSchema, DataType, Collection
+import numpy as np
+
+MILVUS_HOST = os.environ.get("MILVUS_HOST", "milvus.default.svc.cluster.local")
+MILVUS_PORT = int(os.environ.get("MILVUS_PORT", 19530))
+COLLECTION_NAME = os.environ.get("MILVUS_COLLECTION", "aegis_active")
+
+def ensure_connection():
+    connections.connect(host=MILVUS_HOST, port=str(MILVUS_PORT))
+
+def ensure_collection(dim=128):
+    ensure_connection()
+    if Collection.exists(COLLECTION_NAME):
+        return Collection(COLLECTION_NAME)
+    fields = [
+        FieldSchema(name="id", dtype=DataType.VARCHAR, is_primary=True, max_length=64),
+        FieldSchema(name="embedding", dtype=DataType.FLOAT_VECTOR, dim=dim),
+        FieldSchema(name="uncertainty", dtype=DataType.FLOAT),
+        FieldSchema(name="payload", dtype=DataType.VARCHAR, max_length=4096),
+    ]
+    schema = CollectionSchema(fields, description="Active learning samples")
+    coll = Collection(name=COLLECTION_NAME, schema=schema)
+    coll.create_index(field_name="embedding", index_params={"index_type":"IVF_FLAT","metric_type":"L2","params":{"nlist":128}})
+    coll.load()
+    return coll
+
+def upsert_sample(coll, sample_id, embedding, uncertainty, payload_json):
+    # Milvus expects lists per field
+    entities = [
+        [sample_id],
+        [embedding],
+        [float(uncertainty)],
+        [json_safe(payload_json)]
+    ]
+    insert_result = coll.insert(entities)
+    coll.flush()
+    return insert_result
+
+def json_safe(x):
+    import json
+    s = json.dumps(x, separators=(",", ":"), ensure_ascii=False)
+    return s[:4096]
+
+def topk_uncertain(coll, k=50):
+    # Query by uncertainty predicate: milvus supports expr filters
+    expr = "uncertainty > 0"
+    res = coll.query(expr=expr, output_fields=["id","uncertainty","payload"], limit=k, expr_fmt="python")
+    # sort descending by uncertainty
+    res_sorted = sorted(res, key=lambda r: float(r["uncertainty"]), reverse=True)
+    return res_sorted[:k]
+
+if __name__ == "__main__":
+    import json, sys
+    c = ensure_collection(dim=64)
+    print("Collection ready:", c.name)
+
