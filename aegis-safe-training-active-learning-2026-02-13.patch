+#!/usr/bin/env python3
+"""
+domain_randomization.py
+Simple domain randomization generator for winter-sports simulation data.
+Produces randomized parameter sets and synthetic feature vectors for robustness testing
+and to feed into training pipelines (helps avoid overfitting to local conditions).
+
+Usage:
+  python domain_randomization.py --n 1000 --out synthetic_data.jsonl
+"""
+import argparse
+import json
+import math
+import random
+from datetime import datetime
+
+DEFAULT_PARAMS = {
+    "temperature_c": (-15.0, 5.0),   # range to sample from
+    "humidity": (10.0, 90.0),
+    "wind_m_s": (0.0, 12.0),
+    "snow_grain_size_mm": (0.1, 3.0),
+    "altitude_m": (200.0, 3200.0),
+    "surface_roughness": (0.0, 1.0),
+}
+
+def synthesize_features(params):
+    """
+    Create a small synthetic feature vector for a run given environment params.
+    Replace this with the actual simulator / physics-based digital twin.
+    """
+    # Example features: friction_estimate, glide_index, stability_index
+    temp = params["temperature_c"]
+    wind = params["wind_m_s"]
+    grain = params["snow_grain_size_mm"]
+    altitude = params["altitude_m"]
+    rough = params["surface_roughness"]
+
+    # synthetic physics-like combinations (toy example)
+    friction = max(0.01, 0.2 + 0.01 * (0 - temp) + 0.05 * grain + 0.02 * rough + 0.001 * (altitude/100.0))
+    glide = max(0.0, 1.0 - friction - 0.01 * abs(wind - 3.0))
+    stability = max(0.0, 1.0 - 0.1 * rough - 0.02 * grain + 0.005 * (temp + 10))
+
+    # Add small measurement noise
+    friction *= random.uniform(0.98, 1.02)
+    glide *= random.uniform(0.99, 1.01)
+    stability *= random.uniform(0.97, 1.03)
+
+    return {
+        "friction": friction,
+        "glide": glide,
+        "stability": stability
+    }
+
+def sample_one(param_ranges):
+    p = {}
+    for k, (lo, hi) in param_ranges.items():
+        p[k] = random.uniform(lo, hi)
+    features = synthesize_features(p)
+    return {"ts": datetime.utcnow().isoformat() + "Z", "params": p, "features": features}
+
+def main(n, out):
+    with open(out, "w") as f:
+        for i in range(n):
+            rec = sample_one(DEFAULT_PARAMS)
+            f.write(json.dumps(rec) + "\n")
+    print(f"Wrote {n} synthetic records to {out}")
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--n", type=int, default=1000)
+    p.add_argument("--out", default="synthetic_data.jsonl")
+    args = p.parse_args()
+    main(args.n, args.out)
+
