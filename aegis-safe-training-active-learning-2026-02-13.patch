+
+def sign_decision(decision_payload):
+    try:
+        r = requests.post(SIGNER_URL, json=decision_payload, timeout=5.0)
+        r.raise_for_status()
+        sig = r.json()
+    except Exception as e:
+        raise RuntimeError("signer failed: " + str(e))
+    # record to Rekor (best-effort)
+    if REKOR_URL:
+        try:
+            requests.post(f"{REKOR_URL.rstrip('/')}/api/v1/log/entries", json={"payload": decision_payload, "signature": sig}, timeout=5.0)
+        except Exception:
+            pass
+    # record to MCP
+    try:
+        requests.post(f"{MCP_API.rstrip('/')}/evidence/decisions", json={"payload": decision_payload, "signature": sig, "ts": time.time()}, timeout=3.0)
+    except Exception:
+        pass
+    return {"signature": sig}
+
+if __name__ == "__main__":
+    import sys
+    payload = {"action":"equip-change","who":"coach-1","detail":"adjust angle by 2deg","ts":time.time()}
+    print(sign_decision(payload))
