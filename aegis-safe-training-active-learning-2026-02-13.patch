+#!/usr/bin/env python3
+"""
+Simple human-in-the-loop approval service.
+ - POST /request  -> {action_id, summary}  returns request id (pending)
+ - POST /approve -> {request_id, approver, decision}
+ - GET /status/<id> -> status
+
+This keeps a durable SQLite store for basic auditing and can emit signed receipts via receipt_signer.
+"""
+from flask import Flask, request, jsonify
+import sqlite3, os, time, json, requests
+from datetime import datetime
+
+DB = os.environ.get("A2A_DB", "/data/a2a.db")
+SIGNER_URL = os.environ.get("RECEIPT_SIGNER_URL", "http://receipt-signer:8080/sign")
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+app = Flask(__name__)
+os.makedirs(os.path.dirname(DB), exist_ok=True)
+conn = sqlite3.connect(DB, check_same_thread=False)
+conn.execute("""CREATE TABLE IF NOT EXISTS requests (
+    id TEXT PRIMARY KEY,
+    action_id TEXT,
+    summary TEXT,
+    status TEXT,
+    created_ts TEXT,
+    resolved_ts TEXT,
+    approver TEXT,
+    decision TEXT,
+    evidence TEXT
+)""")
+conn.commit()
+
+def sign_and_record_evidence(req):
+    payload = {"action_id": req["action_id"], "summary": req["summary"], "timestamp": req["resolved_ts"], "decision": req["decision"], "approver": req["approver"]}
+    try:
+        r = requests.post(SIGNER_URL, json=payload, timeout=5.0)
+        if r.ok:
+            sig = r.json()
+            # write to MCP
+            try:
+                requests.post(f"{MCP_API.rstrip('/')}/a2a/evidence", json={"request": payload, "signature": sig}, timeout=3.0)
+            except Exception:
+                pass
+            return json.dumps(sig)
+    except Exception:
+        pass
+    return ""
+
+@app.route("/request", methods=["POST"])
+def make_request():
+    j = request.json or {}
+    rid = j.get("request_id") or f"req-{int(time.time()*1000)}"
+    action_id = j.get("action_id", "action")
+    summary = j.get("summary", "")
+    now = datetime.utcnow().isoformat()+"Z"
+    conn.execute("INSERT OR REPLACE INTO requests (id,action_id,summary,status,created_ts) VALUES (?,?,?,?,?)", (rid, action_id, summary, "PENDING", now))
+    conn.commit()
+    return jsonify({"request_id": rid, "status": "PENDING"})
+
+@app.route("/approve", methods=["POST"])
+def approve():
+    j = request.json or {}
+    rid = j.get("request_id")
+    approver = j.get("approver", "unknown")
+    decision = j.get("decision", "approved")
+    now = datetime.utcnow().isoformat()+"Z"
+    cur = conn.execute("SELECT action_id,summary FROM requests WHERE id=?", (rid,))
+    row = cur.fetchone()
+    if not row:
+        return jsonify({"error":"not found"}), 404
+    action_id, summary = row
+    conn.execute("UPDATE requests SET status=?,resolved_ts=?,approver=?,decision=? WHERE id=?", ("RESOLVED", now, approver, decision, rid))
+    conn.commit()
+    req = {"action_id": action_id, "summary": summary, "resolved_ts": now, "approver": approver, "decision": decision}
+    evidence = sign_and_record_evidence(req)
+    conn.execute("UPDATE requests SET evidence=? WHERE id=?", (evidence, rid))
+    conn.commit()
+    return jsonify({"request_id": rid, "status": "RESOLVED", "evidence": evidence})
+
+@app.route("/status/<rid>", methods=["GET"])
+def status(rid):
+    cur = conn.execute("SELECT id,action_id,summary,status,created_ts,resolved_ts,approver,decision FROM requests WHERE id=?", (rid,))
+    row = cur.fetchone()
+    if not row:
+        return jsonify({"error":"not found"}), 404
+    keys = ["id","action_id","summary","status","created_ts","resolved_ts","approver","decision"]
+    return jsonify(dict(zip(keys,row)))
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8082")))
+
