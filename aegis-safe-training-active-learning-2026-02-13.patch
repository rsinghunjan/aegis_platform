+"""
+Enhanced Consent Manager with opt-out and explainability logging endpoints.
+Stores consents and opt-outs; provides explainability request logging for legal review.
+"""
+from flask import Flask, request, jsonify
+import sqlite3, os, json
+from datetime import datetime, timedelta
+
+DB_PATH = os.environ.get("CONSENT_DB", "/data/consent_v3.db")
+app = Flask(__name__)
+os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+conn = sqlite3.connect(DB_PATH, check_same_thread=False)
+conn.execute("""CREATE TABLE IF NOT EXISTS consents_v3 (
+    id TEXT PRIMARY KEY,
+    subject_id TEXT,
+    scope TEXT,
+    granted INTEGER,
+    granted_ts TEXT,
+    expires_ts TEXT,
+    metadata TEXT,
+    opted_out INTEGER DEFAULT 0
+)""")
+conn.execute("""CREATE TABLE IF NOT EXISTS explainability_requests (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    subject_id TEXT,
+    request_ts TEXT,
+    details TEXT
+)""")
+conn.commit()
+
+@app.route("/consent", methods=["POST"])
+def grant():
+    j = request.json or {}
+    subject = j.get("subject_id")
+    scope = j.get("scope", "general")
+    duration_days = int(j.get("duration_days", 365))
+    metadata = j.get("metadata", {})
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    uid = f"{subject}-{scope}"
+    now = datetime.utcnow()
+    expires = now + timedelta(days=duration_days)
+    conn.execute("REPLACE INTO consents_v3 (id,subject_id,scope,granted,granted_ts,expires_ts,metadata,opted_out) VALUES (?,?,?,?,?,?,?,?)",
+                 (uid, subject, scope, 1, now.isoformat()+"Z", expires.isoformat()+"Z", json.dumps(metadata), 0))
+    conn.commit()
+    return jsonify({"status":"granted","subject_id":subject,"scope":scope,"expires":expires.isoformat()+"Z"})
+
+@app.route("/optout", methods=["POST"])
+def optout():
+    j = request.json or {}
+    subject = j.get("subject_id")
+    scope = j.get("scope","general")
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    uid = f"{subject}-{scope}"
+    # mark opted_out; behavior: opted-out subjects are not included in training/aggregations
+    conn.execute("UPDATE consents_v3 SET opted_out=1 WHERE id=?", (uid,))
+    conn.commit()
+    return jsonify({"status":"opted_out","subject_id":subject,"scope":scope})
+
+@app.route("/consent", methods=["GET"])
+def check():
+    subject = request.args.get("subject_id")
+    scope = request.args.get("scope","general")
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    uid = f"{subject}-{scope}"
+    cur = conn.execute("SELECT granted,expires_ts,opted_out,metadata FROM consents_v3 WHERE id=?", (uid,))
+    row = cur.fetchone()
+    if not row:
+        return jsonify({"consent": False})
+    granted, expires_ts, opted_out, metadata = row
+    if opted_out:
+        return jsonify({"consent": False, "opted_out": True})
+    if not granted:
+        return jsonify({"consent": False})
+    if expires_ts and datetime.fromisoformat(expires_ts.replace("Z","")) < datetime.utcnow():
+        return jsonify({"consent": False})
+    return jsonify({"consent": True, "expires": expires_ts, "metadata": json.loads(metadata or "{}")})
+
+@app.route("/explainability/request", methods=["POST"])
+def explain_request():
+    j = request.json or {}
+    subject = j.get("subject_id")
+    details = j.get("details", "")
+    if not subject:
+        return jsonify({"error":"subject_id required"}), 400
+    now = datetime.utcnow().isoformat()+"Z"
+    conn.execute("INSERT INTO explainability_requests (subject_id, request_ts, details) VALUES (?,?,?)", (subject, now, details))
+    conn.commit()
+    # In production, trigger legal/review workflow (MCP/Jira)
+    return jsonify({"status":"queued","subject_id":subject,"ts": now})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
