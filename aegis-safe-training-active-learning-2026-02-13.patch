+#!/usr/bin/env python3
+"""
+cross_validation.py
+Simple k-fold cross-validation runner that logs metrics to MLflow (if configured).
+Use to validate models against domain-randomized + real data to detect overfitting.
+
+Usage:
+  python cross_validation.py --data data.csv --model sklearn:LogisticRegression --k 5
+"""
+import argparse
+import os
+import time
+import numpy as np
+from sklearn.model_selection import KFold
+from sklearn.metrics import mean_squared_error, accuracy_score
+import joblib
+import mlflow
+
+def load_csv(path):
+    import pandas as pd
+    df = pd.read_csv(path)
+    # Expect features columns prefixed with feat_ and label column 'label'
+    X = df[[c for c in df.columns if c.startswith("feat_")]].values
+    y = df["label"].values
+    return X, y
+
+def run_cv(model, X, y, k=5, mlflow_run_name=None):
+    kf = KFold(n_splits=k, shuffle=True, random_state=42)
+    fold = 0
+    scores = []
+    if mlflow_run_name:
+        mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI", ""))
+        mlflow.start_run(run_name=mlflow_run_name)
+        mlflow.log_param("k", k)
+    for train_idx, test_idx in kf.split(X):
+        fold += 1
+        X_train, X_test = X[train_idx], X[test_idx]
+        y_train, y_test = y[train_idx], y[test_idx]
+        model.fit(X_train, y_train)
+        preds = model.predict(X_test)
+        acc = accuracy_score(y_test, preds)
+        mse = mean_squared_error(y_test, preds)
+        scores.append({"fold": fold, "accuracy": float(acc), "mse": float(mse)})
+        if mlflow_run_name:
+            mlflow.log_metric("fold_accuracy", float(acc), step=fold)
+            mlflow.log_metric("fold_mse", float(mse), step=fold)
+    if mlflow_run_name:
+        mlflow.log_metric("cv_mean_accuracy", float(np.mean([s["accuracy"] for s in scores])))
+        mlflow.end_run()
+    return scores
+
+def main(data_path, k, model_out):
+    X, y = load_csv(data_path)
+    # Simple default model (replaceable)
+    from sklearn.ensemble import RandomForestClassifier
+    model = RandomForestClassifier(n_estimators=50, random_state=42)
+    scores = run_cv(model, X, y, k=k, mlflow_run_name=f"cv-{int(time.time())}")
+    print("CV scores:", scores)
+    joblib.dump(model, model_out)
+    print("Saved model to", model_out)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--data", required=True)
+    p.add_argument("--k", type=int, default=5)
+    p.add_argument("--model-out", default="model.joblib")
+    args = p.parse_args()
+    main(args.data, args.k, args.model_out)
+
