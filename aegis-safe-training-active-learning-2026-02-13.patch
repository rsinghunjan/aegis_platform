+#!/usr/bin/env python3
+"""
+federated_cv.py
+Orchestrates a lightweight federated cross-validation experiment:
+ - asks clients to run local CV and return metrics
+ - aggregates metrics (and optionally model updates) centrally for robust evaluation
+
+This is a prototype: production should include authentication, secure channels and secure aggregation.
+"""
+import os
+import time
+import requests
+import numpy as np
+
+CLIENTS = os.environ.get("FED_CLIENTS", "http://client1:8080,http://client2:8080").split(",")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def collect_client_cv(round_id="r1"):
+    results = []
+    for c in CLIENTS:
+        try:
+            r = requests.get(f"{c.rstrip('/')}/local_cv?round={round_id}", timeout=20)
+            if r.ok:
+                results.append(r.json())
+        except Exception as e:
+            print("client error", c, e)
+    return results
+
+def aggregate_metrics(metrics_list):
+    # metrics_list = [{"folds":[{"accuracy":..},...]}, ...]
+    accs = []
+    for m in metrics_list:
+        for f in m.get("folds", []):
+            accs.append(f.get("accuracy", 0.0))
+    if not accs:
+        return {}
+    return {"mean_accuracy": float(np.mean(accs)), "std_accuracy": float(np.std(accs))}
+
+def main():
+    round_id = str(int(time.time()))
+    clients = collect_client_cv(round_id)
+    agg = aggregate_metrics(clients)
+    print("Aggregated federated CV:", agg)
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/federated/cv", json={"round": round_id, "agg": agg}, timeout=3.0)
+    except Exception:
+        pass
+
+if __name__ == "__main__":
+    main()
