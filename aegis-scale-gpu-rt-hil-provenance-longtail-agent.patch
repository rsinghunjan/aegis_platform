+---- MODULE AgentInvariant ----
+EXTENDS Naturals, Sequences
+
+(* Simple example spec: "Agent never issues throttle > MAX when brake engaged" *)
+CONSTANTS MAX_THROTTLE
+
+VARIABLES time, actions, brake_engaged
+
+Init == /\ time = 0
+        /\ actions = << >>
+        /\ brake_engaged = FALSE
+
+Next ==
+    \E a \in {"navigate","throttle","brake","noop"}:
+        /\ time' = time + 1
+        /\ actions' = Append(actions, a)
+        /\ IF a = "brake" THEN brake_engaged' = TRUE ELSE brake_engaged' = brake_engaged
+
+Invariant == \A i \in 1..Len(actions): ~(actions[i] = "throttle" /\ brake_engaged)
+
+======
