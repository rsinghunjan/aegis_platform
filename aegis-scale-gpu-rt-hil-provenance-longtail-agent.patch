+#!/usr/bin/env python3
+"""
+Runtime constraint enforcer for agent actions.
+ - Subscribes to action events (simple file-tail subscriber or HTTP callback) and enforces JSON-defined runtime constraints.
+ - On violation, issues E-STOP (calls estop adapter) and records evidence.
+"""
+import argparse, json, time, requests, os
+
+def load_policy(path):
+    return json.load(open(path))
+
+def check(action, state, policy):
+    # Example rule: if brake_engaged in state and action.type == "throttle" => violation
+    if state.get("brake_engaged") and action.get("type") == "throttle":
+        return False, "throttle_with_brake"
+    return True, ""
+
+def estop_call(endpoint, reason):
+    try:
+        requests.post(endpoint + "/update", json={"estop": True, "reason": reason}, timeout=2)
+    except Exception as e:
+        print("Failed to call estop:", e)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy", required=True)
+    p.add_argument("--action-log", required=True)
+    p.add_argument("--estop-endpoint", default="http://localhost:9200")
+    args = p.parse_args()
+    policy = load_policy(args.policy)
+    # naive tail: read lines as actions
+    with open(args.action_log) as fh:
+        for line in fh:
+            action = json.loads(line)
+            # state can be tracked or provided; simple example: check last state in action
+            state = action.get("state", {})
+            ok, reason = check(action, state, policy)
+            if not ok:
+                print("Policy violation detected:", reason)
+                estop_call(args.estop_endpoint, reason)
+                # record evidence
+                try:
+                    from ops.sdk.evidence_sdk import record_manifest
+                    record_manifest("agent_policy_violation", {"action": action, "reason": reason})
+                except Exception:
+                    pass
+
