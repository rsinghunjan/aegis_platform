+#!/usr/bin/env python3
+"""
+Run RT sweeps for an exact topology described in a YAML file, validate SLOs, produce signed proof bundles,
+and upload to S3 + Rekor verification.
+"""
+import argparse, yaml, os, subprocess, json
+from datetime import datetime
+
+def load_targets(path):
+    with open(path) as fh:
+        return yaml.safe_load(fh).get("targets", [])
+
+def run_sweep_for(target, outdir, cosign_key=None):
+    os.makedirs(outdir, exist_ok=True)
+    env = os.environ.copy()
+    env["TARGETS"] = f"{target['host']}:{target['iface']}"
+    # call existing run script if present
+    cmd = ["./ops/av/rt/run_hw_rt_sweep.sh", outdir]
+    print("Running sweep for", target["name"], cmd)
+    try:
+        subprocess.check_call(cmd, env=env)
+    except Exception as e:
+        print("Sweep failed:", e)
+    proof = os.path.join(outdir, "rt_slo_proof.json")
+    if os.path.exists(proof):
+        # sign bundle (best-effort)
+        bundle = os.path.join(outdir, f"{target['name']}_proof_bundle.tar.gz")
+        subprocess.call(["tar","-czf",bundle,"-C",outdir,"."])
+        if cosign_key:
+            try:
+                subprocess.check_call(["cosign","sign","--key",cosign_key,bundle])
+            except Exception as e:
+                print("cosign sign failed:", e)
+        return proof, bundle
+    return None, None
+
+def validate_slo(proof_path, p99_thresh, safe_thresh):
+    with open(proof_path) as fh:
+        j = json.load(fh)
+    return (j.get("p99_ms",9999) <= p99_thresh) and (j.get("safe_ms",9999) <= safe_thresh)
+
+def upload_to_s3(path, s3_uri):
+    try:
+        subprocess.check_call(["aws","s3","cp",path, s3_uri])
+        return True
+    except Exception as e:
+        print("s3 upload failed:", e)
+        return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--targets-yaml", required=True)
+    p.add_argument("--out", default=f"/tmp/rt_multi_{int(datetime.utcnow().timestamp())}")
+    p.add_argument("--cosign", default=os.environ.get("COSIGN_KMS_URI",""))
+    p.add_argument("--s3", default=os.environ.get("S3_UPLOAD",""))
+    p.add_argument("--p99-threshold", type=float, default=0.5)
+    p.add_argument("--safe-threshold-ms", type=float, default=50.0)
+    args = p.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+    targets = load_targets(args.targets_yaml)
+    summary = {"run_at": datetime.utcnow().isoformat()+"Z", "results": []}
+    for t in targets:
+        od = os.path.join(args.out, t["name"])
+        proof, bundle = run_sweep_for(t, od, cosign_key=args.cosign)
+        ok = False
+        if proof:
+            ok = validate_slo(proof, args.p99_threshold, args.safe_threshold_ms)
+            if args.s3 and bundle:
+                upload_to_s3(bundle, os.path.join(args.s3, os.path.basename(bundle)))
+        summary["results"].append({"target": t["name"], "proof": proof, "bundle": bundle, "ok": ok})
+    summary_path = os.path.join(args.out, "summary.json")
+    with open(summary_path, "w") as fh:
+        json.dump(summary, fh, indent=2)
+    print("RT multi sweep complete. Summary:", summary_path)
+
+if __name__=="__main__":
+    main()
+
