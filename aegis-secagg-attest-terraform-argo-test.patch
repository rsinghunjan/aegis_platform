+name: Build SecAgg Wheel and FL image (hardened)
+on:
+  workflow_dispatch:
+    inputs:
+      secagg_repo:
+        description: 'Secure-agg source repo'
+        required: false
+        default: 'https://github.com/google/secagg.git'
+      secagg_tag:
+        description: 'Secure-agg tag/commit to build'
+        required: false
+        default: 'v0.0.0-placeholder'
+jobs:
+  build_wheel:
+    runs-on: self-hosted
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build wheel (hardened builder)
+        env:
+          OUTDIR: /tmp/secagg_wheels
+        run: |
+          mkdir -p /tmp/secagg_wheels
+          bash ops/fl/secureagg/build_secagg_wheel.sh "${{ github.event.inputs.secagg_repo }}" "${{ github.event.inputs.secagg_tag }}" 
+      - name: Upload wheel artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: secagg-wheels
+          path: /tmp/secagg_wheels
+
+  build_fl_image:
+    runs-on: ubuntu-latest
+    needs: build_wheel
+    steps:
+      - uses: actions/checkout@v4
+      - name: Download wheel artifact
+        uses: actions/download-artifact@v4
+        with:
+          name: secagg-wheels
+      - name: Build FL runtime image with wheel
+        env:
+          REG: ${{ secrets.CONTAINER_REGISTRY }}
+        run: |
+          # Copy wheels into build context then build runtime image
+          mkdir -p docker_context/tmp/wheels
+          cp -r /home/runner/work/_temp/secagg-wheels/* docker_context/tmp/wheels/ || true
+          cp -r ops/fl docker_context/ops/fl
+          docker build -t "${REG}/aegis-fl:secagg" -f ops/fl/docker/Dockerfile.fl-with-secagg docker_context --build-arg SECAGG_WHEEL_DIR=/tmp/wheels
+          echo "Push to registry (configure auth on runner)"
+          docker push "${REG}/aegis-fl:secagg" || true
+      - name: Run runtime validation (import check)
+        run: |
+          docker run --rm "${{ secrets.CONTAINER_REGISTRY }}/aegis-fl:secagg" python3 - <<'PY'
+import sys
+try:
+    import secagg
+    print("secagg import ok")
+except Exception as e:
+    try:
+        import crypten
+        print("crypten import ok")
+    except Exception as e2:
+        print("No secure aggregation lib installed:", e, e2)
+        sys.exit(2)
