+#!/usr/bin/env python3
+"""
+Minimal runtime validator that confirms a vetted secure-aggregation package is importable
+and exercises a small function (if available).
+Exits non-zero if neither secagg nor crypten can be imported.
+"""
+import sys
+try:
+    import secagg  # type: ignore
+    print("secagg available:", getattr(secagg, '__version__', 'unknown'))
+    sys.exit(0)
+except Exception as e:
+    try:
+        import crypten  # type: ignore
+        print("crypten available:", getattr(crypten, '__version__', 'unknown'))
+        sys.exit(0)
+    except Exception as e2:
+        print("No secure aggregation library available:", e, e2)
+        sys.exit(2)
+
