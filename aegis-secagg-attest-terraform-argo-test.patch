+FROM python:3.11-slim
+WORKDIR /workspace
+COPY ops/fl /workspace/ops/fl
+# If wheel(s) are supplied at build time, copy them into the image and install
+ARG SECAGG_WHEEL_DIR=/tmp/wheels
+COPY ${SECAGG_WHEEL_DIR:-/tmp/wheels} /tmp/wheels
+RUN set -eux; \
+    if [ -d /tmp/wheels ]; then \
+      pip install --no-cache-dir /tmp/wheels/* || true; \
+    fi; \
+    pip install --no-cache-dir -r /workspace/ops/fl/requirements.txt || true
+ENTRYPOINT ["python3"]
+
+# NOTES:
+# - Build process should inject pinned wheel artifacts into build context (use builder container to produce wheel).
+# - The runtime image will error at startup if no vetted library installed and AEGIS_ENV=production.
