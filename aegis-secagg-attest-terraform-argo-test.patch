+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Test harness for Argo remediation: posts a synthetic Alertmanager webhook to the alert handler,
+# waits a short period and queries Argo Workflows to see if remediation workflow executed.
+ALERTHANDLER_URL=${1:-http://alert-handler.aegis-app.svc:7071/alert}
+ARGO_NS=${ARGO_NS:-aegis-app}
+
+echo "Posting synthetic alert to $ALERTHANDLER_URL"
+curl -s -X POST -H "Content-Type: application/json" -d '[{"labels":{"alertname":"High_Hallucination_Rate","severity":"critical"}}]' "$ALERTHANDLER_URL"
+echo "Sleeping 10s to allow workflow submission..."
+sleep 10
+echo "List recent Argo workflows"
+kubectl -n "$ARGO_NS" get wf --sort-by=.metadata.creationTimestamp -o json | jq '.items | .[-5:] | .[] | {name:.metadata.name, phase:.status.phase}' || true
+echo "If a remediation workflow appears with phase Succeeded, remediation test succeeded."
+
