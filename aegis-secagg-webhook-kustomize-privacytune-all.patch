+#!/usr/bin/env python3
+"""
+PySyft POC: minimal server that registers shares using a PySyft Virtual Machine.
+
+This is a proof-of-concept that demonstrates the integration points for PySyft.
+PySyft API evolves; this example uses the high-level VirtualMachine API available
+in the 0.5/0.6 series. If you run into API issues, install the matching syft
+version pinned in requirements.txt and consult PySyft docs for that release.
+
+Endpoints:
+ - POST /submit_share  { "client_id": "...", "share": <base64-json> }
+ - POST /aggregate     -> returns {"aggregate": [...]}
+
+Notes:
+ - This POC stores shares in-memory. Replace storage with durable store (S3/Vault) before production.
+ - Replace the placeholder reconstruction with proper MPC primitives from PySyft or CrypTen when hardening.
+"""
+import base64
+import json
+import os
+from flask import Flask, request, jsonify
+
+try:
+    import syft as sy  # type: ignore
+    # The server does not start PyGrid; we instantiate a local VirtualMachine for demonstration.
+except Exception as e:
+    sy = None
+    print("PySyft import failed; install syft==0.6.0 to use this POC:", e)
+
+app = Flask(__name__)
+STORAGE = {}
+
+@app.route("/submit_share", methods=["POST"])
+def submit_share():
+    body = request.get_json() or {}
+    client = body.get("client_id")
+    share_b64 = body.get("share")
+    if not client or not share_b64:
+        return jsonify({"error": "client_id and share required"}), 400
+    try:
+        raw = base64.b64decode(share_b64)
+        share = json.loads(raw.decode("utf-8"))
+    except Exception as e:
+        return jsonify({"error": f"invalid share: {e}"}), 400
+    STORAGE[client] = share
+    return jsonify({"ok": True}), 200
+
+@app.route("/aggregate", methods=["POST"])
+def aggregate():
+    # Placeholder aggregation - in a real PySyft integration, reconstruct via MPC primitives
+    clients = sorted(STORAGE.keys())
+    if not clients:
+        return jsonify({"error": "no shares"}), 404
+    agg = None
+    for c in clients:
+        arr = STORAGE[c]
+        if agg is None:
+            agg = arr.copy()
+        else:
+            agg = [a + b for a, b in zip(agg, arr)]
+    return jsonify({"aggregate": agg, "clients": clients}), 200
+
+@app.route("/status", methods=["GET"])
+def status():
+    return jsonify({"ok": True, "stored_shares": len(STORAGE)})
+
+if __name__ == "__main__":
+    port = int(os.environ.get("SECAGG_PORT", "8203"))
+    app.run(host="0.0.0.0", port=port)
+
