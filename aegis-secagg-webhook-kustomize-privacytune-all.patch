+#!/usr/bin/env python3
+"""
+Run a privacy tuning sweep on a provided dataset CSV.
+
+Input dataset format: one row per example; the local DP trainer uses random labels (toy)
+but this runner accepts an arbitrary CSV path and launches the tune_runner.
+
+Outputs:
+ - /tmp/privacy_tuning_results.csv
+ - MLflow logs (if MLFLOW_TRACKING_URI set)
+"""
+import argparse, os, subprocess, shutil
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--dataset", required=True, help="Path to dataset CSV (used for records)")
+    p.add_argument("--noise", nargs="+", default=["0.5","1.0","1.5"])
+    p.add_argument("--sr", nargs="+", default=["0.01","0.02"])
+    p.add_argument("--out", default="/tmp/privacy_tuning_results.csv")
+    args = p.parse_args()
+
+    # copy dataset into expected dataset location if needed
+    if not os.path.exists(args.dataset):
+        raise SystemExit("Dataset not found: " + args.dataset)
+
+    # call existing tune_runner.py with parameters
+    cmd = [
+        "python3", "services/fl/privacy_tune/tune_runner.py",
+        "--noise"
+    ] + args.noise + ["--sr"] + args.sr + ["--out", args.out]
+    print("Running command:", " ".join(cmd))
+    subprocess.check_call(cmd)
+    print("Privacy tuning finished. Results at", args.out)
+
+if __name__=="__main__":
+    main()
+
