+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Setup Python
+        uses: actions/setup-python@v4
+        with:
+          python-version: "3.10"
+      - name: Find images in manifests
+        id: images
+        run: |
+          python - <<'PY'
+          import yaml,sys,glob,re
+          imgs=set()
+          for fn in glob.glob('k8s/**/*.yaml', recursive=True)+glob.glob('k8s/*.yaml'):
+              try:
+                  for doc in yaml.safe_load_all(open(fn)):
+                      if isinstance(doc, dict):
+                          def find_images(obj):
+                              if isinstance(obj, dict):
+                                  for k,v in obj.items():
+                                      if k=='image' and isinstance(v,str):
+                                          imgs.add(v)
+                                      else:
+                                          find_images(v)
+                              elif isinstance(obj, list):
+                                  for it in obj: find_images(it)
+                          find_images(doc)
+              except Exception:
+                  pass
+          for i in sorted(imgs):
+              print(i)
+          print('::set-output name=images::' + ','.join(sorted(imgs)))
+          PY
+      - name: Verify cosign signatures for referenced images
+        env:
+          COSIGN_PUB_KEY: ${{ secrets.COSIGN_PUB_KEY }}
+        run: |
+          images="${{ steps.images.outputs.images }}"
+          if [ -z "$images" ]; then echo "no images found"; exit 0; fi
+          for img in $(echo "$images" | tr ',' ' '); do
+            echo "Verifying $img"
+            cosign verify --key <(echo "$COSIGN_PUB_KEY") "$img" || { echo "Signature missing/invalid for $img"; exit 1; }
+          done
