+#!/usr/bin/env python3
+"""
+Small helper that reads a drift score (from S3/endpoint or arguments) and opens an A2A if threshold exceeded.
+Intended to be invoked by the drift detector job when a high drift score is observed.
+"""
+import os
+import sys
+import requests
+
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+THRESH = float(os.environ.get("DRIFT_A2A_THRESHOLD", "1.0"))
+
+def open_a2a_for_drift(feature, score, sample):
+    body = {"action_id": f"drift-{feature}-{int(score*1000)}", "approver":"mlops", "decision":"requested", "comment":f"Drift detected for {feature} score={score}"}
+    try:
+        r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+        if r.ok:
+            requests.post(f"{AEGIS_MCP.rstrip('/')}/monitoring/drift_a2a", json={"feature":feature,"score":score,"a2a":r.json().get("id")}, timeout=3.0)
+            print("Opened A2A", r.json().get("id"))
+    except Exception as e:
+        print("failed to open A2A", e)
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        print("usage: drift_detector_alert_to_a2a.py <feature> <score>")
+        sys.exit(2)
+    feat = sys.argv[1]
+    score = float(sys.argv[2])
+    if score >= THRESH:
+        open_a2a_for_drift(feat, score, None)
+    else:
+        print("score below threshold")
+
