+name: Sign with AWS KMS via OIDC, upload to Rekor and enforce Rekor presence
+on:
+  workflow_dispatch:
+    inputs:
+      artifact_path:
+        description: 'Path to artifact in repo (relative)'
+        required: true
+        default: 'artifact.bin'
+      kms_key_arn:
+        description: 'AWS KMS key ARN to use (kms key for signing)'
+        required: true
+      rekor_server:
+        description: 'Rekor URL (https://rekor.example.com)'
+        required: true
+jobs:
+  sign-and-check:
+    runs-on: ubuntu-latest
+    permissions:
+      id-token: write
+      contents: read
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Configure AWS credentials via OIDC (assume role)
+        uses: aws-actions/configure-aws-credentials@v2
+        with:
+          role-to-assume: ${{ secrets.AWS_SIGN_ROLE_ARN }}
+          aws-region: ${{ secrets.AWS_REGION || 'us-east-1' }}
+
+      - name: Install cosign & jq
+        run: |
+          sudo apt-get update -y
+          sudo apt-get install -y jq
+          curl -sSL -o cosign https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64
+          chmod +x cosign
+          sudo mv cosign /usr/local/bin/cosign
+
+      - name: Sign artifact using AWS KMS
+        env:
+          ARTIFACT_PATH: ${{ github.event.inputs.artifact_path }}
+          KMS_KEY_ARN: ${{ github.event.inputs.kms_key_arn }}
+          REKOR_URL: ${{ github.event.inputs.rekor_server }}
+        run: |
+          if [ ! -f "$ARTIFACT_PATH" ]; then
+            echo "Artifact not found: $ARTIFACT_PATH"
+            exit 1
+          fi
+          KMS_URI="aws-kms://$KMS_KEY_ARN"
+          echo "Signing $ARTIFACT_PATH with COSIGN KMS URI $KMS_URI"
+          cosign sign-blob --kms "$KMS_URI" --output-signature "${ARTIFACT_PATH}.sig" "$ARTIFACT_PATH"
+          ls -l "${ARTIFACT_PATH}.sig"
+
+      - name: Upload signature and artifact to Rekor (and verify)
+        env:
+          ARTIFACT_PATH: ${{ github.event.inputs.artifact_path }}
+          REKOR_URL: ${{ github.event.inputs.rekor_server }}
+        run: |
+          if [ ! -f "${ARTIFACT_PATH}.sig" ]; then
+            echo "Signature missing; abort"
+            exit 1
+          fi
+          echo "Uploading to Rekor at $REKOR_URL"
+          cosign upload-blob --rekor-url "$REKOR_URL" --signature "${ARTIFACT_PATH}.sig" "$ARTIFACT_PATH" || true
+          # Verify Rekor entry exists: check index retrieve using base64 digest
+          DIGEST=$(openssl dgst -sha256 -binary "$ARTIFACT_PATH" | openssl base64 -A)
+          echo "digest(base64)=$DIGEST"
+          SLEEP=2; ATTEMPTS=5
+          for i in $(seq 1 $ATTEMPTS); do
+            echo "Checking Rekor (attempt $i)..."
+            if curl -fsS "${REKOR_URL}/api/v1/index/retrieve?hash=${DIGEST}" | jq -e '. | length > 0' >/dev/null 2>&1; then
+              echo "Rekor entry found"
+              exit 0
+            fi
+            sleep $SLEEP
+          done
+          echo "Rekor entry not found after ${ATTEMPTS} attempts; failing workflow"
+          exit 1
+
+      - name: Persist signature as artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: cosign-signature
+          path: ${{ github.event.inputs.artifact_path }}.sig
+
