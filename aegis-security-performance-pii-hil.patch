+"""
+Celery worker to perform async verification tasks (NLI / verifier).
+ - Tasks:
+   - verify_generated_output: run NLI verifier (or call verifier service) and persist results
+   - if verifier fails, create an A2A approval request (via existing a2a_client)
+   - emit Prometheus metrics
+"""
+import os
+from celery import Celery
+import requests
+import time
+import json
+from prometheus_client import Counter
+
+BROKER = os.environ.get("CELERY_BROKER_URL", "redis://redis:6379/0")
+RESULT_BACKEND = os.environ.get("CELERY_RESULT_BACKEND", "redis://redis:6379/1")
+VERIFIER_API = os.environ.get("VERIFIER_SVC", "http://verifier:80/verify")
+A2A_API = os.environ.get("A2A_API", "http://approver:8080/request")
+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+app = Celery("verifier_worker", broker=BROKER, backend=RESULT_BACKEND)
+
+VERIFY_COUNTER = Counter("aegis_async_verify_requests_total", "Async verify requests")
+FAIL_COUNTER = Counter("aegis_async_verify_fail_total", "Async verify failures")
+
+def create_approval(model_id, artifact_uri, reason, metadata=None):
+    payload = {
+        "model_id": model_id,
+        "artifact_uri": artifact_uri,
+        "approver": "system",
+        "decision": "request_review",
+        "comment": reason
+    }
+    try:
+        # The approver service requires authentication in prod; this is a best-effort call
+        r = requests.post(A2A_API, json=payload, timeout=5.0)
+        if r.ok:
+            return r.json().get("id")
+    except Exception:
+        pass
+    return None
+
+@app.task(bind=True, name="verify_generated_output")
+def verify_generated_output(self, model_id, run_id, output_text, retrieved_docs):
+    VERIFY_COUNTER.inc()
+    try:
+        r = requests.post(VERIFIER_API, json={"text": output_text, "retrieved_docs": retrieved_docs}, timeout=30.0)
+        r.raise_for_status()
+        res = r.json()
+    except Exception as e:
+        FAIL_COUNTER.inc()
+        # In case of verifier unavailable, create approval request
+        approval_id = create_approval(model_id, f"run://{run_id}", f"verifier_unavailable: {e}")
+        # record pending state to MCP (best-effort)
+        try:
+            requests.post(f"{MCP_API.rstrip('/')}/models/{model_id}/context", json={"model_id": model_id, "evaluation": {"run_id": run_id, "verifier": "unavailable", "approval_id": approval_id}}, timeout=5.0)
+        except Exception:
+            pass
+        return {"allow": False, "reason": "verifier_unavailable", "approval_id": approval_id}
+
+    if not res.get("allow", True):
+        FAIL_COUNTER.inc()
+        approval_id = create_approval(model_id, f"run://{run_id}", "verifier_reject", {"score": res.get("score")})
+        # persist to MCP
+        try:
+            requests.post(f"{MCP_API.rstrip('/')}/models/{model_id}/context", json={"model_id": model_id, "evaluation": {"run_id": run_id, "verifier": res, "approval_id": approval_id}}, timeout=5.0)
+        except Exception:
+            pass
+        return {"allow": False, "approval_id": approval_id, "score": res.get("score")}
+
+    # Persist success to MCP
+    try:
+        requests.post(f"{MCP_API.rstrip('/')}/models/{model_id}/context", json={"model_id": model_id, "evaluation": {"run_id": run_id, "verifier": res}}, timeout=5.0)
+    except Exception:
+        pass
+    return {"allow": True, "score": res.get("score")}
+
