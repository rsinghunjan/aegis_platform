+#!/usr/bin/env python3
+"""
+Encrypt and store original artifacts via KMS and S3.
+POST /encrypt (multipart file) -> returns s3_key pointer
+"""
+import os
+from fastapi import FastAPI, File, UploadFile, HTTPException
+import boto3
+import uuid
+
+app = FastAPI(title="Aegis Encrypt Service")
+S3_BUCKET = os.environ.get("ORIGINALS_S3_BUCKET")
+KMS_KEY_ID = os.environ.get("ORIGINALS_KMS_KEY_ID")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+
+if not S3_BUCKET or not KMS_KEY_ID:
+    app.logger = None
+
+@app.post("/encrypt")
+async def encrypt(file: UploadFile = File(...)):
+    body = await file.read()
+    if not S3_BUCKET or not KMS_KEY_ID:
+        raise HTTPException(status_code=500, detail="Storage not configured")
+    s3 = boto3.client("s3", region_name=REGION)
+    kms = boto3.client("kms", region_name=REGION)
+    # Generate a data key
+    dk = kms.generate_data_key(KeyId=KMS_KEY_ID, KeySpec="AES_256")
+    plaintext_key = dk["Plaintext"]
+    ciphertext_key = dk["CiphertextBlob"]
+    # Encrypt object with data key locally (simple xor not recommended; use proper envelope encryption with aws-sdk)
+    # For brevity, we upload plaintext encrypted with KMS via S3 server-side encryption using KMS (SSE-KMS)
+    s3_key = f"originals/{uuid.uuid4().hex}/{file.filename}"
+    s3.put_object(Bucket=S3_BUCKET, Key=s3_key, Body=body, ServerSideEncryption='aws:kms', SSEKMSKeyId=KMS_KEY_ID)
+    return {"s3_key": s3_key}
+
