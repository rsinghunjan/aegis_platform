+"""
+Async-capable preflight wrapper.
+ - performs moderation and PII redaction synchronously
+ - if verifier is heavy, submits verification to async worker and returns pending state
+ - when PII redaction occurs, it optionally encrypts & stores original via encrypt service and attaches pointer
+"""
+import os, requests, time, uuid, logging
+from .a2a_client import request_approval
+
+LOG = logging.getLogger("aegis.preflight_async")
+
+MOD_SVC = os.environ.get("MODERATION_SVC", "http://moderation:80")
+PII_SVC = os.environ.get("PII_SVC", "http://pii:80")
+ENCRYPT_SVC = os.environ.get("ENCRYPT_SVC", "http://encrypt-service:8080/encrypt")
+ASYNC_WORKER_API = os.environ.get("ASYNC_WORKER_API", "http://verifier-async-worker:80")
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def call_moderation(text):
+    try:
+        r = requests.post(f"{MOD_SVC.rstrip('/')}/moderate_text", json={"text": text}, timeout=3.0)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        LOG.warning("moderation call failed: %s", e)
+        return {"nsfw": False}
+
+def call_pii_scan(text):
+    try:
+        r = requests.post(f"{PII_SVC.rstrip('/')}/scan_text", json={"text": text}, timeout=3.0)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        LOG.warning("pii scan failed: %s", e)
+        return {"count": 0, "pii": []}
+
+def call_pii_redact(text):
+    try:
+        r = requests.post(f"{PII_SVC.rstrip('/')}/redact_text", json={"text": text}, timeout=5.0)
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        LOG.warning("pii redact failed: %s", e)
+        return {"redacted": text, "pii": []}
+
+def encrypt_and_store_original(file_bytes, filename, metadata=None):
+    try:
+        r = requests.post(ENCRYPT_SVC, files={"file": (filename, file_bytes)}, timeout=30.0)
+        r.raise_for_status()
+        return r.json().get("s3_key")
+    except Exception as e:
+        LOG.warning("encrypt store failed: %s", e)
+        return None
+
+def submit_async_verifier(model_id, run_id, output_text, retrieved_docs):
+    # call the async worker REST endpoint which will schedule the verify task
+    try:
+        payload = {"model_id": model_id, "run_id": run_id, "text": output_text, "retrieved_docs": retrieved_docs}
+        r = requests.post(f"{ASYNC_WORKER_API.rstrip('/')}/verify", json=payload, timeout=5.0)
+        if r.ok:
+            return r.json()  # expected to return {"task_id": "..."}
+    except Exception as e:
+        LOG.warning("async verify submit failed: %s", e)
+    return None
+
+def run_preflight_async(model_id, run_id, input_text, generated_output, retrieved_docs, options=None):
+    options = options or {}
+
+    # 1) input moderation
+    mod_in = call_moderation(input_text)
+    if mod_in.get("nsfw", False):
+        approval_id = request_approval(model_id, f"run://{run_id}", "input contains NSFW", {"stage": "input", "hits": mod_in.get("hits")})
+        return {"allow": False, "pending": True, "approval_id": approval_id, "reason": "input_nsfw"}
+
+    # 2) PII scan/redact (sync)
+    pii_scan = call_pii_scan(generated_output)
+    if pii_scan.get("count", 0) > 0:
+        # encrypt & store original via encrypt service
+        s3_key = encrypt_and_store_original(generated_output.encode("utf-8"), f"{run_id}.txt", metadata={"pii": pii_scan})
+        redacted = call_pii_redact(generated_output).get("redacted")
+        # attach pointer to MCP evidence
+        try:
+            requests.post(f"{AEGIS_MCP_API.rstrip('/')}/models/{model_id}/context", json={"model_id": model_id, "evaluation": {"run_id": run_id, "pii_original_s3": s3_key}}, timeout=5.0)
+        except Exception:
+            pass
+    else:
+        redacted = generated_output
+
+    # 3) moderation on redacted output
+    mod_out = call_moderation(redacted)
+    if mod_out.get("nsfw", False):
+        approval_id = request_approval(model_id, f"run://{run_id}", "output contains NSFW", {"stage": "output", "hits": mod_out.get("hits")})
+        return {"allow": False, "pending": True, "approval_id": approval_id, "reason": "output_nsfw"}
+
+    # 4) submit verifier async (to avoid blocking UX)
+    submit = submit_async_verifier(model_id, run_id, redacted, retrieved_docs or [])
+    if submit:
+        # return pending and let async worker create A2A if verifier fails
+        return {"allow": False, "pending": True, "task": submit}
+    # fallback: if async submission failed, attempt direct call (best effort)
+    try:
+        r = requests.post(f"{os.environ.get('VERIFIER_SVC','http://verifier:80')}/verify", json={"text": redacted, "retrieved_docs": retrieved_docs or []}, timeout=10.0)
+        if r.ok and r.json().get("allow", True):
+            return {"allow": True, "output": redacted}
+        else:
+            approval_id = request_approval(model_id, f"run://{run_id}", "verifier_reject", {"score": r.json().get("score")})
+            return {"allow": False, "pending": True, "approval_id": approval_id}
+    except Exception:
+        approval_id = request_approval(model_id, f"run://{run_id}", "verifier_unavailable")
+        return {"allow": False, "pending": True, "approval_id": approval_id}
+
