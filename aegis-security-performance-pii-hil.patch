+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run a real-time (RT) benchmark on a node and post results to MCP
+# Requires cyclictest installed on node (from rt-tests package)
+#
+OUT="/tmp/rt_benchmark_$(date +%s).json"
+AEGIS_MCP_API=${AEGIS_MCP_API:-http://mcp:8082}
+MODEL_ID=${1:-"rt-benchmark"}
+
+if command -v cyclictest >/dev/null 2>&1; then
+  # run short cyclictest; adjust parameters for your lab
+  cyclictest -m -p 80 -n -i 100 -l 10000 > /tmp/cyclictest.out || true
+  MAX_LAT=$(grep "max" /tmp/cyclictest.out | awk '{print $2}' | tr -d 'ms' || true)
+  echo "{\"max_latency_ms\": \"${MAX_LAT}\"}" > "$OUT"
+else
+  echo "{\"note\": \"cyclictest not installed, please install rt-tests\"}" > "$OUT"
+fi
+
+# post to MCP (best-effort)
+if [ -f "$OUT" ]; then
+  curl -sS -X POST "$AEGIS_MCP_API/models/${MODEL_ID}/context" -H "Content-Type: application/json" --data-binary @"$OUT" || true
+  echo "Posted benchmark to MCP: $OUT"
+fi
+
+cat "$OUT"
+
