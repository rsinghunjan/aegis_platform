+#!/usr/bin/env python3
+"""
+Simple automated rollback controller.
+- Polls Prometheus for a configured alert/metric (e.g. verifier_failures_total) and if threshold breached,
+  marks the offending deployment with an annotation and scales rollout to zero (safe-stop).
+ - This is a conservative example — in production, integrate with your CD system and use rollout/undo APIs.
+"""
+import os, time, logging
+from kubernetes import client, config
+import requests
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+CHECK_QUERY = os.environ.get("PROM_QUERY", 'increase(aegis_preflight_verifier_fail_total[5m])')
+THRESH = float(os.environ.get("ROLLBACK_THRESHOLD", "5"))
+TARGET_NAMESPACE = os.environ.get("TARGET_NAMESPACE", "default")
+TARGET_DEPLOYMENT = os.environ.get("TARGET_DEPLOYMENT", "")
+SLEEP = int(os.environ.get("CHECK_INTERVAL", "30"))
+
+logging.basicConfig(level=logging.INFO)
+LOG = logging.getLogger("aegis.autorollback")
+
+def query_prometheus(query):
+    try:
+        r = requests.get(f"{PROM_URL.rstrip('/')}/api/v1/query", params={"query": query}, timeout=5.0)
+        r.raise_for_status()
+        data = r.json()
+        if data.get("status") == "success":
+            v = float(data["data"]["result"][0]["value"][1]) if data["data"]["result"] else 0.0
+            return v
+    except Exception as e:
+        LOG.warning("prometheus query failed: %s", e)
+    return 0.0
+
+def do_rollback(namespace, deployment):
+    try:
+        config.load_incluster_config()
+    except:
+        config.load_kube_config()
+    apps = client.AppsV1Api()
+    LOG.info("Scaling deployment %s/%s to 0 (safe-stop)", namespace, deployment)
+    apps.patch_namespaced_deployment_scale(deployment, namespace, {"spec": {"replicas": 0}})
+    # annotate
+    body = {"metadata": {"annotations": {"aegis.autorollback/rolled-back": str(int(time.time()))}}}
+    apps.patch_namespaced_deployment(deployment, namespace, body)
+
+if __name__ == "__main__":
+    if not TARGET_DEPLOYMENT:
+        LOG.error("TARGET_DEPLOYMENT not set; exiting")
+        exit(2)
+    while True:
+        v = query_prometheus(CHECK_QUERY)
+        LOG.info("Prometheus query value: %s", v)
+        if v >= THRESH:
+            LOG.warning("Threshold exceeded (%s >= %s) -> initiating rollback", v, THRESH)
+            do_rollback(TARGET_NAMESPACE, TARGET_DEPLOYMENT)
+            # sleep longer after a rollback
+            time.sleep(SLEEP * 6)
+        else:
+            time.sleep(SLEEP)
+
