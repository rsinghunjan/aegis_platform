+#!/usr/bin/env python3
+"""
+Cross-encoder verifier for RAG / hallucination prevention.
+- Uses a CrossEncoder to score (premise, claim) pairs for entailment / support.
+"""
+import os, logging
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from sentence_transformers import CrossEncoder
+from prometheus_client import Counter, generate_latest, CONTENT_TYPE_LATEST
+from fastapi.responses import Response
+
+LOG = logging.getLogger("aegis.verifier.cross")
+app = FastAPI(title="Aegis CrossEncoder Verifier")
+
+MODEL = os.environ.get("CROSS_ENCODER_MODEL", "cross-encoder/ms-marco-MiniLM-L-6-v2")
+THRESH = float(os.environ.get("CROSS_ENCODER_MIN_SCORE", "0.3"))
+
+REQ_COUNTER = Counter("aegis_crossreq_total", "Cross encoder requests")
+FAIL_COUNTER = Counter("aegis_crossfail_total", "Cross encoder failures")
+
+try:
+    ce = CrossEncoder(MODEL)
+except Exception as e:
+    LOG.error("failed loading model: %s", e)
+    ce = None
+
+class VerifyReq(BaseModel):
+    text: str
+    retrieved_docs: list
+
+@app.get("/metrics")
+def metrics():
+    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+@app.post("/verify")
+def verify(req: VerifyReq):
+    REQ_COUNTER.inc()
+    if not ce:
+        FAIL_COUNTER.inc()
+        raise HTTPException(status_code=503, detail="verifier model unavailable")
+    # Score each doc as (doc_text, claim)
+    pairs = [[d.get("text", ""), req.text] for d in req.retrieved_docs]
+    if not pairs:
+        FAIL_COUNTER.inc()
+        return {"allow": False, "score": 0.0, "reasons": ["no_docs"]}
+    scores = ce.predict(pairs)
+    best = max(scores)
+    allow = best >= THRESH
+    return {"allow": allow, "score": float(best), "all_scores": [float(s) for s in scores]}
+
