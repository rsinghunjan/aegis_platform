+#!/usr/bin/env python3
+"""
+Hardened action-execution sandbox (starter implementation).
+- Accepts action requests over HTTP and runs them in an isolated subprocess with timeouts.
+- Produces signed receipts (using AWS KMS) and writes audit records to MCP.
+- NOTE: For production, run sandbox in an isolated runtime (gVisor/Kata) and enforce RBAC via k8s ServiceAccount.
+"""
+import os, subprocess, uuid, time, json, logging
+from fastapi import FastAPI, HTTPException, BackgroundTasks
+from pydantic import BaseModel
+import boto3, requests
+
+LOG = logging.getLogger("aegis.sandbox")
+app = FastAPI(title="Aegis Sandbox Worker")
+
+KMS_KEY_ID = os.environ.get("SANDBOX_KMS_KEY_ID")
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+SANDBOX_ALLOWED_CMDS = os.environ.get("SANDBOX_ALLOWED_CMDS", "echo,date,ls").split(",")
+
+kms = boto3.client("kms") if KMS_KEY_ID else None
+
+class ActionReq(BaseModel):
+    action_id: str = None
+    cmd: str
+    args: list = []
+    timeout_s: int = 10
+    requestor: str = "unknown"
+
+def sign_receipt(payload_bytes: bytes):
+    if not kms or not KMS_KEY_ID:
+        return None
+    # Use KMS sign (asymmetric key). In practice ensure key supports signing (asymmetric).
+    resp = kms.sign(KeyId=KMS_KEY_ID, Message=payload_bytes, MessageType='RAW', SigningAlgorithm='RSASSA_PKCS1_V1_5_SHA_256')
+    return resp.get("Signature")
+
+def store_audit(record: dict):
+    try:
+        # Write to MCP evidence endpoint; accept best-effort
+        requests.post(f"{AEGIS_MCP_API.rstrip('/')}/sandbox/audit", json=record, timeout=5.0)
+    except Exception as e:
+        LOG.warning("failed storing audit to MCP: %s", e)
+
+@app.post("/run")
+def run_action(req: ActionReq, background: BackgroundTasks):
+    # basic allowlist check
+    cmd_base = req.cmd.split()[0]
+    if cmd_base not in SANDBOX_ALLOWED_CMDS:
+        raise HTTPException(status_code=403, detail="command not allowed")
+    aid = req.action_id or str(uuid.uuid4())
+    start = int(time.time())
+    try:
+        # run command in subprocess; production: use isolated container runtime
+        proc = subprocess.run([req.cmd] + req.args, capture_output=True, timeout=req.timeout_s, check=False, text=True)
+        out = proc.stdout
+        err = proc.stderr
+        rc = proc.returncode
+    except subprocess.TimeoutExpired:
+        out = ""
+        err = "timeout"
+        rc = -1
+    end = int(time.time())
+    receipt = {
+        "action_id": aid,
+        "requestor": req.requestor,
+        "cmd": req.cmd,
+        "args": req.args,
+        "start_ts": start,
+        "end_ts": end,
+        "return_code": rc,
+        "stdout": out[:4096],
+        "stderr": err[:4096],
+    }
+    payload = json.dumps(receipt).encode("utf-8")
+    sig = None
+    try:
+        sig = sign_receipt(payload)
+    except Exception as e:
+        LOG.warning("signing failed: %s", e)
+    receipt_record = {"receipt": receipt, "signature": sig.hex() if sig else None}
+    # store audit asynchronously
+    background.add_task(store_audit, receipt_record)
+    return {"action_id": aid, "signed": bool(sig), "return_code": rc, "stdout": receipt["stdout"], "stderr": receipt["stderr"]}
+
+@app.get("/health")
+def health():
+    return {"ok": True}
+
