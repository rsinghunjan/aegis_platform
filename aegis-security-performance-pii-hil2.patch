+#!/usr/bin/env python3
+"""
+Safety monitor that accepts telemetry webhooks and triggers emergency stop via sandbox if thresholds exceeded.
+It also writes signed evidence to MCP for traceability.
+"""
+import os, time, json, logging, requests
+from fastapi import FastAPI, Request
+
+LOG = logging.getLogger("aegis.safety")
+app = FastAPI(title="Aegis Safety Monitor")
+
+SANDBOX_API = os.environ.get("SANDBOX_API", "http://sandbox.sandbox.svc.cluster.local:8000/run")
+AEGIS_MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+EMERGENCY_THRESHOLD = float(os.environ.get("EMERGENCY_THRESHOLD", "0.9"))
+
+@app.post("/telemetry")
+async def telemetry(req: Request):
+    body = await req.json()
+    # example: body contains {"metric":"cpu_miss", "value": 0.95}
+    metric = body.get("metric")
+    value = float(body.get("value", 0.0))
+    if value >= EMERGENCY_THRESHOLD:
+        # trigger emergency stop action in sandbox
+        action = {"cmd": "echo", "args": ["EMERGENCY STOP"], "requestor": "safety-monitor"}
+        try:
+            r = requests.post(SANDBOX_API, json=action, timeout=5.0)
+            # write evidence to MCP
+            ev = {"type": "safety_event", "metric": metric, "value": value, "sandbox_resp": r.json()}
+            requests.post(f"{AEGIS_MCP_API.rstrip('/')}/safety/events", json=ev, timeout=5.0)
+        except Exception as e:
+            LOG.error("failed to call sandbox or MCP: %s", e)
+        return {"stopped": True}
+    return {"stopped": False}
+
