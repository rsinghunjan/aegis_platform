+#!/usr/bin/env python3
+"""
+Original artifacts retrieval service that enforces A2A approvals.
+- GET /get_original?s3_key=...&approval_id=... -> returns presigned S3 URL if approver confirms.
+"""
+import os, boto3, requests
+from fastapi import FastAPI, HTTPException, Query
+
+APP = FastAPI(title="Aegis Originals Retrieval")
+S3_BUCKET = os.environ.get("ORIGINALS_S3_BUCKET")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+APPROVER_API = os.environ.get("A2A_API", "http://approver:8080")
+
+s3 = boto3.client("s3", region_name=REGION)
+
+@APP.get("/get_original")
+def get_original(s3_key: str = Query(...), approval_id: str = Query(...)):
+    # verify approval exists and corresponds to s3_key
+    try:
+        r = requests.get(f"{APPROVER_API}/approve_status/{approval_id}", timeout=5.0)
+        if r.status_code != 200:
+            raise HTTPException(status_code=403, detail="approval not found")
+        data = r.json()
+        if data.get("artifact_uri") != s3_key:
+            raise HTTPException(status_code=403, detail="approval does not match artifact")
+        if data.get("decision") != "approved":
+            raise HTTPException(status_code=403, detail="not approved")
+    except HTTPException:
+        raise
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"approver check failed: {e}")
+    # produce presigned URL
+    url = s3.generate_presigned_url('get_object', Params={'Bucket': S3_BUCKET, 'Key': s3_key}, ExpiresIn=3600)
+    return {"presigned_url": url}
+
