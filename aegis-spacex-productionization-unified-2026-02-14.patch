+#!/usr/bin/env bash
+set -euo pipefail
+CMD=${1:-backup}
+S3_BUCKET=${S3_BUCKET:-"s3://aegis-spacex-rekor-backups"}
+DUMP_FILE="/tmp/rekor-$(date +%F-%s).dump"
+PGHOST=${POSTGRES_HOST:-"REKOR_RDS_ENDPOINT"}
+PGUSER=${POSTGRES_USER:-"REPL"}
+PGPASS=${POSTGRES_PASSWORD:-"REPL"}
+
+export PGPASSWORD=${PGPASS}
+if [ "$CMD" = "backup" ]; then
+  pg_dump -h "${PGHOST}" -U "${PGUSER}" -Fc -f "${DUMP_FILE}" rekor
+  aws s3 cp "${DUMP_FILE}" "${S3_BUCKET}/"
+  echo "Backup complete: ${DUMP_FILE} -> ${S3_BUCKET}"
+elif [ "$CMD" = "restore" ]; then
+  FILE=${2:-}
+  if [ -z "${FILE}" ]; then echo "Usage: $0 restore s3://..."; exit 2; fi
+  aws s3 cp "${FILE}" /tmp/rekor.restore.dump
+  pg_restore -h "${PGHOST}" -U "${PGUSER}" -d rekor /tmp/rekor.restore.dump
+  echo "Restore complete"
+else
+  echo "Unknown command: ${CMD}"; exit 2
+fi
+
