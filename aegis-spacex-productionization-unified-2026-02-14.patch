+"""
+Minimal Flower client for telemetry updates, supports a --poison flag for testing.
+"""
+import flwr as fl, numpy as np, argparse, random
+class C(fl.client.NumPyClient):
+    def get_parameters(self): return [np.zeros(10)]
+    def fit(self, parameters, config):
+        u = np.random.normal(size=(10,))
+        if config.get("poison"): u *= 10.0
+        return parameters, 1, {}
+    def evaluate(self, parameters, config): return 0.0, 0, {}
