+#!/usr/bin/env python3
+import numpy as np, json, sys
+def dp_gaussian(agg, epsilon=0.5, sensitivity=1.0):
+    sigma = sensitivity/epsilon
+    noise = np.random.normal(0, sigma, size=np.array(agg).shape)
+    return (np.array(agg) + noise).tolist()
+if __name__ == "__main__":
+    agg = json.loads(sys.argv[1]) if len(sys.argv)>1 else [0.0]*10
+    print(json.dumps({"dp_agg": dp_gaussian(agg, epsilon=float(sys.argv[2]) if len(sys.argv)>2 else 0.5)}))
