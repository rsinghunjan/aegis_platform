+#!/usr/bin/env python3
+"""
+Lightweight drift detector that posts to MCP and optionally opens A2A via drift_detector_alert_to_a2a.py
+This is an idempotent script intended to run periodically (CronJob).
+"""
+import os
+import json
+import numpy as np
+import boto3
+import requests
+from datetime import datetime
+
+S3_BUCKET = os.environ.get("FEATURE_STORE_BUCKET", "aegis-features")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+REGION = os.environ.get("AWS_REGION", "us-east-1")
+THRESH = float(os.environ.get("DRIFT_A2A_THRESHOLD", "1.0"))
+
+s3 = boto3.client("s3", region_name=REGION)
+
+def compute_stats(arr):
+    a = np.array(arr)
+    return {"mean": float(a.mean()), "var": float(a.var())}
+
+def detect_and_report():
+    # Placeholder: fetch baseline and current samples from S3 keys
+    try:
+        baseline_obj = s3.get_object(Bucket=S3_BUCKET, Key="baseline/stats.json")
+        baseline = json.loads(baseline_obj["Body"].read().decode())
+    except Exception:
+        baseline = {"feature1":{"mean":0.0,"var":1.0}}
+
+    try:
+        curr_obj = s3.get_object(Bucket=S3_BUCKET, Key="samples/current_batch.json")
+        current_batch = json.loads(curr_obj["Body"].read().decode())
+    except Exception:
+        current_batch = {"feature1":[0.1,0.2,0.15,0.05]}
+
+    scores = {}
+    for f, vals in current_batch.items():
+        base = baseline.get(f, {"mean":0.0,"var":1.0})
+        a = np.array(vals)
+        cur = {"mean": float(a.mean()), "var": float(a.var())}
+        dm = abs(cur["mean"] - base["mean"]) / (abs(base["mean"]) + 1e-6)
+        dv = abs(cur["var"] - base["var"]) / (abs(base["var"]) + 1e-6)
+        score = float(dm + dv)
+        scores[f] = score
+
+    drift_score = max(scores.values()) if scores else 0.0
+    payload = {"ts": datetime.utcnow().isoformat()+"Z", "drift_score": drift_score, "per_feature": scores}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/monitoring/drift", json=payload, timeout=3.0)
+    except Exception:
+        pass
+
+    # Open A2A for high drift features
+    for f, s in scores.items():
+        if s >= THRESH:
+            try:
+                requests.post(f"{AEGIS_MCP.rstrip('/')}/monitoring/drift_alert", json={"feature":f,"score":s}, timeout=3.0)
+            except Exception:
+                pass
+    print("drift_score", drift_score, scores)
+
+if __name__ == "__main__":
+    detect_and_report()
+
