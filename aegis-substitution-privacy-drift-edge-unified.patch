+"""
+Retrieval guard: ensures originals (encrypted) are only accessible after A2A approval.
+This module checks A2A service or local offline approvals when retrieving originals.
+"""
+import os
+import requests
+
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+
+def can_retrieve(artifact_id: str, requester: str) -> bool:
+    """
+    Query A2A to check whether requester has approval to fetch the original.
+    Fallback to offline local approvals if A2A not reachable.
+    """
+    try:
+        r = requests.get(f"{A2A_API.rstrip('/')}/approval?artifact_id={artifact_id}&requester={requester}", timeout=3.0)
+        if r.ok:
+            j = r.json()
+            return j.get("approved", False)
+    except Exception:
+        # offline fallback - check MCP local audit for a pre-authorized fetchtoken redeem (stub)
+        try:
+            r2 = requests.get(f"{AEGIS_MCP.rstrip('/')}/offline_approvals?artifact_id={artifact_id}&requester={requester}", timeout=2.0)
+            if r2.ok:
+                j2 = r2.json()
+                return j2.get("approved", False)
+        except Exception:
+            return False
+    return False
+
+def retrieve_original(artifact_id: str, requester: str):
+    if not can_retrieve(artifact_id, requester):
+        raise PermissionError("Retrieval not authorized")
+    # stubbed retrieval: read local encrypted file and return bytes (in prod decrypt via KMS)
+    path = f"/data/artifacts/original_encrypted/{artifact_id}.bin"
+    with open(path, "rb") as f:
+        return f.read()
