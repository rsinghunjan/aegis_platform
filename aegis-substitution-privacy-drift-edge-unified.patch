+MCP_API = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+DB_PATH = os.environ.get("SUB_DB", "/data/substitution.db")
+
+conn = sqlite3.connect(DB_PATH, check_same_thread=False)
+conn.execute("""CREATE TABLE IF NOT EXISTS actions (
+  id TEXT PRIMARY KEY,
+  player_id TEXT,
+  reason TEXT,
+  ensemble_score REAL,
+  decision TEXT,
+  a2a_id TEXT,
+  receipt TEXT,
+  created_ts INTEGER DEFAULT (strftime('%s','now'))
+)""")
+conn.commit()
+
+def request_substitution(player_id: str, candidate_outputs: list, action_low_risk: bool=False):
+    """
+    candidate_outputs: list of model outputs (dicts) to pass to verifier
+    Returns action record
+    """
+    verdict = score_from_model_outputs(candidate_outputs)
+    decision = verdict["decision"]
+    # For substitutions, be conservative: require A2A unless explicitly low risk and auto decision
