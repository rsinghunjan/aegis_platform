+#!/usr/bin/env python3
+"""
+Ensemble verifier for high-safety decisions (e.g., substitutions).
+Aggregates multiple model scores, applies calibration, and enforces conservative thresholds.
+
+Config (env):
+ - AUTO_THRESHOLD: float (>=) for safe auto-execute
+ - RECOMMEND_THRESHOLD: float (>=) for recommend (A2A) path
+ - MIN_ENSEMBLE_VOTES: int minimum individual model agreement to consider
+ - CALIBRATE_OFFSET: float applied to raw ensemble score to be conservative
+"""
+import os
+import json
+from typing import List, Dict
+
+AUTO_THRESHOLD = float(os.environ.get("AUTO_THRESHOLD", "0.95"))
+RECOMMEND_THRESHOLD = float(os.environ.get("RECOMMEND_THRESHOLD", "0.75"))
+MIN_ENSEMBLE_VOTES = int(os.environ.get("MIN_ENSEMBLE_VOTES", "2"))
+CALIBRATE_OFFSET = float(os.environ.get("CALIBRATE_OFFSET", "-0.05"))
+
+def score_from_model_outputs(model_outputs: List[Dict]) -> Dict:
+    """
+    model_outputs: list of {"model": name, "score": float, "label": optional}
+    returns: {"ensemble_score": float, "votes": int, "decision": "auto"|"recommend"|"require_a2a"}
+    """
+    scores = [m.get("score", 0.0) for m in model_outputs]
+    # simple average ensemble
+    if not scores:
+        return {"ensemble_score": 0.0, "votes": 0, "decision": "require_a2a"}
+    avg = sum(scores) / len(scores)
+    # count votes above recommend threshold
+    votes = sum(1 for s in scores if s >= RECOMMEND_THRESHOLD)
+    # calibrate conservatively
+    calibrated = max(0.0, min(1.0, avg + CALIBRATE_OFFSET))
+
+    # Decision policy (conservative)
+    if calibrated >= AUTO_THRESHOLD and votes >= MIN_ENSEMBLE_VOTES:
+        decision = "auto"
+    elif calibrated >= RECOMMEND_THRESHOLD and votes >= 1:
+        decision = "recommend"
+    else:
+        decision = "require_a2a"
+
+    return {"ensemble_score": calibrated, "votes": votes, "decision": decision, "raw_avg": avg}
+
+if __name__ == "__main__":
+    # quick local test
+    sample = [{"model":"m1","score":0.96},{"model":"m2","score":0.93},{"model":"m3","score":0.60}]
+    print(score_from_model_outputs(sample))
+
