+#!/usr/bin/env python3
+"""
+Fetchtoken service for offline approvals at the edge.
+Operators can pre-provision tokens that allow local retrievals when connectivity is down.
+Tokens are single-use and recorded locally; later they are synced to central MCP.
+"""
+import os
+import uuid
+import json
+import sqlite3
+from datetime import datetime
+
+DB = os.environ.get("FETCH_DB", "/data/fetchtokens.db")
+conn = sqlite3.connect(DB, check_same_thread=False)
+conn.execute("CREATE TABLE IF NOT EXISTS tokens (token TEXT PRIMARY KEY, artifact_id TEXT, used INTEGER DEFAULT 0, created_ts INTEGER)")
+conn.commit()
+
+def mint_token(artifact_id: str) -> str:
+    token = str(uuid.uuid4())
+    ts = int(datetime.utcnow().timestamp())
+    conn.execute("INSERT INTO tokens (token,artifact_id,used,created_ts) VALUES (?,?,0,?)", (token, artifact_id, ts))
+    conn.commit()
+    return token
+
+def redeem_token(token: str) -> bool:
+    cur = conn.execute("SELECT token,artifact_id,used FROM tokens WHERE token=?", (token,))
+    row = cur.fetchone()
+    if not row:
+        return False
+    if row[2]:
+        return False
+    conn.execute("UPDATE tokens SET used=1 WHERE token=?", (token,))
+    conn.commit()
+    # record redemption for later sync (stub)
+    os.makedirs("/data/fetchtoken_redemptions", exist_ok=True)
+    with open(f"/data/fetchtoken_redemptions/{token}.json", "w") as f:
+        json.dump({"token":token,"artifact_id":row[1]}, f)
+    return True
+
+if __name__ == "__main__":
+    # demo
+    t = mint_token("artifact-123")
+    print("token", t, "redeem=>", redeem_token(t))
