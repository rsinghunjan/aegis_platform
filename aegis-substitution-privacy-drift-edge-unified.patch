+        receipt = sign_receipt({"player_id": player_id, "action": "substitute", "method": "auto"})
+        a2a_id = None
+        decision_taken = "auto_executed"
+    elif decision == "recommend":
+        # open A2A with prefilled suggestion
+        body = {"action_id": f"substitute-{player_id}", "approver":"coach", "decision":"requested", "comment":"Recommended substitution", "evidence": verdict}
+        try:
+            r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+            a2a_id = r.json().get("id") if r.ok else None
+        except Exception:
+            a2a_id = None
+        receipt = None
+        decision_taken = "recommendation_queued"
+    else:
+        # require human approval
+        body = {"action_id": f"substitute-{player_id}", "approver":"coach", "decision":"requested", "comment":"Substitution requires approval", "evidence": verdict}
+        try:
+            r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+            a2a_id = r.json().get("id") if r.ok else None
+        except Exception:
+            a2a_id = None
+        receipt = None
+        decision_taken = "require_a2a"
+
+    # persist action
+    import uuid
+    aid = str(uuid.uuid4())
+    conn.execute("INSERT INTO actions (id,player_id,reason,ensemble_score,decision,a2a_id,receipt) VALUES (?,?,?,?,?,?,?)",
+                 (aid, player_id, json.dumps(candidate_outputs), verdict["ensemble_score"], decision_taken, a2a_id, json.dumps(receipt) if receipt else None))
+    conn.commit()
+
+    # Notify MCP for audit
+    try:
+        requests.post(f"{MCP_API.rstrip('/')}/audit/substitution", json={"id":aid,"player_id":player_id,"verdict":verdict,"decision":decision_taken,"a2a_id":a2a_id}, timeout=3.0)
+    except Exception:
+        pass
+
+    return {"id": aid, "player_id": player_id, "verdict": verdict, "decision": decision_taken, "a2a_id": a2a_id, "receipt": receipt}
