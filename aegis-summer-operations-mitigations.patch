+#!/usr/bin/env python3
+"""
+Helper to sign media artifacts with cosign and record Rekor entry (CI/CLI helper).
+Also provides a simple local 'sign-and-publish' flow to be used in editorial publishing.
+"""
+import os
+import subprocess
+import requests
+import logging
+from fastapi import FastAPI, File, UploadFile, Form
+
+LOG = logging.getLogger("aegis.broadcast.sign")
+logging.basicConfig(level=logging.INFO)
+APP = FastAPI(title="Aegis Media Sign & Publish")
+
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+COSIGN = os.environ.get("COSIGN_BIN", "/usr/local/bin/cosign")
+REKOR_URL = os.environ.get("REKOR_URL", "")
+
+@APP.post("/sign-and-publish")
+def sign_and_publish(file: UploadFile = File(...), title: str = Form(...), editor: str = Form("editor")):
+    # store to local tmp (editor should also store to canonical object store)
+    tmp = f"/tmp/{file.filename}"
+    with open(tmp, "wb") as f:
+        f.write(file.file.read())
+    # sign with cosign (keyless assumed) - in CI prefer cosign sign --key ...
+    try:
+        cmd = [COSIGN, "sign", "--keyless", tmp]
+        subprocess.check_call(cmd, timeout=60)
+    except subprocess.CalledProcessError as e:
+        LOG.error("cosign sign failed: %s", e)
+        return {"ok": False, "error": "sign_failed"}
+    # record to MCP
+    rec = {"title": title, "filename": file.filename, "editor": editor, "ts": int(time.time())}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/broadcast/artifacts", json=rec, timeout=3.0)
+    except Exception:
+        LOG.warning("mcp write failed")
+    return {"ok": True, "artifact": rec}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
