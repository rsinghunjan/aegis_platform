+DATASTORE_API = os.environ.get("TRANSPORT_STORE", "http://transport-store:8080")
+WINDOW = int(os.environ.get("FORECAST_WINDOW", "5"))  # minutes of history to use
+
+class PredictReq(BaseModel):
+    stop_id: str
+    recent_counts: list  # list of ints, recent minute-by-minute counts
+
+@APP.post("/predict")
+def predict(req: PredictReq):
+    # simple rolling average forecast
+    if not req.recent_counts:
+        raise HTTPException(status_code=400, detail="no counts")
+    avg = sum(req.recent_counts[-WINDOW:]) / min(WINDOW, len(req.recent_counts))
+    forecast = {"stop_id": req.stop_id, "predicted_per_minute": avg, "timestamp": int(time.time())}
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/transport/forecasts", json=forecast, timeout=3.0)
+    except Exception:
+        LOG.debug("mcp write failed")
+    return forecast
+
+class ReallocateReq(BaseModel):
+    stop_id: str
+    predicted_load: float
+
+@APP.post("/reallocate")
+def reallocate(req: ReallocateReq):
+    # placeholder policy: if predicted load > threshold, suggest additional staff / bus resources
+    threshold = float(os.environ.get("REALLOC_THRESHOLD", "50.0"))
+    actions = []
+    if req.predicted_load > threshold:
+        actions.append({"type":"add_staff","amount":2,"target":req.stop_id})
+        actions.append({"type":"add_shuttle","target":req.stop_id})
+    else:
+        actions.append({"type":"no_action"})
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/transport/actions", json={"stop_id":req.stop_id,"actions":actions}, timeout=3.0)
+    except Exception:
+        LOG.debug("mcp write failed")
+    return {"stop_id": req.stop_id, "actions": actions}
