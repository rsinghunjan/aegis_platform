+#!/usr/bin/env python3
+"""
+Triage controller for heat-driven incidents and medical dispatch.
+ - Receives incident events from detectors.
+ - Applies simple prioritization, prepositions medics/hydration stations,
+   requests A2A approval for medical interventions, supports manual override
+   via approver JWT (strict).
+ - Emits MCP audit events and requests receipts be signed for any side-effect.
+"""
+import os
+import time
+import logging
+import requests
+from fastapi import FastAPI, HTTPException, Header
+from pydantic import BaseModel
+
+LOG = logging.getLogger("aegis.medical.triage")
+logging.basicConfig(level=logging.INFO)
+APP = FastAPI(title="Aegis Medical Triage Controller")
+
+AEGIS_MCP = os.environ.get("AEGIS_MCP_API", "http://mcp:8082")
+A2A_API = os.environ.get("A2A_API", "http://approver:8080")
+RECEIPT_API = os.environ.get("RECEIPT_API", "http://receipt-signer:8080/sign")
+MEDIC_DISPATCH_API = os.environ.get("MEDIC_DISPATCH_API", "http://dispatch:8080/dispatch")
+HYDRATION_API = os.environ.get("HYDRATION_API", "http://hydration:8080/alert")
+HIGH_PRIORITY_TEMP = float(os.environ.get("HIGH_PRIORITY_TEMP", "40.0"))  # Celsius
+
+class Incident(BaseModel):
+    id: str
+    venue: str
+    timestamp: int
+    incident_type: str  # "heat", "fall", "collapse", ...
+    severity: float     # 0..1 predicted severity
+    metadata: dict = {}
+
+def post_mcp(path, payload):
+    try:
+        requests.post(f"{AEGIS_MCP.rstrip('/')}/{path.lstrip('/')}", json=payload, timeout=3.0)
+    except Exception as e:
+        LOG.warning("mcp write failed (%s): %s", path, e)
+
+def request_a2a(incident):
+    body = {"action_id": incident.id, "artifact_uri": incident.metadata.get("evidence_uri"), "approver": "medic-oncall", "decision": "requested", "comment": "medical intervention approval"}
+    try:
+        r = requests.post(f"{A2A_API.rstrip('/')}/request", json=body, timeout=5.0)
+        if r.ok:
+            return r.json().get("id")
+    except Exception as e:
+        LOG.warning("A2A request failed: %s", e)
+    return None
+
+def sign_receipt(event):
+    try:
+        r = requests.post(RECEIPT_API, json=event, timeout=5.0)
+        if r.ok:
+            return r.json()
+    except Exception as e:
+        LOG.warning("receipt signing failed: %s", e)
+    return None
+
+@APP.post("/ingest")
+def ingest_incident(inc: Incident):
+    post_mcp("medical/incidents", inc.dict())
+    # Preposition hydration stations for heat incidents with severity > 0.3
+    if inc.incident_type == "heat" and inc.severity >= 0.3:
+        try:
+            requests.post(HYDRATION_API, json={"venue": inc.venue, "incident_id": inc.id, "severity": inc.severity}, timeout=3.0)
+            post_mcp("medical/events", {"type":"hydration_alert","incident_id":inc.id})
+        except Exception as e:
+            LOG.warning("hydration alert failed: %s", e)
+
+    # If severe or very hot, request A2A approval before dispatching medics
+    if inc.incident_type in ("collapse","serious") or (inc.incident_type=="heat" and inc.metadata.get("temperature_c",0) >= HIGH_PRIORITY_TEMP) or inc.severity >= 0.8:
+        a2a_id = request_a2a(inc)
+        post_mcp("medical/events", {"type":"a2a_requested","incident_id":inc.id,"a2a_id":a2a_id})
+        return {"status":"a2a_requested","a2a_id":a2a_id}
+
+    # Low/mid severity -> dispatch nearest medic automatically (prepositioning)
+    try:
+        r = requests.post(MEDIC_DISPATCH_API, json={"incident_id": inc.id, "venue": inc.venue, "priority": inc.severity}, timeout=5.0)
+        dispatch_res = r.json() if r.ok else {"error":"dispatch_failed"}
+        receipt = sign_receipt({"event":"dispatch","incident":inc.dict(),"dispatch_result":dispatch_res})
+        post_mcp("medical/events", {"type":"auto_dispatched","incident_id":inc.id,"receipt":receipt})
+        return {"status":"dispatched","dispatch":dispatch_res,"receipt":receipt}
+    except Exception as e:
+        LOG.error("auto dispatch failed: %s", e)
+        raise HTTPException(status_code=500, detail="dispatch_failed")
+
+@APP.post("/manual_override")
+def manual_override(incident_id: str, approval_jwt: str = Header(None)):
+    """
+    Manual override endpoint for emergency interventions by humans.
+    Requires approver JWT (checked by approver service in deployment).
+    """
+    if not approval_jwt:
+        raise HTTPException(status_code=401, detail="missing approval token")
+    # validate via approver /approve_status endpoint (best-effort)
+    try:
+        r = requests.get(f"{A2A_API.rstrip('/')}/approve_status/{approval_jwt}", timeout=5.0)
+        if r.status_code != 200:
+            raise HTTPException(status_code=403, detail="invalid approval token")
+    except HTTPException:
+        raise
+    except Exception as e:
+        LOG.error("approver check failed: %s", e)
+        raise HTTPException(status_code=500, detail="approver_unavailable")
+    # Execute manual dispatch
+    try:
+        r = requests.post(MEDIC_DISPATCH_API, json={"incident_id": incident_id, "source":"manual_override"}, timeout=5.0)
+        res = r.json() if r.ok else {"error":"dispatch_internal"}
+        receipt = sign_receipt({"event":"manual_dispatch","incident_id":incident_id,"result":res})
+        post_mcp("medical/events", {"type":"manual_dispatch","incident_id":incident_id,"receipt":receipt})
+        return {"status":"manual_dispatched","result":res,"receipt":receipt}
+    except Exception as e:
+        LOG.error("manual dispatch failed: %s", e)
+        raise HTTPException(status_code=500, detail="manual_dispatch_failed")
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
