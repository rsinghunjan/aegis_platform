+#!/usr/bin/env python3
+"""
+Validating webhook stub to ensure media artifacts are cosign-signed and verified
+before being published to public CDN/orchestrator.
+"""
+import os
+import subprocess
+import logging
+from fastapi import FastAPI, Request, HTTPException
+
+LOG = logging.getLogger("aegis.broadcast.webhook")
+logging.basicConfig(level=logging.INFO)
+APP = FastAPI(title="Aegis Publish Webhook")
+
+COSIGN = os.environ.get("COSIGN_BIN", "/usr/local/bin/cosign")
+FAIL_ON_ERROR = os.environ.get("FAIL_ON_ERROR", "false").lower() == "true"
+
+def verify_signed(path):
+    try:
+        subprocess.check_call([COSIGN, "verify", "--keyless", path], timeout=20)
+        return True
+    except subprocess.CalledProcessError as e:
+        LOG.warning("cosign verify failed: %s", e)
+        return False
+    except Exception as e:
+        LOG.error("cosign verify error: %s", e)
+        return False
+
+@APP.post("/validate")
+async def validate(req: Request):
+    body = await req.json()
+    artifact_path = body.get("artifact_path")
+    if not artifact_path:
+        raise HTTPException(status_code=400, detail="artifact_path is required")
+    ok = verify_signed(artifact_path)
+    if not ok and FAIL_ON_ERROR:
+        raise HTTPException(status_code=403, detail="artifact not signed or verification failed")
+    return {"allowed": ok}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
