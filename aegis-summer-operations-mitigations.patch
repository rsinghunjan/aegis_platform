+#!/usr/bin/env python3
+"""
+Offline A2A fallback for edge sites:
+ - Accepts fetchtokens (pre-provisioned) and validates them locally (HMAC)
+ - Emits a local approval record that edge services can consume to permit retrievals in offline mode.
+ - All redemptions are recorded to local audit queue and synced to MCP when connectivity returns.
+"""
+import os
+import json
+import time
+import logging
+import hmac
+import hashlib
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+LOG = logging.getLogger("aegis.edge.a2a_fallback")
+logging.basicConfig(level=logging.INFO)
+APP = FastAPI(title="Aegis Offline A2A Fallback")
+
+SECRET = os.environ.get("FETCHTOKEN_SECRET", "change-me")
+QUEUE_DIR = os.environ.get("OFFLINE_A2A_QUEUE", "/data/a2a_local")
+os.makedirs(QUEUE_DIR, exist_ok=True)
+
+class TokenReq(BaseModel):
+    token: dict
+    requestor: str
+    artifact: str
+
+def verify(payload, sig):
+    expected = hmac.new(SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()
+    return hmac.compare_digest(expected, sig)
+
+@APP.post("/redeem")
+def redeem(req: TokenReq):
+    token = req.token
+    payload = token.get("token")
+    sig = token.get("sig")
+    if not payload or not sig:
+        raise HTTPException(status_code=400, detail="malformed token")
+    if not verify(payload, sig):
+        raise HTTPException(status_code=403, detail="invalid signature")
+    obj = json.loads(payload)
+    if int(time.time()) > int(obj.get("expires_at",0)):
+        raise HTTPException(status_code=403, detail="expired token")
+    # create local approval record
+    approval = {"artifact": req.artifact, "requestor": req.requestor, "ts": int(time.time()), "token_tid": obj.get("tid")}
+    fid = f"{int(time.time())}-{obj.get('tid')}.json"
+    with open(os.path.join(QUEUE_DIR, fid), "w") as f:
+        json.dump(approval, f)
+    return {"ok": True, "local_approval_id": fid}
+
+@APP.get("/health")
+def health():
+    return {"ok": True}
+
