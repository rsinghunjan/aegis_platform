+#!/usr/bin/env python3
+"""
+Policy simulation harness:
+ - Load policy catalog and delegation matrix
+ - Generate synthetic events (PRs, finance mismatches, forensic signoff requests)
+ - Evaluate policy decisions by calling policy engine (or local evaluator) and record outcomes
+ - Produce a simulation report usable to validate policy changes
+"""
+import os, yaml, json, random, time, requests, argparse
+
+POLICY_CATALOG = os.environ.get("POLICY_CATALOG", "policies/auto_policy_catalog.yaml")
+DELEGATION = os.environ.get("DELEGATION_MATRIX", "policies/delegation_matrix.yaml")
+POLICY_ENGINE = os.environ.get("POLICY_ENGINE_URL", "http://localhost:8085/evaluate")
+
+def load_yaml(p):
+    with open(p) as f:
+        return yaml.safe_load(f)
+
+def simulate(n=100):
+    pol = load_yaml(POLICY_CATALOG)
+    delm = load_yaml(DELEGATION)
+    actions = list(pol.get("actions", {}).keys())
+    results = []
+    for i in range(n):
+        action = random.choice(actions)
+        actor = random.choice(["aegis-bot", "alice", "bob", "finance-bot"])
+        payload = {"action": action, "actor": actor}
+        try:
+            r = requests.post(POLICY_ENGINE, json=payload, timeout=5)
+            r.raise_for_status()
+            res = r.json()
+        except Exception as e:
+            res = {"error": str(e)}
+        results.append({"action": action, "actor": actor, "result": res})
+    return results
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--runs", type=int, default=100)
+    p.add_argument("--out", default="/tmp/policy_simulation.json")
+    args = p.parse_args()
+    out = simulate(args.runs)
+    with open(args.out, "w") as f:
+        json.dump(out, f, indent=2)
+    print("Wrote simulation results to", args.out)
+
+if __name__ == "__main__":
+    main()
+
