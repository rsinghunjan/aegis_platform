+#!/usr/bin/env python3
+"""
+Trust score calculator for Aegis.
+ - Pulls metrics from Prometheus and internal audit DB + attestation store
+ - Computes a composite trust score and writes a JSON summary for dashboards or gating decisions
+
+Config via env:
+ - PROM_URL: Prometheus endpoint (default http://prometheus:9090)
+ - REPRO_API: endpoint to check reproducibility runner results (optional)
+ - RECONCILE_DB: Postgres URL for reconciliation logs (optional)
+ - OUT_PATH: where to write trust_summary.json (default /tmp/aegis_trust_summary.json)
+ - WEIGHTS: optional JSON weights override (string)
+"""
+import os, time, json, requests
+import psycopg2
+
+PROM = os.environ.get("PROM_URL", "http://prometheus:9090")
+REPRO_API = os.environ.get("REPRO_API", "")
+RECON_DB = os.environ.get("RECONCILE_DB", "")
+OUT = os.environ.get("OUT_PATH", "/tmp/aegis_trust_summary.json")
+WEIGHTS = json.loads(os.environ.get("WEIGHTS", "{}") or "{}")
+
+DEFAULT_WEIGHTS = {
+    "supply_chain": 0.25,
+    "attestation_coverage": 0.20,
+    "reproducibility": 0.20,
+    "finance_reconcile": 0.15,
+    "policy_compliance": 0.10,
+    "security_scans": 0.10
+}
+for k, v in WEIGHTS.items():
+    DEFAULT_WEIGHTS[k] = v
+
+def prom_query(q):
+    try:
+        r = requests.get(PROM + "/api/v1/query", params={"query": q}, timeout=10)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        return {}
+
+def score_supply_chain():
+    # percent of prod images with SBOM+cosign published in last 30d
+    q = 'sum(count_over_time(aegis_supplychain_image_signed_total[30d])) / sum(count_over_time(aegis_supplychain_image_total[30d]))'
+    j = prom_query(q)
+    try:
+        val = float(j.get("data",{}).get("result",[{}])[0].get("value",[0,0])[1]) if j else 0.0
+    except Exception:
+        val = 0.0
+    return max(0.0, min(1.0, val))
+
+def score_attestation_coverage():
+    # percent of canary deployments with attestation in last 30d
+    q = 'avg_over_time(aegis_attestation_present[30d])'
+    j = prom_query(q)
+    try:
+        val = float(j.get("data",{}).get("result",[{}])[0].get("value",[0,0])[1]) if j else 0.0
+    except Exception:
+        val = 0.0
+    return max(0.0, min(1.0, val))
+
+def score_reproducibility():
+    if not REPRO_API:
+        return 0.0
+    try:
+        r = requests.get(REPRO_API + "/status", timeout=10)
+        r.raise_for_status()
+        j = r.json()
+        return j.get("repro_pass_rate", 0.0)
+    except Exception:
+        return 0.0
+
+def score_finance_reconcile():
+    if not RECON_DB:
+        return 0.0
+    try:
+        conn = psycopg2.connect(RECON_DB)
+        with conn.cursor() as cur:
+            cur.execute("select count(*) filter (where status!='ok') as bad, count(*) as total from reconciliation_log;")
+            bad, total = cur.fetchone()
+            conn.close()
+            if total == 0:
+                return 1.0
+            return max(0.0, 1.0 - (bad/total))
+    except Exception:
+        return 0.0
+
+def score_policy_compliance():
+    q = 'sum(rate(aegis_policy_violations_total[30d]))'
+    j = prom_query(q)
+    try:
+        val = float(j.get("data",{}).get("result",[{}])[0].get("value",[0,0])[1]) if j else 0.0
+        # lower violations -> higher score; map inversely with a heuristic threshold
+        score = max(0.0, min(1.0, 1.0 - min(val/100.0, 1.0)))
+        return score
+    except Exception:
+        return 0.0
+
+def score_security_scans():
+    q = 'sum(rate(aegis_vuln_critical_total[30d]))'
+    j = prom_query(q)
+    try:
+        val = float(j.get("data",{}).get("result",[{}])[0].get("value",[0,0])[1]) if j else 0.0
+        return max(0.0, min(1.0, 1.0 - min(val/50.0, 1.0)))
+    except Exception:
+        return 0.0
+
+def compute_trust():
+    parts = {}
+    parts["supply_chain"] = score_supply_chain()
+    parts["attestation_coverage"] = score_attestation_coverage()
+    parts["reproducibility"] = score_reproducibility()
+    parts["finance_reconcile"] = score_finance_reconcile()
+    parts["policy_compliance"] = score_policy_compliance()
+    parts["security_scans"] = score_security_scans()
+    total = 0.0
+    for k, w in DEFAULT_WEIGHTS.items():
+        total += parts.get(k, 0.0) * w
+    summary = {"ts": int(time.time()), "score": round(total, 4), "components": parts, "weights": DEFAULT_WEIGHTS}
+    with open(OUT, "w") as f:
+        json.dump(summary, f, indent=2)
+    print("Wrote trust summary to", OUT)
+    return summary
+
+if __name__ == "__main__":
+    compute_trust()
+
