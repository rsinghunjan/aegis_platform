+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Reproducibility runner: Given an attestation artifact URI and a rebuild command, run replay,
+# produce rebuilt artifact and report success/failure to a simple API and optionally post GitHub status.
+#
+ART_URI=${1:-}
+REBUILD_CMD=${2:-}
+OUTDIR=${3:-/tmp/aegis_repro}
+REPORT_API=${REPORT_API:-}
+GITHUB_REPO=${GITHUB_REPO:-}
+GITHUB_PR=${GITHUB_PR:-}
+GITHUB_TOKEN=${GITHUB_TOKEN:-}
+mkdir -p "$OUTDIR"
+echo "Downloading $ART_URI"
+if [[ "$ART_URI" == s3://* ]]; then
+  aws s3 cp "$ART_URI" "$OUTDIR/orig.tar.gz"
+elif [[ "$ART_URI" == gs://* ]]; then
+  gsutil cp "$ART_URI" "$OUTDIR/orig.tar.gz"
+else
+  curl -sSfL "$ART_URI" -o "$OUTDIR/orig.tar.gz"
+fi
+
+echo "Running rebuild command: $REBUILD_CMD"
+pushd "$OUTDIR" >/dev/null
+eval "$REBUILD_CMD"
+popd >/dev/null
+
+# Expect rebuild to produce art_rebuilt.tar.gz
+if [ -f "$OUTDIR/art_rebuilt.tar.gz" ]; then
+  sha_orig=$(sha256sum "$OUTDIR/orig.tar.gz" | awk '{print $1}')
+  sha_new=$(sha256sum "$OUTDIR/art_rebuilt.tar.gz" | awk '{print $1}')
+  result="mismatch"
+  if [ "$sha_orig" = "$sha_new" ]; then
+    result="reproducible"
+  fi
+else
+  result="no_rebuilt_artifact"
+fi
+
+echo "Result: $result"
+
+if [ -n "$REPORT_API" ]; then
+  curl -sSf -X POST -H "Content-Type: application/json" -d "{\"artifact\":\"$ART_URI\",\"result\":\"$result\"}" "$REPORT_API" || true
+fi
+
+if [ -n "$GITHUB_REPO" ] && [ -n "$GITHUB_PR" ] && [ -n "$GITHUB_TOKEN" ]; then
+  state="failure"
+  description="Reproducibility: $result"
+  if [ "$result" = "reproducible" ]; then state="success"; fi
+  curl -sSf -X POST -H "Authorization: token $GITHUB_TOKEN" -H "Accept: application/vnd.github.v3+json" \
+    "https://api.github.com/repos/$GITHUB_REPO/statuses/$(git rev-parse --short HEAD)" \
+    -d "{\"state\":\"$state\",\"description\":\"$description\",\"context\":\"Aegis/Reproducibility\"}" || true
+fi
+
+exit 0
+
