+metadata:
+  name: require-signed-models
+spec:
+  match:
+    kinds:
+      - apiGroups: [""]
+        kinds: ["Deployment"]
+  parameters: {}
+
+# For dry-run, set enforcementAction: dryrun in Constraint YAML before flip.
