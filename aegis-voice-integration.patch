+#!/usr/bin/env python3
+"""
+Voice-aware extension for runtime enforcer:
+ - Accepts a voice-originated action payload, verifies speaker (optional), enforces policy and routes to E-STOP if violations.
+ - Integrates with ops/voice/speaker_verification_stub.py by default.
+"""
+import argparse, json, requests, os, subprocess
+
+ESTOP_ENDPOINT = os.environ.get("ESTOP_ENDPOINT","http://localhost:9200")
+SPEAKER_VERIFY_CMD = os.environ.get("SPEAKER_VERIFY_CMD","python3 ops/voice/speaker_verification_stub.py --audio {audio} --claimed {claimed}")
+
+def verify_speaker(audio, claimed):
+    cmd = SPEAKER_VERIFY_CMD.format(audio=audio, claimed=claimed)
+    try:
+        r = subprocess.call(cmd, shell=True)
+        return r == 0
+    except Exception:
+        return False
+
+def call_estop(reason):
+    try:
+        requests.post(ESTOP_ENDPOINT + "/update", json={"estop": True, "reason": reason}, timeout=2)
+    except Exception as e:
+        print("E-STOP call failed:", e)
+
+def enforce_voice_action(action_payload):
+    # payload: {"audio": "...", "transcript":"...", "intent": {...}, "claimed_speaker": "alice"}
+    intent = action_payload.get("intent", {})
+    audio = action_payload.get("audio")
+    claimed = action_payload.get("claimed_speaker")
+    # For high-risk intents require speaker verification
+    if intent.get("risk") == "high":
+        ok = verify_speaker(audio, claimed)
+        if not ok:
+            call_estop("speaker_verification_failed")
+            return {"ok": False, "reason": "speaker_verification_failed"}
+    # Apply same policy checks as normal enforcer (placeholder)
+    if intent.get("intent") == "stop":
+        # allowed; log and proceed
+        return {"ok": True}
+    # Unknown intents: block by default
+    return {"ok": False, "reason":"unknown_intent"}
+
+if __name__=="__main__":
+    p=argparse.ArgumentParser()
+    p.add_argument("--payload", required=True, help="JSON payload file")
+    args=p.parse_args()
+    payload=json.load(open(args.payload))
+    res = enforce_voice_action(payload)
+    print(json.dumps(res))
+    if not res.get("ok"):
+        exit(2)
+
