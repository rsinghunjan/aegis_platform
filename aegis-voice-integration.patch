+#!/usr/bin/env python3
+"""
+Inject voice scenarios into sim packs for PoA.
+ - Copies/reference audio files into sim pack structure so they are included in sim runs and HIL replay.
+ - Generates a small manifest of voice events to be consumed by sim/hil runners.
+"""
+import argparse, os, shutil, json
+
+VOICE_SAMPLE_DIR = "ops/voice/sample_data"
+
+def inject(sim_pack_dir, audio_list, out_manifest):
+    os.makedirs(sim_pack_dir, exist_ok=True)
+    events=[]
+    for a in audio_list:
+        if not os.path.exists(a):
+            # try sample dir
+            cand = os.path.join(VOICE_SAMPLE_DIR, a)
+            if os.path.exists(cand):
+                a = cand
+            else:
+                print("Audio not found:", a); continue
+        dest = os.path.join(sim_pack_dir, os.path.basename(a))
+        shutil.copy2(a, dest)
+        events.append({"audio": dest, "time_s": 1.0})
+    with open(out_manifest,"w") as fh:
+        json.dump({"voice_events": events}, fh, indent=2)
+    print("Injected audio into", sim_pack_dir, "manifest:", out_manifest)
+
+if __name__=="__main__":
+    p=argparse.ArgumentParser()
+    p.add_argument("--sim-pack", required=True)
+    p.add_argument("--audios", nargs="+", required=True)
+    p.add_argument("--out-manifest", default="/tmp/voice_sim_manifest.json")
+    args=p.parse_args()
+    inject(args.sim_pack, args.audios, args.out_manifest)
+
