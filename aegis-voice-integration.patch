+#!/usr/bin/env python3
+"""
+Bundle voice artifacts (audio + transcripts), compute hashes and optionally sign with cosign.
+Produces a tar.gz and attempts cosign sign if COSIGN_KMS_URI provided.
+"""
+import argparse, json, os, subprocess, tarfile, hashlib, tempfile
+
+def sha256(path):
+    h=hashlib.sha256()
+    with open(path,"rb") as fh:
+        for chunk in iter(lambda: fh.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+def make_bundle(inputs, outpath, cosign_key=None):
+    tmpdir = tempfile.mkdtemp()
+    manifest=[]
+    for inp in inputs:
+        j=json.load(open(inp))
+        audio=j.get("audio")
+        transcript=j.get("transcript","")
+        base=os.path.basename(audio)
+        dst=os.path.join(tmpdir, base)
+        try:
+            subprocess.check_call(["cp", audio, dst])
+        except Exception:
+            continue
+        manifest.append({"audio": base, "transcript": transcript, "sha256": sha256(dst)})
+    mpath=os.path.join(tmpdir,"manifest.json")
+    with open(mpath,"w") as fh:
+        json.dump(manifest, fh, indent=2)
+    with tarfile.open(outpath,"w:gz") as tar:
+        tar.add(tmpdir, arcname="voice_evidence")
+    if cosign_key:
+        try:
+            subprocess.check_call(["cosign","sign","--key",cosign_key,outpath])
+        except Exception as e:
+            print("cosign sign failed:", e)
+    print("Wrote voice evidence bundle:", outpath)
+
+if __name__=="__main__":
+    p=argparse.ArgumentParser()
+    p.add_argument("--inputs", required=True, help="comma-separated transcript JSON files")
+    p.add_argument("--out", required=True)
+    p.add_argument("--cosign", default=os.environ.get("COSIGN_KMS_URI",""))
+    args=p.parse_args()
+    inputs=[x for x in args.inputs.split(",") if x]
+    make_bundle(inputs, args.out, cosign_key=args.cosign)
+
