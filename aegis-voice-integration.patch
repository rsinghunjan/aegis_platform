+#!/usr/bin/env python3
+"""
+Lightweight KWS/VAD + ASR wrapper for edge devices (placeholder).
+ - Uses Vosk for lightweight ASR if available; falls back to a dummy transcript.
+ - Implements wakeword detection and simple intent mapping using sample commands.
+"""
+import argparse, json, os, sys, time
+
+SAMPLE_INTENTS = {
+    "stop": {"intent":"stop", "risk":"high"},
+    "bring to stop": {"intent":"stop", "risk":"high"},
+    "status": {"intent":"status_query", "risk":"low"},
+    "what is the speed": {"intent":"query_speed", "risk":"low"}
+}
+
+def detect_wakeword(audio_path):
+    # Placeholder: implement KWS (Porcupine/whisper-kws) on-device
+    # For now, return True if file exists
+    return os.path.exists(audio_path)
+
+def run_asr(audio_path):
+    # Try Vosk if installed, otherwise dummy
+    try:
+        from vosk import Model, KaldiRecognizer
+        import wave
+        wf = wave.open(audio_path, "rb")
+        model = Model("models/vosk-small")
+        rec = KaldiRecognizer(model, wf.getframerate())
+        result = []
+        while True:
+            data = wf.readframes(4000)
+            if len(data) == 0:
+                break
+            if rec.AcceptWaveform(data):
+                j = json.loads(rec.Result())
+                result.append(j.get("text",""))
+        final = json.loads(rec.FinalResult()).get("text","")
+        txt = " ".join(result + [final]).strip()
+        return txt
+    except Exception:
+        # Fallback: pretend transcript from filename
+        base = os.path.basename(audio_path).lower()
+        for k in SAMPLE_INTENTS:
+            if k in base:
+                return k
+        return "unknown command"
+
+def map_intent(transcript):
+    for k,v in SAMPLE_INTENTS.items():
+        if k in transcript.lower():
+            return v
+    return {"intent":"unknown","risk":"unknown"}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--audio", required=True)
+    p.add_argument("--out", default="/tmp/voice_asr.json")
+    args = p.parse_args()
+    if not detect_wakeword(args.audio):
+        print("Wakeword not detected; exiting")
+        sys.exit(2)
+    txt = run_asr(args.audio)
+    intent = map_intent(txt)
+    out = {"audio": args.audio, "transcript": txt, "intent": intent}
+    with open(args.out,"w") as fh:
+        json.dump(out, fh, indent=2)
+    print("ASR output written to", args.out)
+
+if __name__=="__main__":
+    main()
+
