+#!/usr/bin/env python3
+"""
+Simplified helper to produce a TUF-like OTA manifest referencing an artifact and its attestation/Rekor index.
+In production, integrate with a proper TUF server and metadata signing using private keys/HSM.
+"""
+import argparse, json, os, base64, hashlib, time
+
+def sha256_b64(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        h.update(f.read())
+    return h.hexdigest()
+
+def main(artifact, attestation, out):
+    manifest = {
+        "artifact": os.path.basename(artifact),
+        "sha256": sha256_b64(artifact),
+        "size": os.path.getsize(artifact),
+        "attestation": json.load(open(attestation)) if attestation and os.path.exists(attestation) else None,
+        "generated_at": int(time.time())
+    }
+    with open(out, "w") as f:
+        json.dump(manifest, f, indent=2)
+    print("Wrote manifest to", out)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifact", required=True)
+    p.add_argument("--attestation", required=False, default="")
+    p.add_argument("--out", default="manifest.json")
+    args = p.parse_args()
+    main(args.artifact, args.attestation, args.out)
+
