+#!/usr/bin/env python3
+"""
+Vehicle-side pre-load verification helper for Waymo pilot.
+Checks:
+ - cosign signature (placeholder)
+ - Rekor index presence and retrievable proof
+ - optional TPM/TEE attestation binding
+
+This is a compact reference implementation for testbeds; production agents should be written in robust system languages and use hardware-backed crypto.
+"""
+import os, requests, json, subprocess, sys
+
+REKOR_URL = os.environ.get("REKOR_URL", "https://rekor.waymo.example.com")
+
+def verify_rekor_index(index):
+    try:
+        r = requests.get(f"{REKOR_URL}/api/v1/log/entries?logIndex={index}", timeout=5)
+        return r.ok and bool(r.json())
+    except Exception:
+        return False
+
+def verify_cosign_signature(artifact_path, sig_path):
+    # Placeholder: in prod use cosign verify with KMS/HSM-backed key or public key
+    # Example: subprocess.run(["cosign","verify","--key", "public.pem", artifact_path], check=True)
+    return os.path.exists(sig_path)
+
+def verify_tpm_binding():
+    # Placeholder for TPM quote verification bound to vehicle identity
+    # In production use tpm2-tools + a remote attestation service
+    return True
+
+def main(artifact, manifest_path):
+    m = json.load(open(manifest_path))
+    att = m.get("attestation") or {}
+    rekor_index = att.get("rekorIndex") or att.get("rekor_index")
+    sig_present = verify_cosign_signature(artifact, artifact + ".sig")
+    if not sig_present:
+        print("cosign signature missing or invalid")
+        return 2
+    if not verify_rekor_index(rekor_index):
+        print("Rekor proof missing or invalid for index:", rekor_index)
+        return 3
+    if not verify_tpm_binding():
+        print("TPM/TEE binding failed")
+        return 4
+    print("Pre-load verification passed")
+    return 0
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        print("usage: preload_verify_waymo.py <artifact> <manifest.json>")
+        sys.exit(1)
+    sys.exit(main(sys.argv[1], sys.argv[2]))
+
