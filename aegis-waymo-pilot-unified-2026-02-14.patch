*** Add File:dp/waymo_dp_harness/dp_harness.py
+#!/usr/bin/env python3
+import numpy as np, json, sys
+
+def dp_aggregate(updates, epsilon=1.0, sensitivity=1.0):
+    mean = np.mean(np.array(updates), axis=0)
+    sigma = sensitivity / epsilon
+    noise = np.random.normal(0, sigma, size=mean.shape)
+    return (mean + noise).tolist()
+
+if __name__ == "__main__":
+    updates = json.loads(sys.argv[1]) if len(sys.argv)>1 else [[0.1]*10] * 5
+    out = dp_aggregate(updates, epsilon=float(sys.argv[2]) if len(sys.argv)>2 else 0.5)
+    print(json.dumps({"dp_result": out}))
