+#!/usr/bin/env python3
+"""
+Streaming proxy with tokenizer integration for accurate per-token DP accounting.
+ - Uses a local tokenizer client service to compute exact token counts per chunk.
+ - Periodically charges DP with accurate token counts.
+ - On DP failure or DP over-budget mid-stream, enforces fail-closed behavior:
+     notifies orchestrator and stops the stream with a blocked message.
+
+Environment variables:
+ - LLM_BACKEND_HTTP: backend streaming HTTP endpoint (ndjson)
+ - DP_SERVICE: DP service charge endpoint
+ - ORCH_WEBHOOK: orchestrator webhook URL
+ - TOKENIZER_URL: tokenizer service URL (POST /count)
+ - DP_AUTH_TOKEN: optional auth token for DP service
+ - CHARGE_INTERVAL_TOKENS: tokens window to charge (default 128)
+ - FAIL_CLOSED_ON_DP_FAIL: "true" to enforce fail-closed on charge failures (default true)
+"""
+import os, json, time, logging
+from typing import AsyncIterator
+from fastapi import FastAPI, Request
+from fastapi.responses import StreamingResponse
+import httpx
+
+LOG = logging.getLogger("aegis.streaming.tokenized")
+logging.basicConfig(level=logging.INFO)
+
+LLM_BACKEND_HTTP = os.environ.get("LLM_BACKEND_HTTP", "http://vllm.model-serving.svc.cluster.local:8080/generate_stream")
+DP_SERVICE = os.environ.get("DP_SERVICE", "http://dp-service:8084")
+ORCH_WEBHOOK = os.environ.get("ORCH_WEBHOOK", "http://aegis-orchestrator.aegis-system.svc.cluster.local:8088/webhook")
+TOKENIZER_URL = os.environ.get("TOKENIZER_URL", "http://tokenizer.aegis-system.svc.cluster.local:8090/count")
+DP_AUTH = os.environ.get("DP_AUTH_TOKEN", "")
+CHARGE_INTERVAL_TOKENS = int(os.environ.get("CHARGE_INTERVAL_TOKENS", "128"))
+FAIL_CLOSED = os.environ.get("FAIL_CLOSED_ON_DP_FAIL", "true").lower() in ("1","true","yes")
+
+app = FastAPI(title="Aegis Tokenized Streaming Proxy")
+
+async def count_tokens(text: str, model: str = "default") -> int:
+    try:
+        async with httpx.AsyncClient(timeout=2.0) as c:
+            r = await c.post(TOKENIZER_URL, json={"text": text, "model": model})
+            r.raise_for_status()
+            return int(r.json().get("tokens", 0))
+    except Exception:
+        # fallback heuristic
+        LOG.exception("tokenizer call failed; falling back")
+        return len(text.split())
+
+async def charge_dp(client_id: str, tokens: int) -> bool:
+    if not client_id:
+        return False
+    headers = {"Authorization": f"Bearer {DP_AUTH}"} if DP_AUTH else {}
+    async with httpx.AsyncClient(timeout=3.0) as c:
+        try:
+            r = await c.post(f"{DP_SERVICE}/charge", json={"client": client_id, "tokens": tokens}, headers=headers)
+            return r.status_code == 200
+        except Exception:
+            LOG.exception("dp charge failed")
+            return False
+
+async def notify_orch(evt: dict):
+    async with httpx.AsyncClient(timeout=2.0) as c:
+        try:
+            await c.post(ORCH_WEBHOOK, json=evt)
+        except Exception:
+            LOG.exception("orchestrator notify failed")
+
+async def backend_stream(payload: dict) -> AsyncIterator[dict]:
+    async with httpx.AsyncClient(timeout=None) as client:
+        async with client.stream("POST", LLM_BACKEND_HTTP, json=payload) as r:
+            async for line in r.aiter_lines():
+                if not line:
+                    continue
+                try:
+                    yield json.loads(line)
+                except Exception:
+                    yield {"text": line}
+
+@app.post("/generate")
+async def generate(req: Request):
+    body = await req.json()
+    client_id = body.get("client_id")
+    token_accum = 0
+    async def stream():
+        nonlocal token_accum
+        async for chunk in backend_stream(body):
+            text = chunk.get("text","")
+            # compute accurate tokens for this chunk
+            tokens = await count_tokens(text, model=body.get("model","default"))
+            # simple incremental safety: allow backend to indicate 'score'
+            score = chunk.get("score", 0.0)
+            if score >= 0.95:
+                evt = {"id": f"auto-{int(time.time())}", "model_env": body.get("model_env","staging"), "score": score, "model":"llm-backend"}
+                await notify_orch(evt)
+                yield json.dumps({"status":"blocked","reason":"safety_high_score"}) + "\n"
+                return
+            yield json.dumps({"status":"ok","text": text}) + "\n"
+            token_accum += tokens
+            if token_accum >= CHARGE_INTERVAL_TOKENS:
+                ok = await charge_dp(client_id, token_accum)
+                if not ok:
+                    LOG.warning("DP charge failed for %s tokens", token_accum)
+                    await notify_orch({"id":f"dp-{int(time.time())}", "model_env": body.get("model_env","prod"), "score":0.0, "dp_over_budget": True})
+                    if FAIL_CLOSED:
+                        yield json.dumps({"status":"blocked","reason":"dp_over_budget"}) + "\n"
+                        return
+                token_accum = 0
+    return StreamingResponse(stream(), media_type="application/x-ndjson")
+
