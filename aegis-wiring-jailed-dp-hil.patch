+#!/usr/bin/env python3
+"""
+Integration test (script) to exercise DP fail-closed behavior:
+ - Assumes streaming_proxy_tokenized is reachable at STREAMING_URL
+ - Assumes mock DP service reachable at DP_CONTROL_URL
+ Steps:
+ 1. Start a streaming /generate request (simulated backend that streams text)
+ 2. After a short window, toggle DP to 'fail' via mock DP /set_state
+ 3. Expect the stream to end with a blocked message containing 'dp_over_budget' or similar
+"""
+import requests, threading, time, os, sys
+
+STREAMING_URL = os.environ.get("STREAMING_URL", "http://localhost:8089/generate")
+DP_CONTROL_URL = os.environ.get("DP_CONTROL_URL", "http://localhost:8084")
+
+def run_stream():
+    payload = {"client_id":"test-client","model_env":"staging","payload":{"inputs":"stream test"}}
+    r = requests.post(STREAMING_URL, json=payload, stream=True, timeout=60)
+    for line in r.iter_lines(decode_unicode=True):
+        if not line:
+            continue
+        print("STREAM:", line)
+        if "dp_over_budget" in line or "blocked" in line:
+            print("Detected block; test success")
+            return True
+    print("Stream ended without block")
+    return False
+
+def main():
+    # ensure DP is OK
+    requests.post(f"{DP_CONTROL_URL}/set_state", json={"state":"ok"})
+    t = threading.Thread(target=run_stream)
+    t.start()
+    time.sleep(2)  # let stream start and accumulate charges
+    print("Forcing DP to fail")
+    requests.post(f"{DP_CONTROL_URL}/set_state", json={"state":"fail"})
+    t.join(timeout=30)
+    print("Test complete")
+
+if __name__ == "__main__":
+    main()
+
