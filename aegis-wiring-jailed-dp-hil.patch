+#!/usr/bin/env python3
+"""
+Example test that connects to the HIL simulator, sends a command, engages E-STOP,
+and verifies commands are blocked while E-STOP engaged.
+"""
+import requests, time, os
+
+BASE = os.environ.get("HIL_URL", "http://localhost:9090")
+
+def main():
+    print("Sending a normal command...")
+    r = requests.post(f"{BASE}/command", json={"joint":0,"torque":1.0})
+    print("resp:", r.json())
+    print("Engaging E-STOP")
+    requests.post(f"{BASE}/estop", json={"engage": True})
+    time.sleep(0.5)
+    print("Sending command while estop engaged (should be blocked)")
+    r2 = requests.post(f"{BASE}/command", json={"joint":0,"torque":2.0})
+    print("resp:", r2.json())
+    print("Clearing E-STOP")
+    requests.post(f"{BASE}/estop", json={"engage": False})
+    time.sleep(0.2)
+    print("Sending command after estop cleared")
+    r3 = requests.post(f"{BASE}/command", json={"joint":0,"torque":0.5})
+    print("resp:", r3.json())
+
+if __name__ == "__main__":
+    main()
+
