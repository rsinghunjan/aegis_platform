+#!/usr/bin/env python3
+"""
+Simple HIL simulator using PyBullet.
+ - Provides an HTTP API to accept actuator commands and an E-STOP toggle.
+ - Exposes /command POST {"joint":0,"torque":...} and /estop POST {"engage": true}
+ - Records telemetry and can be queried for current state.
+"""
+import os, time, threading, json
+from fastapi import FastAPI, Request
+import uvicorn
+import pybullet as p
+import pybullet_data
+
+app = FastAPI(title="Aegis HIL Simulator")
+SIM_STATE = {"estop": False, "telemetry": []}
+
+def sim_thread():
+    physicsClient = p.connect(p.DIRECT)
+    p.setAdditionalSearchPath(pybullet_data.getDataPath())
+    planeId = p.loadURDF("plane.urdf")
+    robot = p.loadURDF("r2d2.urdf", basePosition=[0,0,0.1])
+    while True:
+        if SIM_STATE["estop"]:
+            # freeze simulation (no steps) but still record
+            time.sleep(0.05)
+            continue
+        p.stepSimulation()
+        pos, orn = p.getBasePositionAndOrientation(robot)
+        SIM_STATE["telemetry"].append({"t": time.time(), "pos": pos})
+        # keep telemetry bounded
+        if len(SIM_STATE["telemetry"]) > 1000:
+            SIM_STATE["telemetry"] = SIM_STATE["telemetry"][-500:]
+        time.sleep(0.01)
+
+@app.on_event("startup")
+def startup():
+    thread = threading.Thread(target=sim_thread, daemon=True)
+    thread.start()
+
+@app.post("/command")
+async def command(req: Request):
+    body = await req.json()
+    if SIM_STATE["estop"]:
+        return {"status":"blocked", "reason":"estop_engaged"}
+    # In this simple harness, we record commands; a real HIL would apply forces/vels
+    SIM_STATE.setdefault("commands", []).append(body)
+    return {"status":"ok"}
+
+@app.post("/estop")
+async def estop(req: Request):
+    body = await req.json()
+    engage = body.get("engage", True)
+    SIM_STATE["estop"] = bool(engage)
+    return {"estop": SIM_STATE["estop"]}
+
+@app.get("/telemetry")
+async def telemetry():
+    return {"estop": SIM_STATE["estop"], "telemetry_size": len(SIM_STATE["telemetry"])}
+
+if __name__ == "__main__":
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", "9090")), log_level="info")
+
