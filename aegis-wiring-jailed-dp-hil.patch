+#!/usr/bin/env python3
+"""
+Mock DP service used for integration and fail-closed testing.
+ - POST /charge -> returns 200 or 503 depending on internal state
+ - POST /set_state {"state":"ok"|"fail"} toggles behavior
+ - GET /health returns 200 if state == ok
+"""
+from flask import Flask, request, jsonify
+import threading
+
+app = Flask("mock-dp")
+state = {"status": "ok"}
+
+@app.post("/charge")
+def charge():
+    data = request.get_json() or {}
+    if state["status"] == "ok":
+        return jsonify({"ok": True}), 200
+    return jsonify({"error": "dp_fail"}), 503
+
+@app.post("/set_state")
+def set_state():
+    data = request.get_json() or {}
+    s = data.get("state","ok")
+    state["status"] = s
+    return jsonify({"status": state["status"]})
+
+@app.get("/health")
+def health():
+    return ("", 200) if state["status"] == "ok" else ("", 503)
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=8084)
+
