+#!/usr/bin/env python3
+"""
+Replay Buffer Microservice (Redis Streams based)
+
+- Accepts push of timestep/state/action/reward tuples for an episode.
+- Stores per-episode streams with bounded length (ring buffer semantics).
+- Exposes HTTP API to push events, fetch episodes, sample minibatches for training,
+  and export episodes to Parquet/TFRecord for offline training.
+
+Requires: redis, flask, pyarrow, pandas
+"""
+import os
+import time
+import json
+from flask import Flask, request, jsonify
+import redis
+import pandas as pd
+import pyarrow as pa
+import pyarrow.parquet as pq
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://localhost:6379/0")
+MAX_EPISODE_LEN = int(os.environ.get("MAX_EPISODE_LEN", "2000"))
+EXPORT_PATH = os.environ.get("EXPORT_PATH", "/tmp/episodes")
+
+r = redis.from_url(REDIS_URL, decode_responses=True)
+app = Flask(__name__)
+
+def episode_stream_key(run_id: str):
+    return f"aegis:replay:episode:{run_id}"
+
+@app.route("/push_event", methods=["POST"])
+def push_event():
+    """
+    JSON body:
+      {"run_id": "...", "t": 12, "state": {...}, "action": {...}, "reward": 0.0, "done": false}
+    """
+    body = request.get_json()
+    run_id = body["run_id"]
+    key = episode_stream_key(run_id)
+    # store as JSON string, use XADD with MAXLEN ~ MAX_EPISODE_LEN
+    r.xadd(key, {"payload": json.dumps(body)}, maxlen=MAX_EPISODE_LEN, approximate=True)
+    # set TTL to keep episodes for archival period if desired
+    r.expire(key, 60 * 60 * 24 * 7)  # 7 days default
+    return jsonify({"status": "ok"})
+
+@app.route("/get_episode/<run_id>", methods=["GET"])
+def get_episode(run_id):
+    key = episode_stream_key(run_id)
+    entries = r.xrange(key, count=MAX_EPISODE_LEN)
+    events = [json.loads(e[1]["payload"]) for e in entries]
+    return jsonify({"events": events})
+
+@app.route("/export_episode", methods=["POST"])
+def export_episode():
+    """
+    Export an episode to Parquet.
+    JSON body: {"run_id":"...","out":"<optional path>"}
+    """
+    body = request.get_json()
+    run_id = body["run_id"]
+    out = body.get("out") or f"{EXPORT_PATH}/{run_id}.parquet"
+    key = episode_stream_key(run_id)
+    entries = r.xrange(key)
+    if not entries:
+        return jsonify({"status": "not_found"}), 404
+    events = [json.loads(e[1]["payload"]) for e in entries]
+    # flatten events into DataFrame (simple approach)
+    rows = []
+    for ev in events:
+        row = {
+            "run_id": ev.get("run_id"),
+            "t": ev.get("t"),
+            "state": json.dumps(ev.get("state")),
+            "action": json.dumps(ev.get("action")),
+            "reward": ev.get("reward"),
+            "done": ev.get("done", False)
+        }
+        rows.append(row)
+    df = pd.DataFrame(rows)
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    table = pa.Table.from_pandas(df)
+    pq.write_table(table, out)
+    return jsonify({"status": "exported", "path": out})
+
+@app.route("/sample_batch", methods=["POST"])
+def sample_batch():
+    """
+    Sample a minibatch across episodes for training.
+    JSON body: {"batch_size": 64}
+    Returns a small JSON with sampled transitions (note: for large-scale training you should
+    stream directly from Redis into the learner to avoid copying).
+    """
+    body = request.get_json()
+    bsize = int(body.get("batch_size", 32))
+    # naive sample: pick random episode keys and sample a random event from each
+    keys = r.keys("aegis:replay:episode:*")
+    import random
+    samples = []
+    if not keys:
+        return jsonify({"samples": []})
+    for _ in range(bsize):
+        k = random.choice(keys)
+        entries = r.xrange(k)
+        if not entries:
+            continue
+        ev = json.loads(random.choice(entries)[1]["payload"])
+        samples.append(ev)
+    return jsonify({"samples": samples})
+
+if __name__ == "__main__":
+    os.makedirs(EXPORT_PATH, exist_ok=True)
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
