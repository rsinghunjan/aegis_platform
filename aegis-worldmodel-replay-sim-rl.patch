+"""
+Domain randomizer for PyBullet scenarios.
+
+Provides randomized params (friction, mass, lighting, camera jitter) for sim episodes.
+"""
+import random
+import json
+
+DEFAULT_BOUNDS = {
+    "mass_mul": [0.8, 1.2],
+    "friction_mul": [0.7, 1.3],
+    "camera_yaw_jitter": [-5.0, 5.0],
+    "light_intensity": [0.8, 1.2]
+}
+
+def sample_randomization(bounds: dict = None):
+    b = bounds or DEFAULT_BOUNDS
+    params = {}
+    for k, rng in b.items():
+        if isinstance(rng, list) and len(rng) == 2:
+            params[k] = random.uniform(rng[0], rng[1])
+        else:
+            params[k] = rng
+    return params
+
+def to_json(params):
+    return json.dumps(params)
+
+if __name__ == "__main__":
+    print(sample_randomization())
