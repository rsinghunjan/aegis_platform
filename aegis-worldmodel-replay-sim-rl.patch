+#!/usr/bin/env python3
+"""
+High-frequency telemetry exporter using prometheus_client HTTP server.
+Expose per-loop timing and control latency metrics; scrape interval should be configured low.
+"""
+from prometheus_client import start_http_server, Gauge, Summary
+import time
+import argparse
+import random
+
+CONTROL_LATENCY = Summary("aegis_control_loop_latency_ms", "Control loop latency in ms")
+CONTROL_STEP = Gauge("aegis_control_step", "Step counter", ["run_id"])
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--port", type=int, default=9200)
+    args = ap.parse_args()
+    start_http_server(args.port)
+    run_id = str(int(time.time()))
+    step = 0
+    while True:
+        with CONTROL_LATENCY.time():
+            # simulated control work
+            t0 = time.time()
+            time.sleep(random.uniform(0.001, 0.01))  # 1-10ms
+            latency_ms = (time.time() - t0) * 1000.0
+        CONTROL_STEP.labels(run_id=run_id).set(step)
+        step += 1
+        # sleep a short while to simulate loop frequency (e.g., 100Hz -> 0.01s)
+        time.sleep(0.01)
+
+if __name__ == "__main__":
+    main()
+
