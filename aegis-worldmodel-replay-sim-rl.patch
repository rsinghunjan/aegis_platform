+#!/usr/bin/env python3
+"""
+Deterministic experiment runner.
+
+Sets seeds for Python, NumPy, Torch and the simulator, runs episodes, snapshots outputs,
+and writes a DVC stage example to record the dataset artifact.
+"""
+import os
+import argparse
+import random
+import numpy as np
+import json
+import subprocess
+
+def set_global_seed(seed):
+    random.seed(seed)
+    np.random.seed(seed)
+    try:
+        import torch
+        torch.manual_seed(seed)
+        if torch.cuda.is_available():
+            torch.cuda.manual_seed_all(seed)
+    except Exception:
+        pass
+
+def run_and_snapshot(seed, episodes_dir):
+    set_global_seed(seed)
+    # call the episode recorder
+    cmd = f"python3 ops/sim/pb_episode_recorder.py --episodes 1 --out_dir {episodes_dir} --seed {seed}"
+    subprocess.check_call(cmd, shell=True)
+    # write a manifest
+    manifest = {"seed": seed, "timestamp": int(__import__("time").time())}
+    out = os.path.join(episodes_dir, f"manifest_{seed}.json")
+    with open(out, "w") as fh:
+        json.dump(manifest, fh)
+    # example DVC add command (user must initialize dvc remote)
+    try:
+        subprocess.check_call(f"dvc add {episodes_dir}", shell=True)
+    except Exception:
+        print("dvc add failed or not installed; skip")
+    print("Wrote snapshot for seed", seed)
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--seed", type=int, default=1234)
+    ap.add_argument("--out", default="/tmp/episodes_det")
+    args = ap.parse_args()
+    os.makedirs(args.out, exist_ok=True)
