+"""
+PyBullet episode recorder.
+
+Runs a parameterized episode with domain randomization, records timestep states,
+and writes a Parquet episode file + metadata (seed, randomization params).
+
+Usage:
+  python3 pb_episode_recorder.py --episodes 10 --out_dir /tmp/episodes
+"""
+import argparse
+import os
+import time
+import json
+import random
+import pybullet as p
+import pybullet_data
+from domain_randomizer import sample_randomization
+import pandas as pd
+import pyarrow as pa
+import pyarrow.parquet as pq
+
+def run_episode(env_seed, randomize_params, max_steps=200):
+    # Minimal PyBullet loop; replace with your env/robot control logic
+    physicsClient = p.connect(p.DIRECT)
+    p.setAdditionalSearchPath(pybullet_data.getDataPath())
+    p.resetSimulation()
+    p.setGravity(0, 0, -9.81)
+    plane = p.loadURDF("plane.urdf")
+    cube = p.loadURDF("r2d2.urdf", basePosition=[0,0,0.5])
+    # apply simple randomization (placeholder)
+    # e.g., scale visual light or randomize cube mass via changeDynamics
+    if "mass_mul" in randomize_params:
+        try:
+            p.changeDynamics(cube, -1, mass=1.0 * randomize_params["mass_mul"])
+        except Exception:
+            pass
+    data = []
+    for t in range(max_steps):
+        # simple policy: small random actions (replace with policy)
+        action = [random.uniform(-0.1,0.1) for _ in range(2)]
+        p.stepSimulation()
+        pos, orn = p.getBasePositionAndOrientation(cube)
+        # observation simplified
+        obs = {"pos": pos, "orn": orn}
+        row = {"t": t, "state": json.dumps(obs), "action": json.dumps(action), "reward": 0.0, "done": False}
+        data.append(row)
+    p.disconnect()
+    return data
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--episodes", type=int, default=1)
+    ap.add_argument("--out_dir", default="/tmp/episodes")
+    ap.add_argument("--max_steps", type=int, default=200)
+    ap.add_argument("--seed", type=int, default=None)
+    args = ap.parse_args()
+    os.makedirs(args.out_dir, exist_ok=True)
+    seed = args.seed or int(time.time())
+    random.seed(seed)
+    for i in range(args.episodes):
+        ep_seed = seed + i
+        random.seed(ep_seed)
+        rand_params = sample_randomization()
+        data = run_episode(ep_seed, rand_params, max_steps=args.max_steps)
+        df = pd.DataFrame(data)
+        basename = f"episode_{int(time.time())}_{i}.parquet"
+        out_path = os.path.join(args.out_dir, basename)
+        table = pa.Table.from_pandas(df)
+        pq.write_table(table, out_path)
+        meta = {"seed": ep_seed, "randomization": rand_params, "steps": len(data)}
+        with open(out_path + ".meta.json", "w") as fh:
+            json.dump(meta, fh)
+        print("Wrote", out_path)
+
+if __name__ == "__main__":
+    main()
