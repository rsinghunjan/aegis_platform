+#!/usr/bin/env python3
+"""
+Simple sim->real calibration helper.
+
+Given directories of sim episodes and real episodes (Parquet), compute basic distribution
+statistics on selected sensors (e.g., position, orientation) and produce a balancing plan
+that can be used for domain randomization / dataset resampling.
+"""
+import os
+import json
+import numpy as np
+import pandas as pd
+from glob import glob
+
+def collect_stats(parquet_dir, field="state"):
+    files = glob(os.path.join(parquet_dir, "*.parquet"))
+    vals = []
+    for f in files:
+        df = pd.read_parquet(f)
+        # naive: parse JSON state, extract pos[0] as example
+        for s in df[field]:
+            try:
+                j = json.loads(s)
+                pos = j.get("pos", [0,0,0])
+                vals.append(pos[0])
+            except Exception:
+                continue
+    arr = np.array(vals)
+    return {"mean": float(np.mean(arr)), "std": float(np.std(arr)), "count": int(len(arr))}
+
+def build_balancing_plan(sim_dir, real_dir, out_path="balancing_plan.json"):
+    sim_stats = collect_stats(sim_dir)
+    real_stats = collect_stats(real_dir)
+    plan = {"sim": sim_stats, "real": real_stats, "advice": {}}
+    # simple advice: shift mean and widen randomization if mismatch
+    if abs(sim_stats["mean"] - real_stats["mean"]) > 0.1 * (abs(real_stats["mean"]) + 1e-6):
+        plan["advice"]["shift_mean"] = real_stats["mean"] - sim_stats["mean"]
+    if sim_stats["std"] < real_stats["std"]:
+        plan["advice"]["increase_randomization"] = True
+    with open(out_path, "w") as fh:
+        json.dump(plan, fh, indent=2)
+    print("Wrote balancing plan to", out_path)
+    return plan
+
+if __name__ == "__main__":
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--sim-dir", required=True)
+    ap.add_argument("--real-dir", required=True)
+    ap.add_argument("--out", default="balancing_plan.json")
+    args = ap.parse_args()
+    build_balancing_plan(args.sim_dir, args.real_dir, args.out)
+
