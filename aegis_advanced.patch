new file mode 100644
index 0000000..c08fe6a
--- /dev/null
+++ b/training/model_card.py
@@ -0,0 +1,68 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+import json
+
+
+@dataclass(frozen=True)
+class ModelCard:
+    model_name: str
+    version: str
+    created: str
+    data_provenance: dict
+    eval_results: dict
+    intended_use: str
+    limitations: str
+
+    def to_markdown(self) -> str:
+        return (
+            f"# Model Card: {self.model_name}\\n\\n"
+            f"**Version:** {self.version}\\n\\n"
+            f"**Created:** {self.created}\\n\\n"
+            "## Data provenance\\n"
+            f"```json\\n{json.dumps(self.data_provenance, indent=2)}\\n```\\n\\n"
+            "## Evaluation\\n"
+            f"```json\\n{json.dumps(self.eval_results, indent=2)}\\n```\\n\\n"
+            "## Intended use\\n"
+            f"{self.intended_use}\\n\\n"
+            "## Limitations\\n"
+            f"{self.limitations}\\n"
+        )
+
+
+def generate_model_card(model_name: str, version: str, data_provenance: dict, eval_results: dict) -> str:
+    card = ModelCard(
+        model_name=model_name,
+        version=version,
+        created=str(date.today()),
+        data_provenance=data_provenance,
+        eval_results=eval_results,
+        intended_use="scaffold",
+        limitations="scaffold",
+    )
+    return card.to_markdown()
+
diff --git a/training/promote_gate.py b/training/promote_gate.py
new file mode 100644
index 0000000..9f8bf17
--- /dev/null
+++ b/training/promote_gate.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+
+import sys
+import yaml
+
+
+def main():
+    if len(sys.argv) < 3:
+        print("usage: python -m training.promote_gate <manifest.yaml> <rag_eval_score>")
+        raise SystemExit(2)
+
+    manifest_path = sys.argv[1]
+    rag_score = float(sys.argv[2])
+
+    m = yaml.safe_load(open(manifest_path, "r", encoding="utf-8"))
+    thresholds = (m.get("models") or [{}])[0].get("promotion_thresholds") or {}
+    min_score = float(thresholds.get("rag_eval_score_min", 0.0))
+
+    if rag_score < min_score:
+        print(f"DENY promotion: rag_eval_score={rag_score} < min={min_score}")
+        raise SystemExit(1)
+
+    print(f"ALLOW promotion: rag_eval_score={rag_score} >= min={min_score}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
