@@ -0,0 +1,117 @@
+from __future__ import annotations
+
+from fastapi import FastAPI, Header
+from pydantic import BaseModel
+from opentelemetry import trace
+
+from aegis_common.config import get_settings
+from aegis_common.otel import configure_tracing
+from rag_service.rag import answer_question, index_documents
+from rag_service.eval import run_eval
+
+
+settings = get_settings("aegis-rag-service")
+configure_tracing("aegis-rag-service", settings.otel_endpoint)
+tracer = trace.get_tracer(__name__)
+
+app = FastAPI(title="Aegis RAG Service", version="0.1.0")
+
+
+class IndexIn(BaseModel):
+    docs: list[dict]  # {doc_id, text, metadata}
+    namespace: str = "default"
+
+
+class QueryIn(BaseModel):
+    question: str
+    namespace: str = "default"
+    top_k: int = 10
+
+
+@app.get("/healthz")
+def healthz():
+    return {"ok": True, "service": "rag-service"}
+
+
+@app.post("/v1/index")
+def index(body: IndexIn, x_tenant_id: str | None = Header(default=None)):
+    tenant_id = x_tenant_id or settings.default_tenant_id
+    with tracer.start_as_current_span("rag_index"):
+        index_documents(tenant_id=tenant_id, namespace=body.namespace, docs=body.docs)
+        return {"ok": True, "count": len(body.docs)}
+
+
+@app.post("/v1/query")
+def query(body: QueryIn, x_tenant_id: str | None = Header(default=None)):
+    tenant_id = x_tenant_id or settings.default_tenant_id
+    with tracer.start_as_current_span("rag_query"):
+        out = answer_question(tenant_id=tenant_id, namespace=body.namespace, question=body.question, top_k=body.top_k)
+        return out
+
+
+@app.post("/v1/eval")
+def eval(dataset_path: str, x_tenant_id: str | None = Header(default=None)):
+    tenant_id = x_tenant_id or settings.default_tenant_id
+    with tracer.start_as_current_span("rag_eval"):
+        return run_eval(tenant_id=tenant_id, dataset_path=dataset_path)
+
