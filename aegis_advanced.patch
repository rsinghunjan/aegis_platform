@@ -0,0 +1,64 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from rag_service.rag import answer_question
+
+
+def run_eval(*, tenant_id: str, dataset_path: str) -> dict:
+    """
+    Minimal offline eval harness:
+    dataset: JSONL with {"question": "...", "expected": "..."}.
+    Outputs coarse metrics scaffold.
+    """
+    p = Path(dataset_path)
+    if not p.exists():
+        return {"ok": False, "error": f"dataset not found: {dataset_path}"}
+
+    total = 0
+    hits = 0
+    for line in p.read_text(encoding="utf-8").splitlines():
+        if not line.strip():
+            continue
+        row = json.loads(line)
+        q = row["question"]
+        expected = row.get("expected", "")
+        out = answer_question(tenant_id=tenant_id, namespace="default", question=q, top_k=5)
+        # Scaffold metric: "expected keyword appears in answer"
+        if expected and expected.lower() in (out.get("answer") or "").lower():
+            hits += 1
+        total += 1
+
+    score = (hits / total) if total else 0.0
+    return {"ok": True, "run_id": f"rag_eval_{tenant_id}", "score": score, "total": total, "hits": hits}
+
