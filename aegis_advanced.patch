diff --git a/tests/test_rag_eval.py b/tests/test_rag_eval.py
new file mode 100644
index 0000000..bf72c2b
--- /dev/null
+++ b/tests/test_rag_eval.py
@@ -0,0 +1,24 @@
+from __future__ import annotations
+
+from rag_service.eval import run_eval
+from rag_service.rag import index_documents
+
+
+def test_eval_runs(tmp_path):
+    dataset = tmp_path / "ds.jsonl"
+    dataset.write_text('{"question":"hello","expected":"scaffold"}\n', encoding="utf-8")
+    index_documents(tenant_id="dev", namespace="default", docs=[{"doc_id": "1", "text": "scaffold", "metadata": {}}])
+    out = run_eval(tenant_id="dev", dataset_path=str(dataset))
+    assert out["ok"] is True
+    assert "score" in out
+
