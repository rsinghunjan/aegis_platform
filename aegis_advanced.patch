@@ -0,0 +1,58 @@
+from __future__ import annotations
+
+import os
+import json
+from training.mlflow_utils import start_run
+from training.model_card import generate_model_card
+
+
+def main():
+    model_name = os.getenv("AEGIS_MODEL_NAME", "sample_model")
+    version = os.getenv("AEGIS_MODEL_VERSION", "0.1.0")
+
+    with start_run(run_name=f"{model_name}:{version}", tags={"model": model_name, "version": version}):
+        # Scaffold training logic (wire to DeepSpeed/TPU later)
+        metrics = {"loss": 0.0, "note": "scaffold"}
+
+        # Scaffold eval results
+        eval_results = {"rag_eval_score": 0.0}
+        card_md = generate_model_card(
+            model_name=model_name,
+            version=version,
+            data_provenance={"manifest": "training/datasets_manifest.yaml"},
+            eval_results=eval_results,
+        )
+
+        os.makedirs("artifacts", exist_ok=True)
+        with open(f"artifacts/{model_name}_MODEL_CARD.md", "w", encoding="utf-8") as f:
+            f.write(card_md)
+        with open(f"artifacts/{model_name}_metrics.json", "w", encoding="utf-8") as f:
+            json.dump(metrics, f, indent=2)
+
+        print("Wrote artifacts/ model card + metrics (scaffold).")
+
+
+if __name__ == "__main__":
+    main()
+
