@@ -0,0 +1,33 @@
+from __future__ import annotations
+
+"""
+OPA scaffolding:
+- In production, this would call an OPA bundle / sidecar.
+- Here we enforce a simple allowlist to demonstrate policy gates.
+"""
+
+
+DEFAULT_ALLOW = {
+    "job.submit": True,
+    "job.get": True,
+    "rag.eval": True,
+}
+
+
+def require_policy(*, tenant_id: str, action: str, resource: str) -> None:
+    allowed = DEFAULT_ALLOW.get(action, False)
+    if not allowed:
+        raise PermissionError(f"Policy denied: tenant={tenant_id} action={action} resource={resource}")
+
