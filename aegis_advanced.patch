+++ b/serving_router/api.py
@@ -0,0 +1,127 @@
+from __future__ import annotations
+
+import random
+from fastapi import FastAPI, Header
+from pydantic import BaseModel
+from prometheus_client import Counter, Histogram, generate_latest
+
+
+app = FastAPI(title="Aegis Serving Router", version="0.1.0")
+
+REQS = Counter("aegis_router_requests_total", "Total requests", ["tenant_id", "model", "route"])
+LAT = Histogram("aegis_router_latency_seconds", "Latency seconds", ["route"])
+
+
+class RouteConfig(BaseModel):
+    stable_url: str
+    canary_url: str | None = None
+    canary_percent: int = 0  # 0..100
+
+
+ROUTES: dict[tuple[str, str], RouteConfig] = {}
+
+
+@app.get("/healthz")
+def healthz():
+    return {"ok": True, "service": "serving-router"}
+
+
+@app.get("/metrics")
+def metrics():
+    return generate_latest()
+
+
+@app.put("/v1/routes/{model}")
+def put_route(model: str, cfg: RouteConfig, x_tenant_id: str | None = Header(default=None)):
+    tenant_id = x_tenant_id or "dev"
+    ROUTES[(tenant_id, model)] = cfg
+    return {"ok": True}
+
+
+class GenerateIn(BaseModel):
+    prompt: str
+
+
+@app.post("/v1/models/{model}:generate")
+def generate(model: str, body: GenerateIn, x_tenant_id: str | None = Header(default=None)):
+    tenant_id = x_tenant_id or "dev"
+    cfg = ROUTES.get((tenant_id, model))
+    if not cfg:
+        return {"error": "route not configured", "model": model}
+
+    # Canary routing decision
+    route = "stable"
+    target = cfg.stable_url
+    if cfg.canary_url and cfg.canary_percent > 0 and random.randint(1, 100) <= cfg.canary_percent:
+        route = "canary"
+        target = cfg.canary_url
+
+    REQS.labels(tenant_id=tenant_id, model=model, route=route).inc()
+    with LAT.labels(route=route).time():
+        # Placeholder: forward to actual model serving backend (vLLM/Triton/etc.)
+        return {
+            "model": model,
+            "route": route,
+            "target": target,
+            "output": "SCaffolded output. Wire to vLLM/Triton backend.",
+        }
+
