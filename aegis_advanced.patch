+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Settings:
+    env: str = os.getenv("AEIGS_ENV", "dev")
+    otel_endpoint: str | None = os.getenv("OTEL_EXPORTER_OTLP_ENDPOINT")
+    service_name: str = os.getenv("AEGIS_SERVICE_NAME", "aegis-unknown")
+
+    # Multi-tenant defaults (scaffolding)
+    default_tenant_id: str = os.getenv("AEGIS_DEFAULT_TENANT_ID", "dev")
+
+
+def get_settings(service_name: str) -> Settings:
+    os.environ.setdefault("AEGIS_SERVICE_NAME", service_name)
+    return Settings()
+
diff --git a/aegis_common/otel.py b/aegis_common/otel.py
new file mode 100644
index 0000000..4b2bba4
--- /dev/null
+++ b/aegis_common/otel.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+
+from opentelemetry import trace
+from opentelemetry.sdk.resources import SERVICE_NAME, Resource
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import BatchSpanProcessor
+
+
+def configure_tracing(service_name: str, otlp_endpoint: str | None) -> None:
+    """
+    Minimal tracing setup.
+    If OTLP endpoint not provided, tracing remains local (no exporter) but API still works.
+    """
+    resource = Resource.create({SERVICE_NAME: service_name})
+    provider = TracerProvider(resource=resource)
+    trace.set_tracer_provider(provider)
+
+    if otlp_endpoint:
+        # Lazy import so dev installs work even if exporter isn't present in minimal envs.
+        from opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter
+
+        exporter = OTLPSpanExporter(endpoint=otlp_endpoint, insecure=True)
+        provider.add_span_processor(BatchSpanProcessor(exporter))
+
