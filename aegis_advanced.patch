@@ -0,0 +1,35 @@
+from __future__ import annotations
+
+import os
+
+
+def get_mlflow():
+    import mlflow
+
+    tracking = os.getenv("MLFLOW_TRACKING_URI")
+    if tracking:
+        mlflow.set_tracking_uri(tracking)
+    return mlflow
+
+
+def start_run(run_name: str, tags: dict | None = None):
+    mlflow = get_mlflow()
+    mlflow.set_experiment("aegis-training")
+    run = mlflow.start_run(run_name=run_name)
+    if tags:
+        mlflow.set_tags(tags)
+    return run
+
