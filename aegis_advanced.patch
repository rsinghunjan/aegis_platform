+docker-up:
+	docker compose up --build
+
+docker-down:
+	docker compose down -v
+
+k8s-yaml:
+	@echo "Plain YAML lives in k8s/yaml; apply with kubectl -n <ns> apply -f k8s/yaml/"
+
+helm-lint:
+	helm lint helm/aegis-control-plane helm/aegis-rag-service helm/aegis-serving-router helm/aegis-training
