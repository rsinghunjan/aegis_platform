@@ -0,0 +1,75 @@
+syntax = "proto3";
+
+package aegis.control_plane.v1;
+
+option java_multiple_files = true;
+option java_package = "aegis.control_plane.v1";
+option java_outer_classname = "ControlPlaneProto";
+
+service ControlPlane {
+  rpc SubmitJob(SubmitJobRequest) returns (SubmitJobResponse);
+  rpc GetJob(GetJobRequest) returns (GetJobResponse);
+  rpc EvaluateRAG(EvaluateRAGRequest) returns (EvaluateRAGResponse);
+}
+
+message SubmitJobRequest {
+  string tenant_id = 1;
+  string kind = 2; // "rag_index", "train", "deploy", ...
+  string payload_json = 3;
+}
+
+message SubmitJobResponse {
+  string job_id = 1;
+  string status = 2;
+}
+
+message GetJobRequest {
+  string tenant_id = 1;
+  string job_id = 2;
+}
+
+message GetJobResponse {
+  string job_id = 1;
+  string status = 2;
+  string result_json = 3;
+}
+
+message EvaluateRAGRequest {
+  string tenant_id = 1;
+  string dataset_path = 2;
+}
+
+message EvaluateRAGResponse {
+  string run_id = 1;
+  double score = 2;
+  string details_json = 3;
+}
+
