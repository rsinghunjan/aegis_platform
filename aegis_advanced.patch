@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+import json
+from fastapi import FastAPI, Header, HTTPException
+from pydantic import BaseModel
+from opentelemetry import trace
+
+from aegis_common.config import get_settings
+from aegis_common.otel import configure_tracing
+from aegis_control_plane.policy import require_policy
+from aegis_control_plane.state import JOBS
+
+
+settings = get_settings("aegis-control-plane")
+configure_tracing("aegis-control-plane", settings.otel_endpoint)
+tracer = trace.get_tracer(__name__)
+
+app = FastAPI(title="Aegis Control Plane", version="0.1.0")
+
+
+class SubmitJobIn(BaseModel):
+    kind: str
+    payload: dict
+
+
+@app.get("/healthz")
+def healthz():
+    return {"ok": True, "service": "control-plane"}
+
+
+@app.post("/v1/jobs")
+def submit_job(body: SubmitJobIn, x_tenant_id: str | None = Header(default=None)):
+    tenant_id = x_tenant_id or settings.default_tenant_id
+    require_policy(tenant_id=tenant_id, action="job.submit", resource=body.kind)
+
+    with tracer.start_as_current_span("submit_job"):
+        job_id = f"job_{len(JOBS)+1}"
+        JOBS[(tenant_id, job_id)] = {"status": "queued", "kind": body.kind, "payload": body.payload}
+        return {"job_id": job_id, "status": "queued"}
+
+
+@app.get("/v1/jobs/{job_id}")
+def get_job(job_id: str, x_tenant_id: str | None = Header(default=None)):
+    tenant_id = x_tenant_id or settings.default_tenant_id
+    require_policy(tenant_id=tenant_id, action="job.get", resource=job_id)
+
+    job = JOBS.get((tenant_id, job_id))
+    if not job:
+        raise HTTPException(status_code=404, detail="job not found")
+    return {"job_id": job_id, **job}
+
+
+@app.post("/v1/rag/eval")
+def eval_rag(dataset_path: str, x_tenant_id: str | None = Header(default=None)):
+    tenant_id = x_tenant_id or settings.default_tenant_id
+    require_policy(tenant_id=tenant_id, action="rag.eval", resource=dataset_path)
+
+    # Placeholder: control plane would call rag_service eval endpoint or submit a job.
+    with tracer.start_as_current_span("eval_rag"):
+        return {"run_id": "rag_eval_local_1", "score": 0.0, "details": json.dumps({"note": "scaffold"})}
+
diff --git a/aegis_control_plane/grpc_server.py b/aegis_control_plane/grpc_server.py
new file mode 100644
index 0000000..24f5c8e
--- /dev/null
+++ b/aegis_control_plane/grpc_server.py
@@ -0,0 +1,77 @@
+from __future__ import annotations
+
+import json
+from concurrent import futures
+import grpc
+
+from aegis_common.config import get_settings
+from aegis_common.otel import configure_tracing
+from aegis_control_plane.policy import require_policy
+from aegis_control_plane.state import JOBS
+
+from aegis.control_plane.v1 import control_plane_pb2, control_plane_pb2_grpc
+
+
+class ControlPlaneService(control_plane_pb2_grpc.ControlPlaneServicer):
+    def SubmitJob(self, request, context):
+        require_policy(tenant_id=request.tenant_id, action="job.submit", resource=request.kind)
+        job_id = f"job_{len(JOBS)+1}"
+        JOBS[(request.tenant_id, job_id)] = {"status": "queued", "kind": request.kind, "payload": request.payload_json}
+        return control_plane_pb2.SubmitJobResponse(job_id=job_id, status="queued")
+
+    def GetJob(self, request, context):
+        require_policy(tenant_id=request.tenant_id, action="job.get", resource=request.job_id)
+        job = JOBS.get((request.tenant_id, request.job_id))
+        if not job:
+            context.set_code(grpc.StatusCode.NOT_FOUND)
+            context.set_details("job not found")
+            return control_plane_pb2.GetJobResponse(job_id=request.job_id, status="not_found", result_json="{}")
+        return control_plane_pb2.GetJobResponse(
+            job_id=request.job_id, status=job["status"], result_json=json.dumps(job)
+        )
+
+    def EvaluateRAG(self, request, context):
+        require_policy(tenant_id=request.tenant_id, action="rag.eval", resource=request.dataset_path)
+        return control_plane_pb2.EvaluateRAGResponse(run_id="rag_eval_local_1", score=0.0, details_json="{}")
+
+
+def serve() -> None:
+    settings = get_settings("aegis-control-plane-grpc")
+    configure_tracing("aegis-control-plane-grpc", settings.otel_endpoint)
+    server = grpc.server(futures.ThreadPoolExecutor(max_workers=10))
+    control_plane_pb2_grpc.add_ControlPlaneServicer_to_server(ControlPlaneService(), server)
+    server.add_insecure_port("[::]:50051")
+    server.start()
+    server.wait_for_termination()
+
