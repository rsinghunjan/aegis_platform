+.PHONY: fmt lint test proto docker-up docker-down k8s-yaml helm-lint
+
+PY?=python
+
+fmt:
+	$(PY) -m pip install -q -r requirements-dev.txt
+	$(PY) -m ruff format .
+
+lint:
+	$(PY) -m pip install -q -r requirements-dev.txt
+	$(PY) -m ruff check .
+	$(PY) -m mypy .
+
+test:
+	$(PY) -m pip install -q -r requirements-dev.txt
+	$(PY) -m pytest -q
+
+proto:
+	$(PY) -m pip install -q -r requirements-dev.txt
+	$(PY) -m grpc_tools.protoc \
+	  -I proto \
+	  --python_out=. \
+	  --grpc_python_out=. \
+	  proto/aegis/control_plane/v1/control_plane.proto
