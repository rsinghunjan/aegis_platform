+#!/usr/bin/env python3
+"""
+Redis Streams-based aggregator with simple grouping and leader-election.
+
+Features:
+ - Producers XADD to stream `diffusers:stream`.
+ - Aggregator reads with XREADGROUP as a consumer group; leader election via SETNX lock key.
+ - Groups jobs by a params-hash so heterogeneous params are batched separately.
+ - Writes per-job result to a result key (Redis string) or S3 evidence.
+"""
+import os, time, json, hashlib
+try:
+    import redis
+except Exception:
+    redis = None
+
+STREAM = os.environ.get("DIFFUSER_STREAM", "diffusers:stream")
+GROUP = os.environ.get("DIFFUSER_GROUP", "diffusers_group")
+CONSUMER = os.environ.get("DIFFUSER_CONSUMER", f"agg-{os.getpid()}")
+LOCK_KEY = os.environ.get("DIFFUSER_LOCK_KEY", "diffusers:aggregator:lock")
+LOCK_TTL = int(os.environ.get("DIFFUSER_LOCK_TTL", "30"))
+MAX_BATCH = int(os.environ.get("DIFFUSER_MAX_BATCH", "8"))
+READ_TIMEOUT_MS = int(os.environ.get("DIFFUSER_READ_TIMEOUT_MS", "1000"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def _params_hash(params: dict) -> str:
+    # Normalize and hash stable representation
+    s = json.dumps(params, sort_keys=True)
+    return hashlib.sha256(s.encode("utf-8")).hexdigest()[:8]
+
+class StreamAggregator:
+    def __init__(self, pipe_callable):
+        if redis is None:
+            raise RuntimeError("redis required")
+        self.r = redis.from_url(os.environ.get("REDIS_BROKER", "redis://redis:6379/0"))
+        self.pipe = pipe_callable
+        # try to create group if missing
+        try:
+            self.r.xgroup_create(STREAM, GROUP, id="0-0", mkstream=True)
+        except Exception:
+            pass
+
+    def try_acquire_lock(self):
+        return self.r.set(LOCK_KEY, CONSUMER, nx=True, ex=LOCK_TTL)
+
+    def release_lock(self):
+        val = self.r.get(LOCK_KEY)
+        if val and val.decode("utf-8") == CONSUMER:
+            self.r.delete(LOCK_KEY)
+
+    def run_once(self):
+        # XREADGROUP for pending messages
+        entries = self.r.xreadgroup(GROUP, CONSUMER, {STREAM: ">"}, count=MAX_BATCH, block=READ_TIMEOUT_MS)
+        if not entries:
+            return
+        # entries is [(stream, [(id, {b'payload': b'...'}), ...])]
+        msgs = entries[0][1]
+        # group by params-hash
+        grouped = {}
+        ids_by_group = {}
+        for mid, fields in msgs:
+            payload = json.loads(fields[b"payload"].decode("utf-8"))
+            params = payload.get("params", {})
+            key = _params_hash(params)
+            grouped.setdefault(key, []).append(payload)
+            ids_by_group.setdefault(key, []).append(mid)
+        # process each group with same params together
+        for key, jobs in grouped.items():
+            params = jobs[0].get("params", {})
+            prompts = [j["prompt"] for j in jobs]
+            try:
+                out = self.pipe(prompts, **params)
+                images = out.images
+            except Exception as e:
+                # mark each job failed
+                for j in jobs:
+                    rid = j.get("result_key")
+                    if rid:
+                        self.r.set(rid, json.dumps({"status":"error","error":str(e)}))
+                continue
+            # store results
+            for j, img in zip(jobs, images):
+                job_id = j.get("id")
+                rid = j.get("result_key")
+                import io, boto3
+                buf = io.BytesIO()
+                img.save(buf, format="PNG")
+                img_bytes = buf.getvalue()
+                if EVIDENCE_BUCKET:
+                    s3 = boto3.client("s3")
+                    key_img = f"diffusion/outputs/{job_id}.png"
+                    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key_img, Body=img_bytes, ContentType="image/png")
+                    res = {"status":"ok","s3_image": f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key_img}"}
+                else:
+                    res = {"status":"ok"}
+                if rid:
+                    self.r.set(rid, json.dumps(res))
+        # acknowledge processed messages
+        # flatten ids
+        all_ids = [mid for grp in ids_by_group.values() for mid in grp]
+        if all_ids:
+            self.r.xack(STREAM, GROUP, *all_ids)
+
+    def run_loop(self, poll_interval=0.1):
+        try:
+            while True:
+                # try leader election for processing
+                if self.try_acquire_lock():
+                    try:
+                        self.run_once()
+                    finally:
+                        self.release_lock()
+                time.sleep(poll_interval)
+        except KeyboardInterrupt:
+            return
+
