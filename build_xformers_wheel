+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Build an xFormers wheel for the current CUDA / PyTorch environment.
+# This script is intended to run on a GPU build node that matches the target runtime.
+#
+# Usage:
+#   ./build_xformers_wheel.sh /output/dir
+#
+OUT_DIR=${1:-"/tmp/xformers-wheel-out"}
+XFORMERS_REPO=${XFORMERS_REPO:-"https://github.com/facebookresearch/xformers.git"}
+XFORMERS_TAG=${XFORMERS_TAG:-"main"}
+PYTHON_BIN=${PYTHON_BIN:-"python3"}
+
+mkdir -p "$OUT_DIR"
+workdir=$(mktemp -d)
+echo "Building xformers wheel in $workdir"
+git clone --depth 1 --branch "$XFORMERS_TAG" "$XFORMERS_REPO" "$workdir/xformers"
+pushd "$workdir/xformers"
+
+# Create isolated build env
+${PYTHON_BIN} -m pip install --upgrade pip setuptools wheel cmake ninja
+
+# Use environment to pick up CUDA/PyTorch; users should install a matching torch first
+echo "Building wheel (this may take several minutes)..."
+${PYTHON_BIN} -m pip wheel . -w /tmp/xformers_wheels
+
+mkdir -p "$OUT_DIR"
+mv /tmp/xformers_wheels/* "$OUT_DIR/" || true
+echo "Wheels placed in: $OUT_DIR"
+
+popd
+rm -rf "$workdir"
+
+echo "Done"
