+def bundle_and_sign(metadata: dict, artifacts: dict, cosign_key_ref: str = None):
+    """
+    metadata: dict of generation metadata (seed, model, params, timestamp)
+    artifacts: dict of local file paths to include { "image": "/tmp/img.png" }
+    """
+    tmp = tempfile.mkdtemp()
+    meta_path = os.path.join(tmp, "metadata.json")
+    with open(meta_path, "w") as f:
+        json.dump(metadata, f, indent=2)
+    # create an archive
+    archive = os.path.join(tmp, "evidence.tar.gz")
+    import tarfile
+    with tarfile.open(archive, "w:gz") as tar:
+        tar.add(meta_path, arcname="metadata.json")
+        for name, path in artifacts.items():
+            tar.add(path, arcname=name)
+    # upload archive to S3 (if configured)
+    s3_uri = None
+    if EVIDENCE_BUCKET:
+        s3 = boto3.client("s3")
+        key = f"evidence/bundles/{int(__import__('time').time())}.tar.gz"
+        s3.upload_file(archive, EVIDENCE_BUCKET.replace("s3://",""), key)
+        s3_uri = f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key}"
+    # sign with cosign
+    sign_cmd = ["cosign", "sign", "--yes"]
