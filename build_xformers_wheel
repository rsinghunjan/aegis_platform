+    """
+    Calibrate threshold using a labeled dataset: input is JSONL lines with fields
+    {"text": ..., "label": 0|1} where 1 is toxic/unsafe. This writes a suggested threshold.
+    """
+    import numpy as np
+    pipe = init_text_pipeline()
+    if not pipe:
+        raise RuntimeError("Text pipeline not available for calibration")
+    scores = []
+    labels = []
+    for line in open(dataset_jsonl):
+        j = json.loads(line)
+        text = j["text"]
+        lab = int(j["label"])
+        out = pipe(text, truncation=True)
+        sc = float(out[0].get("score",0.0))
+        scores.append(sc)
+        labels.append(lab)
+    # simple threshold: choose max F1 across candidate thresholds
+    best_t = 0.5
+    best_f1 = 0.0
+    for t in np.linspace(0.1,0.9,81):
+        preds = [1 if s>t else 0 for s in scores]
+        tp = sum(1 for p,l in zip(preds,labels) if p==1 and l==1)
+        fp = sum(1 for p,l in zip(preds,labels) if p==1 and l==0)
+        fn = sum(1 for p,l in zip(preds,labels) if p==0 and l==1)
+        prec = tp/(tp+fp+1e-9)
+        rec = tp/(tp+fn+1e-9)
+        f1 = 2*prec*rec/(prec+rec+1e-9)
+        if f1>best_f1:
+            best_f1 = f1
+            best_t = t
+    with open(out_threshold_file,"w") as f:
+        json.dump({"threshold": float(best_t), "f1": float(best_f1)}, f)
+    return best_t
