+        raise ValueError("s3 uri required")
+    parts = uri.replace("s3://","").split("/",1)
+    bucket = parts[0]
+    key = parts[1]
+    s3 = boto3.client("s3")
+    tmp = tempfile.mktemp(suffix=".bin")
+    s3.download_file(bucket, key, tmp)
+    return open(tmp, "rb").read()
