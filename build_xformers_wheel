+#!/usr/bin/env python3
+"""
+Quota client using Redis Lua script for atomic reservation and idempotent release.
+"""
+import os
+import redis
+import time
+import json
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+QUOTA_KEY_FMT = "tenant_quota:{tenant}"
+LUA_SCRIPT_PATH = os.path.join(os.path.dirname(__file__), "quota.lua")
+
+class QuotaClient:
+    def __init__(self):
+        self.r = redis.from_url(REDIS_URL)
+        self.script = open(LUA_SCRIPT_PATH).read()
+        self.sha = self.r.script_load(self.script)
+
+    def reserve(self, tenant: str, amount: float, idempotency_key: str = None) -> bool:
+        key = QUOTA_KEY_FMT.format(tenant=tenant)
+        # use EVALSHA with KEYS and ARGV
+        try:
+            ok = self.r.evalsha(self.sha, 1, key, str(amount))
+            return bool(ok)
+        except redis.exceptions.ResponseError as e:
+            raise
+
+    def release(self, tenant: str, amount: float):
+        key = QUOTA_KEY_FMT.format(tenant=tenant)
+        # increment back
+        self.r.incrby(key, int(amount))
