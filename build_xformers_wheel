+    import io
+    buf = io.BytesIO()
+    img.save(buf, format="PNG")
+    new_bytes = buf.getvalue()
+    new_hash = sha256_of_bytes(new_bytes)
+    # compare to stored image if available
+    stored_hash = None
+    if record.get("s3_image"):
