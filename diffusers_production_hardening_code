+"""
+Watermark verification service (FastAPI).
+
+- GET /v1/verify?uri=s3://bucket/key&payload=<payload>
+  Downloads image from S3 and checks for invisible watermark matching payload.
+"""
+import os
+import urllib.parse
+import boto3
+import io
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from services.serving.diffusers.watermark.invisible_watermark import detect_watermark_bytes
+
+app = FastAPI(title="Aegis Watermark Verifier")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def _download_s3(uri: str) -> bytes:
+    if not uri.startswith("s3://"):
+        raise ValueError("only s3:// supported")
+    bucket_key = uri.replace("s3://", "")
+    parts = bucket_key.split("/", 1)
+    bucket = parts[0]
+    key = parts[1] if len(parts) > 1 else ""
+    s3 = boto3.client("s3")
+    tmp = io.BytesIO()
+    s3.download_fileobj(bucket, key, tmp)
+    return tmp.getvalue()
+
+class VerifyReq(BaseModel):
+    s3_uri: str
+    payload: str
+
+@app.post("/v1/verify")
+def verify(req: VerifyReq):
+    try:
+        img_bytes = _download_s3(req.s3_uri)
+    except Exception as e:
+        raise HTTPException(status_code=400, detail=f"failed to download: {e}")
+    ok = detect_watermark_bytes(img_bytes, req.payload.encode("utf-8"))
+    return {"s3_uri": req.s3_uri, "payload": req.payload, "watermark_present": ok}
