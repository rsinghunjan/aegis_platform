+#!/usr/bin/env python3
+"""
+FastAPI front-end that enqueues generation jobs to Celery and returns job IDs.
+Clients can poll Celery results or use the result backend for callbacks.
+
+Environment:
+ - REDIS_BROKER
+ - EVIDENCE_BUCKET (for metadata references)
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from celery.result import AsyncResult
+from services.serving.diffusers.celery_worker import generate_image_task, REDIS_BROKER
+import os
+
+app = FastAPI(title="Aegis Diffusers Celery API")
+
+class GenReq(BaseModel):
+    prompt: str
+    steps: int = 25
+    guidance_scale: float = 7.5
+    width: int = 512
+    height: int = 512
+    priority: str = "interactive"
+    model: str = None
+
+@app.post("/v1/enqueue")
+def enqueue(req: GenReq):
+    # priority handling can map to queue names, routing keys
+    task = generate_image_task.apply_async(args=[req.prompt, req.steps, req.guidance_scale, req.width, req.height, None, req.model])
+    return {"task_id": task.id, "status": "queued"}
+
+@app.get("/v1/status/{task_id}")
+def status(task_id: str):
+    res = AsyncResult(task_id, app=generate_image_task.app)
+    if res.failed:
+        raise HTTPException(status_code=500, detail=str(res.result))
+    payload = {"task_id": task_id, "state": res.state}
+    if res.ready():
+        payload["result"] = res.result
+    return payload
+
+@app.get("/healthz")
+def health():
+    return {"status":"ok", "broker": REDIS_BROKER}
