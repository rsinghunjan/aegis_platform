+#!/usr/bin/env python3
+"""
+Simple (PoC) invisible watermark embedder & detector.
+
+Mechanism:
+ - Embed: flip LSB of red-channel pixels according to a pseudo-random pattern derived from payload hash.
+ - Detect: read LSB pattern and compare to expected pattern for payload.
+
+NOT cryptographically robust. Replace with a robust steganographic watermark for production.
+"""
+import hashlib
+from PIL import Image
+import io
+import numpy as np
+
+def _pattern_from_payload(payload_bytes: bytes, length: int):
+    h = hashlib.sha256(payload_bytes).digest()
+    # expand RNG via repeated hashing to needed length
+    out = bytearray()
+    cur = h
+    while len(out) < length:
+        cur = hashlib.sha256(cur).digest()
+        out.extend(cur)
+    return out[:length]
+
+def embed_watermark_bytes(image_bytes: bytes, payload_bytes: bytes) -> bytes:
+    im = Image.open(io.BytesIO(image_bytes)).convert("RGB")
+    arr = np.array(im)
+    h, w, _ = arr.shape
+    total = h * w
+    pat = _pattern_from_payload(payload_bytes, total)
+    flat = arr.reshape(-1, 3)
+    # set LSB of red channel to bit from pattern
+    for i in range(total):
+        bit = (pat[i] & 1)
+        flat[i, 0] = (flat[i, 0] & ~1) | bit
+    out = Image.fromarray(flat.reshape(h, w, 3), "RGB")
+    buf = io.BytesIO()
+    out.save(buf, format="PNG")
+    return buf.getvalue()
+
+def detect_watermark_bytes(image_bytes: bytes, expected_payload_bytes: bytes) -> bool:
+    im = Image.open(io.BytesIO(image_bytes)).convert("RGB")
+    arr = np.array(im)
+    h, w, _ = arr.shape
+    total = h * w
+    pat = _pattern_from_payload(expected_payload_bytes, total)
+    flat = arr.reshape(-1, 3)
+    match = True
+    for i in range(total):
+        bit = flat[i,0] & 1
+        expected = pat[i] & 1
+        if bit != expected:
+            match = False
+            break
+    return match
