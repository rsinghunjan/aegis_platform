+Pre-register enforcement: ensure metadata contains license and legal signoff (S3 token).
+
+Usage:
+  python enforce_license_and_signoff.py --metadata metadata.json --evidence-bucket s3://aegis-evidence-prod
+
+Checks:
+ - metadata must include "license" (non-empty)
+ - metadata may include "legal_signoff_s3_key" (S3 key pointing to a token/file)
+ - If legal_signoff_s3_key provided, verify file exists in evidence bucket.
+ - Exit non-zero on failure.
+"""
+import argparse
+import json
+import os
+import boto3
+import sys
+
+def check(metadata_file: str, evidence_bucket: str):
+    md = json.load(open(metadata_file))
+    if not md.get("license"):
+        print("ERROR: metadata missing 'license' field")
+        return False
+    # optional legal signoff key
+    sign_key = md.get("legal_signoff_s3_key")
+    if sign_key:
+        bucket = evidence_bucket.replace("s3://","")
+        s3 = boto3.client("s3")
+        try:
+            s3.head_object(Bucket=bucket, Key=sign_key)
+            print("Found legal signoff at", f"s3://{bucket}/{sign_key}")
+        except Exception as e:
+            print("ERROR: legal_signoff_s3_key not found in evidence bucket:", e)
+            return False
+    else:
+        print("WARNING: no legal_signoff_s3_key present in metadata (legal signoff required for production)")
+    return True
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--metadata", required=True)
+    p.add_argument("--evidence-bucket", required=True)
+    args = p.parse_args()
+    ok = check(args.metadata, args.evidence_bucket)
+    if not ok:
+        sys.exit(2)
+    print("Metadata checks passed")
+
