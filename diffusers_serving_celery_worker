+"""
+Cost preflight and tenant quota checks for heavy sampling jobs.
+ - Estimate GPU-seconds based on steps and image size.
+ - Check per-tenant daily quota stored in Redis or a simple backend.
+"""
+import os
+import math
+
+# simple placeholder parameters: GPU-sec per step per megapixel
+GPU_SEC_PER_STEP_PER_MPIX = float(os.environ.get("GPU_SEC_PER_STEP_PER_MPIX", "0.001"))
+DEFAULT_DAILY_QUOTA_GPU_SEC = float(os.environ.get("DEFAULT_DAILY_QUOTA_GPU_SEC", "3600.0"))
+
+try:
+    import redis
+except Exception:
+    redis = None
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+QUOTA_KEY_FMT = "tenant_quota:{tenant}"  # stores remaining GPU seconds
+
+def estimate_gpu_seconds(steps: int, width: int, height: int) -> float:
+    mpix = (width * height) / 1_000_000.0
+    return float(steps) * GPU_SEC_PER_STEP_PER_MPIX * mpix
+
+def check_and_reserve(tenant: str, est_gpu_sec: float) -> bool:
+    if redis is None:
+        # no quota backend: allow but warn
+        print("Warning: redis not available; bypassing quota checks")
+        return True
+    r = redis.from_url(REDIS_URL)
+    key = QUOTA_KEY_FMT.format(tenant=tenant)
+    cur = r.get(key)
+    if cur is None:
+        # initialize quota
+        r.set(key, DEFAULT_DAILY_QUOTA_GPU_SEC)
+        cur = DEFAULT_DAILY_QUOTA_GPU_SEC
+    else:
+        cur = float(cur)
+    if est_gpu_sec > cur:
+        return False
+    # reserve (decrement)
+    # redis-py does not have decrbyfloat in all versions; use pipeline
+    pipe = r.pipeline()
+    pipe.decr(key, int(est_gpu_sec))
+    try:
+        pipe.execute()
+    except Exception:
+        # best-effort
+        r.set(key, max(0, cur - est_gpu_sec))
+    return True
+
