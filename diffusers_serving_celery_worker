+#!/usr/bin/env python3
+"""
+ML-based moderation helpers (PoC).
+
+- text_classify: uses transformers pipeline('text-classification') if available to detect toxicity.
+- image_nsfw_score: uses CLIP or a simple NSFW heuristic to return (allowed, score).
+Fallbacks: if heavy models unavailable, return lenient stubs (but CI will fail).
+"""
+import os
+
+def _load_text_pipeline():
+    try:
+        from transformers import pipeline
+        return pipeline("text-classification", model="unitary/toxic-bert")  # example small tox model
+    except Exception:
+        return None
+
+_TEXT_PIPE = None
+
+def text_classify(text: str):
+    """Return (allowed:bool, score:float, label:str)"""
+    global _TEXT_PIPE
+    if _TEXT_PIPE is None:
+        _TEXT_PIPE = _load_text_pipeline()
+    if _TEXT_PIPE:
+        out = _TEXT_PIPE(text, truncation=True)
+        # example output: [{'label':'TOXIC','score':0.99}]
+        label = out[0].get("label", "UNKNOWN")
+        score = float(out[0].get("score", 0.0))
+        # treat high toxic score as disallow
+        allowed = not (label.upper() in ("TOXIC","INSULT","THREAT") and score > 0.6)
+        return allowed, score, label
+    # fallback: naive blocklist
+    from services.serving.diffusers.moderation import text_filter
+    ok, matches = text_filter(text)
+    return ok, 0.0, ",".join(matches)
+
+def _load_clip_model():
+    try:
+        from transformers import CLIPProcessor, CLIPModel
+        import torch
+        model = CLIPModel.from_pretrained("openai/clip-vit-base-patch32")
+        proc = CLIPProcessor.from_pretrained("openai/clip-vit-base-patch32")
+        device = "cuda" if torch.cuda.is_available() else "cpu"
+        model = model.to(device)
+        return model, proc, device
+    except Exception:
+        return None, None, None
+
+_CLIP = None
+
+def image_nsfw_score(image_bytes: bytes):
+    """
+    Return (allowed:bool, score:float)
+    PoC: if CLIP available, compute similarity to a set of unsafe prompts (nudity/weapon) and threshold.
+    """
+    global _CLIP
+    if _CLIP is None:
+        _CLIP = _load_clip_model()
+    model, proc, device = _CLIP
+    if model and proc:
+        from PIL import Image
+        import io
+        import torch
+        img = Image.open(io.BytesIO(image_bytes)).convert("RGB")
+        inputs = proc(text=["a photo of a weapon", "a photo of explicit nudity", "a violent scene"], images=img, return_tensors="pt", padding=True).to(device)
+        outputs = model(**inputs)
+        logits_per_image = outputs.logits_per_image
+        scores = logits_per_image.softmax(dim=1).cpu().numpy().max()
+        # Higher score -> more similar to unsafe classes
+        allowed = scores < 0.6
+        return allowed, float(scores)
+    # fallback: allow but return neutral score
+    return True, 0.0
