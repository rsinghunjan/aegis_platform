+#!/usr/bin/env python3
+"""
+PoC robust watermark using frequency-domain spread-spectrum embedding.
+
+Approach:
+ - Convert image to grayscale, compute 2D FFT, add low-energy pseudo-random pattern
+   derived from payload into mid-frequency coefficients, inverse FFT -> embed.
+ - Detection computes correlation between known pattern and image FFT coefficients.
+
+WARNING: This is a PoC for experimentation. Use vetted, peer-reviewed watermarking methods for production.
+"""
+import numpy as np
+from PIL import Image
+import io
+import hashlib
+
+def _pattern(payload_bytes: bytes, shape):
+    # Derive pseudo-random pattern from payload via SHA256 -> seed
+    seed = int(hashlib.sha256(payload_bytes).hexdigest()[:16], 16) % (2**31-1)
+    rng = np.random.RandomState(seed)
+    return rng.normal(loc=0.0, scale=1.0, size=shape)
+
+def embed_watermark(image_bytes: bytes, payload: str, strength: float = 0.01) -> bytes:
+    im = Image.open(io.BytesIO(image_bytes)).convert("L")  # grayscale
+    arr = np.asarray(im).astype(np.float32) / 255.0
+    h, w = arr.shape
+    pat = _pattern(payload.encode("utf-8"), (h, w))
+    # FFT, inject pattern into mid frequencies
+    F = np.fft.fft2(arr)
+    # create a band mask: avoid very low and very high freqs
+    cy, cx = h//2, w//2
+    Y, X = np.ogrid[:h, :w]
+    dist = np.sqrt((Y - cy)**2 + (X - cx)**2)
+    mask = (dist > min(h,w)*0.05) & (dist < min(h,w)*0.35)
+    F_mod = F + strength * pat * mask
+    img_mod = np.fft.ifft2(F_mod).real
+    img_mod = np.clip(img_mod, 0.0, 1.0)
+    out = (img_mod * 255.0).astype(np.uint8)
+    im_out = Image.fromarray(out, mode="L").convert("RGB")
+    buf = io.BytesIO()
+    im_out.save(buf, format="PNG")
+    return buf.getvalue()
+
+def detect_watermark(image_bytes: bytes, payload: str, threshold: float = 0.01) -> bool:
+    im = Image.open(io.BytesIO(image_bytes)).convert("L")
+    arr = np.asarray(im).astype(np.float32) / 255.0
+    h, w = arr.shape
+    pat = _pattern(payload.encode("utf-8"), (h, w))
+    F = np.fft.fft2(arr)
+    # compute cross-correlation between magnitude of F and pattern
+    mag = np.abs(F)
+    score = np.mean(mag * pat)
+    return float(abs(score)) > threshold
+
