# Copy to .env.production at the repository root and restrict access to that file.
# Pin the image by digest after building and publishing it.
AEGIS_IMAGE=your-registry/aegis-api:replace-with-release-tag

# Use externally managed services. Configure TLS and credentials as appropriate.
AEGIS_AGENT_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@DB_HOST:5432/aegis?sslmode=verify-full
AEGIS_AI_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@DB_HOST:5432/aegis?sslmode=verify-full
AEGIS_MEMORY_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@DB_HOST:5432/aegis?sslmode=verify-full
CELERY_BROKER_URL=rediss://USER:PASSWORD@REDIS_HOST:6379/0?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://USER:PASSWORD@REDIS_HOST:6379/1?ssl_cert_reqs=required

OIDC_ISSUER=https://identity.example.com/
OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
OIDC_AUDIENCE=aegis-api
AEGIS_OIDC_TENANT_CLAIM=tenant_id

AEGIS_INFERENCE_PROVIDERS=openai
AEGIS_EMBEDDING_PROVIDER=openai
AEGIS_LLM_API_KEY=replace-me
AEGIS_LLM_MODEL=replace-me
AEGIS_LLM_INPUT_COST_PER_1K=0
AEGIS_LLM_OUTPUT_COST_PER_1K=0

# Set to an importable module included in the image to register trusted tools.
# AEGIS_AGENT_TOOL_MODULE=my_package.aegis_tools
