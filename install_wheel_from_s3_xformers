+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Install pinned xformers wheel(s) from S3 to the local Python environment.
+#
+# Environment:
+#   XFORMERS_S3_PREFIX  (e.g. s3://my-bucket/artifacts/xformers/cu118/)
+#   AWS_REGION (optional)
+#
+if [ -z "${XFORMERS_S3_PREFIX:-}" ]; then
+  echo "XFORMERS_S3_PREFIX must be set (e.g. s3://bucket/path/)"
+  exit 2
+fi
+
+if ! command -v aws >/dev/null 2>&1; then
+  echo "aws cli required"
+  exit 2
+fi
+
+TMPDIR=$(mktemp -d)
+echo "Downloading xformers wheels from ${XFORMERS_S3_PREFIX} to ${TMPDIR}"
+aws s3 cp --recursive "${XFORMERS_S3_PREFIX}" "${TMPDIR}/"
+
+WHEELS=( ${TMPDIR}/*.whl )
+if [ ${#WHEELS[@]} -eq 0 ]; then
+  echo "No wheels found under ${XFORMERS_S3_PREFIX}"
+  exit 3
+fi
+
+python3 -m pip install --upgrade pip setuptools wheel
+for w in "${WHEELS[@]}"; do
+  echo "Installing wheel $w"
+  python3 -m pip install --no-deps --force-reinstall "$w"
+done
+
+echo "xformers wheels installed; cleaning ${TMPDIR}"
+rm -rf "${TMPDIR}"
+echo "Done"
+
