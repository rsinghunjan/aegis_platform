+#!/usr/bin/env python3
+"""
+Generate prioritized remediation tickets from an acceptance summary (acceptance JSON).
+
+Outputs:
+ - Markdown backlog file with prioritized items.
+ - Optionally create GitHub issues using the gh CLI (requires gh authenticated).
+
+Usage:
+  python3 ops/scripts/generate_remediation_tickets.py --input /tmp/acceptance.json --out /tmp/remediation_backlog.md [--create-issues --repo owner/repo --assignee alice]
+"""
+import argparse, json, sys, subprocess, shlex
+from datetime import datetime
+
+OWNERS = {
+    "checkpoint": "ml-platform",
+    "otel": "sre",
+    "opa": "ml-platform",
+    "remediation": "sre",
+    "security": "security",
+    "billing": "finops",
+    "explainability": "ml-platform",
+    "slo": "sre",
+}
+
+PRIORITY_MAP = {
+    "critical": "P0",
+    "high": "P0",
+    "medium": "P1",
+    "low": "P2",
+}
+
+def infer_issues(acceptance):
+    items = []
+    # acceptance is expected to contain per-step results and optional details
+    steps = acceptance.get("steps", [])
+    for s in steps:
+        name = s.get("name","unknown")
+        ok = s.get("ok", True)
+        info = s.get("info", {})
+        if ok is True:
+            continue
+        # classify by name keywords
+        key = None
+        lname = name.lower()
+        if "checkpoint" in lname or "hpo" in lname:
+            key = "checkpoint"
+            title = "HPO checkpoint success below threshold"
+            body = f"Step failed: {name}\n\nDetails:\n```\n{json.dumps(info, indent=2)}\n```"
+        elif "otel" in lname or "trace" in lname:
+            key = "otel"
+            title = "OTEL coverage below threshold"
+            body = f"OTEL coverage check failed for step: {name}\n\nDetails:\n```\n{json.dumps(info, indent=2)}\n```"
+        elif "opa" in lname or "policy" in lname:
+            key = "opa"
+            title = "OPA harness mismatch rate above threshold"
+            body = f"OPA harness reported mismatches in step: {name}\n\nDetails:\n```\n{json.dumps(info, indent=2)}\n```"
+        elif "remediation" in lname:
+            key = "remediation"
+            title = "Automated remediation success below threshold"
+            body = f"Remediation validation failed: {json.dumps(info, indent=2)}"
+        elif "pen-test" in lname or "security" in lname:
+            key = "security"
+            title = "Pen-test reported critical/high findings"
+            body = f"Security recheck failure: {json.dumps(info, indent=2)}"
+        elif "billing" in lname or "chargeback" in lname:
+            key = "billing"
+            title = "Billing / multi-tenant validation issues"
+            body = f"Billing validation failure: {json.dumps(info, indent=2)}"
+        elif "explainability" in lname:
+            key = "explainability"
+            title = "Explainability manifests / ACL issues"
+            body = f"Explainability E2E failed: {json.dumps(info, indent=2)}"
+        elif "slo" in lname or "long-term" in lname:
+            key = "slo"
+            title = "Long-term SLO collection / audit issues"
+            body = f"SLO/Audit validation failed: {json.dumps(info, indent=2)}"
+        else:
+            key = "general"
+            title = f"Validation failure: {name}"
+            body = f"Details:\n```\n{json.dumps(info, indent=2)}\n```"
+
+        owner = OWNERS.get(key, "platform")
+        priority = "P1"
+        # Simple mapping by key
+        if key in ("checkpoint","security","opa"):
+            priority = "P0"
+        items.append({"title": title, "body": body, "owner": owner, "priority": priority, "component": key})
+    return items
+
+def write_markdown(items, outpath):
+    now = datetime.utcnow().isoformat()
+    with open(outpath, "w") as f:
+        f.write(f"# Remediation Backlog — generated {now}\n\n")
+        f.write("| Priority | Component | Title | Owner |\n")
+        f.write("|---|---|---|---|\n")
+        for it in items:
+            f.write(f"| {it['priority']} | {it['component']} | {it['title']} | {it['owner']} |\n")
+        f.write("\n\n")
+        for it in items:
+            f.write(f"## {it['title']}\n\n")
+            f.write(f"- Owner: @{it['owner']}\n")
+            f.write(f"- Priority: {it['priority']}\n\n")
+            f.write(f"{it['body']}\n\n")
+            f.write("---\n\n")
+    print(f"Wrote backlog to {outpath}")
+
+def create_github_issues(items, repo, assignee=None, prefix="[PROOF-FIX]"):
+    created = []
+    for it in items:
+        title = f"{prefix} {it['title']}"
+        body = it['body'] + f"\n\nOwner: @{it['owner']}\nPriority: {it['priority']}\n"
+        cmd = ["gh", "issue", "create", "--repo", repo, "--title", title, "--body", body]
+        if assignee:
+            cmd += ["--assignee", assignee]
+        print("Running:", " ".join(shlex.quote(c) for c in cmd))
+        subprocess.check_call(cmd)
+        created.append(title)
+    return created
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--input", required=True, help="Acceptance summary JSON (produced by the orchestrator)")
+    p.add_argument("--out", default="/tmp/remediation_backlog.md")
+    p.add_argument("--create-issues", action="store_true")
+    p.add_argument("--repo", help="owner/repo for creating issues")
+    p.add_argument("--assignee", help="assignee for created issues")
+    args = p.parse_args()
+
+    try:
+        acc = json.load(open(args.input))
+    except Exception as e:
+        print("Failed to read acceptance JSON:", e, file=sys.stderr)
+        sys.exit(1)
+
+    items = infer_issues(acc)
+    if not items:
+        print("No failed steps detected in acceptance summary.")
+        sys.exit(0)
+
+    write_markdown(items, args.out)
+
+    if args.create_issues:
+        if not args.repo:
+            print("--repo is required when --create-issues is set", file=sys.stderr)
+            sys.exit(1)
+        created = create_github_issues(items, args.repo, assignee=args.assignee)
+        print("Created issues:", created)
+
+if __name__ == "__main__":
+    import argparse, shlex
+    main()
+
