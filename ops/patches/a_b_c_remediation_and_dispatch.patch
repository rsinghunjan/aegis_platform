+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Generate and (optionally) run a GitHub workflow_dispatch curl command.
+#
+USAGE="Usage: $0 --repo OWNER/REPO --workflow-file run_production_proofs.yml --bucket s3://my-bucket [--run]"
+
+REPO=""
+WORKFLOW_FILE="run_production_proofs.yml"
+BUCKET=""
+DO_RUN="false"
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --repo) REPO="$2"; shift 2;;
+    --workflow-file) WORKFLOW_FILE="$2"; shift 2;;
+    --bucket) BUCKET="$2"; shift 2;;
+    --run) DO_RUN="true"; shift;;
+    -h|--help) echo "$USAGE"; exit 0;;
+    *) echo "Unknown arg $1"; echo "$USAGE"; exit 1;;
+  esac
+done
+
+if [[ -z "$REPO" || -z "$BUCKET" ]]; then
+  echo "$USAGE"; exit 1
+fi
+
+API="https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW_FILE}/dispatches"
+PAYLOAD=$(cat <<JSON
+{
+  "ref": "main",
+  "inputs": {
+    "evidence_bucket": "${BUCKET}",
+    "confirm": "RUN_PROOFS",
+    "promote_gatekeeper": "no"
+  }
+}
+JSON
+)
+
+echo "Generated curl command to dispatch workflow ${WORKFLOW_FILE} in ${REPO}:"
+echo
+echo "curl -X POST -H \"Accept: application/vnd.github+json\" -H \"Authorization: Bearer \$GITHUB_TOKEN\" ${API} -d '${PAYLOAD}'"
+echo
+if [[ "$DO_RUN" == "true" ]]; then
+  if [[ -z "${GITHUB_TOKEN:-}" ]]; then
+    echo "GITHUB_TOKEN not set; cannot run"
+    exit 1
+  fi
+  curl -s -X POST -H "Accept: application/vnd.github+json" -H "Authorization: Bearer ${GITHUB_TOKEN}" "${API}" -d "${PAYLOAD}"
+  echo "Dispatched. Check Actions UI."
+fi
+
