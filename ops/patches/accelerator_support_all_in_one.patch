+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Smoke test that schedules an accelerator-aware Job to a node labeled with hardware.accelerator
+ACCEL_LABEL=${ACCEL_LABEL:-habana-gaudi}
+IMAGE=${IMAGE:-us.gcr.io/aegis/hpo-accel:latest}
+JOB_YAML=/tmp/accel-job.yaml
+cat > $JOB_YAML <<EOF
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: accel-smoke-$(date -u +%s)
+spec:
+  template:
+    spec:
+      nodeSelector:
+        hardware.accelerator: "$ACCEL_LABEL"
+      tolerations:
+        - key: "hardware.accelerator"
+          operator: "Exists"
+          effect: "NoSchedule"
+      containers:
+        - name: worker
+          image: "$IMAGE"
+          command: ["python","-c","print('hello accel'); import time; time.sleep(10)"]
+      restartPolicy: Never
+  backoffLimit: 0
+EOF
+
+kubectl apply -f $JOB_YAML
+echo "Job created; waiting for completion..."
+kubectl -n default wait --for=condition=complete job/$(basename $JOB_YAML .yaml | sed 's/.*accel-smoke-//g' ) || true
+echo "Check Pod logs:"
+POD=$(kubectl get pods -l job-name=$(kubectl get -f $JOB_YAML -o jsonpath='{.metadata.name}') -o jsonpath='{.items[0].metadata.name}')
+kubectl logs $POD || true
+
