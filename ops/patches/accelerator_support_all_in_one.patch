+#!/usr/bin/env python3
+"""
+Generate job manifests for accelerator-backed Ray jobs or Kubernetes Jobs.
+Used by Tekton submit task to create proper manifests with nodeSelector/affinity and device resource requests.
+"""
+import json
+
+def generate_k8s_job(name, image, accelerator_label, accelerator_resource=None, command=None):
+    job = {
+        "apiVersion": "batch/v1",
+        "kind": "Job",
+        "metadata": {"name": name},
+        "spec": {
+            "template": {
+                "metadata": {"labels": {"job": name}},
+                "spec": {
+                    "nodeSelector": {"hardware.accelerator": accelerator_label},
+                    "tolerations": [{"key": "hardware.accelerator", "operator": "Exists", "effect": "NoSchedule"}],
+                    "containers": [
+                        {
+                            "name": "worker",
+                            "image": image,
+                            "resources": {"limits": {}, "requests": {}},
+                            "command": command or ["python","/app/train.py"]
+                        }
+                    ],
+                    "restartPolicy": "Never"
+                }
+            }
+        }
+    }
+    if accelerator_resource:
+        job["spec"]["template"]["spec"]["containers"][0]["resources"]["limits"][accelerator_resource] = 1
+        job["spec"]["template"]["spec"]["containers"][0]["resources"]["requests"][accelerator_resource] = 1
+    return json.dumps(job, indent=2)
+
+if __name__ == "__main__":
+    print(generate_k8s_job("accel-smoke", "us.gcr.io/aegis/hpo-accel:latest", "habana-gaudi", accelerator_resource="gaudi.intel.com/gaudi"))
+
