+#!/usr/bin/env python3
+"""
+Estimate cost for HPO trials that use accelerators.
+Simple price lookup per accelerator-hour multiplied by estimated runtime.
+"""
+PRICES = {
+    "habana-gaudi": 1.50,   # USD per device-hour (example)
+    "graphcore-ipu": 3.00,
+    "tpu-vm": 4.00
+}
+
+def estimate_cost(accelerator_type, hours_per_trial, num_trials):
+    price = PRICES.get(accelerator_type, 1.0)
+    return round(price * hours_per_trial * num_trials, 2)
+
+if __name__ == "__main__":
+    print(estimate_cost("habana-gaudi", 0.5, 128))
+
