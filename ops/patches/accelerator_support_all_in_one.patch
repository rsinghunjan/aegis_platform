+#!/usr/bin/env python3
+"""
+Extend chargeback recorder to capture accelerator-hours.
+Call record_accel_usage(team, run_id, accel_type, hours) after each completed run to bill properly.
+"""
+import sqlite3, os, logging
+from datetime import datetime
+
+DB = os.environ.get("HPO_CHARGE_DB", "/tmp/hpo_charge.db")
+logging.basicConfig(level=logging.INFO)
+
+def init():
+    conn = sqlite3.connect(DB)
+    conn.execute("CREATE TABLE IF NOT EXISTS accel_usage(id INTEGER PRIMARY KEY, team TEXT, run_id TEXT, accel_type TEXT, hours REAL, recorded_at TEXT)")
+    conn.commit(); conn.close()
+
+def record_accel_usage(team, run_id, accel_type, hours):
+    conn = sqlite3.connect(DB)
+    conn.execute("INSERT INTO accel_usage(team, run_id, accel_type, hours, recorded_at) VALUES (?,?,?,?,?)",
+                 (team, run_id, accel_type, hours, datetime.utcnow().isoformat()))
+    conn.commit(); conn.close()
+
+if __name__ == "__main__":
+    init()
+    record_accel_usage("team-a", "run-123", "habana-gaudi", 2.5)
+    print("Recorded accel usage")
+
