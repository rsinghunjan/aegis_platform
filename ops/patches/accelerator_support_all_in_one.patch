+#!/usr/bin/env python3
+"""
+Checkpoint hook that runs on accelerator nodes; watches for eviction signals and triggers checkpointing callbacks.
+Integrate into container entrypoint or as a sidecar.
+"""
+import os, time, logging, subprocess
+
+logger = logging.getLogger("evict-hook")
+logging.basicConfig(level=logging.INFO)
+
+TERMINATION_FILE = "/tmp/eviction_notice"
+
+def check_provider_eviction():
+    # Cloud providers vary; this PoC checks for existence of a file created by node-agent or cloud metadata probe.
+    return os.path.exists(TERMINATION_FILE)
+
+def trigger_checkpoint(signal_file="/tmp/trigger_checkpoint"):
+    # Touch a file or call endpoint inside training process to checkpoint
+    open(signal_file, "w").write("checkpoint\n")
+    logger.info("Wrote checkpoint trigger: %s", signal_file)
+
+if __name__ == "__main__":
+    while True:
+        if check_provider_eviction():
+            logger.warning("Eviction detected; signaling checkpoint")
+            trigger_checkpoint()
+            # optional: call application-specific hook or curl to local agent
+        time.sleep(5)
+
