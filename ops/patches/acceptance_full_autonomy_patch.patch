+#!/usr/bin/env python3
+"""
+MTTR drill harness:
+ - Creates a simulated low-risk plan executed by execute_plan_safe (dry_run=False)
+ - Induces a failure in one step (if supported) and measures rollback via transaction_manager.rollback_transaction
+ - Reports the elapsed time to rollback and stores evidence in EVIDENCE_BUCKET
+"""
+import time, json, os
+from services.agent.transaction_manager import start_transaction, record_step, finalize_transaction, rollback_transaction
+
+def simulate_plan():
+    # Simple two-step plan with a side-effecting k8s scale action; adapt to your adapter
+    return {"plan":[{"tool":"k8s.scale_deployment","action":"scale","args":{"namespace":"default","deployment":"test-deploy","replicas":2}}, {"tool":"k8s.set_image","action":"set","args":{"namespace":"default","deployment":"test-deploy","image":"bad/image:tag"}}], "risk_level":"low"}
+
+def main():
+    plan = simulate_plan()
+    tx = start_transaction("mttr-drill-"+str(int(time.time())), "drill-runner", plan)
+    # Step 0: record pre-step backup URIs (simulated)
+    for i, step in enumerate(plan["plan"]):
+        record_step(tx, i, step, backup_uri=f"pretend-backup://{i}")
+    # Simulate failure during execution of second step
+    print("Simulating failure and running rollback...")
+    t0 = time.time()
+    rollback_transaction(tx)
+    elapsed = time.time() - t0
+    finalize_transaction(tx, "rolled_back", {"elapsed_s": elapsed})
+    print("Rollback elapsed (s):", elapsed)
+    # acceptance
+    target = int(os.environ.get("MTTR_TARGET_S", "900"))
+    if elapsed > target:
+        print("MTTR drill FAILED: elapsed", elapsed)
+        raise SystemExit(2)
+    print("MTTR drill PASSED")
+
+if __name__=="__main__":
+    main()
+
