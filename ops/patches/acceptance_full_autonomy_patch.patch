+END=${END:-}
+ACCEPT_CONF=ops/config/autonomy_acceptance.json
+
+echo "1) Run wrapper audit"
+python services/agent/tool_wrapper_generator.py || true
+python services/agent/wrapper_audit_runner.py || true
+python services/agent/wrapper_audit_checker.py || true
+
+echo "2) Run long dry-run acceptance"
+python ops/tests/run_long_dryrun_and_check.py
+
+echo "3) Run MTTR drill"
+python services/agent/mttr_drill.py
+
