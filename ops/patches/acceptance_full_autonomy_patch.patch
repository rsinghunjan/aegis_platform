+#!/usr/bin/env python3
+"""
+Checks the wrapper audit report produced by wrapper_audit_runner.py and enforces acceptance criteria.
+Exits non-zero if any wrapper has failures or missing generated wrappers.
+"""
+import json, sys, os
+
+REPORT_PATH = os.environ.get("WRAPPER_AUDIT_REPORT", "/tmp/wrapper_audit_report.json")
+
+def main():
+    if not os.path.exists(REPORT_PATH):
+        print("Wrapper audit report not found at", REPORT_PATH)
+        sys.exit(2)
+    j = json.load(open(REPORT_PATH))
+    fails = []
+    for r in j.get("results", []):
+        if not r.get("ok", False):
+            fails.append(r)
+    if fails:
+        print("Wrapper audit found failures:", len(fails))
+        for f in fails:
+            print("-", f.get("wrapper"), f.get("func"), f.get("error",""))
+        sys.exit(3)
+    print("Wrapper audit passed")
+
+if __name__=="__main__":
+    main()
+
