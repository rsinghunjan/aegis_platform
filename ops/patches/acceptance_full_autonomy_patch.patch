+"""
+Simulate a carbon budget violation to test policy_controller mitigation.
+ - In test mode, the script will call the policy controller's /run endpoint (if exposed) or directly invoke the controller logic by creating a temporary high-emission metric via Pushgateway (if configured).
+ - This script is environment dependent; it's a harness to be used by SRE in staging.
+"""
+import os, requests, time
+
+POLICY_CONTROLLER = os.environ.get("POLICY_CONTROLLER_URL", "http://carbon-policy-controller.monitoring.svc:8080")
+PUSHGATEWAY = os.environ.get("PUSHGATEWAY", "")
+
+def trigger_fake_emission(model, kg):
+    if PUSHGATEWAY:
+        # Push a metric to pushgateway for the model (best-effort)
+        payload = f'carbon_accounting_model_emissions_kg{{model="{model}"}} {kg}\n'
+        requests.post(f"{PUSHGATEWAY}/metrics/job/test_{model}", data=payload, timeout=5)
+        print("Pushed fake metric for", model)
+    else:
+        print("No pushgateway configured; cannot push metric")
+
+def call_policy_controller_run():
+    try:
+        r = requests.post(f"{POLICY_CONTROLLER}/run", timeout=10)
+        print("Policy controller run response:", r.status_code, r.text)
+    except Exception as e:
+        print("Policy controller run invocation failed (controller may not expose run endpoint):", e)
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("usage: simulate_policy_violation.py <model> <kg>")
+        raise SystemExit(2)
+    model = sys.argv[1]; kg = float(sys.argv[2])
+    trigger_fake_emission(model, kg)
+    call_policy_controller_run()
+    print("Simulation complete")
