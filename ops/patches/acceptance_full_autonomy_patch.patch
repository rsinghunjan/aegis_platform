+#!/usr/bin/env python3
+"""
+Verify accounting service computes emissions and model registry annotations are present.
+ - Requires a recent job_id that has emitted power metrics and a model_name
+"""
+import os, requests, json, time
+
+ACCOUNTING = os.environ.get("ACCOUNTING_URL", "http://carbon-accounting.monitoring.svc:8080")
+MODEL_REGISTRY = os.environ.get("MODEL_REGISTRY_URL", "")
+
+def verify(job_id, model_name, start, end):
+    body = {"promql": f"sum(dcgm_nvml_power_draw_watts{{job_id=\"{job_id}\"}})", "region":"GB", "job_id":job_id, "start":start, "end":end, "model_name": model_name}
+    r = requests.post(f"{ACCOUNTING}/account/job", json=body, timeout=60)
+    if r.status_code != 200:
+        print("Accounting request failed:", r.status_code, r.text)
+        return False
+    rec = r.json().get("record",{})
+    kg = rec.get("kgco2e")
+    print("Accounting produced kgCO2e:", kg)
+    if MODEL_REGISTRY:
+        # Check annotation exists (best-effort)
+        r2 = requests.get(f"{MODEL_REGISTRY}/models/{model_name}/annotations", timeout=10)
+        if r2.status_code == 200:
+            anns = r2.json()
+            print("Model registry annotations:", anns)
+        else:
+            print("Model registry annotations not reachable or missing")
+    return True
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv) < 5:
+        print("usage: accounting_verify.py <job_id> <model_name> <start> <end>")
+        raise SystemExit(2)
+    ok = verify(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4])
+    if not ok:
+        raise SystemExit(3)
+    print("Accounting verify OK")
