+#!/usr/bin/env python3
+"""
+Run the long dry-run runner (2k by default) and validate planner metrics against acceptance thresholds.
+Produces a JSON result with measured schema_failure_rate and high_risk_count.
+"""
+import os, subprocess, json, time
+
+DRYRUN_SCRIPT = "python services/agent/long_dryrun_runner.py"
+OUTFILE = "/tmp/long_dryrun_result.json"
+ACCEPT_PATH = "ops/config/autonomy_acceptance.json"
+
+def run_dryrun():
+    env = os.environ.copy()
+    env["DRYRUN_ITERATIONS"] = env.get("DRYRUN_ITERATIONS", "2000")
+    env["DRYRUN_WORKERS"] = env.get("DRYRUN_WORKERS", "40")
+    print("Running long dry-run...")
+    subprocess.check_call(DRYRUN_SCRIPT, shell=True, env=env)
+
+def find_latest_report():
+    # long_dryrun_runner writes /tmp/long_dryrun_*.json
+    import glob
+    files = glob.glob("/tmp/long_dryrun_*.json")
+    if not files:
+        raise RuntimeError("no dryrun reports")
+    return max(files, key=os.path.getmtime)
+
+def evaluate(report_path):
+    r = json.load(open(report_path))
+    total = r.get("total_runs", 0)
+    schema_failures = r.get("schema_failures", 0)
+    high_risk = r.get("high_risk_count", 0)
+    avg_schema_fail_rate = schema_failures / total if total else 1.0
+    return {"total": total, "schema_failures": schema_failures, "high_risk": high_risk, "schema_fail_rate": avg_schema_fail_rate}
+
+def main():
+    cfg = json.load(open(ACCEPT_PATH))
+    run_dryrun()
+    rp = find_latest_report()
+    print("Found report:", rp)
+    stats = evaluate(rp)
+    print("Stats:", stats)
+    # acceptance checks
+    if stats["total"] < int(cfg["dryrun_iterations_required"]):
+        print("Insufficient iterations:", stats["total"])
+        raise SystemExit(2)
+    if stats["schema_fail_rate"] > cfg["planner_schema_failure_rate_max"]:
+        print("Schema failure rate too high:", stats["schema_fail_rate"])
+        raise SystemExit(3)
+    if stats["high_risk"] / stats["total"] > cfg["planner_high_risk_p95_max"]:
+        print("High-risk plans too frequent")
+        raise SystemExit(4)
+    # write summary
+    out = "/tmp/dryrun_acceptance_summary.json"
+    json.dump({"report": rp, "stats": stats}, open(out, "w"), indent=2)
+    print("Dry-run acceptance passed, summary at", out)
+
+if __name__=="__main__":
+    main()
+
