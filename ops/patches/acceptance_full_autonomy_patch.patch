+#!/usr/bin/env python3
+"""
+Keycloak IdP -> agent RBAC sync.
+ - Fetches realm roles/users from Keycloak and writes a ConfigMap 'agent-rbac' in the monitoring namespace.
+ - This is a best-effort sync; operator should configure Keycloak credentials via env vars.
+"""
+import os, time, json
+import requests
+from kubernetes import client, config
+
+KEYCLOAK_URL = os.environ.get("KEYCLOAK_URL", "")
+KEYCLOAK_REALM = os.environ.get("KEYCLOAK_REALM", "master")
+KEYCLOAK_CLIENT_ID = os.environ.get("KEYCLOAK_CLIENT_ID", "")
+KEYCLOAK_CLIENT_SECRET = os.environ.get("KEYCLOAK_CLIENT_SECRET", "")
+K8S_NAMESPACE = os.environ.get("RBAC_CM_NAMESPACE", "monitoring")
+CM_NAME = os.environ.get("RBAC_CM_NAME", "agent-rbac")
+
+def get_token():
+    if not KEYCLOAK_URL or not KEYCLOAK_CLIENT_ID:
+        raise RuntimeError("Keycloak credentials not configured")
+    url = f"{KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}/protocol/openid-connect/token"
+    r = requests.post(url, data={"grant_type":"client_credentials","client_id":KEYCLOAK_CLIENT_ID,"client_secret":KEYCLOAK_CLIENT_SECRET}, timeout=10)
+    r.raise_for_status()
+    return r.json()["access_token"]
+
+def fetch_roles(token):
+    url = f"{KEYCLOAK_URL}/admin/realms/{KEYCLOAK_REALM}/roles"
+    r = requests.get(url, headers={"Authorization":f"Bearer {token}"}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def build_rbac_from_roles(roles):
+    # Simple mapping example: role name -> allowed actions (operator should extend)
+    out = {}
+    for r in roles:
+        name = r.get("name")
+        if not name:
+            continue
+        # Example convention: role names with prefix "agent_" map to agent roles
+        if name.startswith("agent_"):
+            out[name] = {"allowed": ["k8s.scale_deployment","k8s.get_status","k8s.read_configmap"]}
+    return out
+
+def write_configmap(data):
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    v1 = client.CoreV1Api()
+    body = client.V1ConfigMap(metadata=client.V1ObjectMeta(name=CM_NAME), data={"rbac.json": json.dumps(data)})
+    try:
+        v1.create_namespaced_config_map(namespace=K8S_NAMESPACE, body=body)
+    except client.exceptions.ApiException as e:
+        if e.status == 409:
+            v1.patch_namespaced_config_map(name=CM_NAME, namespace=K8S_NAMESPACE, body=body)
+        else:
+            raise
+    return True
+
+def main():
+    try:
+        token = get_token()
+        roles = fetch_roles(token)
+        rmap = build_rbac_from_roles(roles)
+        write_configmap(rmap)
+        print("Synced RBAC configmap", CM_NAME)
+    except Exception as e:
+        print("Keycloak sync failed:", e)
+
+if __name__=="__main__":
+    main()
+
