+"""
+Edge TPU adapter scaffold for Aegis.
+ - Detects nodes labeled for coral and deploys serving pod with compiled model.
+ - Submits a provenance-wrapped inference job and collects results.
+ - This is a lightweight orchestration adapter (not vendor-managed).
+"""
+import os
+import json
+import subprocess
+from glob import glob
+
+NODE_LABEL_KEY = "aegis/npu"
+NODE_LABEL_VAL = "coral"
+
+def find_nodes():
+    out = subprocess.check_output(["kubectl", "get", "nodes", "-l", f"{NODE_LABEL_KEY}={NODE_LABEL_VAL}", "-o", "name"], text=True)
+    return [l.strip().split("/",1)[-1] for l in out.splitlines() if l.strip()]
+
+def deploy_serving(image, model_path, name="edge-tpu-serving"):
+    # simple deployment manifest for host-mounted device access (privileged)
+    manifest = f"""
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: {name}
+  namespace: aegis-ml
+spec:
+  replicas: 1
+  template:
+    spec:
+      nodeSelector:
+        {NODE_LABEL_KEY}: "{NODE_LABEL_VAL}"
+      containers:
+      - name: server
+        image: {image}
+        securityContext:
+          privileged: true
+        volumeMounts:
+        - name: dev
+          mountPath: /dev
+      volumes:
+      - name: dev
+        hostPath:
+          path: /dev
+"""
+    p = "/tmp/edge_tpu_serving.yaml"
+    open(p,"w").write(manifest)
+    subprocess.check_call(["kubectl", "apply", "-f", p])
+    return p
+
+def submit_inference(url, payload):
+    import requests
+    r = requests.post(url, json=payload, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
