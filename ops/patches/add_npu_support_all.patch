+#!/usr/bin/env python3
+"""
+Generic NPU compile & deploy scaffold.
+ - Reads ops/npu/generic/npu_config.json to discover tool commands per vendor
+ - Runs compile command, writes provenance and returns compiled artifact path
+ - Deploy helper writes a k8s manifest with nodeSelector based on config
+"""
+import os
+import json
+import subprocess
+from datetime import datetime
+
+CONFIG_PATH = "ops/npu/generic/npu_config.json"
+
+def load_cfg():
+    if os.path.exists(CONFIG_PATH):
+        return json.load(open(CONFIG_PATH))
+    return {}
+
+def compile_model(vendor, input_model, out_dir=None):
+    cfg = load_cfg().get(vendor, {})
+    cmd_tpl = cfg.get("compile_cmd")
+    if not cmd_tpl:
+        raise RuntimeError("No compile_cmd configured for vendor " + vendor)
+    out_dir = out_dir or os.path.dirname(input_model)
+    cmd = cmd_tpl.replace("{input}", input_model).replace("{out}", out_dir)
+    subprocess.check_call(cmd.split())
+    prov = {"vendor": vendor, "cmd": cmd, "ts": datetime.utcnow().isoformat()+"Z"}
+    prov_path = os.path.join(out_dir, f"{vendor}_compile.prov.json")
+    json.dump(prov, open(prov_path,"w"), indent=2)
+    return out_dir, prov_path
+
+def deploy_model(vendor, image, model_path, name="npu-serving"):
+    cfg = load_cfg().get(vendor, {})
+    label_key = cfg.get("node_label_key", "aegis/npu")
+    label_val = cfg.get("node_label_val", vendor)
+    manifest = f"""
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: {name}
+  namespace: aegis-ml
+spec:
+  replicas: 1
+  template:
+    spec:
+      nodeSelector:
+        {label_key}: "{label_val}"
+      containers:
+      - name: server
+        image: {image}
+        volumeMounts:
+        - name: model
+          mountPath: /models
+      volumes:
+      - name: model
+        hostPath:
+          path: {model_path}
+"""
+    p = "/tmp/npu_generic_serving.yaml"
+    open(p,"w").write(manifest)
+    subprocess.check_call(["kubectl","apply","-f",p])
+    return p
+
+if __name__ == "__main__":
+    print("Generic NPU scaffold loaded; configure", CONFIG_PATH)
+
