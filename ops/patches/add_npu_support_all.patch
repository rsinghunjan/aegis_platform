+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Label Kubernetes nodes for NPU types.
+# Usage:
+#   ./ops/npu/label_npu_nodes.sh <label-key> <label-value>
+# Examples:
+#   ./ops/npu/label_npu_nodes.sh aegis/npu coral
+#   ./ops/npu/label_npu_nodes.sh aegis/npu inferentia
+LABEL_KEY=${1:-aegis/npu}
+LABEL_VALUE=${2:-generic}
+
+for n in $(kubectl get nodes -o jsonpath='{.items[*].metadata.name}'); do
+  echo "Labeling node $n -> $LABEL_KEY=$LABEL_VALUE"
+  kubectl label node "$n" "$LABEL_KEY"="$LABEL_VALUE" --overwrite || true
+done
+
+echo "Labeling complete."
+
