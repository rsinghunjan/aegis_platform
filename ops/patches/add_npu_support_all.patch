+#!/usr/bin/env python3
+"""
+Compare inference outputs between CPU baseline and NPU runtime for a small test batch.
+ - Load baseline outputs (JSONL) and NPU outputs and compute per-sample diffs.
+ - Fail if max diff > tolerance.
+"""
+import json
+import sys
+from math import fabs
+
+def compare(cpu_path, npu_path, tol=1e-3):
+    cpu = [json.loads(l) for l in open(cpu_path)]
+    npu = [json.loads(l) for l in open(npu_path)]
+    if len(cpu) != len(npu):
+        print("Mismatched lengths"); return 2
+    max_diff = 0.0
+    for a,b in zip(cpu,npu):
+        # assume outputs are dicts of floats
+        for k in a:
+            d = fabs(a[k] - b.get(k,0.0))
+            if d > max_diff: max_diff = d
+            if d > tol:
+                print("Exceeded tol for key", k, "diff", d); return 2
+    print("All diffs within tol; max_diff", max_diff)
+    return 0
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        print("Usage: compare_inference.py cpu.jsonl npu.jsonl [tol]"); sys.exit(2)
+    tol = float(sys.argv[3]) if len(sys.argv) > 3 else 1e-3
+    raise SystemExit(compare(sys.argv[1], sys.argv[2], tol))
+
