+#!/usr/bin/env python3
+"""
+Edge TPU (Coral) compiler wrapper.
+ - Requires edgetpu_compiler in PATH.
+ - Input: model.tflite -> Output: model_edgetpu.tflite
+ - Writes provenance JSON with compiler version and args.
+"""
+import os
+import json
+import subprocess
+from datetime import datetime
+
+def compile_tflite(input_tflite, out_tflite=None, extra_args=None):
+    if out_tflite is None:
+        base = os.path.splitext(input_tflite)[0]
+        out_tflite = base + "_edgetpu.tflite"
+    args = ["edgetpu_compiler", input_tflite, "-o", os.path.dirname(out_tflite)]
+    if extra_args:
+        args += extra_args
+    subprocess.check_call(args)
+    prov = {
+        "compiler": "edgetpu_compiler",
+        "cmd": " ".join(args),
+        "output": out_tflite,
+        "ts": datetime.utcnow().isoformat()+"Z"
+    }
+    prov_path = out_tflite + ".prov.json"
+    json.dump(prov, open(prov_path, "w"), indent=2)
+    return out_tflite, prov_path
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--input", required=True)
+    p.add_argument("--out", default=None)
+    args = p.parse_args()
+    print(compile_tflite(args.input, args.out))
+
