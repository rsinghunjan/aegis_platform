+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run long duration load tests against a service and collect simple metrics.
+# Usage: ./ops/sre/run_long_loadtest.sh http://model-server:8080/health 3600 50
+#   where 3600 = seconds duration, 50 = requests per second
+ENDPOINT=${1:-http://127.0.0.1:8080/health}
+DURATION=${2:-600}
+RPS=${3:-20}
+OUTDIR=${OUTDIR:-/tmp/aegis_loadtest}
+mkdir -p "$OUTDIR"
+
+echo "Starting long load test against $ENDPOINT for $DURATION seconds at $RPS RPS"
+end=$((SECONDS + DURATION))
+total=0
+errors=0
+while [ $SECONDS -lt $end ]; do
+  for i in $(seq 1 $RPS); do
+    (curl -s -o /dev/null -w "%{http_code}" "$ENDPOINT" || echo "000") &
+  done
+  wait
+  sleep 1
+done
+echo "Load test complete. (Detailed telemetry should be via Prometheus/Grafana)"
+echo "{\"endpoint\":\"$ENDPOINT\",\"duration\":$DURATION,\"rps\":$RPS,\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" > "$OUTDIR/last_loadtest.json"
+echo "Wrote summary to $OUTDIR/last_loadtest.json"
+
