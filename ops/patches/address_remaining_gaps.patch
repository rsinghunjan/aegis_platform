+#!/usr/bin/env python3
+"""
+AWS Cost Explorer connector skeleton for billing reconciliation.
+ - Requires AWS credentials and Cost Explorer permissions.
+ - This is a skeleton; fill with your account-specific queries and time windows.
+"""
+import os
+import boto3
+from datetime import datetime, timedelta
+
+def query_costs(days=7):
+    client = boto3.client("ce", region_name=os.environ.get("AWS_REGION"))
+    end = datetime.utcnow().date()
+    start = end - timedelta(days=days)
+    resp = client.get_cost_and_usage(
+        TimePeriod={"Start": start.isoformat(), "End": end.isoformat()},
+        Granularity="DAILY",
+        Metrics=["UnblendedCost"]
+    )
+    return resp
+
+if __name__ == "__main__":
+    print("Querying AWS Cost Explorer (requires AWS credentials)")
+    print(query_costs(7))
