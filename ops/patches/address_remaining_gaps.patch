+#!/usr/bin/env python3
+"""
+Hardware & Cloud Credential Gate Simulator
+ - Used in CI to allow flows to run in "simulated" mode when physical devices or cloud creds are not present.
+ - If real credentials/devices are present, it delegates to the real checks (if available).
+ - Produces clear /tmp/*.simulated artifacts so later CI steps can continue in mock mode.
+
+Usage:
+  python ops/ci/hardware_gate_simulator.py --check hil  # check HIL presence or simulate
+  python ops/ci/hardware_gate_simulator.py --check gpu
+  python ops/ci/hardware_gate_simulator.py --check tpu
+  python ops/ci/hardware_gate_simulator.py --check qpu
+  (Exits 0 on success, non-zero on hard failure)
+"""
+import os
+import sys
+import argparse
+import json
+import subprocess
+from datetime import datetime
+
+def simulate_artifact(name):
+    path = f"/tmp/{name}.simulated.json"
+    payload = {"simulated": True, "name": name, "ts": datetime.utcnow().isoformat()+"Z"}
+    with open(path, "w") as fh:
+        json.dump(payload, fh)
+    print("Wrote simulated artifact:", path)
+    return path
+
+def check_hil():
+    # Use existing adapter check if ACME_HIL_URL is present
+    if os.environ.get("ACME_HIL_URL") and os.environ.get("ACME_HIL_TOKEN"):
+        try:
+            subprocess.check_call(["python", "ops/tests/hardware_integration/check_hil_presence.py"])
+            print("Real HIL check passed")
+            return 0
+        except Exception as e:
+            print("Real HIL check failed:", e)
+            return 2
+    else:
+        print("ACME_HIL_URL/ACME_HIL_TOKEN not configured — simulating HIL presence")
+        simulate_artifact("hil_presence")
+        return 0
+
+def check_gpu():
+    if os.environ.get("KUBECONFIG") and os.environ.get("GPU_REQUIRED") != "false":
+        try:
+            subprocess.check_call(["python", "ops/gpu/ci/gpu_presence_check.py"])
+            print("Real GPU check passed")
+            return 0
+        except Exception as e:
+            print("Real GPU check failed:", e)
+            return 2
+    else:
+        print("KUBECONFIG or GPU cluster not configured — simulating GPU presence")
+        simulate_artifact("gpu_presence")
+        return 0
+
+def check_tpu():
+    if os.environ.get("GCP_PROJECT") and os.environ.get("TPU_REQUIRED") != "false":
+        # We cannot call gcloud in all runners; do a lightweight check
+        try:
+            subprocess.check_call(["gcloud", "compute", "tpus", "tpu-vm", "list"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            print("gcloud TPU list succeeded — assume TPU access")
+            return 0
+        except Exception:
+            print("gcloud not present or TPU not available — simulating TPU presence")
+            simulate_artifact("tpu_presence")
+            return 0
+    else:
+        print("GCP_PROJECT not set or TPU not required — simulating TPU presence")
+        simulate_artifact("tpu_presence")
+        return 0
+
+def check_qpu():
+    if os.environ.get("IONQ_API_KEY") or os.environ.get("QUANTUM_PROVIDER_KEY"):
+        print("QPU API key present — will attempt real submit in downstream job")
+        return 0
+    print("No QPU API key present — simulating QPU presence")
+    simulate_artifact("qpu_presence")
+    return 0
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--check", choices=["hil","gpu","tpu","qpu"], required=True)
+    args = p.parse_args()
+    if args.check == "hil":
+        return check_hil()
+    if args.check == "gpu":
+        return check_gpu()
+    if args.check == "tpu":
+        return check_tpu()
+    if args.check == "qpu":
+        return check_qpu()
+    return 0
+
+if __name__ == "__main__":
+    sys.exit(main())
+
