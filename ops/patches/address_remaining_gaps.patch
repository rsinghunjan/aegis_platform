+#!/usr/bin/env python3
+"""
+CI helper to enforce SME signoff presence for SMT onboarding PRs.
+ - Checks for a metadata file next to the SMT file named <id>.meta.json containing "sme_approved": true
+ - Alternatively, operators may add a file ops/formal/sme_signoff/<id>.signed to indicate SME approval.
+ - This is a soft enforcement helper; it returns non-zero when no evidence of SME approval is present.
+"""
+import os
+import sys
+import glob
+import json
+
+ONBOARD_DIR = "ops/formal/onboard_submissions"
+SME_SIGN_DIR = "ops/formal/sme_signoff"
+
+def find_pending():
+    smt_files = glob.glob(os.path.join(ONBOARD_DIR, "*.smt2"))
+    return [os.path.basename(s).rsplit(".",1)[0] for s in smt_files]
+
+def check_signoff(invariant_id):
+    meta = os.path.join(ONBOARD_DIR, f"{invariant_id}.meta.json")
+    if os.path.exists(meta):
+        try:
+            m = json.load(open(meta))
+            if m.get("sme_approved") is True:
+                print(f"{invariant_id} has sme_approved in meta")
+                return True
+        except Exception:
+            pass
+    signfile = os.path.join(SME_SIGN_DIR, f"{invariant_id}.signed")
+    if os.path.exists(signfile):
+        print(f"{invariant_id} has signoff file {signfile}")
+        return True
+    return False
+
+def main():
+    pending = find_pending()
+    if not pending:
+        print("No onboard submissions found; nothing to check.")
+        return 0
+    failures = []
+    for pid in pending:
+        if not check_signoff(pid):
+            failures.append(pid)
+    if failures:
+        print("SME signoff missing for:", failures)
+        print("Add ops/formal/onboard_submissions/<id>.meta.json with {\"sme_approved\": true} or create ops/formal/sme_signoff/<id>.signed")
+        return 2
+    print("All onboard submissions have SME signoff")
+    return 0
+
+if __name__ == "__main__":
+    sys.exit(main())
+
