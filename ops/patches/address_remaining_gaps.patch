+#!/usr/bin/env python3
+"""
+Mock billing connector and reconciler.
+ - Generates synthetic billing events for QPU/TPU/GPU jobs to allow CI to validate billing_reconcile flows without real provider keys.
+ - Reconcile compares expected costs (based on job metadata) vs reported (mock) and emits discrepancy report.
+"""
+import json
+import random
+import os
+from datetime import datetime
+
+OUT="/tmp/mock_billing_report.json"
+
+def generate_mock_events(num=10):
+    events = []
+    for i in range(num):
+        ev = {
+            "job_id": f"job-{i}",
+            "resource": random.choice(["qpu","tpu","gpu"]),
+            "cost_usd": round(random.uniform(0.01, 5.0), 4),
+            "ts": datetime.utcnow().isoformat()+"Z"
+        }
+        events.append(ev)
+    with open(OUT,"w") as fh:
+        json.dump(events, fh, indent=2)
+    print("Wrote mock billing events to", OUT)
+    return OUT
+
+def reconcile(expected_path, reported_path=OUT):
+    expected = json.load(open(expected_path)) if os.path.exists(expected_path) else {}
+    reported = json.load(open(reported_path))
+    # Simple reconcile: sum costs
+    expected_total = sum([e.get("expected_cost_usd",0.0) for e in expected.get("jobs",[])])
+    reported_total = sum([r.get("cost_usd",0.0) for r in reported])
+    diff = reported_total - expected_total
+    report = {"expected_total": expected_total, "reported_total": reported_total, "diff": diff, "ts": datetime.utcnow().isoformat()+"Z"}
+    print("Reconcile report:", report)
+    return report
+
+if __name__ == "__main__":
+    generate_mock_events()
+
