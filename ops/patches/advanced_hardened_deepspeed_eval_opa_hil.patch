+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Run a container under gVisor runsc (PoC).
+# Requirements: runsc installed and registered as a containerd runtime (or use singular runsc binary wrapper).
+#
+# Usage:
+#   ./run_with_runsc.sh --image your-image:tag --name job1 --cmd "python app.py"
+
+IMAGE=""
+NAME="aegis-sandbox"
+CMD=""
+MEM="512m"
+CPU="1"
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --image) IMAGE="$2"; shift 2;;
+    --name) NAME="$2"; shift 2;;
+    --cmd) CMD="$2"; shift 2;;
+    --mem) MEM="$2"; shift 2;;
+    --cpu) CPU="$2"; shift 2;;
+    *) echo "Unknown arg $1"; exit 1;;
+  esac
+done
+
+if [ -z "$IMAGE" ]; then
+  echo "Specify --image"
+  exit 1
+fi
+
+if [ -z "$CMD" ]; then
+  CMD="/bin/sh -c 'sleep 3600'"
+fi
+
+echo "Running container $NAME with image $IMAGE under runsc (gVisor PoC)"
+# If runsc is configured as runtime in containerd, you can use ctr or nerdctl with --runtime runsc
+if command -v nerdctl >/dev/null 2>&1; then
+  nerdctl run --rm --runtime runsc --memory "$MEM" --cpus "$CPU" --name "$NAME" -d "$IMAGE" sh -c "$CMD"
+else
+  echo "nerdctl not found. Try installing containerd/nerdctl and configure runsc as a runtimeclass."
+  echo "Fallback: docker run (NOT sandboxed) - replace with runsc installation for production"
+  docker run --rm --name "$NAME" -d --memory "$MEM" --cpus "$CPU" "$IMAGE" sh -c "$CMD"
+fi
+
+echo "Launched. Use 'nerdctl ps' or 'docker ps' to inspect."
+
