+#!/usr/bin/env python3
+"""
+ROS2 node (PoC) that listens for 'safety/estop' topic and issues HTTP E-STOP to controller.
+Requires rclpy and requests.
+"""
+try:
+    import rclpy
+    from rclpy.node import Node
+    from std_msgs.msg import Bool
+except Exception:
+    rclpy = None
+
+import requests
+import os
+
+ESTOP_API = os.environ.get("HIL_ESTOP_API", "http://localhost:9001/trigger")
+RESET_API = os.environ.get("HIL_ESTOP_RESET_API", "http://localhost:9001/reset")
+
+if rclpy:
+    class EStopNode(Node):
+        def __init__(self):
+            super().__init__("aegis_estop_node")
+            self.sub = self.create_subscription(Bool, "safety/estop", self.cb, 10)
+
+        def cb(self, msg):
+            if msg.data:
+                try:
+                    r = requests.post(ESTOP_API, timeout=2)
+                    self.get_logger().info(f"E-STOP triggered: {r.status_code}")
+                except Exception as e:
+                    self.get_logger().error(f"Failed to call estop api: {e}")
+            else:
+                try:
+                    r = requests.post(RESET_API, timeout=2)
+                    self.get_logger().info(f"E-STOP reset: {r.status_code}")
+                except Exception as e:
+                    self.get_logger().error(f"Failed reset api: {e}")
+
+    def main():
+        rclpy.init()
+        node = EStopNode()
+        rclpy.spin(node)
+        node.destroy_node()
+        rclpy.shutdown()
+else:
+    def main():
+        print("rclpy not available; install ROS2 Python packages to enable estop node")
+
+if __name__ == "__main__":
+    main()
+
