+#!/usr/bin/env python3
+"""
+Dataset adapter for generative evaluation.
+Supports loading image and text datasets with a manifest JSONL file:
+  {"id":..., "image": "s3://... or path", "text": "reference text"}
+"""
+import json
+import os
+from typing import Iterable, Dict
+import boto3
+import tempfile
+
+def download_s3(uri: str) -> str:
+    bucket = uri.replace("s3://","").split("/")[0]
+    key = "/".join(uri.replace("s3://","").split("/")[1:])
+    tmp = tempfile.mktemp(suffix=os.path.basename(key))
+    s3 = boto3.client("s3")
+    s3.download_file(bucket, key, tmp)
+    return tmp
+
+def iter_manifest(manifest_path: str) -> Iterable[Dict]:
+    with open(manifest_path) as f:
+        for line in f:
+            yield json.loads(line)
+
