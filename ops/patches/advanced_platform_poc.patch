+#!/usr/bin/env python3
+"""
+Closed-loop Carbon Optimizer (PoC)
+
+Purpose:
+- Provide a lightweight service that recommends placement/deferral decisions for training/inference
+  jobs based on Prometheus-scraped GPU power metrics, regional intensity, and latency SLAs.
+- Intended as a PoC optimizer to be invoked by Tekton interceptors, Tekton Tasks, or the inference gateway.
+
+API:
+- POST /optimize
+  payload:
+    {
+      "job_id": "abc123",
+      "model_name": "vision_encoder",
+      "latency_sla_ms": 200,
+      "candidates": { "us-east": "https://us.example/generate", "eu-west": "https://eu.example/generate" },
+      "metadata": { ... }
+    }
+  returns:
+    {
+      "choice": "eu-west",
+      "reason": "lowest_estimated_carbon_within_latency",
+      "estimates": { "us-east": {"kg":0.45, "latency_ms":120}, "eu-west": {...} }
+    }
+
+Notes:
+- This PoC uses simple heuristics: estimated energy = recent average power * expected_duration; carbon = kWh * intensity.
+- For production, replace heuristics with an ML optimizer or ILP using real latency profiling and historical telemetry.
+"""
+import os
+import time
+import json
+import logging
+from typing import Dict, Any
+
+import requests
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+logger = logging.getLogger("carbon-optimizer")
+logging.basicConfig(level=logging.INFO)
+
+PROM_HOST = os.environ.get("PROM_HOST", "http://prometheus.monitoring.svc:9090")
+INTENSITY_URL = os.environ.get("INTENSITY_URL", "http://carbon-intensity-service.monitoring.svc:8080")
+DEFAULT_JOB_DURATION_S = int(os.environ.get("DEFAULT_JOB_DURATION_S", "3600"))  # 1h default
+
+app = FastAPI(title="Aegis Carbon Optimizer (PoC)")
+
+
+class OptimizeRequest(BaseModel):
+    job_id: str
+    model_name: str
+    latency_sla_ms: int
+    candidates: Dict[str, str]
+    metadata: Dict[str, Any] = {}
+
+
+def query_prometheus_power(candidate_endpoint: str, lookback_s: int = 300) -> float:
+    """
+    Attempt to estimate recent average power (watts) for a candidate endpoint by matching region labels.
+    This is heuristic: in real deployments, candidate -> node/job mapping must be precise.
+    """
+    try:
+        # Example query: avg_over_time(dcgm_nvml_power_draw_watts[5m]) by (instance) - simplified demo
+        q = 'avg_over_time(dcgm_nvml_power_draw_watts[5m])'
+        r = requests.get(f"{PROM_HOST}/api/v1/query", params={"query": q}, timeout=8)
+        r.raise_for_status()
+        data = r.json().get("data", {}).get("result", [])
+        # pick the first numeric value as heuristic
+        if not data:
+            return 0.0
+        v = float(data[0].get("value", [])[1])
+        return v
+    except Exception as e:
+        logger.warning("prometheus query failed: %s", e)
+        return 0.0
+
+
+def query_region_intensity(region_hint: str) -> float:
+    """Query intensity service for recent gCO2e/kWh (heuristic by region)."""
+    try:
+        r = requests.get(f"{INTENSITY_URL}/intensity?region={region_hint}", timeout=5)
+        r.raise_for_status()
+        j = r.json()
+        return float(j.get("intensity_gCO2_per_kWh", j.get("gCO2_per_kWh", 400.0))) / 1000.0  # convert g -> kg
+    except Exception as e:
+        logger.warning("intensity query failed: %s", e)
+        return 0.4  # default 0.4 kgCO2e/kWh
+
+
+@app.post("/optimize")
+def optimize(req: OptimizeRequest):
+    # Simple heuristic: for each candidate compute estimated kgCO2e and check latency via optional probe
+    estimates = {}
+    for region, endpoint in req.candidates.items():
+        # estimate power (watts) from Prometheus (heuristic, not tied to endpoint)
+        power_w = query_prometheus_power(endpoint)
+        if power_w <= 0:
+            # fallback to conservative default
+            power_w = 300.0
+        # estimate energy (kWh) = power_w * hours
+        duration_h = (req.metadata.get("expected_duration_s") or DEFAULT_JOB_DURATION_S) / 3600.0
+        kwh = (power_w * duration_h) / 1000.0
+        intensity = query_region_intensity(region)
+        kgco2 = kwh * intensity
+        # optional quick latency probe (best-effort)
+        latency_ms = None
+        try:
+            t0 = time.time()
+            r = requests.options(endpoint, timeout=1)
+            latency_ms = int((time.time() - t0) * 1000)
+        except Exception:
+            latency_ms = 9999
+        estimates[region] = {"kg": round(kgco2, 6), "latency_ms": latency_ms, "power_w": round(power_w,1), "kwh": round(kwh,6)}
+
+    # Filter candidates that meet latency SLA
+    feasible = {r: v for r, v in estimates.items() if v["latency_ms"] <= req.latency_sla_ms}
+    if not feasible:
+        # If none feasible, choose lowest latency among all and flag deferral suggestion
+        choice = min(estimates.items(), key=lambda it: it[1]["latency_ms"])[0]
+        reason = "no_candidate_within_latency_sla; chose_lowest_latency (consider deferring or relaxing SLA)"
+    else:
+        # choose lowest kg among feasible
+        choice = min(feasible.items(), key=lambda it: it[1]["kg"])[0]
+        reason = "lowest_estimated_carbon_within_latency"
+
+    return {"choice": choice, "reason": reason, "estimates": estimates}
+
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run("services.carbon.optimizer:app", host="0.0.0.0", port=int(os.environ.get("PORT", "8082")))
+
