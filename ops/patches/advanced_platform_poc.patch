+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple operator wrapper that calls the optimizer service and applies a nodeSelector to a Tekton PipelineRun (best-effort).
+#
+PIPELINERUN=${1:-}
+OPT_URL=${OPT_URL:-http://carbon-optimizer.monitoring.svc:8082/optimize}
+if [ -z "$PIPELINERUN" ]; then
+  echo "Usage: $0 <pipelinerun-name> (will read namespace 'cicd' by default)"
+  exit 2
+fi
+NS=${NAMESPACE:-cicd}
+
+echo "Fetching PipelineRun $PIPELINERUN in namespace $NS"
+pr=$(kubectl -n "$NS" get pipelinerun "$PIPELINERUN" -o json)
+model_name=$(echo "$pr" | jq -r '.metadata.annotations["aegis.model_name"] // empty')
+job_id=$(echo "$pr" | jq -r '.metadata.annotations["aegis.job_id"] // empty')
+latency=$(echo "$pr" | jq -r '.metadata.annotations["aegis.latency_sla_ms"] // "200"')
+
+if [ -z "$model_name" ]; then
+  echo "PipelineRun missing aegis.model_name annotation; aborting"
+  exit 3
+fi
+
+echo "Calling optimizer for model=$model_name job_id=$job_id"
+payload=$(jq -n --arg jid "$job_id" --arg mn "$model_name" --argjson candidates '{"us-east":"https://us.example","eu-west":"https://eu.example"}' --argjson meta '{}' --arg lat "$latency" '{job_id:$jid, model_name:$mn, latency_sla_ms:(($lat|tonumber)), candidates:$candidates, metadata:$meta}')
+
+resp=$(curl -sS -X POST -H "Content-Type: application/json" -d "$payload" "$OPT_URL")
+choice=$(echo "$resp" | jq -r .choice)
+echo "Optimizer chose: $choice"
+
+if [ -n "$choice" ] && [ "$choice" != "null" ]; then
+  echo "Patching PipelineRun to add annotation aegis.placement=$choice"
+  kubectl -n "$NS" patch pipelinerun "$PIPELINERUN" --type='merge' -p "{\"metadata\": {\"annotations\": {\"aegis.placement\": \"$choice\"}}}"
+  echo "Patch applied"
+else
+  echo "No placement choice returned"
+fi
+
