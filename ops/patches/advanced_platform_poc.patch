+#!/usr/bin/env python3
+"""
+AI Operator (scaffold PoC)
+
+Purpose:
+- A lightweight "operator assistant" that monitors simple signals and proposes (and optionally executes)
+  safe operational actions such as scaling down a deployment, re-routing traffic, or triggering a rollback.
+- All proposals are stored and require approval before execution (policy gates).
+- Every action is recorded to the evidence bucket for audit.
+
+API:
+- GET  /proposals          -> list proposals
+- POST /proposals          -> create a proposal (propose action)
+- POST /proposals/{id}/approve -> approve & execute
+- GET  /health
+"""
+import os
+import time
+import uuid
+import json
+import logging
+from typing import Dict, Any
+
+import requests
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+logger = logging.getLogger("ai-operator")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+REGION = os.environ.get("AEGIS_REGION", "control-plane")
+
+app = FastAPI(title="Aegis AI Operator (PoC)")
+
+# In-memory proposal store (demo). Replace with persistent DB in production.
+PROPOSALS: Dict[str, Dict[str, Any]] = {}
+
+
+class ProposalReq(BaseModel):
+    title: str
+    description: str
+    action: Dict[str, Any]  # e.g., {"type":"scale","target":"deployment/foo","replicas":1}
+    author: str = "ai-operator"
+
+
+def upload_evidence(key_prefix: str, payload: Dict[str, Any]):
+    if not EVIDENCE_BUCKET:
+        # fallback to local file
+        path = f"/tmp/ai_operator_evidence_{int(time.time())}.json"
+        with open(path, "w") as f:
+            json.dump(payload, f, indent=2)
+        logger.info("Wrote evidence locally: %s", path)
+        return path
+    try:
+        import boto3
+        s3 = boto3.client("s3")
+        key = f"{key_prefix}/{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode("utf-8"))
+        uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+        logger.info("Uploaded evidence to %s", uri)
+        return uri
+    except Exception as e:
+        logger.warning("Failed to upload evidence: %s", e)
+        return None
+
+
+@app.post("/proposals")
+def create_proposal(req: ProposalReq):
+    pid = str(uuid.uuid4())
+    p = {
+        "id": pid,
+        "title": req.title,
+        "description": req.description,
+        "action": req.action,
+        "author": req.author,
+        "state": "proposed",
+        "created_at": int(time.time()),
+    }
+    PROPOSALS[pid] = p
+    upload_evidence("operator/proposals", p)
+    return p
+
+
+@app.get("/proposals")
+def list_proposals():
+    return {"proposals": list(PROPOSALS.values())}
+
+
+def execute_action(act: Dict[str, Any]):
+    """
+    Execute the action. PoC supports a tiny set:
+      - scale: {"type":"scale","target":"deployment/<name>","replicas":N}
+      - annotate: {"type":"annotate","target":"model","name":"x","version":"v1","annotations":{...}}
+    """
+    t = act.get("type")
+    if t == "scale":
+        target = act.get("target")
+        replicas = int(act.get("replicas", 1))
+        # basic kubectl patch (best-effort)
+        try:
+            cmd = ["kubectl", "scale", "--replicas=%d" % replicas, act.get("target")]
+            logger.info("Executing scale command: %s", " ".join(cmd))
+            import subprocess
+            subprocess.check_call(cmd)
+            return {"ok": True, "detail": "scaled"}
+        except Exception as e:
+            return {"ok": False, "error": str(e)}
+    elif t == "annotate":
+        # annotate model in registry via API
+        try:
+            reg = os.environ.get("MODEL_REGISTRY_URL", "http://aegis-model-registry.monitoring.svc:8081")
+            name = act.get("name"); ver = act.get("version"); anns = act.get("annotations", {})
+            r = requests.post(f"{reg}/models/{name}/versions/{ver}/annotations", json={"annotations": anns}, timeout=10)
+            r.raise_for_status()
+            return {"ok": True, "detail": "annotated"}
+        except Exception as e:
+            return {"ok": False, "error": str(e)}
+    else:
+        return {"ok": False, "error": "unsupported action type"}
+
+
+@app.post("/proposals/{pid}/approve")
+def approve_and_execute(pid: str, approver: str = "operator-admin"):
+    p = PROPOSALS.get(pid)
+    if not p:
+        raise HTTPException(status_code=404, detail="proposal not found")
+    if p["state"] != "proposed":
+        raise HTTPException(status_code=400, detail="proposal not in proposed state")
+    p["state"] = "approved"
+    p["approver"] = approver
+    p["approved_at"] = int(time.time())
+    upload_evidence("operator/proposals", {"event": "approved", "proposal": p})
+
+    # Execute action (synchronously for PoC)
+    res = execute_action(p["action"])
+    p["execution"] = res
+    p["executed_at"] = int(time.time())
+    upload_evidence("operator/executions", {"proposal": p, "result": res})
+    return {"proposal": p, "result": res}
+
+
+@app.get("/health")
+def health():
+    return {"status": "ok", "region": REGION}
+
