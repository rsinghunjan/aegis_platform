+#!/usr/bin/env python3
+"""
+Explainability & counterfactual PoC service
+
+Purpose:
+- Provide a small REST API to compute feature attributions (SHAP style) and simple counterfactual perturbations.
+- For PoC we include a lightweight stub that can be replaced with real model-backed explainers.
+
+API:
+- POST /explain
+  { "model_uri": "...", "input": { ... } } -> { "attributions": { "feature": value, ... } }
+- POST /counterfactual
+  { "model_uri": "...", "input": {...}, "target": 1 } -> { "cf": {...}, "changes": {...} }
+"""
+import os
+import json
+import logging
+from typing import Dict, Any
+
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+
+logger = logging.getLogger("explainability")
+logging.basicConfig(level=logging.INFO)
+
+app = FastAPI(title="Aegis Explainability PoC")
+
+
+class ExplainReq(BaseModel):
+    model_uri: str
+    input: Dict[str, Any]
+
+
+class CFReq(ExplainReq):
+    target: Any
+
+
+@app.post("/explain")
+def explain(req: ExplainReq):
+    # PoC: return symmetric dummy attributions proportional to value magnitudes
+    inp = req.input
+    atts = {}
+    total = 0.0
+    for k, v in inp.items():
+        try:
+            mag = abs(float(v))
+        except Exception:
+            mag = 1.0
+        atts[k] = mag
+        total += mag
+    # normalize and sign-preserve (simple)
+    for k in atts:
+        atts[k] = round(atts[k] / (total or 1.0), 4)
+    return {"model": req.model_uri, "attributions": atts}
+
+
+@app.post("/counterfactual")
+def counterfactual(req: CFReq):
+    # PoC: flip smallest-magnitude numeric feature to push prediction toward target
+    inp = req.input.copy()
+    numeric = [(k, float(v)) for k, v in inp.items() if isinstance(v, (int, float))]
+    if not numeric:
+        raise HTTPException(status_code=400, detail="no numeric features for PoC counterfactual")
+    numeric.sort(key=lambda it: abs(it[1]))
+    key, val = numeric[0]
+    cf = inp.copy()
+    cf[key] = val + (1.0 if req.target else -1.0)
+    changes = {key: {"from": val, "to": cf[key]}}
+    return {"model": req.model_uri, "cf": cf, "changes": changes}
+
