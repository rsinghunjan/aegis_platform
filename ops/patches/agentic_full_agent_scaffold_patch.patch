+#!/usr/bin/env python3
+"""
+Simple circuit breaker service for agent execution
+- Allows disabling agent automation globally or per-namespace; tracks recent failures and trips when threshold exceeded.
+"""
+import os, time
+from typing import Dict
+
+BREAKER_STATE = {"global_disabled": False, "namespace": {}}
+FAIL_HISTORY = {}  # namespace -> list of timestamps
+FAIL_WINDOW_S = int(os.environ.get("CB_FAIL_WINDOW_S", "600"))
+FAIL_THRESHOLD = int(os.environ.get("CB_FAIL_THRESHOLD", "3"))
+
+def record_failure(namespace: str):
+    ts = int(time.time())
+    FAIL_HISTORY.setdefault(namespace, []).append(ts)
+    # purge old
+    FAIL_HISTORY[namespace] = [t for t in FAIL_HISTORY[namespace] if t >= ts - FAIL_WINDOW_S]
+    if len(FAIL_HISTORY[namespace]) >= FAIL_THRESHOLD:
+        BREAKER_STATE["namespace"][namespace] = True
+
+def clear_failures(namespace: str):
+    FAIL_HISTORY[namespace] = []
+    BREAKER_STATE["namespace"][namespace] = False
+
+def is_allowed(namespace: str) -> bool:
+    if BREAKER_STATE["global_disabled"]:
+        return False
+    if BREAKER_STATE["namespace"].get(namespace, False):
+        return False
+    return True
+
+def disable_global():
+    BREAKER_STATE["global_disabled"] = True
+
+def enable_global():
+    BREAKER_STATE["global_disabled"] = False
+
