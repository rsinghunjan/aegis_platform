+#!/usr/bin/env bash
+#
+# Sample integration: propose plan via LLM planner, simulate, then execute against agent executor.
+#
+set -euo pipefail
+ORCH=${ORCH_URL:-http://localhost:8080}
+INTENT=${1:-"scale verifier to 2"}
+
+echo "Propose via LLM planner"
+PROPOSE=$(curl -s -X POST -H "Content-Type: application/json" -d "{\"requester\":\"ci\",\"intent\":\"$INTENT\"}" $ORCH/propose)
+echo "Planner output:"
+echo "$PROPOSE" | jq .
+
+PLAN=$(echo "$PROPOSE" | jq -c '{plan: .plan}')
+echo "Write plan to /tmp/plan.json"
+echo "$PLAN" > /tmp/plan.json
+
+echo "Simulate plan with trace (optional)..."
+python services/agent/simulator/trace_replayer_v2.py --plan /tmp/plan.json --trace ops/multimodal/sample_trace.json || true
+
+echo "Execute plan (this will create an AgentAction CR via orchestrator execute)"
+EXEC=$(curl -s -X POST -H "Content-Type: application/json" -d "{\"requester\":\"ci\",\"intent\":\"$INTENT\"}" $ORCH/execute)
+echo "Execute response: $EXEC" | jq .
+
+NAME=$(echo "$EXEC" | jq -r .name)
+echo "Polling status..."
+for i in $(seq 1 60); do
+  sleep 2
+  ST=$(curl -s $ORCH/status/$NAME | jq -r .state)
+  echo "state=$ST"
+  if [[ "$ST" == "succeeded" || "$ST" == "failed" || "$ST" == "rejected" || "$ST" == "pending_human" ]]; then
+    curl -s $ORCH/status/$NAME | jq .
+    exit 0
+  fi
+done
+echo "Timeout waiting for action"
+exit 2
