+#!/usr/bin/env python3
+"""
+Enhanced trace replayer/simulator
+- Accepts structured event traces and given a plan returns simulated downstream metrics:
+  - estimated_reward, estimated_risk, estimated_divergence, suggested_mitigation
+- Uses simple heuristics now; pluggable ML model later.
+"""
+import json, argparse, random, statistics
+
+def simulate_step_on_trace(step, traces):
+    # heuristics: policy updates produce higher reward but higher risk proportional to pct change
+    reward = 0.0
+    risk = 0.0
+    divergence = 0.0
+    if step.get("tool") == "policy":
+        inc = step.get("params",{}).get("student_pct_increase", 0)
+        reward += min(0.5, inc/100.0)
+        risk += min(1.0, inc/50.0)
+    if step.get("tool") == "k8s" and step.get("action") == "set_image":
+        reward += 0.1
+        risk += 0.05
+    # simulate trace-based divergence
+    divergence = random.uniform(0, 0.2)
+    return {"reward": reward, "risk": risk, "divergence": divergence}
+
+def simulate_plan(plan, trace_file):
+    traces = json.load(open(trace_file)) if trace_file else []
+    res=[]
+    for s in plan:
+        r = simulate_step_on_trace(s, traces)
+        res.append({"step": s, "sim": r})
+    summary = {"total_reward": sum(x["sim"]["reward"] for x in res), "max_risk": max(x["sim"]["risk"] for x in res) if res else 0, "avg_divergence": statistics.mean([x["sim"]["divergence"] for x in res]) if res else 0}
+    return {"steps": res, "summary": summary}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--plan", required=True)
+    p.add_argument("--trace", required=False, default=None)
+    args = p.parse_args()
+    plan = json.load(open(args.plan))
+    out = simulate_plan(plan.get("plan",[]), args.trace)
+    print(json.dumps(out, indent=2))
+
+if __name__=="__main__":
+    main()
+
