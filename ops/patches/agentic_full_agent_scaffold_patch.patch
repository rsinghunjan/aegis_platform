+#!/usr/bin/env python3
+"""
+Pre/post execution verifier checks for agent actions
+- Calls verifier scoring service to evaluate whether an action proposal is safe to execute
+- The verifier endpoint is expected to implement a lightweight check API
+"""
+import os, requests, json
+
+VERIFIER_URL = os.environ.get("VERIFIER_CHECK_URL", "http://verifier.safety.svc:8080/check_action")
+VERIFIER_TIMEOUT = int(os.environ.get("VERIFIER_CHECK_TIMEOUT_S", "5"))
+
+def pre_check(action: dict) -> (bool, dict):
+    """
+    Return (allowed, details). Posts action metadata to verifier service which returns {allow: bool, reason: str}
+    If verifier is unavailable, default to conservative deny (or allow based on policy).
+    """
+    try:
+        resp = requests.post(VERIFIER_URL, json={"action": action}, timeout=VERIFIER_TIMEOUT)
+        resp.raise_for_status()
+        j = resp.json()
+        return bool(j.get("allow", False)), j
+    except Exception as e:
+        # conservative: deny if verifier unreachable
+        return False, {"error": str(e)}
+
+def post_check(action: dict, result: dict) -> dict:
+    # record outcome to verifier for auditing; may return remediation suggestions
+    try:
+        resp = requests.post(VERIFIER_URL + "/record", json={"action": action, "result": result}, timeout=VERIFIER_TIMEOUT)
+        resp.raise_for_status()
+        return resp.json()
+    except Exception as e:
+        return {"error": str(e)}
+
