+#!/usr/bin/env python3
+"""
+LLM-based planner scaffold (LangChain-style prompt wrapper)
+- Given a high-level intent, produce a constrained step-by-step plan consisting of tool calls.
+- Uses either an external LLM API (OpenAI-compatible) or a local LLM adapter (pluggable).
+"""
+import os
+import json
+from typing import List, Dict, Any, Optional
+
+LLM_PROVIDER = os.environ.get("LLM_PROVIDER", "local")  # "openai" or "local"
+OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY", "")
+
+PROMPT_TEMPLATE = """
+You are a constrained planner for the Aegis platform. Input: {intent}
+
+Constraints:
+- Only use the following tools: k8s.set_image, k8s.scale_deployment, policy.update_serving_policy, human.review
+- Each step must be JSON with keys: tool, action, params
+- params must include namespace and any required fields for the action
+- Keep plans short (<= 6 steps)
+- Annotate risk_level: low/medium/high as part of top-level response object.
+
+Produce output as pure JSON: {{ "risk_level": "<low|medium|high>", "plan": [ {{step}}, ... ] }}
+"""
+
+def call_openai(prompt: str) -> str:
+    import requests
+    url = "https://api.openai.com/v1/chat/completions"
+    headers = {"Authorization": f"Bearer {OPENAI_API_KEY}"}
+    data = {"model": "gpt-4o-mini", "messages": [{"role":"user","content":prompt}], "max_tokens": 512}
+    resp = requests.post(url, headers=headers, json=data, timeout=30)
+    resp.raise_for_status()
+    return resp.json()["choices"][0]["message"]["content"]
+
+def call_local_llm(prompt: str) -> str:
+    # placeholder for local LLM adapter (e.g., HF Inference API)
+    # For now we use simple heuristic fallback: convert known patterns to plan
+    if prompt.lower().find("scale verifier to") >= 0:
+        n = int(prompt.strip().split()[-1])
+        obj = {"risk_level":"low","plan":[{"tool":"k8s","action":"scale_deployment","params":{"namespace":"safety","deployment":"verifier","replicas":n}}]}
+        return json.dumps(obj)
+    # fallback empty plan
+    return json.dumps({"risk_level":"medium","plan":[{"tool":"human","action":"review","params":{"note":"LLM fallback: please author plan","namespace":"safety"}}]})
+
+def plan_for_intent_llm(intent: str, context: Optional[Dict[str,Any]]=None) -> Dict[str,Any]:
+    ctx = context or {}
+    prompt = PROMPT_TEMPLATE.format(intent=intent)
+    if LLM_PROVIDER == "openai" and OPENAI_API_KEY:
+        out = call_openai(prompt)
+    else:
+        out = call_local_llm(prompt)
+    try:
+        return json.loads(out)
+    except Exception:
+        # defensive fallback
+        return {"risk_level":"medium","plan":[{"tool":"human","action":"review","params":{"note":"planner parse failed","intent":intent,"namespace":"safety"}}]}
+
+if __name__=="__main__":
+    import sys
+    intent = " ".join(sys.argv[1:]) or "scale verifier to 2"
+    print(json.dumps(plan_for_intent_llm(intent), indent=2))
+
