+#!/usr/bin/env python3
+"""
+Tool registry for agent executor
+- Register tool metadata, allowed roles, and a callable adapter reference
+This registry is in-memory for the scaffold; an operator can back it with a DB.
+"""
+from typing import Dict, Any, Callable
+import services.agent.tool_adapters.k8s_adapter as k8s_adapter
+
+_REGISTRY: Dict[str, Dict[str, Any]] = {}
+
+def register_tool(name: str, metadata: Dict[str, Any], func: Callable):
+    _REGISTRY[name] = {"meta": metadata, "func": func}
+
+def get_tool(name: str):
+    return _REGISTRY.get(name)
+
+# register builtin tools
+register_tool("k8s.set_image", {"description":"Set deployment image","roles":["sre","ml-lead"]}, k8s_adapter.set_image)
+register_tool("k8s.scale_deployment", {"description":"Scale deployment","roles":["sre"]}, k8s_adapter.scale_deployment)
+register_tool("k8s.create_configmap", {"description":"Create/patch configmap","roles":["sre"]}, k8s_adapter.create_or_patch_configmap)
+register_tool("human.review", {"description":"Manual approval step","roles":["sme","ml-lead"]}, None)
+register_tool("policy.update_serving_policy", {"description":"Update serving policy","roles":["ml-lead","sre"]}, None)
+
+def list_tools():
+    return {k:v["meta"] for k,v in _REGISTRY.items()}
