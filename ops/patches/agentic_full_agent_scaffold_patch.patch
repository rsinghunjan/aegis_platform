+#!/usr/bin/env python3
+"""
+Executor for LLM plans.
+- For each step: perform policy_enforcer check, pre_check via verifier, take snapshot/backup, execute via registered tool adapter, then post_check and record audit.
+- On error, perform rollback of executed steps in reverse order using stored backups.
+"""
+import os, time, json
+from typing import List, Dict, Any
+from services.agent.tool_registry import get_tool
+from services.agent.policy_enforcer import check_step
+from services.agent.prepost_verifier import pre_check, post_check
+from services.agent.audit_logger import audit_log_action
+from services.agent.tool_adapters import k8s_adapter
+
+def take_backup_for_step(step: Dict[str,Any]) -> Dict[str,Any]:
+    """
+    Create simple backup info depending on tool/action. For k8s.set_image, record current image.
+    Returns a backup dict to be used during rollback.
+    """
+    try:
+        if step["tool"] == "k8s" and step["action"] == "set_image":
+            ns = step["params"]["namespace"]; dep = step["params"]["deployment"]
+            cur = k8s_adapter.run_cmd(["kubectl","-n",ns,"get","deployment",dep,"-o","json"])
+            return {"type":"deployment_snapshot","deployment":dep,"namespace":ns,"deployment_json": cur}
+        if step["tool"] == "k8s" and step["action"] == "scale_deployment":
+            ns = step["params"]["namespace"]; dep = step["params"]["deployment"]
+            cur = k8s_adapter.run_cmd(["kubectl","-n",ns,"get","deployment",dep,"-o","jsonpath={.spec.replicas}"])
+            return {"type":"scale_snapshot","deployment":dep,"namespace":ns,"replicas": int(cur)}
+    except Exception as e:
+        return {"error":"backup_failed","reason": str(e)}
+    return {}
+
+def rollback_backups(backups: List[Dict[str,Any]]):
+    # reverse order
+    for b in reversed(backups):
+        try:
+            if b.get("type") == "deployment_snapshot":
+                # restore image by re-applying previous deployment JSON
+                tmpfile = f"/tmp/deploy_restore_{int(time.time())}.json"
+                with open(tmpfile,"w") as f:
+                    f.write(b["deployment_json"])
+                k8s_adapter.run_cmd(["kubectl","apply","-f", tmpfile])
+            elif b.get("type") == "scale_snapshot":
+                k8s_adapter.scale_deployment(b["namespace"], b["deployment"], b["replicas"])
+        except Exception as e:
+            print("Rollback step failed:", e)
+
+def execute_plan(name: str, plan: List[Dict[str,Any]], requester: str):
+    backups=[]
+    results=[]
+    for i,step in enumerate(plan):
+        # policy check
+        ok, reason = check_step(step)
+        if not ok:
+            audit_log_action(name, requester, step, {"state":"rejected_policy","reason":reason})
+            return {"state":"rejected","reason":reason}
+        # pre-check via verifier
+        allowed, vinfo = pre_check(step)
+        if not allowed:
+            audit_log_action(name, requester, step, {"state":"rejected_verifier","verifier":vinfo})
+            return {"state":"rejected","reason":"verifier_rejected","details": vinfo}
+        # take backup
+        b = take_backup_for_step(step)
+        backups.append(b)
+        # execute via tool registry
+        tool_name = f"{step['tool']}.{step['action']}" if '.' not in step['tool'] else step['tool']
+        tool_meta = get_tool(tool_name) or get_tool(f"{step['tool']}.{step['action']}")
+        try:
+            if tool_meta is None or tool_meta.get("func") is None:
+                # handle special tools (human, policy) or unregistered
+                if step["tool"] == "human":
+                    audit_log_action(name, requester, step, {"state":"pending_human"})
+                    return {"state":"pending_human","step_index": i}
+                elif step["tool"] == "policy" and step["action"] == "update_serving_policy":
+                    # simulate policy update by storing configmap
+                    cfg = {"student_pct": str(step["params"].get("student_pct_increase",0))}
+                    res = k8s_adapter.create_or_patch_configmap(step["params"]["namespace"], "policy-temp-"+name, cfg)
+                    results.append({"step":i,"result":res})
+                else:
+                    raise RuntimeError("tool not available")
+            else:
+                func = tool_meta["func"]
+                # map common param names into call
+                if func == k8s_adapter.set_image:
+                    res = func(step["params"]["deployment"], step["params"]["image"]) if False else func(step["params"]["namespace"], step["params"]["deployment"], step["params"]["image"])
+                elif func == k8s_adapter.scale_deployment:
+                    res = func(step["params"]["namespace"], step["params"]["deployment"], step["params"]["replicas"])
+                else:
+                    # generic call
+                    res = func(**step.get("params",{}))
+                results.append({"step":i,"result":res})
+            # post check
+            post = post_check(step, {"result":"ok"})
+            audit_log_action(name, requester, step, {"state":"executed","post": post})
+        except Exception as e:
+            audit_log_action(name, requester, step, {"state":"failed","error": str(e)})
+            # rollback executed steps
+            rollback_backups(backups)
+            return {"state":"failed","error": str(e)}
+    return {"state":"succeeded","results": results}
+
+if __name__=="__main__":
+    import sys, json
+    name="agent_local_"+str(int(time.time()))
+    plan=json.loads(sys.argv[1])
+    print(execute_plan(name, plan.get("plan",[]), "local"))
+
