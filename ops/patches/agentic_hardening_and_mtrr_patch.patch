+#!/usr/bin/env python3
+"""
+Verified tool wrappers add safety checks, RBAC enforcement, dry-run and idempotency helpers.
+Wraps underlying k8s tool adapters and emits consistent structured results.
+"""
+from typing import Dict, Any
+import time
+from services.agent.rbac_manager import is_allowed
+from services.agent.tool_adapters import k8s_adapter
+
+def wrapper_set_image(user: str, namespace: str, deployment: str, image: str, dry_run: bool=False) -> Dict[str,Any]:
+    if not is_allowed(user, "k8s.set_image"):
+        raise PermissionError("user not allowed to call k8s.set_image")
+    # idempotency: check current image
+    try:
+        cur = k8s_adapter.run_cmd(["kubectl","-n",namespace,"get","deployment",deployment,"-o","jsonpath={.spec.template.spec.containers[0].image}"]).strip()
+    except Exception as e:
+        cur = None
+    if cur == image:
+        return {"status":"noop","reason":"image_already_set","image":image}
+    if dry_run:
+        return {"status":"dry_run_ok","would_set":image,"current":cur}
+    start = time.time()
+    res = k8s_adapter.set_image(namespace, deployment, image)
+    return {"status":"ok","result":res,"latency_s": time.time()-start}
+
+def wrapper_scale_deployment(user: str, namespace: str, deployment: str, replicas: int, dry_run: bool=False) -> Dict[str,Any]:
+    if not is_allowed(user, "k8s.scale_deployment"):
+        raise PermissionError("user not allowed to call k8s.scale_deployment")
+    # idempotency check
+    try:
+        cur = int(k8s_adapter.run_cmd(["kubectl","-n",namespace,"get","deployment",deployment,"-o","jsonpath={.spec.replicas}"]).strip())
+    except Exception:
+        cur = None
+    if cur == replicas:
+        return {"status":"noop","reason":"replicas_already_set","replicas":replicas}
+    if dry_run:
+        return {"status":"dry_run_ok","would_scale_to":replicas,"current":cur}
+    res = k8s_adapter.scale_deployment(namespace, deployment, replicas)
+    return {"status":"ok","result":res}
+
+def wrapper_create_configmap(user: str, namespace: str, name: str, data: Dict[str,str], dry_run: bool=False) -> Dict[str,Any]:
+    if not is_allowed(user, "k8s.create_configmap"):
+        raise PermissionError("user not allowed to call k8s.create_configmap")
+    if dry_run:
+        return {"status":"dry_run_ok","would_create":name}
+    res = k8s_adapter.create_or_patch_configmap(namespace, name, data)
+    return {"status":"ok","result":res}
+
