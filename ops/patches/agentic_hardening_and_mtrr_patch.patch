+#!/usr/bin/env python3
+"""
+Simple RBAC manager for agent tool calls.
+ - Maintains an in-memory mapping of roles -> allowed tools.
+ - Lookup function is_allowed(user, tool_name) uses an external user->roles mapping (env or HTTP) in a real deployment.
+ - For the scaffold: supports local USER_ROLE_MAP env variable JSON or default map.
+"""
+import os, json
+from typing import List
+
+# Example default role map: roles to allowed tools
+DEFAULT_ROLE_MAP = {
+    "sre": ["k8s.set_image", "k8s.scale_deployment", "k8s.create_configmap"],
+    "ml-lead": ["policy.update_serving_policy","k8s.set_image"],
+    "rater": [],
+    "admin": ["*"]
+}
+
+USER_ROLE_MAP = {}
+try:
+    USER_ROLE_MAP = json.loads(os.environ.get("USER_ROLE_MAP","{}"))
+except Exception:
+    USER_ROLE_MAP = {}
+
+ROLE_MAP = json.loads(os.environ.get("ROLE_TOOL_MAP", json.dumps(DEFAULT_ROLE_MAP)))
+
+def user_roles(user: str) -> List[str]:
+    # scaffold: user_role_map holds mapping user->roles; fallback to 'sre' for 'ci'
+    if user in USER_ROLE_MAP:
+        return USER_ROLE_MAP[user]
+    if user == "ci":
+        return ["sre"]
+    return ["ml-lead"] if user.startswith("ml-") else ["rater"]
+
+def is_allowed(user: str, tool_name: str) -> bool:
+    roles = user_roles(user)
+    for r in roles:
+        allowed = ROLE_MAP.get(r, [])
+        if "*" in allowed:
+            return True
+        if tool_name in allowed:
+            return True
+    return False
+
