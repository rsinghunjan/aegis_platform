+#!/usr/bin/env python3
+"""
+Richer business simulator for offline agent evaluation.
+ - Takes a structured plan and a trace (user traffic / metrics) and simulates:
+   cost_delta (USD), availability_risk (0-1), user_impact (0-1), expected_regret
+ - Uses simple heuristics and Monte-Carlo sampling; pluggable with ML-based estimators later.
+"""
+import json, argparse, random, statistics
+
+def simulate_step(step, traces):
+    # heuristics tuned for common ops:
+    reward = 0.0
+    cost = 0.0
+    risk = 0.0
+    if step.get("tool") == "k8s" and step.get("action") == "scale_deployment":
+        replicas = step.get("params",{}).get("replicas",1)
+        # cost scales with replicas; reward small improvement in throughput
+        cost = replicas * 0.05  # $0.05 per replica per time unit (example)
+        reward = min(0.5, replicas * 0.02)
+        risk = min(0.4, replicas * 0.01)
+    if step.get("tool") == "k8s" and step.get("action") == "set_image":
+        risk = 0.1
+        reward = 0.2
+    if step.get("tool") == "policy" and step.get("action") == "update_serving_policy":
+        inc = step.get("params",{}).get("student_pct_increase",0)
+        reward = min(1.0, inc/100.0 * 0.8)
+        risk = min(1.0, inc/100.0)
+        cost = 0.0
+    # simulate divergence using trace info (if trace contains baseline metrics)
+    divergence = random.gauss(0.05, 0.02)
+    return {"cost": cost, "reward": reward, "risk": risk, "divergence": max(0.0, divergence)}
+
+def simulate_plan(plan, trace_file=None, runs=50):
+    traces = []
+    if trace_file:
+        try:
+            traces = json.load(open(trace_file))
+        except Exception:
+            traces = []
+    runs_res = []
+    for _ in range(runs):
+        total_cost=0.0; total_reward=0.0; max_risk=0.0; divergences=[]
+        for s in plan:
+            r = simulate_step(s, traces)
+            total_cost += r["cost"]
+            total_reward += r["reward"]
+            max_risk = max(max_risk, r["risk"])
+            divergences.append(r["divergence"])
+        runs_res.append({"cost": total_cost, "reward": total_reward, "max_risk": max_risk, "avg_div": statistics.mean(divergences)})
+    summary = {"cost_mean": statistics.mean([r["cost"] for r in runs_res]), "reward_mean": statistics.mean([r["reward"] for r in runs_res]), "max_risk_p95": sorted([r["max_risk"] for r in runs_res])[int(0.95*len(runs_res))]}
+    return {"samples": runs_res[:5], "summary": summary}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--plan", required=True)
+    p.add_argument("--trace", required=False)
+    args = p.parse_args()
+    plan = json.load(open(args.plan))
+    out = simulate_plan(plan.get("plan",[]), args.trace, runs=100)
+    print(json.dumps(out, indent=2))
+
+if __name__=="__main__":
+    main()
+
