+#!/usr/bin/env python3
+"""
+Enhanced LLM planner with prompt engineering, schema validation, hallucination controls.
+ - Calls an LLM provider (OpenAI or local adapter) with a strict prompt template that instructs the model
+   to output validated JSON.
+ - Validates the returned JSON against the allowed tool set from tool_registry.
+ - If unknown tools or malformed output is detected, marks plan as requiring human review.
+ - Provides limited retry with adjusted prompts to reduce hallucination.
+"""
+import os
+import json
+import time
+import requests
+from typing import Dict, Any
+from services.agent.tool_registry import list_tools
+
+LLM_PROVIDER = os.environ.get("LLM_PROVIDER", "local")
+OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY", "")
+MAX_RETRIES = int(os.environ.get("LLM_PLANNER_RETRIES", "2"))
+
+PROMPT_TEMPLATE = """
+You are a constrained, safety-first planner for the Aegis platform.
+Input intent: {intent}
+
+Rules:
+ - Only use tools from the allowed list: {allowed_tools}
+ - Each plan must be JSON with keys: risk_level (low|medium|high), plan (array of steps)
+ - Each step must be an object with keys: tool (string), action (string), params (object)
+ - Do NOT invent tools. If you cannot plan, respond with JSON: {{"risk_level":"high","plan":[{{"tool":"human","action":"review","params":{{"note":"cannot plan"}}}}]}}
+ - Keep plan length <= 6 steps. Each param must be concrete and include namespace when applicable.
+
+Return ONLY JSON, no commentary.
+"""
+
+def call_openai(prompt: str) -> str:
+    headers = {"Authorization": f"Bearer {OPENAI_API_KEY}"}
+    data = {"model": "gpt-4o-mini", "messages": [{"role":"user","content":prompt}], "max_tokens": 512}
+    resp = requests.post("https://api.openai.com/v1/chat/completions", headers=headers, json=data, timeout=30)
+    resp.raise_for_status()
+    return resp.json()["choices"][0]["message"]["content"]
+
+def call_local_stub(prompt: str) -> str:
+    # Very small deterministic stub: fallback to human review plan
+    allowed = list_tools().keys()
+    return json.dumps({"risk_level": "high", "plan": [{"tool": "human", "action": "review", "params": {"note": "LLM provider not configured; manual plan required"}}]})
+
+def parse_and_validate(raw: str, allowed_tools) -> Dict[str,Any]:
+    try:
+        j = json.loads(raw)
+    except Exception:
+        return {"valid": False, "reason": "json_parse_error", "raw": raw}
+    if not isinstance(j, dict) or "plan" not in j or "risk_level" not in j:
+        return {"valid": False, "reason": "missing_keys", "parsed": j}
+    plan = j.get("plan", [])
+    for step in plan:
+        tool_name = step.get("tool")
+        if tool_name not in allowed_tools:
+            return {"valid": False, "reason": "unknown_tool", "tool": tool_name, "parsed": j}
+        if not isinstance(step.get("params", {}), dict):
+            return {"valid": False, "reason": "invalid_params", "step": step}
+    return {"valid": True, "plan": j}
+
+def plan_for_intent(intent: str, context: Dict[str,Any] = None) -> Dict[str,Any]:
+    allowed = list(list_tools().keys())
+    prompt = PROMPT_TEMPLATE.format(intent=intent, allowed_tools=", ".join(allowed))
+    attempt = 0
+    last_error = None
+    while attempt <= MAX_RETRIES:
+        attempt += 1
+        try:
+            if LLM_PROVIDER == "openai" and OPENAI_API_KEY:
+                raw = call_openai(prompt)
+            else:
+                raw = call_local_stub(prompt)
+            v = parse_and_validate(raw, set(allowed))
+            if v.get("valid"):
+                return v["plan"]
+            else:
+                last_error = v
+                # adjust prompt to instruct LLM to be stricter (limited retries)
+                prompt += "\nBe stricter: do not invent tools. If invalid, return human review plan."
+                time.sleep(1)
+                continue
+        except Exception as e:
+            last_error = {"valid": False, "reason": "llm_call_failed", "error": str(e)}
+            time.sleep(1)
+            continue
+    # fallback: require human review
+    return {"risk_level":"high","plan":[{"tool":"human","action":"review","params":{"note":"planner failed or produced invalid plan","error": last_error}}]}
+
+if __name__=="__main__":
+    import sys
+    intent = " ".join(sys.argv[1:]) if len(sys.argv)>1 else "scale verifier to 2"
+    print(json.dumps(plan_for_intent(intent), indent=2))
+
