+#!/usr/bin/env python3
+"""
+Validate LLM planner output against JSON schema and allowed tool list.
+ - Returns (valid, reason or normalized_plan)
+"""
+import json, os
+from jsonschema import validate, ValidationError
+from services.agent.plan_schema import json as plan_schema_module
+from services.agent.tool_registry import list_tools
+
+SCHEMA = plan_schema_module
+
+def validate_plan(plan_obj):
+    try:
+        validate(instance=plan_obj, schema=SCHEMA)
+    except ValidationError as e:
+        return False, f"schema_validation_failed: {e.message}"
+    # ensure tools are allowed
+    allowed = set(list_tools().keys())
+    for step in plan_obj["plan"]:
+        t = step["tool"]
+        # allow namespaced tool names like k8s.set_image or tool specified separately
+        if '.' in t:
+            name = t
+        else:
+            name = f"{t}.{step.get('action')}"
+        if name not in allowed:
+            return False, f"unknown_tool: {name}"
+    return True, plan_obj
+
+if __name__=="__main__":
+    import sys
+    p = json.load(open(sys.argv[1]))
+    ok, info = validate_plan(p)
+    print(ok, info)
+
