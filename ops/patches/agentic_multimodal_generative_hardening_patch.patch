+#!/usr/bin/env bash
+#
+# Small utility to sync OIDC group->role mappings into USER_ROLE_MAP env variable (scaffold).
+# In production, this would call your IdP API and sync to a central RBAC service.
+#
+if [ $# -lt 2 ]; then
+  echo "Usage: $0 <idp-group> <role> [<idp-group> <role> ...]"
+  exit 2
+fi
+declare -A MAP
+while [ $# -gt 0 ]; do
+  G=$1; R=$2; shift 2
+  MAP["$G"]="$R"
+done
+echo "Mapped groups:"
+for g in "${!MAP[@]}"; do
+  echo "$g -> ${MAP[$g]}"
+done
+echo "To apply, set USER_ROLE_MAP env var in agent deployment (JSON mapping of user->roles)."
