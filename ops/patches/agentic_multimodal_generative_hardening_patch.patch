+#!/usr/bin/env bash
+#
+# Run an MTTR drill:
+# 1) Create a test AgentAction that will intentionally fail (e.g., set image to non-existent)
+# 2) Wait for controller to mark failed and circuit breaker to record
+# 3) Run operator rollback steps (simulated)
+#
+set -euo pipefail
+NS=${NS:-default}
+NAME="mttr-drill-$(date +%s)"
+cat > /tmp/${NAME}.yaml <<EOF
+apiVersion: aegis.example.com/v1
+kind: AgentAction
+metadata:
+  name: ${NAME}
+spec:
+  requester: "drill"
+  intent: "set image impossible"
+  plan:
+    - tool: "k8s"
+      action: "set_image"
+      params:
+        namespace: "${NS}"
+        deployment: "nonexistent-deploy"
+        image: "nonexistent/image:latest"
+  timeout_seconds: 300
+EOF
+
+kubectl apply -f /tmp/${NAME}.yaml
+echo "Created AgentAction ${NAME}. Polling status..."
+for i in $(seq 1 30); do
+  sleep 10
+  ST=$(kubectl -n ${NS} get agentaction ${NAME} -o jsonpath='{.status.state}' 2>/dev/null || echo "")
+  echo "state=$ST"
+  if [[ "$ST" == "failed" || "$ST" == "rejected" ]]; then
+    echo "Drill failed as expected; perform manual remediation steps per runbook"
+    exit 0
+  fi
+done
+echo "Timeout waiting for drill to fail"
+exit 2
+
