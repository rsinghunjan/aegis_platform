+#!/usr/bin/env python3
+"""
+Fallback automation helper for generation endpoints.
+ - When policy/verifier suppression occurs, this helper runs a remediation strategy:
+   1) Try alternate model (fallback_model list)
+   2) Apply conservative decoding settings (temperature=0, max_tokens reduced)
+   3) Emit audit + PagerDuty/alert if remediation fails
+ - Designed to be invoked by middleware (provenance_middleware) when fallback applied.
+"""
+import os, time, requests
+from services.agent.audit_logger import audit_log_action
+
+FALLBACK_MODELS = os.environ.get("GEN_FALLBACK_MODELS", "model:safe-1,model:safe-2").split(",")
+ALERT_WEBHOOK = os.environ.get("OP_ALERT_WEBHOOK", "")
+
+def attempt_remediation(ctx, original_request):
+    """
+    ctx includes user_id, request_id, provenance, etc.
+    original_request is the JSON used for generation.
+    Returns a dict with keys: success(bool), response(dict) or error
+    """
+    for m in FALLBACK_MODELS:
+        try:
+            req = dict(original_request)
+            req["model_id"] = m
+            # conservative decoding
+            req["temperature"] = 0.0
+            req["max_tokens"] = int(max(16, original_request.get("max_tokens", 64)//2))
+            # call model endpoint (assume PROD_URL env)
+            url = os.environ.get("PROD_URL")
+            resp = requests.post(url, json=req, timeout=10)
+            if resp.status_code == 200:
+                rj = resp.json()
+                # optionally run quick policy check
+                # if acceptable, audit and return
+                audit_log_action("fallback_remediation", ctx.get("user_id","unknown"), {"model": m}, {"note":"remediation succeeded"})
+                return {"success":True, "response": rj}
+        except Exception as e:
+            # try next model
+            continue
+    # all remediation attempts failed
+    audit_log_action("fallback_failed", ctx.get("user_id","unknown"), {"request_id": ctx.get("request_id")}, {"note":"remediation failed"})
+    if ALERT_WEBHOOK:
+        try:
+            requests.post(ALERT_WEBHOOK, json={"title":"Generative fallback remediation failed","ctx":ctx}, timeout=5)
+        except Exception:
+            pass
+    return {"success":False, "error":"all_remediation_failed"}
+
+if __name__=="__main__":
+    import json, sys
+    ctx = {"user_id":"local","request_id":"test"}
+    req = {"prompt":"hello world","max_tokens":64}
+    print(attempt_remediation(ctx, req))
+
