+#!/usr/bin/env python3
+"""
+Simple Triton Model Control helper.
+ - Calls Triton Model Control API to load/unload/reload models.
+ - Usage:
+    python scripts/triton_model_control.py --server host:8000 --reload
+"""
+import argparse, requests, json
+
+def reload_models(server):
+    url = f"http://{server}/v2/repository/index"
+    r = requests.get(url, timeout=10)
+    r.raise_for_status()
+    models = r.json()
+    print("Models in repo:", models)
+    # trigger model control reload
+    url_reload = f"http://{server}/v2/repository/models?action=reload"
+    try:
+        rr = requests.post(url_reload, timeout=30)
+        print("Reload status", rr.status_code, rr.text)
+    except Exception as e:
+        print("reload failed", e)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--server", required=True)
+    p.add_argument("--reload", action="store_true")
+    args = p.parse_args()
+    if args.reload:
+        reload_models(args.server)
+
+if __name__=="__main__":
+    main()
+
