+#!/usr/bin/env python3
+"""
+Resumable upload client for testing the resumable ingestion service.
+ - Splits file into chunks, uploads with simulated failures, finalizes and validates server response.
+"""
+import argparse, os, requests, time, random
+
+def chunked_upload(url_base, filepath, dataset_id, modality, chunk_size=1024*1024, fail_rate=0.1):
+    fname = os.path.basename(filepath)
+    # init
+    init = requests.post(f"{url_base}/resumable/init", json={"filename": fname, "modality": modality, "dataset_id": dataset_id})
+    init.raise_for_status()
+    upload_id = init.json()["upload_id"]
+    with open(filepath, "rb") as f:
+        offset = 0
+        while True:
+            data = f.read(chunk_size)
+            if not data:
+                break
+            # simulate intermittent failure
+            if random.random() < fail_rate:
+                print("Simulating network fail at offset", offset)
+                time.sleep(1)
+            files = {'chunk': ('chunk', data)}
+            r = requests.put(f"{url_base}/resumable/{upload_id}/chunk?offset={offset}", files=files)
+            r.raise_for_status()
+            offset += len(data)
+    fin = requests.post(f"{url_base}/resumable/{upload_id}/finalize")
+    fin.raise_for_status()
+    return fin.json()
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--url", default="http://localhost:8080")
+    p.add_argument("--file", required=True)
+    p.add_argument("--dataset", default="test")
+    p.add_argument("--modality", default="image")
+    args = p.parse_args()
+    print("Uploading", args.file)
+    res = chunked_upload(args.url, args.file, args.dataset, args.modality)
+    print("Upload result:", res)
+
