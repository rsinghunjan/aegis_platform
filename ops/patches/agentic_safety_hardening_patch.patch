+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Promotion idempotency + chaos tester:
+# - Creates a ModelPromotion CR to trigger promotion controller
+# - Simulates API server flakiness by deleting the promotion CR mid-flight (emulating transient failures)
+# - Reapplies CR and checks controller handles idempotency and rollback appropriately.
