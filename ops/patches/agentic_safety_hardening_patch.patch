+#!/usr/bin/env python3
+"""
+Sensitive tool definitions
+ - Central mapping of tool -> sensitivity metadata
+ - Used by wrappers and orchestration to require manual approval or extra checks for sensitive actions.
+"""
+SENSITIVE_TOOLS = {
+    # tool name -> reason and min_role required to bypass manual approval
+    "k8s.set_image": {"reason":"image change affects runtime code", "min_role":"admin"},
+    "k8s.scale_deployment": {"reason":"scaling affects capacity/cost", "min_role":"sre"},
+    "policy.update_serving_policy": {"reason":"affects routing of traffic to models", "min_role":"ml-lead"},
+    "k8s.delete_deployment": {"reason":"destructive operation", "min_role":"admin"}
+}
+
+def is_sensitive(tool_name: str) -> bool:
+    return tool_name in SENSITIVE_TOOLS
+
+def get_sensitivity(tool_name: str) -> dict:
+    return SENSITIVE_TOOLS.get(tool_name, {})
+
