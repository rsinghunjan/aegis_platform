+#!/usr/bin/env python3
+"""
+Plan verifier / multi-step safety checks
+- Validates LLM planner output against schema, checks for unsafe patterns,
+  runs a lightweight simulation to estimate risk/reward, and returns a structured verdict.
+ - Designed to be invoked before any execution (automatic or human-approved).
+"""
+import os, json, re
+from typing import Dict, Any
+from services.agent.llm_plan_validator import validate_plan
+from services.agent.simulator.business_simulator_v2 import simulate_plan
+
+# Tunable constraints (env)
+MAX_ALLOWED_STUDENT_INC = int(os.environ.get("MAX_STUDENT_PCT_INC", "10"))
+MAX_ALLOWED_REPLICAS = int(os.environ.get("MAX_REPLICAS_ALLOWED", "50"))
+SIM_RISK_THRESHOLD = float(os.environ.get("SIM_RISK_THRESHOLD", "0.5"))
+
+def detect_unsafe_patterns(plan_obj: Dict[str,Any]) -> (bool, str):
+    # Example checks: extreme student pct changes, scaling to huge replica counts, unknown "destroy" actions
+    for step in plan_obj.get("plan", []):
+        tool = step.get("tool","")
+        action = step.get("action","")
+        params = step.get("params",{})
+        # policy change checks
+        if tool.startswith("policy") and action == "update_serving_policy":
+            inc = params.get("student_pct_increase", 0)
+            if abs(int(inc)) > MAX_ALLOWED_STUDENT_INC:
+                return True, f"student_pct change {inc} exceeds per-day allowed {MAX_ALLOWED_STUDENT_INC}"
+        # scale check
+        if tool.startswith("k8s") and action == "scale_deployment":
+            rep = int(params.get("replicas", 0))
+            if rep > MAX_ALLOWED_REPLICAS:
+                return True, f"replica target {rep} exceeds allowed {MAX_ALLOWED_REPLICAS}"
+        # destructive ops pattern
+        if re.search(r"delete|remove|destroy", action, re.I):
+            return True, f"destructive action '{action}' not allowed via agent"
+    return False, ""
+
+def plan_verdict(plan_obj: Dict[str,Any]) -> Dict[str,Any]:
+    # 1) schema validation
+    ok, info = validate_plan(plan_obj)
+    if not ok:
+        return {"allow": False, "reason": f"schema_validation_failed: {info}"}
+    # 2) unsafe pattern detection
+    unsafe, reason = detect_unsafe_patterns(plan_obj)
+    if unsafe:
+        return {"allow": False, "reason": f"unsafe_pattern: {reason}"}
+    # 3) simulate plan for business metrics
+    sim = simulate_plan(plan_obj.get("plan", []), trace_file=None, runs=50)
+    # if simulated max risk is too high, deny automatic allow
+    max_risk = sim.get("summary",{}).get("max_risk_p95", 0)
+    if max_risk > SIM_RISK_THRESHOLD:
+        return {"allow": False, "reason": f"simulated_risk_high: {max_risk}", "sim": sim}
+    # 4) pass
+    return {"allow": True, "reason": "ok", "sim": sim}
+
+if __name__=="__main__":
+    import sys
+    plan = json.load(open(sys.argv[1]))
+    print(json.dumps(plan_verdict(plan), indent=2))
+
