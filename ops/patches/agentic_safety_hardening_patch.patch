+cat > ${CR_FILE} <<EOF
+apiVersion: aegis.example.com/v1
+kind: ModelPromotion
+metadata:
+  name: promo-chaos-$(date +%s)
+spec:
+  artifact:
+    path: gs://aegis-model-registry/verifier/test/candidate.tar.gz
+    image: us.gcr.io/aegis/verifier:chaos-test
+EOF
+
+kubectl apply -f ${CR_FILE}
+echo "Promotion CR applied"
+sleep 10
+echo "Simulate transient failure: delete CR"
+kubectl delete -f ${CR_FILE} || true
+sleep 5
+echo "Reapply CR to test idempotency"
+kubectl apply -f ${CR_FILE}
+echo "Wait and inspect ModelPromotion status"
+for i in $(seq 1 30); do
+  sleep 10
+  kubectl get modelpromotion -o wide || true
+done
+echo "Idempotency chaos test complete. Check promotion controller logs for duplicate handling and rollback."
