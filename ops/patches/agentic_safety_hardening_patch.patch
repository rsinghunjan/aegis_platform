+#!/usr/bin/env python3
+"""
+Backup store for pre-execution snapshots.
+ - Stores JSON blobs (deployment manifests, config snapshots) into evidence bucket with SSE-KMS and retention metadata.
+ - Returns a storage URI that can be referenced in AgentAction.status for rollback.
+"""
+import os, time, json, boto3
+from datetime import datetime, timedelta
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET")
+KMS_KEY = os.environ.get("COSIGN_KMS_ARN")
+REGION = os.environ.get("AWS_REGION", "us-west-2")
+
+def s3_client():
+    return boto3.client("s3", region_name=REGION)
+
+def store_backup(name: str, payload: dict) -> str:
+    if not EVIDENCE_BUCKET:
+        # fallback to local file
+        path = f"/tmp/{name}_{int(time.time())}.json"
+        with open(path,"w") as f:
+            json.dump(payload, f)
+        return f"file://{path}"
+    key = f"agent_backups/{name}/{int(time.time())}.json"
+    body = json.dumps(payload).encode("utf-8")
+    extra = {}
+    if KMS_KEY:
+        extra["ServerSideEncryption"]="aws:kms"
+        extra["SSEKMSKeyId"]=KMS_KEY
+    s3 = s3_client()
+    s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=body, **extra)
+    # attempt to set retention (best effort)
+    try:
+        until = (datetime.utcnow() + timedelta(days=3650)).isoformat() + "Z"
+        s3.put_object_retention(Bucket=EVIDENCE_BUCKET, Key=key, Retention={'Mode':'GOVERNANCE','RetainUntilDate': until})
+    except Exception:
+        pass
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
