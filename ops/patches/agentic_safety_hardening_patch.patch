+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple chaos canary test:
+# 1) Deploy candidate image to verifier-canary
+# 2) Run canary eval
+# 3) Randomly kill a pod in the production (or canary) verifier to test rollback and idempotency
+# 4) Assert canary eval still runs and promotion controller either rolls back or leaves stable
+#
+NAMESPACE=${NAMESPACE:-safety}
+CANDIDATE_IMAGE=${CANDIDATE_IMAGE:-"us.gcr.io/aegis/verifier:canary"}
+CANARY_SVC=${CANARY_SVC:-verifier-canary}
+PROD_DEPLOY=${PROD_DEPLOY:-verifier}
+
+echo "Deploying canary image to canary deployment"
+kubectl -n ${NAMESPACE} set image deployment/${CANARY_SVC} ${CANARY_SVC}=${CANDIDATE_IMAGE} --record || true
+kubectl -n ${NAMESPACE} rollout status deployment/${CANARY_SVC} --timeout=120s || true
+
+echo "Running canary eval"
+python tests/generative/canary_eval.py --prompts ops/generative/sample_prompts.txt --prod_url http://verifier.safety.svc:8080/generate --cand_url http://${CANARY_SVC}.${NAMESPACE}.svc:8080/generate --out /tmp/canary_result.json || true
+cat /tmp/canary_result.json
+
+echo "Injecting chaos: killing one prod verifier pod"
+POD=$(kubectl -n ${NAMESPACE} get pods -l app=${PROD_DEPLOY} -o jsonpath='{.items[0].metadata.name}')
+if [ -n "$POD" ]; then
+  kubectl -n ${NAMESPACE} delete pod $POD || true
+fi
+
+echo "Wait 30s then re-run canary eval"
+sleep 30
+python tests/generative/canary_eval.py --prompts ops/generative/sample_prompts.txt --prod_url http://verifier.safety.svc:8080/generate --cand_url http://${CANARY_SVC}.${NAMESPACE}.svc:8080/generate --out /tmp/canary_result_after_chaos.json || true
+cat /tmp/canary_result_after_chaos.json
+
+echo "Chaos canary test complete. Inspect promotion controller logs and AgentAction records for rollback behavior."
+
