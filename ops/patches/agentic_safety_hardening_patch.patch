+#!/usr/bin/env python3
+"""
+Helper to request human approval from a manual-approval service.
+ - POST /request -> returns request_id
+ - Poll /status or /list to find approved state
+ - Timeout configurable
+"""
+import os, time, requests
+
+MANUAL_APPROVAL_URL = os.environ.get("MANUAL_APPROVAL_URL", "http://manual-approval.svc")
+POLL_INTERVAL = int(os.environ.get("MANUAL_APPROVAL_POLL_S", "30"))
+TIMEOUT_S = int(os.environ.get("MANUAL_APPROVAL_TIMEOUT_S", str(60*60*24)))  # default 24h
+
+def request_approval(title: str, requestor: str, payload: dict) -> str:
+    body = {"title": title, "requester": requestor, "payload": payload}
+    r = requests.post(MANUAL_APPROVAL_URL.rstrip("/") + "/request", json=body, timeout=10)
+    r.raise_for_status()
+    return r.json().get("request_id")
+
+def wait_for_approval(request_id: str, timeout: int = TIMEOUT_S) -> dict:
+    start = time.time()
+    while time.time() - start < timeout:
+        r = requests.get(MANUAL_APPROVAL_URL.rstrip("/") + "/status/" + request_id, timeout=10)
+        if r.status_code == 200:
+            j = r.json()
+            state = j.get("state")
+            if state in ("approved","rejected"):
+                return j
+        time.sleep(POLL_INTERVAL)
+    # timeout
+    return {"request_id": request_id, "state": "timeout"}
+
+if __name__=="__main__":
+    # small CLI for tests
+    rid = request_approval("Test approval","ci", {"plan":"test"})
+    print("requested", rid)
+    print(wait_for_approval(rid, timeout=60))
+
