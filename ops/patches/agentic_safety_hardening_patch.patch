+#!/usr/bin/env python3
+"""
+Orchestration entrypoint to execute plans with safety checks:
+ - Validate with plan_verifier
+ - If allowed & low risk: proceed to safe_executor
+ - If medium/high risk: automatically create a manual approval request and wait
+ - For each step, take backups to backup_store before execution
+"""
+import os, json
+from services.agent.plan_verifier import plan_verdict
+from services.agent.human_approval_requester import request_approval, wait_for_approval
+from services.agent.backup_store import store_backup
+from services.agent.safe_executor import execute_safe_plan
+from services.agent.audit_logger import audit_log_action
+
+def execute_plan_safe(name: str, plan_obj: dict, requester: str, dry_run=False):
+    verdict = plan_verdict(plan_obj)
+    audit_log_action(name, requester, {"plan": plan_obj}, {"verdict": verdict})
+    if not verdict.get("allow", False):
+        # If not allowed automatically, require human approval
+        title = "Plan blocked by automatic verifier - request human review"
+        req = request_approval(title, requester, {"plan": plan_obj, "verdict": verdict})
+        res = wait_for_approval(req)
+        return {"state": "pending_human_auto_block", "approval": res, "verdict": verdict}
+    # If risk_level is medium or high, require human approval before executing
+    risk = plan_obj.get("risk_level", "low")
+    if risk in ("medium", "high"):
+        title = f"Manual approval for {risk} risk plan"
+        req = request_approval(title, requester, {"plan": plan_obj, "verdict": verdict})
+        approval = wait_for_approval(req)
+        if approval.get("state") != "approved":
+            audit_log_action(name, requester, {"plan": plan_obj}, {"state":"rejected_by_human","approval": approval})
+            return {"state":"rejected_human","approval": approval}
+    # pre-execution: for each step take backup (best-effort)
+    backups = []
+    for i, step in enumerate(plan_obj.get("plan", [])):
+        # attempt to capture relevant snapshot (for k8s deployments, record current manifest)
+        try:
+            tool = step.get("tool")
+            if tool.startswith("k8s"):
+                # ask kubectl to dump current deployment (scaffolded helper)
+                import subprocess, tempfile
+                ns = step.get("params",{}).get("namespace","default")
+                dep = step.get("params",{}).get("deployment")
+                if dep:
+                    out = subprocess.check_output(["kubectl","-n",ns,"get","deployment",dep,"-o","json"])
+                    uri = store_backup(f"{name}_step{i}_deployment_{ns}_{dep}", json.loads(out.decode("utf-8")))
+                    backups.append({"step": i, "backup_uri": uri})
+        except Exception as e:
+            # best-effort backup; continue
+            backups.append({"step": i, "backup_error": str(e)})
+    # record backups
+    audit_log_action(name, requester, {"plan": plan_obj}, {"backups": backups})
+    # execute via safe executor
+    result = execute_safe_plan(name, plan_obj.get("plan", []), requester, dry_run=dry_run)
+    # post-exec audit
+    audit_log_action(name, requester, {"plan": plan_obj}, {"execution_result": result})
+    return {"verdict": verdict, "backups": backups, "execution": result}
+
+if __name__=="__main__":
+    import sys
+    name = f"exec_{int(__import__('time').time())}"
+    plan = json.load(open(sys.argv[1]))
+    print(json.dumps(execute_plan_safe(name, plan, "ci", dry_run=True), indent=2))
+
