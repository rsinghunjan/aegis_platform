+#!/usr/bin/env python3
+"""
+Enforcer wrapper utilities for tool execution:
+ - Check RBAC (user->roles)
+ - If tool is sensitive, require manual approval (unless user has elevated role)
+ - Ensure idempotency by asking underlying adapter about current state where supported
+"""
+from services.agent.rbac_manager import is_allowed, user_roles
+from services.agent.sensitive_tools import is_sensitive, get_sensitivity
+from services.agent.human_approval_requester import request_approval, wait_for_approval
+from typing import Callable, Any, Dict
+
+def enforce_and_call(tool_full: str, caller: str, params: Dict[str,Any], call_fn: Callable, dry_run=False) -> Dict[str,Any]:
+    # RBAC check
+    if not is_allowed(caller, tool_full):
+        raise PermissionError(f"user {caller} not allowed to call {tool_full}")
+    # sensitivity
+    if is_sensitive(tool_full):
+        meta = get_sensitivity(tool_full)
+        min_role = meta.get("min_role")
+        roles = user_roles(caller)
+        if min_role not in roles and "*" not in roles:
+            # request manual approval
+            title = f"Manual approval required for {tool_full}"
+            req_id = request_approval(title, caller, {"tool": tool_full, "params": params})
+            approval = wait_for_approval(req_id)
+            if approval.get("state") != "approved":
+                return {"status":"rejected_manual","request_id": req_id, "approval": approval}
+    # idempotency and dry_run are handled by call_fn itself if supported
+    result = call_fn(caller=caller, **params) if callable(call_fn) else call_fn(**params)
+    return {"status":"ok","result":result}
+
