+#!/usr/bin/env python3
+"""
+Policy enforcer for agentic actions.
+Checks proposed steps against a safe_policy and denies or flags steps that violate constraints.
+"""
+import json, os
+from typing import Dict, Any
+
+SAFE_POLICY_PATH = os.environ.get("SAFE_POLICY_JSON", "services/rl/policy/safe_policy.json")
+
+def load_policy():
+    try:
+        with open(SAFE_POLICY_PATH) as f:
+            return json.load(f)
+    except Exception:
+        return {}
+
+def check_step(step: Dict[str, Any]) -> (bool, str):
+    """
+    Return (allowed, reason). Rule examples:
+      - Disallow student_pct increase > max_student_pct_change_per_day
+      - Disallow changes that exceed max_student_pct_total
+      - Require manual approval for high risk channels
+    """
+    policy = load_policy()
+    constraints = policy.get("constraints", {})
+    if step.get("tool") == "policy" and step.get("action") == "update_serving_policy":
+        params = step.get("params",{})
+        inc = params.get("student_pct_increase",0)
+        max_inc = constraints.get("max_student_pct_change_per_day", 10)
+        if inc > max_inc:
+            return False, f"student_pct increase {inc} exceeds max allowed per day {max_inc}"
+        total_max = constraints.get("max_student_pct_total", 60)
+        # In real system, fetch current value from config; scaffold assumes safe
+        if params.get("student_pct_increase",0) > total_max:
+            return False, f"would exceed total student pct limit {total_max}"
+    # default allow
+    return True, "ok"
+
