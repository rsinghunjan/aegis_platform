+REQ='{"requester":"ci","intent":"'"$INTENT"'","risk_level":"low"}'
+echo "Proposing intent..."
+curl -s -X POST -H "Content-Type: application/json" -d "$REQ" $ORCH/propose | jq .
+echo "Executing intent..."
+NAME=$(curl -s -X POST -H "Content-Type: application/json" -d "$REQ" $ORCH/execute | jq -r .name)
+echo "Created AgentAction: $NAME"
+echo "Polling status..."
+for i in $(seq 1 60); do
+  sleep 2
+  ST=$(curl -s $ORCH/status/$NAME | jq -r .state)
+  echo "state=$ST"
+  if [ "$ST" = "succeeded" ] || [ "$ST" = "failed" ] || [ "$ST" = "rejected" ]; then
+    curl -s $ORCH/status/$NAME | jq .
+    exit 0
+  fi
+done
+echo "Timeout waiting for action"
+exit 2
