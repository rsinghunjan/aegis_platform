+#!/usr/bin/env bash
+#
+# Sample flow:
+# 1) propose intent via orchestrator
+# 2) review plan, then execute -> creates AgentAction CR
+# 3) controller picks up CR and executes steps; poll status
+#
+ORCH=${ORCH_URL:-http://localhost:8080}
