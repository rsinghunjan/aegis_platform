+#!/usr/bin/env python3
+"""
+Kubernetes tool adapter for agent executor.
+Provides idempotent helpers to scale deployments, set images, and create configmaps.
+Used by AgentAction controller to execute steps.
+"""
+import subprocess, json
+from typing import Dict, Any
+
+def run_cmd(cmd):
+    p = subprocess.run(cmd, capture_output=True, text=True)
+    if p.returncode != 0:
+        raise RuntimeError(f"cmd failed: {' '.join(cmd)} stdout:{p.stdout} stderr:{p.stderr}")
+    return p.stdout
+
+def set_image(namespace: str, deployment: str, image: str):
+    run_cmd(["kubectl","-n",namespace,"set","image",f"deployment/{deployment}", f"{deployment}={image}", "--record"])
+    run_cmd(["kubectl","-n",namespace,"rollout","status",f"deployment/{deployment}","--timeout=120s"])
+    return {"applied_image": image}
+
+def scale_deployment(namespace: str, deployment: str, replicas: int):
+    run_cmd(["kubectl","-n",namespace,"scale","deployment",deployment,"--replicas", str(replicas)])
+    return {"scaled_to": replicas}
+
+def create_or_patch_configmap(namespace: str, name: str, data: Dict[str,str]):
+    # create as apply so it's idempotent
+    import yaml, sys, tempfile
+    cm = {"apiVersion":"v1","kind":"ConfigMap","metadata":{"name":name,"namespace":namespace},"data":data}
+    t = tempfile.NamedTemporaryFile(delete=False, mode="w")
+    yaml.safe_dump(cm, t); t.close()
+    run_cmd(["kubectl","apply","-f", t.name])
+    return {"configmap": name}
+
