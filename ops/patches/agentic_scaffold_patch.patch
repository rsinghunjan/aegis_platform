+#!/usr/bin/env python3
+"""
+Audit logger: store agent action audit trail into evidence bucket (S3/GCS).
+Writes JSON objects and attempts to set retention metadata (S3 Object Lock) when available.
+"""
+import os, json, time
+import boto3
+from datetime import datetime, timedelta
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET")
+KMS_KEY = os.environ.get("COSIGN_KMS_ARN")
+REGION = os.environ.get("AWS_REGION","us-west-2")
+
+def s3_put(key, body):
+    s3 = boto3.client("s3", region_name=REGION)
+    extra = {}
+    if KMS_KEY:
+        extra["ServerSideEncryption"] = "aws:kms"
+        extra["SSEKMSKeyId"] = KMS_KEY
+    s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(body).encode("utf-8"), **extra)
+    # try set retention
+    try:
+        until = (datetime.utcnow() + timedelta(days=3650)).isoformat() + "Z"
+        s3.put_object_retention(Bucket=EVIDENCE_BUCKET, Key=key, Retention={'Mode':'GOVERNANCE','RetainUntilDate': until})
+    except Exception:
+        pass
+
+def audit_log_action(action_id, requester, step, meta):
+    if not EVIDENCE_BUCKET:
+        print("No EVIDENCE_BUCKET configured; print audit record", action_id, requester, step, meta)
+        return
+    key = f"agent_audit/{action_id}/{int(time.time())}.json"
+    body = {"action_id": action_id, "requester":requester, "step": step, "meta": meta, "ts": time.time()}
+    try:
+        s3_put(key, body)
+    except Exception as e:
+        print("Failed to write audit to S3:", e)
+
