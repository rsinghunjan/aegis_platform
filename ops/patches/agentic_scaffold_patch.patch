+#!/usr/bin/env python3
+"""
+Planner: simple rule-based decomposition of high-level intent into tool steps.
+This is a scaffold. Replace with LLM-based planner or more advanced logic as needed.
+"""
+from typing import List, Dict, Any
+
+def plan_for_intent(intent: str, context: Dict[str, Any]) -> List[Dict[str, Any]]:
+    """
+    Return a list of steps, each step is a dict:
+      { "tool": "<tool_name>", "action": "<action>", "params": {...} }
+    Example intents supported (scaffold):
+      - "increase_student_pct_for_tenant:tenantA to 20"
+      - "scale verifier to 3"
+      - "apply policy change X"
+    """
+    steps=[]
+    # very small rule-based planner
+    if intent.startswith("scale verifier to"):
+        parts = intent.split()
+        target = int(parts[-1])
+        steps.append({"tool":"k8s","action":"scale_deployment","params":{"namespace":"safety","deployment":"verifier","replicas":target}})
+    elif intent.startswith("set image"):
+        # "set image <deployment> <image>"
+        _,_,dep,img = intent.split(None,3)
+        steps.append({"tool":"k8s","action":"set_image","params":{"namespace":"safety","deployment":dep,"image":img}})
+    elif intent.startswith("increase_student_pct"):
+        # example: increase_student_pct tenantA 10
+        _,tenant,pct = intent.split()
+        steps.append({"tool":"policy","action":"update_serving_policy","params":{"tenant":tenant,"student_pct_increase":int(pct)}})
+    else:
+        # fallback: no-op step packaged for human review
+        steps.append({"tool":"human","action":"review","params":{"note":"Planner could not decompose intent","intent": intent}})
+    return steps
+
