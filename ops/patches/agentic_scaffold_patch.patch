+#!/usr/bin/env python3
+"""
+Agent Orchestrator API
+- Accepts high level intent, runs planner to produce plan, creates AgentAction CR
+- Supports endpoints to propose, request execution, and poll status
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import os, time, json
+from kubernetes import client, config
+from services.agent.planner import plan_for_intent
+
+app = FastAPI(title="Aegis Agent Orchestrator")
+NAMESPACE = os.environ.get("NAMESPACE","default")
+
+class IntentRequest(BaseModel):
+    requester: str
+    intent: str
+    risk_level: str = "medium"
+    timeout_seconds: int = 3600
+
+def create_agentaction_cr(name, spec):
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    api = client.CustomObjectsApi()
+    body = {"apiVersion":"aegis.example.com/v1","kind":"AgentAction","metadata":{"name":name},"spec":spec}
+    api.create_namespaced_custom_object(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="agentactions", body=body)
+
+@app.post("/propose")
+def propose_intent(req: IntentRequest):
+    plan = plan_for_intent(req.intent, {})
+    # return plan to caller for review
+    return {"requester": req.requester, "intent": req.intent, "plan": plan, "risk_level": req.risk_level}
+
+@app.post("/execute")
+def execute_intent(req: IntentRequest):
+    plan = plan_for_intent(req.intent, {})
+    ts = int(time.time())
+    name = f"agentaction-{req.requester}-{ts}"
+    spec = {"requester": req.requester, "intent": req.intent, "plan": plan, "risk_level": req.risk_level, "timeout_seconds": req.timeout_seconds}
+    try:
+        create_agentaction_cr(name,spec)
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"failed to create CR: {e}")
+    return {"name": name, "status": "created", "namespace": NAMESPACE}
+
+@app.get("/status/{name}")
+def get_status(name: str):
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    api = client.CustomObjectsApi()
+    obj = api.get_namespaced_custom_object(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="agentactions", name=name)
+    return obj.get("status", {})
+
