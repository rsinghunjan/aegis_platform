+#!/usr/bin/env python3
+"""
+Sandbox simulator for agent dry-run
+- Replays a trace file of events and simulates tool actions' effects
+- Returns a simulated outcome and estimated risk/reward metrics
+"""
+import json, argparse, time, random
+
+def simulate_action_on_trace(action, traces):
+    # naive simulation: compute a safety risk score and estimated reward
+    # reward: random positive if action reduces cost (heuristic)
+    # risk: escalate if action modifies serving policy heavily
+    reward = random.uniform(-0.1, 1.0)
+    risk = 0.0
+    if action.get("tool") == "policy":
+        inc = action.get("params",{}).get("student_pct_increase",0)
+        risk += min(1.0, inc/100.0)
+    if action.get("tool") == "k8s" and action.get("action") == "set_image":
+        # small risk for image changes
+        risk += 0.1
+    # measure divergence on traces (fake)
+    divergence = random.uniform(0.0, 0.2)
+    return {"reward": reward, "risk": risk, "divergence": divergence}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--plan-file", required=True)
+    p.add_argument("--trace-file", required=True)
+    args = p.parse_args()
+    plan = json.load(open(args.plan_file))
+    traces = json.load(open(args.trace_file))
+    results=[]
+    for step in plan:
+        res = simulate_action_on_trace(step, traces)
+        results.append({"step": step, "sim": res})
+    out = {"sim_results": results, "summary": {"avg_reward": sum(r["sim"]["reward"] for r in results)/len(results)}} 
+    print(json.dumps(out, indent=2))
+
+if __name__=="__main__":
+    main()
+
