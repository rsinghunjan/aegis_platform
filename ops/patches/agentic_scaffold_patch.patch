+#!/usr/bin/env python3
+"""
+AgentAction controller
+- Watches AgentAction CRs and executes planned steps via tool adapters
+- Updates CR status with progress and results; supports rollback if a step fails
+- This is a simple controller for staging; in production use operator-sdk/controller-runtime
+"""
+import os, time, json
+from kubernetes import client, config, watch
+from services.agent.policy_enforcer import check_step
+from services.agent.tool_adapters import k8s_adapter
+from services.agent.audit_logger import audit_log_action
+
+NAMESPACE = os.environ.get("NAMESPACE", "default")
+
+def update_status(api, name, body):
+    try:
+        api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="agentactions", name=name, body=body)
+    except Exception as e:
+        print("Failed to patch status:", e)
+
+def execute_action(obj):
+    name = obj["metadata"]["name"]
+    spec = obj.get("spec",{})
+    plan = spec.get("plan", [])
+    timeout = spec.get("timeout_seconds", 3600)
+    requester = spec.get("requester","unknown")
+    api = client.CustomObjectsApi()
+    # initial status
+    status = {"status":{"state":"running","step_index":0,"results":[]}}
+    update_status(api,name,status)
+    for i,step in enumerate(plan):
+        # policy check
+        allowed, reason = check_step(step)
+        if not allowed:
+            update_status(api,name,{"status":{"state":"rejected","error": reason}})
+            audit_log_action(name, requester, step, {"state":"rejected","reason":reason})
+            return
+        try:
+            tool = step.get("tool")
+            action = step.get("action")
+            params = step.get("params",{})
+            res = {}
+            if tool == "k8s":
+                if action == "set_image":
+                    res = k8s_adapter.set_image(params["namespace"], params["deployment"], params["image"])
+                elif action == "scale_deployment":
+                    res = k8s_adapter.scale_deployment(params["namespace"], params["deployment"], params["replicas"])
+                elif action == "create_configmap":
+                    res = k8s_adapter.create_or_patch_configmap(params["namespace"], params["name"], params.get("data",{}))
+                else:
+                    raise RuntimeError(f"unknown k8s action {action}")
+            elif tool == "human":
+                # mark as pending; human must approve via manual-approval service (external)
+                update_status(api,name,{"status":{"state":"pending_human","step_index":i}})
+                audit_log_action(name, requester, step, {"state":"pending_human"})
+                return
+            else:
+                raise RuntimeError(f"unsupported tool {tool}")
+            # record result
+            results = api.get_namespaced_custom_object(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="agentactions", name=name).get("status",{}).get("results",[])
+            results.append({"step":i,"step_spec":step,"result": res})
+            update_status(api,name,{"status":{"state":"running","step_index": i+1,"results": results}})
+            audit_log_action(name, requester, step, {"state":"executed","result":res})
+        except Exception as e:
+            # attempt rollback simple strategy: for known k8s ops, restore previous state if we stored it (scaffold)
+            update_status(api,name,{"status":{"state":"failed","error": str(e)}})
+            audit_log_action(name, requester, step, {"state":"failed","error": str(e)})
+            # mark for operator attention
+            return
+    # finished
+    update_status(api,name,{"status":{"state":"succeeded"}})
+    audit_log_action(name, requester, {"final":"completed"}, {"state":"succeeded"})
+
+def main():
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    api = client.CustomObjectsApi()
+    w = watch.Watch()
+    for event in w.stream(api.list_namespaced_custom_object, group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="agentactions", timeout_seconds=0):
+        typ = event["type"]
+        obj = event["object"]
+        name = obj["metadata"]["name"]
+        status = obj.get("status",{}).get("state","")
+        if typ == "ADDED" and status in ("", None):
+            print("New AgentAction", name, "processing")
+            execute_action(obj)
+
+if __name__=="__main__":
+    main()
+
