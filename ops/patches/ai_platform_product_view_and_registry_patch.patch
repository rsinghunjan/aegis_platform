+#!/usr/bin/env python3
+"""
+Minimal Aegis Python SDK (control-plane helpers).
+Provides convenience for common flows: register_model, upload_version, promote_model (calls promotion gate).
+"""
+import os, requests
+
+class AegisClient:
+    def __init__(self, registry_url=None, accounting_url=None):
+        self.registry_url = registry_url or os.environ.get("MODEL_REGISTRY_URL", "http://aegis-model-registry.monitoring.svc:8081")
+        self.accounting_url = accounting_url or os.environ.get("CARBON_ACCOUNTING_URL", "")
+
+    def register_model(self, name):
+        r = requests.post(f"{self.registry_url}/models", json={"name": name}, timeout=10)
+        r.raise_for_status()
+        return r.json()
+
+    def upload_version(self, name, version, metadata=None, artifact_path=None):
+        files = {}
+        data = {"version": version, "metadata": json.dumps(metadata or {})}
+        if artifact_path:
+            files["artifact"] = open(artifact_path, "rb")
+        r = requests.post(f"{self.registry_url}/models/{name}/versions", data=data, files=files, timeout=60)
+        r.raise_for_status()
+        return r.json()
+
+    def annotate_version(self, name, version, annotations: dict):
+        r = requests.post(f"{self.registry_url}/models/{name}/versions/{version}/annotations", json={"annotations": annotations}, timeout=10)
+        r.raise_for_status()
+        return r.json()
+
+    def promote_model_via_ci(self, job_id, model_name, model_version, promote_endpoint):
+        # Call the CI promotion gate endpoint (e.g. GH Action or internal endpoint)
+        payload = {"job_id": job_id, "model_name": model_name, "model_version": model_version}
+        r = requests.post(promote_endpoint, json=payload, timeout=30)
+        r.raise_for_status()
+        return r.json()
+
+if __name__=="__main__":
+    import sys, json
+    c = AegisClient()
+    print(c.register_model("demo-model"))
+
