+#!/usr/bin/env python3
+"""
+Minimal Model Registry service.
+ - Lightweight FastAPI service backed by SQLite (services/registry/models.db)
+ - Endpoints:
+    POST /models                 -> create model
+    POST /models/{name}/versions -> create version (accepts artifact upload URI or multipart upload)
+    GET  /models                 -> list
+    GET  /models/{name}          -> model details + versions
+    POST /models/{name}/versions/{version}/annotations -> add annotation (e.g., carbon_kg)
+ - Designed to be a simple control-plane component to integrate with CI gates and promotion flows.
+"""
+import os, time, sqlite3, json
+from fastapi import FastAPI, HTTPException, UploadFile, File, Form
+from pydantic import BaseModel
+import boto3
+
+DB_PATH = os.environ.get("MODEL_REGISTRY_DB", "services/registry/models.db")
+ARTIFACT_STORE_PREFIX = os.environ.get("MODEL_STORE_PREFIX", "")  # optional s3://bucket/path
+S3_CLIENT = None
+if ARTIFACT_STORE_PREFIX.startswith("s3://"):
+    try:
+        S3_CLIENT = boto3.client("s3")
+    except Exception:
+        S3_CLIENT = None
+
+app = FastAPI(title="Aegis Model Registry (Minimal)")
+
+def init_db():
+    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+    conn = sqlite3.connect(DB_PATH)
+    cur = conn.cursor()
+    cur.executescript(open("services/registry/schema.sql").read())
+    conn.commit()
+    conn.close()
+
+def db_conn():
+    c = sqlite3.connect(DB_PATH)
+    c.row_factory = sqlite3.Row
+    return c
+
+class CreateModel(BaseModel):
+    name: str
+
+@app.on_event("startup")
+def startup():
+    init_db()
+
+@app.post("/models")
+def create_model(body: CreateModel):
+    conn = db_conn(); cur = conn.cursor()
+    now = int(time.time())
+    try:
+        cur.execute("INSERT INTO models(name, created_at) VALUES (?,?)", (body.name, now))
+        conn.commit()
+    except sqlite3.IntegrityError:
+        raise HTTPException(status_code=409, detail="model exists")
+    return {"name": body.name, "created_at": now}
+
+@app.get("/models")
+def list_models():
+    conn = db_conn(); cur = conn.cursor()
+    cur.execute("SELECT id, name, created_at FROM models ORDER BY name")
+    rows = cur.fetchall()
+    return {"models":[dict(r) for r in rows]}
+
+@app.get("/models/{name}")
+def get_model(name: str):
+    conn = db_conn(); cur = conn.cursor()
+    cur.execute("SELECT id,name,created_at FROM models WHERE name=?", (name,))
+    m = cur.fetchone()
+    if not m:
+        raise HTTPException(status_code=404, detail="model not found")
+    cur.execute("SELECT id,version,artifact_uri,metadata,created_at FROM model_versions WHERE model_id=? ORDER BY created_at DESC", (m["id"],))
+    versions = [dict(r) for r in cur.fetchall()]
+    return {"model": dict(m), "versions": versions}
+
+@app.post("/models/{name}/versions")
+async def create_version(name: str, version: str = Form(...), metadata: str = Form(None), artifact: UploadFile = File(None), artifact_uri: str = Form(None)):
+    conn = db_conn(); cur = conn.cursor()
+    cur.execute("SELECT id FROM models WHERE name=?", (name,))
+    m = cur.fetchone()
+    if not m:
+        raise HTTPException(status_code=404, detail="model not found")
+    model_id = m["id"]
+    now = int(time.time())
+    final_uri = artifact_uri
+    if artifact is not None:
+        # store artifact to MODEL_STORE_PREFIX if configured, otherwise write to /tmp
+        data = await artifact.read()
+        if ARTIFACT_STORE_PREFIX.startswith("s3://") and S3_CLIENT:
+            parts = ARTIFACT_STORE_PREFIX[len("s3://"):].split("/",1)
+            bucket = parts[0]; base = parts[1] if len(parts)>1 else ""
+            key = f"{base.rstrip('/')}/{name}/{version}/{artifact.filename}"
+            S3_CLIENT.put_object(Bucket=bucket, Key=key, Body=data)
+            final_uri = f"s3://{bucket}/{key}"
+        else:
+            os.makedirs("/tmp/aegis_registry_artifacts", exist_ok=True)
+            path = f"/tmp/aegis_registry_artifacts/{name}_{version}_{artifact.filename}"
+            open(path,"wb").write(data)
+            final_uri = path
+    cur.execute("INSERT INTO model_versions(model_id,version,artifact_uri,metadata,created_at) VALUES (?,?,?,?,?)", (model_id, version, final_uri, metadata or "{}", now))
+    conn.commit()
+    return {"model": name, "version": version, "artifact_uri": final_uri}
+
+@app.post("/models/{name}/versions/{version}/annotations")
+def annotate_version(name: str, version: str, body: dict):
+    conn = db_conn(); cur = conn.cursor()
+    cur.execute("SELECT mv.id FROM model_versions mv JOIN models m ON m.id=mv.model_id WHERE m.name=? AND mv.version=?", (name, version))
+    mv = cur.fetchone()
+    if not mv:
+        raise HTTPException(status_code=404, detail="version not found")
+    now = int(time.time())
+    for k,v in body.get("annotations", {}).items():
+        cur.execute("INSERT INTO annotations(model_version_id,key,value,created_at) VALUES (?,?,?,?)", (mv["id"], k, json.dumps(v), now))
+    conn.commit()
+    return {"ok": True}
+
+if __name__=="__main__":
+    import uvicorn
+    uvicorn.run("services.registry.minimal_model_registry:app", host="0.0.0.0", port=int(os.environ.get("PORT", "8081")))
+
