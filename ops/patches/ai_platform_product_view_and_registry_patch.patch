+#!/usr/bin/env python3
+"""
+Simple CLI wrapper around aegis_sdk for developer ergonomics.
+Commands:
+  aegisctl register <model>
+  aegisctl upload <model> <version> --artifact path
+  aegisctl annotate <model> <version> --key k --value v
+"""
+import argparse
+from services.sdk.aegis_sdk import AegisClient
+import json
+
+def main():
+    p = argparse.ArgumentParser(prog="aegisctl")
+    sub = p.add_subparsers(dest="cmd")
+    reg = sub.add_parser("register"); reg.add_argument("model")
+    up = sub.add_parser("upload"); up.add_argument("model"); up.add_argument("version"); up.add_argument("--artifact")
+    ann = sub.add_parser("annotate"); ann.add_argument("model"); ann.add_argument("version"); ann.add_argument("--key"); ann.add_argument("--value")
+    args = p.parse_args()
+    c = AegisClient()
+    if args.cmd == "register":
+        print(c.register_model(args.model))
+    elif args.cmd == "upload":
+        print(c.upload_version(args.model, args.version, artifact_path=args.artifact))
+    elif args.cmd == "annotate":
+        print(c.annotate_version(args.model, args.version, {args.key: args.value}))
+    else:
+        p.print_help()
+
+if __name__=="__main__":
+    main()
+
