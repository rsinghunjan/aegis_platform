+#!/usr/bin/env python3
+"""
+Create GitHub issues for missing SME signoffs/proofs.
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/automation/create_sme_issues.py --repo owner/repo
+
+This script reads /tmp/sme_missing_items.yml (produced by ops/formal/sme_workflow_manager.py)
+and creates issues for each missing item, deduplicating by title.
+"""
+import os
+import sys
+import yaml
+import requests
+import argparse
+from pathlib import Path
+
+GITHUB_API = "https://api.github.com"
+
+def load_missing(path="/tmp/sme_missing_items.yml"):
+    p = Path(path)
+    if not p.exists():
+        print("Missing input:", path)
+        return []
+    return yaml.safe_load(p.read_text()).get("missing", [])
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def issue_exists(repo, title, token):
+    url = f"{GITHUB_API}/search/issues"
+    q = f"repo:{repo} in:title {requests.utils.requote_uri(title)}"
+    r = requests.get(url, params={"q": q}, headers=gh_headers(token))
+    if r.status_code != 200:
+        print("Search failed:", r.status_code, r.text)
+        return False
+    data = r.json()
+    return data.get("total_count", 0) > 0
+
+def create_issue(repo, title, body, labels, token):
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    payload = {"title": title, "body": body, "labels": labels}
+    r = requests.post(url, json=payload, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        print("Created issue:", r.json().get("html_url"))
+        return True
+    else:
+        print("Failed to create issue:", r.status_code, r.text)
+        return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True, help="owner/repo to create issues in")
+    p.add_argument("--input", default="/tmp/sme_missing_items.yml")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required in env")
+        sys.exit(2)
+    missing = load_missing(args.input)
+    if not missing:
+        print("No missing SME items found.")
+        return
+    for m in missing:
+        iid = m.get("id")
+        issue = m.get("issue")
+        title = f"[SME] {iid}: {issue.replace('_',' ')}"
+        body = f"Automated notice: SME/prover item missing for `{iid}`.\n\nIssue: `{issue}`\n\nPlease add SME signoff or proof artifact under `ops/formal/onboard_submissions` or `tests/artifacts/mock_proof/`.\n\n(Generated by ops/automation/create_sme_issues.py)"
+        labels = ["formal","sme","needs-triage"]
+        if issue_exists(args.repo, title, token):
+            print("Issue already exists for", title)
+            continue
+        create_issue(args.repo, title, body, labels, token)
+
+if __name__ == "__main__":
+    main()
+
