+#!/usr/bin/env python3
+"""
+Safe Autopilot for Low-Risk Promotions
+
+Behavior:
+ - Scans a candidate directory for evaluation summaries (JSON) and their signatures.
+ - Validates presence of signature and that metrics meet thresholds defined in autopilot_policy.json.
+ - For "low" risk candidates: triggers a repository_dispatch event "aegis_auto_promote" to signal downstream promotion automation,
+   and posts an auto-promotion issue for audit.
+ - For "medium"/"high" risk: creates a manual promotion request issue listing required evidence.
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/automation/safe_autopilot.py --repo owner/repo --cand-dir /tmp/autopilot_candidates
+"""
+import os
+import sys
+import json
+import glob
+import requests
+import argparse
+from pathlib import Path
+
+GITHUB_API = "https://api.github.com"
+
+def load_policy(path="ops/automation/autopilot_policy.json"):
+    if Path(path).exists():
+        return json.loads(open(path).read())
+    # default policy
+    return {"metrics": {"f1": 0.90}, "latency_ms_p99": 50}
+
+def has_signature(eval_path):
+    if Path(eval_path + ".sig").exists() or Path(eval_path + ".sig.b64").exists():
+        return True
+    # allow inline signature field
+    try:
+        j = json.loads(open(eval_path).read())
+        return bool(j.get("signature"))
+    except Exception:
+        return False
+
+def meets_thresholds(eval_j, policy):
+    metrics = eval_j.get("metrics", {})
+    f1 = metrics.get("overall", {}).get("f1") or metrics.get("f1") or 0.0
+    latency = metrics.get("latency_ms", {}).get("p99") or eval_j.get("metrics", {}).get("latency_ms_p99", None)
+    ok = True
+    reasons = []
+    if f1 < policy.get("metrics", {}).get("f1", 0.0):
+        ok = False
+        reasons.append(f"f1 {f1} < {policy['metrics']['f1']}")
+    if latency is not None and latency > policy.get("latency_ms_p99", 99999):
+        ok = False
+        reasons.append(f"p99 {latency}ms > {policy['latency_ms_p99']}ms")
+    return ok, reasons
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def create_issue(repo, title, body, labels, token):
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    r = requests.post(url, json={"title": title, "body": body, "labels": labels}, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        print("Created issue:", r.json().get("html_url"))
+        return r.json().get("html_url")
+    print("Failed to create issue:", r.status_code, r.text)
+    return None
+
+def repo_dispatch(repo, event_type, client_payload, token):
+    url = f"{GITHUB_API}/repos/{repo}/dispatches"
+    headers = gh_headers(token)
+    headers["Content-Type"] = "application/json"
+    r = requests.post(url, json={"event_type": event_type, "client_payload": client_payload}, headers=headers)
+    if r.status_code in (204, 200):
+        print("Repository dispatch sent:", event_type)
+        return True
+    print("Failed repo dispatch:", r.status_code, r.text)
+    return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    p.add_argument("--cand-dir", default="/tmp/autopilot_candidates")
+    p.add_argument("--policy", default="ops/automation/autopilot_policy.json")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required")
+        sys.exit(2)
+    policy = load_policy(args.policy)
+    candidates = glob.glob(os.path.join(args.cand_dir, "*.json"))
+    if not candidates:
+        print("No candidates found in", args.cand_dir)
+        return
+    for c in candidates:
+        try:
+            ev = json.loads(open(c).read())
+        except Exception as e:
+            print("Failed to read", c, e); continue
+        model = ev.get("model", "unknown")
+        risk = ev.get("risk", "low")
+        if not has_signature(c):
+            print("Skipping", c, "- missing signature")
+            continue
+        ok, reasons = meets_thresholds(ev, policy)
+        if not ok:
+            # create manual issue
+            title = f"[PROMOTION REQUEST] {model} - requires manual review"
+            body = f"Auto-check failed thresholds for {model}.\n\nReasons:\n" + "\n".join(reasons) + f"\n\nEval file: {c}\n"
+            create_issue(args.repo, title, body, ["promotion","needs-review"], token)
+            continue
+        # thresholds OK
+        if risk == "low":
+            # auto-promote via repository dispatch
+            payload = {"model": model, "eval": c, "initiator": "aegis-autopilot"}
+            dispatched = repo_dispatch(args.repo, "aegis_auto_promote", payload, token)
+            if dispatched:
+                title = f"[AUTO-PROMOTED] {model}"
+                body = f"{model} passed autopilot policy and a repo dispatch was sent to trigger promotion.\n\nEval: {c}"
+                create_issue(args.repo, title, body, ["auto-promote","audit"], token)
+        else:
+            # medium/high risk -> create issue requesting approval
+            title = f"[PROMOTION REQUEST] {model} (risk={risk})"
+            body = f"{model} passes thresholds but is marked risk={risk}. Require manual approval.\n\nEval: {c}"
+            create_issue(args.repo, title, body, ["promotion","needs-approval"], token)
+
+if __name__ == "__main__":
+    main()
+
