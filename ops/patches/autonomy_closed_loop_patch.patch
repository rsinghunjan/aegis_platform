+def handle_alert(alert):
+    typ = alert.get("type")
+    if typ == "drift":
+        # start sampling and retrain sequence
+        reindex()
+        trigger_retrain()
+    elif typ == "verifier_regression":
+        # scale rater pool for more labeling
+        scale_up_raters(5)
+        if HUMAN_APPROVAL_WEBHOOK:
+            requests.post(HUMAN_APPROVAL_WEBHOOK, json={"alert": alert}, timeout=5)
+    elif typ == "high_co2":
+        # delay heavy work
+        print("High CO2: delaying batch jobs")
+    else:
+        print("Unhandled alert:", alert)
+
+def main_loop():
+    while True:
+        try:
+            r = requests.get(ALERT_POLL_URL, timeout=10)
+            alerts = r.json() if r.status_code==200 else []
+            for a in alerts:
