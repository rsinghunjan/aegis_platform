+        j = r.json()
+        if isinstance(j.get("data"), list):
+            v = j["data"][0].get("intensity", {}).get("actual", None)
+            if v is not None:
+                return float(v)/1000.0
+    except Exception:
+        pass
+    return None
+
+def wait_for_low_carbon(max_wait_secs=86400):
+    start = time.time()
+    while time.time() - start < max_wait_secs:
+        val = get_intensity()
+        if val is not None and val <= THRESH_KG_PER_KWH:
+            return True
+        time.sleep(CHECK_INTERVAL)
