+"""
+Explainability utilities used by the autonomous loops:
+ - compute token-level attributions (calls existing token attribution code)
+ - compute uncertainty metrics for outputs (entropy, ensemble variance)
+ - return a compact explanation object used to decide escalation
+"""
+import os
+from typing import Dict, List
+import numpy as np
+
+from services.explainability.token_attribution import integrated_gradients_attribution, attention_rollout_attribution
+
+def token_attributions(model, tokenizer, text, method="attention"):
+    if method == "integrated":
+        atts = integrated_gradients_attribution(model, tokenizer, text)
+    else:
+        atts = attention_rollout_attribution(model, tokenizer(text, return_tensors="pt")["input_ids"])
+    return atts
+
+def uncertainty_from_logits(logits_list: List[np.ndarray]) -> Dict:
+    # logits_list: list of (batch, vocab) arrays from ensemble
+    # compute mean entropy and variance across ensemble
+    entropies = []
+    for logits in logits_list:
+        p = np.exp(logits) / np.exp(logits).sum(axis=-1, keepdims=True)
+        entropies.append(- (p * np.log(p + 1e-12)).sum(axis=-1))
+    entropies = np.stack(entropies, axis=0)
+    mean_ent = float(entropies.mean())
+    var_ent = float(entropies.var())
+    return {"mean_entropy": mean_ent, "var_entropy": var_ent}
+
