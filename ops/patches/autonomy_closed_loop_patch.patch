+"""
+Sampler: chooses examples for labeling using uncertainty and impact heuristics.
+ - Pulls production logs or a sampling endpoint
+ - Scores examples by uncertainty (entropy), verifier disagreement, provenance absence and recency
+ - Enqueues selected items to human_queue with priority and budget controls
+"""
+import os
+import time
+import json
+import math
+from typing import List
+import requests
+from scipy.stats import entropy
+
+HUMAN_QUEUE_URL = os.environ.get("HUMAN_QUEUE_URL", "http://human-queue.safety.svc:80/enqueue")
+INFERENCE_LOG_PATH = os.environ.get("INFERENCE_LOG_PATH", "/var/log/aegis/inference_requests.jsonl")
+SAMPLE_BATCH = int(os.environ.get("SAMPLE_BATCH", "50"))
+BUDGET_PER_DAY = int(os.environ.get("AL_LABEL_BUDGET_PER_DAY", "100"))
+SLEEP_SECONDS = int(os.environ.get("SAMPLER_SLEEP", "60"))
+VERIFIER_URL = os.environ.get("VERIFIER_URL", "http://verifier.safety.svc:8080/verify")
+
+def compute_entropy(probs: List[float]) -> float:
+    # assume probs is softmax over tokens or classes
+    return float(entropy(probs))
+
+def score_example(example: dict) -> float:
+    # heuristics: higher entropy and lower verifier support => higher priority
+    probs = example.get("token_probs") or example.get("class_probs") or [0.5, 0.5]
+    ent = compute_entropy(probs)
+    # call verifier if evidence exists
+    ver_score = 0.0
+    try:
+        if example.get("evidence"):
+            r = requests.post(VERIFIER_URL, json={"claim": example.get("prompt") or example.get("text"), "evidence": example.get("evidence")}, timeout=3)
+            if r.status_code == 200:
+                ver_score = r.json().get("best", {}).get("score", 0.0)
+    except Exception:
+        ver_score = 0.0
+    # absence of provenance => upweight
+    prov_weight = 1.0 if not example.get("provenance") else 0.7
+    score = ent * (1.0 - ver_score) * prov_weight
+    return float(score)
+
+def enqueue_for_label(item: dict, severity: str = "medium"):
+    payload = {
+        "text": item.get("text") or item.get("prompt"),
+        "output": item.get("output"),
+        "provenance": item.get("provenance", []),
+        "severity": severity,
+        "metadata": {"auto_sampled": True, "reason": item.get("reason", "")}
+    }
+    try:
+        r = requests.post(HUMAN_QUEUE_URL, json=payload, timeout=5)
+        return r.status_code in (200,201,202)
+    except Exception:
+        return False
+
+def main_loop():
+    daily_budget_used = 0
+    while True:
+        try:
+            if not os.path.exists(INFERENCE_LOG_PATH):
+                time.sleep(SLEEP_SECONDS); continue
+            batch = []
+            with open(INFERENCE_LOG_PATH) as f:
+                for line in f:
+                    try:
+                        j = json.loads(line.strip())
+                        batch.append(j)
+                        if len(batch) >= SAMPLE_BATCH: break
+                    except Exception:
+                        continue
+            scored = []
+            for ex in batch:
+                s = score_example(ex)
+                scored.append((s, ex))
+            scored.sort(key=lambda x: x[0], reverse=True)
+            for s,ex in scored:
+                if daily_budget_used >= BUDGET_PER_DAY: break
+                ok = enqueue_for_label(ex)
+                if ok:
+                    daily_budget_used += 1
+        except Exception as e:
+            print("sampler error", e)
+        time.sleep(SLEEP_SECONDS)
+
+if __name__ == "__main__":
+    main_loop()
+
