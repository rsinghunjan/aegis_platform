+        "default": {"evidence_required": False, "verifier_threshold": 0.35, "action_on_fail": "allow_with_caveat"}
+    }
+
+POLICIES = load_policies()
+
+def evaluate(output: Dict) -> Dict:
+    """
+    Input output structure expected:
+    {"prompt":..., "answer":..., "provenance":[...], "verifier": {"best": {"score":0.3}}}
+    """
+    policy = POLICIES.get(output.get("risk_level","default"))
+    thresh = policy.get("verifier_threshold", 0.35)
+    evidence_required = policy.get("evidence_required", False)
+    best_score = output.get("verifier", {}).get("best", {}).get("score", 0.0)
+    has_provenance = bool(output.get("provenance"))
+    if evidence_required and not has_provenance:
+        return {"action":"enqueue_review", "reason":"missing_evidence"}
+    if best_score < thresh:
+        return {"action": policy.get("action_on_fail", "enqueue_review"), "reason":"verifier_low"}
