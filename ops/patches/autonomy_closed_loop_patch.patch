+"""
+Drift detector service (embedding / output drift).
+ - Periodically samples a corpus (or uses incoming production embeddings) and computes statistical drift
+ - Emits Prometheus metrics and triggers a webhook / callback when drift exceeds threshold
+ - Configurable via environment variables
+
+Notes:
+ - This is a lightweight scaffold. For production you should replace the sample loader with streaming
+   observation pipelines and persist historical embedding distributions.
+"""
+import os
+import time
+import json
+import numpy as np
+from prometheus_client import Gauge, start_http_server
+from typing import List
+
+from services.retriever import embedding_client  # assumed existing retriever wrapper
+
+DRIFT_THRESHOLD = float(os.environ.get("DRIFT_THRESHOLD", "0.25"))
+POLL_SECS = int(os.environ.get("DRIFT_POLL_SECS", "300"))
+EXPORT_PORT = int(os.environ.get("DRIFT_METRICS_PORT", "9420"))
+ALERT_WEBHOOK = os.environ.get("DRIFT_ALERT_WEBHOOK", "")  # e.g., http://orchestrator/alert
+
+METRIC_DRIFT_SCORE = Gauge("aegis_embedding_drift_score", "Embedding drift score (KS-statistic or cosine-shift)")
+METRIC_DRIFT_ALERTS = Gauge("aegis_embedding_drift_alerts_total", "Drift alerts fired")
+
+BASELINE_PATH = os.environ.get("DRIFT_BASELINE_PATH", "/data/drift_baseline.npy")
+SAMPLE_IDS_PATH = os.environ.get("DRIFT_SAMPLE_IDS", "/data/drift_sample_ids.json")
+
+def load_baseline() -> np.ndarray:
+    if os.path.exists(BASELINE_PATH):
+        return np.load(BASELINE_PATH)
+    # else compute on initial corpus (placeholder)
+    return np.zeros((1, embedding_client.dim()))
+
+def sample_current_embeddings(sample_ids: List[str]) -> np.ndarray:
+    # placeholder: use embedding_client to get embeddings quickly
+    embs = []
+    for sid in sample_ids:
+        v = embedding_client.get_embedding(sid)  # returns np.array or None
+        if v is not None:
+            embs.append(v)
+    if not embs:
+        return np.zeros((1, embedding_client.dim()))
+    return np.vstack(embs)
+
+def drift_score(baseline: np.ndarray, current: np.ndarray) -> float:
+    # simple heuristic: compute mean cosine distance between baseline mean and current mean
+    bmean = np.mean(baseline, axis=0)
+    cmean = np.mean(current, axis=0)
+    num = np.dot(bmean, cmean)
+    den = (np.linalg.norm(bmean) * np.linalg.norm(cmean) + 1e-12)
+    cos = num / den
+    score = 1.0 - cos
+    return float(score)
+
+def fire_alert(score: float, meta: dict):
+    METRIC_DRIFT_ALERTS.inc()
+    if ALERT_WEBHOOK:
+        try:
+            import requests
+            requests.post(ALERT_WEBHOOK, json={"type":"drift","score": score, "meta": meta}, timeout=5)
+        except Exception:
+            pass
+
+def main_loop():
+    start_http_server(EXPORT_PORT)
+    baseline = load_baseline()
+    sample_ids = []
+    if os.path.exists(SAMPLE_IDS_PATH):
+        sample_ids = json.load(open(SAMPLE_IDS_PATH))
+    while True:
+        try:
+            cur = sample_current_embeddings(sample_ids)
+            score = drift_score(baseline, cur)
+            METRIC_DRIFT_SCORE.set(score)
+            if score >= DRIFT_THRESHOLD:
+                fire_alert(score, {"sample_count": cur.shape[0]})
+        except Exception as e:
+            print("drift error", e)
+        time.sleep(POLL_SECS)
+
+if __name__ == "__main__":
+    main_loop()
+
