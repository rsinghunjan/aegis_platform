+#!/usr/bin/env python3
+"""
+Long-term reliability monitor:
+ - Tracks SLOs over time (daily/weekly/monthly windows)
+ - Emits alerts when sustained degradation is observed (calls alert webhook)
+ - Writes reliability reports to evidence bucket for audits
+"""
+import os, time, logging, requests, json
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+logger=logging.getLogger("long-term-monitor")
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+SLO_THRESHOLD = float(os.environ.get("SLO_THRESHOLD", "0.99"))
+
+def query_slo():
+    try:
+        r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": "sum(rate(success_count[5m]))/sum(rate(request_count[5m]))"}, timeout=10)
+        if r.status_code!=200:
+            return None
+        return r.json().get("data",{})
+    except Exception:
+        return None
+
+def send_alert(msg):
+    if not ALERT_WEBHOOK:
+        logger.warning("Alert webhook not configured")
+        return
+    try:
+        requests.post(ALERT_WEBHOOK, json={"text": msg}, timeout=5)
+    except Exception:
+        logger.exception("alert send failed")
+
+def write_report(summary):
+    if not EVIDENCE_BUCKET:
+        return
+    import boto3
+    s3=boto3.client("s3")
+    key=f"reliability/reports/{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(summary).encode())
+
+def run_loop(poll_min=10):
+    window=[]
+    while True:
+        data = query_slo()
+        ts = datetime.utcnow().isoformat()
+        window.append({"ts": ts, "data": data})
+        # keep last N points (sliding)
+        if len(window) > 144:  # ~24 hours at 10min polling
+            window.pop(0)
+        # simple check: if latest SLO < threshold -> alert and record
+        try:
+            # PoC: check existence
+            if not data:
+                send_alert(f"SLO query returned empty at {ts}")
+            # upload periodic snapshot
+            if len(window) % 12 == 0:
+                write_report({"ts": ts, "window_len": len(window), "sample": data})
+        except Exception:
+            logger.exception("monitor error")
+        time.sleep(poll_min*60)
+
+if __name__ == "__main__":
+    run_loop()
+
