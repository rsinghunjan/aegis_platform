+#!/usr/bin/env python3
+"""
+Validating admission webhook (PoC) that ensures deployed model artifacts are cosign-signed.
+In production:
+ - Run behind TLS with cert-manager generated certs
+ - Use a robust cosign verification method (e.g., KMS-backed key or Fulcio transparency)
+ - Restrict scope to model-deployments namespace and validate image/artifact signatures
+"""
+from flask import Flask, request, jsonify
+import subprocess, json, base64, logging, os
+
+app = Flask(__name__)
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("cosign-webhook")
+
+def verify_cosign_annotation(annotations):
+    # PoC: require presence of aegis.cosign_sig annotation (a URL or base64 signature)
+    sig = annotations.get("aegis.cosign_sig")
+    if not sig:
+        return False, "missing cosign annotation"
+    # In production, call `cosign verify-blob` or use python bindings to verify signature against stored public key
+    # Here we just accept presence as PoC
+    return True, "present"
+
+@app.route("/validate", methods=["POST"])
+def validate():
+    req = request.get_json()
+    uid = req["request"]["uid"]
+    obj = req["request"]["object"]
+    try:
+        annotations = obj.get("metadata", {}).get("annotations", {})
+        ok, msg = verify_cosign_annotation(annotations)
+        resp = {"response": {"uid": uid, "allowed": ok}}
+        if not ok:
+            resp["response"]["status"] = {"message": msg}
+        return jsonify(resp)
+    except Exception as e:
+        logger.exception("validation error")
+        return jsonify({"response":{"uid": req.get("request",{}).get("uid",""), "allowed": False, "status":{"message":"internal error"}}})
+
+if __name__ == "__main__":
+    # TLS should be configured via cert-manager and Deployment mount
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8443")))
+
