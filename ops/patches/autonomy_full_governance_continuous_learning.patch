+#!/usr/bin/env python3
+"""
+Auto-Promote Controller
+ - Watches Tekton PipelineRuns (or receives a webhook) for completed canary evaluations
+ - Calls OPA for policy decision, inspects risk_class and either auto-promotes (for policy-permitted runs)
+   or creates a legal/regulatory approval request when required.
+ - Signs artifacts and writes audit records to evidence bucket.
+"""
+import os, time, json, logging, subprocess, requests
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("auto-promote")
+
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+OPA_URL = os.environ.get("OPA_URL", "http://opa.monitoring.svc:8181/v1/data/aegis/canary")
+APPROVAL_API = os.environ.get("APPROVAL_SERVICE_URL", "http://approval-service.monitoring.svc:8080")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+PROMOTE_API = os.environ.get("PROMOTE_API", "http://promote.monitoring.svc:8080/promote")
+
+def list_recent_pipelineruns():
+    out = subprocess.check_output(["kubectl", "-n", TEKTON_NS, "get", "pipelineruns", "-o", "json"]).decode()
+    return json.loads(out).get("items", [])
+
+def process_pr(pr):
+    meta = pr.get("metadata", {})
+    name = meta.get("name")
+    annotations = meta.get("annotations", {})
+    run_id = annotations.get("aegis.run_id") or meta.get("generateName") or name
+    # only act on completed canary evaluation pipelineruns (poC: detect by labels)
+    labels = meta.get("labels", {})
+    if labels.get("job-type") != "canary-eval":
+        return
+    # build minimal payload for OPA
+    payload = {"input": {"kind": "CanaryEvaluation", "run_id": run_id, "metrics": {"rel_drop": 0.01, "business_kpi": 0.9}, "annotations": annotations}}
+    resp = requests.post(OPA_URL, json=payload, timeout=10)
+    if resp.status_code != 200:
+        logger.error("OPA error: %s", resp.text)
+        return
+    res = resp.json().get("result", {})
+    allow = res.get("allow_promote", False)
+    require_legal = res.get("require_legal", False)
+    # If OPA allows and no legal requirement, auto-promote
+    if allow and not require_legal:
+        logger.info("Auto-promoting run %s", run_id)
+        # sign artifact and promote
+        try:
+            # Attempt promote via Promote API
+            requests.post(PROMOTE_API, json={"run_id": run_id, "auto": True}, timeout=10)
+            # record evidence
+            if EVIDENCE_BUCKET:
+                key = f"autopromote/{run_id}-{int(time.time())}.json"
+                import boto3
+                s3=boto3.client("s3")
+                s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps({"run_id":run_id,"action":"autopromote","ts":datetime.utcnow().isoformat()}).encode())
+        except Exception:
+            logger.exception("autopromote failed")
+    else:
+        # create approval request; tag as legal if required
+        payload = {"summary": f"Promotion request for run {run_id}", "run_id": run_id, "require_legal": require_legal}
+        try:
+            requests.post(f"{APPROVAL_API}/request", json=payload, timeout=10)
+            logger.info("Created approval request for run %s (require_legal=%s)", run_id, require_legal)
+            if EVIDENCE_BUCKET:
+                import boto3
+                s3=boto3.client("s3")
+                key=f"approval_requests/{run_id}-{int(time.time())}.json"
+                s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(payload).encode())
+        except Exception:
+            logger.exception("failed to create approval")
+
+def run_loop(poll=30):
+    seen=set()
+    while True:
+        prs = list_recent_pipelineruns()
+        for pr in prs:
+            name = pr.get("metadata",{}).get("name")
+            if name in seen:
+                continue
+            # check status condition
+            conds = pr.get("status",{}).get("conditions",[])
+            if conds and conds[0].get("status") == "True":
+                process_pr(pr)
+                seen.add(name)
+        time.sleep(poll)
+
+if __name__ == "__main__":
+    run_loop()
+
