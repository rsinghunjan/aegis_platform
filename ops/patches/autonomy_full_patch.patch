+#!/usr/bin/env python3
+"""
+Autopilot runner (extended)
+
+- Scans candidate evaluation JSON files in a directory (default /tmp/autopilot_candidates).
+- Verifies signatures exist (eval.json.sig or .sig.b64 or inline "signature" field).
+- Validates metrics against autopilot_policy_extended.json.
+- Performs a lightweight estimated cost check (mock) and enforces cost thresholds.
+- For qualifying low-risk candidates: emits a repo dispatch event "aegis_auto_promote"
+  and writes an audit log entry.
+- For medium/high risk candidates or failures: creates a GitHub issue requesting manual approval.
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/automation/autopilot_runner.py --repo owner/repo --cand-dir /tmp/autopilot_candidates
+"""
+import os
+import sys
+import json
+import glob
+import requests
+import argparse
+from pathlib import Path
+from datetime import datetime
+
+GITHUB_API = "https://api.github.com"
+
+def load_policy(path="ops/automation/autopilot_policy_extended.json"):
+    return json.loads(open(path).read())
+
+def has_signature(path):
+    if Path(path + ".sig").exists() or Path(path + ".sig.b64").exists():
+        return True
+    try:
+        j = json.loads(open(path).read())
+        return bool(j.get("signature"))
+    except Exception:
+        return False
+
+def meets_thresholds(ev, policy):
+    metrics = ev.get("metrics", {})
+    overall = metrics.get("overall", {})
+    f1 = overall.get("f1", metrics.get("f1", 0.0))
+    precision = overall.get("precision", metrics.get("precision", 0.0))
+    recall = overall.get("recall", metrics.get("recall", 0.0))
+    latency_p99 = metrics.get("latency_ms", {}).get("p99", metrics.get("latency_ms_p99", None))
+    reasons = []
+    if f1 < policy["metrics"]["f1"]:
+        reasons.append(f"f1 {f1} < {policy['metrics']['f1']}")
+    if precision < policy["metrics"]["precision"]:
+        reasons.append(f"precision {precision} < {policy['metrics']['precision']}")
+    if recall < policy["metrics"]["recall"]:
+        reasons.append(f"recall {recall} < {policy['metrics']['recall']}")
+    if latency_p99 is not None and latency_p99 > policy["latency_ms_p99"]:
+        reasons.append(f"p99 {latency_p99}ms > {policy['latency_ms_p99']}ms")
+    return len(reasons) == 0, reasons
+
+def estimate_cost(ev):
+    # Mock cost estimator: if eval mentions device or runtime, estimate a small cost.
+    # Replace with real billing connector mapping in production.
+    device = ev.get("device", "cpu")
+    if device.lower() in ("tpu","inferentia","qpu"):
+        return 2.0
+    if device.lower().startswith("gpu"):
+        return 1.0
+    return 0.1
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def create_issue(repo, title, body, labels, token):
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    r = requests.post(url, json={"title": title, "body": body, "labels": labels}, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        return r.json().get("html_url")
+    print("Issue creation failed:", r.status_code, r.text)
+    return None
+
+def repo_dispatch(repo, event_type, payload, token):
+    url = f"{GITHUB_API}/repos/{repo}/dispatches"
+    r = requests.post(url, json={"event_type": event_type, "client_payload": payload}, headers=gh_headers(token))
+    return r.status_code in (204,200)
+
+def audit_write(path, entry):
+    with open(path, "a") as fh:
+        fh.write(json.dumps(entry) + "\n")
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    p.add_argument("--cand-dir", default="/tmp/autopilot_candidates")
+    p.add_argument("--policy", default="ops/automation/autopilot_policy_extended.json")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required"); sys.exit(2)
+    policy = load_policy(args.policy)
+    candidates = glob.glob(os.path.join(args.cand_dir, "*.json"))
+    if not candidates:
+        print("No candidates to process in", args.cand_dir); return
+    for c in candidates:
+        try:
+            ev = json.loads(open(c).read())
+        except Exception as e:
+            print("Failed to load", c, e); continue
+        signed_ok = has_signature(c) if policy.get("require_signed", True) else True
+        if not signed_ok:
+            print("Missing signature for", c); continue
+        ok, reasons = meets_thresholds(ev, policy)
+        cost = estimate_cost(ev)
+        audit = {"ts": datetime.utcnow().isoformat()+"Z", "candidate": c, "model": ev.get("model"), "ok": ok, "reasons": reasons, "cost_est": cost}
+        audit_write(policy.get("audit_log_path","/tmp/autopilot_audit.log"), audit)
+        if cost > policy.get("cost_usd_per_hour", 9999):
+            # create issue to request budget
+            title = f"[AUTOPILOT] Cost exceed for {ev.get('model')}"
+            body = f"Estimated cost {cost} exceeds policy {policy.get('cost_usd_per_hour')}. Eval: {c}"
+            create_issue(args.repo, title, body, ["cost","autopilot"], token)
+            continue
+        risk = ev.get("risk","low")
+        if ok and risk in policy.get("allowed_risks_for_auto", ["low"]):
+            # auto promote
+            payload = {"model": ev.get("model"), "eval": c}
+            dispatched = repo_dispatch(args.repo, "aegis_auto_promote", payload, token)
+            if dispatched:
+                create_issue(args.repo, f"[AUTO-PROMOTED] {ev.get('model')}", f"Auto-promoted by autopilot. Eval: {c}", ["auto-promote","audit"], token)
+        else:
+            title = f"[PROMOTION REQUEST] {ev.get('model')} - manual review required"
+            body = f"Autopilot did not auto-promote. Reasons: {reasons}\nEval file: {c}\nRisk: {risk}"
+            create_issue(args.repo, title, body, ["promotion","needs-review"], token)
+
+if __name__ == "__main__":
+    main()
+
