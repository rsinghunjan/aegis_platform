+#!/usr/bin/env python3
+"""
+Enhanced SME issue creator:
+- Reads SME missing items and proof monitor output to create prioritized GitHub issues.
+- Assigns based on label-to-team mapping file ops/formal/sme_assignees.json (optional).
+"""
+import os
+import json
+import yaml
+import requests
+from pathlib import Path
+
+GITHUB_API = "https://api.github.com"
+
+def read_missing(path="/tmp/sme_missing_items.yml"):
+    p = Path(path)
+    if not p.exists():
+        return []
+    data = yaml.safe_load(p.read_text())
+    return data.get("missing", [])
+
+def read_proof_report(path="/tmp/proof_monitor_report.json"):
+    p = Path(path)
+    if not p.exists():
+        return {}
+    return json.loads(p.read_text())
+
+def load_assignees(path="ops/formal/sme_assignees.json"):
+    p = Path(path)
+    if not p.exists():
+        # default mapping
+        return {"formal-team":"formal-team", "safety-team":"safety-team"}
+    return json.loads(p.read_text())
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def create_issue(repo, title, body, labels, assignees, token):
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    payload = {"title": title, "body": body, "labels": labels}
+    if assignees:
+        payload["assignees"] = assignees
+    r = requests.post(url, json=payload, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        print("Created issue:", r.json().get("html_url"))
+        return True
+    print("Failed to create issue:", r.status_code, r.text)
+    return False
+
+def main():
+    token = os.environ.get("GITHUB_TOKEN")
+    repo = os.environ.get("GITHUB_REPO", "")
+    if not token or not repo:
+        print("GITHUB_TOKEN and GITHUB_REPO required"); return
+    missing = read_missing()
+    proof_report = read_proof_report()
+    assignees_map = load_assignees()
+    for m in missing:
+        iid = m.get("id")
+        issue_type = m.get("issue")
+        title = f"[SME-AUTO] {iid} - {issue_type}"
+        body = f"Automated detection of missing SME/proof item:\n\nID: {iid}\nIssue: {issue_type}\n\nPlease provide SME signoff or proof artifact under ops/formal/onboard_submissions.\n\nProof monitor: {proof_report.get('missing',[])}"
+        labels = ["formal","auto-generated","needs-triage"]
+        # choose assignee heuristically
+        assignee = [assignees_map.get("formal-team")]
+        create_issue(repo, title, body, labels, assignee, token)
+
+if __name__ == "__main__":
+    main()
+
