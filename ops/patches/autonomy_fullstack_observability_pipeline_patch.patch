+def record_inference(req_id: str, model: str, start_ts: float, end_ts: float, tokens:int, verifier_score:float, provenance:list):
+    dur = end_ts - start_ts
+    METRIC_INFER_COUNT.inc()
+    METRIC_INFER_LATENCY.set(dur)
+    METRIC_TOKEN_COUNT.inc(tokens)
+    METRIC_VERIFIER_SCORE.set(verifier_score or 0.0)
