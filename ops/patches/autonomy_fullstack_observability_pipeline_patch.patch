+ROLLBACK_HOOK = os.environ.get("ROLLBACK_HOOK", "")
+
+def deploy_canary(image):
+    # simple kubectl set image pattern
+    subprocess.check_call(["kubectl","-n",NAMESPACE,"set","image","deployment/"+CANARY_DEPLOYMENT,"model="+image])
