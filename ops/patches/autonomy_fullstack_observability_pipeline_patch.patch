+    cur = conn.cursor()
+    cur.execute("""CREATE TABLE IF NOT EXISTS models (
+        id TEXT PRIMARY KEY, name TEXT, version TEXT, created_at REAL, metadata TEXT
+    )""")
+    cur.execute("""CREATE TABLE IF NOT EXISTS datasets (
+        id TEXT PRIMARY KEY, name TEXT, version TEXT, created_at REAL, metadata TEXT
+    )""")
+    cur.execute("""CREATE TABLE IF NOT EXISTS experiments (
+        id TEXT PRIMARY KEY, model_id TEXT, dataset_id TEXT, params TEXT, metrics TEXT, created_at REAL
+    )""")
+    cur.execute("""CREATE TABLE IF NOT EXISTS artifacts (
+        id TEXT PRIMARY KEY, type TEXT, path TEXT, metadata TEXT, created_at REAL
+    )""")
+    conn.commit(); conn.close()
+
+def register_model(id, name, version, metadata):
+    conn = sqlite3.connect(DB_PATH); cur = conn.cursor()
+    cur.execute("INSERT OR REPLACE INTO models (id,name,version,created_at,metadata) VALUES (?,?,?,?,?)",
+                (id,name,version,time.time(),json.dumps(metadata)))
+    conn.commit(); conn.close()
+
+def register_experiment(id, model_id, dataset_id, params, metrics):
+    conn = sqlite3.connect(DB_PATH); cur = conn.cursor()
+    cur.execute("INSERT OR REPLACE INTO experiments (id,model_id,dataset_id,params,metrics,created_at) VALUES (?,?,?,?,?,?)",
+                (id,model_id,dataset_id,json.dumps(params),json.dumps(metrics),time.time()))
