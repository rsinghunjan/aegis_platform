+"""
+Simple capacity planner for raters:
+ - Computes required rater capacity based on backlog, target throughput, and expected SLA
+ - Emits recommended scaling action which can be fed to autoscaler or ops
+"""
+import os, math, requests, json
+
+HUMAN_QUEUE_API = os.environ.get("HUMAN_QUEUE_API", "http://human-queue.safety.svc:80/tasks")
+TARGET_PER_RATER_PER_HOUR = int(os.environ.get("TARGET_PER_RATER_PER_HOUR", "40"))
+
+def get_backlog():
+    try:
+        r = requests.get(HUMAN_QUEUE_API, timeout=10)
+        if r.status_code==200:
+            tasks = r.json()
+            pending = [t for t in tasks if t.get("status") in ("open","claimed")]
+            return len(pending)
+    except Exception:
+        pass
+    return 0
+
+def recommend_replicas():
+    backlog = get_backlog()
+    # assume 1 hour SLA window
+    needed = math.ceil(backlog / TARGET_PER_RATER_PER_HOUR)
+    return max(1, needed)
+
+if __name__=="__main__":
+    print("Recommended replicas:", recommend_replicas())
+
