+"""
+Label distribution drift detector.
+ - Computes distribution over labels (from rater outputs / ground truth) and compares to baseline using JS divergence.
+ - Emits Prometheus metrics and triggers webhook on significant drift.
+"""
+import os, json, time
+import numpy as np
+from prometheus_client import Gauge, start_http_server
+from scipy.stats import entropy
+
+BASELINE_PATH = os.environ.get("LABEL_BASELINE", "/data/label_baseline.json")
+SAMPLES_PATH = os.environ.get("LABEL_SAMPLES", "/data/label_samples.jsonl")
+DRIFT_THRESHOLD = float(os.environ.get("LABEL_DRIFT_THRESHOLD", "0.2"))
+METRIC_LABEL_JS = Gauge("aegis_label_js_divergence", "Jensen-Shannon divergence of label distributions")
+WEBHOOK = os.environ.get("LABEL_DRIFT_WEBHOOK", "")
+
+def load_baseline():
+    if os.path.exists(BASELINE_PATH):
+        return json.load(open(BASELINE_PATH))
+    return {}
+
+def load_samples():
+    counts = {}
+    if os.path.exists(SAMPLES_PATH):
+        for l in open(SAMPLES_PATH):
+            try:
+                j = json.loads(l)
+                lab = j.get("label","unknown")
+                counts[lab]=counts.get(lab,0)+1
+            except Exception:
+                continue
+    return counts
+
+def js_divergence(p, q):
+    # p and q are dicts label->count
+    labels = set(p.keys()) | set(q.keys())
+    P = np.array([p.get(l,0) for l in labels], dtype=float)
+    Q = np.array([q.get(l,0) for l in labels], dtype=float)
+    if P.sum()==0 or Q.sum()==0: return 0.0
+    P/=P.sum(); Q/=Q.sum()
+    M = 0.5*(P+Q)
+    return 0.5*(entropy(P,M)+entropy(Q,M))
+
+def main_loop():
+    start_http_server(int(os.environ.get("LABEL_DRIFT_METRICS_PORT", "9430")))
+    baseline = load_baseline()
+    while True:
+        samples = load_samples()
+        score = js_divergence(baseline, samples)
+        METRIC_LABEL_JS.set(score)
+        if score >= DRIFT_THRESHOLD and WEBHOOK:
+            try:
+                import requests
+                requests.post(WEBHOOK, json={"type":"label_drift","score":score}, timeout=5)
+            except Exception:
+                pass
+        time.sleep(int(os.environ.get("LABEL_DRIFT_POLL", "300")))
+
+if __name__=="__main__":
+    main_loop()
+
