+        gpu = gs[0] if gs else None
+    except Exception:
+        gpu = None
+    ev = {
+        "ts": time.time(),
+        "req_id": req_id,
+        "model": model,
+        "latency_s": dur,
+        "tokens": tokens,
+        "verifier_score": verifier_score,
+        "provenance": provenance,
+        "kwh": kwh,
+        "co2_kg": co2,
+        "gpu": gpu
