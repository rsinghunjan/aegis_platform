+"""
+Simple multi-armed bandit controller (epsilon-greedy) to route traffic among models and learn rewards.
+ - Uses a reward function (e.g., verifier score or user feedback) to adjust weights.
+ - Stores weights in metadata store or in-memory (scaffold).
+"""
+import random, time, json
+
+ARMS = {"student": {"count":0, "score":0.0}, "teacher":{"count":0,"score":0.0}, "quant":{"count":0,"score":0.0}}
+EPSILON = float(__import__("os").environ.get("BANDIT_EPSILON","0.1"))
+
+def choose_arm():
+    if random.random() < EPSILON:
+        return random.choice(list(ARMS.keys()))
+    # choose best average score
+    best = max(ARMS.items(), key=lambda kv: (kv[1]["score"] / (kv[1]["count"]+1e-6)))
+    return best[0]
+
+def update(arm, reward):
+    a = ARMS[arm]
+    a["count"] += 1
+    a["score"] += reward
+
