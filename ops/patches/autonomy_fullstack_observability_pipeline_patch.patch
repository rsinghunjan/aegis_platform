+
+METRIC_INFER_COUNT = Counter("aegis_inference_count_total", "Total inferences")
+METRIC_INFER_LATENCY = Gauge("aegis_inference_latency_seconds", "Inference latency seconds")
+METRIC_INFER_KWH = Counter("aegis_inference_kwh_total", "Total kWh for inference")
+METRIC_INFER_CO2 = Counter("aegis_inference_co2_kg_total", "Total CO2e for inference kg")
+METRIC_TOKEN_COUNT = Counter("aegis_inference_tokens_total", "Total tokens generated")
+METRIC_VERIFIER_SCORE = Gauge("aegis_verifier_score", "Verifier support score (last)")
+
