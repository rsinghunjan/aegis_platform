+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate or create a new KMS key for cosign and wire into k8s & GitHub Actions.
+#
+# Usage:
+#   ./ops/kms/rotate_cosign_kms.sh --create   # create new key (aws cli required)
+#   ./ops/kms/rotate_cosign_kms.sh --set <kms_arn>  # set existing ARN in k8s & GH secrets
+#
+usage(){ echo "usage: $0 [--create] | [--set <kms_arn>]"; exit 2; }
+
+MODE=""
+KMS_ARN=""
+if [ "${1:-}" == "--create" ]; then
+  MODE="create"
+elif [ "${1:-}" == "--set" ]; then
+  MODE="set"
+  KMS_ARN="${2:-}"; if [ -z "$KMS_ARN" ]; then usage; fi
+else
+  usage
+fi
+
+if [ "$MODE" = "create" ]; then
+  echo "Creating a new AWS KMS key (requires aws CLI configured)..."
+  KEY_ID=$(aws kms create-key --description "Cosign key for Aegis (rotated $(date -u +%Y%m%dT%H%M%SZ))" --query KeyMetadata.KeyId --output text)
+  KMS_ARN=$(aws kms describe-key --key-id "$KEY_ID" --query KeyMetadata.Arn --output text)
+  echo "Created key: $KMS_ARN"
+fi
+
+echo "Storing KMS ARN into Kubernetes secret (namespace 'security')..."
+kubectl create namespace security --dry-run=client -o yaml | kubectl apply -f -
+kubectl -n security create secret generic cosign-kms --from-literal=kms_arn="$KMS_ARN" --dry-run=client -o yaml | kubectl apply -f -
+echo "K8s secret security/cosign-kms updated."
+
+if command -v gh >/dev/null 2>&1; then
+  echo "Attempting to update GitHub Actions secret COSIGN_AWS_KMS_KEY_ARN (requires gh auth)"
+  REPO=${GITHUB_REPO:-}
+  if [ -n "$REPO" ]; then
+    gh secret set COSIGN_AWS_KMS_KEY_ARN --body "$KMS_ARN" --repo "$REPO" || echo "Failed to set GH secret via gh CLI; set it manually."
+  else
+    echo "GITHUB_REPO not set; skip updating GH secret. Export GITHUB_REPO=<org/repo> to enable."
+  fi
+else
+  echo "gh CLI not installed; please set COSIGN_AWS_KMS_KEY_ARN in CI manually."
+fi
+
+echo "Rotation complete. Verify by running CI sign/verify workflows."
+
