+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Install cert-manager (if missing), create a Certificate for cosign-admission and populate CA bundle.
+#
+# Usage:
+#   ./ops/certmanager/deploy_cert_manager_and_cert.sh <namespace=admission> <secret_name=cosign-webhook-tls>
+#
+NAMESPACE=${1:-admission}
+SECRET=${2:-cosign-webhook-tls}
+
+echo "Ensure cert-manager is installed..."
+kubectl get deployment -n cert-manager cert-manager >/dev/null 2>&1 || kubectl apply -f https://github.com/cert-manager/cert-manager/releases/latest/download/cert-manager.yaml
+
+echo "Deploy cosign Helm chart if not present (operator should manage helm values)..."
+helm upgrade --install cosign-admission helm/cosign-admission -n "$NAMESPACE" --create-namespace --wait || true
+
+echo "Create Certificate resource for cosign webhook (if chart didn't create it)."
+cat <<EOF | kubectl -n "$NAMESPACE" apply -f -
+apiVersion: cert-manager.io/v1
+kind: Certificate
+metadata:
+  name: cosign-admission-cert
+spec:
+  secretName: ${SECRET}
+  dnsNames:
+  - cosign-admission.${NAMESPACE}.svc
+  issuerRef:
+    name: letsencrypt-prod
+    kind: ClusterIssuer
+EOF
+
+echo "Waiting for certificate secret..."
+for i in $(seq 1 30); do
+  if kubectl -n "$NAMESPACE" get secret "$SECRET" >/dev/null 2>&1; then
+    echo "Secret $SECRET exists"
+    break
+  fi
+  echo "Waiting for certificate issuance... ($i/30)"
+  sleep 10
+done
+
+echo "Populate ValidatingWebhookConfiguration CA bundle..."
+./ops/cosign/populate_ca_bundle.sh "$NAMESPACE" "$SECRET" cosign-validating-webhook || true
+
+echo "Cert-manager & Certificate provisioning complete."
+
