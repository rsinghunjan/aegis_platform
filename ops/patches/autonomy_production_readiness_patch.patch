+#!/usr/bin/env python3
+"""
+Validate wattmeter calibration accuracy and publish a small metric report.
+ - Loads telemetry_calibration.json and sample NVML/wattmeter recent data
+ - Computes mean absolute error and prints result and exits non‑zero if error above threshold
+"""
+import json, sys, os
+import numpy as np
+from prometheus_client import CollectorRegistry, Gauge, push_to_gateway
+
+CALIB_JSON = os.environ.get("WATT_CALIB_OUT", "/data/telemetry_calibration.json")
+NVML_SAMPLE = os.environ.get("NVML_SAMPLE_PATH", "/data/nvml_samples.jsonl")
+WATT_SAMPLE = os.environ.get("WATT_SAMPLE_PATH", "/data/wattmeter_sync.csv")
+THRESH = float(os.environ.get("WATT_CALIB_THRESHOLD_W", "10.0"))
+PUSHGW = os.environ.get("PUSHGATEWAY","")
+
+def load_nvml(path):
+    out=[]
+    if os.path.exists(path):
+        for l in open(path):
+            try:
+                out.append(json.loads(l))
+            except:
+                continue
+    return [x.get("power_w",0.0) for x in out]
+
+def load_watt_csv(path):
+    out=[]
+    if os.path.exists(path):
+        for l in open(path):
+            if not l.strip(): continue
+            t,v = l.strip().split(",")
+            out.append(float(v))
+    return out
+
+def main():
+    if not os.path.exists(CALIB_JSON):
+        print("Calibration JSON not found:", CALIB_JSON); sys.exit(2)
+    calib = json.load(open(CALIB_JSON))
+    nvml = load_nvml(NVML_SAMPLE)
+    watt = load_watt_csv(WATT_SAMPLE)
+    if len(nvml)==0 or len(watt)==0:
+        print("Missing samples for validation"); sys.exit(2)
+    # Apply linear calibration if present
+    scale = float(calib.get("scale",1.0))
+    offset = float(calib.get("offset",0.0))
+    est = [v*scale + offset for v in nvml[:len(watt)]]
+    errors = [abs(e - w) for e,w in zip(est, watt[:len(est)])]
+    mae = float(np.mean(errors))
+    print("MAE (W):", mae, "threshold:", THRESH)
+    if PUSHGW:
+        reg = CollectorRegistry()
+        g = Gauge("aegis_watt_calib_mae_w", "Watt calibration MAE (W)", registry=reg)
+        g.set(mae)
+        push_to_gateway(PUSHGW, job='watt_calib_validation', registry=reg)
+    if mae > THRESH:
+        print("Calibration MAE above threshold, consider re-calibration")
+        sys.exit(3)
+    print("Calibration validation OK")
+
+if __name__=="__main__":
+    main()
+
