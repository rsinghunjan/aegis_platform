+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Local helper to run verifier finetune -> calibrate -> adversarial/fairness -> archive + SME signoff
+#
+# Usage:
+#   ./services/factuality/run_verifier_pipeline.sh --dataset-id <dataset_id> --manifest <manifest_path> --out out/candidate
+#
+MANIFEST=""
+DATASET_ID=""
+OUT_DIR=${OUT_DIR:-out/candidate}
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+
+usage() { echo "Usage: $0 --dataset-id <id> --manifest <path> [--out <out_dir>]"; exit 2; }
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --dataset-id) DATASET_ID="$2"; shift 2;;
+    --manifest) MANIFEST="$2"; shift 2;;
+    --out) OUT_DIR="$2"; shift 2;;
+    *) usage;;
+  esac
+done
+
+if [ -z "$DATASET_ID" ] || [ -z "$MANIFEST" ]; then usage; fi
+
+echo "Check SME dataset approval..."
+STATE=$(curl -sS "${SME_REGISTRY_URL:-http://sme-registry.svc}/datasets/state?dataset_id=${DATASET_ID}" | jq -r .state || echo "unknown")
+if [ "$STATE" != "approved" ]; then
+  echo "Dataset $DATASET_ID is not SME-approved (state=$STATE). Aborting."
+  exit 1
+fi
+
+mkdir -p "$OUT_DIR"
+echo "Running finetune on manifest $MANIFEST -> $OUT_DIR"
+python services/factuality/finetune_domain.py --manifest "$MANIFEST" --out_dir "$OUT_DIR" --seed 42
+
+echo "Calibrating thresholds..."
+python services/factuality/calibrate_and_publish.py --preds "$OUT_DIR/preds.jsonl" --labels "$OUT_DIR/labels.jsonl" || true
+
+echo "Running adversarial tests..."
+python services/ci/adversarial_suite.py || (echo "Adversarial tests failed" && exit 1)
+
+echo "Running fairness checks..."
+python services/ci/fairness_check.py || (echo "Fairness checks failed" && exit 1)
+
+echo "Requesting SME signoff..."
+REQ_ID="verifier_local_$(date -u +%Y%m%dT%H%M%SZ)"
+curl -sS -X POST "${MANUAL_APPROVAL_URL:-http://manual-approval.svc}/request" -H "Content-Type: application/json" -d "{\"request_id\":\"$REQ_ID\",\"user\":\"local-run\",\"reason\":\"SME signoff for verifier candidate\"}"
+echo "Waiting for approval (polling up to 48h)..."
+for i in $(seq 1 576); do
+  sleep 300
+  RES=$(curl -sS "${MANUAL_APPROVAL_URL:-http://manual-approval.svc}/list")
+  echo "$RES" | grep "$REQ_ID" | grep approved && { echo "Approved"; break; }
+done
+RES=$(curl -sS "${MANUAL_APPROVAL_URL:-http://manual-approval.svc}/list")
+echo "$RES" | grep "$REQ_ID" | grep approved || (echo "No SME approval observed; failing" && exit 1)
+
+echo "Archiving artifacts to evidence bucket (if configured)..."
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  aws s3 cp "$OUT_DIR/candidate.tar.gz" "s3://${EVIDENCE_BUCKET}/verifier_local/$(date -u +%Y%m%dT%H%M%SZ)_candidate.tar.gz"
+  aws s3 cp "$OUT_DIR/thresholds.json" "s3://${EVIDENCE_BUCKET}/verifier_local/$(date -u +%Y%m%dT%H%M%SZ)_thresholds.json"
+fi
+
+echo "Verifier pipeline complete and SME-approved."
+
