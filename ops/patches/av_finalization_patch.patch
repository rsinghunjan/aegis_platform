+#!/usr/bin/env python3
+"""
+Collect signed evidence artifacts into a zip bundle and open a PR that contains the traceability matrix and a link to the bundle.
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/certification/create_audit_bundle_and_pr.py --repo owner/repo --evidence-index /tmp/evidence_index.json
+
+Notes:
+ - This script produces /tmp/audit_bundle.zip (local artifact) and creates a branch with ops/certification/traceability_matrix.json (if generated).
+ - It then opens a PR to request a formal audit review.
+"""
+import os
+import argparse
+import json
+import zipfile
+import requests
+import base64
+from datetime import datetime
+
+GITHUB_API = "https://api.github.com"
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def collect_evidence(index_path, out_zip="/tmp/audit_bundle.zip"):
+    if not os.path.exists(index_path):
+        print("Evidence index missing:", index_path); return None
+    idx = json.load(open(index_path))
+    zf = zipfile.ZipFile(out_zip, "w")
+    for e in idx:
+        path = e.get("local_path") or e.get("s3_path")
+        if path and os.path.exists(path):
+            zf.write(path, arcname=os.path.basename(path))
+    zf.close()
+    return out_zip
+
+def create_branch_and_add_file(repo, base, branch, path, content_b64, token, message):
+    # create branch
+    ref = requests.get(f"{GITHUB_API}/repos/{repo}/git/ref/heads/{base}", headers=gh_headers(token)).json()
+    base_sha = ref["object"]["sha"]
+    r = requests.post(f"{GITHUB_API}/repos/{repo}/git/refs", headers=gh_headers(token), json={"ref": f"refs/heads/{branch}", "sha": base_sha})
+    if r.status_code not in (200,201,422):
+        print("Failed to create branch", r.status_code, r.text); return False
+    # create file
+    url = f"{GITHUB_API}/repos/{repo}/contents/{path}"
+    payload = {"message": message, "branch": branch, "content": content_b64}
+    r2 = requests.put(url, headers=gh_headers(token), json=payload)
+    return r2.status_code in (200,201)
+
+def create_pr(repo, head, base, title, body, token):
+    r = requests.post(f"{GITHUB_API}/repos/{repo}/pulls", headers=gh_headers(token), json={"title": title, "head": head, "base": base, "body": body})
+    return r
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    p.add_argument("--evidence-index", default="/tmp/evidence_index.json")
+    p.add_argument("--base", default="main")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required"); return
+    bundle = collect_evidence(args.evidence_index)
+    if not bundle:
+        print("No bundle created; aborting")
+        return
+    # ensure traceability matrix exists
+    tm_path = "/tmp/traceability_matrix.json"
+    if not os.path.exists(tm_path):
+        print("traceability matrix missing at", tm_path)
+    with open(tm_path if os.path.exists(tm_path) else "/tmp/traceability_matrix.json","rb") as fh:
+        content_b64 = base64.b64encode(fh.read()).decode()
+    branch = f"aegis/audit-bundle-{datetime.utcnow().strftime('%Y%m%d%H%M%S')}"
+    target_path = "ops/certification/traceability_matrix.json"
+    ok = create_branch_and_add_file(args.repo, args.base, branch, target_path, content_b64, token, "chore(cert): add traceability matrix for audit bundle")
+    if not ok:
+        print("Failed to add traceability file to new branch")
+    pr = create_pr(args.repo, branch, args.base, "Audit bundle and traceability matrix", "This PR contains the generated traceability matrix and references an audit bundle uploaded to the operator evidence store.", token)
+    if pr.status_code in (200,201):
+        print("Created PR:", pr.json().get("html_url"))
+    else:
+        print("Failed to create PR:", pr.status_code, pr.text)
+
+if __name__ == "__main__":
+    main()
+
