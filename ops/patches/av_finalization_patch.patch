+#!/usr/bin/env python3
+"""
+Create a Pull Request that flips REQUIRE_REAL_HARDWARE to "1" in selected CI workflows.
+
+This script:
+ - Creates a branch off a base branch (default: main)
+ - Updates target workflow files by setting REQUIRE_REAL_HARDWARE to "1" in the env block
+ - Commits the changes and opens a PR for operator review
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/automation/create_flip_hardware_gate_pr.py --repo owner/repo
+
+Notes:
+ - The script uses the GitHub Contents API to fetch and update files.
+ - Review the generated PR before merging; automated edits are best-effort and may need manual adjustments.
+"""
+import os
+import argparse
+import requests
+import base64
+import json
+from datetime import datetime
+
+GITHUB_API = "https://api.github.com"
+
+TARGET_FILES = [
+    ".github/workflows/enforce_hardware_on_push.yml",
+    ".github/workflows/enforce_hardware_protected_branches.yml",
+    ".github/workflows/hardware_real_gate.yml",
+    ".github/workflows/autopilot_strict.yml"
+]
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def get_ref_sha(repo, branch, token):
+    url = f"{GITHUB_API}/repos/{repo}/git/ref/heads/{branch}"
+    r = requests.get(url, headers=gh_headers(token))
+    r.raise_for_status()
+    return r.json()["object"]["sha"]
+
+def create_branch(repo, branch_name, base_sha, token):
+    url = f"{GITHUB_API}/repos/{repo}/git/refs"
+    payload = {"ref": f"refs/heads/{branch_name}", "sha": base_sha}
+    r = requests.post(url, headers=gh_headers(token), json=payload)
+    if r.status_code in (200,201):
+        return True
+    # If branch exists, ignore
+    if r.status_code == 422:
+        return True
+    print("create_branch failed:", r.status_code, r.text)
+    return False
+
+def get_file(repo, path, ref, token):
+    url = f"{GITHUB_API}/repos/{repo}/contents/{path}?ref={ref}"
+    r = requests.get(url, headers=gh_headers(token))
+    if r.status_code == 200:
+        return r.json()
+    return None
+
+def update_file(repo, path, branch, content_b64, sha, message, token):
+    url = f"{GITHUB_API}/repos/{repo}/contents/{path}"
+    payload = {"message": message, "branch": branch, "content": content_b64, "sha": sha}
+    r = requests.put(url, headers=gh_headers(token), json=payload)
+    return r
+
+def set_require_real(content):
+    # naive update: if REQUIRE_REAL_HARDWARE variable present set value to "1"
+    lines = content.splitlines()
+    out = []
+    changed = False
+    for i,l in enumerate(lines):
+        if "REQUIRE_REAL_HARDWARE" in l and ":" in l:
+            # handle YAML env: line like 'REQUIRE_REAL_HARDWARE: ${{ secrets.REQUIRE_REAL_HARDWARE }} # set to "1" to enforce'
+            # replace RHS with "1"
+            prefix = l.split(":",1)[0]
+            out.append(f"{prefix}: \"1\"")
+            changed = True
+            continue
+        out.append(l)
+    if not changed:
+        # add an env block near top: naive insert after name: line
+        for idx,l in enumerate(out):
+            if l.strip().startswith("name:"):
+                insert_at = idx+1
+                break
+        else:
+            insert_at = 0
+        env_block = ["  env:", "    REQUIRE_REAL_HARDWARE: \"1\""]
+        out[insert_at:insert_at] = env_block
+        changed = True
+    return "\n".join(out), changed
+
+def create_pr(repo, head_branch, base_branch, title, body, token):
+    url = f"{GITHUB_API}/repos/{repo}/pulls"
+    payload = {"title": title, "head": head_branch, "base": base_branch, "body": body}
+    r = requests.post(url, headers=gh_headers(token), json=payload)
+    return r
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    p.add_argument("--base", default="main")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required"); return
+    base_sha = get_ref_sha(args.repo, args.base, token)
+    branch_name = f"aegis/flip-hw-gate-{datetime.utcnow().strftime('%Y%m%d%H%M%S')}"
+    if not create_branch(args.repo, branch_name, base_sha, token):
+        print("Failed to create branch"); return
+    modified = []
+    for path in TARGET_FILES:
+        f = get_file(args.repo, path, args.base, token)
+        if not f:
+            print("File not found (skipping):", path); continue
+        decoded = base64.b64decode(f["content"]).decode("utf-8")
+        new_content, changed = set_require_real(decoded)
+        if not changed:
+            print("No change required for", path); continue
+        b64 = base64.b64encode(new_content.encode()).decode()
+        msg = "chore(ci): enforce REQUIRE_REAL_HARDWARE=1 for protected workflows"
+        r = update_file(args.repo, path, branch_name, b64, f["sha"], msg, token)
+        if r.status_code in (200,201):
+            modified.append(path)
+            print("Updated", path)
+        else:
+            print("Failed to update", path, r.status_code, r.text)
+    if not modified:
+        print("No workflows modified; aborting PR creation")
+        return
+    title = "Enforce real hardware gate in protected workflows"
+    body = "This PR enforces REQUIRE_REAL_HARDWARE=1 for selected workflows so CI requires representative hardware to run critical gates. Please review before merge."
+    pr = create_pr(args.repo, branch_name, args.base, title, body, token)
+    if pr.status_code in (200,201):
+        print("Created PR:", pr.json().get("html_url"))
+    else:
+        print("Failed to create PR:", pr.status_code, pr.text)
+
+if __name__ == "__main__":
+    main()
+
