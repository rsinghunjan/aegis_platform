+#!/usr/bin/env python3
+"""
+Create provisioning GitHub issues for representative hardware across device classes.
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/automation/create_hardware_provision_issues_all.py --repo owner/repo
+
+Creates one issue per device family requesting a representative staging node/rack and includes
+acceptance criteria so the provisioning work can be tracked by operators.
+"""
+import os
+import argparse
+import requests
+import json
+
+GITHUB_API = "https://api.github.com"
+
+DEVICES = ["gpu", "lpu", "npu", "qpu", "rt", "hil"]
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def create_issue(repo, title, body, labels, token):
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    r = requests.post(url, json={"title": title, "body": body, "labels": labels}, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        print("Created:", r.json().get("html_url"))
+        return True
+    print("Issue create failed:", r.status_code, r.text)
+    return False
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required in env"); return
+    for d in DEVICES:
+        title = f"[Provision] Representative {d.upper()} staging target required"
+        body = (
+            f"Please provision one representative staging {d} target (node or rack) for early HIL/RT campaigns.\n\n"
+            "Acceptance criteria:\n"
+            "- Node/rack reachable by CI and labeled `aegis/{d}=true`.\n"
+            "- Driver/runtime pinned and validated per `ops/installers/driver_versions.json`.\n"
+            "- Kube access (kubeconfig) or HIL credentials provided to CI secrets (if applicable).\n"
+            "- Run `ops/hil/run_hil_campaign.py` and produce determinism/WCET evidence.\n"
+        )
+        labels = ["onboarding","hardware","high-priority"]
+        create_issue(args.repo, title, body, labels, token)
+
+if __name__ == "__main__":
+    main()
