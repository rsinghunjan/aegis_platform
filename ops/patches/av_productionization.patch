+#!/usr/bin/env python3
+"""
+Scenario generation harness
+
+ - Produces parameterized HIL replay manifests covering corner cases (e.g., occlusion, sensor noise, adversarial)
+ - Writes manifests under ops/hil/playbook/generated/
+ - Produces a coverage report /tmp/scenario_coverage.json counting families produced
+"""
+import os, json
+from pathlib import Path
+from itertools import product
+from datetime import datetime
+
+OUT_DIR = Path("ops/hil/playbook/generated")
+OUT_DIR.mkdir(parents=True, exist_ok=True)
+OUT_REPORT = Path("/tmp/scenario_coverage.json")
+
+FAMILIES = {
+    "occlusion": {"depth":[0.2, 0.5], "duration_s":[1,3]},
+    "sensor_noise": {"noise_std":[0.01,0.05,0.1]},
+    "adversary": {"ped_speed":[1.0,2.5], "angle":[-30,0,30]}
+}
+
+def gen_occlusion(params):
+    name = f"occlusion_d{params['depth']}_t{params['duration_s']}"
+    manifest = {"name": name, "replay":"replays/urban_base.replay", "modifiers":[{"type":"occlusion","depth":params["depth"],"duration_s":params["duration_s"]}]}
+    return name, manifest
+
+def gen_sensor_noise(params):
+    name = f"noise_std{params['noise_std']}"
+    manifest = {"name": name, "replay":"replays/highway.replay", "modifiers":[{"type":"sensor_noise","std":params["noise_std"]}]}
+    return name, manifest
+
+def gen_adversary(params):
+    name = f"adv_speed{params['ped_speed']}_a{params['angle']}"
+    manifest = {"name": name, "replay":"replays/crosswalk.replay", "modifiers":[{"type":"adversary_ped","speed":params["ped_speed"],"angle":params["angle"]}]}
+    return name, manifest
+
+GENERATORS = {"occlusion": gen_occlusion, "sensor_noise": gen_sensor_noise, "adversary": gen_adversary}
+
+def main():
+    produced = []
+    for family, dims in FAMILIES.items():
+        keys = list(dims.keys())
+        values = list(dims.values())
+        for combo in product(*values):
+            params = dict(zip(keys, combo))
+            name, manifest = GENERATORS[family](params)
+            path = OUT_DIR / f"{name}.json"
+            path.write_text(json.dumps(manifest, indent=2))
+            produced.append({"family":family,"name":name,"path":str(path)})
+    OUT_REPORT.write_text(json.dumps({"ts": datetime.utcnow().isoformat()+"Z","produced":produced}, indent=2))
+    print("Wrote scenario coverage to", OUT_REPORT)
+
+if __name__ == "__main__":
+    main()
+
