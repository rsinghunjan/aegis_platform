+#!/usr/bin/env python3
+"""
+Hardened Edge Agent for production AV robots (scaffold)
+
+Features:
+ - TPM attestation (tpm2-tools or fallback)
+ - mTLS for OTA server (client cert configurable)
+ - Vault integration for short-lived credentials
+ - KMS signature verification helper invocation prior to activation
+ - Atomic install and safe activation/rollback hooks
+ - Basic health & watchdog integration
+
+Notes:
+ - This is a scaffold demonstrating integration points. Do not run as-is in production without security review.
+"""
+import os
+import sys
+import time
+import json
+import shutil
+import subprocess
+from pathlib import Path
+from datetime import datetime
+import requests
+
+# Configuration from env
+OTA_SERVER = os.environ.get("AEGIS_OTA_URL", "https://ota.aegis.local")
+MODEL_DIR = Path(os.environ.get("AEGIS_MODEL_DIR", "/opt/aegis/models"))
+WORK_DIR = Path(os.environ.get("AEGIS_WORK_DIR", "/var/lib/aegis"))
+EVIDENCE_DIR = Path(os.environ.get("AEGIS_EVIDENCE_DIR", "/var/lib/aegis/evidence"))
+NODE_ID = os.environ.get("AEGIS_NODE_ID", os.uname().nodename)
+CLIENT_CERT = os.environ.get("AEGIS_OTA_CLIENT_CERT")  # path to client cert
+CLIENT_KEY  = os.environ.get("AEGIS_OTA_CLIENT_KEY")   # path to client key
+CA_BUNDLE   = os.environ.get("AEGIS_OTA_CA_BUNDLE")    # path to CA bundle
+VERIFY_HELPER = Path("ops/governance/kms_verify_helper.py")
+VAULT_HELPER = Path("ops/security/vault_helper.py")
+
+MODEL_DIR.mkdir(parents=True, exist_ok=True)
+WORK_DIR.mkdir(parents=True, exist_ok=True)
+EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)
+
+def log(msg, level="info"):
+    print(f"{datetime.utcnow().isoformat()}Z [{level}] {msg}", flush=True)
+
+def tpm_attest():
+    # Try tpm2-tools: fallback to nonce if not available
+    try:
+        out = subprocess.check_output(["tpm2_getrandom", "16"], text=True).strip()
+        token = {"method": "tpm_getrandom", "value": out, "ts": datetime.utcnow().isoformat()+"Z"}
+        return token
+    except Exception:
+        token = {"method": "local_nonce", "value": str(int(time.time())), "ts": datetime.utcnow().isoformat()+"Z"}
+        return token
+
+def fetch_vault_secrets():
+    # Use vault_helper if available - it writes /tmp/aegis_vault_env.sh
+    try:
+        if VAULT_HELPER.exists():
+            subprocess.check_call(["python", str(VAULT_HELPER)])
+            f = Path("/tmp/aegis_vault_env.sh")
+            if f.exists():
+                for line in f.read_text().splitlines():
+                    if line.startswith("export "):
+                        k,v = line[len("export "):].split("=",1)
+                        os.environ[k] = v.strip("'")
+                log("Loaded secrets from Vault helper")
+                return True
+    except Exception as e:
+        log(f"Vault fetch failed: {e}", level="warn")
+    return False
+
+def mtls_request(url, method="get", json_payload=None, timeout=15):
+    kwargs = {"timeout": timeout, "verify": CA_BUNDLE or True}
+    if CLIENT_CERT and CLIENT_KEY:
+        kwargs["cert"] = (CLIENT_CERT, CLIENT_KEY)
+    if json_payload:
+        r = requests.request(method, url, json=json_payload, **kwargs)
+    else:
+        r = requests.request(method, url, **kwargs)
+    r.raise_for_status()
+    return r
+
+def download_artifact(artifact_url, dest_dir):
+    log(f"Downloading artifact {artifact_url}")
+    r = mtls_request(artifact_url)
+    dest = Path(dest_dir) / Path(artifact_url).name
+    with open(dest, "wb") as fh:
+        fh.write(r.content)
+    return str(dest)
+
+def verify_with_kms(artifact_path):
+    # Delegate to KMS verify helper if present
+    if VERIFY_HELPER.exists():
+        try:
+            subprocess.check_call(["python", str(VERIFY_HELPER), "--file", artifact_path], stdout=subprocess.DEVNULL)
+            log("KMS verification succeeded")
+            return True
+        except Exception as e:
+            log(f"KMS verify failed: {e}", level="error")
+            return False
+    # fallback: require local .sig.b64
+    if Path(artifact_path + ".sig.b64").exists():
+        log("Local signature present (.sig.b64) - accepting per local policy")
+        return True
+    log("No verification method available", level="error")
+    return False
+
+def atomic_activate(artifact_path):
+    # Copy into models dir and swap symlink atomically
+    dest = MODEL_DIR / (Path(artifact_path).name + f".{int(time.time())}")
+    shutil.copy2(artifact_path, dest)
+    cur = MODEL_DIR / "current"
+    tmp_symlink = MODEL_DIR / f"current.tmp.{int(time.time())}"
+    tmp_symlink.symlink_to(dest.name)
+    tmp_symlink.replace(cur)  # atomic on POSIX
+    log(f"Activated model {dest}")
+    # create backup manifest for rollback
+    open(EVIDENCE_DIR / f"activation_{int(time.time())}.json","w").write(json.dumps({"artifact":str(dest),"ts":datetime.utcnow().isoformat()+"Z"}))
+    return True
+
+def watchdog_register():
+    # placeholder: register with a local watchdog or systemd watchdog
+    log("Registering system watchdog (placeholder)")
+
+def check_and_apply():
+    # ask OTA for latest package metadata
+    url = f"{OTA_SERVER.rstrip('/')}/packages/latest?node={NODE_ID}"
+    try:
+        r = mtls_request(url)
+    except Exception as e:
+        log(f"OTA query failed: {e}", level="warn"); return
+    if r.status_code == 204:
+        log("No package available"); return
+    pkg = r.json()
+    artifact_url = pkg.get("artifact_url")
+    if not artifact_url:
+        log("No artifact_url in package"); return
+    local = download_artifact(artifact_url, WORK_DIR)
+    if not verify_with_kms(local):
+        log("Verification failed: rejecting package", level="error"); return
+    # pre-activation checks: driver versions, RT kernel, attestation
+    # driver check: call driver_installer_manager verify
+    try:
+        subprocess.check_call(["python","ops/installers/driver_installer_manager.py"])
+    except Exception as e:
+        log(f"Driver verification failed: {e}", level="error"); return
+    att = tpm_attest()
+    log(f"Attestation token: {att}")
+    if atomic_activate(local):
+        log("Model activated; notify OTA")
+        try:
+            mtls_request(f"{OTA_SERVER.rstrip('/')}/agent/heartbeat", method="post", json_payload={"node":NODE_ID,"event":"activate","artifact":Path(local).name,"ts":datetime.utcnow().isoformat()+"Z"})
+        except Exception:
+            log("Notify OTA failed", level="warn")
+
+def run():
+    watchdog_register()
+    fetch_vault_secrets()
+    while True:
+        try:
+            check_and_apply()
+        except Exception as e:
+            log(f"Error in agent main loop: {e}", level="error")
+        time.sleep(int(os.environ.get("AEGIS_AGENT_POLL", "60")))
+
+if __name__ == "__main__":
+    run()
+
