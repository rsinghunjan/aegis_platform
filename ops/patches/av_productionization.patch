+#!/usr/bin/env python3
+"""
+HIL redundancy and failure-mode test harness
+
+ - Creates HIL campaign manifests for scenarios that simulate sensor loss, compute node failure,
+   and replay corner-case sequences.
+ - Runs campaigns (via ops/hil/run_hil_campaign.py) and collects determinism + WCET evidence.
+ - Produces /tmp/hil_redundancy_report.json summarizing outcomes.
+"""
+import os
+import json
+import subprocess
+from datetime import datetime
+from pathlib import Path
+
+OUT="/tmp/hil_redundancy_report.json"
+
+SCENARIOS = [
+    {"id":"sensor_dropout_lidar","description":"Simulate LiDAR dropout for 5s at t=30s","manifest":"ops/hil/playbook/sensor_dropout_lidar.json"},
+    {"id":"compute_loss_core1","description":"Drop compute core/process to emulate partial failure","manifest":"ops/hil/playbook/compute_loss_core1.json"},
+    {"id":"corner_stopping","description":"Aggressive pedestrian crossing scenario corner-case","manifest":"ops/hil/playbook/corner_stopping.json"}
+]
+
+def run_manifest(manifest, repeats=6):
+    cmd = ["python","ops/hil/run_hil_campaign.py","--manifest",manifest,"--repeats",str(repeats)]
+    try:
+        subprocess.check_call(cmd)
+        # read campaign result
+        if Path("/tmp/hil_campaign_result.json").exists():
+            return json.load(open("/tmp/hil_campaign_result.json"))
+        return {"ok": True, "note": "no detailed summary found"}
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+
+def main():
+    results=[]
+    for s in SCENARIOS:
+        if not Path(s["manifest"]).exists():
+            results.append({"id":s["id"], "ok": False, "error":"manifest_missing"})
+            continue
+        res = run_manifest(s["manifest"], repeats=8)
+        results.append({"id":s["id"], "manifest": s["manifest"], "result": res})
+    report = {"ts": datetime.utcnow().isoformat()+"Z", "results": results}
+    open(OUT,"w").write(json.dumps(report, indent=2))
+    print("Wrote", OUT)
+
+if __name__ == "__main__":
+    main()
+
