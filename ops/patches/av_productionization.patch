+#!/usr/bin/env python3
+"""
+Traceability matrix generator
+
+ - Scans requirements in ops/certification/requirements.json (list of req objects with id and description)
+ - Scans evidence index (/tmp/evidence_index.json or configured path)
+ - Produces a mapping file /tmp/traceability_matrix.json linking requirement -> evidence artifacts
+"""
+import os, json
+from pathlib import Path
+
+REQS_PATH = Path("ops/certification/requirements.json")
+EVIDENCE_INDEX = Path(os.environ.get("AEGIS_EVIDENCE_INDEX", "/tmp/evidence_index.json"))
+OUT = Path("/tmp/traceability_matrix.json")
+
+def load_requirements():
+    if REQS_PATH.exists():
+        return json.load(open(REQS_PATH))
+    return []
+
+def load_evidence():
+    if EVIDENCE_INDEX.exists():
+        return json.load(open(EVIDENCE_INDEX))
+    return []
+
+def main():
+    reqs = load_requirements()
+    evidence = load_evidence()
+    matrix = []
+    for r in reqs:
+        linked = []
+        for e in evidence:
+            tags = e.get("tags", []) or []
+            # simple heuristic: evidence references requirement ids in metadata
+            meta = e.get("meta", {})
+            if r.get("id") in json.dumps(meta) or r.get("id") in json.dumps(e):
+                linked.append(e)
+        matrix.append({"requirement": r, "evidence": linked})
+    OUT.write_text(json.dumps({"ts": datetime.utcnow().isoformat()+"Z", "matrix": matrix}, indent=2))
+    print("Wrote traceability matrix to", OUT)
+
+if __name__ == "__main__":
+    main()
+
