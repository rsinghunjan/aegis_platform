+    import boto3
+    if evidence_bucket:
+        s3 = boto3.client("s3")
+        key = f"baseten/publish-results/{model_name}-{int(time.time())}.json"
+        s3.put_object(Bucket=evidence_bucket, Key=key, Body=json.dumps(res).encode())
+        print("Evidence uploaded to s3://%s/%s" % (evidence_bucket, key))
+except Exception as e:
