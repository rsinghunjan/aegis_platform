+#!/usr/bin/env python3
+"""
+Baseten client helpers (PoC)
+
+- Minimal wrapper around Baseten public API to create deployments from artifacts.
+- Reads API key from AWS Secrets Manager via services.quantum.credentials.secretsmanager_provider.get_secret
+  or from BASSETEN_API_KEY env var for local dev.
+- Uploads evidence of promotion to EVIDENCE_BUCKET (S3) using boto3 when available.
+
+Notes:
+- Baseten API surface may change; adapt the requests payloads to current Baseten spec.
+- In production, run this code from a trusted CI/CD environment with least-privilege credentials.
+"""
+import os
+import time
+import json
+import logging
+from typing import Optional, Dict, Any
+
+logger = logging.getLogger("baseten-client")
+logging.basicConfig(level=logging.INFO)
+
+try:
+    import requests
+except Exception:
+    requests = None
+
+try:
+    from services.quantum.credentials.secretsmanager_provider import get_secret
+except Exception:
+    def get_secret(name: str) -> Optional[str]:
+        return os.environ.get(name.upper())
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def _upload_evidence(prefix: str, payload: Dict[str, Any]) -> Optional[str]:
+    """Upload JSON payload to S3 evidence bucket; returns URI or local path."""
+    data = json.dumps(payload, indent=2)
+    if not EVIDENCE_BUCKET:
+        p = f"/tmp/{prefix.replace('/','_')}-{int(time.time())}.json"
+        with open(p, "w") as f:
+            f.write(data)
+        logger.info("Wrote evidence locally: %s", p)
+        return p
+    try:
+        import boto3
+        s3 = boto3.client("s3")
+        key = f"{prefix}/{int(time.time())}-{int(time.time()*1000)}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=data.encode("utf-8"))
+        uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+        logger.info("Uploaded evidence: %s", uri)
+        return uri
+    except Exception as e:
+        logger.exception("Failed to upload evidence: %s", e)
+        return None
+
+
+class BasetenClient:
+    def __init__(self, api_key_secret_name: Optional[str] = None, api_key_env: Optional[str] = None):
+        self.api_key = None
+        if api_key_secret_name:
+            self.api_key = get_secret(api_key_secret_name)
+        if not self.api_key and api_key_env:
+            self.api_key = os.environ.get(api_key_env)
+        if not self.api_key:
+            # fallback to BASSETEN_API_KEY env
+            self.api_key = os.environ.get("BASSETEN_API_KEY")
+        if not self.api_key:
+            logger.warning("Baseten API key not found; calls will fail if attempted")
+        self.base_url = os.environ.get("BASSETEN_API_URL", "https://api.baseten.co/v1")
+        logger.info("BasetenClient initialized; endpoint=%s", self.base_url)
+
+    def _headers(self):
+        return {"Authorization": f"Bearer {self.api_key}", "Content-Type": "application/json"}
+
+    def create_model(self, name: str, artifact_url: str, metadata: Dict[str, Any] = None) -> Dict[str, Any]:
+        """
+        Create a Baseten model entity (PoC). Returns response dict.
+        """
+        if not requests:
+            raise RuntimeError("requests not available")
+        payload = {
+            "name": name,
+            "artifact": {"url": artifact_url},
+            "metadata": metadata or {}
+        }
+        url = f"{self.base_url}/models"
+        logger.info("Creating Baseten model: %s -> %s", name, url)
+        r = requests.post(url, headers=self._headers(), json=payload, timeout=30)
+        try:
+            r.raise_for_status()
+        except Exception:
+            logger.exception("Baseten create_model failed: %s %s", r.status_code, r.text)
+            raise
+        return r.json()
+
+    def create_deployment(self, model_id: str, deployment_name: str, config: Dict[str, Any] = None) -> Dict[str, Any]:
+        """
+        Create a deployment for a given model_id (PoC).
+        """
+        if not requests:
+            raise RuntimeError("requests not available")
+        payload = {"model": model_id, "name": deployment_name, "config": config or {}}
+        url = f"{self.base_url}/deployments"
+        logger.info("Creating Baseten deployment: model=%s name=%s", model_id, deployment_name)
+        r = requests.post(url, headers=self._headers(), json=payload, timeout=30)
+        try:
+            r.raise_for_status()
+        except Exception:
+            logger.exception("Baseten create_deployment failed: %s %s", r.status_code, r.text)
+            raise
+        return r.json()
+
+    def publish_model_from_s3(self, name: str, s3_artifact_url: str, evidence_meta: Dict[str, Any] = None) -> Dict[str, Any]:
+        """
+        Convenience: create model and deployment from S3 artifact URL, upload evidence and return combined metadata.
+        """
+        evidence = {"action": "publish_to_baseten", "name": name, "artifact": s3_artifact_url, "ts": int(time.time())}
+        if evidence_meta:
+            evidence["meta"] = evidence_meta
+        ev_uri = _upload_evidence("baseten/publish", evidence)
+        # Create model
+        try:
+            model = self.create_model(name=name, artifact_url=s3_artifact_url, metadata={"evidence_uri": ev_uri})
+        except Exception as e:
+            logger.exception("Failed to create model at Baseten: %s", e)
+            raise
+        # Create deployment
+        deployment = self.create_deployment(model_id=model.get("id") or model.get("model_id") or model.get("uuid"), deployment_name=f"{name}-deployment")
+        result = {"model": model, "deployment": deployment, "evidence_uri": ev_uri}
+        _upload_evidence("baseten/publish-result", result)
+        return result
+
