+#!/usr/bin/env python3
+"""
+Annotator used in the model promotion flow.
+ - After a model training job completes, this script fetches the carbon accounting record(s) for the job,
+   writes carbon annotations to the model registry for the model_version, and optionally enforces a budget.
+"""
+import os
+import requests
+import json
+import time
+
+MODEL_REGISTRY_URL = os.environ.get("MODEL_REGISTRY_URL", "")
+CARBON_ACCOUNTING_URL = os.environ.get("CARBON_ACCOUNTING_URL", "http://carbon-accounting.monitoring.svc.cluster.local:8080")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+BUDGETS_PATH = os.environ.get("CARBON_BUDGETS_PATH", "ops/config/carbon_budgets.json")
+
+def load_budgets():
+    if not os.path.exists(BUDGETS_PATH):
+        return {}
+    return json.load(open(BUDGETS_PATH))
+
+def fetch_job_record(job_id):
+    r = requests.get(f"{CARBON_ACCOUNTING_URL}/records/job/{job_id}", timeout=20)
+    if r.status_code == 200:
+        return r.json()
+    return None
+
+def annotate_model(model_name, model_version, kg_co2):
+    if not MODEL_REGISTRY_URL:
+        print("MODEL_REGISTRY_URL not set; skipping annotate")
+        return False
+    body = {"annotations": {"carbon_kg": kg_co2}}
+    try:
+        r = requests.post(f"{MODEL_REGISTRY_URL}/models/{model_name}/versions/{model_version}/annotations", json=body, timeout=10)
+        r.raise_for_status()
+        return True
+    except Exception as e:
+        print("Failed to annotate model:", e)
+        return False
+
+def enforce_budget(model_name, kg_co2):
+    budgets = load_budgets()
+    b = budgets.get(model_name)
+    if not b:
+        return True, None
+    if kg_co2 > b.get("budget_kg", 0):
+        return False, b
+    return True, b
+
+def main():
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--job-id", required=True)
+    p.add_argument("--model-name", required=True)
+    p.add_argument("--model-version", required=True)
+    args = p.parse_args()
+    rec = fetch_job_record(args.job_id)
+    if not rec:
+        print("No accounting record found for job:", args.job_id)
+        return
+    kg = rec.get("kgco2e")
+    ok, budget = enforce_budget(args.model_name, kg)
+    if not ok:
+        print("Budget exceeded for model", args.model_name, "budget:", budget)
+        exit(2)
+    annotated = annotate_model(args.model_name, args.model_version, kg)
+    print("Annotated:", annotated)
+
+if __name__ == "__main__":
+    main()
+
