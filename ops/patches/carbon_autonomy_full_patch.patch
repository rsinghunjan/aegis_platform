+    args = p.parse_args()
+    if not args.pod and not args.job:
+        print("pod or job required")
+        return
+    labels = {}
+    for kv in (args.labels or "").split(","):
+        if not kv.strip(): continue
+        k,v = kv.split("=",1)
+        labels[k]=v
+    try:
+        config.load_kube_config()
+    except Exception:
+        config.load_incluster_config()
+    v1 = client.CoreV1Api()
+    if args.pod:
+        meta = {"metadata":{"labels": labels}}
+        v1.patch_namespaced_pod(args.pod, args.namespace, meta)
+        print("Patched pod", args.pod, labels)
+    else:
+        batch = client.BatchV1Api()
+        body = {"spec":{"template":{"metadata":{"labels": labels}}}}
+        batch.patch_namespaced_job(args.job, args.namespace, body)
