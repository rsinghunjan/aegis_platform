+#!/usr/bin/env python3
+"""
+A simple webhook intended to be used as a Tekton Trigger/Interceptor endpoint.
+ - Tekton (TriggerTemplate) can POST TaskRun-like payloads to this endpoint.
+ - The interceptor consults carbon intensity + budgets and returns a decision:
+    - allow: true/false
+    - mutate: optional modifications (nodeSelector, labels) to prefer low-carbon regions
+"""
+import os
+import requests
+from fastapi import FastAPI, Request
+
+INTENSITY_SERVICE = os.environ.get("INTENSITY_SERVICE_URL", "http://carbon-intensity-service.monitoring.svc.cluster.local:8080")
+CARBON_BUDGETS = os.environ.get("CARBON_BUDGETS_PATH", "ops/config/carbon_budgets.json")
+
+app = FastAPI(title="Tekton Carbon Interceptor")
+
+def choose_low_carbon_region(candidate_regions):
+    best = None
+    for reg in candidate_regions:
+        try:
+            r = requests.get(f"{INTENSITY_SERVICE}/intensity", params={"region": reg}, timeout=3).json()
+            val = r.get("intensity_g_per_kwh", 9999)
+            if best is None or val < best[0]:
+                best = (val, reg)
+        except Exception:
+            continue
+    return best[1] if best else None
+
+@app.post("/intercept")
+async def intercept(req: Request):
+    payload = await req.json()
+    job = payload.get("job", {})
+    regions = job.get("candidate_regions", [])
+    chosen = choose_low_carbon_region(regions)
+    response = {"allow": True, "mutate": {}}
+    if chosen:
+        response["mutate"]["nodeSelector"] = {"aegis.region": chosen}
+    return response
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run("services.carbon.tekton_interceptor:app", host="0.0.0.0", port=8080)
+
