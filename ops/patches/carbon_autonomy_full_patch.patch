+#!/usr/bin/env python3
+"""
+Carbon accounting service.
+ - Queries Prometheus for power metrics for a given job or pod label over a time window
+ - Converts watt-seconds -> kWh and multiplies by carbon intensity (gCO2/kWh) -> kgCO2e
+ - Writes accounting records to evidence bucket (S3) and optionally posts to a model registry endpoint
+ - Exposes HTTP endpoints:
+     POST /account/job  {"promql": "...", "region": "GB", "job_id": "train-123", "start":"<rfc3339>", "end":"<rfc3339>"}
+"""
+import os
+import time
+import json
+import requests
+from fastapi import FastAPI, HTTPException
+from datetime import datetime
+import boto3
+
+PROM_HOST = os.environ.get("PROM_HOST", "http://prometheus.monitoring.svc.cluster.local:9090")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+MODEL_REGISTRY_URL = os.environ.get("MODEL_REGISTRY_URL", "")
+INTENSITY_SERVICE = os.environ.get("INTENSITY_SERVICE_URL", "http://carbon-intensity-service.monitoring.svc.cluster.local:8080")
+
+app = FastAPI(title="Carbon Accounting Service")
+
+def rfc3339_to_ts(s):
+    return int(datetime.fromisoformat(s).timestamp())
+
+def query_prometheus_range(promql, start_ts, end_ts, step="15s"):
+    url = f"{PROM_HOST}/api/v1/query_range"
+    params = {"query": promql, "start": start_ts, "end": end_ts, "step": step}
+    r = requests.get(url, params=params, timeout=30)
+    r.raise_for_status()
+    j = r.json()
+    if j.get("status") != "success":
+        raise RuntimeError("prometheus query failed")
+    return j["data"]["result"]
+
+def integrate_power_to_kwh(series):
+    if len(series) < 2:
+        return 0.0
+    total_ws = 0.0
+    prev_t, prev_v = float(series[0][0]), float(series[0][1])
+    for t, v in series[1:]:
+        t = float(t); v = float(v)
+        dt = t - prev_t
+        area = (prev_v + v) / 2.0 * dt
+        total_ws += area
+        prev_t, prev_v = t, v
+    kwh = total_ws / 3600.0 / 1000.0
+    return kwh
+
+def fetch_intensity(region):
+    try:
+        r = requests.get(f"{INTENSITY_SERVICE}/intensity", params={"region": region}, timeout=10)
+        r.raise_for_status()
+        return float(r.json().get("intensity_g_per_kwh"))
+    except Exception as e:
+        raise RuntimeError(f"could not fetch intensity: {e}")
+
+def upload_evidence(key, payload):
+    if not EVIDENCE_BUCKET:
+        path = f"/tmp/{key}"
+        with open(path, "w") as f:
+            json.dump(payload, f, indent=2)
+        return path
+    s3 = boto3.client("s3")
+    s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode("utf-8"))
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+@app.post("/account/job")
+def account_job(body: dict):
+    promql = body.get("promql")
+    region = body.get("region")
+    job_id = body.get("job_id")
+    start = body.get("start")
+    end = body.get("end")
+    if not all([promql, region, job_id, start, end]):
+        raise HTTPException(status_code=400, detail="missing fields")
+    start_ts = rfc3339_to_ts(start)
+    end_ts = rfc3339_to_ts(end)
+    try:
+        results = query_prometheus_range(promql, start_ts, end_ts)
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"prometheus query failed: {e}")
+    total_kwh = 0.0
+    for r in results:
+        values = r.get("values", [])
+        if not values:
+            continue
+        kwh = integrate_power_to_kwh(values)
+        total_kwh += kwh
+    try:
+        intensity_g = fetch_intensity(region)
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
+    kgco2e = total_kwh * intensity_g / 1000.0
+    rec = {"job_id": job_id, "region": region, "start": start, "end": end, "kwh": total_kwh, "gco2_per_kwh": intensity_g, "kgco2e": kgco2e, "ts": int(time.time())}
+    key = f"carbon_accounting/jobs/{job_id}_{int(time.time())}.json"
+    loc = upload_evidence(key, rec)
+    model = body.get("model_name")
+    if model and MODEL_REGISTRY_URL:
+        try:
+            requests.post(f"{MODEL_REGISTRY_URL}/models/{model}/annotations", json={"carbon_kg": kgco2e, "job": job_id}, timeout=10)
+        except Exception:
+            pass
+    return {"record": rec, "stored_at": loc}
+
+@app.get("/health")
+def health():
+    return {"status":"ok"}
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run("services.carbon.accounting_service:app", host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
