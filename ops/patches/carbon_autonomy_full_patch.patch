+#!/usr/bin/env python3
+"""
+Probe Prometheus for DCGM metric names and produce suggested PromQL templates.
+Run this tool to discover actual metric names and then update ops/promql/job_promql_templates.json accordingly.
+"""
+import os
+import requests
+import json
+
+PROM_HOST = os.environ.get("PROM_HOST", "http://prometheus.monitoring.svc.cluster.local:9090")
+
+def find_metrics(prefixes=("dcgm","dcgm_nvml","nvidia")):
+    url = f"{PROM_HOST}/api/v1/label/__name__/values"
+    r = requests.get(url, timeout=15)
+    r.raise_for_status()
+    names = r.json().get("data", [])
+    matched = [n for n in names if any(n.startswith(p) for p in prefixes)]
+    return matched
+
+def suggest_templates(metrics):
+    templates = {}
+    for m in metrics:
+        base = m.replace(".", "_")
+        templates[f"job_power_avg_{base}"] = f"avg by (job_id) (rate({m}{{job_id=\"{{{{job_id}}}}\"}}[30s]))"
+        templates[f"model_power_sum_{base}"] = f"sum by (model_name) ({m}{{model_name=\"{{{{model_name}}}}\"}})"
+    return templates
+
+if __name__ == "__main__":
+    mets = find_metrics()
+    print("Found metrics (sample):", mets[:20])
+    suggestions = suggest_templates(mets[:20])
+    out = {"suggestions": suggestions, "found": mets}
+    print(json.dumps(out, indent=2))
+
