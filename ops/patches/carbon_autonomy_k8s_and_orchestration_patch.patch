*** Add File:ops/scripts/check_s3_object_lock.sh
+#!/usr/bin/env bash
+set -euo pipefail
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+if [ -z "$EVIDENCE_BUCKET" ]; then
+  echo "EVIDENCE_BUCKET must be set"
+  exit 2
+fi
+if ! command -v aws >/dev/null 2>&1; then
+  echo "aws CLI required"
+  exit 3
+fi
+
+echo "Checking bucket object lock configuration for s3://${EVIDENCE_BUCKET}"
+cfg=$(aws s3api get-bucket-object-lock-configuration --bucket "${EVIDENCE_BUCKET}" 2>/dev/null || true)
+if [ -z "$cfg" ]; then
+  echo "Bucket does not have object lock configuration or you don't have permission to read it."
+  echo "To enable Object Lock, the bucket must be created with --object-lock-enabled-for-bucket."
+  exit 1
+fi
+echo "Object lock config:"
+echo "$cfg"
+echo "Listing recent artifacts (sample):"
+aws s3 ls "s3://${EVIDENCE_BUCKET}/carbon_accounting/jobs/" --recursive | tail -n 10
+echo "Done"
+
