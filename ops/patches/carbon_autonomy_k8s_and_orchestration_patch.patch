+name: Launch Long Runs (dry-run + long-shadow deploy)
+on:
+  workflow_dispatch:
+    inputs:
+      evidence_bucket:
+        required: true
+        description: "S3 evidence bucket name"
+
+jobs:
+  launch:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+      - name: Deploy carbon stack manifests to cluster (kubectl must be configured in runner)
+        run: |
+          kubectl apply -f k8s/manifests/node-labeler-rbac.yaml
+          kubectl apply -f k8s/manifests/node-labeler-deployment.yaml
+          kubectl apply -f k8s/dcgm/dcgm-exporter-daemonset.yaml
+          kubectl apply -f k8s/prometheus/scrape-config-enhanced.yaml || true
+          kubectl apply -f k8s/services/carbon-intensity.yaml
+          kubectl apply -f k8s/services/carbon-accounting.yaml
+          kubectl apply -f k8s/services/carbon-router.yaml
+          kubectl apply -f k8s/services/tekton-interceptor.yaml
+          kubectl apply -f k8s/services/policy-controller.yaml
+          kubectl apply -f k8s/services/long-shadow-daemon.yaml
+          kubectl apply -f k8s/jobs/long-dryrun-job.yaml
+      - name: Wait for deployments
+        run: |
+          kubectl -n monitoring rollout status deploy/carbon-intensity --timeout=120s || true
+          kubectl -n monitoring rollout status deploy/carbon-accounting --timeout=120s || true
+          kubectl -n monitoring rollout status deploy/carbon-router --timeout=120s || true
+      - name: Kick off verification script
+        env:
+          PROM_HOST: ${{ secrets.PROM_HOST }}
+          INTENSITY_URL: http://carbon-intensity-service.monitoring.svc:8080
+          ACCOUNTING_URL: http://carbon-accounting.monitoring.svc:8080
+          EVIDENCE_BUCKET: ${{ github.event.inputs.evidence_bucket }}
+        run: |
