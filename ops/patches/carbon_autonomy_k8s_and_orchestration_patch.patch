+#!/usr/bin/env bash
+set -euo pipefail
+PROM_HOST=${PROM_HOST:-http://prometheus.monitoring.svc:9090}
+echo "1) Check DCGM exporter pods:"
+kubectl -n monitoring get pods -l app=dcgm-exporter -o wide || true
+echo "2) Check node labels (sample):"
+kubectl get nodes --show-labels | grep aegis.region || true
+echo "3) Check carbon services:"
+kubectl -n monitoring get deploy carbon-intensity carbon-accounting carbon-router tekton-interceptor carbon-policy-controller long-shadow || true
+echo "4) Quick Prometheus metric check:"
+curl -s "${PROM_HOST}/api/v1/label/__name__/values" | jq '.data | map(select(test("dcgm|dcgm_nvml|nvidia"))) | .[:20]'
+echo "5) Verify accounting service health:"
+curl -sS http://carbon-accounting.monitoring.svc:8080/health || true
+echo "6) Verify intensity service health:"
+curl -sS http://carbon-intensity-service.monitoring.svc:8080/health || true
+echo "Verification complete."
+
