+#!/usr/bin/env python3
+"""
+Carbon-aware inference router.
+ - Maintains a mapping of region -> endpoint URL (configured via env or file)
+ - For incoming inference request, selects endpoint that:
+    1) Meets specified latency SLA (ms)
+    2) Minimizes current carbon intensity (gCO2/kWh)
+ - Exposes:
+    POST /route  {"model": "...", "latency_sla_ms": 100, "candidates": {"us-east": "...", "eu-west": "..."}}
+    Returns selected endpoint and metadata.
+ - Uses the carbon intensity service to decide and probes endpoints for simple latency checks.
+"""
+import os
+import time
+import requests
+from fastapi import FastAPI, HTTPException
+from typing import Dict
+
+INTENSITY_SERVICE = os.environ.get("INTENSITY_SERVICE_URL", "http://carbon-intensity-service.monitoring.svc.cluster.local:8080")
+HTTP_TIMEOUT = float(os.environ.get("ROUTER_HTTP_TIMEOUT_S", "1.5"))
+
+app = FastAPI(title="Carbon-aware Router")
+
+def probe_latency(endpoint: str) -> float:
+    try:
+        t0 = time.time()
+        r = requests.head(endpoint, timeout=HTTP_TIMEOUT)
+        r.raise_for_status()
+        return (time.time() - t0) * 1000.0
+    except Exception:
+        return float("inf")
+
+def get_intensity(region: str):
+    r = requests.get(f"{INTENSITY_SERVICE}/intensity", params={"region": region}, timeout=5)
+    r.raise_for_status()
+    return float(r.json().get("intensity_g_per_kwh"))
+
+@app.post("/route")
+def route(payload: Dict):
+    """
+    payload: {"model":"m", "latency_sla_ms": 100, "candidates": {"us-east":"https://us.example/generate","eu-west":"https://eu.example/generate"}, "region_map": {"us-east":"US-VA","eu-west":"EU-FR"}}
+    """
+    candidates = payload.get("candidates") or {}
+    region_map = payload.get("region_map") or {}
+    sla = float(payload.get("latency_sla_ms", 200))
+    if not candidates:
+        raise HTTPException(status_code=400, detail="no candidates provided")
+    scores = []
+    for name, url in candidates.items():
+        latency = probe_latency(url)
+        if latency == float("inf"):
+            continue
+        region = region_map.get(name)
+        try:
+            intensity = get_intensity(region) if region else 1000.0
+        except Exception:
+            intensity = 1000.0
+        scores.append({"name": name, "url": url, "latency_ms": latency, "intensity": intensity})
+    # filter by SLA
+    viable = [s for s in scores if s["latency_ms"] <= sla]
+    if not viable:
+        # if none meet SLA, pick lowest latency among all
+        best = min(scores, key=lambda s: s["latency_ms"]) if scores else None
+    else:
+        # choose minimum intensity among viable
+        best = min(viable, key=lambda s: s["intensity"])
+    if not best:
+        raise HTTPException(status_code=503, detail="no candidate endpoints reachable")
+    return {"selected": best, "all": scores}
+
+@app.get("/health")
+def health():
+    return {"status":"ok"}
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run("services.carbon.router:app", host="0.0.0.0", port=int(os.environ.get("PORT","8080")))
+
