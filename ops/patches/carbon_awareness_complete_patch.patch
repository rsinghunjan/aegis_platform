+#!/usr/bin/env python3
+"""
+Helper to push simple accounting metrics to Prometheus Pushgateway (optional).
+"""
+import os
+import requests
+
+PUSHGATEWAY = os.environ.get("PUSHGATEWAY", "")
+
+def push_metric(job, metrics: dict):
+    """
+    metrics: dict of metric_name -> value (float)
+    """
+    if not PUSHGATEWAY:
+        return
+    payload = []
+    for k,v in metrics.items():
+        payload.append(f"{k} {v}")
+    data = "\n".join(payload) + "\n"
+    url = f"{PUSHGATEWAY}/metrics/job/{job}"
+    try:
+        requests.post(url, data=data, timeout=10)
+    except Exception:
+        pass
+
