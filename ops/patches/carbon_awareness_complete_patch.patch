+#!/usr/bin/env python3
+"""
+Carbon intensity microservice.
+ - Fetches marginal carbon intensity from ElectricityMap or WattTime (configurable via env)
+ - Optionally uses cloud provider estimated intensity endpoints (AWS, GCP, Azure) when configured
+ - Exposes:
+    GET /intensity?region=<region>  -> {"region": "...", "intensity_g_per_kwh": 200, "source": "electricitymap"}
+    GET /all -> map of region -> intensity
+ - Caches values for short TTL to avoid rate limits.
+"""
+import os
+import time
+import requests
+from fastapi import FastAPI, HTTPException, Query
+from typing import Optional
+
+app = FastAPI(title="Carbon Intensity Service")
+
+ELEC_API = os.environ.get("ELECTRICITYMAP_API_KEY", "")
+WATTTIME_TOKEN = os.environ.get("WATTTIME_API_TOKEN", "")
+CACHE_TTL = int(os.environ.get("INTENSITY_CACHE_TTL_S", "300"))
+
+# simple in-memory cache: {region: (ts, value, source)}
+cache = {}
+
+def fetch_electricitymap(region: str):
+    if not ELEC_API:
+        raise RuntimeError("ELECTRICITYMAP_API_KEY not configured")
+    url = f"https://api.electricitymap.org/v3/carbon-intensity/latest?zone={region}"
+    headers = {"auth-token": ELEC_API}
+    r = requests.get(url, headers=headers, timeout=10)
+    r.raise_for_status()
+    j = r.json()
+    # electricitymap returns gCO2eq_per_kWh in many shapes; attempt common keys
+    val = j.get("data", {}).get("carbonIntensity")
+    if val is None:
+        val = j.get("carbonIntensity")
+    if val is None:
+        raise RuntimeError("unexpected ElectricityMap response")
+    return float(val)
+
+def fetch_watttime(region: str):
+    if not WATTTIME_TOKEN:
+        raise RuntimeError("WATTTIME_API_TOKEN not configured")
+    # WattTime provides gridmatch endpoints; here we call a generic endpoint placeholder
+    url = f"https://api.watttime.org/api/v2/ba?region={region}"
+    headers = {"Authorization": f"Bearer {WATTTIME_TOKEN}"}
+    r = requests.get(url, headers=headers, timeout=10)
+    r.raise_for_status()
+    j = r.json()
+    # placeholder mapping
+    val = j.get("carbonIntensity", None) or j.get("gCO2_per_kWh")
+    if val is None:
+        raise RuntimeError("unexpected WattTime response")
+    return float(val)
+
+def fetch_cloud_provider(region: str):
+    # Placeholder: cloud provider specific implementations can be added via env
+    # e.g., AWS: use `aws ce get-...` or the Carbon API; here we return None
+    return None
+
+def get_intensity(region: str):
+    now = int(time.time())
+    if region in cache and now - cache[region][0] < CACHE_TTL:
+        return {"region": region, "intensity_g_per_kwh": cache[region][1], "source": cache[region][2], "cached": True}
+    # Try ElectricityMap first, then WattTime, then cloud provider
+    sources = []
+    try:
+        v = fetch_electricitymap(region)
+        cache[region] = (now, v, "electricitymap")
+        return {"region": region, "intensity_g_per_kwh": v, "source": "electricitymap", "cached": False}
+    except Exception:
+        sources.append("electricitymap_failed")
+    try:
+        v = fetch_watttime(region)
+        cache[region] = (now, v, "watttime")
+        return {"region": region, "intensity_g_per_kwh": v, "source": "watttime", "cached": False}
+    except Exception:
+        sources.append("watttime_failed")
+    try:
+        v = fetch_cloud_provider(region)
+        if v:
+            cache[region] = (now, v, "cloud")
+            return {"region": region, "intensity_g_per_kwh": v, "source": "cloud", "cached": False}
+    except Exception:
+        sources.append("cloud_failed")
+    raise HTTPException(status_code=503, detail=f"Could not fetch intensity for {region}. Tried: {sources}")
+
+@app.get("/intensity")
+def intensity(region: str = Query(..., description="Region/zone identifier (e.g., GB, FR, US-CA)")):
+    return get_intensity(region)
+
+@app.get("/all")
+def all_regions(regions: Optional[str] = Query(None, description="Comma-separated list of regions")):
+    if not regions:
+        raise HTTPException(status_code=400, detail="regions param required (comma separated)")
+    out = {}
+    for r in regions.split(","):
+        out[r] = get_intensity(r.strip())
+    return out
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run("services.carbon.intensity_service:app", host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
