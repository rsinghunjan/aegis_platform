+#!/usr/bin/env python3
+"""
+Node labeler that ensures nodes and GPU pods have region/zone and PUE tags.
+ - Reads cloud metadata where available (GCE/AWS) or falls back to node annotations
+ - Labels nodes: aegis.region, aegis.zone, aegis.pue (pue is optional)
+ - Annotates pods with node labels for easier PromQL joins (via pod annotations)
+
+Run as a Deployment with appropriate RBAC to read/write nodes and pods.
+"""
+import os
+import time
+import logging
+from kubernetes import client, config, watch
+
+logging.basicConfig(level=logging.INFO)
+
+DEFAULT_POLL = int(os.environ.get("NODE_LABELER_POLL_S", "300"))
+
+def get_cloud_labels(node):
+    # Try to infer region/zone from existing labels (k8s standard)
+    lbls = node.metadata.labels or {}
+    region = lbls.get("topology.kubernetes.io/region") or lbls.get("failure-domain.beta.kubernetes.io/region")
+    zone = lbls.get("topology.kubernetes.io/zone") or lbls.get("failure-domain.beta.kubernetes.io/zone")
+    # PUE can be provided via node label e.g., aegis/pue=1.2
+    pue = lbls.get("aegis/pue")
+    return region, zone, pue
+
+def label_node(api, node_name, region, zone, pue):
+    patch = {"metadata": {"labels": {}}}
+    if region:
+        patch["metadata"]["labels"]["aegis.region"] = region
+    if zone:
+        patch["metadata"]["labels"]["aegis.zone"] = zone
+    if pue:
+        patch["metadata"]["labels"]["aegis.pue"] = str(pue)
+    try:
+        api.patch_node(node_name, patch)
+        logging.info("Patched node %s with %s", node_name, patch["metadata"]["labels"])
+    except Exception as e:
+        logging.warning("Failed to patch node %s: %s", node_name, e)
+
+def annotate_pods_with_node_labels(api, node_name, labels):
+    # Annotate pods running on the node with aegis.node_region/zone to simplify PromQL joins
+    try:
+        pods = api.list_pod_for_all_namespaces(field_selector=f"spec.nodeName={node_name}").items
+        for p in pods:
+            meta = p.metadata
+            ann = meta.annotations or {}
+            changed = False
+            if "aegis.node_region" not in ann and labels.get("aegis.region"):
+                ann["aegis.node_region"] = labels["aegis.region"]
+                changed = True
+            if "aegis.node_zone" not in ann and labels.get("aegis.zone"):
+                ann["aegis.node_zone"] = labels["aegis.zone"]
+                changed = True
+            if changed:
+                body = {"metadata": {"annotations": ann}}
+                try:
+                    api.patch_namespaced_pod(meta.name, meta.namespace, body)
+                except Exception:
+                    continue
+    except Exception as e:
+        logging.warning("Error annotating pods on %s: %s", node_name, e)
+
+def main_loop():
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    v1 = client.CoreV1Api()
+    while True:
+        nodes = v1.list_node().items
+        for n in nodes:
+            name = n.metadata.name
+            region, zone, pue = get_cloud_labels(n)
+            labels = {}
+            if region:
+                labels["aegis.region"] = region
+            if zone:
+                labels["aegis.zone"] = zone
+            if pue:
+                labels["aegis.pue"] = pue
+            if labels:
+                label_node(v1, name, region, zone, pue)
+                annotate_pods_with_node_labels(v1, name, labels)
+        time.sleep(DEFAULT_POLL)
+
+if __name__ == "__main__":
+    main_loop()
+
