+#!/usr/bin/env python3
+"""
+Periodic policy controller that enforces carbon budgets and triggers mitigations:
+ - Reads ops/config/carbon_budgets.json which lists budgets per team/model
+ - Queries recent emissions (Pushgateway metrics or evidence S3) and if budgets are exceeded:
+     - scale down non-essential deployments
+     - add annotations to new Tekton/Argo tasks to defer them
+     - send alerts via webhook
+
+This is a pragmatic orchestrator to implement automated mitigation actions.
+"""
+import os
+import json
+import time
+import subprocess
+import requests
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+PROM_HOST = os.environ.get("PROM_HOST", "http://prometheus.monitoring.svc.cluster.local:9090")
+ALERT_WEBHOOK = os.environ.get("CARBON_ALERT_WEBHOOK", "")
+BUDGETS_PATH = os.environ.get("CARBON_BUDGETS_PATH", "ops/config/carbon_budgets.json")
+
+def load_budgets():
+    if not os.path.exists(BUDGETS_PATH):
+        return {}
+    return json.load(open(BUDGETS_PATH))
+
+def query_recent_emissions_for_model(model_name, window="30d"):
+    # Prometheus metric carbon_accounting_model_emissions_kg{model="..."}
+    q = f"sum_over_time(carbon_accounting_model_emissions_kg{{model=\"{model_name}\"}}[{window}])"
+    r = requests.get(f"{PROM_HOST}/api/v1/query", params={"query": q}, timeout=30)
+    r.raise_for_status()
+    j = r.json()
+    try:
+        v = float(j["data"]["result"][0]["value"][1])
+    except Exception:
+        v = 0.0
+    return v
+
+def scale_down_deployment(namespace, deployment, factor=0.5):
+    # Use kubectl to scale as a pragmatic approach; in production use API client
+    try:
+        current = subprocess.check_output(["kubectl","-n",namespace,"get","deployment",deployment,"-o","jsonpath={.spec.replicas}"]).decode().strip()
+        cur = int(current)
+        target = max(1, int(cur * factor))
+        subprocess.check_call(["kubectl","-n",namespace,"scale","deployment",deployment,"--replicas="+str(target)])
+        return True
+    except Exception:
+        return False
+
+def run_controller():
+    budgets = load_budgets()
+    for model, info in budgets.items():
+        budget_kg = info.get("budget_kg", 0)
+        recent = query_recent_emissions_for_model(model, window=info.get("window","30d"))
+        if recent > budget_kg:
+            # mitigation: scale down associated deployment(s)
+            deployments = info.get("mitigate_deployments", [])
+            for d in deployments:
+                ns, name = d.split("/",1) if "/" in d else ("default", d)
+                ok = scale_down_deployment(ns, name)
+            # alert
+            if ALERT_WEBHOOK:
+                requests.post(ALERT_WEBHOOK, json={"text": f"Carbon budget exceeded for model {model}: {recent}kg > {budget_kg}kg"}, timeout=5)
+
+if __name__ == "__main__":
+    while True:
+        try:
+            run_controller()
+        except Exception as e:
+            print("policy_controller error", e)
+        time.sleep(int(os.environ.get("POLICY_CONTROLLER_INTERVAL_S", "3600")))
+
