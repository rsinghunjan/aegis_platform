+#!/usr/bin/env python3
+"""
+Resolve PromQL templates for accounting_service.
+ - Loads ops/promql/job_promql_templates.json and renders templates using simple replacement.
+"""
+import os
+import json
+from string import Template
+
+TEMPLATES_PATH = os.environ.get("PROMQL_TEMPLATES", "ops/promql/job_promql_templates.json")
+
+def load_templates():
+    with open(TEMPLATES_PATH) as f:
+        j = json.load(f)
+    return j.get("templates", {})
+
+def render(name, **kwargs):
+    templates = load_templates()
+    if name not in templates:
+        raise KeyError("template not found: " + name)
+    t = Template(templates[name])
+    return t.safe_substitute(**kwargs)
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) > 1:
+        print(render(sys.argv[1], **dict(arg.split("=") for arg in sys.argv[2:])))
+
