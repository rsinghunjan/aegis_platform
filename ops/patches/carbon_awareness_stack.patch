+#!/usr/bin/env python3
+"""
+Simple carbon-aware scheduler helper
+ - Finds Jobs labeled carbon_aware=true and defers them if current carbon intensity above threshold
+ - Deferral implemented by annotating job with aegis/carbon.defer_until and suspending via kubectl patch (suspend=true) if using batch/v1beta1 CronJobs or by adding label for operator manual handling.
+
+This is intentionally lightweight: operators must integrate or replace with a full scheduler-extender for production.
+Environment:
+ - CARBON_ESTIMATOR_URL (required) e.g. http://carbon-estimator.monitoring.svc:8080/intensity
+ - CARBON_THRESHOLD (gCO2e/kWh) default 300
+"""
+import os
+import requests
+import subprocess
+from datetime import datetime, timedelta
+import json
+
+EST_URL = os.environ.get("CARBON_ESTIMATOR_URL", "http://carbon-estimator.monitoring.svc:8080/intensity")
+THRESH = float(os.environ.get("CARBON_THRESHOLD", "300"))
+
+def get_intensity():
+    r = requests.get(EST_URL, timeout=5)
+    j = r.json()
+    return float(j.get("intensity_gCO2e_per_kWh", THRESH))
+
+def find_carbon_jobs():
+    out = subprocess.check_output(["kubectl","get","jobs","--all-namespaces","-o","json"], text=True)
+    j = json.loads(out)
+    jobs = []
+    for item in j.get("items",[]):
+        ms = item["metadata"]
+        labels = ms.get("labels", {})
+        if labels.get("carbon_aware","") == "true":
+            jobs.append({"name": ms["name"], "ns": ms["namespace"], "meta": ms})
+    return jobs
+
+def defer_job(ns, name, until_ts):
+    # annotate job with defer_until
+    patch = {"metadata":{"annotations":{"aegis/carbon.defer_until": until_ts}}}
+    subprocess.check_call(["kubectl","patch","job","-n",ns,name,"-p",json.dumps(patch)])
+    print("Patched job", ns, name, "defer_until", until_ts)
+
+def main():
+    intensity = get_intensity()
+    print("Current intensity", intensity)
+    if intensity <= THRESH:
+        print("Within threshold; nothing to defer")
+        return
+    # defer non-urgent carbon_aware jobs by 1 hour (example)
+    until = (datetime.utcnow() + timedelta(hours=1)).isoformat()+"Z"
+    jobs = find_carbon_jobs()
+    for j in jobs:
+        ns = j["ns"]; name = j["name"]
+        defer_job(ns, name, until)
+
+if __name__=="__main__":
+    main()
+
