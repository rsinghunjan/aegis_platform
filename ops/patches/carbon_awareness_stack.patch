+"""
+Carbon Estimator service
+ - Queries Prometheus for power metrics (GPU/host) aggregated by label (job_id/model/team)
+ - Calls a carbon intensity API (ElectricityMap or cloud provider) to get gCO2e/kWh
+ - Computes energy_kwh and carbon_gco2e and writes estimates into Postgres (carbon_estimates table)
+ - Exposes a small HTTP API for other services to query last estimates and carbon intensity
+
+Environment variables:
+ - PROMETHEUS_URL (required)
+ - DATABASE_URL (required) - Postgres DSN
+ - ELECTRICITYMAP_API_KEY (optional) - if provided used for intensity lookup
+ - REGION (optional) - region code used for intensity API
+ - PORT default 8080
+"""
+import os
+import time
+import json
+import requests
+from datetime import datetime, timedelta
+import psycopg2
+from prometheus_api_client import PrometheusConnect
+
+PROM = os.environ.get("PROMETHEUS_URL", "http://prometheus.monitoring.svc:9090")
+DB_URL = os.environ.get("DATABASE_URL")
+EM_API = os.environ.get("ELECTRICITYMAP_API_KEY")
+REGION = os.environ.get("REGION", "default")
+PORT = int(os.environ.get("PORT", 8080))
+
+pc = PrometheusConnect(url=PROM, disable_ssl=True)
+
+def query_power_by_label(window_minutes=5):
+    """
+    Query Prometheus for average power (watts) per job/model over the last window.
+    Expects exporters to expose metrics named:
+      - nvidia_gpu_power_draw_watts{pod,job_id,model}
+      - host_power_watts{node,job_id,model}
+    Returns list of dicts: [{labels:{...}, avg_watts: float}, ...]
+    """
+    end = datetime.utcnow()
+    start = end - timedelta(minutes=window_minutes)
+    results = {}
+    # GPU power
+    q_gpu = 'avg_over_time(nvidia_gpu_power_draw_watts[{}m])'.format(window_minutes)
+    try:
+        gpu_series = pc.custom_query(q_gpu)
+        for s in gpu_series:
+            labels = s.get("metric", {})
+            value = float(s.get("value")[1]) if s.get("value") else 0.0
+            key = (labels.get("job_id") or labels.get("pod") or "unknown", labels.get("model") or "unknown")
+            results.setdefault(key, 0.0)
+            results[key] += value
+    except Exception:
+        pass
+    # Host power (if available)
+    q_host = 'avg_over_time(host_power_watts[{}m])'.format(window_minutes)
+    try:
+        host_series = pc.custom_query(q_host)
+        for s in host_series:
+            labels = s.get("metric", {})
+            value = float(s.get("value")[1]) if s.get("value") else 0.0
+            key = (labels.get("job_id") or labels.get("pod") or "unknown", labels.get("model") or "unknown")
+            results.setdefault(key, 0.0)
+            results[key] += value
+    except Exception:
+        pass
+    # Convert into list of records
+    recs = []
+    for (job_id, model), avg_watts in results.items():
+        recs.append({"job_id": job_id, "model": model, "avg_watts": avg_watts})
+    return recs
+
+def get_carbon_intensity(region=REGION):
+    """
+    Query ElectricityMap or fallback to a static default intensity (gCO2e/kWh)
+    """
+    if EM_API and region != "default":
+        url = f"https://api.electricitymap.org/v3/carbon-intensity/latest?zone={region}"
+        headers = {"auth-token": EM_API}
+        try:
+            r = requests.get(url, headers=headers, timeout=10)
+            j = r.json()
+            return float(j["data"]["carbonIntensity"]["gCO2eqPerKWh"])
+        except Exception:
+            pass
+    # fallback defaults (gCO2e/kWh)
+    return 400.0
+
+def persist_estimate(conn, artifact_id, job_id, model, energy_kwh, carbon_gco2e, source):
+    cur = conn.cursor()
+    cur.execute("""
+    INSERT INTO carbon_estimates (artifact_id, job_id, model, energy_kwh, carbon_gco2e, source, ts)
+    VALUES (%s,%s,%s,%s,%s,%s,%s)
+    """, (artifact_id, job_id, model, energy_kwh, carbon_gco2e, source, datetime.utcnow()))
+    conn.commit()
+    cur.close()
+
+def run_cycle(window_minutes=5):
+    recs = query_power_by_label(window_minutes=window_minutes)
+    intensity = get_carbon_intensity()
+    conn = None
+    if DB_URL:
+        conn = psycopg2.connect(DB_URL, connect_timeout=5)
+    out = []
+    for r in recs:
+        avg_watts = r["avg_watts"]
+        # energy in this window (kWh) = watts * minutes / 60 / 1000
+        energy_kwh = (avg_watts * window_minutes) / 60.0 / 1000.0
+        carbon_g = energy_kwh * intensity
+        artifact_id = f"{r['job_id']}-{int(time.time())}"
+        if conn:
+            try:
+                persist_estimate(conn, artifact_id, r["job_id"], r["model"], energy_kwh, carbon_g, f"electricitymap|{REGION}")
+            except Exception as e:
+                print("persist failed", e)
+        out.append({"artifact_id": artifact_id, "job_id": r["job_id"], "model": r["model"], "energy_kwh": energy_kwh, "carbon_gco2e": carbon_g})
+    if conn:
+        conn.close()
+    return {"ts": datetime.utcnow().isoformat()+"Z", "intensity_gCO2e_per_kWh": intensity, "estimates": out}
+
+from flask import Flask, jsonify
+app = Flask(__name__)
+
+@app.route("/status")
+def status():
+    return jsonify({"ok": True, "ts": datetime.utcnow().isoformat()+"Z"})
+
+@app.route("/estimate_now")
+def estimate_now():
+    res = run_cycle()
+    return jsonify(res)
+
+@app.route("/intensity")
+def intensity():
+    return jsonify({"intensity_gCO2e_per_kWh": get_carbon_intensity(), "region": REGION})
+
+if __name__ == "__main__":
+    # simple loop mode when run as container; also supports HTTP
+    from threading import Thread
+    def background():
+        while True:
+            try:
+                run_cycle()
+            except Exception as e:
+                print("cycle failed", e)
+            time.sleep(300)
+    Thread(target=background, daemon=True).start()
+    app.run(host="0.0.0.0", port=PORT)
+
