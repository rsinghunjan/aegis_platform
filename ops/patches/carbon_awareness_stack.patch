+#!/usr/bin/env python3
+"""
+Attach the latest carbon estimate to a .prov.json provenance file or artifact record.
+Usage:
+  python ops/provenance/update_prov_with_carbon.py --artifact-id <artifact> --prov /path/to/artifact.prov.json
+This looks up the latest carbon_estimates row for artifact_id and injects energy_kwh/carbon_gco2e into the provenance JSON.
+"""
+import argparse
+import psycopg2
+import json
+import os
+
+DB = os.environ.get("DATABASE_URL")
+
+def lookup_latest(conn, artifact_id):
+    cur = conn.cursor()
+    cur.execute("SELECT energy_kwh, carbon_gco2e, ts FROM carbon_estimates WHERE artifact_id=%s ORDER BY ts DESC LIMIT 1", (artifact_id,))
+    row = cur.fetchone()
+    cur.close()
+    return row
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--artifact-id", required=True)
+    p.add_argument("--prov", required=True)
+    args = p.parse_args()
+    if not DB:
+        print("DATABASE_URL required")
+        return
+    conn = psycopg2.connect(DB)
+    r = lookup_latest(conn, args.artifact_id)
+    if not r:
+        print("No carbon estimate for", args.artifact_id); return
+    energy, carbon, ts = r
+    prov = {}
+    if os.path.exists(args.prov):
+        prov = json.load(open(args.prov))
+    prov["carbon"] = {"energy_kwh": energy, "carbon_gco2e": carbon, "estimated_at": ts.isoformat() if hasattr(ts,"isoformat") else str(ts)}
+    open(args.prov, "w").write(json.dumps(prov, indent=2))
+    print("Updated prov file with carbon info")
+
+if __name__=="__main__":
+    main()
+
