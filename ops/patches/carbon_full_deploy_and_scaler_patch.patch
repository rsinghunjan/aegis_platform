+"""
+Carbon Metrics Exporter v2
+
+- Fetches estimates from Carbon Estimator (/estimate_now or /intensity)
+- Exposes two Prometheus gauges:
+  - aegis_carbon_score (higher means worse / higher intensity)
+  - aegis_carbon_capacity (higher means more capacity to run carbon-sensitive workloads)
+
+This exporter is intended to be scraped by Prometheus and used by KEDA Prometheus scaler.
+ENV:
+ - CARBON_ESTIMATOR_URL (default http://carbon-estimator.carbon.svc:8080/estimate_now)
+ - PORT (default 8000)
+"""
+import os
+import time
+import requests
+from prometheus_client import Gauge, start_http_server
+
+EST_URL = os.environ.get("CARBON_ESTIMATOR_URL", "http://carbon-estimator.carbon.svc:8080/estimate_now")
+PORT = int(os.environ.get("PORT", "8000"))
+
+score_gauge = Gauge('aegis_carbon_score', 'Carbon score derived for scaling (higher is worse)', ['scope'])
+capacity_gauge = Gauge('aegis_carbon_capacity', 'Carbon capacity for scaling (higher is better)', ['scope'])
+
+def fetch_and_update():
+    try:
+        r = requests.get(EST_URL, timeout=10)
+        j = r.json()
+        intensity = float(j.get("intensity_gCO2e_per_kWh", 400.0))
+        # normalize score (0..1) scaling: score = intensity / 1000 (cap)
+        score = max(0.0, min(1.0, intensity / 1000.0))
+        capacity = max(0.0, min(1.0, 1.0 - score))
+        # global scope metric
+        score_gauge.labels(scope="global").set(score)
+        capacity_gauge.labels(scope="global").set(capacity)
+    except Exception as e:
+        print("fetch failed", e)
+
+if __name__ == "__main__":
+    start_http_server(PORT)
+    while True:
+        fetch_and_update()
+        time.sleep(30)
+
