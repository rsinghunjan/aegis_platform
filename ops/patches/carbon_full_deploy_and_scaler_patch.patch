+#!/usr/bin/env python3
+"""
+Carbon Budget Enforcer
+ - Periodically aggregates carbon_estimates per team/project
+ - Compares against configured budgets and takes enforcement action:
+   - creates a GitHub issue to notify owners
+   - optionally patches a ConfigMap / Deployment to disable autopilot or annotate to throttle non-critical jobs
+
+Configuration:
+ - DATABASE_URL env (Postgres)
+ - GITHUB_REPOSITORY env (owner/repo)
+ - GITHUB_TOKEN env for creating issues
+ - BUDGETS_FILE defaults to ops/carbon/carbon_budgets.json
+
+This is a lightweight enforcer; integrate into your autopilot_gatekeeper for production enforcement.
+"""
+import os
+import json
+import psycopg2
+import requests
+from datetime import datetime, timedelta
+
+DB = os.environ.get("DATABASE_URL")
+REPO = os.environ.get("GITHUB_REPOSITORY")
+TOKEN = os.environ.get("GITHUB_TOKEN")
+BUDGETS_FILE = os.environ.get("BUDGETS_FILE", "ops/carbon/carbon_budgets.json")
+
+def gh_headers():
+    return {"Authorization": f"token {TOKEN}", "Accept":"application/vnd.github+json"}
+
+def load_budgets():
+    if not os.path.exists(BUDGETS_FILE):
+        return {}
+    return json.load(open(BUDGETS_FILE))
+
+def aggregate_carbon(conn, since_hours=168):
+    cur = conn.cursor()
+    since = datetime.utcnow() - timedelta(hours=since_hours)
+    cur.execute("""
+    SELECT coalesce(team,'unknown') as team, sum(carbon_gco2e) FROM carbon_estimates
+    WHERE ts >= %s GROUP BY coalesce(team,'unknown')
+    """, (since,))
+    rows = cur.fetchall()
+    cur.close()
+    return {r[0]: float(r[1] or 0.0) for r in rows}
+
+def create_budget_issue(team, used, budget):
+    title = f"[Carbon Budget] {team} exceeded carbon budget"
+    body = f"Team `{team}` used {used:.2f} gCO2e in the window and exceeded budget {budget:.2f} gCO2e.\n\nPlease review and throttle noncritical workloads."
+    r = requests.post(f"https://api.github.com/repos/{REPO}/issues", json={"title":title,"body":body,"labels":["carbon","finance"]}, headers=gh_headers())
+    return r.status_code, r.json().get("html_url")
+
+def annotate_deployments(team):
+    # lightweight enforcement: annotate deployments with aegis/carbon-throttle=true
+    # operator must implement admission controller to act on this annotation or use k8s patching
+    print("Annotate deployments for team", team, "(operator action required)")
+
+def main():
+    if not DB:
+        print("DATABASE_URL required"); return
+    conn = psycopg2.connect(DB)
+    totals = aggregate_carbon(conn)
+    budgets = load_budgets()
+    for team, used in totals.items():
+        budget = budgets.get(team, {}).get("budget_gco2e", None)
+        if budget and used > budget:
+            print(f"Team {team} exceeded budget: {used} > {budget}")
+            if REPO and TOKEN:
+                status, url = create_budget_issue(team, used, budget)
+                print("Created issue:", status, url)
+            annotate_deployments(team)
+    conn.close()
+
+if __name__=="__main__":
+    main()
+
