+"""
+End-to-end carbon stack test (uses mock emitter).
+Run this test after deploying the carbon stack in the 'carbon' namespace.
+
+Prerequisites:
+ - kubectl context pointed at the cluster
+ - carbon stack deployed
+ - DATABASE_URL set so the test can query Postgres
+"""
+import os
+import subprocess
+import time
+import requests
+import psycopg2
+
+NAMESPACE = os.environ.get("NAMESPACE", "carbon")
+EST_HOST = f"http://carbon-estimator.{NAMESPACE}.svc.cluster.local:8080"
+DB = os.environ.get("DATABASE_URL")
+
+def call_estimator():
+    try:
+        r = requests.get(EST_HOST + "/estimate_now", timeout=15)
+        print("Estimator response:", r.status_code, r.json())
+        return True
+    except Exception as e:
+        print("Estimator call failed", e)
+        return False
+
+def check_db():
+    if not DB:
+        print("No DATABASE_URL; skipping DB check")
+        return False
+    conn = psycopg2.connect(DB)
+    cur = conn.cursor()
+    cur.execute("SELECT count(*) FROM carbon_estimates;")
+    c = cur.fetchone()[0]
+    print("carbon_estimates count:", c)
+    cur.close()
+    conn.close()
+    return c > 0
+
+def main():
+    print("Waiting for estimator to be ready...")
+    time.sleep(10)
+    ok = call_estimator()
+    if not ok:
+        print("Estimator call failed; check logs")
+        return 2
+    print("Checking DB for estimates...")
+    if check_db():
+        print("DB check OK")
+        return 0
+    else:
+        print("No estimates found in DB; ensure DB migration run and estimator configured")
+        return 3
+
+if __name__ == "__main__":
+    raise SystemExit(main())
