+"""
+Simple exporter that queries the Carbon Estimator service for a derived 'carbon_score'
+and exposes it as a Prometheus metric for KEDA/Prometheus to scrape.
+
+ENV:
+ - CARBON_ESTIMATOR_URL (default http://carbon-estimator.carbon.svc:8080/estimate_now)
+ - PORT (default 8000)
+"""
+import os
+import time
+import requests
+from prometheus_client import Gauge, start_http_server
+
+EST_URL = os.environ.get("CARBON_ESTIMATOR_URL", "http://carbon-estimator.carbon.svc:8080/estimate_now")
+PORT = int(os.environ.get("PORT", "8000"))
+
+carbon_gauge = Gauge('aegis_carbon_score', 'Carbon score derived for scaling (lower is better)', ['job'])
+
+def fetch_and_update():
+    try:
+        r = requests.get(EST_URL, timeout=10)
+        j = r.json()
+        intensity = j.get("intensity_gCO2e_per_kWh", 400)
+        # derive a simple score between 0..1 where higher means worse (scaled to 0..100)
+        score = float(intensity) / 1000.0
+        # use job "global" for this exporter
+        carbon_gauge.labels(job="global").set(score)
+    except Exception as e:
+        print("fetch failed", e)
+
+if __name__ == "__main__":
+    start_http_server(PORT)
+    while True:
+        fetch_and_update()
+        time.sleep(30)
+
