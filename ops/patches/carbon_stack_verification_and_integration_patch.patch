+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Verify deployed carbon-awareness stack:
+#  - DCGM exporter metrics present in Prometheus
+#  - Intensity service responding and mapping regions
+#  - Accounting service reachable
+#  - Evidence bucket contains recent accounting records
+#
+# Usage:
+#   EVIDENCE_BUCKET=<bucket> PROM_HOST=http://prometheus.monitoring.svc:9090 \
+#     INTENSITY_URL=http://carbon-intensity-service.monitoring.svc:8080 \
+#     ACCOUNTING_URL=http://carbon-accounting.monitoring.svc:8080 \
+#     ./ops/scripts/verify_carbon_stack.sh
+
+PROM_HOST=${PROM_HOST:-http://prometheus.monitoring.svc:9090}
+INTENSITY_URL=${INTENSITY_URL:-http://carbon-intensity-service.monitoring.svc:8080}
+ACCOUNTING_URL=${ACCOUNTING_URL:-http://carbon-accounting.monitoring.svc:8080}
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+
+echo "1) Checking DCGM exporter metrics in Prometheus..."
+resp=$(curl -s "${PROM_HOST}/api/v1/label/__name__/values" || true)
+if echo "${resp}" | grep -q '"dcgm'; then
+  echo "  OK: Found dcgm metrics in Prometheus"
+else
+  echo "  WARNING: No dcgm metrics found. Try querying Prometheus UI for metric names like dcgm_nvml_power_usage_gpu_watts"
+fi
+
+echo "2) Checking intensity service..."
+if curl -fs "${INTENSITY_URL}/health" > /dev/null 2>&1; then
+  echo "  OK: intensity service healthy"
+else
+  echo "  ERROR: intensity service not reachable at ${INTENSITY_URL}"
+fi
+
+echo "  sample intensity for region='GB'..."
+curl -fs "${INTENSITY_URL}/intensity?region=GB" || echo "  could not fetch sample intensity (configure ELECTRICITYMAP_API_KEY or mapping)"
+
+echo "3) Checking accounting service health..."
+if curl -fs "${ACCOUNTING_URL}/health" > /dev/null 2>&1; then
+  echo "  OK: accounting service healthy"
+else
+  echo "  ERROR: accounting service not reachable at ${ACCOUNTING_URL}"
+fi
+
+if [ -n "${EVIDENCE_BUCKET}" ]; then
+  echo "4) Checking evidence bucket for recent accounting records (s3)..."
+  if command -v aws >/dev/null 2>&1; then
+    objs=$(aws s3 ls "s3://${EVIDENCE_BUCKET}/carbon_accounting/jobs/" --recursive --human-readable --summarize | tail -n 10 || true)
+    if [ -n "$objs" ]; then
+      echo "  OK: found recent accounting artifacts:"
+      echo "$objs"
+    else
+      echo "  WARNING: no accounting artifacts found in s3://${EVIDENCE_BUCKET}/carbon_accounting/jobs/"
+    fi
+  else
+    echo "  SKIP: aws CLI not available to check S3"
+  fi
+else
+  echo "4) SKIP: EVIDENCE_BUCKET not set"
+fi
+
+echo "5) Quick PromQL sanity checks (example queries)"
+echo "  - avg by (job_id) (rate(dcgm_nvml_power_usage_gpu_watts[30s]))"
+echo "  Try in Prometheus UI: ${PROM_HOST}/graph"
+
+echo "Verification complete. Address any WARNINGS / ERRORS above."
+
