+#!/usr/bin/env python3
+"""
+Helper to add job_id and model_name labels to a Kubernetes Job/Pod after creation (or to patch existing Pods).
+Usage:
+  python services/ops/label_injector.py --pod mypod-abc --namespace default --labels job_id=train-123,model_name=vision_encoder
+"""
+import argparse
+from kubernetes import client, config
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--pod")
+    p.add_argument("--job")
+    p.add_argument("--namespace", default="default")
+    p.add_argument("--labels", help="comma separated k=v pairs")
+    args = p.parse_args()
+    if not args.pod and not args.job:
+        print("pod or job required")
+        return
+    labels = {}
+    for kv in (args.labels or "").split(","):
+        if not kv.strip(): continue
+        k,v = kv.split("=",1)
+        labels[k]=v
+    try:
+        config.load_kube_config()
+    except Exception:
+        config.load_incluster_config()
+    v1 = client.CoreV1Api()
+    if args.pod:
+        meta = {"metadata":{"labels": labels}}
+        v1.patch_namespaced_pod(args.pod, args.namespace, meta)
+        print("Patched pod", args.pod, labels)
+    else:
+        batch = client.BatchV1Api()
+        # patch job template labels (note: this patches the Job object only)
+        body = {"spec":{"template":{"metadata":{"labels": labels}}}}
+        batch.patch_namespaced_job(args.job, args.namespace, body)
+        print("Patched job", args.job, labels)
+
+if __name__ == "__main__":
+    main()
+
