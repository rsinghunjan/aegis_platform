+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Import Grafana dashboards using HTTP API (requires admin token)
+# Usage:
+#   GRAFANA_URL=https://grafana.example.com GRAFANA_TOKEN=xxx ./ops/scripts/import_grafana_dashboards.sh dashboards/grafana/carbon_dashboard.json
+
+GRAFANA_URL=${GRAFANA_URL:-}
+GRAFANA_TOKEN=${GRAFANA_TOKEN:-}
+if [ -z "$GRAFANA_URL" ] || [ -z "$GRAFANA_TOKEN" ]; then
+  echo "GRAFANA_URL and GRAFANA_TOKEN must be set"
+  exit 2
+fi
+
+for f in "$@"; do
+  echo "Importing $f"
+  dash=$(cat "$f")
+  curl -fsS -X POST "${GRAFANA_URL}/api/dashboards/db" -H "Authorization: Bearer ${GRAFANA_TOKEN}" -H "Content-Type: application/json" -d "{\"dashboard\": $dash, \"overwrite\": true}" || echo "Failed to import $f"
+done
+echo "Done"
+
