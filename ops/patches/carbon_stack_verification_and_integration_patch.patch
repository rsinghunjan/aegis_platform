+#!/usr/bin/env bash
+set -euo pipefail
+# CI helper to enforce carbon budget on model promotion
+# Usage: MODEL_REGISTRY_URL=... CARBON_ACCOUNTING_URL=... ./ops/ci/model_promotion_gate.sh <job-id> <model-name> <model-version>
+JOB_ID=${1:?}
+MODEL_NAME=${2:?}
+MODEL_VERSION=${3:?}
+MODEL_REGISTRY_URL=${MODEL_REGISTRY_URL:-}
+CARBON_ACCOUNTING_URL=${CARBON_ACCOUNTING_URL:-http://carbon-accounting.monitoring.svc:8080}
+
+echo "Fetching accounting record for job ${JOB_ID}..."
+rec=$(curl -fs "${CARBON_ACCOUNTING_URL}/records/job/${JOB_ID}" || true)
+if [ -z "$rec" ]; then
+  echo "No accounting record found; failing gate"
+  exit 2
+fi
+kg=$(echo "$rec" | python -c "import sys,json;print(json.load(sys.stdin).get('kgco2e',0))")
+echo "Job emitted ${kg} kgCO2e"
+
+echo "Annotating model registry..."
+if [ -n "${MODEL_REGISTRY_URL}" ]; then
+  curl -fs -X POST "${MODEL_REGISTRY_URL}/models/${MODEL_NAME}/versions/${MODEL_VERSION}/annotations" -H "Content-Type: application/json" -d "{\"annotations\": {\"carbon_kg\": ${kg}}}" || true
+else
+  echo "MODEL_REGISTRY_URL not set; skipping annotate"
+fi
+
+# Optionally enforce budgets by reading ops/config/carbon_budgets.json
+budget=$(python - <<PY
+import json,sys
+try:
+  b=json.load(open('ops/config/carbon_budgets.json'))
+  print(b.get("${MODEL_NAME}",{}).get("budget_kg",""))
+except Exception:
+  print("")
+PY
+)
+if [ -n "$budget" ]; then
+  echo "Budget for ${MODEL_NAME} is ${budget} kg"
+  awk -v kg="$kg" -v b="$budget" 'BEGIN{ if (kg+0 > b+0) exit 2; exit 0 }'
+fi
+echo "Promotion gate passed"
+
