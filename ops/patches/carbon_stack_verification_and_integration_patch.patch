+#!/usr/bin/env bash
+set -euo pipefail
+# Verify S3 evidence objects and attempt to read object lock/retention metadata when possible
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+if [ -z "${EVIDENCE_BUCKET}" ]; then
+  echo "EVIDENCE_BUCKET not set"
+  exit 1
+fi
+if ! command -v aws >/dev/null 2>&1; then
+  echo "aws CLI required"
+  exit 2
+fi
+
+echo "Listing recent carbon accounting artifacts..."
+aws s3 ls "s3://${EVIDENCE_BUCKET}/carbon_accounting/jobs/" --recursive | tail -n 20
+
+echo "Checking object retention metadata for latest object..."
+latest=$(aws s3 ls "s3://${EVIDENCE_BUCKET}/carbon_accounting/jobs/" --recursive | tail -n 1 | awk '{print $4}')
+if [ -n "$latest" ]; then
+  echo "Latest object: $latest"
+  aws s3api head-object --bucket "${EVIDENCE_BUCKET}" --key "${latest}" --query '{Key:Key,Metadata:Metadata}' || echo "Could not read metadata"
+else
+  echo "No objects found"
+fi
+
+echo "Retention/lock verification complete (best-effort)."
+
