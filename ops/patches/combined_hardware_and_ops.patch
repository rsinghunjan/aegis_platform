+#!/usr/bin/env python3
+"""
+Proof Monitor
+
+- Compares a configured list of high-priority invariants to produced proof artifacts.
+- Emits /tmp/proof_monitor_report.json for SRE/maintainers and can be integrated into alerting.
+
+Config:
+  ops/formal/invariant_registry_high_priority.json (list of ids)
+
+Prover outputs expected at: tests/artifacts/mock_proof/*.proof.json  (CI/prover writes here)
+"""
+import os
+import json
+from pathlib import Path
+
+REGISTRY = Path("ops/formal/invariant_registry_high_priority.json")
+PROOFDIR = Path("tests/artifacts/mock_proof")
+OUT = Path("/tmp/proof_monitor_report.json")
+
+def load_registry():
+    if not REGISTRY.exists():
+        return []
+    return json.loads(REGISTRY.read_text())
+
+def discovered_proofs():
+    return [p.stem.replace(".proof","") for p in PROOFDIR.glob("*.proof.json")]
+
+def main():
+    registry = load_registry()
+    proofs = discovered_proofs()
+    missing = [inv for inv in registry if inv not in proofs]
+    report = {"ts": __import__("datetime").datetime.utcnow().isoformat()+"Z", "registered": registry, "found_proofs": proofs, "missing": missing}
+    OUT.write_text(json.dumps(report, indent=2))
+    print("Wrote proof monitor report to", OUT)
+
+if __name__ == "__main__":
+    main()
+
