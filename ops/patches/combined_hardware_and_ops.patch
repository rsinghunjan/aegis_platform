+#!/usr/bin/env python3
+"""
+Vault / Secret Checker
+
+- Verifies required secrets are present in environment or HashiCorp Vault.
+- Writes diagnostics to /tmp/secret_check.json
+- If REQUIRE_SECRETS=1 and any required secret is missing, exits non-zero (fail CI).
+
+Config:
+  Provide a newline-separated file ops/security/required_secrets.txt listing names to check,
+  or pass --secrets "A,B,C".
+
+Vault:
+  If VAULT_ADDR and VAULT_TOKEN env vars are present, attempts to read secrets from Vault KV v2 at secret/data/<name>
+"""
+import os, sys, json, argparse
+
+OUT="/tmp/secret_check.json"
+
+def check_env(name):
+    return os.environ.get(name) is not None
+
+def check_vault(name):
+    # lightweight: call vault CLI if present
+    if os.environ.get("VAULT_ADDR") and os.environ.get("VAULT_TOKEN") and shutil_which("vault"):
+        try:
+            import subprocess
+            subprocess.check_call(["vault","kv","get","-field=value",f"secret/{name}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            return True
+        except Exception:
+            return False
+    return False
+
+def shutil_which(cmd):
+    from shutil import which
+    return which(cmd)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--secrets", default=None, help="Comma-separated list of secret names")
+    args = p.parse_args()
+    secrets = []
+    if args.secrets:
+        secrets = [s.strip() for s in args.secrets.split(",")]
+    else:
+        path = "ops/security/required_secrets.txt"
+        if os.path.exists(path):
+            secrets = [l.strip() for l in open(path) if l.strip()]
+    results = {}
+    for s in secrets:
+        ok_env = check_env(s)
+        ok_vault = check_vault(s)
+        results[s] = {"env": ok_env, "vault": ok_vault, "present": ok_env or ok_vault}
+    open(OUT,"w").write(json.dumps({"results": results, "require": os.environ.get("REQUIRE_SECRETS","0")}, indent=2))
+    print("Wrote secret diagnostics to", OUT)
+    if os.environ.get("REQUIRE_SECRETS") == "1" and any(not r["present"] for r in results.values()):
+        print("Missing required secrets and REQUIRE_SECRETS=1 -> failing")
+        sys.exit(2)
+    sys.exit(0)
+
+if __name__ == "__main__":
+    main()
+
