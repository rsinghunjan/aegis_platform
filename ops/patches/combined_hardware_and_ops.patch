+#!/usr/bin/env python3
+"""
+SME Workflow Manager
+
+- Ensures SMT submissions have SME signoff and (where required) associated proof artifacts.
+- Creates a small issues file (YAML) for missing signoffs/proofs to drive SME/maintainer work.
+- Designed to run in CI nightly or on-demand to track outstanding items.
+
+Output: /tmp/sme_missing_items.yml
+"""
+import os
+import glob
+import json
+import yaml
+from pathlib import Path
+
+ONBOARD_DIR = Path("ops/formal/onboard_submissions")
+PROOFS_DIR = Path("tests/artifacts/mock_proof")  # CI/prover outputs in real runs
+OUT = Path("/tmp/sme_missing_items.yml")
+
+def load_submissions():
+    subs = []
+    for smt in ONBOARD_DIR.glob("*.smt2"):
+        id = smt.stem
+        meta = {}
+        meta_path = ONBOARD_DIR / f"{id}.meta.json"
+        if meta_path.exists():
+            try:
+                meta = json.loads(meta_path.read_text())
+            except Exception:
+                meta = {}
+        subs.append({"id": id, "smt": str(smt), "meta": meta})
+    return subs
+
+def has_proof(id):
+    p = PROOFS_DIR / f"{id}.proof.json"
+    return p.exists()
+
+def require_sme(meta):
+    return meta.get("priority","").lower() == "high" or meta.get("sme_required", False)
+
+def main():
+    subs = load_submissions()
+    missing = []
+    for s in subs:
+        id = s["id"]
+        meta = s["meta"]
+        sme_signed = meta.get("sme_approved", False)
+        proof_exists = has_proof(id)
+        if require_sme(meta) and not sme_signed:
+            missing.append({"id": id, "issue": "missing_sme_signoff"})
+        if meta.get("priority","").lower() == "high" and not proof_exists:
+            missing.append({"id": id, "issue": "missing_proof"})
+    out = {"timestamp": __import__("datetime").datetime.utcnow().isoformat()+"Z", "missing": missing}
+    OUT.write_text(yaml.dump(out))
+    print("Wrote SME missing items to", OUT)
+
+if __name__ == "__main__":
+    main()
+
