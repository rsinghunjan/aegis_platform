+#!/usr/bin/env python3
+"""
+AWS Billing Reconcile Skeleton
+
+- Connects to AWS Cost Explorer and returns summarized costs for a given time window.
+- Intended to be extended to map job_ids and tags to costs for reconciliation.
+
+Environment:
+  AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (or assume role via OIDC)
+"""
+import os
+import boto3
+from datetime import datetime, timedelta
+import json
+
+def query_costs(days=7):
+    client = boto3.client("ce", region_name=os.environ.get("AWS_REGION"))
+    end = datetime.utcnow().date()
+    start = end - timedelta(days=days)
+    resp = client.get_cost_and_usage(
+        TimePeriod={"Start": start.isoformat(), "End": end.isoformat()},
+        Granularity="DAILY",
+        Metrics=["UnblendedCost"]
+    )
+    return resp
+
+def summarize(resp):
+    # Simplified
+    summary = []
+    for r in resp.get("ResultsByTime",[]):
+        summary.append({"timePeriod": r.get("TimePeriod"), "total": r.get("Total")})
+    return summary
+
+if __name__ == "__main__":
+    out = query_costs(7)
+    print(json.dumps(summarize(out), indent=2))
