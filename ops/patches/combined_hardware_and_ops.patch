+#!/usr/bin/env python3
+"""
+Quantization Statistical Validator
+
+- Compare baseline (float) outputs against compiled/quantized (LPU/NPU/TPU) outputs across a test set.
+- Computes mean absolute error, max error and simple KS-test-like check (if scipy available).
+- Produces a JSON report at /tmp/quant_validation_report.json
+
+Usage:
+  python ops/tests/quantization/statistical_quant_test.py --baseline baseline.jsonl --quant quant.jsonl --tol 1e-2
+"""
+import argparse, json, math, sys
+from statistics import mean
+OUT="/tmp/quant_validation_report.json"
+
+def load_jsonl(p):
+    with open(p) as fh:
+        return [json.loads(l) for l in fh]
+
+def compare(baseline, quant, tol=1e-2):
+    if len(baseline) != len(quant):
+        return {"ok": False, "reason": "length_mismatch", "baseline_len": len(baseline), "quant_len": len(quant)}
+    errors = []
+    for a,b in zip(baseline, quant):
+        # flatten numeric outputs
+        for k,v in a.items():
+            if isinstance(v, (int,float)):
+                qv = b.get(k, 0.0)
+                errors.append(abs(v - qv))
+    if not errors:
+        return {"ok": True, "reason": "no_numeric_outputs"}
+    report = {"count": len(errors), "mean_abs_error": mean(errors), "max_error": max(errors)}
+    report["ok"] = report["mean_abs_error"] <= tol
+    return report
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--baseline", required=True)
+    p.add_argument("--quant", required=True)
+    p.add_argument("--tol", type=float, default=1e-2)
+    args = p.parse_args()
+    base = load_jsonl(args.baseline)
+    q = load_jsonl(args.quant)
+    report = compare(base, q, args.tol)
+    json.dump(report, open(OUT,"w"), indent=2)
+    print("Wrote quantization report to", OUT)
+    if not report.get("ok"):
+        sys.exit(2)
+
+if __name__ == "__main__":
+    main()
+
