+#!/usr/bin/env python3
+"""
+Hardware & Credential Hard Gate for CI
+
+- Ensures real hardware / cloud creds are present before allowing "real" hardware CI steps.
+- If REQUIRE_REAL_HARDWARE=1 is set in CI, this script will fail the job when any required device/credential is missing.
+- Writes a small diagnostics JSON to /tmp/hardware_hard_gate.json for operator triage.
+
+Usage:
+  python ops/ci/hardware_hard_gate.py --require acme_hil,gpu,tpu,qpu,lpu
+
+Environment:
+  - ACME_HIL_URL / ACME_HIL_TOKEN for HIL
+  - KUBECONFIG for cluster checks
+  - IONQ_API_KEY (or other QPU keys)
+  - GCP_PROJECT (or gcloud configured) for TPU checks
+  - REQUIRE_REAL_HARDWARE=1 to make missing hardware a hard CI failure
+"""
+import os
+import sys
+import argparse
+import subprocess
+import json
+
+OUT = "/tmp/hardware_hard_gate.json"
+
+def check_hil():
+    url = os.environ.get("ACME_HIL_URL")
+    token = os.environ.get("ACME_HIL_TOKEN")
+    if url and token:
+        return True, "ACME credentials present"
+    return False, "ACME_HIL_URL/ACME_HIL_TOKEN missing"
+
+def check_gpu():
+    try:
+        out = subprocess.check_output(["kubectl","get","nodes","-l","aegis/gpu=true","-o","name"], text=True)
+        found = any(l.strip() for l in out.splitlines())
+        return found, "GPU nodes found" if found else "No nodes labeled aegis/gpu=true"
+    except Exception as e:
+        return False, f"kubectl/gpu check failed: {e}"
+
+def check_tpu():
+    # soft check via gcloud presence
+    if os.environ.get("GCP_PROJECT") or shutil_which("gcloud"):
+        try:
+            subprocess.check_call(["gcloud","compute","tpus","tpu-vm","list"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            return True, "gcloud TPU list succeeded"
+        except Exception:
+            return False, "gcloud present but TPU list failed or no TPUs"
+    return False, "GCP_PROJECT/gcloud not configured"
+
+def check_qpu():
+    # example IonQ env
+    if os.environ.get("IONQ_API_KEY"):
+        return True, "IonQ API key present"
+    # check other QPU providers here...
+    return False, "No QPU API keys present"
+
+def check_lpu():
+    try:
+        out = subprocess.check_output(["kubectl","get","nodes","-l","aegis/lpu=generic","-o","name"], text=True)
+        found = any(l.strip() for l in out.splitlines())
+        return found, "LPU nodes found" if found else "No nodes labeled aegis/lpu=generic"
+    except Exception as e:
+        return False, f"kubectl/lpu check failed: {e}"
+
+def shutil_which(cmd):
+    from shutil import which
+    return which(cmd)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--require", default="", help="Comma-separated list of checks to perform (acme_hil,gpu,tpu,qpu,lpu)")
+    args = p.parse_args()
+    reqs = [r.strip() for r in args.require.split(",") if r.strip()]
+    results = {}
+    exit_code = 0
+    for r in reqs:
+        if r == "acme_hil":
+            ok,msg = check_hil()
+        elif r == "gpu":
+            ok,msg = check_gpu()
+        elif r == "tpu":
+            ok,msg = check_tpu()
+        elif r == "qpu":
+            ok,msg = check_qpu()
+        elif r == "lpu":
+            ok,msg = check_lpu()
+        else:
+            ok,msg = False,"unknown check"
+        results[r] = {"ok": bool(ok), "message": str(msg)}
+        if os.environ.get("REQUIRE_REAL_HARDWARE") == "1" and not ok:
+            exit_code = 2
+    # write diagnostics
+    with open(OUT,"w") as fh:
+        json.dump({"results": results, "require_real": os.environ.get("REQUIRE_REAL_HARDWARE","0")}, fh, indent=2)
+    print("Diagnostics written to", OUT)
+    for k,v in results.items():
+        print(f"{k}: {v['ok']} - {v['message']}")
+    if exit_code != 0:
+        print("REQUIRE_REAL_HARDWARE=1 and one or more checks failed -> failing CI")
+    sys.exit(exit_code)
+
+if __name__ == "__main__":
+    main()
+
