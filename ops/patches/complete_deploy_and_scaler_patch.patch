+"""
+KEDA External Scaler Stub (HTTP metric endpoint)
+
+This is NOT a full KEDA External Scaler implementation. It provides a simple HTTP endpoint
+that returns a JSON metric derived from the Carbon Estimator. Use it as a bridge or testing adapter.
+"""
+import os
+import requests
+from flask import Flask, jsonify
+
+EST_URL = os.environ.get("CARBON_ESTIMATOR_URL", "http://carbon-estimator.carbon.svc:8080/estimate_now")
+app = Flask(__name__)
+
+@app.route("/metric")
+def metric():
+    try:
+        r = requests.get(EST_URL, timeout=5)
+        j = r.json()
+        intensity = float(j.get("intensity_gCO2e_per_kWh", 400.0))
+        # Produce a metric where higher value indicates more carbon intensity
+        metric_value = intensity
+        return jsonify({"metric": metric_value})
+    except Exception as e:
+        return jsonify({"error": str(e)}), 500
+
+@app.route("/health")
+def health():
+    return jsonify({"ok": True})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8081")))
+
