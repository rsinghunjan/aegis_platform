+#!/usr/bin/env bash
+set -euo pipefail
+#
+# One-click deploy helper for Aegis carbon stack (staging)
+#
+# Usage:
+#   DOCKER_REGISTRY=ghcr.io/yourorg DATABASE_URL=postgresql://... ELECTRICITYMAP_API_KEY=key \
+#     GITHUB_TOKEN=ghp_xxx ./scripts/one_click_deploy.sh
+#
+REGISTRY="${DOCKER_REGISTRY:-localhost:5000}"
+echo "Using registry: $REGISTRY"
+
+echo "Building images..."
+docker build -t "${REGISTRY}/aegis/carbon-estimator:latest" services/carbon_estimator
+docker build -t "${REGISTRY}/aegis/carbon-metrics-exporter:latest" services/carbon_metrics_exporter_v2
+docker build -t "${REGISTRY}/aegis/carbon-budget-enforcer:latest" services/carbon_budget_enforcer
+
+echo "Pushing images..."
+docker push "${REGISTRY}/aegis/carbon-estimator:latest"
+docker push "${REGISTRY}/aegis/carbon-metrics-exporter:latest"
+docker push "${REGISTRY}/aegis/carbon-budget-enforcer:latest"
+
+echo "Creating k8s secrets (overwrites if present)..."
+kubectl create namespace carbon --dry-run=client -o yaml | kubectl apply -f -
+kubectl create secret generic aegis-db-secret --from-literal=DATABASE_URL="${DATABASE_URL:-}" -n carbon --dry-run=client -o yaml | kubectl apply -f -
+kubectl create secret generic aegis-secrets --from-literal=ELECTRICITYMAP_API_KEY="${ELECTRICITYMAP_API_KEY:-}" --from-literal=GITHUB_TOKEN="${GITHUB_TOKEN:-}" -n carbon --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Applying manifests via kustomize..."
+kustomize build deploy | kubectl apply -f -
+
+echo "Run DB migration (operator-run):"
+echo "  psql \"${DATABASE_URL}\" -f ops/db/migrations/0001_create_carbon_estimates.sql"
+
+echo
+echo "Prometheus: add scrape targets for mock-power-emitter:9104, dcgm-exporter:9400, and carbon-metrics-exporter:8000"
+echo "Then reload Prometheus or apply new config."
+
+echo
+echo "Import Grafana dashboards (see scripts/import_grafana_dashboard.sh)"
+echo "Smoke test: scripts/test_carbon_stack.sh"
+
