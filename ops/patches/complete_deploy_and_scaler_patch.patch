+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Worker post-job provenance hook
+# Should be called after a job completes and artifact provenance file exists.
+#
+# Usage:
+#   PROV_PATH=/path/to/artifact.prov.json ARTIFACT_ID=myjob-123 DATABASE_URL=... ./services/worker_hooks/prov_hook.sh
+#
+if [ -z "${PROV_PATH:-}" ] || [ -z "${ARTIFACT_ID:-}" ]; then
+  echo "Require PROV_PATH and ARTIFACT_ID env vars"
+  exit 2
+fi
+
+if [ -z "${DATABASE_URL:-}" ]; then
+  echo "DATABASE_URL required to lookup carbon estimates (set in env or via secret)"
+fi
+
+echo "Looking up latest carbon estimate for artifact ${ARTIFACT_ID} and injecting into ${PROV_PATH}"
+export DATABASE_URL="${DATABASE_URL:-}"
+python ops/provenance/update_prov_with_carbon.py --artifact-id "${ARTIFACT_ID}" --prov "${PROV_PATH}" || {
+  echo "Provenance update failed; proceed without carbon in prov"
+}
+
+echo "Done"
