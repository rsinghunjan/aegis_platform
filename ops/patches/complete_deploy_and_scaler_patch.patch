+API_KEY="${GRAFANA_API_KEY:-}"
+
+if [ -z "$API_KEY" ]; then
+  echo "GRAFANA_API_KEY required (set env)"
+  exit 2
+fi
+
+echo "Posting dashboard $FILE to $GRAFANA"
+curl -s -H "Content-Type: application/json" -H "Authorization: Bearer ${API_KEY}" \
+  -X POST "${GRAFANA}/api/dashboards/db" \
+  --data-binary "@${FILE}" | jq .
+
