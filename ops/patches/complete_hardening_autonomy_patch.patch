+#!/usr/bin/env python3
+"""
+Orchestrates a long-duration shadow campaign.
+ - Runs a continuous shadow proxy/daemon for a specified number of days (by default 30).
+ - Periodically aggregates reports via shadow_aggregator and uploads daily summaries to EVIDENCE_BUCKET.
+ - After the campaign ends, invokes SME signoff orchestration (prints instructions for human SME).
+
+This is a coordinator script: in production, deploy long_shadow_daemon as a Deployment and run aggregator as CronWorkflow.
+"""
+import os, time, subprocess, json
+from datetime import datetime, timedelta
+
+CAMPAIGN_DAYS = int(os.environ.get("LONG_SHADOW_DAYS", "30"))
+AGG_INTERVAL_HOURS = int(os.environ.get("LONG_SHADOW_AGG_INTERVAL_HOURS", "24"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def run_aggregator():
+    subprocess.check_call(["python","services/generative/shadow_aggregator.py","--window-hours", "24","--out","/tmp/shadow_daily.json"])
+    if EVIDENCE_BUCKET:
+        subprocess.check_call(["aws","s3","cp","/tmp/shadow_daily.json", f"s3://{EVIDENCE_BUCKET}/gen_shadow_reports/{datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')}_daily.json"])
+
+def main():
+    start = datetime.utcnow()
+    end = start + timedelta(days=CAMPAIGN_DAYS)
+    print(f"Starting long-shadow campaign from {start} to {end}")
+    # Recommend operator ensures long_shadow_daemon is running in cluster
+    while datetime.utcnow() < end:
+        run_aggregator()
+        time.sleep(AGG_INTERVAL_HOURS * 3600)
+    # Final aggregation
+    run_aggregator()
+    # After campaign, print SME signoff instructions
+    print("Long-shadow campaign completed. Please run SME signoff for verifier thresholds:")
+    print("  python services/factuality/sme_signoff.py --sme <SME_NAME> --thresholds out/calib/thresholds.json --notes '30-day shadow campaign review'")
+
+if __name__=="__main__":
+    main()
+
