+#!/usr/bin/env python3
+"""
+Basic k8s adapter utilities used by wrappers.
+ - set_image, scale_deployment, get_deployment_replicas, get_deployment_status
+ - For production, replace with proper client-go/pykube implementations and RBAC principles.
+"""
+import subprocess, json
+
+def run_cmd(cmd):
+    return subprocess.check_output(cmd).decode("utf-8")
+
+def set_image(namespace, deployment, image):
+    subprocess.check_call(["kubectl","-n",namespace,"set","image","deployment/"+deployment, f"{deployment}={image}"])
+    return {"status":"ok","image":image}
+
+def scale_deployment(namespace, deployment, replicas):
+    subprocess.check_call(["kubectl","-n",namespace,"scale","deployment",deployment,"--replicas="+str(replicas)])
+    return {"status":"ok","replicas":replicas}
+
+def get_deployment_replicas(namespace, deployment):
+    out = run_cmd(["kubectl","-n",namespace,"get","deployment",deployment,"-o","jsonpath={.spec.replicas}"])
+    return int(out.strip())
+
+def get_deployment_status(namespace, deployment):
+    out = run_cmd(["kubectl","-n",namespace,"get","deployment",deployment,"-o","json"])
+    return json.loads(out)
