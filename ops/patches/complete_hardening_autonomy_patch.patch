+#!/usr/bin/env python3
+"""
+Policy adapter used by generated wrappers (completing earlier scaffold).
+ - Exposes apply_policy(namespace, name, data, dry_run)
+"""
+import subprocess, json, tempfile
+from services.agent.backup_store import store_backup
+
+def apply_policy(namespace, name, data, dry_run=False):
+    prev = None
+    try:
+        prev_raw = subprocess.check_output(["kubectl","-n",namespace,"get","configmap",name,"-o","json"])
+        prev = json.loads(prev_raw.decode("utf-8"))
+    except Exception:
+        prev = None
+    if dry_run:
+        return {"status":"dry_run","would_apply": data, "previous_present": bool(prev)}
+    cm = {"apiVersion":"v1","kind":"ConfigMap","metadata":{"name":name,"namespace":namespace},"data":{k:str(v) for k,v in data.items()}}
+    tf = tempfile.NamedTemporaryFile(delete=False, mode="w")
+    json.dump(cm, tf); tf.close()
+    subprocess.check_call(["kubectl","apply","-f", tf.name])
+    if prev:
+        store_backup(f"policy_{name}_{int(time.time())}", prev)
+    return {"status":"applied"}
+
