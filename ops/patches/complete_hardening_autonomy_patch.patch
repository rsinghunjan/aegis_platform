+#!/usr/bin/env python3
+"""
+Storage adapter completion (wraps S3 ops).
+ - Provides safe_copy, safe_delete (moves to tombstone) and get_object_head.
+"""
+import boto3, os
+from urllib.parse import urlparse
+
+S3_REGION = os.environ.get("AWS_REGION", "us-west-2")
+
+def s3_client():
+    return boto3.client("s3", region_name=S3_REGION)
+
+def parse_s3(uri):
+    p = urlparse(uri)
+    return p.netloc, p.path.lstrip("/")
+
+def safe_copy(src, dst):
+    sb, sk = parse_s3(src)
+    db, dk = parse_s3(dst)
+    c = s3_client()
+    c.copy_object(Bucket=db, CopySource={"Bucket": sb, "Key": sk}, Key=dk)
+    return {"status":"copied", "dst": dst}
+
+def safe_delete(uri):
+    b,k = parse_s3(uri)
+    c = s3_client()
+    tomb = f".tombstone/{k}.{int(time.time())}"
+    c.copy_object(Bucket=b, CopySource={"Bucket":b,"Key":k}, Key=tomb)
+    c.delete_object(Bucket=b, Key=k)
+    return {"status":"tombstoned", "tomb": f"s3://{b}/{tomb}"}
+
+def get_head(uri):
+    b,k = parse_s3(uri)
+    c = s3_client()
+    return c.head_object(Bucket=b, Key=k)
+
