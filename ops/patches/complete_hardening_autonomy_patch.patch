+#!/usr/bin/env python3
+"""
+Staged automation controller for low-risk agentic actions.
+ - Reads a safe_policy (ops/config/safe_policy.json) which lists allowed low-risk tools/actions.
+ - Reads a queue of candidate intents (ops/agent/auto_intents.jsonl) and proposes plans via LLM planner.
+ - Validates via plan_verifier; automatically executes low-risk plans up to a staged ramp (percent).
+ - All executions use execute_plan_safe to ensure pre/post checks, backups and auditing.
+ - Respects circuit breaker and manual approval for medium/high risk.
+
+This is intended to run as a cron or deployment in staging/production with limited rate.
+"""
+import os
+import json
+import time
+from services.agent.llm_planner_enhanced import plan_for_intent
+from services.agent.plan_verifier import plan_verdict
+from services.agent.execute_with_safety import execute_plan_safe
+from services.agent.circuit_breaker import is_allowed as cb_is_allowed, record_failure
+
+SAFE_POLICY_PATH = os.environ.get("SAFE_POLICY_PATH", "ops/config/safe_policy.json")
+INTENTS_FILE = os.environ.get("AUTO_INTENTS_FILE", "ops/agent/auto_intents.jsonl")
+RAMP_PERCENT = float(os.environ.get("STAGED_RAMP_PERCENT", "0.05"))  # fraction of intents to auto-execute
+SLEEP_S = int(os.environ.get("STAGED_CONTROLLER_INTERVAL_S", "30"))
+
+def load_safe_policy(path):
+    if not os.path.exists(path):
+        return {"allowed": []}
+    return json.load(open(path))
+
+def load_intents(path):
+    out=[]
+    if not os.path.exists(path):
+        return out
+    for l in open(path):
+        if not l.strip(): continue
+        out.append(json.loads(l))
+    return out
+
+def intent_allowed_by_policy(plan, policy):
+    # simple check: all tool.action pairs in plan must be in policy.allowed
+    allowed = set(policy.get("allowed", []))
+    for step in plan.get("plan", []):
+        t = f"{step.get('tool')}.{step.get('action')}" if '.' not in step.get('tool') else step.get('tool')
+        if t not in allowed:
+            return False
+    return True
+
+def run_once():
+    if not cb_is_allowed("default"):
+        print("Circuit breaker tripped; not executing")
+        return
+    policy = load_safe_policy(SAFE_POLICY_PATH)
+    intents = load_intents(INTENTS_FILE)
+    if not intents:
+        print("No auto intents found")
+        return
+    # pick a subset according to ramp percent
+    limit = max(1, int(len(intents) * RAMP_PERCENT))
+    selected = intents[:limit]
+    for it in selected:
+        intent_text = it.get("intent")
+        try:
+            plan = plan_for_intent(intent_text, {})
+            verdict = plan_verdict(plan)
+            if not verdict.get("allow", False):
+                print("Plan vetoed by automatic verifier for intent:", intent_text)
+                continue
+            # only auto-execute if risk low and policy allows
+            if plan.get("risk_level","low") != "low":
+                print("Plan risk not low -> requires human:", plan.get("risk_level"))
+                continue
+            if not intent_allowed_by_policy(plan, policy):
+                print("Plan contains non-allowed actions; skipping")
+                continue
+            # execute safely (dry_run False)
+            res = execute_plan_safe(f"staged-{int(time.time())}", plan, requester="automation", dry_run=False)
+            print("Execution result:", res)
+            if res.get("state") == "failed":
+                record_failure("default")
+        except Exception as e:
+            print("Error processing intent", intent_text, e)
+
+def main_loop():
+    print("Starting staged automation controller with ramp", RAMP_PERCENT)
+    while True:
+        run_once()
+        time.sleep(SLEEP_S)
+
+if __name__=="__main__":
+    main_loop()
+
