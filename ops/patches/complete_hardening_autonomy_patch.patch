+#!/usr/bin/env python3
+"""
+Pack, upload and validate Triton model; optionally trigger reload and run a validation inference.
+ - Wraps packaging, uploading to MODEL_STORE_PREFIX (s3://...), and calls Triton reload + validate.
+ - Produces an evidence report uploaded to EVIDENCE_BUCKET.
+"""
+import os, sys, json, subprocess, time
+from services.agent.audit_logger import s3_put
+
+MODEL_STORE = os.environ.get("MODEL_STORE_PREFIX", "")
+TRITON_HOST = os.environ.get("TRITON_HOST", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def package_model(src_dir, model_name):
+    subprocess.check_call(["./scripts/package_triton_model.sh", src_dir, model_name, "/tmp/model_store"])
+    return "/tmp/triton_repo_" + str(int(time.time()))
+
+def upload_to_store(local_path, store_prefix, model_name):
+    if store_prefix.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp","--recursive", local_path, f"{store_prefix.rstrip('/')}/{model_name}/"])
+        return f"{store_prefix.rstrip('/')}/{model_name}/"
+    else:
+        # fallback: copy to local path
+        target = os.path.join(store_prefix, model_name)
+        subprocess.check_call(["mkdir","-p", target])
+        subprocess.check_call(["cp","-r", local_path, target])
+        return target
+
+def reload_triton(server):
+    subprocess.check_call(["python","scripts/triton_model_control.py","--server", server, "--reload"])
+
+def validate_inference(server, model_name, sample_input):
+    subprocess.check_call(["python","services/triton/validate_and_test_model.py", server, model_name, sample_input])
+
+def main():
+    if len(sys.argv) < 4:
+        print("Usage: pack_and_publish_model.py <src_dir> <model_name> <sample_input.json>")
+        sys.exit(2)
+    src = sys.argv[1]; name = sys.argv[2]; sample = sys.argv[3]
+    repo = package_model(src, name)
+    store = upload_to_store(repo, MODEL_STORE, name) if MODEL_STORE else repo
+    if TRITON_HOST:
+        reload_triton(TRITON_HOST)
+        try:
+            validate_inference(TRITON_HOST, name, sample)
+            ok = True
+        except Exception as e:
+            ok = False
+    else:
+        ok = None
+    report = {"model": name, "store": store, "validated": ok, "ts": int(time.time())}
+    if EVIDENCE_BUCKET:
+        s3_put(f"model_publish/{name}_{int(time.time())}.json", report)
+    print("Publish report:", json.dumps(report, indent=2))
+
+if __name__=="__main__":
+    main()
+
