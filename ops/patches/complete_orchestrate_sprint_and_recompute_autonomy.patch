+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Deploys the long-shadow daemon into Kubernetes (namespace inference) and starts the campaign coordinator.
+# Requires:
+#  - kubectl configured to target the cluster
+#  - env vars: EVIDENCE_BUCKET, CANDIDATE_URL, LONG_SHADOW_DAYS (optional)
+#
+NAMESPACE=${NAMESPACE:-inference}
+DEPLOY_NAME=${DEPLOY_NAME:-aegis-long-shadow}
+IMAGE=${IMAGE:-us.gcr.io/aegis/long-shadow-daemon:latest}
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+CANDIDATE_URL=${CANDIDATE_URL:-}
+LONG_SHADOW_DAYS=${LONG_SHADOW_DAYS:-30}
+
+if [ -z "$CANDIDATE_URL" ]; then
+  echo "You must set CANDIDATE_URL environment variable (the candidate generation endpoint)"
+  exit 2
+fi
+
+cat > /tmp/long-shadow-deploy.yaml <<EOF
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: ${DEPLOY_NAME}
+  namespace: ${NAMESPACE}
+spec:
+  replicas: 2
+  selector:
+    matchLabels:
+      app: ${DEPLOY_NAME}
+  template:
+    metadata:
+      labels:
+        app: ${DEPLOY_NAME}
+    spec:
+      containers:
+      - name: long-shadow
+        image: ${IMAGE}
+        env:
+        - name: CANDIDATE_URL
+          value: "${CANDIDATE_URL}"
+        - name: PROD_PROXY
+          value: "http://prod-gen-proxy.inference.svc:8080/generate"
+        - name: EVIDENCE_BUCKET
+          value: "${EVIDENCE_BUCKET}"
+        - name: LONG_SHADOW_BATCH
+          value: "50"
+        - name: LONG_SHADOW_SAMPLE_RATE
+          value: "0.01"
+        - name: LONG_SHADOW_DAYS
+          value: "${LONG_SHADOW_DAYS}"
+EOF
+
+echo "Applying long-shadow deployment to namespace ${NAMESPACE}..."
+kubectl apply -f /tmp/long-shadow-deploy.yaml
+
+echo "Starting campaign coordinator (local process that aggregates daily)."
+echo "Run the coordinator in background (or deploy as CronWorkflow)."
+echo "To run coordinator locally:"
+echo "  python ops/long_shadow_campaign/run_long_shadow_campaign.py"
+
+echo "Long-shadow daemon deployed. Use ops/long_shadow_campaign/run_long_shadow_campaign.py to run coordinator for ${LONG_SHADOW_DAYS} days."
+
