+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Dispatch key GitHub workflows that run the hardening pipelines:
+#  - finalize_hardening.yml
+#  - hardening_execute.yml
+#  - agent_long_dryrun_2000.yml
+#  - ingest_stress_ci.yml
+#
+# Two modes:
+#  - gh CLI mode (preferred): requires `gh auth login` and repository context
+#  - raw API mode: requires GITHUB_TOKEN env and repo owner/name in GITHUB_REPO
+#
+REPO=${GITHUB_REPO:-}
+GITHUB_TOKEN=${GITHUB_TOKEN:-}
+USE_GH=${USE_GH:-1}  # set to 0 to use raw API
+
+function dispatch_with_gh() {
+  local wf="$1"
+  echo "Dispatching workflow via gh: $wf"
+  gh workflow run "$wf" || (echo "gh dispatch failed for $wf"; return 1)
+}
+
+function dispatch_with_api() {
+  local wf="$1"
+  if [ -z "$REPO" ] || [ -z "$GITHUB_TOKEN" ]; then
+    echo "GITHUB_REPO and GITHUB_TOKEN must be set for API dispatch"
+    return 1
+  fi
+  echo "Dispatching workflow via API: $wf"
+  curl -s -X POST \
+    -H "Accept: application/vnd.github+json" \
+    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
+    "https://api.github.com/repos/${REPO}/actions/workflows/${wf}/dispatches" \
+    -d '{"ref":"main"}' || (echo "api dispatch failed for $wf"; return 1)
+}
+
+WORKFLOWS=("finalize_hardening.yml" "hardening_execute.yml" "agent_long_dryrun_2000.yml" "ingest_stress_ci.yml")
+
+for wf in "${WORKFLOWS[@]}"; do
+  if [ "${USE_GH}" -eq 1 ]; then
+    dispatch_with_gh "$wf"
+  else
+    dispatch_with_api "$wf"
+  fi
+done
+
+echo "Dispatched workflows: ${WORKFLOWS[*]}"
+
