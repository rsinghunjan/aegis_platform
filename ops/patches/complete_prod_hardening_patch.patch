+#!/usr/bin/env python3
+"""
+LabelStudio simple integration helper:
+ - export tasks from dataset manifest to LabelStudio import
+ - pull annotations back and attach to dataset manifest/provenance
+Requires LABELSTUDIO_URL and LABELSTUDIO_API_KEY env vars.
+"""
+import os, requests, json
+
+LS_URL = os.environ.get("LABELSTUDIO_URL")
+LS_KEY = os.environ.get("LABELSTUDIO_API_KEY")
+
+def create_task(image_uri, project_id, meta=None):
+    if not LS_URL or not LS_KEY:
+        raise RuntimeError("LABELSTUDIO_URL/KEY required")
+    url = f"{LS_URL}/api/projects/{project_id}/import"
+    headers = {"Authorization": f"Token {LS_KEY}"}
+    payload = {"data": {"image": image_uri, **(meta or {})}}
+    r = requests.post(url, json=[payload], headers=headers)
+    r.raise_for_status()
+    return r.json()
+
+def export_annotations(project_id, out_file):
+    if not LS_URL or not LS_KEY:
+        raise RuntimeError("LABELSTUDIO_URL/KEY required")
+    url = f"{LS_URL}/api/projects/{project_id}/export"
+    headers = {"Authorization": f"Token {LS_KEY}"}
+    r = requests.get(url, headers=headers)
+    r.raise_for_status()
+    open(out_file,"w").write(r.text)
+    return out_file
