+#!/usr/bin/env python3
+"""
+Attestation verifier: improved scaffold that attempts to call tpm2-tools if available.
+ - If tpm2-tools (tpm2_checkquote) is available on the host, will shell out to verify a quote
+ - Otherwise falls back to simple signature verification implemented in services/attestation_verifier
+This lets clusters with tpm2 packages installed perform fuller verification.
+"""
+import os, subprocess, base64, json
+from cryptography.hazmat.primitives import serialization, hashes
+from cryptography.hazmat.primitives.asymmetric import padding
+
+def verify_with_tpm2(quote_b64, signature_b64, ak_pub_pem_path, qualifying_data_b64=None):
+    try:
+        quote = base64.b64decode(quote_b64)
+        signature = base64.b64decode(signature_b64)
+        qfile = "/tmp/quote.bin"
+        sigfile = "/tmp/sig.bin"
+        open(qfile,"wb").write(quote)
+        open(sigfile,"wb").write(signature)
+        cmd = ["tpm2_checkquote", "-q", qfile, "-s", sigfile, "-P", ak_pub_pem_path]
+        if qualifying_data_b64:
+            qdata = base64.b64decode(qualifying_data_b64)
+            qpath = "/tmp/qdata.bin"
+            open(qpath,"wb").write(qdata)
+            cmd += ["-m", qpath]
+        subprocess.check_call(cmd, timeout=15)
+        return True, "tpm2_checkquote_ok"
+    except Exception as e:
+        return False, str(e)
+
+def verify_basic_signature(quote_b64, signature_b64, ak_pub_pem):
+    try:
+        quote = base64.b64decode(quote_b64)
+        signature = base64.b64decode(signature_b64)
+        ak = serialization.load_pem_public_key(ak_pub_pem.encode() if isinstance(ak_pub_pem,str) else ak_pub_pem)
+        ak.verify(signature, quote, padding.PKCS1v15(), hashes.SHA256())
+        return True, "basic_sig_ok"
+    except Exception as e:
+        return False, str(e)
+
