+"""
+Milvus adapter for storing vector embeddings and metadata for agent memory and dataset augmentation.
+This is a thin wrapper intended to be replaced by your production connector (Milvus Cloud / self-hosted).
+"""
+import os
+try:
+    from pymilvus import connections, Collection, utility, FieldSchema, CollectionSchema, DataType
+except Exception:
+    connections = None
+
+MILVUS_HOST = os.environ.get("MILVUS_HOST", "localhost")
+MILVUS_PORT = os.environ.get("MILVUS_PORT", "19530")
+
+class MilvusAdapter:
+    def __init__(self, collection_name="aegis_memory", dim=256):
+        if connections:
+            connections.connect("default", host=MILVUS_HOST, port=MILVUS_PORT)
+            self.name = collection_name
+            if not utility.has_collection(collection_name):
+                fields = [
+                    FieldSchema(name="id", dtype=DataType.INT64, is_primary=True, auto_id=True),
+                    FieldSchema(name="embedding", dtype=DataType.FLOAT_VECTOR, dim=dim),
+                    FieldSchema(name="meta", dtype=DataType.JSON)
+                ]
+                schema = CollectionSchema(fields, description="Aegis memory")
+                self.col = Collection(collection_name, schema)
+            else:
+                self.col = Collection(collection_name)
+        else:
+            self.col = None
+
+    def add(self, vectors, metas):
+        if not self.col:
+            raise RuntimeError("pymilvus not installed")
+        self.col.insert([vectors, metas])
+
+    def search(self, query_vec, top_k=10):
+        if not self.col:
+            raise RuntimeError("pymilvus not installed")
+        res = self.col.search([query_vec], "embedding", params={"metric_type":"L2"}, limit=top_k)
+        return res
+
