+#!/usr/bin/env python3
+"""
+Utility to export a PyTorch model to ONNX and generate a Triton-friendly repo layout.
+ - Exports model.pt -> model.onnx
+ - Writes a minimal config.pbtxt for Triton
+"""
+import torch, os, json
+
+def export_torch_to_onnx(model_path, out_dir, example_inputs):
+    os.makedirs(out_dir, exist_ok=True)
+    model = torch.jit.load(model_path) if model_path.endswith(".pt") else torch.load(model_path)
+    model.eval()
+    example = example_inputs
+    onnx_path = os.path.join(out_dir, "model.onnx")
+    torch.onnx.export(model, example, onnx_path, opset_version=12)
+    # minimal triton config
+    cfg = f"""
+name: "onnx_model"
+platform: "onnxruntime_onnx"
+max_batch_size: 8
+input [ {{ name: "input__0" data_type: TYPE_FP32 dims: [ -1 ] }} ]
+output [ {{ name: "output__0" data_type: TYPE_FP32 dims: [ -1 ] }} ]
+"""
+    open(os.path.join(out_dir, "config.pbtxt"), "w").write(cfg)
+    print("Exported ONNX to", onnx_path)
