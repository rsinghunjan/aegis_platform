+#!/usr/bin/env python3
+"""
+Checkpoint manager:
+ - watches a checkpoint directory
+ - uploads new checkpoints to object store (S3)
+ - maintains a signed manifest (cosign/cosign-notes placeholder)
+"""
+import os, time, json
+from s3_uploader import upload_file
+
+WATCH_DIR = os.environ.get("CHECKPOINT_DIR", "/workspace/checkpoints")
+DATASET_BUCKET = os.environ.get("DATASET_BUCKET")
+SIGNING_COMMAND = os.environ.get("SIGN_CMD")  # optional, e.g., cosign sign ...
+
+def list_checkpoints(dir):
+    return sorted([os.path.join(dir,f) for f in os.listdir(dir)])
+
+def upload_and_manifest(path, tag=None):
+    uri = upload_file(path)
+    manifest = {"path": path, "uri": uri, "uploaded_at": time.time(), "tag": tag}
+    # optionally sign manifest
+    if SIGNING_COMMAND:
+        # placeholder: operator runs signing command against manifest
+        pass
+    print("Uploaded checkpoint", uri)
+    return manifest
+
+def main():
+    seen = set()
+    while True:
+        if not os.path.exists(WATCH_DIR):
+            time.sleep(5); continue
+        files = list_checkpoints(WATCH_DIR)
+        for f in files:
+            if f in seen: continue
+            if os.path.isdir(f): continue
+            try:
+                m = upload_and_manifest(f)
+                print("manifest", m)
+                seen.add(f)
+            except Exception as e:
+                print("upload failed", e)
+        time.sleep(10)
+
+if __name__ == "__main__":
+    main()
