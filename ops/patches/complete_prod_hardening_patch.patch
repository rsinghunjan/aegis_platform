+#!/usr/bin/env python3
+"""
+Dataset registry client for writing/managing dataset manifests and versions.
+Uses DATABASE_URL to persist registry entries.
+"""
+import os, psycopg2, json
+from datetime import datetime
+
+DB = os.environ.get("DATABASE_URL")
+
+def conn():
+    if not DB:
+        raise RuntimeError("DATABASE_URL not set")
+    return psycopg2.connect(DB)
+
+def create_dataset(dataset_id, description="", metadata=None):
+    c = conn()
+    cur = c.cursor()
+    cur.execute("INSERT INTO datasets (id, description, metadata) VALUES (%s,%s,%s) ON CONFLICT DO NOTHING", (dataset_id, description, json.dumps(metadata or {})))
+    c.commit(); cur.close(); c.close()
+
+def add_object(dataset_id, object_id, uri, modality):
+    c = conn()
+    cur = c.cursor()
+    cur.execute("INSERT INTO dataset_objects (dataset_id, object_id, uri, modality) VALUES (%s,%s,%s,%s)", (dataset_id, object_id, uri, modality))
+    c.commit(); cur.close(); c.close()
+
+def create_version(dataset_id, version_tag, manifest_uri):
+    c = conn()
+    cur = c.cursor()
+    cur.execute("INSERT INTO dataset_versions (dataset_id, version_tag, manifest_uri) VALUES (%s,%s,%s)", (dataset_id, version_tag, manifest_uri))
+    c.commit(); cur.close(); c.close()
+
+def record_lineage(dataset_id, parent_dataset_id, transform):
+    c = conn()
+    cur = c.cursor()
+    cur.execute("INSERT INTO dataset_lineage (dataset_id, parent_dataset_id, transform) VALUES (%s,%s,%s)", (dataset_id, parent_dataset_id, json.dumps(transform)))
+    c.commit(); cur.close(); c.close()
+
+if __name__ == "__main__":
+    # simple CLI usage
