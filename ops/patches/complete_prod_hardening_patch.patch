+#!/usr/bin/env python3
+"""
+S3 uploader helper used by HIL ingest and dataset pipelines.
+- Uploads files with content-addressed keys and writes an object manifest entry
+- Supports optional server-side encryption via KMS (env KMS_KEY)
+"""
+import os, sys, hashlib, json
+import boto3
+from datetime import datetime
+
+S3_BUCKET = os.environ.get("DATASET_BUCKET", "")
+S3_PREFIX = os.environ.get("DATASET_PREFIX", "aegis-datasets")
+
+def sha256_file(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+def upload_file(path, key=None, kms_key=None):
+    if not S3_BUCKET:
+        raise RuntimeError("DATASET_BUCKET not set")
+    s3 = boto3.client("s3")
+    if key is None:
+        digest = sha256_file(path)
+        key = f"{S3_PREFIX}/{digest}/{os.path.basename(path)}"
+    extra = {}
+    if kms_key:
+        extra["ServerSideEncryption"] = "aws:kms"
+        extra["SSEKMSKeyId"] = kms_key
+    s3.upload_file(path, S3_BUCKET, key, ExtraArgs=extra)
+    uri = f"s3://{S3_BUCKET}/{key}"
+    return uri
+
+def record_manifest_entry(db_conn, dataset_id, obj_id, uri, modality, ts=None):
+    cur = db_conn.cursor()
+    ts = ts or datetime.utcnow()
+    cur.execute("""
+    INSERT INTO dataset_objects (dataset_id, object_id, uri, modality, created_at)
+    VALUES (%s,%s,%s,%s,%s)
+    """, (dataset_id, obj_id, uri, modality, ts))
+    db_conn.commit()
+    cur.close()
+
+if __name__ == "__main__":
+    # simple CLI: upload a file and print URI
+    if len(sys.argv) < 2:
+        print("Usage: s3_uploader.py <file> [dataset_id] [modality]")
+        sys.exit(2)
+    path = sys.argv[1]
+    dataset = sys.argv[2] if len(sys.argv) > 2 else "unspecified"
+    modality = sys.argv[3] if len(sys.argv) > 3 else "unknown"
+    uri = upload_file(path)
+    print("Uploaded:", uri)
+
