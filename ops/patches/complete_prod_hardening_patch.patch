+#!/usr/bin/env python3
+"""
+Lightweight Kafka -> object store connector for streaming HIL logs into the dataset store.
+Consume messages (JSON with fields: bytes/filepath or raw payload) and write to S3 via s3_uploader.
+Intended to run as a deployment on k8s, scalable via consumer group.
+"""
+import os, json, logging, time
+from confluent_kafka import Consumer, KafkaException
+from s3_uploader import upload_file
+
+KAFKA_BOOTSTRAP = os.environ.get("KAFKA_BOOTSTRAP", "kafka:9092")
+KAFKA_TOPIC = os.environ.get("KAFKA_TOPIC", "hil-raw")
+GROUP = os.environ.get("KAFKA_GROUP", "aegis-ingest")
+
+consumer_conf = {
+    "bootstrap.servers": KAFKA_BOOTSTRAP,
+    "group.id": GROUP,
+    "auto.offset.reset": "earliest",
+    "enable.auto.commit": False
+}
+
+def main():
+    c = Consumer(consumer_conf)
+    c.subscribe([KAFKA_TOPIC])
+    try:
+        while True:
+            msg = c.poll(1.0)
+            if msg is None:
+                continue
+            if msg.error():
+                logging.error("Kafka error: %s", msg.error())
+                continue
+            payload = msg.value()
+            # write payload to a temp file and upload
+            fname = f"/tmp/hil_payload_{int(time.time()*1000)}.bin"
+            with open(fname, "wb") as f:
+                f.write(payload)
+            uri = upload_file(fname)
+            logging.info("Uploaded payload to %s", uri)
+            c.commit(msg)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        c.close()
+
+if __name__ == "__main__":
+    main()
+
