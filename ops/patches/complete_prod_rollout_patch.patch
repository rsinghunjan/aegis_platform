+#!/usr/bin/env python3
+"""
+CI helper to enforce finance tagging on jobs and fail CI if unlabeled jobs detected.
+Reads a job report JSON placed by CI and fails if any job misses required tags.
+"""
+import sys
+import json
+import os
+
+POLICY = "ops/finance/finance_policy.yaml"
+
+def load_policy():
+    import yaml
+    return yaml.safe_load(open(POLICY))
+
+def main():
+    report = "/tmp/job_reports.json"
+    if not os.path.exists(report):
+        print("No job report found; skipping check")
+        return
+    jobs = json.load(open(report))
+    policy = load_policy()
+    required = policy.get("quota",{}).get("tags_required", [])
+    violations = []
+    for j in jobs:
+        tags = j.get("tags", {})
+        for t in required:
+            k = t.split(":",1)[0]
+            if k not in tags:
+                violations.append({"job": j.get("id"), "missing": t})
+    if violations:
+        print("Tagging violations found:", violations)
+        sys.exit(1)
+    print("Tagging enforcement passed")
+
+if __name__=="__main__":
+    main()
+
