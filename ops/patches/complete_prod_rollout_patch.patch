+#!/usr/bin/env python3
+"""
+Production TPM verifier orchestration script (wrapper).
+Requires tpm2-tools and openssl. Validates signature and optionally checks PCRs.
+This script is intended to run on a hardened verifier host behind an authenticated API.
+"""
+import argparse
+import json
+import tempfile
+import base64
+import subprocess
+from datetime import datetime
+
+def write_tmp(b64, suffix):
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=suffix)
+    f.write(base64.b64decode(b64))
+    f.flush()
+    f.close()
+    return f.name
+
+def verify_sig(quote_path, sig_path, ak_pub):
+    try:
+        subprocess.check_call(["openssl","dgst","-sha256","-verify",ak_pub,"-signature",sig_path,quote_path])
+        return True, "signature_ok"
+    except subprocess.CalledProcessError as e:
+        return False, str(e)
+
+def run_tpm2_checkquote(quote_path, ak_pub):
+    # If tpm2_checkquote available, call it for parsing; otherwise skip
+    try:
+        out = subprocess.check_output(["tpm2_checkquote","-o",quote_path,"-c",ak_pub], text=True)
+        return True, out
+    except Exception:
+        return False, "tpm2_checkquote not available or failed"
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="infile", required=True)
+    p.add_argument("--ak-pub", required=True)
+    args = p.parse_args()
+    j = json.load(open(args.infile))
+    quote_f = write_tmp(j["quote"], ".quote")
+    sig_f = write_tmp(j["sig"], ".sig")
+    ok, msg = verify_sig(quote_f, sig_f, args.ak_pub)
+    parsed_ok, parsed_msg = run_tpm2_checkquote(quote_f, args.ak_pub)
+    out = {"ok": ok and parsed_ok, "sig_verify": ok, "sig_msg": msg, "parsed_ok": parsed_ok, "parsed_msg": parsed_msg, "ts": datetime.utcnow().isoformat()+"Z"}
+    print(json.dumps(out))
+
+if __name__=="__main__":
+    main()
+
