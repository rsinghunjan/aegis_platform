+#!/usr/bin/env python3
+"""
+Create provisioning issues and an inventory PR, plus a checklist issue for operators.
+Usage:
+  GITHUB_TOKEN=<token> python ops/automation/create_all_provision_and_inventory_prs.py --repo owner/repo
+"""
+import os
+import argparse
+import requests
+import json
+import base64
+from datetime import datetime
+
+GITHUB_API = "https://api.github.com"
+
+DEFAULT_INVENTORY = {
+  "ts": "",
+  "devices": {
+    "gpu": {"requested": 1, "notes": "NVIDIA A100-class rack preferred"},
+    "rt": {"requested": 1, "notes": "Real-time compute node with RT kernel"},
+    "hil": {"requested": 1, "notes": "HIL rack with CAN/ETH adapters"},
+    "npu": {"requested": 0}
+  }
+}
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def create_issue(repo, title, body, token, labels=None):
+    labels = labels or ["onboarding","hardware"]
+    r = requests.post(f"{GITHUB_API}/repos/{repo}/issues", headers=gh_headers(token), json={"title": title, "body": body, "labels": labels})
+    r.raise_for_status()
+    return r.json().get("html_url")
+
+def get_ref_sha(repo, branch, token):
+    r = requests.get(f"{GITHUB_API}/repos/{repo}/git/ref/heads/{branch}", headers=gh_headers(token))
+    r.raise_for_status()
+    return r.json()["object"]["sha"]
+
+def create_branch(repo, branch, sha, token):
+    r = requests.post(f"{GITHUB_API}/repos/{repo}/git/refs", headers=gh_headers(token), json={"ref": f"refs/heads/{branch}", "sha": sha})
+    if r.status_code not in (200,201,422):
+        raise RuntimeError("create branch failed: " + r.text)
+
+def create_or_update_file(repo, path, branch, content, token, sha=None, message="Add inventory"):
+    b64 = base64.b64encode(content.encode()).decode()
+    payload = {"message": message, "branch": branch, "content": b64}
+    if sha:
+        payload["sha"] = sha
+    r = requests.put(f"{GITHUB_API}/repos/{repo}/contents/{path}", headers=gh_headers(token), json=payload)
+    r.raise_for_status()
+    return r.json()
+
+def create_pr(repo, head, base, title, body, token):
+    r = requests.post(f"{GITHUB_API}/repos/{repo}/pulls", headers=gh_headers(token), json={"title": title, "head": head, "base": base, "body": body})
+    r.raise_for_status()
+    return r.json().get("html_url")
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    p.add_argument("--base", default="main")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required"); return
+    now = datetime.utcnow().isoformat()+"Z"
+    inv = DEFAULT_INVENTORY.copy()
+    inv["ts"] = now
+    inv_json = json.dumps(inv, indent=2)
+    base_sha = get_ref_sha(args.repo, args.base, token)
+    branch = f"aegis/provision-inventory-{datetime.utcnow().strftime('%Y%m%d%H%M%S')}"
+    create_branch(args.repo, branch, base_sha, token)
+    # create or update inventory file
+    try:
+        f = requests.get(f"{GITHUB_API}/repos/{args.repo}/contents/ops/provisioning/inventory.json?ref={args.base}", headers=gh_headers(token))
+        sha = f.json().get("sha") if f.status_code == 200 else None
+    except Exception:
+        sha = None
+    create_or_update_file(args.repo, "ops/provisioning/inventory.json", branch, inv_json, token, sha=sha, message="chore(provision): add inventory")
+    pr = create_pr(args.repo, branch, args.base, "Add provisioning inventory", "Adds inventory for representative hardware provisioning", token)
+    print("Created PR:", pr)
+    # create per-device issues calling operators out
+    for dev in inv["devices"]:
+        title = f"[Provision] Add representative {dev.upper()} hardware"
+        body = f"Please provision {inv['devices'][dev]['requested']} representative {dev} target(s).\n\nAcceptance criteria:\n- Node/rack reachable by CI\n- Labeled aegis/{dev}=true\n- Driver pinned and validated per ops/installers/driver_versions.json\n\nInventory: ops/provisioning/inventory.json"
+        issue = create_issue(args.repo, title, body, token)
+        print("Created issue:", issue)
+
+if __name__ == "__main__":
+    main()
