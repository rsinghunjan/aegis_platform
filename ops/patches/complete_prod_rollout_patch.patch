+#!/usr/bin/env python3
+"""
+OTA server that enforces TPM attestation before issuing presigned artifact URLs.
+Exposes /v1/ota/latest which accepts attestation + node id and returns presigned URL.
+"""
+from flask import Flask, request, jsonify
+import os
+import json
+import subprocess
+from ops.ota import signed_url_helper as helper
+
+VERIFIER = "ops/attestation/production_tpm_verifier.py"
+
+app = Flask(__name__)
+
+def verify(att):
+    fn = "/tmp/att.json"
+    open(fn,"w").write(json.dumps(att))
+    cmd = ["python", VERIFIER, "--in", fn, "--ak-pub", os.environ.get("AK_PUB_PATH","/opt/ak_pub.pem")]
+    try:
+        out = subprocess.check_output(cmd, text=True)
+        return json.loads(out)
+    except Exception as e:
+        return {"ok": False, "msg": str(e)}
+
+@app.route("/v1/ota/latest", methods=["POST"])
+def latest():
+    j = request.get_json(force=True)
+    att = j.get("attestation")
+    if not att:
+        return jsonify({"error":"attestation required"}), 400
+    v = verify(att)
+    if not v.get("ok"):
+        return jsonify({"error":"attestation failed","detail":v}), 403
+    # produce presigned URL
+    bucket = os.environ.get("OTA_BUCKET","aegis-ota")
+    key = os.environ.get("OTA_KEY","models/latest.tar.gz")
+    url = helper.s3_presigned(bucket, key, expires=3600)
+    return jsonify({"artifact_url": url, "metadata": {"verified": True}})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
