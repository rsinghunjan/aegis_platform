+#!/usr/bin/env python3
+"""
+Verifier smoke test:
+ - Reads thresholds from ConfigMap in cluster (VERIFIER_CALIB_CM) and runs verifier_gate.py against a candidate dir
+ - Exits 0 if gate passes; non-zero otherwise (blocks promotion in CI)
+"""
+import os, sys, json
+import subprocess
+from kubernetes import client, config
+
+CONFIGMAP_NAME = os.environ.get("VERIFIER_CALIB_CM", "verifier-calib")
+NAMESPACE = os.environ.get("CALIB_NS", "safety")
+CANDIDATE_DIR = os.environ.get("CANDIDATE_DIR", "out/candidate")
+
+def has_threshold():
+    try:
+        config.load_kube_config()
+        v1 = client.CoreV1Api()
+        cm = v1.read_namespaced_config_map(CONFIGMAP_NAME, NAMESPACE)
+        if "thresholds.json" in (cm.data or {}):
+            print("Found thresholds.json in ConfigMap")
+            return True
+    except Exception as e:
+        print("Warning: could not read ConfigMap:", e)
+    return False
+
+def run_gate():
+    # run verifier_gate.py which reads ConfigMap from cluster (KUBECONFIG must be configured)
+    rc = subprocess.call(["python", "services/factuality/verifier_gate.py", CANDIDATE_DIR])
+    return rc == 0
+
+if __name__=="__main__":
+    if not has_threshold():
+        print("Calibration ConfigMap missing; failing smoke test")
+        sys.exit(1)
+    ok = run_gate()
+    if not ok:
+        print("Verifier gate failed — block promotion")
+        sys.exit(2)
+    print("Verifier smoke test passed")
+    sys.exit(0)
+
