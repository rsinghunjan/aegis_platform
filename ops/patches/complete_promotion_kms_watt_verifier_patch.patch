+name: Promotion CR Integration Test
+on:
+  workflow_dispatch:
+
+jobs:
+  promotion-cr-test:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup kubectl
+        uses: azure/setup-kubectl@v3
+        with:
+          version: 'v1.27.0'
+
+      - name: Configure kubeconfig
+        env:
+          KUBECONFIG_DATA: ${{ secrets.KUBECONFIG }}
+        run: |
+          echo "${KUBECONFIG_DATA}" > kubeconfig
+          export KUBECONFIG=$PWD/kubeconfig
+          kubectl get nodes
+
+      - name: Apply test ModelPromotion CR
+        run: |
+          TMP_CR=/tmp/promotion_test_cr.yaml
+          # substitute a unique name to avoid collisions
+          UID=$(date +%s)
+          sed "s/{{workflow_uid}}/$UID/g" tests/argo/promotion_test/promotion_test_cr.yaml > $TMP_CR
+          kubectl apply -f $TMP_CR
+          echo "Applied modelpromotion"
+
+      - name: Wait for controller to update status
+        run: |
+          NAME=$(kubectl get modelpromotion -o jsonpath='{.items[?(@.spec.artifact.image=="us.gcr.io/aegis/verifier:test-harness")].metadata.name}' || true)
+          if [ -z "$NAME" ]; then
+            NAME=$(kubectl get modelpromotion -o jsonpath='{.items[0].metadata.name}')
+          fi
+          echo "Monitoring ModelPromotion $NAME status..."
+          TIMEOUT=600
+          INTERVAL=10
+          ELAPSED=0
+          while [ $ELAPSED -lt $TIMEOUT ]; do
+            STATE=$(kubectl -n default get modelpromotion $NAME -o jsonpath='{.status.state}' 2>/dev/null || echo "")
+            echo "State: $STATE"
+            if [ "$STATE" = "promoted" ]; then
+              echo "Promotion succeeded"
+              exit 0
+            fi
+            if [ "$STATE" = "promotion_failed" ] || [ "$STATE" = "canary_failed" ] || [ "$STATE" = "verification_failed" ]; then
+              echo "Promotion entered failure state: $STATE"
+              kubectl -n default get modelpromotion $NAME -o yaml
+              exit 1
+            fi
+            sleep $INTERVAL
+            ELAPSED=$((ELAPSED+INTERVAL))
+          done
+          echo "Timeout waiting for promotion controller"
+          kubectl -n default get modelpromotion $NAME -o yaml || true
+          exit 1
+
