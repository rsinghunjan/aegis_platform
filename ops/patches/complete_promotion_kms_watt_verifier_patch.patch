+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Usage: ./ops/cosign/attach_kms_secret.sh <KMS_KEY_ARN> <NAMESPACE>
+KMS_ARN=${1:-}
+NS=${2:-security}
+if [ -z "$KMS_ARN" ]; then
+  echo "Usage: $0 <KMS_KEY_ARN> [namespace]"
+  exit 2
+fi
+kubectl create namespace $NS --dry-run=client -o yaml | kubectl apply -f -
+kubectl -n $NS create secret generic cosign-kms --from-literal=kms_arn="$KMS_ARN" --dry-run=client -o yaml | kubectl apply -f -
+echo "Stored KMS ARN in k8s secret $NS/cosign-kms"
+
