+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Deploy cert-manager (if not present), deploy cosign-admission Helm chart and populate CA bundle
+#
+# Usage:
+#   ./ops/cosign/helm_deploy_and_populate_ca.yml <helm_release_name> <helm_chart_dir> <namespace>
+#
+RELEASE=${1:-cosign-admission}
+CHART_DIR=${2:-helm/cosign-admission}
+NAMESPACE=${3:-admission}
+
+echo "Ensure cert-manager is installed (operator should manage this in prod). Installing cert-manager in cluster if missing..."
+kubectl get deployment -n cert-manager cert-manager >/dev/null 2>&1 || kubectl apply -f https://github.com/cert-manager/cert-manager/releases/latest/download/cert-manager.yaml
+
+echo "Deploying Helm chart $CHART_DIR as $RELEASE in namespace $NAMESPACE"
+helm upgrade --install "$RELEASE" "$CHART_DIR" -n "$NAMESPACE" --create-namespace --wait
+
+echo "Waiting for Certificate (if cert-manager configured to issue)..."
+# Wait for the secret to appear
+SECRET_NAME=$(kubectl -n "$NAMESPACE" get secret -l app=cosign-admission -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
+if [ -z "$SECRET_NAME" ]; then
+  # default secret name from chart values
+  SECRET_NAME=${SECRET_NAME:-cosign-webhook-tls}
+fi
+
+for i in $(seq 1 30); do
+  if kubectl -n "$NAMESPACE" get secret "$SECRET_NAME" >/dev/null 2>&1; then
+    echo "Found TLS secret $SECRET_NAME"
+    break
+  fi
+  echo "Waiting for TLS secret $SECRET_NAME... ($i/30)"
+  sleep 10
+done
+
+echo "Populating ValidatingWebhookConfiguration CA bundle..."
+./ops/cosign/populate_ca_bundle.sh "$NAMESPACE" "$SECRET_NAME" cosign-validating-webhook || true
+
+echo "Helm deploy & CA population complete."
+
