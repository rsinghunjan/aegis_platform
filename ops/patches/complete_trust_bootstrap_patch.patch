+name: Verifier Full CI Gate
+on:
+  workflow_dispatch:
+
+jobs:
+  verifier_gate:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Setup Python
+        uses: actions/setup-python@v4
+        with:
+          python-version: '3.10'
+      - name: Install deps
+        run: pip install -r requirements-ci.txt
+
+      - name: Finetune verifier (deterministic)
+        run: |
+          python services/factuality/finetune_domain.py --manifest ops/factuality/sample_manifest.jsonl --out_dir out/candidate --model_name facebook/bart-large --epochs 1 --seed 42
+
+      - name: Calibrate thresholds & publish to cluster
+        env:
+          KUBECONFIG: ${{ secrets.KUBECONFIG }}
+          PUSHGATEWAY: ${{ secrets.PUSHGATEWAY }}
+          NAMESPACE: safety
+        run: |
+          python services/factuality/calibrate_and_publish.py
+
+      - name: Run adversarial suite
+        run: |
+          python services/ci/adversarial_suite.py || (echo "Adversarial suite failed" && exit 1)
+
+      - name: Run fairness checks
+        run: |
+          python services/ci/fairness_check.py || (echo "Fairness checks failed" && exit 1)
+
+      - name: Run validation battery
+        run: |
+          python services/ci/validation_battery.py out/candidate || (echo "Validation battery failed" && exit 1)
+
+      - name: Upload artifact & sign (call reusable)
+        uses: ./.github/workflows/cosign_kms_sign_template.yml
+        with:
+          artifact_path: out/candidate.tar.gz
+
+      - name: Create SME signoff request
+        run: |
+          REQ_ID="verifier_ci_${{ github.run_id }}"
+          curl -sS -X POST "${{ secrets.MANUAL_APPROVAL_URL }}/request" -H "Content-Type: application/json" -d "{\"request_id\":\"$REQ_ID\",\"user\":\"ci\",\"reason\":\"SME signoff for verifier candidate\"}"
+          echo "Waiting for SME approval (timeout 48h) ..."
+          for i in $(seq 1 576); do
+            sleep 300
+            RES=$(curl -sS "${{ secrets.MANUAL_APPROVAL_URL }}/list")
+            echo "$RES" | grep "$REQ_ID" | grep approved && { echo "Approved"; break; } || true
+          done
+          # check final state
+          RES=$(curl -sS "${{ secrets.MANUAL_APPROVAL_URL }}/list")
+          echo "$RES" | grep "$REQ_ID" | grep approved || (echo "No SME approval observed; failing gate" && exit 1)
+
+      - name: Publish calibration & signoff artifacts to evidence bucket
+        env:
+          EVIDENCE_BUCKET: ${{ secrets.EVIDENCE_BUCKET }}
+          AWS_REGION: ${{ secrets.AWS_REGION }}
+        run: |
+          aws s3 cp out/candidate.tar.gz "s3://${EVIDENCE_BUCKET}/verifier_ci/${{ github.run_id }}/candidate.tar.gz"
+          aws s3 cp out/calib/thresholds.json "s3://${EVIDENCE_BUCKET}/verifier_ci/${{ github.run_id }}/thresholds.json"
+
+      - name: Finalize - artifact ready for promotion
+        run: echo "Verifier CI gate passed - artifact signed, calibrated, tested, and SME-approved"
+
