+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Wrapper to run Terraform for KMS & S3, extract outputs, and store KMS ARN in k8s secret
+#
+# Usage:
+#   ./run_terraform_and_create_secret.sh <terraform_dir> <k8s_namespace>
+#
+TF_DIR=${1:-terraform/kms_and_s3}
+K8S_NS=${2:-security}
+
+if [ ! -d "$TF_DIR" ]; then
+  echo "Terraform dir $TF_DIR not found"
+  exit 2
+fi
+
+pushd "$TF_DIR" >/dev/null
+terraform init
+terraform apply -auto-approve
+# read outputs
+KMS_ARN=$(terraform output -raw cosign_kms_key_arn)
+EVIDENCE_BUCKET=$(terraform output -raw evidence_bucket)
+popd >/dev/null
+
+echo "KMS ARN: $KMS_ARN"
+echo "Evidence bucket: $EVIDENCE_BUCKET"
+
+# create k8s namespace and secret
+kubectl create namespace "$K8S_NS" --dry-run=client -o yaml | kubectl apply -f -
+kubectl -n "$K8S_NS" create secret generic cosign-kms --from-literal=kms_arn="$KMS_ARN" --dry-run=client -o yaml | kubectl apply -f -
+echo "Stored cosign KMS ARN in k8s secret $K8S_NS/cosign-kms"
+
+cat > /tmp/aegis_evidence_bucket.env <<EOF
+EVIDENCE_BUCKET=$EVIDENCE_BUCKET
+COSIGN_KMS_ARN=$KMS_ARN
+EOF
+echo "Wrote /tmp/aegis_evidence_bucket.env with outputs"
+
