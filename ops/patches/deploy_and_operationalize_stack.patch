+    steps:
+      - uses: actions/checkout@v4
+      - name: Set up kubectl
+        uses: azure/setup-kubectl@v3
+        with:
+          version: 'latest'
+      - name: Set up Python
+        uses: actions/setup-python@v4
+        with:
+          python-version: '3.10'
+      - name: Create k8s secrets (from GH secrets where present)
+        env:
+          EVIDENCE_BUCKET: ${{ github.event.inputs.evidence_bucket }}
+          ELECTRICITYMAP_API_KEY: ${{ secrets.ELECTRICITYMAP_API_KEY }}
+          WATTTIME_API_TOKEN: ${{ secrets.WATTTIME_API_TOKEN }}
+          MODEL_STORE_PREFIX: ${{ secrets.MODEL_STORE_PREFIX }}
+        run: |
+          chmod +x ops/scripts/create_k8s_secrets.sh
+          ./ops/scripts/create_k8s_secrets.sh || true
+      - name: Deploy stack and verify
+        env:
+          PROM_HOST: ${{ secrets.PROM_HOST }}
+        run: |
+          chmod +x ops/scripts/deploy_and_verify_stack.sh
+          ./ops/scripts/deploy_and_verify_stack.sh
+      - name: Run wrapper audit and acceptance runner
+        env:
+          EVIDENCE_BUCKET: ${{ github.event.inputs.evidence_bucket }}
+        run: |
+          chmod +x ops/scripts/run_wrapper_audit_and_dryrun.sh
