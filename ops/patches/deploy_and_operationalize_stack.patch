*** Add File:ops/scripts/create_k8s_secrets.sh
+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create Kubernetes secrets required by the carbon/autonomy stack.
+# Usage:
+#   ELECTRICITYMAP_API_KEY=... WATTTIME_API_TOKEN=... EVIDENCE_BUCKET=... MODEL_STORE_PREFIX=... ./ops/scripts/create_k8s_secrets.sh
+
+NAMESPACE=${NAMESPACE:-monitoring}
+
+if [ -z "${EVIDENCE_BUCKET:-}" ] || ( [ -z "${ELECTRICITYMAP_API_KEY:-}" ] && [ -z "${WATTTIME_API_TOKEN:-}" ] ); then
+  echo "Required envs: EVIDENCE_BUCKET and at least one of ELECTRICITYMAP_API_KEY or WATTTIME_API_TOKEN"
+  exit 2
+fi
+
+echo "Creating/updating evidence-bucket secret in namespace ${NAMESPACE}..."
+kubectl create secret generic evidence-bucket -n "${NAMESPACE}" --from-literal=bucket="${EVIDENCE_BUCKET}" --dry-run=client -o yaml | kubectl apply -f -
+
+if [ -n "${ELECTRICITYMAP_API_KEY:-}" ] || [ -n "${WATTTIME_API_TOKEN:-}" ]; then
+  echo "Creating/updating carbon-secrets..."
+  TMP_ARGS=()
+  if [ -n "${ELECTRICITYMAP_API_KEY:-}" ]; then
+    TMP_ARGS+=(--from-literal=electricitymap_key="${ELECTRICITYMAP_API_KEY}")
+  fi
+  if [ -n "${WATTTIME_API_TOKEN:-}" ]; then
+    TMP_ARGS+=(--from-literal=watttime_token="${WATTTIME_API_TOKEN}")
+  fi
+  kubectl create secret generic carbon-secrets -n "${NAMESPACE}" "${TMP_ARGS[@]}" --dry-run=client -o yaml | kubectl apply -f -
+fi
+
+if [ -n "${MODEL_STORE_PREFIX:-}" ]; then
+  echo "Creating/updating model-store secret..."
+  kubectl create secret generic model-store -n "${NAMESPACE}" --from-literal=prefix="${MODEL_STORE_PREFIX}" --dry-run=client -o yaml | kubectl apply -f -
+fi
+
+echo "Secrets created/updated."
+
