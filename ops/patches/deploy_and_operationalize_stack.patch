+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Check and advise on S3 bucket object-lock and retention.
+# Usage: EVIDENCE_BUCKET=<bucket> ./ops/scripts/configure_s3_retention_check.sh
+
+if [ -z "${EVIDENCE_BUCKET:-}" ]; then
+  echo "EVIDENCE_BUCKET environment variable must be set."
+  exit 2
+fi
+if ! command -v aws >/dev/null 2>&1; then
+  echo "aws CLI required to inspect bucket"
+  exit 3
+fi
+
+echo "Checking object lock configuration for s3://${EVIDENCE_BUCKET}..."
+cfg=$(aws s3api get-bucket-object-lock-configuration --bucket "${EVIDENCE_BUCKET}" 2>/dev/null || true)
+if [ -z "$cfg" ]; then
+  echo "Bucket does not appear to have object lock configuration or permission denied."
+  echo "Important: To enable Object Lock you must create the bucket with object-lock enabled at creation time."
+  echo "See: https://docs.aws.amazon.com/AmazonS3/latest/userguide/object-lock.html"
+  exit 1
+fi
+echo "Object lock configuration:"
+echo "$cfg"
+echo "Please ensure retention policies meet your compliance requirements."
+
