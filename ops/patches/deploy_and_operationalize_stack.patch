+kubectl -n monitoring rollout status deploy/aegis-model-registry --timeout=120s || true
+
+echo "Setting GitHub secret MODEL_REGISTRY_URL in ${gh_repo}..."
+if command -v gh >/dev/null 2>&1; then
+  gh secret set MODEL_REGISTRY_URL --body "${MODEL_REGISTRY_URL}" --repo "${gh_repo}"
+  echo "GitHub secret set."
+else
+  echo "gh CLI not available; please set MODEL_REGISTRY_URL in GitHub repo secrets manually."
+fi
+
+echo "Model registry deployed and CI secret configured (if gh available)."
