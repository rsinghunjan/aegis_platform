+#!/usr/bin/env python3
+"""
+Diffusers service wrapper (FastAPI) — PoC production-ready pattern.
+
+- Exposes /v1/generate-image that accepts prompt + sampling params.
+- Uses a bounded asyncio worker queue for requests and runs generation on GPU(s).
+- Uploads evidence (prompt, seed, model config, output image) to S3 as immutable artifacts.
+"""
+import os
+import io
+import json
+import time
+import asyncio
+import uuid
+from typing import Optional
+from fastapi import FastAPI, HTTPException, BackgroundTasks
+from pydantic import BaseModel
+import boto3
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+MODEL_NAME_DEFAULT = os.environ.get("DIFFUSERS_MODEL", "runwayml/stable-diffusion-v1-5")
+MAX_QUEUE = int(os.environ.get("DIFFUSER_QUEUE_MAX", "8"))
+WORKER_COUNT = int(os.environ.get("DIFFUSER_WORKERS", "1"))
+
+app = FastAPI(title="Aegis Diffusers Service")
+
+class GenRequest(BaseModel):
+    prompt: str
+    seed: Optional[int] = None
+    steps: Optional[int] = 25
+    guidance_scale: Optional[float] = 7.5
+    width: Optional[int] = 512
+    height: Optional[int] = 512
+    model: Optional[str] = None
+    priority: Optional[str] = "interactive"  # interactive | batch
+
+
+class GenResult(BaseModel):
+    request_id: str
+    status: str
+    s3_image_key: Optional[str] = None
+    metadata_key: Optional[str] = None
+    error: Optional[str] = None
+
+# Simple in-memory asyncio queue — for production, swap to Redis / RabbitMQ + workers
+QUEUE = asyncio.PriorityQueue(MAX_QUEUE)
+WORKERS = []
+
+def _s3_upload_bytes(bucket: str, key: str, data: bytes, content_type="application/octet-stream"):
+    s3 = boto3.client("s3")
+    s3.put_object(Bucket=bucket.replace("s3://", ""), Key=key, Body=data, ContentType=content_type)
+    return f"s3://{bucket.replace('s3://','')}/{key}"
+
+async def diffusers_worker(worker_id: int):
+    # Import the heavy DL dependencies inside worker to avoid cold-start for the API process
+    try:
+        import torch
+        from diffusers import StableDiffusionPipeline
+    except Exception as e:
+        app.logger = getattr(app, "logger", None)
+        print("Worker failed to import DL libs:", e)
+        return
+
+    model_name = os.environ.get("DIFFUSERS_MODEL", MODEL_NAME_DEFAULT)
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    pipe = StableDiffusionPipeline.from_pretrained(model_name, torch_dtype=torch.float16 if device=="cuda" else torch.float32)
+    if device == "cuda":
+        pipe.to(device)
+
+    while True:
+        prio, item = await QUEUE.get()
+        req: GenRequest = item["req"]
+        req_id = item["id"]
+        ts0 = time.time()
+        out = {"request_id": req_id, "status": "failed"}
+        try:
+            seed = req.seed or int((time.time() * 1000) % (2**31-1))
+            generator = None
+            if device == "cuda":
+                generator = torch.Generator(device).manual_seed(seed)
+            # run inference
+            image = pipe(req.prompt, num_inference_steps=req.steps, guidance_scale=req.guidance_scale, height=req.height, width=req.width, generator=generator).images[0]
+            buf = io.BytesIO()
+            image.save(buf, format="PNG")
+            buf.seek(0)
+            image_bytes = buf.read()
+            # evidence upload
+            key_img = f"diffusion/outputs/{req_id}.png"
+            key_meta = f"diffusion/metadata/{req_id}.json"
+            if EVIDENCE_BUCKET:
+                s3img = _s3_upload_bytes(EVIDENCE_BUCKET, key_img, image_bytes, content_type="image/png")
+                meta = {
+                    "request_id": req_id,
+                    "prompt": req.prompt,
+                    "seed": int(seed),
+                    "model": req.model or model_name,
+                    "steps": int(req.steps),
+                    "guidance_scale": float(req.guidance_scale),
+                    "width": int(req.width),
+                    "height": int(req.height),
+                    "timestamp": time.time(),
+                    "s3_image": s3img,
+                }
+                _s3_upload_bytes(EVIDENCE_BUCKET, key_meta, json.dumps(meta).encode("utf-8"), content_type="application/json")
+                out.update({"status":"ok", "s3_image_key": s3img, "metadata_key": f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key_meta}"})
+            else:
+                # local save fallback
+                os.makedirs("/tmp/diffusion_out", exist_ok=True)
+                with open(f"/tmp/diffusion_out/{req_id}.png", "wb") as f:
+                    f.write(image_bytes)
+                out.update({"status":"ok", "s3_image_key": None})
+        except Exception as e:
+            out["status"] = "failed"
+            out["error"] = str(e)
+        # place result into item's future
+        if "future" in item and not item["future"].done():
+            item["future"].set_result(out)
+        QUEUE.task_done()
+        elapsed = time.time() - ts0
+        print(f"worker[{worker_id}] finished req {req_id} status {out.get('status')} elapsed={elapsed:.2f}s")
+
+@app.on_event("startup")
+async def startup_event():
+    # start worker pool
+    for i in range(WORKER_COUNT):
+        w = asyncio.create_task(diffusers_worker(i))
+        WORKERS.append(w)
+
+@app.post("/v1/generate-image", response_model=GenResult)
+async def generate_image(req: GenRequest, background: BackgroundTasks):
+    if QUEUE.qsize() >= MAX_QUEUE:
+        raise HTTPException(status_code=429, detail="Queue full")
+    req_id = str(uuid.uuid4())
+    prio = 0 if req.priority == "interactive" else 1
+    loop = asyncio.get_event_loop()
+    fut = loop.create_future()
+    item = {"id": req_id, "req": req, "future": fut}
+    await QUEUE.put( (prio, item) )
+    # wait with timeout
+    try:
+        res = await asyncio.wait_for(fut, timeout=600)
+    except asyncio.TimeoutError:
+        raise HTTPException(status_code=504, detail="Generation timeout")
+    return GenResult(request_id=req_id, status=res.get("status","failed"), s3_image_key=res.get("s3_image_key"), metadata_key=res.get("metadata_key"), error=res.get("error"))
+
+@app.get("/healthz")
+def health():
+    return {"status":"ok", "queue_size": QUEUE.qsize()}
+
