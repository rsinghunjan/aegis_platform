+#!/usr/bin/env python3
+"""
+Managed API adapter and simple RAG wiring.
+
+- /v1/chat -> routes to configured managed API (OpenAI/Anthropic) with unified interface and evidence logging.
+- /v1/rag -> performs retrieval via FAISS using embeddings and appends context to prompt before calling managed API.
+"""
+import os
+import json
+import time
+import uuid
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import boto3
+import requests
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY", "")
+EMBED_MODEL = os.environ.get("EMBED_MODEL", "sentence-transformers/all-MiniLM-L6-v2")
+
+app = FastAPI(title="Aegis Managed LLM Adapter")
+
+class ChatReq(BaseModel):
+    prompt: str
+    user: str = "unknown"
+    model: str = "openai/gpt-4"  # logical model name
+
+def _upload_json(bucket, key, obj):
+    s3 = boto3.client("s3")
+    s3.put_object(Bucket=bucket.replace("s3://",""), Key=key, Body=json.dumps(obj).encode("utf-8"), ContentType="application/json")
+    return f"s3://{bucket.replace('s3://','')}/{key}"
+
+def call_openai(prompt: str, model: str = "gpt-4"):
+    # PoC: minimal call using requests; in production use official client with retries and telemetry
+    if not OPENAI_API_KEY:
+        raise RuntimeError("OPENAI_API_KEY not configured")
+    url = "https://api.openai.com/v1/chat/completions"
+    headers = {"Authorization": f"Bearer {OPENAI_API_KEY}", "Content-Type": "application/json"}
+    payload = {"model": model, "messages":[{"role":"user","content":prompt}], "temperature":0.2}
+    r = requests.post(url, headers=headers, json=payload, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+@app.post("/v1/chat")
+def chat(req: ChatReq):
+    req_id = str(uuid.uuid4())
+    ts = time.time()
+    try:
+        resp = call_openai(req.prompt, model=req.model)
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
+    # evidence upload
+    if EVIDENCE_BUCKET:
+        meta = {"id": req_id, "user": req.user, "prompt": req.prompt, "model": req.model, "response": resp, "ts": ts}
+        key = f"llm/managed/{req_id}.json"
+        _upload_json(EVIDENCE_BUCKET, key, meta)
+    return {"request_id": req_id, "response": resp}
+
+################ RAG ####################################
+try:
+    import faiss
+    from sentence_transformers import SentenceTransformer
+except Exception:
+    faiss = None
+    SentenceTransformer = None
+
+INDEX = None
+EMBEDDER = None
+
+@app.on_event("startup")
+def init_index():
+    global INDEX, EMBEDDER
+    if SentenceTransformer:
+        EMBEDDER = SentenceTransformer(EMBED_MODEL)
+    # For PoC, initialize empty index
+    if faiss:
+        INDEX = faiss.IndexFlatL2(384)
+
+class RagReq(BaseModel):
+    query: str
+    top_k: int = 4
+    user: str = "unknown"
+    model: str = "gpt-4"
+
+@app.post("/v1/rag")
+def rag(req: RagReq):
+    if EMBEDDER is None or INDEX is None:
+        raise HTTPException(status_code=500, detail="RAG components not available (missing faiss or embedder)")
+    q_emb = EMBEDDER.encode([req.query])
+    D, I = INDEX.search(q_emb.astype("float32"), req.top_k)
+    # For PoC, pretend we retrieved text snippets
+    snippets = [f"retrieved-snippet-{i}" for i in range(req.top_k)]
+    # build augmented prompt
+    augmented = "Context:\n" + "\n".join(snippets) + f"\n\nUser Query: {req.query}"
+    resp = call_openai(augmented, model=req.model)
+    # audit
+    req_id = str(uuid.uuid4())
+    if EVIDENCE_BUCKET:
+        _upload_json(EVIDENCE_BUCKET, f"llm/rag/{req_id}.json", {"query": req.query, "snippets": snippets, "response": resp})
+    return {"request_id": req_id, "response": resp, "snippets": snippets}
+
+@app.get("/healthz")
+def health():
+    return {"status":"ok"}
+
