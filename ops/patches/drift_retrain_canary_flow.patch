+#!/usr/bin/env python3
+"""
+Drift detector service (PoC) using evidently to detect feature drift and trigger a retrain pipeline.
+
+Behavior:
+ - Loads a small sample of latest input data (from S3 or DB)
+ - Compares against baseline dataset snapshot (S3)
+ - Computes drift metric (e.g., Data Drift via evidently)
+ - Exposes Prometheus metric `aegis_data_drift_score{dataset=...}`
+ - When drift_score > DRIFT_THRESHOLD, triggers the Tekton retrain Pipeline via Kubernetes API or a Tekton Trigger endpoint.
+
+Config (env):
+ - BASELINE_S3_URI: s3://bucket/path/to/baseline.parquet
+ - LATEST_S3_URI: s3://bucket/path/to/latest_sample.parquet
+ - EVIDENCE_BUCKET: where to upload detector evidence (optional)
+ - DRIFT_THRESHOLD: float (default 0.1)
+ - TEKTON_TRIGGER_URL: optional webhook URL to trigger pipeline
+ - TEKTON_NAMESPACE: default cicd
+ - PROM_PORT: default 8000
+"""
+import os
+import time
+import logging
+import tempfile
+import json
+from prometheus_client import start_http_server, Gauge
+
+logger = logging.getLogger("drift-detector")
+logging.basicConfig(level=logging.INFO)
+
+BASELINE = os.environ.get("BASELINE_S3_URI", "")
+LATEST = os.environ.get("LATEST_S3_URI", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+DRIFT_THRESHOLD = float(os.environ.get("DRIFT_THRESHOLD", "0.1"))
+TEKTON_TRIGGER_URL = os.environ.get("TEKTON_TRIGGER_URL", "")
+TEKTON_NAMESPACE = os.environ.get("TEKTON_NAMESPACE", "cicd")
+PROM_PORT = int(os.environ.get("PROM_PORT", "8000"))
+
+DRIFT_GAUGE = Gauge("aegis_data_drift_score", "Data drift score for dataset", ["dataset"])
+
+def _download_s3_to_local(s3_uri):
+    if not s3_uri.startswith("s3://"):
+        return s3_uri
+    import boto3, botocore
+    s3 = boto3.client("s3")
+    _, rest = s3_uri.split("s3://", 1)
+    bucket, key = rest.split("/", 1)
+    local = tempfile.NamedTemporaryFile(delete=False, suffix=".parquet").name
+    s3.download_file(bucket, key, local)
+    return local
+
+def compute_drift(baseline_path, latest_path):
+    try:
+        # import here to fail gracefully if library missing
+        from evidently.report import Report
+        from evidently.metric_preset import DataDriftPreset
+        import pandas as pd
+        base = pd.read_parquet(baseline_path)
+        latest = pd.read_parquet(latest_path)
+        report = Report(metrics=[DataDriftPreset()])
+        report.run(reference_data=base, current_data=latest)
+        res = report.as_dict()
+        # This is a simplification: take summary drift score if present
+        drift_score = 0.0
+        for metric in res.get("metrics", []):
+            if metric.get("metric") == "DataDriftPreset":
+                # metric structure varies; attempt to read dataset_drift share
+                value = metric.get("result", {}).get("dataset_drift", {}).get("share", 0.0)
+                drift_score = float(value or 0.0)
+        return drift_score, res
+    except Exception as e:
+        logger.exception("Evidently drift computation failed: %s", e)
+        return 0.0, {"error": str(e)}
+
+def upload_evidence(prefix, payload):
+    if not EVIDENCE_BUCKET:
+        p = f"/tmp/{prefix.replace('/','_')}-{int(time.time())}.json"
+        with open(p, "w") as f:
+            json.dump(payload, f, indent=2)
+        logger.info("Wrote evidence locally: %s", p)
+        return p
+    try:
+        import boto3
+        s3 = boto3.client("s3")
+        key = f"{prefix}/{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode())
+        uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+        logger.info("Uploaded evidence: %s", uri)
+        return uri
+    except Exception as e:
+        logger.exception("Evidence upload failed: %s", e)
+        return None
+
+def trigger_retrain(payload):
+    if TEKTON_TRIGGER_URL:
+        try:
+            import requests
+            r = requests.post(TEKTON_TRIGGER_URL, json=payload, timeout=10)
+            r.raise_for_status()
+            logger.info("Triggered Tekton Trigger: %s", r.text)
+            return True
+        except Exception:
+            logger.exception("Failed to call Tekton trigger webhook; falling back to kubectl apply")
+    # fallback: write PipelineRun YAML to /tmp and apply via kubectl (requires in-cluster service account)
+    try:
+        pr = {
+            "apiVersion": "tekton.dev/v1beta1",
+            "kind": "PipelineRun",
+            "metadata": {"generateName": "drift-retrain-run-"},
+            "spec": {
+                "pipelineRef": {"name": "drift-retrain-canary-pipeline"},
+                "params": [
+                    {"name":"dataset_snapshot_s3","value": BASELINE or ""},
+                    {"name":"evidence_bucket","value": EVIDENCE_BUCKET or ""}
+                ]
+            }
+        }
+        import tempfile, subprocess, yaml
+        f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+        f.write(yaml.dump(pr).encode()); f.close()
+        subprocess.check_call(["kubectl", "apply", "-f", f.name])
+        logger.info("Applied PipelineRun via kubectl: %s", f.name)
+        return True
+    except Exception:
+        logger.exception("Failed to create PipelineRun via kubectl")
+        return False
+
+def run_loop(poll_interval=300):
+    start_http_server(PROM_PORT)
+    logger.info("Started Prometheus metrics on port %d", PROM_PORT)
+    while True:
+        try:
+            baseline_local = _download_s3_to_local(BASELINE) if BASELINE else None
+            latest_local = _download_s3_to_local(LATEST) if LATEST else None
+            if not baseline_local or not latest_local:
+                logger.warning("Missing baseline or latest sample; skipping run")
+            else:
+                score, details = compute_drift(baseline_local, latest_local)
+                DRIFT_GAUGE.labels(dataset="default").set(score)
+                upload_evidence("drift/detector", {"score": score, "details": details})
+                logger.info("Drift score=%s", score)
+                if score >= DRIFT_THRESHOLD:
+                    logger.warning("Drift threshold exceeded: %s >= %s -> triggering retrain", score, DRIFT_THRESHOLD)
+                    trigger_retrain({"score": score, "dataset": "default"})
+        except Exception:
+            logger.exception("Drift detector loop error")
+        time.sleep(poll_interval)
+
+if __name__ == "__main__":
+    run_loop()
+
