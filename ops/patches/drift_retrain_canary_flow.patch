+#!/usr/bin/env python3
+"""
+Canary monitor & rollback controller (PoC).
+ - Monitors a business metric for canary vs baseline via Prometheus HTTP API
+ - If canary metric drops by more than REL_DROP_THRESHOLD relative to baseline for WINDOW seconds, triggers rollback:
+   - deletes/scales down the canary deployment and uploads rollback evidence to EVIDENCE_BUCKET
+
+Config (env):
+ - PROM_URL: http://prometheus.monitoring.svc:9090
+ - CANARY_DEPLOYMENT: name of canary deployment (default: model-canary)
+ - BASELINE_SERVICE_LABEL: app=production-model
+ - METRIC_EXPR_CANARY: PromQL expression to measure canary (e.g. sum(rate(model_success_count{app="model-canary"}[1m])))
+ - METRIC_EXPR_BASELINE: same for baseline
+ - REL_DROP_THRESHOLD: relative drop threshold (0.05 => 5%)
+ - WINDOW: seconds over which to evaluate degradation (default 300)
+ - EVIDENCE_BUCKET: optional S3
+"""
+import os, time, logging, subprocess, json
+from datetime import datetime
+
+logger = logging.getLogger("canary-controller")
+logging.basicConfig(level=logging.INFO)
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+CANARY = os.environ.get("CANARY_DEPLOYMENT", "model-canary")
+METRIC_CANARY = os.environ.get("METRIC_EXPR_CANARY", 'sum(rate(model_success_count{app="model-canary"}[1m]))')
+METRIC_BASE = os.environ.get("METRIC_EXPR_BASELINE", 'sum(rate(model_success_count{app="production-model"}[1m]))')
+REL_DROP_THRESHOLD = float(os.environ.get("REL_DROP_THRESHOLD", "0.1"))
+WINDOW = int(os.environ.get("WINDOW", "300"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def prom_query(expr):
+    import requests
+    try:
+        r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": expr}, timeout=10)
+        r.raise_for_status()
+        data = r.json()
+        v = 0.0
+        if data.get("data", {}).get("result"):
+            # take first result value
+            val = data["data"]["result"][0]["value"][1]
+            v = float(val)
+        return v
+    except Exception:
+        logger.exception("Prometheus query failed for %s", expr)
+        return 0.0
+
+def upload_evidence(prefix, payload):
+    if not EVIDENCE_BUCKET:
+        p = f"/tmp/{prefix.replace('/','_')}-{int(time.time())}.json"
+        with open(p, "w") as f:
+            json.dump(payload, f, indent=2)
+        logger.info("Wrote evidence locally: %s", p)
+        return p
+    try:
+        import boto3
+        s3 = boto3.client("s3")
+        key = f"{prefix}/{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode())
+        uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+        logger.info("Uploaded evidence: %s", uri)
+        return uri
+    except Exception:
+        logger.exception("Upload failed")
+        return None
+
+def rollback_canary():
+    try:
+        subprocess.check_call(["kubectl","-n","monitoring","delete","deployment",CANARY])
+        payload = {"action":"rollback", "deployment": CANARY, "ts": datetime.utcnow().isoformat()}
+        upload_evidence("canary/rollback", payload)
+        logger.warning("Canary %s rolled back", CANARY)
+    except Exception:
+        logger.exception("Rollback failed")
+
+def run_loop(interval=30):
+    while True:
+        try:
+            canary_v = prom_query(METRIC_CANARY)
+            baseline_v = prom_query(METRIC_BASE)
+            logger.info("Canary=%s baseline=%s", canary_v, baseline_v)
+            # avoid divide by zero
+            if baseline_v <= 0:
+                logger.warning("Baseline metric zero or missing; skipping check")
+            else:
+                rel_drop = (baseline_v - canary_v) / baseline_v
+                if rel_drop >= REL_DROP_THRESHOLD:
+                    logger.warning("Relative drop %s >= threshold %s -> rollback", rel_drop, REL_DROP_THRESHOLD)
+                    rollback_canary()
+        except Exception:
+            logger.exception("Canary monitor loop error")
+        time.sleep(interval)
+
+if __name__ == "__main__":
+    run_loop()
+
