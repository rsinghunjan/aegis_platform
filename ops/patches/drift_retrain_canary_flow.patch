+apiVersion: tekton.dev/v1beta1
+kind: Task
+metadata:
+  name: hpo-train
+  namespace: cicd
+spec:
+  params:
+    - name: s3_artifact_bucket
+      type: string
+    - name: evidence_bucket
+      type: string
+  steps:
+    - name: run-training
+      image: python:3.10
+      script: |
+        #!/bin/sh
+        set -euo pipefail
+        pip install boto3 optuna scikit-learn joblib || true
+        python - <<'PY'
+import os, time, json, boto3, joblib
+import optuna
+from sklearn.ensemble import RandomForestClassifier
+from sklearn.model_selection import cross_val_score
+import numpy as np
+
+def load_training_data():
+    # PoC: load from /workspace/data or from S3 if present
+    import pandas as pd
+    p = "/workspace/data/train.parquet"
+    if not os.path.exists(p):
+        # create synthetic dataset
+        from sklearn.datasets import make_classification
+        X, y = make_classification(n_samples=1000, n_features=10, n_informative=5)
+        df = pd.DataFrame(X, columns=[f"f{i}" for i in range(X.shape[1])])
+        df["label"] = y
+        df.to_parquet(p)
+    return pd.read_parquet(p)
+
+data = load_training_data()
+X = data.drop(columns=["label"]).values
+y = data["label"].values
+
+def objective(trial):
+    n_estimators = trial.suggest_int("n_estimators", 16, 256)
+    max_depth = trial.suggest_int("max_depth", 2, 20)
+    clf = RandomForestClassifier(n_estimators=n_estimators, max_depth=max_depth, n_jobs=1)
+    scores = cross_val_score(clf, X, y, cv=3, scoring="accuracy")
+    return float(np.mean(scores))
+
+study = optuna.create_study(direction="maximize")
+study.optimize(objective, n_trials=8)
+best = study.best_params
+print("Best params:", best)
+clf = RandomForestClassifier(**best)
+clf.fit(X, y)
+model_path = "/workspace/artifacts/model.joblib"
+joblib.dump(clf, model_path)
+
+# upload model to S3
+bucket = os.environ.get("S3_ARTIFACT_BUCKET", "")
+if bucket:
+    s3 = boto3.client("s3")
+    key = f"models/retrain-{int(time.time())}.joblib"
+    s3.upload_file(model_path, bucket, key)
+    model_s3 = f"s3://{bucket}/{key}"
+else:
+    model_s3 = model_path
+
+evidence = {"model_s3": model_s3, "params": best, "ts": int(time.time())}
+evidence_path = f"/workspace/artifacts/evidence-{int(time.time())}.json"
+with open(evidence_path, "w") as f:
+    json.dump(evidence, f)
+
+eb = os.environ.get("EVIDENCE_BUCKET","")
+if eb:
+    s3 = boto3.client("s3")
+    s3.put_object(Bucket=eb, Key=f"retrain/evidence-{int(time.time())}.json", Body=json.dumps(evidence).encode())
+    print("Uploaded evidence to s3")
+print("Training & HPO finished. model:", model_s3)
+print(json.dumps(evidence))
+PY
