+// Minimal Office Add-in Taskpane using MSAL to get a user token and call backend proxy.
+// Configure below:
+const MSAL_CLIENT_ID = "<YOUR_AZURE_APP_CLIENT_ID>";
+const MSAL_TENANT = "<YOUR_TENANT_ID_OR_COMMON>";
+const BACKEND_BASE = "<https://aegis-proxy.example.com>"; // replace with deployed backend proxy URL
+
+const msalConfig = {
+  auth: {
+    clientId: MSAL_CLIENT_ID,
+    authority: `https://login.microsoftonline.com/${MSAL_TENANT}`
+  }
+};
+const msalInstance = new msal.PublicClientApplication(msalConfig);
+const loginRequest = { scopes: ["openid", "profile", "email"] };
+
+async function getAccessToken() {
+  // interactive login if no account
+  const accounts = msalInstance.getAllAccounts();
+  if (accounts.length === 0) {
+    await msalInstance.loginPopup(loginRequest);
+  }
+  try {
+    const resp = await msalInstance.acquireTokenSilent({ scopes: loginRequest.scopes, account: msalInstance.getAllAccounts()[0] });
+    return resp.accessToken;
+  } catch (e) {
+    const resp = await msalInstance.acquireTokenPopup(loginRequest);
+    return resp.accessToken;
+  }
+}
+
+document.addEventListener("DOMContentLoaded", function() {
+  document.getElementById("btnAsk").onclick = async () => {
+    const p = document.getElementById("prompt").value;
+    const token = await getAccessToken();
+    const r = await fetch(`${BACKEND_BASE}/api/rag/infer`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", "Authorization": `Bearer ${token}` },
+      body: JSON.stringify({ prompt: p, mode: "evidence_required", top_k: 5 })
+    });
+    const j = await r.json();
+    document.getElementById("answer").innerText = j.result?.answer || JSON.stringify(j);
+    document.getElementById("verifier").innerText = JSON.stringify(j.verifier || {});
+    document.getElementById("provenance").innerText = JSON.stringify(j.provenance || []);
+  };
+
+  document.getElementById("btnInsert").onclick = async () => {
+    const ans = document.getElementById("answer").innerText;
+    await Excel.run(async (context) => {
+      const range = context.workbook.getSelectedRange();
+      range.values = [[ans]];
+      await context.sync();
+    });
+  };
+
+  document.getElementById("btnReview").onclick = async () => {
+    const token = await getAccessToken();
+    const payload = {
+      text: document.getElementById("prompt").value,
+      output: document.getElementById("answer").innerText,
+      provenance: document.getElementById("provenance").innerText,
+      severity: "medium"
+    };
+    const r = await fetch(`${BACKEND_BASE}/api/enqueue`, {
+      method: "POST",
+      headers: { "Content-Type":"application/json", "Authorization": `Bearer ${token}` },
+      body: JSON.stringify(payload)
+    });
+    const j = await r.json();
+    alert("Enqueue response: " + JSON.stringify(j));
+  };
+});
+
