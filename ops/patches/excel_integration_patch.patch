+"""Aegis Excel Backend Proxy
+
+Responsibilities:
+- Validate incoming MSAL / OIDC bearer tokens from the Excel Add-in (config via OIDC_ISSUER and CLIENT_ID)
+- Proxy inference requests to internal Aegis RAG service using SERVICE_API_KEY
+- Provide reports endpoint for Power Query (CSV/JSON) protected by same auth
+- Expose an enqueue endpoint that forwards "request review" calls to human_queue service
+
+Configure via environment variables:
+ - OIDC_ISSUER (e.g. https://login.microsoftonline.com/{tenant}/v2.0)
+ - CLIENT_ID (Azure app client id used by Add-in)
+ - AEGIS_RAG_URL (internal RAG endpoint, e.g. http://rag-service.svc:8080/infer)
+ - AEGIS_REPORTS_URL (internal reporting endpoint returning JSON/CSV)
+ - SERVICE_API_KEY (secret allowing this proxy to call internal Aegis services)
+ - HUMAN_QUEUE_URL (http endpoint for human_queue.enqueue)
+ - LOG_PATH (optional)
+"""
+import os
+import time
+import json
+from typing import Dict, Any
+import requests
+from fastapi import FastAPI, Header, HTTPException, Request
+from pydantic import BaseModel
+from jose import jwt
+from jose.exceptions import JWTError
+from cachetools import TTLCache
+
+OIDC_ISSUER = os.environ.get("OIDC_ISSUER", "")
+CLIENT_ID = os.environ.get("CLIENT_ID", "")
+AEGIS_RAG_URL = os.environ.get("AEGIS_RAG_URL", "http://rag-service.svc:8080/infer")
+AEGIS_REPORTS_URL = os.environ.get("AEGIS_REPORTS_URL", "http://aegis-reports.svc:8080")
+SERVICE_API_KEY = os.environ.get("SERVICE_API_KEY", "")
+HUMAN_QUEUE_URL = os.environ.get("HUMAN_QUEUE_URL", "http://human-queue.safety.svc:80/enqueue")
+LOG_PATH = os.environ.get("LOG_PATH", "/tmp/aegis_excel_proxy.log")
+
+app = FastAPI(title="Aegis Excel Proxy")
+
+# JWKS caching
+JWKS_CACHE = TTLCache(maxsize=1, ttl=3600)
+
+def fetch_jwks():
+    if "jwks" in JWKS_CACHE:
+        return JWKS_CACHE["jwks"]
+    if not OIDC_ISSUER:
+        raise RuntimeError("OIDC_ISSUER not configured")
+    well_known = OIDC_ISSUER.rstrip("/") + "/.well-known/openid-configuration"
+    r = requests.get(well_known, timeout=5)
+    r.raise_for_status()
+    jwks_uri = r.json().get("jwks_uri")
+    if not jwks_uri:
+        raise RuntimeError("jwks_uri not found in OIDC configuration")
+    jwks = requests.get(jwks_uri, timeout=5).json()
+    JWKS_CACHE["jwks"] = jwks
+    return jwks
+
+def validate_bearer_token(token: str) -> Dict[str, Any]:
+    """Validate incoming OIDC token (minimal checks)."""
+    jwks = fetch_jwks()
+    try:
+        # note: algorithms could be retrieved from jwks; for MS use RS256
+        payload = jwt.decode(token, jwks, audience=CLIENT_ID, issuer=OIDC_ISSUER, algorithms=['RS256'])
+        return payload
+    except JWTError as e:
+        raise HTTPException(status_code=401, detail=f"Invalid token: {e}")
+
+def log_event(obj: Dict[str, Any]):
+    try:
+        with open(LOG_PATH, "a") as f:
+            f.write(json.dumps({"ts": int(time.time()), **obj}) + "\n")
+    except Exception:
+        pass
+
+class InferRequest(BaseModel):
+    prompt: str
+    mode: str = "evidence_required"
+    top_k: int = 5
+
+@app.post("/api/rag/infer")
+def rag_infer(req: InferRequest, authorization: str = Header(None)):
+    if not authorization or not authorization.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Missing Authorization header")
+    token = authorization.split(" ", 1)[1]
+    user = validate_bearer_token(token)
+    # proxy to Aegis RAG
+    payload = {"prompt": req.prompt, "mode": req.mode, "top_k": req.top_k, "requester": user.get("upn") or user.get("preferred_username") or user.get("sub")}
+    headers = {"Authorization": f"Bearer {SERVICE_API_KEY}", "Content-Type": "application/json"}
+    r = requests.post(AEGIS_RAG_URL, json=payload, headers=headers, timeout=30)
+    if r.status_code != 200:
+        raise HTTPException(status_code=502, detail="Upstream RAG error")
+    resp = r.json()
+    # Log for audit / evidence store (also upstream Aegis should log)
+    log_event({"type":"excel_infer","user":user.get("sub"), "prompt": req.prompt, "verifier": resp.get("verifier"), "provenance": resp.get("provenance")})
+    return resp
+
+@app.get("/api/reports/predictions")
+def reports_predictions(model: str = "qa", format: str = "json", authorization: str = Header(None)):
+    """Power Query friendly endpoint: proxies to AEGIS_REPORTS_URL and enforces auth."""
+    if not authorization or not authorization.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Missing Authorization header")
+    _ = validate_bearer_token(authorization.split(" ",1)[1])
+    target = f"{AEGIS_REPORTS_URL}/predictions?model={model}&format={format}"
+    headers = {"Authorization": f"Bearer {SERVICE_API_KEY}"}
+    r = requests.get(target, headers=headers, timeout=30, stream=True)
+    if r.status_code != 200:
+        raise HTTPException(status_code=502, detail="Upstream reports error")
+    # stream response (FastAPI supports StreamingResponse, but return raw content for simplicity)
+    if format.lower() == "csv":
+        return Response(content=r.content, media_type="text/csv")
+    return r.json()
+
+@app.post("/api/enqueue")
+def enqueue_for_review(body: Dict[str, Any], authorization: str = Header(None)):
+    """Forward a request to human_queue.enqueue. Body should include text, output, provenance, severity."""
+    if not authorization or not authorization.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Missing Authorization header")
+    user = validate_bearer_token(authorization.split(" ",1)[1])
+    payload = dict(body)
+    payload["reported_by"] = user.get("upn") or user.get("preferred_username") or user.get("sub")
+    # forward to human queue
+    headers = {"Content-Type":"application/json"}
+    try:
+        r = requests.post(HUMAN_QUEUE_URL, json=payload, headers=headers, timeout=10)
+    except Exception as e:
+        raise HTTPException(status_code=502, detail=f"Failed to call human queue: {e}")
+    if r.status_code not in (200,201,202):
+        raise HTTPException(status_code=502, detail="Human queue error")
+    log_event({"type":"enqueue","user":payload["reported_by"], "severity": payload.get("severity")})
+    return r.json()
+
+@app.get("/.well-known/health")
+def health():
+    return {"status":"ok"}
+
