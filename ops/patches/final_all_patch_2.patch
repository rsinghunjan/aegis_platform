+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple Postgres backup/restore helper (operator-run).
+#
+usage() {
+  cat <<EOF
+Usage: $0 [backup|restore] --db-url <DATABASE_URL> --out <file>
+
+Examples:
+  ./pg_backup_restore.sh backup --db-url postgresql://user:pass@host:5432/aegis --out /tmp/aegis.dump
+  ./pg_backup_restore.sh restore --db-url postgresql://user:pass@host:5432/aegis --in /tmp/aegis.dump
+EOF
+}
+
+if [ $# -lt 1 ]; then usage; exit 2; fi
+CMD="$1"; shift
+
+DB_URL=""
+OUT=""
+IN=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --db-url) DB_URL="$2"; shift 2;;
+    --out) OUT="$2"; shift 2;;
+    --in) IN="$2"; shift 2;;
+    *) echo "Unknown: $1"; usage; exit 2;;
+  esac
+done
+
+if [ "$CMD" = "backup" ]; then
+  if [ -z "$DB_URL" ] || [ -z "$OUT" ]; then echo "Missing params"; usage; exit 2; fi
+  echo "Running pg_dump to $OUT"
+  PGPASSWORD=$(echo "$DB_URL" | sed -n 's/.*:\(.*\)@.*/\1/p') pg_dump -Fc "$DB_URL" -f "$OUT"
+  echo "Backup complete"
+elif [ "$CMD" = "restore" ]; then
+  if [ -z "$DB_URL" ] || [ -z "$IN" ]; then echo "Missing params"; usage; exit 2; fi
+  echo "Restoring from $IN"
+  PGPASSWORD=$(echo "$DB_URL" | sed -n 's/.*:\(.*\)@.*/\1/p') pg_restore -d "$DB_URL" -c "$IN"
+  echo "Restore complete"
+else
+  echo "Unknown command $CMD"
+  usage; exit 2
+fi
+
