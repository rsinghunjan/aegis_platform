+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate CI secrets (operator-run). Example: rotate DB password and update CI secret store.
+#
+if [ $# -lt 2 ]; then
+  echo "Usage: $0 <secret-name> <new-value>"
+  exit 2
+fi
+NAME="$1"
+VALUE="$2"
+echo "Rotating secret $NAME in CI (operator must have GH CLI or use provider API)"
+# Example using gh CLI (ensure authenticated with sufficient perms)
+if command -v gh >/dev/null 2>&1; then
+  gh secret set "$NAME" --body "$VALUE"
+  echo "Updated GitHub Actions secret: $NAME"
+else
+  echo "gh CLI not available; operator must update secret via provider console"
+fi
