+#!/usr/bin/env python3
+"""
+Simple SME reminder: finds unapproved high-priority invariants and creates a short GitHub comment/issue to notify SMEs.
+"""
+import glob, json, os, requests
+
+GITHUB_API="https://api.github.com"
+
+def gh_headers(token):
+    return {"Authorization":f"token {token}","Accept":"application/vnd.github+json"}
+
+def find_unapproved():
+    out=[]
+    for meta in glob.glob("ops/formal/onboard_submissions/*.meta.json"):
+        m=json.load(open(meta))
+        if m.get("priority")=="high" and not m.get("sme_approved"):
+            out.append((meta,m))
+    return out
+
+def create_issue(repo, token, title, body):
+    r = requests.post(f"{GITHUB_API}/repos/{repo}/issues", headers=gh_headers(token), json={"title":title,"body":body,"labels":["sme","reminder"]})
+    return r.status_code, r.json().get("html_url")
+
+def main():
+    repo = os.environ.get("GITHUB_REPOSITORY")
+    token = os.environ.get("GITHUB_TOKEN")
+    if not repo or not token:
+        print("GITHUB_REPOSITORY and GITHUB_TOKEN required"); return
+    items = find_unapproved()
+    if not items:
+        print("No unapproved items")
+        return
+    body = "SME reminder: the following high-priority invariants await SME approval:\n\n"
+    for meta,_ in items:
+        body += f"- {meta}\n"
+    status,url = create_issue(repo, token, "SME Approval Reminder: High-priority invariants", body)
+    print("Created reminder issue:", status, url)
+
+if __name__=="__main__":
+    main()
+
