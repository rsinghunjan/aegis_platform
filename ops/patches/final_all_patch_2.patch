+#!/usr/bin/env python3
+"""
+Send a PagerDuty trigger for critical incidents.
+Set PD_INTEGRATION_KEY env before running.
+"""
+import os, requests, json
+
+PD_KEY = os.environ.get("PD_INTEGRATION_KEY")
+PD_URL = "https://events.pagerduty.com/v2/enqueue"
+
+def trigger(summary, severity="critical", source="aegis"):
+    if not PD_KEY:
+        print("PD key not set; skipping notification")
+        return
+    payload = {
+        "routing_key": PD_KEY,
+        "event_action": "trigger",
+        "payload": {
+            "summary": summary,
+            "severity": severity,
+            "source": source
+        }
+    }
+    r = requests.post(PD_URL, json=payload)
+    print("PagerDuty status", r.status_code, r.text)
+
+if __name__=="__main__":
+    import sys
+    trigger("Aegis critical alert: " + " ".join(sys.argv[1:]))
+
