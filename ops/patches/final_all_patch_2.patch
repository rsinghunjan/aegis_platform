+#!/usr/bin/env bash
+set -euo pipefail
+#
+# AK rotation helper (operator-run). Rotates stored AK public keys on verifier host.
+#
+OUTDIR=${1:-/opt/ak_pub_pool}
+mkdir -p "$OUTDIR"
+echo "Rotating AK public key pool - operator must place new AK pub PEM into $OUTDIR/new_ak_pub.pem and run this script"
+if [ ! -f "$OUTDIR/new_ak_pub.pem" ]; then
+  echo "Place new_ak_pub.pem in $OUTDIR and re-run"
+  exit 1
+fi
+mv "$OUTDIR/current_ak_pub.pem" "$OUTDIR/old_ak_pub_$(date -u +%Y%m%d%H%M%S).pem" || true
+mv "$OUTDIR/new_ak_pub.pem" "$OUTDIR/current_ak_pub.pem"
+echo "AK rotation completed; update OTA verifier AK_PUB_PATH env if needed"
+
