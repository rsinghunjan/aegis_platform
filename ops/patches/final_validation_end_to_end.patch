+        env = os.environ.copy()
+        env["HPO_SAMPLES"] = str(HPO_SAMPLES)
+        env["HPO_PARALLEL"] = "1"
+        env["HPO_TEAM"] = f"validation-{i}"
+        # reuse existing submitter script
+        try:
+            out = run_cmd(["python3", "services/hpo/scale_hpo_submitter.py"], capture=True)
+            submitted.append(out)
+        except Exception:
+            logger.exception("submit failed for parallel index %d", i)
+    # upload manifest of submissions
+    manifest_path = "/tmp/hpo_submissions_manifest.json"
