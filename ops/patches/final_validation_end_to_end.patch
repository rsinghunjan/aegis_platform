+#!/usr/bin/env python3
+"""
+Evidence bundler and signer:
+ - Collects evidence objects (paths or S3 prefixes), bundles them into a tarball
+ - Signs the tarball with cosign (if key present) and uploads tar + sig to evidence bucket
+ - Produces a manifest.json with list of uploaded artifacts and signatures
+"""
+import os, json, tempfile, subprocess, logging, tarfile
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("evidence-bundler")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_KEY = os.environ.get("COSIGN_KEY_PATH", "/secrets/cosign.key")
+
+def collect_local(paths, outdir):
+    for p in paths:
+        if os.path.exists(p):
+            subprocess.check_call(["cp", "-r", p, outdir])
+
+def bundle_and_sign(paths):
+    tmp = tempfile.mkdtemp(prefix="evidence-")
+    collect_local(paths, tmp)
+    tarball = f"/tmp/evidence-bundle-{int(time.time())}.tar.gz"
+    with tarfile.open(tarball, "w:gz") as tf:
+        tf.add(tmp, arcname="evidence")
+    sig = None
+    if os.path.exists(COSIGN_KEY):
+        try:
+            subprocess.check_call(["cosign", "sign-blob", "--key", COSIGN_KEY, tarball])
+            sig = tarball + ".sig"
+        except Exception:
+            logger.exception("cosign sign failed")
+    # upload to S3
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        bucket=EVIDENCE_BUCKET.replace("s3://","")
+        key=f"bundles/{os.path.basename(tarball)}"
+        s3.upload_file(tarball, bucket, key)
+        if sig and os.path.exists(sig):
+            s3.upload_file(sig, bucket, f"{key}.sig")
+        manifest={"tar": f"s3://{bucket}/{key}", "sig": f"s3://{bucket}/{key}.sig" if sig else None, "ts": datetime.utcnow().isoformat()}
+        keym=f"bundles/{os.path.basename(tarball)}.manifest.json"
+        s3.put_object(Bucket=bucket, Key=keym, Body=json.dumps(manifest).encode())
+        logger.info("Uploaded evidence bundle & manifest to s3://%s/%s", bucket, keym)
+        return manifest
+    else:
+        logger.warning("No evidence bucket configured; leaving bundle at %s", tarball)
+        return {"tar": tarball, "sig": sig}
+
+if __name__ == "__main__":
+    import sys
+    paths = sys.argv[1:] if len(sys.argv) > 1 else ["/tmp"]
+    manifest = bundle_and_sign(paths)
+    print(json.dumps(manifest, indent=2))
+
