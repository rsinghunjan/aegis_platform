+#!/usr/bin/env python3
+"""
+Enhanced OPA harness that:
+ - Runs a corpus of canary evaluations through OPA
+ - Compares OPA decisions against expected outcomes (if provided) and reports unexpected permits/denies
+ - Uploads a coverage + mismatch report to evidence bucket
+"""
+import os, json, requests, logging, random, time
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("opa-harness")
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa.monitoring.svc:8181/v1/data/aegis/canary/allow_promote")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def generate_corpus(n=500):
+    corpus=[]
+    for i in range(n):
+        rel = round((i % 20) * 0.01, 3)
+        kpi = round(0.95 - ((i % 30) * 0.01), 3)
+        # expected: permit if rel_drop <= 0.05 and kpi >= 0.8
+        expected = (rel <= 0.05 and kpi >= 0.8)
+        payload={"input":{"kind":"CanaryEvaluation","run_id":f"test-{i}","metrics":{"rel_drop":rel,"business_kpi":kpi},"policy":{"max_rel_drop":0.05,"min_kpi":0.8},"annotations":{"aegis_evidence_uri":"s3://evidence/test"}},"expected": expected}
+        corpus.append(payload)
+    return corpus
+
+def run_corpus(corpus):
+    mismatches=[]
+    decisions={"permit":0, "deny":0}
+    for entry in corpus:
+        inp = entry["input"]
+        expected = entry.get("expected")
+        try:
+            r=requests.post(OPA_URL, json={"input": inp}, timeout=5)
+            r.raise_for_status()
+            allow = r.json().get("result", {}).get("allow_promote", False)
+            decisions["permit" if allow else "deny"] += 1
+            if expected is not None and allow != expected:
+                mismatches.append({"run_id": inp["run_id"], "allow": allow, "expected": expected})
+        except Exception as e:
+            mismatches.append({"run_id": inp.get("run_id"), "error": str(e)})
+    return decisions, mismatches
+
+def upload_report(decisions, mismatches):
+    report = {"ts": datetime.utcnow().isoformat(), "decisions": decisions, "mismatches": mismatches}
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"opa/harness-report-{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(report).encode())
+        logger.info("Uploaded OPA harness report to s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
+    else:
+        print(json.dumps(report, indent=2))
+    # return mismatch rate
+    return len(mismatches), len(mismatches) / (decisions["permit"] + decisions["deny"]) if decisions["permit"] + decisions["deny"] else 0.0
+
+def main():
+    corpus = generate_corpus(int(os.environ.get("OPA_TESTS", "500")))
+    decisions, mismatches = run_corpus(corpus)
+    mism_count, mism_rate = upload_report(decisions, mismatches)
+    print("Decisions:", decisions, "mismatches:", mism_count, "rate:", mism_rate)
+
+if __name__ == "__main__":
+    main()
+
