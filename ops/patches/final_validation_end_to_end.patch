+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Promote Gatekeeper constraints from dryrun -> deny in a controlled way:
+# 1) Run in CI with manual approval (workflow has manual confirmation)
+# 2) This script patches only known constraints listed in ops/gatekeeper/enforce-list.txt
+LIST=${CONSTRAINT_LIST:-ops/gatekeeper/enforce-list.txt}
+if [ ! -f "$LIST" ]; then
+  echo "Constraint list not found: $LIST"
+  exit 1
+fi
+for c in $(cat $LIST | sed '/^\s*#/d' | sed '/^\s*$/d'); do
+  ns=$(echo "$c" | cut -d':' -f1)
+  name=$(echo "$c" | cut -d':' -f2)
+  echo "Promoting constraint $name in $ns to enforcement 'deny'"
+  # patch if exists
+  if kubectl get constraint $name >/dev/null 2>&1; then
+    kubectl patch constraint $name --type='json' -p='[{"op":"replace","path":"/spec/enforcementAction","value":"deny"}]' || true
+  else
+    echo "Constraint $name not found; skipping"
+  fi
+done
+echo "Gatekeeper promotion completed (controlled list)"
+
