+HPO_PARALLEL = int(os.environ.get("HPO_PARALLEL", "8"))
+CHECKPOINT_THRESHOLD = float(os.environ.get("CHECKPOINT_THRESHOLD", "0.9"))
+OTEL_COVERAGE_THRESHOLD = float(os.environ.get("OTEL_COVERAGE_THRESHOLD", "0.9"))
+REMEDIATION_SUCCESS_THRESHOLD = float(os.environ.get("REMEDIATION_SUCCESS_THRESHOLD", "0.9"))
+
+def run_cmd(cmd, capture=True):
+    logger.info("Running: %s", " ".join(cmd))
+    if capture:
+        out = subprocess.check_output(cmd).decode()
+        logger.info("Output len: %d", len(out))
+        return out
+    else:
