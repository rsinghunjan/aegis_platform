+#!/usr/bin/env python3
+"""
+Check OTEL coverage for recent run_ids by querying Jaeger and/or OTEL collector.
+Calculates percentage of critical spans that include run_id and business_kpi attributes.
+Writes summary to evidence bucket (if configured) and prints JSON to stdout.
+"""
+import os, time, logging, requests, json
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("otel-coverage")
+
+JAEGER_QUERY = os.environ.get("JAEGER_QUERY", "http://jaeger-query.monitoring.svc:16686/api/traces")
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def recent_run_ids(limit=50):
+    try:
+        r = requests.get(f"{PROM_URL}/api/v1/label/run_id/values", timeout=10)
+        if r.status_code != 200:
+            return []
+        vals = r.json().get("data", [])
+        return vals[-limit:]
+    except Exception:
+        return []
+
+def check_run(run_id):
+    # Query Jaeger with a simple filter for run_id in tags; PoC: use /api/traces with service param omitted
+    try:
+        resp = requests.get(JAEGER_QUERY, params={"service": "", "limit": 20, "lookback": "1h", "query": f"json.attributes.run_id:{run_id}"}, timeout=10)
+        if resp.status_code != 200:
+            return {"run_id": run_id, "checked": False}
+        traces = resp.json().get("data", [])
+        spans_total = 0
+        spans_with_attrs = 0
+        for t in traces:
+            for s in t.get("spans", []):
+                spans_total += 1
+                tags = s.get("tags", [])
+                has_run_id = any(tg.get("key") == "run_id" for tg in tags)
+                has_kpi = any(tg.get("key") == "business_kpi" for tg in tags)
+                if has_run_id and has_kpi:
+                    spans_with_attrs += 1
+        coverage = (spans_with_attrs / spans_total) if spans_total else 0.0
+        return {"run_id": run_id, "checked": True, "spans_total": spans_total, "spans_with_attrs": spans_with_attrs, "coverage": coverage}
+    except Exception:
+        logger.exception("jaeger query failed for run %s", run_id)
+        return {"run_id": run_id, "checked": False}
+
+def main():
+    run_ids = recent_run_ids(50)
+    report = {"ts": datetime.utcnow().isoformat(), "results": []}
+    for rid in run_ids:
+        res = check_run(rid)
+        report["results"].append(res)
+    # compute aggregate coverage over runs with data
+    covs = [r["coverage"] for r in report["results"] if r.get("checked") and r.get("spans_total", 0) > 0]
+    agg = sum(covs) / len(covs) if covs else 0.0
+    report["coverage"] = agg
+    out = json.dumps(report)
+    print(out)
+    # upload to evidence bucket
+    if EVIDENCE_BUCKET:
+        import boto3
+        key = f"otel/coverage-{int(time.time())}.json"
+        s3 = boto3.client("s3")
+        s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=out.encode())
+        logger.info("Uploaded OTEL coverage report to s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
+
+if __name__ == "__main__":
+    main()
+
