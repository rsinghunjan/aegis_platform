+#!/usr/bin/env python3
+"""
+Compute remediation success metrics from remediation evidence in S3
+ - Expects remediation evidence objects under remediation/<pr_name>/
+ - Each object contains JSON with fields {"remediation_attempted":bool,"attempts":N,"success":bool}
+ - Outputs {"success_rate": X, "total":N} as JSON to stdout and uploads to evidence bucket
+"""
+import os, json, logging, boto3
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("remediation-metrics")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def gather():
+    if not EVIDENCE_BUCKET:
+        return []
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    objs = s3.list_objects_v2(Bucket=bucket, Prefix="remediation/").get("Contents", [])
+    records=[]
+    for o in objs:
+        key=o["Key"]
+        try:
+            obj = s3.get_object(Bucket=bucket, Key=key)
+            body = obj["Body"].read().decode()
+            records.append(json.loads(body))
+        except Exception:
+            continue
+    return records
+
+def compute(records):
+    total=len(records)
+    success=sum(1 for r in records if r.get("success", False) or r.get("remediation_attempted") and not r.get("escalated", False))
+    rate = success / total if total else 0.0
+    return {"total": total, "success": success, "success_rate": rate, "ts": datetime.utcnow().isoformat()}
+
+def main():
+    recs=gather()
+    summary=compute(recs)
+    out=json.dumps(summary)
+    print(out)
+    if EVIDENCE_BUCKET:
+        s3=boto3.client("s3")
+        key=f"remediation/metrics-{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=out.encode())
+        logger.info("Uploaded remediation metrics to s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
+
+if __name__ == "__main__":
+    main()
+
