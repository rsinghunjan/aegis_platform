+#!/usr/bin/env bash
+set -euo pipefail
+# This script simulates a drift event and waits for the auto-fallback controller to act.
+DRIFT_SCORE=${1:-1.0}
+EVIDENCE_PATH=${EVIDENCE_PATH:-/tmp/last_drift.json}
+TARGET_DEP=${TARGET_DEPLOYMENT:-monitoring/gen-deployment}
+FALLBACK_IMAGE=${FALLBACK_IMAGE:-"ghcr.io/example/aegis-gen:baseline"}
+
+echo "{\"ts\": $(date +%s), \"drift_score\": ${DRIFT_SCORE}}" > "${EVIDENCE_PATH}"
+echo "Wrote drift score ${DRIFT_SCORE} to ${EVIDENCE_PATH}"
+echo "Waiting up to 120s for auto-fallback controller to patch deployment ${TARGET_DEP}"
+for i in $(seq 1 24); do
+  sleep 5
+  ns=${TARGET_DEP%%/*}
+  name=${TARGET_DEP#*/}
+  current=$(kubectl -n "${ns}" get deploy "${name}" -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null || echo "")
+  echo "Current image: $current"
+  if [[ "$current" == *"${FALLBACK_IMAGE}"* ]]; then
+    echo "Fallback image applied"
+    exit 0
+  fi
+done
+echo "Auto-fallback not observed within timeout"
+exit 2
+
