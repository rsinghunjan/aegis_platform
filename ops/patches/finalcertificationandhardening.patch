+aws s3api put-bucket-versioning --bucket "$BUCKET" --versioning-configuration Status=Enabled
+echo "NOTE: To enable Object Lock, the bucket must be created with ObjectLockEnabledForBucket=true via S3 control or the AWS console. Use the console or S3Control APIs for creation with Object Lock."
+echo "Bucket $BUCKET created (versioning enabled). Configure Object Lock via console if required."
