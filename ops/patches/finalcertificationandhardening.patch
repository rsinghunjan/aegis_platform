+#!/usr/bin/env python3
+"""
+Inference performance benchmark for a model using HuggingFace transformers.
+Measures throughput and latency for generate() over a small set of prompts.
+"""
+import time, argparse
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+def bench(model_name_or_path, prompts, batch_size=1, device='cuda'):
+    model = AutoModelForCausalLM.from_pretrained(model_name_or_path).to(device)
+    tokenizer = AutoTokenizer.from_pretrained(model_name_or_path)
+    model.eval()
+    inputs = tokenizer(prompts, return_tensors="pt", padding=True).to(device)
+    # warmup
+    for _ in range(3):
+        _ = model.generate(**inputs, max_length=32)
+    # timed runs
+    iters = 10
+    t0 = time.time()
+    for _ in range(iters):
+        _ = model.generate(**inputs, max_length=32)
+    t1 = time.time()
+    total = t1 - t0
+    print(f"Ran {iters} iterations in {total:.2f}s; avg {total/iters:.3f}s per batch")
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--model", default="distilgpt2")
+    p.add_argument("--prompts", default="Hello world")
+    p.add_argument("--batch", type=int, default=1)
+    p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
+    args = p.parse_args()
+    prompts = [args.prompts] * args.batch
+    bench(args.model, prompts, batch_size=args.batch, device=args.device)
+
