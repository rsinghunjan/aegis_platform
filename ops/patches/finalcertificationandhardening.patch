+#!/usr/bin/env python3
+"""
+Simple checkpoint resume test:
+ - Simulates training that periodically writes checkpoint files
+ - Simulates a failure and restarts training resuming from last checkpoint
+ - Verifies that checkpoint files are present and that resume logic loads previous state
+"""
+import os, time, json, argparse
+
+CKPT_DIR = "./tmp_ckpts"
+
+def create_checkpoint(step):
+    os.makedirs(CKPT_DIR, exist_ok=True)
+    path = os.path.join(CKPT_DIR, f"ckpt_{step}.json")
+    open(path,"w").write(json.dumps({"step": step, "ts": time.time()}))
+    print("Wrote", path)
+
+def latest_checkpoint():
+    if not os.path.exists(CKPT_DIR):
+        return None
+    files = sorted([f for f in os.listdir(CKPT_DIR) if f.startswith("ckpt_")])
+    if not files:
+        return None
+    return os.path.join(CKPT_DIR, files[-1])
+
+def run_training(steps=5, fail_at=3):
+    print("Starting synthetic training")
+    for s in range(1, steps+1):
+        create_checkpoint(s)
+        time.sleep(1)
+        if s == fail_at:
+            print("Simulate crash")
+            return
+
+def resume_training(total_steps=8):
+    ck = latest_checkpoint()
+    if ck:
+        print("Resuming from", ck)
+        state = json.load(open(ck))
+        start = state["step"] + 1
+    else:
+        start = 1
+    for s in range(start, total_steps+1):
+        create_checkpoint(s)
+        time.sleep(1)
+    print("Resume complete")
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--run-steps", type=int, default=5)
+    p.add_argument("--fail-at", type=int, default=3)
+    p.add_argument("--resume-to", type=int, default=8)
+    args = p.parse_args()
+    run_training(steps=args.run_steps, fail_at=args.fail_at)
+    print("Now resume")
+    resume_training(total_steps=args.resume_to)
+
