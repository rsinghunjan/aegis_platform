+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Finalize PCR policy, sign with KMS/HSM (example AWS KMS) and push to k8s secret for attestation verifier.
+#
+POLICY_TEMPLATE=${1:-services/attestation_verifier/pcr_policy_templates.json}
+PROFILE=${2:-edge_controller_v1}
+KMS_KEY_ARN=${KMS_KEY_ARN:-""}   # set ENV or export before running
+S3_UPLOAD_BUCKET=${S3_UPLOAD_BUCKET:-""}
+K8S_SECRET_NAME=${K8S_SECRET_NAME:-attestation-signed-policy}
+K8S_NS=${K8S_NS:-attestation}
+
+if [ -z "$KMS_KEY_ARN" ]; then
+  echo "Set KMS_KEY_ARN environment variable to your KMS key ARN (e.g. arn:aws:kms:...)" >&2
+  exit 2
+fi
+
+tmp=$(mktemp -d)
+policy_file="$tmp/policy.json"
+signed_file="$tmp/signed_policy.json"
+
+jq --arg p "$PROFILE" '.device_profiles[$p]' "$POLICY_TEMPLATE" > "$policy_file"
+echo "Selected policy profile: $PROFILE -> $policy_file"
+
+echo "Signing policy via AWS KMS..."
+python3 services/attestation_verifier/policy_kms_sign_aws.py sign --policy "$policy_file" --key-id "$KMS_KEY_ARN" --out "$signed_file"
+
+echo "Uploading signed policy to S3 (optional)..."
+if [ -n "$S3_UPLOAD_BUCKET" ]; then
+  aws s3 cp "$signed_file" "s3://${S3_UPLOAD_BUCKET}/attestation/signed_policy_${PROFILE}.json"
+fi
+
+echo "Creating k8s secret with signed policy"
+kubectl -n "$K8S_NS" create secret generic "$K8S_SECRET_NAME" --from-file=signed_policy.json="$signed_file" --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Open GitHub issue requesting Security signoff (requires gh CLI)"
+ISS_TITLE="Security: PCR policy signed for profile ${PROFILE} - request signoff"
+ISS_BODY="Signed PCR policy for ${PROFILE} uploaded and installed to cluster namespace ${K8S_NS} as secret ${K8S_SECRET_NAME}.\n\nPlease review and sign off. Signed policy S3 (if uploaded): s3://${S3_UPLOAD_BUCKET}/attestation/signed_policy_${PROFILE}.json\n\nKMS Key: ${KMS_KEY_ARN}"
+if command -v gh >/dev/null 2>&1; then
+  gh issue create --title "$ISS_TITLE" --body "$ISS_BODY" --label security --assignee @me || true
+else
+  echo "Install gh CLI to auto-create PR/issue. Policy is ready in k8s secret."
+fi
+
+echo "Done. Security team: verify attached policy and run hardware attestation tests (hardware_attest_test.py) on representative devices."
+
