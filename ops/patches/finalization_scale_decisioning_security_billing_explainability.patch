+            return False
+        data=resp.json().get("data",[])
+        for t in data:
+            for span in t.get("spans",[]):
+                for tag in span.get("tags",[]):
+                    if tag.get("key")=="business_kpi":
+                        return True
+    except Exception:
+        logger.exception("jaeger query failed")
