+#!/usr/bin/env python3
+"""
+Long-shadow orchestrator:
+ - Runs accelerated long-shadow (configurable duration or real 30d)
+ - Monitors business KPI, stores periodic snapshots, raises alerts for drift/regressions
+ - Produces signed evidence bundle at end of run
+"""
+import os, time, json, subprocess, tempfile, logging
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("longshadow-run")
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+DURATION_HOURS = int(os.environ.get("LONG_SHADOW_HOURS", "720"))  # default 30d
+SAMPLE_INTERVAL = int(os.environ.get("LONG_SHADOW_SAMPLE_INTERVAL", "60"))  # seconds
+
+def sample_kpi():
+    try:
+        resp = subprocess.check_output(["curl","-s", f"{PROM_URL}/api/v1/query", "--data-urlencode", "query=sum(rate(business_metric[1m]))"])
+        return json.loads(resp.decode())
+    except Exception:
+        return None
+
+def run(duration_hours=DURATION_HOURS):
+    end = time.time() + duration_hours*3600
+    tmpdir = tempfile.mkdtemp(prefix="longshadow-")
+    samples=[]
+    while time.time() < end:
+        s = sample_kpi()
+        ts = datetime.utcnow().isoformat()
+        samples.append({"ts": ts, "kpi": s})
+        # basic local alert if KPI missing
+        if not s or not s.get("data") or not s["data"].get("result"):
+            logger.warning("KPI missing at %s", ts)
+        time.sleep(SAMPLE_INTERVAL)
+    path = f"{tmpdir}/longshadow_samples_{int(time.time())}.json"
+    open(path,"w").write(json.dumps(samples))
+    # bundle and upload
+    bundle = f"/tmp/longshadow-{int(time.time())}.tar.gz"
+    subprocess.check_call(["tar","-czf", bundle, "-C", tmpdir, "."])
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"longshadow/{os.path.basename(bundle)}"
+        s3.upload_file(bundle, EVIDENCE_BUCKET.replace("s3://",""), key)
+        logger.info("Uploaded bundle to s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
+    print("Completed long-shadow; bundle:", bundle)
+
+if __name__ == "__main__":
+    run()
+
