+def recent_run_ids(limit=20):
+    r=requests.get(f"{PROM_URL}/api/v1/label/run_id/values", timeout=10)
+    if r.status_code!=200:
+        return []
+    ids=r.json().get("data",[])
+    return ids[-limit:]
+
+def jaeger_has_business_kpi(run_id):
+    try:
+        # Query Jaeger for traces including the run_id tag
+        params={"service":"", "limit":20, "lookback":"1h"}
