+#!/usr/bin/env python3
+"""
+HPO Controller: submit distributed Ray jobs, watch progress, enforce cost guard and checkpointing,
+record submissions to chargeback and upload evidence.
+"""
+import os, time, json, logging, subprocess, tempfile, requests
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("hpo-controller")
+
+CHARGEBACK_API = os.environ.get("CHARGEBACK_API", "http://chargeback.monitoring.svc:8080/submit")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+COST_GUARD_USD = float(os.environ.get("HPO_COST_GUARD_USD", "1000.0"))
+
+def submit_ray_job(manifest):
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(manifest.encode()); f.close()
+    out = subprocess.check_output(["kubectl","apply","-n",TEKTON_NS,"-f",f.name]).decode()
+    logger.info("Submitted Ray job: %s", out)
+    for l in out.splitlines():
+        if "rayjob.ray.io/" in l:
+            return l.split()[0].split("/")[1]
+    return None
+
+def watch_ray_job(job_name, timeout_hours=8):
+    end = time.time() + timeout_hours*3600
+    while time.time() < end:
+        try:
+            out = subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","rayjob",job_name,"-o","json"]).decode()
+            st = json.loads(out).get("status",{})
+            if st.get("state") in ("Succeeded","Failed"):
+                return st.get("state"), st
+        except Exception:
+            logger.exception("watch error")
+        time.sleep(30)
+    return "Timeout", {}
+
+def upload_evidence(local_path, prefix):
+    if not EVIDENCE_BUCKET:
+        return local_path
+    import boto3
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    key=f"{prefix}/{os.path.basename(local_path)}"
+    s3.upload_file(local_path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def record_chargeback(team, run_id, est_usd):
+    try:
+        requests.post(CHARGEBACK_API, json={"team":team,"run_id":run_id,"estimated_usd":est_usd}, timeout=10)
+    except Exception:
+        logger.exception("chargeback record failed")
+
+def generate_ray_manifest(samples, team, checkpoint_s3, image="us.gcr.io/aegis/ray-hpo:latest"):
+    # Use services/hpo/ray_job_generator in repo if available; simple manifest placeholder
+    return json.dumps({
+        "apiVersion": "ray.io/v1",
+        "kind": "RayJob",
+        "metadata": {"generateName": f"aegis-hpo-{team}-"},
+        "spec": {"entrypoint": f"python /app/run_ray_tune_prod_checkpoint.py --num-samples {samples}", "template": {"spec": {"containers":[{"name":"hpo","image":image}]}}}
+    }, indent=2)
+
+def main():
+    samples=int(os.environ.get("HPO_SAMPLES","128"))
+    team=os.environ.get("HPO_TEAM","stress")
+    checkpoint_s3=os.environ.get("CHECKPOINT_S3","s3://aegis-checkpoints")
+    est_cost=float(os.environ.get("EST_COST_USD", "200.0"))
+    if est_cost > COST_GUARD_USD:
+        logger.error("Estimated cost %s exceeds guard %s; aborting", est_cost, COST_GUARD_USD)
+        return
+    manifest = generate_ray_manifest(samples, team, checkpoint_s3)
+    job = submit_ray_job(manifest)
+    if not job:
+        logger.error("failed to submit ray job")
+        return
+    record_chargeback(team, job, est_cost)
+    state, status = watch_ray_job(job)
+    summary_file = f"/tmp/hpo-{job}-summary.json"
+    open(summary_file,"w").write(json.dumps({"job":job,"state":state,"status":status}, default=str))
+    upload_evidence(summary_file, f"hpo/{job}")
+    logger.info("HPO job %s finished with state %s", job, state)
+
+if __name__ == "__main__":
+    main()
+
