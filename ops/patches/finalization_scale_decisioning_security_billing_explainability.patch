+#!/usr/bin/env python3
+"""
+Tenant cap enforcer:
+ - Periodically checks BillingRecord totals and enforces caps by calling submission service to disable submissions
+ - Sends alerts via webhook and writes evidence to S3
+"""
+import os, logging, time, requests, json
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("tenant-cap-enforcer")
+
+CHARGEBACK_API = os.environ.get("CHARGEBACK_API", "http://chargeback.monitoring.svc:8080")
+SUBMIT_DISABLE_API = os.environ.get("SUBMIT_DISABLE_API", "http://hpo-submit.monitoring.svc:8080/disable")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def get_tenants():
+    try:
+        r = requests.get(f"{CHARGEBACK_API}/tenants", timeout=10)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        logger.exception("failed to list tenants")
+        return []
+
+def disable_submissions(tenant):
+    try:
+        requests.post(f"{SUBMIT_DISABLE_API}/{tenant}", timeout=5)
+    except Exception:
+        logger.exception("failed to disable submissions")
+
+def send_alert(msg):
+    if not ALERT_WEBHOOK:
+        return
+    try:
+        requests.post(ALERT_WEBHOOK, json={"text": msg}, timeout=5)
+    except Exception:
+        logger.exception("alert failed")
+
+def run_loop(interval=300):
+    while True:
+        tenants = get_tenants()
+        for t in tenants:
+            tenant = t.get("tenant")
+            spend = float(t.get("spend",0))
+            cap = float(t.get("cap", 0) or 0)
+            if cap>0 and spend>cap:
+                logger.warning("Tenant %s exceeded cap: %s > %s", tenant, spend, cap)
+                disable_submissions(tenant)
+                send_alert(f"Tenant {tenant} exceeded cap {cap}, submissions disabled.")
+                # write evidence
+                if EVIDENCE_BUCKET:
+                    import boto3
+                    s3=boto3.client("s3")
+                    key=f"billing/enforcement/{tenant}-{int(time.time())}.json"
+                    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps({"tenant":tenant,"spend":spend,"cap":cap,"ts":datetime.utcnow().isoformat()}).encode())
+        time.sleep(interval)
+
+if __name__ == "__main__":
+    run_loop()
