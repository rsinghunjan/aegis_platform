+#!/usr/bin/env python3
+"""
+Remediation engine:
+ - Detects common Tekton failures and attempts automated remediation:
+   - restart failed pods, increase resources (by annotating job), resubmit pipeline runs with safer params
+ - Integrates with approval/escalation service when retries exhausted
+"""
+import os, time, json, logging, subprocess
+from datetime import datetime
+import requests
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("remediation-engine")
+
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE","cicd")
+MAX_ATTEMPTS = int(os.environ.get("REMEDIATION_MAX_ATTEMPTS","3"))
+APPROVAL_API = os.environ.get("APPROVAL_SERVICE_URL","http://approval-service.monitoring.svc:8080")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+
+def list_failed_prs():
+    out = subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","pipelineruns","-o","json"]).decode()
+    items = json.loads(out).get("items",[])
+    failed=[i for i in items if i.get("status",{}).get("conditions",[{}])[0].get("status")=="False"]
+    return failed
+
+def restart_failed_pods(pr):
+    pods=json.loads(subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","pods","-o","json"]).decode()).get("items",[])
+    restarted=[]
+    pr_name=pr.get("metadata",{}).get("name")
+    for p in pods:
+        owners=p.get("metadata",{}).get("ownerReferences",[])
+        if any(o.get("name","").startswith(pr_name) for o in owners):
+            name=p["metadata"]["name"]
+            try:
+                subprocess.check_call(["kubectl","-n",TEKTON_NS,"delete","pod",name,"--grace-period=5"])
+                restarted.append(name)
+            except Exception:
+                logger.exception("failed to delete pod %s", name)
+    return restarted
+
+def resubmit_pipelinerun(pr):
+    # Simple resubmit by re-creating a pipeline run from pipelineRef, copying params and adding retry annotation
+    spec=pr.get("spec",{})
+    pipeline_ref=spec.get("pipelineRef",{}).get("name")
+    params=spec.get("params",[])
+    params_str=" ".join([f"{p['name']}={p['value']}" for p in params])
+    new_pr = {
+        "apiVersion":"tekton.dev/v1beta1",
+        "kind":"PipelineRun",
+        "metadata":{"generateName": f"{pipeline_ref}-retry-"},
+        "spec":{"pipelineRef":{"name":pipeline_ref},"params":params}
+    }
+    import tempfile, yaml
+    f=tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.safe_dump(new_pr).encode()); f.close()
+    subprocess.check_call(["kubectl","apply","-n",TEKTON_NS,"-f",f.name])
+    return True
+
+def escalate(pr_name, reason):
+    payload={"summary": f"PipelineRun {pr_name} needs manual attention", "details": reason}
+    try:
+        requests.post(f"{APPROVAL_API}/request", json=payload, timeout=5)
+    except Exception:
+        logger.exception("failed to notify approval")
+
+def run_loop(poll=30):
+    while True:
+        failed=list_failed_prs()
+        for pr in failed:
+            name=pr.get("metadata",{}).get("name")
+            annotations=pr.get("metadata",{}).get("annotations",{})
+            attempts=int(annotations.get("aegis.remediation_attempts","0"))
+            logger.info("Found failed PR %s attempts=%d", name, attempts)
+            if attempts < MAX_ATTEMPTS:
+                restarted=restart_failed_pods(pr)
+                resubmit_pipelinerun(pr)
+                subprocess.check_call(["kubectl","-n",TEKTON_NS,"annotate","pipelinerun",name,f"aegis.remediation_attempts={attempts+1}","--overwrite"])
+                logger.info("Attempted remediation for %s restarted=%s", name, restarted)
+            else:
+                escalate(name, "max remediation attempts reached")
+        time.sleep(poll)
+
+if __name__ == "__main__":
+    run_loop()
+
