+#!/usr/bin/env python3
+"""
+Wrapper script to run the various PR/issue creation automation scripts included in the repo.
+This is a convenience to create all suggested PRs/issues for operator review.
+"""
+import os
+import subprocess
+import argparse
+
+SCRIPTS = [
+    "ops/automation/create_all_provision_and_inventory_prs.py",
+    "ops/automation/create_provisioning_inventory_pr.py",
+    "ops/automation/create_enforce_hardware_gate_pr.py",
+    "ops/automation/create_provisioning_inventory_pr.py",
+    "ops/finance/create_finance_signoff_pr.py",
+]
+
+def run_script(path, repo):
+    env = os.environ.copy()
+    env["GITHUB_REPOSITORY"] = repo
+    env["GITHUB_TOKEN"] = os.environ.get("GITHUB_TOKEN","")
+    print("Running", path)
+    subprocess.check_call(["python", path, "--repo", repo], env=env)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    args = p.parse_args()
+    for s in SCRIPTS:
+        try:
+            run_script(s, args.repo)
+        except Exception as e:
+            print("Script failed:", s, e)
+
+if __name__=="__main__":
+    main()
+
