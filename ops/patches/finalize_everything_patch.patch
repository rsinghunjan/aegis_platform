+#!/usr/bin/env python3
+"""
+CI acceptance gate script.
+Checks the repository state and artifacts to determine whether the acceptance checklist is met.
+This script is intended to be run in CI (pull_request or manual) and return non-zero if checks fail.
+It performs lightweight checks (file presence / meta flags / smoke artifacts). Many checks require operator-provided artifacts in /tmp or env signals.
+"""
+import os
+import sys
+import json
+
+def check_inventory(path="ops/provisioning/inventory.json"):
+    if not os.path.exists(path):
+        return False, f"Missing inventory file {path}"
+    inv = json.load(open(path))
+    for dev, info in inv.get("devices", {}).items():
+        if info.get("requested",0) < 1 and dev in ("gpu","rt","hil"):
+            return False, f"Device {dev} requested count < 1"
+    return True, "Inventory OK"
+
+def check_sme_meta(glob_pattern="ops/formal/onboard_submissions/*.meta.json"):
+    import glob
+    missing = []
+    for p in glob.glob(glob_pattern):
+        m = json.load(open(p))
+        if m.get("priority")=="high" and not m.get("sme_approved"):
+            missing.append(p)
+    if missing:
+        return False, f"SME approval missing for: {missing}"
+    return True, "SME approvals OK"
+
+def check_managed_smoke(path="/tmp/managed_migration_smoke.json"):
+    if not os.path.exists(path):
+        return False, f"Managed migration smoke result missing at {path}"
+    r = json.load(open(path))
+    if not r.get("postgres", [True])[0] if isinstance(r.get("postgres"), list) else r.get("postgres"):
+        # handle different write formats
+        pass
+    if r.get("postgres") and r.get("redis"):
+        return True, "Managed services smoke OK"
+    return False, f"Managed smoke failure: {r}"
+
+def check_attestation(path="/tmp/attestation_ok.json"):
+    if os.path.exists(path):
+        j = json.load(open(path))
+        if j.get("ok"):
+            return True, "Attestation smoke OK"
+        return False, "Attestation smoke failed"
+    return False, "Attestation smoke missing"
+
+def check_golden_image(path="ops/images/baked_image_manifest.json"):
+    if not os.path.exists(path):
+        return False, "Golden image manifest missing"
+    return True, "Golden image manifest present"
+
+def check_triton_tuning(path="/tmp/triton_tuning_results.json"):
+    if os.path.exists(path):
+        j = json.load(open(path))
+        # simple pass if at least one candidate exists
+        if isinstance(j, list) and len(j)>0:
+            return True, "Triton tuning results present"
+    return False, "Triton tuning results missing"
+
+def check_hil_results(path="/tmp/hil_bulk_results.json"):
+    if os.path.exists(path):
+        j = json.load(open(path))
+        # ensure at least one run and no more than 10% failures (heuristic)
+        runs = j.get("runs",[])
+        if not runs:
+            return False, "HIL results empty"
+        fails = sum(1 for r in runs if not r.get("ok"))
+        if fails > max(1, int(0.1*len(runs))):
+            return False, f"HIL failures too many: {fails}/{len(runs)}"
+        return True, "HIL results OK"
+    return False, "HIL results missing"
+
+def check_soak_status(path="/tmp/soak_status.json"):
+    if os.path.exists(path):
+        j = json.load(open(path))
+        if j.get("ok"):
+            return True, "Soak active"
+    return False, "Soak not active or missing"
+
+def check_finance(issue_label_required="finance:approved"):
+    # simple check: operator must provide /tmp/finance_signoff.json with approved=true
+    path="/tmp/finance_signoff.json"
+    if os.path.exists(path):
+        j = json.load(open(path))
+        if j.get("approved"):
+            return True, "Finance signoff present"
+    return False, "Finance signoff missing"
+
+def main():
+    checks = [
+        ("Inventory", check_inventory),
+        ("SME meta", check_sme_meta),
+        ("Managed smoke", check_managed_smoke),
+        ("Attestation", check_attestation),
+        ("Golden image", check_golden_image),
+        ("Triton tuning", check_triton_tuning),
+        ("HIL results", check_hil_results),
+        ("Soak status", check_soak_status),
+        ("Finance signoff", check_finance),
+    ]
+    ok = True
+    for name, fn in checks:
+        try:
+            passed, msg = fn()
+        except Exception as e:
+            passed, msg = False, f"Exception during check: {e}"
+        print(f"{name}: {'PASS' if passed else 'FAIL'} - {msg}")
+        if not passed:
+            ok = False
+    if not ok:
+        print("Acceptance gate failed")
+        sys.exit(2)
+    print("Acceptance gate passed")
+    sys.exit(0)
+
+if __name__=="__main__":
+    main()
+
