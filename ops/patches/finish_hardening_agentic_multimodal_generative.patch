+#!/usr/bin/env python3
+"""
+Supervisor for long-duration shadow campaigns.
+ - Aggregates daily results, checks against thresholds, and emits alerts to a webhook when thresholds breached.
+ - Produces a final campaign report for SME signoff.
+"""
+import os, time, json
+from services.generative.shadow_aggregator import aggregate, read_s3_prefix, iter_local
+try:
+    import boto3
+except Exception:
+    boto3 = None
+import requests
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+PUSH_WEBHOOK = os.environ.get("SHADOW_ALERT_WEBHOOK", "")
+LOCAL_SHADOW_PATH = os.environ.get("SHADOW_OUT", "/data/shadow_generations.jsonl")
+DIVERGENCE_THRESHOLD = float(os.environ.get("SHADOW_DIVERGENCE_THRESHOLD", "0.02"))
+
+def load_window(hours=24):
+    since = int(time.time()) - hours*3600
+    items = list(iter_local(LOCAL_SHADOW_PATH, since))
+    if EVIDENCE_BUCKET and boto3:
+        items.extend(list(read_s3_prefix(EVIDENCE_BUCKET, "gen_shadow/", since)))
+    return items
+
+def check_and_alert():
+    items = load_window(24)
+    rep = aggregate(items)
+    rep["checked_at"] = int(time.time())
+    # upload daily summary
+    if EVIDENCE_BUCKET and boto3:
+        s3 = boto3.client("s3")
+        key = f"gen_shadow_reports/daily_{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(rep).encode("utf-8"))
+    else:
+        with open(f"/tmp/gen_shadow_daily_{int(time.time())}.json","w") as f:
+            json.dump(rep, f, indent=2)
+    if rep.get("divergence_rate",0) > DIVERGENCE_THRESHOLD:
+        msg = {"text": f"Shadow divergence exceeded threshold: {rep.get('divergence_rate')}, threshold {DIVERGENCE_THRESHOLD}"}
+        if PUSH_WEBHOOK:
+            try:
+                requests.post(PUSH_WEBHOOK, json=msg, timeout=10)
+            except Exception:
+                pass
+        # also record an incident artifact
+        incident = {"ts": int(time.time()), "type":"shadow_divergence", "report": rep}
+        if EVIDENCE_BUCKET and boto3:
+            s3.put_object(Bucket=EVIDENCE_BUCKET, Key=f"incidents/shadow_{int(time.time())}.json", Body=json.dumps(incident).encode("utf-8"))
+    return rep
+
+if __name__=="__main__":
+    print("Running supervisor check")
+    r = check_and_alert()
+    print("Supervisor report:", r)
+
