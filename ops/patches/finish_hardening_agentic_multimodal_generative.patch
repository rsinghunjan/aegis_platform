+#!/usr/bin/env python3
+"""
+Transaction manager for agentic actions.
+ - Records transaction metadata (start/steps/backup_uris/status) into evidence store.
+ - Provides rollback orchestration by replaying stored backups.
+ - This is a control-plane helper used by execute_with_safety.
+"""
+import time
+from services.agent.backup_store import store_backup
+from services.agent.audit_logger import audit_log_action, s3_put
+import json, os
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def start_transaction(name: str, requester: str, plan: dict) -> dict:
+    tx = {"name": name, "requester": requester, "plan": plan, "start_ts": int(time.time()), "steps": [], "state": "started"}
+    # record to evidence
+    key = f"agent_tx/{name}_{int(time.time())}.json"
+    if EVIDENCE_BUCKET:
+        s3_put(key, tx)
+    else:
+        with open(f"/tmp/{os.path.basename(key)}","w") as f:
+            json.dump(tx, f)
+    return tx
+
+def record_step(tx: dict, step_index: int, step: dict, backup_uri: str=None):
+    entry = {"index": step_index, "step": step, "backup_uri": backup_uri, "ts": int(time.time())}
+    tx.setdefault("steps", []).append(entry)
+    # update evidence copy
+    key = f"agent_tx/{tx['name']}_latest.json"
+    if EVIDENCE_BUCKET:
+        s3_put(key, tx)
+    else:
+        with open(f"/tmp/{os.path.basename(key)}","w") as f:
+            json.dump(tx, f)
+    return entry
+
+def finalize_transaction(tx: dict, final_state: str, details: dict=None):
+    tx["state"] = final_state
+    tx["end_ts"] = int(time.time())
+    if details:
+        tx["details"] = details
+    key = f"agent_tx/{tx['name']}_final_{int(time.time())}.json"
+    if EVIDENCE_BUCKET:
+        s3_put(key, tx)
+    else:
+        with open(f"/tmp/{os.path.basename(key)}","w") as f:
+            json.dump(tx, f)
+    audit_log_action("transaction_finalized", tx["requester"], {"tx": tx["name"]}, {"state": final_state})
+    return tx
+
+def rollback_transaction(tx: dict):
+    # Iterate steps in reverse, apply backups if possible (best effort)
+    for s in reversed(tx.get("steps", [])):
+        b = s.get("backup_uri")
+        if not b:
+            continue
+        try:
+            if b.startswith("s3://"):
+                # Download and apply depending on content (scaffold)
+                import boto3, tempfile, json, subprocess
+                s3 = boto3.client("s3")
+                parts = b[len("s3://"):].split("/",1)
+                bucket = parts[0]; key = parts[1]
+                tmp = tempfile.NamedTemporaryFile(delete=False)
+                s3.download_file(bucket, key, tmp.name)
+                data = json.load(open(tmp.name))
+                # If manifest exists, re-apply via kubectl
+                if "deployment_json" in data:
+                    tmp2 = tempfile.NamedTemporaryFile(delete=False, mode="w")
+                    json.dump(data["deployment_json"], tmp2); tmp2.close()
+                    subprocess.check_call(["kubectl","apply","-f", tmp2.name])
+        except Exception:
+            pass
+    tx["state"] = "rolled_back"
+    finalize_transaction(tx, "rolled_back")
+    return tx
+
