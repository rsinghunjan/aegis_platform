+#!/usr/bin/env python3
+"""
+Model repo watcher for Triton model store.
+ - Polls MODEL_STORE_PREFIX (supports s3:// and file://) and detects new model versions per model_name
+ - Triggers Triton reload and runs validate_inference for newly discovered models
+ - Writes evidence to EVIDENCE_BUCKET via audit_logger.s3_put
+"""
+import os, time, json
+from urllib.parse import urlparse
+try:
+    import boto3
+except Exception:
+    boto3 = None
+from services.agent.audit_logger import s3_put
+from services.triton.validate_and_test_model import reload_triton, infer_test
+
+MODEL_STORE_PREFIX = os.environ.get("MODEL_STORE_PREFIX", "")
+TRITON_HOST = os.environ.get("TRITON_HOST", "triton-clip-backend.inference.svc:8000")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+POLL_S = int(os.environ.get("MODEL_REPO_POLL_S", "300"))
+
+seen = {}
+
+def list_models_s3(prefix):
+    if not boto3:
+        return []
+    s3 = boto3.client("s3")
+    parts = prefix[len("s3://"):].split("/",1)
+    bucket = parts[0]; base = parts[1] if len(parts)>1 else ""
+    models = set()
+    resp = s3.list_objects_v2(Bucket=bucket, Prefix=base, Delimiter="/")
+    for p in resp.get("CommonPrefixes", []):
+        name = p.get("Prefix").rstrip("/").split("/")[-1]
+        models.add(name)
+    return list(models)
+
+def list_models_file(path):
+    if not os.path.exists(path):
+        return []
+    return [d for d in os.listdir(path) if os.path.isdir(os.path.join(path,d))]
+
+def publish_evidence(obj):
+    key = f"model_repo_watcher/{int(time.time())}.json"
+    if EVIDENCE_BUCKET:
+        s3_put(key, obj)
+    else:
+        with open("/tmp/model_repo_watcher_"+str(int(time.time()))+".json","w") as f:
+            json.dump(obj, f)
+
+def main_loop():
+    while True:
+        try:
+            if MODEL_STORE_PREFIX.startswith("s3://"):
+                models = list_models_s3(MODEL_STORE_PREFIX)
+            else:
+                models = list_models_file(MODEL_STORE_PREFIX)
+            for m in models:
+                if m not in seen:
+                    seen[m] = True
+                    # trigger reload and validate
+                    info = {"model": m, "discovered_at": int(time.time())}
+                    try:
+                        reload_triton(TRITON_HOST)
+                        # simple sample input if present
+                        # caller should configure sample for each model; we skip inference if no sample path
+                        sample = os.environ.get(f"SAMPLE_INPUT_{m.upper()}")
+                        if sample:
+                            out = infer_test(TRITON_HOST, m, sample)
+                            info["validation"] = out
+                        info["status"] = "validated" if sample else "reloaded"
+                    except Exception as e:
+                        info["status"] = "error"
+                        info["error"] = str(e)
+                    publish_evidence(info)
+        except Exception as e:
+            print("watcher error", e)
+        time.sleep(POLL_S)
+
+if __name__=="__main__":
+    main_loop()
+
