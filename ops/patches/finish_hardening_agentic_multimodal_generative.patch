+#!/usr/bin/env python3
+"""
+Verified K8s wrappers with RBAC, idempotency, backups, retries and audit logging.
+ - Exposes safe_set_image, safe_scale_deployment, safe_create_configmap
+ - Uses services.agent.rbac_manager.is_allowed for authorization
+ - Stores pre-action snapshots via services.agent.backup_store.store_backup
+ - Emits audit records via services.agent.audit_logger.audit_log_action
+ - Retries transient failures with exponential backoff
+"""
+import time
+import subprocess
+from typing import Dict, Any
+
+from services.agent.rbac_manager import is_allowed
+from services.agent.backup_store import store_backup
+from services.agent.audit_logger import audit_log_action
+
+RETRY_MAX = int(__import__("os").environ.get("K8S_WRAPPER_RETRIES", "3"))
+RETRY_BASE_S = float(__import__("os").environ.get("K8S_WRAPPER_RETRY_BASE_S", "0.5"))
+
+def _run_kubectl(cmd):
+    return subprocess.check_output(cmd).decode("utf-8")
+
+def _retry(func, *a, **kw):
+    for i in range(RETRY_MAX):
+        try:
+            return func(*a, **kw)
+        except subprocess.CalledProcessError as e:
+            if i == RETRY_MAX - 1:
+                raise
+            time.sleep(RETRY_BASE_S * (2 ** i))
+
+def safe_set_image(requester: str, namespace: str, deployment: str, image: str, dry_run: bool=False) -> Dict[str, Any]:
+    tool = "k8s.set_image"
+    if not is_allowed(requester, tool):
+        raise PermissionError("not permitted")
+    # idempotency check
+    try:
+        cur = _run_kubectl(["kubectl","-n",namespace,"get","deployment",deployment,"-o","jsonpath={.spec.template.spec.containers[0].image}"]).strip()
+    except Exception:
+        cur = None
+    if cur == image:
+        audit_log_action("safe_set_image", requester, {"namespace":namespace,"deployment":deployment,"image":image}, {"state":"noop","reason":"image_already_set"})
+        return {"status":"noop","reason":"image_already_set","image":image}
+    # backup current deployment
+    try:
+        manifest = _run_kubectl(["kubectl","-n",namespace,"get","deployment",deployment,"-o","json"])
+        backup_uri = store_backup(f"set_image_{namespace}_{deployment}_{int(time.time())}", {"deployment_json": manifest})
+    except Exception as e:
+        backup_uri = None
+    if dry_run:
+        return {"status":"dry_run","would_set":image,"backup_uri":backup_uri}
+    def _do():
+        _run_kubectl(["kubectl","-n",namespace,"set","image","deployment/"+deployment, f"{deployment}={image}"])
+        return {"status":"ok","image":image}
+    res = _retry(_do)
+    audit_log_action("safe_set_image", requester, {"namespace":namespace,"deployment":deployment,"image":image}, {"state":"executed","result":res,"backup_uri":backup_uri})
+    return {"status":"ok","result":res,"backup_uri":backup_uri}
+
+def safe_scale_deployment(requester: str, namespace: str, deployment: str, replicas: int, dry_run: bool=False) -> Dict[str, Any]:
+    tool = "k8s.scale_deployment"
+    if not is_allowed(requester, tool):
+        raise PermissionError("not permitted")
+    try:
+        cur = int(_run_kubectl(["kubectl","-n",namespace,"get","deployment",deployment,"-o","jsonpath={.spec.replicas}"]).strip())
+    except Exception:
+        cur = None
+    if cur == replicas:
+        audit_log_action("safe_scale", requester, {"namespace":namespace,"deployment":deployment,"replicas":replicas}, {"state":"noop"})
+        return {"status":"noop","reason":"replicas_already_set","replicas":replicas}
+    # backup current spec
+    backup_uri = None
+    try:
+        manifest = _run_kubectl(["kubectl","-n",namespace,"get","deployment",deployment,"-o","json"])
+        backup_uri = store_backup(f"scale_{namespace}_{deployment}_{int(time.time())}", {"deployment_json": manifest})
+    except Exception:
+        pass
+    if dry_run:
+        return {"status":"dry_run","would_scale_to":replicas,"backup_uri":backup_uri}
+    def _do():
+        _run_kubectl(["kubectl","-n",namespace,"scale","deployment",deployment,"--replicas="+str(replicas)])
+        return {"status":"ok","replicas":replicas}
+    res = _retry(_do)
+    audit_log_action("safe_scale", requester, {"namespace":namespace,"deployment":deployment,"replicas":replicas}, {"state":"executed","result":res,"backup_uri":backup_uri})
+    return {"status":"ok","result":res,"backup_uri":backup_uri}
+
+def safe_create_configmap(requester: str, namespace: str, name: str, data: Dict[str,str], dry_run: bool=False) -> Dict[str, Any]:
+    tool = "k8s.create_configmap"
+    if not is_allowed(requester, tool):
+        raise PermissionError("not permitted")
+    # backup existing if present
+    backup_uri = None
+    try:
+        prev = _run_kubectl(["kubectl","-n",namespace,"get","configmap",name,"-o","json"])
+        backup_uri = store_backup(f"cm_{namespace}_{name}_{int(time.time())}", {"configmap_json": prev})
+    except Exception:
+        prev = None
+    if dry_run:
+        return {"status":"dry_run","would_create":name,"previous_present": bool(prev), "backup_uri": backup_uri}
+    # write to temp file and apply
+    import tempfile, json as _json
+    cm = {"apiVersion":"v1","kind":"ConfigMap","metadata":{"name":name,"namespace":namespace},"data":{k:str(v) for k,v in data.items()}}
+    tf = tempfile.NamedTemporaryFile(delete=False, mode="w")
+    _json.dump(cm, tf); tf.close()
+    def _do():
+        _run_kubectl(["kubectl","apply","-f", tf.name])
+        return {"status":"applied"}
+    res = _retry(_do)
+    audit_log_action("safe_create_configmap", requester, {"namespace":namespace,"name":name,"data_keys": list(data.keys())}, {"state":"executed","result":res,"backup_uri":backup_uri})
+    return {"status":"ok","result":res,"backup_uri":backup_uri}
