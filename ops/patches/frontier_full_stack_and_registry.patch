+#!/usr/bin/env python3
+"""
+Simple uploader for chargeback records to S3. In production, stream to billing DB.
+"""
+import os, json, tempfile
+def upload_charge_record(record: dict, evidence_bucket: str = None):
+    import boto3
+    if evidence_bucket is None:
+        evidence_bucket = os.environ.get("EVIDENCE_BUCKET", "")
+    if not evidence_bucket:
+        print("No evidence bucket configured; charge record:", record)
+        return None
+    s3 = boto3.client("s3")
+    tmp = tempfile.mktemp(suffix=".json")
+    with open(tmp, "w") as f:
+        json.dump(record, f)
+    key = f"billing/charge-{int(__import__('time').time())}.json"
+    s3.upload_file(tmp, evidence_bucket.replace("s3://",""), key)
+    return f"s3://{evidence_bucket.replace('s3://','')}/{key}"
+
