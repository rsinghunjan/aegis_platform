+#!/usr/bin/env bash
+#
+# Example: sign an S3 object reference using cosign with a KMS-backed key (PoC)
+# Requires cosign and configured KMS key/provider per cosign docs.
+ARTIFACT_URI=$1
+KMS_KEY_REF=${2:-}
