+#!/usr/bin/env python3
+"""
+Simple cost estimator for preflight gating.
+ - For managed APIs, uses configured prices (env)
+ - For self-hosted, estimates GPU-seconds based on model size hints
+"""
+import os
+
+MODEL_GPU_SEC_PER_TOKEN = {
+    "big-llm-v1": 0.005,  # placeholder GPU-seconds per token; tune with benchmarking
+    "small-llm": 0.0005,
+}
+
+MANAGED_COSTS_PER_1K_TOKENS = float(os.environ.get("MANAGED_COST_PER_1K", "0.02"))
+GPU_COST_PER_SEC = float(os.environ.get("GPU_COST_PER_SEC", "0.10"))
+
+def estimate_cost(model: str, tokens: int) -> float:
+    if model in MODEL_GPU_SEC_PER_TOKEN:
+        gpu_sec = MODEL_GPU_SEC_PER_TOKEN[model] * tokens
+        return gpu_sec * GPU_COST_PER_SEC
+    # fallback to managed cost estimate
+    return (tokens / 1000.0) * MANAGED_COSTS_PER_1K_TOKENS
+
