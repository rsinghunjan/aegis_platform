+#!/usr/bin/env python3
+"""
+Model registry helper: uploads model metadata and artifacts to artifact store and registers signed metadata.
+ - uploads metadata JSON to S3 (or registry)
+ - optionally runs cosign to sign artifact URLs (shelling out to cosign)
+"""
+import argparse
+import json
+import os
+import subprocess
+import tempfile
+import boto3
+
+def upload_metadata(evidence_bucket: str, model_name: str, metadata: dict):
+    s3 = boto3.client("s3")
+    bucket = evidence_bucket.replace("s3://","")
+    key = f"models/{model_name}/metadata-{int(__import__('time').time())}.json"
+    tmp = tempfile.mktemp(suffix=".json")
+    with open(tmp, "w") as f:
+        json.dump(metadata, f, indent=2)
+    s3.upload_file(tmp, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def cosign_sign(artifact_uri: str, key_ref: str = None):
+    # key_ref could be a KMS-backed reference like "gcpkms://..." or "aws-kms://..."
+    cmd = ["cosign", "sign", "--yes", artifact_uri]
+    if key_ref:
+        cmd = ["cosign", "sign", "--key", key_ref, artifact_uri]
+    print("Running:", " ".join(cmd))
+    subprocess.check_call(cmd)
+    return True
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--evidence-bucket", required=True)
+    p.add_argument("--model-name", required=True)
+    p.add_argument("--metadata-file", required=True)
+    p.add_argument("--cosign-key-ref", required=False)
+    args = p.parse_args()
+    metadata = json.load(open(args.metadata_file))
+    uri = upload_metadata(args.evidence_bucket, args.model_name, metadata)
+    print("Uploaded metadata to", uri)
+    if args.cosign_key_ref:
+        cosign_sign(uri, args.cosign_key_ref)
+        print("Signed metadata with cosign")
+
+if __name__ == "__main__":
+    main()
+
