+#!/usr/bin/env python3
+"""
+Gateway router for frontier workloads.
+ - Routes requests to managed adapter (default) or to self-hosted frontier endpoints based on model policy
+ - Performs cost preflight and chargeback logging (best-effort)
+ - Enforces simple policy: managed_by default unless model in self-hosted allowlist
+"""
+import os
+import json
+import time
+import requests
+from fastapi import FastAPI, HTTPException, Request
+from pydantic import BaseModel
+from services.frontier import registry
+from ops.costing.cost_estimator import estimate_cost
+from ops.telemetry.chargeback_uploader import upload_charge_record
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+MANAGED_ADAPTER = os.environ.get("MANAGED_ADAPTER_URL", "http://aegis-llm-adapter.ml-serving.svc.cluster.local:8080")
+SELF_HOSTED_PREFIX = os.environ.get("SELF_HOSTED_PREFIX", "http://aegis-deepspeed-prod.ml-serving.svc.cluster.local:8080")
+SELF_HOSTED_MODELS = os.environ.get("SELF_HOSTED_MODELS", "")  # comma-separated list
+
+app = FastAPI(title="Aegis Frontier Router")
+
+class InferenceRequest(BaseModel):
+    model: str
+    prompt: str
+    user: str = "unknown"
+    max_tokens: int = 64
+
+def is_self_hosted(model_name: str):
+    allowed = [m.strip() for m in SELF_HOSTED_MODELS.split(",") if m.strip()]
+    return model_name in allowed
+
+@app.post("/v1/infer")
+def infer(req: InferenceRequest):
+    # cost preflight
+    est_cost = estimate_cost(req.model, req.max_tokens)
+    # For chargeback: write early record
+    charge_record = {"model": req.model, "user": req.user, "est_cost": est_cost, "timestamp": time.time()}
+    try:
+        upload_charge_record(charge_record)
+    except Exception as e:
+        # non-blocking
+        print("charge upload err", e)
+    # route
+    if is_self_hosted(req.model):
+        url = SELF_HOSTED_PREFIX + "/v1/infer"
+    else:
+        url = MANAGED_ADAPTER + "/v1/chat"
+    payload = {"prompt": req.prompt, "model": req.model, "max_new_tokens": req.max_tokens, "user": req.user}
+    try:
+        r = requests.post(url, json=payload, timeout=60)
+        r.raise_for_status()
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
+    resp = r.json()
+    # billing finalize: record actual cost if returned
+    actual_cost = resp.get("cost")
+    if actual_cost:
+        charge_record["actual_cost"] = actual_cost
+        upload_charge_record(charge_record)
+    return {"request_id": resp.get("request_id",""), "response": resp}
+
+@app.get("/healthz")
+def health():
+    return {"status":"ok"}
+
