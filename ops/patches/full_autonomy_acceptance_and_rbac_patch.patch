+#!/usr/bin/env python3
+"""
+Template generator for verified wrappers.
+ - Scans a list of unwrapped tool names (provided by operator) and generates a wrapper file scaffold
+   that enforces RBAC, dry-run, idempotency checks, and backup hooks.
+ - Operators should fill implementation details per environment.
+"""
+import sys, os, json
+
+TEMPLATE = '''#!/usr/bin/env python3
+\"\"\"Wrapper for TOOL_NAME
+ - Enforces RBAC: is_allowed(user, "TOOL_NAME")
+ - Supports dry_run parameter
+ - Performs idempotency check and returns noop when appropriate
+ - Stores backup via backup_store.store_backup before executing side-effect
+\"\"\"
+from services.agent.rbac_manager import is_allowed
+from services.agent.backup_store import store_backup
+
+def wrapper_tool(user, **params):
+    if not is_allowed(user, "TOOL_NAME"):
+        raise PermissionError("user not allowed to call TOOL_NAME")
+    dry_run = params.get("dry_run", False)
+    # TODO: implement idempotency check
+    if dry_run:
+        return {"status":"dry_run_ok"}
+    # TODO: take backup (if applicable)
+    # backup_uri = store_backup("tool_backup", {{}})
+    # TODO: execute the underlying action
+    return {"status":"ok", "note":"implement actual call"}
+
+'''
+
+def generate(tool_list, out_dir="services/agent/tool_adapters/generated"):
+    os.makedirs(out_dir, exist_ok=True)
+    for t in tool_list:
+        fname = t.replace(".","_") + ".py"
+        with open(os.path.join(out_dir, fname), "w") as f:
+            f.write(TEMPLATE.replace("TOOL_NAME", t))
+    print("Generated wrappers in", out_dir)
+
+if __name__=="__main__":
+    if len(sys.argv) < 2:
+        print("Usage: rbac_wrapper_template.py tool1.tool2 ...")
+        sys.exit(2)
+    generate(sys.argv[1:])
+
