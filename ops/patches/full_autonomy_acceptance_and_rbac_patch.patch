+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Local wrapper to run the acceptance checks end‑to‑end (same tasks as CI).
+# Produces artifacts under ./out/acceptance/<timestamp> and optionally uploads to S3 (EVIDENCE_BUCKET).
+#
+OUT_DIR=${OUT_DIR:-./out/acceptance/$(date -u +%Y%m%dT%H%M%SZ)}
+mkdir -p "$OUT_DIR"
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+
+echo "Running tokenization parity test..."
+python tests/generative/tokenization_parity_test.py --prompts ops/generative/sample_prompts.txt || { echo "tokenization failed"; exit 2; }
+
+echo "Running deterministic inference test (staging endpoint must be configured)..."
+python tests/generative/deterministic_inference_test.py --url ${GEN_STAGING_URL:-http://localhost:8000/generate} --prompt "Deterministic test" --repeats 3 --seed 42 || { echo "deterministic test failed"; exit 2; }
+
+echo "Running verifier calibration..."
+python services/factuality/verifier_calibration_on_holdout.py || true
+cp out/calib/thresholds.json "$OUT_DIR/" || true
+
+echo "Running short shadow run..."
+python services/generative/shadow_runner.py --sample-count 100 || true
+python services/generative/shadow_aggregator.py --window-hours 1 --out "$OUT_DIR/shadow_report.json" || true
+
+echo "Running ingest load test..."
+python tests/ingest/ingest_load_test.py --server ${INGEST_SERVER:-http://localhost:8080} --files ops/multimodal/sample_images/* --parallel 10 --fail-rate 0.02 > "$OUT_DIR/ingest_load_result.json" || true
+
+echo "Running planner hallucination monitor..."
+python services/agent/hallucination_monitor.py > "$OUT_DIR/planner_report.json" || true
+
+echo "Packaging models and triggering triton reload (if configured)..."
+./scripts/package_triton_model.sh models/vision_sample vision_encoder /tmp/model_store || true
+python scripts/triton_model_control.py --server ${TRITON_HOST:-localhost:8000} --reload || true
+
+echo "Generate evidence manifest..."
+python ops/ci/generate_evidence_manifest.py --run-id local-$(date -u +%Y%m%dT%H%M%SZ) --out "$OUT_DIR/evidence_manifest.json" || true
+
+if [ -n "$EVIDENCE_BUCKET" ]; then
+  echo "Uploading artifacts to s3://$EVIDENCE_BUCKET/acceptance/..."
+  aws s3 cp "$OUT_DIR" "s3://$EVIDENCE_BUCKET/acceptance/$(basename $OUT_DIR)/" --recursive || true
+fi
+
+echo "Acceptance checks complete. Artifacts in $OUT_DIR"
+
