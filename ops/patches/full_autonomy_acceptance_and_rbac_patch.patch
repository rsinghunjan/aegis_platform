+#!/usr/bin/env python3
+"""
+Collects acceptance artifacts and generates a small manifest for auditing.
+ - Expects the following files to exist under a working directory or default locations:
+   out/calib/thresholds.json, /tmp/shadow_report.json, /tmp/ingest_load_result.json, planner report, etc.
+ - Produces a JSON manifest listing artifacts and basic metadata.
+"""
+import argparse, json, os, time
+
+def gather(run_id, out):
+    files = {}
+    candidates = [
+        ("verifier_thresholds","out/calib/thresholds.json"),
+        ("shadow_report","/tmp/shadow_report.json"),
+        ("ingest_result","/tmp/ingest_load_result.json"),
+        ("planner_report","out/planner_report.json"),
+        ("evidence_manifest","/tmp/evidence_manifest.json")
+    ]
+    for name, path in candidates:
+        if os.path.exists(path):
+            files[name] = {"path": path, "size": os.path.getsize(path), "mtime": os.path.getmtime(path)}
+    manifest = {"run_id": run_id, "ts": int(time.time()), "artifacts": files}
+    with open(out,"w") as f:
+        json.dump(manifest, f, indent=2)
+    print("Wrote manifest to", out)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--run-id", required=True)
+    p.add_argument("--out", required=True)
+    args = p.parse_args()
+    gather(args.run_id, args.out)
+
