+#!/usr/bin/env python3
+"""
+RBAC manager for agent tool calls.
+ - Reads user->roles mapping from in-cluster ConfigMap 'agent-rbac' if available, otherwise falls back to env USER_ROLE_MAP.
+ - ROLE_TOOL_MAP continues to define which roles can call which tools.
+"""
+import os, json
+from typing import List
+try:
+    from kubernetes import client, config
+    K8S_AVAILABLE = True
+except Exception:
+    K8S_AVAILABLE = False
+
+DEFAULT_ROLE_MAP = {
+    "sre": ["k8s.set_image", "k8s.scale_deployment", "k8s.create_configmap"],
+    "ml-lead": ["policy.update_serving_policy","k8s.set_image"],
+    "rater": [],
+    "admin": ["*"]
+}
+
+ROLE_MAP = json.loads(os.environ.get("ROLE_TOOL_MAP", json.dumps(DEFAULT_ROLE_MAP)))
+
+def load_user_role_map_from_configmap(namespace="default", name="agent-rbac"):
+    if not K8S_AVAILABLE:
+        return {}
+    try:
+        config.load_incluster_config()
+    except Exception:
+        try:
+            config.load_kube_config()
+        except Exception:
+            return {}
+    v1 = client.CoreV1Api()
+    try:
+        cm = v1.read_namespaced_config_map(name=name, namespace=namespace)
+        data = cm.data.get("USER_ROLE_MAP","{}")
+        return json.loads(data)
+    except Exception:
+        return {}
+
+# cached user map
+_USER_ROLE_MAP = {}
+
+def refresh_user_map(namespace="default", name="agent-rbac"):
+    global _USER_ROLE_MAP
+    cm = load_user_role_map_from_configmap(namespace,name)
+    if cm:
+        _USER_ROLE_MAP = cm
+    else:
+        try:
+            _USER_ROLE_MAP = json.loads(os.environ.get("USER_ROLE_MAP","{}"))
+        except Exception:
+            _USER_ROLE_MAP = {}
+    return _USER_ROLE_MAP
+
+def user_roles(user: str) -> List[str]:
+    if not _USER_ROLE_MAP:
+        refresh_user_map()
+    if user in _USER_ROLE_MAP:
+        return _USER_ROLE_MAP[user]
+    if user == "ci":
+        return ["sre"]
+    if user.startswith("ml-"):
+        return ["ml-lead"]
+    return ["rater"]
+
+def is_allowed(user: str, tool_name: str) -> bool:
+    roles = user_roles(user)
+    for r in roles:
+        allowed = ROLE_MAP.get(r, [])
+        if "*" in allowed:
+            return True
+        if tool_name in allowed:
+            return True
+    return False
+
+if __name__=="__main__":
+    print("RBAC manager loaded; current map keys:", list(refresh_user_map().keys())[:5])
+
