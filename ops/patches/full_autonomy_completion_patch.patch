+#!/usr/bin/env python3
+"""
+Policy adapter wrapper: apply serving policy changes via ConfigMap and return previous state.
+Supports dry_run and produces an auditable result.
+"""
+import subprocess, json, time
+from services.agent.backup_store import store_backup
+
+def update_serving_policy(namespace: str, name: str, data: dict, dry_run=False):
+    """
+    name: configmap name (e.g., serving-policy-tenantA)
+    data: dictionary of policy entries
+    """
+    # capture current CM for backup
+    prev = None
+    try:
+        prev_raw = subprocess.check_output(["kubectl","-n",namespace,"get","configmap",name,"-o","json"], stderr=subprocess.DEVNULL)
+        prev = json.loads(prev_raw.decode("utf-8"))
+    except Exception:
+        prev = None
+    if dry_run:
+        return {"status":"dry_run","would_apply": data, "previous_present": bool(prev)}
+    # apply new CM via kubectl apply - create temp file
+    import tempfile, os
+    cm = {"apiVersion":"v1","kind":"ConfigMap","metadata":{"name":name,"namespace":namespace},"data":{k:str(v) for k,v in data.items()}}
+    t = tempfile.NamedTemporaryFile(delete=False, mode="w")
+    json.dump(cm, t); t.close()
+    subprocess.check_call(["kubectl","apply","-f", t.name])
+    # store backup of previous if exists
+    if prev:
+        bk = store_backup(f"policy_{name}_{int(time.time())}", prev)
+    else:
+        bk = None
+    return {"status":"applied","backup_uri": bk}
+
