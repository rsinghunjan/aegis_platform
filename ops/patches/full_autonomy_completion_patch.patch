+#!/usr/bin/env python3
+"""
+HTTP proxy that forwards requests to the production generation endpoint and asynchronously mirrors (shadows)
+the request to a candidate endpoint. Useful as middleware in front of production service for long-shadow collection.
+ - Configure PROD_URL and CANDIDATE_URL
+ - Writes shadow records to local SHADOW_OUT or EVIDENCE_BUCKET using audit_logger.s3_put
+"""
+from fastapi import FastAPI, Request, Response
+import os, asyncio, aiohttp, time, json
+from services.agent.audit_logger import s3_put
+
+PROD_URL = os.environ.get("PROD_URL")
+CANDIDATE_URL = os.environ.get("CANDIDATE_URL")
+SHADOW_OUT = os.environ.get("SHADOW_OUT", "/data/shadow_generations.jsonl")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+app = FastAPI(title="Aegis Shadow Proxy")
+
+async def forward(session, url, payload):
+    async with session.post(url, json=payload, timeout=30) as resp:
+        text = await resp.text()
+        try:
+            return json.loads(text)
+        except Exception:
+            return {"raw": text, "status": resp.status}
+
+@app.post("/generate")
+async def generate(req: Request):
+    payload = await req.json()
+    async with aiohttp.ClientSession() as session:
+        # forward to prod synchronously
+        prod_resp = await forward(session, PROD_URL, payload)
+        # schedule shadow to candidate asynchronously
+        async def do_shadow():
+            try:
+                cand_resp = await forward(session, CANDIDATE_URL, payload)
+            except Exception as e:
+                cand_resp = {"error": str(e)}
+            rec = {"ts": time.time(), "request": payload, "prod": {"resp": prod_resp}, "candidate": {"resp": cand_resp}}
+            # write to local file
+            try:
+                with open(SHADOW_OUT, "a") as f:
+                    f.write(json.dumps(rec) + "\n")
+            except Exception:
+                pass
+            # upload to evidence bucket if configured
+            if EVIDENCE_BUCKET:
+                try:
+                    s3_put(f"gen_shadow/{int(time.time())}.json", rec)
+                except Exception:
+                    pass
+        asyncio.create_task(do_shadow())
+        # return production response to caller
+        return Response(content=json.dumps(prod_resp), media_type="application/json")
+
+if __name__=="__main__":
+    import uvicorn
+    uvicorn.run("services.generative.request_shadow_proxy:app", host="0.0.0.0", port=int(os.environ.get("PORT", "8080")))
+
