+#!/usr/bin/env python3
+"""
+Storage adapter wrappers for safe object operations (S3).
+ - Provides safe_delete_object which moves object to a tombstone/backup prefix instead of immediate delete.
+ - Requires S3 bucket configured in env STORAGE_BUCKET
+"""
+import os, boto3, time
+from urllib.parse import urlparse
+
+STORAGE_BUCKET = os.environ.get("MM_STORE_BUCKET", "")
+S3_REGION = os.environ.get("AWS_REGION", "us-west-2")
+
+def s3_client():
+    return boto3.client("s3", region_name=S3_REGION)
+
+def safe_delete_object(s3_uri):
+    """
+    Move object s3://bucket/key -> s3://bucket/.tombstone/key_TIMESTAMP
+    """
+    parsed = urlparse(s3_uri)
+    bucket = parsed.netloc
+    key = parsed.path.lstrip("/")
+    client = s3_client()
+    tomb = f".tombstone/{key}.{int(time.time())}"
+    client.copy_object(Bucket=bucket, CopySource={"Bucket":bucket,"Key":key}, Key=tomb)
+    client.delete_object(Bucket=bucket, Key=key)
+    return {"status":"moved_to_tombstone","tombstone_uri": f"s3://{bucket}/{tomb}"}
+
