+#!/usr/bin/env python3
+"""
+Keycloak / OIDC group -> role sync for agent RBAC.
+ - Fetches group membership from Keycloak (or generic OIDC with group endpoint)
+ - Builds a USER_ROLE_MAP (user -> [roles]) JSON and writes to a Kubernetes ConfigMap 'agent-rbac' in the agent namespace.
+ - Fallback to writing to local file when not running in-cluster.
+"""
+import os, json, requests
+from kubernetes import client, config
+
+KEYCLOAK_URL = os.environ.get("KEYCLOAK_URL")  # e.g., https://keycloak.example.com
+REALM = os.environ.get("KEYCLOAK_REALM", "master")
+ADMIN_TOKEN = os.environ.get("KEYCLOAK_ADMIN_TOKEN", "")
+AGENT_NS = os.environ.get("AGENT_NAMESPACE", "default")
+CONFIGMAP_NAME = os.environ.get("AGENT_RBAC_CONFIGMAP", "agent-rbac")
+
+def fetch_users_and_groups():
+    # This is a small Keycloak-specific implementation. For other IdPs adapt endpoints.
+    if not KEYCLOAK_URL or not ADMIN_TOKEN:
+        raise RuntimeError("KEYCLOAK_URL and KEYCLOAK_ADMIN_TOKEN must be set")
+    headers = {"Authorization": f"Bearer {ADMIN_TOKEN}", "Accept": "application/json"}
+    # list users
+    users = requests.get(f"{KEYCLOAK_URL}/admin/realms/{REALM}/users", headers=headers, timeout=30).json()
+    user_map = {}
+    for u in users:
+        username = u.get("username")
+        # get groups for user
+        groups = requests.get(f"{KEYCLOAK_URL}/admin/realms/{REALM}/users/{u['id']}/groups", headers=headers, timeout=30).json()
+        user_map[username] = [g.get("name") for g in groups]
+    return user_map
+
+def map_groups_to_roles(user_groups_map, group_to_role_map):
+    # group_to_role_map: dict group->role
+    out = {}
+    for user, groups in user_groups_map.items():
+        roles = set()
+        for g in groups:
+            if g in group_to_role_map:
+                roles.add(group_to_role_map[g])
+        if not roles:
+            roles.add("rater")
+        out[user] = list(roles)
+    return out
+
+def write_configmap(data):
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    v1 = client.CoreV1Api()
+    cm = client.V1ConfigMap(metadata=client.V1ObjectMeta(name=CONFIGMAP_NAME), data={"USER_ROLE_MAP": json.dumps(data)})
+    try:
+        v1.create_namespaced_config_map(namespace=AGENT_NS, body=cm)
+        print("Created ConfigMap", CONFIGMAP_NAME)
+    except client.exceptions.ApiException as e:
+        if e.status == 409:
+            v1.patch_namespaced_config_map(name=CONFIGMAP_NAME, namespace=AGENT_NS, body=cm)
+            print("Patched ConfigMap", CONFIGMAP_NAME)
+        else:
+            raise
+
+def main():
+    # Optional: supply mapping via env GROUP_TO_ROLE_JSON
+    g2r = {}
+    if os.environ.get("GROUP_TO_ROLE_JSON"):
+        g2r = json.loads(os.environ.get("GROUP_TO_ROLE_JSON"))
+    else:
+        # sensible defaults
+        g2r = {"sre":"sre", "ml-leads":"ml-lead", "admins":"admin"}
+    users = fetch_users_and_groups()
+    mapped = map_groups_to_roles(users, g2r)
+    write_configmap(mapped)
+    print("Wrote USER_ROLE_MAP entries:", len(mapped))
+
+if __name__=="__main__":
+    main()
+
