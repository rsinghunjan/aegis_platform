+#!/usr/bin/env bash
+set -euo pipefail
+# Controlled rollout of Gatekeeper constraints to enforcement=deny and validating webhook verification
+EVIDENCE=${EVIDENCE:-}
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --evidence) EVIDENCE="$2"; shift 2;;
+    *) echo "Unknown arg $1"; exit 1;;
+  esac
+done
+
+if [ -z "$EVIDENCE" ]; then
+  echo "Usage: $0 --evidence s3://bucket"; exit 1
+fi
+
+echo "Ensure cert-manager is installed and a Certificate exists for cosign-validator"
+kubectl -n kube-system rollout status deploy/cosign-validator || true
+
+echo "Patch constraints to deny (controlled): (this will attempt to patch constraints listed in ops/gatekeeper/enforce-list.txt)"
+if [ -f ops/gatekeeper/enforce-list.txt ]; then
+  while read -r c; do
+    c=$(echo "$c" | sed 's/#.*//;s/^\s*//;s/\s*$//')
+    [ -z "$c" ] && continue
+    echo "Patching constraint $c to deny"
+    kubectl patch constraint "$c" --type='json' -p='[{"op":"replace","path":"/spec/enforcementAction","value":"deny"}]' || true
+  done < ops/gatekeeper/enforce-list.txt
+else
+  echo "No constraint list found; skipping constraint patch"
+fi
+
+echo "Verify validating webhook rejects a test Pod without cosign annotation"
+TMP=/tmp/gk-test-pod.yaml
+cat > $TMP <<EOF
+apiVersion: v1
+kind: Pod
+metadata:
+  name: gatekeeper-test-no-sig
+  namespace: default
+spec:
+  containers:
+  - name: c
+    image: busybox
+    command: ["sleep", "3600"]
+EOF
+
+if kubectl apply -f $TMP >/dev/null 2>&1; then
+  echo "WARN: Pod creation succeeded but should have been denied by Gatekeeper"
+  kubectl delete -f $TMP || true
+  exit 2
+else
+  echo "Gatekeeper appears to deny non-compliant Pod as expected"
+fi
+
+rm -f $TMP
+
+REPORT=/tmp/gk_verify_$(date +%s).json
+echo "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"result\":\"deny-tested\"}" > $REPORT
+aws s3 cp $REPORT ${EVIDENCE}/governance/ || true
+echo "Uploaded Gatekeeper verification to ${EVIDENCE}/governance/"
+
