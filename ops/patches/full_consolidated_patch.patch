+"""
+Aggregate weekly/monthly SLO snapshots, cosign-sign them (if key present) and upload to evidence.
+"""
+import os, argparse, json, logging, subprocess
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log=logging.getLogger("longterm-agg")
+
+def collect():
+    subprocess.check_call(["python3", "services/reliability/collect_long_term_slo.py"])
+    rp="/tmp/longterm_slo.json"
+    if not os.path.exists(rp):
+        open(rp,"w").write(json.dumps({"ts": datetime.utcnow().isoformat(), "note":"pooled"}))
+    return rp
+
+def sign(path):
+    key="/secrets/cosign.key"
+    if os.path.exists(key):
+        try:
+            subprocess.check_call(["cosign","sign-blob","--key", key, path])
+            return True
+        except Exception:
+            log.exception("cosign sign failed")
+            return False
+    return False
+
+def upload(path, evidence):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    key=f"reliability/longterm-{int(time.time())}.json"
+    s3.upload_file(path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True)
+    args=p.parse_args()
+    rp = collect()
+    signed = sign(rp)
+    uri=upload(rp, args.evidence)
+    print(json.dumps({"uploaded": uri, "signed": signed}))
+
