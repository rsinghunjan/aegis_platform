+import os, argparse, json, logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log=logging.getLogger("explain-indexer")
+
+def list_manifests(evidence, prefix="closedloop/"):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix=prefix, MaxKeys=10000)
+    keys=[o["Key"] for o in resp.get("Contents",[])]
+    return [k for k in keys if "explainability/manifest.json" in k]
+
+def check_acl(evidence, key):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    acl_key=key.replace("explainability/manifest.json","explainability/acl.json")
+    try:
+        s3.head_object(Bucket=bucket, Key=acl_key)
+        return True
+    except Exception:
+        return False
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True)
+    args=p.parse_args()
+    manifests=list_manifests(args.evidence)
+    index=[]
+    for m in manifests:
+        acl_ok = check_acl(args.evidence, m)
+        index.append({"manifest_key": m, "acl_ok": acl_ok})
+    payload={"ts": datetime.utcnow().isoformat(), "count": len(index), "entries": index}
+    out="/tmp/explain_index_"+str(int(time.time()))+".json"
+    open(out,"w").write(json.dumps(payload, indent=2))
+    import boto3
+    s3=boto3.client("s3")
+    s3.upload_file(out, args.evidence.replace("s3://",""), f"explainability/index-{int(time.time())}.json")
+    print(json.dumps(payload))
