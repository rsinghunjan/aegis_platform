+#!/usr/bin/env python3
+"""
+Compute OTEL span coverage for critical spans (run_id & business_kpi) using coverage reports uploaded to S3.
+Writes a small JSON summary to stdout and S3 (if EVIDENCE_BUCKET set).
+"""
+import os, argparse, json, logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("otel-coverage-checker")
+
+def find_latest_report(bucket, prefix="otel/coverage"):
+    import boto3
+    s3=boto3.client("s3")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix=prefix, MaxKeys=100)
+    items=resp.get("Contents",[])
+    if not items:
+        return None
+    items.sort(key=lambda x: x["LastModified"], reverse=True)
+    return items[0]["Key"]
+
+def load_report(bucket, key):
+    import boto3
+    s3=boto3.client("s3")
+    obj=s3.get_object(Bucket=bucket, Key=key)
+    return json.loads(obj["Body"].read().decode())
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True)
+    args=p.parse_args()
+    bucket=args.evidence.replace("s3://","")
+    key = find_latest_report(bucket)
+    if not key:
+        log.error("No OTEL coverage report found in s3://%s/otel/", bucket)
+        raise SystemExit(2)
+    rpt = load_report(bucket, key)
+    cov = rpt.get("coverage", 0.0)
+    out = {"ts": str(datetime.utcnow()), "coverage": cov, "s3_key": key}
+    print(json.dumps(out))
+
+if __name__ == "__main__":
+    main()
+
