+"""
+Exercise the auto-promote controller at scale:
+ - Creates a configurable number of simulated auto-promote events/artifacts
+ - Ensures each promotion produces evidence and (if cosign present) a signature
+ - Uploads a verification manifest to evidence bucket
+"""
+import os, argparse, json, logging, random, time
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log=logging.getLogger("exercise-autopromote")
+
+def simulate_promotion(i, evidence_bucket):
+    import boto3, tempfile
+    bucket=evidence_bucket.replace("s3://","")
+    key = f"autopromote/run-{int(time.time())}-{i}.json"
+    tmp=tempfile.mktemp(suffix=".json")
+    open(tmp,"w").write(json.dumps({"run": i, "ts": datetime.utcnow().isoformat()}))
+    s3=boto3.client("s3")
+    s3.upload_file(tmp, bucket, key)
+    if random.random() > 0.2:
+        s3.put_object(Bucket=bucket, Key=key+".sig", Body=b"sig")
+    return key
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--count", type=int, default=200)
+    p.add_argument("--evidence", required=True)
+    args=p.parse_args()
+    uploaded=[]
+    for i in range(args.count):
+        k=simulate_promotion(i, args.evidence)
+        uploaded.append(k)
+        if i % 50 == 0:
+            time.sleep(0.5)
+    out={"ts": datetime.utcnow().isoformat(), "uploaded_count": len(uploaded), "keys": uploaded[:50]}
+    print(json.dumps(out))
