+#!/usr/bin/env python3
+"""
+Auto-run orchestrator + post-process script.
+"""
+import argparse
+import os
+import subprocess
+import time
+import json
+import logging
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("auto-run")
+
+DEFAULT_POLL_TIMEOUT_MIN = 360
+POLL_INTERVAL = 60
+
+def run(cmd, capture=False, check=True, env=None):
+    log.info("RUN: %s", " ".join(cmd))
+    try:
+        if capture:
+            return subprocess.check_output(cmd, env=env).decode()
+        subprocess.check_call(cmd, env=env)
+        return ""
+    except subprocess.CalledProcessError:
+        log.exception("command failed: %s", cmd)
+        if check:
+            raise
+        return ""
+
+def trigger_tekton(pipelinerun_yaml):
+    run(["kubectl", "apply", "-f", pipelinerun_yaml], check=True)
+
+def trigger_gh_dispatch():
+    script = "ops/ci/dispatch_ready.sh"
+    if os.path.exists(script):
+        run([script], check=True)
+    else:
+        raise RuntimeError("dispatch script not found: {}".format(script))
+
+def trigger_local_orchestrator():
+    run(["python3", "ops/production/level4_proofs_executor.py"], check=True)
+
+def poll_for_final_summary(evidence_bucket, timeout_minutes=DEFAULT_POLL_TIMEOUT_MIN):
+    import boto3
+    s3 = boto3.client("s3")
+    bucket = evidence_bucket.replace("s3://", "")
+    deadline = datetime.utcnow() + timedelta(minutes=timeout_minutes)
+    while datetime.utcnow() < deadline:
+        try:
+            resp = s3.list_objects_v2(Bucket=bucket, Prefix="production_proofs/", MaxKeys=1000)
+            items = resp.get("Contents", [])
+            finals = [i for i in items if i["Key"].startswith("production_proofs/final-summary")]
+            if finals:
+                finals.sort(key=lambda x: x["LastModified"], reverse=True)
+                key = finals[0]["Key"]
+                local = "/tmp/acceptance_{}.json".format(int(time.time()))
+                s3.download_file(bucket, key, local)
+                return local, "s3://{}/{}".format(bucket, key)
+        except Exception:
+            log.exception("S3 poll failed")
+        time.sleep(POLL_INTERVAL)
+    raise TimeoutError("Timed out waiting for final summary")
+
+def run_validators(evidence_bucket, validators=None):
+    validators = validators or [
+        ("checkpoint", ["python3", "services/hpo/checkpoint_analyzer.py", "--evidence", evidence_bucket, "--threshold", "0.90"]),
+        ("otel", ["python3", "services/telemetry/otel_span_coverage_checker.py", "--evidence", evidence_bucket]),
+        ("opa", ["python3", "services/decisioning/opa_full_harness_runner.py", "--evidence", evidence_bucket]),
+        ("remediation", ["python3", "services/failure/remediation_analyzer.py", "--evidence", evidence_bucket, "--threshold", "0.90"]),
+        ("explainability", ["python3", "services/explainability/manifest_index_and_attach.py", "--evidence", evidence_bucket]),
+    ]
+    results = {}
+    for name, cmd in validators:
+        try:
+            out = run(cmd, capture=True, check=True)
+            try:
+                data = json.loads(out) if out else {}
+            except Exception:
+                data = {"raw_output": out}
+            results[name] = {"ok": True, "result": data}
+        except Exception as e:
+            log.exception("Validator failed: %s", name)
+            results[name] = {"ok": False, "error": str(e)}
+    return results
+
+def generate_backlog_and_issues(acceptance_json, create_issues=False, repo=None, assignee=None):
+    outpath = "/tmp/remediation_backlog_{}.md".format(int(time.time()))
+    run(["python3", "ops/scripts/generate_remediation_tickets.py", "--input", acceptance_json, "--out", outpath], check=True)
+    created = []
+    if create_issues:
+        if not repo:
+            raise RuntimeError("repo required to create issues")
+        run(["python3", "ops/scripts/generate_remediation_tickets.py", "--input", acceptance_json, "--out", outpath, "--create-issues", "--repo", repo, "--assignee", assignee], check=True)
+        created = ["created via script (see GH)"]
+    return outpath, created
+
+def upload_processing_report(evidence_bucket, report):
+    import boto3, tempfile
+    s3 = boto3.client("s3")
+    bucket = evidence_bucket.replace("s3://", "")
+    tmp = "/tmp/processing_report_{}.json".format(int(time.time()))
+    with open(tmp, "w") as f:
+        json.dump(report, f, indent=2)
+    key = "production_proofs/processing-report-{}.json".format(int(time.time()))
+    s3.upload_file(tmp, bucket, key)
+    return "s3://{}/{}".format(bucket, key)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--mode", choices=["tekton", "gh", "local"], default="tekton")
+    p.add_argument("--pipelinerun", default="ops/tekton/pipelineruns/production_proofs_pr_ready.yaml")
+    p.add_argument("--evidence", default=os.environ.get("EVIDENCE_BUCKET", ""))
+    p.add_argument("--timeout-min", type=int, default=DEFAULT_POLL_TIMEOUT_MIN)
+    p.add_argument("--create-issues", action="store_true")
+    p.add_argument("--repo", default=os.environ.get("REPO", "rsinghunjan/aegis"))
+    p.add_argument("--assignee", default=os.environ.get("ASSIGNEE", "rsinghunjan"))
+    args = p.parse_args()
+    if not args.evidence:
+        log.error("EVIDENCE_BUCKET not set. Export or use --evidence")
+        return 2
+    if args.mode == "tekton":
+        trigger_tekton(args.pipelinerun)
+    elif args.mode == "gh":
+        trigger_gh_dispatch()
+    else:
+        trigger_local_orchestrator()
+    try:
+        acceptance_local, acceptance_s3 = poll_for_final_summary(args.evidence, timeout_minutes=args.timeout_min)
+    except Exception as e:
+        log.exception("Failed to obtain final summary: %s", e)
+        return 2
+    validators_results = run_validators(args.evidence)
+    backlog_path, created = generate_backlog_and_issues(acceptance_local, create_issues=args.create_issues, repo=args.repo, assignee=args.assignee)
+    report = {
+        "ts": datetime.utcnow().isoformat(),
+        "evidence_bucket": args.evidence,
+        "acceptance_summary_s3": acceptance_s3,
+        "validators": validators_results,
+        "backlog": backlog_path,
+        "created_issues": created,
+    }
+    upload_processing_report(args.evidence, report)
+    required = ["checkpoint", "otel", "opa", "remediation"]
+    failed = [k for k in required if not validators_results.get(k, {}).get("ok", False)]
+    if failed:
+        log.error("Required validators failed: %s", failed)
+        return 2
+    log.info("Processing complete. All required validators reported OK.")
+    return 0
+
+if __name__ == "__main__":
+    import argparse, sys
+    sys.exit(main())
+
