+#!/usr/bin/env python3
+"""
+Readiness calculator for Level-4 promotion.
+"""
+import os
+import sys
+import json
+import time
+import argparse
+import logging
+import subprocess
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("readiness")
+
+DEFAULT_WEIGHTS = {
+    "hpo_checkpoints": 20,
+    "longshadow_2k": 20,
+    "otel_coverage": 10,
+    "opa_mismatch": 10,
+    "remediation": 10,
+    "security": 15,
+    "gatekeeper_canary": 5,
+    "billing_quota": 5,
+    "explainability": 3,
+    "longterm_slo": 2,
+}
+
+def run_cmd(cmd, capture=True, check=True):
+    log.debug("RUN: %s", " ".join(cmd))
+    try:
+        if capture:
+            return subprocess.check_output(cmd).decode().strip()
+        subprocess.check_call(cmd)
+        return ""
+    except subprocess.CalledProcessError:
+        if check:
+            raise
+        return ""
+
+def s3_key_exists(bucket, key_prefix):
+    import boto3
+    s3=boto3.client("s3")
+    try:
+        resp=s3.list_objects_v2(Bucket=bucket.replace("s3://",""), Prefix=key_prefix, MaxKeys=1)
+        return resp.get("KeyCount",0) > 0
+    except Exception:
+        log.exception("s3 list failed for %s %s", bucket, key_prefix)
+        return False
+
+def analyze_checkpoints(evidence, threshold):
+    try:
+        out = run_cmd(["python3","services/hpo/checkpoint_analyzer.py","--evidence", evidence, "--threshold", str(threshold)], capture=True, check=True)
+        data = json.loads(out) if out else {}
+        ok = True
+    except SystemExit:
+        ok = False
+        data = {}
+    except Exception:
+        ok = False
+        data = {}
+    return {"ok": ok, "detail": data}
+
+def analyze_longshadow_and_2k(evidence):
+    bucket = evidence
+    has_long = s3_key_exists(bucket, "longshadow/")
+    has_2k = s3_key_exists(bucket, "stress/")
+    ok = has_long and has_2k
+    return {"ok": ok, "has_longshadow": has_long, "has_2k": has_2k}
+
+def analyze_otel_coverage(evidence, threshold):
+    try:
+        out = run_cmd(["python3","services/telemetry/otel_span_coverage_checker.py","--evidence", evidence], capture=True, check=True)
+        rpt = json.loads(out)
+        cov = float(rpt.get("coverage", 0.0))
+        ok = cov >= threshold
+        return {"ok": ok, "coverage": cov, "s3_key": rpt.get("s3_key","")}
+    except Exception:
+        log.exception("otel analysis failed")
+        return {"ok": False, "coverage": 0.0}
+
+def analyze_opa(evidence, threshold):
+    try:
+        out = run_cmd(["python3","services/decisioning/opa_full_harness_runner.py","--evidence", evidence], capture=True, check=True)
+    except Exception:
+        log.warning("opa harness run failed or returned non-zero")
+    import boto3, json as _json
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    try:
+        resp=s3.list_objects_v2(Bucket=bucket, Prefix="opa/verdict", MaxKeys=10)
+        items=resp.get("Contents",[])
+        if not items:
+            return {"ok": False, "mismatch_rate": 1.0}
+        items.sort(key=lambda x: x["LastModified"], reverse=True)
+        key=items[0]["Key"]
+        obj=s3.get_object(Bucket=bucket, Key=key)
+        report=_json.loads(obj["Body"].read().decode())
+        rate=report.get("mismatch_rate", 1.0)
+        return {"ok": rate <= threshold, "mismatch_rate": rate, "s3_key": key}
+    except Exception:
+        log.exception("failed to read opa verdict")
+        return {"ok": False, "mismatch_rate": 1.0}
+
+def analyze_remediation(evidence, threshold):
+    try:
+        out = run_cmd(["python3","services/failure/remediation_analyzer.py","--evidence", evidence, "--threshold", str(threshold)], capture=True, check=True)
+        data = json.loads(out) if out else {}
+        ok = True
+    except Exception:
+        ok = False
+        data = {}
+    return {"ok": ok, "detail": data}
+
+def analyze_security(evidence):
+    import boto3
+    s3=boto3.client("s3")
+    try:
+        resp=s3.list_objects_v2(Bucket=evidence.replace("s3://",""), Prefix="security/", MaxKeys=100)
+        items=resp.get("Contents",[])
+        for obj in items:
+            if "summary" in obj["Key"]:
+                o=s3.get_object(Bucket=evidence.replace("s3://",""), Key=obj["Key"])
+                j=json.loads(o["Body"].read().decode())
+                crit = sum(1 for f in j.get("findings",[]) if f.get("severity") in ("critical","high"))
+                return {"ok": crit==0, "critical_findings": crit, "s3_key": obj["Key"]}
+    except Exception:
+        log.exception("security check failed")
+    return {"ok": False, "critical_findings": 1}
+
+def analyze_gatekeeper_canary(evidence):
+    ok = s3_key_exists(evidence, "governance/gk_verify")
+    if not ok:
+        ok = s3_key_exists(evidence, "governance/")
+    return {"ok": ok}
+
+def analyze_billing(evidence):
+    ok = s3_key_exists(evidence, "billing/")
+    return {"ok": ok}
+
+def analyze_explainability(evidence):
+    ok = s3_key_exists(evidence, "explainability/index")
+    return {"ok": ok}
+
+def analyze_longterm_slo(evidence, required_weeks=4):
+    import boto3
+    s3=boto3.client("s3")
+    try:
+        resp=s3.list_objects_v2(Bucket=evidence.replace("s3://",""), Prefix="reliability/weekly", MaxKeys=1000)
+        items=resp.get("Contents",[])
+        weeks=len(items)
+        ok = weeks >= required_weeks
+        return {"ok": ok, "weeks_collected": weeks}
+    except Exception:
+        log.exception("longterm slo check failed")
+        return {"ok": False, "weeks_collected": 0}
+
+def compute_readiness(results, weights=DEFAULT_WEIGHTS):
+    total_weight = sum(weights.values())
+    score = 0.0
+    breakdown = {}
+    mapping = {
+        "hpo_checkpoints": ("hpo", results.get("hpo_checkpoints",{})),
+        "longshadow_2k": ("longshadow", results.get("longshadow_2k",{})),
+        "otel_coverage": ("otel", results.get("otel_coverage",{})),
+        "opa_mismatch": ("opa", results.get("opa_mismatch",{})),
+        "remediation": ("remediation", results.get("remediation",{})),
+        "security": ("security", results.get("security",{})),
+        "gatekeeper_canary": ("gatekeeper", results.get("gatekeeper_canary",{})),
+        "billing_quota": ("billing", results.get("billing",{})),
+        "explainability": ("explainability", results.get("explainability",{})),
+        "longterm_slo": ("longterm_slo", results.get("longterm_slo",{})),
+    }
+    for key, (label, val) in mapping.items():
+        w = weights.get(key, 0)
+        ok = bool(val.get("ok", False))
+        contribution = w * (1.0 if ok else 0.0)
+        breakdown[key] = {"weight": w, "ok": ok, "contribution": contribution}
+        score += contribution
+    percent = (score / total_weight) * 100.0 if total_weight else 0.0
+    return {"percent": round(percent,2), "breakdown": breakdown, "total_weight": total_weight}
+
+def upload_report(evidence, report):
+    import boto3, tempfile
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    path=tempfile.mktemp(suffix=".json")
+    open(path,"w").write(json.dumps(report, indent=2))
+    key=f"production_proofs/readiness/readiness-{int(time.time())}.json"
+    s3.upload_file(path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--checkpoint-threshold", type=float, default=float(os.environ.get("CHECKPOINT_THRESHOLD","0.90")))
+    p.add_argument("--otel-threshold", type=float, default=float(os.environ.get("OTEL_THRESHOLD","0.90")))
+    p.add_argument("--opa-threshold", type=float, default=float(os.environ.get("OPA_MISMATCH_THRESHOLD","0.01")))
+    p.add_argument("--remediation-threshold", type=float, default=float(os.environ.get("REMEDIATION_THRESHOLD","0.90")))
+    p.add_argument("--required-slo-weeks", type=int, default=4)
+    args = p.parse_args()
+
+    evidence = os.environ.get("EVIDENCE_BUCKET", "")
+    if not evidence:
+        log.error("EVIDENCE_BUCKET must be set in environment")
+        sys.exit(2)
+
+    results = {}
+    try:
+        results["hpo_checkpoints"] = analyze_checkpoints(evidence, args.checkpoint_threshold)
+        results["longshadow_2k"] = analyze_longshadow_and_2k(evidence)
+        results["otel_coverage"] = analyze_otel_coverage(evidence, args.otel_threshold)
+        results["opa_mismatch"] = analyze_opa(evidence, args.opa_threshold)
+        results["remediation"] = analyze_remediation(evidence, args.remediation_threshold)
+        results["security"] = analyze_security(evidence)
+        results["gatekeeper_canary"] = analyze_gatekeeper_canary(evidence)
+        results["billing_quota"] = analyze_billing(evidence)
+        results["explainability"] = analyze_explainability(evidence)
+        results["longterm_slo"] = analyze_longterm_slo(evidence, args.required_slo_weeks)
+    except Exception as e:
+        log.exception("readiness analysis failed")
+
+    computed = compute_readiness(results)
+    report = {"ts": datetime.utcnow().isoformat(), "evidence_bucket": evidence, "results": results, "computed": computed}
+    print(json.dumps(report, indent=2))
+    try:
+        uri = upload_report(evidence, report)
+        log.info("Uploaded readiness report to %s", uri)
+    except Exception:
+        log.exception("Failed to upload readiness report")
+    return 0
+
+if __name__ == "__main__":
+    main()
+
