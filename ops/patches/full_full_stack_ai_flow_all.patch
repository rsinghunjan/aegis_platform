+#!/usr/bin/env python3
+"""
+Helper utilities for adding OpenTelemetry tracing & metric instrumentation across tasks and services.
+Usage:
+ - Import and call `init_tracing(service_name, exporter_url)` in Tekton task wrappers and python services.
+ - Use `span_context(run_id=...)` to annotate spans with run_id (evidence correlation).
+"""
+from opentelemetry import trace, metrics
+from opentelemetry.sdk.resources import Resource
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import BatchSpanProcessor, ConsoleSpanExporter
+from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
+from opentelemetry.sdk.metrics import MeterProvider
+from opentelemetry.exporter.otlp.proto.http.metric_exporter import OTLPMetricExporter
+import os
+
+def init_tracing(service_name="aegis-service", otlp_endpoint=None):
+    otlp_endpoint = otlp_endpoint or os.environ.get("OTLP_ENDPOINT")
+    resource = Resource.create({"service.name": service_name})
+    tp = TracerProvider(resource=resource)
+    if otlp_endpoint:
+        exporter = OTLPSpanExporter(endpoint=otlp_endpoint, insecure=True)
+        tp.add_span_processor(BatchSpanProcessor(exporter))
+    else:
+        tp.add_span_processor(BatchSpanProcessor(ConsoleSpanExporter()))
+    trace.set_tracer_provider(tp)
+    return trace.get_tracer(service_name)
+
+def span_context(tracer, run_id=None, attrs=None):
+    return tracer.start_as_current_span("aegis.run", attributes={"run_id": run_id} if run_id else attrs or {})
+
