+#!/usr/bin/env python3
+"""
+Redis-backed token-bucket rate limiter for per-tenant throttling (multi-replica safe).
+Usage: instantiate RedisRateLimiter(redis_url) and call allow(tenant) -> (bool, info)
+PoC uses simple Lua script for atomic tokens.
+"""
+import os, time, redis
+import logging
+
+logger = logging.getLogger("redis-rate-limiter")
+logging.basicConfig(level=logging.INFO)
+
+LUA_SCRIPT = """
+local key = KEYS[1]
+local burst = tonumber(ARGV[1])
+local rate = tonumber(ARGV[2])
+local now = tonumber(ARGV[3])
+local requested = tonumber(ARGV[4])
+local fill = math.min(burst, tonumber(redis.call('hget', key, 'tokens') or burst) + (now - tonumber(redis.call('hget', key, 'last') or now)) * rate)
+if fill < requested then
+  redis.call('hset', key, 'tokens', fill)
+  redis.call('hset', key, 'last', now)
+  return {0, fill}
+else
+  fill = fill - requested
+  redis.call('hset', key, 'tokens', fill)
+  redis.call('hset', key, 'last', now)
+  return {1, fill}
+end
+"""
+
+class RedisRateLimiter:
+    def __init__(self, redis_url=None, burst=5, rate=0.2):
+        self.redis_url = redis_url or os.environ.get("REDIS_URL", "redis://redis.data.svc.cluster.local:6379/0")
+        self.r = redis.from_url(self.redis_url)
+        self.burst = int(os.environ.get("RATE_BURST", burst))
+        self.rate = float(os.environ.get("RATE_PER_SEC", rate))
+        self.lua = self.r.register_script(LUA_SCRIPT)
+
+    def allow(self, tenant, requested=1):
+        key = f"rate:{tenant}"
+        now = int(time.time())
+        ok, tokens = self.lua(keys=[key], args=[self.burst, self.rate, now, requested])
+        return bool(ok), float(tokens)
+
+if __name__ == "__main__":
+    rl = RedisRateLimiter()
+    for i in range(10):
+        ok, rem = rl.allow("tenant1")
+        print(i, ok, rem)
+        time.sleep(0.5)
+
