+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Extended Keycloak hardening - apply recommended realm and client settings (PoC)
+KEYCLOAK_URL=${KEYCLOAK_URL:-http://keycloak.monitoring.svc:8080}
+REALM=${REALM:-aegis}
+ADMIN_USER=${ADMIN_USER:-admin}
+ADMIN_PASS=${ADMIN_PASS:-changeme}
+
+echo "Obtaining admin token"
+TOKEN=$(curl -sS -X POST "$KEYCLOAK_URL/realms/master/protocol/openid-connect/token" -d "grant_type=password&client_id=admin-cli&username=$ADMIN_USER&password=$ADMIN_PASS" | jq -r .access_token)
+
+echo "Updating realm config for security best practices (PoC)"
+curl -sS -X GET -H "Authorization: Bearer $TOKEN" "$KEYCLOAK_URL/admin/realms/$REALM" -o /tmp/realm.json
+jq '. + {
+  "accessTokenLifespan": 300,
+  "clientSessionIdleTimeout": 300,
+  "ssoSessionIdleTimeout": 1800,
+  "ssoSessionMaxLifespan": 3600,
+  "bruteForceProtected": true,
+  "registrationAllowed": false,
+  "eventsEnabled": true,
+  "eventsExpiration": 3600
+}' /tmp/realm.json > /tmp/realm2.json
+curl -sS -X PUT -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" --data @/tmp/realm2.json "$KEYCLOAK_URL/admin/realms/$REALM"
+
+echo "Lock down clients: remove direct access grants, reduce token lifespans per client (review manually in admin console)."
