+#!/usr/bin/env python3
+"""
+Placement optimizer prototype (PoC)
+ - Simple cost-latency scoring to pick a region/instance type given job metadata
+ - Exposes a REST endpoint to request placement suggestion
+ - Can be extended to RL; currently uses heuristic scoring: score = cost * alpha + latency * beta
+"""
+from flask import Flask, request, jsonify
+import os, math
+
+app = Flask(__name__)
+
+# sample catalog (cost_per_hour, baseline_latency_ms)
+CANDIDATES = {
+    "region-a/c5.4xlarge": {"cost": 1.0, "latency": 50},
+    "region-b/c5.2xlarge": {"cost": 0.6, "latency": 100},
+    "region-c/g4dn.xlarge": {"cost": 1.4, "latency": 30}
+}
+
+ALPHA = float(os.environ.get("PLACEMENT_ALPHA", "0.7"))
+BETA = float(os.environ.get("PLACEMENT_BETA", "0.3"))
+
+@app.route("/suggest", methods=["POST"])
+def suggest():
+    payload = request.json or {}
+    urgency = float(payload.get("urgency", 1.0))
+    pref = payload.get("preference", "cost")  # or "latency"
+    best = None
+    best_score = float("inf")
+    for k,v in CANDIDATES.items():
+        cost = v["cost"]
+        lat = v["latency"] / 1000.0
+        score = ALPHA * cost + BETA * lat / urgency
+        if pref == "latency":
+            score = ALPHA * lat + BETA * cost / urgency
+        if score < best_score:
+            best_score = score
+            best = k
+    return jsonify({"choice": best, "score": best_score})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8082")))
+
