+#!/usr/bin/env python3
+"""
+Record HPO submissions and estimated cost; provide reconcile hook.
+ - PoC sqlite persistence + `/submit` endpoint that other components call
+"""
+from fastapi import FastAPI, Request
+import sqlite3, os, json, logging, time
+
+app = FastAPI()
+DB = os.environ.get("HPO_CHARGE_DB", "/tmp/hpo_charge.db")
+logging.basicConfig(level=logging.INFO)
+
+def init():
+    conn = sqlite3.connect(DB)
+    conn.execute("CREATE TABLE IF NOT EXISTS submissions(id INTEGER PRIMARY KEY, team TEXT, run_id TEXT, est REAL, created_at INTEGER)")
+    conn.commit(); conn.close()
+
+@app.post("/submit")
+async def submit(req: Request):
+    body = await req.json()
+    team = body.get("team","unknown")
+    run_id = body.get("run_id","")
+    est = float(body.get("estimated_usd",0.0))
+    conn = sqlite3.connect(DB)
+    conn.execute("INSERT INTO submissions(team, run_id, est, created_at) VALUES (?,?,?,?)",(team, run_id, est,int(time.time())))
+    conn.commit(); conn.close()
+    return {"ok": True}
+
+@app.post("/reconcile")
+async def reconcile(req: Request):
+    body = await req.json()
+    run_id = body.get("run_id")
+    actual = float(body.get("actual_usd",0.0))
+    conn = sqlite3.connect(DB)
+    conn.execute("UPDATE submissions SET est = ? WHERE run_id = ?", (actual, run_id))
+    conn.commit(); conn.close()
+    return {"ok": True}
+
+if __name__ == "__main__":
+    init()
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=8080)
+
