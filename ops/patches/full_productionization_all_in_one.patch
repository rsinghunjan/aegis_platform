+CHARGEBACK_API = os.environ.get("CHARGEBACK_API", "http://chargeback.monitoring.svc:8080")
+
+def check_and_submit(team, config):
+    r = requests.post(f"{QUOTA_API}/reserve/{team}", timeout=5)
+    if r.status_code != 200:
+        raise RuntimeError("Quota reserve failed")
+    # estimate spot preference
+    ss = requests.get(SPOT_SIGNAL_API, timeout=5).json()
+    spot_ok = ss.get("spot_ok", True)
+    submission = {"team": team, "config": config, "spot": spot_ok}
+    # notify chargeback recorder with estimate (PoC)
+    try:
+        requests.post(CHARGEBACK_API + "/submit", json={"team":team,"estimated_usd":config.get("est_usd",0.0)}, timeout=5)
+    except Exception:
+        logger.exception("chargeback submit failed")
