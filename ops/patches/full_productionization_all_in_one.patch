+    return HTMLResponse(html)
+
+@app.get("/search", response_class=HTMLResponse)
+def search(tenant: str, model: str):
+    try:
+        r = requests.get(f"{INDEXER}/index/{tenant}/{model}", timeout=5)
+        items = r.json().get("items",[])
+    except Exception:
+        items = []
+    html = "<h2>Results</h2><ul>"
+    for it in items:
+        html += f"<li>{it['key']} - <a href='/view?key={it['key']}'>View</a></li>"
+    html += "</ul>"
+    return HTMLResponse(html)
+
+@app.get("/view", response_class=HTMLResponse)
+def view(key: str):
+    # presigned URL or proxied fetch could be used - PoC shows link
+    html = f"<h3>Explain: {key}</h3><p>Download from S3 or use secure API.</p><form method='post' action='/signoff'><input type='hidden' name='key' value='{key}'><input name='note' placeholder='signed note'><button>Signoff</button></form>"
+    return HTMLResponse(html)
+
+@app.post("/signoff")
+def signoff(key: str = Form(...), note: str = Form(...)):
+    # call signoff collector
+    try:
+        requests.post(SIGNOFF_URL, json={"run_id": key.split("/")[2], "note": note}, timeout=5)
+    except Exception:
+        pass
+    return RedirectResponse("/", status_code=303)
