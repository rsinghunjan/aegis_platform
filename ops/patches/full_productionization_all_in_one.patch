+#!/usr/bin/env python3
+"""
+Generate a RayClusterJob manifest that:
+ - Runs Ray Tune distributed HPO
+ - Mounts S3 checkpointing config (via environment)
+ - Emits a callback HTTP POST to chargeback recorder on start
+"""
+import json
+def generate_ray_job_manifest(samples, team, checkpoint_s3="s3://aegis-checkpoints"):
+    job = {
+        "apiVersion": "ray.io/v1",
+        "kind": "RayJob",
+        "metadata": {"generateName": "aegis-hpo-"},
+        "spec": {
+            "entrypoint": "python /app/run_ray_tune_prod_checkpoint.py --num-samples %d" % samples,
+            "rayVersion": "2.0.0",
+            "template": {
+                "spec": {
+                    "containers": [
+                        {
+                            "name": "hpo",
+                            "image": "us.gcr.io/aegis/ray-hpo:latest",
+                            "env": [
+                                {"name":"CHECKPOINT_S3","value": checkpoint_s3},
+                                {"name":"HPO_TEAM","value": team},
+                                {"name":"CHARGEBACK_API","value":"http://chargeback.monitoring.svc:8080/submit"}
+                            ],
+                            "resources": {"limits": {"cpu": "2000m", "memory": "8Gi"}}
+                        }
+                    ]
+                }
+            }
+        }
+    }
+    return json.dumps(job, indent=2)
