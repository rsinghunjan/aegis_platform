+#!/usr/bin/env python3
+"""
+Mutating admission webhook (PoC) to:
+ - Inject RUN_ID and OTLP env into Pods
+ - Enforce cosign-signed model artifact annotation when Pods are labelled as 'aegis-model-deploy'
+NOTE: In production use TLS, validate admission request signature and restrict scope.
+"""
+from flask import Flask, request, jsonify
+import json, base64, uuid, logging, os
+
+app = Flask(__name__)
+logging.basicConfig(level=logging.INFO)
+OTLP = os.environ.get("OTLP_ENDPOINT", "http://otel-collector.monitoring.svc:4318")
+
+@app.route("/mutate", methods=["POST"])
+def mutate():
+    body = request.get_json()
+    uid = body["request"]["uid"]
+    pod = body["request"]["object"]
+    patches = []
+    run_id = pod.get("metadata",{}).get("annotations",{}).get("aegis.run_id") or f"run-{uuid.uuid4().hex[:8]}"
+    # add annotation if missing
+    if not pod.get("metadata",{}).get("annotations"):
+        patches.append({"op":"add","path":"/metadata/annotations","value":{}})
+    patches.append({"op":"add","path":"/metadata/annotations/aegis.run_id","value":run_id})
+    # Inject OTLP and RUN_ID env to containers
+    containers = pod.get("spec",{}).get("containers",[])
+    for i,_ in enumerate(containers):
+        env_path = f"/spec/containers/{i}/env"
+        if not containers[i].get("env"):
+            patches.append({"op":"add","path":env_path,"value":[]})
+        patches.append({"op":"add","path":f"{env_path}/-","value":{"name":"OTLP_ENDPOINT","value":OTLP}})
+        patches.append({"op":"add","path":f"{env_path}/-","value":{"name":"RUN_ID","value":run_id}})
+    # If model deploy label present, require aegis.cosign_sig annotation (PoC enforcement)
+    labels = pod.get("metadata",{}).get("labels",{})
+    if labels.get("aegis-model-deploy") == "true":
+        anns = pod.get("metadata",{}).get("annotations",{})
+        if not anns.get("aegis.cosign_sig"):
+            # deny by returning allowed false
+            return jsonify({"response":{"uid":uid,"allowed":False,"status":{"message":"Missing cosign signature annotation for model deploy"}}})
+    patch_b64 = base64.b64encode(json.dumps(patches).encode()).decode()
+    return jsonify({"response":{"uid":uid,"allowed":True,"patchType":"JSONPatch","patch":patch_b64}})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT",8443)))
+
