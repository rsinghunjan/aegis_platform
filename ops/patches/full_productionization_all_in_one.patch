+#!/usr/bin/env python3
+"""
+Spot eviction handler:
+ - On cloud provider eviction notice, signal local trials to checkpoint and call resubmit logic
+ - AWS: check metadata URL for termination-time; GCP/Azure similar hooks can be added
+"""
+import os, time, logging, subprocess
+
+logger = logging.getLogger("spot-eviction")
+logging.basicConfig(level=logging.INFO)
+
+AWS_TERMINATION_URL = "http://169.254.169.254/latest/meta-data/spot/termination-time"
+
+def check_aws_eviction():
+    try:
+        resp = subprocess.check_output(["curl","-s","--max-time","2", AWS_TERMINATION_URL])
+        if resp:
+            return True
+    except Exception:
+        return False
+    return False
+
+def signal_checkpoint(trial_id):
+    open(f"/tmp/evict-checkpoint-{trial_id}","w").write("evict\n")
+    logger.info("Signaled checkpoint for %s", trial_id)
+
+def find_active_trials():
+    return [f for f in os.listdir("/tmp") if f.startswith("trial-")]
+
+if __name__ == "__main__":
+    while True:
+        if check_aws_eviction():
+            logger.warning("Eviction notice detected")
+            for t in find_active_trials():
+                signal_checkpoint(t)
+        time.sleep(5)
+
