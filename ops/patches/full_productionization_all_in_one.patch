+#!/usr/bin/env python3
+"""
+Explainability indexer service:
+ - Builds and serves an index (manifest) of explainability objects stored in S3
+ - Supports secure listing by tenant and model, used by SME UI
+"""
+from fastapi import FastAPI, HTTPException, Header
+import boto3, os, json, logging
+
+app = FastAPI()
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("explain-indexer")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+TENANT_MAP = json.loads(os.environ.get("TENANT_MAP_JSON","{}"))
+KEYCLOAK_USERINFO = os.environ.get("KEYCLOAK_USERINFO","http://keycloak.monitoring.svc:8080/realms/aegis/protocol/openid-connect/userinfo")
+
+s3 = boto3.client("s3") if EVIDENCE_BUCKET else None
+
+def introspect(token):
+    try:
+        import requests
+        r = requests.get(KEYCLOAK_USERINFO, headers={"Authorization": token}, timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        return {}
+
+@app.get("/index/{tenant}/{model}")
+def list_explanations(tenant: str, model: str, authorization: str = Header(None)):
+    if not authorization:
+        raise HTTPException(status_code=401)
+    user = introspect(authorization)
+    username = user.get("preferred_username")
+    # basic ACL check
+    if TENANT_MAP and username and TENANT_MAP.get(username) != tenant:
+        raise HTTPException(status_code=403)
+    prefix = f"explainability/{tenant}/{model}/"
+    try:
+        objs = s3.list_objects_v2(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Prefix=prefix).get("Contents", [])
+        keys = [{"key": o["Key"], "last_modified": o["LastModified"].isoformat()} for o in objs]
+        return {"items": keys}
+    except Exception:
+        raise HTTPException(status_code=500)
+
