+#!/usr/bin/env python3
+"""
+Toy placement optimizer trainer (PoC): trains a small model to predict cost/latency tradeoffs.
+ - Works offline on historic placement telemetry stored in S3/DB
+ - Outputs a simple model that the placement service can use
+"""
+import os, json, joblib
+import numpy as np
+from sklearn.ensemble import RandomForestRegressor
+
+def load_telemetry(path="/data/placement_telemetry.json"):
+    if path.startswith("s3://"):
+        import boto3, tempfile
+        s3 = boto3.client("s3")
+        bucket, key = path.replace("s3://","").split("/",1)
+        tmp = tempfile.NamedTemporaryFile(delete=False).name
+        s3.download_file(bucket, key, tmp)
+        path = tmp
+    with open(path) as f:
+        arr = [json.loads(l) for l in f]
+    return arr
+
+def featurize(records):
+    X=[]; y=[]
+    for r in records:
+        X.append([r.get("region_score",0.5), r.get("instance_perf",1.0), r.get("spot_avail",1.0)])
+        y.append(r.get("cost",1.0))
+    return np.array(X), np.array(y)
+
+def main():
+    path = os.environ.get("PLACEMENT_TELEMETRY", "/data/placement_telemetry.json")
+    out_model = os.environ.get("PLACEMENT_MODEL_OUT", "/workspace/artifacts/placement_model.joblib")
+    recs = load_telemetry(path)
+    X,y = featurize(recs)
+    clf = RandomForestRegressor(n_estimators=50)
+    clf.fit(X,y)
+    joblib.dump(clf, out_model)
+    print("Trained placement model saved to", out_model)
+
+if __name__ == "__main__":
+    main()
+
