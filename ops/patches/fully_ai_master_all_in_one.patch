+#!/usr/bin/env python3
+"""
+Tekton run wrapper for OTEL instrumentation and run_id correlation.
+
+Usage:
+ - This script is intended to be used as the entrypoint for Tekton Tasks (or invoked at the start of Task steps)
+ - It initializes OpenTelemetry, creates a run_id, exports the run_id as an environment variable and a small
+   evidence file to be consumed by downstream steps.
+ - It requires OTLP_ENDPOINT env var to send traces to a collector; otherwise console exporter is used.
+"""
+import os
+import sys
+import json
+import uuid
+import time
+from datetime import datetime
+from opentelemetry import trace
+from opentelemetry.sdk.resources import Resource
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import BatchSpanProcessor, ConsoleSpanExporter
+from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
+
+def init_tracer(service_name="tekton-task"):
+    otlp = os.environ.get("OTLP_ENDPOINT")
+    resource = Resource.create({"service.name": service_name})
+    tp = TracerProvider(resource=resource)
+    if otlp:
+        exporter = OTLPSpanExporter(endpoint=otlp, insecure=True)
+        tp.add_span_processor(BatchSpanProcessor(exporter))
+    else:
+        tp.add_span_processor(BatchSpanProcessor(ConsoleSpanExporter()))
+    trace.set_tracer_provider(tp)
+    return trace.get_tracer(service_name)
+
+def main():
+    # generate run id
+    run_id = os.environ.get("RUN_ID") or f"run-{uuid.uuid4().hex[:8]}"
+    os.environ["RUN_ID"] = run_id
+    service = os.environ.get("TASK_SERVICE_NAME", "tekton-task")
+    tracer = init_tracer(service_name=service)
+    # write run_id evidence for this task to /tekton/results (Tekton supports results)
+    results_dir = os.environ.get("TEKTON_RESULTS_DIR", "/tekton/results")
+    try:
+        os.makedirs(results_dir, exist_ok=True)
+        out = {"run_id": run_id, "ts": datetime.utcnow().isoformat()}
+        with open(os.path.join(results_dir, "run_id.json"), "w") as f:
+            json.dump(out, f)
+    except Exception:
+        pass
+    # print to stdout for visibility
+    print(f"[tekton-run-wrapper] run_id={run_id}")
+    # Optionally start a parent span for the entire task
+    with tracer.start_as_current_span("tekton.task") as span:
+        span.set_attribute("run_id", run_id)
+        # Execute the wrapped command if provided
+        if len(sys.argv) > 1:
+            cmd = sys.argv[1:]
+            print(f"[tekton-run-wrapper] executing wrapped command: {' '.join(cmd)}")
+            rc = os.system(" ".join(cmd))
+            if rc != 0:
+                print(f"[tekton-run-wrapper] wrapped command failed rc={rc}")
+                sys.exit(rc)
+    # flush and exit
+    time.sleep(0.5)
+    return 0
+
+if __name__ == "__main__":
+    sys.exit(main())
+
