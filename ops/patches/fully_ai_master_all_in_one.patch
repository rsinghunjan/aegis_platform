+#!/usr/bin/env python3
+"""
+Example Ray Tune HPO script (PoC).
+This should be packaged into the ray-hpo image at /app/run_ray_tune.py
+"""
+import os
+import argparse
+import time
+import json
+import ray
+from ray import tune
+from sklearn.datasets import make_classification
+from sklearn.ensemble import RandomForestClassifier
+from sklearn.model_selection import cross_val_score
+import joblib
+
+def train_eval(config):
+    # simple synthetic training for PoC
+    X, y = make_classification(n_samples=2000, n_features=20, n_informative=10)
+    clf = RandomForestClassifier(n_estimators=int(config["n_estimators"]), max_depth=int(config["max_depth"]))
+    scores = cross_val_score(clf, X, y, cv=3)
+    tune.report(mean_accuracy=float(scores.mean()))
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--evidence-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    args = parser.parse_args()
+    ray.init(address=os.environ.get("RAY_ADDRESS", "auto"))
+    analysis = tune.run(
+        train_eval,
+        config={"n_estimators": tune.randint(16,256), "max_depth": tune.randint(3,30)},
+        num_samples=8,
+        resources_per_trial={"cpu": 1}
+    )
+    best = analysis.get_best_config(metric="mean_accuracy", mode="max")
+    print("Best config:", best)
+    # In PoC, save best config to evidence S3 if available
+    if args.evidence_bucket:
+        import boto3
+        s3 = boto3.client("s3")
+        key = f"hpo/results/best-{int(time.time())}.json"
+        s3.put_object(Bucket=args.evidence_bucket, Key=key, Body=json.dumps(best).encode())
+        print("Uploaded best config to s3://%s/%s" % (args.evidence_bucket, key))
+
+if __name__ == "__main__":
+    main()
+
