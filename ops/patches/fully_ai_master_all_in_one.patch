+#!/usr/bin/env python3
+"""
+Middleware for the QPU submission endpoint that enforces per-tenant caps (consults BillingRecord),
+emits Prometheus metrics and rejects submissions when caps are exceeded.
+Integrate into API as dependency or middleware.
+"""
+import os, logging
+from prometheus_client import Counter, Gauge
+from services.quantum.db_models import SessionLocal, BillingRecord
+from datetime import datetime, timedelta
+
+logger = logging.getLogger("billing-enforcer")
+logging.basicConfig(level=logging.INFO)
+
+TENANT_MONTHLY_CAP = float(os.environ.get("TENANT_MONTHLY_CAP_USD", "1000"))
+CAP_VIOLATIONS = Counter("aegis_billing_cap_violations_total", "Tenant cap violations")
+TENANT_SPEND = Gauge("aegis_tenant_spend_usd", "Tenant spend", ["tenant"])
+
+def compute_spend(tenant):
+    db = SessionLocal()
+    month_ago = datetime.utcnow() - timedelta(days=30)
+    total = db.query(BillingRecord).filter(BillingRecord.owner==tenant, BillingRecord.created_at >= month_ago).with_entities(func.sum(BillingRecord.actual_cost)).scalar() or 0.0
+    TENANT_SPEND.labels(tenant=tenant).set(total)
+    return total
+
+def enforce_cap(tenant):
+    total = compute_spend(tenant)
+    if total >= TENANT_MONTHLY_CAP:
+        CAP_VIOLATIONS.inc()
+        logger.warning("Tenant %s exceeded cap: %s >= %s", tenant, total, TENANT_MONTHLY_CAP)
+        return False, total
+    return True, total
+
+def billing_enforcer_dependency(user):
+    tenant = user.get("preferred_username", "unknown")
+    ok, total = enforce_cap(tenant)
+    if not ok:
+        from fastapi import HTTPException
+        raise HTTPException(status_code=403, detail=f"tenant {tenant} monthly cap exceeded: {total}")
+    return True
+
