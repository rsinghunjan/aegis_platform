+"""
+Inference safety middleware for generative model serving.
+- Runs modular detectors (toxicity, PII, custom policies)
+- Logs blocked attempts to evidence DB (simple file or Postgres)
+"""
+import os, json, re, time
+
+TOXIC_PATTERNS = [r"\bkill\b", r"\battack\b"]
+PII_RE = re.compile(r"\b\d{3}-\d{2}-\d{4}\b")
+
+def check_toxicity(text):
+    for p in TOXIC_PATTERNS:
+        if re.search(p, text, flags=re.I):
+            return True, "toxicity"
+    return False, None
+
+def check_pii(text):
+    if PII_RE.search(text):
+        return True, "pii"
+    return False, None
+
+def filter_and_log(request_ctx, output_text, evidence_path="/tmp/generative_evidence.jsonl"):
+    # request_ctx: dict with model, user, prompt, request_id
+    t = output_text
+    toxic, reason = check_toxicity(t)
+    pii, reason2 = check_pii(t)
+    blocked=False
+    block_reason=None
+    if toxic:
+        blocked=True; block_reason=reason
+    elif pii:
+        blocked=True; block_reason=reason2
+    rec = {"ts": time.time(), "request": request_ctx, "output_snippet": t[:512], "blocked":blocked, "reason":block_reason}
+    open(evidence_path,"a").write(json.dumps(rec)+"\n")
+    return not blocked, block_reason
+
+if __name__=="__main__":
+    # demo
+    ok, reason = filter_and_log({"model":"gpt2","user":"demo","prompt":"test"},"I will kill you")
+    print("Allowed?", ok, "reason", reason)
+
