+"""
+Minimal Rater backend for collecting pairwise preference judgments.
+- POST /pairs   : accept JSON list of {"a": "...", "b": "...", "meta": {...}}
+- GET  /task    : pop a pair for human rater (for demo returns random pair)
+- POST /vote    : store a preference vote
+
+Operator: adapt to real auth, rate limiting, and UI integration.
+"""
+import os, json, uuid
+from flask import Flask, request, jsonify
+from datetime import datetime
+import sqlite3
+
+DB = os.environ.get("RATER_DB", "/tmp/rater.db")
+
+def init_db():
+    conn = sqlite3.connect(DB)
+    cur = conn.cursor()
+    cur.execute("CREATE TABLE IF NOT EXISTS pairs(id TEXT PRIMARY KEY, a TEXT, b TEXT, meta TEXT, created_at TEXT)")
+    cur.execute("CREATE TABLE IF NOT EXISTS votes(id TEXT PRIMARY KEY, pair_id TEXT, choice INTEGER, rater TEXT, ts TEXT)")
+    conn.commit()
+    conn.close()
+
+app = Flask(__name__)
+init_db()
+
+@app.route("/pairs", methods=["POST"])
+def add_pairs():
+    pairs = request.json
+    conn = sqlite3.connect(DB)
+    cur = conn.cursor()
+    for p in pairs:
+        pid = str(uuid.uuid4())
+        cur.execute("INSERT INTO pairs(id,a,b,meta,created_at) VALUES (?,?,?,?,?)", (pid, p["a"], p["b"], json.dumps(p.get("meta",{})), datetime.utcnow().isoformat()))
+    conn.commit()
+    conn.close()
+    return jsonify({"status":"ok","inserted":len(pairs)})
+
+@app.route("/task", methods=["GET"])
+def get_task():
+    conn = sqlite3.connect(DB)
+    cur = conn.cursor()
+    cur.execute("SELECT id,a,b,meta FROM pairs ORDER BY RANDOM() LIMIT 1")
+    r = cur.fetchone()
+    conn.close()
+    if not r:
+        return jsonify({"status":"empty"}), 204
+    pid, a, b, meta = r
+    return jsonify({"id": pid, "a": a, "b": b, "meta": json.loads(meta)})
+
+@app.route("/vote", methods=["POST"])
+def vote():
+    body = request.json
+    vid = str(uuid.uuid4())
+    conn = sqlite3.connect(DB)
+    cur = conn.cursor()
+    cur.execute("INSERT INTO votes(id,pair_id,choice,rater,ts) VALUES (?,?,?,?,?)", (vid, body["pair_id"], int(body["choice"]), body.get("rater","unknown"), datetime.utcnow().isoformat()))
+    conn.commit()
+    conn.close()
+    return jsonify({"status":"ok","vote_id":vid})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT",8082)))
+
