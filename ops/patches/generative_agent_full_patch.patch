+"""
+Reward model training script (more complete toy).
+- Reads prefs JSONL produced by rater backend or collector
+- Trains a simple reward model and persists artifact + provenance
+"""
+import argparse, json
+from sklearn.linear_model import LogisticRegression
+from sklearn.feature_extraction.text import TfidfVectorizer
+import joblib, os
+
+def load_prefs(path):
+    X=[]; y=[]
+    for line in open(path):
+        r=json.loads(line)
+        X.append(r["a"] + " [SEP] " + r["b"])
+        y.append(r["choice"])
+    return X, y
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--prefs", required=True)
+    p.add_argument("--out", default="./out")
+    args=p.parse_args()
+    X,y = load_prefs(args.prefs)
+    vec = TfidfVectorizer(max_features=20000)
+    Xv = vec.fit_transform(X)
+    clf = LogisticRegression(max_iter=1000)
+    clf.fit(Xv, y)
+    os.makedirs(args.out, exist_ok=True)
+    joblib.dump({"vec":vec, "clf":clf}, os.path.join(args.out,"reward_model.joblib"))
+    open(os.path.join(args.out,"reward_model.prov.json"),"w").write(json.dumps({"type":"toy_reward_model"}))
+    print("Saved reward model to", args.out)
+
+if __name__=="__main__":
+    main()
+
