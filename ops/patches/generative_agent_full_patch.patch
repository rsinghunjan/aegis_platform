+"""
+Plan signer / verifier utilities
+- sign_plan(plan_json) -> signature (operator implement using KMS)
+- verify_plan(plan_json, signature) -> bool
+For PoC these are stubs that should be wired to KMS and cosign / notation for production.
+"""
+import json, hashlib, base64
+
+def sign_plan(plan):
+    # naive "signature" = base64(sha256(plan))
+    b = json.dumps(plan, sort_keys=True).encode()
+    h = hashlib.sha256(b).digest()
+    return base64.b64encode(h).decode()
+
+def verify_plan(plan, sig):
+    s = sign_plan(plan)
+    return s == sig
+
