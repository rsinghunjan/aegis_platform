+"""
+Simple FAISS vector adapter stub for memory storage and retrieval.
+Production: replace with Milvus / Pinecone connector with auth, namespaces and secure storage.
+"""
+import numpy as np
+try:
+    import faiss
+except Exception:
+    faiss = None
+
+class VectorMemory:
+    def __init__(self, dim=128):
+        self.dim = dim
+        self.index = None
+        self.items = []
+        if faiss:
+            self.index = faiss.IndexFlatL2(dim)
+
+    def add(self, vec, meta):
+        v = np.array(vec).astype('float32').reshape(1,-1)
+        if self.index:
+            self.index.add(v)
+        self.items.append((v, meta))
+
+    def search(self, vec, k=5):
+        q = np.array(vec).astype('float32').reshape(1,-1)
+        if self.index:
+            D, I = self.index.search(q, k)
+            res=[]
+            for idx in I[0]:
+                if idx < len(self.items):
+                    res.append(self.items[idx][1])
+            return res
+        # fallback: brute force
+        return [m for _,m in self.items[:k]]
+
