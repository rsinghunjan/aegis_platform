+#!/usr/bin/env python3
+"""
+Provenance middleware for generation endpoints.
+ - Adds provenance fields to generation responses: model_id, model_version, artifact_sig, request_id, timestamp, verifier_score
+ - Enforces basic policy via policy-check endpoint before returning user-visible result; if policy violation, returns fallback text and logs event.
+
+Usage:
+ - Import and call wrap_response(response_dict, ctx)
+"""
+import os, time, requests
+from services.agent.audit_logger import audit_log_action
+
+POLICY_URL = os.environ.get("GEN_POLICY_URL", "http://policy.svc:8080/check")
+VERIFIER_URL = os.environ.get("VERIFIER_CHECK_URL", "http://verifier.safety.svc:8080/score")
+FALLBACK_TEXT = os.environ.get("GEN_FALLBACK_TEXT", "[response suppressed due to policy]")
+
+def enrich_provenance(resp: dict, ctx: dict):
+    """
+    ctx should include: model_id, model_version, artifact_sig, request_id, user_id
+    """
+    now = int(time.time())
+    resp.setdefault("provenance", {})
+    resp["provenance"].update({
+        "model_id": ctx.get("model_id"),
+        "model_version": ctx.get("model_version"),
+        "artifact_sig": ctx.get("artifact_sig"),
+        "request_id": ctx.get("request_id"),
+        "user_id": ctx.get("user_id"),
+        "timestamp": now
+    })
+    return resp
+
+def policy_enforce_and_fallback(resp: dict, ctx: dict):
+    # call policy endpoint with candidate text and metadata
+    text = resp.get("text") or resp.get("generated_text", "")
+    try:
+        r = requests.post(POLICY_URL, json={"text": text, "ctx": ctx}, timeout=3)
+        r.raise_for_status()
+        pj = r.json()
+        if not pj.get("allow", True):
+            # log and replace text with fallback
+            audit_log_action("policy_block", ctx.get("user_id", "unknown"), {"text": text}, {"reason": pj.get("reason")})
+            resp["suppressed"] = True
+            resp["supplanted_by_fallback"] = True
+            resp["original_text_hash"] = hash(text)
+            resp["text"] = FALLBACK_TEXT
+            return resp
+    except Exception as e:
+        # on policy check failure, be conservative: fallback
+        resp["suppressed_on_policy_check_error"] = True
+        resp["text"] = FALLBACK_TEXT
+        audit_log_action("policy_error", ctx.get("user_id","unknown"), {"error": str(e)}, {"note":"policy service unreachable, fallback applied"})
+        return resp
+    # if allowed, optionally score with verifier and attach
+    try:
+        vr = requests.post(VERIFIER_URL, json={"text": text, "ctx": ctx}, timeout=3)
+        vr.raise_for_status()
+        resp["provenance"]["verifier_score"] = vr.json()
+    except Exception:
+        resp["provenance"]["verifier_score"] = {"error": "verifier_unavailable"}
+    return resp
+
+def wrap_response(resp: dict, ctx: dict):
+    resp = enrich_provenance(resp, ctx)
+    resp = policy_enforce_and_fallback(resp, ctx)
+    return resp
+
