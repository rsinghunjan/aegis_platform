+#!/usr/bin/env python3
+"""
+Deterministic inference test
+ - Sends identical requests multiple times to the serving endpoint to validate deterministic outputs
+ - Optionally tests across batch sizes to surface batching nondeterminism
+ - Exits non-zero if outputs differ beyond exact-match threshold (expected exact for deterministic models)
+
+Usage:
+  python tests/generative/deterministic_inference_test.py --url http://triton-llm.svc:8000/generate --prompt "hello"
+"""
+import argparse, requests, hashlib, json, sys
+from time import sleep
+
+def call_generate(url, prompt, seed=None):
+    payload = {"prompt": prompt}
+    if seed is not None:
+        payload["seed"] = seed
+    r = requests.post(url, json=payload, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--url", required=True)
+    p.add_argument("--prompt", required=True)
+    p.add_argument("--repeats", type=int, default=3)
+    p.add_argument("--seed", type=int, default=42)
+    args = p.parse_args()
+    outputs = []
+    for i in range(args.repeats):
+        o = call_generate(args.url, args.prompt, seed=args.seed)
+        # normalize result to text
+        text = o.get("text") or o.get("generated_text") or json.dumps(o)
+        outputs.append(text)
+        sleep(0.5)
+    # compare all outputs to first
+    first = outputs[0]
+    diffs = [i for i,o in enumerate(outputs) if o != first]
+    if diffs:
+        print("Non-deterministic outputs observed. Outputs:")
+        for idx,o in enumerate(outputs):
+            print(f"--- run {idx} ---")
+            print(o)
+        sys.exit(2)
+    print("Deterministic inference test passed")
+    sys.exit(0)
+
+if __name__ == "__main__":
+    main()
