+#!/usr/bin/env python3
+"""
+Generation Shadow Runner
+ - Captures a sample of production generation requests and forwards copies to candidate endpoints
+ - Stores paired (prod, candidate) results with provenance and verifier scores to evidence store
+ - Emits Prometheus metrics for divergence and volume
+
+Environment:
+ - PROD_URL: production generation endpoint
+ - CANDIDATE_URL: candidate generation endpoint (for canary)
+ - EVIDENCE_BUCKET: S3/gs bucket (via upload helper) or local store
+ - SAMPLE_RATE: probability to shadow a given request (0-1)
+ - SHADOW_OUT: local file output if no remote store
+"""
+import os, time, json, random, requests
+from prometheus_client import start_http_server, Counter, Gauge
+from services.agent.audit_logger import s3_put
+
+PROD_URL = os.environ.get("PROD_URL", "http://prod-llm.svc:8000/generate")
+CANDIDATE_URL = os.environ.get("CANDIDATE_URL", "http://canary-llm.svc:8000/generate")
+SAMPLE_RATE = float(os.environ.get("SHADOW_SAMPLE_RATE", "0.01"))
+SHADOW_OUT = os.environ.get("SHADOW_OUT", "/data/shadow_generations.jsonl")
+PUSHGW = os.environ.get("PUSHGATEWAY", "")
+
+G_SAMP = Counter("aegis_gen_shadow_samples_total", "Total generation shadow samples")
+G_DIV = Gauge("aegis_gen_shadow_divergence", "Divergence between prod and candidate (binary 0/1)")
+
+def compute_divergence(prod_text, cand_text):
+    return 0.0 if (prod_text or "").strip() == (cand_text or "").strip() else 1.0
+
+def shadow_once(req_json):
+    try:
+        prod = requests.post(PROD_URL, json=req_json, timeout=15).json()
+    except Exception:
+        prod = {"error": "prod_failed"}
+    try:
+        cand = requests.post(CANDIDATE_URL, json=req_json, timeout=30).json()
+    except Exception:
+        cand = {"error": "cand_failed"}
+    prod_text = prod.get("text") or prod.get("generated_text", "")
+    cand_text = cand.get("text") or cand.get("generated_text", "")
+    div = compute_divergence(prod_text, cand_text)
+    rec = {
+        "ts": time.time(),
+        "request": req_json,
+        "prod": {"resp": prod, "model_info": prod.get("model_info")},
+        "candidate": {"resp": cand, "model_info": cand.get("model_info")},
+        "divergence": div
+    }
+    # write to local file
+    with open(SHADOW_OUT, "a") as f:
+        f.write(json.dumps(rec) + "\n")
+    # also try to write to evidence bucket via s3_put
+    try:
+        if os.environ.get("EVIDENCE_BUCKET"):
+            key = f"gen_shadow/{int(time.time())}.json"
+            s3_put(key, rec)
+    except Exception as e:
+        print("failed to archive to evidence:", e)
+    G_SAMP.inc(); G_DIV.set(div)
+
+def main_loop():
+    start_http_server(int(os.environ.get("SHADOW_MET_PORT", "9481")))
+    print("Generation shadow runner started")
+    # In production, this would subscribe to a message bus of requests; here we simulate sampling synthetic prompts
+    while True:
+        if random.random() < SAMPLE_RATE:
+            req = {"prompt": "Shadow sample: " + str(time.time()), "max_tokens": 64}
+            shadow_once(req)
+        time.sleep(float(os.environ.get("SHADOW_INTERVAL_S", "0.5")))
+
+if __name__ == "__main__":
+    main_loop()
+
