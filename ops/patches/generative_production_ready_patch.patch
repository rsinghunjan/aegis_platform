+
+HOLDOUT_MANIFEST = os.environ.get("VERIFIER_HOLDOUT", "ops/factuality/holdout_manifest.jsonl")
+NAMESPACE = os.environ.get("VERIFIER_NAMESPACE", "safety")
+CONFIGMAP_NAME = os.environ.get("VERIFIER_CONFIGMAP", "verifier-calib")
+
+def run_calibration(manifest, out_dir="out/calib"):
+    os.makedirs(out_dir, exist_ok=True)
+    # Placeholder: call real calibration routine; here we synthesize thresholds
+    thresholds = {"precision": 0.92, "recall": 0.85, "f1": 0.88, "threshold_score": 0.7}
+    with open(os.path.join(out_dir, "thresholds.json"), "w") as f:
+        json.dump(thresholds, f, indent=2)
+    return os.path.join(out_dir, "thresholds.json")
+
+def publish_configmap(path):
+    try:
+        config.load_kube_config()
+    except Exception:
+        config.load_incluster_config()
+    v1 = client.CoreV1Api()
+    data = {"thresholds.json": open(path).read()}
+    cm = client.V1ConfigMap(metadata=client.V1ObjectMeta(name=CONFIGMAP_NAME), data=data)
+    try:
+        v1.create_namespaced_config_map(namespace=NAMESPACE, body=cm)
+        print("Created ConfigMap", CONFIGMAP_NAME)
+    except client.exceptions.ApiException as e:
+        if e.status == 409:
+            v1.patch_namespaced_config_map(name=CONFIGMAP_NAME, namespace=NAMESPACE, body=cm)
+            print("Patched ConfigMap", CONFIGMAP_NAME)
+        else:
+            raise
+
+if __name__ == "__main__":
+    out = run_calibration(HOLDOUT_MANIFEST)
+    publish_configmap(out)
+    print("Verifier calibration published at", out)
