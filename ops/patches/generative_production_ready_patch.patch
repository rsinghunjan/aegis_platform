+#!/usr/bin/env python3
+"""
+Tokenization parity test
+ - Ensures tokenizer used by training/serving are equivalent for a sample prompt set.
+ - Compares token IDs and decoded text round-trip across two tokenizer backends.
+ - Exits non-zero on mismatch.
+
+Usage:
+  python tests/generative/tokenization_parity_test.py --prompts ops/generative/sample_prompts.txt
+"""
+import argparse
+import sys
+from transformers import AutoTokenizer
+
+def load_prompts(path):
+    with open(path) as f:
+        return [l.strip() for l in f if l.strip()]
+
+def compare_tokenizers(model_tokenizer_name, serving_tokenizer_path, prompts):
+    t1 = AutoTokenizer.from_pretrained(model_tokenizer_name, use_fast=True)
+    t2 = AutoTokenizer.from_pretrained(serving_tokenizer_path, use_fast=True)
+    mismatches = []
+    for p in prompts:
+        ids1 = t1.encode(p, add_special_tokens=False)
+        ids2 = t2.encode(p, add_special_tokens=False)
+        if ids1 != ids2:
+            mismatches.append({"prompt": p, "ids_model": ids1, "ids_serving": ids2})
+            continue
+        # roundtrip decode check
+        dec1 = t1.decode(ids1)
+        dec2 = t2.decode(ids2)
+        if dec1.strip() != dec2.strip():
+            mismatches.append({"prompt": p, "dec_model": dec1, "dec_serving": dec2})
+    return mismatches
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--model-tokenizer", default="facebook/opt-125m")
+    p.add_argument("--serving-tokenizer", default="./serving/tokenizer")
+    p.add_argument("--prompts", default="ops/generative/sample_prompts.txt")
+    args = p.parse_args()
+    prompts = load_prompts(args.prompts)
+    mismatches = compare_tokenizers(args.model_tokenizer, args.serving_tokenizer, prompts)
+    if mismatches:
+        print("Found tokenizer mismatches:")
+        for m in mismatches:
+            print(m)
+        sys.exit(2)
+    print("Tokenizer parity checks passed")
+    sys.exit(0)
+
