+#!/usr/bin/env python3
+"""
+Canary evaluation for generative models
+ - For each prompt, call prod and candidate endpoints, compute divergence rate and verifier pass rate
+ - Outputs JSON with summary: pass boolean, metrics and per-prompt data
+"""
+import argparse, requests, json, time
+
+def call(url, prompt):
+    r = requests.post(url, json={"prompt": prompt, "max_tokens": 64}, timeout=20)
+    r.raise_for_status()
+    return r.json()
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--prompts", required=True)
+    p.add_argument("--prod_url", required=True)
+    p.add_argument("--cand_url", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--max_divergence_rate", type=float, default=0.05)
+    args = p.parse_args()
+    prompts = [l.strip() for l in open(args.prompts) if l.strip()]
+    total = 0
+    divergences = 0
+    per = []
+    for prompt in prompts:
+        total += 1
+        prod = call(args.prod_url, prompt)
+        cand = call(args.cand_url, prompt)
+        pt = prod.get("text") or prod.get("generated_text","")
+        ct = cand.get("text") or cand.get("generated_text","")
+        div = 0 if pt.strip() == ct.strip() else 1
+        if div:
+            divergences += 1
+        per.append({"prompt": prompt, "prod": pt, "cand": ct, "div": div})
+    div_rate = divergences / total if total else 0.0
+    pass_flag = div_rate <= args.max_divergence_rate
+    out = {"total": total, "divergences": divergences, "divergence_rate": div_rate, "pass": pass_flag, "per_prompt": per}
+    with open(args.out, "w") as f:
+        json.dump(out, f, indent=2)
+    if not pass_flag:
+        raise SystemExit(2)
+    print("Canary evaluation passed")
+
+if __name__ == "__main__":
+    main()
+
