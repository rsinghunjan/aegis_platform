+#!/usr/bin/env python3
+"""
+CI helper: fail if required LPU nodes are not present in the cluster.
+Usage:
+  python ops/lpu/ci/lpu_presence_check.py --vendor generic
+"""
+import argparse
+import subprocess
+import sys
+
+def has_nodes(vendor_label):
+    try:
+        out = subprocess.check_output(["kubectl","get","nodes","-l",f"aegis/lpu={vendor_label}","-o","name"], text=True)
+        return bool([l for l in out.splitlines() if l.strip()])
+    except Exception:
+        return False
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--vendor", required=True)
+    args = p.parse_args()
+    ok = has_nodes(args.vendor)
+    if not ok:
+        print(f"No nodes labeled aegis/lpu={args.vendor} found; failing this CI step.")
+        sys.exit(2)
+    print(f"Found nodes for {args.vendor}")
+    sys.exit(0)
+
