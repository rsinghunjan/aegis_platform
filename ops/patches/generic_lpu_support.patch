+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Label Kubernetes nodes for generic LPU usage.
+# Usage:
+#   ./ops/lpu/label_lpu_nodes.sh <label-key> <label-value>
+# Examples:
+#   ./ops/lpu/label_lpu_nodes.sh aegis/lpu generic
+#   ./ops/lpu/label_lpu_nodes.sh aegis/lpu ethos-n78
+LABEL_KEY=${1:-aegis/lpu}
+LABEL_VALUE=${2:-generic}
+
+for n in $(kubectl get nodes -o jsonpath='{.items[*].metadata.name}'); do
+  echo "Labeling node $n -> $LABEL_KEY=$LABEL_VALUE"
+  kubectl label node "$n" "$LABEL_KEY"="$LABEL_VALUE" --overwrite || true
+done
+
+echo "Labeling complete."
+
