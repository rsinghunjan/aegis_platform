+#!/usr/bin/env python3
+"""
+Generic LPU compile wrapper.
+ - Reads environment variable LPU_COMPILE_CMD template, or uses a default no-op placeholder.
+ - Example LPU_COMPILE_CMD: "lpu-compiler --input {input} --output {out}"
+ - Produces a provenance JSON alongside the compiled artifact.
+"""
+import os
+import json
+import subprocess
+from datetime import datetime
+
+def compile_model(input_model, out_dir=None, compile_cmd=None):
+    out_dir = out_dir or os.path.dirname(input_model) or "."
+    os.makedirs(out_dir, exist_ok=True)
+    base = os.path.splitext(os.path.basename(input_model))[0]
+    compiled = os.path.join(out_dir, base + ".lpu.bin")
+    cmd_tpl = compile_cmd or os.environ.get("LPU_COMPILE_CMD", "")
+    if not cmd_tpl:
+        # No compiler configured: create a copy placeholder
+        with open(input_model, "rb") as rf, open(compiled, "wb") as wf:
+            wf.write(rf.read())
+        prov = {
+            "tool": "noop-copy",
+            "cmd": f"copy {input_model} -> {compiled}",
+            "ts": datetime.utcnow().isoformat()+"Z"
+        }
+        prov_path = compiled + ".prov.json"
+        json.dump(prov, open(prov_path, "w"), indent=2)
+        return compiled, prov_path
+    # substitute tokens
+    cmd = cmd_tpl.replace("{input}", input_model).replace("{out}", compiled)
+    subprocess.check_call(cmd.split())
+    prov = {"tool": "lpu-compiler", "cmd": cmd, "ts": datetime.utcnow().isoformat()+"Z"}
+    prov_path = compiled + ".prov.json"
+    json.dump(prov, open(prov_path, "w"), indent=2)
+    return compiled, prov_path
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--input", required=True)
+    p.add_argument("--outdir", default=None)
+    p.add_argument("--cmd", default=None)
+    args = p.parse_args()
+    compiled, prov = compile_model(args.input, args.outdir, args.cmd)
+    print("Compiled:", compiled)
+    print("Prov:", prov)
+
