+#!/usr/bin/env python3
+"""
+Generic LPU adapter scaffold for Aegis.
+ - Detects nodes labeled for generic LPU and deploys a serving pod with the compiled model.
+ - Submits a simple provenance-wrapped inference job and collects results (HTTP-based).
+ - This is a scaffold: adapt vendor-specific model paths, runtime flags and security contexts.
+"""
+import os
+import subprocess
+import json
+from datetime import datetime
+
+NODE_LABEL_KEY = os.environ.get("LPU_NODE_LABEL_KEY", "aegis/lpu")
+NODE_LABEL_VAL = os.environ.get("LPU_NODE_LABEL_VAL", "generic")
+
+def find_nodes():
+    try:
+        out = subprocess.check_output(["kubectl", "get", "nodes", "-l", f"{NODE_LABEL_KEY}={NODE_LABEL_VAL}", "-o", "name"], text=True)
+        return [l.strip().split("/",1)[-1] for l in out.splitlines() if l.strip()]
+    except subprocess.CalledProcessError:
+        return []
+
+def deploy_serving(image, model_host_path, name="lpu-serving"):
+    manifest = f"""
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: {name}
+  namespace: aegis-ml
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: {name}
+  template:
+    metadata:
+      labels:
+        app: {name}
+    spec:
+      nodeSelector:
+        {NODE_LABEL_KEY}: "{NODE_LABEL_VAL}"
+      containers:
+      - name: server
+        image: {image}
+        env:
+          - name: MODEL_PATH
+            value: "/models/{os.path.basename(model_host_path)}"
+        volumeMounts:
+          - name: model
+            mountPath: /models
+      volumes:
+        - name: model
+          hostPath:
+            path: {model_host_path}
+"""
+    p = "/tmp/lpu_serving.yaml"
+    open(p, "w").write(manifest)
+    subprocess.check_call(["kubectl", "apply", "-f", p])
+    return p
+
+def submit_inference(endpoint, payload):
+    import requests
+    r = requests.post(endpoint, json=payload, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def record_provenance(flow_id, model, compiled_artifact, extra=None):
+    rec = {
+        "flow_id": flow_id,
+        "model": model,
+        "compiled": compiled_artifact,
+        "ts": datetime.utcnow().isoformat()+"Z",
+    }
+    if extra:
+        rec.update(extra)
+    # For now, write to /tmp (operator can upload/sign)
+    path = f"/tmp/lpu_provenance_{flow_id}_{int(datetime.utcnow().timestamp())}.json"
+    open(path, "w").write(json.dumps(rec, indent=2))
+    return path
+
+if __name__ == "__main__":
+    print("LPU adapter: nodes", find_nodes())
+
