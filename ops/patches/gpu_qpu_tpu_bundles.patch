+#!/usr/bin/env python3
+"""
+CI helper to attempt an IonQ submission if credentials are present.
+ - Fails only if credentials present but submission fails.
+ - If no credentials, exits with code 0 to avoid blocking CI.
+"""
+import os
+import json
+from ops.qpu.adapters.ionq_adapter import IonQAdapter
+
+def main():
+    if not os.environ.get("IONQ_API_KEY"):
+        print("No IONQ_API_KEY configured; skipping IonQ smoke check.")
+        return 0
+    adapter = IonQAdapter()
+    job = json.load(open("ops/qpu/sample_jobs/bell_circuit.json"))
+    res = adapter.submit_circuit(job)
+    if res.get("error"):
+        print("IonQ submission failed:", res)
+        return 2
+    print("Submission ok:", res.get("job_id"))
+    return 0
+
+if __name__ == "__main__":
+    import sys
+    raise SystemExit(main())
+
