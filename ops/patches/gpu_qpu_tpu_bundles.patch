+import time
+import torch
+import torch.nn as nn
+import torch.optim as optim
+from torch.utils.data import DataLoader, TensorDataset
+
+def build_model():
+    return nn.Sequential(
+        nn.Linear(10, 64),
+        nn.ReLU(),
+        nn.Linear(64, 2)
+    )
+
+def train(epochs=3):
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    print("Using device:", device)
+    model = build_model().to(device)
+    x = torch.randn(1024,10)
+    y = torch.randint(0,2,(1024,))
+    ds = TensorDataset(x,y)
+    dl = DataLoader(ds, batch_size=32)
+    opt = optim.Adam(model.parameters(), lr=1e-3)
+    loss_fn = nn.CrossEntropyLoss()
+    for e in range(epochs):
+        total = 0.0
+        for xb,yb in dl:
+            xb,yb = xb.to(device), yb.to(device)
+            opt.zero_grad()
+            out = model(xb)
+            loss = loss_fn(out, yb)
+            loss.backward()
+            opt.step()
+            total += loss.item()
+        print(f"Epoch {e}: loss {total/len(dl):.4f}")
+    # produce a small evaluation summary
+    summary = {"model":"gpu-sample","device":str(device),"final_loss": total/len(dl)}
+    open("/tmp/eval_summary.json","w").write(str(summary))
+    print("Wrote /tmp/eval_summary.json")
+
+if __name__ == "__main__":
+    train()
+
