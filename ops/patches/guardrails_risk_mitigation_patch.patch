+"""
+Budget manager enforces per-tenant or per-model cost budgets.
+ - Uses Redis to track budget consumption and enforce throttles
+ - Exposes check_and_consume(user_or_tenant, estimated_cost) -> bool
+"""
+import os, time
+try:
+    import redis
+except Exception:
+    redis = None
+
+REDIS_URL = os.environ.get("BUDGET_REDIS_URL", "redis://localhost:6379/2")
+BUDGET_DEFAULT_USD = float(os.environ.get("BUDGET_DEFAULT_USD", "100.0"))  # per period
+BUDGET_WINDOW_SECS = int(os.environ.get("BUDGET_WINDOW_SECS", "86400"))  # daily
+
+if redis:
+    r = redis.from_url(REDIS_URL)
+else:
+    r = None
+
+def _key(tenant):
+    now = int(time.time())
+    window = now // BUDGET_WINDOW_SECS
+    return f"budget:{tenant}:{window}"
+
+def get_balance(tenant: str) -> float:
+    if not r:
+        return BUDGET_DEFAULT_USD
+    val = r.get(_key(tenant))
+    if not val:
+        return BUDGET_DEFAULT_USD
+    return float(val)
+
+def check_and_consume(tenant: str, amount_usd: float) -> bool:
+    """
+    Atomically check and consume budget; returns True if allowed, False if exceeds budget.
+    """
+    if not r:
+        # non-redis fallback: allow (operator must ensure budgets elsewhere)
+        return True
+    key = _key(tenant)
+    pipe = r.pipeline()
+    pipe.get(key)
+    res = pipe.execute()[0]
+    if res is None:
+        # initialize
+        r.set(key, BUDGET_DEFAULT_USD - amount_usd, ex=BUDGET_WINDOW_SECS)
+        return True
+    bal = float(res)
+    if amount_usd > bal:
+        return False
+    # decrement
+    r.decrbyfloat(key, amount_usd)
+    return True
+
