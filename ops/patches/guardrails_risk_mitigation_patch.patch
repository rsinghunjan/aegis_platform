+
+def append_record(rec):
+    os.makedirs(os.path.dirname(STORE), exist_ok=True)
+    with open(STORE, "a") as f:
+        f.write(json.dumps(rec) + "\n")
+
+def load_all():
+    out=[]
+    if not os.path.exists(STORE):
+        return out
+    for l in open(STORE):
+        out.append(json.loads(l))
+    return out
+
+@APP.post("/request")
+def create_request(request_id: str, user: str, reason: str):
+    rec = {"request_id": request_id, "user": user, "reason": reason, "status":"pending", "ts": time.time()}
+    append_record(rec)
+    return {"status":"created"}
+
+@APP.post("/approve")
+def approve(request_id: str, approver: str):
+    # naive: append an approval record; consumers must read approvals and act
+    rec = {"request_id": request_id, "approver": approver, "action":"approved", "ts": time.time()}
+    append_record(rec)
+    return {"status":"approved"}
+
+@APP.post("/reject")
+def reject(request_id: str, approver: str, reason: str = ""):
+    rec = {"request_id": request_id, "approver": approver, "action":"rejected", "reason": reason, "ts": time.time()}
+    append_record(rec)
+    return {"status":"rejected"}
+
+@APP.get("/list")
+def list_requests():
