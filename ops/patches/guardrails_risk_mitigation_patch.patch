+ALERT_THRESHOLD_FRAC = float(os.environ.get("BUDGET_ALERT_THRESHOLD_FRAC", "0.1"))
+
+if redis:
+    r = redis.from_url(REDIS_URL)
+else:
+    r = None
+
+def poll_budgets():
+    if not r:
+        return
+    for key in r.scan_iter(match="budget:*"):
+        try:
+            val = float(r.get(key) or 0)
+            # extract tenant from key
+            if val <= 0:
+                msg = {"tenant": str(key), "status":"exhausted", "balance": val}
+                if WEBHOOK:
+                    try:
+                        import requests
+                        requests.post(WEBHOOK, json=msg, timeout=5)
+                    except Exception:
+                        pass
+        except Exception:
+            continue
+
+if __name__=="__main__":
+    while True:
+        poll_budgets()
+        time.sleep(int(os.environ.get("BUDGET_POLL_SECS","60")))
