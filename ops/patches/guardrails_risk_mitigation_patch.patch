+"""
+Inference gateway (centralized enforcement point).
+ - Applies DLP/redaction, rate limits, budget checks, hard policy enforcement and audit logging
+ - If allowed, forwards request to chosen model endpoint (serving decision engine can be used)
+"""
+import os, requests, uuid, time
+from fastapi import FastAPI, Header, HTTPException, Request
+from services.excel.dlp_rules import contains_pii, redact
+from services.audit.audit_logger import log_event
+from services.cost.budget_manager import check_and_consume
+from services.policy.hard_policy_enforcer import enforce_hard_constraints
+from services.autonomy.serving_decision_engine import choose as choose_model
+
+SERVICE_API_KEY = os.environ.get("SERVICE_API_KEY", "")
+DEFAULT_MODEL_ENDPOINT = os.environ.get("DEFAULT_MODEL_ENDPOINT", "http://triton-proxy.inference:8080/infer")
+RATE_LIMIT_HEADER = "X-User-Rate-Remaining"
+
+app = FastAPI()
+
+def estimate_cost_for_request(req: dict) -> float:
+    # naive heuristic: cost per second * expected duration (this should be refined)
+    return float(os.environ.get("EST_COST_PER_REQUEST_USD", "0.001"))
+
+@app.post("/infer")
+async def infer(req: Request, authorization: str = Header(None)):
+    body = await req.json()
+    user = "anonymous"
+    if authorization and authorization.startswith("Bearer "):
+        # ideally validate token; for scaffold we extract subject-less
+        user = authorization.split(" ",1)[1][:20]
+
+    # DLP: block or redact heavy PII
+    if contains_pii(body.get("prompt","")):
+        raise HTTPException(status_code=400, detail="Prompt contains sensitive PII. Remove or request redaction.")
+    # Redact metadata
+    body["prompt_redacted"] = redact(body.get("prompt",""))
+
+    # Serving decision: choose model variant
+    chosen = choose_model()
+    model_name = chosen.get("chosen", {}).get("name", "teacher")
+    # budget check
+    estimated_cost = estimate_cost_for_request(body)
+    tenant = body.get("tenant", user)
+    ok_budget = check_and_consume(tenant, estimated_cost)
+    if not ok_budget:
+        log_event({"user": user, "request_id": None, "action":"throttled", "reason":"budget_exhausted", "model": model_name}, persist_to_s3=False)
+        raise HTTPException(status_code=429, detail="Tenant budget exceeded")
+
+    # run a conservative pre-check using hard policy enforcer (no preview available)
+    hp = enforce_hard_constraints({"prompt": body.get("prompt",""), "user_id": user, "requested_max_tokens": body.get("max_tokens", 256), "risk_level": body.get("risk_level","default")})
+    if hp.get("action") == "block":
+        log_event({"user": user, "request_id": None, "action":"blocked", "reason": hp.get("reason"), "model": model_name}, persist_to_s3=True)
+        raise HTTPException(status_code=403, detail=f"Blocked: {hp.get('reason')}")
+    if hp.get("action") == "require_manual_approval":
+        # create request and signal for manual approval; return pending response
+        req_id = str(uuid.uuid4())
+        log_event({"user": user, "request_id": req_id, "action":"require_manual_approval", "reason":hp.get("reason"), "model": model_name}, persist_to_s3=True)
+        return {"status":"pending_manual_approval", "request_id": req_id, "reason": hp.get("reason")}
+
+    # Forward to model endpoint
+    # choose endpoint by model_name (resolve name->url via simple mapping env or service discovery)
+    endpoint = os.environ.get(f"MODEL_ENDPOINT_{model_name.upper()}", DEFAULT_MODEL_ENDPOINT)
+    # attach provenance flags so model returns provenance if supported
+    payload = {"prompt": body.get("prompt"), "max_tokens": body.get("max_tokens",256), "requester": user, "return_provenance": True}
+    try:
+        resp = requests.post(endpoint, json=payload, headers={"Authorization": f"Bearer {SERVICE_API_KEY}"}, timeout=30)
+    except Exception as e:
+        raise HTTPException(status_code=502, detail="Upstream model error")
+    if resp.status_code != 200:
+        raise HTTPException(status_code=502, detail="Model endpoint returned error")
+    result = resp.json()
+    # post-hoc enforcement using preview
+    hp2 = enforce_hard_constraints({"prompt": body.get("prompt"), "user_id": user, "requested_max_tokens": body.get("max_tokens",256), "risk_level": body.get("risk_level","default")}, output_preview=result)
+    if hp2.get("action") == "block":
+        # quarantine and block
+        log_event({"user": user, "request_id": result.get("request_id"), "action":"blocked_after_preview", "reason":hp2.get("reason"), "model": model_name}, persist_to_s3=True)
+        quarantine_artifact({"req": body, "resp": result})
+        raise HTTPException(status_code=403, detail="Response blocked by policy")
+    if hp2.get("action") == "enqueue_review" or hp2.get("action") == "require_manual_approval":
+        req_id = result.get("request_id") or str(uuid.uuid4())
+        log_event({"user": user, "request_id": req_id, "action":"enqueued_for_review", "reason":hp2.get("reason"), "model": model_name}, persist_to_s3=True)
+        return {"status":"enqueued_for_review", "request_id": req_id, "preview": result}
+
+    # allowed: audit and return
+    log_event({"user": user, "request_id": result.get("request_id"), "action":"allowed", "reason":"policy_passed", "model": model_name}, persist_to_s3=False)
+    return result
+
