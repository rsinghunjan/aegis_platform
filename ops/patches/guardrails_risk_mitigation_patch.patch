+"""
+Hard policy enforcer and fail-safe guardrails.
+ - Enforces non-negotiable constraints (forbidden patterns, max tokens, evidence_required for high-risk)
+ - Integrates with policy_engine to decide action and escalates to human approval if needed
+ - Designed to be called from inference gateway before forwarding to model
+"""
+import os, re, time, json
+from typing import Dict, Any
+from services.explainability.auto_explain import uncertainty_from_logits
+from services.policy.policy_engine import evaluate as evaluate_policy
+from services.policy.quarantine import quarantine_artifact
+
+MAX_TOKENS_DEFAULT = int(os.environ.get("MAX_TOKENS_DEFAULT", "1024"))
+FORBIDDEN_PATTERNS = [
+    re.compile(r"\b(?:secret|password|ssn|social security|credit card)\b", re.IGNORECASE),
+]
+HUMAN_APPROVAL_SIGNAL_URL = os.environ.get("HUMAN_APPROVAL_SIGNAL_URL", "")  # optional
+
+def matches_forbidden(text: str) -> bool:
+    if not text:
+        return False
+    for p in FORBIDDEN_PATTERNS:
+        if p.search(text):
+            return True
+    return False
+
+def enforce_hard_constraints(request: Dict[str, Any], output_preview: Dict[str, Any]=None) -> Dict[str, Any]:
+    """
+    request: { prompt, user_id, model, requested_max_tokens, risk_level }
+    output_preview: best-effort predicted output (optional) used for pre-checks
+    Returns action dict: {"action":"allow"|"enqueue_review"|"block"|"require_manual_approval", "reason": "..."}
+    """
+    # basic DLP
+    if matches_forbidden(request.get("prompt","")):
+        return {"action":"block", "reason":"forbidden_content_in_prompt"}
+
+    # token limit
+    limit = int(request.get("requested_max_tokens", MAX_TOKENS_DEFAULT))
+    if limit > MAX_TOKENS_DEFAULT:
+        return {"action":"block", "reason":"requested_token_limit_exceeds_policy"}
+
+    # policy-level evaluation (evidence_required, verifier thresholds, etc.)
+    # If output_preview is provided, evaluate against policy; else conservative path: require review for high risk
+    if output_preview:
+        verdict = evaluate_policy(output_preview)
+        if verdict.get("action") == "allow":
+            return {"action":"allow", "reason":"policy_passed"}
+        if verdict.get("action") == "enqueue_review":
+            # quarantine artifact and enqueue
+            quarantine_artifact({"req": request, "preview": output_preview, "ts": time.time()})
+            return {"action":"enqueue_review", "reason":"policy_requested_review"}
+        if verdict.get("action") == "block":
+            return {"action":"block", "reason":"policy_blocked"}
+    else:
+        # No preview; conservative behavior for high-risk
+        if request.get("risk_level","default") == "high_risk":
+            return {"action":"require_manual_approval", "reason":"no_preview_high_risk"}
+
+    return {"action":"allow", "reason":"no_issues_detected"}
+
