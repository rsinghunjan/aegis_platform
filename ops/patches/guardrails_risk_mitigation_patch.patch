+"""
+Safe promotion controller:
+ - Ensures candidate models only auto-promote when safety margins and validation battery pass
+ - Otherwise create a human approval request and block automatic promotion
+"""
+import os, requests, json, time
+from services.audit.audit_logger import log_event
+
+VERIFICATION_METRICS_THRESHOLD = float(os.environ.get("PROMOTION_VERIFIER_THRESHOLD", "0.45"))
+MIN_PERF_MARGIN = float(os.environ.get("PROMOTION_PERF_MARGIN", "0.02"))  # candidate must beat baseline by margin or at least match
+MANUAL_APPROVAL_URL = os.environ.get("MANUAL_APPROVAL_URL", "http://manual-approval:8080/request")
+
+def evaluate_and_promote(candidate_artifact: dict, validation_results: dict) -> dict:
+    """
+    validation_results: output from validation battery containing keys: verifier_f1, perf_score, fairness_ok (bool), adversarial_ok (bool)
+    """
+    vid = candidate_artifact.get("id")
+    # basic safety checks
+    if not validation_results.get("fairness_ok") or not validation_results.get("adversarial_ok"):
+        # enqueue for human review
+        log_event({"user":"system","request_id": vid, "action":"promotion_blocked","reason":"safety_checks_failed","model": candidate_artifact.get("name")}, persist_to_s3=True)
+        # request manual approval
+        try:
+            requests.post(MANUAL_APPROVAL_URL, json={"request_id": vid, "user":"system", "reason":"safety_checks_failed"})
+        except Exception:
+            pass
+        return {"status":"blocked","reason":"safety_checks_failed"}
+
+    # verifier threshold
+    if validation_results.get("verifier_f1",0.0) < VERIFICATION_METRICS_THRESHOLD:
+        log_event({"user":"system","request_id":vid,"action":"promotion_blocked","reason":"verifier_threshold_not_met","model":candidate_artifact.get("name")}, persist_to_s3=True)
+        requests.post(MANUAL_APPROVAL_URL, json={"request_id": vid, "user":"system", "reason":"verifier_threshold_not_met"})
+        return {"status":"blocked","reason":"verifier_threshold_not_met"}
+
+    # perf check (must not regress more than MIN_PERF_MARGIN)
+    baseline_perf = candidate_artifact.get("baseline_perf", 0.0)
+    cand_perf = validation_results.get("perf_score", 0.0)
+    if cand_perf + MIN_PERF_MARGIN < baseline_perf:
+        log_event({"user":"system","request_id":vid,"action":"promotion_blocked","reason":"perf_regression","model":candidate_artifact.get("name")}, persist_to_s3=True)
+        requests.post(MANUAL_APPROVAL_URL, json={"request_id": vid, "user":"system", "reason":"perf_regression"})
+        return {"status":"blocked","reason":"perf_regression"}
+
+    # all checks passed -> promote to canary via orchestrator (simplified)
+    try:
+        # orchestrator endpoint
+        orchestrator = os.environ.get("ORCHESTRATOR_PROMOTE_URL", "http://trainer.orchestrator:8080/promote")
+        resp = requests.post(orchestrator, json={"artifact": candidate_artifact}, timeout=30)
+        if resp.status_code == 200:
+            log_event({"user":"system","request_id":vid,"action":"promoted","model":candidate_artifact.get("name")}, persist_to_s3=True)
+            return {"status":"promoted"}
+    except Exception as e:
+        log_event({"user":"system","request_id":vid,"action":"promotion_failed","reason":str(e),"model":candidate_artifact.get("name")}, persist_to_s3=True)
+    return {"status":"error","reason":"orchestrator_failed"}
+
