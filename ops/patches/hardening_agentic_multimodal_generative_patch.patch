+#!/usr/bin/env python3
+"""
+Large-scale dry-run runner for planner + verifier + simulator
+ - Executes planner on a corpus of intents (ops/agent/sample_intents.jsonl or a provided trace)
+ - Runs many iterations in parallel (threads) and aggregates schema failure, simulation risk, and other metrics
+ - Writes aggregated evidence to EVIDENCE_BUCKET
+"""
+import os
+import json
+import threading
+from queue import Queue
+import time
+from services.agent.llm_planner_enhanced import plan_for_intent
+from services.agent.llm_plan_validator import validate_plan
+from services.agent.plan_verifier import plan_verdict
+from services.agent.simulator.business_simulator_v2 import simulate_plan
+from services.agent.audit_logger import s3_put
+
+INTENTS_FILE = os.environ.get("AGENT_INTENTS_FILE", "ops/agent/sample_intents.jsonl")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+WORKERS = int(os.environ.get("DRYRUN_WORKERS", "20"))
+ITERATIONS = int(os.environ.get("DRYRUN_ITERATIONS", "1000"))
+
+def load_intents(path):
+    out=[]
+    for l in open(path):
+        if not l.strip(): continue
+        out.append(json.loads(l))
+    return out
+
+def worker(q, stats):
+    while True:
+        item = q.get()
+        if item is None:
+            break
+        intent = item.get("intent")
+        plan = plan_for_intent(intent, {})
+        ok, info = validate_plan(plan)
+        verdict = plan_verdict(plan)
+        sim = simulate_plan(plan.get("plan",[]), None, runs=10)
+        # record per-run stats
+        stats.append({"intent": intent, "schema_ok": ok, "schema_info": str(info), "verdict": verdict, "sim": sim})
+        q.task_done()
+
+def run():
+    intents = load_intents(INTENTS_FILE)
+    if not intents:
+        print("No intents found")
+        return
+    q = Queue(maxsize=ITERATIONS)
+    stats = []
+    # spawn workers
+    threads = []
+    for _ in range(WORKERS):
+        t = threading.Thread(target=worker, args=(q, stats), daemon=True)
+        t.start()
+        threads.append(t)
+    # enqueue iterations
+    for i in range(ITERATIONS):
+        q.put(intents[i % len(intents)])
+    q.join()
+    for _ in threads:
+        q.put(None)
+    # aggregate
+    total = len(stats)
+    schema_fail = sum(1 for s in stats if not s["schema_ok"])
+    high_risk = sum(1 for s in stats if s["verdict"].get("sim",{}).get("summary",{}).get("max_risk_p95",0) > 0.5)
+    report = {"ts": int(time.time()), "total_runs": total, "schema_failures": schema_fail, "high_risk_count": high_risk, "sample": stats[:50]}
+    out = f"/tmp/long_dryrun_{int(time.time())}.json"
+    with open(out,"w") as f:
+        json.dump(report, f, indent=2)
+    if EVIDENCE_BUCKET:
+        s3_put(f"agent_long_dryrun/{os.path.basename(out)}", report)
+    print("Wrote dryrun report:", out)
+    return out
+
+if __name__=="__main__":
+    run()
+
