+#!/usr/bin/env python3
+"""
+SME signoff service for verifier thresholds.
+ - Exposes simple CLI and a small HTTP endpoint to record SME approvals for thresholds.
+ - Stores signoffs in a ConfigMap in Kubernetes or uploads to evidence bucket for audit.
+"""
+import os
+import json
+from datetime import datetime
+try:
+    from kubernetes import client, config
+    K8S = True
+except Exception:
+    K8S = False
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+CONFIGMAP_NAME = os.environ.get("SME_SIGNOFF_CM", "verifier-sme-signoffs")
+NAMESPACE = os.environ.get("SME_NAMESPACE", "safety")
+
+def record_signoff(sme_name, thresholds_path, notes=""):
+    payload = {"sme": sme_name, "thresholds_path": thresholds_path, "notes": notes, "ts": int(datetime.utcnow().timestamp())}
+    # write to evidence bucket if available
+    if EVIDENCE_BUCKET and boto3:
+        s3 = boto3.client("s3")
+        key = f"verifier_signoffs/{sme_name}_{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode("utf-8"))
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    # else store as ConfigMap
+    if K8S:
+        try:
+            config.load_incluster_config()
+        except Exception:
+            config.load_kube_config()
+        v1 = client.CoreV1Api()
+        cm = client.V1ConfigMap(metadata=client.V1ObjectMeta(name=CONFIGMAP_NAME), data={sme_name: json.dumps(payload)})
+        try:
+            v1.create_namespaced_config_map(namespace=NAMESPACE, body=cm)
+        except client.exceptions.ApiException as e:
+            if e.status == 409:
+                v1.patch_namespaced_config_map(name=CONFIGMAP_NAME, namespace=NAMESPACE, body=cm)
+        return f"configmap://{NAMESPACE}/{CONFIGMAP_NAME}"
+    # fallback local
+    out = f"/tmp/verifier_signoff_{sme_name}_{int(time.time())}.json"
+    with open(out, "w") as f:
+        json.dump(payload, f, indent=2)
+    return out
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--sme", required=True)
+    p.add_argument("--thresholds", required=True)
+    p.add_argument("--notes", default="")
+    args = p.parse_args()
+    res = record_signoff(args.sme, args.thresholds, args.notes)
+    print("Recorded signoff to", res)
+
