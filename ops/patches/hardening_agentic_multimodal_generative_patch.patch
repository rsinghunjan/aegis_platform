+#!/usr/bin/env python3
+"""
+Stress runner for resumable ingest.
+ - Spawns multiple parallel uploader processes to hit the resumable service
+ - Collects success/failure counts and basic latency metrics
+ - Can run for a specified duration or number of total uploads
+ - Uploads a summary to EVIDENCE_BUCKET
+"""
+import argparse
+import requests
+import time
+from concurrent.futures import ThreadPoolExecutor, as_completed
+import os, json
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def upload_file(server, filepath, dataset, modality, chunk_size=1024*256):
+    fname = os.path.basename(filepath)
+    init = requests.post(f"{server}/resumable/init", json={"filename": fname, "modality": modality, "dataset_id": dataset}, timeout=10)
+    init.raise_for_status()
+    uid = init.json()["upload_id"]
+    with open(filepath, "rb") as f:
+        offset = 0
+        while True:
+            data = f.read(chunk_size)
+            if not data:
+                break
+            files = {'chunk': ('chunk', data)}
+            r = requests.put(f"{server}/resumable/{uid}/chunk?offset={offset}", files=files, timeout=30)
+            r.raise_for_status()
+            offset += len(data)
    # finalize
+    fin = requests.post(f"{server}/resumable/{uid}/finalize", timeout=120)
+    fin.raise_for_status()
+    return fin.json()
+
+def run_load(server, files, parallel, total_uploads):
+    results = []
+    start = time.time()
+    with ThreadPoolExecutor(max_workers=parallel) as ex:
+        futures = []
+        for i in range(total_uploads):
+            fp = files[i % len(files)]
+            futures.append(ex.submit(upload_file, server, fp, "stress-dataset", "image"))
+        for fut in as_completed(futures):
+            try:
+                res = fut.result()
+                results.append({"ok": True, "resp": res})
+            except Exception as e:
+                results.append({"ok": False, "error": str(e)})
+    dur = time.time() - start
+    success = sum(1 for r in results if r["ok"])
+    fail = sum(1 for r in results if not r["ok"])
+    summary = {"total": len(results), "success": success, "fail": fail, "duration_s": dur}
+    return summary, results
+
+def upload_summary(summary, details, run_id):
+    out = {"ts": int(time.time()), "run_id": run_id, "summary": summary}
+    if EVIDENCE_BUCKET and boto3:
+        s3 = boto3.client("s3")
+        key = f"ingest_stress/{run_id}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(out).encode("utf-8"))
+        # also upload details truncated
+        key2 = f"ingest_stress/{run_id}_details.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key2, Body=json.dumps(details[:100]).encode("utf-8"))
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    else:
+        path = f"/tmp/ingest_stress_{run_id}.json"
+        with open(path, "w") as f:
+            json.dump(out, f, indent=2)
+        return path
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--server", required=True)
+    p.add_argument("--files", nargs="+", required=True)
+    p.add_argument("--parallel", type=int, default=50)
+    p.add_argument("--total", type=int, default=500)
+    args = p.parse_args()
+    summary, details = run_load(args.server, args.files, args.parallel, args.total)
+    run_id = f"stress_{int(time.time())}"
+    uri = upload_summary(summary, details, run_id)
+    print("Summary uploaded to", uri)
+
+if __name__=="__main__":
+    main()
+
