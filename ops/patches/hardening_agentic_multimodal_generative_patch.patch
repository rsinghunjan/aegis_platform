+from services.agent.backup_store import store_backup
+from services.agent.sensitive_tools import is_sensitive, get_sensitivity
+from services.agent.human_approval_requester import request_approval, wait_for_approval
+
+# Underlying adapter import (may need operator to edit)
+try:
+    from services.agent.tool_adapters import {adapter_module}
+except Exception:
+    {adapter_module} = None
+
+def wrapper_{fn_name}(requester: str, params: dict, dry_run: bool = False):
+    tool_full = "{tool_name}"
+    if not is_allowed(requester, tool_full):
+        raise PermissionError(f"{{requester}} not allowed to call {{tool_full}}")
+    if is_sensitive(tool_full):
+        meta = get_sensitivity(tool_full)
+        min_role = meta.get("min_role")
+        roles = user_roles(requester)
+        if min_role not in roles and "*" not in roles:
+            rid = request_approval(f"Manual approval for {{tool_full}}", requester, {{"params": params}})
+            approval = wait_for_approval(rid)
+            if approval.get("state") != "approved":
+                return {{"status": "rejected_by_human", "approval": approval}}
+    # take best-effort backup (adapter may implement snapshot helpers)
+    try:
+        backup_uri = store_backup(f"pre_{tool_full}_{requester}", params)
+    except Exception:
+        backup_uri = None
+    if dry_run:
+        return {{"status": "dry_run_ok", "backup_uri": backup_uri}}
+    # call underlying adapter function if present
+    if {adapter_module} is None:
+        return {{"status":"not_implemented","note":"adapter module missing"}}
+    # operator: adapt the call below to match adapter signature
+    try:
+        func = getattr({adapter_module}, "{adapter_fn}", None)
+        if not func:
+            return {{"status":"not_implemented","note":"adapter function missing"}}
+        # assume adapter accepts **params
+        res = func(**params)
+        return {{"status":"ok","result":res,"backup_uri": backup_uri}}
+    except Exception as e:
+        # in case of error, it's expected controllers / executors will attempt rollback using backup_uri
+        return {{"status":"failed","error": str(e), "backup_uri": backup_uri}}
+
+'''
+
+def safe_name(s):
+    return s.replace(".", "_").replace("/", "_")
+
+def main():
+    tools = tool_registry.list_tools()
+    for name, meta in tools.items():
+        # try to infer adapter module and function name from tool name (heuristic)
+        parts = name.split(".")
+        adapter_module = f"tool_adapters.{parts[0]}_adapter"
+        adapter_fn = parts[1] if len(parts) > 1 else parts[0]
+        fn_name = safe_name(name)
+        out = TEMPLATE.format(tool_name=name, adapter_module=adapter_module, adapter_fn=adapter_fn, fn_name=fn_name)
+        fname = os.path.join(OUT_DIR, f"{fn_name}.py")
