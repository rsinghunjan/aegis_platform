+#!/usr/bin/env python3
+"""
+Audit-runner for generated wrappers.
+ - Loads wrappers from services/agent/tool_adapters/generated and runs dry_run checks
+ - Validates RBAC enforcement by exercising each wrapper with a test requester and records results
+ - Produces an audit report and uploads to EVIDENCE_BUCKET if configured
+"""
+import os
+import importlib.util
+import glob
+import json
+import time
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+GEN_DIR = os.environ.get("TOOL_WRAPPER_OUT", "services/agent/tool_adapters/generated")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def load_wrapper(path):
+    spec = importlib.util.spec_from_file_location("mod", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+def run():
+    results = []
+    for p in glob.glob(os.path.join(GEN_DIR, "*.py")):
+        name = os.path.basename(p)
+        try:
+            mod = load_wrapper(p)
+            # find any callable wrapper_* in module
+            funcs = [getattr(mod, a) for a in dir(mod) if a.startswith("wrapper_")]
+            for f in funcs:
+                # run dry-run with test params
+                try:
+                    res = f("ci", {"test": "value"}, dry_run=True)
+                    results.append({"wrapper": name, "func": f.__name__, "ok": True, "result": res})
+                except Exception as e:
+                    results.append({"wrapper": name, "func": f.__name__, "ok": False, "error": str(e)})
+        except Exception as e:
+            results.append({"wrapper": name, "loaded": False, "error": str(e)})
+    report = {"ts": int(time.time()), "results": results}
+    out = f"/tmp/wrapper_audit_{int(time.time())}.json"
+    with open(out, "w") as f:
+        json.dump(report, f, indent=2)
+    if EVIDENCE_BUCKET and boto3:
+        s3 = boto3.client("s3")
+        key = f"agent_wrapper_audit/{os.path.basename(out)}"
+        s3.upload_file(out, EVIDENCE_BUCKET, key)
+        print("Uploaded to s3://{}/{}".format(EVIDENCE_BUCKET, key))
+    print("Report:", out)
+    return out
+
+if __name__=="__main__":
+    run()
+
