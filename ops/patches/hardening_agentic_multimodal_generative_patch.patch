+#!/usr/bin/env python3
+"""
+Validate model repo uploaded to model store and perform a quick inference test against Triton server.
+ - Expects model_name and server host
+ - Calls Triton Model Control reload and then sends sample inference to verify correctness
+"""
+import sys
+import time
+import requests
+import json
+
+def reload_triton(server):
+    url_reload = f"http://{server}/v2/repository/models?action=reload"
+    r = requests.post(url_reload, timeout=30)
+    r.raise_for_status()
+    return r.text
+
+def infer_test(server, model_name, input_payload):
+    # This assumes model has HTTP infer endpoint /v2/models/{model}/infer (adjust as needed)
+    url = f"http://{server}/v2/models/{model_name}/infer"
+    r = requests.post(url, json=input_payload, timeout=30)
+    r.raise_for_status()
+    return r.json()
+
+def main():
+    if len(sys.argv) < 4:
+        print("Usage: validate_and_test_model.py <server:port> <model_name> <sample_input.json>")
+        sys.exit(2)
+    server = sys.argv[1]; model = sys.argv[2]; sample = sys.argv[3]
+    print("Reloading Triton models...")
+    reload_triton(server)
+    print("Waiting 5s for models to load...")
+    time.sleep(5)
+    payload = json.load(open(sample))
+    print("Running test inference...")
+    out = infer_test(server, model, payload)
+    print("Inference OK:", out)
+
+if __name__=="__main__":
+    main()
+
