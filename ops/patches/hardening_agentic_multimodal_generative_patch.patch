+#!/usr/bin/env python3
+"""
+Continuous long-shadow daemon to mirror a % of production generation traffic to candidate endpoints.
+ - Designed to run inside cluster as a deployment; reads sampling rate and writes to EVIDENCE_BUCKET.
+ - Includes rotation and batching for S3 writes to reduce API chattiness.
+"""
+import os
+import time
+import json
+import random
+import threading
+try:
+    import boto3
+except Exception:
+    boto3 = None
+from services.agent.audit_logger import s3_put
+
+PROD_PROXY = os.environ.get("PROD_PROXY", "http://prod-gen-proxy:8080/generate")
+CANDIDATE_URL = os.environ.get("CANDIDATE_URL")
+SAMPLE_RATE = float(os.environ.get("LONG_SHADOW_SAMPLE_RATE", "0.01"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+BATCH_SIZE = int(os.environ.get("LONG_SHADOW_BATCH", "50"))
+OUT_PREFIX = "gen_shadow/long"
+
+buffer = []
+lock = threading.Lock()
+
+def send_batch(b):
+    rec = {"ts": int(time.time()), "samples": b}
+    if EVIDENCE_BUCKET and boto3:
+        key = f"{OUT_PREFIX}/{int(time.time())}_batch.json"
+        s3 = boto3.client("s3")
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(rec).encode("utf-8"))
+    else:
+        path = f"/tmp/long_shadow_{int(time.time())}.json"
+        with open(path, "w") as f:
+            json.dump(rec, f)
+
+def shadow_request(request_payload):
+    # send to candidate endpoint, record both responses
+    try:
+        import requests
+        prod = requests.post(PROD_PROXY, json=request_payload, timeout=10).json()
+    except Exception:
+        prod = {"error": "prod_failed"}
+    try:
+        cand = requests.post(CANDIDATE_URL, json=request_payload, timeout=30).json()
+    except Exception:
+        cand = {"error": "cand_failed"}
+    rec = {"ts": time.time(), "request": request_payload, "prod": prod, "candidate": cand}
+    with lock:
+        buffer.append(rec)
+        if len(buffer) >= BATCH_SIZE:
+            b = buffer[:]
+            buffer.clear()
+            send_batch(b)
+
+def main_loop():
+    # in real deployment, this subscribes to a message bus or receives traffic from the proxy
+    print("Long shadow daemon started, sampling rate:", SAMPLE_RATE)
+    while True:
+        # in this scaffold we generate synthetic prompts; replace by hooking into actual request stream
+        if random.random() < SAMPLE_RATE:
+            req = {"prompt": "Long-shadow sample " + str(time.time()), "max_tokens": 64}
+            shadow_request(req)
+        time.sleep(0.1)
+
+if __name__=="__main__":
+    main_loop()
+
