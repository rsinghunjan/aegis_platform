+os.makedirs(OUT_DIR, exist_ok=True)
+
+TEMPLATE = '''#!/usr/bin/env python3
+"""
+Auto-generated wrapper for {tool_name}
+ - Enforces RBAC using services.agent.rbac_manager.is_allowed
+ - Supports dry_run param
+ - Calls the underlying adapter function if available
+ - Captures pre-action backup (best-effort) via services.agent.backup_store.store_backup
+"""
