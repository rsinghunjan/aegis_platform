+"""
+Helpers to fetch secrets from AWS Secrets Manager or decrypt with KMS.
+
+Functions:
+ - get_secret_value(secret_name): fetches from Secrets Manager and returns plaintext (caches short-term)
+ - decrypt_with_kms(ciphertext_blob): decrypts using local IAM role via boto3 KMS client
+
+Environment:
+ AWS region should be configured via AWS env vars or IAM role attached to the pod.
+"""
+import os
+import time
+from typing import Optional
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+_cache = {}
+_CACHE_TTL = int(os.environ.get("SECRETS_CACHE_TTL", "30"))
+
+def get_secret_value(secret_name: str) -> Optional[str]:
+    """Fetch secret value from AWS Secrets Manager (string) with caching."""
+    if not boto3:
+        return None
+    ent = _cache.get(secret_name)
+    if ent and (time.time() - ent["ts"] < _CACHE_TTL):
+        return ent["val"]
+    client = boto3.client("secretsmanager")
+    try:
+        r = client.get_secret_value(SecretId=secret_name)
+        val = r.get("SecretString") or r.get("SecretBinary")
+        _cache[secret_name] = {"ts": time.time(), "val": val}
+        return val
+    except Exception:
+        return None
+
+def decrypt_with_kms(cipher_blob: bytes) -> Optional[bytes]:
+    if not boto3:
+        return None
+    kms = boto3.client("kms")
+    try:
+        r = kms.decrypt(CiphertextBlob=cipher_blob)
+        return r.get("Plaintext")
+    except Exception:
+        return None
+
