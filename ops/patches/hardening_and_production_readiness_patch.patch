+#!/usr/bin/env python3
+"""
+Prometheus relabeling & label-check helper
+
+ - Queries Prometheus for DCGM (GPU) metrics and checks that series include job_id and model_name labels.
+ - If labels missing, it prints recommended ServiceMonitor relabel configs (yaml snippet) to map pod annotations -> labels.
+ - Use this as an interactive helper during staging.
+"""
+import os
+import requests
+import sys
+import yaml
+
+PROM = os.environ.get("PROM_HOST", "http://prometheus.monitoring.svc:9090")
+
+def get_metric_names():
+    r = requests.get(f"{PROM}/api/v1/label/__name__/values", timeout=10)
+    r.raise_for_status()
+    return r.json().get("data", [])
+
+def check_metric_sample(metric):
+    q = f"{metric}[5m]"
+    r = requests.get(f"{PROM}/api/v1/query", params={"query": q}, timeout=10)
+    r.raise_for_status()
+    res = r.json().get("data", {}).get("result", [])
+    return res
+
+def suggest_relabel():
+    # A common relabel maps pod annotations to labels: metadata.annotations['aegis.job_id'] -> job_id
+    sm = {
+        "relabel_configs": [
+            {"source_labels": ["__meta_kubernetes_pod_annotation_aegis_job_id"], "target_label": "job_id", "action": "replace"},
+            {"source_labels": ["__meta_kubernetes_pod_annotation_aegis_model_name"], "target_label": "model_name", "action": "replace"},
+            {"source_labels": ["__meta_kubernetes_pod_node_label_aegis_region"], "target_label": "aegis_region", "action": "replace"},
+        ]
+    }
+    print("# Suggested relabel_config snippet for ServiceMonitor/Prometheus scrape_config:")
+    print(yaml.safe_dump(sm, sort_keys=False))
+
+def main():
+    names = get_metric_names()
+    dcgm = [n for n in names if n.startswith("dcgm") or n.startswith("nvidia") or n.startswith("dcgm_nvml")]
+    if not dcgm:
+        print("No DCGM-like metrics found. Ensure dcgm-exporter is deployed and scraped.")
+        sys.exit(2)
+    print("Found DCGM-like metrics (sample):", dcgm[:10])
+    issues = 0
+    for m in dcgm[:3]:
+        print("Checking:", m)
+        series = check_metric_sample(m)
+        if not series:
+            print("  No series in recent interval (maybe no GPU activity); skipping.")
+            continue
+        has_job = any("job_id" in s.get("metric", {}) for s in series)
+        has_model = any("model_name" in s.get("metric", {}) for s in series)
+        print(f"  has_job_id={has_job}, has_model_name={has_model}")
+        if not (has_job and has_model):
+            issues += 1
+    if issues:
+        print(f"\nDetected {issues} metrics missing job_id/model_name labels.")
+        print("You can add relabel rules that map pod annotations -> labels on scrape time. Example below:\n")
+        suggest_relabel()
+        sys.exit(3)
+    print("Prometheus label checks passed.")
+
+if __name__ == "__main__":
+    main()
+
