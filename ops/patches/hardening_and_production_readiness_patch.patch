+"""
+Keycloak auth helpers for FastAPI services.
+
+Provides:
+ - validate_token dependency (validates access tokens via Keycloak userinfo endpoint)
+ - require_role(role) dependency factory (ensures token includes role)
+ - simple token caching to reduce introspection calls
+
+Configure via env:
+ KEYCLOAK_URL, KEYCLOAK_REALM, KEYCLOAK_CLIENT_ID
+"""
+import os
+import time
+import requests
+from typing import Dict, Any
+from fastapi import HTTPException, Security
+from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
+
+KEYCLOAK_URL = os.environ.get("KEYCLOAK_URL", "")
+KEYCLOAK_REALM = os.environ.get("KEYCLOAK_REALM", "aegis")
+CLIENT_ID = os.environ.get("KEYCLOAK_CLIENT_ID", "")
+
+security = HTTPBearer(auto_error=False)
+_token_cache: Dict[str, Dict[str, Any]] = {}
+_CACHE_TTL = int(os.environ.get("KEYCLOAK_TOKEN_CACHE_TTL", "30"))  # seconds
+
+def _fetch_userinfo(token: str) -> Dict[str, Any]:
+    if not KEYCLOAK_URL:
+        # dev mode: accept any token with a dummy user
+        return {"preferred_username": "dev", "realm_access": {"roles": ["admin"]}}
+    # cache
+    ent = _token_cache.get(token)
+    if ent and (time.time() - ent["ts"] < _CACHE_TTL):
+        return ent["userinfo"]
+    # try userinfo endpoint
+    try:
+        resp = requests.get(f"{KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}/protocol/openid-connect/userinfo",
+                            headers={"Authorization": f"Bearer {token}"}, timeout=5)
+        if resp.status_code == 200:
+            ui = resp.json()
+            _token_cache[token] = {"ts": time.time(), "userinfo": ui}
+            return ui
+        # fallback to introspect
+        resp = requests.post(f"{KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}/protocol/openid-connect/token/introspect",
+                             data={"token": token, "client_id": CLIENT_ID}, timeout=5)
+        if resp.status_code == 200 and resp.json().get("active"):
+            ui = resp.json()
+            _token_cache[token] = {"ts": time.time(), "userinfo": ui}
+            return ui
+    except Exception:
+        pass
+    raise HTTPException(status_code=401, detail="Invalid or expired token")
+
+def validate_token(credentials: HTTPAuthorizationCredentials = Security(security)) -> Dict[str, Any]:
+    if not credentials:
+        raise HTTPException(status_code=401, detail="Missing Authorization header")
+    token = credentials.credentials
+    return _fetch_userinfo(token)
+
+def require_role(role: str):
+    """Return a FastAPI dependency that ensures the token has the given realm role."""
+    def _dep(userinfo = Security(validate_token)):
+        roles = userinfo.get("realm_access", {}).get("roles", []) if userinfo else []
+        if role not in roles:
+            raise HTTPException(status_code=403, detail=f"requires role: {role}")
+        return userinfo
+    return _dep
+
