+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Verify S3 bucket object lock configuration and attempt to apply default retention (best-effort).
+# Note: Object Lock must be enabled at bucket creation. This script will verify configuration and
+# report instructions if bucket not created with object lock.
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+if [ -z "$EVIDENCE_BUCKET" ]; then
+  echo "EVIDENCE_BUCKET required"
+  exit 2
+fi
+if ! command -v aws >/dev/null 2>&1; then
+  echo "aws CLI required"
+  exit 3
+fi
+cfg=$(aws s3api get-bucket-object-lock-configuration --bucket "$EVIDENCE_BUCKET" 2>/dev/null || true)
+if [ -z "$cfg" ]; then
+  echo "Bucket $EVIDENCE_BUCKET not configured with Object Lock or permission denied."
+  echo "To create a bucket with object lock enabled:"
+  echo "  aws s3api create-bucket --bucket $EVIDENCE_BUCKET --object-lock-enabled-for-bucket --region <region>"
+  echo "Then apply default retention:"
+  echo "  aws s3api put-bucket-object-lock-configuration --bucket $EVIDENCE_BUCKET --object-lock-configuration '{\"ObjectLockEnabled\":\"Enabled\",\"Rule\":{\"DefaultRetention\":{\"Mode\":\"GOVERNANCE\",\"Days\":365}}}'"
+  exit 1
+else
+  echo "Object Lock configuration exists:"
+  echo "$cfg"
+  echo "You may patch default retention via put-bucket-object-lock-configuration as needed."
+fi
+
