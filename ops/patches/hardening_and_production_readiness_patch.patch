+"""
+Wrapper audit runner (stricter checks)
+
+Checks:
+ - presence of explicit emergency-stop check in wrapper (search for AEGIS_EMERGENCY_STOP or actuator-emergency)
+ - idempotency: must read request_id and cache or handle duplicates (search for 'request_id')
+ - transaction_manager integration: calls to start_transaction/record_step/finalize_transaction
+ - evidence upload: uses EVIDENCE_BUCKET or upload_evidence call
+
+Outputs a JSON report for CI gating.
+"""
+import os
+import re
+import json
+from pathlib import Path
+
+ROOT = os.environ.get("WRAPPER_DIR", "services")  # directory to scan for wrappers
+
+RULES = {
+    "emergency_check": re.compile(r"AEGIS_EMERGENCY_STOP|actuator-emergency"),
+    "request_id": re.compile(r"request_id"),
+    "transaction": re.compile(r"start_transaction|record_step|finalize_transaction"),
+    "evidence": re.compile(r"upload_evidence|EVIDENCE_BUCKET|s3.put_object"),
+}
+
+def scan_file(p: Path):
+    text = p.read_text()
+    results = {}
+    for k, rx in RULES.items():
+        results[k] = bool(rx.search(text))
+    return results
+
+def run():
+    wrappers = list(Path(ROOT).rglob("*wrapper*.py"))
+    report = {"summary": {}, "files": {}}
+    total_fail = 0
+    for w in wrappers:
+        res = scan_file(w)
+        report["files"][str(w)] = res
+        fails = [k for k, v in res.items() if not v]
+        report["files"][str(w)]["fails"] = fails
+        if fails:
+            total_fail += 1
+    report["summary"]["total_wrappers"] = len(wrappers)
+    report["summary"]["failures"] = total_fail
+    out = Path("/tmp/wrapper_audit_report.json")
+    out.write_text(json.dumps(report, indent=2))
+    print("Report written to", out)
+    # exit non-zero if any failures
+    return 1 if total_fail else 0
+
+if __name__ == "__main__":
+    import sys
+    sys.exit(run())
+
