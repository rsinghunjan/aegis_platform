+          docker build -t $IMAGE -f Dockerfile .
+          echo "${{ secrets.REGISTRY_PASSWORD }}" | docker login ${{ secrets.IMAGE_REG }} -u "${{ secrets.REGISTRY_USER }}" --password-stdin
