+  template:
+    metadata:
+      labels:
+        app: cosign-test-${{ github.run_id }}
+    spec:
+      containers:
+      - name: test
+        image: $IMAGE
+        command: ["/bin/sh","-c","sleep 3600"]
+EOF
+          kubectl apply -f /tmp/deploy.yaml
+          # wait for pod creation or admission denial
+          sleep 5
+          kubectl -n ${PROD_NAMESPACE} get pods -l app=cosign-test-${{ github.run_id }} || true
