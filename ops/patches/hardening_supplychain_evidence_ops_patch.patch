+#!/usr/bin/env python3
+"""
+Audit Event Uploader
+ - Tails local per-inference event log file and periodically uploads rotated chunks to S3/GCS
+ - Uses SSE-KMS and sets object lock retention metadata (bucket must have Object Lock enabled)
+ - Writes a small manifest for each upload for audit indexing
+"""
+import os
+import time
+import json
+import boto3
+from datetime import datetime, timedelta
+
+EVENT_LOG = os.environ.get("EVENT_LOG", "/var/log/aegis/inference_events.jsonl")
+UPLOAD_BUCKET = os.environ.get("EVIDENCE_BUCKET")
+KMS_KEY_ARN = os.environ.get("COSIGN_KMS_ARN")  # reuse cosign KMS or separate key
+CHUNK_SIZE = int(os.environ.get("EVENT_UPLOAD_CHUNK", "1000"))
+SLEEP = int(os.environ.get("EVENT_UPLOAD_INTERVAL", "60"))
+REGION = os.environ.get("AWS_REGION", "us-west-2")
+
+s3 = boto3.client("s3", region_name=REGION)
+
+def rotate_and_upload():
+    if not os.path.exists(EVENT_LOG):
+        return
+    tmp = EVENT_LOG + ".upload"
+    # move to tmp and create new empty file atomically
+    try:
+        os.rename(EVENT_LOG, tmp)
+    except FileNotFoundError:
+        return
+    # split into chunks
+    with open(tmp) as f:
+        batch = []
+        i = 0
+        for line in f:
+            batch.append(line)
+            if len(batch) >= CHUNK_SIZE:
+                upload_chunk(batch, i)
+                batch = []
+                i += 1
+        if batch:
+            upload_chunk(batch, i)
+    os.remove(tmp)
+
+def upload_chunk(lines, idx):
+    ts = datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
+    key = f"events/{ts}/events_{idx}.jsonl"
+    body = "".join(lines).encode("utf-8")
+    # Put object with SSE-KMS using provided KMS key and set retention (if bucket supports object lock)
+    extra = {
+        "ServerSideEncryption": "aws:kms",
+        "SSEKMSKeyId": KMS_KEY_ARN
+    }
+    print("Uploading", key, "size", len(body))
+    s3.put_object(Bucket=UPLOAD_BUCKET, Key=key, Body=body, **extra)
+    # Optionally set object lock retention (requires permissions)
+    try:
+        retention_until = (datetime.utcnow() + timedelta(days=3650)).isoformat() + "Z"
+        s3.put_object_retention(Bucket=UPLOAD_BUCKET, Key=key, Retention={'Mode':'GOVERNANCE','RetainUntilDate':retention_until})
+    except Exception as e:
+        print("Warning: failed to set retention on", key, e)
+
+def main_loop():
+    while True:
+        try:
+            rotate_and_upload()
+        except Exception as e:
+            print("Uploader error", e)
+        time.sleep(SLEEP)
+
+if __name__=="__main__":
+    main_loop()
+
