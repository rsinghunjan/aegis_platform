+  enable_key_rotation     = true
+}
+
+resource "aws_kms_alias" "cosign_alias" {
+  name          = "alias/aegis-cosign"
+  target_key_id = aws_kms_key.cosign_key.key_id
+}
+
+# S3 bucket for immutable evidence/artifacts with Object Lock enabled.
+resource "aws_s3_bucket" "evidence_bucket" {
+  bucket = var.evidence_bucket_name
+  acl    = "private"
+
+  versioning {
+    enabled = true
+  }
+
+  lifecycle_rule {
+    id      = "expire-old-objects"
+    enabled = true
+    noncurrent_version_expiration {
+      days = 3650
+    }
+  }
+
+  server_side_encryption_configuration {
+    rule {
+      apply_server_side_encryption_by_default {
+        sse_algorithm     = "aws:kms"
+        kms_master_key_id = aws_kms_key.cosign_key.arn
+      }
+    }
+  }
+
+  object_lock_enabled = true
+}
+
+resource "aws_s3_bucket_object_lock_configuration" "lock" {
+  bucket = aws_s3_bucket.evidence_bucket.id
+
+  rule {
+    default_retention {
+      mode  = "GOVERNANCE"
+      # Default retention in days - operator/legal must set appropriately
+      days  = var.object_lock_days
+    }
+  }
+}
+
+output "cosign_kms_key_arn" {
+  value       = aws_kms_key.cosign_key.arn
+  description = "KMS ARN to use for cosign signing"
+}
+
+output "evidence_bucket" {
+  value       = aws_s3_bucket.evidence_bucket.bucket
+  description = "S3 bucket used for immutable evidence (Object Lock enabled)"
+}
