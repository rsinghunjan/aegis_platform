+#!/usr/bin/env python3
+"""
+Archive SME signoff artifacts into immutable evidence bucket
+ - Reads local SME signoff store and uploads to S3 with retention metadata
+"""
+import os, json, time
+import boto3
+from datetime import datetime, timedelta
+
+STORE = os.environ.get("SME_STORE", "/data/sme_signoffs.jsonl")
+BUCKET = os.environ.get("EVIDENCE_BUCKET")
+KMS_KEY = os.environ.get("COSIGN_KMS_ARN")
+REGION = os.environ.get("AWS_REGION", "us-west-2")
+
+s3 = boto3.client("s3", region_name=REGION)
+
+def archive():
+    if not os.path.exists(STORE):
+        print("No SME store found")
+        return
+    ts = datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
+    key = f"sme_signoffs/{ts}_signoffs.jsonl"
+    with open(STORE) as f:
+        body = f.read().encode("utf-8")
+    s3.put_object(Bucket=BUCKET, Key=key, Body=body, ServerSideEncryption='aws:kms', SSEKMSKeyId=KMS_KEY)
+    try:
+        retention_until = (datetime.utcnow() + timedelta(days=3650)).isoformat() + "Z"
+        s3.put_object_retention(Bucket=BUCKET, Key=key, Retention={'Mode':'GOVERNANCE','RetainUntilDate':retention_until})
+    except Exception as e:
+        print("Warning: could not set retention", e)
+    print("Archived SME signoffs to", key)
+
+if __name__=="__main__":
+    archive()
+
