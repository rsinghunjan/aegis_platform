+#!/usr/bin/env python3
+"""
+Advanced inference safety middleware (production scaffold)
+ - Pluggable detectors (toxicity, PII, policy)
+ - Optional integration with detoxify if installed, otherwise falls back to regex/heuristics
+ - Logs to evidence path or Postgres (if DATABASE_URL set)
+"""
+import os, re, json, time
+
+try:
+    from detoxify import Detoxify  # optional
+    DETOX_OK = True
+except Exception:
+    DETOX_OK = False
+
+PII_RE = re.compile(r"\b\d{3}-\d{2}-\d{4}\b")
+EVIDENCE_PATH = os.environ.get("GEN_EVIDENCE_PATH", "/tmp/generative_evidence.jsonl")
+
+detox = Detoxify('original') if DETOX_OK else None
+
+def detect_toxicity(text):
+    if detox:
+        scores = detox.predict(text)
+        # simple policy: if toxicity > 0.5 flag
+        if scores.get("toxicity", 0.0) > 0.5:
+            return True, {"detox": scores}
+    # fallback heuristics
+    if "kill" in text.lower() or "attack" in text.lower():
+        return True, {"heuristic":"suspicious_term"}
+    return False, {}
+
+def detect_pii(text):
+    if PII_RE.search(text):
+        return True, {}
+    return False, {}
+
+def enforce_and_log(request_ctx, out_text, db_conn=None):
+    blocked_reasons = []
+    tox, tox_meta = detect_toxicity(out_text)
+    if tox:
+        blocked_reasons.append({"type":"toxicity","meta":tox_meta})
+    pii, _ = detect_pii(out_text)
+    if pii:
+        blocked_reasons.append({"type":"pii"})
+    blocked = len(blocked_reasons) > 0
+    rec = {"ts": time.time(), "request": request_ctx, "out_snippet": out_text[:1000], "blocked": blocked, "reasons": blocked_reasons}
+    if db_conn:
+        cur = db_conn.cursor()
+        # minimal insertion -- operator should adapt schema
+        try:
+            cur.execute("INSERT INTO generative_evidence (payload, ts) VALUES (%s, now())", (json.dumps(rec),))
+            db_conn.commit()
+        except Exception:
+            pass
+    else:
+        open(EVIDENCE_PATH, "a").write(json.dumps(rec)+"\n")
+    return not blocked, blocked_reasons
+
