+#!/usr/bin/env python3
+"""
+KEDA External Scaler (HTTP adapter) - lightweight production scaffold.
+
+Implements a simple HTTP service that implements the (HTTP) External Scaler contract
+used by KEDA-based scalers:
+ - /is-active         -> returns whether scaling should be considered active
+ - /get-metric-spec   -> returns the metric spec KEDA will use
+ - /get-metrics       -> returns the current metric(s) value(s)
+
+This implementation queries a carbon estimator endpoint (or any configured metric URL)
+and exposes KEDA-compatible responses. Adapt to your KEDA version if necessary.
+
+Config (env):
+ - CARBON_ESTIMATOR_URL (default http://carbon-estimator.carbon.svc:8080/estimate_now)
+ - METRIC_NAME (default aegis_carbon_capacity)
+ - SCALE_THRESHOLD (string number for metric target)
+ - PORT (default 8080)
+"""
+import os
+import requests
+from flask import Flask, request, jsonify
+
+CARBON_URL = os.environ.get("CARBON_ESTIMATOR_URL", "http://carbon-estimator.carbon.svc:8080/estimate_now")
+METRIC_NAME = os.environ.get("METRIC_NAME", "aegis_carbon_capacity")
+SCALE_THRESHOLD = os.environ.get("SCALE_THRESHOLD", "0.2")
+PORT = int(os.environ.get("PORT", "8080"))
+
+app = Flask(__name__)
+
+@app.route("/is-active", methods=["POST", "GET"])
+def is_active():
+    """
+    KEDA calls this to verify whether scaling should be considered.
+    We'll call the carbon estimator and decide based on capacity > 0.
+    """
+    try:
+        r = requests.get(CARBON_URL, timeout=5)
+        j = r.json()
+        cap = float(j.get("estimates", [{}])[0].get("energy_kwh", 0.0)) if j.get("estimates") else None
+        # simpler: prefer intensity -> derive capacity
+        intensity = float(j.get("intensity_gCO2e_per_kWh", 400.0))
+        capacity = max(0.0, 1.0 - (intensity / 1000.0))
+        active = capacity > 0.0
+    except Exception:
+        # conservative: mark active so KEDA can query metrics (or set false if you prefer)
+        active = True
+    return jsonify({"active": active})
+
+@app.route("/get-metric-spec", methods=["POST", "GET"])
+def get_metric_spec():
+    """
+    Return the metric specification KEDA needs to construct the ScaledObject.
+    """
+    spec = [
+        {
+            "metricName": METRIC_NAME,
+            "target": {
+                "type": "Value",
+                "value": str(SCALE_THRESHOLD)
+            }
+        }
+    ]
+    return jsonify(spec)
+
+@app.route("/get-metrics", methods=["POST", "GET"])
+def get_metrics():
+    """
+    Return current metric values for KEDA.
+    We'll call the estimator and return a single metric representing capacity (0..1).
+    KEDA expects a JSON list of dicts with name/value.
+    """
+    try:
+        r = requests.get(CARBON_URL, timeout=5)
+        j = r.json()
+        intensity = float(j.get("intensity_gCO2e_per_kWh", 400.0))
+        capacity = max(0.0, 1.0 - (intensity / 1000.0))
+        metric_value = capacity
+    except Exception:
+        metric_value = 0.0
+    metrics = [
+        {
+            "metricName": METRIC_NAME,
+            "metricValue": str(metric_value)
+        }
+    ]
+    return jsonify(metrics)
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=PORT)
+
