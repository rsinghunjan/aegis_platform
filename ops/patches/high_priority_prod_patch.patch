+#!/usr/bin/env python3
+"""
+Rater backend v2 - production-hardened scaffold
+ - PostgreSQL-backed (DATABASE_URL)
+ - Token-based API key auth (RATER_API_KEY)
+ - Basic endpoints: POST /pairs, GET /task, POST /vote
+ - Admin endpoints protected by API key to list stats
+
+Environment:
+ - DATABASE_URL (postgresql://user:pass@host:5432/db)
+ - RATER_API_KEY (shared secret for clients)
+"""
+import os
+import json
+import uuid
+import psycopg2
+from flask import Flask, request, jsonify, abort
+from datetime import datetime
+
+DB_URL = os.environ.get("DATABASE_URL")
+API_KEY = os.environ.get("RATER_API_KEY", "change-me")
+
+app = Flask(__name__)
+
+def get_conn():
+    if not DB_URL:
+        raise RuntimeError("DATABASE_URL not set")
+    return psycopg2.connect(DB_URL, connect_timeout=5)
+
+def require_api_key():
+    key = request.headers.get("X-API-KEY") or request.args.get("api_key")
+    if not key or key != API_KEY:
+        abort(401)
+
+@app.route("/health")
+def health():
+    return jsonify({"ok": True})
+
+@app.route("/pairs", methods=["POST"])
+def add_pairs():
+    require_api_key()
+    pairs = request.json
+    if not isinstance(pairs, list):
+        return jsonify({"error":"expected list"}), 400
+    conn = get_conn()
+    cur = conn.cursor()
+    for p in pairs:
+        pid = str(uuid.uuid4())
+        cur.execute("INSERT INTO rater_pairs (id, a, b, meta, created_at) VALUES (%s,%s,%s,%s,%s)",
+                    (pid, p.get("a",""), p.get("b",""), json.dumps(p.get("meta",{})), datetime.utcnow()))
+    conn.commit()
+    cur.close()
+    conn.close()
+    return jsonify({"status":"ok","inserted":len(pairs)})
+
+@app.route("/task", methods=["GET"])
+def get_task():
+    require_api_key()
+    conn = get_conn()
+    cur = conn.cursor()
+    cur.execute("SELECT id,a,b,meta FROM rater_pairs ORDER BY created_at ASC LIMIT 1")
+    r = cur.fetchone()
+    if not r:
+        cur.close(); conn.close()
+        return jsonify({"status":"empty"}), 204
+    pid,a,b,meta = r
+    # return task (do not delete here; let admin ack)
+    cur.close(); conn.close()
+    return jsonify({"id":pid,"a":a,"b":b,"meta":json.loads(meta)})
+
+@app.route("/vote", methods=["POST"])
+def vote():
+    require_api_key()
+    body = request.json
+    if not body or "pair_id" not in body or "choice" not in body:
+        return jsonify({"error":"pair_id and choice required"}), 400
+    vid = str(uuid.uuid4())
+    conn = get_conn()
+    cur = conn.cursor()
+    cur.execute("INSERT INTO rater_votes (id, pair_id, choice, rater, ts) VALUES (%s,%s,%s,%s,%s)",
+                (vid, body["pair_id"], int(body["choice"]), body.get("rater","unknown"), datetime.utcnow()))
+    conn.commit()
+    cur.close()
+    conn.close()
+    return jsonify({"status":"ok","vote_id":vid})
+
+@app.route("/admin/stats")
+def admin_stats():
+    require_api_key()
+    conn = get_conn()
+    cur = conn.cursor()
+    cur.execute("SELECT COUNT(*) FROM rater_pairs")
+    pairs = cur.fetchone()[0]
+    cur.execute("SELECT COUNT(*) FROM rater_votes")
+    votes = cur.fetchone()[0]
+    cur.close(); conn.close()
+    return jsonify({"pairs": pairs, "votes": votes})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT",8082)))
+
