+#!/usr/bin/env python3
+"""
+Lightweight Attestation Verifier service (TPM quote verification scaffold)
+
+Endpoints:
+ - POST /verify_quote  { "quote": "<base64>", "ak_pub": "<pem or ref>" }
+
+Behaviour:
+ - Verifies signature from AK public key (PEM). This is a scaffold: full TPM quote parsing
+   and PCR policy verification should be implemented by your security team.
+ - Returns allow/block decision and logs evidence.
+"""
+import os, base64, json
+from flask import Flask, request, jsonify
+from cryptography.hazmat.primitives import serialization, hashes
+from cryptography.hazmat.primitives.asymmetric import padding
+
+AK_PUB_PATH = os.environ.get("AK_PUB_PATH", "/secrets/ak_pub.pem")
+EVIDENCE_LOG = os.environ.get("EVIDENCE_LOG", "/tmp/attest_evidence.jsonl")
+
+app = Flask(__name__)
+
+def load_ak_pub(path=AK_PUB_PATH):
+    if not os.path.exists(path):
+        return None
+    data = open(path,"rb").read()
+    return serialization.load_pem_public_key(data)
+
+@app.route("/health")
+def health():
+    return jsonify({"ok": True})
+
+@app.route("/verify_quote", methods=["POST"])
+def verify_quote():
+    body = request.json or {}
+    quote_b64 = body.get("quote")
+    signature_b64 = body.get("signature")
+    ak_pem = body.get("ak_pub")  # optional pem
+    if not quote_b64 or not signature_b64:
+        return jsonify({"error":"quote and signature required"}), 400
+    quote = base64.b64decode(quote_b64)
+    signature = base64.b64decode(signature_b64)
+    ak = None
+    try:
+        if ak_pem:
+            ak = serialization.load_pem_public_key(ak_pem.encode())
+        else:
+            ak = load_ak_pub()
+        if not ak:
+            return jsonify({"error":"AK public key not available"}), 500
+        # perform signature verification (scaffold)
+        ak.verify(signature, quote, padding.PKCS1v15(), hashes.SHA256())
+        res = {"allow": True, "reason": "signature_valid"}
+    except Exception as e:
+        res = {"allow": False, "reason": str(e)}
+    # log evidence
+    open(EVIDENCE_LOG, "a").write(json.dumps({"req": body, "res": res})+"\n")
+    return jsonify(res)
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT",8083)))
+
