+#!/usr/bin/env python3
+"""
+Emergency stop helper - scaffolding
+
+ - In production this should interface with a hardware safety controller / E-stop circuit.
+ - Here we log the event and optionally call a user-supplied actuator script.
+"""
+import sys
+import os
+import json
+from datetime import datetime
+
+ACTUATOR = os.environ.get("AEGIS_EMERGENCY_ACTUATOR", "/usr/local/bin/robot_estop.sh")
+
+def do_estop(reason):
+    print(f"{datetime.utcnow().isoformat()}Z [ESTOP] Triggered: {reason}")
+    # run actuator if present
+    if os.path.exists(ACTUATOR) and os.access(ACTUATOR, os.X_OK):
+        try:
+            import subprocess
+            subprocess.check_call([ACTUATOR, "stop", reason], timeout=10)
+        except Exception as e:
+            print("Actuator call failed:", e)
+    # write evidence
+    ev = {"reason":reason,"ts":datetime.utcnow().isoformat()+"Z"}
+    outp = "/var/lib/aegis/evidence/estop_"+str(int(time.time()))+".json"
+    os.makedirs(os.path.dirname(outp), exist_ok=True)
+    open(outp,"w").write(json.dumps(ev))
+
+if __name__ == "__main__":
+    reason = "manual"
+    if len(sys.argv) > 1:
+        reason = sys.argv[1]
+    do_estop(reason)
+
