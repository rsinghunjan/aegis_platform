+#!/usr/bin/env python3
+"""
+Aegis Edge Agent (robot) - scaffold
+
+Responsibilities:
+ - Periodically poll OTA controller for new signed model packages.
+ - Verify signatures (local .sig.b64 or call KMS verify helper if configured).
+ - Install compiled artifact atomically to model directory.
+ - Launch an RT runner process (placeholder) that executes the model with RT priorities.
+ - Heartbeat and upload provenance/evidence to central Aegis (signed or local retention).
+
+This is a minimal scaffold for integration and must be hardened for production:
+ - Use secure transport (mTLS) to OTA server / S3
+ - Use TPM attestation for firmware/agent integrity
+ - Run RT processes as a real-time scheduled native process (chrt)
+"""
+import os
+import sys
+import time
+import json
+import base64
+import shutil
+import tempfile
+import subprocess
+from pathlib import Path
+from datetime import datetime
+import requests
+
+# Configuration (env or defaults)
+OTA_SERVER = os.environ.get("AEGIS_OTA_URL", "http://ota.aegis-ml.svc.cluster.local:8080")
+MODEL_DIR = Path(os.environ.get("AEGIS_MODEL_DIR", "/opt/aegis/models"))
+WORK_DIR = Path(os.environ.get("AEGIS_WORK_DIR", "/var/lib/aegis"))
+EVIDENCE_DIR = Path(os.environ.get("AEGIS_EVIDENCE_DIR", "/var/lib/aegis/evidence"))
+POLL_INTERVAL = int(os.environ.get("AEGIS_OTA_POLL", "60"))
+VERIFY_HELPER = Path("ops/governance/kms_verify_helper.py")  # optional
+NODE_ID = os.environ.get("AEGIS_NODE_ID", os.uname().nodename)
+
+MODEL_DIR.mkdir(parents=True, exist_ok=True)
+WORK_DIR.mkdir(parents=True, exist_ok=True)
+EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)
+
+def log(msg, level="info"):
+    print(f"{datetime.utcnow().isoformat()}Z [{level}] {msg}", flush=True)
+
+def download_package(package_url, dest_dir):
+    log(f"Downloading package {package_url} -> {dest_dir}")
+    r = requests.get(package_url, stream=True, timeout=30)
+    r.raise_for_status()
+    dest = Path(dest_dir) / os.path.basename(package_url)
+    with open(dest, "wb") as fh:
+        for chunk in r.iter_content(32768):
+            fh.write(chunk)
+    return str(dest)
+
+def verify_signature_local(artifact_path):
+    # Accept .sig.b64 or .sig alongside artifact
+    p = Path(artifact_path)
+    b64sig = str(p) + ".sig.b64"
+    sig = str(p) + ".sig"
+    if Path(b64sig).exists():
+        log("Found local .sig.b64 -> passing local signature check (operator must ensure KMS signed).")
+        return True
+    if Path(sig).exists():
+        log("Found local .sig -> passing local signature check.")
+        return True
+    # Try KMS verify helper if present
+    if VERIFY_HELPER.exists() and shutil.which("python"):
+        try:
+            subprocess.check_call(["python", str(VERIFY_HELPER), "--file", artifact_path], stdout=subprocess.DEVNULL)
+            log("KMS verify helper accepted artifact.")
+            return True
+        except Exception as e:
+            log(f"KMS verify helper failed: {e}", level="warn")
+            return False
+    log("No signature found and no verify helper available -> failing verification", level="error")
+    return False
+
+def atomic_install(artifact_path):
+    # place into MODEL_DIR with a versioned name and symlink 'current'
+    p = Path(artifact_path)
+    versioned = MODEL_DIR / f"{p.stem}-{int(time.time())}{p.suffix}"
+    shutil.copy2(p, versioned)
+    current = MODEL_DIR / "current"
+    if current.exists() or current.is_symlink():
+        current.unlink()
+    current.symlink_to(versioned.name)
+    log(f"Installed model artifact -> {versioned}")
+    return str(versioned)
+
+def start_rt_runner(compiled_artifact_path):
+    """
+    Start an RT runner process that executes the compiled artifact.
+    Placeholder: simulate an RT loop by running a small Python script with chrt if available.
+    In production this should run native process with proper RT scheduler.
+    """
+    runner = WORK_DIR / "rt_runner.sh"
+    runner.write_text(f"""#!/usr/bin/env bash
+# RT runner placeholder - run user's model binary or container
+echo "Starting RT runner for {compiled_artifact_path}"
+while true; do
+  # simulate invoking the model runtime
+  sleep 1
+done
+""")
+    runner.chmod(0o755)
+    # Prefer using chrt if available to set SCHED_FIFO priority
+    if shutil.which("chrt"):
+        proc = subprocess.Popen(["chrt", "-f", "10", str(runner)])
+    else:
+        proc = subprocess.Popen([str(runner)])
+    log(f"Started RT runner pid={proc.pid}")
+    return proc
+
+def heartbeat_upload(evidence):
+    """
+    Upload a small heartbeat evidence JSON to OTA server or central evidence endpoint.
+    If EVIDENCE_BUCKET configured, operator should prefer s3 uploader.
+    """
+    url = OTA_SERVER.rstrip("/") + "/agent/heartbeat"
+    try:
+        r = requests.post(url, json=evidence, timeout=10)
+        if r.status_code == 200:
+            log("Heartbeat accepted by OTA")
+            return True
+        else:
+            log(f"Heartbeat returned {r.status_code}", level="warn")
+            return False
+    except Exception as e:
+        log(f"Heartbeat upload failed: {e}", level="warn")
+        return False
+
+def fetch_latest_package():
+    # Simple protocol: OTA server has endpoint /packages/latest?node=<id>
+    url = f"{OTA_SERVER.rstrip('/')}/packages/latest?node={NODE_ID}"
+    try:
+        r = requests.get(url, timeout=10)
+        if r.status_code == 204:
+            return None
+        r.raise_for_status()
+        return r.json()
+    except Exception as e:
+        log(f"Error fetching latest package: {e}", level="warn")
+        return None
+
+def run_loop():
+    rt_proc = None
+    while True:
+        pkg = fetch_latest_package()
+        if pkg:
+            artifact_url = pkg.get("artifact_url")
+            if artifact_url:
+                try:
+                    local = download_package(artifact_url, WORK_DIR)
+                    if verify_signature_local(local):
+                        installed = atomic_install(local)
+                        # restart RT runner with new artifact
+                        if rt_proc and rt_proc.poll() is None:
+                            log("Stopping previous RT runner")
+                            rt_proc.terminate()
+                            try:
+                                rt_proc.wait(timeout=5)
+                            except Exception:
+                                rt_proc.kill()
+                        rt_proc = start_rt_runner(installed)
+                        # write local provenance and evidence copy
+                        ev = {"node": NODE_ID, "artifact": installed, "ts": datetime.utcnow().isoformat()+"Z", "source": artifact_url}
+                        open(EVIDENCE_DIR / f"installed_{int(time.time())}.json", "w").write(json.dumps(ev))
+                    else:
+                        log("Signature verification failed; not installing package", level="error")
+                except Exception as e:
+                    log(f"Package install failed: {e}", level="error")
+        # heartbeat
+        hb = {"node": NODE_ID, "ts": datetime.utcnow().isoformat()+"Z", "uptime": int(time.time())}
+        heartbeat_upload(hb)
+        time.sleep(POLL_INTERVAL)
+
+if __name__ == "__main__":
+    try:
+        run_loop()
+    except KeyboardInterrupt:
+        log("Edge agent stopping", level="info")
+        sys.exit(0)
+
