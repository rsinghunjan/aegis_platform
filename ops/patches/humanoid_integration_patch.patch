+#!/usr/bin/env python3
+"""
+Runtime Safety Monitor (robot)
+
+ - Loads a small JSON list of invariants (ops/robot/safety/invariants.json) with
+   simple conditions to check against telemetry inputs.
+ - When an invariant fails, triggers emergency stop via emergency_stop.py and writes evidence.
+ - This is a minimal scaffold. Replace with domain-specific monitors or embed inside the control loop.
+"""
+import os
+import json
+import time
+from datetime import datetime
+from pathlib import Path
+import importlib.util
+
+INV_PATH = Path("ops/robot/safety/invariants.json")
+EVIDENCE_DIR = Path(os.environ.get("AEGIS_EVIDENCE_DIR","/var/lib/aegis/evidence"))
+EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)
+
+def load_invariants():
+    if INV_PATH.exists():
+        return json.loads(open(INV_PATH).read())
+    # Example invariant: "obstacle_distance > min_stop_distance"
+    return [
+        {"id":"obstacle_stop","desc":"stop if obstacle closer than min distance","type":"threshold","sensor":"obstacle_distance","op":"<","value":0.5}
+    ]
+
+def check_invariant(inv, telemetry):
+    stype = inv.get("type")
+    if stype == "threshold":
+        sensor = inv.get("sensor")
+        op = inv.get("op")
+        v = inv.get("value")
+        val = telemetry.get(sensor)
+        if val is None:
+            return True, "no-data"  # cannot assert
+        if op == "<":
+            ok = not (val < v)
+        elif op == ">":
+            ok = not (val > v)
+        else:
+            ok = True
+        return ok, f"{sensor}={val}"
+    return True, "unknown-inv-type"
+
+def trigger_emergency(inv, telemetry):
+    # call emergency stop helper
+    try:
+        import subprocess
+        subprocess.check_call(["python","ops/robot/safety/emergency_stop.py","--reason",inv.get("id")])
+    except Exception as e:
+        print("Failed to call emergency stop:", e)
+    # write evidence
+    ev = {"invariant":inv,"telemetry":telemetry,"ts":datetime.utcnow().isoformat()+"Z"}
+    open(EVIDENCE_DIR / f"invariant_violation_{int(time.time())}.json","w").write(json.dumps(ev))
+
+def run_monitor():
+    invariants = load_invariants()
+    # telemetry source is left as a stub: in production, subscribe to local bus
+    while True:
+        # stub telemetry
+        telemetry = {"obstacle_distance": 0.4, "speed": 0.2}
+        for inv in invariants:
+            ok,info = check_invariant(inv, telemetry)
+            if not ok:
+                print("Invariant failed:", inv["id"], info)
+                trigger_emergency(inv, telemetry)
+        time.sleep(0.5)
+
+if __name__ == "__main__":
+    run_monitor()
+
