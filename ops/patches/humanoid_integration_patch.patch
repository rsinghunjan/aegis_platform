+#!/usr/bin/env python3
+"""
+Very small helper to verify signatures for artifacts on robot edge.
+
+Behavior:
+ - If a .sig.b64 file exists alongside the artifact, decode and (optionally) call KMS verify helper.
+ - If ops/governance/kms_verify_helper.py exists, delegate to it.
+ - Otherwise, fall back to presence check only (operator must ensure signing policy).
+"""
+import sys
+import os
+import base64
+import subprocess
+
+KMS_VERIFY = "ops/governance/kms_verify_helper.py"
+
+def verify(artifact):
+    if os.path.exists(artifact + ".sig.b64"):
+        print("Found .sig.b64: accepting (local policy)")
+        return 0
+    if os.path.exists(artifact + ".sig"):
+        print("Found .sig: accepting (local policy)")
+        return 0
+    if os.path.exists(KMS_VERIFY):
+        try:
+            subprocess.check_call(["python", KMS_VERIFY, "--file", artifact])
+            print("KMS verify helper accepted")
+            return 0
+        except Exception as e:
+            print("KMS verify helper failed", e)
+            return 2
+    print("No signature or verify helper found")
+    return 2
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        print("Usage: verify_signature.py <artifact>")
+        sys.exit(2)
+    sys.exit(verify(sys.argv[1]))
+
