+fi
+
+echo
+echo "13) Trigger security scan workflow (if gh CLI available)"
+if command -v gh >/dev/null 2>&1; then
+  "${SCRIPTS_DIR}/trigger_security_scan.sh" || echo "Security scan dispatch failed (inspect GH CLI permissions)"
+else
+  echo "gh CLI not found; skipping security workflow trigger. Run .github/workflows/security_scan.yml manually in Actions."
+fi
+
+echo
+echo "14) Rehearse MTTR drill (transaction rollback test)"
+python -m pip install requests || true
+python services/agent/mttr_drill.py || echo "MTTR drill execution returned non-zero; check transaction manager and rollback behavior"
+
+echo
+echo "Integration readiness orchestration complete. Review warnings and fix any issues highlighted above before declaring staging integration-ready."
+
