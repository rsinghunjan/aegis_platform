+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Check tenant quotas by querying the model registry for counts and comparing to ops/config/tenants.json
+# This is reporting only; enforcement should be implemented in admission/webhook paths.
+#
+REG_URL=${MODEL_REGISTRY_URL:-http://aegis-model-registry.monitoring.svc:8081}
+TENANTS_CONF=${TENANTS_CONFIG:-ops/config/tenants.json}
+
+if [ ! -f "${TENANTS_CONF}" ]; then
+  echo "Tenants config not found: ${TENANTS_CONF}"
+  exit 1
+fi
+
+echo "Loading tenants config from ${TENANTS_CONF}"
+jq . "${TENANTS_CONF}" > /dev/null
+
+for t in $(jq -r 'keys[]' "${TENANTS_CONF}"); do
+  max_models=$(jq -r ".\"${t}\".quotas.max_models" "${TENANTS_CONF}")
+  echo "Checking tenant ${t} (max_models=${max_models})"
+  # count models with tenant tag (registry must support tenant field on models; if not, this is a warning)
+  count=$(curl -s "${REG_URL}/models" | jq -r --arg tenant "$t" '.models | map(select(.metadata? | tostring | contains($tenant))) | length' 2>/dev/null || echo "0")
+  # if registry doesn't store tenant metadata this check will be heuristic
+  echo "  reported model count (heuristic): ${count}"
+  if [ "${count}" -gt "${max_models}" ]; then
+    echo "  WARNING: tenant ${t} appears to exceed model quota (${count} > ${max_models})"
+  fi
+done
+
+echo "Tenant quota check complete (reporting only). To enforce quotas implement an admission webhook or registry-side enforcement."
+
