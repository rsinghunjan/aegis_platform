+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Integration readiness orchestrator
+# Runs the main provisioning, deployment, verification and preflight checks required to validate
+# integration readiness in staging. This script calls other helper scripts in the repo and
+# fails fast on critical errors so CI can gate merges/releases.
+#
+# Usage:
+#   export EVIDENCE_BUCKET=... MODEL_STORE_PREFIX=s3://... AWS_REGION=... \
+#     ELECTRICITYMAP_API_KEY=... KEYCLOAK_CLIENT_SECRET=... KEYCLOAK_URL=... \
+#     ./ops/scripts/integration_readiness_check.sh
+
+ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
+SCRIPTS_DIR="${ROOT_DIR}/ops/scripts"
+
+echo "=== Integration readiness check started ==="
+
+echo
+echo "1) Ensure required environment variables"
+: "${EVIDENCE_BUCKET:?EVIDENCE_BUCKET must be set (S3 bucket for evidence)}"
+: "${MODEL_STORE_PREFIX:?MODEL_STORE_PREFIX must be set (model store prefix e.g. s3://bucket/path)}"
+echo "EVIDENCE_BUCKET=${EVIDENCE_BUCKET}"
+echo "MODEL_STORE_PREFIX=${MODEL_STORE_PREFIX}"
+
+echo
+echo "2) Create k8s secrets (Keycloak, carbon keys, evidence bucket, model store)"
+if [ -x "${SCRIPTS_DIR}/create_prod_secrets.sh" ]; then
+  "${SCRIPTS_DIR}/create_prod_secrets.sh"
+else
+  echo "Missing ${SCRIPTS_DIR}/create_prod_secrets.sh"
+  exit 2
+fi
+
+echo
+echo "3) Ensure evidence S3 bucket exists and has Object Lock when possible"
+if command -v aws >/dev/null 2>&1 && [ -n "${AWS_REGION:-}" ]; then
+  "${SCRIPTS_DIR}/create_evidence_bucket_with_object_lock.sh" || echo "create_evidence_bucket... returned non-zero; verify bucket manually"
+else
+  echo "Skipping bucket creation: aws CLI or AWS_REGION not set. Ensure bucket exists and was created with object lock."
+fi
+
+echo
+echo "4) Bootstrap staging (Postgres + registry + carbon/autonomy stack)"
+if [ -x "${SCRIPTS_DIR}/setup_staging.sh" ]; then
+  "${SCRIPTS_DIR}/setup_staging.sh"
+else
+  echo "Missing setup_staging.sh"
+  exit 3
+fi
+
+echo
+echo "5) Deploy & verify stack, probe Prometheus & auto-tune PromQL"
+if [ -x "${SCRIPTS_DIR}/deploy_and_verify_stack.sh" ]; then
+  "${SCRIPTS_DIR}/deploy_and_verify_stack.sh"
+else
+  echo "Missing deploy_and_verify_stack.sh"
+  exit 4
+fi
+
+echo "Running interactive PromQL tuning helper (auto suggestions). If running non-interactive, pass SKIP_PROMQL=1"
+if [ "${SKIP_PROMQL:-0}" = "1" ]; then
+  echo "SKIP_PROMQL set; skipping interactive tuning"
+else
+  if [ -x "${SCRIPTS_DIR}/tune_promql_apply.sh" ]; then
+    "${SCRIPTS_DIR}/tune_promql_apply.sh" || echo "PromQL tuning helper completed; please review suggestions."
+  else
+    echo "Missing tune_promql_apply.sh; manually run promql_probe and adjust templates."
+  fi
+fi
+
+echo
+echo "6) Prometheus label/metric checks: ensure DCGM metrics and job/model labels exist"
+if command -v python >/dev/null 2>&1; then
+  python "${ROOT_DIR}/ops/scripts/check_prometheus_labels.py" || echo "Prometheus label check returned non-zero; inspect Prometheus and relabel rules"
+else
+  echo "Python not available; skipping Prometheus label checks"
+fi
+
+echo
+echo "7) Run wrapper audit, wrapper audit checker and acceptance dry-run"
+if [ -x "${SCRIPTS_DIR}/run_wrapper_audit_and_dryrun.sh" ]; then
+  "${SCRIPTS_DIR}/run_wrapper_audit_and_dryrun.sh" || { echo "Wrapper audit/dry-run had non-zero exit; inspect artifacts and fix wrappers"; exit 6; }
+else
+  echo "Missing run_wrapper_audit_and_dryrun.sh"
+  exit 5
+fi
+
+echo
+echo "8) Start long-shadow campaign & supervisor"
+if [ -x "${SCRIPTS_DIR}/run_long_shadow_campaign.sh" ]; then
+  "${SCRIPTS_DIR}/run_long_shadow_campaign.sh" || echo "Long-shadow start attempted; verify long-shadow deployment & supervisor in 'monitoring' ns"
+else
+  echo "Missing run_long_shadow_campaign.sh"
+fi
+
+echo
+echo "9) Verify S3 object lock & evidence writeability"
+if [ -x "${SCRIPTS_DIR}/check_s3_object_lock.sh" ]; then
+  "${SCRIPTS_DIR}/check_s3_object_lock.sh" || echo "S3 object-lock check failed or requires manual verification"
+else
+  echo "Missing check_s3_object_lock.sh"
+fi
+
+echo
