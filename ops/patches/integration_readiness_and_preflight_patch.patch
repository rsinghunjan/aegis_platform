+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Patch the registry deployment to inject Keycloak env vars and then smoke-test the registry authentication.
+# Requires keycloak-credentials secret to be present.
+#
+NAMESPACE=${NAMESPACE:-monitoring}
+DEPLOYMENT=${DEPLOYMENT:-aegis-model-registry}
+
+echo "Patching deployment ${DEPLOYMENT} in namespace ${NAMESPACE} to include Keycloak environment variables (best-effort)..."
+kubectl patch deployment "${DEPLOYMENT}" -n "${NAMESPACE}" --patch "$(cat <<'YAML'
+spec:
+  template:
+    spec:
+      containers:
+        - name: registry
+          env:
+            - name: KEYCLOAK_URL
+              valueFrom:
+                secretKeyRef:
+                  name: keycloak-credentials
+                  key: KEYCLOAK_URL
+            - name: KEYCLOAK_REALM
+              valueFrom:
+                secretKeyRef:
+                  name: keycloak-credentials
+                  key: KEYCLOAK_REALM
+            - name: KEYCLOAK_CLIENT_ID
+              valueFrom:
+                secretKeyRef:
+                  name: keycloak-credentials
+                  key: KEYCLOAK_CLIENT_ID
+YAML
+)" || echo "Patch may have failed; verify keycloak-credentials secret and deployment name."
+
+echo "Waiting for registry rollout..."
+kubectl -n "${NAMESPACE}" rollout status deployment/"${DEPLOYMENT}" --timeout=120s || echo "rollout status returned non-zero"
+
+# Smoke test: unauthenticated request should get 401 when Keycloak properly enforced
+REG_URL=${MODEL_REGISTRY_URL:-http://${DEPLOYMENT}.${NAMESPACE}.svc.cluster.local:8081}
+echo "Smoke testing registry auth at ${REG_URL}/models"
+code=$(curl -s -o /dev/null -w "%{http_code}" "${REG_URL}/models" || true)
+echo "HTTP status code from registry /models: ${code}"
+if [ "${code}" = "401" ] || [ "${code}" = "403" ]; then
+  echo "Registry appears to be enforcing auth (status ${code})."
+else
+  echo "Registry did not return 401/403 for unauthenticated request; verify registry integration with Keycloak or token provisioning."
+fi
+
