+#!/usr/bin/env python3
+"""
+Check Prometheus for DCGM metrics and whether series have job_id and model_name labels.
+Exits 0 if basic checks pass, non-zero otherwise.
+"""
+import os, sys, requests
+
+PROM = os.environ.get("PROM_HOST", "http://prometheus.monitoring.svc:9090")
+TIMEOUT = 15
+
+def get_metric_names():
+    url = f"{PROM}/api/v1/label/__name__/values"
+    r = requests.get(url, timeout=TIMEOUT)
+    r.raise_for_status()
+    return r.json().get("data", [])
+
+def sample_series(metric):
+    # query for last 5m sample
+    q = f'{metric}[5m]'
+    url = f"{PROM}/api/v1/query"
+    r = requests.get(url, params={"query": q}, timeout=TIMEOUT)
+    r.raise_for_status()
+    j = r.json()
+    return j.get("data", {}).get("result", [])
+
+def main():
+    names = get_metric_names()
+    dcgm_like = [n for n in names if n.startswith("dcgm") or n.startswith("dcgm_nvml") or n.startswith("nvidia")]
+    if not dcgm_like:
+        print("No DCGM-like metrics found in Prometheus. Ensure dcgm-exporter is running and scrape config applied.")
+        sys.exit(2)
+    print(f"Found DCGM-like metrics sample (count={len(dcgm_like)}): {dcgm_like[:10]}")
+    # pick up to 3 metrics to sample
+    issues = 0
+    for m in dcgm_like[:3]:
+        print("Checking metric:", m)
+        series = sample_series(m)
+        if not series:
+            print("  No series returned for metric (maybe no GPUs active in timeframe).")
+            continue
+        # check if any series contain job_id or model_name labels
+        has_job = any("job_id" in s.get("metric", {}) for s in series)
+        has_model = any("model_name" in s.get("metric", {}) for s in series)
+        print(f"  has_job_id={has_job}, has_model_name={has_model}")
+        if not (has_job and has_model):
+            print("  WARNING: Series for metric lack job_id/model_name labels; ensure pods/jobs are labeled and relabel rules map annotations->labels.")
+            issues += 1
+    if issues:
+        print(f"Prometheus label checks found {issues} issues. Fix relabeling and job/pod labeling.")
+        sys.exit(3)
+    print("Prometheus label checks passed.")
+    sys.exit(0)
+
+if __name__ == "__main__":
+    main()
+
