+#!/usr/bin/env python3
+"""
+Langflow run webhook — receives flow run metadata and outputs, signs and uploads evidence, and indexes it.
+This service should be deployed inside cluster and only accept traffic from Langflow service (via NetworkPolicy).
+
+Expected POST payload (JSON):
+  {
+    "flow_id": "...",
+    "run_id": "...",
+    "user": "...",
+    "model": "...",
+    "inputs": {...},
+    "outputs": {...},
+    "meta": {...}
+  }
+
+Environment expected:
+  EVIDENCE_BUCKET - S3 bucket to store evidence
+  AWS_REGION - region for boto3/KMS (if using AWS)
+  AWS_KMS_KEY_ID - key id for signing (optional)
+  EVIDENCE_SIGN_BACKEND - if set, attempt KMS signing
+  INDEX_DB_PATH - sqlite path to index DB (default /tmp/evidence_index.db)
+"""
+import os
+import json
+import sqlite3
+import tempfile
+import subprocess
+from flask import Flask, request, jsonify
+from datetime import datetime
+
+app = Flask(__name__)
+INDEX_DB = os.environ.get("INDEX_DB_PATH", "/tmp/evidence_index.db")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+AWS_KMS_KEY_ID = os.environ.get("AWS_KMS_KEY_ID", "")
+
+def ensure_db():
+    conn = sqlite3.connect(INDEX_DB)
+    c = conn.cursor()
+    c.execute("""CREATE TABLE IF NOT EXISTS evidence (id TEXT PRIMARY KEY, flow_id TEXT, run_id TEXT, user TEXT, model TEXT, s3_key TEXT, signed INTEGER, ts TEXT)""")
+    conn.commit()
+    conn.close()
+
+def sign_and_upload(path_local):
+    # Attempt KMS sign via helper; then upload using s3_retention_uploader
+    sig_path = None
+    if os.environ.get("EVIDENCE_SIGN_BACKEND") and AWS_KMS_KEY_ID:
+        try:
+            subprocess.check_call(["python", "ops/governance/kms_sign_helper.py", "--file", path_local, "--key-id", AWS_KMS_KEY_ID])
+            sig_path = path_local + ".sig"
+        except Exception as e:
+            app.logger.exception("KMS sign failed: %s", e)
+    # upload via s3_retention_uploader if bucket configured
+    if EVIDENCE_BUCKET:
+        try:
+            subprocess.check_call(["python","ops/evidence/s3_retention_uploader.py","--pattern", path_local, "--bucket", EVIDENCE_BUCKET])
+            if sig_path:
+                subprocess.check_call(["python","ops/evidence/s3_retention_uploader.py","--pattern", sig_path, "--bucket", EVIDENCE_BUCKET])
+        except Exception as e:
+            app.logger.exception("S3 upload failed: %s", e)
+    return sig_path
+
+def index_record(rec):
+    conn = sqlite3.connect(INDEX_DB)
+    c = conn.cursor()
+    c.execute("INSERT OR REPLACE INTO evidence (id, flow_id, run_id, user, model, s3_key, signed, ts) VALUES (?,?,?,?,?,?,?,?)",
+              (rec["id"], rec["flow_id"], rec["run_id"], rec["user"], rec.get("model",""), rec.get("s3_key",""), 1 if rec.get("signed") else 0, rec.get("ts")))
+    conn.commit()
+    conn.close()
+
+@app.route("/runs", methods=["POST"])
+def run_hook():
+    payload = request.get_json(force=True)
+    if not payload:
+        return jsonify({"error":"missing payload"}), 400
+    # produce evidence file
+    tid = f"{payload.get('flow_id')}-{payload.get('run_id')}-{int(datetime.utcnow().timestamp())}"
+    tmp = tempfile.mkdtemp(prefix="langflow_evidence_")
+    path = os.path.join(tmp, f"{tid}.json")
+    with open(path, "w") as fh:
+        json.dump(payload, fh, indent=2)
+    # sign and upload
+    sig = sign_and_upload(path)
+    rec = {"id": tid, "flow_id": payload.get("flow_id"), "run_id": payload.get("run_id"), "user": payload.get("user"), "model": payload.get("model"), "s3_key": "", "signed": bool(sig), "ts": datetime.utcnow().isoformat()+"Z"}
+    index_record(rec)
+    return jsonify({"status":"ok","evidence_id":tid, "signed": bool(sig)})
+
+if __name__ == "__main__":
+    ensure_db()
+    app.run(host="0.0.0.0", port=8081)
+
