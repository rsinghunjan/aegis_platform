+#!/usr/bin/env python3
+"""
+Enhanced chargeback integration for large distributed HPO runs.
+ - Aggregates estimated cost per trial, records submissions in a submission DB, and posts to the chargeback API.
+ - Provides a utility to reconcile realized cost after invoices arrive.
+"""
+import os, json, sqlite3, logging, requests
+from datetime import datetime
+
+logger = logging.getLogger("hpo-chargeback-int")
+logging.basicConfig(level=logging.INFO)
+
+DB = os.environ.get("HPO_CHARGEDB", "/tmp/hpo_charge.db")
+CHARGEBACK_API = os.environ.get("CHARGEBACK_API", "http://chargeback.monitoring.svc:8080")
+
+def init():
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("""CREATE TABLE IF NOT EXISTS submissions (
+        id INTEGER PRIMARY KEY AUTOINCREMENT, team TEXT, run_id TEXT, est_usd REAL, actual_usd REAL, created_at TEXT)""")
+    conn.commit()
+    conn.close()
+
+def record_submission(team, run_id, est_usd):
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("INSERT INTO submissions(team, run_id, est_usd, actual_usd, created_at) VALUES (?,?,?,?,?)",
+              (team, run_id, est_usd, None, datetime.utcnow().isoformat()))
+    conn.commit()
+    conn.close()
+    try:
+        requests.post(f"{CHARGEBACK_API}/submit", json={"team":team,"run_id":run_id,"estimated_usd":est_usd}, timeout=5)
+    except Exception:
+        logger.exception("Failed to notify chargeback API")
+
+def reconcile_run(run_id, actual_usd):
+    conn = sqlite3.connect(DB)
+    c = conn.cursor()
+    c.execute("UPDATE submissions SET actual_usd = ? WHERE run_id = ?", (actual_usd, run_id))
+    conn.commit()
+    conn.close()
+    try:
+        requests.post(f"{CHARGEBACK_API}/reconcile", json={"run_id":run_id,"actual_usd":actual_usd}, timeout=5)
+    except Exception:
+        logger.exception("Failed to notify chargeback reconcile")
+
+if __name__ == "__main__":
+    init()
+    print("HPO chargeback DB initialized")
+
