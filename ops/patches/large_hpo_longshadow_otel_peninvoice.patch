+#!/usr/bin/env python3
+"""
+Script to trigger many distributed HPO PipelineRuns (useful for stress testing large HPO).
+Records submissions and waits for completion. Uploads aggregated evidence when done.
+"""
+import os, time, json, tempfile, subprocess, logging
+from datetime import datetime
+
+logger = logging.getLogger("run-large-hpo")
+logging.basicConfig(level=logging.INFO)
+
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+SLEEP = int(os.environ.get("POLL_INTERVAL", "30"))
+
+def create_pipeline_run(samples, team, evidence_bucket):
+    pr = {
+        "apiVersion": "tekton.dev/v1beta1",
+        "kind": "PipelineRun",
+        "metadata": {"generateName": "large-hpo-run-"},
+        "spec": {
+            "pipelineRef": {"name": "large-hpo-pipeline"},
+            "params": [
+                {"name": "samples", "value": str(samples)},
+                {"name": "team", "value": team},
+                {"name": "evidence_bucket", "value": evidence_bucket}
+            ]
+        }
+    }
+    import yaml, tempfile
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.safe_dump(pr).encode()); f.close()
+    out = subprocess.check_output(["kubectl", "apply", "-n", TEKTON_NS, "-f", f.name]).decode()
+    logger.info("Created PipelineRun: %s", out)
+    # parse name
+    for line in out.splitlines():
+        if "pipelinerun.tekton.dev/" in line:
+            return line.split()[0].split("/")[1]
+    return None
+
+def wait_for_pr(pr_name, timeout=7200):
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            out = subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","pipelinerun", pr_name, "-o", "json"])
+            st = json.loads(out).get("status", {})
+            conds = st.get("conditions", [])
+            if conds:
+                s = conds[0].get("status")
+                if s == "True":
+                    return True, st
+                if s == "False":
+                    return False, st
+        except Exception:
+            pass
+        time.sleep(SLEEP)
+    return False, {}
+
+def collect_and_upload(pr_name):
+    local = tempfile.mkdtemp(prefix=f"evidence-{pr_name}-")
+    try:
+        subprocess.check_call(["kubectl","-n",TEKTON_NS,"get","pipelinerun",pr_name,"-o","json"], stdout=open(f"{local}/pipelinerun.json","w"))
+    except Exception:
+        pass
+    try:
+        pods = json.loads(subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","pods","-o","json"]).decode()).get("items", [])
+        for p in pods:
+            owners = p.get("metadata",{}).get("ownerReferences",[])
+            if any(o.get("name","").startswith(pr_name) for o in owners):
+                name = p["metadata"]["name"]
+                try:
+                    logs = subprocess.check_output(["kubectl","-n",TEKTON_NS,"logs",name], stderr=subprocess.STDOUT).decode()
+                except Exception as e:
+                    logs = f"error: {e}"
+                open(f"{local}/{name}.log","w").write(logs)
+    except Exception:
+        pass
+    if EVIDENCE_BUCKET:
+        import boto3, os
+        s3=boto3.client("s3")
+        bucket=EVIDENCE_BUCKET.replace("s3://","")
+        for root, _, files in os.walk(local):
+            for f in files:
+                s3.upload_file(os.path.join(root,f), bucket, f"large_hpo/{pr_name}/{f}")
+        return f"s3://{bucket}/large_hpo/{pr_name}/"
+    return local
+
+def main():
+    samples = int(os.environ.get("HPO_SAMPLES","128"))
+    parallel = int(os.environ.get("HPO_PARALLEL","4"))
+    team = os.environ.get("HPO_TEAM","team-a")
+    evidence = EVIDENCE_BUCKET
+    prs=[]
+    for i in range(parallel):
+        pr = create_pipeline_run(samples, team, evidence)
+        if pr:
+            prs.append(pr)
+    results=[]
+    for pr in prs:
+        ok, st = wait_for_pr(pr)
+        uri = collect_and_upload(pr)
+        results.append({"pr": pr, "ok": ok, "evidence": uri, "status": st})
+    print(json.dumps(results, indent=2))
+
+if __name__ == "__main__":
+    main()
+
