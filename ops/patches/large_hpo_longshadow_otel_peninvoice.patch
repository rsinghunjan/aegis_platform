+#!/usr/bin/env python3
+"""
+Simple FastAPI UI + API for tenant cap enforcement and adjustments.
+ - Lists tenants, current spend, cap and allows admins to adjust cap (calls chargeback API)
+ - Provides endpoint used by submission path to check tenant cap before accepting jobs
+"""
+from fastapi import FastAPI, HTTPException, Request, Form
+from fastapi.responses import HTMLResponse
+import os, requests, json, logging
+
+app = FastAPI()
+logger = logging.getLogger("tenant-cap-ui")
+logging.basicConfig(level=logging.INFO)
+
+CHARGEBACK_API = os.environ.get("CHARGEBACK_API", "http://chargeback.monitoring.svc:8080")
+
+@app.get("/", response_class=HTMLResponse)
+def index():
+    try:
+        r = requests.get(f"{CHARGEBACK_API}/tenants", timeout=5)
+        tenants = r.json()
+    except Exception:
+        tenants = []
+    html = "<h1>Tenant Caps</h1><table><tr><th>tenant</th><th>spend</th><th>cap</th><th>action</th></tr>"
+    for t in tenants:
+        html += f"<tr><td>{t['tenant']}</td><td>{t.get('spend',0)}</td><td>{t.get('cap', 'N/A')}</td><td><form method='post' action='/adjust'><input type='hidden' name='tenant' value='{t['tenant']}'><input name='cap' placeholder='new cap'><button type='submit'>Adjust</button></form></td></tr>"
+    html += "</table>"
+    return HTMLResponse(html)
+
+@app.post("/adjust")
+def adjust(tenant: str = Form(...), cap: float = Form(...)):
+    try:
+        r = requests.post(f"{CHARGEBACK_API}/adjust_cap", json={"tenant": tenant, "new_cap": cap}, timeout=5)
+        r.raise_for_status()
+    except Exception:
+        raise HTTPException(status_code=500, detail="Failed to adjust cap")
+    return {"ok": True}
+
+@app.get("/check/{tenant}")
+def check(tenant: str):
+    try:
+        r = requests.get(f"{CHARGEBACK_API}/tenant/{tenant}/spend", timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        raise HTTPException(status_code=500, detail="Failed to query chargeback API")
+
