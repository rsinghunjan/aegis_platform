+#!/usr/bin/env python3
+"""
+Index explainability manifests, verify ACLs, and attach manifests to promotion evidence bundles.
+"""
+import os, argparse, json, logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log=logging.getLogger("explain-attach")
+
+def list_runs(evidence, prefix="closedloop/"):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix=prefix, Delimiter="/", MaxKeys=1000)
+    return [p.get("Prefix") for p in resp.get("CommonPrefixes",[])]
+
+def check_and_attach(evidence, run_prefix):
+    import boto3, io
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    explain_key = run_prefix + "explainability/manifest.json"
+    acl_key = run_prefix + "explainability/acl.json"
+    exists = False
+    try:
+        s3.head_object(Bucket=bucket, Key=explain_key)
+        exists = True
+    except Exception:
+        return {"run": run_prefix, "explain_present": False}
+    # check ACL
+    acl_present = True
+    try:
+        s3.head_object(Bucket=bucket, Key=acl_key)
+    except Exception:
+        acl_present = False
+    # attach manifest to evidence bundle record (write an attachment marker)
+    attach_key = run_prefix + "promotion/attached_explain_manifest.json"
+    payload = {"attached_at": datetime.utcnow().isoformat(), "explain_key": explain_key, "acl_present": acl_present}
+    s3.put_object(Bucket=bucket, Key=attach_key, Body=json.dumps(payload).encode())
+    return {"run": run_prefix, "explain_present": True, "acl_present": acl_present, "attached": attach_key}
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True)
+    args=p.parse_args()
+    runs = list_runs(args.evidence)
+    report=[]
+    for run in runs[:200]:
+        r = check_and_attach(args.evidence, run)
+        report.append(r)
+    out="/tmp/explain_attach_"+str(int(time.time()))+".json"
+    open(out,"w").write(json.dumps(report, indent=2))
+    if args.evidence:
+        import boto3
+        s3=boto3.client("s3")
+        s3.upload_file(out, args.evidence.replace("s3://",""), f"explainability/attach-report-{int(time.time())}.json")
+    print(json.dumps(report))
+
+if __name__ == "__main__":
+    main()
+
