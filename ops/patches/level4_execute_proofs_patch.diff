+#!/usr/bin/env python3
+"""
+Level‑4 Proofs Executor
+Runs the full production proofs sequence and enforces measurable acceptance criteria.
+This script orchestrates:
+  - Distributed HPO submission & checkpoint success analysis (>= CHECKPOINT_THRESHOLD)
+  - Accelerated 30-day long-shadow + 2k dry runs, evidence bundling + cosign signature
+  - OTEL span coverage check (>= OTEL_THRESHOLD) and upload of trace->evidence manifests
+  - OPA corpus harness and mismatch enforcement (<= OPA_MISMATCH_THRESHOLD)
+  - Auto-promote controller exercise + verification of signed/audited promotions
+  - Remediation tests and success rate enforcement (>= REMEDIATION_THRESHOLD)
+  - Pen-test recheck and Terraform least-privilege plan (manual gated apply)
+  - Gatekeeper controlled promotion (deny) and validating webhook verification
+  - Multi-tenant stress + chargeback validation and tuning
+  - Explainability manifest indexing, ACL checks and attachment to promotion evidence
+  - Long-term SLO collection and cosign-signed audit artifact upload
+
+Usage:
+  export EVIDENCE_BUCKET=s3://your-evidence-bucket
+  python3 ops/production/level4_proofs_executor.py
+"""
+import os, sys, json, time, logging, subprocess
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("level4-executor")
+
+# thresholds configurable via env
+CHECKPOINT_THRESHOLD = float(os.environ.get("CHECKPOINT_THRESHOLD", "0.90"))
+OTEL_THRESHOLD = float(os.environ.get("OTEL_THRESHOLD", "0.90"))
+OPA_MISMATCH_THRESHOLD = float(os.environ.get("OPA_MISMATCH_THRESHOLD", "0.01"))
+REMEDIATION_THRESHOLD = float(os.environ.get("REMEDIATION_THRESHOLD", "0.90"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def run(cmd, capture=False, env=None, check=True):
+    log.info("RUN: %s", " ".join(cmd))
+    try:
+        if capture:
+            return subprocess.check_output(cmd, env=env).decode()
+        else:
+            subprocess.check_call(cmd, env=env)
+            return ""
+    except subprocess.CalledProcessError:
+        log.exception("Command failed: %s", cmd)
+        if check:
+            raise
+        return ""
+
+def step_hpo_and_checkpoints():
+    # Submit/monitor HPO (this module submits Ray jobs and writes submission manifest then runs checkpoint analysis)
+    run(["python3", "services/hpo/hpo_run_and_monitor.py",
+         "--total", os.environ.get("HPO_TOTAL_TRIALS", "256"),
+         "--per-job", os.environ.get("HPO_TRIALS_PER_JOB", "8"),
+         "--checkpoint", os.environ.get("CHECKPOINT_S3", "s3://aegis-checkpoints"),
+         "--evidence", EVIDENCE_BUCKET], check=True)
+    # Analyze checkpoint success rate
+    out = run(["python3", "services/hpo/checkpoint_analyzer.py", "--evidence", EVIDENCE_BUCKET, "--threshold", str(CHECKPOINT_THRESHOLD)], capture=True, check=True)
+    return True, json.loads(out) if out else {}
+
+def step_longshadow_and_2k():
+    run(["python3", "ops/validation/longshadow_accelerated_full.py", "--hours", os.environ.get("LONG_SHADOW_HOURS","720"), "--evidence", EVIDENCE_BUCKET], check=True)
+    run(["python3", "services/simulator/sim_2k_runner.py", "--runs", "2000", "--evidence", EVIDENCE_BUCKET], check=True)
+    # Bundling & cosign handled later; postmortems created by scripts above
+    return True, {"note":"long-shadow and 2k executed"}
+
+def step_otel_coverage_and_link():
