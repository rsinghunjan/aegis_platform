+#!/usr/bin/env python3
+"""
+Analyze HPO checkpoint artifacts in the evidence bucket and compute checkpoint success rate across trials.
+Exits non-zero if success rate < threshold.
+"""
+import os, argparse, json, logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("checkpoint-analyzer")
+
+def list_keys_s3(bucket, prefix):
+    import boto3
+    s3=boto3.client("s3")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix=prefix, MaxKeys=10000)
+    return [o["Key"] for o in resp.get("Contents",[])]
+
+def load_json_s3(bucket, key):
+    import boto3
+    s3=boto3.client("s3")
+    obj=s3.get_object(Bucket=bucket, Key=key)
+    return json.loads(obj["Body"].read().decode())
+
+def analyze(evidence_s3, prefix="checkpoints/"):
+    if evidence_s3.startswith("s3://"):
+        bucket=evidence_s3.replace("s3://","")
+    else:
+        raise RuntimeError("evidence must be s3 URI")
+    keys = list_keys_s3(bucket, prefix)
+    trials = []
+    for k in keys:
+        if k.endswith(".json"):
+            try:
+                j = load_json_s3(bucket, k)
+                # expected fields: trial_id, checkpoint_present: true/false
+                trials.append(1 if j.get("checkpoint_present", False) else 0)
+            except Exception:
+                log.exception("failed load %s", k)
+    total = len(trials)
+    success = sum(trials)
+    rate = success/total if total else 0.0
+    return {"total_trials": total, "successful": success, "success_rate": rate}
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True)
+    p.add_argument("--prefix", default="checkpoints/")
+    p.add_argument("--threshold", type=float, default=float(os.environ.get("CHECKPOINT_THRESHOLD","0.90")))
+    args=p.parse_args()
+    report=analyze(args.evidence, args.prefix)
+    print(json.dumps(report))
+    if report["success_rate"] < args.threshold:
+        log.error("Checkpoint success rate %.3f below threshold %.3f", report["success_rate"], args.threshold)
+        raise SystemExit(2)
+    log.info("Checkpoint success rate OK: %.3f", report["success_rate"])
+
+if __name__ == "__main__":
+    main()
+
