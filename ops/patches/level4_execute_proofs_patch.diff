+def step_bundle_and_cosign():
+    # Create evidence bundle and cosign it
+    run(["python3", "services/evidence/evidence_bundler_sign.py", "--out-dir", "/tmp/evidence_bundle", "--evidence", EVIDENCE_BUCKET], check=True)
+    run(["bash", "ops/scripts/cosign_sign_evidence_bundle.sh"], check=False)
