+        ("Long-shadow + 2k sim", step_longshadow_and_2k),
+        ("OTEL coverage & trace->evidence", step_otel_coverage_and_link),
+        ("OPA harness & auto-promote", step_opa_and_autopromote),
+        ("Remediation validation", step_remediation_validate),
+        ("Pen-test recheck & terraform plan", step_pen_test_and_terraform),
+        ("Promote Gatekeeper (controlled)", step_promote_gatekeeper),
+        ("Billing & chargeback validation", step_billing_and_chargeback),
+        ("Explainability e2e & attachments", step_explainability_and_attachment),
+        ("Long-term SLO & audit", step_longterm_slo_and_audit),
+        ("Bundle & cosign evidence", step_bundle_and_cosign),
+    ]
+
+    for name, fn in steps:
+        log.info("Starting step: %s", name)
+        try:
+            ok, info = fn()
+        except Exception as e:
+            ok = False
+            info = {"error": str(e)}
+        summary["steps"].append({"name": name, "ok": ok, "info": info, "ts": datetime.utcnow().isoformat()})
+        if not ok:
+            log.error("Step failed: %s -> %s", name, info)
+            break
+
+    summary["finished"] = datetime.utcnow().isoformat()
+    path = "/tmp/level4_execution_summary.json"
+    open(path, "w").write(json.dumps(summary, indent=2))
