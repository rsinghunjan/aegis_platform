*** Add File:ops/scripts/auto_promote_controller_run.sh
+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to watch acceptance summary and (optionally) trigger auto promotions for policy-permitted runs.
+# This script is intended for operators: it will not bypass legal-required approvals.
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-s3://your-evidence-bucket}
+PROMOTE_API=${PROMOTE_API:-http://promote.monitoring.svc:8080/promote}
+APPROVAL_API=${APPROVAL_API:-http://approval-service.monitoring.svc:8080}
+SLEEP=${SLEEP:-30}
+echo "Watching acceptance summary in ${EVIDENCE_BUCKET} and auto-promoting approved runs (policy-permitted only)."
+while true; do
+  # fetch latest acceptance summary
+  KEY=$(aws s3 ls ${EVIDENCE_BUCKET}/acceptance/ | sort | tail -n1 | awk '{print $4}' || true)
+  if [ -n "$KEY" ]; then
+    TEMP=/tmp/acceptance.json
+    aws s3 cp "${EVIDENCE_BUCKET}/acceptance/${KEY}" "$TEMP" || true
+    PASS=$(jq -r '.overall_ok' "$TEMP" || echo "false")
+    if [ "$PASS" = "true" ]; then
+      echo "Acceptance passed. Scanning for candidate runs to auto-promote..."
+      # Query evidence bucket for autopromote candidates (closedloop/*/canary_eval.json)
+      # PoC: list possible run ids and call promote API if policy allowed (real logic uses OPA/controller)
+      for run_prefix in $(aws s3 ls ${EVIDENCE_BUCKET}/closedloop/ | awk '{print $2}' | sed 's|/||g' ); do
+        # skip legal-flagged runs by checking an annotations file
+        ANNO_KEY="closedloop/${run_prefix}/annotations.json"
+        if aws s3 ls "${EVIDENCE_BUCKET}/${ANNO_KEY}" >/dev/null 2>&1; then
+          REQ_LEGAL=$(aws s3 cp "s3://${EVIDENCE_BUCKET#s3://}/${ANNO_KEY}" - | jq -r '.require_legal // false' || echo "false")
+        else
+          REQ_LEGAL="false"
+        fi
+        if [ "$REQ_LEGAL" = "true" ]; then
+          echo "Run ${run_prefix} requires legal approval; creating approval request."
+          curl -s -X POST -H "Content-Type: application/json" -d "{\"summary\":\"Legal approval for run ${run_prefix}\",\"run_id\":\"${run_prefix}\",\"require_legal\":true}" ${APPROVAL_API}/request || true
+        else
+          echo "Auto-promoting run ${run_prefix} via Promote API"
+          curl -s -X POST -H "Content-Type: application/json" -d "{\"run_id\":\"${run_prefix}\",\"auto\":true}" ${PROMOTE_API} || true
+        fi
+      done
+      echo "Auto-promote scan complete."
+    else
+      echo "Acceptance not yet passing. Waiting..."
+    fi
+  fi
+  sleep ${SLEEP}
+done
+
