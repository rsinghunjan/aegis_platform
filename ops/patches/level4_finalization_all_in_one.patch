+#!/usr/bin/env bash
+set -euo pipefail
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-s3://your-evidence-bucket}
+OUT=/tmp/compliance-package-$(date -u +%Y%m%dT%H%M%SZ)
+mkdir -p ${OUT}
+echo "Collecting latest audit artifacts..."
+aws s3 cp ${EVIDENCE_BUCKET}/audits/ ${OUT}/audits/ --recursive || true
+aws s3 cp ${EVIDENCE_BUCKET}/bundles/ ${OUT}/bundles/ --recursive || true
+aws s3 cp ${EVIDENCE_BUCKET}/acceptance/ ${OUT}/acceptance/ --recursive || true
+tar -czf ${OUT}.tar.gz -C /tmp $(basename ${OUT})
+if [ -f /secrets/cosign.key ]; then
+  cosign sign-blob --key /secrets/cosign.key ${OUT}.tar.gz || true
+fi
+aws s3 cp ${OUT}.tar.gz ${EVIDENCE_BUCKET}/compliance/ || true
+echo "Prepared compliance package: ${OUT}.tar.gz (and uploaded to ${EVIDENCE_BUCKET}/compliance/)"
+
