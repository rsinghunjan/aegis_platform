+            exit 1
+          fi
+      - name: Apply Tekton PipelineRun
+        env:
+          EVIDENCE_BUCKET: ${{ github.event.inputs.evidence_bucket }}
+        run: |
+          sed "s|s3://your-evidence-bucket|${EVIDENCE_BUCKET}|g" ops/tekton/pipelineruns/level4_master_pipelinerun.yaml > /tmp/l4pr.yaml
+          kubectl apply -f /tmp/l4pr.yaml
+          echo "PipelineRun applied; monitor in Tekton dashboard"
+  promote-gatekeeper:
+    runs-on: ubuntu-latest
+    needs: dispatch-validation
