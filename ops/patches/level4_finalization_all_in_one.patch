*** Add File:ops/scripts/cosign_sign_evidence_bundle.sh
+#!/usr/bin/env bash
+set -euo pipefail
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-s3://your-evidence-bucket}
+COSIGN_KEY=${COSIGN_KEY:-/secrets/cosign.key}
+TMP=/tmp/evidence_bundle_sign
+mkdir -p $TMP
+echo "Downloading latest evidence bundle..."
+LATEST=$(aws s3 ls ${EVIDENCE_BUCKET}/bundles/ | sort | tail -n1 | awk '{print $4}' || true)
+if [ -z "$LATEST" ]; then
+  echo "No bundle found"
+  exit 0
+fi
+aws s3 cp "${EVIDENCE_BUCKET}/bundles/${LATEST}" ${TMP}/${LATEST}
+if [ -f "$COSIGN_KEY" ]; then
+  cosign sign-blob --key "$COSIGN_KEY" ${TMP}/${LATEST}
+  aws s3 cp ${TMP}/${LATEST}.sig "${EVIDENCE_BUCKET}/bundles/${LATEST}.sig" || true
+  echo "Signed and uploaded signature"
+else
+  echo "Cosign key missing; skipping sign"
+fi
+
