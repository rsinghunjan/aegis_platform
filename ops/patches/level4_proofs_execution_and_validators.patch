+#!/usr/bin/env python3
+"""
+Accelerated 30-day long shadow runner (PoC)
+Samples KPIs at accelerated cadence, stores periodic snapshots, runs basic anomaly detection,
+and uploads evidence including a manifest and a short postmortem if anomalies detected.
+"""
+import argparse, time, json, os, logging
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("longshadow-full")
+
+def sample_kpi(prom_url):
+    try:
+        import requests
+        q='sum(rate(business_metric[1m]))'
+        r=requests.get(f"{prom_url}/api/v1/query", params={"query": q}, timeout=10)
+        if r.status_code==200:
+            return r.json()
+    except Exception:
+        pass
+    return None
+
+def upload(path, evidence):
+    if not evidence:
+        return path
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    key=f"longshadow/{os.path.basename(path)}"
+    s3.upload_file(path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--hours", type=int, default=720)  # 30 days accelerated
+    p.add_argument("--interval-sec", type=int, default=30)
+    p.add_argument("--prom", default="http://prometheus.monitoring.svc:9090")
+    p.add_argument("--evidence", default=os.environ.get("EVIDENCE_BUCKET",""))
+    args=p.parse_args()
+    samples=[]
+    end=time.time()+args.hours*3600/24  # accelerated: compress days into hours factor
+    # For PoC we'll collect up to 5000 samples or until time cap
+    for i in range(5000):
+        s=sample_kpi(args.prom)
+        ts=datetime.utcnow().isoformat()
+        samples.append({"ts": ts, "kpi": s})
+        time.sleep(args.interval_sec)
+        if len(samples)>=5000:
+            break
+    path=f"/tmp/longshadow_samples_{int(time.time())}.json"
+    open(path,"w").write(json.dumps(samples))
+    uri=upload(path, args.evidence)
+    # quick anomaly detection: find null samples
+    anomalies=[s for s in samples if s["kpi"] is None]
+    postmortem={"ts": datetime.utcnow().isoformat(), "total_samples": len(samples), "anomalies": len(anomalies)}
+    pm_path=f"/tmp/longshadow_postmortem_{int(time.time())}.json"
+    open(pm_path,"w").write(json.dumps(postmortem, indent=2))
+    pm_uri=upload(pm_path, args.evidence)
+    print(json.dumps({"samples_uri": uri, "postmortem_uri": pm_uri}))
+
+if __name__ == "__main__":
+    main()
+
