+#!/usr/bin/env python3
+"""
+End-to-end explainability validator:
+ - Ensures per-inference manifests exist for recent runs
+ - Verifies ACL file present and that SME fetch would be authorized (PoC: checks presence)
+ - Ensures explain manifest is attached to promotion evidence (closedloop/<run_id>/)
+ - Uploads a verification report to evidence bucket
+"""
+import argparse, os, json, logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log=logging.getLogger("explain-e2e")
+
+def list_recent_runs(evidence, limit=100):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix="closedloop/", Delimiter="/", MaxKeys=1000)
+    prefixes=[p.get("Prefix") for p in resp.get("CommonPrefixes",[])]
+    return prefixes[:limit]
+
+def check_run_prefix(evidence, prefix):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    # check explainability manifest exist under closedloop/<run>/explain*
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix=prefix+"explain", MaxKeys=2)
+    found = resp.get("KeyCount",0)>0
+    # check ACL file
+    resp2=s3.list_objects_v2(Bucket=bucket, Prefix=prefix+"acl", MaxKeys=2)
+    acl=resp2.get("KeyCount",0)>0
+    return found, acl
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True)
+    args=p.parse_args()
+    report={"ts": datetime.utcnow().isoformat(), "items": []}
+    prefixes = list_recent_runs(args.evidence, limit=200)
+    for pref in prefixes:
+        found, acl = check_run_prefix(args.evidence, pref)
+        report["items"].append({"run_prefix": pref, "explain_manifest": found, "acl_present": acl})
+    out="/tmp/explain_e2e_"+str(int(time.time()))+".json"
+    open(out,"w").write(json.dumps(report, indent=2))
+    if args.evidence:
+        import boto3
+        s3=boto3.client("s3")
+        s3.upload_file(out, args.evidence.replace("s3://",""), f"explainability/verify-{int(time.time())}.json")
+    print(json.dumps(report, indent=2))
+
+if __name__ == "__main__":
+    main()
+
