+#!/usr/bin/env python3
+"""
+Run the OPA harness (broad corpus) and enforce mismatch threshold.
+Uploads verdict to evidence bucket and exits non-zero if mismatch rate exceeds threshold.
+"""
+import argparse, os, json, logging, subprocess, sys
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log=logging.getLogger("opa-full")
+
+def run_harness():
+    subprocess.check_call(["python3","services/decisioning/opa_harness_coverage.py"])
+
+def fetch_latest_report(evidence):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix="opa/harness-report", MaxKeys=100)
+    items=resp.get("Contents",[])
+    if not items:
+        return None
+    items.sort(key=lambda x: x["LastModified"], reverse=True)
+    key=items[0]["Key"]
+    obj=s3.get_object(Bucket=bucket, Key=key)
+    return json.loads(obj["Body"].read().decode()), key
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", default=os.environ.get("EVIDENCE_BUCKET",""))
+    args=p.parse_args()
+    thresh=float(os.environ.get("OPA_MISMATCH_THRESHOLD","0.01"))
+    try:
+        run_harness()
+        if not args.evidence:
+            log.warning("no evidence bucket; cannot fetch report to enforce threshold")
+            sys.exit(0)
+        report, key = fetch_latest_report(args.evidence)
+        decisions=report.get("decisions",{})
+        mism=report.get("mismatches",[])
+        total=decisions.get("permit",0)+decisions.get("deny",0)
+        mismatch_rate = len(mism)/total if total else 1.0
+        verdict={"ts": str(datetime.utcnow()), "mismatch_rate": mismatch_rate, "s3_key": key}
+        import boto3
+        s3=boto3.client("s3")
+        bucket=args.evidence.replace("s3://","")
+        s3.put_object(Bucket=bucket, Key=f"opa/verdict-{int(time.time())}.json", Body=json.dumps(verdict).encode())
+        log.info("OPA mismatch_rate=%.6f", mismatch_rate)
+        if mismatch_rate > thresh:
+            log.error("Mismatch rate above threshold")
+            sys.exit(2)
+    except Exception:
+        log.exception("OPA full harness failed")
+        sys.exit(2)
+
+if __name__ == "__main__":
+    main()
+
