+#!/usr/bin/env python3
+"""
+Run 2k dry-run simulator which exercises the submission path and records results to evidence bucket.
+"""
+import argparse, time, json, os, random, logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log=logging.getLogger("sim-2k")
+
+def run_sim(runs, evidence):
+    stats={"accepted":0,"rejected":0,"errors":0}
+    for i in range(runs):
+        try:
+            # simulate submission via internal endpoint (PoC uses random acceptance)
+            if random.random() > 0.1:
+                stats["accepted"] +=1
+            else:
+                stats["rejected"] +=1
+        except Exception:
+            stats["errors"]+=1
+        if i % 100 == 0:
+            time.sleep(0.1)
+    path=f"/tmp/sim2k_{int(time.time())}.json"
+    open(path,"w").write(json.dumps(stats, indent=2))
+    if evidence:
+        import boto3
+        s3=boto3.client("s3")
+        bucket=evidence.replace("s3://","")
+        key=f"stress/2k-{int(time.time())}.json"
+        s3.upload_file(path, bucket, key)
+        log.info("Uploaded sim results to s3://%s/%s", bucket, key)
+    print(json.dumps(stats))
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--runs", type=int, default=2000)
+    p.add_argument("--evidence", default=os.environ.get("EVIDENCE_BUCKET",""))
+    args=p.parse_args()
+    run_sim(args.runs, args.evidence)
+
+if __name__ == "__main__":
+    main()
