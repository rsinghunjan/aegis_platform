+#!/usr/bin/env python3
+"""
+Submit distributed HPO workload (configurable trials) and monitor progress.
+After completion, run checkpoint_validator and upload submission manifest to evidence.
+"""
+import argparse, time, json, logging, subprocess, os
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("hpo-monitor")
+
+def run_cmd(cmd, capture=True):
+    log.info("CMD: %s", " ".join(cmd))
+    if capture:
+        return subprocess.check_output(cmd).decode()
+    else:
+        subprocess.check_call(cmd)
+
+def submit_bulk(total, per_job, checkpoint_s3, evidence):
+    # reuse ray_job_bulk_generator which submits and uploads a manifest
+    cmd = ["python3", "services/hpo/ray_job_bulk_generator.py", "--trials-total", str(total),
+           "--trials-per-job", str(per_job), "--checkpoint", checkpoint_s3, "--team", "validation", "--evidence", evidence]
+    run_cmd(cmd, capture=False)
+
+def poll_for_completion(wait_minutes=120, poll_sec=60):
+    # PoC: Poll for a sentinel object in S3 produced by Ray job completion process.
+    log.info("Polling for HPO completion up to %d minutes", wait_minutes)
+    import boto3
+    bucket = os.environ.get("EVIDENCE_BUCKET","").replace("s3://","")
+    s3=boto3.client("s3")
+    end=time.time()+wait_minutes*60
+    while time.time() < end:
+        try:
+            resp=s3.list_objects_v2(Bucket=bucket, Prefix="hpo/submissions")
+            if resp.get("KeyCount",0) > 0:
+                log.info("Found hpo submission artifacts; assume jobs started/completed")
+                return True
+        except Exception:
+            log.exception("s3 poll failed")
+        time.sleep(poll_sec)
+    log.error("HPO poll timed out")
+    return False
+
+def run_checkpoint_validator(evidence):
+    try:
+        run_cmd(["python3","services/hpo/checkpoint_validator.py","--evidence", evidence], capture=False)
+        return True
+    except subprocess.CalledProcessError:
+        return False
+
+def upload_manifest(manifest, evidence):
+    if not evidence:
+        log.info("No evidence bucket configured, writing manifest locally")
+        path="/tmp/hpo_submission_manifest.json"
+        open(path,"w").write(json.dumps(manifest, indent=2))
+        return path
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence.replace("s3://","")
+    key=f"hpo/submissions/manifest-{int(time.time())}.json"
+    s3.put_object(Bucket=bucket, Key=key, Body=json.dumps(manifest).encode())
+    return f"s3://{bucket}/{key}"
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--total", type=int, default=256)
+    p.add_argument("--per-job", type=int, default=8)
+    p.add_argument("--checkpoint", default="s3://aegis-checkpoints")
+    p.add_argument("--evidence", default=os.environ.get("EVIDENCE_BUCKET",""))
+    args=p.parse_args()
+    start=datetime.utcnow().isoformat()
+    submit_bulk(args.total, args.per_job, args.checkpoint, args.evidence)
+    ok = poll_for_completion(wait_minutes=180, poll_sec=60)
+    manifest={"submitted_total": args.total, "per_job": args.per_job, "start": start, "completed_flag_found": ok}
+    uri = upload_manifest(manifest, args.evidence)
+    log.info("Submission manifest uploaded: %s", uri)
+    # run checkpoint validator and return status
+    chk_ok = run_checkpoint_validator(args.evidence)
+    if not chk_ok:
+        log.error("Checkpoint validator failed (threshold not met or errors).")
+        raise SystemExit(2)
+    log.info("Checkpoint validator succeeded")
+
+if __name__ == "__main__":
+    main()
+
