+#!/usr/bin/env python3
+"""
+Run OPA harness and enforce mismatch threshold; uploads a brief verdict to evidence bucket.
+"""
+import os, subprocess, json, sys, logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("opa-runner")
+
+THRESH = float(os.environ.get("OPA_MISMATCH_THRESHOLD", "0.01"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def main():
+    try:
+        subprocess.check_call(["python3", "services/decisioning/opa_harness_coverage.py"])
+    except Exception:
+        log.exception("OPA harness execution failed")
+        sys.exit(2)
+    # analyze latest report in S3
+    if not EVIDENCE_BUCKET:
+        log.warning("no evidence bucket; cannot enforce mismatch rate")
+        sys.exit(0)
+    import boto3
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix="opa/harness-report")
+    items=resp.get("Contents",[])
+    if not items:
+        log.error("no harness report found")
+        sys.exit(2)
+    items.sort(key=lambda x: x["LastModified"], reverse=True)
+    key=items[0]["Key"]
+    obj=s3.get_object(Bucket=bucket, Key=key)
+    report=json.loads(obj["Body"].read().decode())
+    mismatches=report.get("mismatches", [])
+    decisions=report.get("decisions", {})
+    total = decisions.get("permit",0)+decisions.get("deny",0)
+    mismatch_rate = len(mismatches)/total if total else 1.0
+    verdict={"ts": str(datetime.utcnow()), "s3_key": key, "mismatch_rate": mismatch_rate, "mismatches": len(mismatches)}
+    out="/tmp/opa_verdict.json"
+    open(out, "w").write(json.dumps(verdict, indent=2))
+    s3.put_object(Bucket=bucket, Key=f"opa/verdict-{int(time.time())}.json", Body=json.dumps(verdict).encode())
+    log.info("OPA mismatch_rate=%.6f", mismatch_rate)
+    if mismatch_rate > THRESH:
+        log.error("Mismatch rate above threshold: %.6f > %.6f", mismatch_rate, THRESH)
+        sys.exit(2)
+    log.info("OPA harness OK")
+
+if __name__ == "__main__":
+    main()
+
