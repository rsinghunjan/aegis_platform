+         "--trials-total", str(HPO_TOTAL),
+         "--trials-per-job", str(HPO_PER_JOB),
+         "--checkpoint", os.environ.get("CHECKPOINT_S3", "s3://aegis-checkpoints"),
+         "--team", "validation",
+         "--evidence", EVIDENCE_BUCKET], check=True)
+
+def step_checkpoint_validate(retries=6, delay_sec=60):
