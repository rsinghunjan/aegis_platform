+            log.info("Checkpoint validation passed")
+            return True
+        except subprocess.CalledProcessError:
+            log.warning("Checkpoint validation attempt %d/%d failed; waiting %ds", attempt, retries, delay_sec)
+            time.sleep(delay_sec)
+    log.error("Checkpoint validation failed after %d attempts", retries)
