+#!/usr/bin/env python3
+"""
+Verify auto-promote evidence:
+ - Lists autopromote records in evidence bucket
+ - Validates cosign signatures exist for associated artifacts (PoC)
+ - Produces a verification report uploaded to evidence bucket
+"""
+import os, json, logging, subprocess
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+log = logging.getLogger("verify-autopromote")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_PUB = os.environ.get("COSIGN_PUB", "/secrets/cosign.pub")
+
+def list_autopromote_keys():
+    if not EVIDENCE_BUCKET:
+        return []
+    import boto3
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix="autopromote/", MaxKeys=1000)
+    return [o["Key"] for o in resp.get("Contents",[])]
+
+def verify_signature(s3path):
+    # PoC: expect artifact path and .sig present next to it; download and use cosign verify-blob
+    import boto3, tempfile
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    filename=os.path.basename(s3path)
+    local="/tmp/"+filename
+    try:
+        s3.download_file(bucket, s3path, local)
+    except Exception:
+        return False, "download failed"
+    sig_local = local + ".sig"
+    try:
+        s3.download_file(bucket, s3path + ".sig", sig_local)
+    except Exception:
+        return False, "sig missing"
+    try:
+        subprocess.check_call(["cosign", "verify-blob", "-key", COSIGN_PUB, "-signature", sig_local, local])
+        return True, ""
+    except Exception:
+        return False, "verify failed"
+
+def main():
+    keys = list_autopromote_keys()
+    report = {"ts": datetime.utcnow().isoformat(), "items": []}
+    for k in keys:
+        ok, reason = verify_signature(k)
+        report["items"].append({"key": k, "verified": ok, "reason": reason})
+    out = "/tmp/autopromote_verify_"+str(int(time.time()))+".json"
+    open(out, "w").write(json.dumps(report, indent=2))
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        bucket=EVIDENCE_BUCKET.replace("s3://","")
+        key=f"autopromote/verify-{int(time.time())}.json"
+        s3.upload_file(out, bucket, key)
+        log.info("Uploaded verify report to s3://%s/%s", bucket, key)
+    print(json.dumps(report, indent=2))
+
+if __name__ == "__main__":
+    main()
+
