+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Promote Gatekeeper constraints in a controlled way and verify admission webhook enforcement by attempting a denied pod create.
+# Expects: CONSTRAINT_LIST file with constraint names (one per line).
+
+CONSTRAINT_LIST=${CONSTRAINT_LIST:-ops/gatekeeper/enforce-list.txt}
+NAMESPACE=${NAMESPACE:-model-serving}
+TEMP_POD="/tmp/gatekeeper_test_pod.yaml"
+
+if [ ! -f "$CONSTRAINT_LIST" ]; then
+  echo "Constraint list not found: $CONSTRAINT_LIST"
+  exit 1
+fi
+
+echo "Promoting constraints to enforcement 'deny'..."
+while read -r c; do
+  c=$(echo "$c" | sed 's/#.*//;s/^\s*//;s/\s*$//')
+  [ -z "$c" ] && continue
+  echo "Patching constraint $c -> deny"
+  kubectl patch -n gatekeeper-system "constraint/$c" --type='json' -p='[{"op":"replace","path":"/spec/enforcementAction","value":"deny"}]' || true
+done < "$CONSTRAINT_LIST"
+
+echo "Verifying rejecting admission: create a Pod without cosign annotation (should be denied)"
+cat > $TEMP_POD <<EOF
+apiVersion: v1
+kind: Pod
+metadata:
+  name: gatekeeper-test-no-sig
+  namespace: ${NAMESPACE}
+spec:
+  containers:
+  - name: c
+    image: busybox
+    command: ["sleep","3600"]
+EOF
+
+if kubectl apply -f $TEMP_POD >/dev/null 2>&1; then
+  echo "WARNING: Pod creation succeeded but should have been denied by Gatekeeper/webhook"
+  kubectl delete -f $TEMP_POD || true
+  exit 2
+else
+  echo "Admission webhook / Gatekeeper appears to deny non-compliant Pod as expected"
+fi
+
+rm -f $TEMP_POD
+echo "Gatekeeper promotion & verification complete"
+
