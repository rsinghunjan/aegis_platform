+  if [ -n "${EVIDENCE_BUCKET}" ]; then
+    aws s3 cp /tmp/tfstate_after.json ${EVIDENCE_BUCKET}/terraform/ || true
+  fi
+else
+  echo "APPLY not set. Review plan in evidence bucket before applying."
