+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Dispatch "Execute Production Proofs Now" workflow for rsinghunjan/aegis with prefilled inputs.
+#
+REPO="rsinghunjan/aegis"
+WORKFLOW_FILE="execute_production_proofs_now.yml"
+WORKFLOW_NAME="Execute Production Proofs Now"
+EVIDENCE_BUCKET="s3://aegis-evidence-prod"
+PROMOTE_GATEKEEPER="no"
+MANUAL_APPROVAL_TOKEN=""
+
+if command -v gh >/dev/null 2>&1; then
+  echo "Dispatching via gh CLI..."
+  gh workflow run "${WORKFLOW_NAME}" -R "${REPO}" --field evidence_bucket="${EVIDENCE_BUCKET}" --field confirm=RUN_PROOFS --field promote_gatekeeper="${PROMOTE_GATEKEEPER}" --field manual_approval_token="${MANUAL_APPROVAL_TOKEN}"
+  echo "Dispatched. Monitor GitHub Actions UI."
+else
+  echo "gh CLI not found; dispatching via GitHub API with curl. Ensure GITHUB_TOKEN is set."
+  if [ -z "${GITHUB_TOKEN:-}" ]; then
+    echo "GITHUB_TOKEN must be set for curl dispatch."; exit 1
+  fi
+  API="https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW_FILE}/dispatches"
+  PAYLOAD=$(
+    cat <<JSON
+{
+  "ref": "main",
+  "inputs": {
+    "evidence_bucket": "${EVIDENCE_BUCKET}",
+    "confirm": "RUN_PROOFS",
+    "promote_gatekeeper": "${PROMOTE_GATEKEEPER}",
+    "manual_approval_token": "${MANUAL_APPROVAL_TOKEN}"
+  }
+}
+JSON
+  )
+  curl -s -X POST -H "Accept: application/vnd.github+json" -H "Authorization: Bearer ${GITHUB_TOKEN}" "${API}" -d "${PAYLOAD}"
+  echo "Dispatched via curl. Monitor GitHub Actions UI."
+fi
+
