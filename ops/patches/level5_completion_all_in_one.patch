+#!/usr/bin/env python3
+"""
+Simple benchmark client for the DeepSpeed service.
+Sends concurrent requests and prints qps/latency summary (PoC).
+"""
+import requests
+import time
+import threading
+
+TARGET = "http://aegis-deepspeed.ml-serving.svc.cluster.local:8080/v1/infer"
+CONCURRENCY = 4
+REQUESTS_PER_THREAD = 50
+
+def worker(id):
+    latencies=[]
+    for i in range(REQUESTS_PER_THREAD):
+        t0=time.time()
+        try:
+            r=requests.post(TARGET, json={"prompt":"hello"}, timeout=10)
+            r.raise_for_status()
+        except Exception as e:
+            print("request error", e)
+            continue
+        latencies.append(time.time()-t0)
+    print(f"worker {id} done, avg latency {sum(latencies)/len(latencies) if latencies else -1}")
+
+threads=[]
+t0=time.time()
+for i in range(CONCURRENCY):
+    th=threading.Thread(target=worker, args=(i,))
+    th.start()
+    threads.append(th)
+for th in threads:
+    th.join()
+dt=time.time()-t0
+print("benchmark finished in", dt)
+
