+#!/usr/bin/env python3
+"""
+Upload HIL traces / logs to evidence bucket and return the S3 key.
+"""
+import os
+import json
+import tempfile
+
+def upload_evidence(evidence_bucket: str, content: dict, prefix: str = "hil/traces"):
+    import boto3
+    s3 = boto3.client("s3")
+    tmp = tempfile.mktemp(suffix=".json")
+    with open(tmp, "w") as f:
+        json.dump(content, f, indent=2)
+    key = f"{prefix}/trace-{int(__import__('time').time())}.json"
+    s3.upload_file(tmp, evidence_bucket.replace("s3://",""), key)
+    return f"s3://{evidence_bucket.replace('s3://','')}/{key}"
+
+if __name__ == "__main__":
+    print("PoC uploader. Set EVIDENCE_BUCKET and call upload_evidence(...)")
+
