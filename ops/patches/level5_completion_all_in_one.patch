+#!/usr/bin/env python3
+"""
+Vendor E-STOP binding example (HTTP), implement for real vendor API in production.
+"""
+import requests
+import os
+
+ESTOP_API = os.environ.get("HIL_ESTOP_API", "http://controller.local/api/estop")
+RESET_API = os.environ.get("HIL_ESTOP_RESET_API", "http://controller.local/api/reset")
+
+def trigger_estop():
+    r = requests.post(ESTOP_API, timeout=2)
+    r.raise_for_status()
+    return r.json()
+
+def reset_estop():
+    r = requests.post(RESET_API, timeout=2)
+    r.raise_for_status()
+    return r.json()
+
+if __name__ == "__main__":
+    print("Triggering E-STOP:", trigger_estop())
