+#!/usr/bin/env python3
+"""
+CI-friendly wrapper for full evaluation pipeline.
+Produces a JSON report and exits non-zero if thresholds are not met.
+"""
+import argparse
+import json
+from services.eval.fid_clip_rouge.full_eval_real import run_full_eval
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--manifest", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--fid-threshold", type=float, default=100.0)
+    p.add_argument("--rouge-threshold", type=float, default=0.2)
+    args=p.parse_args()
+    run_full_eval(args.manifest, args.out)
+    report=json.load(open(args.out))
+    fid=report.get("fid", 9999.0)
+    rouge=report.get("rouge_l", 0.0)
+    print("EVAL REPORT:", report)
+    if fid>args.fid_threshold or rouge<args.rouge_threshold:
+        print("Evaluation failed thresholds")
+        raise SystemExit(2)
+    print("Evaluation passed thresholds")
+
+if __name__ == "__main__":
+    main()
+
