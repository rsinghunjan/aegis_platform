+#!/usr/bin/env bash
+set -euo pipefail
+#
+# PoC autoscaler: check slurm queue length and scale slurm-head deployment accordingly
+THRESHOLD=${1:-50}
+NAMESPACE=${2:-cicd}
+QUEUE_LEN=$(squeue -h | wc -l || echo 0)
+if [ "$QUEUE_LEN" -gt "$THRESHOLD" ]; then
+  echo "Queue length $QUEUE_LEN > $THRESHOLD: scaling slurm-head to 3"
+  kubectl -n "$NAMESPACE" scale deployment slurm-head --replicas=3
+else
+  echo "Queue length $QUEUE_LEN <= $THRESHOLD: scaling slurm-head to 1"
+  kubectl -n "$NAMESPACE" scale deployment slurm-head --replicas=1
+fi
