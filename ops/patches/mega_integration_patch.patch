+def capture_provider_terms(provider_name, terms_url, signer):
+    meta = {"provider": provider_name, "terms_url": terms_url, "accepted_by": signer, "ts": int(time.time())}
+    key = f"qpu/compliance/terms-{provider_name}-{int(time.time())}-{uuid.uuid4().hex}.json"
+    if S3:
+        S3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(meta).encode())
+        uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+    else:
+        path = f"/tmp/{key.replace('/','_')}"
+        with open(path, "w") as f:
+            json.dump(meta, f)
+        uri = path
+    logger.info("Captured provider terms: %s", uri)
+    return uri
+
