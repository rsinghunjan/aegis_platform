+#!/usr/bin/env python3
+"""
+Robust telemetry buffer & forward agent (PoC)
+ - Writes telemetry to local queue directory and attempts to POST to central endpoint with retries/backoff
+ - Records forward successes/failures and optionally uploads local backlog metadata to evidence S3 for reconciliation
+"""
+import os, time, json, logging, requests
+from pathlib import Path
+
+WATCH_DIR = Path(os.environ.get("RELAY_DIR", "/tmp/telemetry_queue"))
+ENDPOINT = os.environ.get("CENTRAL_ENDPOINT", "http://ros2-bridge.monitoring.svc:8080/telemetry")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+try:
+    import boto3
+    S3 = boto3.client("s3")
+except Exception:
+    S3 = None
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("telemetry-relay")
+
+WATCH_DIR.mkdir(parents=True, exist_ok=True)
+
+def forward_file(path: Path):
+    with open(path) as f:
+        payload = json.load(f)
+    backoff = 1
+    for attempt in range(5):
+        try:
+            r = requests.post(ENDPOINT, json=payload, timeout=5)
+            if r.status_code in (200,201):
+                path.unlink()
+                return True
+        except Exception as e:
+            logger.debug("forward attempt %d failed: %s", attempt, e)
+        time.sleep(backoff); backoff *= 2
+    # upload metadata for reconciliation
+    if S3 and EVIDENCE_BUCKET:
+        key = f"telemetry/backlog/{path.name}.meta"
+        S3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps({"file":path.name,"ts":int(time.time())}).encode())
+    return False
+
+def main_loop():
+    while True:
+        files = sorted(WATCH_DIR.glob("*.json"))
+        for f in files:
+            forward_file(f)
+        time.sleep(5)
+
+if __name__=="__main__":
+    main_loop()
+
