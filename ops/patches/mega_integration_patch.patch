+"""
+OpenTelemetry initializer helper (PoC)
+ - Configure OTEL exporter (OTLP/OTLP_HTTP) and instrument FastAPI / requests automatically where possible
+"""
+import os
+from opentelemetry import trace
+from opentelemetry.sdk.resources import Resource
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import BatchSpanProcessor, ConsoleSpanExporter
+from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
+
+def init_otel(service_name="aegis-service"):
+    exporter_endpoint = os.environ.get("OTEL_EXPORTER_OTLP_ENDPOINT")
+    resource = Resource.create({"service.name": service_name})
+    provider = TracerProvider(resource=resource)
+    trace.set_tracer_provider(provider)
+    if exporter_endpoint:
+        exporter = OTLPSpanExporter(endpoint=exporter_endpoint)
+        provider.add_span_processor(BatchSpanProcessor(exporter))
+    else:
+        provider.add_span_processor(BatchSpanProcessor(ConsoleSpanExporter()))
