+    br = BillingRecord(job_id=job_id, owner=owner, provider=provider, estimated_cost=estimate_usd)
+    db.add(br)
+    db.commit()
+    logger.info("Recorded billing estimate for %s", job_id)
+
+def record_actual(job_id, actual_usd):
+    db = SessionLocal()
+    rec = db.query(BillingRecord).filter(BillingRecord.job_id == job_id).first()
+    if rec:
+        rec.actual_cost = actual_usd
+        db.commit()
+        logger.info("Recorded actual cost for %s", job_id)
+    else:
+        logger.warning("No billing record found for %s", job_id)
