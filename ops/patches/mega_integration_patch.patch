+#!/usr/bin/env python3
+"""
+Extended capacity planning helper:
+ - Run configurable workloads (optimizer qps, simulator parallel runs)
+ - Estimate nodes required given target p95 latency and throughput
+"""
+import os, time, statistics, requests
+from concurrent.futures import ThreadPoolExecutor
+
+def stress_optimizer(url, qps=50, duration_s=30):
+    latencies = []
+    def task(i):
+        t0 = time.time()
+        try:
+            r = requests.post(url, json={"job_id":f"b{i}","model_name":"m","latency_sla_ms":200,"candidates":{"us-east":"http://example"}} , timeout=5)
+            return time.time()-t0
+        except Exception:
+            return None
+    end = time.time()+duration_s
+    i=0
+    with ThreadPoolExecutor(max_workers=qps) as ex:
+        futures=[]
+        while time.time() < end:
+            futures.append(ex.submit(task,i)); i+=1
+            time.sleep(1.0/qps)
+        for f in futures:
+            r = f.result()
+            if r: latencies.append(r)
+    if latencies:
+        return {"p50":statistics.median(latencies), "p95":sorted(latencies)[int(0.95*len(latencies))-1]}
+    return {}
+
+if __name__=="__main__":
+    url = os.environ.get("OPTIMIZER_URL","http://carbon-optimizer.monitoring.svc:8082/optimize")
+    print("Running quick stress to estimate capacity on", url)
+    print(stress_optimizer(url, qps=20, duration_s=15))
+
