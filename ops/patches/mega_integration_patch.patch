+#!/usr/bin/env python3
+"""
+Fleet Controller (PoC)
+ - Manages OTA campaigns in batches and supports rollback signals
+ - Records evidence per batch into evidence bucket
+"""
+import os, time, json, logging
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+logger = logging.getLogger("fleet-controller")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+S3 = boto3.client("s3") if boto3 and EVIDENCE_BUCKET else None
+
+app = FastAPI(title="Fleet Controller (PoC)")
+
+class Campaign(BaseModel):
+    name: str
+    artifact: str
+    devices: list
+    batch_size: int = 10
+
+CAMPAIGNS = {}
+
+@app.post("/campaigns")
+def create_campaign(c: Campaign):
+    cid = f"camp-{int(time.time())}"
+    CAMPAIGNS[cid] = {"id":cid, "campaign": c.dict(), "state":"staged"}
+    return CAMPAIGNS[cid]
+
+@app.post("/campaigns/{cid}/start")
+def start_campaign(cid: str):
+    c = CAMPAIGNS.get(cid)
+    if not c:
+        raise HTTPException(status_code=404)
+    c["state"] = "running"
+    # PoC: iterate in batches and record evidence
+    devices = c["campaign"]["devices"]
+    bs = c["campaign"]["batch_size"]
+    batches = [devices[i:i+bs] for i in range(0,len(devices),bs)]
+    for i,b in enumerate(batches):
+        meta = {"campaign": cid, "batch": i, "devices": b, "ts": int(time.time())}
+        if S3:
+            key = f"ota/campaigns/{cid}/batch-{i}.json"
+            S3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(meta).encode())
+        time.sleep(1)  # simulate rollout
+    c["state"]="completed"
+    return c
+
+@app.post("/campaigns/{cid}/rollback")
+def rollback_campaign(cid: str):
+    c = CAMPAIGNS.get(cid)
+    if not c:
+        raise HTTPException(status_code=404)
+    c["state"]="rolled_back"
+    meta = {"campaign": cid, "action":"rollback", "ts": int(time.time())}
+    if S3:
+        key = f"ota/campaigns/{cid}/rollback-{int(time.time())}.json"
+        S3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(meta).encode())
+    return {"ok": True}
