+#!/usr/bin/env python3
+"""
+AWS Billing connector that maps Cost Explorer results to tags/job ids.
+
+This is an enhanced connector that:
+- Queries Cost Explorer for the time window.
+- Filters costs by resource tags (e.g., aegis:job_id or project).
+- Produces a reconciliation JSON at /tmp/billing_reconcile.json
+
+Requires AWS credentials with Cost Explorer access.
+"""
+import os
+import boto3
+import json
+from datetime import datetime, timedelta
+
+OUT="/tmp/billing_reconcile.json"
+
+def query_costs(start_date, end_date):
+    client = boto3.client("ce", region_name=os.environ.get("AWS_REGION"))
+    resp = client.get_cost_and_usage(
+        TimePeriod={"Start": start_date, "End": end_date},
+        Granularity="DAILY",
+        Metrics=["UnblendedCost"],
+        GroupBy=[{"Type":"TAG","Key":"aegis:job_id"}]
+    )
+    return resp
+
+def summarize(resp):
+    jobs=[]
+    for t in resp.get("ResultsByTime",[]):
+        for g in t.get("Groups",[]):
+            tag = g.get("Keys")[0] if g.get("Keys") else "unknown"
+            cost = g.get("Metrics",{}).get("UnblendedCost",{}).get("Amount",0.0)
+            jobs.append({"tag":tag,"date":t.get("TimePeriod").get("Start"),"cost":float(cost)})
+    return jobs
+
+if __name__ == "__main__":
+    end = datetime.utcnow().date()
+    start = (end - timedelta(days=7)).isoformat()
+    end = end.isoformat()
+    print("Querying costs", start, end)
+    data = query_costs(start, end)
+    out = summarize(data)
+    open(OUT,"w").write(json.dumps({"window":[start,end],"jobs":out}, indent=2))
+    print("Wrote reconcile to", OUT)
+
