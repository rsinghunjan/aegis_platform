+"""
+Simple device exporter stub that exposes Prometheus metrics for NPUs/LPUs/GPUs.
+Operators should replace with vendor exporters; this stub helps ensure dashboards and alerts work before vendor metrics are available.
+"""
+from http.server import BaseHTTPRequestHandler, HTTPServer
+import time
+import random
+
+class H(BaseHTTPRequestHandler):
+    def do_GET(self):
+        if self.path != "/metrics":
+            self.send_response(404); self.end_headers(); return
+        # simple metrics
+        metrics = []
+        for i in range(2):
+            metrics.append(f'aegis_device_util{{device="gpu{i}"}} {random.uniform(0,100):.2f}')
+        metrics.append(f'aegis_npu_temp{{device="npu0"}} {random.uniform(40,80):.2f}')
+        body = "\n".join(metrics) + "\n"
+        self.send_response(200)
+        self.send_header("Content-Type","text/plain; version=0.0.4")
+        self.end_headers()
+        self.wfile.write(body.encode())
+
+if __name__=="__main__":
+    port = int(__import__("os").environ.get("PORT","9101"))
+    print("Device exporter stub on", port)
+    HTTPServer(("",port), H).serve_forever()
