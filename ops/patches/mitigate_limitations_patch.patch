+#!/usr/bin/env python3
+"""
+GCP Billing connector skeleton.
+
+This script demonstrates how to query GCP Billing Export (BigQuery) to reconcile costs by Aegis job tags.
+Requires gcloud BigQuery access and a billing dataset exported to BigQuery.
+"""
+import os
+import json
+from google.cloud import bigquery
+
+OUT="/tmp/gcp_billing_reconcile.json"
+
+def query_bq(project, dataset_table, days=7):
+    client = bigquery.Client(project=project)
+    q = f"""
+    SELECT
+      labels.aegis_job_id as job_id,
+      SUM(cost) as cost
+    FROM `{dataset_table}`
+    WHERE usage_start_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL {days} DAY)
+    GROUP BY job_id
+    """
+    job = client.query(q)
+    rows = []
+    for r in job:
+        rows.append({"job_id": r.get("job_id"), "cost": float(r.get("cost") or 0.0)})
+    return rows
+
+if __name__ == "__main__":
+    project = os.environ.get("GCP_PROJECT")
+    dataset_table = os.environ.get("GCP_BILLING_TABLE")  # e.g. "my-billing-project.my_dataset.gcp_billing_export_v1_012345"
+    if not project or not dataset_table:
+        print("Set GCP_PROJECT and GCP_BILLING_TABLE")
+        exit(2)
+    rows = query_bq(project, dataset_table, days=7)
+    open(OUT,"w").write(json.dumps({"rows":rows}, indent=2))
+    print("Wrote", OUT)
+
