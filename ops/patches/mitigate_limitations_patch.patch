+"""
+Oncall Drill Scheduler
+
+Creates GitHub issues (weekly) for a rotating oncall drill list and notifies assignees.
+This helps operational maturity by scheduling realistic incident drills.
+"""
+import os
+import requests
+import json
+from datetime import datetime
+
+DRILLS = [
+    {"title":"HIL API outage drill", "body":"Simulate HIL API 503 and practice fallback to evidence simulation."},
+    {"title":"RT p99 spike drill", "body":"Simulate RT p99 regression and run rollback playbook."},
+    {"title":"Langflow egress drill", "body":"Simulated unapproved egress from Langflow - revoke keys and audit."}
+]
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def create_issue(repo, title, body, token):
+    url = f"https://api.github.com/repos/{repo}/issues"
+    r = requests.post(url, json={"title":title,"body":body,"labels":["oncall-drill"]}, headers=gh_headers(token))
+    return r.status_code in (200,201)
+
+def main():
+    token = os.environ.get("GITHUB_TOKEN")
+    repo = os.environ.get("GITHUB_REPOSITORY")
+    if not token or not repo:
+        print("GITHUB_TOKEN and GITHUB_REPOSITORY required")
+        return
+    for d in DRILLS:
+        t = f"[DRILL] {d['title']} - {datetime.utcnow().date().isoformat()}"
+        create_issue(repo, t, d["body"], token)
+    print("Scheduled drills (created issues).")
+
+if __name__ == "__main__":
+    main()
