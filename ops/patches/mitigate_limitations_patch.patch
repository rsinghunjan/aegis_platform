+#!/usr/bin/env python3
+"""
+Hardware & Credentials Inventory Collector
+
+Writes /tmp/hardware_inventory.json with detected hardware, node labels and credential availability.
+Used by CI to decide whether real-hardware jobs can run and to provide diagnostics for operators.
+"""
+import os
+import json
+import subprocess
+from datetime import datetime
+
+OUT = "/tmp/hardware_inventory.json"
+
+def run_cmd(cmd):
+    try:
+        return subprocess.check_output(cmd, text=True).strip()
+    except Exception as e:
+        return ""
+
+def kube_nodes_by_label(label):
+    try:
+        out = run_cmd(["kubectl","get","nodes","-l",label,"-o","name"])
+        return [l.split("/",1)[-1] for l in out.splitlines() if l.strip()]
+    except Exception:
+        return []
+
+def check():
+    inv = {"ts": datetime.utcnow().isoformat()+"Z", "nodes": {}, "creds": {}}
+    # node labels
+    inv["nodes"]["gpu_nodes"] = kube_nodes_by_label("aegis/gpu=true")
+    inv["nodes"]["lpu_nodes"] = kube_nodes_by_label("aegis/lpu=generic")
+    inv["nodes"]["npu_nodes"] = kube_nodes_by_label("aegis/npu")
+    inv["nodes"]["rt_nodes"] = kube_nodes_by_label("aegis/rt=true")
+
+    # credentials presence (non-exhaustive)
+    inv["creds"]["ACME_HIL"] = bool(os.environ.get("ACME_HIL_URL") and os.environ.get("ACME_HIL_TOKEN"))
+    inv["creds"]["IONQ"] = bool(os.environ.get("IONQ_API_KEY"))
+    inv["creds"]["GCP"] = bool(os.environ.get("GCP_PROJECT") or run_cmd(["which", "gcloud"]))
+    inv["creds"]["AWS"] = bool(os.environ.get("AWS_ACCESS_KEY_ID") or os.environ.get("AWS_REGION"))
+    inv["creds"]["KUBECONFIG"] = bool(os.environ.get("KUBECONFIG") or run_cmd(["kubectl","config","current-context"]))
+
+    # quick driver checks
+    inv["drivers"] = {}
+    inv["drivers"]["nvidia_smi"] = bool(run_cmd(["which","nvidia-smi"]))
+    inv["drivers"]["libedgetpu"] = bool(run_cmd(["sh","-c","ldconfig -p 2>/dev/null | grep libedgetpu || true"]))
+    inv["drivers"]["neuron"] = bool(run_cmd(["which","neuron-cc"]))
+    inv["drivers"]["habana"] = bool(run_cmd(["sh","-c","ldconfig -p 2>/dev/null | grep habana || true"]))
+
+    with open(OUT,"w") as fh:
+        json.dump(inv, fh, indent=2)
+    print("Wrote hardware inventory to", OUT)
+    return inv
+
+if __name__ == "__main__":
+    check()
+
