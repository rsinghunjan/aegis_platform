+#!/usr/bin/env python3
+"""
+Extended Quantization Test Suite
+
+Runs a battery of statistical checks comparing baseline and quantized outputs:
+ - Mean absolute error
+ - Max absolute error
+ - Per-class drift summary
+ - Simple KS-like distribution comparison (if scipy available)
+Writes /tmp/quant_suite_report.json and exits non-zero on failure.
+"""
+import argparse, json, statistics, sys
+from collections import defaultdict
+
+OUT="/tmp/quant_suite_report.json"
+
+def load_jsonl(path):
+    with open(path) as fh:
+        return [json.loads(l) for l in fh]
+
+def flatten_numeric(d):
+    vals=[]
+    for k,v in d.items():
+        if isinstance(v,(int,float)):
+            vals.append(v)
+    return vals
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--baseline", required=True)
+    p.add_argument("--quant", required=True)
+    p.add_argument("--tol", type=float, default=1e-2)
+    args=p.parse_args()
+    base = load_jsonl(args.baseline)
+    q = load_jsonl(args.quant)
+    if len(base)!=len(q):
+        print("Length mismatch"); sys.exit(2)
+    abs_errs=[]
+    per_class=defaultdict(list)
+    for a,b in zip(base,q):
+        for k in a:
+            if isinstance(a[k], (int,float)):
+                err = abs(a[k]-b.get(k,0.0))
+                abs_errs.append(err)
+                per_class[k].append(err)
+    report = {"count": len(abs_errs), "mean_abs": statistics.mean(abs_errs) if abs_errs else 0.0, "max_abs": max(abs_errs) if abs_errs else 0.0, "per_class": {}}
+    for k,v in per_class.items():
+        report["per_class"][k] = {"mean": statistics.mean(v), "max": max(v)}
+    report["ok"] = report["mean_abs"] <= args.tol
+    open(OUT,"w").write(json.dumps(report, indent=2))
+    print("Wrote", OUT)
+    if not report["ok"]:
+        sys.exit(2)
+
+if __name__=="__main__":
+    main()
+
