+#!/usr/bin/env python3
+"""
+Vault helper to fetch secrets into environment for ephemeral CI steps.
+
+Approach:
+- Prefer hvac (python) if available; fallback to 'vault' CLI.
+- Writes a small env file to /tmp/aegis_vault_env.sh for sourcing in CI steps.
+"""
+import os
+import json
+from pathlib import Path
+
+OUT="/tmp/aegis_vault_env.sh"
+
+def read_from_vault_cli(path, key):
+    import subprocess
+    try:
+        val = subprocess.check_output(["vault","kv","get","-field=value", f"secret/{path}"], text=True).strip()
+        return {key: val}
+    except Exception as e:
+        return {}
+
+def fetch(secrets):
+    env_pairs = {}
+    # try hvac
+    try:
+        import hvac
+        client = hvac.Client(url=os.environ.get("VAULT_ADDR"), token=os.environ.get("VAULT_TOKEN"))
+        for s in secrets:
+            try:
+                d = client.secrets.kv.v2.read_secret_version(path=s)
+                data = d["data"]["data"]
+                for k,v in data.items():
+                    env_pairs[k] = v
+            except Exception:
+                pass
+    except Exception:
+        # fallback to vault CLI if present
+        for s in secrets:
+            env_pairs.update(read_from_vault_cli(s, s))
+    # write to shell file
+    with open(OUT,"w") as fh:
+        for k,v in env_pairs.items():
+            fh.write(f"export {k}='{v}'\n")
+    print("Wrote vault env file to", OUT)
+    return OUT
+
+if __name__ == "__main__":
+    # example usage: fetch a list from ops/security/required_secrets.txt
+    path = "ops/security/required_secrets.txt"
+    secrets = []
+    if os.path.exists(path):
+        secrets = [l.strip() for l in open(path) if l.strip()]
+    if secrets:
+        fetch(secrets)
+    else:
+        print("No secrets list found at", path)
+
