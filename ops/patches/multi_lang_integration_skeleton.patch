+import express from "express";
+import bodyParser from "body-parser";
+const app = express();
+app.use(bodyParser.json());
+
+// Admission-like endpoint (PoC): accepts image info and returns accept/deny
+app.post("/admit", (req, res) => {
+  const pod = req.body;
+  // PoC policy: require annotation "aegis.cosign/signed" === "true" on pod metadata
+  const annotations = pod?.metadata?.annotations || {};
+  if (annotations["aegis.cosign/signed"] === "true") {
+    return res.json({ allowed: true, reason: "signed-annotation-present" });
+  }
+  // Optionally, call out to cosign-verifier service
+  // For demo, deny
+  return res.json({ allowed: false, reason: "missing-cosign-signature" });
+});
+
+app.get("/healthz", (_, res) => res.send("ok"));
+
+const port = process.env.PORT ? parseInt(process.env.PORT) : 8080;
+app.listen(port, () => {
+  console.log(`Aegis Node webhook listening on ${port}`);
+});
+
