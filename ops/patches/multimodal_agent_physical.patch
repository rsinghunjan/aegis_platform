+    # PoC heuristic: measure overlap of named entities or numeric matches; here random
+    return [float(np.random.rand()) for _ in generated_texts]
+
+def conditional_likelihood(model, inputs, targets):
+    # If model exposes log_prob, call it; else return NaN
+    if hasattr(model, "log_prob"):
