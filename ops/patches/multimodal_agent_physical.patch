+#!/usr/bin/env python3
+"""
+Video ingestion adapter (PoC):
+ - Extract frames at a sampling rate
+ - Apply transforms (resize, normalize)
+Requires opencv-python
+"""
+import cv2
+import numpy as np
+
+def frames_from_video(path, fps=1, max_frames=None):
+    cap = cv2.VideoCapture(path)
+    video_fps = cap.get(cv2.CAP_PROP_FPS) or 30.0
+    step = max(1, int(video_fps / max(1, fps)))
+    frames = []
+    i = 0
+    while cap.isOpened():
+        ret, frame = cap.read()
+        if not ret:
+            break
+        if i % step == 0:
+            frames.append(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
+            if max_frames and len(frames) >= max_frames:
+                break
+        i += 1
+    cap.release()
+    return frames
+
+def resize_frame(frame, size=(224,224)):
+    return cv2.resize(frame, size)
+
+def normalize_frame(frame, mean=(0.485,0.456,0.406), std=(0.229,0.224,0.225)):
+    f = frame.astype(np.float32) / 255.0
+    f = (f - np.array(mean)) / np.array(std)
+    return f
+
