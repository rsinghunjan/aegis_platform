+def compute_fid(real_feats: np.ndarray, gen_feats: np.ndarray):
+    # PoC: simple mean-covariance Gaussian FID formula placeholder
+    mu1 = real_feats.mean(0)
+    mu2 = gen_feats.mean(0)
+    cov1 = np.cov(real_feats, rowvar=False)
+    cov2 = np.cov(gen_feats, rowvar=False)
+    diff = mu1 - mu2
+    fid = diff.dot(diff) + np.trace(cov1 + cov2 - 2 * (cov1 @ cov2)**0.5)
+    return float(np.abs(fid))
+
