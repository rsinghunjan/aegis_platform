+"""
+Image ingestion adapter: transforms, batching, augmentations and upload hooks.
+PoC: uses Pillow / torchvision compatible transforms.
+"""
+import os
+import io
+import json
+from PIL import Image, ImageOps, ImageFilter
+import numpy as np
+
+def load_image(path_or_bytes):
+    if isinstance(path_or_bytes, (bytes, bytearray)):
+        return Image.open(io.BytesIO(path_or_bytes)).convert("RGB")
+    return Image.open(path_or_bytes).convert("RGB")
+
+def resize(img, size=(256,256)):
+    return ImageOps.fit(img, size, Image.BILINEAR)
+
+def normalize(np_img, mean=(0.485,0.456,0.406), std=(0.229,0.224,0.225)):
+    return (np_img/255.0 - np.array(mean)) / np.array(std)
+
+def augment_random_flip(img):
+    if np.random.rand() > 0.5:
+        return ImageOps.mirror(img)
+    return img
+
+def augment_random_jitter(img):
+    return img.filter(ImageFilter.GaussianBlur(radius=np.random.rand()*1.5))
+
+def to_numpy(img):
+    return np.array(img).astype(np.float32)
+
+def batchify(list_of_arrays, batch_size=32):
+    """Yield batches of arrays"""
+    for i in range(0, len(list_of_arrays), batch_size):
+        yield np.stack(list_of_arrays[i:i+batch_size])
+
+if __name__ == "__main__":
+    # quick demo
+    import sys
+    p = sys.argv[1]
+    img = load_image(p)
+    img = resize(img, (224,224))
+    img = augment_random_flip(img)
+    arr = to_numpy(img)
