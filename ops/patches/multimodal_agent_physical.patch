+#!/usr/bin/env python3
+"""
+Agent execution sandbox (PoC):
+ - Runs a tool call or script in a confined subprocess with resource limits and timeout.
+ - NOTE: This is a PoC. For production use, run in container microVMs (gVisor, Firecracker), or use OS-level containers with strict seccomp and cgroups.
+"""
+import subprocess
+import resource
+import os, signal, time
+
+def set_limits(cpu_seconds=10, memory_bytes=256*1024*1024):
+    # set resource limits for the child process (POSIX)
+    resource.setrlimit(resource.RLIMIT_CPU, (cpu_seconds, cpu_seconds))
+    resource.setrlimit(resource.RLIMIT_AS, (memory_bytes, memory_bytes))
+
+def run_sandbox(cmd, timeout=30, cpu_seconds=5, memory_bytes=256*(1024**2)):
+    def preexec():
+        # put process in new process group
+        os.setpgrp()
+        set_limits(cpu_seconds=cpu_seconds, memory_bytes=memory_bytes)
+    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, preexec_fn=preexec)
+    try:
+        out, err = p.communicate(timeout=timeout)
+        return 0, out.decode(), err.decode()
+    except subprocess.TimeoutExpired:
+        os.killpg(p.pid, signal.SIGKILL)
+        return 124, "", "timeout"
+
+if __name__ == "__main__":
+    code, out, err = run_sandbox(["/bin/echo","hello"], timeout=5)
+    print(code, out, err)
