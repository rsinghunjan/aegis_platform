+OPA_URL = os.environ.get("OPA_URL", "http://localhost:8181/v1/data/aegis/action/allow")
+
+class ActionRequest(BaseModel):
+    action: str
+    params: dict = {}
+    user: str = "unknown"
+
+def opa_check(action_req: ActionRequest):
+    payload = {"input": {"action": action_req.action, "params": action_req.params, "user": action_req.user}}
+    try:
+        r = requests.post(OPA_URL, json=payload, timeout=5)
+        r.raise_for_status()
+        res = r.json()
+        allow = res.get("result", {}).get("allow", False)
+        return allow, res
+    except Exception as e:
+        return False, {"error": str(e)}
+
+@app.post("/action")
+def run_action(req: ActionRequest):
+    ok, detail = opa_check(req)
+    if not ok:
+        raise HTTPException(status_code=403, detail={"allowed": False, "reason": detail})
+    # Map action -> tool invocation (PoC)
+    if req.action == "exec_shell":
+        cmd = req.params.get("cmd")
+        if not cmd:
+            raise HTTPException(status_code=400, detail="cmd required")
+        code, out, err = run_sandbox(cmd.split(), timeout=int(req.params.get("timeout",30)))
+        # write audit to evidence store (best-effort)
+        # (in production: send to evidence service, include signed marker)
+        return {"code": code, "stdout": out, "stderr": err}
