+"""
+Unified preprocessing pipeline for images, audio and video.
+Abstracts adapters and provides a single entrypoint for training/eval pipelines.
+"""
+from typing import List, Dict
+from services.data.ingest.adapters import image_adapter, audio_adapter, video_adapter
+import numpy as np
+
+def preprocess_batch(samples: List[Dict], mode="train"):
+    """
+    samples: list of {"type":"image"/"audio"/"video", "path":...}
+    returns dict: {"images": batches, "audio": batches, "video": batches}
+    """
+    images, audios, videos = [], [], []
+    for s in samples:
+        t = s.get("type")
+        p = s.get("path")
+        if t == "image":
+            img = image_adapter.load_image(p)
+            img = image_adapter.resize(img, (224,224))
+            if mode == "train":
+                img = image_adapter.augment_random_flip(img)
+            images.append(image_adapter.to_numpy(img))
+        elif t == "audio":
+            y = audio_adapter.load_audio(p)
+            feats = audio_adapter.mel_spectrogram(y)
+            audios.append(feats)
+        elif t == "video":
+            frames = video_adapter.frames_from_video(p, fps=1, max_frames=8)
+            frames = [video_adapter.resize_frame(f,(224,224)) for f in frames]
+            videos.append(np.stack(frames))
+    out = {}
+    if images:
+        out["images"] = list(image_adapter.batchify(images, batch_size=32))
+    if audios:
+        out["audio"] = list(audio_adapter.batchify(audios, batch_size=8))
+    if videos:
+        out["video"] = videos
+    return out
