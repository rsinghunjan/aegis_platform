+#!/usr/bin/env python3
+"""
+Simple batching queue for inference requests to a generative model.
+Supports max_batch_size and timeout for flush.
+"""
+import time
+import threading
+
+class BatchingQueue:
+    def __init__(self, max_batch=8, timeout=0.1):
+        self.max_batch = max_batch
+        self.timeout = timeout
+        self.buffer = []
+        self.lock = threading.Lock()
+
+    def add(self, item):
+        with self.lock:
+            self.buffer.append(item)
+            if len(self.buffer) >= self.max_batch:
+                return self.flush()
+        # else wait timeout in background
+        t = threading.Timer(self.timeout, self._timer_flush)
+        t.start()
+        return None
+
+    def _timer_flush(self):
+        with self.lock:
+            if self.buffer:
+                self.flush()
+
+    def flush(self):
+        with self.lock:
+            batch = list(self.buffer)
+            self.buffer = []
+            return batch
+
