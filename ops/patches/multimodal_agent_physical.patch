+#!/usr/bin/env python3
+"""
+Audio ingestion adapter (PoC): resampling, mel-spectrogram, batching.
+Depends on librosa (optional). Provides fallback lightweight processing.
+"""
+import os
+import numpy as np
+
+try:
+    import librosa
+except Exception:
+    librosa = None
+
+def load_audio(path, sr=16000):
+    if librosa:
+        y, _ = librosa.load(path, sr=sr, mono=True)
+        return y
+    else:
+        # naive fallback (requires soundfile)
+        import soundfile as sf
+        y, rate = sf.read(path)
+        if rate != sr:
+            raise RuntimeError("Install librosa for resampling or provide matching sample rate")
+        return y
+
+def mel_spectrogram(y, sr=16000, n_mels=80, hop_length=160, win_length=400):
+    if librosa:
+        S = librosa.feature.melspectrogram(y, sr=sr, n_mels=n_mels, hop_length=hop_length, win_length=win_length)
+        return librosa.power_to_db(S, ref=np.max)
+    else:
+        # fallback: return raw frames shaped (n_frames,1)
+        n_frames = len(y) // hop_length
+        frames = np.array([y[i*hop_length:i*hop_length+win_length] for i in range(n_frames)])
+        return frames
+
+def batchify(list_of_feats, batch_size=16, pad_value=0.0):
+    # simple ragged to padded batching
+    maxlen = max(f.shape[0] for f in list_of_feats)
+    out = np.full((len(list_of_feats), maxlen, *list_of_feats[0].shape[1:]), pad_value, dtype=np.float32)
+    for i,f in enumerate(list_of_feats):
+        out[i,:f.shape[0],...] = f
+    for i in range(0, len(out), batch_size):
+        yield out[i:i+batch_size]
+
