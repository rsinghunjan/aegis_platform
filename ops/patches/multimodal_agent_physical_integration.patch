+#!/usr/bin/env python3
+"""
+Multimodal data adapters: images, audio, video and simple dataset wrappers.
+Provides transforms, batching and augmentation hooks used by training/eval pipelines.
+PoC: requires Pillow, numpy, librosa (optional), and opencv-python (optional).
+"""
+from typing import List, Iterable, Dict, Any, Tuple
+import numpy as np
+import os
+
+### Image helpers (Pillow)
+try:
+    from PIL import Image, ImageOps, ImageFilter
+except Exception:
+    Image = None
+
+def load_image(path: str):
+    if Image is None:
+        raise RuntimeError("Pillow required for image processing")
+    return Image.open(path).convert("RGB")
+
+def image_transform(img, size=(224,224), augment=False):
+    img = ImageOps.fit(img, size, Image.BILINEAR)
+    if augment:
+        if np.random.rand() > 0.5:
+            img = ImageOps.mirror(img)
+        if np.random.rand() > 0.8:
+            img = img.filter(ImageFilter.GaussianBlur(radius=1.0))
+    return np.asarray(img).astype(np.float32) / 255.0
+
+def batch_images(arrays: List[np.ndarray], batch_size: int = 32):
+    for i in range(0, len(arrays), batch_size):
+        yield np.stack(arrays[i:i+batch_size])
+
+### Audio helpers (librosa fallback)
+try:
+    import librosa
+except Exception:
+    librosa = None
+
+def load_audio(path: str, sr: int = 16000):
+    if librosa:
+        y, _ = librosa.load(path, sr=sr, mono=True)
+        return y
+    else:
+        raise RuntimeError("librosa is required for audio processing")
+
+def audio_to_mel(y, sr=16000, n_mels=80, hop_length=160, win_length=400):
+    S = librosa.feature.melspectrogram(y=y, sr=sr, n_mels=n_mels, hop_length=hop_length, win_length=win_length)
+    return librosa.power_to_db(S, ref=np.max)
+
+def batch_audio(feats: List[np.ndarray], batch_size: int = 8, pad_value: float = 0.0):
+    # pad to max length
+    maxlen = max(f.shape[1] for f in feats)
+    out = np.full((len(feats), feats[0].shape[0], maxlen), pad_value, dtype=np.float32)
+    for i,f in enumerate(feats):
+        out[i,:,:f.shape[1]] = f
+    for i in range(0, len(out), batch_size):
+        yield out[i:i+batch_size]
+
+### Video helpers (opencv)
+try:
+    import cv2
+except Exception:
+    cv2 = None
+
+def extract_frames(path: str, sample_fps: int = 1, max_frames: int = 16):
+    if cv2 is None:
+        raise RuntimeError("opencv-python required for video processing")
+    cap = cv2.VideoCapture(path)
+    src_fps = cap.get(cv2.CAP_PROP_FPS) or 30.0
+    step = max(1, int(src_fps // max(1, sample_fps)))
+    frames = []
+    i = 0
+    while cap.isOpened() and len(frames) < max_frames:
+        ok, frame = cap.read()
+        if not ok:
+            break
+        if i % step == 0:
+            frames.append(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
+        i += 1
+    cap.release()
+    return frames
+
+def process_video_frames(frames: List[Any], size=(224,224)):
+    out = []
+    for f in frames:
+        if cv2 is None:
+            continue
+        f_resized = cv2.resize(f, size)
+        out.append(f_resized.astype(np.float32)/255.0)
+    return np.stack(out) if out else np.zeros((0,*size,3), dtype=np.float32)
+
+### Generic dataset iterator
+def iterate_samples(manifest: Iterable[Dict[str, Any]]):
+    """
+    manifest: iterable of {"id":..., "type":"image|audio|video|text", "path":...}
+    Yields preprocessed entries.
+    """
+    for entry in manifest:
+        t = entry.get("type")
+        p = entry.get("path")
+        if t == "image":
+            img = load_image(p)
+            arr = image_transform(img, augment=entry.get("augment", False))
+            yield {"id": entry.get("id"), "type": "image", "data": arr}
+        elif t == "audio":
+            y = load_audio(p)
+            feats = audio_to_mel(y)
+            yield {"id": entry.get("id"), "type": "audio", "data": feats}
+        elif t == "video":
+            frames = extract_frames(p, sample_fps=entry.get("fps",1), max_frames=entry.get("max_frames",8))
+            v = process_video_frames(frames)
+            yield {"id": entry.get("id"), "type": "video", "data": v}
+        else:
+            yield {"id": entry.get("id"), "type": "text", "data": entry.get("text")}
+
