+#!/usr/bin/env python3
+"""
+Audit logger for agent actions.
+Writes immutable JSON events to S3 (evidence bucket) with timestamps and signatures (cosign signing is external).
+"""
+import json
+import os
+import time
+
+def log_event(evidence_bucket: str, event: dict):
+    """
+    event must include: {action, user, params, result, ts}
+    """
+    import boto3, tempfile
+    s3=boto3.client("s3")
+    bucket=evidence_bucket.replace("s3://","")
+    ts = int(time.time() * 1000)
+    path = tempfile.mktemp(suffix=".json")
+    with open(path,"w") as f:
+        json.dump(event, f, indent=2)
+    key = f"agents/audit/event-{ts}.json"
+    s3.upload_file(path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
