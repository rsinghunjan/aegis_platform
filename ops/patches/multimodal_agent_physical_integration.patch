+#!/usr/bin/env python3
+"""
+Emergency stop (E-STOP) stub (non-destructive PoC).
+ - Exposes a simple HTTP toggle for E-STOP state.
+ - In production, integrate with hardware controller or safety bus.
+"""
+from http.server import BaseHTTPRequestHandler, HTTPServer
+import threading
+import json
+
+STATE = {"estop": False}
+
+class Handler(BaseHTTPRequestHandler):
+    def _write(self, data, code=200):
+        self.send_response(code)
+        self.send_header("Content-Type", "application/json")
+        self.end_headers()
+        self.wfile.write(json.dumps(data).encode())
+
+    def do_GET(self):
+        if self.path == "/status":
+            self._write({"estop": STATE["estop"]})
+        else:
+            self._write({"error":"not found"}, 404)
+
+    def do_POST(self):
+        if self.path == "/trigger":
+            STATE["estop"]=True
+            self._write({"estop":True})
+        elif self.path == "/reset":
+            STATE["estop"]=False
+            self._write({"estop":False})
+        else:
+            self._write({"error":"not found"}, 404)
+
+def run_server(port=9001):
+    srv = HTTPServer(("0.0.0.0", port), Handler)
+    t = threading.Thread(target=srv.serve_forever, daemon=True)
+    t.start()
+    return srv
+
+if __name__ == "__main__":
+    s = run_server()
+    print("E-STOP stub running on :9001 (POST /trigger to engage, /reset to clear)")
+    try:
+        while True:
+            pass
+    except KeyboardInterrupt:
+        s.shutdown()
+
