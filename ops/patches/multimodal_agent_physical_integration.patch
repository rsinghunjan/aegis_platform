+#!/usr/bin/env python3
+"""
+Agent runtime orchestrator (PoC):
+ - Provides run() to execute a decision loop safely using sandbox and audit logging
+ - Integrates with action API and OPA gating (delegated)
+"""
+from services.agents.sandbox.sandbox_runner import run_sandbox
+from services.agents.audit.audit_logger import log_event
+import time
+import os
+
+def agent_execute_action(evidence_bucket, user, action, params):
+    # perform OPA check via action API in production; here we assume caller already checked
+    start = time.time()
+    if action == "exec_shell":
+        cmd = params.get("cmd")
+        timeout = int(params.get("timeout", 30))
+        code, out, err = run_sandbox(cmd.split(), timeout=timeout)
+        ev = {"ts": time.time(), "user": user, "action": action, "params": params, "result": {"code": code}}
+        uri = log_event(evidence_bucket, ev) if evidence_bucket else None
+        return {"code": code, "stdout": out, "stderr": err, "audit_uri": uri}
+    return {"ok": False, "error": "unsupported action"}
