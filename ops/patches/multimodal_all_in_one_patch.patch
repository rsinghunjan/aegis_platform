+#!/usr/bin/env python3
+"""
+Embedding drift detector
+- Loads baseline and recent embeddings (npz), computes mean cosine distance and flags drift
+- Emits a simple metric to Pushgateway if configured
+"""
+import os, sys, numpy as np
+from sklearn.metrics.pairwise import cosine_similarity
+from prometheus_client import CollectorRegistry, Gauge, push_to_gateway
+
+BASELINE = os.environ.get("BASELINE_EMBEDDINGS_PATH", "/data/baseline_embeddings.npz")
+RECENT = os.environ.get("RECENT_EMBEDDINGS_PATH", "/data/recent_embeddings.npz")
+THRESH = float(os.environ.get("DRIFT_THRESHOLD", "0.15"))
+PUSHGW = os.environ.get("PUSHGATEWAY", "")
+
+def load_emb(path):
+    if not os.path.exists(path):
+        print("Missing embeddings", path); return None
+    d = np.load(path)
+    return d.get("embeddings")
+
+def cosine_dist(a,b):
+    cs = cosine_similarity(a, b)
+    return 1.0 - cs.mean()
+
+def main():
+    a = load_emb(BASELINE); b = load_emb(RECENT)
+    if a is None or b is None:
+        print("Embeddings missing, cannot compute drift"); sys.exit(2)
+    dist = cosine_dist(a, b)
+    print("Embedding drift:", dist)
+    if PUSHGW:
+        reg = CollectorRegistry()
+        g = Gauge("aegis_multimodal_embedding_drift", "Embedding drift (1-cosine_sim)", registry=reg)
