+#!/usr/bin/env python3
+"""
+Image preprocessing microservice
+- Resize, thumbnail, basic augmentations (flip, color jitter)
+- Accepts file upload (multipart/form-data) or URL (json body)
+- Returns JSON with paths to processed images (on local disk or PVC) and basic metadata
+"""
+from fastapi import FastAPI, File, UploadFile, HTTPException
+from pydantic import BaseModel
+from PIL import Image, ImageOps, ImageEnhance
+import io, os, uuid, requests
+
+app = FastAPI(title="Aegis Image Preprocess Service")
+
+OUT_DIR = os.environ.get("MM_IMAGE_OUT", "/workspace/mm_images")
+os.makedirs(OUT_DIR, exist_ok=True)
+
+class URLPayload(BaseModel):
+    url: str
+    resize: tuple = (224, 224)
+    thumbnail: tuple = (128, 128)
+    do_augment: bool = False
+
+def save_image(img: Image.Image, name: str):
+    path = os.path.join(OUT_DIR, name)
+    img.save(path, format="PNG")
+    return path
+
+def augment_image(img: Image.Image):
+    # simple augmentations
+    if img.mode != "RGB":
+        img = img.convert("RGB")
+    img = ImageOps.mirror(img) if uuid.uuid4().int % 2 == 0 else img
+    enhancer = ImageEnhance.Color(img)
+    img = enhancer.enhance(1.1)
+    return img
+
+@app.post("/process/upload")
+async def process_upload(file: UploadFile = File(...), resize: int = 224, thumbnail: int = 128, augment: bool = False):
+    data = await file.read()
+    try:
+        img = Image.open(io.BytesIO(data))
+    except Exception as e:
+        raise HTTPException(status_code=400, detail=f"invalid image: {e}")
+    base = uuid.uuid4().hex
+    resized = img.resize((resize, resize))
+    resized_path = save_image(resized, f"{base}_resized.png")
+    thumb = img.copy()
+    thumb.thumbnail((thumbnail, thumbnail))
+    thumb_path = save_image(thumb, f"{base}_thumb.png")
+    aug_path = None
+    if augment:
+        aug = augment_image(img)
+        aug_path = save_image(aug, f"{base}_aug.png")
+    return {"resized": resized_path, "thumbnail": thumb_path, "augmented": aug_path}
+
+@app.post("/process/url")
+def process_url(payload: URLPayload):
+    r = requests.get(payload.url, timeout=10)
+    if r.status_code != 200:
+        raise HTTPException(status_code=400, detail="failed to fetch url")
+    try:
+        img = Image.open(io.BytesIO(r.content))
+    except Exception as e:
+        raise HTTPException(status_code=400, detail=f"invalid image: {e}")
+    base = uuid.uuid4().hex
+    resized = img.resize(tuple(payload.resize))
+    resized_path = save_image(resized, f"{base}_resized.png")
+    thumb = img.copy()
+    thumb.thumbnail(tuple(payload.thumbnail))
+    thumb_path = save_image(thumb, f"{base}_thumb.png")
+    aug_path = None
+    if payload.do_augment:
+        aug = augment_image(img)
+        aug_path = save_image(aug, f"{base}_aug.png")
+    return {"resized": resized_path, "thumbnail": thumb_path, "augmented": aug_path}
