+#!/usr/bin/env python3
+"""
+Adversarial image suite (multimodal)
+- Loads sample images from manifest, applies perturbations (noise, blur, brightness)
+- Sends original and perturbed images to model endpoint and compares outputs via embedding distance
+- Produces a JSON report and exits non-zero if any attack causes large embedding drift
+"""
+import json, os, sys, io
+from PIL import Image, ImageFilter, ImageEnhance
+import numpy as np
+import requests
+from hashlib import sha256
+
+MANIFEST = "ops/multimodal/sample_image_manifest.jsonl"
+MODEL_URL = os.environ.get("MM_MODEL_URL", "http://triton-clip:8000/v2/models/clip/versions/1/infer")
+THRESH = float(os.environ.get("MM_ADV_THRESH", "0.25"))
+
+def load_manifest(path):
+    rows=[]
+    for l in open(path):
+        if not l.strip(): continue
+        rows.append(json.loads(l))
+    return rows
+
+def perturb(image: Image.Image, kind: str):
+    if kind == "noise":
+        arr = np.array(image).astype(np.float32)/255.0
+        arr = np.clip(arr + np.random.normal(0,0.05,arr.shape), 0, 1)
+        return Image.fromarray((arr*255).astype('uint8'))
+    if kind == "blur":
+        return image.filter(ImageFilter.GaussianBlur(radius=2))
+    if kind == "bright":
+        enhancer = ImageEnhance.Brightness(image)
+        return enhancer.enhance(0.6)
+    return image
+
+def image_to_bytes(image):
+    buf = io.BytesIO()
+    image.save(buf, format="PNG")
+    buf.seek(0)
+    return buf.read()
+
+def get_embedding(image_bytes):
+    # This depends on model endpoint; here we expect a simple REST endpoint that returns embedding vector JSON
+    try:
+        resp = requests.post(MODEL_URL, files={"image": image_bytes}, timeout=10)
+        resp.raise_for_status()
+        return resp.json().get("embedding")
+    except Exception as e:
+        print("Model request failed:", e); return None
+
+def l2(a,b):
+    a = np.array(a); b = np.array(b)
+    return float(np.linalg.norm(a-b))
+
+def main():
+    rows = load_manifest(MANIFEST)
+    report = []
+    failed = False
+    for r in rows:
+        path = r["path"]
+        if not os.path.exists(path):
+            print("Missing sample", path); continue
+        img = Image.open(path).convert("RGB").resize((224,224))
+        orig = get_embedding(image_to_bytes(img))
+        if orig is None:
+            print("No orig embedding, skipping", path); continue
+        for attack in ["noise","blur","bright"]:
+            pert = perturb(img, attack)
+            emb = get_embedding(image_to_bytes(pert))
+            if emb is None:
+                continue
+            dist = l2(orig, emb)
+            report.append({"id": r["id"], "attack": attack, "dist": dist})
+            if dist > THRESH:
+                print("Adversarial attack caused large drift:", r["id"], attack, dist)
+                failed = True
+    with open("/workspace/adversarial_image_report.json","w") as f:
+        json.dump(report,f,indent=2)
+    if failed:
+        sys.exit(2)
+    print("Adversarial image suite passed")
+
+if __name__=="__main__":
+    main()
+
