+#!/usr/bin/env python3
+"""
+Video preprocessing microservice
+- Extract frames (sampled at interval or fps), optionally resize
+- Requires ffmpeg installed in container
+"""
+from fastapi import FastAPI, File, UploadFile, HTTPException, Query
+from pydantic import BaseModel
+import os, uuid, subprocess, shutil
+
+app = FastAPI(title="Aegis Video Preprocess Service")
+OUT_DIR = os.environ.get("MM_VIDEO_OUT", "/workspace/mm_video")
+os.makedirs(OUT_DIR, exist_ok=True)
+
+class URLPayload(BaseModel):
+    url: str
+    fps: float = 1.0
+    resize: tuple = (224, 224)
+
+def extract_frames(video_path, out_prefix, fps=1.0, resize=None):
+    # ffmpeg -i input.mp4 -r 1 -vf "scale=224:224" out_%04d.png
+    args = ["ffmpeg", "-y", "-i", video_path, "-r", str(fps)]
+    if resize:
+        args += ["-vf", f"scale={resize[0]}:{resize[1]}"]
+    args += [f"{out_prefix}_%04d.png"]
+    subprocess.check_call(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+@app.post("/video/upload")
+async def video_upload(file: UploadFile = File(...), fps: float = Query(1.0), resize_w: int = Query(224), resize_h: int = Query(224)):
+    data = await file.read()
+    tmp = os.path.join(OUT_DIR, f"{uuid.uuid4().hex}.mp4")
+    with open(tmp, "wb") as f:
+        f.write(data)
+    base = os.path.join(OUT_DIR, uuid.uuid4().hex)
+    try:
+        extract_frames(tmp, base, fps=fps, resize=(resize_w, resize_h))
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"ffmpeg extract failed: {e}")
+    frames = [p for p in os.listdir(OUT_DIR) if p.startswith(os.path.basename(base))]
+    frames = [os.path.join(OUT_DIR, p) for p in frames]
+    return {"frames": frames}
+
+@app.post("/video/url")
+def video_url(payload: URLPayload):
+    tmp = os.path.join(OUT_DIR, f"{uuid.uuid4().hex}.mp4")
+    r = requests.get(payload.url, stream=True, timeout=30)
+    if r.status_code != 200:
+        raise HTTPException(status_code=400, detail="failed to fetch url")
+    with open(tmp, "wb") as f:
+        shutil.copyfileobj(r.raw, f)
+    base = os.path.join(OUT_DIR, uuid.uuid4().hex)
+    try:
+        extract_frames(tmp, base, fps=payload.fps, resize=tuple(payload.resize))
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"ffmpeg extract failed: {e}")
+    frames = [p for p in os.listdir(OUT_DIR) if p.startswith(os.path.basename(base))]
+    frames = [os.path.join(OUT_DIR, p) for p in frames]
+    return {"frames": frames}
