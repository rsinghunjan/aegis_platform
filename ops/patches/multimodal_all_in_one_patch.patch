+#!/usr/bin/env python3
+"""
+Audio preprocessing microservice
+- Accepts audio upload (wav/mp3) or URL
+- Produces spectrogram PNG and Numpy .npy of mel-spectrogram
+"""
+from fastapi import FastAPI, File, UploadFile, HTTPException
+from pydantic import BaseModel
+import os, uuid, io, requests
+import numpy as np
+import librosa, soundfile as sf
+import matplotlib.pyplot as plt
+
+app = FastAPI(title="Aegis Audio Preprocess Service")
+OUT_DIR = os.environ.get("MM_AUDIO_OUT", "/workspace/mm_audio")
+os.makedirs(OUT_DIR, exist_ok=True)
+
+class URLPayload(BaseModel):
+    url: str
+    sr: int = 16000
+    n_mels: int = 128
+
+def save_spectrogram(spec, path_png, sr=16000):
+    plt.figure(figsize=(6,3))
+    plt.imshow(spec, aspect='auto', origin='lower')
+    plt.axis('off')
+    plt.tight_layout()
+    plt.savefig(path_png, bbox_inches='tight', pad_inches=0)
+    plt.close()
+
+@app.post("/audio/upload")
+async def audio_upload(file: UploadFile = File(...), sr: int = 16000, n_mels: int = 128):
+    data = await file.read()
+    tmp = os.path.join(OUT_DIR, f"{uuid.uuid4().hex}.tmp")
+    with open(tmp, "wb") as f:
+        f.write(data)
+    try:
+        y, _ = librosa.load(tmp, sr=sr, mono=True)
+    except Exception as e:
+        raise HTTPException(status_code=400, detail=f"failed to load audio: {e}")
+    mel = librosa.feature.melspectrogram(y, sr=sr, n_mels=n_mels)
+    mel_db = librosa.power_to_db(mel, ref=np.max)
+    base = uuid.uuid4().hex
+    png = os.path.join(OUT_DIR, f"{base}_mel.png")
+    npy = os.path.join(OUT_DIR, f"{base}_mel.npy")
+    save_spectrogram(mel_db, png, sr=sr)
+    np.save(npy, mel_db)
+    return {"mel_png": png, "mel_npy": npy}
+
