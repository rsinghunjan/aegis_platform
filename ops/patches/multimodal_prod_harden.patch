+#!/usr/bin/env python3
+"""
+Validate kernel autotuner result for vision workloads and bake into Triton configmap
+ - Expects ops/triton/backend/kernel_best_config_vision.json to exist
+ - Runs validate_kernel_results.py and then writes a configmap kernel-best-config-vision
+"""
+import os, subprocess, sys
+
+CONFIG_PATH = os.environ.get("KERNEL_CONFIG_PATH", "ops/triton/backend/kernel_best_config_vision.json")
+NAMESPACE = os.environ.get("TRITON_NAMESPACE", "inference")
+
+def main():
+    if not os.path.exists(CONFIG_PATH):
+        print("No kernel config found at", CONFIG_PATH); sys.exit(2)
+    # validate (assumes script exists)
+    subprocess.check_call(["python","services/triton/kernel_opt/validate_kernel_results.py", CONFIG_PATH])
+    # create configmap
+    subprocess.check_call(["kubectl","-n",NAMESPACE,"create","configmap","kernel-best-config-vision","--from-file="+CONFIG_PATH,"--dry-run=client","-o","yaml"], stdout=open("/tmp/cm.yaml","wb"))
+    subprocess.check_call(["kubectl","-n",NAMESPACE,"apply","-f","/tmp/cm.yaml"])
+    print("Applied kernel-best-config-vision configmap")
+    # optionally rollout triton server to pick up config (operator decision)
+    try:
+        subprocess.check_call(["kubectl","-n",NAMESPACE,"rollout","restart","deployment/triton-clip-backend"])
+    except Exception as e:
+        print("Could not restart triton deployment:", e)
+
+if __name__=="__main__":
+    main()
+
