+#!/usr/bin/env bash
+#
+# Helper to set lifecycle rules for an S3 bucket used to store multimodal datasets
+#
+if [ $# -lt 1 ]; then
+  echo "Usage: $0 <s3-bucket-name> [prefix]"
+  exit 2
+fi
+BUCKET=$1
+PREFIX=${2:-}
+
+cat > /tmp/lifecycle.json <<EOF
+{
+  "Rules": [
+    {
+      "ID": "MultimodalArchive",
+      "Prefix": "$PREFIX",
+      "Status": "Enabled",
+      "Transitions": [
+        {
+          "Days": 30,
+          "StorageClass": "STANDARD_IA"
+        },
+        {
+          "Days": 365,
+          "StorageClass": "GLACIER"
+        }
+      ],
+      "NoncurrentVersionExpiration": {
+        "NoncurrentDays": 3650
+      }
+    }
+  ]
+}
+EOF
+
+aws s3api put-bucket-lifecycle-configuration --bucket "$BUCKET" --lifecycle-configuration file:///tmp/lifecycle.json
+echo "Applied lifecycle rules to s3://$BUCKET (prefix=$PREFIX)"
+
