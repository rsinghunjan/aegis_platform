+#!/usr/bin/env python3
+"""
+Daemon that ensures thumbnails/transcodes for objects in storage exist as first-class artifacts.
+ - Periodically scans metadata service for recent files without derivatives and creates them.
+ - Uploads derivative artifacts back to store and updates metadata via metadata service.
+"""
+import os, time, json
+from services.multimodal.metadata.register_dataset import register_file_entry
+from services.multimodal.storage.uploader import upload_to_storage
+from urllib.parse import urlparse
+from PIL import Image
+import requests, tempfile, shutil, subprocess
+
+METADATA_URL = os.environ.get("METADATA_URL", "http://metadata.svc")
+POLL_INTERVAL = int(os.environ.get("THUMB_DAEMON_INTERVAL_S", "300"))
+STORE_PREFIX = os.environ.get("MM_STORE_PREFIX", "")
+
+def fetch_recent_items():
+    try:
+        resp = requests.get(METADATA_URL.rstrip("/") + "/files/recent", timeout=10)
+        resp.raise_for_status()
+        return resp.json()
+    except Exception as e:
+        print("Failed to list recent metadata:", e)
+        return []
+
+def download_storage_uri(uri, local_path):
+    if uri.startswith("s3://"):
+        # require aws cli
+        subprocess.check_call(["aws","s3","cp",uri, local_path])
+    elif uri.startswith("file://"):
+        shutil.copy(uri[len("file://"):], local_path)
+    else:
+        # attempt HTTP GET
+        r = requests.get(uri, timeout=30)
+        r.raise_for_status()
+        with open(local_path, "wb") as f:
+            f.write(r.content)
+
+def ensure_derivs(item):
+    # only handle images and audio in daemon
+    modality = item.get("modality")
+    uri = item.get("storage_uri")
+    if not uri:
+        return
+    if modality == "image" and not item.get("derivatives", {}).get("thumbnail"):
+        tmp = tempfile.mktemp(suffix=".img")
+        try:
+            download_storage_uri(uri, tmp)
+            img = Image.open(tmp)
+            img.thumbnail((256,256))
+            tpath = tmp + "_thumb.png"
+            img.save(tpath, format="PNG")
+            up = upload_to_storage(tpath, object_name=f"{item['dataset_id']}/{item['id']}_thumb.png")
+            # update metadata - best effort
+            item.setdefault("derivatives",{})["thumbnail"] = up
+            requests.post(METADATA_URL.rstrip("/") + "/files/update", json={"id": item["id"], "derivatives": item["derivatives"]}, timeout=10)
+            print("Created thumbnail for", item["id"])
+        except Exception as e:
+            print("Thumbnail creation failed for", item["id"], e)
+        finally:
+            try: os.remove(tmp)
+            except: pass
+
+def main_loop():
+    while True:
+        items = fetch_recent_items()
+        for it in items:
+            ensure_derivs(it)
+        time.sleep(POLL_INTERVAL)
+
+if __name__=="__main__":
+    main_loop()
+
