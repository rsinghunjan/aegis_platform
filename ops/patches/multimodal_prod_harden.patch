+import json,sys
+metrics = json.load(open('/workspace/metrics.json'))
+thresholds = json.load(open('$(inputs.params.thresholds-json)'))
+fail=False
+msgs=[]
+for k,v in thresholds.items():
+    if k not in metrics: continue
+    mv = metrics[k]
+    for sub,thr in v.items():
+        if mv.get(sub) is None: continue
+        if mv.get(sub) < thr:
+            fail=True
+            msgs.append(f"{k}.{sub} below threshold {mv.get(sub)} < {thr}")
+if fail:
+    print('Thresholds failed:', msgs)
+    sys.exit(2)
+print('Metrics pass thresholds')
+PY
