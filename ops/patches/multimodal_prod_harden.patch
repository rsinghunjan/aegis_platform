+#!/usr/bin/env python3
+"""
+Resumable ingestion service (simple chunked uploads)
+- Endpoints:
+  - POST /resumable/init  -> {upload_id, upload_url}
+  - PUT  /resumable/{upload_id}/chunk?offset=<n>  -> upload chunk bytes
+  - POST /resumable/{upload_id}/finalize -> assemble, compute sha256, create derivatives, upload, register
+  - GET  /resumable/{upload_id}/status -> progress info
+
+Persistence:
+- Stores chunks under MM_INGEST_TMP/<upload_id>/chunks/
+- Final assembled file is processed by existing ingestion helpers (thumbnail, transcode)
+"""
+import os, uuid, hashlib, shutil, time, json
+from fastapi import FastAPI, UploadFile, File, HTTPException, Body
+from pydantic import BaseModel
+from typing import Optional
+from services.multimodal.storage.uploader import upload_to_storage
+from services.multimodal.metadata.register_dataset import register_file_entry
+from PIL import Image
+import subprocess
+
+app = FastAPI(title="Aegis Resumable Ingest Service")
+
+TMP = os.environ.get("MM_INGEST_TMP", "/tmp/mm_ingest")
+OUT_DIR = os.environ.get("MM_INGEST_OUT", "/workspace/ingest")
+STORE_PREFIX = os.environ.get("MM_STORE_PREFIX", "")
+os.makedirs(TMP, exist_ok=True)
+os.makedirs(OUT_DIR, exist_ok=True)
+
+class InitRequest(BaseModel):
+    filename: str
+    modality: str
+    dataset_id: str
+    total_size: Optional[int] = None
+
+@app.post("/resumable/init")
+def init_upload(req: InitRequest):
+    uid = uuid.uuid4().hex
+    upload_dir = os.path.join(TMP, uid)
+    os.makedirs(os.path.join(upload_dir, "chunks"), exist_ok=True)
+    meta = {
+        "id": uid,
+        "filename": req.filename,
+        "modality": req.modality,
+        "dataset_id": req.dataset_id,
+        "total_size": req.total_size,
+        "created_at": int(time.time()),
+        "chunks": []
+    }
+    with open(os.path.join(upload_dir, "meta.json"), "w") as f:
+        json.dump(meta, f)
+    return {"upload_id": uid, "upload_url": f"/resumable/{uid}/chunk"}
+
+@app.put("/resumable/{upload_id}/chunk")
+async def upload_chunk(upload_id: str, offset: int = 0, chunk: UploadFile = File(...)):
+    upload_dir = os.path.join(TMP, upload_id)
+    if not os.path.exists(upload_dir):
+        raise HTTPException(status_code=404, detail="upload id not found")
+    chunk_dir = os.path.join(upload_dir, "chunks")
+    os.makedirs(chunk_dir, exist_ok=True)
+    # store chunk file named by offset to allow idempotent uploads
+    chunk_path = os.path.join(chunk_dir, f"{offset:020d}.chunk")
+    data = await chunk.read()
+    with open(chunk_path, "wb") as f:
+        f.write(data)
+    # update meta
+    meta_path = os.path.join(upload_dir, "meta.json")
+    meta = json.load(open(meta_path))
+    if offset not in meta.get("chunks", []):
+        meta["chunks"].append(offset)
+    with open(meta_path, "w") as f:
+        json.dump(meta, f)
+    return {"status": "ok", "offset": offset, "bytes": len(data)}
+
+@app.post("/resumable/{upload_id}/finalize")
+def finalize(upload_id: str):
+    upload_dir = os.path.join(TMP, upload_id)
+    if not os.path.exists(upload_dir):
+        raise HTTPException(status_code=404, detail="upload id not found")
+    meta = json.load(open(os.path.join(upload_dir, "meta.json")))
+    chunks_dir = os.path.join(upload_dir, "chunks")
+    chunk_files = sorted(os.listdir(chunks_dir))
+    assembled_path = os.path.join(OUT_DIR, f"{upload_id}_{meta['filename']}")
+    with open(assembled_path, "wb") as w:
+        for cf in chunk_files:
+            with open(os.path.join(chunks_dir, cf), "rb") as r:
+                shutil.copyfileobj(r, w)
+    # compute sha256
+    h = hashlib.sha256()
+    with open(assembled_path, "rb") as f:
+        for b in iter(lambda: f.read(8192), b""):
+            h.update(b)
+    sha = h.hexdigest()
+    # create derivatives depending on modality
+    derivatives = {}
+    try:
+        if meta["modality"] == "image":
+            thumb = os.path.join(OUT_DIR, f"{sha}_thumb.png")
+            img = Image.open(assembled_path)
+            img.thumbnail((256,256))
+            img.save(thumb, format="PNG")
+            derivatives["thumbnail"] = thumb
+        elif meta["modality"] == "audio":
+            wav = os.path.join(OUT_DIR, f"{sha}.wav")
+            subprocess.check_call(["ffmpeg","-y","-i", assembled_path, "-ar","16000","-ac","1", wav])
+            derivatives["wav"] = wav
+        elif meta["modality"] == "video":
+            frames_prefix = os.path.join(OUT_DIR, f"{sha}_frame")
+            subprocess.check_call(["ffmpeg","-y","-i", assembled_path, "-r","1", "-vf","scale=224:224", f"{frames_prefix}_%04d.png"])
+            frames = sorted([os.path.join(OUT_DIR,p) for p in os.listdir(OUT_DIR) if p.startswith(os.path.basename(frames_prefix))])
+            derivatives["frames"] = frames
+    except Exception as e:
+        # derivative creation best-effort
+        print("derivative creation failed", e)
+    # upload original and derivatives
+    storage_uri = upload_to_storage(assembled_path, object_name=f"{meta['dataset_id']}/{sha}_{meta['filename']}")
+    uploaded_derivs = {}
+    for k,v in derivatives.items():
+        if isinstance(v, list):
+            uploaded_derivs[k] = [upload_to_storage(p, object_name=f"{meta['dataset_id']}/{os.path.basename(p)}") for p in v]
+        else:
+            uploaded_derivs[k] = upload_to_storage(v, object_name=f"{meta['dataset_id']}/{os.path.basename(v)}")
+    manifest_entry = {
+        "id": sha,
+        "dataset_id": meta["dataset_id"],
+        "original_name": meta["filename"],
+        "modality": meta["modality"],
+        "storage_uri": storage_uri,
+        "derivatives": uploaded_derivs,
+        "sha256": sha,
+        "ingested_at": int(time.time())
+    }
+    try:
+        register_file_entry(manifest_entry)
+    except Exception as e:
+        print("metadata registration failed", e)
+    # cleanup
+    try:
+        shutil.rmtree(upload_dir)
+    except Exception:
+        pass
+    return {"manifest": manifest_entry}
+
+@app.get("/resumable/{upload_id}/status")
+def status(upload_id: str):
+    upload_dir = os.path.join(TMP, upload_id)
+    if not os.path.exists(upload_dir):
+        raise HTTPException(status_code=404, detail="upload id not found")
+    meta = json.load(open(os.path.join(upload_dir, "meta.json")))
+    chunks = sorted(meta.get("chunks", []))
+    return {"upload_id": upload_id, "metadata": meta, "received_chunks": chunks}
+
