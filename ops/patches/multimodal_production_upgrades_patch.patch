+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Package a model directory into a Triton-compatible model repository structure and optionally upload to storage prefix.
+#
+# Usage:
+#  ./scripts/package_triton_model.sh <local_model_dir> <model_name> [<storage_prefix>]
+#
+MODEL_DIR=${1:-}
+MODEL_NAME=${2:-vision_encoder}
+STORE_PREFIX=${3:-}
+
+if [ -z "$MODEL_DIR" ]; then
+  echo "Usage: $0 <local_model_dir> <model_name> [storage_prefix]"
+  exit 2
+fi
+
+OUT_REPO=/tmp/triton_repo_$(date +%s)
+mkdir -p "$OUT_REPO/$MODEL_NAME/1"
+cp -r "$MODEL_DIR"/* "$OUT_REPO/$MODEL_NAME/1/"
+
+# copy a matching config if present in k8s/triton/models
+if [ -f "k8s/triton/models/${MODEL_NAME}/config.pbtxt" ]; then
+  cp "k8s/triton/models/${MODEL_NAME}/config.pbtxt" "$OUT_REPO/$MODEL_NAME/config.pbtxt"
+fi
+
+echo "Packaged model at $OUT_REPO"
+if [ -n "$STORE_PREFIX" ]; then
+  # use gsutil or aws s3 cp depending on prefix
+  if [[ "$STORE_PREFIX" == s3://* ]]; then
+    aws s3 cp --recursive "$OUT_REPO/" "$STORE_PREFIX/$MODEL_NAME/" || true
+  elif [[ "$STORE_PREFIX" == gs://* ]]; then
+    gsutil -m cp -r "$OUT_REPO/*" "$STORE_PREFIX/$MODEL_NAME/" || true
+  else
+    mkdir -p "$STORE_PREFIX/$MODEL_NAME"
+    cp -r "$OUT_REPO/$MODEL_NAME" "$STORE_PREFIX/$MODEL_NAME/"
+  fi
+  echo "Uploaded to $STORE_PREFIX/$MODEL_NAME"
+fi
