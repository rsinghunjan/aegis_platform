+#!/usr/bin/env python3
+"""
+Audio adversarial/noise suite
+- Apply additive noise at several SNRs and measure embedding or classifier drift
+"""
+import json, os, sys, random
+import numpy as np
+import soundfile as sf
+import requests
+
+MANIFEST = "ops/multimodal/sample_audio_manifest.jsonl"
+MODEL_URL = os.environ.get("MM_AUDIO_MODEL_URL", "http://triton-audio:8000/v2/models/audio/versions/1/infer")
+THRESH = float(os.environ.get("AUDIO_ADV_THRESH", "0.2"))
+
+def load_manifest():
+    out=[]
+    for l in open(MANIFEST):
+        if not l.strip(): continue
+        out.append(json.loads(l))
+    return out
+
+def add_noise(y, snr_db):
+    # simple AWGN to achieve SNR
+    rms = np.sqrt(np.mean(y**2))
+    snr = 10**(snr_db/20.0)
+    noise_std = rms / snr
+    return y + np.random.normal(0, noise_std, size=y.shape)
+
+def get_embedding_from_server(wav_bytes):
+    try:
+        resp = requests.post(MODEL_URL, files={"audio": wav_bytes}, timeout=15)
+        resp.raise_for_status()
+        return resp.json().get("embedding")
+    except Exception as e:
+        print("model call failed", e); return None
+
+def main():
+    rows = load_manifest()
+    failed=False
+    for r in rows:
+        path = r["path"]
+        if not os.path.exists(path): continue
+        y, sr = sf.read(path)
+        # baseline
+        import io
+        buf = io.BytesIO(); sf.write(buf, y, sr, format='WAV'); buf.seek(0)
+        orig = get_embedding_from_server(buf.read())
+        if orig is None: continue
+        for snr in [20,10,5]:
+            y_noisy = add_noise(y, snr)
+            buf2 = io.BytesIO(); sf.write(buf2, y_noisy, sr, format='WAV'); buf2.seek(0)
+            emb = get_embedding_from_server(buf2.read())
+            if emb is None: continue
+            dist = np.linalg.norm(np.array(orig)-np.array(emb))
+            print("id", r["id"], "snr", snr, "dist", dist)
+            if dist > THRESH:
+                print("Audio adversarial drift exceeded threshold")
+                failed = True
+    if failed:
+        sys.exit(2)
+    print("Audio noise suite passed")
+
+if __name__=="__main__":
+    main()
+
