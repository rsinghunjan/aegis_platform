+#!/usr/bin/env python3
+"""
+Small helper to register file entries with central metadata service.
+Implements a thin client to call METADATA_URL /register endpoint.
+"""
+import os, requests, json
+
+METADATA_URL = os.environ.get("METADATA_URL", "http://metadata.svc")
+
+def register_file_entry(entry: dict):
+    url = METADATA_URL.rstrip("/") + "/files/register"
+    resp = requests.post(url, json=entry, timeout=10)
+    resp.raise_for_status()
+    return resp.json()
+
+if __name__=="__main__":
+    print("metadata registrar")
+
