+#!/usr/bin/env python3
+"""
+Multimodal evaluation metrics
+- Image: computes SSIM (structural similarity) and per-class ROC (if labels provided)
+- Audio: computes SNR and simple classification ROC
+- Exposes CLI to read predictions + labels and produce a metrics JSON
+"""
+import argparse, json, os
+import numpy as np
+from skimage.metrics import structural_similarity as ssim
+from sklearn.metrics import roc_auc_score
+import soundfile as sf
+
+def image_metrics(preds, refs):
+    # preds and refs are list of file paths
+    vals = []
+    for p,r in zip(preds, refs):
+        try:
+            from PIL import Image
+            ip = np.array(Image.open(p).convert("L"))
+            ir = np.array(Image.open(r).convert("L"))
+            v = ssim(ip, ir, data_range=ir.max()-ir.min())
+            vals.append(v)
+        except Exception:
+            vals.append(None)
+    return {"ssim_mean": float(np.nanmean([v for v in vals if v is not None])) if any(v is not None for v in vals) else None}
+
+def audio_snr(ref_path, pred_path):
+    # simple SNR estimate between reference and predicted waveform
+    try:
+        ref, _ = sf.read(ref_path)
+        pred, _ = sf.read(pred_path)
+        # trim to same length
+        n = min(len(ref), len(pred))
+        ref = ref[:n]; pred = pred[:n]
+        noise = ref - pred
+        snr = 10 * np.log10( (np.mean(ref**2) + 1e-9) / (np.mean(noise**2) + 1e-9) )
+        return snr
+    except Exception:
+        return None
+
+def classification_roc(labels, scores):
+    # labels: list of 0/1, scores: continuous
+    try:
+        return float(roc_auc_score(labels, scores))
+    except Exception:
+        return None
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--predictions", required=True, help="JSON lines: [{id, modality, pred_path, ref_path, label, score}]")
+    p.add_argument("--out", required=True)
+    args = p.parse_args()
+    rows = [json.loads(l) for l in open(args.predictions) if l.strip()]
+    out = {"image":{}, "audio":{}, "class_roc":{}}
+    # group by modality
+    imgs = [r for r in rows if r.get("modality")=="image" and r.get("pred_path") and r.get("ref_path")]
+    if imgs:
+        out["image"] = image_metrics([r["pred_path"] for r in imgs],[r["ref_path"] for r in imgs])
+    aud = [r for r in rows if r.get("modality")=="audio" and r.get("pred_path") and r.get("ref_path")]
+    if aud:
+        snrs = [audio_snr(r["ref_path"], r["pred_path"]) for r in aud]
+        snrs = [s for s in snrs if s is not None]
+        out["audio"] = {"snr_mean": float(np.mean(snrs)) if snrs else None}
+    # classification ROC by label (if labels & scores present)
+    cls = [r for r in rows if r.get("label") is not None and r.get("score") is not None]
+    if cls:
+        labels = [int(r["label"]) for r in cls]
+        scores = [float(r["score"]) for r in cls]
+        out["class_roc"] = {"roc_auc": classification_roc(labels, scores)}
+    with open(args.out,"w") as f:
+        json.dump(out, f, indent=2)
+    print("Wrote metrics to", args.out)
+
+if __name__=="__main__":
+    main()
+
