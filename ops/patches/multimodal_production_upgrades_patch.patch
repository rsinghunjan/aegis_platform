+#!/usr/bin/env python3
+"""
+Durable multimodal ingestion service
+- Accepts uploads for image/audio/video
+- Computes SHA256 content-addressed name, creates thumbnails / spectrograms / frames (where applicable),
+- Uploads artifacts to object storage (local path or S3) using uploader helper and returns manifest entry.
+- Registers dataset entry with metadata service.
+"""
+from fastapi import FastAPI, File, UploadFile, HTTPException, Form
+from pydantic import BaseModel
+import os, hashlib, uuid, subprocess, json, shutil, tempfile, time
+from PIL import Image
+from services.multimodal.storage.uploader import upload_to_storage
+from services.multimodal.metadata.register_dataset import register_file_entry
+
+app = FastAPI(title="Aegis Multimodal Ingest")
+
+OUT_DIR = os.environ.get("MM_INGEST_OUT", "/workspace/ingest")
+os.makedirs(OUT_DIR, exist_ok=True)
+TMP_DIR = os.environ.get("MM_INGEST_TMP", "/tmp")
+
+def sha256_file(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for b in iter(lambda: f.read(8192), b""):
+            h.update(b)
+    return h.hexdigest()
+
+def write_file_and_hash(upload_bytes, dest_path):
+    with open(dest_path, "wb") as f:
+        f.write(upload_bytes)
+    return sha256_file(dest_path)
+
+def make_thumbnail(image_path, out_path, size=(256,256)):
+    img = Image.open(image_path)
+    img.thumbnail(size)
+    img.save(out_path, format="PNG")
+
+def transcode_audio(in_path, out_path, sr=16000):
+    # requires ffmpeg
+    subprocess.check_call(["ffmpeg","-y","-i", in_path, "-ar", str(sr), "-ac", "1", out_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+def extract_frames(video_path, out_prefix, fps=1.0, resize=None):
+    args = ["ffmpeg","-y","-i", video_path, "-r", str(fps)]
+    if resize:
+        args += ["-vf", f"scale={resize[0]}:{resize[1]}"]
+    args += [f"{out_prefix}_%04d.png"]
+    subprocess.check_call(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+@app.post("/ingest/upload")
+async def ingest_upload(modality: str = Form(...), dataset_id: str = Form(...), file: UploadFile = File(...), ttl_days: int = Form(3650)):
+    """
+    modality: image|audio|video
+    dataset_id: logical dataset
+    """
+    if modality not in ("image","audio","video"):
+        raise HTTPException(status_code=400, detail="unsupported modality")
+    data = await file.read()
+    tmp_name = os.path.join(TMP_DIR, uuid.uuid4().hex + "_" + file.filename)
+    with open(tmp_name, "wb") as f:
+        f.write(data)
+    content_sha = sha256_file(tmp_name)
+    content_name = f"{content_sha}_{file.filename}"
+    dest_dir = os.path.join(OUT_DIR, dataset_id)
+    os.makedirs(dest_dir, exist_ok=True)
+    dest_path = os.path.join(dest_dir, content_name)
+    shutil.move(tmp_name, dest_path)
+
+    # derivative artifacts
+    derivatives = {}
+    if modality == "image":
+        thumb_path = os.path.join(dest_dir, f"{content_sha}_thumb.png")
+        make_thumbnail(dest_path, thumb_path, size=(256,256))
+        derivatives["thumbnail"] = thumb_path
+    elif modality == "audio":
+        wav_path = os.path.join(dest_dir, f"{content_sha}.wav")
+        transcode_audio(dest_path, wav_path)
+        derivatives["wav"] = wav_path
+    elif modality == "video":
+        frames_prefix = os.path.join(dest_dir, f"{content_sha}_frame")
+        extract_frames(dest_path, frames_prefix, fps=1.0, resize=(224,224))
+        # collect frames
+        frames = sorted([p for p in os.listdir(dest_dir) if p.startswith(os.path.basename(frames_prefix))])
+        derivatives["frames"] = [os.path.join(dest_dir,f) for f in frames]
+
+    # upload to storage (S3 or local object store)
+    storage_uri = upload_to_storage(dest_path, object_name=f"{dataset_id}/{content_name}")
+    uploaded_derivs = {}
+    for k,v in derivatives.items():
+        if isinstance(v, list):
+            uploaded_derivs[k] = [upload_to_storage(p, object_name=f"{dataset_id}/{os.path.basename(p)}") for p in v]
+        else:
+            uploaded_derivs[k] = upload_to_storage(v, object_name=f"{dataset_id}/{os.path.basename(v)}")
+
+    manifest_entry = {
+        "id": content_sha,
+        "dataset_id": dataset_id,
+        "original_name": file.filename,
+        "modality": modality,
+        "storage_uri": storage_uri,
+        "derivatives": uploaded_derivs,
+        "sha256": content_sha,
+        "ingested_at": int(time.time())
+    }
+
+    # register in metadata service (best-effort)
+    try:
+        register_file_entry(manifest_entry)
+    except Exception as e:
+        # do not abort ingestion on metadata failure
+        print("metadata registration failed:", e)
+
+    return {"manifest": manifest_entry}
+
