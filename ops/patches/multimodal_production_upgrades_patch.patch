+#!/usr/bin/env python3
+"""
+Storage uploader helper
+- Supports local prefix (file://) or S3 (s3://bucket/prefix)
+- Uses SSE-KMS when uploading to S3 if COSIGN_KMS_ARN provided
+"""
+import os, boto3, shutil
+from urllib.parse import urlparse
+
+DEFAULT_STORE = os.environ.get("MM_STORE_PREFIX", os.path.expanduser("~/mm_store"))
+S3_KEY_ARN = os.environ.get("COSIGN_KMS_ARN", "")
+AWS_REGION = os.environ.get("AWS_REGION", "us-west-2")
+
+def upload_to_storage(local_path, object_name=None):
+    """
+    If MM_STORE_PREFIX starts with s3://, upload to S3 under that prefix.
+    Otherwise, copy into local store under prefix/object_name (or basename).
+    Returns storage URI.
+    """
+    prefix = os.environ.get("MM_STORE_PREFIX", DEFAULT_STORE)
+    if prefix.startswith("s3://"):
+        parsed = urlparse(prefix)
+        bucket = parsed.netloc
+        base = parsed.path.lstrip("/")
+        key = f"{base.rstrip('/')}/{object_name}" if base else object_name
+        s3 = boto3.client("s3", region_name=AWS_REGION)
+        extra = {}
+        if S3_KEY_ARN:
+            extra["ServerSideEncryption"] = "aws:kms"
+            extra["SSEKMSKeyId"] = S3_KEY_ARN
+        s3.upload_file(local_path, bucket, key, ExtraArgs=extra)
+        return f"s3://{bucket}/{key}"
+    else:
+        dest_dir = os.path.join(prefix, os.path.dirname(object_name) if object_name else "")
+        os.makedirs(dest_dir, exist_ok=True)
+        dest_path = os.path.join(prefix, object_name if object_name else os.path.basename(local_path))
+        shutil.copy(local_path, dest_path)
+        return f"file://{dest_path}"
+
+if __name__=="__main__":
+    print("uploader module")
+
