+#!/usr/bin/env python3
+"""
+OCR drift test scaffold
+- Given a set of OCRed text outputs (baseline vs recent), compute n-gram / edit-distance drift and flag issues
+"""
+import json, os, sys
+from difflib import SequenceMatcher
+
+BASELINE = "ops/multimodal/ocr_baseline.jsonl"
+RECENT = "ops/multimodal/ocr_recent.jsonl"
+THRESH = float(os.environ.get("OCR_DRIFT_THRESH", "0.15"))
+
+def load(path):
+    out=[]
+    if os.path.exists(path):
+        for l in open(path):
+            if not l.strip(): continue
+            out.append(json.loads(l))
+    return out
+
+def norm_text(t):
+    return " ".join(t.lower().split())
+
+def similarity(a,b):
+    return SequenceMatcher(None, a, b).ratio()
+
+def main():
+    base = load(BASELINE)
+    recent = load(RECENT)
+    if not base or not recent:
+        print("No baseline/recent OCR data; skip")
+        sys.exit(0)
+    # align by id
+    base_map = {r["id"]: norm_text(r.get("text","")) for r in base}
+    total=0; scores=[]
+    for r in recent:
+        rid = r["id"]
+        if rid not in base_map: continue
+        total += 1
+        s = similarity(base_map[rid], norm_text(r.get("text","")))
+        scores.append(s)
+    if total==0:
+        print("No matching ids")
+        sys.exit(0)
+    avg_sim = sum(scores)/len(scores)
+    drift = 1.0 - avg_sim
+    print("OCR avg similarity:", avg_sim, "drift:", drift)
+    if drift > THRESH:
+        print("OCR drift detected")
+        sys.exit(2)
+    print("OCR drift within threshold")
+
+if __name__=="__main__":
+    main()
+
