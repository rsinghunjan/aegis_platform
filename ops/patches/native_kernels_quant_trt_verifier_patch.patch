+#!/usr/bin/env python3
+"""
+Compare outputs from baseline HF model vs quantized model artifact for a small set of prompts.
+Computes simple token-overlap and logs differences; intended for quick validation on target hardware.
+"""
+import argparse, json, sys
+from transformers import AutoModelForCausalLM, AutoTokenizer
+import torch
+import os
+
+def load_prompts(path):
+    out = []
+    if not os.path.exists(path):
+        return ["Hello world"]
+    for line in open(path):
+        j = json.loads(line)
+        out.append(j.get("prompt", j))
+    return out
+
+def generate_text(model, tokenizer, prompt, device="cpu"):
+    inputs = tokenizer(prompt, return_tensors="pt").to(device)
+    with torch.no_grad():
+        outs = model.generate(**inputs, max_length=64)
+    return tokenizer.decode(outs[0], skip_special_tokens=True)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--model", default="gpt2")
+    p.add_argument("--quant_dir", required=True)
+    p.add_argument("--prompts", default="ops/quant/validation_prompts.jsonl")
+    args = p.parse_args()
+
+    # baseline
+    tokenizer = AutoTokenizer.from_pretrained(args.model)
+    baseline = AutoModelForCausalLM.from_pretrained(args.model).eval()
+
+    # attempt to load quant model via from_pretrained(quant_dir) or custom loader
+    quant_model = None
+    try:
+        quant_model = AutoModelForCausalLM.from_pretrained(args.quant_dir).eval()
+    except Exception:
+        print("Quantized model not directly loadable by HF; ensure conversion exposes HF-compatible format.")
+    prompts = load_prompts(args.prompts)
+    report = []
+    for pr in prompts[:10]:
+        base = generate_text(baseline, tokenizer, pr)
+        qout = ""
+        if quant_model:
+            qout = generate_text(quant_model, tokenizer, pr)
+        report.append({"prompt": pr, "baseline": base, "quant": qout})
+        print("PROMPT:", pr)
+        print("BASELINE:", base)
+        print("QUANT:", qout)
+        print("----")
+    # write short report
+    outp = os.path.join(args.quant_dir, "validation_report.json")
+    json.dump(report, open(outp,"w"), indent=2)
+    print("Wrote report:", outp)
+
+if __name__=="__main__":
+    main()
+
