+#!/usr/bin/env python3
+"""
+Native microbenchmark harness for the ternary gemm shared library.
+Expects a shared lib exposing `ternary_gemm` or similar symbol; uses ctypes to call it.
+The library must accept simple dense inputs for a small benchmark.
+
+Usage:
+  python bench_runner_native.py --lib /path/to/libternary_gemm.so
+
+Prints a line containing "avg_time:<seconds>" for automation parsing.
+"""
+import argparse, ctypes, os, time, numpy as np
+
+def load_lib(path):
+    return ctypes.CDLL(path)
+
+def bench(lib_path, m=512, k=512, n=512, runs=10):
+    lib = load_lib(lib_path)
+    # prepare pseudo ternary A and float B
+    A = (np.random.randint(-1,2,size=(m,k)).astype(np.int8)).flatten()
+    scales = (np.random.rand(m).astype(np.float32))
+    B = (np.random.randn(k,n).astype(np.float32)).flatten()
+    C = np.zeros((m,n), dtype=np.float32).flatten()
+
+    # define ctypes types
+    lib.ternary_gemm_stream.restype = ctypes.c_int
+    lib.ternary_gemm_stream.argtypes = [ctypes.POINTER(ctypes.c_int8), ctypes.POINTER(ctypes.c_float),
+                                        ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_float),
+                                        ctypes.c_int, ctypes.POINTER(ctypes.c_float), ctypes.c_void_p]
+
+    A_ct = A.ctypes.data_as(ctypes.POINTER(ctypes.c_int8))
+    scales_ct = scales.ctypes.data_as(ctypes.POINTER(ctypes.c_float))
+    B_ct = B.ctypes.data_as(ctypes.POINTER(ctypes.c_float))
+    C_ct = C.ctypes.data_as(ctypes.POINTER(ctypes.c_float))
+
+    # run warmup
+    for _ in range(2):
+        lib.ternary_gemm_stream(A_ct, scales_ct, m, k, B_ct, n, C_ct, None)
+    # timed runs
+    ts = []
+    for _ in range(runs):
+        t0 = time.time()
+        lib.ternary_gemm_stream(A_ct, scales_ct, m, k, B_ct, n, C_ct, None)
+        t1 = time.time()
+        ts.append(t1-t0)
+    avg = sum(ts)/len(ts)
+    print(f"avg_time:{avg}")
+    return avg
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--lib", required=True)
+    p.add_argument("--m", type=int, default=512)
+    p.add_argument("--k", type=int, default=512)
+    p.add_argument("--n", type=int, default=512)
+    args = p.parse_args()
+    bench(args.lib, args.m, args.k, args.n)
+
