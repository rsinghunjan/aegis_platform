+#!/usr/bin/env python3
+"""
+Validate TensorRT engine outputs against ONNXRuntime baseline for a set of test inputs.
+Uses tensorrt python bindings if available; otherwise skip.
+"""
+import argparse, json, numpy as np, os, sys
+try:
+    import tensorrt as trt
+    TRT_OK = True
+except Exception:
+    TRT_OK = False
+try:
+    import onnxruntime as ort
+    ORT_OK = True
+except Exception:
+    ORT_OK = False
+
+def run_onnx(onnx_path, inputs):
+    sess = ort.InferenceSession(onnx_path, providers=['CPUExecutionProvider'])
+    inp_name = sess.get_inputs()[0].name
+    return sess.run(None, {inp_name: inputs})[0]
+
+def run_trt(engine_path, inputs):
+    TRT_LOGGER = trt.Logger(trt.Logger.WARNING)
+    with open(engine_path, "rb") as f, trt.Runtime(TRT_LOGGER) as runtime:
+        engine = runtime.deserialize_cuda_engine(f.read())
+        # running engine properly requires allocating buffers and CUDA runtime; omitted for brevity
+        raise RuntimeError("TRT validation runner requires CUDA buffer setup; run on-device harness")
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--onnx", required=True)
+    p.add_argument("--engine", required=True)
+    p.add_argument("--tests", default="ops/trt/trt_test_inputs.json")
+    args = p.parse_args()
+    if not ORT_OK:
+        print("onnxruntime not available; cannot validate")
+        sys.exit(2)
+    tests = json.load(open(args.tests)) if os.path.exists(args.tests) else []
+    for t in tests:
+        inp = np.array(t["input"]).astype(np.float32)
+        onnx_out = run_onnx(args.onnx, inp)
+        print("ONNX output sample:", onnx_out.flatten()[:5])
+    print("ONNX baseline validation done. For TRT validation run on a GPU host with proper runtime harness.")
+
+if __name__=="__main__":
+    main()
+
