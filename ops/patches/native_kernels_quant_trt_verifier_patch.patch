+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Auto-tune build + microbench for ternary kernel by varying tile sizes via CMake defines.
+# Requires a GPU build host with CUDA and the bench runner available.
+#
+HERE=$(cd $(dirname $0) && pwd)
+BUILD_ROOT="$HERE/build_tune"
+LIB_OUT="$HERE/build"
+BENCH_PY="../../sustainability/ternary_kernel_bench/bench_runner_native.py"
+
+# tile configurations to try (TILE_M x TILE_K)
+TILE_CONFIGS=("64:128" "128:256" "256:256" "256:512" "512:512")
+BEST_TIME=1e9
+BEST_CFG=""
+
+mkdir -p "$BUILD_ROOT"
+for cfg in "${TILE_CONFIGS[@]}"; do
+  TM=${cfg%%:*}
+  TK=${cfg##*:}
+  echo "=== Building with TILE_M=${TM}, TILE_K=${TK} ==="
+  BUILD_DIR="$BUILD_ROOT/tm${TM}_tk${TK}"
+  rm -rf "$BUILD_DIR" && mkdir -p "$BUILD_DIR"
+  pushd "$BUILD_DIR"
+  cmake -DTILE_M=${TM} -DTILE_K=${TK} ../../sustainability/ternary_kernel_build
+  make -j || { echo "Build failed for ${cfg}"; popd; continue; }
+  # copy lib to a predictable path for bench runner
+  cp libternary_gemm.so "$LIB_OUT/libternary_gemm.so"
+  popd
+
+  echo "Running microbenchmark..."
+  # bench runner returns avg latency; parse output
+  TIME_OUT=$(python3 "$HERE/$BENCH_PY" --lib "$LIB_OUT/libternary_gemm.so" 2>&1 || true)
+  echo "$TIME_OUT"
+  # bench_runner_native prints "avg_time:" line; extract number
+  AVG=$(echo "$TIME_OUT" | awk -F'avg_time:' '/avg_time:/{print $2}' | tail -n1 | tr -d ' ')
+  if [ -z "$AVG" ]; then
+    echo "Benchmark did not produce avg_time for ${cfg}, skipping"
+    continue
+  fi
+  AVGF=$(printf "%.6f" "$AVG")
+  if (( $(echo "$AVGF < $BEST_TIME" | bc -l) )); then
+    BEST_TIME=$AVGF
+    BEST_CFG="$cfg"
+    echo "New best ${BEST_CFG} -> ${BEST_TIME}s"
+  fi
+done
+
+echo "Auto-tune complete. Best config: ${BEST_CFG} avg_time=${BEST_TIME}s"
+echo "Artifacts in ${BUILD_ROOT} and ${LIB_OUT}"
+
