+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Convert ONNX model to TensorRT engine using trtexec if available.
+# Usage:
+#   ./convert_onnx_to_trt.sh model.onnx out.trt [max_workspace=4096] [precision=fp16]
+ONNX=${1:-}
+OUT=${2:-out.trt}
+WORKSPACE=${3:-4096}
+PREC=${4:-fp16}
+
+if [ -z "$ONNX" ]; then
+  echo "Usage: $0 <model.onnx> <out.engine> [workspace_mb] [precision]" >&2
+  exit 2
+fi
+
+if command -v trtexec >/dev/null 2>&1; then
+  echo "Using trtexec to build engine"
+  trtexec --onnx="$ONNX" --saveEngine="$OUT" --workspace=$WORKSPACE --$PREC --buildOnly
+  echo "Engine written to $OUT"
+else
+  echo "trtexec not available; try installing TensorRT or use onnx-tensorrt python bindings"
+  exit 2
+fi
