+"""
+Redis backed rate limiter (token bucket) for production proxy.
+ - Use this in backend_proxy_enhanced to provide persistent per-user limits across replicas
+"""
+import os, time
+import redis
+
+REDIS_URL = os.environ.get("RATE_REDIS_URL","redis://localhost:6379/1")
+r = redis.from_url(REDIS_URL)
+BUCKET_CAPACITY = int(os.environ.get("RATE_BUCKET_CAPACITY", "120"))  # tokens
+REFILL_PER_MIN = int(os.environ.get("RATE_REFILL_PER_MIN", "60"))
+
+def allow_request(user_key: str) -> bool:
+    now = int(time.time())
+    key = f"rl:{user_key}"
+    pipe = r.pipeline()
+    pipe.hgetall(key)
+    res = pipe.execute()[0]
+    if not res:
+        # set tokens to capacity and timestamp
+        r.hset(key, mapping={"tokens":BUCKET_CAPACITY, "ts": now})
+        r.expire(key, 3600)
+        tokens = BUCKET_CAPACITY
+    else:
+        tokens = int(res.get(b"tokens", b"0"))
+        ts = int(res.get(b"ts", b"0"))
+        elapsed = max(0, now - ts)
+        # refill
+        refill = (elapsed/60.0) * REFILL_PER_MIN
+        tokens = min(BUCKET_CAPACITY, int(tokens + refill))
+    if tokens <= 0:
+        return False
+    # consume 1 token
+    r.hincrby(key, "tokens", -1)
+    r.hset(key, "ts", now)
+    r.expire(key, 3600)
+    return True
+
