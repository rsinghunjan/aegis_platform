+"""
+Wattmeter-calibrator for telemetry daemon:
+ - Accepts a CSV of timestamp,watts collected from an external power meter synchronized with node telemetry
+ - Computes calibration (linear) and persists calibration config used by telemetry estimator
+"""
+import numpy as np, json, time, os
+from services.sustainability.gpu_telemetry import get_gpu_stats
+
+def load_csv(path):
+    ts=[]; watts=[]
+    for l in open(path):
+        t,w = l.strip().split(",")
+        ts.append(float(t)); watts.append(float(w))
+    return np.array(ts), np.array(watts)
+
+def calibrate_csv(csv_path, out_json="services/sustainability/telemetry_calibration.json"):
+    ts, watts = load_csv(csv_path)
+    samples=[]
+    for _ in range(len(watts)):
+        s = get_gpu_stats()
+        if s and s[0].get("power_w") is not None:
+            samples.append(s[0]["power_w"])
+    samples = np.array(samples)
+    n = min(len(samples), len(watts))
+    if n == 0:
+        raise RuntimeError("No samples")
+    samples=samples[:n]; watts=watts[:n]
+    A = np.vstack([samples, np.ones(n)]).T
+    a,b = np.linalg.lstsq(A, watts, rcond=None)[0]
+    cfg = {"scale": float(a), "offset": float(b)}
+    json.dump(cfg, open(out_json,"w"), indent=2)
+    print("Wrote calibration", cfg)
+
+if __name__=="__main__":
+    import sys
+    if len(sys.argv)<2:
+        print("Usage: calibrate <wattmeter.csv>")
+    else:
+        calibrate_csv(sys.argv[1])
+
