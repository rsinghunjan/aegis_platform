+"""
+Kernel optimization orchestrator:
+ - Runs microbench harness (bench_runner_native.py) across a set of tile configurations or GPU streams
+ - Aggregates results and writes best config to ops/triton/backend/kernel_best_config.json
+ - Designed to run on each GPU host (self-hosted CI runner) to auto-tune parameterization for the local hardware.
+"""
+import os, json, subprocess, time
+
+TILE_CFGS = [
+    {"TILE_M":64,"TILE_K":128},
+    {"TILE_M":128,"TILE_K":256},
+    {"TILE_M":256,"TILE_K":256},
+    {"TILE_M":256,"TILE_K":512},
+    {"TILE_M":512,"TILE_K":512}
+]
+BENCH_SCRIPT = "ops/sustainability/ternary_kernel_bench/bench_runner_native.py"
+LIB_OUT = "ops/sustainability/ternary_kernel_build/build/libternary_gemm.so"
+
+def run_bench():
+    best = None
+    for cfg in TILE_CFGS:
+        env = os.environ.copy()
+        env["TILE_M"]=str(cfg["TILE_M"]); env["TILE_K"]=str(cfg["TILE_K"])
+        # assume we built the lib with these defines in CI earlier; bench script accepts lib path
+        cmd = ["python3", BENCH_SCRIPT, "--lib", LIB_OUT]
+        try:
+            out = subprocess.check_output(cmd, env=env, stderr=subprocess.STDOUT, timeout=300).decode()
+            # parse avg_time:
+            for line in out.splitlines():
+                if "avg_time:" in line:
+                    avg=float(line.split("avg_time:")[1].strip())
+                    print("cfg",cfg,"avg",avg)
+                    if best is None or avg < best["avg"]:
+                        best={"cfg":cfg,"avg":avg}
+        except Exception as e:
+            print("bench failed for",cfg,e)
+    if best:
+        os.makedirs("ops/triton/backend", exist_ok=True)
+        with open("ops/triton/backend/kernel_best_config.json","w") as f:
+            json.dump(best,f,indent=2)
+        print("Wrote best config",best)
+
+if __name__=="__main__":
+    run_bench()
