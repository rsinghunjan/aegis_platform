+"""
+Verifier training & runtime monitor:
+ - Collect evaluation metrics periodically from verifier predictions (via sample set)
+ - Emit Prometheus metrics and create alerts when drift or drop in F1/precision is detected
+ - Store historical metrics in /var/log/verifier_metrics.jsonl for auditing
+"""
+import os, time, json, requests
+from prometheus_client import Gauge, start_http_server
+
+VERIFIER_URL = os.environ.get("VERIFIER_URL", "http://verifier.safety.svc:8080/verify")
+SAMPLES = os.environ.get("VERIFIER_MONITOR_SAMPLES", "ops/factuality/verification_samples.jsonl")
+POLL = int(os.environ.get("VERIFIER_MONITOR_POLL_SECS", "3600"))
+
+METRIC_F1 = Gauge("aegis_verifier_f1", "Verifier F1 on sample set")
+METRIC_PREC = Gauge("aegis_verifier_precision_support", "Verifier support precision")
+
+def load_samples():
+    out=[]
+    if not os.path.exists(SAMPLES):
+        return out
+    for l in open(SAMPLES):
+        out.append(json.loads(l.strip()))
+    return out
+
+def eval_once():
+    samples = load_samples()
+    if not samples:
+        return
+    total=0; tp=0; pred_support=0
+    for s in samples:
+        total+=1
+        try:
+            r = requests.post(VERIFIER_URL, json={"claim": s["claim"], "evidence": s.get("evidence", [])}, timeout=5)
+            if r.status_code!=200: continue
+            res=r.json()
+            score = res.get("best", {}).get("score", 0.0)
+            pred = (score >= float(os.environ.get("VERIFIER_MIN_SUPPORT", "0.35")))
+            if pred: pred_support+=1
+            true_support = s.get("label") == "support"
+            if pred and true_support: tp+=1
+        except Exception:
+            continue
+    prec = (tp / pred_support) if pred_support>0 else 0.0
+    f1 = (2*prec* (tp/total) / (prec + (tp/total))) if (prec + (tp/total))>0 else 0.0
+    METRIC_PREC.set(prec)
+    METRIC_F1.set(f1)
+    with open("/var/log/verifier_metrics.jsonl","a") as f:
+        f.write(json.dumps({"ts":time.time(),"precision":prec,"f1":f1})+"\n")
+
+if __name__=="__main__":
+    start_http_server(int(os.environ.get("VERIFIER_MONITOR_PORT", "9410")))
+    while True:
+        eval_once()
+        time.sleep(POLL)
+
