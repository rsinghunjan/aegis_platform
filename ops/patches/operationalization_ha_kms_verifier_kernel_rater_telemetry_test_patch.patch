+"""
+Cosign admission webhook (validating) skeleton.
+ - Validates images referenced in pod specs using `cosign verify` with an expected KMS key
+ - Responds to Kubernetes AdmissionReview JSON on /validate
+ - Operator must run this behind a TLS-enabled service and configure Mutating/ValidatingWebhookConfiguration
+
+Notes:
+ - This is a best-effort skeleton. Use a hardened, tested cosign admission controller in production.
+ - Requires `cosign` CLI on PATH and SERVICE_COSIGN_KMS_ARN env var (kms://arn:...)
+"""
+import os
+import json
+import subprocess
+from flask import Flask, request, jsonify
+
+SERVICE_KMS_ARN = os.environ.get("SERVICE_COSIGN_KMS_ARN", "")
+COSIGN_OPTS = os.environ.get("COSIGN_OPTS", "")
+
+app = Flask(__name__)
+
+def verify_image(image: str) -> (bool, str):
+    """Call cosign verify --key ksm://... image. Return (ok, message)."""
+    if not SERVICE_KMS_ARN:
+        return False, "KMS ARN not configured"
+    cmd = ["cosign", "verify", "--key", SERVICE_KMS_ARN, image]
+    if COSIGN_OPTS:
+        cmd = cmd + COSIGN_OPTS.split()
+    try:
+        subprocess.check_output(cmd, stderr=subprocess.STDOUT, timeout=15)
+        return True, "verified"
+    except subprocess.CalledProcessError as e:
+        return False, e.output.decode(errors="ignore") if e.output else str(e)
+    except Exception as e:
+        return False, str(e)
+
+@app.route("/validate", methods=["POST"])
+def validate():
+    review = request.get_json()
+    # Minimal parsing to find images in pod spec (support simple create pods)
+    uid = review.get("request", {}).get("uid")
+    obj = review.get("request", {}).get("object", {})
+    images = []
+    spec = obj.get("spec", {})
+    for c in spec.get("containers", []):
+        img = c.get("image")
+        if img:
+            images.append(img)
+    # verify all images
+    for img in images:
+        ok, msg = verify_image(img)
+        if not ok:
+            # deny admission
+            resp = {
+                "apiVersion": "admission.k8s.io/v1",
+                "kind": "AdmissionReview",
+                "response": {
+                    "uid": uid,
+                    "allowed": False,
+                    "status": {"message": f"Image {img} verification failed: {msg}"}
+                }
+            }
+            return jsonify(resp)
+    # allow
+    resp = {
+        "apiVersion": "admission.k8s.io/v1",
+        "kind": "AdmissionReview",
+        "response": {
+            "uid": uid,
+            "allowed": True
+        }
+    }
+    return jsonify(resp)
+
+@app.route("/health")
+def health():
+    return jsonify({"status":"ok"})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8443")))
+
