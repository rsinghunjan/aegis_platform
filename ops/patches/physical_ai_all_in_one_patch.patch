+#!/usr/bin/env python3
+"""
+Actuator wrapper template (idempotent with emergency-stop and transaction hooks)
+
+- Exposes POST /execute to perform an actuator command.
+- Performs:
+    * Authentication/authorization check (Keycloak token via header)
+    * Safety pre-check (emergency stop, permissive flags)
+    * Idempotency using request_id (stores last result in local cache or S3)
+    * Records transaction via transaction_manager (if available)
+    * Executes hardware command via device adapter (placeholder)
+    * Verifies post-condition and returns result
+    * Uploads signed evidence (optionally)
+Notes:
+- Replace device_adapter.execute(...) with your actual hardware control logic (e.g., CAN bus, serial, ROS2 action)
+- This template logs evidence and attempts to be safe by checking a cluster-level emergency-stop ConfigMap.
+"""
+import os
+import time
+import json
+import logging
+from typing import Dict, Any
+from fastapi import FastAPI, HTTPException, Request, Header
+from pydantic import BaseModel
+
+try:
+    # optional transaction manager from Aegis codebase
+    from services.agent.transaction_manager import start_transaction, record_step, finalize_transaction
+except Exception:
+    start_transaction = None
+    record_step = None
+    finalize_transaction = None
+
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("actuator-wrapper")
+
+app = FastAPI(title="Aegis Actuator Wrapper")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+EMERGENCY_CM = os.environ.get("EMERGENCY_CM", "actuator-emergency")
+IDEMPOTENCY_TTL_S = int(os.environ.get("WRAPPER_IDEMPOTENCY_TTL_S", "3600"))
+
+s3 = boto3.client("s3") if (boto3 and EVIDENCE_BUCKET) else None
+# in-memory idempotency cache (for demo). In prod use Redis or DB.
+_idempotency_cache: Dict[str, Dict[str, Any]] = {}
+
+
+class ExecuteReq(BaseModel):
+    actuator: str
+    command: Dict[str, Any]
+    request_id: str
+    metadata: Dict[str, Any] = {}
+
+
+def check_emergency():
+    # Real implementation should read ConfigMap in cluster or watch a hardware E-stop line
+    # For demo, check env var
+    if os.environ.get("AEGIS_EMERGENCY_STOP", "false").lower() == "true":
+        return True
+    return False
+
+
+def upload_evidence(key_prefix: str, payload: Dict[str, Any]):
+    ts = int(time.time())
+    key = f"{key_prefix}/{ts}.json"
+    if not s3:
+        p = f"/tmp/{key.replace('/','_')}"
+        with open(p, "w") as f:
+            json.dump(payload, f, indent=2)
+        logger.info("Wrote evidence locally: %s", p)
+        return p
+    try:
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode("utf-8"))
+        uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+        logger.info("Uploaded evidence to %s", uri)
+        return uri
+    except Exception as e:
+        logger.warning("Failed to upload evidence: %s", e)
+        return None
+
+
+def device_execute(actuator: str, command: Dict[str, Any]) -> Dict[str, Any]:
+    # Placeholder: implement hardware-level execution (e.g., call into a device driver)
+    # For safety, simulate slow execution and return fake response
+    logger.info("Simulated device_execute for actuator=%s command=%s", actuator, command)
+    time.sleep(0.2)
+    return {"status": "ok", "actuator": actuator, "applied": command, "timestamp": int(time.time())}
+
+
+@app.post("/execute")
+async def execute(body: ExecuteReq, authorization: str = Header(None)):
+    # Basic idempotency check
+    rid = body.request_id
+    if not rid:
+        raise HTTPException(status_code=400, detail="request_id required for idempotency")
+    # Check emergency stop
+    if check_emergency():
+        raise HTTPException(status_code=503, detail="Emergency stop enabled; refusing to actuate")
+    # Check idempotency cache
+    cached = _idempotency_cache.get(rid)
+    if cached and (time.time() - cached.get("ts", 0) < IDEMPOTENCY_TTL_S):
+        logger.info("Idempotent: returning cached result for %s", rid)
+        return cached["result"]
+    # Start transaction (if available)
+    tx = None
+    if start_transaction:
+        try:
+            tx = start_transaction(f"act_{rid}", "actuator-wrapper", {"actuator": body.actuator})
+            record_step(tx, 0, {"action": "precheck"})
+        except Exception:
+            tx = None
+    # Execute hardware action
+    try:
+        res = device_execute(body.actuator, body.command)
+        # Post-verify placeholder
+        ok = res.get("status") == "ok"
+        if not ok:
+            raise RuntimeError("device reported non-ok")
+    except Exception as e:
+        # record failure
+        if tx and record_step:
+            try:
+                record_step(tx, 1, {"action": "failed", "error": str(e)})
+                finalize_transaction(tx, "failed", {"error": str(e)})
+            except Exception:
+                pass
+        logger.exception("Execution failed")
+        raise HTTPException(status_code=500, detail=str(e))
+    # On success, finalize transaction
+    if tx and finalize_transaction:
+        try:
+            record_step(tx, 1, {"action": "applied", "result": res})
+            finalize_transaction(tx, "applied", {"result": res})
+        except Exception:
+            pass
+    # Upload evidence
+    upload_evidence(f"actuator/{body.actuator}", {"request": body.dict(), "response": res})
+    # Cache result for idempotency
+    _idempotency_cache[rid] = {"ts": time.time(), "result": res}
+    return res
+
+
+@app.get("/health")
+def health():
+    return {"status": "ok"}
+
