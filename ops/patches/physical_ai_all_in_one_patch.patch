+#!/usr/bin/env bash
+# Helper to upload local simulation artifacts to evidence bucket used by Tekton task debugging
+set -euo pipefail
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+if [ -z "$EVIDENCE_BUCKET" ]; then
+  echo "EVIDENCE_BUCKET env required"
+  exit 2
+fi
+ARTIFACT=${1:-}
+if [ ! -f "$ARTIFACT" ]; then
+  echo "artifact not found: $ARTIFACT"
+  exit 2
+fi
+aws s3 cp "$ARTIFACT" "s3://$EVIDENCE_BUCKET/simulations/$(basename $ARTIFACT)-$(date +%s).json"
+echo "Uploaded"
+
