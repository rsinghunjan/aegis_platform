+#!/usr/bin/env python3
+"""
+ROS2 <-> Aegis bridge service (FastAPI)
+
+Purpose:
+- Provide a lightweight HTTP bridge for ROS2 (or rosbridge) data to be forwarded into Aegis:
+  - POST /telemetry  : accepts sensor/event payloads and emits Prometheus metrics + optional S3 evidence
+  - POST /actuate    : request an actuator command; the bridge calls the actuator wrapper endpoint via transaction_manager
+  - GET  /health     : health check
+Notes:
+- In real deployments you may integrate directly with ROS2 (rclpy) or use rosbridge websocket to forward messages
+  to this service. For portability we accept HTTP POSTs from rosbridge, from a small local forwarder, or from
+  simulation harnesses.
+- Configure via env:
+  - EVIDENCE_BUCKET (optional) - S3 bucket to store telemetry/evidence
+  - PUSHGATEWAY (optional) - Prometheus Pushgateway URL for edge metrics
+  - ACTUATOR_WRAPPER_URL - base URL of actuator wrapper service (http://wrapper.svc.cluster.local:8080/execute)
+"""
+import os
+import json
+import time
+import logging
+from typing import Any, Dict, Optional
+
+import requests
+from fastapi import FastAPI, HTTPException, Request
+from pydantic import BaseModel
+
+# Optional: prometheus_client for local metrics + pushgateway
+from prometheus_client import CollectorRegistry, Gauge, push_to_gateway
+
+# Optional S3 evidence writer
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("ros2-bridge")
+
+app = FastAPI(title="Aegis ROS2 Bridge")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+PUSHGATEWAY = os.environ.get("PUSHGATEWAY", "")
+ACTUATOR_WRAPPER_URL = os.environ.get("ACTUATOR_WRAPPER_URL", "http://actuator-wrapper.monitoring.svc.cluster.local:8080/execute")
+REGION = os.environ.get("AEGIS_REGION", "local")
+INSTANCE = os.environ.get("AEGIS_INSTANCE", "edge-0001")
+
+s3 = None
+if EVIDENCE_BUCKET and boto3 is not None:
+    s3 = boto3.client("s3")
+
+
+class TelemetryPayload(BaseModel):
+    node_id: str
+    topic: str
+    timestamp: Optional[float]
+    payload: Dict[str, Any]
+    sample_rate: Optional[float] = None
+
+
+class ActuateRequest(BaseModel):
+    actuator: str
+    command: Dict[str, Any]
+    request_id: Optional[str] = None
+    metadata: Optional[Dict[str, Any]] = None
+
+
+def push_metric(name: str, value: float, labels: Dict[str, str] = None):
+    if not PUSHGATEWAY:
+        return
+    try:
+        reg = CollectorRegistry()
+        g = Gauge(name, "edge metric from ros2 bridge", list(labels.keys()) if labels else [])
+        if labels:
+            g = Gauge(name, "edge metric from ros2 bridge", labelnames=list(labels.keys()), registry=reg)
+            g.labels(**labels).set(value)
+        else:
+            g.set(value)
+        push_to_gateway(PUSHGATEWAY, job=INSTANCE, registry=reg)
+    except Exception as e:
+        logger.warning("push_metric error: %s", e)
+
+
+def upload_evidence(prefix: str, payload: Dict[str, Any]) -> Optional[str]:
+    ts = int(time.time())
+    key = f"{prefix}/{INSTANCE}/{ts}.json"
+    if s3 is None:
+        path = f"/tmp/evidence_{ts}.json"
+        with open(path, "w") as f:
+            json.dump(payload, f, indent=2)
+        logger.info("Wrote evidence locally to %s", path)
+        return path
+    try:
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode("utf-8"))
+        uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+        logger.info("Uploaded evidence to %s", uri)
+        return uri
+    except Exception as e:
+        logger.warning("s3 put failed: %s", e)
+        return None
+
+
+@app.post("/telemetry")
+async def telemetry(t: TelemetryPayload):
+    # Normalize timestamp
+    ts = t.timestamp or time.time()
+    record = {
+        "node_id": t.node_id,
+        "topic": t.topic,
+        "timestamp": ts,
+        "payload": t.payload,
+        "region": REGION,
+        "instance": INSTANCE,
+    }
+    # Push simple numeric fields to Pushgateway for scraping
+    # For each numeric key in payload push a metric: aegis_telemetry_<topic>_{key}
+    for k, v in t.payload.items():
+        try:
+            val = float(v)
+            metric_name = f"aegis_telemetry_{t.topic}_{k}"
+            labels = {"node": t.node_id, "region": REGION}
+            push_metric(metric_name, val, labels=labels)
+        except Exception:
+            # not numeric: skip
+            continue
+    # Save evidence if requested or if topic is critical
+    if t.topic.startswith("safety") or t.sample_rate:
+        uploaded = upload_evidence(f"telemetry/{t.topic}", record)
+        return {"stored_at": uploaded}
+    return {"status": "ok"}
+
+
+@app.post("/actuate")
+async def actuate(req: ActuateRequest, request: Request):
+    # Forward actuation request to the actuator wrapper via transaction_manager-style call
+    # We expect wrapper to provide idempotency and safety checks. We add request metadata.
+    payload = {
+        "actuator": req.actuator,
+        "command": req.command,
+        "request_id": req.request_id or f"{INSTANCE}-{int(time.time()*1000)}",
+        "metadata": req.metadata or {},
+        "source": "ros2-bridge",
+        "node": INSTANCE,
+    }
+    try:
+        r = requests.post(ACTUATOR_WRAPPER_URL, json=payload, timeout=10)
+        r.raise_for_status()
+    except Exception as e:
+        logger.exception("Actuator wrapper call failed")
+        raise HTTPException(status_code=502, detail=str(e))
+    res = r.json()
+    # Optionally store actuator evidence
+    upload_evidence(f"actuations/{req.actuator}", {"request": payload, "response": res})
+    return res
+
+
+@app.get("/health")
+def health():
+    return {"status": "ok", "instance": INSTANCE, "region": REGION}
+
