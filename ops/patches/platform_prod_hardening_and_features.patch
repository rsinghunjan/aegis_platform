+"""
+FastAPI dependency to validate Keycloak access tokens and inject user/roles.
+Uses Keycloak introspection or userinfo endpoint (config via env).
+"""
+import os
+import requests
+from fastapi import HTTPException, Security
+from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
+
+KEYCLOAK_URL = os.environ.get("KEYCLOAK_URL", "")
+KEYCLOAK_REALM = os.environ.get("KEYCLOAK_REALM", "aegis")
+CLIENT_ID = os.environ.get("KEYCLOAK_CLIENT_ID", "")
+
+security = HTTPBearer(auto_error=False)
+
+def validate_token(credentials: HTTPAuthorizationCredentials = Security(security)):
+    if not credentials:
+        raise HTTPException(status_code=401, detail="Missing Authorization")
+    token = credentials.credentials
+    if not KEYCLOAK_URL:
+        # in dev mode skip validation
+        return {"sub": "dev", "preferred_username": "dev", "realm_access": {"roles": ["admin"]}}
+    userinfo = None
+    try:
+        resp = requests.get(f"{KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}/protocol/openid-connect/userinfo", headers={"Authorization": f"Bearer {token}"}, timeout=5)
+        if resp.status_code == 200:
+            userinfo = resp.json()
+        else:
+            # fallback to token introspect
+            introspect = requests.post(f"{KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}/protocol/openid-connect/token/introspect", data={"token": token, "client_id": CLIENT_ID}, timeout=5)
+            if introspect.status_code == 200 and introspect.json().get("active"):
+                userinfo = introspect.json()
+    except Exception:
+        raise HTTPException(status_code=403, detail="Token validation failed")
+    if not userinfo:
+        raise HTTPException(status_code=403, detail="Invalid token")
+    return userinfo
+
