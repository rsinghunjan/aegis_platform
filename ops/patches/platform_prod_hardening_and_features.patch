+#     ./ops/scripts/create_prod_secrets.sh
+
+NS=${NAMESPACE:-monitoring}
+
+if [ -z "${EVIDENCE_BUCKET:-}" ]; then
+  echo "EVIDENCE_BUCKET is required"
+  exit 2
+fi
+
+echo "Creating evidence-bucket secret..."
+kubectl create secret generic evidence-bucket -n "${NS}" --from-literal=bucket="${EVIDENCE_BUCKET}" --dry-run=client -o yaml | kubectl apply -f -
+
+if [ -n "${ELECTRICITYMAP_API_KEY:-}" ] || [ -n "${WATTTIME_API_TOKEN:-}" ]; then
+  echo "Creating carbon-secrets..."
+  args=()
+  [ -n "${ELECTRICITYMAP_API_KEY:-}" ] && args+=(--from-literal=electricitymap_key="${ELECTRICITYMAP_API_KEY}")
+  [ -n "${WATTTIME_API_TOKEN:-}" ] && args+=(--from-literal=watttime_token="${WATTTIME_API_TOKEN}")
+  kubectl create secret generic carbon-secrets -n "${NS}" "${args[@]}" --dry-run=client -o yaml | kubectl apply -f -
+fi
+
+if [ -n "${MODEL_STORE_PREFIX:-}" ]; then
+  echo "Creating model-store secret..."
+  kubectl create secret generic model-store -n "${NS}" --from-literal=prefix="${MODEL_STORE_PREFIX}" --dry-run=client -o yaml | kubectl apply -f -
+fi
+
+if [ -n "${KEYCLOAK_CLIENT_SECRET:-}" ] || [ -n "${KEYCLOAK_URL:-}" ]; then
+  echo "Creating keycloak-credentials secret..."
+  kubectl create secret generic keycloak-credentials -n "${NS}" \
