+"""
+Simple tenant enforcement middleware for the registry.
+Checks X-Aegis-Tenant header (or tenant in JSON payload) and enforces configured quotas.
+Quotas are stored in ops/config/tenants.json (simple example).
+"""
+import os, json
+from fastapi import Request, HTTPException
+
+TENANTS_PATH = os.environ.get("TENANTS_CONFIG", "ops/config/tenants.json")
+
+def load_tenants():
+    try:
+        return json.load(open(TENANTS_PATH))
+    except Exception:
+        return {}
+
+def require_tenant(request: Request):
+    # header or body tenant
+    tenant = request.headers.get("X-Aegis-Tenant")
+    if not tenant:
+        # try JSON payload (best-effort)
+        try:
+            body = request.json()
+            tenant = body.get("tenant")
+        except Exception:
+            tenant = None
+    if not tenant:
+        raise HTTPException(status_code=400, detail="Missing tenant header or param (X-Aegis-Tenant)")
+    tenants = load_tenants()
+    if tenant not in tenants:
+        raise HTTPException(status_code=403, detail="Unknown tenant")
+    # basic quota enforcement: max_models
+    q = tenants[tenant].get("quotas", {})
+    # Note: implement actual enforcement by counting models in DB; here we only attach tenant to request.
+    return tenant
+
