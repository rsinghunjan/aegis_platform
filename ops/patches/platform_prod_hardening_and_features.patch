+"""
+Wrapper entrypoint RBAC enforcement.
+Each wrapper should call the check_wrapper_permissions function prior to performing side effects.
+It consults a ConfigMap 'agent-rbac' (populated by Keycloak sync) and optionally validates the caller's roles via token userinfo.
+"""
+import os
+import json
+from kubernetes import client, config
+
+CM_NAMESPACE = os.environ.get("RBAC_CM_NAMESPACE", "monitoring")
+CM_NAME = os.environ.get("RBAC_CM_NAME", "agent-rbac")
+
+def load_rbac_map():
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    v1 = client.CoreV1Api()
+    try:
+        cm = v1.read_namespaced_config_map(CM_NAME, CM_NAMESPACE)
+        data = cm.data.get("rbac.json", "{}")
+        return json.loads(data)
+    except Exception:
+        return {}
+
+def check_wrapper_permissions(wrapper_name: str, userinfo: dict):
+    rmap = load_rbac_map()
+    # find roles in userinfo.realm_access.roles
+    roles = userinfo.get("realm_access", {}).get("roles", []) if userinfo else []
+    # match any role that is allowed to run this wrapper
+    allowed = False
+    for role in roles:
+        role_cfg = rmap.get(role, {})
+        allowed_actions = role_cfg.get("allowed", [])
+        # convention: wrapper names align to allowed actions (e.g., k8s.scale_deployment)
+        if wrapper_name in allowed_actions or "*" in allowed_actions:
+            allowed = True
+            break
+    if not allowed:
+        raise PermissionError("caller not authorized to execute wrapper: "+wrapper_name)
+    return True
+
