+"""
+Adds a promotion request endpoint to the Postgres-backed registry.
+Stores promotion requests for CI to pick up and drive the actual promotion process (promotion gate / human review).
+"""
+import os, time, json
+from fastapi import APIRouter, HTTPException, Depends
+from sqlalchemy import create_engine, Column, Integer, String, Text, ForeignKey
+from sqlalchemy.orm import sessionmaker
+from services.registry.pg_model_registry import SessionLocal, ModelVersion
+
+router = APIRouter()
+
+# Promotion DB table (simple)
+def ensure_promotion_table():
+    engine = create_engine(os.environ.get("DATABASE_URL"))
+    engine.execute("CREATE TABLE IF NOT EXISTS promotion_requests (id serial primary key, model varchar, version varchar, requester varchar, status varchar, created_at bigint)")
+
+ensure_promotion_table()
+
+@router.post("/models/{name}/versions/{version}/promote")
+def request_promotion(name: str, version: str, userinfo: dict = None):
+    db = SessionLocal()
+    mv = db.query(ModelVersion).join(ModelVersion.model).filter(ModelVersion.version==version,).first()
+    if not mv:
+        raise HTTPException(status_code=404, detail="version not found")
+    requester = userinfo.get("preferred_username") if userinfo else "unknown"
+    ts = int(time.time())
+    engine = db.get_bind()
+    engine.execute("INSERT INTO promotion_requests (model,version,requester,status,created_at) VALUES (%s,%s,%s,%s,%s)",
+                   (name, version, requester, "requested", ts))
+    return {"status": "requested", "model": name, "version": version}
+
+@router.get("/promotions")
+def list_promotions():
+    engine = create_engine(os.environ.get("DATABASE_URL"))
+    rows = engine.execute("select id, model, version, requester, status, created_at from promotion_requests order by created_at desc limit 100").fetchall()
+    out = [{"id": r[0], "model": r[1], "version": r[2], "requester": r[3], "status": r[4], "created_at": r[5]} for r in rows]
+    return {"requests": out}
+
