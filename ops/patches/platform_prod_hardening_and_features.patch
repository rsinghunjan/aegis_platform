+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Migrate lightweight SQLite registry to Postgres by exporting rows and re-inserting.
+# WARNING: run in maintenance window and backup both DBs first.
+# Usage:
+#   ./ops/scripts/migrate_sqlite_to_postgres.sh --sqlite /path/to/services/registry/models.db --pg "postgresql://user:pass@host:5432/db"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --sqlite) SQLITE="$2"; shift 2;;
+    --pg) PGURL="$2"; shift 2;;
+    *) shift ;;
+  esac
+done
+
+[ -f "${SQLITE:-}" ] || { echo "sqlite file required"; exit 2; }
+[ -n "${PGURL:-}" ] || { echo "pg url required"; exit 2; }
+
+echo "Exporting from sqlite..."
+sqlite3 -json "${SQLITE}" "select * from models;" > /tmp/sql_models.json
+sqlite3 -json "${SQLITE}" "select * from model_versions;" > /tmp/sql_versions.json
+sqlite3 -json "${SQLITE}" "select * from annotations;" > /tmp/sql_annotations.json
+
+echo "Inserting into Postgres..."
+python - <<PY
+import json, os
+from sqlalchemy import create_engine, text
+PG="${PGURL}"
+engine = create_engine(PG)
+conn = engine.connect()
+models = json.load(open("/tmp/sql_models.json"))
+for m in models:
+    conn.execute(text("INSERT INTO models (id,name,created_at) VALUES (:id,:name,:created_at) ON CONFLICT (id) DO NOTHING"), **m)
+versions = json.load(open("/tmp/sql_versions.json"))
+for v in versions:
+    conn.execute(text("INSERT INTO model_versions (id,model_id,version,artifact_uri,metadata,created_at) VALUES (:id,:model_id,:version,:artifact_uri,:metadata,:created_at) ON CONFLICT (id) DO NOTHING"), **v)
+annotations = json.load(open("/tmp/sql_annotations.json"))
+for a in annotations:
+    conn.execute(text("INSERT INTO annotations (id,model_version_id,key,value,created_at) VALUES (:id,:model_version_id,:key,:value,:created_at) ON CONFLICT (id) DO NOTHING"), **a)
+print("Migration complete")
+PY
+
+echo "Migration finished. Verify counts in Postgres and switch applications to new DATABASE_URL."
+
