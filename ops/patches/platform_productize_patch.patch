+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Sign an artifact with cosign (if available) and upload to S3 evidence bucket
+# Usage:
+#   EVIDENCE_BUCKET=<bucket> ARTIFACT=/path/to/file ./ops/scripts/sign_and_upload_artifact.sh
+
+if [ -z "${EVIDENCE_BUCKET:-}" ] || [ -z "${ARTIFACT:-}" ]; then
+  echo "Set EVIDENCE_BUCKET and ARTIFACT env vars"
+  exit 2
+fi
+
+if command -v cosign >/dev/null 2>&1; then
+  echo "Signing artifact with cosign..."
+  cosign sign --key cosign.key "${ARTIFACT}" || true
+  SIGFILE="${ARTIFACT}.sig"
+else
+  echo "cosign not found; creating a simple SHA256 signature file"
+  SIGFILE="${ARTIFACT}.sha256"
+  sha256sum "${ARTIFACT}" > "${SIGFILE}"
+fi
+
+echo "Uploading artifact and signature to s3://${EVIDENCE_BUCKET}/artifacts/"
+aws s3 cp "${ARTIFACT}" "s3://${EVIDENCE_BUCKET}/artifacts/$(basename ${ARTIFACT})"
+aws s3 cp "${SIGFILE}" "s3://${EVIDENCE_BUCKET}/artifacts/$(basename ${SIGFILE})"
+echo "Upload complete"
+
