+#!/usr/bin/env python3
+"""
+Postgres-backed Model Registry (minimal)
+ - Uses SQLAlchemy and environment variable DATABASE_URL (e.g., postgresql://user:pass@aegis-postgres.monitoring.svc:5432/aegis_registry)
+ - Provides endpoints to create models, create versions (upload or URI), list models, and annotate versions.
+ - Designed to be a drop-in production replacement for the lightweight SQLite registry.
+"""
+import os, time, json
+from fastapi import FastAPI, HTTPException, UploadFile, File, Form
+from pydantic import BaseModel
+from sqlalchemy import create_engine, Column, Integer, Text, String, ForeignKey, TIMESTAMP
+from sqlalchemy.orm import declarative_base, sessionmaker, relationship
+from sqlalchemy.exc import IntegrityError
+import boto3
+
+DATABASE_URL = os.environ.get("DATABASE_URL", "postgresql://aegis:password@aegis-postgres.monitoring.svc:5432/aegis_registry")
+ARTIFACT_STORE_PREFIX = os.environ.get("MODEL_STORE_PREFIX", "")
+S3_CLIENT = None
+if ARTIFACT_STORE_PREFIX.startswith("s3://"):
+    try:
+        S3_CLIENT = boto3.client("s3")
+    except Exception:
+        S3_CLIENT = None
+
+engine = create_engine(DATABASE_URL, pool_pre_ping=True)
+SessionLocal = sessionmaker(bind=engine)
+Base = declarative_base()
+
+class Model(Base):
+    __tablename__ = "models"
+    id = Column(Integer, primary_key=True, index=True)
+    name = Column(String, unique=True, index=True, nullable=False)
+    created_at = Column(Integer, nullable=False)
+    versions = relationship("ModelVersion", back_populates="model")
+
+class ModelVersion(Base):
+    __tablename__ = "model_versions"
+    id = Column(Integer, primary_key=True, index=True)
+    model_id = Column(Integer, ForeignKey("models.id"), nullable=False)
+    version = Column(String, nullable=False)
+    artifact_uri = Column(Text)
+    metadata = Column(Text)
+    created_at = Column(Integer, nullable=False)
+    model = relationship("Model", back_populates="versions")
+
+class Annotation(Base):
+    __tablename__ = "annotations"
+    id = Column(Integer, primary_key=True, index=True)
+    model_version_id = Column(Integer, ForeignKey("model_versions.id"), nullable=False)
+    key = Column(String, nullable=False)
+    value = Column(Text)
+    created_at = Column(Integer, nullable=False)
+
+def init_db():
+    Base.metadata.create_all(bind=engine)
+
+app = FastAPI(title="Aegis Model Registry (Postgres)")
+
+@app.on_event("startup")
+def startup():
+    init_db()
+
+class CreateModel(BaseModel):
+    name: str
+
+@app.post("/models")
+def create_model(body: CreateModel):
+    db = SessionLocal()
+    now = int(time.time())
+    m = Model(name=body.name, created_at=now)
+    db.add(m)
+    try:
+        db.commit()
+    except IntegrityError:
+        db.rollback()
+        raise HTTPException(status_code=409, detail="model exists")
+    return {"name": body.name, "created_at": now}
+
+@app.get("/models")
+def list_models():
+    db = SessionLocal()
+    ms = db.query(Model).order_by(Model.name).all()
+    out = [{"id": m.id, "name": m.name, "created_at": m.created_at} for m in ms]
+    return {"models": out}
+
+@app.get("/models/{name}")
+def get_model(name: str):
+    db = SessionLocal()
+    m = db.query(Model).filter(Model.name == name).first()
+    if not m:
+        raise HTTPException(status_code=404, detail="model not found")
+    versions = [{"id": v.id, "version": v.version, "artifact_uri": v.artifact_uri, "metadata": v.metadata, "created_at": v.created_at} for v in m.versions]
+    return {"model": {"id": m.id, "name": m.name, "created_at": m.created_at}, "versions": versions}
+
+@app.post("/models/{name}/versions")
+async def create_version(name: str, version: str = Form(...), metadata: str = Form(None), artifact: UploadFile = File(None), artifact_uri: str = Form(None)):
+    db = SessionLocal()
+    m = db.query(Model).filter(Model.name == name).first()
+    if not m:
+        raise HTTPException(status_code=404, detail="model not found")
+    now = int(time.time())
+    final_uri = artifact_uri
+    if artifact is not None:
+        data = await artifact.read()
+        if ARTIFACT_STORE_PREFIX.startswith("s3://") and S3_CLIENT:
+            parts = ARTIFACT_STORE_PREFIX[len("s3://"):].split("/",1)
+            bucket = parts[0]; base = parts[1] if len(parts)>1 else ""
+            key = f"{base.rstrip('/')}/{name}/{version}/{artifact.filename}"
+            S3_CLIENT.put_object(Bucket=bucket, Key=key, Body=data)
+            final_uri = f"s3://{bucket}/{key}"
+        else:
+            os.makedirs("/tmp/aegis_registry_artifacts", exist_ok=True)
+            path = f"/tmp/aegis_registry_artifacts/{name}_{version}_{artifact.filename}"
+            open(path,"wb").write(data)
+            final_uri = path
+    mv = ModelVersion(model_id=m.id, version=version, artifact_uri=final_uri, metadata=metadata or "{}", created_at=now)
+    db.add(mv); db.commit()
+    return {"model": name, "version": version, "artifact_uri": final_uri}
+
+@app.post("/models/{name}/versions/{version}/annotations")
+def annotate_version(name: str, version: str, body: dict):
+    db = SessionLocal()
+    mv = db.query(ModelVersion).join(Model).filter(Model.name==name, ModelVersion.version==version).first()
+    if not mv:
+        raise HTTPException(status_code=404, detail="version not found")
+    now = int(time.time())
+    for k,v in body.get("annotations", {}).items():
+        ann = Annotation(model_version_id=mv.id, key=k, value=json.dumps(v), created_at=now)
+        db.add(ann)
+    db.commit()
+    return {"ok": True}
+
+if __name__=="__main__":
+    import uvicorn
+    uvicorn.run("services.registry.pg_model_registry:app", host="0.0.0.0", port=int(os.environ.get("PORT", "8081")))
+
