+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Wrapper to generate remediation backlog and (optionally) create GitHub issues using the generate_remediation_tickets.py script.
+#
+# This script is prefilled to create issues in rsinghunjan/aegis and assign to @rsinghunjan by default.
+#
+# Usage:
+#   ./ops/scripts/create_remediation_issues.sh --input /tmp/acceptance.json [--out /tmp/remediation_backlog.md] [--no-create]
+
+INPUT="/tmp/acceptance.json"
+OUT="/tmp/remediation_backlog.md"
+REPO="rsinghunjan/aegis"
+ASSIGNEE="rsinghunjan"
+CREATE="true"
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --input) INPUT="$2"; shift 2;;
+    --out) OUT="$2"; shift 2;;
+    --no-create) CREATE="false"; shift;;
+    --repo) REPO="$2"; shift 2;;
+    --assignee) ASSIGNEE="$2"; shift 2;;
+    -h|--help) echo "Usage: $0 --input /path/acceptance.json [--out /tmp/backlog.md] [--no-create]"; exit 0;;
+    *) echo "Unknown arg: $1"; exit 1;;
+  esac
+done
+
+if [[ ! -f "$INPUT" ]]; then
+  echo "Acceptance summary not found at $INPUT"
+  exit 1
+fi
+
+echo "Generating remediation backlog from $INPUT -> $OUT"
+python3 ops/scripts/generate_remediation_tickets.py --input "$INPUT" --out "$OUT"
+
+if [[ "$CREATE" == "true" ]]; then
+  echo "Creating GitHub issues in ${REPO} and assigning to ${ASSIGNEE} (requires gh authenticated)"
+  python3 ops/scripts/generate_remediation_tickets.py --input "$INPUT" --out "$OUT" --create-issues --repo "${REPO}" --assignee "${ASSIGNEE}"
+else
+  echo "Skipping issue creation (--no-create passed)"
+fi
+
+echo "Done. Backlog: $OUT"
+
