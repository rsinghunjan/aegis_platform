+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Prefilled commands to dispatch the "Execute Production Proofs Now" workflow in the repo rsinghunjan/aegis
+# and to run the workflow using either curl (GitHub API) or gh CLI.
+#
+# Usage:
+#  - Ensure GITHUB_TOKEN is set in your environment if using curl.
+#  - Ensure gh is authenticated (gh auth login) if using gh CLI.
+
+REPO="rsinghunjan/aegis"
+WORKFLOW_FILE="execute_production_proofs_now.yml"
+WORKFLOW_NAME="Execute Production Proofs Now"
+EVIDENCE_BUCKET="s3://aegis-evidence-prod"
+
+echo "===== curl (GitHub API) example ====="
+echo "Make sure to set GITHUB_TOKEN and replace ref if needed."
+cat <<'CURL'
+curl -X POST \
+  -H "Accept: application/vnd.github+json" \
+  -H "Authorization: Bearer $GITHUB_TOKEN" \
+  https://api.github.com/repos/rsinghunjan/aegis/actions/workflows/execute_production_proofs_now.yml/dispatches \
+  -d '{
+    "ref": "main",
+    "inputs": {
+      "evidence_bucket": "s3://aegis-evidence-prod",
+      "confirm": "RUN_PROOFS",
+      "promote_gatekeeper": "no",
+      "manual_approval_token": ""
+    }
+  }'
+CURL
+
+echo
+echo "===== gh CLI example ====="
+echo "Requires gh authenticated and repo access."
+echo "gh workflow run \"${WORKFLOW_NAME}\" -R ${REPO} --field evidence_bucket=\"${EVIDENCE_BUCKET}\" --field confirm=RUN_PROOFS --field promote_gatekeeper=no"
+
+echo
+echo "To dispatch now with curl (non-interactive):"
+echo "  export GITHUB_TOKEN=ghp_xxx"
+echo "  (paste the curl command above)"
+
+echo
+echo "To dispatch now with gh:"
+echo "  gh workflow run \"${WORKFLOW_NAME}\" -R ${REPO} --field evidence_bucket=\"${EVIDENCE_BUCKET}\" --field confirm=RUN_PROOFS --field promote_gatekeeper=no"
+
