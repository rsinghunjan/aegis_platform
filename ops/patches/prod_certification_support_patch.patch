+#!/usr/bin/env python3
+"""
+Simple policy sign/verify helper for PCR policies.
+Security team can use this to sign a PCR policy JSON with a private key (or a KMS-backed signing tool).
+The verifier will refuse unsigned or tampered policies.
+
+Usage (operator/security):
+  # generate RSA keypair (one-time) or use KMS-backed signing (recommended)
+  openssl genpkey -algorithm RSA -out pcr_sign_key.pem -pkeyopt rsa_keygen_bits:3072
+  openssl rsa -pubout -in pcr_sign_key.pem -out pcr_sign_pub.pem
+
+  python pcr_policy_sign.py sign --policy attestation_policy.json --key pcr_sign_key.pem --out signed_policy.json
+  python pcr_policy_sign.py verify --signed signed_policy.json --pub pcr_sign_pub.pem
+
+NOTE: For production use, replace local RSA signing with KMS/Cloud-HSM signing and store public key in k8s secret.
+"""
+import argparse, json, base64
+from cryptography.hazmat.primitives import serialization, hashes
+from cryptography.hazmat.primitives.asymmetric import padding
+
+def sign_policy(policy_path, key_path, out_path):
+    policy = open(policy_path).read().encode("utf-8")
+    key = serialization.load_pem_private_key(open(key_path,"rb").read(), password=None)
+    sig = key.sign(policy, padding.PKCS1v15(), hashes.SHA256())
+    wrapper = {"policy": json.loads(policy.decode("utf-8")), "signature": base64.b64encode(sig).decode("utf-8")}
+    open(out_path,"w").write(json.dumps(wrapper, indent=2))
+    print("Wrote signed policy to", out_path)
+
+def verify_policy(signed_path, pub_path):
+    wrapper = json.load(open(signed_path))
+    sig = base64.b64decode(wrapper["signature"])
+    policy_bytes = json.dumps(wrapper["policy"], separators=(",",":")).encode("utf-8")
+    pub = serialization.load_pem_public_key(open(pub_path,"rb").read())
+    try:
+        pub.verify(sig, policy_bytes, padding.PKCS1v15(), hashes.SHA256())
+        print("Signature valid")
+        return True
+    except Exception as e:
+        print("Signature invalid:", e)
+        return False
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    sp = p.add_subparsers(dest="cmd")
+    s = sp.add_parser("sign")
+    s.add_argument("--policy", required=True)
+    s.add_argument("--key", required=True)
+    s.add_argument("--out", required=True)
+    v = sp.add_parser("verify")
+    v.add_argument("--signed", required=True)
+    v.add_argument("--pub", required=True)
+    args = p.parse_args()
+    if args.cmd == "sign":
+        sign_policy(args.policy, args.key, args.out)
+    elif args.cmd == "verify":
+        ok = verify_policy(args.signed, args.pub)
+        exit(0 if ok else 2)
+    else:
+        p.print_help()
+
