+#!/usr/bin/env python3
+"""
+Auto-fallback controller:
+ - Monitors drift evidence (via evidence store or Prometheus metric)
+ - If drift exceeds threshold, patches Kubernetes deployment to fallback_image or scales down canary
+ - Config via env:
+    MONITOR_SOURCE: "prometheus" | "evidence"
+    PROM_GATEWAY: url (if using pushgateway or Prometheus API)
+    DRIFT_THRESHOLD
+    TARGET_DEPLOYMENT (namespace/name)
+    FALLBACK_IMAGE (full image tag)
+"""
+import os, sys, time, subprocess, json
+from urllib.parse import urljoin
+
+MONITOR_SOURCE = os.environ.get("MONITOR_SOURCE", "evidence")
+DRIFT_THRESHOLD = float(os.environ.get("DRIFT_THRESHOLD", "0.5"))
+TARGET_DEPLOY = os.environ.get("TARGET_DEPLOYMENT")  # format namespace/name
+FALLBACK_IMAGE = os.environ.get("FALLBACK_IMAGE")
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus:9090")
+
+def get_drift_from_evidence(s3_key=None):
+    # placeholder: query S3 evidence index or read latest drift event
+    # In this scaffold, read /tmp/last_drift.json if exists
+    p = "/tmp/last_drift.json"
+    if not os.path.exists(p):
+        return 0.0
+    j = json.load(open(p))
+    return float(j.get("drift_score", 0.0))
+
+def get_drift_from_prometheus():
+    # Query Prometheus for embedding_drift_score gauge
+    q = 'embedding_drift_score'
+    url = f"{PROM_URL}/api/v1/query?query={q}"
+    import requests
+    r = requests.get(url, timeout=10)
+    r.raise_for_status()
+    data = r.json()
+    try:
+        val = float(data["data"]["result"][0]["value"][1])
+        return val
+    except Exception:
+        return 0.0
+
+def patch_deployment_with_image(ns, name, image):
+    cmd = ["kubectl", "set", "image", f"deployment/{name}", f"*={image}", "-n", ns]
+    subprocess.check_call(cmd)
+
+def main():
+    if not TARGET_DEPLOY:
+        print("TARGET_DEPLOYMENT env not set (namespace/name)"); sys.exit(2)
+    ns, name = TARGET_DEPLOY.split("/",1)
+    while True:
+        try:
+            if MONITOR_SOURCE == "prometheus":
+                score = get_drift_from_prometheus()
+            else:
+                score = get_drift_from_evidence()
+            print("Drift score:", score)
+            if score > DRIFT_THRESHOLD:
+                print("Drift exceeded threshold - initiating fallback")
+                if FALLBACK_IMAGE:
+                    patch_deployment_with_image(ns, name, FALLBACK_IMAGE)
+                    print("Deployment patched to fallback image:", FALLBACK_IMAGE)
+                else:
+                    print("No FALLBACK_IMAGE configured - scaling down deployment")
+                    subprocess.check_call(["kubectl","scale","deployment", name,"--replicas=0","-n", ns])
+            time.sleep(60)
+        except Exception as e:
+            print("Auto-fallback error:", e)
+            time.sleep(30)
+
+if __name__=="__main__":
+    main()
+
