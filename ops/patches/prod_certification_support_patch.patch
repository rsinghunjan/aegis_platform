+"""
+Load, verify, and expose a signed PCR policy for the attestation verifier service.
+This module expects the verification public key (PEM) to be available at AK_POLICY_PUB_PATH
+or to use KMS-based verification (operator to implement).
+"""
+import os, json
+from pcr_policy_sign import verify_policy
+
+SIGNED_POLICY_PATH = os.environ.get("SIGNED_POLICY_PATH", "/etc/attestation/signed_attestation_policy.json")
+POLICY_PUB_PATH = os.environ.get("POLICY_PUB_PATH", "/secrets/pcr_policy_pub.pem")
+
+def load_signed_policy():
+    if not os.path.exists(SIGNED_POLICY_PATH):
+        raise FileNotFoundError("Signed policy not found")
+    if not os.path.exists(POLICY_PUB_PATH):
+        raise FileNotFoundError("Policy public key not found")
+    # verify signature
+    ok = verify_policy(SIGNED_POLICY_PATH, POLICY_PUB_PATH)
+    if not ok:
+        raise RuntimeError("Signed policy verification failed")
+    wrapper = json.load(open(SIGNED_POLICY_PATH))
+    return wrapper["policy"]
+
+if __name__=="__main__":
+    print(json.dumps(load_signed_policy(), indent=2))
