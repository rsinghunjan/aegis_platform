+#!/usr/bin/env python3
+"""
+Triton tuning pipeline:
+ - Given a model and candidate configs, apply each config (operator) and run k6 tests
+ - Collect results and recommend best config based on SLO (p95 < target)
+
+This script orchestrates local evaluation using k6 and writes /tmp/triton_tuning_results.json
+"""
+import os
+import json
+import subprocess
+import argparse
+from datetime import datetime
+
+def run_k6(infer_url):
+    env = os.environ.copy()
+    env["INFER_URL"] = infer_url
+    subprocess.check_call(["k6","run","load-tests/k6/inference_load_test.js","--out","json=./k6_result.json"], env=env)
+    return json.load(open("./k6_result.json"))
+
+def evaluate(k6json, p95_target_ms):
+    # naive evaluation: look for http_req_duration p95 if present, otherwise return fail
+    metrics = k6json.get("metrics",{})
+    latency = 0.0
+    if "http_req_duration" in metrics and "p(95)" in metrics["http_req_duration"].get("values",{}):
+        latency = metrics["http_req_duration"]["values"]["p(95)"]
+    # fallback: set to large number
+    ok = latency and latency*1000 <= p95_target_ms
+    return {"p95_ms": latency*1000 if latency else None, "ok": ok}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--infer-url", default="https://api.aegis.local/v1/infer")
+    p.add_argument("--candidates", nargs="+", help="list of candidate config ids", required=True)
+    p.add_argument("--p95-target-ms", type=int, default=500)
+    args = p.parse_args()
+    results = []
+    for c in args.candidates:
+        print("Assuming operator deployed candidate config:", c)
+        k6 = run_k6(args.infer_url)
+        ev = evaluate(k6, args.p95_target_ms)
+        rec = {"candidate": c, "result": ev, "ts": datetime.utcnow().isoformat()+"Z"}
+        results.append(rec)
+        open(f"/tmp/triton_tuning_{c}.json","w").write(json.dumps(rec, indent=2))
+    open("/tmp/triton_tuning_results.json","w").write(json.dumps(results, indent=2))
+    print("Wrote /tmp/triton_tuning_results.json")
+
+if __name__=="__main__":
+    main()
+
