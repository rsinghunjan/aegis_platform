+#!/usr/bin/env python3
+"""
+Integrated TPM verifier using tpm2-tools + OpenSSL.
+
+ - Accepts JSON input with base64 quote and signature and the AK public key.
+ - Verifies signature and (optionally) extracts PCRs for policy comparison.
+
+This requires tpm2-tools and openssl installed on the verifier host.
+"""
+import json
+import base64
+import tempfile
+import subprocess
+import argparse
+from datetime import datetime
+
+def write_tmp(b64, suffix):
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=suffix)
+    f.write(base64.b64decode(b64))
+    f.flush()
+    f.close()
+    return f.name
+
+def verify_sig_with_openssl(quote_file, sig_file, ak_pub_pem):
+    try:
+        subprocess.check_call(["openssl","dgst","-sha256","-verify",ak_pub_pem,"-signature",sig_file,quote_file])
+        return True, "signature_ok"
+    except subprocess.CalledProcessError as e:
+        return False, str(e)
+
+def parse_pcrs(quote_file):
+    # Use tpm2_quote or tpm2_checkquote tooling if available; placeholder returns no PCRs
+    return {}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="infile", required=True)
+    p.add_argument("--ak-pub", required=True)
+    args = p.parse_args()
+    j = json.load(open(args.infile))
+    qf = write_tmp(j["quote"], ".quote")
+    sf = write_tmp(j["sig"], ".sig")
+    ok, msg = verify_sig_with_openssl(qf, sf, args.ak_pub)
+    pcrs = parse_pcrs(qf) if ok else {}
+    out = {"ok": ok, "msg": msg, "pcrs": pcrs, "ts": datetime.utcnow().isoformat()+"Z"}
+    print(json.dumps(out))
+
+if __name__=="__main__":
+    main()
+
