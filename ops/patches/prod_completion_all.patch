+#!/usr/bin/env python3
+"""
+Provisioning inventory automation
+
+ - Create provisioning issues for requested device families
+ - Validate basic reachability (SSH/BMC) using operator-specified probes
+ - Register inventory records in a simple JSON inventory used by CI
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/provisioning/provision_inventory_automation.py --repo owner/repo --devices gpu,rt,hil --inventory /tmp/hw_inventory.json
+"""
+import os
+import argparse
+import requests
+import json
+import subprocess
+from datetime import datetime
+
+GITHUB_API = "https://api.github.com"
+
+DEVICE_TEMPLATES = {
+    "gpu": {"label": "aegis/gpu=true", "checks": ["nvidia-smi -L"]},
+    "rt":  {"label": "aegis/rt=true", "checks": ["uname -r"]},
+    "hil": {"label": "aegis/hil=true", "checks": ["curl -sS http://localhost:8080/health || true"]},
+    "npu": {"label": "aegis/npu=true", "checks": []},
+}
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def create_issue(repo, title, body, token, labels=None):
+    labels = labels or ["onboarding","hardware"]
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    r = requests.post(url, json={"title": title, "body": body, "labels": labels}, headers=gh_headers(token))
+    r.raise_for_status()
+    return r.json().get("html_url")
+
+def probe_ssh(host):
+    # lightweight ping/ssh probe. Operators may customize to use BMC/Redfish
+    try:
+        subprocess.check_call(["ping","-c","1",host], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
+        return True, "ping_ok"
+    except Exception as e:
+        return False, str(e)
+
+def run_remote_checks(host, checks):
+    # This requires operator-provided method (ssh key, bastion). For now record checks requested.
+    results = {}
+    for cmd in checks:
+        results[cmd] = "operator_run_required"
+    return results
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    p.add_argument("--devices", default="gpu,rt,hil")
+    p.add_argument("--inventory", default="/tmp/hw_inventory.json")
+    p.add_argument("--nodes", help="optional node list node1:ip,node2:ip")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required"); return
+    devices = [d.strip() for d in args.devices.split(",") if d.strip()]
+    node_map = {}
+    if args.nodes:
+        for pair in args.nodes.split(","):
+            n,ip = pair.split(":",1)
+            node_map[n]=ip
+    inventory = {"ts": datetime.utcnow().isoformat()+"Z","devices":{}}
+    for d in devices:
+        tmpl = DEVICE_TEMPLATES.get(d, {"label": f"aegis/{d}=true","checks":[]})
+        title = f"[Provisioning] Representative {d.upper()} node/rack requested"
+        body = f"""Request provisioning for a representative {d} target.

+Acceptance criteria:
+- Node reachable from CI (SSH/BMC) or reachable via bastion.
+- Kubernetes node join and label `{tmpl['label']}` applied if applicable.
+- Drivers installed and pinned per ops/installers/driver_versions.json.
+- Add Kube credentials or HIL adapter credentials to CI secrets.
+
+Operator steps:
+- Provision hardware and provide list as node:ip to this script for verification.
+"""
+        issue = create_issue(args.repo, title, body, token)
+        inventory["devices"][d] = {"issue": issue, "nodes": {}}
+        for node, ip in node_map.items():
+            ok, info = probe_ssh(ip)
+            checks = run_remote_checks(ip, tmpl.get("checks",[]))
+            inventory["devices"][d]["nodes"][node] = {"ip": ip, "ssh_probe": ok, "ssh_info": info, "checks": checks}
+    open(args.inventory,"w").write(json.dumps(inventory, indent=2))
+    print("Wrote inventory to", args.inventory)
+
+if __name__ == "__main__":
+    main()
+
