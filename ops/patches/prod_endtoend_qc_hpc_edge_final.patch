+/*
+Complete Terraform snippet to provision:
+ - Secrets Manager secrets for providers (AWS Braket, IBM, Azure, Pennylane)
+ - IRSA IAM role and least-privilege policy for qpu-worker service account
+ - KMS key for cosign & secret encryption
+
+Variables (example):
+ - var.environment, var.eks_oidc_provider_arn, var.eks_oidc_provider_url,
+ - var.qpu_namespace, var.qpu_service_account, var.evidence_bucket_arn, var.kms_key_arn
+*/
+provider "aws" {
+  region = var.aws_region
+}
+
+resource "aws_kms_key" "cosign" {
+  description = "KMS key for cosign and evidence encryption"
+  deletion_window_in_days = 30
+}
+
+resource "aws_secretsmanager_secret" "aws_braket" {
+  name = "${var.environment}/qpu/aws_braket"
+  description = "Braket settings or role config (use IRSA if possible)"
+}
+
+resource "aws_secretsmanager_secret" "ibm" {
+  name = "${var.environment}/qpu/ibm"
+  description = "IBM Q API token"
+}
+
+resource "aws_secretsmanager_secret" "azure" {
+  name = "${var.environment}/qpu/azure"
+  description = "Azure Quantum credentials / service principal"
+}
+
+resource "aws_iam_role" "qpu_irsa" {
+  name = "${var.environment}-qpu-irsa-role"
+  assume_role_policy = data.aws_iam_policy_document.irsa_assume_role.json
+}
+
+data "aws_iam_policy_document" "irsa_assume_role" {
+  statement {
+    effect = "Allow"
+    principals {
+      type        = "Federated"
+      identifiers = [var.eks_oidc_provider_arn]
+    }
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+    condition {
+      test     = "StringEquals"
+      variable = "${replace(var.eks_oidc_provider_url, "https://", "")}:sub"
+      values   = ["system:serviceaccount:${var.qpu_namespace}:${var.qpu_service_account}"]
+    }
+  }
+}
+
+resource "aws_iam_policy" "qpu_worker_policy" {
+  name = "${var.environment}-qpu-worker-policy"
+  policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [
+      {
+        Effect = "Allow",
+        Action = [
+          "secretsmanager:GetSecretValue",
+          "secretsmanager:DescribeSecret"
+        ],
+        Resource = [
+          aws_secretsmanager_secret.aws_braket.arn,
+          aws_secretsmanager_secret.ibm.arn,
+          aws_secretsmanager_secret.azure.arn
+        ]
+      },
+      {
+        Effect = "Allow",
+        Action = [
+          "s3:GetObject",
+          "s3:PutObject",
+          "s3:ListBucket"
+        ],
+        Resource = [
+          var.evidence_bucket_arn,
+          "${var.evidence_bucket_arn}/*"
+        ]
+      },
+      {
+        Effect = "Allow",
+        Action = ["kms:Decrypt","kms:GenerateDataKey"],
+        Resource = [aws_kms_key.cosign.arn]
+      }
+    ]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "qpu_attach" {
+  role       = aws_iam_role.qpu_irsa.name
+  policy_arn = aws_iam_policy.qpu_worker_policy.arn
+}
+
+output "qpu_irsa_role_arn" {
+  value = aws_iam_role.qpu_irsa.arn
+}
