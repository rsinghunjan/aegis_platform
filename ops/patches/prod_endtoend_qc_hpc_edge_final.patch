+#!/usr/bin/env python3
+"""
+Run live provider tests for AWS Braket, IBM, Azure and PennyLane.
+ - Reads provider credentials from Secrets Manager via services.quantum.credentials.secretsmanager_provider.get_secret
+ - Submits a tiny job to each configured provider and polls for a result
+ - Records result + invoice metadata to evidence S3 (EVIDENCE_BUCKET)
+
+Requires provider SDKs and network access.
+"""
+import os, time, logging
+
+from services.quantum.credentials.secretsmanager_provider import get_secret
+from services.quantum.adapters.aws_braket_sdk import run_braket_sync
+from services.quantum.adapters.ibm_qiskit_runtime import run_ibm_sync
+from services.quantum.adapters.azure_quantum_sdk import run_azure_sync
+from services.quantum.adapters.pennylane_prod import run_pennylane_sync
+
+logger = logging.getLogger("live-provider-tests")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def upload_evidence(prefix, payload):
+    try:
+        import boto3, json
+        s3=boto3.client("s3")
+        key=f"{prefix}/{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode())
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    except Exception as e:
+        logger.warning("evidence upload failed: %s", e)
+        return None
+
+def test_braket():
+    secret = get_secret("staging/qpu/aws_braket")
+    logger.info("Braket secret len=%s", len(secret) if secret else 0)
+    res = run_braket_sync({"job_id": f"live-braket-{int(time.time())}", "payload": {"shots": 64}})
+    upload_evidence("qpu/live/braket", res)
+    return res
+
+def test_ibm():
+    secret = get_secret("staging/qpu/ibm")
+    logger.info("IBM secret len=%s", len(secret) if secret else 0)
+    res = run_ibm_sync({"job_id": f"live-ibm-{int(time.time())}", "payload": {"shots": 256}})
+    upload_evidence("qpu/live/ibm", res)
+    return res
+
+def test_azure():
+    secret = get_secret("staging/qpu/azure")
+    logger.info("Azure secret len=%s", len(secret) if secret else 0)
+    res = run_azure_sync({"job_id": f"live-azure-{int(time.time())}", "payload": {"shots": 128}})
+    upload_evidence("qpu/live/azure", res)
+    return res
+
+def test_pennylane():
+    res = run_pennylane_sync({"job_id": f"live-pl-{int(time.time())}", "payload": {"shots": 64}})
+    upload_evidence("qpu/live/pennylane", res)
+    return res
+
+if __name__ == "__main__":
+    print("Starting live provider tests")
+    for fn in (test_braket, test_ibm, test_azure, test_pennylane):
+        try:
+            out = fn()
+            logger.info("Test passed: %s", out.get("job_id"))
+        except Exception as e:
+            logger.exception("Test failed: %s", e)
+
