+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate a provider secret in Secrets Manager and optionally notify via Slack/email (PoC).
+# Usage:
+#   ./ops/scripts/rotate_provider_secret_and_notify.sh --secret-name staging/qpu/aws_braket --new-value '{"access_key":"..."}'
+
+SECRET_NAME=""
+NEW_VALUE=""
+NOTIFY_WEBHOOK=""
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --secret-name) SECRET_NAME="$2"; shift 2;;
+    --new-value) NEW_VALUE="$2"; shift 2;;
+    --notify-webhook) NOTIFY_WEBHOOK="$2"; shift 2;;
+    *) echo "Unknown arg $1"; exit 2;;
+  esac
+done
+
+if [ -z "$SECRET_NAME" ] || [ -z "$NEW_VALUE" ]; then
+  echo "Usage: $0 --secret-name <name> --new-value '<json>' [--notify-webhook <url>]"
+  exit 2
+fi
+
+echo "Rotating secret $SECRET_NAME"
+aws secretsmanager put-secret-value --secret-id "$SECRET_NAME" --secret-string "$NEW_VALUE"
+
+if [ -n "$NOTIFY_WEBHOOK" ]; then
+  payload="{\"text\":\"Secrets rotated for $SECRET_NAME at $(date -u +%Y-%m-%dT%H:%M:%SZ)\"}"
+  curl -sS -X POST -H 'Content-Type: application/json' -d "$payload" "$NOTIFY_WEBHOOK" || true
+fi
+
+echo "Rotation complete"
+
