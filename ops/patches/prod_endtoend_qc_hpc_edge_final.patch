+#!/usr/bin/env python3
+"""
+Improved aggregator:
+ - Downloads evidence by prefix from S3 (supports pagination), bundles into tar.gz,
+ - Signs bundle with cosign (key must be available), uploads bundle and signature,
+ - Writes a manifest JSON listing included objects into evidence bucket.
+"""
+import os, tarfile, tempfile, json, subprocess, logging
+from datetime import datetime
+
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+logger = logging.getLogger("sim-aggregator-improved")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_KEY = os.environ.get("COSIGN_KEY_PATH", "/secrets/cosign.key")
+
+def list_objects(prefix):
+    s3 = boto3.client("s3")
+    paginator = s3.get_paginator("list_objects_v2")
+    objs = []
+    for page in paginator.paginate(Bucket=EVIDENCE_BUCKET, Prefix=prefix):
+        for item in page.get("Contents", []):
+            objs.append(item["Key"])
+    return objs
+
+def download_objects(keys, dst_dir):
+    s3 = boto3.client("s3")
+    for k in keys:
+        out_path = os.path.join(dst_dir, os.path.basename(k))
+        s3.download_file(EVIDENCE_BUCKET, k, out_path)
+
+def aggregate_and_sign(prefix):
+    tmp = tempfile.mkdtemp()
+    keys = list_objects(prefix)
+    logger.info("Found %d objects under %s", len(keys), prefix)
+    if not keys:
+        return None
+    download_objects(keys, tmp)
+    bundle_name = f"evidence-{prefix.replace('/','-')}-{datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')}.tar.gz"
+    bundle_path = os.path.join("/tmp", bundle_name)
+    with tarfile.open(bundle_path, "w:gz") as tar:
+        tar.add(tmp, arcname=os.path.basename(tmp))
+    # sign
+    if os.path.exists(COSIGN_KEY) and shutil.which("cosign"):
+        subprocess.check_call(["cosign", "sign", "--key", COSIGN_KEY, bundle_path])
+    # upload bundle and signature
+    s3 = boto3.client("s3")
+    s3.upload_file(bundle_path, EVIDENCE_BUCKET, f"bundles/{bundle_name}")
+    if os.path.exists(bundle_path + ".sig"):
+        s3.upload_file(bundle_path + ".sig", EVIDENCE_BUCKET, f"bundles/{bundle_name}.sig")
+    manifest = {"bundle": bundle_name, "count": len(keys), "keys": keys, "ts": datetime.utcnow().isoformat()}
+    s3.put_object(Bucket=EVIDENCE_BUCKET, Key=f"bundles/{bundle_name}.manifest.json", Body=json.dumps(manifest).encode())
+    return f"s3://{EVIDENCE_BUCKET}/bundles/{bundle_name}"
+
+if __name__ == "__main__":
+    import sys, shutil
+    prefix = sys.argv[1] if len(sys.argv) > 1 else "simulations/"
+    print("Aggregating prefix:", prefix)
+    print(aggregate_and_sign(prefix))
+
