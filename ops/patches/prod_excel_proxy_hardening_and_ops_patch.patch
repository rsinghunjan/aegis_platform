+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Import Grafana dashboard JSON into a running Grafana instance using API key.
+# Usage:
+#  ./ops/grafana/import_dashboard.sh <grafana_url> <api_key> <dashboard_json_path>
+GRAFANA_URL=${1:-http://grafana.example.com}
+API_KEY=${2:-}
+DASH_JSON=${3:-monitoring/grafana/sustainability_full_dashboard.json}
+
+if [ -z "$API_KEY" ]; then
+  echo "Provide API key as second argument"; exit 2
+fi
+
+TMP=$(mktemp)
+cat "$DASH_JSON" > "$TMP"
+curl -s -X POST "${GRAFANA_URL}/api/dashboards/db" -H "Authorization: Bearer ${API_KEY}" -H "Content-Type: application/json" -d @"$TMP"
+rm -f "$TMP"
+echo "Imported dashboard to ${GRAFANA_URL}"
+
