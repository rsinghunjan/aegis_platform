+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create an Azure AD App registration for the Excel Add-in and output values to stdout.
+# Requires `az` CLI logged in with sufficient privileges.
+#
+# Usage:
+#   ./ops/azure/register_azure_ad_app.sh <app-display-name> <reply-url>
+APP_NAME=${1:-"Aegis Excel Addin"}
+REPLY_URL=${2:-"https://aegis-proxy.example.com/addin/taskpane.html"}
+
+echo "Creating Azure AD app: $APP_NAME"
+APP_JSON=$(az ad app create --display-name "$APP_NAME" --reply-urls "$REPLY_URL" --available-to-other-tenants false --output json)
+APP_ID=$(echo "$APP_JSON" | jq -r .appId)
+OBJ_ID=$(echo "$APP_JSON" | jq -r .id)
+TENANT_ID=$(az account show --query tenantId -o tsv)
+
+echo "Creating service principal for the app"
+az ad sp create --id "$APP_ID" >/dev/null
+
+echo "Creating client secret (valid 2 years)"
+SECRET_JSON=$(az ad app credential reset --id "$APP_ID" --append --years 2 --output json)
+CLIENT_SECRET=$(echo "$SECRET_JSON" | jq -r .password)
+
+OIDC_ISSUER="https://login.microsoftonline.com/${TENANT_ID}/v2.0"
+
+cat <<EOF
+Azure AD App created:
+  client_id: ${APP_ID}
+  tenant_id: ${TENANT_ID}
+  client_secret: (hidden)
+  OIDC_ISSUER: ${OIDC_ISSUER}
+
+IMPORTANT:
+ - Copy the client_id/application id and client_secret to a k8s secret for the Excel proxy deployment.
+ - Grant the app required API permissions or admin consent if needed for SSO flows.
+EOF
+
+echo "CLIENT_ID=${APP_ID}"
+echo "TENANT_ID=${TENANT_ID}"
+echo "CLIENT_SECRET=${CLIENT_SECRET}"
+echo "OIDC_ISSUER=${OIDC_ISSUER}"
