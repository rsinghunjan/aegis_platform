+"""Enhanced Aegis Excel Backend Proxy with rate limiting, DLP, and safety gating hooks.
+ - Adds per-user in-memory rate limiting (token-bucket style) for Add-in traffic (simple fallback; use API gateway for production).
+ - Applies DLP checks on prompts and blocks or redacts per policy.
+ - Optionally enforces a safety pre-check by calling the verifier service before forwarding to RAG to avoid costly RAG calls on obviously sensitive content.
+"""
+import os
+import time
+import json
+from fastapi import FastAPI, Header, HTTPException, Request, Response
+from pydantic import BaseModel
+import requests
+from cachetools import TTLCache
+from typing import Dict, Any
+from services.excel.dlp_rules import contains_pii, redact
+from jose import jwt, JWTError
+
+# Configuration (env)
+RATE_LIMIT_PER_MIN = int(os.environ.get("EXCEL_RATE_LIMIT_PER_MIN", "60"))  # per user
+VERIFIER_URL = os.environ.get("VERIFIER_URL", "http://verifier.safety.svc:8080/verify")
+SERVICE_API_KEY = os.environ.get("SERVICE_API_KEY", "")
+AEGIS_RAG_URL = os.environ.get("AEGIS_RAG_URL", "http://rag-service.svc:8080/infer")
+OIDC_ISSUER = os.environ.get("OIDC_ISSUER", "")
+CLIENT_ID = os.environ.get("CLIENT_ID", "")
+
+app = FastAPI(title="Aegis Excel Proxy (enhanced)")
+
+# Simple in-memory counters: key => (count, window_start)
+RATE_CACHE = TTLCache(maxsize=100000, ttl=60*60)  # entries expire after 1h
+
+def check_rate_limit(user_id: str):
+    now = int(time.time())
+    window = now // 60
+    key = f"{user_id}:{window}"
+    val = RATE_CACHE.get(key, 0)
+    if val >= RATE_LIMIT_PER_MIN:
+        return False
+    RATE_CACHE[key] = val + 1
+    return True
+
+def validate_bearer_token(token: str):
+    # minimal validation; use full JWKS validation in production
+    try:
+        # decode without verification to extract sub (for demo). Real implementation must verify signature using JWKS.
+        payload = jwt.decode(token, options={"verify_signature": False})
+        return payload
+    except JWTError:
+        raise HTTPException(status_code=401, detail="Invalid token")
+
+class InferRequest(BaseModel):
+    prompt: str
+    mode: str = "evidence_required"
+    top_k: int = 5
+
+@app.post("/api/rag/infer")
+def rag_infer(req: InferRequest, authorization: str = Header(None)):
+    if not authorization or not authorization.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Missing Authorization header")
+    token = authorization.split(" ",1)[1]
+    user = validate_bearer_token(token)
+    user_id = user.get("sub") or user.get("email") or "unknown"
+
+    # Rate limiting
+    if not check_rate_limit(user_id):
+        raise HTTPException(status_code=429, detail="Rate limit exceeded")
+
+    # DLP: block if PII present; otherwise redact to minimize exposure
+    if contains_pii(req.prompt):
+        # Block and ask user to remove sensitive data or automatically redact and continue
+        raise HTTPException(status_code=400, detail="Prompt contains sensitive PII. Remove or request data redaction.")
+
+    # Optional safety pre-check: call verifier on short claim to decide whether to proceed
+    # This is a lightweight heuristic to avoid calling heavy RAG on obviously malicious prompts.
+    try:
+        vh = requests.post(VERIFIER_URL, json={"claim": req.prompt, "evidence": []}, headers={"Authorization": f"Bearer {SERVICE_API_KEY}"}, timeout=3)
+        if vh.status_code == 200:
+            vj = vh.json()
+            # if verifier says 'contradict' or 'insufficient' with very low confidence, still allow; conservative gating left to Aegis RAG
+    except Exception:
+        # verifier unresponsive -> proceed but log
+        pass
+
+    # Forward to Aegis RAG
+    payload = {"prompt": req.prompt, "mode": req.mode, "top_k": req.top_k, "requester": user_id}
+    headers = {"Authorization": f"Bearer {SERVICE_API_KEY}", "Content-Type": "application/json"}
+    r = requests.post(AEGIS_RAG_URL, json=payload, headers=headers, timeout=30)
+    if r.status_code != 200:
+        raise HTTPException(status_code=502, detail="Upstream RAG error")
+    resp = r.json()
+
+    # Provide lightweight provenance redaction: strip long docs if PII suspected
+    for p in resp.get("retrieved", []):
+        if contains_pii(p.get("text","")):
+            p["text"] = redact(p["text"])
+
+    # Log minimal audit event (do not store tokens)
+    try:
+        with open("/tmp/aegis_excel_proxy.log", "a") as f:
+            f.write(json.dumps({"ts": int(time.time()), "user": user_id, "prompt": req.prompt[:100], "verifier": resp.get("verifier", {})}) + "\n")
+    except Exception:
+        pass
+
+    return resp
+
+@app.post("/api/enqueue")
+def enqueue_for_review(body: Dict[str, Any], authorization: str = Header(None)):
+    if not authorization or not authorization.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Missing Authorization header")
+    token = authorization.split(" ",1)[1]
+    user = validate_bearer_token(token)
+    user_id = user.get("sub") or user.get("email") or "unknown"
+    if not check_rate_limit(user_id):
+        raise HTTPException(status_code=429, detail="Rate limit exceeded")
+    # DLP on payload
+    if contains_pii(body.get("text", "")) or contains_pii(body.get("output","")):
+        raise HTTPException(status_code=400, detail="Content contains sensitive PII; cannot enqueue")
+    # forward
+    headers = {"Content-Type":"application/json"}
+    payload = dict(body)
+    payload["reported_by"] = user_id
+    try:
+        r = requests.post(os.environ.get("HUMAN_QUEUE_URL", "http://human-queue.safety.svc:80/enqueue"), json=payload, headers=headers, timeout=10)
+        r.raise_for_status()
+    except Exception as e:
+        raise HTTPException(status_code=502, detail=f"Human queue error: {e}")
+    return r.json()
+
+@app.get("/.well-known/health")
+def health():
+    return {"status":"ok"}
+
