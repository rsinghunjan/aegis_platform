+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create Kubernetes secret aesgis-secrets with azure_client_id, azure_client_secret, service_api_key and oidc_issuer
+# Usage:
+#   ./ops/k8s/create_excel_proxy_secrets.sh <namespace> <client_id> <client_secret> <service_api_key> <oidc_issuer>
+NS=${1:-safety}
+CLIENT_ID=${2:-}
+CLIENT_SECRET=${3:-}
+SERVICE_API_KEY=${4:-}
+OIDC_ISSUER=${5:-}
+
+if [ -z "$CLIENT_ID" ] || [ -z "$CLIENT_SECRET" ] || [ -z "$SERVICE_API_KEY" ] || [ -z "$OIDC_ISSUER" ]; then
+  echo "Usage: $0 <namespace> <client_id> <client_secret> <service_api_key> <oidc_issuer>"
+  exit 2
+fi
+
+kubectl -n "$NS" create secret generic aegis-secrets \
+  --from-literal=azure_client_id="$CLIENT_ID" \
+  --from-literal=azure_client_secret="$CLIENT_SECRET" \
+  --from-literal=service_api_key="$SERVICE_API_KEY" \
+  --from-literal=oidc_issuer="$OIDC_ISSUER" \
+  --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Created secret 'aegis-secrets' in namespace $NS"
+
