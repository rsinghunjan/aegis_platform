+"""
+Bake/push golden image and rollout to staging namespace.
+
+Environment:
+ - DOCKER_REGISTRY, DOCKER_USERNAME, DOCKER_PASSWORD
+ - KUBECONFIG or in-cluster access
+
+This script builds the local golden image (uses ops/images/bake_golden_image.sh),
+pushes to the configured registry and updates staging DaemonSet/Deployment to use the new image.
+"""
+import os
+import subprocess
+import argparse
+from datetime import datetime
+
+def docker_login(reg, user, pwd):
+    subprocess.check_call(["docker","login",reg,"-u",user,"-p",pwd])
+
+def build_and_push(image_tag):
+    subprocess.check_call(["./ops/images/bake_golden_image.sh", image_tag])
+    subprocess.check_call(["docker","tag", image_tag, image_tag])
+    subprocess.check_call(["docker","push", image_tag])
+
+def rollout_deployment(namespace, deployment, container, image_tag):
+    subprocess.check_call(["kubectl","-n",namespace,"set","image","deployment/"+deployment,f"{container}={image_tag}"])
+    print("Triggered rollout; monitor with: kubectl -n",namespace,"rollout status deployment/"+deployment)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--image", required=True)
+    p.add_argument("--namespace", default="staging")
+    p.add_argument("--deployment", default="robot-agent")
+    p.add_argument("--container", default="agent")
+    args = p.parse_args()
+    reg = os.environ.get("DOCKER_REGISTRY")
+    user = os.environ.get("DOCKER_USERNAME")
+    pwd = os.environ.get("DOCKER_PASSWORD")
+    if reg and user and pwd:
+        docker_login(reg, user, pwd)
+    build_and_push(args.image)
