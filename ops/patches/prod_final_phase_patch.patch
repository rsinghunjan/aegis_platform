+"""
+Automated loop to tune Triton configs for a model by iterating batch sizes / instance counts,
+running k6 load tests and recording results. Operator must deploy the candidate config to Triton model repo.
+"""
+import itertools
+import subprocess
+import json
+import os
+from datetime import datetime
+
+DEFAULT_BATCH_OPTIONS = [1,2,4,8,16]
+DEFAULT_INSTANCE_OPTIONS = [1,2,4]
+
+def run_k6_once(infer_url):
+    subprocess.check_call(["k6","run","load-tests/k6/inference_load_test.js","--out","json=./k6_result_tmp.json"], env={**os.environ, "INFER_URL": infer_url})
+    return json.load(open("./k6_result_tmp.json"))
+
+def evaluate_results(k6_json):
+    # Simplified: extract http_reqs and checks rate if available
+    metrics = k6_json.get("metrics",{})
+    rps = metrics.get("http_reqs",{}).get("count",0)
+    checks = metrics.get("checks",{}).get("rate",0)
+    return {"rps": rps, "checks": checks}
+
+def main():
+    infer_url = os.environ.get("INFER_URL","https://api.aegis.local/v1/infer")
+    model = os.environ.get("TRITON_MODEL","example_model")
+    results = []
+    for batch, inst in itertools.product(DEFAULT_BATCH_OPTIONS, DEFAULT_INSTANCE_OPTIONS):
+        cfg = {"model": model, "batch": batch, "instances": inst, "ts": datetime.utcnow().isoformat()+"Z"}
+        print("Testing candidate", cfg)
+        # operator must apply config to Triton model repo manually or via CI prior to k6 run
+        k6 = run_k6_once(infer_url)
+        eval = evaluate_results(k6)
+        cfg.update(eval)
+        results.append(cfg)
+        open(f"/tmp/triton_tune_results_{batch}_{inst}.json","w").write(json.dumps(cfg, indent=2))
+    open("/tmp/triton_tune_summary.json","w").write(json.dumps(results, indent=2))
+    print("Wrote /tmp/triton_tune_summary.json")
+
+if __name__ == "__main__":
+    main()
