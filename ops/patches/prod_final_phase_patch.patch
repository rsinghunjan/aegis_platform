+#!/usr/bin/env python3
+"""
+Schedule continuous 72h soak runs by creating a Kubernetes Job (rolling).
+This script creates a Job manifest with unique name so multiple runs can be tracked.
+"""
+import subprocess
+import argparse
+import json
+from datetime import datetime
+
+def create_soak_job(name_suffix):
+    job = {
+        "apiVersion": "batch/v1",
+        "kind": "Job",
+        "metadata": {"name": f"aegis-soak-{name_suffix}"},
+        "spec": {
+            "template": {
+                "spec": {
+                    "containers": [{
+                        "name":"soak",
+                        "image":"python:3.11-slim",
+                        "command":["bash","-lc","python -u -c 'import time; print(\"Soak running\"); time.sleep(259200)'"]
+                    }],
+                    "restartPolicy":"Never"
+                }
+            },
+            "backoffLimit":0
+        }
+    }
+    with open("/tmp/soak_job.json","w") as f:
+        json.dump(job,f)
+    subprocess.check_call(["kubectl","apply","-f","/tmp/soak_job.json"])
+    print("Submitted soak job aegis-soak-"+name_suffix)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--run-id", default=datetime.utcnow().strftime("%Y%m%d%H%M"))
+    args = p.parse_args()
+    create_soak_job(args.run_id)
+
+if __name__ == "__main__":
+    main()
