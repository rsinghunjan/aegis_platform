+#!/usr/bin/env python3
+"""
+SME workflow automation helpers:
+ - Create SME issues for unapproved/high-priority invariants
+ - Provide a simple review endpoint to mark an invariant as sme_approved
+ - Aggregate prover results for SME consumption
+"""
+import os
+import glob
+import json
+import requests
+from datetime import datetime
+
+GITHUB_API = "https://api.github.com"
+
+def gh_headers(token):
+    return {"Authorization":f"token {token}","Accept":"application/vnd.github+json"}
+
+def create_sme_issue(repo, inv_id, smt_path, meta_path, token):
+    title = f"[SME Review] {inv_id}"
+    body = f"Please review SMT encoding at `{smt_path}` and meta `{meta_path}`. After approval set `sme_approved: true` in meta."
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    r = requests.post(url, json={"title": title, "body": body, "labels":["sme","formal"]}, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        return r.json()["html_url"]
+    return None
+
+def find_unapproved():
+    items = []
+    for meta in glob.glob("ops/formal/onboard_submissions/*.meta.json"):
+        m = json.load(open(meta))
+        if m.get("priority") == "high" and not m.get("sme_approved"):
+            inv = os.path.basename(meta).replace(".meta.json","")
+            items.append((inv, meta, meta.replace(".meta.json",".smt2")))
+    return items
+
+def aggregate_prover_results():
+    path = "ops/formal/prover_results.json"
+    if os.path.exists(path):
+        return json.load(open(path))
+    return {}
+
+def main():
+    repo = os.environ.get("GITHUB_REPOSITORY")
+    token = os.environ.get("GITHUB_TOKEN")
+    if not repo or not token:
+        print("GITHUB_REPOSITORY and GITHUB_TOKEN required"); return
+    unapproved = find_unapproved()
+    created = []
+    for inv, meta, smt in unapproved:
+        issue = create_sme_issue(repo, inv, smt, meta, token)
+        created.append({"inv":inv,"issue":issue,"meta":meta,"smt":smt})
+    prov = aggregate_prover_results()
+    out = {"ts": datetime.utcnow().isoformat()+"Z", "items": created, "prover": prov}
+    open("/tmp/sme_workflow_report.json","w").write(json.dumps(out, indent=2))
+    print("Wrote /tmp/sme_workflow_report.json")
+
+if __name__ == "__main__":
+    main()
+
