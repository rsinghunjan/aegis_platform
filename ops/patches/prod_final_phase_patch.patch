+#!/usr/bin/env python3
+"""
+Automate provisioning ticket creation and basic CI accessibility checks for
+representative hardware (HIL racks, RT robots, accelerator nodes).
+
+Responsibilities:
+ - Create GitHub provisioning issues with acceptance criteria for each device family.
+ - Validate node joinability by checking SSH/BMC access (operator supplies connection tests).
+ - Validate Kubernetes join and label propagation for CI use.
+ - Produce an /tmp/provisioning_report.json summarizing status.
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/provisioning/physical_provisioning_automation.py --repo owner/repo --devices gpu,rt,hil
+"""
+import os
+import argparse
+import json
+import subprocess
+import requests
+from datetime import datetime
+
+GITHUB_API = "https://api.github.com"
+
+DEVICES_META = {
+    "gpu": {"label":"aegis/gpu=true", "example_check":"ssh root@<ip> 'nvidia-smi'"},
+    "lpu": {"label":"aegis/lpu=true", "example_check":"ssh root@<ip> 'ls /dev/*lpu* || true'"},
+    "npu": {"label":"aegis/npu=true", "example_check":"ssh root@<ip> 'ls /dev/*npu* || true'"},
+    "qpu": {"label":"aegis/qpu=true", "example_check":"ssh root@<ip> 'echo qpu'"},
+    "rt":  {"label":"aegis/rt=true",  "example_check":"ssh root@<ip> 'uname -r'"},
+    "hil": {"label":"aegis/hil=true", "example_check":"ssh root@<ip> 'curl -s http://localhost:8080/health || true'"},
+}
+
+def gh_headers(token):
+    return {"Authorization":f"token {token}", "Accept":"application/vnd.github+json"}
+
+def create_issue(repo, title, body, token, labels=["onboarding","hardware"]):
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    r = requests.post(url, json={"title":title,"body":body,"labels":labels}, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        return r.json()["html_url"]
+    raise RuntimeError(f"Failed to create issue: {r.status_code} {r.text}")
+
+def check_ssh_access(host):
+    # Simple ping + SSH test placeholder. Operators must provide working SSH keys in environment or customize.
+    try:
+        subprocess.check_call(["ping","-c","1",host], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
+        return True, "ping_ok"
+    except Exception:
+        return False, "ping_fail"
+
+def check_kube_node_label(node, label):
+    try:
+        out = subprocess.check_output(["kubectl","get","node",node,"-o","json"], text=True, timeout=10)
+        return label in out, "checked"
+    except Exception:
+        return False, "kubectl_fail"
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    p.add_argument("--devices", default="gpu,rt,hil")
+    p.add_argument("--nodes", default="", help="optional comma list of node names to validate (k8s)")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required"); return
+    devices = [d.strip() for d in args.devices.split(",") if d.strip()]
+    nodes = [n.strip() for n in args.nodes.split(",") if n.strip()]
+    report = {"ts": datetime.utcnow().isoformat()+"Z", "devices": {}}
+    for d in devices:
+        meta = DEVICES_META.get(d, {"label":f"aegis/{d}=true","example_check":"operator-check"})
+        title = f"[Provision] Representative {d.upper()} hardware provisioning request"
+        body = (
+            f"Please provision one representative {d} target for staging/HIL.\n\n"
+            f"Acceptance criteria:\n"
+            f"- Node/rack reachable by CI (SSH/BMC) and accessible for driver checks (example: {meta['example_check']}).\n"
+            f"- Node joined to Kubernetes and labeled `{meta['label']}`.\n"
+            f"- Kube node or HIL adapter credentials provided to CI as secrets.\n\n"
+            "Operator: after provisioning, run:\n"
+            f"  python ops/provisioning/physical_provisioning_automation.py --repo {args.repo} --devices {d} --nodes <node-name>\n"
+        )
+        try:
+            issue = create_issue(args.repo, title, body, token)
+        except Exception as e:
+            issue = f"issue-create-failed: {e}"
+        # simple node checks
+        node_checks = {}
+        for node in nodes:
+            ok,label = check_kube_node_label(node, meta["label"])
+            node_checks[node] = {"label_present": ok, "info": label}
+        report["devices"][d] = {"issue": issue, "nodes": node_checks}
+    out = "/tmp/provisioning_report.json"
+    open(out,"w").write(json.dumps(report, indent=2))
+    print("Wrote", out)
+
+if __name__ == "__main__":
+    main()
+
