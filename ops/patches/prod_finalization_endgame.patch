+#!/usr/bin/env python3
+"""
+Collect metrics, logs and traces after a QPU worker incident and upload to evidence bucket.
+ - Pulls Prometheus snapshots (range queries) and pod logs
+ - Optionally pulls OTLP traces (if collector exposes an endpoint)
+ - Bundles and uploads artifacts
+"""
+import os, subprocess, tempfile, json, logging
+from datetime import datetime
+
+logger = logging.getLogger("postmortem")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def fetch_prometheus_snapshot(query, prometheus_url="http://prometheus.monitoring.svc:9090"):
+    out = subprocess.check_output(["curl","-sS", f"{prometheus_url}/api/v1/query?query={query}"])
+    tmp = tempfile.NamedTemporaryFile(delete=False, prefix="prom-snap-", suffix=".json")
+    tmp.write(out); tmp.close()
+    return tmp.name
+
+def fetch_pod_logs(namespace="monitoring", label="app=qpu-worker", tail=500):
+    out = subprocess.check_output(["kubectl","-n",namespace,"logs","-l",label,"--tail","%d" % tail])
+    tmp = tempfile.NamedTemporaryFile(delete=False, prefix="worker-logs-", suffix=".log")
+    tmp.write(out); tmp.close()
+    return tmp.name
+
+def upload(local_path, prefix):
+    if not EVIDENCE_BUCKET:
+        return local_path
+    import boto3
+    s3 = boto3.client("s3")
+    key = f"{prefix}/{os.path.basename(local_path)}"
+    s3.upload_file(local_path, EVIDENCE_BUCKET, key)
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+def run_collect():
+    files = []
+    q = 'increase(aegis_qpu_jobs_queued[5m])'
+    files.append(fetch_prometheus_snapshot(q))
+    files.append(fetch_pod_logs())
+    uploaded = [upload(f, "postmortem") for f in files]
+    manifest = {"ts": datetime.utcnow().isoformat(), "files": uploaded}
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3 = boto3.client("s3")
+        key = f"postmortem/manifest-{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(manifest).encode())
+        logger.info("Uploaded manifest s3://%s/%s", EVIDENCE_BUCKET, key)
+    else:
+        logger.info("Collected artifacts: %s", uploaded)
+
+if __name__ == "__main__":
+    run_collect()
+
