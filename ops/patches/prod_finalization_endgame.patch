+#!/usr/bin/env python3
+"""
+Full live-provider E2E runner + invoice watcher + automatic reconciliation trigger.
+
+Behavior:
+ - Submits small jobs to available provider adapters (Braket, IBM, Azure, PennyLane)
+ - Polls for completion and uploads job evidence and provisional invoice metadata to S3 (EVIDENCE_BUCKET)
+ - Optionally watches an S3 prefix (invoices/) and runs the billing reconciliation when CSVs appear
+ - Emits a reconciliation manifest and writes to BillingRecord via billing_invoice_linker
+
+Usage:
+  EVIDENCE_BUCKET=... python services/quantum/live_e2e_runner.py --run-tests
+  EVIDENCE_BUCKET=... python services/quantum/live_e2e_runner.py --watch-invoices
+"""
+import os
+import time
+import argparse
+import logging
+import json
+from datetime import datetime
+
+logger = logging.getLogger("live-e2e")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def upload_evidence(prefix, payload):
+    payload["ts"] = datetime.utcnow().isoformat()
+    if not EVIDENCE_BUCKET:
+        path = f"/tmp/{prefix.replace('/','_')}_{int(time.time())}.json"
+        with open(path, "w") as f:
+            json.dump(payload, f, indent=2)
+        logger.info("Wrote evidence locally: %s", path)
+        return path
+    import boto3
+    s3 = boto3.client("s3")
+    key = f"{prefix}/{datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')}-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode())
+    uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+    logger.info("Uploaded evidence: %s", uri)
+    return uri
+
+def run_adapter_if_present(module_path, function_name, provider_name, payload):
+    try:
+        module = __import__(module_path, fromlist=[function_name])
+        fn = getattr(module, function_name)
+        return fn({"job_id": f"e2e-{provider_name}-{int(time.time())}", "payload": payload})
+    except Exception as e:
+        logger.warning("Adapter %s not available or failed: %s", provider_name, e)
+        return {"job_id": f"e2e-{provider_name}-failed-{int(time.time())}", "error": str(e)}
+
+def run_all_tests():
+    results = {}
+    adapters = [
+        ("services.quantum.adapters.aws_braket_sdk", "run_braket_sync", "aws_braket", {"shots": 64}),
+        ("services.quantum.adapters.ibm_qiskit_runtime", "run_ibm_sync", "ibm", {"shots": 128}),
+        ("services.quantum.adapters.azure_quantum_sdk", "run_azure_sync", "azure", {"shots": 64}),
+        ("services.quantum.adapters.pennylane_prod", "run_pennylane_sync", "pennylane", {"shots": 64}),
+    ]
+    for module, fn, name, payload in adapters:
+        logger.info("Running %s", name)
+        res = run_adapter_if_present(module, fn, name, payload)
+        uri = upload_evidence(f"qpu/live/{name}/result", res)
+        # Create provisional invoice marker (providers often deliver invoices separately)
+        invoice = {"job_id": res.get("job_id"), "provider": name, "estimated_cost": res.get("estimated_cost", 0.0)}
+        upload_evidence("qpu/invoices/provisional", invoice)
+        results[name] = {"result": res, "evidence_uri": uri}
+    upload_evidence("qpu/live/summary", results)
+    return results
+
+def watch_invoices_and_reconcile(poll_interval=60):
+    """
+    Poll S3 invoices/ prefix and call billing_invoice_linker for any new CSVs. This PoC marks objects as processed
+    by copying them to invoices/processed/.
+    """
+    import boto3
+    s3 = boto3.client("s3")
+    seen = set()
+    while True:
+        resp = s3.list_objects_v2(Bucket=EVIDENCE_BUCKET, Prefix="qpu/invoices/")
+        for obj in resp.get("Contents", []):
+            key = obj["Key"]
+            if key.endswith("/") or key in seen:
+                continue
+            if not key.lower().endswith(".csv"):
+                continue
+            logger.info("Found invoice: %s", key)
+            # download locally
+            local = f"/tmp/{os.path.basename(key)}"
+            s3.download_file(EVIDENCE_BUCKET, key, local)
+            # call reconciler
+            try:
+                from services.quantum.billing_invoice_linker import process_csv
+                process_csv(local)
+            except Exception as e:
+                logger.exception("Reconcile failed: %s", e)
+                continue
+            # move to processed prefix
+            dest = key.replace("qpu/invoices/", "qpu/invoices/processed/")
+            s3.copy_object(Bucket=EVIDENCE_BUCKET, CopySource={'Bucket': EVIDENCE_BUCKET, 'Key': key}, Key=dest)
+            s3.delete_object(Bucket=EVIDENCE_BUCKET, Key=key)
+            seen.add(key)
+        time.sleep(poll_interval)
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--run-tests", action="store_true")
+    parser.add_argument("--watch-invoices", action="store_true")
+    args = parser.parse_args()
+    if args.run_tests:
+        run_all_tests()
+    if args.watch_invoices:
+        if not EVIDENCE_BUCKET:
+            logger.error("EVIDENCE_BUCKET required to watch invoices")
+            return
+        watch_invoices_and_reconcile()
+
+if __name__ == "__main__":
+    main()
+
