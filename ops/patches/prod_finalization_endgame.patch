+#!/usr/bin/env python3
+"""
+Per-tenant quotas, caps and enforcement for Billing & Chargeback.
+ - Enforces monthly caps and concurrency caps
+ - Produces Prometheus metrics and optional webhook alerts
+"""
+import os, logging
+from datetime import datetime, timedelta
+from services.quantum.db_models import SessionLocal, BillingRecord, QPUJob
+from prometheus_client import Gauge, Counter
+
+logger = logging.getLogger("billing-enforcer")
+logging.basicConfig(level=logging.INFO)
+
+TENANT_MONTHLY_CAP = float(os.environ.get("TENANT_MONTHLY_CAP_USD", "1000"))
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK", "")
+
+TENANT_SPEND = Gauge("aegis_tenant_spend_usd", "Tenant accumulated spend", ["tenant"])
+TENANT_CAP_VIOLATIONS = Counter("aegis_tenant_cap_violations_total", "Tenant cap violations")
+
+def compute_tenant_spend(tenant):
+    db = SessionLocal()
+    thirty_days_ago = datetime.utcnow() - timedelta(days=30)
+    total = db.query(BillingRecord).filter(BillingRecord.owner == tenant, BillingRecord.created_at >= thirty_days_ago).with_entities(func.sum(BillingRecord.actual_cost)).scalar() or 0.0
+    TENANT_SPEND.labels(tenant=tenant).set(total)
+    return total
+
+def enforce_caps_for_tenant(tenant):
+    total = compute_tenant_spend(tenant)
+    if total >= TENANT_MONTHLY_CAP:
+        TENANT_CAP_VIOLATIONS.inc()
+        logger.warning("Tenant %s exceeded cap: %s >= %s", tenant, total, TENANT_MONTHLY_CAP)
+        if ALERT_WEBHOOK:
+            import requests
+            try:
+                requests.post(ALERT_WEBHOOK, json={"tenant": tenant, "spend": total}, timeout=5)
+            except Exception:
+                logger.exception("Failed to send alert webhook")
+        return False
+    return True
+
+def check_and_reject_submission(tenant):
+    ok = enforce_caps_for_tenant(tenant)
+    if not ok:
+        raise RuntimeError(f"tenant {tenant} monthly cap exceeded")
+    return True
+
