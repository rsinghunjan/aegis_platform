+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate a Secrets Manager secret and record rotation evidence to EVIDENCE_BUCKET
+if [ -z "${EVIDENCE_BUCKET:-}" ]; then
+  echo "EVIDENCE_BUCKET required"; exit 2
+fi
+if [ "$#" -lt 2 ]; then
+  echo "Usage: $0 <secret-id> <json-payload>"
+  exit 2
+fi
+SECRET_ID="$1"
+PAYLOAD="$2"
+ROTATED_BY="${ROTATED_BY:-automation}"
+NOTE="${NOTE:-rotated by scheduled job}"
+
+aws secretsmanager put-secret-value --secret-id "$SECRET_ID" --secret-string "$PAYLOAD"
+
+TMP="/tmp/rotation-$(basename $SECRET_ID)-$(date -u +%Y%m%dT%H%M%SZ).json"
+cat > "$TMP" <<EOF
+{
+  "secret_id": "$SECRET_ID",
+  "rotated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
+  "rotated_by": "$ROTATED_BY",
+  "note": "$NOTE"
+}
+EOF
+aws s3 cp "$TMP" "s3://${EVIDENCE_BUCKET}/secrets/rotations/$(basename $TMP)" || true
+echo "Rotation evidence uploaded"
+
