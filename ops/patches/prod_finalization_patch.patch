+#!/usr/bin/env python3
+"""
+Automatic RCA parser for HIL bulk results.
+
+ - Reads /tmp/hil_bulk_results.json produced by scale_hil_campaign_runner.py
+ - Detects failed runs and creates GitHub issues for triage including manifest and stderr output.
+"""
+import json
+import os
+import requests
+
+GITHUB_REPO = os.environ.get("GITHUB_REPOSITORY")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN")
+
+def gh_headers():
+    return {"Authorization": f"token {GITHUB_TOKEN}", "Accept":"application/vnd.github+json"}
+
+def create_issue(title, body, labels=["hil","rca"]):
+    if not GITHUB_REPO or not GITHUB_TOKEN:
+        print("GitHub not configured; would create issue:", title)
+        return
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    r = requests.post(url, json={"title":title,"body":body,"labels":labels}, headers=gh_headers())
+    print("Issue status", r.status_code)
+
+def main():
+    path = "/tmp/hil_bulk_results.json"
+    if not os.path.exists(path):
+        print("No hil bulk results at", path); return
+    j = json.load(open(path))
+    for run in j.get("runs",[]):
+        if not run.get("ok"):
+            title = f"HIL failure: {os.path.basename(run.get('manifest','unknown'))}"
+            body = f"Manifest: {run.get('manifest')}\nError: {run.get('error')}\n\nPlease triage."
+            create_issue(title, body)
+
+if __name__ == "__main__":
+    main()
+
