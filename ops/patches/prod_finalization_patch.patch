+#!/usr/bin/env python3
+"""
+Auto-tune Triton model configs and run k6 tests to determine SLO compliance.
+
+Workflow:
+ - Use triton_tuner to propose config.pbtxt
+ - Deploy config to model-repo (operator action)
+ - Run k6 load test and collect results
+ - If SLO not met, recommend smaller batch sizes or more instances
+"""
+import subprocess
+import json
+import argparse
+from ops.triton.triton_tuner import generate_config
+
+def run_k6(infer_url):
+    subprocess.check_call(["k6","run","load-tests/k6/inference_load_test.js","--out","json=./k6_result.json"], env={"INFER_URL": infer_url})
+    j = json.load(open("k6_result.json"))
+    return j
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--model-size-mb", type=int, required=True)
+    p.add_argument("--model-name", default="example_model")
+    p.add_argument("--infer-url", default="https://api.aegis.local/v1/infer")
+    args = p.parse_args()
+    cfg = generate_config(args.model_name, args.model_size_mb, instance_count=1)
+    open("/tmp/config.pbtxt","w").write(cfg)
+    print("Generated config at /tmp/config.pbtxt; operator must deploy into Triton model-repo.")
+    print("Running k6 to evaluate SLOs (operator must ensure k6 installed)")
+    try:
+        res = run_k6(args.infer_url)
+        print("k6 finished; results saved to k6_result.json")
+    except Exception as e:
+        print("k6 failed:", e)
+
+if __name__ == "__main__":
+    main()
