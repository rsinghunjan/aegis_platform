+#!/usr/bin/env python3
+"""
+TPM Quote client wrapper
+
+ - Uses tpm2-tools (tpm2_quote) to produce an attestation blob and signature.
+ - Writes JSON to stdout or a file for OTA server consumption.
+ - Requires tpm2-tools installed and a TPM with an attestation key provisioned.
+"""
+import subprocess
+import base64
+import json
+from datetime import datetime
+import argparse
+
+def run_quote(ak_handle="0x81010001", pcrs="0,1,2"):
+    # Generate a PCR quote using tpm2-tools. This is an example; adapt per provisioning.
+    sigfile = "/tmp/tpm_quote.sig"
+    quotefile = "/tmp/tpm_quote.out"
+    try:
+        subprocess.check_call(["tpm2_quote","-C",ak_handle,"-l","sha256:"+pcrs,"-q","-m",quotefile,"-s",sigfile])
+        with open(quotefile,"rb") as f:
+            q = base64.b64encode(f.read()).decode()
+        with open(sigfile,"rb") as f:
+            s = base64.b64encode(f.read()).decode()
+        return {"quote": q, "sig": s, "ts": datetime.utcnow().isoformat()+"Z"}
+    except Exception as e:
+        return {"error": str(e), "ts": datetime.utcnow().isoformat()+"Z"}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--ak", default="0x81010001")
+    args = p.parse_args()
+    print(json.dumps(run_quote(ak_handle=args.ak)))
+
+if __name__ == "__main__":
+    main()
+
