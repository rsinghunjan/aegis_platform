+#!/usr/bin/env python3
+"""
+End-to-end live provider validator that:
+ - Submits a small job to each configured provider (AWS Braket, IBM Qiskit Runtime, Azure Quantum, PennyLane)
+ - Polls for completion and collects results
+ - Stores job evidence + provider invoice placeholders to S3
+ - Emits a reconciliation record to the BillingRecord table
+
+Configuration via env:
+ - EVIDENCE_BUCKET (required to upload artifacts)
+ - BRACKET_S3_BUCKET (optional)
+ - Uses services.quantum.credentials.secretsmanager_provider.get_secret to fetch credentials securely
+"""
+import os
+import time
+import json
+import logging
+from datetime import datetime
+
+from services.quantum.credentials.secretsmanager_provider import get_secret
+from services.quantum.db_models import SessionLocal, BillingRecord
+
+logger = logging.getLogger("validate-providers-e2e")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def upload_evidence(prefix: str, payload: dict) -> str:
+    if not EVIDENCE_BUCKET:
+        path = f"/tmp/{prefix.replace('/', '_')}_{int(time.time())}.json"
+        with open(path, "w") as f:
+            json.dump(payload, f, indent=2)
+        return path
+    import boto3
+    s3 = boto3.client("s3")
+    key = f"{prefix}/{datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')}-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+def reconcile_invoice(job_id: str, provider: str, estimated_cost: float):
+    db = SessionLocal()
+    br = BillingRecord(job_id=job_id, owner="system-live-test", provider=provider, estimated_cost=estimated_cost)
+    db.add(br)
+    db.commit()
+    logger.info("Billing record created for %s %s", job_id, provider)
+
+def run_one(adapter_run_fn, provider_name: str, payload: dict):
+    job_id = f"live-{provider_name}-{int(time.time())}"
+    logger.info("Running live test for %s job=%s", provider_name, job_id)
+    try:
+        res = adapter_run_fn({"job_id": job_id, "payload": payload})
+        upload_evidence(f"qpu/live/{provider_name}/result", res)
+        invoice = {"job_id": job_id, "provider": provider_name, "cost_usd": res.get("estimated_cost", 0.0)}
+        upload_evidence("qpu/invoices", invoice)
+        reconcile_invoice(job_id, provider_name, float(res.get("estimated_cost", 0.0) or 0.0))
+        return res
+    except Exception as e:
+        logger.exception("Live test failed for %s: %s", provider_name, e)
+        upload_evidence(f"qpu/live/{provider_name}/error", {"job_id": job_id, "error": str(e)})
+        return {"job_id": job_id, "error": str(e)}
+
+def main():
+    results = {}
+    # AWS Braket
+    try:
+        from services.quantum.adapters.aws_braket_sdk import run_braket_sync
+        results["braket"] = run_one(run_braket_sync, "aws_braket", {"shots": 64})
+    except Exception as e:
+        logger.exception("Braket adapter missing or failed: %s", e)
+    # IBM
+    try:
+        from services.quantum.adapters.ibm_qiskit_runtime import run_ibm_sync
+        results["ibm"] = run_one(run_ibm_sync, "ibm", {"shots": 128})
+    except Exception as e:
+        logger.exception("IBM adapter missing or failed: %s", e)
+    # Azure
+    try:
+        from services.quantum.adapters.azure_quantum_sdk import run_azure_sync
+        results["azure"] = run_one(run_azure_sync, "azure", {"shots": 64})
+    except Exception as e:
+        logger.exception("Azure adapter missing or failed: %s", e)
+    # PennyLane
+    try:
+        from services.quantum.adapters.pennylane_prod import run_pennylane_sync
+        results["pennylane"] = run_one(run_pennylane_sync, "pennylane", {"shots": 64})
+    except Exception as e:
+        logger.exception("Pennylane adapter missing or failed: %s", e)
+
+    upload_evidence("qpu/live/summary", {"ts": int(time.time()), "results": results})
+    logger.info("Live provider validation run complete")
+
+if __name__ == "__main__":
+    main()
+
