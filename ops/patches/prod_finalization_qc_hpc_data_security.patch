+#!/usr/bin/env python3
+"""
+Automatically link provider invoice CSVs (uploaded to s3://<EVIDENCE_BUCKET>/invoices/) to BillingRecord entries.
+ - CSV expected with columns: job_id, provider, cost_usd
+ - Updates BillingRecord.actual_cost and emits a reconciliation manifest to S3
+"""
+import os, csv, logging, tempfile
+from services.quantum.db_models import SessionLocal, BillingRecord
+
+logger = logging.getLogger("billing-linker")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def process_csv(local_path):
+    db = SessionLocal()
+    updated = []
+    with open(local_path) as f:
+        r = csv.DictReader(f)
+        for row in r:
+            jid = row.get("job_id")
+            cost = float(row.get("cost_usd") or row.get("cost") or 0.0)
+            rec = db.query(BillingRecord).filter(BillingRecord.job_id == jid).first()
+            if rec:
+                rec.actual_cost = cost
+                db.commit()
+                updated.append({"job_id": jid, "actual_cost": cost})
+                logger.info("Reconciled %s => %s", jid, cost)
+            else:
+                logger.warning("No billing record for %s", jid)
+    # upload manifest
+    if EVIDENCE_BUCKET:
+        import boto3, json
+        s3 = boto3.client("s3")
+        key = f"invoices/reconcile-manifest-{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(updated).encode())
+        logger.info("Uploaded reconciliation manifest s3://%s/%s", EVIDENCE_BUCKET, key)
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("usage: billing_invoice_linker.py <invoice.csv>")
+        raise SystemExit(2)
+    process_csv(sys.argv[1])
+
