+#!/usr/bin/env python3
+"""
+Helpers to collect traces, metrics and logs for QPU worker postmortems.
+ - Collects Prometheus metric snapshots for qpu_worker and queue
+ - Fetches last N logs from worker pods
+ - Packages data into evidence bundle in S3
+"""
+import os, subprocess, json, tempfile, time, logging
+
+logger = logging.getLogger("qpu-postmortem")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def collect_prometheus_snapshot(prometheus_url="http://prometheus.monitoring.svc:9090"):
+    out = subprocess.check_output(["curl", "-sS", f"{prometheus_url}/api/v1/status/flags"]).decode()
+    tmp = tempfile.NamedTemporaryFile(delete=False, prefix="prom-flags-", suffix=".json")
+    tmp.write(out.encode()); tmp.close()
+    return tmp.name
+
+def collect_worker_logs(namespace="monitoring", label="app=qpu-worker", tail=500):
+    out = subprocess.check_output(["kubectl","-n",namespace,"logs","-l",label,"--tail","%d" % tail]).decode()
+    tmp = tempfile.NamedTemporaryFile(delete=False, prefix="worker-logs-", suffix=".log")
+    tmp.write(out.encode()); tmp.close()
+    return tmp.name
+
+def upload_to_s3(local_path, prefix):
+    if not EVIDENCE_BUCKET:
+        return local_path
+    import boto3
+    s3 = boto3.client("s3")
+    key = f"{prefix}/{os.path.basename(local_path)}"
+    s3.upload_file(local_path, EVIDENCE_BUCKET, key)
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+def run_collect():
+    pf = collect_prometheus_snapshot()
+    lg = collect_worker_logs()
+    r1 = upload_to_s3(pf, "postmortem")
+    r2 = upload_to_s3(lg, "postmortem")
+    logger.info("Uploaded postmortem artifacts: %s %s", r1, r2)
+
+if __name__ == "__main__":
+    run_collect()
+
