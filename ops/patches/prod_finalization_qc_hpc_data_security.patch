+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate a provider secret in AWS Secrets Manager and record rotation evidence to the evidence S3 bucket.
+#
+if [ -z "${EVIDENCE_BUCKET:-}" ]; then
+  echo "EVIDENCE_BUCKET must be set"; exit 2
+fi
+if [ "$#" -lt 2 ]; then
+  echo "Usage: $0 <secret-id> <secret-json>"
+  exit 2
+fi
+SECRET_ID="$1"
+SECRET_JSON="$2"
+
+aws secretsmanager put-secret-value --secret-id "$SECRET_ID" --secret-string "$SECRET_JSON"
+echo "Rotated secret $SECRET_ID"
+
+TMP="/tmp/rotation-$(basename $SECRET_ID)-$(date -u +%Y%m%dT%H%M%SZ).json"
+cat > "$TMP" <<EOF
+{
+  "secret_id": "$SECRET_ID",
+  "rotated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
+  "rotated_by": "${ROTATED_BY:-automation}",
+  "note": "${ROTATION_NOTE:-rotated via ops script}"
+}
+EOF
+
+aws s3 cp "$TMP" "s3://${EVIDENCE_BUCKET}/secrets/rotations/$(basename $TMP)" || true
+echo "Recorded rotation evidence to s3://${EVIDENCE_BUCKET}/secrets/rotations/"
+
