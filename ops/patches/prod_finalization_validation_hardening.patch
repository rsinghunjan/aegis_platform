+#!/usr/bin/env python3
+"""
+Exhaustive OPA policy test harness:
+ - Runs a corpus of historical/simulated canary evaluations through OPA
+ - Produces coverage report and uploads to evidence bucket
+"""
+import os, json, requests, logging, time
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("opa-val")
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa:8181/v1/data/aegis/canary/allow_promote")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def generate_corpus(n=200):
+    corpus=[]
+    for i in range(n):
+        rel = round((i % 20) * 0.01, 3)
+        kpi = round(0.9 - ((i % 15) * 0.01), 3)
+        corpus.append({"input":{"kind":"CanaryEvaluation","run_id":f"test-{i}","metrics":{"rel_drop":rel,"business_kpi":kpi},"policy":{"max_rel_drop":0.05,"min_kpi":0.75},"annotations":{"aegis_evidence_uri":"s3://evidence/test"}}})
+    return corpus
+
+def run(corpus):
+    results=[]
+    for c in corpus:
+        try:
+            r=requests.post(OPA_URL, json=c, timeout=5); r.raise_for_status()
+            results.append({"run_id": c["input"]["run_id"], "allow": r.json().get("result", False)})
+        except Exception as e:
+            results.append({"run_id": c["input"]["run_id"], "error": str(e)})
+    return results
+
+def upload(results):
+    if not EVIDENCE_BUCKET:
+        print(json.dumps(results)[:1000])
+        return
+    import boto3
+    s3=boto3.client("s3")
+    key=f"opa_validation/report-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(results).encode())
+    logger.info("Uploaded OPA report to s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
+
+if __name__ == "__main__":
+    corpus=generate_corpus(int(os.environ.get("OPA_TESTS",200)))
+    res=run(corpus)
+    upload(res)
+    print("OPA validation finished")
+
