+#!/usr/bin/env python3
+"""
+Submit many distributed HPO RayJobs, enforce cost guard, record to chargeback and generate run_ids.
+Produces a JSON manifest of submitted runs and uploads to evidence bucket.
+"""
+import os, time, json, tempfile, subprocess, logging, requests
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("scale-hpo-submit")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+CHARGEBACK_API = os.environ.get("CHARGEBACK_API", "http://chargeback.monitoring.svc:8080/submit")
+COST_GUARD_USD = float(os.environ.get("COST_GUARD_USD", "2000"))
+
+def submit_rayjob(manifest_str):
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(manifest_str.encode()); f.close()
+    out = subprocess.check_output(["kubectl","apply","-f", f.name]).decode()
+    for line in out.splitlines():
+        if "rayjob.ray.io/" in line:
+            return line.split("/")[1]
+    return None
+
+def generate_manifest(samples, team, image="us.gcr.io/aegis/ray-hpo-accel:latest"):
+    return json.dumps({
+        "apiVersion":"ray.io/v1",
+        "kind":"RayJob",
+        "metadata":{"generateName":f"aegis-hpo-{team}-"},
+        "spec":{"entrypoint":f"python /app/run_ray_tune_prod_checkpoint.py --num-samples {samples}", "template":{"spec":{"containers":[{"name":"hpo","image":image}]}}}
+    })
+
+def record_chargeback(team, run_id, est_usd):
+    try:
+        requests.post(CHARGEBACK_API, json={"team":team,"run_id":run_id,"estimated_usd": est_usd}, timeout=5)
+    except Exception:
+        logger.exception("chargeback record failed")
+
+def upload_manifest(manifest, prefix="hpo/submissions"):
+    if not EVIDENCE_BUCKET:
+        return None
+    import boto3, os
+    s3=boto3.client("s3")
+    key=f"{prefix}/submitted-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(manifest).encode())
+    return f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key}"
+
+def main():
+    samples=int(os.environ.get("HPO_SAMPLES", "128"))
+    parallel=int(os.environ.get("HPO_PARALLEL", "4"))
+    team=os.environ.get("HPO_TEAM","validation")
+    est_per_run=float(os.environ.get("EST_PER_RUN_USD","50"))
+    if est_per_run * parallel > COST_GUARD_USD:
+        logger.error("Estimated parallel cost exceeds guard; abort")
+        return
+    submitted=[]
+    for i in range(parallel):
+        manifest=generate_manifest(samples, f"{team}-{i}")
+        run_id=submit_rayjob(manifest)
+        if run_id:
+            record_chargeback(team, run_id, est_per_run)
+            submitted.append({"run_id": run_id, "est_usd": est_per_run})
+    uri=upload_manifest(submitted)
+    print(json.dumps({"submitted": submitted, "evidence": uri}, indent=2))
+
+if __name__ == "__main__":
+    main()
+
