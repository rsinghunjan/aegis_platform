+#!/usr/bin/env python3
+"""
+Automated remediation engine:
+ - Detects repeated failure patterns in Tekton PipelineRuns and applies remediation strategies:
+   restart pods, resubmit with conservative params, and escalate when exhausted.
+ - Records remediation attempts in S3 and supports metrics emission.
+"""
+import os, time, json, logging, subprocess, requests
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("remediation-engine")
+
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE","cicd")
+MAX_REMEDIATIONS = int(os.environ.get("MAX_REMEDIATIONS","3"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+APPROVAL_API = os.environ.get("APPROVAL_SERVICE_URL", "http://approval-service.monitoring.svc:8080")
+
+def list_failed_pipelineruns():
+    out = subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","pipelineruns","-o","json"]).decode()
+    items = json.loads(out).get("items",[])
+    failed=[i for i in items if i.get("status",{}).get("conditions",[{}])[0].get("status")=="False"]
+    return failed
+
+def attempt_remediation(pr):
+    name = pr.get("metadata",{}).get("name")
+    annotations = pr.get("metadata",{}).get("annotations",{})
+    attempts = int(annotations.get("aegis.remediation_attempts","0"))
+    if attempts >= MAX_REMEDIATIONS:
+        return False, attempts
+    # restart related pods
+    pods = json.loads(subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","pods","-o","json"]).decode()).get("items",[])
+    restarted=[]
+    for p in pods:
+        owners = p.get("metadata",{}).get("ownerReferences",[])
+        if any(o.get("name","").startswith(name) for o in owners):
+            podname=p["metadata"]["name"]
+            try:
+                subprocess.check_call(["kubectl","-n",TEKTON_NS,"delete","pod",podname,"--grace-period=5"])
+                restarted.append(podname)
+            except Exception:
+                logger.exception("failed to restart %s", podname)
+    # annotate attempts and resubmit a fresh PipelineRun if safe
+    subprocess.check_call(["kubectl","-n",TEKTON_NS,"annotate","pipelinerun",name,f"aegis.remediation_attempts={attempts+1}","--overwrite"])
+    # resubmit: create a new PipelineRun referencing same pipelineRef and params
+    spec = pr.get("spec",{})
+    pipeline_ref = spec.get("pipelineRef",{}).get("name")
+    params = spec.get("params",[])
+    new_pr = {"apiVersion":"tekton.dev/v1beta1","kind":"PipelineRun","metadata":{"generateName": f"{pipeline_ref}-replay-"},"spec":{"pipelineRef":{"name":pipeline_ref},"params":params}}
+    import tempfile, yaml
+    f=tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.safe_dump(new_pr).encode()); f.close()
+    subprocess.check_call(["kubectl","-n",TEKTON_NS,"apply","-f", f.name])
+    return True, attempts+1
+
+def upload_evidence(pr_name, details):
+    if not EVIDENCE_BUCKET:
+        return
+    import boto3
+    s3=boto3.client("s3")
+    key=f"remediation/{pr_name}/{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(details).encode())
+
+def escalate(pr_name, reason):
+    payload={"summary": f"Remediation exhausted for {pr_name}", "details": reason}
+    try:
+        requests.post(f"{APPROVAL_API}/request", json=payload, timeout=5)
+    except Exception:
+        logger.exception("escalation notify failed")
+
+def run_loop(poll=30):
+    while True:
+        failed = list_failed_pipelineruns()
+        for pr in failed:
+            name = pr.get("metadata",{}).get("name")
+            ok, attempts = attempt_remediation(pr)
+            upload_evidence(name, {"remediation_attempted": ok, "attempts": attempts, "ts": datetime.utcnow().isoformat()})
+            if not ok:
+                escalate(name, f"attempts={attempts}")
+        time.sleep(poll)
+
+if __name__ == "__main__":
+    run_loop()
+
