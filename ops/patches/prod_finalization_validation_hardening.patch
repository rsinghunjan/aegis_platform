+EVIDENCE_BUCKET=os.environ.get("EVIDENCE_BUCKET","")
+AUDIT_LINKER=os.environ.get("AUDIT_LINKER_URL","http://audit-linker.monitoring.svc:8080/record")
+
+def upload_manifest(run_id, model_id, manifest, tenant):
+    if not EVIDENCE_BUCKET:
+        return None
+    s3=boto3.client("s3")
+    key=f"closedloop/{run_id}/explain-manifest-{model_id}-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(manifest).encode())
+    acl_key=f"closedloop/{run_id}/acl-{model_id}.json"
+    acl={"tenant": tenant, "model_id": model_id, "ts": datetime.utcnow().isoformat()}
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=acl_key, Body=json.dumps(acl).encode())
+    uri=f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key}"
+    try:
+        requests.post(AUDIT_LINKER, json={"req_id": run_id, "approver": "system", "evidence": uri}, timeout=5)
+    except Exception:
+        logger.exception("audit link failed")
+    return uri
