+"""
+Stress test submission endpoint to validate quotas and rate limiter under heavy multi-tenant load.
+Generates a report uploaded to evidence bucket.
+"""
+import os, time, random, requests, json, threading, logging
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("submission-stress")
+
+SUBMIT_URL = os.environ.get("HPO_SUBMIT_URL","http://hpo-submit.monitoring.svc:8080/submit")
+TENANTS = int(os.environ.get("STRESS_TENANTS", "50"))
+CONC = int(os.environ.get("STRESS_CONC","200"))
+DURATION = int(os.environ.get("STRESS_DURATION","300"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+
+stats={"accepted":0,"rejected":0}
+
+def submit_loop(tenant):
+    end=time.time()+DURATION
+    while time.time()<end:
+        try:
+            cfg={"est_usd": random.random()*100, "samples": random.choice([32,64,128])}
+            r=requests.post(SUBMIT_URL, json={"team": tenant, "config": cfg}, timeout=5)
+            if r.status_code==200:
+                stats["accepted"]+=1
+            else:
+                stats["rejected"]+=1
+        except Exception:
+            stats["rejected"]+=1
+        time.sleep(random.random()*0.2)
+
+def main():
+    tenants=[f"team-{i}" for i in range(TENANTS)]
+    threads=[]
+    for i in range(CONC):
+        t=threading.Thread(target=submit_loop, args=(random.choice(tenants),))
+        t.start(); threads.append(t)
+    for t in threads:
+        t.join()
+    out="/tmp/submission_stress.json"
+    open(out,"w").write(json.dumps(stats, indent=2))
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"stress/submission-{int(time.time())}.json"
+        s3.upload_file(out, EVIDENCE_BUCKET.replace("s3://",""), key)
+    print("Stress result:", stats)
+
+if __name__ == "__main__":
+    main()
+
