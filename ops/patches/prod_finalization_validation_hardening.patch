+#!/usr/bin/env python3
+"""
+Checkpoint success validator:
+ - Scans S3 for checkpoints per run and computes success rate.
+ - Enforces threshold (default 0.9). Uploads summary to evidence bucket.
+ Usage: python checkpoint_validator.py --evidence s3://bucket
+"""
+import argparse, os, json, logging
+import boto3, time
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("checkpoint-validator")
+
+def scan(bucket, prefix="checkpoints/"):
+    s3=boto3.client("s3")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix=prefix)
+    objs=resp.get("Contents", [])
+    runs={}
+    for o in objs:
+        key=o["Key"]
+        parts=key.split("/")
+        if len(parts)<3:
+            continue
+        run=parts[1]
+        runs.setdefault(run, []).append(key)
+    return runs
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True)
+    p.add_argument("--threshold", default=0.9, type=float)
+    args=p.parse_args()
+    bucket=args.evidence.replace("s3://","")
+    runs=scan(bucket)
+    total=len(runs)
+    good=sum(1 for k,v in runs.items() if len(v)>0)
+    rate=good/total if total else 0.0
+    summary={"total_runs":total,"good_runs":good,"success_rate":rate,"ts":int(time.time())}
+    s3=boto3.client("s3")
+    key=f"checkpoints/validator-summary-{int(time.time())}.json"
+    s3.put_object(Bucket=bucket, Key=key, Body=json.dumps(summary).encode())
+    print("Uploaded summary s3://%s/%s" % (bucket, key))
+    if rate < args.threshold:
+        raise SystemExit("Checkpoint success below threshold: %.2f" % rate)
+
+if __name__ == "__main__":
+    main()
+
