+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Install/upgrade Keycloak into the cluster using the official Helm chart.
+# Expects:
+#  - HELM chart repo added (bitnami or codecentric) or use keycloak/keycloak from quay
+#  - CERT_MANAGER_ISSUER (for TLS) or will create self-signed cert via generate_webhook_cert.sh
+#  - Values file at k8s/keycloak/values.yaml
+#
+# Usage:
+#   export AURORA_ENDPOINT=... AURORA_PORT=5432 AURORA_DB=aegis_registry \
+#     AURORA_USER=aegis AURORA_PASSWORD=... \
+#     KEYCLOAK_REALM=aegis
+#   ./k8s/keycloak/helm_install_keycloak.sh
+
+CHART_NAME=${CHART_NAME:-keycloak}
+RELEASE_NAME=${RELEASE_NAME:-aegis-keycloak}
+NAMESPACE=${NAMESPACE:-monitoring}
+VALUES_FILE="$(dirname "$0")/values.yaml"
+
+echo "Ensuring namespace ${NAMESPACE} exists..."
+kubectl create ns "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Adding Keycloak helm repo (codecentric)..."
+helm repo add codecentric https://codecentric.github.io/helm-charts || true
+helm repo update
+
+echo "Installing/upgrading Keycloak with values file ${VALUES_FILE}..."
+helm upgrade --install "${RELEASE_NAME}" codecentric/keycloak -n "${NAMESPACE}" -f "${VALUES_FILE}" --wait --timeout 10m
+
+echo "Keycloak helm release applied. Wait for pods to be Ready:"
+kubectl -n "${NAMESPACE}" rollout status deployment/"${RELEASE_NAME}-keycloak" --timeout=10m || true
+
+echo "Done. Next: create admin user / import realm via kcadm or the Keycloak admin console."
+
