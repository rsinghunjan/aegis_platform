+#!/usr/bin/env python3
+"""
+Validating admission webhook that enforces:
+ - required annotations/labels on Pod/TaskRun/PipelineRun (aegis.job_id, aegis.model_name)
+ - tenant quotas via the model registry API (simple count check)
+
+This is a PoC: in production use TLS, proper authorization and thorough validation.
+"""
+import os, json, logging
+from flask import Flask, request, jsonify
+import requests
+
+APP = Flask(__name__)
+REGISTRY_URL = os.environ.get("MODEL_REGISTRY_URL", "http://aegis-model-registry.monitoring.svc:8081")
+MAX_MODELS_DEFAULT = int(os.environ.get("TENANT_MAX_MODELS_DEFAULT", "100"))
+logging.basicConfig(level=logging.INFO)
+
+def check_tenant_quota(tenant):
+    try:
+        r = requests.get(f"{REGISTRY_URL}/models?tenant={tenant}", timeout=5)
+        r.raise_for_status()
+        data = r.json()
+        count = len(data.get("models", []))
+        return count
+    except Exception:
+        return None
+
+@APP.route("/validate", methods=["POST"])
+def validate():
+    review = request.get_json()
+    req = review.get("request", {})
+    uid = req.get("uid")
+    obj = req.get("object", {})
+    meta = obj.get("metadata", {})
+    annotations = meta.get("annotations", {})
+    missing = []
+    for k in ["aegis.job_id", "aegis.model_name", "aegis.tenant"]:
+        if not annotations.get(k):
+            missing.append(k)
+    if missing:
+        message = f"Missing required annotations: {missing}"
+        return jsonify({"response": {"uid": uid, "allowed": False, "status": {"message": message}}})
+    tenant = annotations.get("aegis.tenant")
+    count = check_tenant_quota(tenant)
+    if count is None:
+        # conservatively allow but warn
+        return jsonify({"response": {"uid": uid, "allowed": True}})
+    max_models = MAX_MODELS_DEFAULT
+    if count > max_models:
+        message = f"Tenant {tenant} exceeds model quota ({count} > {max_models})"
+        return jsonify({"response": {"uid": uid, "allowed": False, "status": {"message": message}}})
+    return jsonify({"response": {"uid": uid, "allowed": True}})
+
+if __name__=="__main__":
+    APP.run(host="0.0.0.0", port=int(os.environ.get("PORT", 8443)))
+
