+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple chaos script to cordon and drain a node to test MTTR & resilience.
+# Use carefully in staging.
+#
+NODE=${1:-}
+if [ -z "$NODE" ]; then
+  echo "Usage: $0 <node-name>"
+  exit 2
+fi
+
+echo "Cordoning node $NODE"
+kubectl cordon "$NODE"
+echo "Draining node $NODE (graceful, will evict pods)"
+kubectl drain "$NODE" --ignore-daemonsets --delete-local-data --force --timeout=60s || true
+echo "Waiting 30s to observe behavior..."
+sleep 30
+echo "Uncordoning and re-scheduling"
+kubectl uncordon "$NODE"
+
+echo "Chaos operation complete. Check deployments and run mttr drills."
+
