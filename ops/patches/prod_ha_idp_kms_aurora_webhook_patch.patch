+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Collect an SME signoff file and upload to the evidence bucket under signoffs/
+# Usage:
+#  EVIDENCE_BUCKET=my-bucket ./ops/scripts/collect_sme_signoff.sh /path/to/signoff.pdf --model my-model --version v1 --sme "alice"
+
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+if [ -z "$EVIDENCE_BUCKET" ]; then
+  echo "EVIDENCE_BUCKET required"
+  exit 2
+fi
+
+FILE=${1:-}
+shift || true
+MODEL=""
+VERSION=""
+SME=""
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --model) MODEL="$2"; shift 2;;
+    --version) VERSION="$2"; shift 2;;
+    --sme) SME="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+if [ -z "$FILE" ] || [ ! -f "$FILE" ]; then
+  echo "Provide a signoff file path"
+  exit 3
+fi
+
+KEY="signoffs/$(basename "$FILE")-$(date -u +%Y%m%dT%H%M%SZ)"
+META="{\"model\":\"${MODEL}\",\"version\":\"${VERSION}\",\"sme\":\"${SME}\",\"uploaded_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}"
+
+aws s3 cp "$FILE" "s3://$EVIDENCE_BUCKET/$KEY"
+echo "$META" | aws s3 cp - "s3://$EVIDENCE_BUCKET/$KEY.metadata.json"
+
+echo "Uploaded signoff to s3://$EVIDENCE_BUCKET/$KEY and metadata file"
+
