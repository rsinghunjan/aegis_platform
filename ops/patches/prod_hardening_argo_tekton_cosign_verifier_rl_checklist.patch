+#!/usr/bin/env python3
+"""
+Offline evaluation harness:
+ - Replays historical traces against a candidate policy and computes estimated rewards and safety risk metrics
+ - Useful to run before requesting manual approval
+"""
+import json,sys
+from typing import Dict,Any
+
+def load_traces(path):
+    out=[]
+    for l in open(path):
+        out.append(json.loads(l))
+    return out
+
+def eval_policy(policy: Dict[str,Any], traces):
+    # reuse same heuristic as RL agent skeleton
+    total=0.0
+    for t in traces:
+        quality = t.get("quality",1.0)
+        pct = policy.get("student_pct",0)
+        reward = pct*0.01*10.0 - max(0, pct*0.001)*(1.0-quality)*100.0
+        total += reward
+    return total / max(1, len(traces))
+
+if __name__=="__main__":
+    policy = json.loads(sys.argv[1])
+    traces = load_traces(sys.argv[2])
+    print(eval_policy(policy, traces))
+
