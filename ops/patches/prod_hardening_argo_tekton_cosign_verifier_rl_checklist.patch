+"""
+Safe RL agent skeleton (production-safe design):
+ - Runs in sandbox mode, generates candidate policies from offline data and simulates rewards
+ - Exposes REST API to list candidates, request approval, and run offline evaluation
+ - Requires manual approval before any suggested action is applied to live systems (integration via manual-approval service)
+ - Includes simple PPO-like loop placeholder (left as scaffold to implement offline RL)
+"""
+import os
+import time
+import json
+import random
+import threading
+from typing import List, Dict, Any
+from fastapi import FastAPI, HTTPException, Request
+
+app = FastAPI(title="Aegis Safe RL Agent")
+
+# In-memory stores (for scaffold)
+POLICIES: List[Dict[str,Any]] = []
+HISTORY: List[Dict[str,Any]] = []
+
+DATASET_PATH = os.environ.get("RL_DATASET", "/data/rl/trajectories.jsonl")
+MANUAL_APPROVAL_URL = os.environ.get("MANUAL_APPROVAL_URL", "http://manual-approval.svc")
+
+def load_offline_data():
+    data=[]
+    if os.path.exists(DATASET_PATH):
+        for l in open(DATASET_PATH):
+            try:
+                data.append(json.loads(l))
+            except Exception:
+                continue
+    return data
+
+def simulate_policy(policy: Dict[str,Any], traces: List[Dict[str,Any]]) -> float:
+    # Simple reward: combine cost saving and quality preservation measured on traces
+    total_reward=0.0
+    for trace in traces[:200]:
+        quality = trace.get("quality", 1.0)
+        cost = trace.get("cost", 1.0)
+        # policy contains e.g. {'student_pct': 20}
+        pct = policy.get("student_pct", 0)
+        # heuristic: cost saving proportional to pct, quality degrades slightly
+        reward = pct*0.01 * 10.0 - max(0, pct*0.001) * (1.0-quality)*100.0
+        total_reward += reward
+    return total_reward / max(1, len(traces[:200]))
+
+def propose_candidates(n=5):
+    traces = load_offline_data()
+    for _ in range(n):
+        cand = {"id": f"cand_{int(time.time())}_{random.randint(0,999)}", "student_pct": random.choice([10,20,30,40,50]), "created": time.time()}
+        cand["est_reward"] = simulate_policy({"student_pct": cand["student_pct"]}, traces)
+        POLICIES.append(cand)
+
+@app.on_event("startup")
+def start_background():
+    def loop():
+        while True:
+            propose_candidates(1)
+            time.sleep(60)
+    t=threading.Thread(target=loop, daemon=True)
+    t.start()
+
+@app.get("/candidates")
+def list_candidates():
+    return sorted(POLICIES, key=lambda c: -c["est_reward"])[:50]
+
+@app.post("/request_apply")
+async def request_apply(req: Request):
+    body = await req.json()
+    cid = body.get("candidate_id")
+    approver = body.get("approver", "unknown")
+    for c in POLICIES:
+        if c["id"] == cid:
+            # create a manual approval ticket; the actual apply must be performed by operators after approval
+            try:
+                requests.post(MANUAL_APPROVAL_URL + "/request", json={"request_id": cid, "user": approver, "reason":"RL suggested policy"}, timeout=5)
+            except Exception:
+                pass
+            return {"status":"approval_requested","candidate":c}
+    raise HTTPException(status_code=404, detail="candidate not found")
+
+@app.post("/evaluate_offline")
+async def evaluate_offline(req: Request):
+    body = await req.json()
+    cid = body.get("candidate_id")
+    traces = load_offline_data()
+    for c in POLICIES:
+        if c["id"] == cid:
+            score = simulate_policy(c, traces)
+            HISTORY.append({"candidate":c,"score":score,"ts":time.time()})
+            return {"score": score}
+    raise HTTPException(status_code=404, detail="candidate not found")
+
+@app.get("/history")
+def history():
+    return HISTORY[-200:]
+
