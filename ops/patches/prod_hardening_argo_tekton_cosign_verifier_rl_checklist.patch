*** Add File:services/factuality/calibrate_and_publish.py
+#!/usr/bin/env python3
+"""
+Calibrate verifier thresholds and publish:
+ - Computes best threshold for desired precision (uses preds + labels)
+ - Writes thresholds.json and publishes to Kubernetes ConfigMap (no kubectl subprocess; uses Kubernetes API)
+ - Posts calibration metrics to Prometheus Pushgateway if PUSHGATEWAY env is set
+ - Registers calibration artifact with metadata service
+"""
+import os, json, numpy as np, time
+from sklearn.metrics import precision_recall_fscore_support
+from kubernetes import client, config
+from services.metadata.metadata_service import register_artifact
+import requests
+
+PRED_PATH = os.environ.get("PRED_PATH", "ops/factuality/sample_preds.jsonl")
+LABEL_PATH = os.environ.get("LABEL_PATH", "ops/factuality/verification_samples.jsonl")
+OUT_DIR = os.environ.get("OUT_DIR", "/workspace/calib")
+PRECISION_TARGET = float(os.environ.get("PRECISION_TARGET", "0.9"))
+PUSHGATEWAY = os.environ.get("PUSHGATEWAY", "")
+NAMESPACE = os.environ.get("NAMESPACE", "safety")
+CONFIGMAP_NAME = os.environ.get("VERIFIER_CALIB_CM","verifier-calib")
+
+os.makedirs(OUT_DIR, exist_ok=True)
+
+def load_jsonl(path):
+    out=[]
+    for l in open(path):
+        if not l.strip(): continue
+        out.append(json.loads(l))
+    return out
+
+def calibrate(preds, labels, precision_target):
+    scores = [p.get("best",{}).get("score",0.0) for p in preds]
+    y_true = [1 if l.get("label")=="support" else 0 for l in labels]
+    thresholds = list(np.linspace(0.0,1.0,101))
+    best = {"threshold":0.5,"precision":0.0,"recall":0.0,"f1":0.0}
+    for t in thresholds:
+        y_pred = [1 if s>=t else 0 for s in scores]
+        p,r,f,_ = precision_recall_fscore_support(y_true,y_pred,average='binary',zero_division=0)
+        if p >= precision_target and f > best["f1"]:
+            best = {"threshold":t,"precision":p,"recall":r,"f1":f}
+    return best
+
+def publish_configmap(cfg, namespace, name):
+    # load kubeconfig (in-cluster or from KUBECONFIG)
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    v1 = client.CoreV1Api()
+    data = {"thresholds.json": json.dumps(cfg)}
+    body = client.V1ConfigMap(metadata=client.V1ObjectMeta(name=name), data=data)
+    try:
+        v1.patch_namespaced_config_map(name, namespace, body)
+    except client.exceptions.ApiException:
+        v1.create_namespaced_config_map(namespace, body)
+    return True
+
+def push_metrics(cfg):
+    if not PUSHGATEWAY:
+        return
+    job = "verifier_calibration"
+    payload = f"verifier_calib_threshold {cfg['threshold']}\nverifier_calib_f1 {cfg['f1']}\nverifier_calib_precision {cfg['precision']}\n"
+    try:
+        resp = requests.post(f"{PUSHGATEWAY}/metrics/job/{job}", data=payload, timeout=5)
+        resp.raise_for_status()
+    except Exception:
+        pass
+
+def main():
+    preds = load_jsonl(PRED_PATH)
+    labels = load_jsonl(LABEL_PATH)
+    cfg = calibrate(preds, labels, PRECISION_TARGET)
+    out_path = os.path.join(OUT_DIR, "thresholds.json")
+    with open(out_path,"w") as f:
+        json.dump(cfg,f,indent=2)
+    # publish
+    publish_configmap(cfg, NAMESPACE, CONFIGMAP_NAME)
+    push_metrics(cfg)
+    # register artifact
+    register_artifact({"id": f"calib_{int(time.time())}", "type":"verifier_calibration", "path": out_path, "meta": cfg})
+    print("Calibration published:", cfg)
+
+if __name__=="__main__":
+    main()
+
