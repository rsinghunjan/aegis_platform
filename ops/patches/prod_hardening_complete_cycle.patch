+apiVersion: tekton.dev/v1beta1
+kind: Task
+metadata:
+  name: slo-canary-auto
+  namespace: cicd
+spec:
+  params:
+    - name: canary_deployment
+      type: string
+    - name: business_metric
+      type: string
+    - name: auto_prom_cm
+      type: string
+      default: "aegis-auto-promoter"
+  steps:
+    - name: evaluate
+      image: python:3.10
+      script: |
+        #!/bin/sh
+        set -euo pipefail
+        pip install requests pyyaml || true
+        CANARY=$(params.canary_deployment)
+        METRIC=$(params.business_metric)
+        CM=$(params.auto_prom_cm)
+        prom="http://prometheus.monitoring.svc:9090"
+        # read recommended threshold from ConfigMap
+        THRESH=$(kubectl -n cicd get cm $CM -o jsonpath='{.data.auto_promote_rel_drop}' 2>/dev/null || echo "0.1")
+        canary_q=$(echo "$METRIC" | sed "s|\${CANARY}|$CANARY|g")
+        base_q=$(echo "$METRIC" | sed "s|\${CANARY}|production-model|g")
+        canary_v=$(curl -s "$prom/api/v1/query" --data-urlencode "query=$canary_q" | jq -r '.data.result[0].value[1]' 2>/dev/null || echo 0)
+        base_v=$(curl -s "$prom/api/v1/query" --data-urlencode "query=$base_q" | jq -r '.data.result[0].value[1]' 2>/dev/null || echo 0)
+        if [ "$base_v" = "0" ] || [ -z "$base_v" ]; then
+          echo "Baseline missing; request SME"
+          exit 2
+        fi
+        rel=$(awk "BEGIN {printf \"%.6f\", ($base_v - $canary_v)/$base_v}")
+        echo "rel_drop=$rel threshold=$THRESH"
+        awk "BEGIN {if ($rel <= $THRESH) exit 0; else exit 1}"
+
