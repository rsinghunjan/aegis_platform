+#!/usr/bin/env python3
+"""
+Auto-promotion tuner:
+ - Uses historical canary evaluation results (Prometheus & evidence) to recommend tuned thresholds
+ - Emits recommended thresholds to a ConfigMap that auto-promoter reads
+ - Simple PoC: computes 95th-percentile relative drop from history and recommends a margin
+"""
+import os, time, logging, json
+import requests
+from statistics import median
+
+logger = logging.getLogger("auto-prom-tuner")
+logging.basicConfig(level=logging.INFO)
+
+PROM = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+CM_NAME = os.environ.get("AUTOPROM_CM", "aegis-auto-promoter")
+NAMESPACE = os.environ.get("TEKTON_NAMESPACE", "cicd")
+WINDOW = int(os.environ.get("TUNE_WINDOW_HOURS", "72"))
+
+def query_rel_drops(metric_expr='(sum(rate(business_metric{app="production-model"}[5m])) - sum(rate(business_metric{app="model-canary"}[5m]))) / sum(rate(business_metric{app="production-model"}[5m]))'):
+    now = int(time.time())
+    start = now - WINDOW * 3600
+    r = requests.get(f"{PROM}/api/v1/query_range", params={"query": metric_expr, "start": start, "end": now, "step": "300"}, timeout=20)
+    r.raise_for_status()
+    data = r.json().get("data", {}).get("result", [])
+    drops = []
+    for series in data:
+        for v in series.get("values", []):
+            try:
+                drops.append(float(v[1]))
+            except Exception:
+                continue
+    return drops
+
+def recommend_threshold(drops):
+    if not drops:
+        return 0.1
+    # use median + safety margin
+    med = median(drops)
+    rec = max(0.01, min(0.3, med * 1.2))
+    return round(rec, 4)
+
+def write_configmap(threshold):
+    cm = {
+        "apiVersion": "v1",
+        "kind": "ConfigMap",
+        "metadata": {"name": CM_NAME, "namespace": NAMESPACE},
+        "data": {"auto_promote_rel_drop": str(threshold)}
+    }
+    import tempfile, subprocess, yaml
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.dump(cm).encode()); f.close()
+    subprocess.check_call(["kubectl","apply","-f",f.name])
+    logger.info("Wrote configmap %s with threshold %s", CM_NAME, threshold)
+
+def run_once():
+    drops = query_rel_drops()
+    th = recommend_threshold(drops)
+    write_configmap(th)
+
+if __name__ == "__main__":
+    run_once()
+
