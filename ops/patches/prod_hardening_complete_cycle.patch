+#!/usr/bin/env python3
+"""
+Offline/Online consistency checker (Feast):
+ - Compares aggregated offline feature statistics to online feature store samples.
+ - Emits a diff report and uploads to evidence bucket.
+"""
+import os, json, logging, tempfile
+import boto3
+import pandas as pd
+from datetime import datetime
+
+logger = logging.getLogger("offline-online-check")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+OFFLINE_PATH = os.environ.get("OFFLINE_FEATURES","s3://data-lake/offline/features/latest.parquet")
+ONLINE_SRV = os.environ.get("FEAST_ONLINE_ENDPOINT","redis://redis.online:6379")
+
+def download_s3(path, local):
+    s3=boto3.client("s3")
+    bucket,key=path.replace("s3://","").split("/",1)
+    s3.download_file(bucket,key,local)
+    return local
+
+def sample_online(keys, n=100):
+    # PoC: if online store is Redis, sample via keys (requires implementation per store)
+    import redis
+    r=redis.from_url(ONLINE_SRV)
+    rows=[]
+    for k in keys[:n]:
+        try:
+            rows.append(json.loads(r.get(k)))
+        except Exception:
+            continue
+    return pd.DataFrame(rows)
+
+def run_check():
+    tmp="/tmp/offline.parquet"
+    download_s3(OFFLINE_PATH, tmp)
+    df_off = pd.read_parquet(tmp)
+    # pick keys column if exists
+    keys = df_off.get("entity_id", df_off.index).tolist()
+    df_online = sample_online(keys, n=200)
+    report = {"offline_rows": len(df_off), "online_rows_sampled": len(df_online)}
+    # compare simple stats
+    for col in df_off.columns:
+        if col in df_online.columns:
+            report[f"{col}_offline_mean"]=float(df_off[col].mean())
+            report[f"{col}_online_mean"]=float(df_online[col].mean())
+            report[f"{col}_mean_diff"]=abs(report[f"{col}_offline_mean"]-report[f"{col}_online_mean"])
+    # upload
+    local=json.dumps(report,indent=2)
+    if EVIDENCE_BUCKET:
+        s3=boto3.client("s3")
+        key=f"data/consistency/{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=local.encode())
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    else:
+        path=f"/tmp/consistency-{int(time.time())}.json"
+        open(path,"w").write(local)
+        return path
+
+if __name__ == "__main__":
+    print(run_check())
+
