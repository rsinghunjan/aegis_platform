+#!/usr/bin/env python3
+"""
+Acceptance orchestrator to run accelerated 2k dry runs and long-shadow simulation.
+ - Submits many simulator jobs (using simulator orchestrator) and then starts a long-shadow monitor process
+ - Aggregates evidence and uploads a signed bundle to evidence bucket
+"""
+import os, time, json, tempfile, subprocess, logging
+from datetime import datetime
+
+logger = logging.getLogger("acceptance-runner")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+SIM_RUNS = int(os.environ.get("SIM_RUNS", "2000"))
+
+def run_simulators(n):
+    logger.info("Starting %d simulator jobs", n)
+    out = subprocess.check_output(["python","-c","from ops.scale.simulator_orchestrator import run_scale; print(run_scale(%d))" % n]).decode()
+    return out
+
+def start_long_shadow(duration_seconds=86400):
+    # run a background monitor that collects KPIs for duration_seconds (accelerated test can lower)
+    logger.info("Starting long-shadow for %s seconds", duration_seconds)
+    end = time.time() + duration_seconds
+    stats = []
+    while time.time() < end:
+        # collect a sample KPI from Prometheus
+        try:
+            r = subprocess.check_output(["curl","-s","http://prometheus.monitoring.svc:9090/api/v1/query","--data-urlencode","query=sum(rate(business_metric[1m]))"])
+            stats.append(r.decode())
+        except Exception:
+            stats.append("{}")
+        time.sleep(60)
+    return stats
+
+def aggregate_and_sign(local_dir):
+    # basic evidence bundle creation and cosign call (PoC)
+    bundle = tempfile.NamedTemporaryFile(delete=False, suffix=".tar.gz").name
+    subprocess.check_call(["tar","-czf", bundle, "-C", local_dir, "."])
+    # cosign sign (requires key mounted)
+    try:
+        subprocess.check_call(["cosign","sign","-key","/secrets/cosign.key", bundle])
+    except Exception:
+        logger.exception("cosign sign failed; skipping")
+    # upload
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"acceptance/bundles/{os.path.basename(bundle)}"
+        s3.upload_file(bundle, EVIDENCE_BUCKET.replace("s3://",""), key)
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    return bundle
+
+def main():
+    tmpdir = tempfile.mkdtemp(prefix="acceptance-")
+    sim_out = run_simulators(SIM_RUNS)
+    open(os.path.join(tmpdir, "sim_output.txt"), "w").write(sim_out)
+    stats = start_long_shadow(duration_seconds=60*60)  # example: run 1 hour for accelerated test
+    open(os.path.join(tmpdir, "longshadow_stats.json"), "w").write(json.dumps(stats))
+    evidence = aggregate_and_sign(tmpdir)
+    print("Acceptance evidence:", evidence)
+
+if __name__ == "__main__":
+    main()
+
