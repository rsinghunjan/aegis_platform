+"""
+TPM quote & PCR verification helper using tpm2-pytss (if available).
+This module provides:
+ - parse_and_verify_quote(quote_b64, sig_b64, ak_pub_pem, expected_pcrs)
+
+Note: full TPM quote verification and PCR policy verification is complex and must
+be validated by your security team. This is a hardened scaffold that uses tpm2-pytss
+if installed; otherwise falls back to signature verification.
+"""
+import base64, json
+from cryptography.hazmat.primitives import serialization, hashes
+from cryptography.hazmat.primitives.asymmetric import padding
+try:
+    from tpm2_pytss import types, TSS2_Exception, ESAPI
+    TSS_AVAILABLE = True
+except Exception:
+    TSS_AVAILABLE = False
+
+def verify_signature(quote_b64, sig_b64, ak_pub_pem):
+    quote = base64.b64decode(quote_b64)
+    sig = base64.b64decode(sig_b64)
+    ak = serialization.load_pem_public_key(ak_pub_pem.encode() if isinstance(ak_pub_pem, str) else ak_pub_pem)
+    try:
+        ak.verify(sig, quote, padding.PKCS1v15(), hashes.SHA256())
+        return True, "basic-sig-ok"
+    except Exception as e:
+        return False, str(e)
+
+def parse_and_verify_quote(quote_b64, sig_b64, ak_pub_pem, expected_pcrs=None):
+    """
+    Attempts to parse and verify TPM quote and PCR values.
+    expected_pcrs: dict int -> hex-string expected value
+    Returns (ok:bool, message:str, details:dict)
+    """
+    if TSS_AVAILABLE:
+        try:
+            # This is a high-level scaffold. Deep parsing would use ESAPI to unmarshal structures.
+            # For now, prefer signature verification plus optional PCR string compare if quote contains PCRs in JSON wrapper.
+            ok, msg = verify_signature(quote_b64, sig_b64, ak_pub_pem)
+            details = {"tss": "used"}
+            # Try to decode quote as JSON (some attestation stacks wrap quote with metadata)
+            try:
+                qtxt = base64.b64decode(quote_b64).decode('utf-8')
+                j = json.loads(qtxt)
+                if expected_pcrs:
+                    mismatches = []
+                    for i, expected in expected_pcrs.items():
+                        observed = j.get("pcrs", {}).get(str(i))
+                        if observed != expected:
+                            mismatches.append({"pcr": i, "expected": expected, "observed": observed})
+                    if mismatches:
+                        return False, "PCR_MISMATCH", {"mismatches": mismatches}
+            except Exception:
+                pass
+            return ok, msg, details
+        except Exception as e:
+            return False, str(e), {}
+    else:
+        ok, msg = verify_signature(quote_b64, sig_b64, ak_pub_pem)
+        return ok, msg, {"tss": "not-available"}
+
