+#!/usr/bin/env python3
+"""
+Rater backend v3: adds OIDC login validation via Authlib (token introspection / JWKS),
+and audit logging of user actions to Postgres.
+"""
+import os, json, uuid, logging
+from datetime import datetime
+from flask import Flask, request, jsonify, abort
+from authlib.jose import JsonWebKey, jwt
+import psycopg2
+
+OIDC_ISSUER = os.environ.get("OIDC_ISSUER")
+AUDIT_TABLE = "rater_audit"
+DB_URL = os.environ.get("DATABASE_URL")
+API_KEY = os.environ.get("RATER_API_KEY", "change-me")
+
+app = Flask(__name__)
+logging.basicConfig(level=logging.INFO)
+
+def get_conn():
+    return psycopg2.connect(DB_URL)
+
+def verify_jwt(token):
+    # Minimal JWKS fetch & verification (caching omitted for brevity)
+    if not OIDC_ISSUER:
+        return None
+    jwks_uri = OIDC_ISSUER.rstrip("/") + "/.well-known/jwks.json"
+    import requests
+    jwks = requests.get(jwks_uri).json()
+    jwk_set = JsonWebKey.import_key_set(jwks)
+    try:
+        header = jwt.get_unverified_header(token)
+        key = [k for k in jwk_set.keys if k.get("kid") == header.get("kid")]
+        if not key:
+            return None
+        claims = jwt.decode(token, key[0])
+        claims.validate()
+        return claims
+    except Exception as e:
+        logging.info("JWT verify failed: %s", e)
+        return None
+
+def require_api_key_or_oidc():
+    auth = request.headers.get("Authorization")
+    if auth and auth.startswith("Bearer "):
+        token = auth.split(" ",1)[1]
+        claims = verify_jwt(token)
+        if claims:
+            return claims
+    api_key = request.headers.get("X-API-KEY") or request.args.get("api_key")
+    if api_key and api_key == API_KEY:
+        return {"api_key_user":"internal"}
+    abort(401)
+
+def audit_event(user, action, details):
+    try:
+        c = get_conn(); cur = c.cursor()
+        cur.execute(f"INSERT INTO {AUDIT_TABLE} (event_id, user_id, action, details, ts) VALUES (%s,%s,%s,%s,now())",
+                    (str(uuid.uuid4()), user.get("sub", user.get("api_key_user", "unknown")), action, json.dumps(details)))
+        c.commit(); cur.close(); c.close()
+    except Exception as e:
+        logging.exception("audit failed")
+
+@app.route("/task", methods=["GET"])
+def get_task():
+    user = require_api_key_or_oidc()
+    # fetch next task
+    conn = get_conn(); cur = conn.cursor()
+    cur.execute("SELECT id,a,b,meta FROM rater_pairs ORDER BY created_at ASC LIMIT 1")
+    r = cur.fetchone()
+    cur.close(); conn.close()
+    if not r: return jsonify({"status":"empty"}), 204
+    pid,a,b,meta = r
+    audit_event(user, "fetch_task", {"pair_id": pid})
+    return jsonify({"id":pid,"a":a,"b":b,"meta":json.loads(meta)})
+
+@app.route("/vote", methods=["POST"])
+def vote():
+    user = require_api_key_or_oidc()
+    body = request.json
+    if not body or "pair_id" not in body or "choice" not in body:
+        return jsonify({"error":"pair_id and choice required"}), 400
+    vid = str(uuid.uuid4())
+    conn = get_conn(); cur = conn.cursor()
+    cur.execute("INSERT INTO rater_votes (id, pair_id, choice, rater, ts) VALUES (%s,%s,%s,%s,now())",
+                (vid, body["pair_id"], int(body["choice"]), user.get("sub", user.get("api_key_user","unknown"))))
+    conn.commit(); cur.close(); conn.close()
+    audit_event(user, "vote", {"pair_id": body["pair_id"], "choice": body["choice"], "vote_id": vid})
+    return jsonify({"status":"ok","vote_id":vid})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT",8082)))
+
