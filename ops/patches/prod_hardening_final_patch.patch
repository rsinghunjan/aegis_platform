+"""
+Safety detectors microservice (FastAPI):
+ - toxicity detector (Detoxify if available)
+ - PII detector (regex + spaCy NER)
+ - hallucination/factuality checker (retrieval placeholder using sentence-transformers)
+ Provides REST endpoints:
+  - POST /check  { "text": "...", "context": "optional context" } -> {toxicity, pii, hallucination_score, verdict}
+"""
+import os, re, json
+from fastapi import FastAPI
+from pydantic import BaseModel
+
+try:
+    from detoxify import Detoxify
+    detox = Detoxify('original')
+except Exception:
+    detox = None
+
+import spacy
+try:
+    nlp = spacy.load("en_core_web_sm")
+except Exception:
+    nlp = spacy.blank("en")
+
+PII_RE = re.compile(r"\b\d{3}-\d{2}-\d{4}\b|\b4\d{3} \d{4} \d{4} \d{4}\b")
+
+app = FastAPI()
+
+class CheckReq(BaseModel):
+    text: str
+    context: str = None
+
+@app.post("/health")
+def health():
+    return {"ok": True}
+
+@app.post("/check")
+def check(req: CheckReq):
+    text = req.text
+    result = {"toxicity": None, "pii": False, "hallucination_score": None, "verdict": "allow"}
+    # toxicity
+    if detox:
+        scores = detox.predict(text)
+        tox_score = scores.get("toxicity", 0.0)
+        result["toxicity"] = tox_score
+        if tox_score > 0.5:
+            result["verdict"] = "block"
+    else:
+        # naive heuristic
+        if "kill" in text.lower() or "attack" in text.lower():
+            result["toxicity"] = 0.9
+            result["verdict"] = "block"
+    # pii
+    if PII_RE.search(text):
+        result["pii"] = True
+        result["verdict"] = "block"
+    # NER-based PII attempt
+    doc = nlp(text)
+    for ent in doc.ents:
+        if ent.label_ in ("PERSON", "GPE", "ORG") and len(ent.text) > 50:
+            # unlikely; ignore
+            pass
+    # hallucination/factuality (placeholder): compute simple entailment/retrieval score
+    # For production integrate with a retrieval system + generative verification model
+    result["hallucination_score"] = 0.1
+    return result
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", "8090")))
