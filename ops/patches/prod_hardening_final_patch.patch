+"""
+Automates creating an issue for SME signoff after a stress campaign finishes.
+ - Reads sim_report.json and creates a GitHub issue (requires GITHUB_TOKEN and repo)
+"""
+import os, json, requests
+
+GITHUB_REPO = os.environ.get("GITHUB_REPO")  # owner/repo
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN")
+
+def create_issue(title, body):
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    r = requests.post(url, json={"title":title,"body":body}, headers={"Authorization": f"token {GITHUB_TOKEN}"})
+    return r.status_code, r.json()
+
+def main():
+    if not GITHUB_REPO or not GITHUB_TOKEN:
+        print("Set GITHUB_REPO and GITHUB_TOKEN")
+        return
+    report = json.load(open("sim_report.json"))
+    ok = sum(1 for r in report if r.get("status")=="ok")
+    err = sum(1 for r in report if r.get("status")!="ok")
+    body = f"SME Signoff requested for sim stress campaign\n\nOK runs: {ok}\nErrors: {err}\n\nSee sim_report.json attached."
+    st, j = create_issue("SME Signoff: Sim Stress Campaign", body)
+    print("Created issue", st, j.get("html_url"))
+
+if __name__=="__main__":
+    main()
+
