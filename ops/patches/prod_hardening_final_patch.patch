+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Takes Terraform outputs (s3_bucket, kms_key_id, rds_endpoint, msk_bootstrap_brokers)
+# and creates Kubernetes secrets in the 'carbon' and 'rater' namespaces.
+#
+TFDIR=${1:-./cloud/aws/terraform}
+KUBECTL=${KUBECTL:-kubectl}
+
+pushd "$TFDIR" >/dev/null
+TF_OUT=$(terraform output -json)
+popd >/dev/null
+
+S3_BUCKET=$(echo "$TF_OUT" | jq -r '.s3_bucket.value')
+KMS_KEY=$(echo "$TF_OUT" | jq -r '.kms_key_id.value')
+RDS_ENDPOINT=$(echo "$TF_OUT" | jq -r '.rds_endpoint.value')
+MSK_BROKERS=$(echo "$TF_OUT" | jq -r '.msk_bootstrap_brokers.value')
+
+echo "Creating k8s secrets (carbon namespace)"
+$KUBECTL create namespace carbon --dry-run=client -o yaml | $KUBECTL apply -f -
+$KUBECTL create secret generic aegis-cloud-secrets -n carbon --from-literal=DATASET_BUCKET="${S3_BUCKET}" --from-literal=KMS_KEY_ID="${KMS_KEY}" --from-literal=MSK_BROKERS="${MSK_BROKERS}" --dry-run=client -o yaml | $KUBECTL apply -f -
+
+echo "Create DB secret (operator: fill in full DATABASE_URL with credentials)"
+echo "kubectl create secret generic aegis-db-secret --from-literal=DATABASE_URL='postgresql://user:pass@${RDS_ENDPOINT}:5432/aegis' -n carbon"
+
+echo "Secrets created (cloud info). Please create DB secret with credentials manually."
+
