+import React, { useEffect, useState } from 'react';
+import { BrowserRouter as Router, Routes, Route, Link } from 'react-router-dom';
+import Callback from './Callback';
+
+function Home() {
+  const [task, setTask] = useState(null);
+  const [token, setToken] = useState(localStorage.getItem("aegis_token") || "");
+
+  useEffect(() => {
+    async function fetchTask() {
+      try {
+        const headers = token ? { 'Authorization': `Bearer ${token}` } : { 'X-API-KEY': '' };
+        const res = await fetch('/api/task', { headers });
+        if (res.status === 200) {
+          const j = await res.json();
+          setTask(j);
+        }
+      } catch (e) {
+        console.error(e);
+      }
+    }
+    fetchTask();
+  }, [token]);
+
+  async function vote(choice) {
+    if (!task) return;
+    const headers = token ? { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' } : { 'X-API-KEY': '' , 'Content-Type': 'application/json' };
+    await fetch('/api/vote', {
+      method: 'POST',
+      headers,
+      body: JSON.stringify({pair_id: task.id, choice})
+    });
+    setTask(null);
+  }
+
+  return (
+    <div style={{padding:20}}>
+      <h1>Aegis Rater UI</h1>
+      <div>
+        {token ? <span>Logged in</span> : <a href="/api/oauth/login">Login with SSO</a>}
+      </div>
+      <hr/>
+      {task ? (
+        <div>
+          <h3>Task</h3>
+          <div><strong>A:</strong> <pre>{task.a}</pre></div>
+          <div><strong>B:</strong> <pre>{task.b}</pre></div>
+          <button onClick={()=>vote(0)}>Choose A</button>
+          <button onClick={()=>vote(1)}>Choose B</button>
+        </div>
+      ) : (
+        <div>No task loaded. Click Login if required.</div>
+      )}
+    </div>
+  );
+}
+
+function App() {
+  return (
+    <Router>
+      <Routes>
+        <Route path="/callback" element={<Callback/>} />
+        <Route path="/" element={<Home/>} />
+      </Routes>
+    </Router>
+  );
+}
+
+export default App;
