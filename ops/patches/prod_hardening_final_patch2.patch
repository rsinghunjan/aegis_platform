+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Helper to prepare a branch and create a PR using the GitHub CLI (gh).
+#
+BRANCH=${1:-"prod-hardening/$(date +%Y%m%d%H%M)"} 
+TITLE=${2:-"prod: infra, attestation, safety, rater SSO & canary"}
+BODY=${3:-"This PR adds production infra wiring (Terraform), TPM attestation verifier, safety detectors, OIDC rater UI integration, and CI workflows for signing & canary."}
+
+git checkout -b "${BRANCH}"
+git add -A
+git commit -m "${TITLE}"
+git push --set-upstream origin "${BRANCH}"
+
+if command -v gh >/dev/null 2>&1; then
+  gh pr create --title "${TITLE}" --body "${BODY}" --base main
+else
+  echo "gh CLI not installed. Branch pushed: ${BRANCH}. Create PR manually."
+fi
+
