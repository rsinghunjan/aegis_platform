+"""
+Generate a simulated TPM quote test vector for local testing.
+This script does NOT perform real TPM quoting; it fabricates a JSON-wrapped quote with PCRs
+for integration testing of the verifier stack.
+"""
+import base64, json, os
+from cryptography.hazmat.primitives import serialization, hashes
+from cryptography.hazmat.primitives.asymmetric import rsa, padding
+
+def generate():
+    # generate temp RSA key pair (simulated AK)
+    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    pub = key.public_key()
+    quote = {
+        "nonce": "test-nonce",
+        "pcrs": {"0":"deadbeef", "1":"cafebabe"}
+    }
+    quote_b = json.dumps(quote).encode('utf-8')
+    sig = key.sign(quote_b, padding.PKCS1v15(), hashes.SHA256())
+    return base64.b64encode(quote_b).decode(), base64.b64encode(sig).decode(), pub.public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo).decode()
+
+if __name__ == "__main__":
+    q, s, p = generate()
+    os.makedirs("out", exist_ok=True)
+    open("out/quote.b64","w").write(q)
+    open("out/sig.b64","w").write(s)
+    open("out/ak_pub.pem","w").write(p)
+    print("Wrote test vector to out/")
+
