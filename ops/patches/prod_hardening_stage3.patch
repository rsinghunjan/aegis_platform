+#!/usr/bin/env python3
+"""
+PoC mutating webhook to inject run_id and OTLP env into Pod specs.
+ - This is a minimal Flask app that responds to AdmissionReview and mutates Pod specs.
+ - In production you must secure with TLS, validate signatures and restrict scope.
+"""
+from flask import Flask, request, jsonify
+import os, uuid, logging
+
+app = Flask(__name__)
+logger = logging.getLogger("mutating-webhook")
+logging.basicConfig(level=logging.INFO)
+
+OTLP_ENDPOINT = os.environ.get("OTLP_ENDPOINT", "http://otel-collector.monitoring.svc:4318")
+
+@app.route("/mutate", methods=["POST"])
+def mutate():
+    req = request.get_json()
+    try:
+        uid = req["request"]["uid"]
+        pod = req["request"]["object"]
+        run_id = pod.get("metadata", {}).get("annotations", {}).get("aegis.run_id") or f"run-{uuid.uuid4().hex[:8]}"
+        # create JSON patch
+        patches = []
+        # add annotation
+        patches.append({"op":"add","path":"/metadata/annotations/aegis.run_id","value":run_id})
+        # inject environment variable into containers
+        containers = pod.get("spec",{}).get("containers",[])
+        for i, _ in enumerate(containers):
+            patches.append({"op":"add","path":f"/spec/containers/{i}/env/-","value":{"name":"OTLP_ENDPOINT","value":OTLP_ENDPOINT}})
+            patches.append({"op":"add","path":f"/spec/containers/{i}/env/-","value":{"name":"RUN_ID","value":run_id}})
+        resp = {
+            "response": {
+                "uid": uid,
+                "allowed": True,
+                "patchType": "JSONPatch",
+                "patch": __import__("base64").b64encode(__import__("json").dumps(patches).encode()).decode()
+            }
+        }
+        return jsonify(resp)
+    except Exception:
+        return jsonify({"response":{"allowed": True, "uid": req.get("request",{}).get("uid","")}})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8443")))
+
