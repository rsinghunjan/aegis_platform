+#!/usr/bin/env python3
+"""
+Connector hardening & watchdog for Debezium/Flink connectors.
+ - Periodically checks connector health via Debezium REST API
+ - If connector is unhealthy, attempts controlled restart (via REST) and records evidence
+ - Calls Marquez shipper to register datasets if connector becomes healthy after restart
+"""
+import os, time, json, logging, requests
+from datetime import datetime
+
+logger = logging.getLogger("connector-harden")
+logging.basicConfig(level=logging.INFO)
+
+DEBEZIUM_URL = os.environ.get("DEBEZIUM_URL", "http://debezium.connect:8083")
+MARQUEZ_URL = os.environ.get("MARQUEZ_URL", "http://marquez.backend:5000")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def list_connectors():
+    r = requests.get(f"{DEBEZIUM_URL}/connectors", timeout=5)
+    r.raise_for_status()
+    return r.json()
+
+def check_status(connector):
+    r = requests.get(f"{DEBEZIUM_URL}/connectors/{connector}/status", timeout=5)
+    r.raise_for_status()
+    return r.json()
+
+def restart_connector(connector):
+    # safe stop/start sequence
+    try:
+        requests.post(f"{DEBEZIUM_URL}/connectors/{connector}/restart", timeout=10)
+        return True
+    except Exception:
+        logger.exception("Failed restart for %s", connector)
+        return False
+
+def upload_evidence(name, payload):
+    if not EVIDENCE_BUCKET:
+        path=f"/tmp/{name}-{int(time.time())}.json"; open(path,"w").write(json.dumps(payload)); return path
+    import boto3
+    s3=boto3.client("s3")
+    key=f"connectors/{name}-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(payload).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+def run_loop(interval=120):
+    while True:
+        try:
+            for c in list_connectors():
+                status = check_status(c)
+                if status.get("connector",{}).get("state") != "RUNNING":
+                    logger.warning("Connector %s not running; attempting restart", c)
+                    ok = restart_connector(c)
+                    upload_evidence("connector-restart", {"connector": c, "ok": ok, "status": status, "ts": datetime.utcnow().isoformat()})
+                    # if recovered, notify Marquez for dataset registration (PoC)
+                    if ok:
+                        try:
+                            requests.post(f"{MARQUEZ_URL}/api/v1/datasets", json={"namespace":"aegis","name":c,"physical_name":f"connector://{c}"}, timeout=5)
+                        except Exception:
+                            logger.exception("Marquez notify failed")
+        except Exception:
+            logger.exception("Connector harden loop error")
+        time.sleep(interval)
+
+if __name__ == "__main__":
+    run_loop()
+
