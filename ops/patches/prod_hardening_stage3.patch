+#!/usr/bin/env python3
+"""
+Signoff collector service
+ - Collects SME signoffs (signed text or uploaded file reference), records Keycloak identity via introspection, and writes to EVIDENCE_BUCKET
+ - Provides a simple HTTP endpoint to submit signoff (POST) and to list signoffs for a run_id
+"""
+from fastapi import FastAPI, Request, Header, HTTPException
+import os, json, logging
+from datetime import datetime
+import requests
+
+app = FastAPI()
+logger = logging.getLogger("signoff-collector")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+KEYCLOAK_USERINFO = os.environ.get("KEYCLOAK_USERINFO", "http://keycloak.monitoring.svc:8080/realms/aegis/protocol/openid-connect/userinfo")
+
+def upload_evidence(key, data):
+    if not EVIDENCE_BUCKET:
+        path=f"/tmp/{key}.json"
+        open(path,"w").write(json.dumps(data)); return path
+    import boto3
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    key_s=f"signoffs/{key}.json"
+    s3.put_object(Bucket=bucket, Key=key_s, Body=json.dumps(data).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key_s}"
+
+@app.post("/signoff")
+async def signoff(req: Request, authorization: str = Header(None)):
+    body = await req.json()
+    run_id = body.get("run_id")
+    note = body.get("note", "")
+    if not run_id:
+        raise HTTPException(status_code=400, detail="run_id required")
+    user = {}
+    if authorization:
+        try:
+            resp = requests.get(KEYCLOAK_USERINFO, headers={"Authorization": authorization}, timeout=5)
+            resp.raise_for_status()
+            user = resp.json()
+        except Exception:
+            user = {"identifier":"unknown"}
+    rec = {"run_id": run_id, "note": note, "user": user, "ts": datetime.utcnow().isoformat()}
+    uri = upload_evidence(f"{run_id}-{int(time.time())}", rec)
+    return {"ok": True, "evidence": uri}
+
+@app.get("/signoffs/{run_id}")
+def list_signoffs(run_id: str):
+    # PoC: list from S3 by prefix (requires S3 access)
+    if not EVIDENCE_BUCKET:
+        raise HTTPException(status_code=404, detail="no evidence bucket")
+    import boto3
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    prefix=f"signoffs/{run_id}"
+    objs = s3.list_objects_v2(Bucket=bucket, Prefix=prefix).get("Contents", [])
+    entries=[]
+    for o in objs:
+        obj = s3.get_object(Bucket=bucket, Key=o["Key"])
+        entries.append(json.loads(obj["Body"].read()))
+    return entries
+
