+    c.execute("""
+    CREATE TABLE IF NOT EXISTS submissions (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      team TEXT,
+      config TEXT,
+      estimated_usd REAL,
+      pipeline_run TEXT,
+      evidence_uri TEXT,
+      created_at TEXT
+    )""")
+    conn.commit()
+    conn.close()
+
+def record_submission(team, config, estimated_usd, pipeline_run, evidence_uri=""):
+    conn = sqlite3.connect(DB_PATH)
