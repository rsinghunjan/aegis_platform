+#!/usr/bin/env python3
+"""
+High-scale failure handler for Tekton pipelines.
+ - Watches PipelineRuns
+ - Implements exponential backoff + automated lightweight remediation:
+   - collects logs and artifacts
+   - attempts safe restart of failed tasks (by restarting related pods)
+   - escalates to approval UI / on-call after retry limit
+ - Writes evidence bundles to EVIDENCE_BUCKET
+"""
+import os, time, json, logging, subprocess, tempfile
+from datetime import datetime
+
+logger = logging.getLogger("highscale-failure-handler")
+logging.basicConfig(level=logging.INFO)
+
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+MAX_RETRIES = int(os.environ.get("CLOSEDLOOP_MAX_RETRIES", "4"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+APPROVAL_SERVICE = os.environ.get("APPROVAL_SERVICE_URL", "http://approval-service.monitoring.svc:8080")
+
+def list_pipelineruns():
+    out = subprocess.check_output(["kubectl", "-n", TEKTON_NS, "get", "pipelineruns", "-o", "json"])
+    return json.loads(out).get("items", [])
+
+def collect_artifacts(pr_name, target_dir):
+    os.makedirs(target_dir, exist_ok=True)
+    try:
+        subprocess.check_call(["kubectl", "-n", TEKTON_NS, "get", "pipelinerun", pr_name, "-o", "json"], stdout=open(os.path.join(target_dir, "pipelinerun.json"), "w"))
+    except Exception:
+        pass
+    pods = json.loads(subprocess.check_output(["kubectl", "-n", TEKTON_NS, "get", "pods", "-o", "json"]).decode()).get("items", [])
+    for p in pods:
+        owners = p.get("metadata", {}).get("ownerReferences", [])
+        if any(o.get("kind") == "PipelineRun" and o.get("name") == pr_name for o in owners):
+            podname = p["metadata"]["name"]
+            try:
+                logs = subprocess.check_output(["kubectl", "-n", TEKTON_NS, "logs", podname], stderr=subprocess.STDOUT).decode()
+            except Exception as e:
+                logs = f"failed to collect logs: {e}"
+            open(os.path.join(target_dir, f"{podname}.log"), "w").write(logs)
+
+def upload_dir_to_s3(local_dir, prefix):
+    if not EVIDENCE_BUCKET:
+        return local_dir
+    import boto3
+    s3 = boto3.client("s3")
+    bucket = EVIDENCE_BUCKET.replace("s3://","")
+    for root, _, files in os.walk(local_dir):
+        for f in files:
+            path = os.path.join(root, f)
+            key = f"{prefix}/{os.path.relpath(path, local_dir)}"
+            s3.upload_file(path, bucket, key)
+    return f"s3://{bucket}/{prefix}/"
+
+def remediate_by_restart(pr_name):
+    # find pods owned by the pipeline run and restart them (best-effort)
+    pods = json.loads(subprocess.check_output(["kubectl", "-n", TEKTON_NS, "get", "pods", "-o", "json"]).decode()).get("items", [])
+    restarted = []
+    for p in pods:
+        owners = p.get("metadata", {}).get("ownerReferences", [])
+        if any(o.get("kind") == "PipelineRun" and o.get("name") == pr_name for o in owners):
+            podname = p["metadata"]["name"]
+            try:
+                subprocess.check_call(["kubectl", "-n", TEKTON_NS, "delete", "pod", podname, "--grace-period=5"])
+                restarted.append(podname)
+            except Exception:
+                logger.exception("Failed to restart pod %s", podname)
+    return restarted
+
+def escalate(pr_name, evidence_uri, reason):
+    try:
+        import requests
+        payload = {"summary": f"PipelineRun {pr_name} failure: {reason}", "evidence_uri": evidence_uri}
+        requests.post(f"{APPROVAL_SERVICE}/request", json=payload, timeout=10)
+    except Exception:
+        logger.exception("Failed to notify approval service")
+
+def run_loop(poll_interval=30):
+    while True:
+        for pr in list_pipelineruns():
+            name = pr.get("metadata", {}).get("name")
+            conds = pr.get("status", {}).get("conditions", [])
+            if conds and conds[0].get("status") == "False":
+                annotations = pr.get("metadata", {}).get("annotations", {})
+                retries = int(annotations.get("aegis.retries", "0"))
+                logger.info("Detected failed PipelineRun %s retries=%s", name, retries)
+                localdir = tempfile.mkdtemp(prefix=f"fail-{name}-")
+                collect_artifacts(name, localdir)
+                s3uri = upload_dir_to_s3(localdir, f"closedloop/failures/{name}")
+                if retries < MAX_RETRIES:
+                    restarted = remediate_by_restart(name)
+                    subprocess.check_call(["kubectl", "-n", TEKTON_NS, "annotate", "pipelinerun", name, f"aegis.retries={retries+1}", "--overwrite"])
+                    logger.info("Attempted remediation for %s restarted=%s", name, restarted)
+                else:
+                    escalate(name, s3uri, "max_retries_exceeded")
+        time.sleep(poll_interval)
+
+if __name__ == "__main__":
+    run_loop()
+
