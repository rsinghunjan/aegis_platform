+ - Exposes an API for canary controller / auto-promoter to query tenant-specific thresholds
+ - On update writes an audit record to EVIDENCE_BUCKET
+"""
+from fastapi import FastAPI
+import os, json, logging, subprocess
+from datetime import datetime
+
+app = FastAPI()
+logger = logging.getLogger("slo-binding")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+CM_NAME = os.environ.get("SLO_CM", "aegis-tenant-slos")
+NS = os.environ.get("SLO_NS", "cicd")
+
+def read_configmap():
+    try:
+        out = subprocess.check_output(["kubectl","-n",NS,"get","cm",CM_NAME,"-o","json"]).decode()
+        cm = json.loads(out)
+        return cm.get("data", {})
+    except Exception:
+        return {}
+
+def write_audit(tenant, data):
+    if not EVIDENCE_BUCKET:
+        logger.info("Audit: %s %s", tenant, data); return
+    import boto3
+    s3=boto3.client("s3")
+    key=f"slo/audit/{tenant}-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(data).encode())
+
+@app.get("/slo/{tenant}")
+def get_slo(tenant: str):
+    data = read_configmap()
+    slo = data.get(tenant, "")
+    write_audit(tenant, {"slo": slo, "ts": datetime.utcnow().isoformat()})
+    return {"tenant": tenant, "slo": slo}
