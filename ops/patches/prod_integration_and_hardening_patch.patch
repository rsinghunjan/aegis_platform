+"""
+Rater backend v2 hardening additions:
+ - rate limiting via flask-limiter
+ - support optional OIDC/JWT validation via OIDC_ISSUER (placeholder)
+ - TLS is handled by Ingress/Cert-Manager (k8s manifests provided separately)
+"""
+import os, json, uuid
