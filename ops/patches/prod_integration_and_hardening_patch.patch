+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simple canary deployment flow:
+# 1. Sign new model artifact using COSIGN_CMD (env); upload new image/artifact
+# 2. Patch k8s deployment with image tag and set annotation canary=true
+# 3. Wait for a short warmup, run safety evaluation endpoint or CI job
+# 4. If safety tests pass, remove canary annotation (promote). If fail, rollback.
+#
+if [ $# -lt 3 ]; then
+  echo "Usage: canary_deploy.sh <deployment> <container_name> <new_image_tag>"
+  exit 2
+fi
+DEPLOY="$1"
+CONTAINER="$2"
+IMAGE="$3"
+NAMESPACE="${NAMESPACE:-inference}"
+COSIGN_CMD="${COSIGN_CMD:-cosign}"
+SAFETY_CHECK_URL="${SAFETY_CHECK_URL:-http://safety-check.safety.svc/check}"
+
+echo "Patching deployment ${DEPLOY} with image ${IMAGE}"
+kubectl -n ${NAMESPACE} set image deployment/${DEPLOY} ${CONTAINER}=${IMAGE}
+kubectl -n ${NAMESPACE} annotate deployment/${DEPLOY} aegis/canary=true --overwrite
+
+echo "Waiting 20s for rollout..."
+sleep 20
+
+echo "Running safety check..."
+if curl -sSf "${SAFETY_CHECK_URL}?image=${IMAGE}" -o /dev/null; then
+  echo "Safety check passed. Promoting deployment."
+  kubectl -n ${NAMESPACE} annotate deployment/${DEPLOY} aegis/canary=promoted --overwrite
+  kubectl -n ${NAMESPACE} annotate deployment/${DEPLOY} aegis/canary=false --overwrite
+else
+  echo "Safety check failed. Rolling back."
+  kubectl -n ${NAMESPACE} rollout undo deployment/${DEPLOY}
+  exit 1
+fi
+
