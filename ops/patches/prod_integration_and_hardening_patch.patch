+from functools import wraps
+
+try:
+    from flask_limiter import Limiter
+    from flask_limiter.util import get_remote_address
+    LIM_OK = True
+except Exception:
+    LIM_OK = False
+
+DB_URL = os.environ.get("DATABASE_URL")
+API_KEY = os.environ.get("RATER_API_KEY", "change-me")
+OIDC_ISSUER = os.environ.get("OIDC_ISSUER")  # optional
+
+app = Flask(__name__)
+if LIM_OK:
+    limiter = Limiter(app, key_func=get_remote_address, default_limits=["200/minute"])
+
+def get_conn():
+    if not DB_URL:
+        raise RuntimeError("DATABASE_URL not set")
+    return psycopg2.connect(DB_URL, connect_timeout=5)
+
+def require_api_key():
+    key = request.headers.get("X-API-KEY") or request.args.get("api_key")
+    if not key or key != API_KEY:
+        abort(401)
+
+def optional_oidc(f):
+    @wraps(f)
+    def wrapped(*a, **kw):
+        # placeholder: validate JWT from Authorization header if OIDC_ISSUER set
+        if OIDC_ISSUER and "Authorization" in request.headers:
+            # operator: validate token against OIDC_ISSUER
+            pass
+        return f(*a, **kw)
+    return wrapped
+
+@app.route("/health")
+def health():
+    return jsonify({"ok": True})
+
+@app.route("/pairs", methods=["POST"])
+@optional_oidc
+def add_pairs():
+    require_api_key()
+    pairs = request.json
+    if not isinstance(pairs, list):
+        return jsonify({"error":"expected list"}), 400
+    conn = get_conn()
+    cur = conn.cursor()
+    for p in pairs:
+        pid = str(uuid.uuid4())
+        cur.execute("INSERT INTO rater_pairs (id, a, b, meta, created_at) VALUES (%s,%s,%s,%s,%s)",
+                    (pid, p.get("a",""), p.get("b",""), json.dumps(p.get("meta",{})), datetime.utcnow()))
+    conn.commit()
+    cur.close(); conn.close()
+    return jsonify({"status":"ok","inserted":len(pairs)})
+
