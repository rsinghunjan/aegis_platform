+#!/usr/bin/env python3
+"""
+Run large-scale simulated HIL campaigns against agent harness.
+ - Spins up many runs (concurrent) and collects results into a report
+ - Produces a CSV and a JSON summary suitable for SME review and signoff
+"""
+import argparse, concurrent.futures, json, time, csv
+from ops.agent.sim.harness import sim_agent_harness
+
+def run_single(i, steps=50):
+    start = time.time()
+    try:
+        sim_agent_harness.run_scenario(steps=steps)
+        return {"id": i, "status":"ok", "duration": time.time()-start}
+    except Exception as e:
+        return {"id": i, "status":"err", "error": str(e), "duration": time.time()-start}
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--runs", type=int, default=100)
+    p.add_argument("--concurrency", type=int, default=8)
+    p.add_argument("--out", default="sim_report.json")
+    args = p.parse_args()
+    results=[]
+    with concurrent.futures.ThreadPoolExecutor(max_workers=args.concurrency) as ex:
+        futs = [ex.submit(run_single, i) for i in range(args.runs)]
+        for f in concurrent.futures.as_completed(futs):
+            results.append(f.result())
+    open(args.out,"w").write(json.dumps(results, indent=2))
+    # CSV
+    with open("sim_report.csv","w") as f:
+        w = csv.DictWriter(f, fieldnames=["id","status","duration","error"])
+        w.writeheader()
+        for r in results:
+            w.writerow({"id":r["id"], "status":r["status"], "duration":r.get("duration"), "error":r.get("error","")})
+    print("Wrote reports:", args.out, "sim_report.csv")
+
+if __name__=="__main__":
+    main()
+
