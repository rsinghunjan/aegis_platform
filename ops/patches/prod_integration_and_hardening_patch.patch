+#!/usr/bin/env python3
+"""
+Attestation Verifier: enhanced to use attest_lib.verify_quote_and_pcrs and enforce PCR policies.
+Expects POST /verify with JSON:
+  { "quote": "<b64>", "signature":"<b64>", "ak_pub":"<pem>", "expected_pcrs": {"0":"abcd...", "1":"..."} }
+"""
+import os, json
+from flask import Flask, request, jsonify
+from attest_lib import verify_quote_and_pcrs
+
+EVIDENCE_LOG = os.environ.get("EVIDENCE_LOG", "/tmp/attest_evidence.jsonl")
+
+app = Flask(__name__)
+
+@app.route("/health")
+def health():
+    return jsonify({"ok": True})
+
+@app.route("/verify", methods=["POST"])
+def verify():
+    body = request.json or {}
+    quote = body.get("quote")
+    signature = body.get("signature")
+    ak_pub = body.get("ak_pub") or (open(os.environ.get("AK_PUB_PATH","/secrets/ak_pub.pem")).read() if os.path.exists(os.environ.get("AK_PUB_PATH","/secrets/ak_pub.pem")) else None)
+    expected = body.get("expected_pcrs")
+    if not quote or not signature or not ak_pub:
+        return jsonify({"error":"missing fields (quote/signature/ak_pub)"}), 400
+    ok, msg = verify_quote_and_pcrs(quote, signature, ak_pub, expected)
+    rec = {"req": {"expected_pcrs": expected}, "result": {"ok": ok, "msg": msg}}
+    open(EVIDENCE_LOG,"a").write(json.dumps(rec)+"\n")
+    return jsonify({"allow": ok, "reason": msg})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8083")))
+
