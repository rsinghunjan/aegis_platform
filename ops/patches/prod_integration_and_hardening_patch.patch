+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Wire AWS provider resources (S3, RDS, KMS, MSK) and create Kubernetes secrets.
+#
+# Usage:
+#   AWS_REGION=us-west-2 DATASET_BUCKET=aegis-datasets ./cloud/aws/wire_provider_aws.sh
+#
+REGION="${AWS_REGION:-us-west-2}"
+BUCKET="${DATASET_BUCKET:-aegis-datasets-$(date +%s)}"
+RDS_IDENTIFIER="${RDS_IDENTIFIER:-aegis-db}"
+RDS_USERNAME="${RDS_USERNAME:-aegis}"
+RDS_PASSWORD="${RDS_PASSWORD:-change-me}"  # operator must replace
+KMS_ALIAS="${KMS_ALIAS:-alias/aegis-dataset}"
+MSK_CLUSTER_NAME="${MSK_CLUSTER_NAME:-aegis-msk}"
+
+echo "Creating S3 bucket: ${BUCKET} in ${REGION}"
+aws s3api create-bucket --bucket "${BUCKET}" --region "${REGION}" --create-bucket-configuration LocationConstraint="${REGION}" || true
+aws s3api put-bucket-versioning --bucket "${BUCKET}" --versioning-configuration Status=Enabled || true
+
+echo "Creating KMS key and alias"
+KMS_KEY_ID=$(aws kms create-key --description "Aegis dataset key" --query KeyMetadata.KeyId --output text)
+aws kms create-alias --alias-name "${KMS_ALIAS}" --target-key-id "${KMS_KEY_ID}"
+
+echo "Creating RDS Postgres (this may take several minutes)"
+aws rds create-db-instance \
+  --db-instance-identifier "${RDS_IDENTIFIER}" \
+  --allocated-storage 20 \
+  --db-instance-class db.t3.medium \
+  --engine postgres \
+  --master-username "${RDS_USERNAME}" \
+  --master-user-password "${RDS_PASSWORD}" \
+  --backup-retention-period 7 \
+  --no-multi-az || true
+
+echo "Create MSK (Kafka) cluster (placeholder; operator to customize brokers/ips)"
+aws kafka create-cluster --cluster-name "${MSK_CLUSTER_NAME}" --broker-node-group-info file://- <<EOF || true
+{
+  "brokerAZDistribution": "DEFAULT",
+  "clientSubnets": ["subnet-xxxxxx"],
+  "instanceType": "kafka.m5.large",
+  "securityGroups": ["sg-xxxxxx"]
+}
+EOF
+
+echo "Wait for RDS endpoint and then create Kubernetes secrets"
+echo "Operator: fetch RDS host via AWS console or CLI and set DATABASE_URL env var before running the k8s secret step below."
+echo ""
+echo "Example kubectl commands to create secrets once you have DATABASE_URL:"
+echo "kubectl create secret generic aegis-db-secret --from-literal=DATABASE_URL='postgresql://$RDS_USERNAME:$RDS_PASSWORD@<RDS_HOST>:5432/postgres' -n carbon"
+echo "kubectl create secret generic aegis-cloud-secrets --from-literal=DATASET_BUCKET='${BUCKET}' --from-literal=KMS_KEY_ID='${KMS_KEY_ID}' -n carbon"
+
+echo ""
+echo "Done. Please configure VPC/Subnets/SecurityGroups for MSK/RDS as appropriate for your environment."
