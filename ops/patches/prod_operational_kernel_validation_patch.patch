+"""
+Enhanced S3 lifecycle policy validator with Object Lock checks and retention policy rules.
+Provides safe guidance and flags destructive or non-compliant policies.
+"""
+import boto3, json, sys
+from botocore.exceptions import ClientError
+
+s3 = boto3.client("s3")
+s3control = boto3.client("s3control")
+
+def bucket_has_object_lock(account_id, bucket):
+    try:
+        r = s3control.get_bucket_ownership_controls(AccountId=account_id, Bucket=bucket)
+        # Some accounts use s3api get-bucket-object-lock-configuration instead
+    except Exception:
+        pass
+    try:
+        r = s3.get_object_lock_configuration(Bucket=bucket)
+        return "ObjectLockEnabled" in r and r["ObjectLockEnabled"] == "Enabled"
+    except ClientError as e:
+        if e.response['Error']['Code'] in ("ObjectLockConfigurationNotFoundError", "NoSuchBucket"):
+            return False
+        raise
+
+def validate_policy_against_compliance(bucket, policy_json, min_retention_days=30, require_object_lock_prefixes=None, account_id=None):
+    issues = []
+    # check object lock presence for required prefixes
+    if require_object_lock_prefixes:
+        has_lock = bucket_has_object_lock(account_id, bucket)
+        if not has_lock:
+            issues.append(f"Bucket {bucket} is NOT configured with Object Lock; required for compliance on prefixes {require_object_lock_prefixes}")
+    # check expiration rules
+    for r in policy_json.get("Rules", []):
+        prefix = r.get("Prefix", "")
+        exp = r.get("Expiration", {})
+        days = exp.get("Days")
+        if days is not None and days < min_retention_days:
+            issues.append(f"Rule for prefix {prefix} expires in {days} days < required {min_retention_days}")
+    return issues
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        print("Usage: lifecycle_validator_enhanced.py <bucket> <policy.json> [account_id]")
+        sys.exit(2)
+    bucket = sys.argv[1]
+    policy = json.load(open(sys.argv[2]))
+    account_id = sys.argv[3] if len(sys.argv) > 3 else None
+    issues = validate_policy_against_compliance(bucket, policy, require_object_lock_prefixes=["checkpoints/"], account_id=account_id)
+    if issues:
+        print("Compliance issues found:")
+        for i in issues: print(" -", i)
+        sys.exit(1)
+    print("Policy looks OK for basic compliance checks.")
+
