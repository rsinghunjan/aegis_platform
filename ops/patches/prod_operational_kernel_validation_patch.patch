+"""
+Run a small verifier gate: query verifier /verify on a set of sample claims and fail if performance below threshold.
+This script is intended to run in CI after verifier deployment and will exit non-zero when gate fails.
+"""
+import requests, json, sys, os
+
+VERIFIER_URL = os.environ.get("VERIFIER_URL", "http://verifier.safety.svc.cluster.local:8080/verify")
+SAMPLES_FILE = os.environ.get("VERIFIER_SAMPLES", "ops/factuality/verification_samples.jsonl")
+THRESH = float(os.environ.get("VERIFIER_GATE_THRESHOLD", "0.4"))
+
+def load_samples(path):
+    out = []
+    if not os.path.exists(path):
+        return out
+    for line in open(path):
+        out.append(json.loads(line))
+    return out
+
+def run_gate():
+    samples = load_samples(SAMPLES_FILE)
+    if not samples:
+        print("No verification samples found; skipping gate")
+        return 0
+    total = 0
+    support_count = 0
+    for s in samples:
+        payload = {"claim": s["claim"], "evidence": s.get("evidence", [])}
+        r = requests.post(VERIFIER_URL, json=payload, timeout=10)
+        r.raise_for_status()
+        res = r.json()
+        score = res.get("best", {}).get("score", 0.0)
+        total += 1
+        if score >= THRESH:
+            support_count += 1
+    pass_rate = support_count / total if total>0 else 0.0
+    print(f"Verifier pass rate: {pass_rate:.3f} (threshold {THRESH})")
+    return 0 if pass_rate >= 0.75 else 2
+
+if __name__ == "__main__":
+    rc = run_gate()
+    sys.exit(rc)
+
