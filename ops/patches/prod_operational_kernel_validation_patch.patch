*** Add File:ops/triton/backend/ternary_gemm_stream.cu
+/*
+Streaming ternary GEMM reference:
+ - Kernel unpacks ternary int8 values per block into a small float tile, multiplies by per-row scale,
+   and calls cuBLAS on tiles to avoid a full host-side unpack.
+ - This is a basic tiled streaming pattern as a starting point for optimization.
+*/
+#include <cuda_runtime.h>
+#include <cublas_v2.h>
+#include <stdint.h>
+#include <stdio.h>
+
+extern "C" int ternary_gemm_stream(const int8_t* A_tern, const float* A_scales, int m, int k,
+                                   const float* B, int n, float* C, cudaStream_t stream) {
+  // For simplicity this reference implementation does:
+  // - allocate device buffer for A_float tiles and copy per-block,
+  // - call cublasSgemm for each tile.
+  // Production: fuse unpack+GEMM kernels to remove extra copy and reduce memory pressure.
+
+  cublasHandle_t handle;
+  if (cublasCreate(&handle) != CUBLAS_STATUS_SUCCESS) {
+    return -1;
+  }
+  cublasSetStream(handle, stream);
+
+  const int TILE_M = 128;  // tile sizes to tune
+  const int TILE_K = 256;
+  float* dA = nullptr;
+  cudaMalloc((void**)&dA, sizeof(float)*TILE_M*TILE_K);
+
+  for (int row = 0; row < m; row += TILE_M) {
+    int cur_m = min(TILE_M, m - row);
+    for (int kk = 0; kk < k; kk += TILE_K) {
+      int cur_k = min(TILE_K, k - kk);
+      // unpack A_tern[row:row+cur_m, kk:kk+cur_k] into dA (host->device copy)
+      // For brevity we do a host-side unpack then cudaMemcpy (replace with device kernel)
+      float* hA = (float*)malloc(sizeof(float)*cur_m*cur_k);
+      for (int i=0;i<cur_m;i++){
+        float s = A_scales[row + i];
+        for (int j=0;j<cur_k;j++){
+          int idx = (row + i)*k + (kk + j);
+          int8_t v = A_tern[idx];
+          hA[i*cur_k + j] = ((float)v) * s;
+        }
+      }
+      cudaMemcpyAsync(dA, hA, sizeof(float)*cur_m*cur_k, cudaMemcpyHostToDevice, stream);
+      free(hA);
+      // B tile pointer offset (assume B is row-major k x n)
+      const float* B_tile = B + kk * n;
+      float* C_tile = C + row * n;
+      // call cublas: C_tile = dA * B_tile (dA: cur_m x cur_k, B_tile: cur_k x n) -> C_tile: cur_m x n
+      const float alpha = 1.0f, beta = 1.0f;
+      // cublas expects column-major; use transposes or swap operands accordingly.
+      cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N, n, cur_m, cur_k, &alpha, B_tile, n, dA, cur_k, &beta, C_tile, n);
+    }
+  }
+
+  cudaFree(dA);
+  cublasDestroy(handle);
+  return 0;
+}
+
