+"""
+Telemetry calibration utility:
+ - Compare NVML/inferred power measurements with an external ground-truth wattmeter CSV (time,watts)
+ - Compute linear calibration factor to adjust estimated power for more accurate per-inference accounting
+ - Writes calibration config to services/sustainability/telemetry_calibration.json
+"""
+import numpy as np, json, sys, os
+from services.sustainability.gpu_telemetry import get_gpu_stats
+
+def load_wattmeter_csv(path):
+    data = []
+    for line in open(path):
+        t,w = line.strip().split(",")
+        data.append(float(w))
+    return np.array(data)
+
+def calibrate(ground_truth_csv):
+    if not os.path.exists(ground_truth_csv):
+        raise RuntimeError("ground truth csv missing")
+    gt = load_wattmeter_csv(ground_truth_csv)
+    # sample telemetry in same window
+    samples = []
+    for _ in range(len(gt)):
+        s = get_gpu_stats()
+        if s and s[0].get("power_w") is not None:
+            samples.append(s[0]["power_w"])
+    samples = np.array(samples)
+    if len(samples) != len(gt):
+        print("Warning: sample length mismatch, trimming to min")
+        n = min(len(samples), len(gt))
+        samples = samples[:n]; gt = gt[:n]
+    # fit linear factor: gt = a * samples + b
+    A = np.vstack([samples, np.ones(len(samples))]).T
+    a,b = np.linalg.lstsq(A, gt, rcond=None)[0]
+    cfg = {"scale": float(a if not np.isnan(a) else 1.0), "offset": float(b if not np.isnan(b) else 0.0)}
+    open("services/sustainability/telemetry_calibration.json","w").write(json.dumps(cfg, indent=2))
+    print("Calibration written:", cfg)
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        print("Usage: calibrate_telemetry.py <wattmeter_csv>")
+        sys.exit(2)
+    calibrate(sys.argv[1])
+
