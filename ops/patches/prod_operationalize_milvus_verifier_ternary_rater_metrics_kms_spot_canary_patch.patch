*** Add File:services/human_queue/sla_enforcer.py
+#!/usr/bin/env python3
+"""
+SLA enforcer for the human review queue:
+ - periodically scans tasks and escalates tasks exceeding claim/resolution SLAs
+ - sends a webhook/event to a configured alert endpoint
+"""
+import os, time, requests, psycopg2, json
+
+DB = os.environ.get("DATABASE_URL")
+CLAIM_SLA_SECS = int(os.environ.get("CLAIM_SLA_SECS", 300))    # 5 minutes to claim
+RESOLVE_SLA_SECS = int(os.environ.get("RESOLVE_SLA_SECS", 60*60))  # 1 hour to resolve
+ALERT_WEBHOOK = os.environ.get("HUMAN_QUEUE_ALERT_WEBHOOK", "")
+
+def alert(payload):
+    if ALERT_WEBHOOK:
+        try:
+            requests.post(ALERT_WEBHOOK, json=payload, timeout=5)
+        except Exception as e:
+            print("alert send failed", e)
+    print("ALERT:", payload)
+
+def scan_and_escalate():
+    if not DB:
+        print("DB not configured"); return
+    conn = psycopg2.connect(DB); cur = conn.cursor()
+    cur.execute("SELECT id,status,claimed_at,created_at FROM human_queue WHERE status IN ('open','claimed')")
+    rows = cur.fetchall()
+    now = time.time()
+    for r in rows:
+        tid, status, claimed_at, created_at = r
+        if status == "open":
+            # time since created
+            age = (now - created_at.timestamp()) if created_at else None
+            if age and age > CLAIM_SLA_SECS:
+                alert({"task_id": tid, "issue": "unclaimed_exceeds_sla", "age_s": age})
+        elif status == "claimed":
+            age = (now - claimed_at.timestamp()) if claimed_at else None
+            if age and age > RESOLVE_SLA_SECS:
+                alert({"task_id": tid, "issue": "claimed_not_resolved_exceeds_sla", "age_s": age})
+    cur.close(); conn.close()
+
+if __name__ == "__main__":
+    while True:
+        try:
+            scan_and_escalate()
+        except Exception as e:
+            print("error", e)
+        time.sleep(60)
+
