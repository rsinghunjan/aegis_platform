+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Deploy Milvus into production namespace with TLS and RBAC support.
+# Usage:
+#   ./deploy_milvus_prod.sh <namespace> <release-name> <values-override-file>
+NS=${1:-milvus}
+RELEASE=${2:-milvus-prod}
+VALUES=${3:-ops/retriever/milvus_k8s/values.yaml}
+
+echo "Creating namespace $NS"
+kubectl create namespace "$NS" --dry-run=client -o yaml | kubectl apply -f -
+
+echo "Applying RBAC"
+kubectl apply -f ops/retriever/milvus_k8s/rbac.yaml -n "$NS"
+
+echo "Install/upgrade Milvus Helm chart (values: $VALUES)"
+helm repo add milvus https://milvus-helm-charts.storage.googleapis.com || true
+helm repo update
+helm upgrade --install "$RELEASE" milvus/milvus -n "$NS" -f "$VALUES" --wait --timeout 5m
+
+echo "Create TLS secret placeholder (operator must populate real certs)"
+kubectl -n "$NS" apply -f ops/milvus/milvus-tls-secret-template.yaml || true
+
+echo "Export MILVUS_URI for services (example):"
+echo "export MILVUS_URI=\"$(kubectl -n $NS get svc milvus-milvus -o jsonpath='{.spec.clusterIP}'):19530\""
+echo "Persist MILVUS_URI as Kubernetes Secret for services to consume (operator action required)"
+
+echo "Milvus provisioned. Next: ensure services set MILVUS_URI env and enable TLS if desired."
+
