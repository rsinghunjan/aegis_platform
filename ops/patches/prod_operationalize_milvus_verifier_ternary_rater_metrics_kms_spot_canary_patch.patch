+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create an AWS KMS asymmetric key usable by Cosign (RSA_3072) and output key arn.
+KEY_ALIAS=${1:-"alias/aegis-cosign-key"}
+POLICY=${2:-""}
+OUT=$(aws kms create-key --description "Cosign KMS key for Aegis CI" --key-usage SIGN_VERIFY --customer-master-key-spec RSA_3072)
+KEY_ID=$(echo "$OUT" | jq -r .KeyMetadata.KeyId)
+aws kms create-alias --alias-name "$KEY_ALIAS" --target-key-id "$KEY_ID"
+ARN=$(aws kms describe-key --key-id "$KEY_ID" --query KeyMetadata.Arn --output text)
+echo "Created KMS key: $ARN"
+echo "Set CI secret COSIGN_AWS_KMS_KEY_ARN to kms://$ARN"
+
