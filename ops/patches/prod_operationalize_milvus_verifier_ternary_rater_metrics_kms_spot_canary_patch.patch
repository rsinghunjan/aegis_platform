+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Simulate node preemption by cordoning and deleting a spot node to exercise checkpoint/resume.
+# Usage: ./simulate_preempt_and_resume.sh <node-name>
+NODE=${1:-}
+if [ -z "$NODE" ]; then
+  echo "Usage: $0 <node-name>"; exit 2
+fi
+kubectl cordon "$NODE"
+kubectl drain "$NODE" --ignore-daemonsets --delete-local-data --force --grace-period=30 || true
+kubectl delete node "$NODE"
+echo "Deleted node $NODE; autoscaler should provision replacement (if configured). Monitor job to ensure resume."
+
