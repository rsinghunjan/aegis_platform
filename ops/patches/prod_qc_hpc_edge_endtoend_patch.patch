+#!/usr/bin/env python3
+"""
+Simple quota enforcer and billing alert trigger (PoC)
+
+ - Reads BillingRecord and QPUJob counts per tenant and enforces quota by marking submissions rejected
+ - Sends alerts when tenant spend exceeds thresholds (uses SNS or webhook)
+"""
+import os
+import logging
+from services.quantum.db_models import SessionLocal, BillingRecord, QPUJob
+
+logger = logging.getLogger("enforce-quotas")
+logging.basicConfig(level=logging.INFO)
+
+SPEND_ALERT_THRESHOLD = float(os.environ.get("SPEND_ALERT_THRESHOLD_USD", "1000"))
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK", "")
+
+def check_and_alert(tenant):
+    db = SessionLocal()
+    total = db.query(BillingRecord).filter(BillingRecord.owner == tenant).with_entities(func.sum(BillingRecord.actual_cost)).scalar() or 0.0
+    if total > SPEND_ALERT_THRESHOLD:
+        msg = {"tenant": tenant, "spend": total}
+        logger.warning("Tenant %s exceeded spend threshold: %s", tenant, total)
+        if ALERT_WEBHOOK:
+            import requests
+            try:
+                requests.post(ALERT_WEBHOOK, json=msg, timeout=5)
+            except Exception:
+                logger.exception("Alert webhook failed")
+
+def tenant_inflight_count(tenant):
+    db = SessionLocal()
+    return db.query(QPUJob).filter(QPUJob.owner == tenant, QPUJob.state.in_(["queued", "running"])).count()
+
+if __name__ == "__main__":
+    # For PoC: check all tenants in BillingRecord and alert if needed
+    db = SessionLocal()
+    tenants = [r[0] for r in db.query(BillingRecord.owner).distinct()]
+    for t in tenants:
+        check_and_alert(t)
+
