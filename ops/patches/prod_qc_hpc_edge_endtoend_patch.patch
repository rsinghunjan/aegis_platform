+#!/usr/bin/env python3
+"""
+Live provider validation runner
+
+Submits tiny jobs to configured providers (AWS Braket, IBM Qiskit Runtime, Azure Quantum, PennyLane),
+polls for completion, stores results and (optionally) stores a placeholder invoice file to S3 for later reconciliation.
+
+Configuration (env):
+ - EVIDENCE_BUCKET (S3) - required to upload evidence/results/invoices
+ - BRACKET_S3_BUCKET (optional) - for braket payloads
+ - Uses services.quantum.credentials.secretsmanager_provider.get_secret to fetch provider credentials
+
+Note: This script attempts to use the real SDKs when available. It falls back gracefully to PoC stubs otherwise.
+"""
+import os
+import time
+import json
+import logging
+from datetime import datetime
+
+from services.quantum.credentials.secretsmanager_provider import get_secret
+
+logger = logging.getLogger("validate-providers")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def upload(key_prefix, payload):
+    if not EVIDENCE_BUCKET:
+        p = f"/tmp/{key_prefix}-{int(time.time())}.json"
+        with open(p, "w") as f:
+            json.dump(payload, f)
+        logger.info("Wrote local evidence: %s", p)
+        return p
+    try:
+        import boto3
+        s3 = boto3.client("s3")
+        key = f"{key_prefix}/{datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')}-{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode())
+        uri = f"s3://{EVIDENCE_BUCKET}/{key}"
+        logger.info("Uploaded evidence: %s", uri)
+        return uri
+    except Exception as e:
+        logger.exception("Failed upload: %s", e)
+        return None
+
+def run_braket_test():
+    # Ensure credentials available
+    secret = get_secret("staging/qpu/aws_braket")
+    logger.info("Braket secret available=%s", bool(secret))
+    from services.quantum.adapters.aws_braket_sdk import run_braket_sync
+    job = {"job_id": f"live-braket-{int(time.time())}", "payload": {"shots": 64}}
+    res = run_braket_sync(job)
+    upload("qpu/live/braket/results", res)
+    # Create placeholder invoice
+    invoice = {"job_id": res.get("job_id"), "provider":"aws_braket", "cost_usd": res.get("estimated_cost", 0.0)}
+    upload("qpu/invoices", invoice)
+    return res
+
+def run_ibm_test():
+    secret = get_secret("staging/qpu/ibm")
+    logger.info("IBM secret available=%s", bool(secret))
+    from services.quantum.adapters.ibm_qiskit_runtime import run_ibm_sync
+    job = {"job_id": f"live-ibm-{int(time.time())}", "payload": {"shots": 128}}
+    res = run_ibm_sync(job)
+    upload("qpu/live/ibm/results", res)
+    invoice = {"job_id": res.get("job_id"), "provider":"ibm", "cost_usd": res.get("estimated_cost", 0.0)}
+    upload("qpu/invoices", invoice)
+    return res
+
+def run_azure_test():
+    secret = get_secret("staging/qpu/azure")
+    logger.info("Azure secret available=%s", bool(secret))
+    from services.quantum.adapters.azure_quantum_sdk import run_azure_sync
+    job = {"job_id": f"live-azure-{int(time.time())}", "payload": {"shots": 64}}
+    res = run_azure_sync(job)
+    upload("qpu/live/azure/results", res)
+    invoice = {"job_id": res.get("job_id"), "provider":"azure", "cost_usd": res.get("estimated_cost", 0.0)}
+    upload("qpu/invoices", invoice)
+    return res
+
+def run_pennylane_test():
+    from services.quantum.adapters.pennylane_prod import run_pennylane_sync
+    job = {"job_id": f"live-pl-{int(time.time())}", "payload": {"shots": 64}}
+    res = run_pennylane_sync(job)
+    upload("qpu/live/pennylane/results", res)
+    invoice = {"job_id": res.get("job_id"), "provider":"pennylane", "cost_usd": res.get("estimated_cost", 0.0)}
+    upload("qpu/invoices", invoice)
+    return res
+
+def main():
+    logger.info("Starting live provider validation run")
+    results = {}
+    for fn in (run_braket_test, run_ibm_test, run_azure_test, run_pennylane_test):
+        try:
+            r = fn()
+            results[r.get("job_id")] = {"status":"ok","provider": r.get("provider"), "meta": r}
+        except Exception as e:
+            logger.exception("Provider test failed: %s", e)
+            results[f"error-{int(time.time())}"] = {"status":"error","error": str(e)}
+    upload("qpu/live/summary", results)
+    logger.info("Live provider validation complete")
+
+if __name__ == "__main__":
+    main()
+
