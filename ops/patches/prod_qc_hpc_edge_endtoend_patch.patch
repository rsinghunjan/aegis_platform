+echo "Sending SIGTERM to qpu-worker container (delete pod which causes SIGTERM in preStop)"
+kubectl -n monitoring delete pod "$POD" --grace-period=30
+echo "Wait for new pod to be Ready"
+kubectl -n monitoring wait --for=condition=ready pod -l app=qpu-worker --timeout=300s
+echo "Check logs for graceful shutdown messages"
+NEWPOD=$(kubectl -n monitoring get pods -l app=qpu-worker -o jsonpath='{.items[0].metadata.name}')
+kubectl -n monitoring logs "$NEWPOD" --since=5m || true
