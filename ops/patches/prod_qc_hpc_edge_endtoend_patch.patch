+  KEYCLOAK_HOST=$(kubectl -n monitoring get svc keycloak -o jsonpath='{.spec.clusterIP}')
+  nikto -host "http://$KEYCLOAK_HOST:8080" > "$REPORT_DIR/nikto_keycloak.txt" || true
