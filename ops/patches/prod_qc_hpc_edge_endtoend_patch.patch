+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Trigger a staged OTA rollout via the fleet controller and monitor batches; rollback if failure ratio exceeds threshold.
+API=${FLEET_API:-http://device-fleet-controller.monitoring.svc:8080}
+CAMPAIGN_NAME=${1:-pilot-campaign}
+ARTIFACT_S3=${2:-}
+DEVICES_CSV=${3:-}
+BATCH_SIZE=${4:-10}
+ROLLBACK_THRESHOLD=${5:-0.1} # 10% failures triggers rollback
+
+if [ -z "$ARTIFACT_S3" ] || [ -z "$DEVICES_CSV" ]; then
+  echo "Usage: $0 <campaign-name> <artifact-s3> <devices-csv> [batch_size] [rollback_threshold]"
+  exit 2
+fi
+
+DEVICES=$(cat "$DEVICES_CSV" | tr '\n' ',' | sed 's/,$//')
+echo "Creating campaign $CAMPAIGN_NAME for devices count=$(echo $DEVICES | awk -F, '{print NF}')"
+BODY="{\"name\":\"$CAMPAIGN_NAME\",\"artifact_s3\":\"$ARTIFACT_S3\",\"target_devices\":[$(printf '"%s",' $(echo $DEVICES | tr ',' ' ' ) )]}";
+BODY=$(echo "$BODY" | sed 's/,$//')
+
+CID=$(curl -sS -X POST -H "Content-Type: application/json" -d "$BODY" $API/campaigns | jq -r .id)
+echo "Campaign created: $CID"
+curl -sS -X POST $API/campaigns/$CID/start || true
+echo "Campaign started. Monitoring batches..."
+
+# Simple monitor (PoC): wait and fetch campaign state
+for i in $(seq 1 60); do
+  sleep 5
+  ST=$(curl -sS $API/campaigns/$CID | jq -r .state)
+  echo "Campaign state: $ST"
+  if [ "$ST" = "completed" ]; then
+    echo "Campaign completed"
+    break
+  fi
+done
+
+# In PoC, we don't compute failure ratio. For production, query device status and compute failures.
+echo "If failures exceed $ROLLBACK_THRESHOLD, call rollback endpoint"
+echo "To rollback: curl -X POST $API/campaigns/$CID/rollback"
+
