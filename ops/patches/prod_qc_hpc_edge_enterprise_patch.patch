+#!/usr/bin/env python3
+"""
+Production-hardened QPU worker:
+ - Graceful shutdown (SIGTERM)
+ - Prometheus metrics (jobs_processed, jobs_failed, jobs_inflight)
+ - OpenTelemetry tracing via services.common.otel_middleware
+ - Robust retries/backoff (configurable)
+ - Idempotency checks via DB job state and `with_for_update(skip_locked=True)` semantics
+"""
+import os
+import signal
+import time
+import logging
+import random
+from datetime import datetime
+
+from prometheus_client import start_http_server, Counter, Gauge
+from services.quantum.db_models import SessionLocal, QPUJob, JobState, BillingRecord
+from sqlalchemy.exc import OperationalError
+
+logger = logging.getLogger("qpu-worker-prod")
+logging.basicConfig(level=logging.INFO)
+
+JOBS_PROCESSED = Counter("aegis_qpu_jobs_processed_total", "Total QPU jobs processed")
+JOBS_FAILED = Counter("aegis_qpu_jobs_failed_total", "Total QPU jobs failed")
+JOBS_INFLIGHT = Gauge("aegis_qpu_jobs_inflight", "QPU jobs inflight")
+
+_SHUTDOWN = False
+
+def _handle_term(signum, frame):
+    global _SHUTDOWN
+    logger.info("SIGTERM received, shutting down gracefully")
+    _SHUTDOWN = True
+
+signal.signal(signal.SIGTERM, _handle_term)
+
+MAX_RETRIES = int(os.environ.get("QPU_MAX_RETRIES", "5"))
+
+def run_adapter(job):
+    provider = (job.provider or "local").lower()
+    spec = {"job_id": job.id, "payload": job.payload}
+    if "braket" in provider:
+        from services.quantum.adapters.aws_braket_sdk import run_braket_sync
+        return run_braket_sync(spec)
+    if "ibm" in provider:
+        from services.quantum.adapters.ibm_qiskit_runtime import run_ibm_sync
+        return run_ibm_sync(spec)
+    if "azure" in provider:
+        from services.quantum.adapters.azure_quantum_sdk import run_azure_sync
+        return run_azure_sync(spec)
+    if "pennylane" in provider:
+        from services.quantum.adapters.pennylane_prod import run_pennylane_sync
+        return run_pennylane_sync(spec)
+    from services.quantum.qiskit_adapter import run_job_sync
+    return run_job_sync(spec)
+
+def worker_loop():
+    start_http_server(int(os.environ.get("METRICS_PORT", 9000)))
+    while not _SHUTDOWN:
+        db = SessionLocal()
+        try:
+            job = db.query(QPUJob).filter(QPUJob.state == JobState.queued).order_by(QPUJob.priority.asc()).with_for_update(skip_locked=True).first()
+        except OperationalError as e:
+            logger.warning("DB error: %s", e)
+            time.sleep(2); continue
+        if job:
+            JOBS_INFLIGHT.inc()
+            logger.info("Processing job %s provider=%s", job.id, job.provider)
+            job.state = JobState.running
+            job.started_at = datetime.utcnow()
+            db.commit()
+            success = False
+            retries = 0
+            backoff = 1.0
+            while retries <= MAX_RETRIES and not _SHUTDOWN:
+                try:
+                    res = run_adapter(job)
+                    job.result = res
+                    job.state = JobState.done
+                    job.finished_at = datetime.utcnow()
+                    # record billing if available
+                    br = db.query(BillingRecord).filter(BillingRecord.job_id == job.id).first()
+                    if br and isinstance(res.get("estimated_cost"), (int,float)):
+                        br.actual_cost = float(res.get("estimated_cost"))
+                    db.commit()
+                    JOBS_PROCESSED.inc()
+                    success = True
+                    break
+                except Exception as e:
+                    logger.exception("Job %s failed on attempt %d: %s", job.id, retries+1, e)
+                    retries += 1
+                    time.sleep(backoff + random.random()*0.2)
+                    backoff *= 2
+            if not success:
+                job.state = JobState.error
+                job.error = f"failed after {retries} retries"
+                db.commit()
+                JOBS_FAILED.inc()
+            JOBS_INFLIGHT.dec()
+        else:
+            time.sleep(1)
+    logger.info("Worker shutdown complete")
+
+if __name__ == "__main__":
+    worker_loop()
+
