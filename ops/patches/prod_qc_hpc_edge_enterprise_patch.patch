+#!/usr/bin/env python3
+"""
+Extended billing reconciliation:
+ - Pull provider invoice files (CSV) from S3 prefix (invoices/) and match by job_id
+ - Mark BillingRecord.actual_cost and emit reconciliation report to evidence bucket
+"""
+import os
+import csv
+import logging
+import boto3
+from services.quantum.db_models import SessionLocal, BillingRecord
+
+logger = logging.getLogger("billing-reconcile-ext")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+S3 = boto3.client("s3") if EVIDENCE_BUCKET else None
+
+def reconcile_from_s3_prefix(prefix: str):
+    db = SessionLocal()
+    if not S3:
+        logger.error("S3 not configured")
+        return
+    res = S3.list_objects_v2(Bucket=EVIDENCE_BUCKET, Prefix=prefix)
+    for obj in res.get("Contents", []):
+        key = obj["Key"]
+        logger.info("Processing invoice: %s", key)
+        tmp = f"/tmp/{os.path.basename(key)}"
+        S3.download_file(EVIDENCE_BUCKET, key, tmp)
+        with open(tmp) as f:
+            reader = csv.DictReader(f)
+            for row in reader:
+                jid = row.get("job_id")
+                cost = float(row.get("cost", "0"))
+                rec = db.query(BillingRecord).filter(BillingRecord.job_id == jid).first()
+                if rec:
+                    rec.actual_cost = cost
+                    db.commit()
+                    logger.info("Reconciled job %s cost %s", jid, cost)
+    # write summary
+    summary_key = f"invoices/reconcile-summary-{int(time.time())}.txt"
+    S3.put_object(Bucket=EVIDENCE_BUCKET, Key=summary_key, Body=b"reconciliation complete")
+    logger.info("Reconciliation summary uploaded: s3://%s/%s", EVIDENCE_BUCKET, summary_key)
+
+if __name__ == "__main__":
+    reconcile_from_s3_prefix("invoices/")
+
