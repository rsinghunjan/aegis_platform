+#!/usr/bin/env python3
+"""
+Provider credentials helper: fetch provider-specific credentials from AWS Secrets Manager (or env).
+ - Designed for pods using IRSA so boto3 calls use the pod identity.
+ - Caches secrets in-memory for short TTL.
+"""
+import os
+import time
+import logging
+from typing import Optional
+
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+logger = logging.getLogger("qpu-creds")
+logging.basicConfig(level=logging.INFO)
+
+_cache = {}
+_TTL = int(os.environ.get("SECRETS_CACHE_TTL", "30"))
+
+def get_secret(secret_name: str) -> Optional[str]:
+    now = time.time()
+    ent = _cache.get(secret_name)
+    if ent and (now - ent["ts"] < _TTL):
+        return ent["val"]
+    if not boto3:
+        val = os.environ.get(secret_name.upper())
+        _cache[secret_name] = {"ts": now, "val": val}
+        return val
+    client = boto3.client("secretsmanager")
+    try:
+        resp = client.get_secret_value(SecretId=secret_name)
+        val = resp.get("SecretString") or resp.get("SecretBinary")
+        _cache[secret_name] = {"ts": now, "val": val}
+        return val
+    except Exception as e:
+        logger.warning("get_secret failed: %s", e)
+        return None
+
