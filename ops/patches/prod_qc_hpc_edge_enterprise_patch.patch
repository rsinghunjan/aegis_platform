+#!/usr/bin/env python3
+"""
+HashiCorp Vault PKI integration (PoC)
+ - Issues device certs by calling Vault's /pki/issue/<role>
+ - Automates rotation by invoking Vault to re-issue certs and publishing CRL or revocation list to S3
+"""
+import os, logging, requests, json
+
+logger = logging.getLogger("vault-pki")
+logging.basicConfig(level=logging.INFO)
+
+VAULT_ADDR = os.environ.get("VAULT_ADDR")
+VAULT_TOKEN = os.environ.get("VAULT_TOKEN")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET")
+
+def issue_device_cert(device_id, role="device-role"):
+    assert VAULT_ADDR and VAULT_TOKEN
+    url = f"{VAULT_ADDR}/v1/pki/issue/{role}"
+    payload = {"common_name": device_id, "ttl": "24h"}
+    resp = requests.post(url, json=payload, headers={"X-Vault-Token": VAULT_TOKEN})
+    resp.raise_for_status()
+    return resp.json()
+
+def revoke_cert(serial):
+    url = f"{VAULT_ADDR}/v1/pki/revoke"
+    payload = {"serial_number": serial}
+    resp = requests.post(url, json=payload, headers={"X-Vault-Token": VAULT_TOKEN})
+    resp.raise_for_status()
+    return resp.json()
