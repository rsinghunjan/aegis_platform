+            f.write(buf)
+    write_time = time.time() - t0
+    # Read test
+    t0 = time.time()
+    with open(path, "r") as f:
+        _ = f.read()
+    read_time = time.time() - t0
+    logger.info("FS throughput write: %.2f MB/s, read: %.2f MB/s", size_mb / write_time, size_mb / read_time)
