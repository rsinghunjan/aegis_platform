+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate SSH key used by Slurm submitters:
+#  - generate new keypair
+#  - patch k8s Secret (slurm-ssh-key) with new private key
+#  - print public key to add to headnode authorized_keys
+
+NAMESPACE=${1:-cicd}
+SECRET_NAME=${2:-slurm-ssh-key}
+
+ssh-keygen -t rsa -b 4096 -f /tmp/slurm_id_rsa -N "" -C "aegis-slurm-$(date +%s)"
+kubectl -n "$NAMESPACE" create secret generic "$SECRET_NAME" --from-file=id_rsa=/tmp/slurm_id_rsa --dry-run=client -o yaml | kubectl apply -f -
+echo "New public key (add to Slurm head authorized_keys):"
+cat /tmp/slurm_id_rsa.pub
+rm -f /tmp/slurm_id_rsa /tmp/slurm_id_rsa.pub
+
