+#!/usr/bin/env python3
+"""
+Device certificate issuance integrated with Keycloak (PoC).
+ - Uses Keycloak admin API to verify device enrollment and issues short-lived certs signed by internal CA.
+ - Stores issuance metadata for CRL & rotation tracking.
+ - In production, use a dedicated PKI (step-ca or Vault) and proper attestation flows.
+"""
+import os, time, uuid, json, logging
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from cryptography import x509
+from cryptography.hazmat.primitives import serialization, hashes
+from cryptography.hazmat.primitives.asymmetric import rsa
+from cryptography.x509.oid import NameOID
+import requests
+
+logger = logging.getLogger("device-cert-prod")
+logging.basicConfig(level=logging.INFO)
+
+KEYCLOAK_URL = os.environ.get("KEYCLOAK_URL", "http://keycloak.monitoring.svc:8080")
+REALM = os.environ.get("KEYCLOAK_REALM", "aegis")
+ADMIN_USER = os.environ.get("KEYCLOAK_ADMIN_USER", "")
+ADMIN_PASS = os.environ.get("KEYCLOAK_ADMIN_PASS", "")
+CA_KEY_PATH = os.environ.get("CA_KEY_PATH", "/etc/ca/ca.key.pem")
+CA_CERT_PATH = os.environ.get("CA_CERT_PATH", "/etc/ca/ca.crt.pem")
+ISSUED_META = os.environ.get("ISSUED_META_FILE", "/tmp/issued_certs.json")
+
+app = FastAPI(title="Device Cert Issuer (Prod PoC)")
+
+class CSRRequest(BaseModel):
+    device_id: str
+    csr_pem: str
+
+def get_admin_token():
+    r = requests.post(f"{KEYCLOAK_URL}/realms/master/protocol/openid-connect/token",
+                      data={"grant_type":"password","client_id":"admin-cli","username":ADMIN_USER,"password":ADMIN_PASS}, timeout=10)
+    r.raise_for_status()
+    return r.json()["access_token"]
+
+def load_ca():
+    with open(CA_KEY_PATH, "rb") as f:
+        key = serialization.load_pem_private_key(f.read(), password=None)
+    with open(CA_CERT_PATH, "rb") as f:
+        cert = x509.load_pem_x509_certificate(f.read())
+    return key, cert
+
+def persist_meta(device_id, cert_pem):
+    meta = {}
+    try:
+        with open(ISSUED_META) as f:
+            meta = json.load(f)
+    except Exception:
+        meta = {}
+    meta[device_id] = {"issued_at": int(time.time()), "cert": cert_pem}
+    with open(ISSUED_META, "w") as f:
+        json.dump(meta, f)
+
+@app.post("/issue")
+def issue(req: CSRRequest):
+    token = get_admin_token()
+    # verify device exists in Keycloak users
+    r = requests.get(f"{KEYCLOAK_URL}/admin/realms/{REALM}/users?username={req.device_id}", headers={"Authorization": f"Bearer {token}"}, timeout=10)
+    if r.status_code != 200 or not r.json():
+        raise HTTPException(status_code=404, detail="device not enrolled in Keycloak")
+    key, ca_cert = load_ca()
+    csr = x509.load_pem_x509_csr(req.csr_pem.encode())
+    builder = x509.CertificateBuilder().subject_name(
+        csr.subject
+    ).issuer_name(
+        ca_cert.subject
+    ).public_key(
+        csr.public_key()
+    ).serial_number(
+        uuid.uuid4().int >> 64
+    ).not_valid_before(
+        x509.datetime.datetime.utcnow()
+    ).not_valid_after(
+        x509.datetime.datetime.utcnow() + x509.datetime.timedelta(days=7)
+    )
+    cert = builder.sign(private_key=key, algorithm=hashes.SHA256())
+    pem = cert.public_bytes(serialization.Encoding.PEM).decode()
+    persist_meta(req.device_id, pem)
+    return {"cert_pem": pem}
+
