+#!/usr/bin/env python3
+"""
+Simulator evidence aggregator:
+ - Collects evidence files from S3 or local path, creates a tar.gz bundle, signs with cosign (if configured)
+   and uploads the bundle to evidence-bucket/bundles/.
+"""
+import os, tarfile, tempfile, subprocess, logging
+import boto3
+from datetime import datetime
+
+logger = logging.getLogger("sim-aggregator")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+S3 = boto3.client("s3") if EVIDENCE_BUCKET else None
+COSIGN_KEY = os.environ.get("COSIGN_KEY_PATH", "/secrets/cosign.key")
+
+def aggregate_prefix(prefix, out_name=None):
+    out_name = out_name or f"evidence_bundle_{prefix}_{datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')}.tar.gz"
+    tmp = tempfile.mkdtemp()
+    local_dir = os.path.join(tmp, "download")
+    os.makedirs(local_dir, exist_ok=True)
+    # download via aws cli for compatibility
+    if S3:
+        subprocess.check_call(["aws","s3","sync", f"s3://{EVIDENCE_BUCKET}/{prefix}", local_dir])
+    # create tar.gz
+    out_path = os.path.join("/tmp", out_name)
+    with tarfile.open(out_path, "w:gz") as tar:
+        tar.add(local_dir, arcname=os.path.basename(local_dir))
+    # sign with cosign if available
+    sig = None
+    if os.path.exists(COSIGN_KEY) and shutil.which("cosign"):
+        subprocess.check_call(["cosign","sign","--key",COSIGN_KEY, out_path])
+        sig = out_path + ".sig"
+    # upload bundle and signature
+    if S3:
+        subprocess.check_call(["aws","s3","cp", out_path, f"s3://{EVIDENCE_BUCKET}/bundles/{os.path.basename(out_path)}"])
+        if sig:
+            subprocess.check_call(["aws","s3","cp", sig, f"s3://{EVIDENCE_BUCKET}/bundles/{os.path.basename(sig)}"])
+    return out_path
+
+if __name__ == "__main__":
+    import sys, shutil
+    prefix = sys.argv[1] if len(sys.argv) > 1 else "simulations"
+    print("Aggregating", prefix)
+    print(aggregate_prefix(prefix))
+
