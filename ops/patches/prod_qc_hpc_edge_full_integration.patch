+#!/usr/bin/env python3
+"""
+Billing reconciliation script (PoC)
+ - Reads BillingRecord entries from DB and attempts to match with provider invoice CSVs (S3 or local)
+ - Marks actual_cost for jobs when matched
+"""
+import os, csv, logging
+from services.quantum.db_models import SessionLocal, BillingRecord
+
+logger = logging.getLogger("billing-reconcile")
+logging.basicConfig(level=logging.INFO)
+
+def reconcile_from_csv(path):
+    db = SessionLocal()
+    with open(path) as f:
+        r = csv.DictReader(f)
+        for row in r:
+            job_id = row.get("job_id")
+            cost = float(row.get("cost", "0"))
+            rec = db.query(BillingRecord).filter(BillingRecord.job_id == job_id).first()
+            if rec:
+                rec.actual_cost = cost
+                db.commit()
+                logger.info("Reconciled job %s cost=%s", job_id, cost)
+            else:
+                logger.warning("No billing record for job %s", job_id)
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("usage: billing_reconcile.py invoice.csv")
+        raise SystemExit(2)
+    reconcile_from_csv(sys.argv[1])
