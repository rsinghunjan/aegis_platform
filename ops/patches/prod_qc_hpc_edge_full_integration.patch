+#!/usr/bin/env python3
+"""
+Kubernetes-friendly QPU worker with retries, backoff, billing reconciliation hooks and quota enforcement.
+ - Polls DB (SQLAlchemy) for queued jobs, claims job, runs provider adapter, updates DB and billing.
+ - Designed to run as a Deployment scaled by KEDA (based on pending queue length metric).
+"""
+import os
+import time
+import logging
+import random
+from datetime import datetime
+from sqlalchemy.exc import OperationalError
+
+from services.quantum.db_models import SessionLocal, QPUJob, JobState, BillingRecord
+
+logger = logging.getLogger("qpu-worker-keda")
+logging.basicConfig(level=logging.INFO)
+
+MAX_RETRIES = int(os.environ.get("QPU_MAX_RETRIES", "5"))
+
+def run_adapter(job):
+    provider = job.provider.lower()
+    spec = {"job_id": job.id, "payload": job.payload}
+    if provider.startswith("aws") or "braket" in provider:
+        from services.quantum.adapters.aws_braket_prod import run_braket_sync
+        return run_braket_sync(spec)
+    if provider.startswith("ibm"):
+        from services.quantum.adapters.ibm_prod import run_ibm_sync
+        return run_ibm_sync(spec)
+    if provider.startswith("azure"):
+        from services.quantum.adapters.azure_prod import run_azure_sync
+        return run_azure_sync(spec)
+    if provider.startswith("pennylane"):
+        from services.quantum.adapters.pennylane_prod import run_pennylane_sync
+        return run_pennylane_sync(spec)
+    # fallback
+    from services.quantum.qiskit_adapter import run_job_sync
+    return run_job_sync(spec)
+
+def worker_loop():
+    while True:
+        db = SessionLocal()
+        try:
+            job = db.query(QPUJob).filter(QPUJob.state == JobState.queued).order_by(QPUJob.priority.asc()).with_for_update(skip_locked=True).first()
+        except OperationalError as e:
+            logger.warning("DB operational error: %s", e)
+            time.sleep(2); continue
+        if job:
+            logger.info("Claiming job %s provider=%s", job.id, job.provider)
+            job.state = JobState.running
+            job.started_at = datetime.utcnow()
+            db.commit()
+            retries = 0
+            backoff = 1.0
+            success = False
+            while retries <= MAX_RETRIES:
+                try:
+                    res = run_adapter(job)
+                    job.result = res
+                    job.state = JobState.done
+                    job.finished_at = datetime.utcnow()
+                    # billing: write actual cost if provided
+                    br = db.query(BillingRecord).filter(BillingRecord.job_id == job.id).first()
+                    if br and isinstance(res.get("estimated_cost"), (int,float)):
+                        br.actual_cost = float(res.get("estimated_cost"))
+                    db.commit()
+                    success = True
+                    break
+                except Exception as e:
+                    logger.exception("Adapter failed for job %s: %s", job.id, e)
+                    retries += 1
+                    time.sleep(backoff + random.random()*0.5)
+                    backoff *= 2
+            if not success:
+                job.state = JobState.error
+                job.error = f"failed after {retries} retries"
+                db.commit()
+        else:
+            time.sleep(2)
+
+if __name__ == "__main__":
+    worker_loop()
+
