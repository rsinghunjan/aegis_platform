+"""
+Simple chaos experiments runner using kubectl:
+ - Simulate DB failure by scaling StatefulSet to 0
+ - Simulate KMS latency by adding sleep on the signing worker (flag file)
+ - Simulate GPU preemption by cordoning and draining GPU node
+
+This is a destructive tool and must be run by operators in staging.
+"""
+import subprocess
+import time
+from datetime import datetime
+
+def run(cmd):
+    print("RUN:", " ".join(cmd))
+    subprocess.check_call(cmd)
+
+def scale_statefulset(ns, name, replicas):
+    run(["kubectl","-n",ns,"scale","statefulset",name,"--replicas",str(replicas)])
+
+def toggle_signing_latency(enable=True):
+    # create or remove /tmp/chaos_sign_delay on worker nodes via a DaemonSet or ssh
+    if enable:
+        print("Enable signing latency - operator must ensure workers poll for this file and sleep")
+    else:
+        print("Disable signing latency")
+
+def preempt_gpu_node(node):
+    # cordon & drain then uncordon after wait to simulate preemption
+    run(["kubectl","cordon",node])
+    run(["kubectl","drain",node,"--ignore-daemonsets","--delete-local-data","--force"])
+    time.sleep(30)
+    run(["kubectl","uncordon",node])
+
+def main():
+    print("Starting chaos experiments at", datetime.utcnow().isoformat())
+    # example sequence
+    try:
+        scale_statefulset("aegis","postgres",0)
+        time.sleep(10)
+        scale_statefulset("aegis","postgres",1)
+        toggle_signing_latency(True)
+        time.sleep(15)
+        toggle_signing_latency(False)
+        # GPU preempt example (operator supplies actual gpu-node name)
+        # preempt_gpu_node("gpunode-1")
+    except Exception as e:
