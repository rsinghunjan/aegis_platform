+#!/usr/bin/env python3
+"""
+Label and validate Kubernetes nodes for representative hardware provisioning.
+
+Usage:
+  python ops/provisioning/label_and_validate_nodes.py --selector "node-role.kubernetes.io/gpu=true" --label "aegis/gpu=true"
+
+This script:
+ - Finds nodes matching a kubectl selector or list
+ - Applies the requested aegis/* label to each node
+ - Validates driver presence via a simple remote check (kubectl exec into privileged job)
+
+Operators must run this with kubeconfig that can label nodes.
+"""
+import argparse
+import subprocess
+import json
+from datetime import datetime
+
+def run(cmd):
+    return subprocess.check_output(cmd, text=True).strip()
+
+def get_nodes_by_selector(selector):
+    cmd = ["kubectl", "get", "nodes", "-l", selector, "-o", "json"]
+    out = run(cmd)
+    j = json.loads(out)
+    return [n["metadata"]["name"] for n in j.get("items",[])]
+
+def label_node(node, label):
+    cmd = ["kubectl", "label", "node", node, label, "--overwrite"]
+    run(cmd)
+    print(f"Labeled {node} with {label}")
+
+def run_driver_check(node, check_cmd=["/bin/sh","-c","which nvidia-smi || true"]):
+    # Run privileged pod to check access to node; this is a heuristic and must be reviewed by operators
+    pod_yaml = f"""
+apiVersion: v1
+kind: Pod
+metadata:
+  name: node-check-{node.replace('.','-')[:40]}
+spec:
+  nodeName: {node}
+  containers:
+  - name: check
+    image: ubuntu:22.04
+    command: ["sleep","3600"]
+  restartPolicy: Never
+"""
+    p = subprocess.Popen(["kubectl","apply","-f","-"], stdin=subprocess.PIPE, text=True)
+    p.communicate(pod_yaml)
+    try:
+        # copy check script into pod and run (fallback simple shell exec)
+        out = run(["kubectl","exec","-n","default","node-check-"+node.replace('.','-')[:40],"--"] + check_cmd)
+        print("Driver check output:", out)
+    except Exception as e:
+        print("Driver check failed:", e)
+    finally:
+        run(["kubectl","delete","pod","node-check-"+node.replace('.','-')[:40],"--ignore-not-found"])
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--selector", help="kubectl node label selector")
+    p.add_argument("--nodes", help="comma-separated node names")
+    p.add_argument("--label", required=True, help="label to apply to nodes e.g. aegis/gpu=true")
+    args = p.parse_args()
+    nodes = []
+    if args.selector:
+        nodes = get_nodes_by_selector(args.selector)
+    if args.nodes:
+        nodes += [n.strip() for n in args.nodes.split(",") if n.strip()]
+    nodes = list(set(nodes))
+    if not nodes:
+        print("No nodes found; provide --selector or --nodes")
+        return
+    for n in nodes:
+        label_node(n, args.label)
+        run_driver_check(n)
+
+if __name__ == "__main__":
+    main()
+
