+"""
+Finance notify & tag enforcement:
+ - Checks recent job metadata for aegis:job_id tag compliance and creates a GitHub issue for finance if violations found.
+ - Also can notify finance webhook (placeholder).
+"""
+import os
+import json
+import requests
+
+GITHUB_REPO = os.environ.get("GITHUB_REPOSITORY")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN")
+FINANCE_WEBHOOK = os.environ.get("FINANCE_WEBHOOK")
+
+def create_issue(title, body):
+    if not GITHUB_REPO or not GITHUB_TOKEN:
+        print("GitHub not configured")
+        return
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    r = requests.post(url, json={"title":title,"body":body,"labels":["finance","billing"]}, headers={"Authorization":f"token {GITHUB_TOKEN}","Accept":"application/vnd.github+json"})
+    print("Issue create status", r.status_code)
+
+def check_tags(job_reports_path="/tmp/job_reports.json"):
+    if not os.path.exists(job_reports_path):
+        print("No job reports at", job_reports_path); return
+    jobs = json.load(open(job_reports_path))
+    violations = []
+    for j in jobs:
+        tags = j.get("tags", {})
+        if not tags.get("aegis:job_id"):
+            violations.append(j)
+    if violations:
+        body = f"Found {len(violations)} jobs without aegis:job_id tag. Please enforce tagging discipline.\n\nSample: {json.dumps(violations[:3],indent=2)}"
+        create_issue("[Finance] Missing aegis:job_id tags", body)
+        if FINANCE_WEBHOOK:
+            requests.post(FINANCE_WEBHOOK, json={"text": body})
+
+if __name__ == "__main__":
+    check_tags()
