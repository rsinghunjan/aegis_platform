+#!/usr/bin/env python3
+"""
+Connectivity and readiness checks for managed services (Postgres, Redis/Kafka).
+This script validates the configured managed endpoints and reports a simple JSON health file.
+"""
+import os
+import json
+import psycopg2
+import redis
+from datetime import datetime
+
+OUT="/tmp/managed_services_health.json"
+
+def check_postgres():
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        return {"ok": False, "error": "DATABASE_URL not set"}
+    try:
+        conn = psycopg2.connect(url, connect_timeout=5)
+        cur = conn.cursor()
+        cur.execute("select 1")
+        cur.close()
+        conn.close()
+        return {"ok": True}
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+
+def check_redis():
+    url = os.environ.get("REDIS_URL")
+    if not url:
+        return {"ok": False, "error": "REDIS_URL not set"}
+    try:
+        r = redis.from_url(url)
+        r.ping()
+        return {"ok": True}
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+
+def main():
+    res = {"ts": datetime.utcnow().isoformat()+"Z", "postgres": check_postgres(), "redis": check_redis()}
+    open(OUT,"w").write(json.dumps(res, indent=2))
+    print("Wrote health to", OUT)
+
+if __name__=="__main__":
+    main()
+
