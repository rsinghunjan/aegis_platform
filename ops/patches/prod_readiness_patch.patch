+#!/usr/bin/env python3
+"""
+Generate a large corpus of HIL scenario manifests by expanding parameter grids.
+Writes manifests into ops/hil/playbook/generated_bulk/
+"""
+import os, json
+from itertools import product
+from pathlib import Path
+from datetime import datetime
+
+OUTDIR = Path("ops/hil/playbook/generated_bulk")
+OUTDIR.mkdir(parents=True, exist_ok=True)
+
+PARAMS = {
+    "occlusion_depth": [0.1,0.2,0.4,0.6],
+    "duration_s": [1,2,4,8],
+    "ped_speed": [0.5,1.0,2.0],
+    "sensor_noise": [0.0,0.01,0.05]
+}
+
+def main():
+    keys = list(PARAMS.keys())
+    combos = list(product(*(PARAMS[k] for k in keys)))
+    produced = []
+    for idx, combo in enumerate(combos):
+        params = dict(zip(keys, combo))
+        name = f"bulk_{idx}_{int(datetime.utcnow().timestamp())}"
+        manifest = {
+            "name": name,
+            "replay": "replays/urban_base.replay",
+            "modifiers": [
+                {"type":"occlusion", "depth": params["occlusion_depth"], "duration_s": params["duration_s"]},
+                {"type":"sensor_noise", "std": params["sensor_noise"]},
+                {"type":"adversary_ped", "speed": params["ped_speed"]}
+            ],
+            "expected": {}
+        }
+        path = OUTDIR / f"{name}.json"
+        path.write_text(json.dumps(manifest, indent=2))
+        produced.append(str(path))
+    print(f"Produced {len(produced)} manifests in {OUTDIR}")
+
+if __name__ == "__main__":
+    main()
+
