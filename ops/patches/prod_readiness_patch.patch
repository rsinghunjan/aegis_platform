+#!/usr/bin/env python3
+"""
+Run SMT provers (Z3 / cvc5 if available) on SMT2 files and record results.
+
+Writes results to ops/formal/prover_results.json
+"""
+import glob
+import subprocess
+import json
+from datetime import datetime
+from pathlib import Path
+
+OUT = Path("ops/formal/prover_results.json")
+
+def try_run(cmd):
+    try:
+        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True, timeout=60)
+        return True, out
+    except subprocess.CalledProcessError as e:
+        return False, e.output
+    except Exception as e:
+        return False, str(e)
+
+def run_on_file(path):
+    # prefer z3 if available
+    if shutil_which("z3"):
+        ok, out = try_run(["z3", "-smt2", path])
+        return {"engine":"z3","ok":ok,"out":out}
+    if shutil_which("cvc5"):
+        ok, out = try_run(["cvc5", path])
+        return {"engine":"cvc5","ok":ok,"out":out}
+    return {"engine":"none","ok":False,"out":"no prover installed"}
+
+def shutil_which(bin):
+    from shutil import which
+    return which(bin)
+
+def main():
+    files = glob.glob("ops/formal/onboard_submissions/*.smt2")
+    results = {"ts": datetime.utcnow().isoformat()+"Z", "results": []}
+    for f in files:
+        res = run_on_file(f)
+        res["file"] = f
+        results["results"].append(res)
+    OUT.write_text(json.dumps(results, indent=2))
+    print("Wrote prover results to", OUT)
+
+if __name__ == "__main__":
+    main()
+
