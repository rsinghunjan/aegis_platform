+#!/usr/bin/env python3
+"""
+Triton model config tuner:
+ - Generates a config.pbtxt given model metadata (approx memory footprint, input dims)
+ - Recommends dynamic batch sizes based on estimated throughput
+
+Usage:
+  python ops/triton/triton_tuner.py --model-size-mb 500 --out config.pbtxt
+"""
+import argparse
+import math
+
+def recommend_batch_sizes(model_mb):
+    # heuristic: larger models benefit from slightly smaller batch sizes due to memory
+    if model_mb < 200:
+        return [8,16,32]
+    if model_mb < 800:
+        return [4,8,16]
+    return [1,2,4,8]
+
+def generate_config(name, model_mb, instance_count=1):
+    b = recommend_batch_sizes(model_mb)
+    cfg = f"""name: "{name}"
+platform: "onnxruntime_onnx"
+max_batch_size: {max(b)}
+instance_group [
+  {{
+    count: {instance_count}
+    kind: KIND_GPU
+  }}
+]
+dynamic_batching {{ preferred_batch_size: [ {', '.join(map(str,b))} ] }}
+"""
+    return cfg
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--model-name", default="example_model")
+    p.add_argument("--model-size-mb", type=int, required=True)
+    p.add_argument("--instance-count", type=int, default=1)
+    p.add_argument("--out", default="config.pbtxt")
+    args = p.parse_args()
+    cfg = generate_config(args.model_name, args.model_size_mb, args.instance_count)
+    open(args.out,"w").write(cfg)
+    print("Wrote", args.out)
+
+if __name__ == "__main__":
+    main()
