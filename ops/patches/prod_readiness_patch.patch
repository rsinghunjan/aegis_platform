+#!/usr/bin/env python3
+"""
+Minimal OTA attestation verification server.
+
+ - Requires client cert (mTLS) for the request.
+ - Accepts attestation token JSON and validates presence and freshness.
+ - Operators must integrate real TPM quote verification against a verifier and CA.
+"""
+from flask import Flask, request, jsonify
+import ssl
+import os
+import json
+from datetime import datetime, timedelta
+
+app = Flask(__name__)
+
+def validate_attestation(att):
+    # Simple freshness check; real verification requires TPM quote & verifier
+    ts = att.get("ts")
+    try:
+        t = datetime.fromisoformat(ts.replace("Z","+00:00"))
+        if datetime.utcnow() - t > timedelta(minutes=10):
+            return False, "stale"
+    except Exception:
+        return False, "bad-ts"
+    return True, "ok"
+
+@app.route("/attest", methods=["POST"])
+def attest():
+    j = request.get_json(force=True)
+    ok,msg = validate_attestation(j)
+    if not ok:
+        return jsonify({"ok":False,"reason":msg}), 400
+    return jsonify({"ok":True})
+
+if __name__ == "__main__":
+    # run with mTLS at kube ingress or behind Envoy; for dev allow plaintext
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 8443)))
+
