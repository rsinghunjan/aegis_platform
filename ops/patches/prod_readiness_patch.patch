+"""
+Run many HIL campaign manifests in parallel (for large-scale runs).
+Aggregates results to /tmp/hil_bulk_results.json
+"""
+import concurrent.futures
+import subprocess
+import glob
+import json
+from datetime import datetime
+from pathlib import Path
+
+OUT="/tmp/hil_bulk_results.json"
+
+def run_manifest(manifest):
+    try:
+        subprocess.check_call(["python","ops/hil/run_hil_campaign.py","--manifest",manifest,"--repeats","4"])
+        # read last result
+        res = {}
+        p = Path("/tmp/hil_campaign_result.json")
+        if p.exists():
+            res = json.loads(p.read_text())
+        return {"manifest": manifest, "ok": True, "result": res}
+    except Exception as e:
+        return {"manifest": manifest, "ok": False, "error": str(e)}
+
+def main():
+    manifests = glob.glob("ops/hil/playbook/generated_bulk/*.json")
+    results = {"ts": datetime.utcnow().isoformat()+"Z", "runs": []}
+    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
+        futures = [ex.submit(run_manifest, m) for m in manifests]
+        for f in concurrent.futures.as_completed(futures):
+            results["runs"].append(f.result())
+    open(OUT,"w").write(json.dumps(results, indent=2))
+    print("Wrote", OUT)
+
+if __name__ == "__main__":
+    main()
