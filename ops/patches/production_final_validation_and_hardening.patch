+#!/usr/bin/env python3
+"""
+HPO runner wrapper:
+ - Submits distributed Ray jobs, monitors trial-level checkpoint flags,
+ - Enforces cost guard and reports checkpoint success.
+"""
+import os, time, logging, subprocess, json, tempfile, requests
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("hpo-runner-checks")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COST_GUARD = float(os.environ.get("HPO_COST_GUARD_USD", "2000.0"))
+EST_COST = float(os.environ.get("EST_COST_USD", "0.0"))
+
+def submit_ray_job(manifest_yaml):
+    f=tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(manifest_yaml.encode()); f.close()
+    out = subprocess.check_output(["kubectl","apply","-f",f.name]).decode()
+    logger.info("Submitted Ray job: %s", out)
+    for l in out.splitlines():
+        if "rayjob.ray.io/" in l:
+            return l.split("/")[1]
+    return None
+
+def watch_job(jobname, timeout_hours=8):
+    end = time.time() + timeout_hours*3600
+    while time.time() < end:
+        try:
+            out=subprocess.check_output(["kubectl","get","rayjob",jobname,"-o","json"]).decode()
+            st=json.loads(out).get("status",{})
+            state=st.get("state")
+            if state in ("Succeeded","Failed"):
+                return state, st
+        except Exception:
+            logger.exception("watch fail")
+        time.sleep(30)
+    return "Timeout", {}
+
+def validate_checkpoints_and_cost(jobname):
+    # run checkpoint_validator to assert >90% success
+    try:
+        out = subprocess.check_output(["python3","/workspace/services/hpo/checkpoint_validator.py"]).decode()
+        logger.info("Checkpoint validator output: %s", out)
+    except Exception as e:
+        logger.exception("Checkpoint validation failed")
+        raise
+    # cost enforcement
+    if EST_COST > COST_GUARD:
+        raise RuntimeError("Estimated cost exceeds guard")
+
+def main():
+    samples=int(os.environ.get("HPO_SAMPLES", "128"))
+    # generate basic Ray manifest (PoC)
+    manifest = json.dumps({
+        "apiVersion":"ray.io/v1",
+        "kind":"RayJob",
+        "metadata": {"generateName":"hpo-run-"},
+        "spec": {"entrypoint": f"python /app/run.py --samples {samples}"}
+    })
+    if EST_COST > COST_GUARD:
+        logger.error("EST_COST %s > COST_GUARD %s - aborting", EST_COST, COST_GUARD)
+        return
+    job = submit_ray_job(manifest)
+    if not job:
+        logger.error("submit failed")
+        return
+    state, status = watch_job(job)
+    logger.info("Job %s finished state=%s", job, state)
+    try:
+        validate_checkpoints_and_cost(job)
+    except Exception:
+        # collect evidence and escalate
+        if EVIDENCE_BUCKET:
+            import boto3, tempfile
+            s3=boto3.client("s3")
+            key=f"hpo/{job}/failure-{int(time.time())}.json"
+            s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps({"job":job,"state":state,"status":status}).encode())
+        raise
+
+if __name__ == "__main__":
+    main()
+
