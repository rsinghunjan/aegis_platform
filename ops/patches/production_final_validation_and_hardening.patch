+#!/usr/bin/env python3
+"""
+Checkpoint validator:
+ - Scans S3 checkpoint prefixes produced by distributed HPO and computes checkpoint success %
+ - Reports failures and uploads a summary to evidence bucket
+"""
+import os, boto3, time, json, logging
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("checkpoint-validator")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+CHECKPOINT_PREFIX = os.environ.get("CHECKPOINT_PREFIX", "checkpoints/")
+MIN_SUCCESS_RATE = float(os.environ.get("MIN_CHECKPOINT_SUCCESS_RATE", "0.9"))
+
+def scan_checkpoints():
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    resp = s3.list_objects_v2(Bucket=bucket, Prefix=CHECKPOINT_PREFIX)
+    objs = resp.get("Contents", [])
+    runs = {}
+    for o in objs:
+        key = o["Key"]
+        # expected path: checkpoints/<run_id>/trial-<id>/checkpoint-<ts>.ckpt
+        parts = key.split("/")
+        if len(parts) < 3:
+            continue
+        run_id = parts[1]
+        runs.setdefault(run_id, []).append(key)
+    return runs
+
+def evaluate():
+    runs = scan_checkpoints()
+    summary = {"total_runs": len(runs), "run_stats": {}}
+    good=0
+    for r, keys in runs.items():
+        # heuristic: at least one checkpoint per trial => success
+        count = len(keys)
+        ok = count > 0
+        summary["run_stats"][r] = {"checkpoints": count, "ok": ok}
+        if ok:
+            good += 1
+    success_rate = good / len(runs) if runs else 0.0
+    summary["success_rate"] = success_rate
+    # upload summary
+    if EVIDENCE_BUCKET:
+        s3=boto3.client("s3")
+        key=f"checkpoints/summary-{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(summary).encode())
+    logger.info("Checkpoint summary: %s", summary)
+    if success_rate < MIN_SUCCESS_RATE:
+        raise RuntimeError("Checkpoint success rate below threshold: %.2f" % success_rate)
+    return summary
+
+if __name__ == "__main__":
+    print(evaluate())
+
