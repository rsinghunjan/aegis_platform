+#!/usr/bin/env python3
+"""
+Verify and build trace->evidence linkage for recent runs:
+ - For recent run_ids, verify traces contain run_id and business_kpi attributes
+ - Ensure evidence S3 prefix exists and write a linkage manifest
+"""
+import os, requests, json, logging, boto3, time
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("otel-linker")
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+JAEGER = os.environ.get("JAEGER_QUERY", "http://jaeger-query.monitoring.svc:16686/api/traces")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def recent_run_ids(limit=20):
+    r=requests.get(f"{PROM_URL}/api/v1/label/run_id/values", timeout=10)
+    if r.status_code!=200:
+        return []
+    return r.json().get("data",[])[:limit]
+
+def evidence_present(run_id):
+    if not EVIDENCE_BUCKET:
+        return False
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    resp = s3.list_objects_v2(Bucket=bucket, Prefix=f"closedloop/{run_id}/", MaxKeys=1)
+    return resp.get("KeyCount", 0) > 0
+
+def trace_has_kpi(run_id):
+    try:
+        resp=requests.get(JAEGER, params={"query": f"json.attributes.run_id:{run_id}"}, timeout=10)
+        if resp.status_code!=200:
+            return False
+        data=resp.json().get("data",[])
+        for t in data:
+            for s in t.get("spans",[]):
+                for tag in s.get("tags",[]):
+                    if tag.get("key")=="business_kpi":
+                        return True
+    except Exception:
+        logger.exception("jaeger query failed")
+    return False
+
+def run_check():
+    runs = recent_run_ids(50)
+    manifest=[]
+    for r in runs:
+        tr = trace_has_kpi(r)
+        ev = evidence_present(r)
+        manifest.append({"run_id": r, "trace_has_kpi": tr, "evidence_present": ev})
+    # upload manifest
+    if EVIDENCE_BUCKET:
+        s3=boto3.client("s3")
+        key=f"trace_evidence/linkage-{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(manifest).encode())
+    print(json.dumps(manifest, indent=2))
+
+if __name__ == "__main__":
+    run_check()
+
