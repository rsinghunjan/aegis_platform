+TENANTS = int(os.environ.get("STRESS_TENANTS", "50"))
+CONC = int(os.environ.get("STRESS_CONC", "200"))
+DURATION = int(os.environ.get("STRESS_DURATION", "300"))
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+result = {"accepted":0, "rejected":0}
+
+def worker(tenant):
+    end = time.time() + DURATION
+    while time.time() < end:
+        try:
+            cfg={"est_usd": random.random()*50, "samples": random.choice([32,64,128])}
+            r=requests.post(SUBMIT_URL, json={"team": tenant, "config": cfg}, timeout=5)
+            if r.status_code == 200:
+                result["accepted"] += 1
+            else:
+                result["rejected"] += 1
+        except Exception:
+            result["rejected"] += 1
+        time.sleep(random.random()*0.5)
+
+def main():
+    tenants = [f"team-{i}" for i in range(TENANTS)]
+    threads=[]
+    for i in range(CONC):
+        t = threading.Thread(target=worker, args=(random.choice(tenants),))
+        t.start(); threads.append(t)
+    for t in threads:
+        t.join()
+    report="/tmp/hpo_stress_report.json"
+    open(report,"w").write(json.dumps(result, indent=2))
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"stress/hpo-{int(time.time())}.json"
+        s3.upload_file(report, EVIDENCE_BUCKET.replace("s3://",""), key)
+    print("Stress test complete:", result)
+
+if __name__ == "__main__":
+    main()
