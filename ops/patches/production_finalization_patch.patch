+#!/usr/bin/env python3
+"""
+Hardened Approval UI:
+ - Keycloak introspection for approver identity
+ - HTTPS support (expect TLS terminated at ingress)
+ - Audit linking via audit-linker service on successful approvals
+"""
+from fastapi import FastAPI, Request, Form, Header, HTTPException
+from fastapi.responses import HTMLResponse, RedirectResponse
+import os, requests, logging
+
+app = FastAPI()
+logger = logging.getLogger("approval-ui-hardened")
+logging.basicConfig(level=logging.INFO)
+
+APPROVAL_API = os.environ.get("APPROVAL_SERVICE_URL","http://approval-service.monitoring.svc:8080")
+KEYCLOAK_USERINFO = os.environ.get("KEYCLOAK_USERINFO","http://keycloak.monitoring.svc:8080/realms/aegis/protocol/openid-connect/userinfo")
+AUDIT_LINKER = os.environ.get("AUDIT_LINKER_URL","http://audit-linker.monitoring.svc:8080/record")
+
+def introspect(token):
+    if not token:
+        return {}
+    try:
+        r = requests.get(KEYCLOAK_USERINFO, headers={"Authorization": token}, timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        logger.exception("introspect failed")
+        return {}
+
+@app.get("/", response_class=HTMLResponse)
+def index():
+    try:
+        r = requests.get(f"{APPROVAL_API}/pending", timeout=5)
+        pending = r.json()
+    except Exception:
+        pending = []
+    html = "<h1>Approval Requests</h1><ul>"
+    for p in pending:
+        html += f"<li>{p['id']} - {p.get('summary','')} - Evidence: {p.get('evidence','')} - <form method='post' action='/approve/{p['id']}' style='display:inline'><input name='token' placeholder='Bearer token' required><input name='note' placeholder='signed note'><button type='submit'>Approve</button></form></li>"
+    html += "</ul>"
+    return HTMLResponse(html)
+
+@app.post("/approve/{req_id}")
+def approve(req_id: str, token: str = Form(...), note: str = Form("")):
+    user = introspect(token)
+    if not user:
+        raise HTTPException(status_code=401, detail="invalid token")
+    headers = {"Authorization": f"Bearer {token}"}
+    payload = {"note": note}
+    r = requests.put(f"{APPROVAL_API}/approve/{req_id}", headers=headers, json=payload, timeout=10)
+    if r.status_code != 200:
+        raise HTTPException(status_code=400, detail="approve failed")
+    # call audit linker
+    try:
+        requests.post(AUDIT_LINKER, json={"req_id": req_id, "approver": user.get("preferred_username"), "evidence": r.json().get("evidence")}, timeout=5)
+    except Exception:
+        logger.exception("audit-link failed")
+    return RedirectResponse("/", status_code=303)
+
