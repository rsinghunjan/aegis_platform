+#!/usr/bin/env python3
+"""
+Calibrate cost estimator using historical invoices:
+ - Pull invoice records from S3 (or local path)
+ - Compute empirical cost per accelerator-hour and update a local JSON pricing file
+"""
+import os, json, logging, statistics
+import boto3
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("calibrate-cost")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+HIST_INVOICE_PREFIX = os.environ.get("HIST_INVOICE_PREFIX", "invoices/historical/")
+PRICES_FILE = os.environ.get("PRICES_FILE", "/tmp/accel_prices.json")
+
+def list_invoices():
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    resp = s3.list_objects_v2(Bucket=bucket, Prefix=HIST_INVOICE_PREFIX)
+    return [o["Key"] for o in resp.get("Contents",[])]
+
+def download(key, dest):
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    s3.download_file(bucket, key, dest)
+
+def process_csv(path):
+    import csv
+    records=[]
+    with open(path) as f:
+        r=csv.DictReader(f)
+        for row in r:
+            records.append(row)
+    return records
+
+def main():
+    if not EVIDENCE_BUCKET:
+        logger.error("EVIDENCE_BUCKET required")
+        return
+    keys = list_invoices()
+    samples={}
+    for k in keys:
+        tmp="/tmp/inv.csv"
+        download(k,tmp)
+        for r in process_csv(tmp):
+            accel = r.get("accelerator_type","unknown")
+            hours = float(r.get("hours",0.0))
+            cost = float(r.get("cost_usd",0.0))
+            if hours>0:
+                samples.setdefault(accel,[]).append(cost/hours)
+    prices = {}
+    for a, vals in samples.items():
+        prices[a] = round(statistics.median(vals),2)
+    open(PRICES_FILE,"w").write(json.dumps(prices, indent=2))
+    print("Wrote calibrated prices to", PRICES_FILE)
+
+if __name__ == "__main__":
+    main()
+
