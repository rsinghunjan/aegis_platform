+#!/usr/bin/env python3
+"""
+Simulate many provider invoices and upload to S3 to stress test reconciliation.
+Produces CSVs with columns: provider, accelerator_type, hours, cost_usd, invoice_id
+"""
+import os, csv, random, boto3, time
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+BUCKET = EVIDENCE_BUCKET.replace("s3://","") if EVIDENCE_BUCKET else ""
+
+def generate_invoice(n_lines=1000, fname="/tmp/inv.csv"):
+    fields=["provider","accelerator_type","hours","cost_usd","invoice_id"]
+    rows=[]
+    for i in range(n_lines):
+        accel=random.choice(["habana-gaudi","graphcore-ipu","tpu-vm"])
+        hours=round(random.random()*10,2)
+        price={"habana-gaudi":1.5,"graphcore-ipu":3.0,"tpu-vm":4.0}[accel]
+        cost=round(price*hours,2)
+        rows.append({"provider":"provA","accelerator_type":accel,"hours":hours,"cost_usd":cost,"invoice_id":f"inv-{int(time.time())}-{i}"})
+    with open(fname,"w",newline="") as f:
+        w=csv.DictWriter(f, fieldnames=fields)
+        w.writeheader()
+        w.writerows(rows)
+    return fname
+
+def upload(fname, key_prefix="invoices/simulated/"):
+    s3=boto3.client("s3")
+    key = f"{key_prefix}{os.path.basename(fname)}"
+    s3.upload_file(fname, BUCKET, key)
+    return f"s3://{BUCKET}/{key}"
+
+if __name__ == "__main__":
+    f=generate_invoice(5000, "/tmp/inv.csv")
+    print(upload(f))
+
