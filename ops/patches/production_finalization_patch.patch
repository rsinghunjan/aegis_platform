+#!/usr/bin/env python3
+"""
+Multi-tenant stress tester:
+ - Simulate many tenants submitting HPO jobs rapidly
+ - Use quota-enforcer and submission endpoints (Tekton or HPO submit service)
+ - Monitor Redis quota counters and produce a report of rejections vs accepted
+"""
+import os, time, random, requests, logging, json, threading
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("multi-stress")
+
+SUBMIT_URL = os.environ.get("HPO_SUBMIT_URL", "http://hpo-submit.monitoring.svc:8080/submit")
+QUOTA_API = os.environ.get("QUOTA_API", "http://quota-enforcer.monitoring.svc:8080")
+TENANTS = int(os.environ.get("TENANTS", "20"))
+CONC = int(os.environ.get("CONC", "200"))
+DURATION = int(os.environ.get("DURATION", "300"))
+
+results = {"accepted":0, "rejected":0}
+
+def submit_loop(tenant):
+    end = time.time() + DURATION
+    while time.time() < end:
+        try:
+            resp = requests.post(SUBMIT_URL, json={"team": tenant, "config": {"est_usd": random.random()*10}}, timeout=5)
+            if resp.status_code == 200:
+                results["accepted"] += 1
+            else:
+                results["rejected"] += 1
+        except Exception:
+            results["rejected"] += 1
+        time.sleep(random.random()*0.5)
+
+def main():
+    tenants = [f"team-{i}" for i in range(TENANTS)]
+    threads=[]
+    for i in range(CONC):
+        t = threading.Thread(target=submit_loop, args=(random.choice(tenants),))
+        t.start(); threads.append(t)
+    for t in threads:
+        t.join()
+    out = "/tmp/multi_stress_report.json"
+    open(out,"w").write(json.dumps(results, indent=2))
+    print(json.dumps(results, indent=2))
+    if os.environ.get("EVIDENCE_BUCKET"):
+        import boto3
+        s3=boto3.client("s3")
+        key=f"stress_reports/{int(time.time())}.json"
+        s3.upload_file(out, os.environ["EVIDENCE_BUCKET"].replace("s3://",""), key)
+
+if __name__ == "__main__":
+    main()
+
