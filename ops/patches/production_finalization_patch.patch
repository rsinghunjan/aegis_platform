+#!/usr/bin/env python3
+"""
+Orchestrator to run:
+ - Large distributed HPO runs (many PipelineRuns or RayJobs)
+ - Long‑shadow accelerated runs (collect KPI samples for extended duration)
+ - 2k dry-run simulator farm executions
+Collects evidence, uploads bundles to evidence S3 and returns a JSON report.
+
+Usage:
+  EVIDENCE_BUCKET=s3://... python ops/validation/scale_hpo_longshadow_runner.py
+"""
+import os
+import time
+import json
+import tempfile
+import subprocess
+import logging
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("scale-runner")
+
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+HPO_SAMPLES = int(os.environ.get("HPO_SAMPLES", "128"))
+HPO_PARALLEL = int(os.environ.get("HPO_PARALLEL", "4"))
+SIM_RUNS = int(os.environ.get("SIM_RUNS", "2000"))
+LONG_SHADOW_ACCEL_HOURS = float(os.environ.get("LONG_SHADOW_ACCEL_HOURS", "24"))  # accelerated hours
+
+def apply_manifest(manifest_yaml):
+    p = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    p.write(manifest_yaml.encode()); p.flush(); p.close()
+    subprocess.check_call(["kubectl", "apply", "-f", p.name])
+    return p.name
+
+def trigger_pipeline(name, params):
+    pr = {
+        "apiVersion": "tekton.dev/v1beta1",
+        "kind": "PipelineRun",
+        "metadata": {"generateName": f"{name}-run-"},
+        "spec": {"pipelineRef": {"name": name}, "params": [{"name": k, "value": str(v)} for k, v in params.items()]}
+    }
+    import yaml, tempfile
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.safe_dump(pr).encode()); f.close()
+    out = subprocess.check_output(["kubectl", "apply", "-n", TEKTON_NS, "-f", f.name]).decode()
+    logger.info("Triggered PipelineRun: %s", out)
+    # extract name
+    for l in out.splitlines():
+        if "pipelinerun.tekton.dev/" in l:
+            return l.split()[0].split("/")[1]
+    return None
+
+def wait_for_pipelinerun(pr_name, timeout=3600):
+    end = time.time() + timeout
+    while time.time() < end:
+        out = subprocess.check_output(["kubectl", "-n", TEKTON_NS, "get", "pipelinerun", pr_name, "-o", "json"]).decode()
+        st = json.loads(out).get("status", {})
+        conds = st.get("conditions", [])
+        if conds:
+            s = conds[0].get("status")
+            if s == "True":
+                return True, st
+            if s == "False":
+                return False, st
+        time.sleep(10)
+    return False, {}
+
+def collect_evidence(pr_name):
+    tmp = tempfile.mkdtemp(prefix=f"evidence-{pr_name}-")
+    try:
+        subprocess.check_call(["kubectl", "-n", TEKTON_NS, "get", "pipelinerun", pr_name, "-o", "json"], stdout=open(f"{tmp}/pipelinerun.json","w"))
+    except Exception:
+        pass
+    # collect logs for pods belonging to this run
+    pods = json.loads(subprocess.check_output(["kubectl", "-n", TEKTON_NS, "get", "pods", "-o", "json"]).decode()).get("items", [])
+    for p in pods:
+        owners = p.get("metadata", {}).get("ownerReferences", [])
+        if any(o.get("name","").startswith(pr_name) for o in owners):
+            podname = p["metadata"]["name"]
+            try:
+                logs = subprocess.check_output(["kubectl", "-n", TEKTON_NS, "logs", podname], stderr=subprocess.STDOUT).decode()
+            except Exception as e:
+                logs = f"error: {e}"
+            open(f"{tmp}/{podname}.log","w").write(logs)
+    # bundle and upload
+    bundle = f"/tmp/{pr_name}-{int(time.time())}.tar.gz"
+    subprocess.check_call(["tar","-czf", bundle, "-C", tmp, "."])
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"scale_validation/{pr_name}/{os.path.basename(bundle)}"
+        s3.upload_file(bundle, EVIDENCE_BUCKET.replace("s3://",""), key)
+        return f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key}"
+    return bundle
+
+def run_large_hpo_parallel():
+    prs=[]
+    for i in range(HPO_PARALLEL):
+        pr = trigger_pipeline("large-hpo-pipeline", {"samples": HPO_SAMPLES, "evidence_bucket": EVIDENCE_BUCKET, "team": f"stress-{i}"})
+        if pr:
+            prs.append(pr)
+    results=[]
+    for pr in prs:
+        ok, st = wait_for_pipelinerun(pr, timeout=4*3600)
+        evidence = collect_evidence(pr)
+        results.append({"pr": pr, "ok": ok, "evidence": evidence})
+    return results
+
+def run_simulator_farm():
+    pr = trigger_pipeline("long-shadow-2k-pipeline", {"sim_runs": SIM_RUNS, "evidence_bucket": EVIDENCE_BUCKET})
+    if not pr:
+        return {"ok": False}
+    ok, st = wait_for_pipelinerun(pr, timeout=6*3600)
+    ev = collect_evidence(pr)
+    return {"pr": pr, "ok": ok, "evidence": ev}
+
+def run_long_shadow_accelerated(hours=LONG_SHADOW_ACCEL_HOURS):
+    # Run an accelerated KPI sampler for `hours` and collect KPI timeseries snapshots
+    tmp = tempfile.mkdtemp(prefix="longshadow-")
+    # sample Prometheus metrics periodically for `hours` worth of accelerated sampling (step=10s)
+    prom = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+    end = time.time() + hours * 3600
+    samples=[]
+    while time.time() < end:
+        try:
+            r = subprocess.check_output(["curl","-s", f"{prom}/api/v1/query", "--data-urlencode", "query=sum(rate(business_metric[1m]))"]).decode()
+            samples.append({"ts": int(time.time()), "val": json.loads(r)})
+        except Exception:
+            samples.append({"ts": int(time.time()), "val": None})
+        time.sleep(10)
+    path = f"{tmp}/longshadow_samples.json"
+    open(path,"w").write(json.dumps(samples))
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"longshadow/{int(time.time())}.json"
+        s3.upload_file(path, EVIDENCE_BUCKET.replace("s3://",""), key)
+        return f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key}"
+    return path
+
+def main():
+    report = {"started": datetime.utcnow().isoformat(), "hpo_results": None, "sim_results": None, "longshadow": None}
+    logger.info("Starting large HPO parallel runs")
+    report["hpo_results"] = run_large_hpo_parallel()
+    logger.info("Starting simulator farm run")
+    report["sim_results"] = run_simulator_farm()
+    logger.info("Starting long-shadow accelerated run")
+    report["longshadow"] = run_long_shadow_accelerated()
+    report["finished"] = datetime.utcnow().isoformat()
+    out = "/tmp/scale_validation_report.json"
+    open(out,"w").write(json.dumps(report, indent=2))
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"scale_validation/report-{int(time.time())}.json"
+        s3.upload_file(out, EVIDENCE_BUCKET.replace("s3://",""), key)
+        logger.info("Uploaded report to s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
+    print(json.dumps(report, indent=2))
+
+if __name__ == "__main__":
+    main()
+
