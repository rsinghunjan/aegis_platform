+#!/usr/bin/env python3
+"""
+Verify OTEL end-to-end:
+ - Query Prometheus for traces/metrics with run_id within a time window
+ - Query Jaeger or OTEL collector for traces that include span attribute run_id and business_kpi
+ - Report missing instrumentation
+"""
+import os, time, requests, logging, json
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("otel-check")
+
+PROM = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+JAEGER = os.environ.get("JAEGER_QUERY", "http://jaeger-query.monitoring.svc:16686/api/traces")
+WINDOW_MIN = int(os.environ.get("WINDOW_MIN", "30"))
+
+def query_prom_run_ids():
+    q = 'label_values(run_id)'
+    r = requests.get(f"{PROM}/api/v1/label/{q.replace('label_values(','').replace(')','')}")
+    if r.status_code != 200:
+        return []
+    return r.json().get("data",[])
+
+def check_traces_for_run(run_id):
+    # Query Jaeger traces for traces that include attribute run_id
+    params = {"query": f"json.attributes.run_id:{run_id}", "limit": 20}
+    try:
+        r = requests.get(JAEGER, params=params, timeout=10)
+        if r.status_code != 200:
+            return False, "jaeger query failed"
+        traces = r.json().get("data", [])
+        for t in traces:
+            # check spans for business_kpi attribute
+            for s in t.get("spans", []):
+                attrs = s.get("tags", [])
+                for a in attrs:
+                    if a.get("key") == "business_kpi":
+                        return True, "ok"
+        return False, "no business_kpi attribute in traces"
+    except Exception as e:
+        return False, str(e)
+
+def main():
+    run_ids = query_prom_run_ids()
+    recent = run_ids[-10:]
+    report = {}
+    for rid in recent:
+        ok, msg = check_traces_for_run(rid)
+        report[rid] = {"ok": ok, "msg": msg}
+    out = "/tmp/otel_e2e_check.json"
+    open(out,"w").write(json.dumps(report, indent=2))
+    print(json.dumps(report, indent=2))
+    if os.environ.get("EVIDENCE_BUCKET"):
+        import boto3
+        s3=boto3.client("s3")
+        key=f"otel_checks/{int(time.time())}.json"
+        s3.upload_file(out, os.environ["EVIDENCE_BUCKET"].replace("s3://",""), key)
+        logger.info("Uploaded check to s3://%s/%s", os.environ["EVIDENCE_BUCKET"].replace("s3://",""), key)
+
+if __name__ == "__main__":
+    main()
+
