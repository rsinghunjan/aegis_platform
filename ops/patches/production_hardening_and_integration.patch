+EOF
+  if [ -n "$EVIDENCE_BUCKET" ]; then
+    aws s3 cp "$tmp" "s3://$EVIDENCE_BUCKET/secrets/rotations/$(basename $tmp)" || true
+    echo "Uploaded rotation evidence for $s"
+  else
+    echo "Rotation evidence (local): $tmp"
+  fi
+done
