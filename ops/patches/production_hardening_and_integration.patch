+#!/usr/bin/env python3
+"""
+Simulator farm orchestrator:
+ - Submits N simulator jobs as Kubernetes Jobs, monitors completion, aggregates outputs, and signs evidence bundle.
+ - Designed to be used in Tekton or as standalone runner.
+"""
+import os, time, json, subprocess, tempfile, logging
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+logger = logging.getLogger("sim-orchestrator")
+logging.basicConfig(level=logging.INFO)
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def submit_job(i):
+    name = f"sim-job-{int(time.time())}-{i}"
+    cmd = ["kubectl","-n","cicd","run",name,"--image=us.gcr.io/aegis/simulator:latest","--restart=Never","--","/bin/sh","-c","python /app/run_sim.py > /tmp/out.json; cat /tmp/out.json"]
+    subprocess.check_call(cmd)
+    return name
+
+def aggregate_results(jobs):
+    results = []
+    for j in jobs:
+        # Wait for pod logs to appear (PoC)
+        out = subprocess.check_output(["kubectl","-n","cicd","logs","job/"+j], stderr=subprocess.DEVNULL).decode()
+        results.append({"job": j, "out": out})
+    # upload evidence
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".json").name
+    with open(tmp,"w") as f: json.dump(results,f)
+    if boto3 and EVIDENCE_BUCKET:
+        s3 = boto3.client("s3")
+        key = f"simulator/aggregate-{int(time.time())}.json"
+        s3.upload_file(tmp, EVIDENCE_BUCKET.replace("s3://",""), key)
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    return tmp
+
+def run_scale(n=100):
+    jobs=[]
+    for i in range(n):
+        try:
+            j = submit_job(i)
+            jobs.append(j)
+        except Exception:
+            logger.exception("submit failed for %d", i)
+    # naive wait
+    time.sleep(60)
+    return aggregate_results(jobs)
+
+if __name__ == "__main__":
+    print(run_scale(int(os.environ.get("SIM_RUNS","10"))))
