+#!/usr/bin/env python3
+"""
+Explainability service (PoC) that computes SHAP values for a model artifact and stores per-inference explanations.
+ - Loads model from S3 (joblib), computes SHAP for a batch of inputs, uploads explanation JSON to EVIDENCE_BUCKET.
+ - Exposes a small API to request explanations for a model_s3 + input batch.
+"""
+from fastapi import FastAPI, HTTPException
+import os, json, tempfile, boto3, joblib
+import numpy as np
+import shap
+
+app = FastAPI()
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+S3 = boto3.client("s3") if EVIDENCE_BUCKET else None
+
+def download_model(s3uri):
+    bucket,key = s3uri.replace("s3://","").split("/",1)
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".joblib").name
+    S3.download_file(bucket, key, tmp)
+    return tmp
+
+@app.post("/explain")
+def explain(payload: dict):
+    model_s3 = payload.get("model_s3"); inputs = payload.get("inputs")
+    if not model_s3 or not inputs:
+        raise HTTPException(status_code=400, detail="model_s3 and inputs required")
+    model_path = download_model(model_s3)
+    model = joblib.load(model_path)
+    import pandas as pd
+    X = pd.DataFrame(inputs)
+    explainer = shap.Explainer(model.predict, X)
+    shap_values = explainer(X)
+    out = {"shap": shap_values.values.tolist(), "base_values": shap_values.base_values.tolist()}
+    # upload
+    if S3:
+        key = f"explainability/{int(time.time())}.json"
+        S3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(out).encode())
+        return {"s3": f"s3://{EVIDENCE_BUCKET}/{key}"}
+    return out
