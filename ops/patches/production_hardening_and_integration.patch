+  echo "Rotating $s"
+  # Simple PoC: put a versioned value
+  aws secretsmanager put-secret-value --secret-id "$s" --secret-string "{\"rotated_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" || true
+  # wait for ExternalSecrets to sync, then record evidence
+  sleep 10
+  # evidence file
+  tmp="/tmp/rotation-$(basename $s)-$(date -u +%Y%m%dT%H%M%SZ).json"
+  cat > "$tmp" <<EOF
