+#!/usr/bin/env python3
+"""
+Labeling ingest service:
+ - Receives a request (webhook or Tekton) that labels are exported to S3
+ - Validates the exported file, converts to Parquet and writes to dataset area
+ - Triggers the retrain pipeline (Tekton) with the new dataset snapshot as param
+"""
+from fastapi import FastAPI, Request, HTTPException
+import os, boto3, tempfile, subprocess, json
+import pandas as pd
+import logging
+
+app = FastAPI()
+logger = logging.getLogger("labeling-ingest")
+logging.basicConfig(level=logging.INFO)
+
+S3 = boto3.client("s3")
+DATASET_PREFIX = os.environ.get("DATASET_PREFIX", "s3://aegis-data/datasets/")
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+RETRAIN_PIPELINE = os.environ.get("RETRAIN_PIPELINE", "drift-retrain-canary-pipeline")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def upload_evidence(prefix, payload):
+    if not EVIDENCE_BUCKET:
+        p = f"/tmp/{prefix.replace('/','_')}-{int(time.time())}.json"
+        with open(p,"w") as f: json.dump(payload,f,indent=2)
+        return p
+    key = f"labeling/evidence/{int(time.time())}.json"
+    S3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(payload).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+@app.post("/ingest")
+async def ingest(req: Request):
+    body = await req.json()
+    export_s3 = body.get("export_s3")
+    if not export_s3:
+        raise HTTPException(status_code=400, detail="export_s3 required")
+    bucket,key = export_s3.replace("s3://","").split("/",1)
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".json").name
+    S3.download_file(bucket, key, tmp)
+    # convert JSON to Parquet
+    df = pd.read_json(tmp)
+    pq = tmp + ".parquet"
+    df.to_parquet(pq, index=False)
+    # upload to datasets area with timestamped path
+    ds_bucket, ds_prefix = DATASET_PREFIX.replace("s3://","").split("/",1)
+    target_key = f"{ds_prefix}/labeled/{int(time.time())}.parquet"
+    S3.upload_file(pq, ds_bucket, target_key)
+    ds_uri = f"s3://{ds_bucket}/{target_key}"
+    upload_evidence("labeling/ingest", {"export_s3": export_s3, "dataset_uri": ds_uri})
+    # trigger retrain pipeline
+    pr = {
+      "apiVersion": "tekton.dev/v1beta1",
+      "kind": "PipelineRun",
+      "metadata": {"generateName": "labeling-trigger-run-"},
+      "spec": {"pipelineRef": {"name": RETRAIN_PIPELINE},
+               "params":[{"name":"dataset_snapshot_s3","value": ds_uri}, {"name":"evidence_bucket","value": EVIDENCE_BUCKET}]}
+    }
+    import yaml, tempfile
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.dump(pr).encode()); f.close()
+    subprocess.check_call(["kubectl","apply","-n",TEKTON_NS,"-f",f.name])
+    return {"ok":True, "dataset": ds_uri}
+
