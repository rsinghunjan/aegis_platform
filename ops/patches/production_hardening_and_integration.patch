+#!/usr/bin/env bash
+#
+# Script to iterate Keycloak clients and enforce reduced token lifespans and removal of direct access grants
+KEYCLOAK_URL=${KEYCLOAK_URL:-http://keycloak.monitoring.svc:8080}
+REALM=${REALM:-aegis}
+ADMIN_USER=${ADMIN_USER:-admin}
+ADMIN_PASS=${ADMIN_PASS:-changeme}
+
+TOKEN=$(curl -s -X POST "$KEYCLOAK_URL/realms/master/protocol/openid-connect/token" -d "grant_type=password&client_id=admin-cli&username=$ADMIN_USER&password=$ADMIN_PASS" | jq -r .access_token)
+CLIENTS=$(curl -s -H "Authorization: Bearer $TOKEN" "$KEYCLOAK_URL/admin/realms/$REALM/clients")
+for c in $(echo "$CLIENTS" | jq -r '.[].id'); do
+  echo "Patching client $c"
+  curl -s -X GET -H "Authorization: Bearer $TOKEN" "$KEYCLOAK_URL/admin/realms/$REALM/clients/$c" -o /tmp/client.json
+  jq '. + {"attributes": {"access.token.lifespan":"300"} }' /tmp/client.json > /tmp/client2.json
+  curl -s -X PUT -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" --data @/tmp/client2.json "$KEYCLOAK_URL/admin/realms/$REALM/clients/$c"
+done
+echo "Client token lifespans updated (PoC). Review clients manually."
+
