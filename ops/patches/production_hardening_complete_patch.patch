+"""
+Calibration script to compute safety thresholds based on labeled domain dataset.
+Input: JSONL with {"text": "...", "toxicity_label": 0/1, "pii_label": 0/1}
+Outputs: thresholds.json with recommended thresholds.
+"""
+import json, argparse, numpy as np
+from detoxify import Detoxify
+
+def calibrate(input_path, out_path):
+    detox = Detoxify('original')
+    toks = []
+    labels = []
+    pii_labels = []
+    with open(input_path) as f:
+        for line in f:
+            j = json.loads(line)
+            toks.append(j["text"])
+            labels.append(int(j.get("toxicity_label", 0)))
+            pii_labels.append(int(j.get("pii_label", 0)))
+    scores = [detox.predict(t)["toxicity"] for t in toks]
+    # simple threshold: choose score that maximizes F1 on labels
+    best = 0.0
+    best_th = 0.5
+    for th in np.linspace(0.1,0.9,41):
+        preds = [1 if s>th else 0 for s in scores]
+        tp = sum(1 for p,l in zip(preds,labels) if p==1 and l==1)
+        fp = sum(1 for p,l in zip(preds,labels) if p==1 and l==0)
+        fn = sum(1 for p,l in zip(preds,labels) if p==0 and l==1)
+        prec = tp/(tp+fp+1e-9)
+        rec = tp/(tp+fn+1e-9)
+        f1 = 2*prec*rec/(prec+rec+1e-9)
+        if f1 > best:
+            best = f1; best_th = th
+    # pii thresholding simple: majority preference (if more than 50% labeled pii, set flag)
+    pii_recommend = 1 if sum(pii_labels) > len(pii_labels)/2 else 0
+    out = {"toxicity": float(best_th), "pii": bool(pii_recommend)}
+    with open(out_path, "w") as f:
+        json.dump(out, f, indent=2)
+    print("Wrote thresholds to", out_path)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--in", dest="inp", required=True)
+    p.add_argument("--out", dest="out", default="/etc/safety/thresholds.json")
+    args = p.parse_args()
+    calibrate(args.inp, args.out)
+
