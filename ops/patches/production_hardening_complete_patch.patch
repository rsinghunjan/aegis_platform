+"""
+Embedding drift detector:
+ - Periodically computes embedding distribution distance between baseline and live samples
+ - If drift exceeds configured threshold triggers an alert (writes a Prometheus metric push or calls alert API)
+ - Also writes a drift event to evidence store (append-only)
+"""
+import os, time, json, numpy as np
+from sentence_transformers import SentenceTransformer
+from scipy.stats import wasserstein_distance
+from services.evidence_store.s3_append_only import append_evidence
+
+MODEL = SentenceTransformer("all-MiniLM-L6-v2")
+BASELINE_EMBEDS_PATH = os.environ.get("BASELINE_EMBED_PATH", "/data/baseline_embs.npy")
+LIVE_SAMPLE_SOURCE = os.environ.get("LIVE_SAMPLE_SOURCE", "/data/live_samples.txt")
+DRIFT_THRESHOLD = float(os.environ.get("DRIFT_THRESHOLD", "0.4"))
+
+def load_baseline():
+    if os.path.exists(BASELINE_EMBEDS_PATH):
+        return np.load(BASELINE_EMBEDS_PATH)
+    return None
+
+def sample_live_embeddings():
+    if not os.path.exists(LIVE_SAMPLE_SOURCE):
+        return None
+    texts = [l.strip() for l in open(LIVE_SAMPLE_SOURCE) if l.strip()]
+    if not texts:
+        return None
+    emb = MODEL.encode(texts, convert_to_numpy=True)
+    return emb
+
+def compute_drift(baseline, live):
+    # compute per-dimension wasserstein distances and average
+    dists = [wasserstein_distance(baseline[:,i], live[:,i]) for i in range(min(baseline.shape[1], live.shape[1]))]
+    return float(np.mean(dists))
+
+def main():
+    baseline = load_baseline()
+    if baseline is None:
+        print("No baseline embeddings; aborting")
+        return
+    live = sample_live_embeddings()
+    if live is None:
+        print("No live samples; aborting")
+        return
+    score = compute_drift(baseline, live)
+    rec = {"ts": time.time(), "drift_score": score}
+    append_evidence({"type":"drift_event", "payload": rec})
+    print("drift score:", score)
+    if score > DRIFT_THRESHOLD:
+        # push a Prometheus metric via pushgateway or call alert endpoint; placeholder prints
+        print("DRIFT EXCEEDED threshold; consider auto-fallback")
+        # Optionally trigger auto-fallback logic (not implemented here)
+
+if __name__=="__main__":
+    main()
+
