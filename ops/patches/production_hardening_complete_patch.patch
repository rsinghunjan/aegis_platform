+
+app = Flask(__name__)
+
+def append_evidence(rec):
+    os.makedirs(os.path.dirname(EVIDENCE_PATH), exist_ok=True)
+    with open(EVIDENCE_PATH, "a") as f:
+        f.write(json.dumps(rec) + "\n")
+
+@app.route("/health")
+def health():
