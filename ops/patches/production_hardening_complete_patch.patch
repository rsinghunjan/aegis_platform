+        return jsonify(json.load(open(PCR_POLICY_PATH)))
+    return jsonify({"error": "policy-not-found"}), 404
+
+@app.route("/verify_tpm", methods=["POST"])
+def verify_tpm():
+    body = request.json or {}
+    quote = body.get("quote")
+    signature = body.get("signature")
