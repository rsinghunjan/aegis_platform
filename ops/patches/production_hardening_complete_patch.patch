+"""
+import os, re, json
+from fastapi import FastAPI
+from pydantic import BaseModel
+import numpy as np
+
+try:
+    from detoxify import Detoxify
+    detox = Detoxify('original')
+except Exception:
+    detox = None
+
+from transformers import pipeline
+tox_pipeline = pipeline("text-classification", model=os.environ.get("TOX_MODEL","unitary/unbiased-toxic-roberta"))
+
+import spacy
+try:
+    nlp = spacy.load("en_core_web_sm")
+except Exception:
+    nlp = spacy.blank("en")
+
+from services.safety.detectors.factuality_verifier import Retriever, verify_factuality
+
+APPROVAL_THRESHOLDS_PATH = os.environ.get("SAFETY_THRESHOLDS_PATH", "/etc/safety/thresholds.json")
+
+app = FastAPI()
+
+class CheckReq(BaseModel):
+    text: str
+    context: str = None
+    user: str = None
+
+def load_thresholds():
+    if os.path.exists(APPROVAL_THRESHOLDS_PATH):
+        return json.load(open(APPROVAL_THRESHOLDS_PATH))
+    return {"toxicity": 0.5, "pii": True, "factuality_min": 0.2}
+
+def detect_pii(text):
+    ssn = re.search(r"\b\d{3}-\d{2}-\d{4}\b", text)
+    cc = re.search(r"\b(?:\d[ -]*?){13,16}\b", text)
+    ents = [ent for ent in nlp(text).ents if ent.label_ in ("PERSON","GPE","ORG")]
+    return bool(ssn or cc or len(ents)>0)
+
+@app.post("/health")
+def health():
+    return {"ok": True}
+
+@app.post("/check")
+def check(req: CheckReq):
+    t = req.text
+    thresholds = load_thresholds()
+    verdict = "allow"
+    reasons = []
+    # toxicity
+    tox_score = None
+    if detox:
+        scores = detox.predict(t)
+        tox_score = scores.get("toxicity", 0.0)
+    else:
+        res = tox_pipeline(t, truncation=True)
+        # map label to toxicity score heuristic
+        tox_score = float(res[0].get("score", 0.0))
+    if tox_score is not None and tox_score > thresholds["toxicity"]:
+        verdict = "block"
+        reasons.append("toxicity")
+    # pii
+    pii = detect_pii(t)
+    if pii and thresholds.get("pii", True):
+        verdict = "block"
+        reasons.append("pii")
+    # factuality
+    # load retriever with domain corpus path if present
+    retriever = None
+    corpus_path = os.environ.get("FACTUAL_CORPUS")
+    if corpus_path and os.path.exists(corpus_path):
+        corpus = [l.strip() for l in open(corpus_path) if l.strip()]
+        retriever = Retriever(corpus)
+        fact = verify_factuality(t, retriever)
+        if fact["max_score"] < thresholds.get("factuality_min", 0.2):
+            # suspicious: low evidence
+            if verdict != "block":
+                verdict = "review"
+            reasons.append("low_factuality")
+    out = {"verdict": verdict, "toxicity_score": tox_score, "pii": pii, "reasons": reasons}
