+#!/usr/bin/env python3
+"""
+HIL test case runner for Vendor_X — staged non-destructive tests
+Stages:
+  A: sensors only (no actuators)
+  B: limited actuation (reduced velocity)
+  C: nominal actuation under supervision
+"""
+import time
+import os
+import requests
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+HIL_ENDPOINT = os.environ.get("HIL_ENDPOINT", "http://localhost:9000")
+ESTOP_API = os.environ.get("HIL_ESTOP_API", "http://localhost:9001/trigger")
+
+def upload_trace(trace, key):
+    if not EVIDENCE_BUCKET:
+        return
+    import boto3, tempfile, json
+    s3=boto3.client("s3")
+    tmp=tempfile.mktemp(suffix=".json")
+    json.dump(trace, open(tmp,"w"))
+    s3.upload_file(tmp, EVIDENCE_BUCKET.replace("s3://",""), key)
+    print("Uploaded trace", key)
+
+def stage_a():
+    print("Stage A: sensors only")
+    # Query sensor topics via HIL endpoint (PoC)
+    r = requests.get(HIL_ENDPOINT + "/sensors")
+    trace = {"stage":"A", "sensors": r.json() if r.status_code==200 else {}}
+    upload_trace(trace, "hil/traces/stageA-{}.json".format(int(time.time())))
+
+def stage_b():
+    print("Stage B: limited actuation")
+    # Send a limited actuation command
+    r = requests.post(HIL_ENDPOINT + "/actuate", json={"mode":"limited","duration":1})
+    trace={"stage":"B","resp": r.json() if r.status_code==200 else {}}
+    upload_trace(trace, "hil/traces/stageB-{}.json".format(int(time.time())))
+
+def stage_c():
+    print("Stage C: nominal actuation under supervision")
+    r = requests.post(HIL_ENDPOINT + "/actuate", json={"mode":"nominal","duration":1})
+    trace={"stage":"C","resp": r.json() if r.status_code==200 else {}}
+    upload_trace(trace, "hil/traces/stageC-{}.json".format(int(time.time())))
+
+if __name__ == "__main__":
+    stage_a()
+    input("Verify sensor outputs OK and press Enter to continue to Stage B (or Ctrl-C to abort)")
+    stage_b()
+    input("Verify limited motion OK and press Enter to continue to Stage C")
+    stage_c()
+    print("HIL run completed (PoC). Ensure E-STOP was available throughout.")
+
