+#!/usr/bin/env python3
+"""
+Production-oriented minimal serving example using HuggingFace + accelerate (device_map="auto").
+This is an integration example for small/public models; for large LLMs use DeepSpeed inference or optimized runtimes.
+"""
+import os
+import json
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+MODEL_NAME = os.environ.get("MODEL_NAME", "distilgpt2")
+TOKENIZER = None
+MODEL = None
+
+def init_model():
+    global MODEL, TOKENIZER
+    try:
+        from transformers import AutoTokenizer, AutoModelForCausalLM
+        import torch
+    except Exception:
+        raise RuntimeError("transformers and torch required")
+    TOKENIZER = AutoTokenizer.from_pretrained(MODEL_NAME)
+    MODEL = AutoModelForCausalLM.from_pretrained(MODEL_NAME, device_map="auto")
+
+class Handler(BaseHTTPRequestHandler):
+    def _json(self, body, code=200):
+        self.send_response(code)
+        self.send_header("Content-Type", "application/json")
+        self.end_headers()
+        self.wfile.write(json.dumps(body).encode())
+
+    def do_POST(self):
+        if self.path == "/v1/infer":
+            length = int(self.headers.get('content-length',0))
+            data = self.rfile.read(length) if length else b"{}"
+            inp = json.loads(data.decode())
+            prompt = inp.get("prompt","")
+            max_len = int(inp.get("max_new_tokens", 32))
+            inputs = TOKENIZER(prompt, return_tensors="pt").to(MODEL.device)
+            out = MODEL.generate(**inputs, max_new_tokens=max_len)
+            text = TOKENIZER.decode(out[0], skip_special_tokens=True)
+            self._json({"output": text})
+        else:
+            self._json({"error":"not found"}, 404)
+
+if __name__ == "__main__":
+    init_model()
+    port = int(os.environ.get("PORT", 8080))
+    srv = HTTPServer(("0.0.0.0", port), Handler)
+    print("Prod serve listening on", port)
+    srv.serve_forever()
+
