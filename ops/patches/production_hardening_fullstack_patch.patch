+"""
+RL Sandbox & Safe Agent skeleton for cost-quality tradeoffs.
+ - Runs in a sandbox environment with a simulated traffic generator and reward function
+ - Produces suggested policy actions but requires human approval before any cluster change
+ - Provides a REST API to view candidate actions and training metrics
+"""
+import os
+import time
+import json
+import random
+import threading
+from typing import Dict, Any
+from fastapi import FastAPI
+
+app = FastAPI(title="RL Agent Sandbox")
+
+# Simple in-memory policy store
+POLICY_CANDIDATES = []
+
+def simulate_env_step(action: Dict[str,Any]) -> float:
+    # Simulate reward: positive for lower cost and maintained quality, negative for safety violations
+    cost_saved = action.get("cost_saving", 0.0)
+    quality_impact = action.get("quality_delta", 0.0)
+    safety_penalty = action.get("safety_risk", 0.0)
+    reward = cost_saving*10.0 + quality_impact*100.0 - safety_penalty*1000.0
+    return reward
+
+def propose_candidate():
+    # Random policy perturbation example
+    c = {"id": f"cand_{int(time.time())}_{random.randint(0,999)}", "action":{"switch_to_student_pct": random.choice([10,20,30,50])}, "meta":{}}
+    # simulate reward
+    r = simulate_env_step({"cost_saving": c["action"]["switch_to_student_pct"]/100.0, "quality_delta": -0.01, "safety_risk": 0.0})
+    c["est_reward"] = r
+    POLICY_CANDIDATES.append(c)
+
+@app.on_event("startup")
+def start_worker():
+    def loop():
+        while True:
+            propose_candidate()
+            time.sleep(60)
+    t = threading.Thread(target=loop, daemon=True)
+    t.start()
+
+@app.get("/candidates")
+def list_candidates():
+    return POLICY_CANDIDATES[-20:]
+
+@app.post("/apply")
+def apply_candidate(candidate_id: str, approver: str):
+    # In sandbox only: record approval request and emit manual approval external ticket
+    for c in POLICY_CANDIDATES:
+        if c["id"] == candidate_id:
+            # write to manual approval service and log
+            try:
+                import requests
+                requests.post(os.environ.get("MANUAL_APPROVAL_URL","http://manual-approval:8080/request"), json={"request_id": candidate_id, "user": approver, "reason":"rl_suggested"})
+            except Exception:
+                pass
+            return {"status":"requested_approval","candidate":c}
+    return {"status":"not_found"}
+
