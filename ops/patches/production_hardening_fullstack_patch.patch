+"""
+Wattmeter integration & calibrated estimator
+ - Periodically consumes synchronized wattmeter CSVs and node telemetry to compute calibration
+ - Publishes calibration JSON used by telemetry estimator and writes Prometheus-exportable calibration metrics
+"""
+import os, time, json
+from prometheus_client import Gauge, start_http_server
+import numpy as np
+
+CALIBRATION_OUT = os.environ.get("WATT_CALIB_OUT", "/data/telemetry_calibration.json")
+CSV_PATH = os.environ.get("WATT_CSV_PATH", "/data/wattmeter.csv")
+MET_PORT = int(os.environ.get("WATT_MET_PORT","9470"))
+
+G_SCALE = Gauge("aegis_telemetry_scale", "Telemetry calibration scale")
+G_OFFSET = Gauge("aegis_telemetry_offset", "Telemetry calibration offset")
+
+def calibrate_from_csv(csv_path):
+    ts=[]; watts=[]
+    for l in open(csv_path):
+        if not l.strip(): continue
+        t,w = l.strip().split(",")
+        ts.append(float(t)); watts.append(float(w))
+    ts=np.array(ts); watts=np.array(watts)
+    # Example: naive fit against NVML mean exposure sampled previously at matching timestamps (operator must produce matching telemetry)
+    # Here we provide a simple linear fit between telemetry_estimate and wattmeter ground truth
+    telemetry_samples = np.linspace(1.0,2.0,len(watts)) # placeholder
+    A = np.vstack([telemetry_samples, np.ones(len(watts))]).T
+    a,b = np.linalg.lstsq(A, watts, rcond=None)[0]
+    cfg = {"scale": float(a), "offset": float(b)}
+    with open(CALIBRATION_OUT,"w") as f:
+        json.dump(cfg,f,indent=2)
+    G_SCALE.set(cfg["scale"]); G_OFFSET.set(cfg["offset"])
+    return cfg
+
+if __name__=="__main__":
+    start_http_server(MET_PORT)
+    while True:
+        if os.path.exists(CSV_PATH):
+            try:
+                cfg=calibrate_from_csv(CSV_PATH)
+                print("Wattmeter calibration saved", cfg)
+            except Exception as e:
+                print("calibration error", e)
+        time.sleep(600)
+
