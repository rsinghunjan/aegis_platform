+#!/usr/bin/env python3
+"""
+Calibrate verifier thresholds and produce a signed calibration artifact.
+ - Loads predictions and labels from validation samples, computes precision/recall/F1 at multiple thresholds
+ - Writes thresholds.json with recommended threshold for 'support' label at desired precision target
+ - Registers calibration artifact in metadata service
+"""
+import argparse, json, numpy as np, os
+from sklearn.metrics import precision_recall_fscore_support
+from services.metadata.metadata_service import register_artifact
+
+def calibrate(preds_path, labels_path, out_dir, precision_target=0.9):
+    os.makedirs(out_dir, exist_ok=True)
+    preds = [json.loads(l) for l in open(preds_path)]
+    labs = [json.loads(l) for l in open(labels_path)]
+    scores = [p.get("best",{}).get("score",0.0) for p in preds]
+    y_true = [1 if l.get("label")=="support" else 0 for l in labs]
+    thresholds = list(np.linspace(0.0,1.0,101))
+    best = {"threshold":0.5,"precision":0.0,"recall":0.0,"f1":0.0}
+    for t in thresholds:
+        y_pred = [1 if s>=t else 0 for s in scores]
+        p,r,f,_ = precision_recall_fscore_support(y_true,y_pred,average='binary',zero_division=0)
+        if p >= precision_target and f > best["f1"]:
+            best = {"threshold":t,"precision":p,"recall":r,"f1":f}
+    with open(os.path.join(out_dir,"thresholds.json"),"w") as f:
+        json.dump(best,f,indent=2)
+    register_artifact({"id": f"verifier_calib_{int(os.time())}", "type":"calibration", "path": os.path.join(out_dir,"thresholds.json"), "meta": best})
+    print("Calibration written:", best)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--preds", required=True)
+    p.add_argument("--labels", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--precision", type=float, default=0.9)
+    args=p.parse_args()
+    calibrate(args.preds, args.labels, args.out, args.precision)
+
