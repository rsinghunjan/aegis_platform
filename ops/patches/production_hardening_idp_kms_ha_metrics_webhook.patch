+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Orchestrate 2k dry-run acceptance and start a long-shadow campaign (30+ days recommended).
+# Usage:
+#   EVIDENCE_BUCKET=... ./ops/scripts/run_2k_dryruns_and_start_longshadow.sh --days 30
+
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+if [ -z "$EVIDENCE_BUCKET" ]; then
+  echo "EVIDENCE_BUCKET required"
+  exit 2
+fi
+
+DAYS=30
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --days) DAYS="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+echo "1) Run 2000 dry-run planner acceptance tests"
+DRYRUN_SCRIPT=services/agent/long_dryrun_runner.py
+if [ -f "$DRYRUN_SCRIPT" ]; then
+  python "$DRYRUN_SCRIPT" --iterations 2000 --evidence-bucket "$EVIDENCE_BUCKET" || echo "Dryrun script returned non-zero; inspect logs"
+else
+  echo "Dryrun runner not found at $DRYRUN_SCRIPT; run your custom harness"
+fi
+
+echo "2) Start long-shadow campaign for $DAYS days"
+./ops/scripts/run_long_shadow_campaign.sh --days "$DAYS" --sample-rate 0.01 || echo "Long-shadow start attempted"
+
+echo "3) Periodically collect SME signoffs (operator manual step)"
+echo "Use ops/scripts/collect_sme_signoff.sh to upload signoffs to the evidence bucket."
+
+echo "Orchestration complete. Monitor long-shadow supervisor and evidence bucket daily."
