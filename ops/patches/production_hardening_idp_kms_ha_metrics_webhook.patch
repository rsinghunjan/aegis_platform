+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Rotate cosign key:
+# - generate new key
+# - encrypt with KMS and store in AWS Secrets Manager
+# - (optional) patch deployments to reload secret (restart pods)
+#
+NEW_KEY=${1:-./cosign.key}
+SM_SECRET_NAME=${2:-staging/aegis/cosign-key}
+KMS_KEY_ALIAS=${3:-alias/aegis-evidence}
+
+if ! command -v cosign >/dev/null 2>&1; then
+  echo "cosign CLI required"
+  exit 2
+fi
+if ! command -v aws >/dev/null 2>&1; then
+  echo "aws CLI required"
+  exit 2
+fi
+
+echo "Generating new cosign key..."
+cosign generate-key-pair --key "$NEW_KEY" || true
+
+echo "Encrypting key with KMS and storing in Secrets Manager..."
+ENCRYPTED=$(aws kms encrypt --key-id "$KMS_KEY_ALIAS" --plaintext "fileb://$NEW_KEY" --query CiphertextBlob --output text)
+# store base64 as secret string for simplicity
+aws secretsmanager create-secret --name "$SM_SECRET_NAME" --secret-string "{\"cosign_key_b64\":\"$ENCRYPTED\"}" || \
+  aws secretsmanager put-secret-value --secret-id "$SM_SECRET_NAME" --secret-string "{\"cosign_key_b64\":\"$ENCRYPTED\"}"
+
+echo "Cosign key rotated and stored in Secrets Manager as $SM_SECRET_NAME. Update deployments to fetch and use new key (restart required)."
+
