+#!/usr/bin/env python3
+"""
+Keycloak → Kubernetes RBAC sync helper (scaffold)
+
+- Fetches Keycloak groups/roles and creates a ConfigMap mapping roles -> allowed actions for wrappers and services.
+- Intended as a periodic job or manual operator task to keep agent-rbac ConfigMap in sync with Keycloak decisions.
+
+Configure via environment:
+ - KEYCLOAK_URL, KEYCLOAK_REALM, KEYCLOAK_CLIENT_ID, KEYCLOAK_CLIENT_SECRET
+ - K8S_NAMESPACE (default `monitoring`)
+"""
+import os, json, time, logging
+import requests
+from kubernetes import client, config
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("keycloak-rbac-sync")
+
+KEYCLOAK_URL = os.environ.get("KEYCLOAK_URL", "http://keycloak.monitoring.svc:8080")
+KEYCLOAK_REALM = os.environ.get("KEYCLOAK_REALM", "aegis")
+CLIENT_ID = os.environ.get("KEYCLOAK_CLIENT_ID", "")
+CLIENT_SECRET = os.environ.get("KEYCLOAK_CLIENT_SECRET", "")
+K8S_NS = os.environ.get("K8S_NAMESPACE", "monitoring")
+CM_NAME = os.environ.get("RBAC_CM_NAME", "agent-rbac")
+
+def get_token():
+    try:
+        r = requests.post(f"{KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}/protocol/openid-connect/token",
+                          data={"grant_type":"client_credentials","client_id":CLIENT_ID,"client_secret":CLIENT_SECRET}, timeout=10)
+        r.raise_for_status()
+        return r.json()["access_token"]
+    except Exception as e:
+        logger.error("Failed to get keycloak token: %s", e)
+        return None
+
+def fetch_roles(token):
+    url = f"{KEYCLOAK_URL}/admin/realms/{KEYCLOAK_REALM}/roles"
+    r = requests.get(url, headers={"Authorization":f"Bearer {token}"}, timeout=10)
+    r.raise_for_status()
+    return r.json()
+
+def build_rbac_map(roles):
+    # Scaffold: create a mapping where each role has allowed wrapper actions
+    # In practice map roles → actions via admin UI or a declarative mapping
+    rmap = {}
+    for r in roles:
+        name = r.get("name")
+        if name.startswith("platform-admin"):
+            rmap[name] = {"allowed":["*"]}
+        elif name.startswith("dev"):
+            rmap[name] = {"allowed":["wrapper:*","promote:*"]}
+        else:
+            rmap[name] = {"allowed":["wrapper:read"]}
+    return rmap
+
+def apply_configmap(rmap):
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    v1 = client.CoreV1Api()
+    data = {"rbac.json": json.dumps(rmap)}
+    body = client.V1ConfigMap(metadata=client.V1ObjectMeta(name=CM_NAME, namespace=K8S_NS), data=data)
+    try:
+        v1.patch_namespaced_config_map(CM_NAME, K8S_NS, body)
+        logger.info("Patched existing ConfigMap %s", CM_NAME)
+    except client.exceptions.ApiException:
+        v1.create_namespaced_config_map(K8S_NS, body)
+        logger.info("Created ConfigMap %s", CM_NAME)
+
+def main():
+    token = get_token()
+    if not token:
+        logger.error("No token, abort")
+        return
+    roles = fetch_roles(token)
+    rmap = build_rbac_map(roles)
+    apply_configmap(rmap)
+    logger.info("RBAC sync complete.")
+
+if __name__ == "__main__":
+    main()
+
