+#!/usr/bin/env python3
+"""
+Mutating admission webhook to integrate with Carbon Optimizer for Tekton PipelineRuns (PoC).
+
+ - Receives AdmissionReview for PipelineRun creation
+ - Extracts aegis.model_name, aegis.job_id, aegis.latency_sla_ms annotations
+ - Calls optimizer service and returns JSONPatch to add annotation 'aegis.placement'
+
+Notes:
+ - This is a PoC. A production webhook must validate requests, use TLS certs and proper admission responses.
+"""
+import os, json, logging
+from flask import Flask, request, jsonify
+import requests
+
+APP = Flask(__name__)
+OPT_URL = os.environ.get("OPTIMIZER_URL", "http://carbon-optimizer.monitoring.svc:8082/optimize")
+logging.basicConfig(level=logging.INFO)
+
+def make_patch(choice):
+    # JSON Patch to add annotation to metadata.annotations.aegis.placement
+    patch = [
+        {"op":"add","path":"/metadata/annotations/aegis.placement","value":choice}
+    ]
+    return patch
+
+@APP.route("/mutate", methods=["POST"])
+def mutate():
+    review = request.get_json()
+    try:
+        req = review["request"]
+        obj = req["object"]
+        annotations = obj.get("metadata", {}).get("annotations", {})
+        model = annotations.get("aegis.model_name")
+        jobid = annotations.get("aegis.job_id")
+        sla = int(annotations.get("aegis.latency_sla_ms","200"))
+        if not model:
+            # allow create, no mutation
+            response = {"response":{"uid":req.get("uid"), "allowed": True}}
+            return jsonify(response)
+        payload = {"job_id":jobid or "auto-"+str(int(time.time())), "model_name":model, "latency_sla_ms":sla, "candidates":{"us-east":"http://us","eu-west":"http://eu"}}
+        r = requests.post(OPT_URL, json=payload, timeout=5)
+        r.raise_for_status()
+        choice = r.json().get("choice")
+        patch = make_patch(choice)
+        resp = {"response":{"uid": req.get("uid"), "allowed": True, "patchType":"JSONPatch", "patch": (json.dumps(patch)).encode("utf-8").decode("utf-8")}}
+        return jsonify(resp)
+    except Exception as e:
+        logging.exception("mutate error")
+        return jsonify({"response":{"uid": req.get("uid"), "allowed": True}})
+
+if __name__=="__main__":
+    APP.run(host="0.0.0.0", port=int(os.environ.get("PORT",8088)))
+
