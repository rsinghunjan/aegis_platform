+"""
+Admission-like enforcement helper: validate that job creators include required annotations/labels.
+This helper can be used by CI pre-commit hooks, job templaters, and local dev tooling to ensure
+that any Pod/Job/TaskRun has aegis.job_id and aegis.model_name set as annotations or labels.
+
+Example usage:
+  python services/common/require_job_labels.py <yaml-file>
+"""
+import sys
+import yaml
+
+REQ_ANNOTATIONS = ["aegis.job_id", "aegis.model_name"]
+
+def check_doc(doc):
+    meta = doc.get("metadata", {})
+    ann = meta.get("annotations", {})
+    missing = [k for k in REQ_ANNOTATIONS if k not in ann]
+    return missing
+
+def main():
+    if len(sys.argv) < 2:
+        print("Usage: require_job_labels.py <k8s-yaml-file>")
+        sys.exit(2)
+    with open(sys.argv[1]) as f:
+        objs = list(yaml.safe_load_all(f))
+    ok = True
+    for o in objs:
+        missing = check_doc(o)
+        if missing:
+            print("Resource", o.get("metadata",{}).get("name"), "missing annotations:", missing)
+            ok = False
+    sys.exit(0 if ok else 1)
+
+if __name__ == "__main__":
+    main()
+
