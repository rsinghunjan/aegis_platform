+#!/usr/bin/env python3
+"""
+Batch SHAP computation and standardized storage:
+ - Loads model artifact, computes SHAP for a batch of inputs, stores per-inference explanation in explainability store
+ - Writes index manifest to evidence bucket for later retrieval
+"""
+import os, json, tempfile, logging
+import joblib
+import pandas as pd
+import shap
+import boto3
+
+logger = logging.getLogger("shap-batch")
+logging.basicConfig(level=logging.INFO)
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+s3 = boto3.client("s3") if EVIDENCE_BUCKET else None
+
+def compute_and_store(model_s3, inputs_df, model_id="model"):
+    # download model
+    bucket,key = model_s3.replace("s3://","").split("/",1)
+    tmp_model = tempfile.NamedTemporaryFile(delete=False, suffix=".joblib").name
+    s3.download_file(bucket, key, tmp_model)
+    model = joblib.load(tmp_model)
+    explainer = shap.Explainer(model.predict, inputs_df)
+    shap_vals = explainer(inputs_df)
+    records = []
+    for i, row in inputs_df.iterrows():
+        rec = {"index": int(i), "shap": shap_vals.values[i].tolist(), "base": shap_vals.base_values[i].tolist()}
+        records.append(rec)
+        # store each explanation as separate object
+        if s3:
+            s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=f"explainability/{model_id}/inst-{i}.json", Body=json.dumps(rec).encode())
+    # write manifest
+    manifest = {"model": model_id, "count": len(records), "ts": int(time.time())}
+    if s3:
+        s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=f"explainability/{model_id}/manifest-{int(time.time())}.json", Body=json.dumps(manifest).encode())
+    return manifest
+
