+#!/usr/bin/env python3
+"""
+Auto-Promoter service
+ - Receives canary evaluation payloads (JSON) from canary controller or Tekton
+ - Calls OPA (or local Rego) to decide if auto-promotion is allowed
+ - If allowed, triggers promotion pipeline; otherwise, requests SME approval via approval service
+ - Uploads audit/evidence and links approver identity to evidence
+"""
+import os
+import json
+import logging
+import subprocess
+import tempfile
+from datetime import datetime
+from urllib.parse import urljoin
+
+import requests
+
+logger = logging.getLogger("auto-promoter")
+logging.basicConfig(level=logging.INFO)
+
+OPA_URL = os.environ.get("OPA_URL", "http://opa:8181/v1/data/aegis/autopromote/allow")
+APPROVAL_SERVICE = os.environ.get("APPROVAL_SERVICE_URL", "http://approval-service.monitoring.svc:8080")
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+PROMOTE_PIPELINE = os.environ.get("PROMOTE_PIPELINE", "promote-model-to-baseten")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def upload_evidence(run_id, payload):
+    if not EVIDENCE_BUCKET:
+        p = f"/tmp/{run_id}-evidence.json"
+        with open(p, "w") as f:
+            json.dump(payload, f, indent=2)
+        return p
+    import boto3
+    s3 = boto3.client("s3")
+    key = f"autopromote/{run_id}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(payload).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+def opa_evaluate(payload):
+    try:
+        r = requests.post(OPA_URL, json={"input": payload}, timeout=10)
+        r.raise_for_status()
+        decision = r.json().get("result", False)
+        return decision
+    except Exception:
+        logger.exception("OPA eval failed - default deny")
+        return False
+
+def trigger_promotion(run_id, model_id, params=None):
+    pr = {
+        "apiVersion": "tekton.dev/v1beta1",
+        "kind": "PipelineRun",
+        "metadata": {"generateName": f"promote-{model_id}-"},
+        "spec": {
+            "pipelineRef": {"name": PROMOTE_PIPELINE},
+            "params": [{"name":"model_id","value":model_id},{"name":"model_name","value":model_id},{"name":"artifact_s3","value":""},{"name":"evidence_bucket","value":EVIDENCE_BUCKET}]
+        }
+    }
+    import yaml
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.dump(pr).encode()); f.close()
+    subprocess.check_call(["kubectl", "apply", "-n", TEKTON_NS, "-f", f.name])
+    logger.info("Triggered promotion PipelineRun for model %s", model_id)
+
+def request_sme(run_id, summary, evidence_uri):
+    payload = {"summary": summary, "evidence_uri": evidence_uri}
+    r = requests.post(urljoin(APPROVAL_SERVICE, "/request"), json=payload, timeout=10)
+    r.raise_for_status()
+    return r.json().get("id")
+
+def handle_evaluation(payload):
+    """
+    payload example:
+    {
+      "kind":"CanaryEvaluation",
+      "run_id":"run-123",
+      "metrics": {"rel_drop": 0.03},
+      "annotations": {"aegis_cost_accounted":"s3://..."},
+      "uses_paid_provider": true
+    }
+    """
+    run_id = payload.get("run_id", f"run-{int(datetime.utcnow().timestamp())}")
+    decision = opa_evaluate(payload)
+    evidence_uri = upload_evidence(run_id, payload)
+    if decision:
+        # perform promotion
+        model_id = payload.get("model_id","unknown")
+        trigger_promotion(run_id, model_id)
+        return {"status":"promoted", "evidence": evidence_uri}
+    else:
+        # SME flow
+        summary = f"Canary requires SME review for run {run_id}"
+        req_id = request_sme(run_id, summary, evidence_uri)
+        logger.info("SME requested: %s", req_id)
+        return {"status":"sme_requested", "request_id": req_id, "evidence": evidence_uri}
+
+if __name__ == "__main__":
+    import sys
+    data = json.load(sys.stdin) if not sys.stdin.isatty() else {}
+    print(handle_evaluation(data))
+
