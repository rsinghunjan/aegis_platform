+#!/usr/bin/env python3
+"""
+Rotation verifier:
+ - Watches ExternalSecrets target secret and ensures 'aegis.rotation_record' annotation exists on subsequent Secret objects
+ - Uploads verification evidence to EVIDENCE_BUCKET
+"""
+import os, time, logging
+import subprocess, json
+
+logger = logging.getLogger("rotation-verifier")
+logging.basicConfig(level=logging.INFO)
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+NAMESPACE = os.environ.get("SECRETS_NS","monitoring")
+TARGET_SECRET = os.environ.get("TARGET_SECRET","aegis-service-creds")
+
+def check_secret():
+    out = subprocess.check_output(["kubectl","-n",NAMESPACE,"get","secret",TARGET_SECRET,"-o","json"]).decode()
+    sec = json.loads(out)
+    ann = sec.get("metadata",{}).get("annotations",{})
+    record = ann.get("aegis.rotation_record","")
+    return bool(record), record
+
+def upload_evidence(name, payload):
+    if not EVIDENCE_BUCKET:
+        path=f"/tmp/{name}.json"
+        with open(path,"w") as f: json.dump(payload,f); return path
+    import boto3
+    s3=boto3.client("s3")
+    key=f"secrets/rotation_verify/{name}-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(payload).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+if __name__ == "__main__":
+    while True:
+        ok, rec = check_secret()
+        payload = {"ok": ok, "record": rec}
+        upload_evidence("rotation_check", payload)
+        if ok:
+            logger.info("Rotation record present")
+        else:
+            logger.warning("Rotation record missing for secret %s", TARGET_SECRET)
+        time.sleep(300)
+
