+#!/usr/bin/env python3
+"""
+Ray Tune cost guard helper:
+ - Estimates trial cost by configuration and instance pricing (simple heuristic)
+ - Provides a callback to stop experiment when estimated spend exceeds MAX_SPEND_USD
+"""
+import os
+import logging
+
+logger = logging.getLogger("hpo-cost-guard")
+logging.basicConfig(level=logging.INFO)
+
+MAX_SPEND_USD = float(os.environ.get("HPO_MAX_SPEND_USD", "500.0"))
+COST_PER_CPU_HOUR = float(os.environ.get("COST_PER_CPU_HOUR", "0.02"))
+
+def estimate_trial_cost(config, cpu_hours=1.0):
+    # simple heuristic: cpu_hours * COST_PER_CPU_HOUR * num_cpus (from config if present)
+    cpus = float(config.get("cpus", 1.0))
+    return cpus * cpu_hours * COST_PER_CPU_HOUR
+
+class CostGuard:
+    def __init__(self, max_spend=MAX_SPEND_USD):
+        self.max_spend = max_spend
+        self.accum = 0.0
+
+    def on_trial_start(self, trial_config):
+        est = estimate_trial_cost(trial_config)
+        self.accum += est
+        logger.info("Estimated spend now: %s (added %s) vs max %s", self.accum, est, self.max_spend)
+        if self.accum > self.max_spend:
+            raise RuntimeError("HPO estimated spend exceeded")
+
