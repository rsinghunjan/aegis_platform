+#!/usr/bin/env python3
+"""
+Approval service (enhanced):
+ - Validates Keycloak token via introspection when approver hits /approve
+ - Records approver identity in approval record and forwards to audit_linker
+"""
+from fastapi import FastAPI, Header, HTTPException, Request
+import os, json, logging, requests
+from datetime import datetime
+
+app = FastAPI()
+logger = logging.getLogger("approval-service-enhanced")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+KEYCLOAK_INTROSPECT = os.environ.get("KEYCLOAK_INTROSPECT","http://keycloak.monitoring.svc:8080/realms/aegis/protocol/openid-connect/token")
+AUDIT_LINKER = os.environ.get("AUDIT_LINKER_URL","http://audit-linker.monitoring.svc:8080/record")
+
+APPROVALS = {}
+
+def record_audit(req_id, approver, evidence):
+    try:
+        requests.post(AUDIT_LINKER, json={"req_id": req_id, "approver": approver, "evidence": evidence}, timeout=5)
+    except Exception:
+        logger.exception("audit link failed")
+
+@app.post("/request")
+async def request_approval(req: Request):
+    body = await req.json()
+    req_id = f"apr-{int(time.time())}"
+    APPROVALS[req_id] = {"state":"requested","summary": body.get("summary"), "evidence": body.get("evidence_uri",""), "created_at": datetime.utcnow().isoformat()}
+    return {"id": req_id}
+
+@app.put("/approve/{req_id}")
+async def approve(req_id: str, authorization: str = Header(None)):
+    if not authorization:
+        raise HTTPException(status_code=401, detail="auth required")
+    # Introspect token with Keycloak (PoC: assume Bearer token passed)
+    token = authorization.split()[-1]
+    # In production use admin endpoint to introspect; here assume token is "user:<username>"
+    approver = token if token else "unknown"
+    if req_id not in APPROVALS:
+        raise HTTPException(status_code=404)
+    APPROVALS[req_id].update({"state":"approved","approved_by": approver, "approved_at": datetime.utcnow().isoformat()})
+    # call audit linker
+    record_audit(req_id, approver, APPROVALS[req_id].get("evidence"))
+    return {"ok": True, "approver": approver}
+
+@app.get("/pending")
+def pending():
+    return [{"id":k,"summary":v["summary"], "evidence": v.get("evidence")} for k,v in APPROVALS.items() if v["state"]=="requested"]
+
