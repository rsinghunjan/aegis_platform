+apiVersion: tekton.dev/v1beta1
+kind: Task
+metadata:
+  name: slo-canary-check
+  namespace: cicd
+spec:
+  params:
+    - name: canary_deployment
+      type: string
+    - name: business_metric
+      type: string
+    - name: rel_drop_threshold
+      type: string
+      default: "0.1"
