+
+NAMESPACE = os.environ.get("TEKTON_NAMESPACE","cicd")
+
+def get_run_id_from_pr(pr_name):
+    try:
+        out = subprocess.check_output(["kubectl","-n",NAMESPACE,"get","pipelinerun",pr_name,"-o","json"]).decode()
+        pr = json.loads(out)
+        # try results or annotations
+        ann = pr.get("metadata",{}).get("annotations",{})
+        if ann.get("aegis.run_id"):
+            return ann.get("aegis.run_id")
+        # fallback: look into results
+        res = pr.get("status",{}).get("pipelineResults",[])
+        for r in res:
+            if r.get("name") == "run_id":
+                return r.get("value")
+    except Exception:
+        logger.exception("Failed to read PR")
+    return None
+
+def label_current_pod(run_id):
+    try:
+        pod = subprocess.check_output(["/bin/sh","-c","echo $HOSTNAME"]).decode().strip()
+        subprocess.check_call(["kubectl","-n",NAMESPACE,"label","pod",pod,f"run_id={run_id}","--overwrite"])
+    except Exception:
+        logger.exception("labeling pod failed")
+
+if __name__ == "__main__":
+    import sys
+    pr=sys.argv[1] if len(sys.argv)>1 else ""
+    rid=get_run_id_from_pr(pr)
+    if rid:
