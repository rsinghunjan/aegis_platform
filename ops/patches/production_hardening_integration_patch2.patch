+#!/usr/bin/env python3
+"""
+Explainability indexer:
+ - Builds an index manifest for explainability artifacts stored under EVIDENCE_BUCKET/explainability/<model>/
+ - Provides a small search/index helper (PoC) that lists available explanation objects for a model
+"""
+import os, boto3, json, logging
+
+logger = logging.getLogger("explain-index")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+s3 = boto3.client("s3") if EVIDENCE_BUCKET else None
+
+def build_index(model_id):
+    prefix = f"explainability/{model_id}/"
+    objects = s3.list_objects_v2(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Prefix=prefix).get("Contents", [])
+    index = []
+    for o in objects:
+        key = o["Key"]
+        if key.endswith(".json"):
+            index.append({"key": key, "last_modified": o["LastModified"].isoformat()})
+    # store manifest
+    key = f"{prefix}manifest-{int(time.time())}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(index).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+if __name__ == "__main__":
+    import sys
+    mid = sys.argv[1] if len(sys.argv)>1 else "model"
+    print(build_index(mid))
+
