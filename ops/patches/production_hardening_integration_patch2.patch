+#!/usr/bin/env python3
+"""
+Spot orchestration helper for HPO:
+ - Manages Ray job submission policy for spot/ondemand mixes
+ - Respects per-team quotas via environment variables or a quota API
+ - Emits estimated cost for each trial to chargeback API
+"""
+import os, time, json, logging, requests
+
+logger = logging.getLogger("spot-orch")
+logging.basicConfig(level=logging.INFO)
+
+QUOTA_API = os.environ.get("QUOTA_API","http://chargeback.monitoring.svc:8080")
+COST_API = os.environ.get("COST_API","http://charge-estimator:8080/estimate")
+
+def check_quota(team):
+    try:
+        r = requests.get(f"{QUOTA_API}/quota/{team}", timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        logger.exception("Quota check failed; default deny")
+        return {"allowed":False}
+
+def estimate_cost(trial_config):
+    try:
+        r = requests.post(COST_API, json=trial_config, timeout=5)
+        r.raise_for_status()
+        return r.json().get("estimated_usd",0.0)
+    except Exception:
+        return 0.0
+
+def submit_hpo_request(team, config, max_trials=16):
+    q = check_quota(team)
+    if not q.get("allowed"):
+        raise RuntimeError("Quota exceeded for team")
+    # attach cost estimation per trial
+    est = estimate_cost(config)
+    payload = {"team": team, "config": config, "max_trials": max_trials, "est_per_trial_usd": est}
+    # in production submit to Ray operator or to Tekton task
+    logger.info("HPO submit accepted: %s", payload)
+    return payload
+
