+      script: |
+        #!/bin/sh
+        set -euo pipefail
+        pip install requests || true
+        CANARY=$(params.canary_deployment)
+        METRIC=$(params.business_metric)
+        THRESH=$(params.rel_drop_threshold)
+        prom="http://prometheus.monitoring.svc:9090"
+        canary_q=$(echo "$METRIC" | sed "s|\${CANARY}|$CANARY|g")
+        base_q=$(echo "$METRIC" | sed "s|\${CANARY}|production-model|g")
+        canary_v=$(curl -s "$prom/api/v1/query" --data-urlencode "query=$canary_q" | jq -r '.data.result[0].value[1]' 2>/dev/null || echo 0)
+        base_v=$(curl -s "$prom/api/v1/query" --data-urlencode "query=$base_q" | jq -r '.data.result[0].value[1]' 2>/dev/null || echo 0)
+        echo "canary=$canary_v baseline=$base_v"
+        if [ "$base_v" = "0" ] || [ -z "$base_v" ]; then
+          echo "Baseline missing; failing check"; exit 2
+        fi
+        rel=$(awk "BEGIN {print ($base_v - $canary_v)/$base_v}")
+        echo "rel_drop=$rel"
+        awk "BEGIN {if ($rel <= $THRESH) exit 0; else exit 1}"
+
