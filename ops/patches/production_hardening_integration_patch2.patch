+#!/usr/bin/env python3
+"""
+Failure handler / retry orchestrator for closed-loop pipelines.
+ - Monitors PipelineRuns (Tekton) and implements exponential backoff retries up to a configured limit.
+ - On persistent failure, escalates via Approval Service and creates an incident evidence bundle.
+"""
+import os, time, json, logging, subprocess
+from datetime import datetime
+
+logger = logging.getLogger("failure-handler")
+logging.basicConfig(level=logging.INFO)
+
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE","cicd")
+MAX_RETRIES = int(os.environ.get("CLOSEDLOOP_MAX_RETRIES","3"))
+APPROVAL_SERVICE = os.environ.get("APPROVAL_SERVICE_URL","http://approval-service.monitoring.svc:8080")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+
+def get_pipelineruns(label_selector=None):
+    cmd = ["kubectl","-n",TEKTON_NS,"get","pipelineruns","-o","json"]
+    out = subprocess.check_output(cmd).decode()
+    obj = json.loads(out)
+    return obj.get("items",[])
+
+def escalate(pr_name, reason):
+    payload = {"summary": f"PipelineRun {pr_name} needs attention", "details": reason}
+    try:
+        import requests
+        r = requests.post(f"{APPROVAL_SERVICE}/request", json=payload, timeout=10)
+        r.raise_for_status()
+        logger.info("Escalation request created for %s", pr_name)
+    except Exception:
+        logger.exception("Failed to create escalation")
+
+def collect_and_upload(pr_name):
+    ts = datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
+    local = f"/tmp/{pr_name}-{ts}.json"
+    try:
+        subprocess.check_call(["kubectl","-n",TEKTON_NS,"get","pipelinerun",pr_name,"-o","json"], stdout=open(local,"w"))
+    except Exception:
+        pass
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3 = boto3.client("s3")
+        key = f"closedloop/failures/{pr_name}-{ts}.json"
+        s3.upload_file(local, EVIDENCE_BUCKET.replace("s3://",""), key)
+        logger.info("Uploaded failure evidence s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
+
+def run_loop(poll=60):
+    while True:
+        runs = get_pipelineruns()
+        for r in runs:
+            meta = r.get("metadata",{})
+            name = meta.get("name")
+            status = r.get("status",{})
+            conds = status.get("conditions",[])
+            if conds and conds[0].get("status") == "False":
+                retries = meta.get("annotations",{}).get("aegis.retries","0")
+                retries = int(retries)
+                if retries < MAX_RETRIES:
+                    backoff = (2 ** retries) * 30
+                    logger.info("Retrying %s in %s seconds (attempt %s)", name, backoff, retries+1)
+                    time.sleep(backoff)
+                    subprocess.check_call(["kubectl","-n",TEKTON_NS,"annotate","pipelinerun",name,f"aegis.retries={retries+1}","--overwrite"])
+                    subprocess.check_call(["kubectl","-n",TEKTON_NS,"delete","pipelinerun",name,"--ignore-not-found"])
+                    # In production you'd re-create a new PipelineRun; here we escalate for manual run
+                    escalate(name,"Auto-retry requested")
+                else:
+                    collect_and_upload(name)
+                    escalate(name,"Max retries exceeded")
+        time.sleep(poll)
+
+if __name__ == "__main__":
+    run_loop()
+
