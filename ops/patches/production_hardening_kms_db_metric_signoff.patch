+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Wrapper to migrate local SQLite registry to managed Postgres using DATABASE_URL from Secrets Manager.
+# Usage: ./ops/scripts/migrate_sqlite_to_managed_postgres.sh /path/to/models.db staging/aegis/registry-db
+
+SQLITE_FILE=${1:-}
+SM_SECRET=${2:-}
+if [ -z "$SQLITE_FILE" ] || [ -z "$SM_SECRET" ]; then
+  echo "Usage: $0 <sqlite_file> <secrets-manager-name>"
+  exit 2
+fi
+if [ ! -f "$SQLITE_FILE" ]; then
+  echo "SQLite file not found: $SQLITE_FILE"
+  exit 3
+fi
+echo "Fetching DATABASE_URL from Secrets Manager: $SM_SECRET"
+DB_JSON=$(aws secretsmanager get-secret-value --secret-id "$SM_SECRET" --query SecretString --output text)
+DATABASE_URL=$(echo "$DB_JSON" | python -c "import sys, json; print(json.load(sys.stdin).get('DATABASE_URL'))")
+if [ -z "$DATABASE_URL" ]; then
+  echo "DATABASE_URL not found in secret"
+  exit 4
+fi
+
+echo "Running migration..."
+./ops/scripts/migrate_sqlite_to_postgres.sh --sqlite "$SQLITE_FILE" --pg "$DATABASE_URL"
+echo "Migration finished. Verify counts in Postgres and switch apps to new DATABASE_URL."
+
