+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Aggregate evidence objects from S3 under provided prefixes, create a tar.gz bundle, sign with cosign (if available),
+# and upload bundle + signature back to the evidence bucket under "bundles/".
+#
+# Usage:
+#   EVIDENCE_BUCKET=my-bucket ./ops/scripts/aggregate_evidence_and_sign.sh simulations/episode1 longshadow/modelX
+
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
+if [ -z "$EVIDENCE_BUCKET" ]; then
+  echo "EVIDENCE_BUCKET required"
+  exit 2
+fi
+PREFIXES=("$@")
+if [ ${#PREFIXES[@]} -eq 0 ]; then
+  echo "Provide at least one s3 prefix path (relative to bucket) to gather"
+  exit 3
+fi
+
+TMPDIR=$(mktemp -d)
+echo "Downloading artifacts into $TMPDIR"
+for p in "${PREFIXES[@]}"; do
+  echo "Syncing s3://$EVIDENCE_BUCKET/$p -> $TMPDIR/$p"
+  mkdir -p "$TMPDIR/$p"
+  aws s3 sync "s3://$EVIDENCE_BUCKET/$p" "$TMPDIR/$p" || echo "Sync returned non-zero for prefix $p"
+done
+
+BUNDLE_NAME="evidence_bundle_$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
+(cd "$TMPDIR" && tar -czf "/tmp/$BUNDLE_NAME" .)
+
+echo "Bundle created at /tmp/$BUNDLE_NAME"
+if command -v cosign >/dev/null 2>&1 && [ -f "${COSIGN_KEY:-./cosign.key}" ]; then
+  echo "Signing bundle with cosign..."
+  cosign sign --key "${COSIGN_KEY:-./cosign.key}" "/tmp/$BUNDLE_NAME" || echo "cosign sign returned non-zero"
+  SIGFILE="/tmp/$BUNDLE_NAME.sig"
+else
+  echo "cosign not available or key missing; creating SHA256"
+  SIGFILE="/tmp/$BUNDLE_NAME.sha256"
+  sha256sum "/tmp/$BUNDLE_NAME" > "$SIGFILE"
+fi
+
+echo "Uploading bundle and signature to s3://$EVIDENCE_BUCKET/bundles/"
+aws s3 cp "/tmp/$BUNDLE_NAME" "s3://$EVIDENCE_BUCKET/bundles/$BUNDLE_NAME"
+aws s3 cp "$SIGFILE" "s3://$EVIDENCE_BUCKET/bundles/$(basename $SIGFILE)"
+
+echo "Uploaded. Clean up $TMPDIR"
+rm -rf "$TMPDIR"
+
