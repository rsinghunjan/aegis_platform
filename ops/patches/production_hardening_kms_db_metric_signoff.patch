+// Terraform snippet to provision managed Postgres, KMS key, Secrets Manager secret, and S3 evidence bucket with Object Lock
+// Usage: fill variables in terraform/variables.tf and run `terraform init && terraform apply`
+provider "aws" {
+  region = var.aws_region
+}
+
+resource "aws_kms_key" "evidence_key" {
+  description             = "KMS key for encrypting evidence and S3 objects for Aegis"
+  deletion_window_in_days = 30
+}
+
+resource "aws_kms_alias" "evidence_key_alias" {
+  name          = "alias/aegis-evidence"
+  target_key_id = aws_kms_key.evidence_key.id
+}
+
+resource "aws_s3_bucket" "evidence_bucket" {
+  bucket = var.evidence_bucket_name
+  acl    = "private"
+
+  server_side_encryption_configuration {
+    rule {
+      apply_server_side_encryption_by_default {
+        sse_algorithm     = "aws:kms"
+        kms_master_key_id = aws_kms_key.evidence_key.arn
+      }
+    }
+  }
+
+  object_lock_configuration {
+    rule {
+      default_retention {
+        mode = "GOVERNANCE"
+        days = var.evidence_retention_days
+      }
+    }
+  }
+
+  force_destroy = false
+}
+
+// RDS Postgres (single instance example; for production swap to cluster/aurora)
+resource "aws_db_instance" "aegis_postgres" {
+  identifier              = "${var.environment}-aegis-postgres"
+  engine                  = "postgres"
+  engine_version          = var.postgres_version
+  instance_class          = var.postgres_instance_class
+  allocated_storage       = var.postgres_storage_gb
+  name                    = var.postgres_db_name
+  username                = var.postgres_master_username
+  password                = var.postgres_master_password
+  skip_final_snapshot     = true
+  publicly_accessible     = false
+  multi_az                = var.postgres_multi_az
+  storage_encrypted       = true
+  kms_key_id              = aws_kms_key.evidence_key.arn
+}
+
+// Store DB connection string in Secrets Manager
+resource "aws_secretsmanager_secret" "registry_db_secret" {
+  name = "${var.environment}/aegis/registry-db"
+}
+
+resource "aws_secretsmanager_secret_version" "registry_db_secret_version" {
+  secret_id     = aws_secretsmanager_secret.registry_db_secret.id
+  secret_string = jsonencode({
+    DATABASE_URL = "postgresql://${var.postgres_master_username}:${var.postgres_master_password}@${aws_db_instance.aegis_postgres.address}:${aws_db_instance.aegis_postgres.port}/${var.postgres_db_name}"
+  })
+}
+
+output "evidence_bucket" {
+  value = aws_s3_bucket.evidence_bucket.id
+}
+
+output "registry_db_secret_arn" {
+  value = aws_secretsmanager_secret.registry_db_secret.arn
+}
+
