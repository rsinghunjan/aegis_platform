+#!/usr/bin/env python3
+"""
+Run promql_probe output and generate ServiceMonitor relabel snippet that maps pod annotations -> labels.
+If --apply is passed, attempt to patch the ServiceMonitor named in args (best-effort).
+"""
+import os
+import json
+import subprocess
+import argparse
+
+PROMQL_PROBE = "services/carbon/promql_probe.py"
+TUNED_OUT = "ops/promql/tuned_promql_templates.json"
+
+RELAB_SNIPPET = {
+    "relabel_configs": [
+        {"source_labels": ["__meta_kubernetes_pod_annotation_aegis_job_id"], "target_label": "job_id", "action": "replace"},
+        {"source_labels": ["__meta_kubernetes_pod_annotation_aegis_model_name"], "target_label": "model_name", "action": "replace"},
+        {"source_labels": ["__meta_kubernetes_pod_node_label_aegis_region"], "target_label": "aegis_region", "action": "replace"}
+    ]
+}
+
+def run_promql_probe():
+    print("Running promql_probe to /tmp/promql_probe.json")
+    subprocess.run(["python", PROMQL_PROBE], check=False)
+    # promql_probe may write output itself; we just produce relabel suggestion
+
+def print_snippet():
+    import yaml
+    print("# Suggested relabel snippet for ServiceMonitor or Prometheus scrape_config:")
+    print(yaml.safe_dump(RELAB_SNIPPET, sort_keys=False))
+
+def apply_patch(servicemonitor_name):
+    # Patch a ServiceMonitor to add relabel_configs (best-effort)
+    patch = {
+        "spec": {
+            "endpoints": [
+                {
+                    "relabelings": RELAB_SNIPPET["relabel_configs"]
+                }
+            ]
+        }
+    }
+    import tempfile, json
+    f = tempfile.NamedTemporaryFile(delete=False, mode="w")
+    f.write(json.dumps(patch))
+    f.flush()
+    cmd = ["kubectl", "patch", "servicemonitor", servicemonitor_name, "-n", "monitoring", "--type=merge", "-p", json.dumps(patch)]
+    print("Patching ServiceMonitor:", " ".join(cmd))
+    subprocess.run(cmd, check=False)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--apply", help="ServiceMonitor name to patch", default=None)
+    args = p.parse_args()
+    run_promql_probe()
+    print_snippet()
+    if args.apply:
+        apply_patch(args.apply)
+
