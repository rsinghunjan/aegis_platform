+#!/usr/bin/env python3
+"""
+LLM planner hallucination monitor
+ - Runs the enhanced LLM planner over a corpus of intents (ops/agent/sample_intents.jsonl)
+ - Validates planner outputs against schema and allowed tool list, computes schema-failure/hallucination rates
+ - Uploads a report to evidence bucket and pushes a metric to Pushgateway
+"""
+import os, json, time
+from services.agent.llm_planner_enhanced import plan_for_intent
+from services.agent.llm_plan_validator import validate_plan
+try:
+    import boto3
+except Exception:
+    boto3 = None
+try:
+    from prometheus_client import CollectorRegistry, Gauge, push_to_gateway
+except Exception:
+    push_to_gateway = None
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+PUSHGW = os.environ.get("PUSHGATEWAY","")
+INTENTS_FILE = os.environ.get("AGENT_INTENTS_FILE","ops/agent/sample_intents.jsonl")
+
+def load_intents(path):
+    out=[]
+    if not os.path.exists(path):
+        return out
+    for l in open(path):
+        if not l.strip(): continue
+        out.append(json.loads(l))
+    return out
+
+def upload_report(report, name):
+    if not EVIDENCE_BUCKET or not boto3:
+        path = f"/tmp/{name}.json"
+        with open(path,"w") as f:
+            json.dump(report,f,indent=2)
+        return path
+    s3 = boto3.client("s3")
+    key = f"agent_planner_reports/{name}.json"
+    s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(report).encode("utf-8"))
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+def push_metric(rate):
+    if not push_to_gateway or not PUSHGW:
+        return
+    reg = CollectorRegistry()
+    g = Gauge("aegis_agent_planner_schema_failure_rate", "Planner schema failure/hallucination rate", registry=reg)
+    g.set(rate)
+    push_to_gateway(PUSHGW, job='planner_hallucination_monitor', registry=reg)
+
+def main():
+    intents = load_intents(INTENTS_FILE)
+    total = len(intents)
+    failures = 0
+    details=[]
+    for it in intents:
+        intent_text = it.get("intent")
+        plan = plan_for_intent(intent_text, {})
+        ok, info = validate_plan(plan)
+        if not ok:
+            failures += 1
+        details.append({"intent": intent_text, "valid": ok, "info": info})
+    rate = failures/total if total else 0.0
+    report = {"total": total, "failures": failures, "failure_rate": rate, "details_sample": details[:50], "ts": int(time.time())}
+    name = f"planner_report_{int(time.time())}"
+    dest = upload_report(report, name)
+    push_metric(rate)
+    print("Report written to", dest)
+
+if __name__=="__main__":
+    main()
+
