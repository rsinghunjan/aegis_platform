+#!/usr/bin/env python3
+"""
+Shadow aggregator and daily/rolling reporter
+ - Aggregates shadow_runner outputs from local file or S3 (gen_shadow/*.jsonl)
+ - Computes divergence rate, verifier regressions, and basic safety signals over configurable window
+ - Writes an evidence report to EVIDENCE_BUCKET and emits a Pushgateway metric (if configured)
+
+Usage:
+  export EVIDENCE_BUCKET=... (optional)
+  export SHADOW_LOCAL=/data/shadow_generations.jsonl
+  python services/generative/shadow_aggregator.py --window-hours 24 --out /tmp/shadow_report.json
+"""
+import os, json, time, argparse
+from datetime import datetime, timedelta
+try:
+    import boto3
+except Exception:
+    boto3 = None
+try:
+    from prometheus_client import CollectorRegistry, Gauge, push_to_gateway
+except Exception:
+    push_to_gateway = None
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+PUSHGW = os.environ.get("PUSHGATEWAY", "")
+LOCAL_SHADOW_PATH = os.environ.get("SHADOW_OUT", "/data/shadow_generations.jsonl")
+
+def iter_local(path, since_ts):
+    if not os.path.exists(path):
+        return
+    with open(path) as f:
+        for l in f:
+            if not l.strip(): continue
+            try:
+                j = json.loads(l)
+                if j.get("ts",0) >= since_ts:
+                    yield j
+            except Exception:
+                continue
+
+def read_s3_prefix(bucket, prefix, since_ts):
+    if not boto3:
+        return
+    s3 = boto3.client("s3")
+    paginator = s3.get_paginator("list_objects_v2")
+    for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
+        for obj in page.get("Contents", []):
+            key = obj["Key"]
+            try:
+                body = s3.get_object(Bucket=bucket, Key=key)["Body"].read().decode("utf-8")
+                for l in body.splitlines():
+                    if not l.strip(): continue
+                    j = json.loads(l)
+                    if j.get("ts",0) >= since_ts:
+                        yield j
+            except Exception:
+                continue
+
+def aggregate(items):
+    total = 0
+    divergences = 0
+    verifier_failures = 0
+    per_min = {}
+    for it in items:
+        total += 1
+        div = float(it.get("divergence", 0.0))
+        divergences += 1 if div > 0 else 0
+        vfail = 0
+        p = it.get("prod",{}).get("resp",{})
+        c = it.get("candidate",{}).get("resp",{})
+        # quick heuristic: if either resp has an 'error' field, count as verifier/service failure
+        if p.get("error") or c.get("error"):
+            verifier_failures += 1
+            vfail = 1
+        ts_min = int(it.get("ts",0)) // 60
+        per_min.setdefault(ts_min, {"total":0,"div":0,"vfail":0})
+        per_min[ts_min]["total"] += 1
+        per_min[ts_min]["div"] += 1 if div>0 else 0
+        per_min[ts_min]["vfail"] += vfail
+    divergence_rate = (divergences/total) if total else 0.0
+    vfail_rate = (verifier_failures/total) if total else 0.0
+    return {"total": total, "divergences": divergences, "divergence_rate": divergence_rate, "verifier_failures": verifier_failures, "verifier_failure_rate": vfail_rate, "per_min": per_min}
+
+def upload_report(report, dest_key):
+    if not EVIDENCE_BUCKET or not boto3:
+        with open(dest_key, "w") as f:
+            f.write(json.dumps(report, indent=2))
+        return dest_key
+    s3 = boto3.client("s3")
+    key = f"gen_shadow_reports/{os.path.basename(dest_key)}"
+    s3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(report).encode("utf-8"))
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+def push_metrics(report):
+    if not push_to_gateway or not PUSHGW:
+        return
+    reg = CollectorRegistry()
+    g_div = Gauge("aegis_gen_shadow_divergence_rate", "Shadow divergence rate (window)", registry=reg)
+    g_total = Gauge("aegis_gen_shadow_total", "Shadow sample count", registry=reg)
+    g_vfail = Gauge("aegis_gen_shadow_verifier_failure_rate", "Verifier failure rate", registry=reg)
+    g_div.set(float(report["divergence_rate"]))
+    g_total.set(int(report["total"]))
+    g_vfail.set(float(report["verifier_failure_rate"]))
+    push_to_gateway(PUSHGW, job='shadow_aggregator', registry=reg)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--window-hours", type=int, default=24)
+    p.add_argument("--out", default="/tmp/shadow_report.json")
+    args = p.parse_args()
+    since = int((datetime.utcnow() - timedelta(hours=args.window_hours)).timestamp())
+    items = []
+    # local-first
+    try:
+        items.extend(list(iter_local(LOCAL_SHADOW_PATH, since)))
+    except Exception:
+        pass
+    # also check S3 prefix if configured
+    if EVIDENCE_BUCKET and boto3:
+        try:
+            items.extend(list(read_s3_prefix(EVIDENCE_BUCKET, "gen_shadow/", since)))
+        except Exception:
+            pass
+    report = aggregate(items)
+    report["window_hours"] = args.window_hours
+    report["generated_at"] = int(time.time())
+    path = args.out
+    dest = upload_report(report, path)
+    push_metrics(report)
+    print("Report saved to", dest)
+
+if __name__ == "__main__":
+    main()
+
