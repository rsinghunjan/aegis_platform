+#!/usr/bin/env python3
+"""
+Load test for resumable ingest service.
+ - Starts N worker threads, each uploads files by chunked/resumable protocol and reports success/fail counts.
+ - Produces a JSON summary with throughput, error rate, retries.
+"""
+import argparse, os, requests, threading, time, random, json
+
+def worker(server, filepath, dataset, modality, results, fail_rate):
+    try:
+        # use resumable client endpoints
+        init = requests.post(f"{server}/resumable/init", json={"filename": os.path.basename(filepath), "modality": modality, "dataset_id": dataset})
+        init.raise_for_status()
+        uid = init.json()["upload_id"]
+        with open(filepath, "rb") as f:
+            chunk_size = 1024*128
+            offset = 0
+            while True:
+                data = f.read(chunk_size)
+                if not data: break
+                # simulate network flake
+                if random.random() < fail_rate:
+                    time.sleep(0.05)
+                files = {'chunk': ('chunk', data)}
+                r = requests.put(f"{server}/resumable/{uid}/chunk?offset={offset}", files=files, timeout=30)
+                r.raise_for_status()
+                offset += len(data)
+        fin = requests.post(f"{server}/resumable/{uid}/finalize", timeout=60)
+        fin.raise_for_status()
+        results.append({"ok": True, "resp": fin.json()})
+    except Exception as e:
+        results.append({"ok": False, "error": str(e)})
+
+def run_load(server, files, parallel=10, fail_rate=0.05):
+    threads=[]
+    results=[]
+    start=time.time()
+    for i in range(parallel):
+        fp = random.choice(files)
+        t = threading.Thread(target=worker, args=(server, fp, "load-test", "image", results, fail_rate))
+        t.start()
+        threads.append(t)
+    for t in threads:
+        t.join()
+    dur=time.time()-start
+    success=sum(1 for r in results if r["ok"])
+    fail=sum(1 for r in results if not r["ok"])
+    return {"total": len(results), "success": success, "fail": fail, "duration_s": dur, "samples": results[:10]}
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--server", default="http://localhost:8080")
+    p.add_argument("--files", nargs="+", required=True)
+    p.add_argument("--parallel", type=int, default=20)
+    p.add_argument("--fail-rate", type=float, default=0.05)
+    args = p.parse_args()
+    out = run_load(args.server, args.files, args.parallel, args.fail_rate)
+    print(json.dumps(out, indent=2))
+
