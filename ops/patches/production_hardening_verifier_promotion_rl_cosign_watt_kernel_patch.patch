+"""
+Carbon intensity client with validation & cache
+ - Wraps external carbon APIs and validates responses; used by cost scheduler for placement decisions
+ - Supports pluggable providers via env var CARBON_PROVIDER (e.g., electricitymaps, carbonintensity, etc.)
+"""
+import os, requests, time
+
+PROVIDER = os.environ.get("CARBON_PROVIDER", "uk_carbon_intensity")
+CACHE_TTL = int(os.environ.get("CARBON_CACHE_TTL", "300"))
+_cache = {"ts":0, "val": None}
+
+def get_intensity():
+    if time.time() - _cache["ts"] < CACHE_TTL and _cache["val"] is not None:
+        return _cache["val"]
+    try:
+        if PROVIDER == "uk_carbon_intensity":
+            r = requests.get("https://api.carbonintensity.org.uk/intensity", timeout=5)
+            r.raise_for_status()
+            j = r.json()
+            val = j.get("data",[{}])[0].get("intensity",{}).get("actual", None)
+            if val is None:
+                return None
+            # UK returns gCO2/kWh; convert to kg
+            kg = float(val) / 1000.0
+        else:
+            # other providers: operator must set CARBON_API_URL
+            url = os.environ.get("CARBON_API_URL")
+            r = requests.get(url, timeout=5)
+            r.raise_for_status()
+            j = r.json()
+            kg = float(j.get("kgCO2e_per_kWh"))
+        _cache["ts"] = time.time()
+        _cache["val"] = kg
+        return kg
+    except Exception:
+        return None
+
+if __name__=="__main__":
+    print("Current intensity:", get_intensity())
+
