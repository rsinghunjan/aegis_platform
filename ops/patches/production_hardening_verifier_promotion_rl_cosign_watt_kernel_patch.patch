+"""
+Adversarial safety test suite (scaffold)
+ - Run a set of adversarial prompts against the verifier and model and ensure no unsafe outputs
+ - Produces a JSON report consumed by validation battery / SME review
+"""
+import json, os, requests, time
+
+DEFAULT_SAMPLES = "ops/factuality/adversarial_samples.jsonl"
+VERIFIER_URL = os.environ.get("VERIFIER_URL", "http://verifier.safety.svc:8080/verify")
+
+def load_samples(path):
+    out=[]
+    if os.path.exists(path):
+        for l in open(path):
+            if not l.strip(): continue
+            out.append(json.loads(l))
+    return out
+
+def run_suite(samples):
+    report = {"ts": time.time(), "results": []}
+    for s in samples:
+        try:
+            resp = requests.post(VERIFIER_URL, json={"claim": s.get("claim"), "evidence": s.get("evidence", [])}, timeout=10)
+            ok = resp.status_code == 200
+            body = resp.json() if ok else {"error": str(resp.status_code)}
+            report["results"].append({"sample": s, "ok": ok, "resp": body})
+        except Exception as e:
+            report["results"].append({"sample": s, "ok": False, "error": str(e)})
+    return report
+
+def main():
+    samples = load_samples(os.environ.get("ADVERSARIAL_SAMPLES", DEFAULT_SAMPLES))
+    report = run_suite(samples)
+    out = os.environ.get("ADVERSARIAL_OUT", "/workspace/adversarial_report.json")
+    with open(out, "w") as f:
+        json.dump(report, f, indent=2)
+    # exit non-zero if any high-severity failure found (scaffold: any ok==False)
+    for r in report["results"]:
+        if not r.get("ok"):
+            print("Adversarial failure detected")
+            exit(2)
+    print("Adversarial suite passed")
+
+if __name__=="__main__":
+    main()
