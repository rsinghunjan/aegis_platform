+#!/usr/bin/env python3
+"""
+Fairness test scaffold
+ - Runs simple subgroup evaluation metrics and writes a pass/fail result
+ - Expects candidate predictions and ground truth with demographic metadata
+"""
+import json, os
+import numpy as np
+from sklearn.metrics import f1_score, accuracy_score
+
+PRED_PATH = os.environ.get("FAIR_PRED_PATH", "ops/factuality/sample_preds_with_meta.jsonl")
+LABEL_PATH = os.environ.get("FAIR_LABEL_PATH", "ops/factuality/sample_labels_with_meta.jsonl")
+OUT = os.environ.get("FAIR_OUT", "/workspace/fairness_report.json")
+MIN_ACCURACY = float(os.environ.get("FAIR_MIN_ACCURACY", "0.7"))
+
+def load(path):
+    out=[]
+    if os.path.exists(path):
+        for l in open(path):
+            if not l.strip(): continue
+            out.append(json.loads(l))
+    return out
+
+def group_eval(preds, labels, group_key):
+    # build mapping by id
+    id2pred = {p["id"]: p for p in preds}
+    groups = {}
+    for lab in labels:
+        pid = lab["id"]
+        grp = lab.get(group_key, "unknown")
+        pred = id2pred.get(pid, {"label_pred": None})
+        groups.setdefault(grp, []).append((lab["label"], pred.get("label_pred")))
+    report = {}
+    for g,v in groups.items():
+        y_true = [x[0] for x in v]
+        y_pred = [x[1] for x in v]
+        acc = accuracy_score(y_true, y_pred) if any(y_pred) else 0.0
+        report[g] = {"n": len(v), "accuracy": acc}
+    return report
+
+def main():
+    preds = load(PRED_PATH)
+    labels = load(LABEL_PATH)
+    group_key = os.environ.get("FAIR_GROUP_KEY", "demographic_group")
+    rep = group_eval(preds, labels, group_key)
+    with open(OUT,"w") as f:
+        json.dump({"group_report": rep}, f, indent=2)
+    # simple fail condition if any group accuracy below threshold
+    for g,v in rep.items():
+        if v["accuracy"] < MIN_ACCURACY:
+            print("Fairness check failed for group", g)
+            exit(2)
+    print("Fairness checks passed")
+
+if __name__=="__main__":
+    main()
+
