+#!/usr/bin/env python3
+"""
+Promotion controller scaffold
+ - Listens for ModelPromotion CRs and performs idempotent, transactional promotion:
+   1) Verify signature of artifact (cosign verify)
+   2) Apply canary -> wait -> run smoke checks -> if pass update production Deployment via patch
+   3) Update CR status with state/promotedAt
+ - This is a simplified controller; in production use a proper operator framework (kubebuilder/controller-runtime)
+"""
+import os, subprocess
+import time
+import json
+from kubernetes import client, config, watch
+
+NAMESPACE = os.environ.get("NAMESPACE", "safety")
+COSIGN_KEY = os.environ.get("COSIGN_KEY", "")
+SMOKE_TEST_CMD = os.environ.get("SMOKE_TEST_CMD", "python services/ci/smoke_tests.py")
+
+def verify_artifact(artifact_path):
+    # artifact_path is a local or gs:// URI that must be downloaded by operator beforehand
+    try:
+        subprocess.check_call(["cosign","verify","--key", COSIGN_KEY, artifact_path])
+        return True
+    except Exception:
+        return False
+
+def apply_promotion(name, artifact_meta):
+    # idempotent promotion: check if a ModelPromotion with same artifact exists with 'promoted' status
+    # here we just patch the production deployment image as a simplified step
+    image = artifact_meta.get("image") or artifact_meta.get("artifact_path")
+    # Example: patch deployment image
+    cmd = ["kubectl","-n", NAMESPACE, "set", "image", "deployment/verifier", f"verifier={image}", "--record"]
+    subprocess.check_call(cmd)
+    # wait for rollout
+    subprocess.check_call(["kubectl","-n",NAMESPACE,"rollout","status","deployment/verifier","--timeout=120s"])
+    return True
+
+def main():
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    api = client.CustomObjectsApi()
+    w = watch.Watch()
+    for event in w.stream(api.list_namespaced_custom_object, group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", timeout_seconds=0):
+        obj = event["object"]
+        typ = event["type"]
+        name = obj["metadata"]["name"]
+        spec = obj.get("spec",{})
+        status = obj.get("status",{})
+        if typ == "ADDED" and status.get("state") != "promoted":
+            artifact = spec.get("artifact",{})
+            art_path = artifact.get("path")
+            # verify
+            ok = verify_artifact(art_path)
+            if not ok:
+                api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", name=name, body={"status":{"state":"verification_failed"}})
+                continue
+            # apply promotion
+            try:
+                apply_promotion(name, artifact)
+                api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", name=name, body={"status":{"state":"promoted","promotedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ")}})
+            except Exception as e:
+                api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", name=name, body={"status":{"state":"promotion_failed","error": str(e)}})
+
+if __name__=="__main__":
+    main()
+
