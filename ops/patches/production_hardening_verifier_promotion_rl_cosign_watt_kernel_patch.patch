+        return False
+    for rec in r.json():
+        if rec.get("request_id") == request_id and rec.get("action") == "approved":
+            return True
+    return False
+
+def apply_policy(policy):
+    # Example: patch configmap controlling serving decision engine
+    cm_name = "serving-decision-config"
