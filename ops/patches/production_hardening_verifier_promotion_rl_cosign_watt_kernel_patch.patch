+#!/usr/bin/env python3
+"""
+Validate kernel autotuner results
+ - Compares baseline throughput/latency numbers versus tuned config and emits pass/fail
+ - Expects a JSON with baseline and tuned metrics
+"""
+import sys, json
+
+def main(path):
+    j = json.load(open(path))
+    baseline = j.get("baseline", {})
+    tuned = j.get("tuned", {})
+    # require tuned throughput >= baseline * 1.05 and latency p95 <= baseline p95 * 0.98
+    base_tp = baseline.get("throughput", 0)
+    tune_tp = tuned.get("throughput", 0)
+    base_p95 = baseline.get("p95_latency_ms", 999999)
+    tune_p95 = tuned.get("p95_latency_ms", 999999)
+    ok = True
+    if tune_tp < base_tp * 1.05:
+        print("Throughput improvement insufficient", tune_tp, base_tp)
+        ok = False
+    if tune_p95 > base_p95 * 0.98:
+        print("Latency p95 not improved", tune_p95, base_p95)
+        ok = False
+    if not ok:
+        sys.exit(2)
+    print("Kernel tuning validated")
+
+if __name__=="__main__":
+    main(sys.argv[1])
