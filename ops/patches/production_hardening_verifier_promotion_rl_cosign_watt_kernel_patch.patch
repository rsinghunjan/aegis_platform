+"""
+Wattmeter calibration runner
+ - Reads synchronized wattmeter CSV and NVML telemetry snapshots and computes calibration factors
+ - Writes calibration JSON consumed by telemetry estimator
+"""
+import os, json, numpy as np
+from services.sustainability.carbon_client import get_intensity
+
+CSV = os.environ.get("WATT_CSV", "/data/wattmeter_sync.csv")
+NVML_SAMPLES = os.environ.get("NVML_SAMPLES", "/data/nvml_samples.jsonl")
+OUT = os.environ.get("WATT_CALIB_OUT", "/data/telemetry_calibration.json")
+
+def load_watts(csv):
+    ts=[]; watts=[]
+    for l in open(csv):
+        t,w = l.strip().split(",")
+        ts.append(float(t)); watts.append(float(w))
+    return np.array(ts), np.array(watts)
+
+def load_nvml(path):
+    arr=[]
+    for l in open(path):
+        arr.append(json.loads(l))
+    # map timestamp->nvml_power
+    return arr
+
+def calibrate():
+    ts,watts = load_watts(CSV)
+    nvml = load_nvml(NVML_SAMPLES)
+    # simplistic mapping: use mean nvml value to fit linear scale
+    nvml_vals = np.array([x.get("power_w", 0.0) for x in nvml])
+    if len(nvml_vals)==0:
+        return
+    a,b = np.polyfit(nvml_vals, watts[:len(nvml_vals)], 1)
+    cfg = {"scale": float(a), "offset": float(b), "calibrated_at": int(time.time())}
+    with open(OUT,"w") as f:
+        json.dump(cfg, f, indent=2)
+    print("Calibration written to", OUT)
+    return cfg
+
+if __name__=="__main__":
+    calibrate()
+
