+#!/usr/bin/env python3
+"""
+Parse k6 JSON output and push basic metrics to Prometheus Pushgateway.
+
+Example:
+  python ops/loadtests/push_k6_to_pushgateway.py --files k6_infer_result.json --pushgateway http://pushgateway:9091
+"""
+import json
+import argparse
+import requests
+from datetime import datetime
+
+def parse_k6_summary(js):
+    j = json.load(open(js))
+    metrics = {}
+    # k6 json has metrics.summary but structure varies; try extracting http_req_duration p95 and http_reqs
+    try:
+        m = j.get("metrics", {})
+        if "http_req_duration" in m:
+            stats = m["http_req_duration"]["counts"]
+            # fallback: use p(95) from "http_req_duration" -> "values" if present
+        # simple approach: store iteration count and vus
+        metrics["checks"] = j.get("metrics", {}).get("checks", {}).get("rate", 0)
+        metrics["http_reqs"] = j.get("metrics", {}).get("http_reqs", {}).get("count", 0)
+    except Exception:
+        pass
+    return metrics
+
+def push_to_gateway(pushgateway, job, metrics):
+    lines = []
+    for k,v in metrics.items():
+        lines.append(f'aegis_k6_{k} {v}')
+    data = "\n".join(lines) + "\n"
+    url = pushgateway.rstrip("/") + f"/metrics/job/{job}"
+    r = requests.post(url, data=data)
+    return r.status_code
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--files", nargs="+", required=True)
+    p.add_argument("--pushgateway", required=True)
+    args = p.parse_args()
+    for f in args.files:
+        metrics = parse_k6_summary(f)
+        job = "k6_"+f.replace(".","_")
+        code = push_to_gateway(args.pushgateway, job, metrics)
+        print("Pushed", f, "code", code)
+
+if __name__ == "__main__":
+    main()
+
