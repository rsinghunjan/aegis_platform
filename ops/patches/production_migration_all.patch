+#!/usr/bin/env python3
+"""
+Managed Postgres adapter and pgbouncer connection helper
+
+Usage:
+ - Set DATABASE_URL to your managed Postgres (e.g. postgresql://user:pass@host:5432/aegis)
+ - Optionally set PGB_HOST/PGB_PORT to point to a pgbouncer service (recommended).
+ - Use provided helper functions to get a connection string suitable for application pools.
+
+Notes:
+ - For production use, deploy pgbouncer as a sidecar or managed service and use TLS between app and DB.
+ - Use environment secrets (Vault/GCP Secret Manager/AWS Secrets Manager) for credentials.
+"""
+import os
+import urllib.parse
+
+def get_db_url():
+    """
+    Returns the DB URL to use in applications. If PGB_HOST is set, replace host/port with pgbouncer.
+    """
+    base = os.environ.get("DATABASE_URL")
+    if not base:
+        raise RuntimeError("DATABASE_URL not set")
+    pgb_host = os.environ.get("PGB_HOST")
+    pgb_port = os.environ.get("PGB_PORT")
+    if not pgb_host:
+        return base
+    # parse base and replace host/port with pgbouncer
+    parsed = urllib.parse.urlparse(base)
+    new_netloc = f"{parsed.username}:{parsed.password}@{pgb_host}:{pgb_port or '6543'}"
+    rebuilt = parsed._replace(netloc=new_netloc).geturl()
+    return rebuilt
+
+def get_psycopg2_conn_kwargs():
+    """
+    Return a dict suitable for psycopg2.connect(**kwargs) using DATABASE_URL or pgbouncer override.
+    """
+    dburl = get_db_url()
+    # Let caller use DATABASE_URL directly or parse as needed
+    return {"dsn": dburl}
+
+if __name__ == "__main__":
+    print(get_db_url())
+
