+#!/usr/bin/env python3
+"""
+Production Proofs Orchestrator
+Runs the production proof sequence to demonstrate readiness for Level 4:
+  - Bulk distributed HPO (target trials)
+  - Checkpoint validation (>= 0.90 success)
+  - Accelerated long-shadow
+  - 2k dry-run simulator
+  - OTEL coverage check (>= 0.90)
+  - OPA harness run and mismatch calculation (<< 1%)
+  - Automated remediation metrics check (>= 0.90)
+  - Pen-test run + terraform least-privilege plan (manual apply)
+  - Multi-tenant stress + chargeback validation
+  - Explainability index & ACL checks
+  - Long-term SLO snapshot
+  - Bundle, cosign-sign, and upload evidence; produce final audit report
+
+Usage:
+  EVIDENCE_BUCKET=s3://your-bucket python3 ops/production/production_proofs_orchestrator.py
+"""
+import os
+import sys
+import time
+import json
+import subprocess
+import logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("production-proofs")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+CHECKPOINT_THRESHOLD = float(os.environ.get("CHECKPOINT_THRESHOLD", "0.90"))
+OTEL_THRESHOLD = float(os.environ.get("OTEL_THRESHOLD", "0.90"))
+REMEDIATION_THRESHOLD = float(os.environ.get("REMEDIATION_THRESHOLD", "0.90"))
+OPA_MISMATCH_THRESHOLD = float(os.environ.get("OPA_MISMATCH_THRESHOLD", "0.01"))
+
+def run_cmd(cmd, check=True, capture=True, env=None):
+    logger.info(">>> %s", " ".join(cmd))
+    if capture:
+        out = subprocess.check_output(cmd, env=env).decode()
+        logger.debug(out)
+        return out
+    else:
+        subprocess.check_call(cmd, env=env)
+        return ""
+
+def submit_distributed_hpo(total_trials=128, per_job=8, checkpoint_s3="s3://aegis-checkpoints", team="validation"):
+    logger.info("Submitting distributed HPO: total=%s per_job=%s", total_trials, per_job)
+    cmd = ["python3", "services/hpo/ray_job_bulk_generator.py",
+           "--trials-total", str(total_trials),
+           "--trials-per-job", str(per_job),
+           "--checkpoint", checkpoint_s3,
+           "--team", team,
+           "--evidence", EVIDENCE_BUCKET]
+    run_cmd(cmd, capture=False)
+    # In production this should poll RayJob objects; here we sleep briefly to let jobs start
+    logger.info("Allowing jobs to initialize...")
+    time.sleep(30)
+
+def validate_checkpoints():
+    logger.info("Running checkpoint validator")
+    try:
+        run_cmd(["python3", "services/hpo/checkpoint_validator.py", "--evidence", EVIDENCE_BUCKET, "--threshold", str(CHECKPOINT_THRESHOLD)], capture=False)
+        logger.info("Checkpoint validation succeeded")
+        return True
+    except subprocess.CalledProcessError:
+        logger.exception("Checkpoint validation failed")
+        return False
+
+def run_long_shadow(hours=24):
+    logger.info("Starting long-shadow accelerated run for %s hours", hours)
+    try:
+        run_cmd(["python3", "ops/validation/longshadow_accelerated.py", "--hours", str(hours), "--evidence", EVIDENCE_BUCKET], capture=False)
+        return True
+    except Exception:
+        logger.exception("Long-shadow run failed")
+        return False
+
+def run_2k_simulator():
+    logger.info("Triggering 2k dry-run simulator")
+    try:
+        # If you have a Tekton pipeline for the simulator, apply it or call script
+        run_cmd(["python3", "services/stress/simulator_trigger.py"], capture=False)
+        return True
+    except Exception:
+        # fallback: attempt to call existing simulator task
+        try:
+            run_cmd(["python3", "services/stress/simulator_farm.py"], capture=False)
+            return True
+        except Exception:
+            logger.exception("2k simulator trigger failed")
+            return False
+
+def run_otel_coverage():
+    logger.info("Running OTEL coverage checker")
+    try:
+        out = run_cmd(["python3", "services/telemetry/otel_coverage_checker.py"], capture=True)
+        report = json.loads(out)
+        coverage = report.get("coverage", 0.0)
+        logger.info("OTEL coverage: %.3f", coverage)
+        ok = coverage >= OTEL_THRESHOLD
+        return ok, report
+    except Exception:
+        logger.exception("OTEL coverage check failed")
+        return False, {}
+
+def run_opa_harness():
+    logger.info("Running OPA harness")
+    try:
+        run_cmd(["python3", "services/decisioning/opa_harness_coverage.py"], capture=False)
+        # fetch latest harness report from S3
+        if EVIDENCE_BUCKET:
+            import boto3
+            s3=boto3.client("s3")
+            bucket=EVIDENCE_BUCKET.replace("s3://","")
+            resp=s3.list_objects_v2(Bucket=bucket, Prefix="opa/harness-report")
+            items=resp.get("Contents", [])
+            if not items:
+                logger.warning("No OPA harness report found in S3")
+                return False, 1.0
+            items.sort(key=lambda x: x["LastModified"], reverse=True)
+            key=items[0]["Key"]
+            obj=s3.get_object(Bucket=bucket, Key=key)
+            report=json.loads(obj["Body"].read().decode())
+            mismatches = report.get("mismatches", [])
+            decisions = report.get("decisions", {})
+            total = decisions.get("permit",0) + decisions.get("deny",0)
+            mismatch_rate = len(mismatches)/total if total else 1.0
+            logger.info("OPA mismatch_rate=%.6f", mismatch_rate)
+            return mismatch_rate <= OPA_MISMATCH_THRESHOLD, {"mismatch_rate": mismatch_rate, "s3_key": key}
+        else:
+            logger.warning("No EVIDENCE_BUCKET configured; assume harness executed")
+            return True, {}
+    except Exception:
+        logger.exception("OPA harness failed")
+        return False, {}
+
+def remediation_metrics_check():
+    logger.info("Running remediation metrics check")
+    try:
+        out = run_cmd(["python3", "services/failure/remediation_metrics.py"], capture=True)
+        stats=json.loads(out)
+        rate=stats.get("success_rate", 0.0)
+        logger.info("Remediation success rate: %.3f", rate)
+        return rate >= REMEDIATION_THRESHOLD, stats
+    except Exception:
+        logger.exception("Remediation metrics check failed")
+        return False, {}
+
+def run_pen_test_and_plan():
+    logger.info("Running pen-test and producing terraform plan")
+    try:
+        run_cmd(["bash", "ops/security/pen_test_remediate_and_issue.sh"], capture=False)
+        run_cmd(["bash", "terraform/scripts/manual_apply_and_audit.sh"], capture=False)
+        return True
+    except Exception:
+        logger.exception("Pen-test or plan failed")
+        return False
+
+def run_multi_tenant_stress_and_chargeback():
+    logger.info("Running multi-tenant stress and invoice simulation")
+    try:
+        run_cmd(["python3", "services/stress/multi_tenant_submission_stress.py"], capture=False)
+        run_cmd(["python3", "services/billing/invoice_simulator.py"], capture=False)
+        run_cmd(["python3", "services/billing/chargeback_validator.py"], capture=False)
+        return True
+    except Exception:
+        logger.exception("Billing/chargeback validation failed")
+        return False
+
+def verify_explainability_index_and_acl():
+    logger.info("Verifying explainability index & ACLs")
+    try:
+        run_cmd(["python3", "services/explainability/verify_index_acl_and_attachment.py"], capture=False)
+        return True
+    except Exception:
+        logger.exception("Explainability verification failed")
+        return False
+
+def collect_long_term_slo_snapshot():
+    logger.info("Collecting long-term SLO snapshot")
+    try:
+        run_cmd(["python3", "services/reliability/collect_long_term_slo.py"], capture=False)
+        return True
+    except Exception:
+        logger.exception("SLO collection failed")
+        return False
+
+def bundle_and_sign_all():
+    logger.info("Bundling and signing evidence")
+    try:
+        # collect standard prefixes into a bundle and sign
+        run_cmd(["python3", "services/evidence/evidence_bundler_sign.py", "/tmp"], capture=False)
+        # cosign script for last bundle
+        run_cmd(["bash", "ops/scripts/cosign_sign_evidence_bundle.sh"], capture=False)
+        return True
+    except Exception:
+        logger.exception("Evidence bundling/signing failed")
+        return False
+
+def produce_final_audit():
+    logger.info("Producing final audit via audit_collector")
+    try:
+        run_cmd(["python3", "services/compliance/audit_collector.py"], capture=False)
+        run_cmd(["python3", "services/compliance/audit_verifier.py"], capture=False)
+        return True
+    except Exception:
+        logger.exception("Audit production failed")
+        return False
+
+def main():
+    report={"start": datetime.utcnow().isoformat(), "steps": {}}
+    # 1. HPO
+    submit_distributed_hpo(total_trials=int(os.environ.get("HPO_TOTAL_TRIALS", "256")),
+                           per_job=int(os.environ.get("HPO_TRIALS_PER_JOB", "8")),
+                           checkpoint_s3=os.environ.get("CHECKPOINT_S3", "s3://aegis-checkpoints"),
+                           team=os.environ.get("HPO_TEAM", "validation"))
+    report["steps"]["hpo_submitted"] = True
+
+    # Wait time for jobs to run; in production this should poll job status / Tekton
+    logger.info("Waiting for HPO jobs to run (adaptive wait)...")
+    time.sleep(int(os.environ.get("HPO_WAIT_SECONDS", "300")))
+
+    # 2. checkpoint validation
+    ok_chk = validate_checkpoints()
+    report["steps"]["checkpoint_validation"] = ok_chk
+
+    # 3. 2k simulator
+    ok_sim2k = run_2k_simulator()
+    report["steps"]["2k_simulator"] = ok_sim2k
+
+    # 4. long-shadow
+    ok_long = run_long_shadow(int(os.environ.get("LONG_SHADOW_HOURS", "720")))  # default 30d accelerated
+    report["steps"]["long_shadow"] = ok_long
+
+    # 5. OTEL coverage
+    ok_otel, otel_report = run_otel_coverage()
+    report["steps"]["otel_coverage"] = {"ok": ok_otel, "report": otel_report}
+
+    # 6. OPA harness
+    ok_opa, opa_report = run_opa_harness()
+    report["steps"]["opa_harness"] = {"ok": ok_opa, "report": opa_report}
+
+    # 7. remediation metrics
+    ok_rem, rem_stats = remediation_metrics_check()
+    report["steps"]["remediation_metrics"] = {"ok": ok_rem, "stats": rem_stats}
+
+    # 8. pen-test + terraform plan
+    ok_pentest = run_pen_test_and_plan()
+    report["steps"]["pen_test_and_terraform_plan"] = ok_pentest
+
+    # 9. billing & multi-tenant stress
+    ok_billing = run_multi_tenant_stress_and_chargeback()
+    report["steps"]["billing_and_stress"] = ok_billing
+
+    # 10. explainability checks
+    ok_explain = verify_explainability_index_and_acl()
+    report["steps"]["explainability_check"] = ok_explain
+
+    # 11. long-term SLO snapshot
+    ok_slo = collect_long_term_slo_snapshot()
+    report["steps"]["long_term_slo_snapshot"] = ok_slo
+
+    # 12. bundle & sign
+    ok_bundle = bundle_and_sign_all()
+    report["steps"]["evidence_bundle"] = ok_bundle
+
+    # 13. final audit
+    ok_audit = produce_final_audit()
+    report["steps"]["audit"] = ok_audit
+
+    report["finished"] = datetime.utcnow().isoformat()
+    summary_path = "/tmp/production_proofs_summary.json"
+    open(summary_path, "w").write(json.dumps(report, indent=2))
+    logger.info("Wrote summary to %s", summary_path)
+    # upload summary
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        key=f"production_proofs/summary-{int(time.time())}.json"
+        s3.upload_file(summary_path, EVIDENCE_BUCKET.replace("s3://",""), key)
+        logger.info("Uploaded summary to s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
+
+    # Evaluate final acceptance
+    all_ok = all([
+        report["steps"]["checkpoint_validation"],
+        report["steps"]["2k_simulator"],
+        report["steps"]["long_shadow"],
+        report["steps"]["otel_coverage"]["ok"],
+        report["steps"]["opa_harness"]["ok"],
+        report["steps"]["remediation_metrics"]["ok"],
+        report["steps"]["billing_and_stress"],
+        report["steps"]["explainability_check"],
+        report["steps"]["evidence_bundle"],
+        report["steps"]["audit"]
+    ])
+    if not all_ok:
+        logger.error("One or more acceptance checks failed. Review the summary and postmortems in the evidence bucket.")
+        sys.exit(2)
+    logger.info("Production proofs completed successfully. You can promote Gatekeeper & enable auto-promote for low-risk classes.")
+
+if __name__ == "__main__":
+    main()
+
