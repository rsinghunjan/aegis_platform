+#!/usr/bin/env python3
+"""
+Remediation Test Harness:
+ - Simulates common Tekton failure scenarios and measures remediation_engine effectiveness.
+ - Writes a remediation roundtrip report to the evidence bucket.
+"""
+import os, time, json, logging, subprocess
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger=logging.getLogger("remediation-test")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+
+def create_failed_pr(name):
+    # Create a PipelineRun that intentionally fails (PoC: reference non-existent task)
+    pr = {
+        "apiVersion": "tekton.dev/v1beta1",
+        "kind": "PipelineRun",
+        "metadata": {"generateName": f"remed-fail-{name}-"},
+        "spec": {"pipelineRef": {"name": "nonexistent-pipeline"}}
+    }
+    import tempfile, yaml
+    f=tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.safe_dump(pr).encode()); f.close()
+    subprocess.check_output(["kubectl", "-n", TEKTON_NS, "apply", "-f", f.name]).decode()
+
+def measure_remediation(rounds=5, interval=10):
+    records=[]
+    for i in range(rounds):
+        logger.info("Creating failed PipelineRun #%d", i)
+        create_failed_pr(i)
+        logger.info("Waiting %d seconds for remediation engine to act", interval)
+        time.sleep(interval)
+        # collect remediation evidence entries for today
+        if EVIDENCE_BUCKET:
+            import boto3
+            s3=boto3.client("s3")
+            bucket=EVIDENCE_BUCKET.replace("s3://","")
+            resp=s3.list_objects_v2(Bucket=bucket, Prefix="remediation/", MaxKeys=100)
+            records.append(resp.get("KeyCount",0))
+        else:
+            records.append({"note":"no evidence bucket"})
+    report={"ts":datetime.utcnow().isoformat(), "samples": records}
+    path="/tmp/remediation_test_report.json"
+    open(path,"w").write(json.dumps(report, indent=2))
+    if EVIDENCE_BUCKET:
+        s3=boto3.client("s3")
+        s3.upload_file(path, EVIDENCE_BUCKET.replace("s3://",""), f"remediation/test-report-{int(time.time())}.json")
+    print(json.dumps(report, indent=2))
+
+if __name__ == "__main__":
+    measure_remediation()
+
