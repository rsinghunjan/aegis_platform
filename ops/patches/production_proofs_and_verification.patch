+#!/usr/bin/env python3
+"""
+Exercise auto-promote controller at scale by simulating canary evaluations.
+This script will submit N fake canary evaluation PipelineRun objects (or create minimal canary JSONs)
+tagged with job-type=canary-eval to trigger the auto-promote controller in the cluster.
+It will then gather resulting auto-promote evidence from S3 and validate signatures.
+"""
+import os, time, json, subprocess, logging
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger=logging.getLogger("exercise-auto-promote")
+
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+NUM = int(os.environ.get("AUTO_PROMOTE_EXERCISE_COUNT", "50"))
+
+def create_minimal_pipelinerun(i):
+    pr = {
+        "apiVersion": "tekton.dev/v1beta1",
+        "kind": "PipelineRun",
+        "metadata": {"generateName": f"canary-eval-sim-{i}-", "labels": {"job-type": "canary-eval"}},
+        "spec": {"pipelineRef": {"name": "canary-eval"}, "params": [{"name": "run_id", "value": f"sim-run-{i}"}]}
+    }
+    import tempfile, yaml
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.safe_dump(pr).encode()); f.close()
+    out = subprocess.check_output(["kubectl", "apply", "-n", TEKTON_NS, "-f", f.name]).decode()
+    logger.info("Created PipelineRun: %s", out.strip())
+
+def main():
+    for i in range(NUM):
+        create_minimal_pipelinerun(i)
+        time.sleep(0.5)
+    logger.info("Created %d simulated canary PipelineRuns. Wait for auto-promote controller to process.", NUM)
+    # wait for controller to act
+    time.sleep(60)
+    # Optionally fetch evidence from S3 to confirm auto-promotes recorded
+    if EVIDENCE_BUCKET:
+        import boto3
+        s3=boto3.client("s3")
+        bucket=EVIDENCE_BUCKET.replace("s3://","")
+        resp = s3.list_objects_v2(Bucket=bucket, Prefix="autopromote/")
+        items = resp.get("Contents",[])
+        logger.info("Found %d autopromote evidence objects", len(items))
+    logger.info("Finished exercise")
+
+if __name__ == "__main__":
+    main()
+
