+"""
+Simple Triton warmup script to preload and warm model for dynamic batching performance.
+Call this after model is loaded to generate a few batched requests and keep model resident.
+"""
+import time, requests, json, os
+
+TRITON_URL = os.environ.get("TRITON_URL", "http://triton-server.inference:8000")
+MODEL_NAME = os.environ.get("TRITON_MODEL", "ternary_model")
+BATCH_SIZES = [1,4,8,16]
+
+def warmup():
+    for b in BATCH_SIZES:
+        # craft a fake request: this depends on your model's expected input shape
+        data = {
+            "inputs": [
+                {
+                    "name": "INPUT_IDS",
+                    "shape": [b, 16],
+                    "datatype": "INT32",
+                    "data": [[101]*16 for _ in range(b)]
+                }
+            ]
+        }
+        url = f"{TRITON_URL}/v2/models/{MODEL_NAME}/infer"
+        try:
+            r = requests.post(url, json=data, timeout=10)
+            print("Warmup batch", b, "status", r.status_code)
+        except Exception as e:
+            print("Warmup failed", e)
+        time.sleep(1)
+
+if __name__ == "__main__":
+    warmup()
+
