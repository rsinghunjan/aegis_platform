+"""
+Traffic split controller for Istio VirtualService weight tuning.
+ - Adjusts weights between student/teacher models based on drift/quality signals.
+ - Requires `kubectl` and `jq` or use Kubernetes python client.
+"""
+import os, subprocess, json
+
+VS_NAME = os.environ.get("VIRTUAL_SERVICE", "model-gateway")
+NS = os.environ.get("VIRTUAL_SERVICE_NS", "inference")
+
+def set_weights(student_pct):
+    teacher_pct = max(0, 100 - int(student_pct))
+    patch = {
+        "spec": {
+            "http": [
+                {
+                    "route": [
+                        {"destination": {"host": "student-service.inference.svc.cluster.local", "port": {"number": 80}}, "weight": student_pct},
+                        {"destination": {"host": "teacher-service.inference.svc.cluster.local", "port": {"number": 80}}, "weight": teacher_pct}
+                    ]
+                }
+            ]
+        }
+    }
+    cmd = ["kubectl", "patch", "virtualservice", VS_NAME, "-n", NS, "--type=merge", "-p", json.dumps(patch)]
+    subprocess.check_call(cmd)
+    print(f"Set student:{student_pct}% teacher:{teacher_pct}%")
+
+if __name__=="__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--student", type=int, default=80)
+    args = p.parse_args()
+    set_weights(args.student)
+
