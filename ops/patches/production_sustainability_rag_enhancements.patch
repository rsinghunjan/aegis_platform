+"""
+Microbenchmark harness for ternary GEMM kernel.
+ - Calls the compiled shared library (ternary_gemm) via ctypes and measures throughput.
+ - Fallback to CPU numpy matmul for baseline comparison.
+"""
+import ctypes, os, time, numpy as np
+
+LIB_PATH = os.environ.get("TERNARY_LIB", "ops/sustainability/ternary_kernel_bench/libternary_gemm.so")
+
+def load_lib(path):
+    if not os.path.exists(path):
+        print("Kernel library not found:", path); return None
+    return ctypes.CDLL(path)
+
+def bench_cpu(m, k, n):
+    a = np.random.randn(m,k).astype(np.float32)
+    b = np.random.randn(k,n).astype(np.float32)
+    t0 = time.time()
+    for _ in range(10):
+        _ = a.dot(b)
+    t1 = time.time()
+    return (t1-t0)/10.0
+
+def main():
+    print("Baseline CPU microbenchmark")
+    cpu_lat = bench_cpu(512,512,512)
+    print("Avg CPU matmul time (s):", cpu_lat)
+    lib = load_lib(LIB_PATH)
+    if lib:
+        print("Native kernel present. Please run custom harness linking to ternary input format.")
+
+if __name__=="__main__":
+    main()
+
