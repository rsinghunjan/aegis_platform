+"""
+Redis-backed embedding cache for fast reuse and to avoid repeated encoding cost.
+ - Uses a simple string key schema: "emb:{doc_id}" for stored embeddings (base64 or binary)
+ - Provides get_embeddings(ids) and set_embedding(id, vector)
+ - TTL support to prune stale entries
+"""
+import os, base64, json
+import numpy as np
+try:
+    import redis
+    REDIS_OK = True
+except Exception:
+    REDIS_OK = False
+
+REDIS_URL = os.environ.get("EMB_REDIS_URL", "redis://localhost:6379/0")
+EMB_DIM = int(os.environ.get("EMB_DIM", "384"))
+
+class EmbeddingCache:
+    def __init__(self, url=REDIS_URL):
+        if not REDIS_OK:
+            raise RuntimeError("redis python client not installed")
+        self.r = redis.from_url(url)
+
+    def set_embedding(self, doc_id: str, vec: np.ndarray, ttl: int = 3600*24*7):
+        # store as raw bytes (float32)
+        b = vec.astype(np.float32).tobytes()
+        self.r.set(f"emb:{doc_id}", b, ex=ttl)
+
+    def get_embedding(self, doc_id: str):
+        b = self.r.get(f"emb:{doc_id}")
+        if not b:
+            return None
+        return np.frombuffer(b, dtype=np.float32)
+
+    def get_many(self, ids):
+        out = {}
+        pipe = self.r.pipeline()
+        for i in ids: pipe.get(f"emb:{i}")
+        res = pipe.execute()
+        for i,v in zip(ids,res):
+            if v: out[i] = np.frombuffer(v, dtype=np.float32)
+        return out
+
+if __name__ == "__main__":
+    if REDIS_OK:
+        c = EmbeddingCache()
+        import numpy as np
+        v = np.random.randn(EMB_DIM).astype(np.float32)
+        c.set_embedding("doc1", v)
+        print("Got", c.get_embedding("doc1"))
+    else:
+        print("redis not installed")
+
