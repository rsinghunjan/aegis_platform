+#!/usr/bin/env python3
+"""
+Small utility to annotate Tekton PipelineRun objects with run_id and inject tracing annotations so tasks inherit run_id.
+ - Monitors PipelineRun creation events and patches the PipelineRun and child pods with run_id label/annotation.
+ - Simple implementation using kubectl watch (PoC). Deploy as a Deployment in cluster for production.
+"""
+import subprocess, json, time, logging
+
+logger = logging.getLogger("tekton-tracer-injector")
+logging.basicConfig(level=logging.INFO)
+
+NS = "cicd"
+
+def watch_loop():
+    p = subprocess.Popen(["kubectl","-n",NS,"get","pipelineruns","-o","json","--watch"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    try:
+        for line in p.stdout:
+            try:
+                # quick approach: re-scan all PipelineRuns and ensure they have run_id annotation
+                out = subprocess.check_output(["kubectl","-n",NS,"get","pipelineruns","-o","json"]).decode()
+                obj = json.loads(out)
+                for pr in obj.get("items", []):
+                    name = pr["metadata"]["name"]
+                    ann = pr["metadata"].get("annotations", {})
+                    if not ann.get("aegis.run_id"):
+                        run_id = f"run-{int(time.time())}"
+                        subprocess.check_call(["kubectl","-n",NS,"annotate","pipelinerun",name, f"aegis.run_id={run_id}", "--overwrite"])
+                        logger.info("Annotated PipelineRun %s with run_id=%s", name, run_id)
+                        # label child pods after a short delay
+                        time.sleep(2)
+                        pods = json.loads(subprocess.check_output(["kubectl","-n",NS,"get","pods","-o","json"]).decode()).get("items",[])
+                        for pinfo in pods:
+                            owners = pinfo.get("metadata", {}).get("ownerReferences", [])
+                            if any(o.get("name","").startswith(name) for o in owners):
+                                podname = pinfo["metadata"]["name"]
+                                subprocess.check_call(["kubectl","-n",NS,"label","pod",podname, f"run_id={run_id}", "--overwrite"])
+            except Exception:
+                logger.exception("watch handling error")
+            time.sleep(5)
+    finally:
+        p.terminate()
+
+if __name__ == "__main__":
+    watch_loop()
+
