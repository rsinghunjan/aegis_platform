+#!/usr/bin/env python3
+"""
+Standardized explainability storage & API helpers:
+ - Accepts per-inference explanation payloads (model_id, input_hash, explanation vector, metadata)
+ - Stores JSON in S3 under explainability/<model_id>/<input_hash>.json and records metadata in a small index (DynamoDB or S3 index)
+ - Provides simple access control check (Keycloak token) when retrieving
+"""
+import os, json, hashlib, boto3, logging
+from fastapi import FastAPI, HTTPException, Request
+
+app = FastAPI()
+logger = logging.getLogger("explain-store")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+s3 = boto3.client("s3") if EVIDENCE_BUCKET else None
+
+def _key(model_id, input_hash):
+    return f"explainability/{model_id}/{input_hash}.json"
+
+@app.post("/store")
+async def store(payload: dict):
+    model_id = payload.get("model_id")
+    inp = payload.get("input")
+    explanation = payload.get("explanation")
+    if not (model_id and inp and explanation):
+        raise HTTPException(status_code=400, detail="model_id,input,explanation required")
+    input_hash = hashlib.sha256(json.dumps(inp, sort_keys=True).encode()).hexdigest()
+    obj = {"model_id": model_id, "input_hash": input_hash, "explanation": explanation, "meta": payload.get("meta",{}), "ts": int(time.time())}
+    if not s3:
+        path = f"/tmp/explain-{model_id}-{input_hash}.json"
+        with open(path,"w") as f: json.dump(obj,f)
+        return {"local": path}
+    key = _key(model_id, input_hash)
+    s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(obj).encode())
+    return {"s3": f"s3://{EVIDENCE_BUCKET}/{key}"}
+
+@app.get("/fetch/{model_id}/{input_hash}")
+def fetch(model_id: str, input_hash: str, authorization: str = ""):
+    # PoC access control: in prod validate token with Keycloak introspection and check claims
+    if not s3:
+        path = f"/tmp/explain-{model_id}-{input_hash}.json"
+        try:
+            with open(path) as f: return json.load(f)
+        except Exception:
+            raise HTTPException(status_code=404)
+    key = _key(model_id, input_hash)
+    try:
+        obj = s3.get_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key)
+        return json.loads(obj["Body"].read())
+    except Exception:
+        raise HTTPException(status_code=404)
+
