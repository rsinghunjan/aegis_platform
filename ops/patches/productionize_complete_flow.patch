+#!/usr/bin/env python3
+"""
+Enhanced labeling ingestion service for production.
+ - Validates Label Studio exports, writes to versioned dataset path with manifest
+ - Notifies dataset catalog (Marquez) and triggers retrain pipeline with dataset_snapshot param
+ - Uploads evidence of ingestion and dataset version manifest
+"""
+from fastapi import FastAPI, HTTPException, Request
+import os, boto3, tempfile, subprocess, json, logging
+import pandas as pd
+from datetime import datetime
+
+app = FastAPI()
+logger = logging.getLogger("labeling-ingest-v2")
+logging.basicConfig(level=logging.INFO)
+
+S3 = boto3.client("s3")
+DATASET_PREFIX = os.environ.get("DATASET_PREFIX", "s3://aegis-data/datasets")
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+RETRAIN_PIPELINE = os.environ.get("RETRAIN_PIPELINE", "drift-retrain-canary-pipeline")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+MARQUEZ_URL = os.environ.get("MARQUEZ_URL","http://marquez.backend:5000")
+
+def upload_evidence(path, payload):
+    if not EVIDENCE_BUCKET:
+        p = f"/tmp/{path.replace('/','_')}-{int(time.time())}.json"
+        with open(p,"w") as f: json.dump(payload,f); return p
+    key = f"labeling/{path}/{int(time.time())}.json"
+    S3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=json.dumps(payload).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+def notify_marquez(dataset_uri, dataset_name):
+    payload = {"namespace": "aegis", "name": dataset_name, "physical_name": dataset_uri}
+    try:
+        import requests
+        r = requests.post(f"{MARQUEZ_URL}/api/v1/datasets", json=payload, timeout=10)
+        r.raise_for_status()
+    except Exception:
+        logger.exception("Failed to notify Marquez")
+
+@app.post("/ingest")
+async def ingest(req: Request):
+    body = await req.json()
+    export_s3 = body.get("export_s3")
+    if not export_s3:
+        raise HTTPException(status_code=400, detail="export_s3 required")
+    bucket,key = export_s3.replace("s3://","").split("/",1)
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".json").name
+    S3.download_file(bucket, key, tmp)
+    df = pd.read_json(tmp)
+    version = datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
+    ds_bucket, ds_prefix = DATASET_PREFIX.replace("s3://","").split("/",1)
+    dest_key = f"{ds_prefix}/labeled/version={version}/part-0.parquet"
+    pq = tmp + ".parquet"
+    df.to_parquet(pq, index=False)
+    S3.upload_file(pq, ds_bucket, dest_key)
+    dataset_uri = f"s3://{ds_bucket}/{dest_key}"
+    manifest = {"dataset": dataset_uri, "version": version, "rows": len(df)}
+    upload_evidence("labeling/ingest", {"export": export_s3, "manifest": manifest})
+    notify_marquez(dataset_uri, f"labeled_dataset_v{version}")
+    # trigger retrain pipeline with dataset_snapshot_s3 param
+    import yaml, tempfile, subprocess
+    pr = {
+      "apiVersion": "tekton.dev/v1beta1",
+      "kind": "PipelineRun",
+      "metadata": {"generateName": "labeling-trigger-run-"},
+      "spec": {"pipelineRef": {"name": RETRAIN_PIPELINE},
+               "params":[{"name":"dataset_snapshot_s3","value": dataset_uri}, {"name":"evidence_bucket","value": EVIDENCE_BUCKET}]}
+    }
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(yaml.safe_dump(pr).encode()); f.close()
+    subprocess.check_call(["kubectl","apply","-n",TEKTON_NS,"-f",f.name])
+    return {"ok":True, "dataset": dataset_uri, "manifest": manifest}
+
