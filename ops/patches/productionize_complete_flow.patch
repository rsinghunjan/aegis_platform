+        html += f"<li>{p['id']} - {p.get('summary','')} - <form method='post' action='/approve/{p['id']}' style='display:inline'><button type='submit'>Approve</button></form></li>"
+    html += "</ul>"
+    return HTMLResponse(html)
+
+@app.post("/approve/{req_id}")
+def approve(req_id: str, authorization: str = ""):
+    if not authorization:
+        # in PoC we skip auth; in prod validate via Keycloak
+        token = None
+    else:
+        token = authorization
+    r = requests.put(f"{APPROVAL_SERVICE}/approve/{req_id}", headers={"Authorization": token or ""})
+    if r.status_code != 200:
+        raise HTTPException(status_code=400, detail="approve failed")
+    return RedirectResponse("/", status_code=303)
