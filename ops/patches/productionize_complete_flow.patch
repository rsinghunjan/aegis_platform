+#!/usr/bin/env python3
+"""
+Production closed-loop manager (orchestrator).
+Features:
+ - Trigger Tekton PipelineRun for retrain/HPO/validate/package/deploy-canary
+ - Monitor PipelineRun via kubectl/Tekton API, collect logs, artifacts and evidence
+ - Request SME approval via Approval Service when needed
+ - Auto-promote or abort based on canary metrics or SME decision
+ - Uploads signed evidence bundles to EVIDENCE_BUCKET
+
+Notes:
+ - This is a robust orchestrator for production usage; in production deploy with K8s ServiceAccount
+   that has read access to Tekton resources, pods, and ability to upload to S3.
+ - Correlates everything with run_id and stores evidence under evidence_bucket/closedloop/<run_id>/
+"""
+import os
+import time
+import json
+import subprocess
+import tempfile
+import logging
+from datetime import datetime
+
+logger = logging.getLogger("closed-loop-prod")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+TEKTON_NS = os.environ.get("TEKTON_NAMESPACE", "cicd")
+APPROVAL_SERVICE = os.environ.get("APPROVAL_SERVICE_URL", "http://approval-service.monitoring.svc:8080")
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+CANARY_DEPLOYMENT = os.environ.get("CANARY_DEPLOYMENT", "model-canary")
+CANARY_METRIC = os.environ.get("CANARY_METRIC", 'sum(rate(model_success_count{app="${CANARY}"}[1m]))')
+CANARY_REL_DROP = float(os.environ.get("CANARY_REL_DROP", "0.1"))
+SME_TIMEOUT = int(os.environ.get("SME_TIMEOUT", "3600"))
+
+def upload_evidence_dir(run_id, local_dir):
+    """Upload all files in local_dir to S3 under evidence path for the run."""
+    if not EVIDENCE_BUCKET:
+        logger.info("No EVIDENCE_BUCKET configured; evidence kept locally at %s", local_dir)
+        return local_dir
+    import boto3
+    s3 = boto3.client("s3")
+    prefix = f"closedloop/{run_id}/"
+    for root, _, files in os.walk(local_dir):
+        for f in files:
+            path = os.path.join(root, f)
+            key = prefix + os.path.relpath(path, local_dir)
+            s3.upload_file(path, EVIDENCE_BUCKET.replace("s3://",""), key)
+    uri = f"s3://{EVIDENCE_BUCKET}/closedloop/{run_id}/"
+    logger.info("Uploaded evidence to %s", uri)
+    return uri
+
+def create_pipeline_run(pipeline_name, params):
+    pr = {
+        "apiVersion": "tekton.dev/v1beta1",
+        "kind": "PipelineRun",
+        "metadata": {"generateName": f"{pipeline_name}-run-"},
+        "spec": {
+            "pipelineRef": {"name": pipeline_name},
+            "params": [{"name": k, "value": v} for k, v in (params or {}).items()]
+        }
+    }
+    import yaml
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    tmp.write(yaml.safe_dump(pr).encode()); tmp.close()
+    out = subprocess.check_output(["kubectl","apply","-n",TEKTON_NS,"-f", tmp.name]).decode()
+    logger.info("Created PipelineRun: %s", out)
+    # extract pipelinerun name
+    for line in out.splitlines():
+        if "pipelinerun.tekton.dev/" in line:
+            name = line.split()[0].split("/")[1]
+            return name
+    return None
+
+def wait_for_pipelinerun(pr_name, poll=10, timeout=3600):
+    start = time.time()
+    while time.time() - start < timeout:
+        try:
+            out = subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","pipelinerun", pr_name, "-o", "json"]).decode()
+            obj = json.loads(out)
+            conds = obj.get("status", {}).get("conditions", [])
+            if conds:
+                state = conds[0].get("status")
+                reason = conds[0].get("reason", "")
+                logger.info("PipelineRun %s status=%s reason=%s", pr_name, state, reason)
+                if state == "True":
+                    return True, obj
+                if state == "False":
+                    return False, obj
+        except Exception:
+            logger.exception("Error reading PipelineRun")
+        time.sleep(poll)
+    logger.warning("PipelineRun wait timed out")
+    return False, {}
+
+def collect_pipelinerun_artifacts(pr_name, target_dir):
+    os.makedirs(target_dir, exist_ok=True)
+    # collect pod logs for tasks
+    out = subprocess.check_output(["kubectl","-n",TEKTON_NS,"get","pods","-o","json"]).decode()
+    pods = json.loads(out).get("items", [])
+    for p in pods:
+        owners = p.get("metadata", {}).get("ownerReferences", [])
+        if any(o.get("kind","") == "PipelineRun" and o.get("name","") == pr_name for o in owners):
+            podname = p["metadata"]["name"]
+            try:
+                logs = subprocess.check_output(["kubectl","-n",TEKTON_NS,"logs", podname], stderr=subprocess.STDOUT).decode()
+            except Exception as e:
+                logs = f"error collecting logs: {e}"
+            with open(os.path.join(target_dir, f"{podname}.log"), "w") as f:
+                f.write(logs)
+    return target_dir
+
+def query_prometheus(expr):
+    import requests
+    try:
+        r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": expr}, timeout=10)
+        r.raise_for_status()
+        data = r.json()
+        if data.get("data", {}).get("result"):
+            return float(data["data"]["result"][0]["value"][1])
+    except Exception:
+        logger.exception("Prometheus query failed")
+    return 0.0
+
+def evaluate_canary():
+    canary_expr = CANARY_METRIC.replace("${CANARY}", CANARY_DEPLOYMENT)
+    baseline_expr = CANARY_METRIC.replace("${CANARY}", "production-model")
+    canary_v = query_prometheus(canary_expr)
+    base_v = query_prometheus(baseline_expr)
+    if base_v <= 0:
+        return False, {"reason":"baseline_missing"}
+    rel_drop = (base_v - canary_v) / base_v
+    return (rel_drop <= CANARY_REL_DROP), {"rel_drop": rel_drop, "canary":canary_v, "baseline":base_v}
+
+def request_approval(evidence_uri, summary):
+    import requests
+    payload = {"summary": summary, "evidence_uri": evidence_uri}
+    r = requests.post(f"{APPROVAL_SERVICE}/request", json=payload, timeout=10)
+    r.raise_for_status()
+    return r.json().get("id")
+
+def poll_approval(req_id, timeout=SME_TIMEOUT, poll=15):
+    import requests
+    start = time.time()
+    while time.time() - start < timeout:
+        r = requests.get(f"{APPROVAL_SERVICE}/status/{req_id}", timeout=10)
+        if r.status_code == 200:
+            st = r.json()
+            if st.get("state") == "approved":
+                return True, st
+        time.sleep(poll)
+    return False, {}
+
+def run_cycle(pipeline="drift-retrain-canary-pipeline", params=None):
+    run_id = f"run-{int(time.time())}"
+    tmpdir = tempfile.mkdtemp(prefix=f"closedloop-{run_id}-")
+    upload_evidence_dir(run_id, tmpdir)  # create base entry
+    pr_name = create_pipeline_run(pipeline, params or {"evidence_bucket": EVIDENCE_BUCKET})
+    if not pr_name:
+        upload_evidence_dir(run_id, tmpdir)
+        return False
+    ok, pr_obj = wait_for_pipelinerun(pr_name, poll=15, timeout=7200)
+    collect_pipelinerun_artifacts(pr_name, tmpdir)
+    ev_uri = upload_evidence_dir(run_id, tmpdir)
+    if ok:
+        # evaluate canary
+        passed, info = evaluate_canary()
+        if passed:
+            # auto-promote
+            upload_evidence_dir(run_id, tmpdir)
+            # call promotion pipeline or publish to Baseten
+            create_pipeline_run("promote-model-to-baseten", {"model_id": run_id, "model_name": run_id, "artifact_s3":"", "evidence_bucket": EVIDENCE_BUCKET})
+            return True
+        else:
+            # request SME approval
+            req_id = request_approval(ev_uri, "Canary degraded, SME review required")
+            approved, st = poll_approval(req_id)
+            if approved:
+                create_pipeline_run("promote-model-to-baseten", {"model_id": run_id, "model_name": run_id, "artifact_s3":"", "evidence_bucket": EVIDENCE_BUCKET})
+                return True
+            else:
+                logger.warning("SME did not approve; aborting run %s", run_id)
+                return False
+    else:
+        upload_evidence_dir(run_id, tmpdir)
+        logger.error("PipelineRun failed; evidence at %s", ev_uri)
+        return False
+
+if __name__ == "__main__":
+    # run continuously if RUN_LOOP set
+    if os.environ.get("RUN_LOOP","false").lower()=="true":
+        while True:
+            try:
+                run_cycle()
+            except Exception:
+                logger.exception("Cycle failed")
+            time.sleep(int(os.environ.get("CYCLE_INTERVAL", "600")))
+    else:
+        run_cycle()
+
