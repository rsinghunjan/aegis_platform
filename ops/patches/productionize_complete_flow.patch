+#!/usr/bin/env python3
+"""
+Invoice watcher and enforcement
+ - Watches S3 prefix invoices/ for provider invoice CSVs
+ - Reconciles via billing_invoice_linker.process_csv
+ - Updates BillingRecord.actual_cost and triggers enforcement worker if caps exceeded
+ - Uploads reconciliation manifest and alerts via webhook
+"""
+import os, time, logging
+import boto3
+from services.quantum.billing_invoice_linker import process_csv
+from prometheus_client import Counter
+
+logger = logging.getLogger("invoice-watcher")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET","")
+INVOICE_PREFIX = "invoices/"
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK","")
+PROCESS_COUNT = Counter("aegis_invoices_processed_total", "Processed invoice CSVs")
+
+def run_loop(interval=60):
+    s3 = boto3.client("s3")
+    seen = set()
+    bucket = EVIDENCE_BUCKET.replace("s3://","")
+    while True:
+        resp = s3.list_objects_v2(Bucket=bucket, Prefix=INVOICE_PREFIX)
+        for obj in resp.get("Contents", []):
+            key = obj["Key"]
+            if not key.lower().endswith(".csv"): continue
+            if key in seen: continue
+            tmp = f"/tmp/{os.path.basename(key)}"
+            s3.download_file(bucket, key, tmp)
+            try:
+                process_csv(tmp)
+                PROCESS_COUNT.inc()
+                seen.add(key)
+                # move to processed
+                dest = key.replace(INVOICE_PREFIX, "invoices/processed/")
+                s3.copy_object(Bucket=bucket, CopySource={'Bucket':bucket,'Key':key}, Key=dest)
+                s3.delete_object(Bucket=bucket, Key=key)
+                if ALERT_WEBHOOK:
+                    import requests
+                    requests.post(ALERT_WEBHOOK, json={"invoice": key}, timeout=5)
+            except Exception:
+                logger.exception("Failed to process invoice %s", key)
+        time.sleep(interval)
+
+if __name__ == "__main__":
+    run_loop()
+
