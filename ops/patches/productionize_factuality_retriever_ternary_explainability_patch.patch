+"""
+Index lifecycle manager:
+ - monitors the source corpus manifest (S3 path or git ref)
+ - triggers reindex when corpus changes (diff based on manifest hash)
+ - supports scheduled refresh cadence and shard pruning
+ - writes index metadata to persistent registry (Postgres or a JSON file)
+"""
+import os, time, json, hashlib
+from ops.retriever.milvus_retriever import Retriever
+
+MANIFEST_PATH = os.environ.get("CORPUS_MANIFEST", "/data/corpus_manifest.json")
+POLL_INTERVAL = int(os.environ.get("INDEX_POLL_INTERVAL", "300"))
+REGISTRY_PATH = os.environ.get("INDEX_REGISTRY_PATH", "/data/index_registry.json")
+
+def manifest_hash(path):
+    if not os.path.exists(path):
+        return None
+    h = hashlib.sha256()
+    for line in open(path, "rb"):
+        h.update(line)
+    return h.hexdigest()
+
+def main_loop():
+    last_hash = None
+    retriever = Retriever()
+    while True:
+        cur_hash = manifest_hash(MANIFEST_PATH)
+        if cur_hash and cur_hash != last_hash:
+            print("Manifest changed, reindexing...")
+            # manifest expected format: [{"id":"doc1","text":"...","source":"s3://...","version":"v1"}, ...]
+            docs = json.load(open(MANIFEST_PATH))
+            retriever.upsert_documents(docs)
+            meta = {"last_indexed": time.time(), "manifest_hash": cur_hash, "count": len(docs)}
+            json.dump(meta, open(REGISTRY_PATH, "w"), indent=2)
+            last_hash = cur_hash
+        time.sleep(POLL_INTERVAL)
+
+if __name__=="__main__":
+    main_loop()
+
