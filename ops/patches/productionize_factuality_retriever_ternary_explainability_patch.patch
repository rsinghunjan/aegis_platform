+"""
+Fine-tune a seq2seq verifier model (BART/T5) or NLI model on claim-evidence datasets (FEVER or domain dataset).
+Produces a verifier model and a calibrated threshold file (verifier_threshold.json).
+
+Usage:
+  python services/factuality/finetune_verifier.py --data ./data/fever_train.jsonl --out_dir ./out/verifier --model_name facebook/bart-large
+
+Notes:
+ - Expects data lines: {"claim": "...", "evidence": "..." , "label": "support"/"contradict"/"neutral"}
+ - Tune --batch_size/--epochs for your infra. Use HF Trainer for distributed training.
+"""
+import argparse, os, json
+from datasets import load_dataset, Dataset
+from transformers import AutoTokenizer, AutoModelForSequenceClassification, Trainer, TrainingArguments
+import numpy as np
+
+def load_jsonl(path):
+    rows = []
+    with open(path) as f:
+        for line in f:
+            rows.append(json.loads(line))
+    return rows
+
+def prepare_dataset(rows, tokenizer, max_len=256):
+    texts_a = [r["evidence"] for r in rows]
+    texts_b = [r["claim"] for r in rows]
+    labels_map = {"contradict":0,"neutral":1,"support":2}
+    labels = [labels_map.get(r.get("label","neutral"),1) for r in rows]
+    ds = Dataset.from_dict({"evidence":texts_a,"claim":texts_b,"label":labels})
+    def tokenize_fn(ex):
+        return tokenizer(ex["evidence"], ex["claim"], truncation=True, padding="max_length", max_length=max_len)
+    ds = ds.map(tokenize_fn, batched=True)
+    ds = ds.rename_column("label","labels")
+    ds.set_format(type="torch", columns=["input_ids","attention_mask","labels"])
+    return ds
+
+def calibrate_threshold(trainer, ds_eval, out_path):
+    # compute scores on eval set and pick threshold maximizing F1 for 'support' (label 2) vs others
+    import torch
+    preds = trainer.predict(ds_eval)
+    logits = preds.predictions
+    probs = torch.softmax(torch.tensor(logits), dim=1).numpy()[:,2]  # support prob
+    labels = preds.label_ids
+    best_f1 = 0.0
+    best_th = 0.5
+    from sklearn.metrics import f1_score
+    for th in np.linspace(0.1,0.9,41):
+        preds_bin = (probs >= th).astype(int)
+        labels_bin = (labels==2).astype(int)
+        f1 = f1_score(labels_bin, preds_bin, zero_division=0)
+        if f1 > best_f1:
+            best_f1 = f1; best_th = float(th)
+    json.dump({"best_threshold": best_th, "best_f1": best_f1}, open(out_path,"w"), indent=2)
+    print("Wrote threshold:", out_path)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--data", required=True)
+    p.add_argument("--out_dir", default="./out/verifier")
+    p.add_argument("--model_name", default="facebook/bart-large")
+    p.add_argument("--epochs", type=int, default=1)
+    p.add_argument("--batch_size", type=int, default=8)
+    args = p.parse_args()
+    os.makedirs(args.out_dir, exist_ok=True)
+    rows = load_jsonl(args.data)
+    tokenizer = AutoTokenizer.from_pretrained(args.model_name)
+    ds = prepare_dataset(rows, tokenizer)
+    # split
+    ds_train = ds.select(range(int(len(ds)*0.9)))
+    ds_eval = ds.select(range(int(len(ds)*0.9), len(ds)))
+    model = AutoModelForSequenceClassification.from_pretrained(args.model_name, num_labels=3)
+    training_args = TrainingArguments(output_dir=args.out_dir, per_device_train_batch_size=args.batch_size,
+                                      per_device_eval_batch_size=args.batch_size, num_train_epochs=args.epochs,
+                                      evaluation_strategy="epoch", save_strategy="epoch")
+    trainer = Trainer(model=model, args=training_args, train_dataset=ds_train, eval_dataset=ds_eval)
+    trainer.train()
+    trainer.save_model(args.out_dir)
+    # calibrate
+    calibrate_threshold(trainer, ds_eval, os.path.join(args.out_dir, "verifier_threshold.json"))
+
+if __name__=="__main__":
+    main()
+
