+"""
+Bias mitigation helpers:
+ - counterfactual augmentation using simple swap templates
+ - constrained decoding utility (ban tokens/phrases)
+ - training reweighting stub
+"""
+from transformers import AutoTokenizer, AutoModelForCausalLM
+import random
+import json
+
+def counterfactual_augment(prompts_jsonl, out_jsonl, swaps=None):
+    """
+    Simple counterfactual augmentation: for each prompt line, produce counterfactuals by replacing tokens.
+    prompts_jsonl: input file lines [{"group":"male","prompt":"..."}]
+    swaps: dict mapping token->list of replacements, e.g. {"he":["she"], "male":["female"]}
+    """
+    if swaps is None:
+        swaps = {" he ": " she ", " He ": " She ", " his ": " her ", " man ": " woman "}
+    out=[]
+    for line in open(prompts_jsonl):
+        item = json.loads(line)
+        text = item["prompt"]
+        out.append(item)
+        for k,v in swaps.items():
+            if k in text:
+                new = text.replace(k, random.choice(v) if isinstance(v,list) else v)
+                newitem = dict(item)
+                newitem["prompt"] = new
+                newitem["augmented"] = True
+                out.append(newitem)
+    with open(out_jsonl,"w") as f:
+        for it in out:
+            f.write(json.dumps(it)+"\n")
+    print("Wrote augmented prompts to", out_jsonl)
+
+def constrained_decode(tokenizer, model, input_ids, banned_strings=[]):
+    """
+    Return generated text while avoiding banned strings via simple filter on finished sequences.
+    For production, use constrained decoding APIs (HuggingFace decode logits processors).
+    """
+    out_ids = model.generate(input_ids, max_length=64)
+    text = tokenizer.decode(out_ids[0], skip_special_tokens=True)
+    for b in banned_strings:
+        if b in text:
+            return "[REDACTED]"
+    return text
+
