+"""
+Token-level attribution using attention rollout and integrated gradients (Captum).
+Return per-token attribution scores and map them to evidence tokens for fine-grained provenance.
+"""
+from transformers import AutoModelForCausalLM, AutoTokenizer
+import torch
+import numpy as np
+
+try:
+    from captum.attr import IntegratedGradients
+    CAPTUM_AVAILABLE = True
+except Exception:
+    CAPTUM_AVAILABLE = False
+
+def attention_rollout_attribution(model, input_ids, layer_start=0):
+    # attention rollout: aggregate attention matrices to get token influence scores
+    model.eval()
+    with torch.no_grad():
+        outputs = model(input_ids, output_attentions=True)
+    # sum attentions across heads and layers
+    attns = outputs.attentions  # tuple of (batch, head, seq, seq)
+    joint = None
+    for i,a in enumerate(attns):
+        if i < layer_start: continue
+        # a: (batch, head, seq, seq)
+        avg = a.mean(dim=1)  # mean over heads -> (batch, seq, seq)
+        if joint is None:
+            joint = avg
+        else:
+            joint = torch.matmul(joint, avg)
+    # token importance as sum of attention from [CLS]/first token or from tokens to output
+    scores = joint.sum(dim=1) if joint is not None else torch.zeros(input_ids.shape)
+    return scores.squeeze(0).cpu().numpy().tolist()
+
+def integrated_gradients_attribution(model, tokenizer, text, target_token_index=None):
+    if not CAPTUM_AVAILABLE:
+        raise RuntimeError("Captum not installed")
+    model.eval()
+    tokens = tokenizer(text, return_tensors="pt")
+    ig = IntegratedGradients(model)
+    input_ids = tokens["input_ids"]
+    def forward_func(input_ids):
+        outputs = model(input_ids)
+        # sum logits for target token position or return logits mean
+        return outputs.logits.sum()
+    attributions, delta = ig.attribute(inputs=input_ids, target=0, return_convergence_delta=True)
+    return attributions.squeeze(0).cpu().detach().numpy().tolist()
+
