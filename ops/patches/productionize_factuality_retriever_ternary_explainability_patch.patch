+/*
+Reference CUDA implementation:
+ - Unpacks ternary int8 values (-1,0,1) from a packed representation (here we assume int8 per element)
+ - Writes an unpacked float matrix and calls cuBLAS SGEMM for GEMM performance
+
+This is a starter: production kernels should be fully vectorized and avoid extra GPU memory copies
+by streaming blocks and using optimized packing.
+*/
+#include <cuda_runtime.h>
+#include <cublas_v2.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+extern "C" {
+  int ternary_gemm(const int8_t* A_tern, const float* A_scales, int m, int k,
+                   const float* B, int k2, int n, float* C) {
+    // A_tern: m x k, values -1,0,1 stored as int8 per element
+    // A_scales: per-row scales length m (or NULL for scalar)
+    // B: k x n float
+    // C: output m x n float (preallocated)
+    // For simplicity unpack A into float buffer
+    float* A_float = nullptr;
+    if (cudaMalloc((void**)&A_float, sizeof(float)*m*k) != cudaSuccess) {
+      return -1;
+    }
+    // launch kernel to unpack and multiply by scale (simple loop here, not optimized)
+    // For brevity use host-side copy (not ideal) - replace with proper kernel in production.
+    float* hostA = (float*)malloc(sizeof(float)*m*k);
+    for (int i=0;i<m;i++){
+      float s = A_scales ? A_scales[i] : 1.0f;
+      for (int j=0;j<k;j++){
+        int8_t v = A_tern[i*k + j];
+        hostA[i*k + j] = ((float)v) * s;
+      }
+    }
+    // copy to device
+    cudaMemcpy(A_float, hostA, sizeof(float)*m*k, cudaMemcpyHostToDevice);
+    free(hostA);
+    // cuBLAS SGEMM: C = A_float * B
+    cublasHandle_t handle;
+    cublasCreate(&handle);
+    const float alpha = 1.0f, beta = 0.0f;
+    // A: m x k, B: k x n, C: m x n (row-major assumption; cuBLAS expects column-major so use transposes)
+    // We'll call cublasSgemm with appropriate transposes to match row-major semantics
+    cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N, n, m, k, &alpha, B, n, A_float, k, &beta, C, n);
+    cublasDestroy(handle);
+    cudaFree(A_float);
+    return 0;
+  }
+}
