+"""
+Improved auto-calibration:
+ - uses fallback thresholds when insufficient labels
+ - alerts operators via Slack webhook (if configured)
+ - keeps minimum sample counts before applying new thresholds
+"""
+import os, time, json, subprocess
+import psycopg2
+
+DB = os.environ.get("DATABASE_URL")
+MIN_SAMPLES = int(os.environ.get("CALIB_MIN_SAMPLES", "50"))
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK", "")
+SAFETY_CALIB_OUT = os.environ.get("SAFETY_CALIB_OUT", "/tmp/thresholds.json")
+
+def alert(msg):
+    if ALERT_WEBHOOK:
+        import requests
+        try:
+            requests.post(ALERT_WEBHOOK, json={"text":msg}, timeout=3)
+        except Exception:
+            pass
+    print("ALERT:", msg)
+
+def fetch_labeled_examples(limit=1000):
+    if not DB:
+        return []
+    conn = psycopg2.connect(DB); cur = conn.cursor()
+    cur.execute("SELECT text, toxicity_label, pii_label FROM rater_labels WHERE created_at > now() - interval '7 days' LIMIT %s", (limit,))
+    rows = cur.fetchall(); cur.close(); conn.close()
+    return [{"text":r[0],"toxicity_label":int(r[1]),"pii_label":int(r[2])} for r in rows]
+
+def run_cycle():
+    examples = fetch_labeled_examples()
+    if len(examples) < MIN_SAMPLES:
+        alert(f"Not enough labeled examples for calibration: {len(examples)} < {MIN_SAMPLES}")
+        # fallback: do not change thresholds
+        return
+    tmp = "/tmp/calib.jsonl"
+    with open(tmp,"w") as f:
+        for e in examples: f.write(json.dumps(e)+"\n")
+    subprocess.check_call(["python","ops/safety/calibrate_thresholds.py","--in",tmp,"--out",SAFETY_CALIB_OUT])
+    subprocess.check_call(["./ops/safety/apply_thresholds_and_deploy.sh", SAFETY_CALIB_OUT])
+    alert("Auto-calibration deployed new thresholds")
+
+if __name__=="__main__":
+    while True:
+        try:
+            run_cycle()
+        except Exception as e:
+            print("calib error", e)
+        time.sleep(int(os.environ.get("CALIB_INTERVAL_SECS", "3600")))
+
