+"""
+Factuality verifier service that serves a finetuned verifier model and calibrated threshold.
+ - Loads verifier model from path (local or mounted volume)
+ - Loads threshold JSON produced by finetune_verifier.py
+ - Exposes /verify which accepts {"claim": "...", "evidence": [{"id":"...", "text":"..."}...]}
+   and returns verdict and score.
+"""
+import os, json
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from transformers import AutoTokenizer, AutoModelForSequenceClassification
+import torch
+
+MODEL_DIR = os.environ.get("VERIFIER_MODEL_DIR", "/models/verifier")
+THRESH_PATH = os.path.join(MODEL_DIR, "verifier_threshold.json")
+MODEL_NAME = os.environ.get("VERIFIER_MODEL_NAME", None)
+
+app = FastAPI()
+
+class VerifReq(BaseModel):
+    claim: str
+    evidence: list
+
+def load_model(dir_path=None):
+    if MODEL_NAME:
+        tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
+        model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME)
+    else:
+        tokenizer = AutoTokenizer.from_pretrained(dir_path)
+        model = AutoModelForSequenceClassification.from_pretrained(dir_path)
+    return tokenizer, model
+
+TOKENIZER, MODEL = load_model(MODEL_DIR if os.path.exists(MODEL_DIR) else MODEL_NAME)
+THRESH = {}
+if os.path.exists(THRESH_PATH):
+    THRESH = json.load(open(THRESH_PATH))
+MIN_SUPPORT = THRESH.get("best_threshold", float(os.environ.get("VERIFIER_MIN_SUPPORT", 0.35)))
+
+def score_claim(claim, evidence_text):
+    # prepare pair and run classifier
+    inputs = TOKENIZER(evidence_text, claim, return_tensors="pt", truncation=True, padding=True)
+    with torch.no_grad():
+        out = MODEL(**inputs)
+    probs = torch.softmax(out.logits, dim=1).cpu().numpy()[0]
+    # index 2 = support (per finetune_verifier.py mapping)
+    support_prob = float(probs[2])
+    return support_prob
+
+@app.post("/verify")
+def verify(req: VerifReq):
+    evs = req.evidence or []
+    if not evs:
+        raise HTTPException(400, "evidence required")
+    scores = []
+    for e in evs:
+        s = score_claim(req.claim, e.get("text",""))
+        scores.append({"id": e.get("id"), "score": s})
+    scores = sorted(scores, key=lambda x: x["score"], reverse=True)
+    best = scores[0]
+    verdict = "support" if best["score"] >= MIN_SUPPORT else "insufficient"
+    return {"verdict": verdict, "best": best, "scores": scores, "threshold": MIN_SUPPORT}
+
