+"""
+RAG inference service wrapper with safe defaults:
+ - loads default policies (conservative/evidence_required)
+ - uses existing services/rag.middleware.generate_with_rag under the hood
+ - exposes /infer with mode and evidence requirements
+"""
+import os, json
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from services.rag.middleware import generate_with_rag
+
+POLICIES_PATH = os.environ.get("DEFAULT_POLICIES", "config/default_policies.yaml")
+import yaml
+POLICIES = {}
+if os.path.exists(POLICIES_PATH):
+    POLICIES = yaml.safe_load(open(POLICIES_PATH))
+DEFAULT_MODE = POLICIES.get("default_mode", "evidence_required")
+
+app = FastAPI()
+
+class InferReq(BaseModel):
+    prompt: str
+    mode: str = None
+
+@app.post("/infer")
+def infer(req: InferReq):
+    mode = req.mode or DEFAULT_MODE
+    res = generate_with_rag(req.prompt, top_k=5)
+    # enforce evidence requirement
+    if mode == "evidence_required":
+        if not res["verifier"] or res["verifier"]["verdict"] != "support":
+            return {"verdict":"needs_review", "reason":"insufficient_evidence", "partial": res}
+    if mode == "conservative":
+        # prefer shorter answers and lower temperature (generation handled by middleware)
+        pass
+    return {"verdict":"ok","result":res}
+
