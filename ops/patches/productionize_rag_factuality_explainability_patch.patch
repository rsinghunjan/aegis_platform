+import React, {useEffect, useState} from "react";
+import axios from "axios";
+
+function App(){
+  const [tasks, setTasks] = useState([]);
+  useEffect(()=>{ fetchTasks(); }, []);
+  async function fetchTasks(){
+    const r = await axios.get("/api/human_queue/tasks");
+    setTasks(r.data);
+  }
+  async function claim(id){
+    await axios.post(`/api/human_queue/claim/${id}`, {claimer: "ui-user"});
+    fetchTasks();
+  }
+  async function resolve(id, verdict){
+    await axios.post(`/api/human_queue/resolve/${id}`, {verdict: verdict, reviewer: "ui-user", notes: "reviewed via UI"});
+    fetchTasks();
+  }
+  return (<div style={{padding:20}}>
+    <h2>Aegis Human Review Queue</h2>
+    {tasks.map(t => (
+      <div key={t.id} style={{border:"1px solid #ddd", padding:10, marginBottom:10}}>
+        <div><strong>#{t.id}</strong> severity:{t.severity} status:{t.status}</div>
+        <div style={{fontStyle:"italic"}}>Output: {t.output}</div>
+        <div style={{marginTop:8}}>
+          {t.status === "open" && <button onClick={()=>claim(t.id)}>Claim</button>}
+          {t.status !== "resolved" && <button onClick={()=>resolve(t.id,"approve")}>Approve</button>}
+          {t.status !== "resolved" && <button onClick={()=>resolve(t.id,"reject")}>Reject</button>}
+        </div>
+      </div>
+    ))}
+  </div>);
+}
+
+export default App;
+
