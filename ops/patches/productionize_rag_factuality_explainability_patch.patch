+"""
+Explainability endpoints exposing token-level attributions (attention rollout / integrated gradients).
+ - /attribution : given model & text returns token-level attributions
+Requires captum for integrated gradients; falls back to attention rollout otherwise.
+"""
+import os, json
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from transformers import AutoTokenizer, AutoModelForCausalLM
+import torch
+
+MODEL_NAME = os.environ.get("EXPL_MODEL", "gpt2")
+TOKENIZER = AutoTokenizer.from_pretrained(MODEL_NAME)
+MODEL = AutoModelForCausalLM.from_pretrained(MODEL_NAME, output_attentions=True)
+
+try:
+    from services.explainability.token_attribution import attention_rollout_attribution, integrated_gradients_attribution
+    CAPTUM_OK = True
+except Exception:
+    CAPTUM_OK = False
+
+app = FastAPI()
+
+class AttrReq(BaseModel):
+    text: str
+    method: str = "attention"
+
+@app.post("/attribution")
+def attribution(req: AttrReq):
+    text = req.text
+    toks = TOKENIZER(text, return_tensors="pt")
+    input_ids = toks["input_ids"]
+    try:
+        if req.method == "integrated" and CAPTUM_OK:
+            atts = integrated_gradients_attribution(MODEL, TOKENIZER, text)
+        else:
+            atts = attention_rollout_attribution(MODEL, input_ids)
+        tokens = TOKENIZER.convert_ids_to_tokens(input_ids[0])
+        return {"tokens": tokens, "attributions": atts}
+    except Exception as e:
+        raise HTTPException(500, str(e))
+
