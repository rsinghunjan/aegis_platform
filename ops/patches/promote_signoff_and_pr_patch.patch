+#!/usr/bin/env bash
+set -euo pipefail
+#
+# promote_runner.sh
+# Wrapper to safely run a Level-4 promotion:
+# - Performs prechecks (readiness report, Legal signoff)
+# - Prints exact commands an operator should run
+# - Optionally executes the guarded promotion (promote_to_level4.sh) if --execute is passed
+#
+# Usage (dry-run, recommended):
+#   export EVIDENCE_BUCKET=s3://aegis-evidence-prod
+#   ./ops/production/promote_runner.sh --min-readiness 85
+#
+# To actually execute promotion (operator must be present and approve):
+#   ./ops/production/promote_runner.sh --min-readiness 85 --execute
+
+EVIDENCE=${EVIDENCE_BUCKET:-}
+MIN_READINESS="85"
+EXECUTE="false"
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --evidence) EVIDENCE="$2"; shift 2;;
+    --min-readiness) MIN_READINESS="$2"; shift 2;;
+    --execute) EXECUTE="true"; shift;;
+    -h|--help) echo "Usage: $0 [--evidence s3://bucket] [--min-readiness N] [--execute]"; exit 0;;
+    *) echo "Unknown arg $1"; exit 1;;
+  esac
+done
+
+if [ -z "${EVIDENCE}" ]; then
+  echo "EVIDENCE_BUCKET must be set via env or --evidence"
+  exit 1
+fi
+
+BUCKET=${EVIDENCE#s3://}
+echo "Looking for latest readiness report in s3://${BUCKET}/production_proofs/readiness/"
+LATEST=$(aws s3 ls s3://${BUCKET}/production_proofs/readiness/ --recursive | sort | tail -n 1 | awk '{print $4}' || true)
+if [ -z "${LATEST}" ]; then
+  echo "No readiness report found. Run readiness_calculator.py first and upload the report."
+  exit 1
+fi
+
+TMP=/tmp/readiness_latest.json
+aws s3 cp s3://${BUCKET}/${LATEST} ${TMP}
+PCT=$(jq '.computed.percent' ${TMP})
+echo "Readiness percent: ${PCT}% (required: ${MIN_READINESS}%)"
+
+echo
+echo "Checking legal signoff marker at s3://${BUCKET}/compliance/legal_signoff.txt"
+if aws s3 ls s3://${BUCKET}/compliance/legal_signoff.txt >/dev/null 2>&1; then
+  echo "Legal signoff present"
+else
+  echo "Legal signoff NOT present. To proceed, Legal must upload a short token to s3://${BUCKET}/compliance/legal_signoff.txt"
+  echo "Example:"
+  echo "  echo \"legal ok - \$(date -u)\" > /tmp/legal_ok.txt"
+  echo "  aws s3 cp /tmp/legal_ok.txt s3://${BUCKET}/compliance/legal_signoff.txt"
+  exit 1
+fi
+
+echo
+echo "Promotion DRY-RUN (the following commands show exactly what will be executed):"
+echo
+echo "# 1) Backup existing Gatekeeper constraints"
+echo "kubectl get constraint --all-namespaces -o yaml > /tmp/constraints-backup-\$(date +%s).yaml"
+echo
+echo "# 2) Run the guarded promotion (this patches constraints and performs verification):"
+echo "./ops/production/promote_to_level4.sh --min-readiness ${MIN_READINESS} --evidence ${EVIDENCE}"
+echo
+echo "# 3) Record promotion evidence in S3 (the promote script uploads a marker under ${EVIDENCE}/governance/)"
+echo
+echo "# 4) After promotion, monitor for any anomalies and keep humans in the loop for the next 7-14 days."
+echo
+
+if [ "${EXECUTE}" = "true" ]; then
+  echo "=== EXECUTION MODE ENABLED ==="
+  read -p "Operator confirmation: type PROMOTE to continue: " CONFIRM
+  if [ "${CONFIRM}" != "PROMOTE" ]; then
+    echo "Confirmation not provided. Aborting."
+    exit 1
+  fi
+
+  echo "Running promote_to_level4.sh now..."
+  bash ops/production/promote_to_level4.sh --min-readiness "${MIN_READINESS}" --evidence "${EVIDENCE}"
+  echo "Promotion script executed. Verify governance artifacts in ${EVIDENCE}/governance/"
+else
+  echo "Dry-run complete. Re-run with --execute to perform the promotion (operator confirmation required)."
+fi
+
