+#!/usr/bin/env bash
+set -euo pipefail
+#
+# prepare_remove_human_gates_pr.sh
+# - Creates a local branch with suggested, phased changes to remove/reduce manual gates for low-risk pipelines
+# - Generates a PR draft with checklist and suggested reviewers (requires gh CLI and repo push rights)
+#
+# Usage (dry-run):
+#   ./ops/ci/prepare_remove_human_gates_pr.sh --branch remove-human-gates-phase1 --dry-run
+#
+# To create PR (will push branch and open PR draft):
+#   ./ops/ci/prepare_remove_human_gates_pr.sh --branch remove-human-gates-phase1
+
+REPO=${REPO:-"rsinghunjan/aegis"}
+BRANCH=${1:-"remove-human-gates-phase1"}
+DRY_RUN=false
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --branch) BRANCH="$2"; shift 2;;
+    --dry-run) DRY_RUN=true; shift;;
+    -h|--help) echo "Usage: $0 [--branch name] [--dry-run]"; exit 0;;
+    *) shift;;
+  esac
+done
+
+echo "Preparing branch: ${BRANCH} (repo: ${REPO})"
+TMPDIR=$(mktemp -d)
+trap 'rm -rf ${TMPDIR}' EXIT
+
+# Strategy: produce small, auditable changes that remove required reviewers from low-risk GH environment file
+# and comment out manual approval steps in an example workflow (operator must review).
+
+PATCH_FILE=${TMPDIR}/remove_human_gates.patch
+cat > ${PATCH_FILE} <<'PATCH'
+*** Begin Patch
+*** Update File: .github/workflows/production_proofs.yml
+@@
+     steps:
+       - name: Wait for manual approval
+-        if: needs.approval.outputs.approved != 'true'
+-        uses: peter-evans/wait-for-approval@v2
+-        with:
+-          ...
++        # Manual approval step commented out for Phase 1 (operator must review)
++        # REMOVED: wait-for-approval action temporarily for low-risk workflows
+ PATCH
+
+echo "Patch prepared at ${PATCH_FILE}"
+
+if [ "${DRY_RUN}" = "true" ]; then
+  echo "Dry-run mode: patch not applied. Review the patch file and apply manually if desired."
+  echo "Patch content:"
+  sed -n '1,200p' ${PATCH_FILE}
+  exit 0
+fi
+
+if ! command -v gh >/dev/null 2>&1; then
+  echo "gh CLI required to create PR. Install and authenticate, then re-run."
+  exit 1
+fi
+
+echo "Applying patch locally and opening PR..."
+git checkout -b "${BRANCH}"
+# Apply patch: the patch is advisory; operator should edit files to their liking
+git apply --reject --whitespace=fix ${PATCH_FILE} || true
+git add -A || true
+git commit -m "ci: propose phased removal of manual approval for low-risk workflows (phase 1)" || true
+git push origin "${BRANCH}"
+gh pr create --repo "${REPO}" --title "Propose phased removal of human gates (phase 1)" --body-file - <<'PRBODY'
+This PR proposes a phased reduction of routine human approvals for low-risk workflows.
+
+Summary of changes:
+- Comment out manual approval step in production_proofs workflow (phase 1).
+
+Why:
+- Automate routine flows while keeping high-risk protections in place.
+
+Reviewers:
+- @security (security)
+- @rsinghunjan (platform owner)
+- @legal (for audit trail)
+
+Notes:
+- This PR is intentionally conservative. Do NOT merge until Legal & Security signoff is recorded.
+PRBODY
+
+echo "PR created. Please review, add reviewers and require signoff before merging."
+
