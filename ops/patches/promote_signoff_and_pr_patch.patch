+#!/usr/bin/env python3
+"""
+generate_signoff_package.py
+
+Collects the final readiness report, final orchestrator summary, cosign-signed evidence bundles,
+relevant manifests and remediation closure artifacts into a single zip package suitable for Legal/Compliance.
+
+Usage:
+  export EVIDENCE_BUCKET=s3://aegis-evidence-prod
+  python3 ops/production/generate_signoff_package.py --evidence $EVIDENCE_BUCKET --out /tmp/aegis_level4_signoff.zip --upload
+
+Notes:
+ - Requires boto3 installed and AWS credentials available.
+ - If --upload is passed, uploads the package to ${EVIDENCE_BUCKET}/compliance/signoff-packages/
+"""
+import argparse
+import os
+import sys
+import tempfile
+import zipfile
+import json
+import glob
+from datetime import datetime
+
+def list_latest_s3_key(bucket, prefix):
+    import boto3
+    s3=boto3.client("s3")
+    resp=s3.list_objects_v2(Bucket=bucket.replace("s3://",""), Prefix=prefix, MaxKeys=1000)
+    items=resp.get("Contents",[])
+    if not items:
+        return None
+    items.sort(key=lambda x: x["LastModified"], reverse=True)
+    return items[0]["Key"]
+
+def download_s3_to(tmpdir, bucket, key):
+    import boto3
+    s3=boto3.client("s3")
+    local=os.path.join(tmpdir, os.path.basename(key))
+    s3.download_file(bucket.replace("s3://",""), key, local)
+    return local
+
+def collect_and_zip(evidence_bucket, outpath, upload=False):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=evidence_bucket.replace("s3://","")
+    tmpdir=tempfile.mkdtemp(prefix="aegis-signoff-")
+    files_added=[]
+
+    # 1) Latest readiness report
+    key = list_latest_s3_key(evidence_bucket, "production_proofs/readiness/")
+    if key:
+        files_added.append(download_s3_to(tmpdir, evidence_bucket, key))
+
+    # 2) Latest final-summary
+    key2 = list_latest_s3_key(evidence_bucket, "production_proofs/final-summary")
+    if key2:
+        files_added.append(download_s3_to(tmpdir, evidence_bucket, key2))
+
+    # 3) Cosign-signed bundles (evidence-bundles/ or similar)
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix="evidence-bundles/", MaxKeys=1000)
+    for o in resp.get("Contents", [])[:50]:
+        k=o["Key"]
+        if k.endswith(".json") or k.endswith(".tar") or k.endswith(".tgz") or k.endswith(".zip") or k.endswith(".sig"):
+            try:
+                files_added.append(download_s3_to(tmpdir, evidence_bucket, k))
+            except Exception:
+                pass
+
+    # 4) Remediation closure list (if uploaded)
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix="remediation/closure/", MaxKeys=100)
+    for o in resp.get("Contents", []):
+        try:
+            files_added.append(download_s3_to(tmpdir, evidence_bucket, o["Key"]))
+        except Exception:
+            pass
+
+    # 5) OTEL coverage report (latest)
+    key3 = list_latest_s3_key(evidence_bucket, "otel/")
+    if key3:
+        try:
+            files_added.append(download_s3_to(tmpdir, evidence_bucket, key3))
+        except Exception:
+            pass
+
+    # 6) OPA verdicts
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix="opa/", MaxKeys=100)
+    for o in resp.get("Contents", [])[:50]:
+        try:
+            files_added.append(download_s3_to(tmpdir, evidence_bucket, o["Key"]))
+        except Exception:
+            pass
+
+    # 7) Security summary
+    sec_key = list_latest_s3_key(evidence_bucket, "security/")
+    if sec_key:
+        files_added.append(download_s3_to(tmpdir, evidence_bucket, sec_key))
+
+    # 8) Include README manifest summarizing what's inside
+    manifest = {
+        "generated_at": datetime.utcnow().isoformat(),
+        "evidence_bucket": evidence_bucket,
+        "readiness_report_key": key,
+        "final_summary_key": key2,
+        "collected_files": [os.path.basename(p) for p in files_added]
+    }
+    manifest_path = os.path.join(tmpdir, "SIGNOFF_MANIFEST.json")
+    with open(manifest_path, "w") as f:
+        json.dump(manifest, f, indent=2)
+    files_added.append(manifest_path)
+
+    # Create zip
+    with zipfile.ZipFile(outpath, "w", compression=zipfile.ZIP_DEFLATED) as z:
+        for p in files_added:
+            arcname = os.path.basename(p)
+            z.write(p, arcname=arcname)
+    print("Created signoff package:", outpath)
+
+    if upload:
+        key_dest = f"compliance/signoff-packages/level4-signoff-{int(time.time())}.zip"
+        s3.upload_file(outpath, bucket, key_dest)
+        print(f"Uploaded signoff package to s3://{bucket}/{key_dest}")
+        return f"s3://{bucket}/{key_dest}"
+    return outpath
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--upload", action="store_true")
+    args=p.parse_args()
+    res = collect_and_zip(args.evidence, args.out, upload=args.upload)
+    print("Result:", res)
+
+if __name__ == "__main__":
+    main()
+
