+#!/usr/bin/env python3
+"""
+Submit jobs to Slurm from Tekton/CI or scripts.
+ - Submits job via sbatch over SSH to a SLURM headnode (PoC)
+ - Polls job status and streams accounting into Prometheus pushgateway (if present)
+ - Supports checkpoint preemption hook via scontrol/kill signal
+"""
+import os, subprocess, time, logging
+from typing import Optional
+
+logger = logging.getLogger("slurm-submit")
+logging.basicConfig(level=logging.INFO)
+
+SLURM_HEAD = os.environ.get("SLURM_HEAD", "slurm-head.example.internal")
+SSH_USER = os.environ.get("SLURM_SSH_USER", "aegis")
+PUSHGATEWAY = os.environ.get("PUSHGATEWAY", "")
+
+def ssh_run(cmd: str):
+    ssh = ["ssh", f"{SSH_USER}@{SLURM_HEAD}", cmd]
+    out = subprocess.check_output(ssh).decode("utf-8")
+    return out
+
+def submit_script(script_path: str) -> Optional[str]:
+    # copy script to head and run sbatch
+    remote_path = f"/tmp/{os.path.basename(script_path)}-{int(time.time())}"
+    subprocess.check_call(["scp", script_path, f"{SSH_USER}@{SLURM_HEAD}:{remote_path}"])
+    out = ssh_run(f"sbatch {remote_path}")
+    # parse job id
+    import re
+    m = re.search(r"Submitted batch job (\d+)", out)
+    if m:
+        return m.group(1)
+    return None
+
+def poll_job(job_id: str, interval=10):
+    while True:
+        out = ssh_run(f"sacct -j {job_id} --format=JobID,State,Elapsed -n")
+        logger.info("sacct: %s", out.strip())
+        if "COMPLETED" in out or "FAILED" in out or "CANCELLED" in out:
+            return out
+        time.sleep(interval)
+
+def trigger_checkpoint(job_id: str):
+    # best-effort: send USR1 to job's tasks so training job can checkpoint
+    ssh_run(f"scontrol signal jobid={job_id} USR1")
+
+if __name__ == "__main__":
+    import sys
+    script = sys.argv[1] if len(sys.argv) > 1 else "train.sh"
+    j = submit_script(script)
+    if j:
+        logger.info("Submitted job %s", j)
+        poll_job(j)
+
