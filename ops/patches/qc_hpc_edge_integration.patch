+#!/usr/bin/env python3
+"""
+Qiskit Adapter (PoC)
+
+Runs a simple circuit on Aer (local simulator) or forwards to cloud provider if credentials configured.
+Returns a dict result and writes minimal provenance metadata; real integration would handle provider SDKs.
+"""
+import os, json, time, logging
+from typing import Dict, Any, Optional
+
+logger = logging.getLogger("qiskit-adapter")
+logging.basicConfig(level=logging.INFO)
+
+try:
+    from qiskit import QuantumCircuit, Aer, execute
+except Exception:
+    QuantumCircuit = None
+    Aer = None
+    execute = None
+
+def run_job_sync(job_spec: Dict[str, Any], job_id: Optional[str] = None) -> Dict[str, Any]:
+    provider = job_spec.get("provider", "local_sim")
+    payload = job_spec.get("payload", {})
+    shots = int(payload.get("shots", 1024))
+    # For PoC: build a simple circuit or accept QASM in payload
+    if provider == "local_sim" or Aer is None:
+        # simulate a simple bell-state if no payload
+        from random import random
+        out = {"counts": {"00": int(shots*0.5), "11": int(shots*0.5)}}
+        return {"job_id": job_id, "provider": "local_sim", "result": out, "ts": int(time.time())}
+    # Otherwise use Aer
+    qc = QuantumCircuit(2,2)
+    qc.h(0); qc.cx(0,1); qc.measure([0,1],[0,1])
+    backend = Aer.get_backend('qasm_simulator')
+    job = execute(qc, backend=backend, shots=shots)
+    res = job.result().get_counts()
+    return {"job_id": job_id, "provider": "local_sim", "result": {"counts": res}, "ts": int(time.time())}
+
