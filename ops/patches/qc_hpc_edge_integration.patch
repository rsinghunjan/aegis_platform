+#!/usr/bin/env python3
+"""
+QPU Job Queue Service (PoC)
+
+Provides:
+ - POST /submit : submit a QPU job (payload contains circuit metadata, provider choice, budget/timeout)
+ - GET  /status/{job_id} : check job status
+ - GET  /estimate : quick cost/latency estimate
+ - POST /cancel/{job_id} : cancel job
+
+Features:
+ - Basic quota check (per-client) and billing estimate
+ - Records provenance and uploads evidence to S3 (EVIDENCE_BUCKET)
+ - Integrates with Keycloak auth via services.common.keycloak_auth if available
+
+Notes:
+ - This is a PoC queue. In production you must persist jobs (DB), add retries, backpressure, and provenance storage.
+"""
+import os
+import time
+import uuid
+import json
+import logging
+from typing import Dict, Any
+
+from fastapi import FastAPI, HTTPException, Depends
+from pydantic import BaseModel
+
+try:
+    from services.common.keycloak_auth import validate_token, require_role
+except Exception:
+    def validate_token(x=None): return {"preferred_username": "dev"}
+    def require_role(r): return validate_token
+
+import requests
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+logger = logging.getLogger("qpu-queue")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+S3 = boto3.client("s3") if boto3 and EVIDENCE_BUCKET else None
+
+app = FastAPI(title="QPU Queue Service (PoC)")
+
+JOBS: Dict[str, Dict[str, Any]] = {}
+QUOTAS = {"dev": 10}  # jobs in flight
+
+class QPUJobSubmit(BaseModel):
+    name: str
+    provider: str  # e.g., "local_sim", "ibm", "aws_braket"
+    payload: Dict[str, Any]  # circuit spec or reference to stored artifact
+    priority: int = 10
+    max_cost_usd: float = 10.0
+    timeout_s: int = 600
+
+def upload_evidence(key_prefix: str, payload: Dict[str, Any]):
+    ts = int(time.time())
+    key = f"{key_prefix}/{ts}-{uuid.uuid4().hex}.json"
+    if not S3:
+        path = f"/tmp/{key.replace('/','_')}"
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w") as f:
+            json.dump(payload, f, indent=2)
+        return path
+    try:
+        S3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode("utf-8"))
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    except Exception as e:
+        logger.warning("s3 upload failed: %s", e)
+        return None
+
+@app.post("/submit")
+def submit(job: QPUJobSubmit, user=Depends(validate_token)):
+    client = user.get("preferred_username", "dev")
+    # simple in-memory quota check
+    in_flight = sum(1 for j in JOBS.values() if j["owner"] == client and j["state"] in ("queued","running"))
+    quota = QUOTAS.get(client, 2)
+    if in_flight >= quota:
+        raise HTTPException(status_code=429, detail="quota exceeded")
+    job_id = uuid.uuid4().hex
+    JOBS[job_id] = {"id": job_id, "owner": client, "job": job.dict(), "state": "queued", "submitted_at": int(time.time())}
+    upload_evidence("qpu/submissions", {"job_id": job_id, "owner": client, "job": job.dict(), "ts": int(time.time())})
+    # For PoC: immediately schedule local simulation or proxy to adapter
+    try:
+        from services.quantum.qiskit_adapter import run_job_sync
+        JOBS[job_id]["state"] = "running"
+        res = run_job_sync(job.dict(), job_id=job_id)
+        JOBS[job_id]["state"] = "done"
+        JOBS[job_id]["result"] = res
+        upload_evidence("qpu/results", {"job_id": job_id, "result": res})
+    except Exception as e:
+        JOBS[job_id]["state"] = "error"
+        JOBS[job_id]["error"] = str(e)
+        upload_evidence("qpu/errors", {"job_id": job_id, "error": str(e)})
+    return {"job_id": job_id}
+
+@app.get("/status/{job_id}")
+def status(job_id: str, user=Depends(validate_token)):
+    j = JOBS.get(job_id)
+    if not j:
+        raise HTTPException(status_code=404, detail="job not found")
+    return {"id": job_id, "state": j["state"], "owner": j["owner"], "submitted_at": j.get("submitted_at"), "result": j.get("result"), "error": j.get("error")}
+
+@app.get("/estimate")
+def estimate(provider: str = "local_sim", shots: int = 1000):
+    # PoC heuristics
+    per_shot_usd = {"local_sim": 0.0, "ibm": 0.0005, "aws_braket": 0.001}
+    latency_s = {"local_sim": 0.1, "ibm": 30, "aws_braket": 10}
+    return {"cost_usd": per_shot_usd.get(provider, 0.01) * shots, "latency_s": latency_s.get(provider, 30)}
+
+@app.post("/cancel/{job_id}")
+def cancel(job_id: str, user=Depends(validate_token)):
+    j = JOBS.get(job_id)
+    if not j:
+        raise HTTPException(status_code=404)
+    if j["state"] in ("done", "error"):
+        return {"ok": False, "reason": "already finished"}
+    j["state"] = "cancelled"
+    upload_evidence("qpu/cancel", {"job_id": job_id, "by": user.get("preferred_username"), "ts": int(time.time())})
+    return {"ok": True}
+
