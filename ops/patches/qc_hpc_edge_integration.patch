+#!/usr/bin/env bash
+#
+# Called by Slurm preemption handler or spot interruption hook to checkpoint training job
+# Expects TRAIN_PID or training process to respond to USR1/USR2 to trigger checkpoint
+PID=${1:-}
+if [ -z "$PID" ]; then
+  echo "Usage: $0 <training-pid>"
+  exit 2
+fi
+echo "Sending USR1 to PID $PID to trigger checkpoint"
+kill -USR1 "$PID"
+sleep 2
+echo "Checkpoint signaled"
