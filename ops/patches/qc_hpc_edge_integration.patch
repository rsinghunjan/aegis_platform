+ - Handles checkpoint signals
+"""
+import os, subprocess, logging
+from typing import List
+
+logger = logging.getLogger("mpi-orch")
+logging.basicConfig(level=logging.INFO)
+
+def write_hostfile(hosts: List[str], path="/tmp/hostfile"):
+    with open(path, "w") as f:
+        for h in hosts:
+            f.write(h + "\n")
+    return path
+
+def launch_mpi(hostfile: str, cmd: List[str]):
+    mpi_cmd = ["mpirun", "-np", str(len(open(hostfile).read().strip().splitlines())), "-hostfile", hostfile] + cmd
+    logger.info("Launching MPI: %s", " ".join(mpi_cmd))
+    subprocess.check_call(mpi_cmd)
+
+if __name__ == "__main__":
+    hosts = os.environ.get("MPI_HOSTS", "node1,node2").split(",")
+    hf = write_hostfile(hosts)
+    launch_mpi(hf, ["python", "train_distributed.py"])
