+#!/usr/bin/env python3
+"""
+Simulator runner to execute many noisy simulations in parallel for CI.
+Writes per-run evidence to EVIDENCE_BUCKET.
+"""
+import os, json, time, logging
+from concurrent.futures import ThreadPoolExecutor
+
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+logger = logging.getLogger("sim-runner")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+S3 = boto3.client("s3") if boto3 and EVIDENCE_BUCKET else None
+
+def run_one(i):
+    # Simulate noise run (PoC)
+    res = {"run": i, "counts": {"00": 512, "11": 512}, "ts": int(time.time())}
+    key = f"simulations/run-{i}-{int(time.time())}.json"
+    if S3:
+        S3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(res).encode("utf-8"))
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    else:
+        p = f"/tmp/{key.replace('/','_')}"
+        os.makedirs(os.path.dirname(p), exist_ok=True)
+        with open(p, "w") as f:
+            json.dump(res, f)
+        return p
+
+def run_many(n=100, workers=8):
+    with ThreadPoolExecutor(max_workers=workers) as ex:
+        futures = [ex.submit(run_one, i) for i in range(n)]
+        res = [f.result() for f in futures]
+    logger.info("Completed %d simulations", len(res))
+    return res
+
+if __name__ == "__main__":
+    import sys
+    n = int(sys.argv[1]) if len(sys.argv) > 1 else 200
+    run_many(n=n, workers=16)
+
