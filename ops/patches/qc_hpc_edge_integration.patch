+#!/usr/bin/env python3
+"""
+Offline buffer agent (PoC)
+ - Watches a local directory for telemetry files and attempts to POST them to a central endpoint.
+ - Retries with backoff on failure.
+"""
+import os, time, json, logging
+import requests
+
+WATCH_DIR = os.environ.get("WATCH_DIR", "/tmp/evidence")
+ENDPOINT = os.environ.get("CENTRAL_ENDPOINT", "http://ros2-bridge.monitoring.svc:8080/telemetry")
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("buffer-agent")
+
+def forward_file(path):
+    with open(path) as f:
+        payload = json.load(f)
+    try:
+        r = requests.post(ENDPOINT, json=payload, timeout=5)
+        if r.status_code in (200,201):
+            os.remove(path)
+            logger.info("Forwarded and removed %s", path)
+            return True
+    except Exception as e:
+        logger.debug("Forward failed: %s", e)
+    return False
+
+def run_loop():
+    os.makedirs(WATCH_DIR, exist_ok=True)
+    while True:
+        files = sorted([os.path.join(WATCH_DIR,f) for f in os.listdir(WATCH_DIR)])
+        for p in files:
+            forward_file(p)
+        time.sleep(10)
+
+if __name__ == "__main__":
+    run_loop()
+
