+
+def run_job_adapter(job_spec):
+    provider = job_spec["provider"]
+    if provider.startswith("aws") or provider == "aws_braket":
+        from services.quantum.adapters.aws_braket_adapter import run_braket_sync
+        return run_braket_sync(job_spec)
+    elif provider.startswith("pennylane"):
+        from services.quantum.adapters.pennylane_adapter import run_pennylane_sync
+        return run_pennylane_sync(job_spec)
+    else:
+        from services.quantum.qiskit_adapter import run_job_sync
+        return run_job_sync(job_spec)
+
+def worker_loop():
+    while True:
+        db = SessionLocal()
+        job = db.query(QPUJob).filter(QPUJob.state == JobState.queued).order_by(QPUJob.priority.asc()).first()
+        if job:
+            logger.info("Starting job %s", job.id)
+            job.state = JobState.running
+            job.started_at = datetime.utcnow()
+            db.commit()
+            try:
+                res = run_job_adapter({"provider": job.provider, "payload": job.payload})
+                job.result = res
+                job.state = JobState.done
+                # record billing (placeholder)
+                br = db.query(BillingRecord).filter(BillingRecord.job_id == job.id).first()
+                if br:
+                    br.actual_cost = float(res.get("estimated_cost", 0.0))
+                job.finished_at = datetime.utcnow()
+                db.commit()
+            except Exception as e:
+                logger.exception("Job failed")
+                job.state = JobState.error
+                job.error = str(e)
+                db.commit()
+        else:
+            time.sleep(POLL_INTERVAL)
+
+if __name__ == "__main__":
+    worker_loop()
