+#!/usr/bin/env python3
+"""
+Secure Slurm submitter:
+ - Uses SSH key injected via Kubernetes Secret (mounted into pod)
+ - Copies script via scp and runs sbatch; polls sacct for status
+ - Supports secure key rotation by reloading secret and restarting job submitter pods
+"""
+import os, subprocess, logging, time
+
+SLURM_HEAD = os.environ.get("SLURM_HEAD", "slurm-head.cluster.local")
+SSH_USER = os.environ.get("SLURM_SSH_USER", "aegis")
+SSH_KEY_PATH = os.environ.get("SLURM_SSH_KEY_PATH", "/secrets/slurm_id_rsa")
+
+logger = logging.getLogger("slurm-submit-secure")
+logging.basicConfig(level=logging.INFO)
+
+def scp_to_head(local_path, remote_path):
+    cmd = ["scp", "-i", SSH_KEY_PATH, "-o", "StrictHostKeyChecking=no", local_path, f"{SSH_USER}@{SLURM_HEAD}:{remote_path}"]
+    subprocess.check_call(cmd)
+
+def ssh_run(cmd):
+    ssh = ["ssh", "-i", SSH_KEY_PATH, "-o", "StrictHostKeyChecking=no", f"{SSH_USER}@{SLURM_HEAD}", cmd]
+    return subprocess.check_output(ssh).decode("utf-8")
+
+def submit_script(script_path):
+    remote = f"/tmp/{os.path.basename(script_path)}-{int(time.time())}"
+    scp_to_head(script_path, remote)
+    out = ssh_run(f"sbatch {remote}")
+    import re
+    m = re.search(r"Submitted batch job (\d+)", out)
+    return m.group(1) if m else None
+
+def poll_job(job_id, interval=10):
+    while True:
+        out = ssh_run(f"sacct -j {job_id} --format=JobID,State,Elapsed -n")
+        logger.info("sacct: %s", out.strip())
+        if any(st in out for st in ("COMPLETED","FAILED","CANCELLED")):
+            return out
+        time.sleep(interval)
+
+if __name__=="__main__":
+    import sys
+    script = sys.argv[1] if len(sys.argv)>1 else "train.sh"
+    j = submit_script(script)
+    logger.info("Submitted job: %s", j)
+    poll_job(j)
+
