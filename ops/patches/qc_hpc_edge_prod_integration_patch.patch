+#!/usr/bin/env python3
+"""
+Device CA Issuer (PoC)
+ - Issues short-lived device certificates signed by an internal CA for enrolled devices
+ - Stores issued certs metadata into registry (for revocation)
+ - In production, integrate with Keycloak or a proper PKI (step-ca, CFSSL) and automated rotation
+"""
+import os, time, json, uuid, logging
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+from cryptography import x509
+from cryptography.x509.oid import NameOID
+from cryptography.hazmat.primitives import serialization, hashes
+from cryptography.hazmat.primitives.asymmetric import rsa
+
+logger = logging.getLogger("device-ca")
+logging.basicConfig(level=logging.INFO)
+
+CA_KEY_PATH = os.environ.get("CA_KEY_PATH", "/etc/ca/ca.key.pem")
+CA_CERT_PATH = os.environ.get("CA_CERT_PATH", "/etc/ca/ca.crt.pem")
+
+app = FastAPI(title="Device CA Issuer (PoC)")
+
+class CSRRequest(BaseModel):
+    device_id: str
+    csr_pem: str
+
+def load_ca():
+    with open(CA_KEY_PATH, "rb") as f:
+        key = serialization.load_pem_private_key(f.read(), password=None)
+    with open(CA_CERT_PATH, "rb") as f:
+        cert = x509.load_pem_x509_certificate(f.read())
+    return key, cert
+
+@app.post("/issue")
+def issue(req: CSRRequest):
+    key, cert = load_ca()
+    # For PoC simply sign a CSR and return cert
+    csr = x509.load_pem_x509_csr(req.csr_pem.encode())
+    subject = csr.subject
+    builder = x509.CertificateBuilder().subject_name(
+        subject
+    ).issuer_name(
+        cert.subject
+    ).public_key(
+        csr.public_key()
+    ).serial_number(
+        int(uuid.uuid4().int & (1<<64)-1)
+    ).not_valid_before(
+        time.time()
+    ).not_valid_after(
+        time.time() + 3600*24  # 1 day
+    )
+    signed = builder.sign(private_key=key, algorithm=hashes.SHA256())
+    pem = signed.public_bytes(serialization.Encoding.PEM).decode()
+    return {"cert_pem": pem}
+
