+"""
+Simple performance benchmarking harness:
+ - Run a configurable number of concurrent optimizer requests to measure latency and throughput
+ - Can be used for capacity planning or CI smoke tests
+"""
+import os, time, requests
+from concurrent.futures import ThreadPoolExecutor
+
+URL = os.environ.get("OPTIMIZER_URL", "http://carbon-optimizer.monitoring.svc:8082/optimize")
+CONC = int(os.environ.get("PERF_CONCURRENCY", "20"))
+ITERS = int(os.environ.get("PERF_ITERS", "100"))
+
+def call_once(i):
+    payload = {"job_id": f"bench-{i}", "model_name": "bench", "latency_sla_ms":200, "candidates": {"us-east":"http://example"}}
+    t0 = time.time()
+    r = requests.post(URL, json=payload, timeout=10)
+    return time.time()-t0, r.status_code
+
+def run():
+    latencies = []
+    with ThreadPoolExecutor(max_workers=CONC) as ex:
+        futures = [ex.submit(call_once, i) for i in range(ITERS)]
+        for f in futures:
+            dt, status = f.result()
+            latencies.append(dt)
+    latencies.sort()
+    n = len(latencies)
+    print("Requests:", n, "p50:", latencies[int(n*0.5)], "p95:", latencies[int(n*0.95)], "p99:", latencies[int(n*0.99)])
+
+if __name__ == "__main__":
+    run()
