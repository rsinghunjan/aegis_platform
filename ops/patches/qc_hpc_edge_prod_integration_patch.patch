+"""
+Persistent QPU Queue Service (FastAPI)
+ - Uses SQLAlchemy-backed DB for job persistence and billing
+ - Has endpoints to submit, status, cancel, estimate
+ - Places provenance/evidence into EVIDENCE_BUCKET
+ - Enqueues work for worker processes via a simple work table; workers poll DB
+"""
+import os
+import uuid
+import json
+import time
+import logging
+from typing import Dict
+from fastapi import FastAPI, HTTPException, Depends
+from pydantic import BaseModel
+
+from services.quantum.db_models import SessionLocal, init_db, QPUJob, BillingRecord, JobState
+
+try:
+    from services.common.keycloak_auth import validate_token
+except Exception:
+    def validate_token(*a, **k):
+        return {"preferred_username": "dev"}
+
+import boto3
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+S3 = boto3.client("s3") if boto3 and EVIDENCE_BUCKET else None
+
+logger = logging.getLogger("qpu-queue-persistent")
+logging.basicConfig(level=logging.INFO)
+
+app = FastAPI(title="QPU Queue Persistent (PoC)")
+
+init_db()
+
+
+class QPUJobSubmit(BaseModel):
+    name: str
+    provider: str
+    payload: Dict
+    priority: int = 10
+    max_cost_usd: float = 10.0
+    timeout_s: int = 600
+
+
+def upload_evidence(prefix: str, payload: Dict):
+    if not S3:
+        p = f"/tmp/evidence_{prefix}_{int(time.time())}.json"
+        with open(p, "w") as f:
+            json.dump(payload, f, indent=2)
+        return p
+    key = f"{prefix}/{int(time.time())}-{uuid.uuid4().hex}.json"
+    S3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(payload).encode("utf-8"))
+    return f"s3://{EVIDENCE_BUCKET}/{key}"
+
+
+@app.post("/submit")
+def submit(job: QPUJobSubmit, user=Depends(validate_token)):
+    owner = user.get("preferred_username", "dev")
+    job_id = uuid.uuid4().hex
+    db = SessionLocal()
+    j = QPUJob(
+        id=job_id,
+        owner=owner,
+        provider=job.provider,
+        payload=job.payload,
+        priority=job.priority,
+        max_cost_usd=job.max_cost_usd,
+        timeout_s=job.timeout_s,
+        state=JobState.queued
+    )
+    db.add(j)
+    # billing estimate record
+    br = BillingRecord(job_id=job_id, owner=owner, provider=job.provider, estimated_cost=0.0)
+    db.add(br)
+    db.commit()
+    upload_evidence("qpu/submissions", {"job_id": job_id, "owner": owner, "job": job.dict()})
+    return {"job_id": job_id}
+
+
+@app.get("/status/{job_id}")
+def status(job_id: str, user=Depends(validate_token)):
+    db = SessionLocal()
+    j = db.query(QPUJob).get(job_id)
+    if not j:
+        raise HTTPException(status_code=404)
+    return {"id": j.id, "state": j.state.value, "owner": j.owner, "result": j.result, "error": j.error}
+
+
+@app.post("/cancel/{job_id}")
+def cancel(job_id: str, user=Depends(validate_token)):
+    db = SessionLocal()
+    j = db.query(QPUJob).get(job_id)
+    if not j:
+        raise HTTPException(status_code=404)
+    if j.state in (JobState.done, JobState.error):
+        return {"ok": False, "reason": "finished"}
+    j.state = JobState.cancelled
+    db.commit()
+    upload_evidence("qpu/cancel", {"job_id": job_id, "by": user.get("preferred_username")})
+    return {"ok": True}
+
+
+@app.get("/estimate")
+def estimate(provider: str = "local_sim", shots: int = 1024):
+    per_shot = {"local_sim": 0.0, "ibm": 0.0005, "aws_braket": 0.001}
+    latency = {"local_sim": 0.1, "ibm": 30, "aws_braket": 10}
+    return {"cost_est_usd": per_shot.get(provider, 0.01) * shots, "latency_s": latency.get(provider, 30)}
