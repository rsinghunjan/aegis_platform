+"""
+Simulator farm runner: runs many noisy sims in parallel and uploads evidence to S3/HDFS.
+ - Designed to be run on an HPC or batch system; for Kubernetes, run as a Job with high parallelism.
+"""
+import os, json, time
+from concurrent.futures import ThreadPoolExecutor
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+S3 = boto3.client("s3") if boto3 and EVIDENCE_BUCKET else None
+
+def run_sim(i, noise_level=0.01):
+    # PoC: simulate and write counts
+    res = {"run": i, "noise": noise_level, "counts": {"00": 500, "11": 500}, "ts": int(time.time())}
+    key = f"simulations/noisy/run-{i}-{int(time.time())}.json"
+    if S3:
+        S3.put_object(Bucket=EVIDENCE_BUCKET, Key=key, Body=json.dumps(res).encode("utf-8"))
+        return f"s3://{EVIDENCE_BUCKET}/{key}"
+    else:
+        p = f"/tmp/{key.replace('/','_')}"
+        os.makedirs(os.path.dirname(p), exist_ok=True)
+        with open(p, "w") as f:
+            json.dump(res, f)
+        return p
+
+def run_many(n=1000, workers=32):
+    with ThreadPoolExecutor(max_workers=workers) as ex:
+        futures = [ex.submit(run_sim, i) for i in range(n)]
+        return [f.result() for f in futures]
+
+if __name__ == "__main__":
+    import sys
+    n = int(sys.argv[1]) if len(sys.argv) > 1 else 100
+    run_many(n=n, workers=int(os.environ.get("SIM_WORKERS","16")))
