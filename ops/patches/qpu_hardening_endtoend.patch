+#!/usr/bin/env bash
+set -euo pipefail
+#
+# CLI helper to create/update provider secrets in AWS Secrets Manager for QPU adapters.
+# Usage:
+#   ./ops/scripts/provision_provider_secrets.sh --provider braket --name staging/qpu/aws_braket --payload '{"region":"us-east-1"}'
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --provider) PROVIDER="$2"; shift 2;;
+    --name) NAME="$2"; shift 2;;
+    --payload) PAYLOAD="$2"; shift 2;;
+    *) echo "Unknown arg $1"; exit 2;;
+  esac
+done
+
+if [ -z "${PROVIDER:-}" ] || [ -z "${NAME:-}" ]; then
+  echo "Usage: $0 --provider <braket|ibm|azure> --name <secretsmanager-name> [--payload '<json>']"
+  exit 2
+fi
+
+PAYLOAD=${PAYLOAD:-"{}"}
+if aws secretsmanager describe-secret --secret-id "$NAME" >/dev/null 2>&1; then
+  echo "Updating secret $NAME"
+  aws secretsmanager put-secret-value --secret-id "$NAME" --secret-string "$PAYLOAD"
+else
+  echo "Creating secret $NAME"
+  aws secretsmanager create-secret --name "$NAME" --secret-string "$PAYLOAD"
+fi
+
+echo "Secret provisioned: $NAME"
+
