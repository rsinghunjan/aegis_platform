+  echo "EVIDENCE_BUCKET required (export variable)"
+  exit 2
+fi
+
+echo "Applying simulator large job manifest..."
+kubectl -n cicd apply -f ops/tekton/sim-hpc-job-large.yaml || true
+
+echo "Waiting for Job to start... (sleep 30s)"
+sleep 30
+
+echo "Polling for completion (best-effort)..."
+JOBNAME=simulator-farm-large-hpc
+while true; do
+  active=$(kubectl -n cicd get job "$JOBNAME" -o jsonpath='{.status.active}' 2>/dev/null || echo 0)
+  succ=$(kubectl -n cicd get job "$JOBNAME" -o jsonpath='{.status.succeeded}' 2>/dev/null || echo 0)
+  if [ "$active" = "" ] || [ "$active" = "0" ]; then
+    echo "No active pods. succeeded=$succ"
+    break
+  fi
+  echo "Active=$active succeeded=$succ; sleeping 30s"
+  sleep 30
+done
+
+echo "Run aggregator to bundle evidence and sign"
+python services/quantum/sim_aggregator.py simulations || echo "Aggregator returned non-zero"
