+/*
+Terraform: Create provider SecretsManager secrets and an IAM role for IRSA allowing QPU workers to read them.
+Fill variables in terraform/aws/variables.tf or pass via CLI.
+*/
+provider "aws" {
+  region = var.aws_region
+}
+
+resource "aws_secretsmanager_secret" "aws_braket" {
+  name = "${var.environment}/qpu/aws_braket"
+  description = "AWS Braket credentials for Aegis QPU workers (PoC). Store JSON {\"access_key\":\"...\",\"secret_key\":\"...\"} or assume IRSA."
+}
+
+resource "aws_secretsmanager_secret" "ibm" {
+  name = "${var.environment}/qpu/ibm"
+  description = "IBM Q API token secret (JSON or plain string)"
+}
+
+resource "aws_secretsmanager_secret" "azure" {
+  name = "${var.environment}/qpu/azure"
+  description = "Azure Quantum service principal credentials or connection string"
+}
+
+resource "aws_iam_role" "qpu_worker_irsa" {
+  name = "${var.environment}-qpu-worker-irsa"
+  assume_role_policy = data.aws_iam_policy_document.irsa_assume_role.json
+}
+
+data "aws_iam_policy_document" "irsa_assume_role" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+    principals {
+      type        = "Federated"
+      identifiers = [var.eks_oidc_provider_arn]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "${replace(var.eks_oidc_provider_url, "https://", "")}:sub"
+      values   = ["system:serviceaccount:${var.qpu_namespace}:${var.qpu_service_account}"]
+    }
+  }
+}
+
+resource "aws_iam_policy" "qpu_worker_secrets_policy" {
+  name = "${var.environment}-qpu-secrets-policy"
+  policy = jsonencode({
+    Version = "2012-10-17",
+    Statement = [
+      {
+        Effect = "Allow",
+        Action = [
+          "secretsmanager:GetSecretValue",
+          "secretsmanager:DescribeSecret"
+        ],
+        Resource = [
+          aws_secretsmanager_secret.aws_braket.arn,
+          aws_secretsmanager_secret.ibm.arn,
+          aws_secretsmanager_secret.azure.arn
+        ]
+      },
+      {
+        Effect = "Allow",
+        Action = [
+          "s3:GetObject",
+          "s3:PutObject",
+          "s3:ListBucket"
+        ],
+        Resource = [
+          var.evidence_bucket_arn,
+          "${var.evidence_bucket_arn}/*"
+        ]
+      },
+      {
+        Effect = "Allow",
+        Action = ["kms:Decrypt","kms:GenerateDataKey"],
+        Resource = [var.kms_key_arn]
+      }
+    ]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "attach_qpu_policy" {
+  role       = aws_iam_role.qpu_worker_irsa.name
+  policy_arn = aws_iam_policy.qpu_worker_secrets_policy.arn
+}
+
+output "qpu_worker_irsa_role_arn" {
+  value = aws_iam_role.qpu_worker_irsa.arn
+}
+
