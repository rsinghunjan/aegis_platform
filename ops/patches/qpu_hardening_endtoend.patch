+#!/usr/bin/env python3
+"""
+Utility to submit a small QPU job using provider adapters and poll until completion.
+Uses secretsmanager_provider.get_secret to fetch credentials when needed.
+"""
+import os, time, logging
+from services.quantum.credentials.secretsmanager_provider import get_secret
+
+logger = logging.getLogger("test-submit")
+logging.basicConfig(level=logging.INFO)
+
+def submit_and_poll(provider="local_sim", evidence_bucket=None):
+    from services.quantum.db_models import init_db, SessionLocal, QPUJob, JobState
+    init_db()
+    session = SessionLocal()
+    # Build a small job spec
+    job_id = f"smoke-{int(time.time())}"
+    payload = {"shots": 128, "qasm": "bell"}
+    job_spec = {"job_id": job_id, "provider": provider, "payload": payload}
+    # Fetch provider creds if required (PoC secret names)
+    if provider in ("aws_braket","braket"):
+        secret = get_secret("staging/qpu/aws_braket")
+        logger.info("Fetched Braket secret (len=%d)", len(secret) if secret else 0)
+    if provider.startswith("ibm"):
+        secret = get_secret("staging/qpu/ibm")
+        logger.info("Fetched IBM secret (len=%d)", len(secret) if secret else 0)
+    # For PoC, call the queue service directly (assumes it's reachable via env or cluster DNS)
+    import requests
+    submit_url = os.environ.get("QPU_QUEUE_URL","http://qpu-queue.monitoring.svc:8085/submit")
+    r = requests.post(submit_url, json=job_spec, timeout=10)
+    r.raise_for_status()
+    jid = r.json().get("job_id")
+    logger.info("Submitted job %s -> polling", jid)
+    status_url = os.environ.get("QPU_STATUS_URL","http://qpu-queue.monitoring.svc:8085/status/")
+    for _ in range(60):
+        s = requests.get(status_url + jid, timeout=5)
+        if s.status_code == 200:
+            st = s.json().get("state")
+            logger.info("Job %s state=%s", jid, st)
+            if st in ("done","error","cancelled"):
+                logger.info("Final result: %s", s.json())
+                return s.json()
+        time.sleep(5)
+    raise RuntimeError("timeout waiting for job")
+
+if __name__ == "__main__":
+    submit_and_poll(provider=os.environ.get("PROVIDER","local_sim"), evidence_bucket=os.environ.get("EVIDENCE_BUCKET",""))
+
