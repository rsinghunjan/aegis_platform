+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Stress-test the QPU queue by submitting many small jobs concurrently.
+# Usage: ./ops/scripts/stress_qpu_queue.sh --count 500 --concurrency 20
+
+COUNT=500
+CONC=20
+QUEUE_URL=${QUEUE_URL:-http://qpu-queue.monitoring.svc:8085/submit}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --count) COUNT="$2"; shift 2;;
+    --concurrency) CONC="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+echo "Submitting $COUNT jobs with concurrency $CONC to $QUEUE_URL"
+seq 1 $COUNT | xargs -P "$CONC" -I {} bash -c "curl -sS -X POST -H 'Content-Type: application/json' -d '{\"name\":\"stress-{}\",\"provider\":\"local_sim\",\"payload\":{\"shots\":64}}' $QUEUE_URL >/dev/null || echo failed {}"
+
+echo "Done. Monitor qpu-worker metrics and queue length in Prometheus."
+
