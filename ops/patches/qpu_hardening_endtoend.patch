+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Submit simulator farm job and run aggregator when complete (best-effort).
+# Usage: EVIDENCE_BUCKET=... ./ops/scripts/run_sim_farm_and_aggregate.sh
+
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-}
