+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Capture provider contract metadata and sign with cosign (PoC)
+# Usage: ./services/quantum/capture_contract_and_sign.sh --provider aws_braket --terms-url "https://aws/terms" --signer alice
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --provider) PROVIDER="$2"; shift 2;;
+    --terms-url) TERMS="$2"; shift 2;;
+    --signer) SIGNER="$2"; shift 2;;
+    *) shift;;
+  esac
+done
+
+if [ -z "${PROVIDER:-}" ] || [ -z "${TERMS:-}" ] || [ -z "${SIGNER:-}" ]; then
+  echo "Usage: $0 --provider <name> --terms-url <url> --signer <name>"
+  exit 2
+fi
+
+TMP=/tmp/qpu-contract-$(date -u +%Y%m%dT%H%M%SZ).json
+cat > "$TMP" <<EOF
+{
+  "provider": "$PROVIDER",
+  "terms_url": "$TERMS",
+  "accepted_by": "$SIGNER",
+  "accepted_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+}
+EOF
+
+if command -v cosign >/dev/null 2>&1 && [ -f "${COSIGN_KEY:-./cosign.key}" ]; then
+  cosign sign --key "${COSIGN_KEY:-./cosign.key}" "$TMP" || true
+fi
+
+if [ -n "${EVIDENCE_BUCKET:-}" ]; then
+  aws s3 cp "$TMP" "s3://$EVIDENCE_BUCKET/qpu/contracts/$(basename $TMP)"
+  [ -f "${TMP}.sig" ] && aws s3 cp "${TMP}.sig" "s3://$EVIDENCE_BUCKET/qpu/contracts/$(basename ${TMP}.sig)" || true
+fi
+
+echo "Captured and (optionally) signed contract metadata: $TMP"
+
