+"""
+Milvus-backed retriever abstraction with FAISS fallback.
+ - stores documents with ids and textual content
+ - supports upsert_documents(docs) and query(text, top_k)
+ - computes simple retrieval metrics (recall@k) given labelled qrels
+"""
+import os
+import time
+from typing import List, Dict
+import numpy as np
+
+try:
+    from pymilvus import connections, FieldSchema, CollectionSchema, DataType, Collection, utility
+    MILVUS_AVAILABLE = True
+except Exception:
+    MILVUS_AVAILABLE = False
+
+from sentence_transformers import SentenceTransformer
+EMBED_MODEL = SentenceTransformer(os.environ.get("RETRIEVAL_EMBED_MODEL","all-MiniLM-L6-v2"))
+
+class Retriever:
+    def __init__(self, collection_name: str = "aegis_corpus"):
+        self.collection_name = collection_name
+        self.emb_model = EMBED_MODEL
+        if MILVUS_AVAILABLE and os.environ.get("MILVUS_URI"):
+            host = os.environ.get("MILVUS_URI").split(":")[0]
+            port = int(os.environ.get("MILVUS_URI").split(":")[1])
+            connections.connect("default", host=host, port=port)
+            if not utility.has_collection(collection_name):
+                # create table
+                id_field = FieldSchema(name="doc_id", dtype=DataType.VARCHAR, is_primary=True, max_length=256)
+                text_field = FieldSchema(name="text", dtype=DataType.VARCHAR, is_primary=False, max_length=65535)
+                emb_field = FieldSchema(name="embedding", dtype=DataType.FLOAT_VECTOR, dim=EMBED_MODEL.get_sentence_embedding_dimension())
+                schema = CollectionSchema([id_field, text_field, emb_field], description="Aegis doc collection")
+                self.collection = Collection(collection_name, schema)
+            else:
+                self.collection = Collection(collection_name)
+            self.use_milvus = True
+        else:
+            self.use_milvus = False
+            # FAISS fallback: in-memory lists
+            self.docs = []
+            self.doc_ids = []
+            self.embs = None
+
+    def upsert_documents(self, docs: List[Dict]):
+        """
+        docs: list of {"id": str, "text": str}
+        """
+        texts = [d["text"] for d in docs]
+        ids = [d["id"] for d in docs]
+        embs = self.emb_model.encode(texts, convert_to_numpy=True)
+        if self.use_milvus:
+            # Milvus expects list of columns
+            self.collection.insert([ids, texts, embs.tolist()])
+            self.collection.flush()
+        else:
+            self.doc_ids.extend(ids)
+            self.docs.extend(texts)
+            if self.embs is None:
+                self.embs = embs
+            else:
+                self.embs = np.vstack([self.embs, embs])
+
+    def query(self, text: str, top_k: int = 5) -> List[Dict]:
+        q_emb = self.emb_model.encode([text], convert_to_numpy=True)
+        if self.use_milvus:
+            res = self.collection.search(q_emb.tolist(), "embedding", {"metric_type":"IP"}, limit=top_k, output_fields=["doc_id","text"])
+            out = []
+            for hits in res:
+                for h in hits:
+                    out.append({"id": h.entity.get("doc_id"), "text": h.entity.get("text"), "score": float(h.score)})
+            return out
+        else:
+            if self.embs is None or len(self.docs)==0:
+                return []
+            import numpy as np
+            scores = (self.embs @ q_emb[0]).tolist()
+            idxs = list(np.argsort(scores)[::-1][:top_k])
+            out = [{"id": self.doc_ids[i], "text": self.docs[i], "score": float(scores[i])} for i in idxs]
+            return out
+
+    def recall_at_k(self, queries: List[Dict], k=5) -> float:
+        """
+        queries: list of {q: text, relevant_ids: [id...]}
+        Returns average recall@k
+        """
+        total = 0
+        hit = 0
+        for q in queries:
+            r = self.query(q["q"], top_k=k)
+            retrieved_ids = set(item["id"] for item in r)
+            rel = set(q.get("relevant_ids", []))
+            if len(rel)==0: continue
+            total += 1
+            if len(retrieved_ids & rel) > 0:
+                hit += 1
+        return float(hit)/max(1,total)
+
+if __name__ == "__main__":
+    r = Retriever()
+    docs = [{"id":"d1","text":"Paris is the capital of France."},{"id":"d2","text":"Berlin is the capital of Germany."}]
+    r.upsert_documents(docs)
+    print(r.query("Where is the Eiffel Tower?", top_k=2))
+
