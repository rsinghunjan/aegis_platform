+"""
+Human review queue service.
+ - receives flagged items (text, model_output, provenance, severity)
+ - stores queue in Postgres (requires DATABASE_URL)
+ - exposes endpoints for rater UI to list tasks, claim tasks, submit decisions
+ - emits events to re-evaluate items (webhook) or call CI gating on resolution
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+import os, psycopg2, json, time
+from typing import Optional
+
+DB = os.environ.get("DATABASE_URL")
+app = FastAPI()
+
+class FlagItem(BaseModel):
+    task_id: Optional[str]
+    text: str
+    output: str
+    provenance: dict
+    severity: str = "medium"
+    reported_by: Optional[str]
+
+def get_conn():
+    if not DB:
+        raise RuntimeError("DATABASE_URL not configured")
+    return psycopg2.connect(DB)
+
+@app.post("/enqueue")
+def enqueue(item: FlagItem):
+    conn = get_conn(); cur = conn.cursor()
+    cur.execute("INSERT INTO human_queue (text, output, provenance, severity, reported_by, status, created_at) VALUES (%s,%s,%s,%s,%s,%s, now()) RETURNING id",
+                (item.text, item.output, json.dumps(item.provenance), item.severity, item.reported_by, "open"))
+    id = cur.fetchone()[0]
+    conn.commit(); cur.close(); conn.close()
+    return {"task_id": str(id)}
+
+@app.get("/tasks")
+def list_tasks(limit: int = 50):
+    conn = get_conn(); cur = conn.cursor()
+    cur.execute("SELECT id, text, output, provenance, severity, status, claimed_by FROM human_queue WHERE status IN ('open','claimed') ORDER BY created_at DESC LIMIT %s",(limit,))
+    rows = cur.fetchall(); cur.close(); conn.close()
+    out=[]
+    for r in rows:
+        out.append({"id": r[0], "text": r[1], "output": r[2], "provenance": r[3], "severity": r[4], "status": r[5], "claimed_by": r[6]})
+    return out
+
+@app.post("/claim/{task_id}")
+def claim(task_id: int, claimer: str):
+    conn = get_conn(); cur = conn.cursor()
+    cur.execute("UPDATE human_queue SET status='claimed', claimed_by=%s, claimed_at=now() WHERE id=%s AND status='open' RETURNING id", (claimer, task_id))
+    res = cur.fetchone()
+    conn.commit(); cur.close(); conn.close()
+    if not res:
+        raise HTTPException(status_code=404, detail="task not available")
+    return {"claimed": True, "task_id": task_id}
+
+@app.post("/resolve/{task_id}")
+def resolve(task_id: int, verdict: str, reviewer: str, notes: Optional[str]=None):
+    conn = get_conn(); cur = conn.cursor()
+    cur.execute("UPDATE human_queue SET status='resolved', verdict=%s, reviewed_by=%s, review_notes=%s, resolved_at=now() WHERE id=%s RETURNING id", (verdict, reviewer, notes, task_id))
+    res = cur.fetchone()
+    conn.commit(); cur.close(); conn.close()
+    if not res:
+        raise HTTPException(status_code=404, detail="task not found")
+    # Optionally trigger re-eval or call webhooks here
+    return {"resolved": True}
