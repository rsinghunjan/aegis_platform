+"""
+Simple uncertainty scoring utilities:
+ - generation_entropy: token-level softmax entropy
+ - ensemble_variance: variance across multiple sampled generations
+ - verifier_confidence: uses NLI verifier score
+
+These signals can be combined into a conservative abstain decision.
+"""
+import math
+import numpy as np
+from typing import List
+
+def softmax(xs):
+    ex = np.exp(xs - np.max(xs))
+    return ex / ex.sum()
+
+def token_entropy(logits: List[float]) -> float:
+    p = softmax(np.array(logits))
+    return -float(np.sum(p * np.log(np.clip(p,1e-12,1.0))))
+
+def generation_entropy_from_logits(logits_matrix: List[List[float]]) -> float:
+    # average token entropies
+    ent = [token_entropy(l) for l in logits_matrix]
+    return float(np.mean(ent)) if ent else 0.0
+
+def ensemble_variance(generated_texts: List[str]) -> float:
+    # approximate via embedding variance
+    from sentence_transformers import SentenceTransformer
+    model = SentenceTransformer("all-MiniLM-L6-v2")
+    embs = model.encode(generated_texts, convert_to_numpy=True)
+    return float(np.mean(np.var(embs, axis=0)))
+
+def combined_uncertainty(entropy_score: float, ensemble_var: float, verifier_score: float) -> float:
+    # normalized combination (weights can be tuned)
+    return 0.5*entropy_score + 0.3*ensemble_var + 0.2*(1.0 - verifier_score)
+
