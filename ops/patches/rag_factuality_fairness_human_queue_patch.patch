+"""
+Auto-calibration service:
+ - periodically pulls labeled safety/rater events from rater backend DB (requires DATABASE_URL)
+ - runs calibration to compute thresholds.json and deploys to safety service configmap
+ - keeps a versioned history of thresholds in an S3 bucket or GH release (configurable)
+"""
+import os, time, json, subprocess
+import psycopg2
+
+DB = os.environ.get("DATABASE_URL")
+SAFETY_CALIB_OUT = os.environ.get("SAFETY_CALIB_OUT", "/tmp/thresholds.json")
+S3_HISTORY_BUCKET = os.environ.get("SAFETY_THRESH_BUCKET", "")
+POLL_INTERVAL = int(os.environ.get("CALIB_INTERVAL_SECS", "3600"))
+
+def fetch_labeled_examples(limit=1000):
+    if not DB:
+        print("DATABASE_URL not set")
+        return []
+    conn = psycopg2.connect(DB)
+    cur = conn.cursor()
+    cur.execute("SELECT text, toxicity_label, pii_label FROM rater_labels WHERE created_at > now() - interval '7 days' LIMIT %s", (limit,))
+    rows = cur.fetchall()
+    cur.close(); conn.close()
+    out = []
+    for row in rows:
+        out.append({"text": row[0], "toxicity_label": int(row[1]), "pii_label": int(row[2])})
+    return out
+
+def write_jsonl(items, path):
+    with open(path,"w") as f:
+        for it in items:
+            f.write(json.dumps(it)+"\n")
+
+def run_calibration_cycle():
+    examples = fetch_labeled_examples()
+    if not examples:
+        print("No new labels found")
+        return
+    tmp = "/tmp/calib.jsonl"
+    write_jsonl(examples, tmp)
+    subprocess.check_call(["python","ops/safety/calibrate_thresholds.py","--in", tmp, "--out", SAFETY_CALIB_OUT])
+    # deploy to k8s
+    subprocess.check_call(["./ops/safety/apply_thresholds_and_deploy.sh", SAFETY_CALIB_OUT])
+    # archive
+    if S3_HISTORY_BUCKET:
+        subprocess.check_call(["aws","s3","cp", SAFETY_CALIB_OUT, f"s3://{S3_HISTORY_BUCKET}/thresholds_{int(time.time())}.json"])
+
+def main_loop():
+    while True:
+        try:
+            run_calibration_cycle()
+        except Exception as e:
+            print("calibration error", e)
+        time.sleep(POLL_INTERVAL)
+
+if __name__ == "__main__":
+    main_loop()
+
