+"""
+RAG middleware that integrates retriever + generator + verifier + provenance linking.
+ - retrieve top-k passages
+ - prepare a context prompt for generator including attributed passages
+ - call generator (HF model) to produce an answer
+ - verify answer with NLI verifier against retrieved passages
+ - produce provenance mapping tokens -> evidence id (approximate)
+
+This module is intended to be used by your inference service to produce evidence-backed outputs.
+"""
+from typing import List, Dict, Any
+import os, re
+from transformers import AutoModelForCausalLM, AutoTokenizer
+from services.factuality.nli_verifier import get_verifier
+from ops.retriever.milvus_retriever import Retriever
+import numpy as np
+
+RETRIEVER_COLLECTION = os.environ.get("RETRIEVER_COLLECTION","aegis_corpus")
+GEN_MODEL = os.environ.get("RAG_GEN_MODEL","gpt2")
+TOP_K = int(os.environ.get("RAG_TOP_K","5"))
+
+retriever = Retriever(RETRIEVER_COLLECTION)
+verifier = get_verifier()
+
+tokenizer = AutoTokenizer.from_pretrained(GEN_MODEL)
+gen_model = AutoModelForCausalLM.from_pretrained(GEN_MODEL)
+
+def build_context(passages: List[Dict], max_passages=5) -> str:
+    ctx = []
+    for i,p in enumerate(passages[:max_passages]):
+        ctx.append(f"[{p['id']}] {p['text']}")
+    return "\n\n".join(ctx)
+
+def generate_with_rag(prompt: str, top_k: int = TOP_K, gen_kwargs=None) -> Dict[str, Any]:
+    # Retrieve
+    passages = retriever.query(prompt, top_k=top_k)
+    context = build_context(passages)
+    # Build final prompt: context + instruction
+    full_prompt = f"Context:\n{context}\n\nQuestion: {prompt}\nAnswer concisely and cite evidence ids in square brackets."
+    inputs = tokenizer(full_prompt, return_tensors="pt", truncation=True)
+    out_ids = gen_model.generate(**inputs, max_length=256, **(gen_kwargs or {}))
+    out_text = tokenizer.decode(out_ids[0], skip_special_tokens=True)
+    # Basic heuristic: extract citations like [docid]
+    cited = re.findall(r"\[([^\]]+)\]", out_text)
+    # Verify the whole answer (or sentence-wise)
+    v = verifier.verify_claim(out_text, passages)
+    # provenance mapping (approx): for each sentence map to best evidence id by similarity
+    sentences = re.split(r'(?<=[\.\?\!])\s+', out_text)
+    provenance = []
+    for s in sentences:
+        best_id = None
+        best_score = 0.0
+        for p in passages:
+            # coarse similarity by cosine of embeddings (uses retriever embeddings model)
+            emb_s = retriever.emb_model.encode([s], convert_to_numpy=True)[0]
+            emb_p = retriever.emb_model.encode([p["text"]], convert_to_numpy=True)[0]
+            sim = float(np.dot(emb_s, emb_p) / (np.linalg.norm(emb_s)*np.linalg.norm(emb_p)+1e-10))
+            if sim > best_score:
+                best_score = sim; best_id = p["id"]
+        provenance.append({"sentence": s, "best_evidence_id": best_id, "similarity": best_score})
+    return {"answer": out_text, "verifier": v, "provenance": provenance, "retrieved": passages}
+
+if __name__ == "__main__":
+    res = generate_with_rag("Where is the Eiffel Tower?")
+    print(res)
+
