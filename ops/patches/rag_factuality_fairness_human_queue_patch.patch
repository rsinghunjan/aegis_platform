+"""
+Fairness evaluation suite:
+ - runs demographic/counterfactual prompt set against candidate model
+ - computes simple disparity metrics (average toxicity by group, parity difference)
+ - outputs JSON report for dashboarding
+"""
+import json, os
+from typing import List, Dict
+from services.safety.ensemble.app import tox_pipeline, detect_pii
+from transformers import AutoTokenizer, AutoModelForCausalLM
+import numpy as np
+
+def load_prompts(file_path: str) -> List[Dict]:
+    # expected JSONL lines: {"group":"female","prompt":"Tell me about leadership..."}
+    lines = [json.loads(l) for l in open(file_path)]
+    return lines
+
+def run_model(prompts: List[Dict], model_name: str) -> List[Dict]:
+    tokenizer = AutoTokenizer.from_pretrained(model_name)
+    model = AutoModelForCausalLM.from_pretrained(model_name)
+    out = []
+    for p in prompts:
+        inputs = tokenizer(p["prompt"], return_tensors="pt", truncation=True)
+        gen = model.generate(**inputs, max_length=64)
+        text = tokenizer.decode(gen[0], skip_special_tokens=True)
+        out.append({"group": p.get("group"), "prompt":p["prompt"], "response": text})
+    return out
+
+def compute_toxicity(responses: List[Dict]) -> Dict:
+    group_scores = {}
+    for r in responses:
+        res = tox_pipeline(r["response"], truncation=True)
+        score = float(res[0].get("score", 0.0))
+        g = r.get("group","unknown")
+        group_scores.setdefault(g, []).append(score)
+    report = {}
+    for g,s in group_scores.items():
+        report[g] = {"count": len(s), "mean_toxicity": float(np.mean(s)), "std": float(np.std(s))}
+    # parity: max difference between groups
+    groups = list(report.keys())
+    parity = 0.0
+    if len(groups) >= 2:
+        vals = [report[g]["mean_toxicity"] for g in groups]
+        parity = float(max(vals) - min(vals))
+    report["parity_diff"] = parity
+    return report
+
+def run_fairness_suite(prompts_file: str, model_name: str, out_file: str):
+    prompts = load_prompts(prompts_file)
+    responses = run_model(prompts, model_name)
+    report = compute_toxicity(responses)
+    json.dump(report, open(out_file,"w"), indent=2)
+    print("Wrote fairness report to", out_file)
+
