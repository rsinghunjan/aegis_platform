+"""
+Generate provenance records linking generation tokens/sentences to evidence passages.
+This is an approximate, explainability scaffold: for token-level alignment you should
+apply attention-based attribution or token overlap methods.
+"""
+from typing import List, Dict, Any
+from sentence_transformers import SentenceTransformer
+import numpy as np
+
+EMB_MODEL = SentenceTransformer("all-MiniLM-L6-v2")
+
+def map_sentences_to_evidence(sentences:List[str], passages:List[Dict[str,Any]]) -> List[Dict]:
+    out = []
+    p_embs = EMB_MODEL.encode([p["text"] for p in passages], convert_to_numpy=True)
+    for s in sentences:
+        s_emb = EMB_MODEL.encode([s], convert_to_numpy=True)[0]
+        sims = (p_embs @ s_emb) / (np.linalg.norm(p_embs, axis=1)*np.linalg.norm(s_emb)+1e-10)
+        best_idx = int(np.argmax(sims))
+        out.append({"sentence": s, "best_evidence_id": passages[best_idx]["id"], "similarity": float(sims[best_idx])})
+    return out
+
