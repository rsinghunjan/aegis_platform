+"""
+NLI-based factuality verifier wrapper.
+Uses a pretrained NLI model (e.g., roberta-large-mnli / facebook/bart-large-mnli) to score
+entailment between a claim (model output) and candidate evidence passages.
+
+API:
+  verify_claim(claim:str, evidence: List[{"id":..., "text":...}]) -> {
+    "best_evidence_id": id or None,
+    "score": float (0..1 entailment prob),
+    "verdict": "support"/"contradict"/"neutral"/"insufficient",
+    "evidence_scores": [ {id, score} ... ]
+  }
+
+Calibration:
+ - You should compute verifier thresholds on domain-labeled claim↔evidence datasets.
+ - The calibrate tool (ops/safety/calibrate_thresholds.py) can be adapted to tune this verifier.
+"""
+from typing import List, Dict, Any
+import os
+import numpy as np
+from transformers import pipeline
+
+# Model choice can be configured via env var
+NLI_MODEL = os.environ.get("NLI_MODEL", "facebook/bart-large-mnli")
+# mapping: pipeline label -> normalized score
+LABEL_MAP = {"ENTAILMENT": "support", "CONTRADICTION": "contradict", "NEUTRAL": "neutral"}
+
+class NliVerifier:
+    def __init__(self, model_name: str = NLI_MODEL):
+        self.clf = pipeline("zero-shot-classification", model=model_name) if "zero-shot" in model_name else pipeline("text-classification", model=model_name, return_all_scores=True)
+        # fallback mode detection
+        self.use_zs = False
+
+    def _score_pair(self, claim: str, evidence_text: str) -> float:
+        """
+        Return an entailment score (0..1) estimating support for claim given evidence.
+        Using M-NLI-style models; adapt mapping as needed for your model outputs.
+        """
+        try:
+            # Some classification pipelines return label/score. Use wrapper for M-NLI style.
+            res = self.clf(f"{evidence_text}", f"{claim}")
+            # res could be list of dicts or list of labels depending on pipeline
+            # Standard HF entailment models produce label+score in text-classification with return_all_scores
+            if isinstance(res, list) and isinstance(res[0], dict) and "label" in res[0]:
+                # return max entailment-like label score mapping if possible
+                # attempt to find ENTAILMENT label
+                for entry in res:
+                    lbl = entry.get("label", "").upper()
+                    scr = entry.get("score", 0.0)
+                    if "ENTAIL" in lbl:
+                        return float(scr)
+                # fallback to highest score
+                return float(max(e.get("score", 0.0) for e in res))
+            # fallback: if using zero-shot, estimate via hypothesis template
+            if isinstance(res, dict) and "labels" in res and "scores" in res:
+                # not strictly entailment but produce an approximate confidence
+                labels = res["labels"]
+                scores = res["scores"]
+                # if 'entailment' label exists map it, else return max
+                for l,s in zip(labels, scores):
+                    if "entail" in l.lower():
+                        return float(s)
+                return float(max(scores))
+        except Exception:
+            pass
+        return 0.0
+
+    def verify_claim(self, claim: str, evidence: List[Dict[str, Any]], min_support: float = 0.35) -> Dict[str, Any]:
+        """
+        Score claim against provided evidence passages and return best evidence + score and verdict.
+        min_support should be calibrated on your domain.
+        """
+        evidence_scores = []
+        for e in evidence:
+            txt = e.get("text", "")
+            score = self._score_pair(claim, txt)
+            evidence_scores.append({"id": e.get("id"), "score": float(score), "text_snippet": txt[:400]})
+        if not evidence_scores:
+            return {"best_evidence_id": None, "score": 0.0, "verdict": "insufficient", "evidence_scores": []}
+        evidence_scores.sort(key=lambda x: x["score"], reverse=True)
+        best = evidence_scores[0]
+        verdict = "support" if best["score"] >= min_support else "insufficient"
+        return {"best_evidence_id": best["id"], "score": best["score"], "verdict": verdict, "evidence_scores": evidence_scores}
+
+# helper instance (shared)
+_VERIFIER = None
+
+def get_verifier():
+    global _VERIFIER
+    if _VERIFIER is None:
+        _VERIFIER = NliVerifier()
+    return _VERIFIER
+
+if __name__ == "__main__":
+    v = get_verifier()
+    sample_claim = "The Eiffel Tower is in Berlin."
+    evid = [{"id":"doc1", "text":"The Eiffel Tower is a wrought-iron lattice tower in Paris."},
+            {"id":"doc2","text":"Berlin is the capital of Germany."}]
+    print(v.verify_claim(sample_claim, evid))
