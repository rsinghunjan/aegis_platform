+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Promotion helper: reads the latest readiness report and (if criteria met and Legal signoff present)
+# performs the controlled Gatekeeper deny promotion and records promotion evidence.
+#
+# Usage:
+#   export EVIDENCE_BUCKET=s3://aegis-evidence-prod
+#   export LEGAL_SIGNOFF_S3_KEY="compliance/legal_signoff.txt"   # path under evidence bucket that signals legal approval
+#   ./ops/production/promote_to_level4.sh --min-readiness 85
+
+EVIDENCE=${EVIDENCE_BUCKET:-}
+MIN_READINESS=85
+LEGAL_SIGNOFF_KEY=${LEGAL_SIGNOFF_S3_KEY:-"compliance/legal_signoff.txt"}
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --min-readiness) MIN_READINESS="$2"; shift 2;;
+    --evidence) EVIDENCE="$2"; shift 2;;
+    --legal-key) LEGAL_SIGNOFF_KEY="$2"; shift 2;;
+    -h|--help) echo "Usage: $0 [--min-readiness N] [--evidence s3://bucket] [--legal-key path]"; exit 0;;
+    *) echo "Unknown arg $1"; exit 1;;
+  esac
+done
+
+if [ -z "${EVIDENCE:-}" ]; then
+  echo "EVIDENCE_BUCKET not set. Export EVIDENCE_BUCKET=s3://your-bucket"
+  exit 1
+fi
+
+if ! command -v aws >/dev/null 2>&1; then
+  echo "aws cli is required"
+  exit 1
+fi
+
+echo "Downloading latest readiness report from ${EVIDENCE}"
+BUCKET=${EVIDENCE#s3://}
+LATEST=$(aws s3 ls s3://${BUCKET}/production_proofs/readiness/ --recursive | sort | tail -n 1 | awk '{print $4}')
+if [ -z "${LATEST}" ]; then
+  echo "No readiness report found in s3://${BUCKET}/production_proofs/readiness/"
+  exit 1
+fi
+
+TMP=/tmp/readiness_latest.json
+aws s3 cp s3://${BUCKET}/${LATEST} ${TMP}
+PCT=$(jq '.computed.percent' ${TMP})
+echo "Readiness percent: ${PCT}% (min required: ${MIN_READINESS}%)"
+
+echo "Checking legal signoff key s3://${BUCKET}/${LEGAL_SIGNOFF_KEY}"
+if aws s3 ls s3://${BUCKET}/${LEGAL_SIGNOFF_KEY} >/dev/null 2>&1; then
+  echo "Legal signoff present"
+else
+  echo "Legal signoff NOT present. Place a legal signoff marker at s3://${BUCKET}/${LEGAL_SIGNOFF_KEY} to proceed."
+  exit 1
+fi
+
+if (( $(echo "${PCT} >= ${MIN_READINESS}" | bc -l) )); then
+  echo "Readiness threshold satisfied. Proceeding with controlled Gatekeeper promotion."
+  # Run Gatekeeper controlled rollout and webhook setup (this script will perform canary/verification)
+  bash ops/gatekeeper/controlled_rollout_and_webhook_setup.sh --evidence "${EVIDENCE}"
+  # Record promotion marker
+  MARKER=/tmp/level4_promote_$(date +%s).json
+  echo "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"readiness\":${PCT},\"promoted_by\":\"operator\"}" > ${MARKER}
+  aws s3 cp ${MARKER} ${EVIDENCE}/governance/ || true
+  echo "Promotion recorded to ${EVIDENCE}/governance/"
+  echo "Gatekeeper promotion initiated. You should still perform final manual checks before removing all human gates."
+else
+  echo "Readiness below threshold (${PCT} < ${MIN_READINESS}). Aborting promotion."
+  exit 2
+fi
+
