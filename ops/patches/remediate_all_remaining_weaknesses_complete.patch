+#!/usr/bin/env python3
+"""
+Uploads sim report and proof artifact to GitHub release and opens an SME review issue with links.
+Required env:
+ - GITHUB_REPO
+ - GITHUB_TOKEN
+Usage:
+  python ops/sim/attach_proofs_and_request_sme.py sim_report.json proof.json
+"""
+import sys, os, requests, json, base64
+
+REPO = os.environ.get("GITHUB_REPO")
+TOKEN = os.environ.get("GITHUB_TOKEN")
+
+def upload_release_and_issue(report, proof):
+    headers = {"Authorization": f"token {TOKEN}"}
+    # create release
+    tag = f"sim-report-{int(os.path.getmtime(report))}"
+    body = "Sim results and proofs for SME review"
+    r = requests.post(f"https://api.github.com/repos/{REPO}/releases", headers=headers, json={"tag_name": tag, "name": tag, "body": body})
+    r.raise_for_status()
+    rel = r.json()
+    upload_url = rel["upload_url"].split("{")[0]
+    # upload files
+    for path in [report, proof]:
+        with open(path,"rb") as f:
+            fname = os.path.basename(path)
+            hup = f"{upload_url}?name={fname}"
+            ur = requests.post(hup, headers={**headers,"Content-Type":"application/octet-stream"}, data=f.read())
+            ur.raise_for_status()
+    # create issue
+    title = "SME Review Required: Sim Run & Proofs"
+    body = f"Please review the artifacts: Release {tag}.\n\nAttached: {report}, {proof}\n\nLabel with `sme-approved` to approve promotion."
+    ir = requests.post(f"https://api.github.com/repos/{REPO}/issues", headers=headers, json={"title": title, "body": body})
+    ir.raise_for_status()
+    print("Created SME issue:", ir.json()["html_url"])
+
+if __name__=="__main__":
+    if len(sys.argv) < 3:
+        print("Usage: attach_proofs_and_request_sme.py <sim_report.json> <proof.json>")
+        raise SystemExit(2)
+    upload_release_and_issue(sys.argv[1], sys.argv[2])
