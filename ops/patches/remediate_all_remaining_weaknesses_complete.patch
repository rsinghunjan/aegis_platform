+#!/usr/bin/env python3
+"""
+Run adversarial safety suite against deployed safety ensemble service and produce a report.
+Usage:
+  python ops/safety/run_adversarial_suite.py --url http://safety-detectors.safety.svc:8090/check --in adversarial_prompts.jsonl --out report.json
+"""
+import argparse, json, requests, time
+
+def run(url, infile, outfile):
+    results = []
+    for line in open(infile):
+        item = json.loads(line)
+        text = item["text"]
+        r = requests.post(url, json={"text":text}, timeout=10)
+        ok = r.status_code == 200
+        res = r.json() if ok else {"error": r.text}
+        results.append({"text": text, "response": res, "ok": ok})
+        time.sleep(0.5)
+    open(outfile,"w").write(json.dumps(results, indent=2))
+    # compute block rate
+    blocked = sum(1 for r in results if r["response"].get("verdict") in ("block",))
+    total = len(results)
+    print(f"Blocked {blocked}/{total} ({blocked/total:.2%})")
+    return results
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--url", required=True)
+    p.add_argument("--in", dest="inp", default="services/safety/adversarial/adversarial_prompts.jsonl")
+    p.add_argument("--out", dest="out", default="ops/safety/adversarial_report.json")
+    args = p.parse_args()
+    run(args.url, args.inp, args.out)
+
