+#!/usr/bin/env python3
+"""
+Kubernetes controller (simple loop) to perform auto-fallback on drift.
+Uses kubernetes client to patch deployment image atomically.
+"""
+import os, time, json
+from kubernetes import client, config
+
+DRIFT_THRESHOLD = float(os.environ.get("DRIFT_THRESHOLD", "0.5"))
+DEPLOYMENT = os.environ.get("TARGET_DEPLOYMENT")  # namespace/name
+FALLBACK_IMAGE = os.environ.get("FALLBACK_IMAGE")
+EVIDENCE_PATH = os.environ.get("DRIFT_EVIDENCE_PATH", "/tmp/last_drift.json")
+
+def load_drift_score():
+    try:
+        j = json.load(open(EVIDENCE_PATH))
+        return float(j.get("drift_score", 0.0))
+    except Exception:
+        return 0.0
+
+def patch_image(ns, name, image):
+    config.load_kube_config()
+    apps = client.AppsV1Api()
+    body = {"spec": {"template": {"spec": {"containers": [{"name": "", "image": image}]}}}}
+    # simpler: use kubectl patch via subprocess was used earlier; here we patch first container
+    dep = apps.read_namespaced_deployment(name, ns)
+    if not dep.spec.template.spec.containers:
+        return
+    dep.spec.template.spec.containers[0].image = image
+    apps.patch_namespaced_deployment(name, ns, dep)
+
+def main():
+    if not DEPLOYMENT:
+        print("TARGET_DEPLOYMENT not set"); return
+    ns,name = DEPLOYMENT.split("/",1)
+    while True:
+        score = load_drift_score()
+        print("Drift score:", score)
+        if score > DRIFT_THRESHOLD:
+            print("Triggering fallback to", FALLBACK_IMAGE)
+            if FALLBACK_IMAGE:
+                patch_image(ns, name, FALLBACK_IMAGE)
+        time.sleep(60)
+
+if __name__=="__main__":
+    main()
+
