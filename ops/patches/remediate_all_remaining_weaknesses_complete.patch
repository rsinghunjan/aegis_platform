+#!/usr/bin/env python3
+"""
+Sign and verify attestation PCR policy using AWS KMS asymmetric signing keys.
+ - Requires an AWS KMS asymmetric key (KeySpec RSA_3072 or RSA_4096 with Signing algorithms RSASSA_PKCS1_V1_5_SHA_256 etc.)
+ - Uses boto3 KMS sign/verify APIs.
+
+Usage:
+  python policy_kms_sign_aws.py sign --policy policy.json --key-id arn:aws:kms:... --out signed_policy.json
+  python policy_kms_sign_aws.py verify --signed signed_policy.json --key-id arn:aws:kms:...
+"""
+import argparse, json, base64, boto3
+from botocore.exceptions import ClientError
+
+kms = boto3.client("kms")
+
+def sign_policy_kms(policy_path, key_id, out_path):
+    policy = open(policy_path,"rb").read()
+    try:
+        r = kms.sign(KeyId=key_id, Message=policy, MessageType='RAW', SigningAlgorithm='RSASSA_PKCS1_V1_5_SHA_256')
+        sig = base64.b64encode(r['Signature']).decode()
+        wrapper = {"policy": json.loads(policy.decode("utf-8")), "signature": sig, "kms_key_id": key_id}
+        open(out_path,"w").write(json.dumps(wrapper, indent=2))
+        print("Wrote signed policy to", out_path)
+    except ClientError as e:
+        print("KMS sign failed:", e)
+        raise
+
+def verify_policy_kms(signed_path, key_id):
+    wrapper = json.load(open(signed_path))
+    sig = base64.b64decode(wrapper["signature"])
+    policy_bytes = json.dumps(wrapper["policy"], separators=(",",":")).encode("utf-8")
+    try:
+        r = kms.verify(KeyId=key_id, Message=policy_bytes, Signature=sig, MessageType='RAW', SigningAlgorithm='RSASSA_PKCS1_V1_5_SHA_256')
+        print("Verified:", r.get("SignatureValid", False))
+        return r.get("SignatureValid", False)
+    except ClientError as e:
+        print("KMS verify failed:", e)
+        raise
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    sp = p.add_subparsers(dest="cmd")
+    s = sp.add_parser("sign")
+    s.add_argument("--policy", required=True)
+    s.add_argument("--key-id", required=True)
+    s.add_argument("--out", required=True)
+    v = sp.add_parser("verify")
+    v.add_argument("--signed", required=True)
+    v.add_argument("--key-id", required=True)
+    args = p.parse_args()
+    if args.cmd == "sign":
+        sign_policy_kms(args.policy, args.key_id, args.out)
+    elif args.cmd == "verify":
+        ok = verify_policy_kms(args.signed, args.key_id)
+        exit(0 if ok else 2)
+    else:
+        p.print_help()
+
