+#!/usr/bin/env python3
+"""
+Hardware attestation test runner.
+ - Uses tpm2-tools on a host with TPM to create AK, generate a quote, and post to attestation verifier service.
+ - Operator must run this on the attested device or on a host with access to tpm device.
+
+Prereqs on the device:
+ - tpm2-tools installed (tpm2_createprimary, tpm2_createak, tpm2_quote)
+ - curl or python requests to POST to verifier
+
+Usage:
+  python hardware_attest_test.py --verifier http://attestation-verifier.attestation.svc:8083/verify_tpm
+"""
+import argparse, subprocess, json, base64, tempfile, os, sys, time
+
+def run(cmd):
+    print("+", " ".join(cmd))
+    subprocess.check_call(cmd)
+
+def create_ak(tmpdir):
+    ak_priv = os.path.join(tmpdir, "ak.priv")
+    ak_pub = os.path.join(tmpdir, "ak.pub")
+    # Create primary and AK; location & parameters are conservative
+    run(["tpm2_createprimary","-C","o","-c", os.path.join(tmpdir,"primary.ctx")])
+    run(["tpm2_createak","-C", os.path.join(tmpdir,"primary.ctx"), "-c", os.path.join(tmpdir,"ak.ctx"), "-u", ak_pub, "-r", ak_priv, "--algorithm", "rsa"])
+    return ak_pub, ak_priv, os.path.join(tmpdir,"ak.ctx")
+
+def quote_and_sign(ak_ctx, ak_priv, ak_pub, tmpdir):
+    # create nonce
+    nonce = os.urandom(20)
+    nfile = os.path.join(tmpdir,"nonce.bin")
+    open(nfile,"wb").write(nonce)
+    # produce quote (PCRs 0,7 as example)
+    quote_file = os.path.join(tmpdir,"quote.bin")
+    sig_file = os.path.join(tmpdir,"sig.bin")
+    run(["tpm2_quote", "-C", ak_ctx, "-l", "sha256:0,7", "-q", nfile, "-m", quote_file, "-s", sig_file])
+    return quote_file, sig_file
+
+def post_to_verifier(verifier_url, quote_file, sig_file, ak_pub):
+    import requests
+    q = open(quote_file,"rb").read()
+    s = open(sig_file,"rb").read()
+    body = {"quote": base64.b64encode(q).decode(), "signature": base64.b64encode(s).decode(), "ak_pub": open(ak_pub).read()}
+    r = requests.post(verifier_url, json=body, timeout=15)
+    print("verifier status:", r.status_code)
+    print(r.text)
+    return r
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--verifier", required=True)
+    args = p.parse_args()
+    with tempfile.TemporaryDirectory() as tmp:
+        try:
+            ak_pub, ak_priv, ak_ctx = create_ak(tmp)
+            quote, sig = quote_and_sign(ak_ctx, ak_priv, ak_pub, tmp)
+            r = post_to_verifier(args.verifier, quote, sig, ak_pub)
+            if r.status_code == 200:
+                print("Attestation verification response:", r.json())
+            else:
+                print("Attestation verifier returned error")
+        except subprocess.CalledProcessError as e:
+            print("TPM command failed:", e)
+            sys.exit(2)
+
+if __name__=="__main__":
+    main()
+
