+#!/usr/bin/env python3
+"""
+Simple API for recording annotation provenance.
+Call from LabelStudio adapter or rater backend when annotation is completed.
+"""
+import os, psycopg2, json
+DB = os.environ.get("DATABASE_URL")
+
+def conn():
+    return psycopg2.connect(DB)
+
+def record_annotation(dataset_id, object_id, rater_id, annotation, confidence=1.0):
+    c = conn(); cur = c.cursor()
+    cur.execute("INSERT INTO annotation_provenance (dataset_id, object_id, rater_id, annotation, confidence) VALUES (%s,%s,%s,%s,%s)",
+                (dataset_id, object_id, rater_id, json.dumps(annotation), confidence))
+    c.commit(); cur.close(); c.close()
+
+if __name__=="__main__":
+    import sys
+    # usage: record dataset obj rater annotation.json
+    if len(sys.argv) < 5:
+        print("Usage: annotation_provenance_api.py <dataset> <object> <rater> <annotation.json> [confidence]")
+        raise SystemExit(2)
+    dataset, obj, rater, annfile = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
+    conf = float(sys.argv[5]) if len(sys.argv) > 5 else 1.0
+    ann = json.load(open(annfile))
+    record_annotation(dataset, obj, rater, ann, conf)
+    print("recorded provenance")
+
