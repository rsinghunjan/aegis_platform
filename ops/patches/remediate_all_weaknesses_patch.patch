+#!/usr/bin/env python3
+"""
+Executor-side gating helper:
+ - verifies plan signature using cosign or local signer
+ - verifies attestation (calls attestation verifier service)
+ - returns allow/block decision to executor before actuating hardware
+"""
+import os, requests, json, subprocess
+
+ATTEST_URL = os.environ.get("ATTEST_VERIFIER_URL", "http://attestation-verifier.attestation.svc:8083/verify")
+PLAN_SIG_CMD = os.environ.get("PLAN_SIG_CMD", "cosign")  # placeholder
+
+def verify_plan_signature(plan_path, pubkey_or_kms):
+    # For cosign-signed plan: cosign verify --key <key> <plan_path>
+    try:
+        subprocess.check_call([PLAN_SIG_CMD, "verify", "--key", pubkey_or_kms, plan_path])
+        return True, "sig_ok"
+    except Exception as e:
+        return False, str(e)
+
+def verify_attestation(quote_b64, signature_b64, ak_pub_pem, expected_pcrs):
+    body = {"quote": quote_b64, "signature": signature_b64, "ak_pub": ak_pub_pem, "expected_pcrs": expected_pcrs}
+    r = requests.post(ATTEST_URL, json=body, timeout=10)
+    if r.status_code != 200:
+        return False, f"attest_http_{r.status_code}"
+    j = r.json()
+    return j.get("allow", False), j.get("reason", "")
+
+def gate_for_execution(plan_path, plan_signature, plan_pubkey, quote_b64, quote_sig_b64, ak_pub_pem, expected_pcrs):
+    ok, msg = verify_plan_signature(plan_path, plan_pubkey)
+    if not ok:
+        return False, f"plan_sig_failed:{msg}"
+    ok2, msg2 = verify_attestation(quote_b64, quote_sig_b64, ak_pub_pem, expected_pcrs)
+    if not ok2:
+        return False, f"attest_failed:{msg2}"
+    return True, "allow"
+
