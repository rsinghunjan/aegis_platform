+#!/usr/bin/env python3
+"""
+Checkpoint manager that uploads and COSIGN-signs checkpoint manifests.
+Requires COSIGN_KEY (or KMS key URI) configured in env to sign manifest JSON.
+"""
+import os, time, json, subprocess
+from s3_uploader import upload_file
+
+WATCH_DIR = os.environ.get("CHECKPOINT_DIR", "/workspace/checkpoints")
+COSIGN_KEY = os.environ.get("COSIGN_KEY")  # e.g. "kms://projects/.../cryptoKeys/..."
+OUT_BUCKET = os.environ.get("DATASET_BUCKET")
+
+def list_checkpoints(dir):
+    return sorted([os.path.join(dir,f) for f in os.listdir(dir)])
+
+def upload_and_sign(path):
+    uri = upload_file(path)
+    manifest = {"path": path, "uri": uri, "uploaded_at": time.time()}
+    mf = path + ".manifest.json"
+    open(mf,"w").write(json.dumps(manifest))
+    # sign manifest with cosign
+    if COSIGN_KEY:
+        subprocess.check_call(["cosign", "sign", "--key", COSIGN_KEY, mf])
+    else:
+        print("COSIGN_KEY not set; skipping sign")
+    return manifest
+
+def main():
+    seen = set()
+    while True:
+        if not os.path.exists(WATCH_DIR):
+            time.sleep(5); continue
+        files = list_checkpoints(WATCH_DIR)
+        for f in files:
+            if f in seen: continue
+            if os.path.isdir(f): continue
+            try:
+                m = upload_and_sign(f)
+                print("manifest", m)
+                seen.add(f)
+            except Exception as e:
+                print("upload/sign failed", e)
+        time.sleep(10)
+
+if __name__ == "__main__":
+    main()
+
