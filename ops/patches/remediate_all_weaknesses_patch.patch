+#!/usr/bin/env python3
+"""
+PII detection and redaction utility used during ingest.
+ - redacts SSN-like patterns and credit card numbers
+ - can be extended with NER-based redaction
+"""
+import re, sys, json
+
+SSN_RE = re.compile(r"\b\d{3}-\d{2}-\d{4}\b")
+CC_RE = re.compile(r"\b(?:\d[ -]*?){13,16}\b")
+
+def redact_text(s):
+    s = SSN_RE.sub("[REDACTED_SSN]", s)
+    s = CC_RE.sub("[REDACTED_CC]", s)
+    return s
+
+def redact_json_file(path, out):
+    data = open(path).read()
+    # naive: redact textual occurrences
+    data2 = redact_text(data)
+    open(out,"w").write(data2)
+    return out
+
+if __name__=="__main__":
+    if len(sys.argv) < 3:
+        print("Usage: pii_redactor.py <in.json> <out.json>")
+        sys.exit(2)
+    redact_json_file(sys.argv[1], sys.argv[2])
+    print("redaction complete")
+
