+KEY_TYPE="${KEY_TYPE:-kms}"  # kms or local
+KMS_KEY="${KMS_KEY:-projects/<project>/locations/global/keyRings/<kr>/cryptoKeys/<key>}" # GCP example
+
+if [ "$KEY_TYPE" = "kms" ]; then
+  # Example: cosign sign --key gcpkms://$KMS_KEY $IMAGE
+  cosign sign --key "kms://$KMS_KEY" "$IMAGE"
+else
+  # local private key path must be provided in COSIGN_KEY
+  cosign sign --key "${COSIGN_KEY}" "$IMAGE"
+fi
+
+echo "Signed $IMAGE"
