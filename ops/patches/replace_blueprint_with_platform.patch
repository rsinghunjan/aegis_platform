+#!/usr/bin/env bash
+#
+# Replace the word "blueprint" with "platform" across tracked text files in the repository.
+# - Replacements are word-boundary aware and handle common capitalization forms:
+#     blueprint -> platform
+#     Blueprint -> Platform
+#     BLUEPRINT -> PLATFORM
+#
+# Usage:
+#   # dry-run: show files that would be changed
+#   ./ops/scripts/replace_blueprint_with_platform.sh --preview
+#
+#   # perform replacement (no commit)
+#   ./ops/scripts/replace_blueprint_with_platform.sh
+#
+#   # perform replacement and create a git commit (recommended for CI/automation)
+#   ./ops/scripts/replace_blueprint_with_platform.sh --commit
+#
+# Notes:
+# - This script operates on files reported by `git grep` (tracked files only). Untracked files are not modified.
+# - Binary files are skipped by git grep with -I.
+# - Review changes before committing when using --commit.
+
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+PREVIEW=0
+DO_COMMIT=0
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --preview) PREVIEW=1; shift ;;
+    --commit) DO_COMMIT=1; shift ;;
+    -h|--help) echo "Usage: $0 [--preview] [--commit]"; exit 0 ;;
+    *) echo "Unknown arg: $1"; exit 2 ;;
+  esac
+done
+
+if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
+  echo "Error: this script expects to be run from inside a git repository (tracked files only)."
+  exit 2
+fi
+
+echo "Searching for occurrences of 'blueprint' (case-insensitive) in tracked files..."
+# -I skip binary; -l list file names; -i case-insensitive
+FILES=$(git grep -I -l -e "blueprint" -e "Blueprint" -e "BLUEPRINT" || true)
+
+if [ -z "$FILES" ]; then
+  echo "No tracked files contain 'blueprint' (case-insensitive). Nothing to do."
+  exit 0
+fi
+
+echo "Found the following files:"
+echo "$FILES"
+echo
+
+if [ "$PREVIEW" -eq 1 ]; then
+  echo "Preview mode: showing diffs (no files will be modified)."
+  for f in $FILES; do
+    echo "----- $f -----"
+    git --no-pager grep -n -i -e "blueprint" -e "Blueprint" -e "BLUEPRINT" -- "$f" || true
+    echo
+  done
+  exit 0
+fi
+
+echo "Applying replacements..."
+MODIFIED=()
+for f in $FILES; do
+  # Create a backup for safety (in-memory); using perl for robust word-boundary replacement
+  perl -0777 -pe 's/\bblueprint\b/platform/g; s/\bBlueprint\b/Platform/g; s/\bBLUEPRINT\b/PLATFORM/g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
+  MODIFIED+=("$f")
+done
+
+echo "Replacement complete. Modified files:"
+for f in "${MODIFIED[@]}"; do
+  echo " - $f"
+done
+
+echo
+echo "You can review changes with: git --no-pager diff --stat"
+
+if [ "$DO_COMMIT" -eq 1 ]; then
+  echo "Staging and committing changes..."
+  git add "${MODIFIED[@]}"
+  git commit -m "Replace usages of 'blueprint' with 'platform' (word-boundary, case variants)"
+  echo "Committed changes."
+else
+  echo "No commit requested. Review changes and commit when ready."
+fi
+
+echo "Done."
+
