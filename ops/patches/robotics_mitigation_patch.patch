+#!/usr/bin/env python3
+"""
+SME Sprint Manager
+
+ - Accepts a list of invariants (ids) to prioritize for a sprint.
+ - Creates a GitHub milestone and issues for each invariant with SMT template pre-filled.
+ - Produces a sprint plan file /tmp/sme_sprint_plan.json.
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/formal/sme_sprint_manager.py --repo owner/repo --ids inv1,inv2,inv3 --milestone "SME Sprint 1"
+"""
+import os
+import requests
+import json
+import argparse
+from pathlib import Path
+
+GITHUB_API = "https://api.github.com"
+
+def gh_headers(token):
+    return {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
+
+def create_milestone(repo, title, token):
+    url = f"{GITHUB_API}/repos/{repo}/milestones"
+    r = requests.post(url, json={"title": title, "state": "open"}, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        return r.json().get("number")
+    return None
+
+def create_issue(repo, title, body, labels, milestone, token):
+    url = f"{GITHUB_API}/repos/{repo}/issues"
+    payload = {"title": title, "body": body, "labels": labels}
+    if milestone:
+        payload["milestone"] = milestone
+    r = requests.post(url, json=payload, headers=gh_headers(token))
+    if r.status_code in (200,201):
+        return r.json().get("html_url")
+    else:
+        print("Issue create failed:", r.status_code, r.text)
+        return None
+
+def generate_smt_template(inv_id):
+    path = Path(f"ops/formal/onboard_submissions/{inv_id}.smt2")
+    meta = Path(f"ops/formal/onboard_submissions/{inv_id}.meta.json")
+    if not path.exists():
+        Path("ops/formal/onboard_submissions").mkdir(parents=True, exist_ok=True)
+        path.write_text(f"; SMT2 skeleton for {inv_id}\n(set-logic QF_BV)\n")
+    if not meta.exists():
+        meta.write_text(json.dumps({"id": inv_id, "description": "", "priority": "high", "responsible": "safety-team", "sme_approved": False}, indent=2))
+    return str(path), str(meta)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True)
+    p.add_argument("--ids", required=True, help="comma-separated invariant ids")
+    p.add_argument("--milestone", default="SME Sprint")
+    args = p.parse_args()
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token:
+        print("GITHUB_TOKEN required"); return
+    invs = [i.strip() for i in args.ids.split(",") if i.strip()]
+    mid = create_milestone(args.repo, args.milestone, token)
+    created = []
+    for inv in invs:
+        smt,meta = generate_smt_template(inv)
+        body = f"SME Sprint item: {inv}\n\nSMT template: `{smt}`\nMeta: `{meta}`\n\nPlease fill SMT encoding and set `sme_approved\": true` in meta when ready."
+        url = create_issue(args.repo, f"[SME Sprint] {inv}", body, ["formal","sme-sprint"], mid, token)
+        created.append({"id": inv, "issue": url, "smt": smt, "meta": meta})
+    open("/tmp/sme_sprint_plan.json","w").write(json.dumps({"milestone": args.milestone, "items": created}, indent=2))
+    print("Wrote /tmp/sme_sprint_plan.json")
+
+if __name__ == "__main__":
+    main()
+
