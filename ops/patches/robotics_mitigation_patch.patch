+#!/usr/bin/env python3
+"""
+Orchestrate a HIL campaign: run N replays, collect determinism summary, sign and upload evidence.
+
+Behavior:
+ - If ACME_HIL_URL and ACME_HIL_TOKEN are present, call certify_rack.py (if available) to run campaign.
+ - Otherwise create a provisioning issue (ops/provisioning/provision_rack_issue.py).
+ - Writes /tmp/hil_campaign_result.json with campaign metadata for CI.
+"""
+import os
+import json
+import subprocess
+from datetime import datetime
+
+OUT="/tmp/hil_campaign_result.json"
+
+def has_hil_creds():
+    return bool(os.environ.get("ACME_HIL_URL") and os.environ.get("ACME_HIL_TOKEN"))
+
+def run_certify(manifest, name, repeats, s3_bucket=None):
+    cmd = ["python","ops/hil/certify_rack.py","--adapter","ops.hil.adapters.acme_hil_adapter.AcmeHILAdapter","--manifest",manifest,"--name",name,"--repeats",str(repeats)]
+    if s3_bucket:
+        cmd += ["--s3-bucket", s3_bucket]
+    try:
+        subprocess.check_call(cmd)
+        # find summary
+        # heuristics: look for /tmp/hil_replay_summary*.json
+        import glob
+        files = glob.glob("/tmp/hil_replay_summary*.json")
+        summary = files[0] if files else ""
+        return {"ok": True, "summary": summary}
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+
+def create_provision_issue(repo, device):
+    token = os.environ.get("GITHUB_TOKEN")
+    if not token or not repo:
+        return {"ok": False, "error": "missing git token/repo"}
+    cmd = ["python","ops/provisioning/provision_rack_issue.py","--repo",repo,"--device",device,"--summary","Auto-created by HIL campaign runner: hardware missing"]
+    try:
+        subprocess.check_call(cmd, env=os.environ)
+        return {"ok": True}
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+
+def main():
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--manifest", default="ops/hil/playbook/example_replay_manifest.json")
+    p.add_argument("--name", default="representative-rack-1")
+    p.add_argument("--repeats", type=int, default=12)
+    p.add_argument("--s3-bucket", default=os.environ.get("EVIDENCE_BUCKET",""))
+    p.add_argument("--repo", default=os.environ.get("GITHUB_REPOSITORY",""))
+    args = p.parse_args()
+    result = {"ts": datetime.utcnow().isoformat()+"Z", "manifest": args.manifest}
+    if has_hil_creds():
+        result.update(run_certify(args.manifest, args.name, args.repeats, args.s3_bucket))
+    else:
+        result.update({"ok": False, "error": "no HIL creds; creating provisioning issue"})
+        result.update(create_provision_issue(args.repo, "hil"))
+    open(OUT,"w").write(json.dumps(result, indent=2))
+    print("Wrote campaign result to", OUT)
