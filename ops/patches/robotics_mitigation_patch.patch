+#!/usr/bin/env python3
+"""
+Quota enforcer / billing monitor
+
+ - Periodically queries billing connectors and enforces per-project/device quotas.
+ - If usage > threshold, create GitHub issue and optionally disable autopilot by flipping a flag (operator action).
+ - Writes /tmp/quota_report.json
+"""
+import os, json
+from datetime import datetime
+
+OUT="/tmp/quota_report.json"
+
+def check_aws(threshold=100.0):
+    # use aws_billing_connector_enhanced to produce /tmp/billing_reconcile.json
+    try:
+        import subprocess
+        subprocess.check_call(["python","ops/billing/aws_billing_connector_enhanced.py"])
+        data = json.load(open("/tmp/billing_reconcile.json"))
+        total = sum([j.get("cost",0.0) for j in data.get("jobs",[])])
+        return {"provider":"aws","total": total, "over": total>threshold}
+    except Exception as e:
+        return {"error": str(e)}
+
+def create_quota_issue(repo, token, body, title="Quota breach detected"):
+    import requests
+    url = f"https://api.github.com/repos/{repo}/issues"
+    r = requests.post(url, json={"title":title, "body":body, "labels":["billing","alert"]}, headers={"Authorization":f"token {token}","Accept":"application/vnd.github+json"})
+    return r.status_code in (200,201)
+
+def main():
+    repo = os.environ.get("GITHUB_REPOSITORY")
+    token = os.environ.get("GITHUB_TOKEN")
+    thresh = float(os.environ.get("AEGIS_BILLING_THRESHOLD", "100.0"))
+    aws = check_aws(thresh)
+    rep = {"ts": datetime.utcnow().isoformat()+"Z", "aws": aws}
+    open(OUT,"w").write(json.dumps(rep, indent=2))
+    if aws.get("over"):
+        if repo and token:
+            body = f"Billing threshold exceeded: total={aws.get('total')}, threshold={thresh}\n\nPlease investigate and consider disabling autopilot or pausing expensive jobs."
+            create_quota_issue(repo, token, body, title="[Billing] Quota Exceeded")
+    print("Wrote", OUT)
+
+if __name__ == "__main__":
+    main()
+
