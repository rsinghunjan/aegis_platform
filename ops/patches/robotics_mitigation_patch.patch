+"""
+TPM Attestation helper (edge)
+
+Purpose:
+ - Produce a simple attestation token using tpm2-tools (if available) or a local fallback nonce.
+ - Writes attestation JSON to /tmp/attestation_token.json for the agent to include when requesting short-lived creds.
+"""
+import subprocess
+import json
+import time
+from datetime import datetime
+
+OUT="/tmp/attestation_token.json"
+
+def tpm_quote():
+    try:
+        # placeholder: real flow uses TPM key, PCRs and a signing key
+        out = subprocess.check_output(["tpm2_getrandom","8"], text=True).strip()
+        token = {"method":"tpm_random", "value": out, "ts": datetime.utcnow().isoformat()+"Z"}
+        return token
+    except Exception:
+        # fallback
+        token = {"method":"local_nonce", "value": str(int(time.time())), "ts": datetime.utcnow().isoformat()+"Z"}
+        return token
+
+def main():
+    token = tpm_quote()
+    open(OUT,"w").write(json.dumps(token))
+    print("Wrote attestation token to", OUT)
+
+if __name__ == "__main__":
+    main()
