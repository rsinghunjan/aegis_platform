*** Add File:ops/scripts/dispatch_full_validation.sh
+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Script to trigger the full validation:
+#  - creates a Tekton PipelineRun (local apply) OR
+#  - dispatches the GitHub workflow `Full Validation CI` (requires gh CLI & auth)
+#
+EVIDENCE_BUCKET=${EVIDENCE_BUCKET:-s3://your-evidence-bucket}  # override as needed
+KUBECONFIG=${KUBECONFIG:-~/.kube/config}
+USE_GITHUB=${USE_GITHUB:-false}
+GITHUB_REPO=${GITHUB_REPO:-your-org/your-repo}   # set to repository that contains workflow
+WORKFLOW_ID=${WORKFLOW_ID:-Full Validation CI.yml} # exact workflow file name or id
+
+if [ "$USE_GITHUB" = "true" ]; then
+  if ! command -v gh >/dev/null 2>&1; then
+    echo "gh CLI required to dispatch GitHub workflow. Install and authenticate first."
+    exit 1
+  fi
+  echo "Dispatching GitHub workflow ${WORKFLOW_ID} on ${GITHUB_REPO}"
+  gh workflow run "${WORKFLOW_ID}" -R "${GITHUB_REPO}" --field evidence_bucket="$EVIDENCE_BUCKET" --field confirm=I_APPROVE
+  echo "Dispatched workflow. Check GitHub Actions UI for progress."
+  exit 0
+fi
+
+echo "Applying Tekton PipelineRun manifest (local cluster)"
+TMP=/tmp/full_validation_pr.yaml
+cat > "${TMP}" <<EOF
+apiVersion: tekton.dev/v1beta1
+kind: PipelineRun
+metadata:
+  generateName: full-validation-run-
+  namespace: cicd
+spec:
+  pipelineRef:
+    name: full-validation-with-audit
+  params:
+    - name: evidence_bucket
+      value: "${EVIDENCE_BUCKET}"
+    - name: hpo_samples
+      value: "128"
+    - name: hpo_parallel
+      value: "8"
+    - name: long_shadow_hours
+      value: "24"
+EOF
+
+kubectl --kubeconfig="${KUBECONFIG}" apply -f "${TMP}"
+echo "PipelineRun applied. Watch with: kubectl -n cicd get pipelineruns"
+
