+#!/usr/bin/env bash
+set -euo pipefail
+usage() {
+  cat <<EOF
+Usage: $0 --repo owner/repo --workflow workflow_file.yml --bucket s3://my-bucket
+
+Requires:
+  - GITHUB_TOKEN environment variable with repo workflow dispatch permissions.
+
+This script will call the GitHub Actions workflow dispatch API to start the Run Production Proofs workflow.
+EOF
+}
+
+REPO=""
+WORKFLOW=""
+BUCKET=""
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --repo) REPO="$2"; shift 2;;
+    --workflow) WORKFLOW="$2"; shift 2;;
+    --bucket) BUCKET="$2"; shift 2;;
+    -h|--help) usage; exit 0;;
+    *) echo "Unknown arg: $1"; usage; exit 1;;
+  esac
+done
+
+if [ -z "$REPO" ] || [ -z "$WORKFLOW" ] || [ -z "$BUCKET" ]; then
+  echo "ERROR: --repo, --workflow and --bucket are required"
+  usage
+  exit 1
+fi
+
+if [ -z "${GITHUB_TOKEN:-}" ]; then
+  echo "ERROR: GITHUB_TOKEN environment variable not set"
+  exit 1
+fi
+
+API_URL="https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW}/dispatches"
+
+PAYLOAD=$(cat <<JSON
+{
+  "ref": "main",
+  "inputs": {
+    "evidence_bucket": "${BUCKET}",
+    "confirm": "RUN_PROOFS"
+  }
+}
+JSON
+)
+
+echo "Dispatching workflow ${WORKFLOW} on ${REPO} (ref=main)"
+curl -s -X POST -H "Accept: application/vnd.github+json" \
+  -H "Authorization: Bearer ${GITHUB_TOKEN}" \
+  -H "Content-Type: application/json" \
+  -d "${PAYLOAD}" \
+  "${API_URL}"
+
+echo "Workflow dispatch requested. Check GitHub Actions UI for progress."
+
