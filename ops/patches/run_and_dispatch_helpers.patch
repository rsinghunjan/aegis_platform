+#!/usr/bin/env bash
+set -euo pipefail
+usage() {
+  cat <<EOF
+Usage: $0 --bucket s3://my-bucket [--kubeconfig /path/to/kubeconfig] [--file path/to/pipelinerun.yaml]
+
+This script fills the production PipelineRun template with your evidence S3 bucket and applies it to the cluster.
+EOF
+}
+
+BUCKET=""
+KUBECONFIG="${KUBECONFIG:-}"
+PR_FILE="ops/tekton/pipelineruns/production_proofs_pipelinerun_filled.yaml"
+
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --bucket) BUCKET="$2"; shift 2;;
+    --kubeconfig) KUBECONFIG="$2"; shift 2;;
+    --file) PR_FILE="$2"; shift 2;;
+    -h|--help) usage; exit 0;;
+    *) echo "Unknown arg: $1"; usage; exit 1;;
+  esac
+done
+
+if [ -z "$BUCKET" ]; then
+  echo "ERROR: --bucket is required"
+  usage
+  exit 1
+fi
+
+TMP="/tmp/production_proofs_pr.$$.yaml"
+sed "s|s3://REPLACE_WITH_YOUR_EVIDENCE_BUCKET|${BUCKET}|g" "${PR_FILE}" > "${TMP}"
+
+echo "Applying PipelineRun using ${TMP}"
+if [ -n "$KUBECONFIG" ]; then
+  kubectl --kubeconfig="$KUBECONFIG" apply -f "$TMP"
+else
+  kubectl apply -f "$TMP"
+fi
+
+echo "PipelineRun created. Monitor in Tekton dashboard or with: kubectl -n cicd get pipelineruns"
+
