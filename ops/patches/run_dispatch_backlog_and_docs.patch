+  exit 1
+fi
+
+echo "Generating remediation backlog -> ${OUT}"
+python3 ops/scripts/generate_remediation_tickets.py --input "${ACCEPTANCE_JSON}" --out "${OUT}"
+
+echo "Backlog generated: ${OUT}"
+echo "Preview:"
+sed -n '1,200p' "${OUT}"
