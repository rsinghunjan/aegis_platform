+#!/usr/bin/env python3
+"""
+Orchestrator to run the full Aegis automation suite.
+
+This script invokes the various automation helpers included in the repo to:
+ - create provisioning issues & inventory PRs
+ - create enforcement PRs for hardware gates
+ - create finance signoff issues
+ - run managed services migration smoke
+ - kick off golden image bake/push/rollout helper
+ - trigger Triton tuning CI helper (local k6 runs require k6 installed)
+ - kick off weekly HIL cadence runner (assumes HIL credentials in env)
+ - schedule soak and chaos (creates issue and submits soak job)
+
+Usage:
+  GITHUB_TOKEN=<token> python ops/automation/run_everything.py --repo owner/repo
+
+Notes:
+ - This is an operator-facing orchestration tool. It will attempt to run scripts that require
+   network/cluster access and will record per-step results to /tmp/aegis_automation_summary.json.
+ - Many steps are destructive or require operator approval/credentials.
+"""
+import argparse
+import subprocess
+import json
+import os
+from datetime import datetime
+
+SCRIPTS = [
+    # Create provisioning inventory and issues
+    ("create_inventory_pr", ["python", "ops/automation/create_all_provision_and_inventory_prs.py", "--repo", "{repo}"]),
+    # Create an inventory PR (alternate)
+    ("create_inventory_pr_alt", ["python", "ops/automation/create_provisioning_inventory_pr.py", "--repo", "{repo}"]),
+    # Create PR to enforce hardware gates
+    ("enforce_hw_gate_pr", ["python", "ops/automation/create_enforce_hardware_gate_pr.py", "--repo", "{repo}"]),
+    # Create finance signoff issue
+    ("finance_signoff", ["python", "ops/finance/create_finance_signoff_pr.py"]),
+    # Run managed migration smoke (requires DATABASE_URL, REDIS_URL in env)
+    ("migration_smoke", ["python", "ops/db/migration/run_migration_smoke.py"]),
+    # Bake and push golden image helper (operator must set DOCKER_* env vars)
+    ("bake_push_golden", ["python", "ops/images/golden_pipeline_helper.py", "--image", os.environ.get("GOLDEN_IMAGE_TAG", "aegis-robot-golden:latest")]),
+    # Run Triton CI tuning (operator must ensure models deployed or candidates available)
+    ("triton_ci_tune", ["python", "ops/triton/ci_tune_and_record.py", "--candidates", "candidateA", "candidateB"]),
+    # Trigger HIL cadence once (needs ACME_HIL_URL / ACME_HIL_TOKEN)
+    ("hil_cadence", ["python", "ops/hil/hil_cadence_scheduler.py", "--once"]),
+    # Schedule soak and chaos
+    ("soak_and_chaos", ["python", "ops/soak/soak_and_chaos_schedule.py"]),
+]
+
+def run_step(name, cmd, repo=None, env=None):
+    env = env or os.environ.copy()
+    if repo:
+        # format command with repo if command contains placeholder
+        cmd = [c.format(repo=repo) for c in cmd]
+    print(f"Running step {name}: {' '.join(cmd)}")
+    try:
+        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, text=True, timeout=60*60)
+        result = {"rc": p.returncode, "stdout": p.stdout[:4096], "stderr": p.stderr[:4096]}
+    except subprocess.TimeoutExpired as e:
+        result = {"rc": 124, "stdout": "", "stderr": "timeout"}
+    except FileNotFoundError as e:
+        result = {"rc": 127, "stdout": "", "stderr": f"missing-script: {e}"}
+    except Exception as e:
+        result = {"rc": 1, "stdout": "", "stderr": str(e)}
+    print(f"Step {name} finished rc={result['rc']}")
+    return result
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--repo", required=True, help="owner/repo for GitHub operations")
+    args = p.parse_args()
+    summary = {"ts": datetime.utcnow().isoformat()+"Z", "steps": {}}
+    for name, cmd in SCRIPTS:
+        res = run_step(name, cmd, repo=args.repo)
+        summary["steps"][name] = res
+        # simple fail fast for critical steps (optionally continue)
+        # continue executing to produce maximum artifacts, but log failures
+    out = "/tmp/aegis_automation_summary.json"
+    open(out, "w").write(json.dumps(summary, indent=2))
+    print("Wrote summary to", out)
+    # exit with non-zero if any critical steps failed (finance, migration smoke, inventory)
+    critical = ["create_inventory_pr", "enforce_hw_gate_pr", "finance_signoff", "migration_smoke"]
+    failed = False
+    for c in critical:
+        s = summary["steps"].get(c, {})
+        if s.get("rc", 1) != 0:
+            failed = True
+            print("Critical step failed:", c)
+    if failed:
+        raise SystemExit(2)
+
+if __name__ == "__main__":
+    main()
+
