+#!/usr/bin/env python3
+"""
+FastAPI middleware to apply Redis-backed token-bucket rate limiting and tenant quota check for HPO submissions.
+ - Expose dependency `enforce_submission` for submission endpoints
+"""
+from fastapi import FastAPI, Request, HTTPException, Depends
+import os, time, redis, logging
+
+logger = logging.getLogger("rate-limiter")
+logging.basicConfig(level=logging.INFO)
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+BURST = int(os.environ.get("RATE_BURST", "5"))
+RATE = float(os.environ.get("RATE_PER_SEC", "0.2"))
+
+r = redis.from_url(REDIS_URL)
+
+LUA = """
+local key = KEYS[1]
+local burst = tonumber(ARGV[1])
+local rate = tonumber(ARGV[2])
+local now = tonumber(ARGV[3])
+local requested = tonumber(ARGV[4])
+local tokens = tonumber(redis.call('get', key .. ':tokens') or burst)
+local last = tonumber(redis.call('get', key .. ':last') or now)
+local new_tokens = math.min(burst, tokens + (now - last) * rate)
+if new_tokens < requested then
+  redis.call('set', key .. ':tokens', new_tokens)
+  redis.call('set', key .. ':last', now)
+  return {0, new_tokens}
+else
+  new_tokens = new_tokens - requested
+  redis.call('set', key .. ':tokens', new_tokens)
+  redis.call('set', key .. ':last', now)
+  return {1, new_tokens}
+end
+"""
+
+script = r.register_script(LUA)
+
+def allow_tenant(tenant: str, requested: int = 1):
+    now = int(time.time())
+    ok, rem = script(keys=[f"rl:{tenant}"], args=[BURST, RATE, now, requested])
+    return bool(ok), float(rem)
+
+def enforce_submission(request: Request):
+    # expect header X-Tenant
+    tenant = request.headers.get("X-Tenant")
+    if not tenant:
+        raise HTTPException(status_code=400, detail="Missing X-Tenant header")
+    ok, rem = allow_tenant(tenant)
+    if not ok:
+        raise HTTPException(status_code=429, detail="tenant rate limit exceeded")
+    # in production also check chargeback / quota API here
+    return True
+
