+#!/usr/bin/env python3
+"""
+Durable invoice ingestion using SQS as buffer:
+ - Providers upload invoice CSVs to S3/invoices/, a simple S3->SQS notification is configured
+ - This worker polls SQS, downloads invoice object, processes via billing_invoice_linker, and moves to processed/
+ - Retries with visibility timeout/backoff and writes reconciliation evidence to S3
+"""
+import os, time, logging, json, botocore
+import boto3
+from datetime import datetime
+
+logger = logging.getLogger("invoice-sqs")
+logging.basicConfig(level=logging.INFO)
+
+SQS_URL = os.environ.get("INVOICE_SQS_URL", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+BUCKET = EVIDENCE_BUCKET.replace("s3://","") if EVIDENCE_BUCKET else ""
+
+s3 = boto3.client("s3")
+sqs = boto3.client("sqs")
+
+def process_s3_invoice(key):
+    tmp = f"/tmp/{os.path.basename(key)}"
+    s3.download_file(BUCKET, key, tmp)
+    try:
+        from services.quantum.billing_invoice_linker import process_csv
+        process_csv(tmp)
+        # move processed
+        dest = key.replace("invoices/","invoices/processed/")
+        s3.copy_object(Bucket=BUCKET, CopySource={'Bucket':BUCKET,'Key':key}, Key=dest)
+        s3.delete_object(Bucket=BUCKET, Key=key)
+        s3.put_object(Bucket=BUCKET, Key=f"invoices/reconciled/{os.path.basename(key)}.meta", Body=str(datetime.utcnow()).encode())
+    except Exception:
+        logger.exception("Invoice processing failed for %s", key)
+
+def run_loop():
+    if not SQS_URL:
+        logger.error("INVOICE_SQS_URL required"); return
+    while True:
+        resp = sqs.receive_message(QueueUrl=SQS_URL, MaxNumberOfMessages=10, WaitTimeSeconds=20)
+        for msg in resp.get("Messages", []):
+            try:
+                body = json.loads(msg["Body"])
+                # S3 event wrapper: extract key
+                rec = body.get("Records", [])[0]
+                key = rec["s3"]["object"]["key"]
+                process_s3_invoice(key)
+                sqs.delete_message(QueueUrl=SQS_URL, ReceiptHandle=msg["ReceiptHandle"])
+            except Exception:
+                logger.exception("Failed processing message")
+        time.sleep(2)
+
+if __name__ == "__main__":
+    run_loop()
+
