+#!/usr/bin/env python3
+"""
+Approval alert escalator:
+ - Polls Approval Service for pending approvals older than threshold
+ - Sends alert to configured webhook (PagerDuty / Slack) and creates an on-call ticket via webhook
+ - Uploads escalation evidence to EVIDENCE_BUCKET
+"""
+import os, time, logging, requests, json
+from datetime import datetime, timedelta
+
+logger = logging.getLogger("approval-escalator")
+logging.basicConfig(level=logging.INFO)
+
+APPROVAL_API = os.environ.get("APPROVAL_SERVICE_URL", "http://approval-service.monitoring.svc:8080")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK", "")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+PENDING_THRESHOLD_MIN = int(os.environ.get("PENDING_THRESHOLD_MIN", "30"))
+
+def list_pending():
+    try:
+        r = requests.get(f"{APPROVAL_API}/pending", timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        return []
+
+def send_alert(payload):
+    if not ALERT_WEBHOOK:
+        logger.warning("No ALERT_WEBHOOK configured")
+        return
+    try:
+        requests.post(ALERT_WEBHOOK, json=payload, timeout=5)
+    except Exception:
+        logger.exception("Alert send failed")
+
+def upload_evidence(key, data):
+    if not EVIDENCE_BUCKET:
+        p=f"/tmp/{key}.json"; open(p,"w").write(json.dumps(data)); return p
+    import boto3
+    s3=boto3.client("s3"); bucket=EVIDENCE_BUCKET.replace("s3://","")
+    key_s=f"approvals/escalations/{key}.json"
+    s3.put_object(Bucket=bucket, Key=key_s, Body=json.dumps(data).encode())
+    return f"s3://{EVIDENCE_BUCKET}/{key_s}"
+
+def run_loop(poll=60):
+    while True:
+        pend = list_pending()
+        now = datetime.utcnow()
+        for p in pend:
+            created = p.get("created_at")
+            try:
+                created_dt = datetime.fromisoformat(created)
+            except Exception:
+                continue
+            if now - created_dt > timedelta(minutes=PENDING_THRESHOLD_MIN):
+                payload = {"summary": "Approval pending too long", "request": p}
+                upload_evidence(f"escalation-{p['id']}", payload)
+                send_alert(payload)
+        time.sleep(poll)
+
+if __name__ == "__main__":
+    run_loop()
+
