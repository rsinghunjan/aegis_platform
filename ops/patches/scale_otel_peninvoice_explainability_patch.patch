+#!/usr/bin/env python3
+"""
+OTEL instrumentation helpers and examples for:
+ - Tekton task wrappers, Ray training jobs, QPU worker and model serving apps.
+ - Ensures run_id and business_kpi attributes propagate with spans and to metrics.
+
+Usage:
+ - Call init_tracer(service_name) at process start.
+ - Use annotate_span(run_id=..., kpi=...) to attach run_id and business_kpi to the active span.
+"""
+import os
+from opentelemetry import trace, metrics
+from opentelemetry.sdk.resources import Resource
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import BatchSpanProcessor, ConsoleSpanExporter
+from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
+from opentelemetry.instrumentation.requests import RequestsInstrumentor
+
+def init_tracer(service_name="aegis-service"):
+    otlp = os.environ.get("OTLP_ENDPOINT")
+    resource = Resource.create({"service.name": service_name})
+    tp = TracerProvider(resource=resource)
+    if otlp:
+        exporter = OTLPSpanExporter(endpoint=otlp, insecure=True)
+        tp.add_span_processor(BatchSpanProcessor(exporter))
+    else:
+        tp.add_span_processor(BatchSpanProcessor(ConsoleSpanExporter()))
+    trace.set_tracer_provider(tp)
+    RequestsInstrumentor().instrument()
+    return trace.get_tracer(service_name)
+
+def annotate_span(run_id=None, business_kpi=None):
+    span = trace.get_current_span()
+    if not span:
+        return
+    if run_id:
+        span.set_attribute("run_id", run_id)
+    if business_kpi:
+        span.set_attribute("business_kpi", business_kpi)
+
+if __name__ == "__main__":
+    tr = init_tracer("example-task")
+    with tr.start_as_current_span("example"):
+        annotate_span(run_id="run-abc123", business_kpi="orders_per_minute")
+        print("Annotated example span")
+
