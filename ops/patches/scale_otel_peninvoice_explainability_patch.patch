+#!/usr/bin/env python3
+"""
+Explainability API with Keycloak introspection and ACL checks.
+ - Fetches explanation JSON from S3 and enforces per-tenant / per-user access using token introspection.
+ - PoC: token introspection via Keycloak userinfo endpoint; map preferred_username -> tenant membership via a simple mapping.
+"""
+from fastapi import FastAPI, Header, HTTPException
+import os, boto3, requests, json, logging
+
+app = FastAPI()
+logger = logging.getLogger("secure-explain")
+logging.basicConfig(level=logging.INFO)
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+USERINFO = os.environ.get("KEYCLOAK_USERINFO", "http://keycloak.monitoring.svc:8080/realms/aegis/protocol/openid-connect/userinfo")
+TENANT_MAP = json.loads(os.environ.get("TENANT_MAP_JSON", "{}"))
+
+s3 = boto3.client("s3") if EVIDENCE_BUCKET else None
+
+def introspect(token):
+    try:
+        r = requests.get(USERINFO, headers={"Authorization": token}, timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        logger.exception("introspect failed")
+        return {}
+
+@app.get("/explain/{model_id}/{input_hash}")
+def get_explain(model_id: str, input_hash: str, authorization: str = Header(None)):
+    if not authorization:
+        raise HTTPException(status_code=401)
+    user = introspect(authorization)
+    tenant = user.get("tenant") or TENANT_MAP.get(user.get("preferred_username"), "")
+    # ACL: for PoC, explanation keys contain tenant prefix: explainability/<tenant>/<model>/<input_hash>.json
+    key = f"explainability/{tenant}/{model_id}/{input_hash}.json"
+    try:
+        obj = s3.get_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key)
+        return json.loads(obj["Body"].read())
+    except Exception:
+        raise HTTPException(status_code=404, detail="explanation not found or access denied")
+
