+#!/usr/bin/env python3
+"""
+Quota enforcer service:
+ - Maintains per-tenant quotas for concurrent expensive jobs (HPO/training)
+ - Exposes an HTTP API used by submission paths to reserve capacity or reject
+ - Uses Redis for atomic counters and configurable quota per tenant
+"""
+from fastapi import FastAPI, HTTPException
+import os, redis, logging, json
+from datetime import datetime
+
+app = FastAPI()
+logger = logging.getLogger("quota-enforcer")
+logging.basicConfig(level=logging.INFO)
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+r = redis.from_url(REDIS_URL)
+DEFAULT_QUOTA = int(os.environ.get("DEFAULT_QUOTA", "2"))
+
+def get_quota(tenant):
+    q = r.get(f"quota:{tenant}")
+    if q:
+        return int(q)
+    return DEFAULT_QUOTA
+
+@app.post("/reserve/{tenant}")
+def reserve(tenant: str):
+    quota = get_quota(tenant)
+    key = f"quota_usage:{tenant}"
+    val = r.incr(key)
+    if val > quota:
+        r.decr(key)
+        raise HTTPException(status_code=429, detail="quota exceeded")
+    # set TTL to avoid permanent increments (PoC)
+    r.expire(key, 60*60*24)
+    return {"ok": True, "usage": int(val), "quota": quota}
+
+@app.post("/release/{tenant}")
+def release(tenant: str):
+    key = f"quota_usage:{tenant}"
+    val = r.decr(key)
+    if val < 0:
+        r.set(key, 0)
+        val = 0
+    return {"ok": True, "usage": int(val)}
+
+@app.get("/quota/{tenant}")
+def quota(tenant: str):
+    return {"tenant": tenant, "quota": get_quota(tenant)}
+
