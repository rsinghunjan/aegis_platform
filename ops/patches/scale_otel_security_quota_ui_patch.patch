+#!/usr/bin/env python3
+"""
+Minimal TLS-enabled mutating webhook (PoC) for injecting OTLP endpoint and run_id into Pods.
+In production: secure with proper certs, namespace scoping, and RBAC.
+"""
+from flask import Flask, request, jsonify
+import os, uuid, base64, json, logging
+
+app = Flask(__name__)
+logger = logging.getLogger("mutating-webhook-tls")
+logging.basicConfig(level=logging.INFO)
+
+OTLP_ENDPOINT = os.environ.get("OTLP_ENDPOINT", "http://otel-collector.monitoring.svc:4318")
+
+@app.route("/mutate", methods=["POST"])
+def mutate():
+    req = request.get_json()
+    uid = req["request"]["uid"]
+    pod = req["request"]["object"]
+    try:
+        run_id = pod.get("metadata", {}).get("annotations", {}).get("aegis.run_id") or f"run-{uuid.uuid4().hex[:8]}"
+        patches = []
+        # ensure annotations map exists
+        if "annotations" not in pod.get("metadata", {}):
+            patches.append({"op":"add", "path":"/metadata/annotations", "value": {}})
+        patches.append({"op":"add","path":"/metadata/annotations/aegis.run_id","value":run_id})
+        # inject OTLP env and RUN_ID into each container
+        containers = pod.get("spec", {}).get("containers", [])
+        for i,_ in enumerate(containers):
+            env_path = f"/spec/containers/{i}/env"
+            # ensure env array exists
+            patches.append({"op":"add","path":env_path,"value":[]})
+            patches.append({"op":"add","path":f"{env_path}/-","value":{"name":"OTLP_ENDPOINT","value":OTLP_ENDPOINT}})
+            patches.append({"op":"add","path":f"{env_path}/-","value":{"name":"RUN_ID","value":run_id}})
+        patch_b64 = base64.b64encode(json.dumps(patches).encode()).decode()
+        resp = {"response":{"uid": uid, "allowed": True, "patchType":"JSONPatch", "patch": patch_b64}}
+        return jsonify(resp)
+    except Exception:
+        logger.exception("mutate failed")
+        return jsonify({"response":{"uid": uid, "allowed": True}})
+
+if __name__ == "__main__":
+    # expects TLS certs mounted at /tls/tls.crt and /tls/tls.key for real deployment
+    cert = os.environ.get("TLS_CERT","/tls/tls.crt")
+    key = os.environ.get("TLS_KEY","/tls/tls.key")
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8443")), ssl_context=(cert, key))
+
