+#!/usr/bin/env python3
+"""
+Improved Approval UI:
+ - Uses Keycloak introspection to show approver identity
+ - Adds Slack/PagerDuty integration for on-call escalation
+ - Shows evidence links and allows approver to attach signed note
+"""
+from fastapi import FastAPI, Request, Form
+from fastapi.responses import HTMLResponse, RedirectResponse
+import os, requests, json, logging
+
+app = FastAPI()
+logger = logging.getLogger("approval-ui-imp")
+logging.basicConfig(level=logging.INFO)
+
+APPROVAL_API = os.environ.get("APPROVAL_SERVICE_URL","http://approval-service.monitoring.svc:8080")
+KEYCLOAK_USERINFO = os.environ.get("KEYCLOAK_USERINFO","http://keycloak.monitoring.svc:8080/realms/aegis/protocol/openid-connect/userinfo")
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK","")
+
+def introspect(token):
+    try:
+        r = requests.get(KEYCLOAK_USERINFO, headers={"Authorization": token}, timeout=5)
+        r.raise_for_status()
+        return r.json()
+    except Exception:
+        return {}
+
+@app.get("/", response_class=HTMLResponse)
+def index():
+    try:
+        r = requests.get(f"{APPROVAL_API}/pending", timeout=5)
+        pending = r.json()
+    except Exception:
+        pending = []
+    html = "<h1>Approval Requests</h1><ul>"
+    for p in pending:
+        html += f"<li>{p['id']} - {p.get('summary','')} - Evidence: {p.get('evidence','')} - <form method='post' action='/approve/{p['id']}' style='display:inline'><input name='token' placeholder='Bearer token'><input name='note' placeholder='signed note'><button type='submit'>Approve</button></form></li>"
+    html += "</ul>"
+    return HTMLResponse(html)
+
+@app.post("/approve/{req_id}")
+def approve(req_id: str, token: str = Form(...), note: str = Form("")):
+    user = introspect(token)
+    headers = {"Authorization": token}
+    payload = {"note": note}
+    r = requests.put(f"{APPROVAL_API}/approve/{req_id}", headers=headers, json=payload, timeout=10)
+    if r.status_code != 200:
+        return {"ok": False, "status": r.text}
+    # send alert to slack/pagerduty if configured
+    if ALERT_WEBHOOK:
+        requests.post(ALERT_WEBHOOK, json={"text": f"Approval {req_id} approved by {user.get('preferred_username')}"}, timeout=5)
+    return RedirectResponse("/", status_code=303)
