+    import boto3, time
+    if EVIDENCE_BUCKET:
+        s3=boto3.client("s3")
+        bucket=EVIDENCE_BUCKET.replace("s3://","")
+        resp = s3.list_objects_v2(Bucket=bucket, Prefix="opa/harness-report")
+        items = resp.get("Contents", [])
+        if items:
+            items.sort(key=lambda x: x["LastModified"], reverse=True)
+            key = items[0]["Key"]
+            obj = s3.get_object(Bucket=bucket, Key=key)
+            report = json.loads(obj["Body"].read().decode())
+            mismatches = report.get("mismatches", [])
+            decisions = report.get("decisions", {})
+            total = decisions.get("permit",0) + decisions.get("deny",0)
+            mismatch_rate = len(mismatches)/total if total else 1.0
+            summary = {"mismatch_rate": mismatch_rate, "mismatches": len(mismatches), "decisions": decisions, "s3_key": key}
+            print(json.dumps(summary, indent=2))
+            if mismatch_rate > THRESHOLD:
+                logger.error("OPA mismatch rate %.4f exceeds threshold %.4f", mismatch_rate, THRESHOLD)
+                sys.exit(2)
+            else:
+                logger.info("OPA harness OK: mismatch rate %.4f", mismatch_rate)
+                sys.exit(0)
+    print("No EVIDENCE_BUCKET or report found; inspect harness output")
+
+if __name__ == "__main__":
