+#!/usr/bin/env python3
+"""
+Generate and submit many RayJob manifests to reach target trial counts.
+Each RayJob runs a number of trials and emits checkpoints to S3.
+After submission this script monitors job status and writes a manifest of run_ids to S3 (evidence).
+"""
+import argparse
+import json
+import subprocess
+import tempfile
+import time
+import logging
+import os
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("ray-job-bulk")
+
+def generate_ray_manifest(trials, team, image="us.gcr.io/aegis/ray-hpo-accel:latest", checkpoint_s3="s3://aegis-checkpoints"):
+    manifest = {
+        "apiVersion": "ray.io/v1",
+        "kind": "RayJob",
+        "metadata": {"generateName": f"aegis-hpo-{team}-"},
+        "spec": {
+            "entrypoint": f"python /app/run_ray_tune_prod_checkpoint.py --num-samples {trials}",
+            "template": {"spec": {"containers": [{"name": "hpo", "image": image, "env": [{"name":"CHECKPOINT_S3","value":checkpoint_s3}]}]}}
+        }
+    }
+    return json.dumps(manifest, indent=2)
+
+def submit_manifest(manifest):
+    f = tempfile.NamedTemporaryFile(delete=False, suffix=".yaml")
+    f.write(manifest.encode()); f.close()
+    out = subprocess.check_output(["kubectl", "apply", "-f", f.name]).decode()
+    return out
+
+def monitor_submitted(prefix, timeout_hours=8):
+    # PoC: sleep and not inspect deeply; in production poll RayJob status
+    logger.info("Monitoring submitted jobs (sleeping for %s seconds)", timeout_hours*3600)
+    time.sleep(min(60, timeout_hours*60))
+
+def upload_manifest(manifest, s3uri):
+    if not s3uri:
+        logger.info("No evidence s3 configured; writing locally")
+        path = "/tmp/hpo_submissions.json"
+        open(path,"w").write(json.dumps(manifest, indent=2))
+        return path
+    import boto3
+    bucket = s3uri.replace("s3://","")
+    key = f"hpo/submissions/submitted-{int(time.time())}.json"
+    s3=boto3.client("s3")
+    s3.put_object(Bucket=bucket, Key=key, Body=json.dumps(manifest).encode())
+    return f"s3://{bucket}/{key}"
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--trials-total", type=int, default=128)
+    p.add_argument("--trials-per-job", type=int, default=8)
+    p.add_argument("--checkpoint", default="s3://aegis-checkpoints")
+    p.add_argument("--team", default="validation")
+    p.add_argument("--evidence", default="")
+    args = p.parse_args()
+    submissions=[]
+    remaining = args.trials_total
+    idx=0
+    while remaining>0:
+        n = min(args.trials_per_job, remaining)
+        manifest = generate_ray_manifest(n, f"{args.team}-{idx}", checkpoint_s3=args.checkpoint)
+        try:
+            out = submit_manifest(manifest)
+            logger.info("Submitted job: %s", out.splitlines()[-1] if out else "ok")
+            submissions.append({"team": f"{args.team}-{idx}", "trials": n, "submitted": True})
+        except Exception:
+            logger.exception("submit failed")
+            submissions.append({"team": f"{args.team}-{idx}", "trials": n, "submitted": False})
+        remaining -= n
+        idx += 1
+    # monitor (PoC)
+    monitor_submitted("aegis-hpo", timeout_hours=6)
+    uri = upload_manifest(submissions, args.evidence)
+    print(json.dumps({"submitted": len(submissions), "evidence": uri}, indent=2))
+
+if __name__ == "__main__":
+    main()
+
