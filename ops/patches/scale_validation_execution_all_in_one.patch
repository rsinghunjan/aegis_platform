+#!/usr/bin/env python3
+"""
+Accelerated long-shadow runner:
+ - Samples KPI metrics at an accelerated cadence to simulate long duration runs.
+ - Produces periodic snapshots and uploads a bundled artifact to evidence S3.
+"""
+import argparse, time, json, subprocess, tempfile, os, logging
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("longshadow-accel")
+
+def sample_kpi(prom_url):
+    try:
+        out = subprocess.check_output(["curl","-s", f"{prom_url}/api/v1/query", "--data-urlencode", "query=sum(rate(business_metric[1m]))"], timeout=10)
+        return json.loads(out.decode())
+    except Exception:
+        return None
+
+def upload(path, s3uri):
+    if not s3uri:
+        return path
+    import boto3
+    bucket = s3uri.replace("s3://","")
+    key = f"longshadow/{os.path.basename(path)}"
+    s3=boto3.client("s3")
+    s3.upload_file(path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--hours", type=int, default=24)
+    p.add_argument("--prom", default="http://prometheus.monitoring.svc:9090")
+    p.add_argument("--interval-sec", type=int, default=10)
+    p.add_argument("--evidence", default="")
+    args = p.parse_args()
+    end = time.time() + args.hours*3600
+    tmpdir = tempfile.mkdtemp(prefix="longshadow-")
+    samples = []
+    while time.time() < end:
+        s = sample_kpi(args.prom)
+        ts = datetime.utcnow().isoformat()
+        samples.append({"ts": ts, "kpi": s})
+        # accelerated mode: sleep interval
+        time.sleep(args.interval_sec)
+        # safety: limit size to keep PoC manageable
+        if len(samples) > 10000:
+            break
+    path = os.path.join(tmpdir, f"longshadow_samples_{int(time.time())}.json")
+    open(path,"w").write(json.dumps(samples))
+    uri = upload(path, args.evidence)
+    print(json.dumps({"samples": len(samples), "evidence": uri}, indent=2))
+
+if __name__ == "__main__":
+    main()
+
