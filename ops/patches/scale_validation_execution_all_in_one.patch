+Collect long-term SLO snapshots and aggregate weekly/monthly reports for auditors.
+Uploads aggregated reports to evidence bucket and triggers audit_collector.
+"""
+import os, requests, json, logging, time
+from datetime import datetime, timedelta
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("slo-collector")
+
+PROM_URL = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def query_slo_range(start_iso, end_iso):
+    # PoC: single instant query approximating SLO; replace with range queries
+    try:
+        q = 'sum(rate(success_count[5m]))/sum(rate(request_count[5m]))'
+        r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": q}, timeout=10)
+        if r.status_code!=200:
+            return None
+        return r.json().get("data", {})
+    except Exception:
+        return None
+
+def aggregate(period_days=7):
+    end = datetime.utcnow()
+    start = end - timedelta(days=period_days)
+    data = query_slo_range(start.isoformat(), end.isoformat())
+    report = {"period_start": start.isoformat(), "period_end": end.isoformat(), "slo_sample": data}
+    return report
+
+def upload(report):
+    if not EVIDENCE_BUCKET:
+        print(json.dumps(report, indent=2))
+        return
+    import boto3
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    key=f"reliability/weekly-{int(time.time())}.json"
+    s3.put_object(Bucket=bucket, Key=key, Body=json.dumps(report).encode())
+    logger.info("Uploaded SLO report to s3://%s/%s", bucket, key)
+
+def main():
+    rpt = aggregate(7)
+    upload(rpt)
+
+if __name__ == "__main__":
+    main()
+
