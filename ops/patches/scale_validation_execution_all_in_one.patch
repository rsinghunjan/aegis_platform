+"""
+Improved Trace -> Evidence linker:
+ - For recent run_ids, verify traces contain run_id and business_kpi attributes.
+ - Build a linkage manifest listing evidence S3 prefixes that correspond to traces.
+ - Upload manifest to evidence bucket.
+"""
+import os, requests, json, logging, boto3
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("trace-evidence-linker")
+
+PROM = os.environ.get("PROM_URL", "http://prometheus.monitoring.svc:9090")
+JAEGER = os.environ.get("JAEGER_QUERY", "http://jaeger-query.monitoring.svc:16686/api/traces")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def recent_run_ids(limit=50):
+    try:
+        r = requests.get(f"{PROM}/api/v1/label/run_id/values", timeout=10)
+        if r.status_code != 200:
+            return []
+        return r.json().get("data", [])[-limit:]
+    except Exception:
+        return []
+
+def trace_has_attrs(run_id):
+    try:
+        resp = requests.get(JAEGER, params={"query": f"json.attributes.run_id:{run_id}"}, timeout=10)
+        if resp.status_code != 200:
+            return False
+        data = resp.json().get("data",[])
+        for t in data:
+            for s in t.get("spans",[]):
+                tags = s.get("tags",[])
+                has_run = any(tg.get("key")=="run_id" for tg in tags)
+                has_kpi = any(tg.get("key")=="business_kpi" for tg in tags)
+                if has_run and has_kpi:
+                    return True
+    except Exception:
+        logger.exception("jaeger query failed")
+    return False
+
+def find_evidence_prefix(run_id):
+    # assume evidence layout closedloop/<run_id>/
+    prefix = f"closedloop/{run_id}/"
+    import boto3
+    s3=boto3.client("s3")
+    if not EVIDENCE_BUCKET:
+        return None
+    bucket = EVIDENCE_BUCKET.replace("s3://","")
+    resp = s3.list_objects_v2(Bucket=bucket, Prefix=prefix, MaxKeys=1)
+    return prefix if resp.get("KeyCount",0)>0 else None
+
+def main():
+    runs = recent_run_ids(100)
+    manifest=[]
+    for r in runs:
+        ok = trace_has_attrs(r)
+        evidence_prefix = find_evidence_prefix(r)
+        manifest.append({"run_id": r, "trace_has_attrs": ok, "evidence_prefix": evidence_prefix})
+    out = json.dumps({"ts": datetime.utcnow().isoformat(), "items": manifest}, indent=2)
+    print(out)
+    if EVIDENCE_BUCKET:
+        s3=boto3.client("s3")
+        key=f"trace_evidence/linkage-{int(time.time())}.json"
+        s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key, Body=out.encode())
+        logger.info("Uploaded linkage to s3://%s/%s", EVIDENCE_BUCKET.replace("s3://",""), key)
