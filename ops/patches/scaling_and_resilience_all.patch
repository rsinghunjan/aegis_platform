+#!/usr/bin/env python3
+"""
+Helpers to generate signed URLs for S3 (AWS) and GCS (GCP).
+Operators must supply proper credentials in environment or use IAM roles.
+"""
+import os
+import sys
+import boto3
+from datetime import datetime, timedelta
+
+def s3_presigned(bucket, key, expires=3600):
+    s3 = boto3.client("s3", region_name=os.environ.get("AWS_REGION"))
+    url = s3.generate_presigned_url('get_object', Params={'Bucket': bucket, 'Key': key}, ExpiresIn=expires)
+    return url
+
+def main():
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--provider", choices=["s3"], default="s3")
+    p.add_argument("--bucket", required=True)
+    p.add_argument("--key", required=True)
+    args = p.parse_args()
+    if args.provider == "s3":
+        print(s3_presigned(args.bucket, args.key))
+
+if __name__ == "__main__":
+    main()
+
