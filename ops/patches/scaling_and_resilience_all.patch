+#!/usr/bin/env python3
+"""
+Redis list worker that pops tasks and processes them.
+Processing is intentionally idempotent: tasks should be safe to re-run.
+This worker demonstrates asynchronous signing and indexing.
+"""
+import os
+import time
+import json
+import redis
+import subprocess
+from datetime import datetime
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+r = redis.from_url(REDIS_URL)
+
+def sign_artifact(local_path):
+    # delegate to ops/governance/kms_sign_helper.py if present
+    helper = "ops/governance/kms_sign_helper.py"
+    if os.path.exists(helper):
+        try:
+            subprocess.check_call(["python", helper, "--file", local_path])
+            return True
+        except Exception as e:
+            print("KMS sign helper failed:", e)
+            return False
+    # fallback: create .sig.b64 placeholder
+    import base64
+    open(local_path + ".sig.b64", "wb").write(base64.b64encode(b"mock-signature"))
+    return True
+
+def index_artifact(info):
+    # simple append to evidence index; in prod use Postgres
+    idx = "/tmp/evidence_index.json"
+    entry = {"artifact": info.get("artifact"), "ts": datetime.utcnow().isoformat()+"Z"}
+    try:
+        arr = json.load(open(idx))
+    except Exception:
+        arr = []
+    arr.append(entry)
+    open(idx, "w").write(json.dumps(arr, indent=2))
+    return True
+
+def process_task(task):
+    t = task.get("type")
+    payload = task.get("payload", {})
+    if t == "sign":
+        artifact = payload.get("artifact")
+        ok = sign_artifact(artifact)
+        if ok:
+            index_artifact({"artifact": artifact})
+            print("Signed & indexed", artifact)
+        else:
+            print("Sign failed for", artifact)
+    else:
+        print("Unknown task type", t)
+
+def run_loop():
+    print("Worker started, polling aegis:evidence_tasks")
+    while True:
+        item = r.brpoplpush("aegis:evidence_tasks", "aegis:evidence_tasks.inflight", timeout=5)
+        if not item:
+            time.sleep(1)
+            continue
+        try:
+            task = json.loads(item)
+            print("Processing task", task.get("id"))
+            process_task(task)
+        except Exception as e:
+            print("Task processing failed:", e)
+        finally:
+            # remove from inflight
+            r.lrem("aegis:evidence_tasks.inflight", 0, item)
+
+if __name__ == "__main__":
+    run_loop()
+
