+#!/usr/bin/env python3
+"""
+Simple Redis-backed task producer for evidence-signing / compile jobs.
+
+Pushes small JSON tasks onto Redis list `aegis:evidence_tasks`.
+"""
+import os
+import json
+import redis
+import uuid
+from datetime import datetime
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+r = redis.from_url(REDIS_URL)
+
+def push_task(task_type, payload):
+    task = {"id": str(uuid.uuid4()), "type": task_type, "payload": payload, "ts": datetime.utcnow().isoformat()+"Z"}
+    r.lpush("aegis:evidence_tasks", json.dumps(task))
+    print("Pushed task", task["id"])
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--type", default="sign")
+    p.add_argument("--artifact", required=True)
+    args = p.parse_args()
+    push_task(args.type, {"artifact": args.artifact})
+
