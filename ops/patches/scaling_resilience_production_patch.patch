+#!/usr/bin/env python3
+"""
+Simple OTA server that returns CDN/signed URLs for artifacts instead of serving from origin.
+Uses ops/ota/signed_url_helper.py for presigned URL generation.
+"""
+from flask import Flask, request, jsonify
+import os, json
+from ops.ota import signed_url_helper as helper
+
+app = Flask(__name__)
+
+@app.route("/packages/latest")
+def latest():
+    # For simplicity: return the most recent package file in /opt/ota/packages
+    import glob
+    files = sorted(glob.glob("/opt/ota/packages/*.json"), reverse=True)
+    if not files:
+        return ("",204)
+    pkg = json.load(open(files[0]))
+    # if artifact stored in S3, convert to presigned URL
+    if pkg.get("storage") == "s3":
+        bucket = pkg.get("s3_bucket")
+        key = pkg.get("s3_key")
+        url = helper.s3_presigned(bucket, key, expires=3600)
+        pkg["artifact_url"] = url
+    return jsonify(pkg)
+
+@app.route("/agent/heartbeat", methods=["POST"])
+def hb():
+    j=request.get_json(force=True)
+    with open("/tmp/ota_heartbeats.log","a") as fh:
+        fh.write(json.dumps(j)+"\n")
+    return jsonify({"status":"ok"})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=8080)
+
