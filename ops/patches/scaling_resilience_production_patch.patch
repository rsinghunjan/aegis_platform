+#!/usr/bin/env python3
+"""
+Worker that processes tasks off Redis and indexes to Postgres (replacing SQLite).
+Uses ops/db/postgres_connector.py for indexing.
+"""
+import os
+import time
+import json
+import redis
+import subprocess
+from datetime import datetime
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+r = redis.from_url(REDIS_URL)
+
+def sign_artifact(local_path):
+    helper = "ops/governance/kms_sign_helper.py"
+    if os.path.exists(helper):
+        try:
+            subprocess.check_call(["python", helper, "--file", local_path])
+            return True
+        except Exception as e:
+            print("KMS sign helper failed:", e)
+            return False
+    # fallback mock signature
+    import base64
+    open(local_path + ".sig.b64", "wb").write(base64.b64encode(b"mock-signature"))
+    return True
+
+def index_to_postgres(artifact):
+    # delegate to postgres connector
+    try:
+        subprocess.check_call(["python","ops/db/postgres_connector.py","--index", json.dumps({"artifact":artifact,"meta":{}})])
+        return True
+    except Exception as e:
+        print("Postgres index failed:", e)
+        return False
+
+def process_task(task):
+    t = task.get("type")
+    payload = task.get("payload", {})
+    if t == "sign":
+        artifact = payload.get("artifact")
+        ok = sign_artifact(artifact)
+        if ok:
+            index_to_postgres(artifact)
+            print("Signed & indexed", artifact)
+        else:
+            print("Sign failed for", artifact)
+    else:
+        print("Unknown task type", t)
+
+def run_loop():
+    print("Worker_postgres started, polling aegis:evidence_tasks")
+    while True:
+        item = r.brpoplpush("aegis:evidence_tasks", "aegis:evidence_tasks.inflight", timeout=5)
+        if not item:
+            time.sleep(1)
+            continue
+        try:
+            task = json.loads(item)
+            print("Processing task", task.get("id"))
+            process_task(task)
+        except Exception as e:
+            print("Task processing failed:", e)
+        finally:
+            r.lrem("aegis:evidence_tasks.inflight", 0, item)
+
+if __name__ == "__main__":
+    run_loop()
+
