+#!/usr/bin/env python3
+"""
+GPU pre-warm controller
+
+ - Watches Redis queue length (aegis:inference_tasks or aegis:evidence_tasks) and ensures a minimum GPU nodepool size.
+ - Supports GKE (gcloud) and EKS/eksctl/AWS (CLI) via environment-configured commands.
+ - This is a helper script that operators can run as a CronJob or deployment.
+
+Config (env):
+  REDIS_URL
+  QUEUE_NAME (default aegis:inference_tasks)
+  PREWARM_THRESHOLD (queue length to trigger pre-warm)
+  TARGET_GPU_NODES (number of nodes to ensure)
+  CLOUD_PROVIDER (gke|aws|none)
+  GKE_PROJECT, GKE_ZONE, GKE_CLUSTER, GKE_NODEPOOL
+  AWS_ASG_NAME (for AWS autoscaling group name)
+"""
+import os
+import time
+import redis
+import subprocess
+
+REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
+QUEUE = os.environ.get("QUEUE_NAME", "aegis:inference_tasks")
+PREWARM_THRESHOLD = int(os.environ.get("PREWARM_THRESHOLD", "50"))
+TARGET_GPU_NODES = int(os.environ.get("TARGET_GPU_NODES", "2"))
+CLOUD = os.environ.get("CLOUD_PROVIDER", "none")
+
+r = redis.from_url(REDIS_URL)
+
+def get_queue_len():
+    try:
+        return r.llen(QUEUE)
+    except Exception:
+        return 0
+
+def ensure_gke_nodes():
+    project = os.environ.get("GKE_PROJECT")
+    zone = os.environ.get("GKE_ZONE")
+    cluster = os.environ.get("GKE_CLUSTER")
+    nodepool = os.environ.get("GKE_NODEPOOL")
+    if not all([project, zone, cluster, nodepool]):
+        print("GKE config missing")
+        return False
+    cmd = ["gcloud","container","node-pools","resize", nodepool, f"--cluster={cluster}", f"--zone={zone}", f"--num-nodes={TARGET_GPU_NODES}", f"--project={project}", "--quiet"]
+    print("Running:", " ".join(cmd))
+    try:
+        subprocess.check_call(cmd)
+        return True
+    except Exception as e:
+        print("GKE resize failed:", e); return False
+
+def ensure_aws_nodes():
+    asg = os.environ.get("AWS_ASG_NAME")
+    if not asg:
+        print("AWS_ASG_NAME missing"); return False
+    cmd = ["aws","autoscaling","set-desired-capacity","--auto-scaling-group-name",asg,"--desired-capacity",str(TARGET_GPU_NODES),"--honor-cooldown"]
+    print("Running:", " ".join(cmd))
+    try:
+        subprocess.check_call(cmd)
+        return True
+    except Exception as e:
+        print("AWS resize failed:", e); return False
+
+def main():
+    while True:
+        length = get_queue_len()
+        print("Queue length", length)
+        if length >= PREWARM_THRESHOLD:
+            print("Threshold exceeded; ensuring GPU nodes")
+            if CLOUD == "gke":
+                ensure_gke_nodes()
+            elif CLOUD == "aws":
+                ensure_aws_nodes()
+            else:
+                print("No cloud configured; notify operator")
+        time.sleep(int(os.environ.get("PREWARM_POLL", "30")))
+
+if __name__ == "__main__":
+    main()
+
