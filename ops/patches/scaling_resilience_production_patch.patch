+#!/usr/bin/env python3
+"""
+Autopilot gatekeeper
+
+ - Watches quota_enforcer output (or calls billing connectors) and flips a ConfigMap key to disable autopilot when budget exceeded.
+ - Also creates a GitHub issue to notify operators.
+
+Config (env):
+  GITHUB_REPO
+  GITHUB_TOKEN
+  KUBECONFIG (optional, for in-cluster use use service account)
+  AUTOPILOT_CONFIGMAP (default: aegis/autopilot-config)
+"""
+import os
+import json
+import subprocess
+import requests
+from datetime import datetime
+
+AUTOPILOT_CM = os.environ.get("AUTOPILOT_CONFIGMAP", "aegis/autopilot-config")
+GITHUB_REPO = os.environ.get("GITHUB_REPO")
+GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN")
+
+def read_quota_report(path="/tmp/quota_report.json"):
+    if os.path.exists(path):
+        return json.load(open(path))
+    return {}
+
+def disable_autopilot():
+    ns,name = AUTOPILOT_CM.split("/",1)
+    cmd = ["kubectl","-n",ns,"create","configmap",name,"--from-literal=enabled=false","--dry-run=client","-o","yaml"]
+    try:
+        out = subprocess.check_output(cmd)
+        apply = ["kubectl","apply","-f","-"]
+        p = subprocess.Popen(apply, stdin=subprocess.PIPE)
+        p.communicate(out)
+        print("Autopilot disabled in ConfigMap")
+    except Exception as e:
+        print("Failed to update ConfigMap:", e)
+
+def create_github_issue(title, body):
+    if not GITHUB_REPO or not GITHUB_TOKEN:
+        print("GitHub not configured; skipping issue")
+        return
+    url = f"https://api.github.com/repos/{GITHUB_REPO}/issues"
+    r = requests.post(url, json={"title": title, "body": body, "labels":["billing","autopilot"]}, headers={"Authorization":f"token {GITHUB_TOKEN}","Accept":"application/vnd.github+json"})
+    print("Issue create status", r.status_code)
+
+def main():
+    report = read_quota_report()
+    aws = report.get("aws", {})
+    over = aws.get("over")
+    total = aws.get("total")
+    if over:
+        print("Quota exceeded:", total)
+        disable_autopilot()
+        create_github_issue("[Autopilot Disabled] Billing threshold exceeded", f"Total cost: {total}. Autopilot disabled automatically at {datetime.utcnow().isoformat()}Z.")
+    else:
+        print("Quota within limits")
+
+if __name__=="__main__":
+    main()
+
