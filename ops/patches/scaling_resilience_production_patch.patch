+#!/usr/bin/env python3
+"""
+Small async signing service that accepts artifact index requests and enqueues sign tasks.
+Provides a status endpoint to query task state (based on Redis inflight list).
+
+This decouples KMS signing from user request paths.
+"""
+from flask import Flask, request, jsonify
+import os, json, redis, uuid, time
+
+REDIS_URL = os.environ.get("REDIS_URL","redis://redis:6379/0")
+r = redis.from_url(REDIS_URL)
+TASK_LIST = "aegis:evidence_tasks"
+
+app = Flask(__name__)
+
+@app.route("/sign", methods=["POST"])
+def sign():
+    data = request.get_json(force=True)
+    artifact = data.get("artifact")
+    if not artifact:
+        return jsonify({"error":"artifact required"}), 400
+    task = {"id": str(uuid.uuid4()), "type": "sign", "payload": {"artifact": artifact}, "ts": time.time()}
+    r.lpush(TASK_LIST, json.dumps(task))
+    return jsonify({"task_id": task["id"], "status":"queued"}), 202
+
+@app.route("/status/<task_id>")
+def status(task_id):
+    # naive status: check inflight list and main queue
+    inflight = r.lrange("aegis:evidence_tasks.inflight",0,-1)
+    queue = r.lrange(TASK_LIST,0,-1)
+    for b in inflight+queue:
+        try:
+            t = json.loads(b)
+            if t.get("id") == task_id:
+                return jsonify({"task_id":task_id, "found": True}), 200
+        except Exception:
+            continue
+    return jsonify({"task_id":task_id, "found": False}), 404
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", "8081")))
+
