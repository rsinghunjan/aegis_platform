+#!/usr/bin/env python3
+"""
+Simple Postgres connector for evidence indexing.
+
+Usage:
+  export DATABASE_URL=postgresql://user:pass@postgres.default.svc.cluster.local:5432/aegis
+  python ops/db/postgres_connector.py --init
+  python ops/db/postgres_connector.py --index '{"artifact":"s3://bucket/key","meta":{}}'
+
+Notes:
+ - For production use a managed Postgres (RDS / Cloud SQL) and configure proper credentials and TLS.
+ - This is intentionally small and uses psycopg2; add pooling (pgbouncer) in production.
+"""
+import os
+import json
+import argparse
+import psycopg2
+import psycopg2.extras
+
+DATABASE_URL = os.environ.get("DATABASE_URL", "postgresql://postgres:postgres@localhost:5432/aegis")
+
+def get_conn():
+    return psycopg2.connect(DATABASE_URL)
+
+def init_db():
+    with get_conn() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+            CREATE TABLE IF NOT EXISTS evidence (
+              id SERIAL PRIMARY KEY,
+              artifact TEXT,
+              meta JSONB,
+              created_at TIMESTAMP WITH TIME ZONE DEFAULT now()
+            );
+            CREATE INDEX IF NOT EXISTS idx_evidence_artifact ON evidence (artifact);
+            """)
+            conn.commit()
+    print("Initialized evidence table")
+
+def index_evidence(entry_json):
+    entry = json.loads(entry_json) if isinstance(entry_json, str) else entry_json
+    artifact = entry.get("artifact")
+    meta = entry.get("meta") or {}
+    with get_conn() as conn:
+        with conn.cursor() as cur:
+            cur.execute("INSERT INTO evidence (artifact, meta) VALUES (%s, %s) RETURNING id", (artifact, json.dumps(meta)))
+            id = cur.fetchone()[0]
+            conn.commit()
+    print("Indexed evidence id=", id)
+    return id
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--init", action="store_true")
+    p.add_argument("--index", help="JSON string or path")
+    args = p.parse_args()
+    if args.init:
+        init_db(); return
+    if args.index:
+        payload = args.index
+        if os.path.exists(payload):
+            payload = open(payload).read()
+        index_evidence(payload)
+
+if __name__ == "__main__":
+    main()
+
