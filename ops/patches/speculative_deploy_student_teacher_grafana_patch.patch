+"""
+Student model stub for speculative decoding pilot.
+Provides a very simple /generate endpoint that returns a draft text.
+This is a lightweight, deterministic stub intended for staging/shadow testing.
+In production replace with a real student model (distilled/quantized).
+"""
+from flask import Flask, request, jsonify
+import math
+
+app = Flask(__name__)
+
+def simple_draft(context: str, max_length: int = 8) -> str:
+    # naive deterministic "generation": repeat last 1-3 words with suffixes
+    words = context.strip().split()
+    base = words[-3:] if len(words) >= 3 else words
+    draft_tokens = []
+    for i in range(max_length):
+        # produce token based on index and last token
+        last = base[-1] if base else "tok"
+        draft_tokens.append(f"{last}_s{i}")
+        base.append(draft_tokens[-1])
+    return " ".join(draft_tokens)
+
+@app.route("/generate", methods=["POST"])
+def generate():
+    j = request.get_json() or {}
+    context = j.get("context", "")
+    max_length = int(j.get("max_length", 8))
+    text = simple_draft(context, max_length=max_length)
+    return jsonify({"text": text})
+
+@app.route("/health")
+def health():
+    return jsonify({"status":"ok"})
+
+if __name__ == "__main__":
+    app.run(host="0.0.0.0", port=8080)
+
