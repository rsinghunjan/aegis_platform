+"""
+Teacher scoring and generate-one-token stub for speculative decoding pilot.
+
+Endpoints:
+ - POST /score_batch  Accepts list of {"job_id","context","draft"} and returns list of {"job_id","tokens":[...],"token_scores":[...]}
+ - POST /generate_one Accepts {"context"} and returns {"token":"<token>", "token_logprob": -0.5}
+
+This stub uses simple whitespace tokenization and deterministic scoring heuristics (length-based).
+Replace with real teacher model scoring in staging/production.
+"""
+from flask import Flask, request, jsonify
+import math
+
+app = Flask(__name__)
+
+def tokenize(text: str):
+    # simple whitespace tokenization (must match student/staging tokenizer in pilot)
+    if not text:
+        return []
+    return text.strip().split()
+
+def score_token(token: str):
+    # heuristic: shorter tokens get slightly higher "confidence"; deterministic mapping to [-1.5, -0.1]
+    n = len(token)
+    score = -1.0 + (min(10, max(1, 10 - n)) * 0.05)
+    # clamp
+    score = max(-3.0, min(5.0, score))
+    return float(score)
+
+@app.route("/score_batch", methods=["POST"])
+def score_batch():
+    batch = request.get_json() or []
+    out = []
+    for job in batch:
+        job_id = job.get("job_id")
+        draft = job.get("draft","")
+        tokens = tokenize(draft)
+        token_scores = [score_token(t) for t in tokens]
+        out.append({"job_id": job_id, "tokens": tokens, "token_scores": token_scores})
+    return jsonify(out)
+
+@app.route("/generate_one", methods=["POST"])
+def generate_one():
+    j = request.get_json() or {}
+    context = j.get("context","")
+    # deterministic "next token": last word + "_t"
+    last = context.strip().split()[-1] if context.strip().split() else "tok"
+    token = f"{last}_t"
+    # logprob-like score (negative)
+    logprob = -0.5
+    return jsonify({"token": token, "token_logprob": logprob})
+
+@app.route("/health")
+def health():
+    return jsonify({"status":"ok"})
+
+if __name__=="__main__":
+    app.run(host="0.0.0.0", port=8080)
+
