+#!/usr/bin/env python3
+"""
+Speculative Mode Circuit Breaker Controller (scaffold)
+
+ - Polls Prometheus for metrics and auto-disables speculative mode when thresholds are crossed.
+ - Exposes a simple HTTP API to query and set the speculative_enabled flag:
+    GET  /status  -> {"enabled":true, "reason":...}
+    POST /disable -> {"status":"disabled"}
+    POST /enable  -> {"status":"enabled"}
+
+ - By default toggles an in-memory flag; when KUBE_CONFIG is provided and a CONFIGMAP target is set,
+   it will patch the ConfigMap key to persist the flag cluster-wide.
+"""
+import os
+import time
+import threading
+import requests
+from fastapi import FastAPI
+from pydantic import BaseModel
+
+PROM_URL = os.environ.get("PROMETHEUS_URL", "http://prometheus.monitoring:9090")
+POLL_SECS = int(os.environ.get("CB_POLL_SECS", "30"))
+ACCEPT_THRESHOLD = float(os.environ.get("CB_ACCEPT_THRESH", "0.2"))
+FALLBACK_RATE_THRESH = float(os.environ.get("CB_FALLBACK_RATE_THRESH", "0.1"))  # per-second rate threshold
+CONFIGMAP_NAME = os.environ.get("CB_CONFIGMAP", "")
+CONFIGMAP_NS = os.environ.get("CB_CONFIGMAP_NS", "inference")
+KUBECONFIG = os.environ.get("KUBECONFIG", "")
+
+app = FastAPI(title="Speculative Circuit Breaker")
+
+state = {"enabled": True, "reason": "initial"}
+
+def patch_configmap(enabled: bool):
+    if not CONFIGMAP_NAME:
+        return
+    # Best-effort kubectl patch
+    val = "true" if enabled else "false"
+    try:
+        # label key: speculative_enabled
+        cmd = f"kubectl -n {CONFIGMAP_NS} patch configmap {CONFIGMAP_NAME} -p '{{\"data\":{{\"speculative_enabled\":\"{val}\"}}}}'"
+        os.system(cmd)
+    except Exception:
+        pass
+
+def query_prometheus(expr: str):
+    try:
+        r = requests.get(f"{PROM_URL}/api/v1/query", params={"query": expr}, timeout=5)
+        r.raise_for_status()
+        data = r.json()
+        return data.get("data", {}).get("result", [])
+    except Exception:
+        return []
+
+def monitor_loop():
+    while True:
+        try:
+            # acceptance rate (instant)
+            res = query_prometheus("aegis_spec_acceptance_rate")
+            accept_val = float(res[0]["value"][1]) if res else 1.0
+            # fallback rate over 5m
+            fr = query_prometheus('increase(aegis_spec_fallback_count_total[5m])')
+            fallback_count = float(fr[0]["value"][1]) if fr else 0.0
+            if accept_val < ACCEPT_THRESHOLD or fallback_count > 50:
+                if state["enabled"]:
+                    state["enabled"] = False
+                    state["reason"] = f"auto_disabled_accept={accept_val:.3f}_fallbacks={fallback_count}"
+                    patch_configmap(False)
+            # re-enable if metrics recover (apply hysteresis)
+            if not state["enabled"] and accept_val > (ACCEPT_THRESHOLD + 0.05) and fallback_count < 10:
+                state["enabled"] = True
+                state["reason"] = "auto_reenabled_recovered"
+                patch_configmap(True)
+        except Exception:
+            pass
+        time.sleep(POLL_SECS)
+
+@app.on_event("startup")
+def start_monitor():
+    t = threading.Thread(target=monitor_loop, daemon=True)
+    t.start()
+
+@app.get("/status")
+def get_status():
+    return {"enabled": state["enabled"], "reason": state["reason"]}
+
+@app.post("/disable")
+def disable():
+    state["enabled"] = False
+    state["reason"] = "manual_disable"
+    patch_configmap(False)
+    return {"status":"disabled"}
+
+@app.post("/enable")
+def enable():
+    state["enabled"] = True
+    state["reason"] = "manual_enable"
+    patch_configmap(True)
+    return {"status":"enabled"}
+
