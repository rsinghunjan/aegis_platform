+#!/usr/bin/env python3
+"""
+Tokenizer parity checker
+
+ - Compares tokenization between two tokenizer implementations or between two model names.
+ - POST /check with JSON {"model_a":"gpt2", "model_b":"gpt2-medium", "samples":[ "...", ... ]}
+ - Returns per-sample tokenization diffs and summary.
+"""
+from fastapi import FastAPI, HTTPException, Request
+from pydantic import BaseModel
+from typing import List, Dict, Any, Optional
+from transformers import AutoTokenizer
+
+app = FastAPI(title="Tokenizer Parity Checker")
+
+class CheckRequest(BaseModel):
+    model_a: str
+    model_b: str
+    samples: Optional[List[str]] = None
+
+@app.post("/check")
+async def check(req: CheckRequest):
+    samples = req.samples or [
+        "The quick brown fox jumps over the lazy dog.",
+        "In 2026 AI is everywhere; privacy matters.",
+        "Tokenization parity: check #1."
+    ]
+    try:
+        t_a = AutoTokenizer.from_pretrained(req.model_a, use_fast=True)
+        t_b = AutoTokenizer.from_pretrained(req.model_b, use_fast=True)
+    except Exception as e:
+        raise HTTPException(status_code=400, detail=f"Failed to load tokenizers: {e}")
+    diffs = []
+    total = {"equal":0, "different":0}
+    for s in samples:
+        a_ids = t_a.encode(s, add_special_tokens=False)
+        b_ids = t_b.encode(s, add_special_tokens=False)
+        a_toks = t_a.convert_ids_to_tokens(a_ids)
+        b_toks = t_b.convert_ids_to_tokens(b_ids)
+        equal = (a_ids == b_ids)
+        if equal:
+            total["equal"] += 1
+        else:
+            total["different"] += 1
+        diffs.append({
+            "sample": s,
+            "a_tokens": a_toks,
+            "a_ids": a_ids,
+            "b_tokens": b_toks,
+            "b_ids": b_ids,
+            "equal": equal
+        })
+    return {"summary": total, "diffs": diffs}
+
+@app.get("/health")
+async def health():
+    return {"status":"ok"}
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=8090)
+
