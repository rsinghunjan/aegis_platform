+#!/usr/bin/env python3
+"""
+Teacher scoring service (production-ready scaffold)
+
+ - Loads a Hugging Face causal LM and tokenizer and exposes:
+   POST /score_batch  -> accepts list of {"job_id","context","draft"} and returns per-job:
+         {"job_id","tokens":[...],"token_ids":[...],"token_scores":[...]}
+   POST /generate_one -> accepts {"context"} and returns {"token":"...","token_id":..,"token_logprob":..}
+
+Notes:
+ - For performance, this currently processes jobs sequentially. Replace with batching/padding to utilize GPU efficiently.
+ - Ensure this service is deployed on GPU nodes with appropriate device plugin if using large models.
+ - Use the same tokenizer on student and teacher to ensure tokenization parity.
+"""
+import os
+from typing import List, Dict, Any
+from fastapi import FastAPI, HTTPException, Request
+from pydantic import BaseModel
+import torch
+import torch.nn.functional as F
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+MODEL_NAME = os.environ.get("TEACHER_MODEL", "gpt2")
+DEVICE = os.environ.get("TEACHER_DEVICE", "cuda" if torch.cuda.is_available() else "cpu")
+PORT = int(os.environ.get("TEACHER_PORT", "8080"))
+
+app = FastAPI(title="Aegis Teacher Scoring Service")
+
+class Job(BaseModel):
+    job_id: str
+    context: str
+    draft: str
+
+class ScoreBatchRequest(BaseModel):
+    jobs: List[Job]
+
+# Load model & tokenizer once at startup
+print(f"Loading teacher model {MODEL_NAME} on {DEVICE} ...")
+tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, use_fast=True)
+model = AutoModelForCausalLM.from_pretrained(MODEL_NAME)
+model.to(DEVICE)
+model.eval()
+print("Teacher model loaded.")
+
+def compute_token_scores(context: str, draft: str) -> Dict[str, Any]:
+    """
+    Compute token ids, tokens and per-token logprobs (natural log) for draft tokens
+    given the context using a single forward pass.
+    """
+    # combine context + draft; we will compute logprobs for draft tokens conditioned on context+previous draft tokens
+    if context is None:
+        context = ""
+    full_text = (context + " " + draft).strip() if context else draft
+    # encode to ids
+    enc = tokenizer(full_text, return_tensors="pt", add_special_tokens=False)
+    input_ids = enc["input_ids"].to(DEVICE)  # shape [1, seq_len]
+    # we need to know boundary between context and draft in tokens
+    if context:
+        ctx_enc = tokenizer(context, return_tensors="pt", add_special_tokens=False)
+        ctx_len = ctx_enc["input_ids"].shape[1]
+    else:
+        ctx_len = 0
+    seq_len = input_ids.shape[1]
+    if seq_len <= ctx_len:
+        # nothing to score
+        return {"tokens": [], "token_ids": [], "token_scores": []}
+
+    with torch.no_grad():
+        outputs = model(input_ids)
+        # logits shape: [1, seq_len, vocab]
+        logits = outputs.logits  # type: ignore
+        # compute log softmax across vocab for all positions
+        logprobs = F.log_softmax(logits, dim=-1)  # [1, seq_len, vocab]
+        # for each draft token i (positions ctx_len .. seq_len-1), the relevant predictive logits are at position i-1
+        tokens_ids = input_ids[0, ctx_len: seq_len].tolist()
+        tokens = tokenizer.convert_ids_to_tokens(tokens_ids)
+        token_scores = []
+        for idx, token_id in enumerate(tokens_ids):
+            pos = ctx_len + idx
+            # teacher predicting token at pos => logits at pos-1 (previous token), except when pos==0 (no prev); handle pos==0 by using logits[0,0]
+            logits_pos = logprobs[0, pos - 1] if pos - 1 >= 0 else logprobs[0, 0]
+            score = float(logits_pos[token_id].item())
+            token_scores.append(score)
+
+    return {"tokens": tokens, "token_ids": tokens_ids, "token_scores": token_scores}
+
+@app.post("/score_batch")
+async def score_batch(req: List[Dict[str, Any]]):
+    """
+    Accepts a list of jobs (job_id, context, draft). Returns list of results per job.
+    """
+    out = []
+    try:
+        for j in req:
+            job_id = j.get("job_id")
+            context = j.get("context", "")
+            draft = j.get("draft", "")
+            res = compute_token_scores(context, draft)
+            out.append({"job_id": job_id, **res})
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
+    return out
+
+@app.post("/generate_one")
+async def generate_one(req: Request):
+    body = await req.json()
+    context = body.get("context", "")
+    # tokenization
+    enc = tokenizer(context, return_tensors="pt", add_special_tokens=False)
+    input_ids = enc["input_ids"].to(DEVICE)
+    with torch.no_grad():
+        outputs = model(input_ids)
+        logits = outputs.logits  # [1, seq_len, vocab]
+        # next-token logits are at last position
+        last_logits = logits[0, -1, :]
+        logp = F.log_softmax(last_logits, dim=-1)
+        token_id = int(torch.argmax(last_logits).item())
+        token_str = tokenizer.convert_ids_to_tokens([token_id])[0]
+        token_logprob = float(logp[token_id].item())
+    return {"token": token_str, "token_id": token_id, "token_logprob": token_logprob}
+
+@app.get("/health")
+async def health():
+    return {"status": "ok", "model": MODEL_NAME, "device": DEVICE}
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=PORT)
+
