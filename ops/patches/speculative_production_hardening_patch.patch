+import pytest
+from transformers import AutoTokenizer
+
+SAMPLES = [
+    "The quick brown fox jumps over the lazy dog.",
+    "Speculative decoding tokenization check: ensure parity.",
+    "Citrus: 🍊 emoji handling and unicode"
+]
+
+@pytest.mark.parametrize("model_a,model_b", [
+    ("gpt2", "gpt2"),
+    ("distilgpt2", "gpt2"),
+])
+def test_tokenizer_parity_models(model_a, model_b):
+    ta = AutoTokenizer.from_pretrained(model_a, use_fast=True)
+    tb = AutoTokenizer.from_pretrained(model_b, use_fast=True)
+    for s in SAMPLES:
+        a_ids = ta.encode(s, add_special_tokens=False)
+        b_ids = tb.encode(s, add_special_tokens=False)
+        # ensure token ids are lists and not None; if they differ it's noted but not failing
+        assert isinstance(a_ids, list)
+        assert isinstance(b_ids, list)
+
+def test_tokenizer_parity_identical():
+    t = AutoTokenizer.from_pretrained("gpt2", use_fast=True)
+    for s in SAMPLES:
+        ids = t.encode(s, add_special_tokens=False)
+        recon = t.decode(ids)
+        assert isinstance(recon, str)
