+/* TokenTrace - simple React component to show token-level trace (student vs teacher)
+   Usage:
+     <TokenTrace trace={trace} />
+   where trace = {
+     tokens: ["Hello", "Ġworld", ...],
+     proposed_by: ["student","student","teacher",...],
+     teacher_scores: [ -0.2, -1.1, ... ]
+   }
+*/
+import React from "react";
+
+function TokenTrace({trace}) {
+  if (!trace) return <div>No trace</div>;
+  const tokens = trace.tokens || [];
+  const by = trace.proposed_by || [];
+  const scores = trace.teacher_scores || [];
+  return (
+    <div style={{fontFamily: "monospace", padding: 8, border: "1px solid #ddd", borderRadius: 6}}>
+      <div style={{marginBottom:8}}><strong>Token-level trace</strong></div>
+      <div style={{display:"flex", flexWrap:"wrap"}}>
+        {tokens.map((t, i) => {
+          const proposer = by[i] || "teacher";
+          const bg = proposer === "student" ? "#e6f7ff" : "#fff4e6";
+          return (
+            <div key={i} style={{margin:4, padding:6, background:bg, borderRadius:4, minWidth:80}}>
+              <div style={{fontSize:12, color:"#444"}}>{t}</div>
+              <div style={{fontSize:11, color:"#666"}}>{proposer}</div>
+              <div style={{fontSize:11, color:"#999"}}>{scores[i] !== undefined ? scores[i].toFixed(3) : ""}</div>
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
+
+export default TokenTrace;
+
