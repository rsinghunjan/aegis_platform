+/*
+ Minimal Kalman filter C demo (single-dim for clarity).
+ Compile: make -C ops/ssm/on_device
+ Run: ./kalman_c_demo
+*/
+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
+
+int main() {
+    double A = 1.0, B = 0.1, C = 1.0;
+    double Q = 0.01, R = 0.1;
+    double x = 0.0;
+    double P = 1.0;
+    for (int t=0; t<100; t++) {
+        double u = 0.1 * sin(0.1 * t);
+        // predict
+        x = A * x + B * u;
+        P = A*P*A + Q;
+        // measurement (synthetic)
+        double true_x = sin(0.05 * t);
+        double y = true_x + ((rand()%100)/100.0 - 0.5)*0.2;
+        // update
+        double S = C*P*C + R;
+        double K = P*C / S;
+        double ytil = y - C*x;
+        x = x + K*ytil;
+        P = (1 - K*C)*P;
+        printf("t=%d x_est=%.4f y=%.4f nis=%.4f\\n", t, x, y, ytil*ytil / S);
+    }
+    return 0;
+}
