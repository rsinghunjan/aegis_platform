+"""
+Simple RNN-SSM prototype (encoder-decoder style).
+This is intentionally small to serve as a starter for experiments.
+"""
+import torch
+import torch.nn as nn
+
+class RNNSSM(nn.Module):
+    def __init__(self, obs_dim, input_dim, latent_dim=16, hidden_dim=32):
+        super().__init__()
+        self.latent_dim = latent_dim
+        self.rnn = nn.GRU(input_size=obs_dim+input_dim, hidden_size=hidden_dim, batch_first=True)
+        self.fc_state = nn.Linear(hidden_dim, latent_dim)
+        self.fc_obs = nn.Linear(latent_dim, obs_dim)
+
+    def forward(self, y, u):
+        # y: (B,T,obs_dim), u: (B,T,input_dim)
+        x_in = torch.cat([y, u], dim=-1)
+        h, _ = self.rnn(x_in)
+        z = self.fc_state(h)   # latent sequence
+        y_hat = self.fc_obs(z)
+        return y_hat, z
+
