+"""
+Toy training/eval for Kalman filter hyperparameters on synthetic linear system.
+Produces an artifact .prov.json with SSM metadata (A,B,C,Q,R) and a simple metrics summary.
+"""
+import numpy as np
+import json
+import os
+from kalman_kf import KalmanFilter
+
+def simulate_sys(A,B,C, Q, R, x0, N=200, seed=0):
+    rng = np.random.RandomState(seed)
+    x = np.array(x0).reshape(-1,1)
+    xs, ys, us = [], [], []
+    for t in range(N):
+        u = rng.randn(B.shape[1],1) * 0.1
+        w = rng.multivariate_normal(np.zeros(Q.shape[0]), Q).reshape(-1,1)
+        v = rng.multivariate_normal(np.zeros(R.shape[0]), R).reshape(-1,1)
+        x = A @ x + B @ u + w
+        y = C @ x + v
+        xs.append(x.flatten().tolist())
+        ys.append(y.flatten().tolist())
+        us.append(u.flatten().tolist())
+    return np.array(xs).squeeze(), np.array(ys).squeeze(), np.array(us).squeeze()
+
+def fit_simple_noise(ys):
+    # placeholder: set R as variance of observation residuals
+    return np.var(ys, axis=0).mean() + 1e-6
+
+def main():
+    A = np.array([[1.0, 0.1],[0,1.0]])
+    B = np.array([[0.0],[0.1]])
+    C = np.array([[1.0, 0.0]])
+    Q = np.eye(2) * 0.01
+    R = np.eye(1) * 0.1
+    x0 = np.array([0.0, 0.0])
+    xs, ys, us = simulate_sys(A,B,C,Q,R,x0,N=500)
+    # train/tune (very simple)
+    R_est = fit_simple_noise(ys)
+    R = np.eye(1) * R_est
+    kf = KalmanFilter(A,B,C,Q,R,x0=x0)
+    nis_list = []
+    for t in range(len(ys)):
+        _, nis = kf.step(us[t], ys[t])
+        nis_list.append(nis)
+    metrics = {"nis_mean": float(np.mean(nis_list)), "nis_std": float(np.std(nis_list))}
+    # write model & provenance
+    out_dir = os.environ.get("OUT_DIR","./out")
+    os.makedirs(out_dir, exist_ok=True)
+    prov = {
+        "model_type": "kalman_filter",
+        "A": A.tolist(),
+        "B": B.tolist(),
+        "C": C.tolist(),
+        "Q": Q.tolist(),
+        "R": R.tolist(),
+        "metrics": metrics
+    }
+    open(os.path.join(out_dir,"kalman.prov.json"), "w").write(json.dumps(prov, indent=2))
+    print("Wrote provenance to", os.path.join(out_dir,"kalman.prov.json"))
+
+if __name__=="__main__":
+    main()
+
