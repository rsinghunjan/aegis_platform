+"""
+Generate a synthetic system identification dataset or reformat HIL logs into a unified JSON
+that contains time-aligned control inputs (u), observations (y) and ground-truth (gt).
+"""
+import argparse, json, time, math
+import numpy as np
+
+def synth_pose(duration_s=60, rate_hz=50):
+    N = int(duration_s*rate_hz)
+    t = np.linspace(0, duration_s, N)
+    thrust = 0.1*np.sin(0.2*t)
+    steer = 0.05*np.cos(0.1*t)
+    x = np.cumsum(thrust*np.cos(steer))*0.01
+    y = np.cumsum(thrust*np.sin(steer))*0.01
+    theta = np.cumsum(steer)*0.01
+    accel_x = np.gradient(thrust)
+    accel_y = np.gradient(steer)
+    gyro = np.gradient(theta)
+    data = {"meta":{"generated_at":time.time(),"duration_s":duration_s,"rate_hz":rate_hz},"records":[]}
+    for i in range(N):
+        rec = {
+            "t": float(t[i]),
+            "u": {"thrust": float(thrust[i]), "steer": float(steer[i])},
+            "y": {"accel_x": float(accel_x[i]), "accel_y": float(accel_y[i]), "gyro_z": float(gyro[i])},
+            "gt": {"x": float(x[i]), "y": float(y[i]), "theta": float(theta[i])}
+        }
+        data["records"].append(rec)
+    return data
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", required=True)
+    p.add_argument("--duration", type=int, default=60)
+    p.add_argument("--rate", type=int, default=50)
+    args = p.parse_args()
+    d = synth_pose(duration_s=args.duration, rate_hz=args.rate)
+    open(args.out,"w").write(json.dumps(d))
+    print("Wrote dataset to", args.out)
+
+if __name__=="__main__":
+    main()
+
