+"""
+Prometheus exporter for SSM residuals/NIS.
+Reads a JSON file (residuals produced by jobs) and exposes two gauges:
+ - ssm_residual_mse{model,job}
+ - ssm_nis{model,job}
+This is a lightweight starter; production would push metrics directly from workers to a metrics endpoint.
+"""
+import os, time, json
+from prometheus_client import Gauge, start_http_server
+
+RES_FILE = os.environ.get("SSM_RES_FILE", "/tmp/ssm_residuals.json")
+PORT = int(os.environ.get("PORT", "9200"))
+
+res_mse = Gauge("ssm_residual_mse", "Residual MSE per model/job", ["model","job"])
+res_nis = Gauge("ssm_nis", "Normalized Innovation Squared per model/job", ["model","job"])
+
+def read_and_export():
+    if not os.path.exists(RES_FILE):
+        return
+    j = json.load(open(RES_FILE))
+    for rec in j.get("results", []):
+        model = rec.get("model","unknown")
+        job = rec.get("job","unknown")
+        mse = rec.get("mse",0.0)
+        nis = rec.get("nis",0.0)
+        res_mse.labels(model,job).set(float(mse))
+        res_nis.labels(model,job).set(float(nis))
+
+if __name__=="__main__":
+    start_http_server(PORT)
+    while True:
+        try:
+            read_and_export()
+        except Exception as e:
+            print("read failed", e)
+        time.sleep(10)
+
