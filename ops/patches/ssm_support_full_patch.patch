+#!/usr/bin/env python3
+"""
+Update a .prov.json file with SSM metadata and optionally attach latest carbon estimate (if available).
+"""
+import argparse, json, os
+from datetime import datetime
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--prov", required=True)
+    p.add_argument("--model-type", default="kalman_filter")
+    p.add_argument("--ssm-json", help="SSM metadata JSON to merge")
+    args = p.parse_args()
+    prov = {}
+    if os.path.exists(args.prov):
+        prov = json.load(open(args.prov))
+    if args.ssm_json and os.path.exists(args.ssm_json):
+        prov["ssm"] = json.load(open(args.ssm_json))
+    else:
+        prov.setdefault("ssm", {})["updated_at"] = datetime.utcnow().isoformat()+"Z"
+    prov["model_type"] = args.model_type
+    open(args.prov, "w").write(json.dumps(prov, indent=2))
+    print("Updated provenance:", args.prov)
+
+if __name__=="__main__":
+    main()
