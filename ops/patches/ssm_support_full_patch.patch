+"""
+Train the simple RNN-SSM on synthetic data and export TorchScript for serving.
+"""
+import torch
+import torch.optim as optim
+from model import RNNSSM
+import numpy as np
+import json, os
+
+def synth_data(B=32, T=100, obs_dim=1, input_dim=1):
+    y = np.random.randn(B,T,obs_dim).astype(np.float32)
+    u = np.random.randn(B,T,input_dim).astype(np.float32)*0.1
+    return y, u
+
+def main():
+    obs_dim = 1; input_dim=1
+    model = RNNSSM(obs_dim, input_dim, latent_dim=8, hidden_dim=32)
+    optim_ = optim.Adam(model.parameters(), lr=1e-3)
+    y, u = synth_data()
+    y_t = torch.from_numpy(y); u_t = torch.from_numpy(u)
+    for epoch in range(10):
+        optim_.zero_grad()
+        yhat,_ = model(y_t, u_t)
+        loss = torch.mean((yhat - y_t)**2)
+        loss.backward(); optim_.step()
+        print("epoch", epoch, "loss", loss.item())
+    # export TorchScript
+    model.eval()
+    example_y = torch.zeros(1,10,obs_dim)
+    example_u = torch.zeros(1,10,input_dim)
+    traced = torch.jit.trace(model, (example_y, example_u))
+    out_dir = os.environ.get("OUT_DIR","./out")
+    os.makedirs(out_dir, exist_ok=True)
+    traced.save(os.path.join(out_dir,"rnn_ssm.pt"))
+    # provenance
+    prov = {"model_type":"rnn_ssm","latent_dim":8,"hidden_dim":32}
+    open(os.path.join(out_dir,"rnn_ssm.prov.json"), "w").write(json.dumps(prov, indent=2))
+    print("Saved model and provenance in", out_dir)
+
+if __name__=="__main__":
+    main()
+
