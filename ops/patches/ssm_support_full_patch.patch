+"""
+Simple linear Kalman Filter implementation (discrete-time).
+Works for x_{t+1} = A x_t + B u_t + w_t; y_t = C x_t + v_t
+"""
+import numpy as np
+
+class KalmanFilter:
+    def __init__(self, A, B, C, Q, R, x0=None, P0=None):
+        self.A = np.array(A)
+        self.B = np.array(B) if B is not None else None
+        self.C = np.array(C)
+        self.Q = np.array(Q)
+        self.R = np.array(R)
+        n = self.A.shape[0]
+        self.x = np.zeros((n,1)) if x0 is None else np.array(x0).reshape(n,1)
+        self.P = np.eye(n) if P0 is None else np.array(P0)
+
+    def predict(self, u=None):
+        if self.B is not None and u is not None:
+            self.x = self.A @ self.x + self.B @ np.array(u).reshape(-1,1)
+        else:
+            self.x = self.A @ self.x
+        self.P = self.A @ self.P @ self.A.T + self.Q
+        return self.x
+
+    def update(self, y):
+        y = np.array(y).reshape(-1,1)
+        S = self.C @ self.P @ self.C.T + self.R
+        K = self.P @ self.C.T @ np.linalg.inv(S)
+        ytil = y - (self.C @ self.x)
+        self.x = self.x + K @ ytil
+        self.P = (np.eye(self.P.shape[0]) - K @ self.C) @ self.P
+        # return innovation and NIS for monitoring
+        nis = float(ytil.T @ np.linalg.inv(S) @ ytil)
+        return self.x, nis
+
+    def step(self, u, y):
+        self.predict(u)
+        return self.update(y)
+
