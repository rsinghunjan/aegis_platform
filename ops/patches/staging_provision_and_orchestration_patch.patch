+  # user must set --pg param as DATABASE_URL; try to use manifest value
+  PGURL="${DATABASE_URL:-postgresql://aegis:password@aegis-postgres.monitoring.svc:5432/aegis_registry}"
+  ./ops/scripts/migrate_sqlite_to_postgres.sh --sqlite services/registry/models.db --pg "${PGURL}" || echo "Migration script attempted; verify results manually."
+else
+  echo "No local SQLite registry found; skipping migration."
+fi
+
+echo "=== 10) Wire Alertmanager receivers (Slack/PagerDuty) ==="
