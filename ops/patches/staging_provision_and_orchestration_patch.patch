+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create an S3 bucket with Object Lock enabled and set a default retention policy.
+# NOTE: For AWS S3, Object Lock must be enabled at bucket creation time. This script is best-effort:
+# - If bucket exists, it will attempt to read object-lock config.
+# - If not, it will create bucket with --object-lock-enabled-for-bucket and then put a default retention config.
+#
+# Usage:
+#   EVIDENCE_BUCKET=<bucket> AWS_REGION=<region> ./ops/scripts/create_evidence_bucket_with_object_lock.sh
+
+: "${EVIDENCE_BUCKET:?EVIDENCE_BUCKET must be set}"
+: "${AWS_REGION:?AWS_REGION must be set (e.g. us-east-1)}"
+
+if ! command -v aws >/dev/null 2>&1; then
+  echo "aws CLI not found. Install and configure AWS CLI before running this script."
+  exit 2
+fi
+
+exists=$(aws s3api head-bucket --bucket "${EVIDENCE_BUCKET}" 2>/dev/null || true)
+if [ -n "$exists" ]; then
+  echo "Bucket ${EVIDENCE_BUCKET} already exists. Checking object lock configuration..."
+  cfg=$(aws s3api get-bucket-object-lock-configuration --bucket "${EVIDENCE_BUCKET}" 2>/dev/null || true)
+  if [ -z "$cfg" ]; then
+    echo "Bucket exists but does not show object lock configuration (or you lack permission)."
+    echo "You cannot enable object lock on an existing bucket after creation. Create a new bucket with object-lock enabled if required."
+    exit 1
+  else
+    echo "Bucket has object lock config:"
+    echo "$cfg"
+    exit 0
+  fi
+else
+  echo "Creating bucket ${EVIDENCE_BUCKET} with object lock enabled in region ${AWS_REGION}..."
+  # Create bucket (note: S3 CreateBucket behavior varies by region; use location constraint when required)
+  if [ "${AWS_REGION}" = "us-east-1" ]; then
+    aws s3api create-bucket --bucket "${EVIDENCE_BUCKET}" --object-lock-enabled-for-bucket
+  else
+    aws s3api create-bucket --bucket "${EVIDENCE_BUCKET}" --region "${AWS_REGION}" --create-bucket-configuration LocationConstraint="${AWS_REGION}" --object-lock-enabled-for-bucket
+  fi
+  echo "Applying default retention (GOVERNANCE, 365 days) as a template (operator should adapt)..."
+  aws s3api put-bucket-object-lock-configuration --bucket "${EVIDENCE_BUCKET}" --object-lock-configuration '{
+    "ObjectLockEnabled": "Enabled",
+    "Rule": {
+      "DefaultRetention": { "Mode": "GOVERNANCE", "Days": 365 }
+    }
+  }'
+  echo "Bucket created and default retention applied. Verify with ops/scripts/check_s3_object_lock.sh"
+fi
+
