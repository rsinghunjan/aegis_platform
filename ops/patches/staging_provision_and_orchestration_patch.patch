+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Orchestrator script to provision secrets, deploy stack to staging, run verification, tuning,
+# wrapper audits, long-dry runs, start long-shadow campaign, enable S3 object lock, harden registry auth,
+# wire Alertmanager receiver config, and rehearse MTTR drill.
+#
+# Usage (example):
+#   export EVIDENCE_BUCKET=my-evidence-bucket \
+#     ELECTRICITYMAP_API_KEY=... \
+#     WATTTIME_API_TOKEN=... \
+#     MODEL_STORE_PREFIX=s3://my-models \
+#     KEYCLOAK_URL=https://keycloak.example.com \
+#     KEYCLOAK_REALM=aegis \
+#     KEYCLOAK_CLIENT_ID=aegis-service \
+#     KEYCLOAK_CLIENT_SECRET=... \
+#     AWS_REGION=us-east-1 \
+#   ./ops/scripts/staging_full_run.sh
+
+SCRIPTDIR="$(cd "$(dirname "$0")" && pwd)"
+
+echo "=== 1) Validate environment ==="
+: "${EVIDENCE_BUCKET:?EVIDENCE_BUCKET must be set (name of S3 bucket for evidence)}"
+: "${MODEL_STORE_PREFIX:?MODEL_STORE_PREFIX must be set (e.g. s3://my-model-bucket/models)}"
+# Keycloak creds are optional for dev but required for hardening
+if [ -z "${KEYCLOAK_CLIENT_SECRET:-}" ] || [ -z "${KEYCLOAK_URL:-}" ]; then
+  echo "Warning: Keycloak credentials not fully set; registry will be deployed without strict auth. Set KEYCLOAK_* envs to enable."
+fi
+
+echo "AWS region: ${AWS_REGION:-not-set}"
+
+echo "=== 2) Create production secrets in cluster ==="
+chmod +x "${SCRIPTDIR}/create_prod_secrets.sh"
+"${SCRIPTDIR}/create_prod_secrets.sh"
+
+echo "=== 3) Create evidence S3 bucket with Object Lock (if not exists) ==="
+if command -v aws >/dev/null 2>&1; then
+  chmod +x "${SCRIPTDIR}/create_evidence_bucket_with_object_lock.sh"
+  "${SCRIPTDIR}/create_evidence_bucket_with_object_lock.sh" || echo "Bucket creation/lock step returned non-zero; ensure bucket exists with object lock enabled"
+else
+  echo "aws CLI not found; skipping bucket creation. Ensure bucket ${EVIDENCE_BUCKET} exists and was created with Object Lock enabled."
+fi
+
+echo "=== 4) Bootstrap staging (Postgres + registry + stack) ==="
+chmod +x "${SCRIPTDIR}/setup_staging.sh"
+${SCRIPTDIR}/setup_staging.sh
+
+echo "=== 5) Deploy & verify stack, run promql probe & tune templates ==="
+chmod +x "${SCRIPTDIR}/deploy_and_verify_stack.sh"
+${SCRIPTDIR}/deploy_and_verify_stack.sh || { echo "deploy_and_verify_stack failed"; exit 2; }
+
+echo "Run interactive PromQL tuner helper (auto-check)..."
+chmod +x "${SCRIPTDIR}/tune_promql_apply.sh"
+${SCRIPTDIR}/tune_promql_apply.sh || echo "PromQL tuning helper completed (inspect ops/promql/tuned_promql_templates.json)."
+
+echo "=== 6) Run wrapper audit, wrapper audit checker and acceptance dry-run ==="
+chmod +x "${SCRIPTDIR}/run_wrapper_audit_and_dryrun.sh"
+${SCRIPTDIR}/run_wrapper_audit_and_dryrun.sh || echo "Wrapper audit/dry-run had non-zero exit; inspect logs/artifacts in /tmp and evidence bucket"
+
+echo "=== 7) Start long-shadow campaign & supervisor ==="
+chmod +x "${SCRIPTDIR}/run_long_shadow_campaign.sh"
+# default sample rate and days can be overridden via env
+${SCRIPTDIR}/run_long_shadow_campaign.sh || echo "Long-shadow start attempted; verify long-shadow pods and cronjob in 'monitoring' ns"
+
+echo "=== 8) Verify S3 object lock and evidence writeability ==="
+chmod +x "${SCRIPTDIR}/check_s3_object_lock.sh"
+${SCRIPTDIR}/check_s3_object_lock.sh || echo "S3 Object Lock check failed or requires manual verification"
+
+echo "=== 9) Harden registry behind Keycloak (patch deployment with secret refs) ==="
