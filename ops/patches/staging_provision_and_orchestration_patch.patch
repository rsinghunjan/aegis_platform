+
+echo "=== Optional: Migrate SQLite registry to Postgres (if applicable) ==="
+if [ -f "services/registry/models.db" ]; then
+  echo "Local SQLite registry detected; running migration script to Postgres (operator must ensure DATABASE_URL points to staging Postgres)"
