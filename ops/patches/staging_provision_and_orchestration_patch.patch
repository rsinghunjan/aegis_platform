+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Apply Alertmanager config template (monitoring/alertmanager/alertmanager-config.yaml.template).
+# The operator must replace the PagerDuty and Slack webhook placeholders via environment variables or editing the template.
+#
+TEMPLATE=monitoring/alertmanager/alertmanager-config.yaml.template
+NS=${NAMESPACE:-monitoring}
+
+if [ ! -f "${TEMPLATE}" ]; then
+  echo "Alertmanager template not found: ${TEMPLATE}"
+  exit 2
+fi
+
+echo "Applying Alertmanager config as kubernetes secret (best-effort). Ensure Alertmanager reads this config from the secret or ConfigMap as per your setup."
+kubectl create configmap alertmanager-config -n "${NS}" --from-file=alertmanager.yaml="${TEMPLATE}" --dry-run=client -o yaml | kubectl apply -f -
+echo "ConfigMap alertmanager-config applied in namespace ${NS}. Update your Alertmanager deployment to use this config if not already configured."
+
