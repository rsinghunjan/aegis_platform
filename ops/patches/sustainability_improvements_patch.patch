+"""
+Compress old checkpoints and deduplicate by checksum to reduce storage.
+Run as a cronjob after checkpoints are uploaded to S3 or local filesystem.
+"""
+import os, hashlib, shutil, gzip, argparse, glob
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path,"rb") as f:
+        while True:
+            b = f.read(8192)
+            if not b: break
+            h.update(b)
+    return h.hexdigest()
+
+def compress_and_dedupe(path_pattern, out_dir):
+    os.makedirs(out_dir, exist_ok=True)
+    seen = {}
+    for p in glob.glob(path_pattern):
+        chk = sha256(p)
+        if chk in seen:
+            print("Duplicate found:", p, "->", seen[chk])
+            continue
+        outp = os.path.join(out_dir, os.path.basename(p) + ".gz")
+        with open(p,"rb") as fr, gzip.open(outp,"wb") as fw:
+            shutil.copyfileobj(fr, fw)
+        seen[chk] = outp
+        print("Compressed", p, "->", outp)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--pattern", default="checkpoints/*")
+    p.add_argument("--out", default="checkpoints_compressed")
+    args = p.parse_args()
+    compress_and_dedupe(args.pattern, args.out)
+
