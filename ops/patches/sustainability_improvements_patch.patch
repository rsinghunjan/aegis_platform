+"""
+Middleware helper to integrate into inference service:
+ - Measure wall time per request
+ - Estimate energy (kWh) and CO2e for inference using energy_estimator
+ - Emit Prometheus metrics (via prometheus_client)
+ - Append per-inference sustainability datapoint to evidence store (optionally)
+ Usage: wrap inference handlers to call record_inference(...)
+"""
+import time
+import os
+from prometheus_client import Counter, Gauge
+from services.sustainability.energy_estimator import estimate_energy_for_duration_seconds, estimate_co2e_for_kwh
+import json
+
+INF_COUNT = Counter("aegis_inference_count_total", "Total inference count")
+INF_KWH = Counter("aegis_inference_kwh_total", "Total inferred kWh consumed")
+INF_CO2 = Counter("aegis_inference_co2_kg_total", "Total inferred CO2e (kg)")
+INF_LAT = Gauge("aegis_inference_latency_seconds", "Inference latency seconds")
+
+EVIDENCE_PATH = os.environ.get("EVIDENCE_PATH", "/tmp/inference_sustainability.jsonl")
+
+def record_inference(start_ts, end_ts, model_name, request_meta=None, store_evidence=True):
+    duration = end_ts - start_ts
+    INF_COUNT.inc()
+    INF_LAT.set(duration)
+    kwh = estimate_energy_for_duration_seconds(duration)
+    INF_KWH.inc(kwh)
+    co2 = estimate_co2e_for_kwh(kwh)
+    INF_CO2.inc(co2)
+    if store_evidence:
+        os.makedirs(os.path.dirname(EVIDENCE_PATH), exist_ok=True)
+        rec = {"ts": time.time(), "model": model_name, "duration_s": duration, "kwh": kwh, "co2_kg": co2, "meta": request_meta or {}}
+        with open(EVIDENCE_PATH, "a") as f:
+            f.write(json.dumps(rec) + "\n")
+    return {"duration_s": duration, "kwh": kwh, "co2_kg": co2}
+
