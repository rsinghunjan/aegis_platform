+"""
+Schedule batch training jobs to low-carbon windows and/or preferred regions.
+Uses a carbon intensity API (or a fallback heuristic) to decide when to launch heavy batch jobs.
+This script can be run as a controller or invoked by CI to delay execution to low-carbon windows.
+"""
+import os, time, requests, datetime, subprocess, json
+
+CARBON_API = os.environ.get("CARBON_API_URL", "https://api.carbonintensity.org.uk/intensity")
+THRESH = float(os.environ.get("CARBON_THRESHOLD_KG_PER_KWH", "0.35"))
+CHECK_INTERVAL = int(os.environ.get("BATCH_SCHED_INTERVAL_SECS", "300"))
+KUBE_JOB_TEMPLATE = os.environ.get("KUBE_JOB_TEMPLATE", "ops/scheduling/batch_job_template.yaml")
+
+def get_current_intensity():
+    try:
+        r = requests.get(CARBON_API, timeout=5)
+        r.raise_for_status()
+        j = r.json()
+        if isinstance(j.get("data"), list):
+            val = j["data"][0].get("intensity", {}).get("actual", None)
+            if val is not None:
+                return float(val) / 1000.0
+    except Exception:
+        pass
+    # fallback: use a moderate value
+    return 0.5
+
+def schedule_job_when_low(job_name="aegis-batch-job", max_wait_secs=86400):
+    start = time.time()
+    while time.time() - start < max_wait_secs:
+        intensity = get_current_intensity()
+        print("Current carbon intensity (kgCO2/kWh):", intensity)
+        if intensity <= THRESH:
+            # launch k8s job via kubectl apply
+            cmd = ["kubectl","apply","-f", KUBE_JOB_TEMPLATE]
+            subprocess.check_call(cmd)
+            print("Launched job due to low-carbon window")
+            return True
+        print("Not low enough, sleeping", CHECK_INTERVAL, "secs")
+        time.sleep(CHECK_INTERVAL)
+    print("Timeout waiting for low-carbon window; launching job anyway")
+    subprocess.check_call(["kubectl","apply","-f", KUBE_JOB_TEMPLATE])
+    return False
+
+if __name__ == "__main__":
+    schedule_job_when_low()
+
