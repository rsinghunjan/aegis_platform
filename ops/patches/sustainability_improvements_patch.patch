+"""
+Estimate per-pod / per-inference energy usage and convert to CO2e using a carbon intensity API.
+This is an estimator: for GPUs we read nvidia-smi utilization and TDP; for CPUs we use heuristics.
+Integrate this with inference middleware to emit per-inference kWh and CO2e metrics.
+"""
+import os, subprocess, json
+import math
+import requests
+from typing import Optional
+
+# Config
+DEFAULT_GPU_TDP_WATTS = float(os.environ.get("DEFAULT_GPU_TDP_WATTS", "300.0"))
+CARBON_API_URL = os.environ.get("CARBON_API_URL", "https://api.carbonintensity.org.uk/intensity")  # placeholder
+CARBON_API_FALLBACK = float(os.environ.get("CARBON_API_FALLBACK", "0.4"))  # kgCO2e per kWh fallback
+
+def get_gpu_utilization():
+    """Use nvidia-smi to get GPU utilization percent and power draw (watts) if available."""
+    try:
+        out = subprocess.check_output(["nvidia-smi", "--query-gpu=utilization.gpu,power.draw", "--format=csv,noheader,nounits"], stderr=subprocess.DEVNULL)
+        lines = out.decode().strip().splitlines()
+        # return first GPU entry as aggregate approximation
+        util_str, power_str = lines[0].split(",")
+        util = float(util_str.strip())
+        power = float(power_str.strip())
+        return {"util_pct": util, "power_w": power}
+    except Exception:
+        return None
+
+def estimate_energy_for_duration_seconds(duration_secs: float, pod_role: str = "inference") -> float:
+    """
+    Estimate kWh consumed by this pod during duration_secs.
+    Returns kWh.
+    """
+    # Prefer direct GPU power reading
+    g = get_gpu_utilization()
+    if g and g.get("power_w", 0.0) > 0:
+        watts = g["power_w"]
+    else:
+        # fallback: estimate by util fraction of TDP
+        util = g["util_pct"] if g else 50.0
+        watts = (util / 100.0) * DEFAULT_GPU_TDP_WATTS
+    kwh = (watts * duration_secs) / 3600.0
+    return kwh
+
+def fetch_carbon_intensity(region: Optional[str] = None) -> float:
+    """
+    Query a carbon intensity API to return kgCO2e per kWh. Fallback to configured constant.
+    """
+    try:
+        # very small wrapper to keep generic
+        r = requests.get(CARBON_API_URL, timeout=3)
+        r.raise_for_status()
+        j = r.json()
+        # adapt to common APIs: try nested keys
+        # e.g., UK API -> j['data'][0]['intensity']['actual']
+        if isinstance(j.get("data"), list):
+            intensity = j["data"][0]
+            if isinstance(intensity, dict):
+                # try 'intensity' field
+                val = intensity.get("intensity", {})
+                if isinstance(val, dict) and val.get("actual") is not None:
+                    return float(val["actual"]) / 1000.0  # gCO2/kWh -> kgCO2/kWh
+        # fallback parse
+        return CARBON_API_FALLBACK
+    except Exception:
+        return CARBON_API_FALLBACK
+
+def estimate_co2e_for_kwh(kwh: float, region: Optional[str] = None) -> float:
+    intensity = fetch_carbon_intensity(region)
+    return kwh * intensity
+
+if __name__ == "__main__":
+    # quick demo
+    kwh = estimate_energy_for_duration_seconds(1.0)  # 1 sec
+    co2 = estimate_co2e_for_kwh(kwh)
+    print(f"1s energy ~{kwh:.6f} kWh -> CO2e {co2:.6f} kg")
+
