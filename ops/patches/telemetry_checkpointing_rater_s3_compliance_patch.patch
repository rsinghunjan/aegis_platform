+"""
+Autoscaler for human-queue rater service.
+ - watches pending tasks in DB and scales k8s deployment replicas accordingly
+ - simple linear policy: desired_replicas = min(max(1, pending/target_per_replica), max_replicas)
+ Uses Kubernetes Python client; operator must run this with appropriate KUBECONFIG.
+"""
+import os, time
+import psycopg2
+from kubernetes import client, config
+
+DB = os.environ.get("DATABASE_URL")
+DEPLOYMENT_NS = os.environ.get("RATER_NS", "safety")
+DEPLOYMENT_NAME = os.environ.get("RATER_DEPLOYMENT", "rater")
+TARGET_PER_REPLICA = int(os.environ.get("TARGET_PER_REPLICA", "20"))
+MAX_REPLICAS = int(os.environ.get("RATER_MAX_REPLICAS", "10"))
+POLL = int(os.environ.get("RATER_AUTOSCALE_POLL_SECS", "30"))
+
+def get_pending_count():
+    conn = psycopg2.connect(DB); cur = conn.cursor()
+    cur.execute("SELECT count(*) FROM human_queue WHERE status IN ('open','claimed')")
+    c = cur.fetchone()[0]
+    cur.close(); conn.close()
+    return int(c)
+
+def set_replicas(n):
+    config.load_kube_config()
+    apps = client.AppsV1Api()
+    body = {"spec": {"replicas": n}}
+    apps.patch_namespaced_deployment_scale(DEPLOYMENT_NAME, DEPLOYMENT_NS, body)
+
+if __name__ == "__main__":
+    while True:
+        try:
+            pending = get_pending_count()
+            desired = max(1, min(MAX_REPLICAS, (pending + TARGET_PER_REPLICA - 1) // TARGET_PER_REPLICA))
+            print("Pending:", pending, "Desired replicas:", desired)
+            set_replicas(desired)
+        except Exception as e:
+            print("autoscale error", e)
+        time.sleep(POLL)
+
