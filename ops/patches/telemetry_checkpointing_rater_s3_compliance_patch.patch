+"""
+S3 lifecycle policy validator and dry-run simulator.
+ - Validates policy JSON for required compliance controls (min retention, object lock enabled for critical prefixes)
+ - Simulates which objects would be expired/transitioned given policy rules (uses object list and policy heuristics)
+ - Reports warnings for destructive rules that may conflict with retention/compliance needs
+"""
+import boto3, json, sys, os, datetime
+from dateutil import parser
+
+s3 = boto3.client("s3")
+
+def validate_policy(policy_json, required_prefixes=None, min_retention_days=90):
+    warnings = []
+    rules = policy_json.get("Rules", [])
+    for r in rules:
+        prefix = r.get("Prefix","")
+        if required_prefixes and prefix in required_prefixes:
+            exp = r.get("Expiration",{})
+            days = exp.get("Days")
+            if days is None or days < min_retention_days:
+                warnings.append(f"Prefix {prefix} has expiration {days} days < required {min_retention_days}")
+    return warnings
+
+def simulate_policy(bucket, policy_json, lookback_days=365):
+    # naive simulation: list objects and apply simple rules
+    out = {"to_transition":[], "to_expire":[]}
+    rules = policy_json.get("Rules", [])
+    paginator = s3.get_paginator("list_objects_v2")
+    for page in paginator.paginate(Bucket=bucket):
+        for obj in page.get("Contents", []):
+            key = obj["Key"]
+            last_modified = obj["LastModified"]
+            age_days = (datetime.datetime.now(last_modified.tzinfo) - last_modified).days
+            for r in rules:
+                prefix = r.get("Prefix","")
+                if not key.startswith(prefix): continue
+                exp = r.get("Expiration",{})
+                if "Days" in exp and age_days >= exp["Days"]:
+                    out["to_expire"].append(key)
+                # transitions
+                for t in r.get("Transitions", []):
+                    if age_days >= t.get("Days", 3650):
+                        out["to_transition"].append({"key":key,"storage":t.get("StorageClass")})
+    return out
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        print("Usage: lifecycle_validator.py <bucket> <policy.json>")
+        sys.exit(2)
+    bucket = sys.argv[1]
+    policy = json.load(open(sys.argv[2]))
+    print("Validating policy...")
+    w = validate_policy(policy, required_prefixes=["checkpoints/"], min_retention_days=30)
+    if w:
+        print("Warnings:", w)
+    print("Simulating policy against bucket (this may be slow)...")
+    sim = simulate_policy(bucket, policy)
+    print("Simulation summary:", {k: len(v) for k,v in sim.items()})
+
