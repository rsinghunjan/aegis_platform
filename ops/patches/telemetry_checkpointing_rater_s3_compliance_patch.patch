+"""
+Daemon that polls GPU telemetry and exports Prometheus metrics and precise per-request energy samples.
+Intended to run on GPU inference / training nodes as a sidecar or daemonset.
+"""
+import time, os, json
+from prometheus_client import Gauge, start_http_server
+from services.sustainability.gpu_telemetry import get_gpu_stats
+from services.sustainability.gpu_telemetry import NVML_OK
+
+GPU_POWER = Gauge("node_gpu_power_watts", "GPU power draw (watts)", ["gpu_index","gpu_uuid"])
+GPU_UTIL = Gauge("node_gpu_util_pct", "GPU utilization percent", ["gpu_index","gpu_uuid"])
+GPU_TEMP = Gauge("node_gpu_temp_c", "GPU temperature C", ["gpu_index","gpu_uuid"])
+GPU_MEM_USED = Gauge("node_gpu_mem_used_mib", "GPU mem used MiB", ["gpu_index","gpu_uuid"])
+
+POLL = int(os.environ.get("TELEMETRY_POLL_SECS", "5"))
+PORT = int(os.environ.get("TELEMETRY_METRICS_PORT", "9400"))
+
+def export_loop():
+    start_http_server(PORT)
+    while True:
+        stats = get_gpu_stats()
+        for s in stats:
+            labels = {"gpu_index": str(s["index"]), "gpu_uuid": s.get("uuid","")}
+            if s.get("power_w") is not None:
+                GPU_POWER.labels(**labels).set(float(s["power_w"]))
+            if s.get("util_gpu") is not None:
+                GPU_UTIL.labels(**labels).set(float(s["util_gpu"]))
+            if s.get("temperature_c") is not None:
+                GPU_TEMP.labels(**labels).set(int(s["temperature_c"]))
+            if s.get("mem_used_mib") is not None:
+                GPU_MEM_USED.labels(**labels).set(int(s["mem_used_mib"]))
+        time.sleep(POLL)
+
+if __name__ == "__main__":
+    print("Starting telemetry exporter; NVML available:", NVML_OK)
+    export_loop()
+
