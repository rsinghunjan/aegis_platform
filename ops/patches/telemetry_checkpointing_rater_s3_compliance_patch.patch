+"""
+Robust S3-backed checkpoint manager for spot training.
+ - save_checkpoint(path, job_id, step) uploads atomic file to s3://<bucket>/checkpoints/<job_id>/<step>.ckpt
+ - write manifest.json with latest pointer and checksums
+ - list_latest_checkpoint(job_id) returns latest step+key
+ - supports acquire/release simple lock via S3 object (simple advisory lock)
+
+Requires AWS credentials or environment with permissions to S3.
+"""
+import os, time, json, hashlib, boto3, botocore
+from typing import Optional, Tuple
+
+S3_BUCKET = os.environ.get("CHECKPOINT_BUCKET", "")
+S3_PREFIX = os.environ.get("CHECKPOINT_PREFIX", "checkpoints")
+LOCK_SUFFIX = ".lock"
+
+s3 = boto3.client("s3")
+
+def _key(job_id, step):
+    return f"{S3_PREFIX}/{job_id}/step_{step}.ckpt"
+
+def _manifest_key(job_id):
+    return f"{S3_PREFIX}/{job_id}/manifest.json"
+
+def compute_sha256(path):
+    import hashlib
+    h = hashlib.sha256()
+    with open(path,"rb") as f:
+        while True:
+            b = f.read(8192)
+            if not b: break
+            h.update(b)
+    return h.hexdigest()
+
+def acquire_lock(job_id, ttl=60) -> bool:
+    key = f"{S3_PREFIX}/{job_id}/.lock"
+    try:
+        s3.put_object(Bucket=S3_BUCKET, Key=key, Body=b"locked", ContentType="text/plain")
+        return True
+    except botocore.exceptions.ClientError:
+        return False
+
+def release_lock(job_id):
+    key = f"{S3_PREFIX}/{job_id}/.lock"
+    try:
+        s3.delete_object(Bucket=S3_BUCKET, Key=key)
+    except Exception:
+        pass
+
+def save_checkpoint(local_path: str, job_id: str, step: int) -> dict:
+    """
+    Upload checkpoint and update manifest atomically.
+    Returns manifest dict.
+    """
+    if not S3_BUCKET:
+        raise RuntimeError("CHECKPOINT_BUCKET not set")
+    key = _key(job_id, step)
+    sha = compute_sha256(local_path)
+    # upload
+    s3.upload_file(local_path, S3_BUCKET, key)
+    manifest = {"latest_step": step, "latest_key": key, "sha256": sha, "ts": int(time.time())}
+    s3.put_object(Bucket=S3_BUCKET, Key=_manifest_key(job_id), Body=json.dumps(manifest).encode("utf-8"), ContentType="application/json")
+    return manifest
+
+def list_latest_checkpoint(job_id: str) -> Optional[dict]:
+    try:
+        r = s3.get_object(Bucket=S3_BUCKET, Key=_manifest_key(job_id))
+        manifest = json.loads(r["Body"].read())
+        return manifest
+    except botocore.exceptions.ClientError:
+        return None
+
+def download_checkpoint(job_id: str, out_dir: str) -> Optional[str]:
+    m = list_latest_checkpoint(job_id)
+    if not m:
+        return None
+    key = m["latest_key"]
+    os.makedirs(out_dir, exist_ok=True)
+    outp = os.path.join(out_dir, os.path.basename(key))
+    s3.download_file(S3_BUCKET, key, outp)
+    # verify sha
+    if "sha256" in m:
+        if compute_sha256(outp) != m["sha256"]:
+            raise RuntimeError("Checksum mismatch on downloaded checkpoint")
+    return outp
+
+if __name__ == "__main__":
+    print("Checkpoint manager demo: ensure CHECKPOINT_BUCKET is set")
+
