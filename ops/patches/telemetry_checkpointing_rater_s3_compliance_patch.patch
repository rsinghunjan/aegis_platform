+"""
+GPU telemetry helpers using NVML (pynvml) with robust fallbacks.
+Provides accurate instantaneous power draw and (when available) total energy counters.
+If NVML isn't available, falls back to nvidia-smi or heuristics.
+
+Usage:
+  from services.sustainability.gpu_telemetry import get_gpu_stats
+  stats = get_gpu_stats()
+  # stats: [{index, uuid, power_w, temperature_c, util_gpu, mem_used_mib, mem_total_mib, energy_uj (optional)}...]
+"""
+import os
+import time
+import subprocess
+import json
+from typing import List, Dict
+
+try:
+    import pynvml
+    NVML_OK = True
+    pynvml.nvmlInit()
+except Exception:
+    NVML_OK = False
+
+def _nvml_stats() -> List[Dict]:
+    out = []
+    device_count = pynvml.nvmlDeviceGetCount()
+    for i in range(device_count):
+        h = pynvml.nvmlDeviceGetHandleByIndex(i)
+        try:
+            util = pynvml.nvmlDeviceGetUtilizationRates(h)
+            mem = pynvml.nvmlDeviceGetMemoryInfo(h)
+            try:
+                power = pynvml.nvmlDeviceGetPowerUsage(h) / 1000.0  # mW -> W
+            except Exception:
+                power = None
+            # energy counter (microjoules) available on some drivers via nvmlDeviceGetTotalEnergyConsumption
+            energy_uj = None
+            try:
+                energy_uj = pynvml.nvmlDeviceGetTotalEnergyConsumption(h)
+            except Exception:
+                energy_uj = None
+            info = {
+                "index": i,
+                "uuid": pynvml.nvmlDeviceGetUUID(h).decode() if isinstance(pynvml.nvmlDeviceGetUUID(h), bytes) else pynvml.nvmlDeviceGetUUID(h),
+                "power_w": float(power) if power is not None else None,
+                "temperature_c": int(pynvml.nvmlDeviceGetTemperature(h, pynvml.NVML_TEMPERATURE_GPU)),
+                "util_gpu": int(util.gpu),
+                "mem_used_mib": int(mem.used / 1024**2),
+                "mem_total_mib": int(mem.total / 1024**2),
+                "energy_uj": int(energy_uj) if energy_uj is not None else None
+            }
+            out.append(info)
+        except Exception:
+            continue
+    return out
+
+def _nvidia_smi_stats() -> List[Dict]:
+    # Parse nvidia-smi CSV, fallback option
+    try:
+        res = subprocess.check_output(["nvidia-smi", "--query-gpu=index,uuid,utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw", "--format=csv,noheader,nounits"], stderr=subprocess.DEVNULL)
+        lines = res.decode().strip().splitlines()
+        out = []
+        for l in lines:
+            parts = [p.strip() for p in l.split(",")]
+            if len(parts) < 7:
+                continue
+            idx, uuid, util, temp, memu, memt, power = parts[:7]
+            out.append({
+                "index": int(idx),
+                "uuid": uuid,
+                "power_w": float(power) if power not in ("", "N/A") else None,
+                "temperature_c": int(temp) if temp not in ("", "N/A") else None,
+                "util_gpu": int(util) if util not in ("", "N/A") else None,
+                "mem_used_mib": int(memu) if memu not in ("", "N/A") else None,
+                "mem_total_mib": int(memt) if memt not in ("", "N/A") else None,
+                "energy_uj": None
+            })
+        return out
+    except Exception:
+        return []
+
+def get_gpu_stats() -> List[Dict]:
+    """
+    Return list of GPU stats; prefer NVML, fallback to nvidia-smi, else return empty list.
+    """
+    if NVML_OK:
+        try:
+            return _nvml_stats()
+        except Exception:
+            pass
+    # fallback
+    try:
+        return _nvidia_smi_stats()
+    except Exception:
+        return []
+
+if __name__ == "__main__":
+    print(json.dumps(get_gpu_stats(), indent=2))
+
