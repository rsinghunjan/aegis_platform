+"""
+Improved ternary QAT trainer:
+ - Replaces Linear modules with TernaryLinearV2
+ - Saves per-channel quant metadata into a prov file
+ - Includes a small eval loop using a tiny validation set to compute a proxy perplexity
+
+Usage:
+  python ops/training/quantization/ternary_qat_v2.py --out ./out/ternary_v2
+"""
+import argparse, json, os
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+from torch.utils.data import DataLoader, Dataset
+from tqdm import tqdm
+from ops.training.quantization.utils_v2 import TernaryLinearV2
+
+class SmallEvalDataset(Dataset):
+    def __init__(self, tokenizer, samples=64, seq_len=64):
+        self.tokenizer = tokenizer
+        self.samples = samples
+        self.seq_len = seq_len
+    def __len__(self): return self.samples
+    def __getitem__(self, idx):
+        import random
+        # For PoC use random text via tokenizer's pad token (replace with real eval data)
+        ids = torch.randint(0, self.tokenizer.vocab_size, (self.seq_len,), dtype=torch.long)
+        return ids
+
+def replace_linears_with_v2(module, learnable_threshold=False):
+    replaced = 0
+    for name, child in list(module.named_children()):
+        if isinstance(child, torch.nn.Linear):
+            setattr(module, name, TernaryLinearV2(child, threshold_init=0.05, learnable_threshold=learnable_threshold))
+            replaced += 1
+        else:
+            replaced += replace_linears_with_v2(child, learnable_threshold)
+    return replaced
+
+def eval_perplexity(model, tokenizer, device):
+    model.eval()
+    ds = SmallEvalDataset(tokenizer)
+    dl = DataLoader(ds, batch_size=4)
+    total_loss = 0.0
+    n = 0
+    with torch.no_grad():
+        for batch in dl:
+            batch = batch.to(device)
+            out = model(input_ids=batch, labels=batch)
+            total_loss += float(out.loss.item()) * batch.size(0)
+            n += batch.size(0)
+    ppl = torch.exp(torch.tensor(total_loss / n)).item()
+    return ppl
+
+def save_checkpoint_with_prov(model, out_dir, prov_meta):
+    os.makedirs(out_dir, exist_ok=True)
+    sd = model.state_dict()
+    torch.save(sd, os.path.join(out_dir, "ternary_v2_model.pt"))
+    quant_meta = {}
+    for n, m in model.named_modules():
+        if hasattr(m, "get_quant_metadata"):
+            quant_meta[n] = m.get_quant_metadata()
+    prov = {"quant_type": "ternary_v2", "quant_metadata": quant_meta}
+    prov.update(prov_meta or {})
+    open(os.path.join(out_dir, "ternary_v2_model.prov.json"), "w").write(json.dumps(prov, indent=2))
+    print("Saved model and provenance to", out_dir)
+
+def train(args):
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    tokenizer = AutoTokenizer.from_pretrained("distilgpt2")
+    model = AutoModelForCausalLM.from_pretrained("distilgpt2").to(device)
+    nrep = replace_linears_with_v2(model, learnable_threshold=args.learnable_threshold)
+    print(f"Replaced {nrep} Linear layers with TernaryLinearV2")
+    # minimal toy training loop
+    ds = SmallEvalDataset(tokenizer, samples=128, seq_len=32)
+    dl = DataLoader(ds, batch_size=8)
+    optim = torch.optim.AdamW(model.parameters(), lr=5e-5)
+    model.train()
+    for epoch in range(args.epochs):
+        for batch in tqdm(dl, desc="train"):
+            batch = batch.to(device)
+            out = model(input_ids=batch, labels=batch)
+            loss = out.loss
+            loss.backward()
+            optim.step()
+            optim.zero_grad()
+    ppl = eval_perplexity(model, tokenizer, device)
+    prov_meta = {"base_model":"distilgpt2","qat_epochs":args.epochs,"ppl":ppl, "commit":"<git-sha>"}
+    save_checkpoint_with_prov(model, args.out_dir, prov_meta)
+    print("Eval perplexity (proxy):", ppl)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--out-dir", default="./out/ternary_v2")
+    p.add_argument("--epochs", type=int, default=1)
+    p.add_argument("--learnable-threshold", dest="learnable_threshold", action="store_true")
+    args = p.parse_args()
+    train(args)
+
