+"""
+Improved ternary quantizer utilities with per-channel scales and STE.
+This implements a per-out-channel ternarization for Linear layers which helps
+maintain accuracy. This is still a PoC: production QAT should use more robust
+per-layer/per-channel strategies, clipping schedules, and learning-rate tuning.
+"""
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+import numpy as np
+
+def ternarize_per_channel(weight, threshold_factor):
+    """
+    weight: Tensor of shape (out_features, in_features)
+    threshold_factor: scalar (float) or Tensor of shape (out_features,)
+    Returns:
+      ternary: same shape as weight, values in {-1,0,1}
+      scales: Tensor of shape (out_features,) per-output-channel scale
+    """
+    # compute per-out-channel scale = mean(abs(w), dim=1)
+    w = weight
+    scales = w.abs().mean(dim=1)  # (out_features,)
+    scales = torch.where(scales == 0, torch.ones_like(scales), scales)
+    t = threshold_factor * scales  # (out_features,)
+    # broadcast threshold for comparison
+    pos = (w > t.unsqueeze(1)).to(w.dtype)
+    neg = (w < -t.unsqueeze(1)).to(w.dtype)
+    tern = pos - neg
+    return tern, scales
+
+class TernaryLinearV2(nn.Module):
+    """
+    Linear replacement that applies per-channel ternary quantization during forward.
+    Stores last ternary and scales for checkpointing.
+    """
+    def __init__(self, linear: nn.Linear, threshold_init=0.05, learnable_threshold=False):
+        super().__init__()
+        # reuse original parameters to keep optimizer state when swapping
+        self.weight = linear.weight
+        self.bias = linear.bias if linear.bias is not None else None
+        # threshold can be a scalar or learnable per-channel parameter
+        if learnable_threshold:
+            self.threshold = nn.Parameter(torch.full((self.weight.size(0),), float(threshold_init)))
+        else:
+            self.register_buffer("threshold", torch.full((1,), float(threshold_init)))
+        self.learnable = learnable_threshold
+        self.last_tern = None
+        self.last_scales = None
+
+    def forward(self, x):
+        if self.learnable:
+            thr = torch.clamp(self.threshold, min=1e-6)
+        else:
+            thr = self.threshold.squeeze(0)
+        tern, scales = ternarize_per_channel(self.weight, thr)
+        # STE reconstruction: scale * tern + (w - w.detach())
+        recon = scales.unsqueeze(1) * tern + (self.weight - self.weight.detach())
+        self.last_tern = tern.detach().cpu().numpy()
+        self.last_scales = scales.detach().cpu().numpy()
+        return F.linear(x, recon, bias=self.bias)
+
+    def get_quant_metadata(self):
+        return {"ternary": self.last_tern.tolist() if self.last_tern is not None else None,
+                "scales": self.last_scales.tolist() if self.last_scales is not None else None,
+                "learnable_threshold": self.learnable}
+
