+#!/usr/bin/env python3
+"""
+Compute a proxy perplexity on a small validation set.
+Used by CI to compare baseline model vs quantized variants.
+"""
+import argparse, json
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+from torch.utils.data import DataLoader, Dataset
+
+class EvalDataset(Dataset):
+    def __init__(self, tokenizer, texts, seq_len=64):
+        self.tokenizer = tokenizer
+        self.texts = texts
+        self.seq_len = seq_len
+    def __len__(self): return len(self.texts)
+    def __getitem__(self, idx):
+        toks = self.tokenizer(self.texts[idx], truncation=True, max_length=self.seq_len, padding='max_length', return_tensors="pt")
+        return toks["input_ids"].squeeze(0)
+
+def compute_perplexity(model_name_or_obj, texts, device="cpu"):
+    if isinstance(model_name_or_obj, str):
+        tokenizer = AutoTokenizer.from_pretrained(model_name_or_obj)
+        model = AutoModelForCausalLM.from_pretrained(model_name_or_obj).to(device)
+    else:
+        model = model_name_or_obj
+        tokenizer = AutoTokenizer.from_pretrained("distilgpt2")
+        model = model.to(device)
+    ds = EvalDataset(tokenizer, texts, seq_len=64)
+    dl = DataLoader(ds, batch_size=4)
+    total_loss = 0.0
+    n = 0
+    model.eval()
+    with torch.no_grad():
+        for batch in dl:
+            batch = batch.to(device)
+            out = model(input_ids=batch, labels=batch)
+            total_loss += float(out.loss.item()) * batch.size(0)
+            n += batch.size(0)
+    import math
+    ppl = math.exp(total_loss / n)
+    return ppl
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--model", default="distilgpt2")
+    p.add_argument("--texts", default="Hello world|The quick brown fox")
+    args = p.parse_args()
+    texts = args.texts.split("|")
+    print("Perplexity:", compute_perplexity(args.model, texts))
+
