+"""
+Updated ternary fallback loader that understands per-channel scales produced by TernaryLinearV2.
+It reconstructs float weights from stored ternary arrays and per-channel scales.
+"""
+import os, json, torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+def load_ternary_v2_model(model_name="distilgpt2", checkpoint_dir="./out/ternary_v2"):
+    tokenizer = AutoTokenizer.from_pretrained(model_name)
+    model = AutoModelForCausalLM.from_pretrained(model_name)
+    state_path = os.path.join(checkpoint_dir, "ternary_v2_model.pt")
+    prov_path = os.path.join(checkpoint_dir, "ternary_v2_model.prov.json")
+    if not os.path.exists(state_path):
+        raise FileNotFoundError("ternary_v2 checkpoint not found")
+    sd = torch.load(state_path, map_location="cpu")
+    prov = json.load(open(prov_path)) if os.path.exists(prov_path) else {}
+    quant_meta = prov.get("quant_metadata", {})
+    # Reconstruct weights where quant metadata exists
+    for mod_name, meta in quant_meta.items():
+        tern = meta.get("ternary")
+        scales = meta.get("scales")
+        if tern is None or scales is None:
+            continue
+        # find state dict keys that correspond to this module
+        for k in list(sd.keys()):
+            if k.startswith(mod_name + ".weight"):
+                # reconstruct: scales is list length out_features
+                import numpy as np
+                tern_arr = np.array(tern)
+                scales_arr = np.array(scales).reshape(-1,1)
+                recon = (scales_arr * tern_arr).astype("float32")
+                sd[k] = torch.from_numpy(recon)
+    model.load_state_dict(sd, strict=False)
+    return model, tokenizer
+
+def generate(prompt="Hi", checkpoint_dir="./out/ternary_v2"):
+    model, tokenizer = load_ternary_v2_model(checkpoint_dir=checkpoint_dir)
+    model.eval()
+    inputs = tokenizer(prompt, return_tensors="pt")
+    with torch.no_grad():
+        out = model.generate(**inputs, max_length=32)
+    return tokenizer.decode(out[0], skip_special_tokens=True)
+
+if __name__ == "__main__":
+    print(generate("Quick test of ternary_v2", checkpoint_dir="./out/ternary_v2"))
+
