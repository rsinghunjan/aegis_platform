+#!/usr/bin/env python3
+"""
+AWQ / GPTQ integration helpers.
+These functions attempt to call AWQ or GPTQ converters if those tools are installed
+in the environment. They are non-blocking: if the tools are not present the functions
+return None and the caller can fall back to other methods (ternary QAT / fallback).
+
+Note: operators should install AWQ/GPTQ toolchains in CI runners where requested.
+"""
+import os
+import subprocess
+import logging
+
+log = logging.getLogger("awq_gptq")
+
+def run_awq_convert(model_name, out_dir):
+    """
+    Attempt to run AWQ conversion tool. Return path to converted model or raise if fails.
+    """
+    out = os.path.abspath(out_dir)
+    cmd = ["python", "-m", "awq.convert", "--model", model_name, "--out", out]
+    log.info("Running AWQ: %s", " ".join(cmd))
+    try:
+        subprocess.check_call(cmd)
+        return out
+    except FileNotFoundError:
+        log.warning("AWQ conversion tool not found in PATH")
+        return None
+    except subprocess.CalledProcessError as e:
+        log.exception("AWQ conversion failed")
+        raise
+
+def run_gptq_convert(model_name, out_dir):
+    """
+    Attempt to run GPTQ conversion tool. Return path to converted model or None.
+    """
+    out = os.path.abspath(out_dir)
+    cmd = ["python", "-m", "gptq.convert", "--model", model_name, "--out", out]
+    log.info("Running GPTQ: %s", " ".join(cmd))
+    try:
+        subprocess.check_call(cmd)
+        return out
+    except FileNotFoundError:
+        log.warning("GPTQ conversion tool not found in PATH")
+        return None
+    except subprocess.CalledProcessError:
+        log.exception("GPTQ conversion failed")
+        raise
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser()
+    p.add_argument("--model", default="distilgpt2")
+    p.add_argument("--out", default="./out/awq_model")
+    args = p.parse_args()
+    print("Trying AWQ...")
+    print(run_awq_convert(args.model, args.out))
+    print("Trying GPTQ...")
+    print(run_gptq_convert(args.model, args.out))
+
