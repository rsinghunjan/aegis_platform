+// Minimal ONNXRuntime custom op implementing TernaryDecompress.
+// This is a simple C++ implementation that accepts:
+//  - input0: int8 tensor containing ternary values {-1,0,1} (or packed int8 representation)
+//  - input1: float scale tensor (per-channel or scalar)
+// and outputs a float tensor = input0 * scale (broadcasting scale).
+//
+// Production: replace this with a performance-optimized kernel: vectorized loops,
+// multi-threading (OpenMP/TBB), AVX/NEON intrinsics or call into provider libraries.
+//
+#include "onnxruntime_cxx_api.h"
+#include <vector>
+#include <iostream>
+
+struct TernaryDecompressKernel {
+  TernaryDecompressKernel(const OrtApi& api, const OrtKernelInfo* info) : api_(api), info_(info) {}
+  void Compute(OrtKernelContext* context) {
+    Ort::KernelContext ctx(context);
+    const OrtValue* in0 = ctx.GetInput(0);
+    const OrtValue* in1 = ctx.GetInput(1);
+    Ort::Value v_in0(const_cast<OrtValue*>(in0));
+    Ort::Value v_in1(const_cast<OrtValue*>(in1));
+
+    auto mt0 = v_in0.GetTensorTypeAndShapeInfo();
+    auto mt1 = v_in1.GetTensorTypeAndShapeInfo();
+    std::vector<int64_t> shape0 = mt0.GetShape();
+    std::vector<int64_t> shape1 = mt1.GetShape();
+
+    size_t total = 1;
+    for (auto d : shape0) total *= (size_t)d;
+
+    // allocate output with same shape as input0, type float
+    Ort::MemoryInfo info = Ort::MemoryInfo::CreateCpu(OrtDeviceAllocator, OrtMemTypeCPU);
+    Ort::Value out = Ort::Value::CreateTensor<float>(info, shape0.data(), shape0.size());
+
+    // Access raw data
+    int8_t* p_in0 = (int8_t*)v_in0.GetTensorMutableData<int8_t>();
+    float* p_out = out.GetTensorMutableData<float>();
+
+    // Determine scale: either scalar or per-channel (assume first dim is channels)
+    bool per_channel = !(shape1.size() == 0 || (shape1.size()==1 && shape1[0]==1));
+    float scalar_scale = 1.0f;
+    std::vector<float> scales;
+    if (per_channel) {
+      size_t c = (size_t)shape1[0];
+      scales.resize(c);
+      float* p_scale = (float*)v_in1.GetTensorMutableData<float>();
+      for (size_t i=0;i<c;i++) scales[i] = p_scale[i];
+    } else {
+      float* p_scale = (float*)v_in1.GetTensorMutableData<float>();
+      scalar_scale = p_scale[0];
+    }
+
+    // Naive decompression: apply per-element
+    // If per-channel scales, try to infer channel stride: assume shape0[0] == channels
+    if (per_channel && shape0.size() >= 2) {
+      int64_t channels = shape0[0];
+      size_t stride = 1;
+      for (size_t i=1;i<shape0.size();i++) stride *= (size_t)shape0[i];
+      for (int64_t ch=0; ch<channels; ++ch) {
+        float s = scales[ch];
+        size_t base = (size_t)ch * stride;
+        for (size_t j=0;j<stride;j++) {
+          int8_t t = p_in0[base + j];
+          p_out[base + j] = ((float)t) * s;
+        }
+      }
+    } else {
+      // scalar scale
+      for (size_t i=0;i<total;i++) {
+        p_out[i] = ((float)p_in0[i]) * scalar_scale;
+      }
+    }
+
+    // set output as first output
+    ctx.SetOutput(0, out);
+  }
+  const OrtApi& api_;
+  const OrtKernelInfo* info_;
+};
+
+struct TernaryDecompressCustomOp : Ort::CustomOpBase<TernaryDecompressCustomOp, TernaryDecompressKernel> {
+  void* CreateKernel(const OrtApi& api, const OrtKernelInfo* info) const { return new TernaryDecompressKernel(api, info); }
+  const char* GetName() const { return "TernaryDecompress"; }
+  size_t GetInputTypeCount() const { return 2; }
+  ONNXTensorElementDataType GetInputType(size_t /*index*/) const { return ONNX_TENSOR_ELEMENT_DATA_TYPE_INT8; } // second input will be cast
+  size_t GetOutputTypeCount() const { return 1; }
+  ONNXTensorElementDataType GetOutputType(size_t /*index*/) const { return ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT; }
+};
+
+extern "C" {
+  ORT_API_STATUS(OrtRegisterCustomOps)(OrtSessionOptions* options, const OrtApiBase* api) {
+    const OrtApi* ort_api = api->GetApi(ORT_API_VERSION);
+    Ort::CustomOpDomain custom_domain("");
+    static TernaryDecompressCustomOp c_op;
+    custom_domain.Add(&c_op);
+    Ort::ThrowOnError(ort_api->CreateCustomOpDomain(custom_domain.GetName(), &custom_domain));
+    // Note: proper registration requires hooking custom ops domain onto the session options.
+    // This is a simplified example and may need adaptation for ONNXRuntime versions.
+    std::cout << "TernaryDecompress custom op library loaded\n";
+    return nullptr;
+  }
+}
+
