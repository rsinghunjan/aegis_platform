*** Add File:ops/triton/model_repository/ternary_model/1/model.py
+# Triton Python backend model that loads a ternary checkpoint (prov metadata with per-channel scales)
+# and reconstructs weights to FP16 on model init for fast inference using PyTorch.
+#
+# This is a pragmatic "near-native" approach: decompress once at model init on GPU memory,
+# avoiding per-inference decompression overhead. It trades increased model load time for faster inference.
+#
+import os, json
+import torch
+from transformers import AutoTokenizer, AutoModelForCausalLM
+from triton_python_backend_utils import pb_utils
+
+MODEL_NAME = os.environ.get("MODEL_BASE", "distilgpt2")
+CHECKPOINT_DIR = os.environ.get("CHECKPOINT_DIR", "/models/ternary")
+
+class TritonPythonModel:
+    def initialize(self, args):
+        print("Initializing ternary model for Triton Python backend")
+        self.tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
+        # Load base model weights and overlay ternary checkpoint if found
+        self.model = AutoModelForCausalLM.from_pretrained(MODEL_NAME).half().cuda()
+        prov_path = os.path.join(CHECKPOINT_DIR, "ternary_v2_model.prov.json")
+        state_path = os.path.join(CHECKPOINT_DIR, "ternary_v2_model.pt")
+        if os.path.exists(state_path) and os.path.exists(prov_path):
+            print("Loading ternary checkpoint and reconstructing weights")
+            sd = torch.load(state_path, map_location="cpu")
+            prov = json.load(open(prov_path))
+            quant_meta = prov.get("quant_metadata", {})
+            for mod_name, meta in quant_meta.items():
+                tern = meta.get("ternary")
+                scales = meta.get("scales")
+                if tern is None or scales is None:
+                    continue
+                # apply reconstruction into model's state dict (best effort mapping)
+                # Note: this assumes the module names in prov match state dict prefixes.
+                import numpy as np
+                tern_arr = np.array(tern)
+                scales_arr = np.array(scales).reshape(-1,1)
+                recon = (scales_arr * tern_arr).astype("float32")
+                # find matching key
+                for k in list(self.model.state_dict().keys()):
+                    if k.startswith(mod_name) and k.endswith("weight"):
+                        w = torch.from_numpy(recon).to(dtype=torch.float16).cuda()
+                        self.model.state_dict()[k].copy_(w)
+                        print(f"Patched {k}")
+        self.model.eval()
+
+    def execute(self, requests):
+        responses = []
+        for request in requests:
+            input0 = pb_utils.get_input_tensor_by_name(request, "INPUT_IDS")
+            ids = input0.as_numpy().tolist()
+            # simple: decode first id list to text and generate
+            prompt = " ".join([str(x) for x in ids[0]])
+            tokens = self.tokenizer(prompt, return_tensors="pt").to("cuda")
+            with torch.no_grad():
+                out = self.model.generate(**tokens, max_length=32)
+            text = self.tokenizer.decode(out[0], skip_special_tokens=True)
+            out_tensor = pb_utils.Tensor("OUTPUT_TEXT", [text])
+            responses.append(pb_utils.InferenceResponse(output_tensors=[out_tensor]))
+        return responses
+
