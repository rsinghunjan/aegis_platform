+"""
+ONNXRuntime custom op stub (python) - placeholder to illustrate how a custom op might be authored.
+Production: implement as C++ custom op for performance, with proper operator registration.
+"""
+import numpy as np
+
+def ternary_decompress(ternary_array, scale):
+    """
+    Expand ternary values (-1,0,1) with a scalar to float array.
+    ternary_array: numpy array with values -1,0,1
+    scale: float
+    """
+    return (ternary_array.astype(np.float32)) * float(scale)
+
+def run_stub(ternary_weights, scales, input_vec):
+    # decompress weights for GEMM
+    W = ternary_decompress(ternary_weights, scales)
+    return input_vec.dot(W.T)
+
