+"""
+Ternary fallback inference:
+ - Loads a 'ternary_model.pt' state dict where Linear layers were trained via TernaryLinear
+ - Reconstructs float weights from stored ternary + scale metadata (if present), or falls back to stored weight params
+ - Runs inference with standard PyTorch kernels (no custom ternary kernels required)
+
+This gives immediate storage savings (if you store ternary arrays separately) and a quick deploy path
+while custom kernels are being developed.
+"""
+import torch, os, json
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+def load_ternary_model(model_class_name="distilgpt2", checkpoint_dir="./out/ternary"):
+    tokenizer = AutoTokenizer.from_pretrained(model_class_name)
+    model = AutoModelForCausalLM.from_pretrained(model_class_name)
+    # load state dict if present
+    state_path = os.path.join(checkpoint_dir, "ternary_model.pt")
+    prov_path = os.path.join(checkpoint_dir, "ternary_model.prov.json")
+    if os.path.exists(state_path):
+        sd = torch.load(state_path, map_location="cpu")
+        # attempt to read quant metadata
+        quant_meta = {}
+        if os.path.exists(prov_path):
+            prov = json.load(open(prov_path))
+            quant_meta = prov.get("quant_metadata", {})
+        # reconstruct parameters: if quant_meta contains module path, set weight to scale*tern
+        for name, param in list(sd.items()):
+            # param names like "transformer.h.0.attn.c_attn.weight" - we look for matching quant key
+            mod_name = name.rsplit(".", 1)[0]  # approximate module path
+            qmeta = quant_meta.get(mod_name)
+            if qmeta and qmeta.get("ternary") is not None:
+                tern = torch.tensor(qmeta["ternary"], dtype=param.dtype)
+                scale = float(qmeta.get("scale", 1.0))
+                new_w = scale * tern
+                sd[name] = new_w
+        model.load_state_dict(sd, strict=False)
+    else:
+        raise FileNotFoundError("ternary checkpoint not found")
+    return model, tokenizer
+
+def generate_sample(prompt="Hello world", checkpoint_dir="./out/ternary", max_length=32):
+    model, tokenizer = load_ternary_model(checkpoint_dir=checkpoint_dir)
+    model.eval()
+    inputs = tokenizer(prompt, return_tensors="pt")
+    with torch.no_grad():
+        out = model.generate(**inputs, max_length=max_length)
+    text = tokenizer.decode(out[0], skip_special_tokens=True)
+    return text
+
+if __name__=="__main__":
+    print(generate_sample("Testing ternary model", checkpoint_dir="./out/ternary"))
+
