+"""
+Ternary quantization utilities (QAT helpers).
+Contains a minimal ternarize function and a TernaryLinear wrapper that implements
+straight-through estimator behaviour for PoC QAT.
+
+This is intentionally small: for production QAT you'll want more sophisticated
+clipping, per-channel thresholds, and careful optimizer scheduling.
+"""
+import torch
+import torch.nn as nn
+
+def ternarize_tensor(x, threshold):
+    """
+    Map tensor x to ternary values {-1,0,1} using threshold.
+    Returns ternary tensor (same dtype) and a positive scale (scalar).
+    """
+    # scale estimate (mean absolute)
+    s = x.abs().mean().detach()
+    if s == 0:
+        s = torch.tensor(1.0, device=x.device, dtype=x.dtype)
+    t = threshold * s
+    pos = (x > t).to(x.dtype)
+    neg = (x < -t).to(x.dtype)
+    tern = pos - neg
+    return tern, s
+
+class TernaryLinear(nn.Module):
+    """
+    Replace nn.Linear with ternary weights during forward. Stores last computed
+    ternary representation and scale for checkpointing.
+    """
+    def __init__(self, linear: nn.Linear, threshold_init=0.05):
+        super().__init__()
+        # keep original linear as source of parameters and bias
+        self.in_features = linear.in_features
+        self.out_features = linear.out_features
+        self.bias_flag = linear.bias is not None
+        # Copy weight and bias parameters
+        self.weight = linear.weight
+        if self.bias_flag:
+            self.bias = linear.bias
+        else:
+            self.register_parameter("bias", None)
+        # threshold is a small positive scalar (learnable)
+        self.threshold = nn.Parameter(torch.tensor(float(threshold_init)))
+        # placeholders to store last ternary & scale
+        self.last_tern = None
+        self.last_scale = None
+
+    def forward(self, x):
+        # compute ternary and scale from current weight
+        tern, scale = ternarize_tensor(self.weight, threshold=self.threshold.abs())
+        # straight-through estimator: use tern*scale as forward, but pass grad to weight
+        recon = scale * tern + (self.weight - self.weight.detach())
+        # save for checkpointing
+        self.last_tern = tern.detach().cpu().numpy()
+        self.last_scale = float(scale.detach().cpu().item())
+        return nn.functional.linear(x, recon, bias=self.bias)
+
+    def get_quant_metadata(self):
+        return {"ternary": self.last_tern.tolist() if self.last_tern is not None else None,
+                "scale": self.last_scale}
+
