+"""
+Ternary QAT trainer (PoC).
+- loads a small pretrained model (distilgpt2 / gpt2-small)
+- replaces nn.Linear layers with TernaryLinear wrappers
+- fine-tunes for a few steps and saves a ternary checkpoint with quant metadata
+
+Usage:
+  python ops/training/quantization/ternary_qat.py --out ./out
+"""
+import argparse, json, os
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+from torch.utils.data import DataLoader, Dataset
+from tqdm import tqdm
+from ops.training.quantization.utils import TernaryLinear
+
+class DummyTextDataset(Dataset):
+    def __init__(self, tokenizer, size=256, seq_len=64):
+        self.size = size
+        self.seq_len = seq_len
+        self.tokenizer = tokenizer
+    def __len__(self): return self.size
+    def __getitem__(self, idx):
+        # random tokens for PoC; replace with real dataset/loader
+        ids = torch.randint(0, self.tokenizer.vocab_size, (self.seq_len,), dtype=torch.long)
+        return ids
+
+def replace_linears(module):
+    """
+    Recursively replace nn.Linear modules with TernaryLinear wrappers in-place.
+    Returns count of replaced modules.
+    """
+    replaced = 0
+    for name, child in module.named_children():
+        if isinstance(child, torch.nn.Linear):
+            setattr(module, name, TernaryLinear(child))
+            replaced += 1
+        else:
+            replaced += replace_linears(child)
+    return replaced
+
+def save_ternary_checkpoint(model, out_dir, prov_meta):
+    os.makedirs(out_dir, exist_ok=True)
+    # collect per-layer metadata
+    quant_meta = {}
+    for n, m in model.named_modules():
+        if hasattr(m, "get_quant_metadata"):
+            quant_meta[n] = m.get_quant_metadata()
+    # save model state dict
+    torch.save(model.state_dict(), os.path.join(out_dir, "ternary_model.pt"))
+    # save quant metadata + provenance
+    prov = {"quant_type":"ternary", "quant_metadata": quant_meta}
+    prov.update(prov_meta or {})
+    open(os.path.join(out_dir, "ternary_model.prov.json"), "w").write(json.dumps(prov, indent=2))
+    print("Saved ternary checkpoint and provenance to", out_dir)
+
+def train(args):
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    tokenizer = AutoTokenizer.from_pretrained("distilgpt2")
+    model = AutoModelForCausalLM.from_pretrained("distilgpt2").to(device)
+    # replace linears
+    nrep = replace_linears(model)
+    print(f"Replaced {nrep} Linear layers with TernaryLinear")
+    ds = DummyTextDataset(tokenizer, size=200, seq_len=32)
+    dl = DataLoader(ds, batch_size=8)
+    optim = torch.optim.AdamW(model.parameters(), lr=1e-4)
+    model.train()
+    for epoch in range(1):
+        for batch in tqdm(dl, desc="train"):
+            batch = batch.to(device)
+            outputs = model(input_ids=batch, labels=batch)
+            loss = outputs.loss
+            loss.backward()
+            optim.step()
+            optim.zero_grad()
+    # save
+    prov_meta = {"base_model":"distilgpt2", "qat_steps": len(dl), "commit":"<git-sha>"}
+    save_ternary_checkpoint(model, args.out_dir, prov_meta)
+
+if __name__=="__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--out-dir", default="./out/ternary")
+    args = p.parse_args()
+    train(args)
+
