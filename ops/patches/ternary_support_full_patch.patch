+    print("AWQ cmd:", cmd)
+    # subprocess.run(cmd, shell=True, check=True)
+    return "./out/awq_model"
+
+def run_gptq(model):
+    cmd = f"python -m gptq.convert --model {model} --out ./out/gptq_model"
+    print("GPTQ cmd:", cmd)
+    # subprocess.run(cmd, shell=True, check=True)
+    return "./out/gptq_model"
+
+def run_ternary_qat():
