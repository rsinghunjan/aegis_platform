+#!/usr/bin/env python3
+"""
+Validation gate used by CI and Argo/Tekton workflows:
+ - Runs validation battery and computes pass/fail using thresholds from calibration ConfigMap
+ - Emits JSON {pass: true|false, metrics: {...}} for workflow consumption
+"""
+import os, json, subprocess, sys
+from kubernetes import client, config
+
+CALIB_CM = os.environ.get("VERIFIER_CALIB_CM", "verifier-calib")
+CALIB_NS = os.environ.get("CALIB_NS", "safety")
+
+def load_threshold():
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    v1 = client.CoreV1Api()
+    try:
+        cm = v1.read_namespaced_config_map(CALIB_CM, CALIB_NS)
+        thresholds = json.loads(cm.data.get("thresholds.json","{}"))
+        return thresholds
+    except Exception:
+        return {"threshold": 0.5}
+
+def run_validation(candidate_dir):
+    # run existing validation battery; assume it writes metrics to candidate_dir/validation_metrics.json
+    cmd = ["python","services/ci/validation_battery.py", candidate_dir]
+    try:
+        subprocess.check_call(cmd, timeout=30*60)
+    except subprocess.CalledProcessError:
+        return {"pass": False, "reason": "validation_failed"}
+    metrics_path = os.path.join(candidate_dir, "validation_metrics.json")
+    metrics = {}
+    if os.path.exists(metrics_path):
+        metrics = json.load(open(metrics_path))
+    else:
+        # fallback metric
+        metrics = {"verifier_f1": 0.0}
+    return {"pass": True, "metrics": metrics}
+
+def main():
+    candidate_dir = sys.argv[1]
+    thresholds = load_threshold()
+    res = run_validation(candidate_dir)
+    metrics = res.get("metrics",{})
+    f1 = metrics.get("verifier_f1", 0.0)
+    pass_gate = f1 >= float(thresholds.get("f1_threshold", thresholds.get("f1", 0.5)))
+    out = {"pass": bool(pass_gate), "f1": f1, "thresholds": thresholds}
+    print(json.dumps(out))
+    if not pass_gate:
+        sys.exit(2)
+
+if __name__=="__main__":
+    main(sys.argv[1])
+
