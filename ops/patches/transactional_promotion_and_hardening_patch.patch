+#!/usr/bin/env python3
+"""
+Promotion controller (improved transactional semantics)
+ - Watches ModelPromotion CR (ops/argo/promotion_transaction_crd.yaml must be installed)
+ - Downloads artifact (supports gs:// or local), verifies cosign signature (KMS), then:
+   * backs up current deployment image
+   * applies canary deployment and runs smoke checks
+   * if smoke checks pass, patches production deployment; else restores backup
+ - Updates CR status for audit and idempotency.
+"""
+import os
+import time
+import json
+import subprocess
+from urllib.parse import urlparse
+from kubernetes import client, config, watch
+
+NAMESPACE = os.environ.get("NAMESPACE", "safety")
+COSIGN_KEY = os.environ.get("COSIGN_VERIFIER_KEY", "/secrets/cosign_pub.pem")
+SMOKE_TEST_CMD = os.environ.get("SMOKE_TEST_CMD", "python services/ci/smoke_tests.py")
+
+def download_artifact(uri, out):
+    if uri.startswith("gs://"):
+        subprocess.check_call(["gsutil", "cp", uri, out])
+    elif uri.startswith("s3://"):
+        subprocess.check_call(["aws","s3","cp",uri,out])
+    else:
+        # assume local path
+        subprocess.check_call(["cp", uri, out])
+
+def verify(artifact):
+    try:
+        subprocess.check_call(["cosign","verify","--key",COSIGN_KEY,artifact])
+        return True
+    except Exception:
+        return False
+
+def get_current_image(deploy="verifier"):
+    p = subprocess.check_output(["kubectl","-n",NAMESPACE,"get","deployment",deploy,"-o","json"])
+    j = json.loads(p)
+    return j["spec"]["template"]["spec"]["containers"][0]["image"]
+
+def set_image(deploy, image):
+    subprocess.check_call(["kubectl","-n",NAMESPACE,"set","image","deployment/"+deploy, f"{deploy}="+image, "--record"])
+    subprocess.check_call(["kubectl","-n",NAMESPACE,"rollout","status","deployment/"+deploy,"--timeout=120s"])
+
+def main():
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+    api = client.CustomObjectsApi()
+    w = watch.Watch()
+    for ev in w.stream(api.list_namespaced_custom_object, group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", timeout_seconds=0):
+        obj = ev["object"]
+        typ = ev["type"]
+        name = obj["metadata"]["name"]
+        spec = obj.get("spec", {})
+        if typ != "ADDED":
+            continue
+        if obj.get("status", {}).get("state") == "promoted":
+            continue
+        artifact = spec.get("artifact", {})
+        art_uri = artifact.get("path")
+        if not art_uri:
+            api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", name=name, body={"status":{"state":"error","error":"no_artifact"}})
+            continue
+        tmp = "/tmp/artifact.tar.gz"
+        try:
+            download_artifact(art_uri, tmp)
+            # verify signature
+            if not verify(tmp):
+                api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", name=name, body={"status":{"state":"verification_failed"}})
+                continue
+            # backup current prod image
+            old_image = get_current_image("verifier")
+            # create backup configmap
+            subprocess.check_call(["kubectl","-n",NAMESPACE,"create","configmap","promotion-backup","--from-literal=current_image="+old_image,"--dry-run=client","-o","yaml"], stdout=subprocess.PIPE)
+            subprocess.check_call(["kubectl","-n",NAMESPACE,"apply","-f","-"], input=subprocess.check_output(["kubectl","-n",NAMESPACE,"create","configmap","promotion-backup","--from-literal=current_image="+old_image,"--dry-run=client","-o","yaml"]))
+            # extract image name from artifact meta if present
+            # (operator should embed image into artifact metadata or use container registry)
+            image = artifact.get("image")
+            if not image:
+                raise RuntimeError("artifact missing image metadata")
+            # deploy canary
+            set_image("verifier-canary", image)
+            # run smoke tests
+            rc = subprocess.call(SMOKE_TEST_CMD, shell=True)
+            if rc != 0:
+                # rollback canary -> restore prod image
+                set_image("verifier", old_image)
+                api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", name=name, body={"status":{"state":"canary_failed"}})
+                continue
+            # promote to prod
+            set_image("verifier", image)
+            api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", name=name, body={"status":{"state":"promoted","promotedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ")}})
+        except Exception as e:
+            # restore backup if possible
+            try:
+                set_image("verifier", old_image)
+            except Exception:
+                pass
+            api.patch_namespaced_custom_object_status(group="aegis.example.com", version="v1", namespace=NAMESPACE, plural="modelpromotions", name=name, body={"status":{"state":"error","error": str(e)}})
+
+if __name__=="__main__":
+    main()
+
