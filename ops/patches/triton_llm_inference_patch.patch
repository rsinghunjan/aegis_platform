+#!/usr/bin/env python3
+"""
+Validate Triton ONNX model inference via HTTP API (simple next-token request).
+
+Requires: pip install requests numpy
+"""
+import requests, json
+import numpy as np
+
+TRITON_HOST = "http://triton-server.inference.svc.cluster.local:8000"
+MODEL = "gpt2"
+
+def infer_sample(prompt_tokens):
+    # Triton HTTP v2 infer payload expects inputs with name, shape, datatype and data
+    url = f"{TRITON_HOST}/v2/models/{MODEL}/infer"
+    inputs = [{
+        "name": "input_ids",
+        "shape": [1, len(prompt_tokens)],
+        "datatype": "INT32",
+        "data": prompt_tokens
+    }]
+    payload = {"inputs": inputs}
+    r = requests.post(url, json=payload, timeout=15)
+    r.raise_for_status()
+    return r.json()
+
+if __name__ == "__main__":
+    # sample: token ids for "Hello world" - replace with tokenizer output in your test infra
+    sample_ids = [15496, 995]  # WARNING: only works if vocab matches; adapt to your tokenizer
+    print("Sending sample infer request...")
+    print(infer_sample(sample_ids))
+
