+#!/usr/bin/env python3
+"""
+Export a Hugging Face causal LM (e.g. gpt2/distilgpt2) to ONNX suitable for Triton.
+
+Usage:
+  python ops/onnx/export_hf_to_onnx.py --model gpt2 --out-dir out/model_repo/gpt2/1
+
+Notes:
+ - This is a simple export scaffold. For large models use the HF transformers.onnx CLI or accelerate export.
+ - Ensure the target environment has torch and transformers installed.
+"""
+import argparse
+import os
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+def export(model_name: str, out_dir: str, opset: int = 13):
+    os.makedirs(out_dir, exist_ok=True)
+    tokenizer = AutoTokenizer.from_pretrained(model_name, use_fast=True)
+    model = AutoModelForCausalLM.from_pretrained(model_name).eval()
+    # Create a sample input (batch size 1, seq len 8)
+    sample = tokenizer("Hello world", return_tensors="pt")
+    input_ids = sample["input_ids"]
+    attention_mask = sample.get("attention_mask", None)
+
+    # ONNX export path
+    onnx_path = os.path.join(out_dir, "model.onnx")
+    # We export using torch.onnx; adjust inputs/outputs as required for Triton model config.
+    inputs = (input_ids, )
+    input_names = ["input_ids"]
+    dynamic_axes = {"input_ids": {0: "batch_size", 1: "sequence"}}
+    if attention_mask is not None:
+        inputs = (input_ids, attention_mask)
+        input_names = ["input_ids", "attention_mask"]
+        dynamic_axes["attention_mask"] = {0: "batch_size", 1: "sequence"}
+
+    # Example output name - many HF models return logits as 'logits'
+    output_names = ["logits"]
+    with torch.no_grad():
+        torch.onnx.export(
+            model,
+            inputs,
+            onnx_path,
+            input_names=input_names,
+            output_names=output_names,
+            dynamic_axes=dynamic_axes,
+            opset_version=opset,
+            do_constant_folding=True,
+        )
+    print("Wrote ONNX model to", onnx_path)
+    # write tokenizer files into out_dir for convenience (Triton model repo consumers)
+    tokenizer.save_pretrained(out_dir)
+    print("Saved tokenizer files to", out_dir)
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--model", default="gpt2")
+    p.add_argument("--out-dir", default="out/model_repo/gpt2/1")
+    p.add_argument("--opset", type=int, default=13)
+    args = p.parse_args()
+    export(args.model, args.out_dir, args.opset)
+
