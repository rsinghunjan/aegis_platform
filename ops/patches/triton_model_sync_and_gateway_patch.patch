+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: oauth2-proxy-cfg
+  namespace: inference
+data:
+  oauth2_proxy.cfg: |
+    provider = "oidc"
+    oidc_issuer_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0"
+    client_id = "<CLIENT_ID>"
+    client_secret = "<CLIENT_SECRET_ENV>" # mounted from secret
+    redirect_url = "https://<INGRESS_HOST>/oauth2/callback"
+    cookie_secret = "<COOKIE_SECRET>"     # mounted from secret
+    cookie_secure = true
+    cookie_samesite = "lax"
+
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: oauth2-proxy
+  namespace: inference
+spec:
+  replicas: 2
+  selector:
+    matchLabels:
+      app: oauth2-proxy
+  template:
+    metadata:
+      labels:
+        app: oauth2-proxy
+    spec:
+      containers:
+      - name: oauth2-proxy
+        image: quay.io/oauth2-proxy/oauth2-proxy:v7.4.0
+        args:
+          - --provider=oidc
+          - --oidc-issuer-url=https://login.microsoftonline.com/<TENANT_ID>/v2.0
+          - --client-id=$(CLIENT_ID)
+          - --client-secret=$(CLIENT_SECRET)
+          - --cookie-secret=$(COOKIE_SECRET)
+          - --redirect-url=https://<INGRESS_HOST>/oauth2/callback
+          - --email-domain=*
+          - --cookie-secure=true
+        env:
+          - name: CLIENT_ID
+            valueFrom:
+              secretKeyRef:
+                name: oauth2-proxy-secret
+                key: client_id
+          - name: CLIENT_SECRET
+            valueFrom:
+              secretKeyRef:
+                name: oauth2-proxy-secret
+                key: client_secret
+          - name: COOKIE_SECRET
+            valueFrom:
+              secretKeyRef:
+                name: oauth2-proxy-secret
+                key: cookie_secret
+        ports:
+          - containerPort: 4180
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: oauth2-proxy
+  namespace: inference
+spec:
+  selector:
+    app: oauth2-proxy
+  ports:
+    - port: 4180
+      targetPort: 4180
