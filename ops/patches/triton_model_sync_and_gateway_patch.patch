+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Create Kubernetes secret for oauth2-proxy / OIDC client and TLS for inference gateway ingress.
+#
+# Usage:
+#  ./ops/k8s/create_oidc_secret.sh <namespace> <client_id> <client_secret> <cookie_secret_b64> <tls_secret_name> <tls_cert_file> <tls_key_file>
+
+NS=${1:-inference}
+CLIENT_ID=${2:-}
+CLIENT_SECRET=${3:-}
+COOKIE_SECRET_B64=${4:-} # base64 encoded 16,24,32 byte secret required by oauth2-proxy
+TLS_SECRET_NAME=${5:-ingress-tls}
+TLS_CERT_FILE=${6:-}
+TLS_KEY_FILE=${7:-}
+
+if [ -z "$CLIENT_ID" ] || [ -z "$CLIENT_SECRET" ] || [ -z "$COOKIE_SECRET_B64" ]; then
+  echo "Usage: $0 <namespace> <client_id> <client_secret> <cookie_secret_b64> <tls_secret_name> <tls_cert_file> <tls_key_file>"
+  exit 2
+fi
+
+kubectl create namespace "$NS" --dry-run=client -o yaml | kubectl apply -f -
+
+kubectl -n "$NS" create secret generic oauth2-proxy-secret \
+  --from-literal=client_id="$CLIENT_ID" \
+  --from-literal=client_secret="$CLIENT_SECRET" \
+  --from-literal=cookie_secret="$COOKIE_SECRET_B64" \
+  --dry-run=client -o yaml | kubectl apply -f -
+
+if [ -n "$TLS_CERT_FILE" ] && [ -n "$TLS_KEY_FILE" ]; then
+  kubectl -n "$NS" create secret tls "$TLS_SECRET_NAME" --cert="$TLS_CERT_FILE" --key="$TLS_KEY_FILE" --dry-run=client -o yaml | kubectl apply -f -
+  echo "Created TLS secret $TLS_SECRET_NAME in namespace $NS"
+fi
+
+echo "Created oauth2-proxy secret in namespace $NS"
+
