+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Copy a local model repository folder (e.g. out/model_repo/gpt2/1) into a Triton PVC by creating
+# a temporary pod that mounts the PVC and using kubectl cp.
+#
+# Usage:
+#   ./ops/triton/copy_model_to_pvc.sh <local_model_dir> <pvc_name> <namespace> <target_model_dir_on_pvc>
+#
+# Example:
+#   ./ops/triton/copy_model_to_pvc.sh out/model_repo/gpt2/1 triton-model-repo-pvc inference /models/gpt2/1
+
+LOCAL_DIR=${1:-}
+PVC_NAME=${2:-triton-model-repo-pvc}
+NAMESPACE=${3:-inference}
+TARGET_DIR=${4:-/models/gpt2/1}
+POD_NAME="model-sync-$(date +%s)"
+
+if [ -z "$LOCAL_DIR" ]; then
+  echo "Usage: $0 <local_model_dir> <pvc_name> <namespace> <target_model_dir_on_pvc>"
+  exit 2
+fi
+
+if [ ! -d "$LOCAL_DIR" ]; then
+  echo "Local model dir $LOCAL_DIR does not exist"
+  exit 2
+fi
+
+cat <<EOF | kubectl -n "$NAMESPACE" apply -f -
+apiVersion: v1
+kind: Pod
+metadata:
+  name: $POD_NAME
+spec:
+  restartPolicy: Never
+  containers:
+  - name: copier
+    image: alpine:3.18
+    command: ["/bin/sh","-c","sleep 3600"]
+    volumeMounts:
+    - name: model-repo
+      mountPath: /models
+  volumes:
+  - name: model-repo
+    persistentVolumeClaim:
+      claimName: $PVC_NAME
+EOF
+
+echo "Waiting for pod $POD_NAME to be ready..."
+kubectl -n "$NAMESPACE" wait --for=condition=Ready pod/$POD_NAME --timeout=120s
+
+echo "Creating target directory on PVC: $TARGET_DIR"
+kubectl -n "$NAMESPACE" exec "$POD_NAME" -- mkdir -p "$TARGET_DIR"
+
+echo "Copying local dir $LOCAL_DIR -> $POD_NAME:$TARGET_DIR"
# kubectl cp requires the destination to be a directory path under the pod
+kubectl -n "$NAMESPACE" cp "$LOCAL_DIR" "$POD_NAME":"$TARGET_DIR"
+
+echo "Removing temporary pod..."
+kubectl -n "$NAMESPACE" delete pod "$POD_NAME" --wait=true
+
+echo "Copy complete. Model should be available under PVC at $TARGET_DIR"
+
