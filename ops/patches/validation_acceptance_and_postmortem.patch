+#!/usr/bin/env python3
+"""
+Audit verifier:
+ - Verifies cosign signatures for audit reports and evidence bundles where signature files exist
+ - Produces a verification summary uploaded to the evidence bucket
+Requires: cosign installed and public key available at /secrets/cosign.pub (or use keyless verification)
+"""
+import os, json, logging, subprocess, tempfile
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("audit-verifier")
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+COSIGN_PUB = os.environ.get("COSIGN_PUB", "/secrets/cosign.pub")
+
+def download_latest(prefix, local_dir="/tmp"):
+    import boto3
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    resp=s3.list_objects_v2(Bucket=bucket, Prefix=prefix)
+    items=resp.get("Contents",[])
+    if not items:
+        return None
+    items.sort(key=lambda x: x["LastModified"], reverse=True)
+    key=items[0]["Key"]
+    local=os.path.join(local_dir, os.path.basename(key))
+    s3.download_file(bucket, key, local)
+    return local, key
+
+def verify_file(local_path):
+    sig = local_path + ".sig"
+    if not os.path.exists(sig):
+        logger.warning("No signature file for %s", local_path)
+        return {"file": local_path, "verified": False, "reason": "no sig"}
+    try:
+        subprocess.check_call(["cosign","verify-blob","-key", COSIGN_PUB, "-signature", sig, local_path])
+        return {"file": local_path, "verified": True}
+    except Exception:
+        return {"file": local_path, "verified": False}
+
+def main():
+    report={"ts": datetime.utcnow().isoformat(), "results":[]}
+    if not EVIDENCE_BUCKET:
+        print("EVIDENCE_BUCKET required")
+        return
+    for prefix in ["audits/", "bundles/", "final_reports/"]:
+        dl = download_latest(prefix)
+        if dl:
+            local, key = dl
+            res=verify_file(local)
+            res["s3_key"]=key
+            report["results"].append(res)
+    out="/tmp/audit_verify_"+str(int(time.time()))+".json"
+    open(out,"w").write(json.dumps(report, indent=2))
+    # upload
+    import boto3
+    s3=boto3.client("s3")
+    bucket=EVIDENCE_BUCKET.replace("s3://","")
+    key=f"audits/verify-{int(time.time())}.json"
+    s3.upload_file(out, bucket, key)
+    print(json.dumps(report, indent=2))
+
+if __name__ == "__main__":
+    main()
+
