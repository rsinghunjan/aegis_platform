+#!/usr/bin/env python3
+"""
+Acceptance checker for full validation run:
+ - Aggregates outputs from checkpoint_validator, otel_coverage_checker, opa_harness_coverage,
+   remediation_metrics, multi-tenant stress, invoice simulator results.
+ - Applies configurable thresholds and emits a pass/fail result and summary JSON uploaded to evidence bucket.
+
+Usage:
+  EVIDENCE_BUCKET=s3://... python3 ops/validation/acceptance_checker.py --evidence s3://... --out /tmp/acceptance.json
+"""
+import os, json, argparse, logging, boto3
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("acceptance-checker")
+
+DEFAULTS = {
+    "checkpoint_success_threshold": 0.90,
+    "otel_coverage_threshold": 0.90,
+    "remediation_success_threshold": 0.90,
+    "opa_mismatch_rate_threshold": 0.01,   # <1% mismatches
+    "stress_reject_rate_threshold": 0.20    # allowed rejection rate under stress (tune)
+}
+
+def load_json_s3(evidence_bucket, key):
+    s3 = boto3.client("s3")
+    bucket = evidence_bucket.replace("s3://","")
+    try:
+        obj = s3.get_object(Bucket=bucket, Key=key)
+        return json.loads(obj["Body"].read().decode())
+    except Exception as e:
+        logger.warning("Failed loading s3://%s/%s: %s", bucket, key, e)
+        return None
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--evidence", required=True, help="s3://bucket prefix")
+    p.add_argument("--out", default="/tmp/acceptance.json")
+    args = p.parse_args()
+    EB = args.evidence
+    thresholds = DEFAULTS.copy()
+    summary = {"ts": datetime.utcnow().isoformat(), "checks": {}}
+
+    # 1) checkpoint validation summary (expect key under checkpoints/summary-*.json)
+    # We search for the latest summary key in S3 list (PoC: attempt common key)
+    s3 = boto3.client("s3")
+    bucket = EB.replace("s3://","")
+    def find_latest(prefix):
+        try:
+            resp = s3.list_objects_v2(Bucket=bucket, Prefix=prefix)
+            items = resp.get("Contents", [])
+            if not items:
+                return None
+            items.sort(key=lambda x: x["LastModified"], reverse=True)
+            return items[0]["Key"]
+        except Exception as e:
+            logger.warning("list_objects failed for %s: %s", prefix, e)
+            return None
+
+    chk_key = find_latest("checkpoints/summary")
+    if chk_key:
+        chk = load_json_s3(EB, chk_key)
+        rate = chk.get("success_rate", 0.0) if chk else 0.0
+        ok = rate >= thresholds["checkpoint_success_threshold"]
+        summary["checks"]["checkpoint"] = {"key": chk_key, "success_rate": rate, "ok": ok}
+    else:
+        summary["checks"]["checkpoint"] = {"key": None, "ok": False, "reason": "missing summary key"}
+
+    # 2) OTEL coverage (otel/coverage-*.json)
+    otel_key = find_latest("otel/coverage")
+    if otel_key:
+        otel = load_json_s3(EB, otel_key)
+        cov = otel.get("coverage", 0.0) if otel else 0.0
+        ok = cov >= thresholds["otel_coverage_threshold"]
+        summary["checks"]["otel"] = {"key": otel_key, "coverage": cov, "ok": ok}
+    else:
+        summary["checks"]["otel"] = {"key": None, "ok": False, "reason": "missing otel coverage report"}
+
+    # 3) remediation metrics
+    rem_key = find_latest("remediation/metrics")
+    if rem_key:
+        rem = load_json_s3(EB, rem_key)
+        rate = rem.get("success_rate", 0.0) if rem else 0.0
+        ok = rate >= thresholds["remediation_success_threshold"]
+        summary["checks"]["remediation"] = {"key": rem_key, "success_rate": rate, "ok": ok}
+    else:
+        summary["checks"]["remediation"] = {"key": None, "ok": False, "reason": "missing remediation metrics"}
+
+    # 4) OPA harness report (opa/harness-report-*.json)
+    opa_key = find_latest("opa/harness-report")
+    mismatches = None
+    mismatch_rate = 1.0
+    if opa_key:
+        opa = load_json_s3(EB, opa_key)
+        # assume report contains "mismatches" and "decisions"
+        mismatches = opa.get("mismatches", [])
+        decisions = opa.get("decisions", {})
+        total = decisions.get("permit",0) + decisions.get("deny",0)
+        mismatch_rate = len(mismatches) / total if total else 1.0
+        ok = mismatch_rate <= thresholds["opa_mismatch_rate_threshold"]
+        summary["checks"]["opa"] = {"key": opa_key, "mismatch_rate": mismatch_rate, "ok": ok, "mismatches": len(mismatches)}
+    else:
+        summary["checks"]["opa"] = {"key": None, "ok": False, "reason": "missing OPA harness report"}
+
+    # 5) stress test: submission stress report at stress/submission-*.json
+    stress_key = find_latest("stress/submission")
+    if stress_key:
+        stress = load_json_s3(EB, stress_key)
+        accepted = stress.get("accepted", 0)
+        rejected = stress.get("rejected", 0)
+        total = accepted + rejected
+        reject_rate = rejected/total if total else 1.0
+        ok = reject_rate <= thresholds["stress_reject_rate_threshold"]
+        summary["checks"]["stress_submission"] = {"key": stress_key, "accepted": accepted, "rejected": rejected, "reject_rate": reject_rate, "ok": ok}
+    else:
+        summary["checks"]["stress_submission"] = {"key": None, "ok": False, "reason": "missing stress report"}
+
+    # 6) invoice reconciliation / invoice sim presence
+    inv_key = find_latest("invoices/simulated")
+    summary["checks"]["invoice_sim"] = {"key": inv_key, "present": bool(inv_key)}
+
+    # Final decision
+    all_ok = all(v.get("ok", False) for v in summary["checks"].values())
+    summary["overall_ok"] = all_ok
+    summary["thresholds"] = thresholds
+    open(args.out, "w").write(json.dumps(summary, indent=2))
+    # upload acceptance summary
+    s3.put_object = s3.put_object if True else None  # type: ignore
+    try:
+        key = f"acceptance/summary-{int(datetime.utcnow().timestamp())}.json"
+        s3.put_object(Bucket=bucket, Key=key, Body=json.dumps(summary).encode())
+        logger.info("Uploaded acceptance summary to s3://%s/%s", bucket, key)
+    except Exception as e:
+        logger.exception("Failed to upload acceptance summary: %s", e)
+
+    if not all_ok:
+        logger.error("Acceptance checks failed; see %s", args.out)
+        raise SystemExit(2)
+    logger.info("Acceptance checks passed")
+
+if __name__ == "__main__":
+    main()
+
