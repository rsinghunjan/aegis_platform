+#!/usr/bin/env python3
+"""
+Postmortem generator:
+ - Aggregates evidence artifacts for failed checks and generates a postmortem JSON with action items.
+ - Uploads postmortem to evidence bucket and optionally notifies a webhook (Slack, PagerDuty).
+ - This is intentionally non-destructive: action items are advisory and must be tracked by engineering.
+
+Usage:
+  EVIDENCE_BUCKET=s3://... NOTIFY_WEBHOOK=https://hooks.slack/... python3 ops/validation/postmortem_generator.py --acceptance /tmp/acceptance.json
+"""
+import os, json, argparse, logging, boto3, requests
+from datetime import datetime
+
+logging.basicConfig(level=logging.INFO)
+logger = logging.getLogger("postmortem-gen")
+
+def upload_to_s3(evidence_bucket, local_path, prefix="postmortems"):
+    if not evidence_bucket:
+        return None
+    s3=boto3.client("s3")
+    bucket=evidence_bucket.replace("s3://","")
+    key=f"{prefix}/{os.path.basename(local_path)}"
+    s3.upload_file(local_path, bucket, key)
+    return f"s3://{bucket}/{key}"
+
+def generate_action_items(summary):
+    items=[]
+    checks=summary.get("checks",{})
+    if not checks.get("checkpoint",{}).get("ok",False):
+        items.append({"area":"checkpoints","action":"Investigate missing/failed checkpoints per run; increase checkpoint frequency and retention; review Ray/Tune hooks","owner":"ml-infra","prio":"P0"})
+    if not checks.get("otel",{}).get("ok",False):
+        items.append({"area":"otel","action":"Add run_id/business_kpi instrumentation to components missing spans; validate OTEL collector/jaeger config","owner":"sre","prio":"P0"})
+    if not checks.get("opa",{}).get("ok",False):
+        items.append({"area":"policy","action":"Review OPA mismatches, adjust policy rego or thresholds; add test vectors to harness","owner":"ml-platform","prio":"P1"})
+    if not checks.get("remediation",{}).get("ok",False):
+        items.append({"area":"remediation","action":"Tune remediation engine; add more granular strategies for common failure classes","owner":"sre","prio":"P1"})
+    if not checks.get("stress_submission",{}).get("ok",False):
+        items.append({"area":"quota","action":"Tune tenant quotas and rate-limiter thresholds; review false-positive causes","owner":"finops/sre","prio":"P1"})
+    return items
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--acceptance", required=True)
+    args=p.parse_args()
+    acceptance = json.load(open(args.acceptance))
+    post = {"ts": datetime.utcnow().isoformat(), "acceptance": acceptance, "action_items": generate_action_items(acceptance)}
+    out="/tmp/postmortem-"+str(int(datetime.utcnow().timestamp()))+".json"
+    open(out,"w").write(json.dumps(post, indent=2))
+    uri = upload_to_s3(os.environ.get("EVIDENCE_BUCKET",""), out)
+    logger.info("Postmortem written to %s", out)
+    if os.environ.get("NOTIFY_WEBHOOK"):
+        try:
+            requests.post(os.environ["NOTIFY_WEBHOOK"], json={"text": f"Validation postmortem uploaded: {uri}"}, timeout=5)
+        except Exception:
+            logger.exception("notify webhook failed")
+    print(json.dumps(post, indent=2))
+
+if __name__ == "__main__":
+    main()
+
