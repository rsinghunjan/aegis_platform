+    script:
+      image: alpine:3.18
+      command: [sh]
+      source: |
+        set -euo pipefail
+        if [ -f /workspace/train_manifest.jsonl ]; then
+          cp /workspace/train_manifest.jsonl /tmp/train_manifest.jsonl
+          echo "manifest_path=/tmp/train_manifest.jsonl" > /tmp/outputs
+        else
+          echo "manifest_path=" > /tmp/outputs
+        fi
+        cat /tmp/outputs
+    outputs:
+      parameters:
+      - name: manifest_path
+        valueFrom:
