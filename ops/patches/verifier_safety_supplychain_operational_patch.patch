+apiVersion: argoproj.io/v1alpha1
+kind: Workflow
+metadata:
+  name: verifier-full-pipeline
+  namespace: ml-pipelines
+spec:
+  entrypoint: verifier-pipeline
+  serviceAccountName: argo-workflow-sa
+  onExit: verifier-exit-handler
+
+  templates:
+  - name: verifier-pipeline
+    steps:
+    - - name: fetch-manifest
+        template: fetch-manifest
+    - - name: finetune-domain
+        template: finetune-domain
+        arguments:
+          parameters:
+            - name: manifest
+              value: "{{steps.fetch-manifest.outputs.parameters.manifest_path}}"
+    - - name: calibrate-thresholds
