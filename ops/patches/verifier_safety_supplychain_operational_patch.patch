+  - name: sme-request
+    script:
+      image: python:3.10-slim
+      command: [sh]
+      source: |
+        set -euo pipefail
+        ART_META=/workspace/artifact_meta.json
+        # Create a manual-approval request for SME signoff and wait for approval
+        REQ_ID="verifier_$(date +%s)"
+        curl -sS -X POST "${MANUAL_APPROVAL_URL:-http://manual-approval.svc}/request" -H "Content-Type: application/json" -d "{\"request_id\":\"$REQ_ID\",\"user\":\"system\",\"reason\":\"SME signoff for verifier candidate\"}"
+        # Poll for approval (timeout after 48h)
+        for i in $(seq 1 576); do
+          sleep 300
+          RES=$(curl -sS "${MANUAL_APPROVAL_URL:-http://manual-approval.svc}/list")
+          echo "$RES" | grep "$REQ_ID" | grep -E "approved|rejected" && break || true
+        done
+        # Evaluate final decision
+        RES=$(curl -sS "${MANUAL_APPROVAL_URL:-http://manual-approval.svc}/list")
+        echo "$RES" | grep "$REQ_ID" | grep approved || (echo "SME not approved" && exit 2)
