+        # If last step failed, log and create incident
+        # Argo provides status via env; for simplicity, check for presence of promotion-backup configmap and canary state
+        if ! kubectl -n $NAMESPACE get deployment verifier -o jsonpath='{.status.availableReplicas}' 2>/dev/null; then
+          echo "Production verifier not available; creating incident"
+          curl -sS -X POST "${TICKET_URL:-http://ticket.svc}/create" -H "Content-Type: application/json" -d '{"title":"Verifier pipeline failure","body":"Argo pipeline exit handler detected failure"}' || true
+        fi
+
