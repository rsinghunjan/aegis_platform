+#!/usr/bin/env bash
+set -euo pipefail
+#
+# Populate CA bundle for ValidatingWebhookConfiguration using cert-manager-issued secret
+# Usage:
+#   ./ops/cosign/populate_ca_bundle.sh <namespace> <tls-secret-name> <validatingwebhookconfiguration-name>
+
+NS=${1:-admission}
+TLS_SECRET=${2:-cosign-webhook-tls}
+VWC_NAME=${3:-cosign-validating-webhook}
+
+if ! kubectl -n "$NS" get secret "$TLS_SECRET" >/dev/null 2>&1; then
+  echo "Secret $TLS_SECRET not found in $NS"
+  exit 2
+fi
+
+CA_BUNDLE=$(kubectl -n "$NS" get secret "$TLS_SECRET" -o jsonpath='{.data.ca\.crt}')
+if [ -z "$CA_BUNDLE" ]; then
+  echo "CA bundle not present in secret"
+  exit 2
+fi
+
+kubectl get validatingwebhookconfiguration "$VWC_NAME" -o json | \
+  jq --arg cab "$CA_BUNDLE" '.webhooks[0].clientConfig.caBundle=$cab' > /tmp/vwc.json
+
+kubectl apply -f /tmp/vwc.json
+echo "Updated ValidatingWebhookConfiguration $VWC_NAME with CA bundle from $TLS_SECRET"
+
