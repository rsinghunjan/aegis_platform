+            - name: labels
+              value: /workspace/candidate/labels.jsonl
+    - - name: adversarial-tests
+        template: adversarial
+    - - name: fairness-tests
+        template: fairness
+    - - name: validation-battery
+        template: validation-battery
+    - - name: upload-and-sign
+        template: sign-and-publish
+    - - name: request-sme-signoff
+        template: sme-request
+    - - name: gated-promotion
+        template: transactional-promotion
+
