+import time
+import os
+try:
+    import redis
+except Exception:
+    redis = None
+
+moderation_flagged = Counter("aegis_moderation_flagged_total", "Total flagged moderation events")
+moderation_review_latency = Histogram("aegis_moderation_review_latency_seconds", "Human review latency seconds")
+moderation_pending = Gauge("aegis_moderation_pending", "Number of pending moderation items")
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+STREAM_NAME = os.environ.get("MODERATION_STREAM", "diffusers:moderation:stream")
+
+def poll_pending_loop(poll_interval=10, port=9102):
+    start_http_server(port)
+    if redis is None:
+        print("redis not available; exporter will expose static metrics")
+        while True:
+            time.sleep(poll_interval)
+    r = redis.from_url(REDIS_URL)
+    while True:
+        try:
+            pending = r.xlen(STREAM_NAME)
+            moderation_pending.set(pending)
+        except Exception as e:
+            print("redis read error", e)
+        time.sleep(poll_interval)
+
+if __name__ == "__main__":
+    PORT = int(os.environ.get("MOD_METRICS_PORT", "9102"))
+    poll_pending_loop(port=PORT)
