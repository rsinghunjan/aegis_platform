+#!/usr/bin/env python3
+"""
+Example integration of quota middleware into frontier router flow.
+This shows the minimal change to preflight reservations before submitting to queue/stream.
+"""
+from services.gateway.frontier_router import infer as base_infer
+from services.gateway.quota_middleware import reserve_for_tenant, release_for_tenant
+
+def infer_with_quota(req):
+    # estimate GPU seconds using existing estimator
+    from ops.costing.cost_estimator import estimate_cost
+    est = estimate_cost(req.model, req.max_tokens)
+    tenant = req.user
+    ok, idempotency_key = reserve_for_tenant(tenant, est)
+    if not ok:
+        return {"error": "quota_exceeded", "message": "Tenant quota insufficient for this request"}
+    # forward to base router (which enqueues the job)
+    try:
+        resp = base_infer(req)
+    except Exception as e:
+        # release reservation on failure
+        release_for_tenant(tenant, idempotency_key)
+        raise
+    # attach idempotency_key to response metadata for later release when job completes
+    resp.setdefault("quota_reservation", {})["idempotency_key"] = idempotency_key
+    resp.setdefault("quota_reservation", {})["tenant"] = tenant
+    return resp
+
