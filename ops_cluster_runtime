+#!/usr/bin/env python3
+"""
+Check moderation stream for items older than SLA and emit a simple alert (console/post webhook).
+Intended to run as a CronJob.
+"""
+import os
+import time
+import json
+try:
+    import redis
+except Exception:
+    redis = None
+import requests
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+STREAM_NAME = os.environ.get("MODERATION_STREAM", "diffusers:moderation:stream")
+SLA_SECONDS = int(os.environ.get("MODERATION_SLA_SECONDS", str(60*60)))  # default 1 hour
+ALERT_WEBHOOK = os.environ.get("ALERT_WEBHOOK", "")
+
+def check_sla():
+    if redis is None:
+        print("redis not available; exiting")
+        return 2
+    r = redis.from_url(REDIS_URL)
+    # XRANGE from start to end, include ids and payloads, but limit for performance
+    entries = r.xrange(STREAM_NAME, count=1000)
+    now_ms = int(time.time() * 1000)
+    stale = []
+    for e in entries:
+        msg_id = e[0]
+        ts = int(msg_id.split(b"-")[0]) if isinstance(msg_id, bytes) else int(str(msg_id).split("-")[0])
+        # message id timestamp is milliseconds
+        age = (now_ms - ts) / 1000.0
+        if age > SLA_SECONDS:
+            payload = json.loads(e[1].get(b"payload").decode("utf-8"))
+            stale.append({"id": msg_id.decode() if isinstance(msg_id, bytes) else msg_id, "age_s": age, "payload": payload})
+    if stale:
+        msg = {"alert": "moderation_sla_breach", "count": len(stale), "samples": stale[:10]}
+        print(json.dumps(msg, indent=2))
+        if ALERT_WEBHOOK:
+            try:
+                requests.post(ALERT_WEBHOOK, json=msg, timeout=5)
+            except Exception as e:
+                print("failed to post webhook", e)
+        return 1
+    print("no SLA breaches")
+    return 0
+
+if __name__ == "__main__":
+    raise SystemExit(check_sla())
+
