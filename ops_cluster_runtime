+#!/usr/bin/env python3
+"""
+Cluster runtime validator
+ - Uses the Kubernetes API to check that nodes advertise runtimes or RuntimeClass support
+ - Detects missing runsc/kata support and emits a simple report (stdout / optional S3 upload)
+
+Run:
+  python ops/cluster/runtime_validator.py [--s3-bucket s3://bucket] [--kubeconfig /path/to/kubeconfig]
+"""
+import os
+import sys
+import json
+import argparse
+from datetime import datetime
+
+try:
+    from kubernetes import client, config
+except Exception:
+    client = None
+
+def load_kube(kubeconfig=None):
+    if client is None:
+        raise RuntimeError("kubernetes python client is required (pip install kubernetes)")
+    if kubeconfig:
+        config.load_kube_config(kubeconfig)
+    else:
+        try:
+            config.load_incluster_config()
+        except Exception:
+            config.load_kube_config()
+
+def check_nodes():
+    v1 = client.CoreV1Api()
+    nodes = v1.list_node().items
+    report = {"timestamp": datetime.utcnow().isoformat(), "nodes": []}
+    for n in nodes:
+        name = n.metadata.name
+        runtime = n.status.node_info.container_runtime_version or ""
+        labels = n.metadata.labels or {}
+        rc_supported = False
+        # Check for node labels that indicate a runtime-class mapping (best-effort)
+        if any(k.startswith("node.kubernetes.io/") for k in labels.keys()):
+            pass
+        report["nodes"].append({
+            "name": name,
+            "containerRuntimeVersion": runtime,
+            "labels": labels
+        })
+    return report
+
+def summarize(report):
+    problems = []
+    for n in report["nodes"]:
+        runtime = n.get("containerRuntimeVersion","").lower()
+        if "runsc" in runtime or "kata" in runtime:
+            continue
+        # if runtime string doesn't include runsc/kata we flag node
+        problems.append({"name": n["name"], "runtime": runtime})
+    return problems
+
+def upload_s3(s3_uri, payload_bytes):
+    import boto3
+    bucket = s3_uri.replace("s3://","").split("/",1)[0]
+    key = "ops/runtime-validator/report-{}.json".format(int(__import__("time").time()))
+    s3 = boto3.client("s3")
+    s3.put_object(Bucket=bucket, Key=key, Body=payload_bytes, ContentType="application/json")
+    return f"s3://{bucket}/{key}"
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--s3-bucket", default="")
+    p.add_argument("--kubeconfig", default=None)
+    args = p.parse_args()
+    load_kube(args.kubeconfig)
+    report = check_nodes()
+    problems = summarize(report)
+    out = {"report": report, "problems": problems}
+    txt = json.dumps(out, indent=2)
+    print(txt)
+    if args.s3_bucket:
+        uri = upload_s3(args.s3_bucket, txt.encode("utf-8"))
+        print("Uploaded report to", uri)
+    if problems:
+        print("WARNING: some nodes lack runsc/kata in their runtime string; review nodes above")
+        sys.exit(2)
+    print("All nodes appear to not advertise runsc/kata in runtime string; if you expect runsc/kata, ensure node setup and labels are correct.")
+
+if __name__ == "__main__":
+    main()
+
