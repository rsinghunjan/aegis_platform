+#!/usr/bin/env python3
+"""
+Expose moderation metrics for Prometheus:
+ - moderation_flagged_total (counter)
+ - moderation_review_latency_seconds (histogram)
+ - moderation_pending_gauge (gauge)
+
+This simple HTTP exporter is intended to run as a sidecar in moderation_reviewer or as a small service.
+"""
