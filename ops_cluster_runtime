+#!/usr/bin/env python3
+"""
+Quota middleware: integrate QuotaClientV2 at the gateway to perform a preflight reservation.
+ - Attempt a reservation before routing/enqueuing a heavy job.
+ - Release the reservation on failure or when the run completes (frontend should call release via API on completion).
+
+Usage:
+ - Import and call `reserve_for_tenant(tenant, est_gpu_sec, idempotency_key)` from gateway routing logic.
+"""
+from services.serving.diffusers.quota_client_v2 import QuotaClientV2
+import uuid
+
+quota = QuotaClientV2()
+
+def reserve_for_tenant(tenant: str, est_gpu_sec: float, idempotency_key: str = None):
+    """
+    Returns (ok:bool, idempotency_key:str)
+    """
+    if idempotency_key is None:
+        idempotency_key = str(uuid.uuid4())
+    ok = quota.reserve(tenant, est_gpu_sec, idempotency_key)
+    return bool(ok), idempotency_key
+
+def release_for_tenant(tenant: str, idempotency_key: str):
+    return quota.release(tenant, idempotency_key)
+
