@@ -0,0 +1,70 @@
+from __future__ import annotations
+
+from kubernetes.client import V1Namespace, V1ObjectMeta
+from kubernetes.client.rest import ApiException
+
+from api.k8s_client import core_api
+
+
+def ensure_tenant_namespace(tenant_id: str) -> str:
+    """
+    Creates or ensures a namespace for a tenant.
+    Naming convention: aegis-<tenant_id>
+    """
+    ns = f"aegis-{tenant_id}"
+    api = core_api()
+    try:
+        api.read_namespace(ns)
+        return ns
+    except ApiException as e:
+        if e.status != 404:
+            raise
+
+    body = V1Namespace(
+        metadata=V1ObjectMeta(
+            name=ns,
+            labels={
+                "aegis.io/tenant": tenant_id,
+                "aegis.io/managed-by": "aegis-api",
+            },
+        )
+    )
+    api.create_namespace(body=body)
+    return ns
diff --git a/api/k8s_deployer.py b/api/k8s_deployer.py
new file mode 100644
index 0000000..a8cd1bb
--- /dev/null
+++ b/api/k8s_deployer.py
@@ -0,0 +1,330 @@
+from __future__ import annotations
+
+import os
+from typing import Dict, Any, Optional, Tuple
+
+from kubernetes import client
+
+from api.k8s_client import apps_api, core_api
+
+
+def _labels(tenant_id: str, project_id: str, model_version_id: str, deployment_id: str) -> Dict[str, str]:
+    return {
+        "app.kubernetes.io/name": "aegis-model",
+        "aegis.io/tenant": tenant_id,
+        "aegis.io/project": project_id,
+        "aegis.io/model_version": model_version_id,
+        "aegis.io/deployment": deployment_id,
+    }
+
+
+def deploy_vllm(
+    namespace: str,
+    name: str,
+    tenant_id: str,
+    project_id: str,
+    model_version_id: str,
+    deployment_id: str,
+    model_artifact_uri: str,
+    gpu: int = 1,
+    image: Optional[str] = None,
+    extra_env: Optional[Dict[str, str]] = None,
+) -> Tuple[str, str]:
+    """
+    Creates a vLLM deployment and service.
+    Notes:
+    - This is a template. Production setups often need nodeSelectors/tolerations, PVC caching, etc.
+    - We pass model uri as env; your serving container should fetch from S3 and verify signature before load.
+    """
+    image = image or os.environ.get("AEGIS_VLLM_IMAGE", "vllm/vllm-openai:latest")
+    labels = _labels(tenant_id, project_id, model_version_id, deployment_id)
+    appsv1 = apps_api()
+    corev1 = core_api()
+
+    env = [
+        client.V1EnvVar(name="AEGIS_MODEL_ARTIFACT_URI", value=model_artifact_uri),
+    ]
+    for k, v in (extra_env or {}).items():
+        env.append(client.V1EnvVar(name=k, value=v))
+
+    container = client.V1Container(
+        name="vllm",
+        image=image,
+        ports=[client.V1ContainerPort(container_port=8000)],
+        env=env,
+        resources=client.V1ResourceRequirements(
+            limits={"nvidia.com/gpu": str(gpu)} if gpu and gpu > 0 else None
+        ),
+    )
+
+    pod_spec = client.V1PodSpec(containers=[container])
+    template = client.V1PodTemplateSpec(
+        metadata=client.V1ObjectMeta(labels=labels),
+        spec=pod_spec,
+    )
+    spec = client.V1DeploymentSpec(
+        replicas=1,
+        selector=client.V1LabelSelector(match_labels={"aegis.io/deployment": deployment_id}),
+        template=template,
+    )
+    dep = client.V1Deployment(
+        metadata=client.V1ObjectMeta(name=name, namespace=namespace, labels=labels),
+        spec=spec,
+    )
+    appsv1.create_namespaced_deployment(namespace=namespace, body=dep)
+
+    svc = client.V1Service(
+        metadata=client.V1ObjectMeta(name=f"{name}-svc", namespace=namespace, labels=labels),
+        spec=client.V1ServiceSpec(
+            selector={"aegis.io/deployment": deployment_id},
+            ports=[client.V1ServicePort(name="http", port=80, target_port=8000)],
+            type="ClusterIP",
+        ),
+    )
+    corev1.create_namespaced_service(namespace=namespace, body=svc)
+    return svc.metadata.name, f"http://{svc.metadata.name}.{namespace}.svc.cluster.local"
+
+
+def deploy_triton(
+    namespace: str,
+    name: str,
+    tenant_id: str,
+    project_id: str,
+    model_version_id: str,
+    deployment_id: str,
+    model_artifact_uri: str,
+    image: Optional[str] = None,
+    gpu: int = 0,
+    extra_env: Optional[Dict[str, str]] = None,
+) -> Tuple[str, str]:
+    """
+    Creates a Triton deployment and service.
+    Template assumptions:
+    - container knows how to populate /models from AEGIS_MODEL_ARTIFACT_URI.
+    """
+    image = image or os.environ.get("AEGIS_TRITON_IMAGE", "nvcr.io/nvidia/tritonserver:24.01-py3")
+    labels = _labels(tenant_id, project_id, model_version_id, deployment_id)
+    appsv1 = apps_api()
+    corev1 = core_api()
+
+    env = [client.V1EnvVar(name="AEGIS_MODEL_ARTIFACT_URI", value=model_artifact_uri)]
+    for k, v in (extra_env or {}).items():
+        env.append(client.V1EnvVar(name=k, value=v))
+
+    # For real installs, you often mount a PVC at /models and run an initContainer to fetch from S3.
+    container = client.V1Container(
+        name="triton",
+        image=image,
+        args=[
+            "tritonserver",
+            "--model-repository=/models",
+            "--http-port=8000",
+            "--grpc-port=8001",
+            "--metrics-port=8002",
+        ],
+        ports=[
+            client.V1ContainerPort(container_port=8000),
+            client.V1ContainerPort(container_port=8001),
+            client.V1ContainerPort(container_port=8002),
+        ],
+        env=env,
+        resources=client.V1ResourceRequirements(
+            limits={"nvidia.com/gpu": str(gpu)} if gpu and gpu > 0 else None
+        ),
+    )
+    pod_spec = client.V1PodSpec(containers=[container])
+    template = client.V1PodTemplateSpec(
+        metadata=client.V1ObjectMeta(labels=labels),
+        spec=pod_spec,
+    )
+    spec = client.V1DeploymentSpec(
+        replicas=1,
+        selector=client.V1LabelSelector(match_labels={"aegis.io/deployment": deployment_id}),
+        template=template,
+    )
+    dep = client.V1Deployment(
+        metadata=client.V1ObjectMeta(name=name, namespace=namespace, labels=labels),
+        spec=spec,
+    )
+    appsv1.create_namespaced_deployment(namespace=namespace, body=dep)
+
+    svc = client.V1Service(
+        metadata=client.V1ObjectMeta(name=f"{name}-svc", namespace=namespace, labels=labels),
+        spec=client.V1ServiceSpec(
+            selector={"aegis.io/deployment": deployment_id},
+            ports=[
+                client.V1ServicePort(name="http", port=80, target_port=8000),
+                client.V1ServicePort(name="grpc", port=81, target_port=8001),
+                client.V1ServicePort(name="metrics", port=82, target_port=8002),
+            ],
+            type="ClusterIP",
+        ),
+    )
+    corev1.create_namespaced_service(namespace=namespace, body=svc)
+    return svc.metadata.name, f"http://{svc.metadata.name}.{namespace}.svc.cluster.local"
