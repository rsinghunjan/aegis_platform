new file mode 100644
index 0000000..db8cda7
--- /dev/null
+++ b/api/s3_store.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+import os
+import hashlib
+from typing import Tuple, Optional
+
+import boto3
+
+
+def _client():
+    # supports MinIO via endpoint_url
+    endpoint_url = os.environ.get("AEGIS_S3_ENDPOINT_URL", None)
+    region = os.environ.get("AEGIS_S3_REGION", "us-east-1")
+    return boto3.client("s3", region_name=region, endpoint_url=endpoint_url)
+
+
+def sha256_file(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def put_artifact(
+    tenant_id: str,
+    project_id: str,
+    model_id: str,
+    version: str,
+    local_path: str,
+    content_type: Optional[str] = None,
+) -> Tuple[str, str]:
+    """
+    Upload a file to S3 and return (artifact_uri, sha256).
+    """
+    bucket = os.environ.get("AEGIS_ARTIFACTS_BUCKET", "")
+    if not bucket:
+        raise RuntimeError("AEGIS_ARTIFACTS_BUCKET not set")
+
+    digest = sha256_file(local_path)
+    key = f"{tenant_id}/{project_id}/{model_id}/{version}/artifact"
+    extra = {}
+    if content_type:
+        extra["ContentType"] = content_type
+
+    c = _client()
+    c.upload_file(local_path, bucket, key, ExtraArgs=extra or None)
+    return f"s3://{bucket}/{key}", digest
