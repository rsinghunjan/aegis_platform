@@ -0,0 +1,65 @@
+from __future__ import annotations
+
+import os
+
+from kubernetes import client, config
+
+
+def load_k8s():
+    """
+    Loads kubernetes configuration.
+    - In cluster: uses ServiceAccount
+    - Local dev: uses kubeconfig
+    """
+    mode = os.environ.get("AEGIS_K8S_CONFIG", "auto")  # auto|incluster|kubeconfig
+    if mode == "incluster":
+        config.load_incluster_config()
+        return
+    if mode == "kubeconfig":
+        config.load_kube_config()
+        return
+    # auto
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+
+
+def core_api() -> client.CoreV1Api:
+    load_k8s()
+    return client.CoreV1Api()
+
+
+def apps_api() -> client.AppsV1Api:
+    load_k8s()
+    return client.AppsV1Api()
