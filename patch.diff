+"""
+Platform schema for multi-tenant Aegis SaaS.
+
+This file is additive: it does not delete/rename existing api/models.py.
+It introduces a tenant-scoped schema that you can migrate to over time.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Optional
+
+from sqlalchemy import (
+    Column,
+    Integer,
+    String,
+    Boolean,
+    DateTime,
+    ForeignKey,
+    Text,
+    JSON,
+    Float,
+    UniqueConstraint,
+    Index,
+)
+from sqlalchemy.orm import relationship
+
+from api.db import Base
+
+
+# ------------------------ Tenancy ------------------------
+
+class Tenant(Base):
+    __tablename__ = "tenants"
+    id = Column(String(100), primary_key=True)  # uuid/slug
+    name = Column(String(200), nullable=True)
+    status = Column(String(50), nullable=False, default="active")  # active|suspended|deleted
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    projects = relationship("Project", back_populates="tenant")
+
+
+class TenantQuota(Base):
+    __tablename__ = "tenant_quotas"
+    id = Column(Integer, primary_key=True)
+    tenant_id = Column(String(100), ForeignKey("tenants.id", ondelete="CASCADE"), nullable=False, index=True)
+    rate_per_min = Column(Integer, nullable=True)
+    burst = Column(Integer, nullable=True)
+    daily_quota_units = Column(Integer, nullable=True)
+    updated_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    tenant = relationship("Tenant")
+
+
+class UsageRecord(Base):
+    __tablename__ = "usage_records"
+    id = Column(Integer, primary_key=True)
+    tenant_id = Column(String(100), nullable=True, index=True)
+    model_name = Column(String(200), nullable=False)
+    version = Column(String(100), nullable=False)
+    units = Column(Integer, nullable=False, default=1)
+    inference_ms = Column(Float, nullable=True)
+    cost_estimate = Column(Float, nullable=True)
+    extra = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+
+class Invoice(Base):
+    __tablename__ = "invoices"
+    id = Column(Integer, primary_key=True)
+    tenant_id = Column(String(100), nullable=True, index=True)
+    period_start = Column(DateTime, nullable=False)
+    period_end = Column(DateTime, nullable=False)
+    units = Column(Integer, nullable=False, default=0)
+    amount = Column(Float, nullable=False, default=0.0)
+    currency = Column(String(10), nullable=False, default="USD")
+    status = Column(String(50), nullable=False, default="issued")  # issued|paid|disputed
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+
+# ------------------------ Core platform objects ------------------------
+
+class Project(Base):
+    __tablename__ = "projects"
+    id = Column(String(100), primary_key=True)  # uuid
+    tenant_id = Column(String(100), ForeignKey("tenants.id", ondelete="CASCADE"), nullable=False, index=True)
+    name = Column(String(200), nullable=False)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    tenant = relationship("Tenant", back_populates="projects")
+    models = relationship("Model", back_populates="project")
+
+    __table_args__ = (
+        UniqueConstraint("tenant_id", "name", name="uq_project_tenant_name"),
+        Index("ix_projects_tenant_id_created_at", "tenant_id", "created_at"),
+    )
+
+
+class Model(Base):
+    __tablename__ = "platform_models"
+    id = Column(String(100), primary_key=True)  # uuid
+    tenant_id = Column(String(100), ForeignKey("tenants.id", ondelete="CASCADE"), nullable=False, index=True)
+    project_id = Column(String(100), ForeignKey("projects.id", ondelete="CASCADE"), nullable=False, index=True)
+    name = Column(String(200), nullable=False)
+    description = Column(Text, nullable=True)
+    kind = Column(String(50), nullable=False, default="ml")  # ml|llm
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    project = relationship("Project", back_populates="models")
+    versions = relationship("ModelVersion", back_populates="model")
+
+    __table_args__ = (
+        UniqueConstraint("tenant_id", "project_id", "name", name="uq_model_tenant_project_name"),
+        Index("ix_platform_models_tenant_project", "tenant_id", "project_id"),
+    )
+
+
+class ModelVersion(Base):
+    __tablename__ = "platform_model_versions"
+    id = Column(String(100), primary_key=True)  # uuid
+    tenant_id = Column(String(100), nullable=False, index=True)
+    model_id = Column(String(100), ForeignKey("platform_models.id", ondelete="CASCADE"), nullable=False, index=True)
+    version = Column(String(100), nullable=False)
+    stage = Column(String(50), nullable=False, default="staging")  # staging|canary|prod
+    artifact_uri = Column(String(2000), nullable=False)
+    artifact_sha256 = Column(String(128), nullable=True)
+    signature = Column(Text, nullable=True)  # detached signature material (or envelope)
+    signed = Column(Boolean, nullable=False, default=False)
+
+    eval_status = Column(String(50), nullable=False, default="unknown")  # pass|fail|unknown
+    approved = Column(Boolean, nullable=False, default=False)
+
+    metadata = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    model = relationship("Model", back_populates="versions")
+
+    __table_args__ = (
+        UniqueConstraint("model_id", "version", name="uq_platform_model_version"),
+        Index("ix_model_versions_tenant_model_stage", "tenant_id", "model_id", "stage"),
+    )
+
+
+class Deployment(Base):
+    __tablename__ = "deployments"
+    id = Column(String(100), primary_key=True)  # uuid
+    tenant_id = Column(String(100), nullable=False, index=True)
+    project_id = Column(String(100), nullable=False, index=True)
+    model_version_id = Column(String(100), ForeignKey("platform_model_versions.id", ondelete="CASCADE"), nullable=False, index=True)
+    name = Column(String(200), nullable=False)
+    backend = Column(String(50), nullable=False)  # vllm|triton|custom
+    namespace = Column(String(200), nullable=False)
+    service_name = Column(String(200), nullable=False)
+    url = Column(String(2000), nullable=True)  # external URL if known
+    status = Column(String(50), nullable=False, default="creating")  # creating|ready|error|deleted
+    config = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (
+        UniqueConstraint("tenant_id", "namespace", "name", name="uq_deployments_tenant_ns_name"),
+        Index("ix_deployments_tenant_project", "tenant_id", "project_id"),
+    )
+
+
+class Run(Base):
+    __tablename__ = "runs"
+    id = Column(String(100), primary_key=True)  # uuid
+    tenant_id = Column(String(100), nullable=False, index=True)
+    project_id = Column(String(100), nullable=False, index=True)
+    kind = Column(String(50), nullable=False, default="train")  # train|eval|batch
+    status = Column(String(50), nullable=False, default="pending")  # pending|running|succeeded|failed
+    k8s_namespace = Column(String(200), nullable=True)
+    k8s_job_name = Column(String(200), nullable=True)
+    input = Column(JSON, nullable=True)
+    output = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+    updated_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+
+class AuditEvent(Base):
+    __tablename__ = "audit_events"
+    id = Column(Integer, primary_key=True)
+    tenant_id = Column(String(100), nullable=True, index=True)
+    actor = Column(String(200), nullable=False)
+    action = Column(String(200), nullable=False)
+    resource_type = Column(String(200), nullable=True)
+    resource_id = Column(String(200), nullable=True)
+    request_id = Column(String(200), nullable=True, index=True)
+    decision = Column(String(50), nullable=True)  # allow|block|review|n/a
+    details = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (Index("ix_audit_tenant_created_at", "tenant_id", "created_at"),)
diff --git a/api/auth_tenant.py b/api/auth_tenant.py
new file mode 100644
index 0000000..86a0a30
--- /dev/null
+++ b/api/auth_tenant.py
@@ -0,0 +1,212 @@
+"""
+Tenant-aware JWT auth for Aegis SaaS.
+
+Supports OIDC JWT validation using auth/oidc_jwks.py (JWKS fetch + python-jose).
+
+Expected claims (configurable by env):
+- tenant: tenant id/slug (default claim key: "tenant")
+- roles: list of role strings (default claim key: "roles")
+- sub: subject
+
+You can also support "scope" or "scp" claims; this module normalizes into roles/scopes.
+"""
+
+from __future__ import annotations
+
+import os
+import logging
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional
+
+from fastapi import Depends, HTTPException, Request, status
+from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
+
+from auth.oidc_jwks import verify_jwt
+
+logger = logging.getLogger("aegis.auth_tenant")
+
+TENANT_CLAIM = os.environ.get("AEGIS_TENANT_CLAIM", "tenant")
+ROLES_CLAIM = os.environ.get("AEGIS_ROLES_CLAIM", "roles")
+SCOPES_CLAIM = os.environ.get("AEGIS_SCOPES_CLAIM", "scope")  # can be "scope" (space-separated)
+
+OIDC_AUDIENCE = os.environ.get("OIDC_AUDIENCE", None)
+OIDC_ISSUER = os.environ.get("OIDC_ISSUER", None)
+
+bearer = HTTPBearer(auto_error=False)
+
+
+@dataclass(frozen=True)
+class Actor:
+    sub: str
+    tenant_id: Optional[str]
+    roles: List[str]
+    raw_claims: Dict[str, Any]
+
+    @property
+    def is_platform_admin(self) -> bool:
+        return "platform_admin" in self.roles or "admin" in self.roles
+
+
+def _extract_roles(claims: Dict[str, Any]) -> List[str]:
+    roles: List[str] = []
+
+    raw_roles = claims.get(ROLES_CLAIM)
+    if isinstance(raw_roles, list):
+        roles.extend([str(x) for x in raw_roles])
+    elif isinstance(raw_roles, str) and raw_roles.strip():
+        # allow comma-separated
+        roles.extend([r.strip() for r in raw_roles.split(",") if r.strip()])
+
+    # normalize OAuth "scope" claim if present
+    raw_scopes = claims.get(SCOPES_CLAIM)
+    if isinstance(raw_scopes, str) and raw_scopes.strip():
+        roles.extend([s.strip() for s in raw_scopes.split(" ") if s.strip()])
+    elif isinstance(raw_scopes, list):
+        roles.extend([str(x) for x in raw_scopes])
+
+    # de-dupe but preserve order
+    seen = set()
+    out = []
+    for r in roles:
+        if r not in seen:
+            seen.add(r)
+            out.append(r)
+    return out
+
+
+def _extract_tenant_id(claims: Dict[str, Any]) -> Optional[str]:
+    val = claims.get(TENANT_CLAIM)
+    if val is None:
+        return None
+    if isinstance(val, str) and val.strip():
+        return val.strip()
+    return str(val)
+
+
+def get_actor_from_request(request: Request) -> Optional[Actor]:
+    return getattr(request.state, "actor", None)
+
+
+async def require_actor(
+    request: Request,
+    creds: Optional[HTTPAuthorizationCredentials] = Depends(bearer),
+) -> Actor:
+    """
+    Validates Authorization: Bearer <JWT> and attaches Actor to request.state.
+    """
+    if creds is None or not creds.credentials:
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="missing bearer token")
+
+    token = creds.credentials
+    try:
+        claims = verify_jwt(token, audience=OIDC_AUDIENCE, issuer=OIDC_ISSUER)
+    except Exception as e:
+        logger.info("jwt.invalid", extra={"error": str(e)})
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="invalid token")
+
+    sub = str(claims.get("sub") or "")
+    if not sub:
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="token missing sub")
+
+    actor = Actor(
+        sub=sub,
+        tenant_id=_extract_tenant_id(claims),
+        roles=_extract_roles(claims),
+        raw_claims=claims,
+    )
+    request.state.actor = actor
+    return actor
+
+
+def require_roles(required: List[str]):
+    async def _dep(actor: Actor = Depends(require_actor)) -> Actor:
+        for r in required:
+            if r in actor.roles:
+                return actor
+        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail={"message": "forbidden", "required": required})
+    return _dep
+
+
+def require_tenant_actor():
+    async def _dep(actor: Actor = Depends(require_actor)) -> Actor:
+        if not actor.tenant_id:
+            raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="missing tenant claim")
+        return actor
+    return _dep
