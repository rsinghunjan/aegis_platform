--- /dev/null
+++ b/api/platform_app.py
@@ -0,0 +1,446 @@
+"""
+Platform FastAPI app for Aegis SaaS (multi-tenant, Kubernetes-first).
+
+This app is additive and does not remove existing demo apps.
+Run:
+  uvicorn api.platform_app:app --reload
+"""
+
+from __future__ import annotations
+
+import os
+import time
+import uuid
+import tempfile
+import logging
+from typing import Any, Dict, Optional
+
+from fastapi import FastAPI, Depends, HTTPException, UploadFile, File, Form, Request
+from fastapi.responses import PlainTextResponse
+from fastapi.middleware.gzip import GZipMiddleware
+from starlette.middleware.cors import CORSMiddleware
+
+from prometheus_client import generate_latest, CONTENT_TYPE_LATEST, Counter, Summary
+
+from api.logging_config import configure_logging, set_request_id
+from api.otel import init_otel
+from api.db import engine as sqlalchemy_engine, SessionLocal
+
+from api.auth_tenant import require_actor, require_roles, require_tenant_actor, Actor
+from api.audit_platform import record_audit_event
+from api.models_platform import (
+    Tenant,
+    Project,
+    Model,
+    ModelVersion,
+    Deployment,
+    UsageRecord,
+)
+from api.s3_store import put_artifact
+from api.signing import sign_sha256
+from api.k8s_tenant import ensure_tenant_namespace
+from api.k8s_deployer import deploy_vllm, deploy_triton
+from api.policy_gates import ensure_deploy_allowed, ensure_signature_valid
+from api.safety import enforce_and_maybe_block
+
+configure_logging()
+logger = logging.getLogger("aegis.platform")
+logger.setLevel(logging.INFO)
+
+app = FastAPI(title="Aegis Platform API", version="0.1.0")
+app.add_middleware(GZipMiddleware, minimum_size=1000)
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=["*"],
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+init_otel(app=app, sqlalchemy_engine=sqlalchemy_engine)
+
+# Prometheus metrics
+INFER_TOTAL = Counter("aegis_infer_total", "Total inference calls", ["tenant", "model", "version", "backend"])
+INFER_LAT_MS = Summary("aegis_infer_latency_ms", "Inference latency ms", ["tenant", "model", "version", "backend"])
+REGISTRY_UPLOAD_TOTAL = Counter("aegis_registry_upload_total", "Total registry uploads", ["tenant"])
+DEPLOY_TOTAL = Counter("aegis_deploy_total", "Total deployments created", ["tenant", "backend"])
+
+
+@app.middleware("http")
+async def request_context(request: Request, call_next):
+    request_id = request.headers.get("x-request-id") or str(uuid.uuid4())
+    set_request_id(request_id)
+    start = time.time()
+    response = None
+    try:
+        response = await call_next(request)
+        return response
+    finally:
+        elapsed_ms = (time.time() - start) * 1000.0
+        logger.info(
+            "http.request",
+            extra={
+                "request_id": request_id,
+                "method": request.method,
+                "path": request.url.path,
+                "status": getattr(response, "status_code", None),
+                "latency_ms": elapsed_ms,
+                "remote": request.client.host if request.client else None,
+            },
+        )
+
+
+@app.get("/metrics")
+async def metrics():
+    return PlainTextResponse(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+
+@app.get("/healthz")
+async def healthz():
+    return {"ok": True}
+
+
+# ----------------- Admin: tenant provisioning -----------------
+
+@app.post("/v1/admin/tenants/provision", dependencies=[Depends(require_roles(["platform_admin"]))])
+async def provision_tenant(
+    tenant_id: str = Form(...),
+    name: Optional[str] = Form(None),
+    actor: Actor = Depends(require_actor),
+):
+    """
+    Admin-only:
+    - creates/ensures Tenant in DB
+    - creates/ensures Kubernetes namespace aegis-<tenant_id>
+    """
+    session = SessionLocal()
+    try:
+        t = session.query(Tenant).filter_by(id=tenant_id).one_or_none()
+        if not t:
+            t = Tenant(id=tenant_id, name=name or tenant_id)
+            session.add(t)
+            session.commit()
+
+        ns = ensure_tenant_namespace(tenant_id=tenant_id)
+
+        record_audit_event(
+            tenant_id=tenant_id,
+            actor=actor.sub,
+            action="tenant.provision",
+            resource_type="tenant",
+            resource_id=tenant_id,
+            request_id=None,
+            decision="allow",
+            details={"namespace": ns},
+        )
+        return {"tenant_id": tenant_id, "namespace": ns, "created": True}
+    finally:
+        session.close()
+
+
+# ----------------- Tenant APIs -----------------
+
+@app.post("/v1/projects", dependencies=[Depends(require_tenant_actor())])
+async def create_project(
+    name: str = Form(...),
+    actor: Actor = Depends(require_actor),
+):
+    session = SessionLocal()
+    try:
+        pid = str(uuid.uuid4())
+        p = Project(id=pid, tenant_id=actor.tenant_id, name=name)
+        session.add(p)
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "project.create", "project", pid, details={"name": name})
+        return {"project_id": pid, "name": name}
+    except Exception as e:
+        session.rollback()
+        raise HTTPException(status_code=400, detail=str(e))
+    finally:
+        session.close()
+
+
+@app.post("/v1/models", dependencies=[Depends(require_tenant_actor())])
+async def create_model(
+    project_id: str = Form(...),
+    name: str = Form(...),
+    kind: str = Form("ml"),
+    description: Optional[str] = Form(None),
+    actor: Actor = Depends(require_actor),
+):
+    session = SessionLocal()
+    try:
+        # ensure project belongs to tenant
+        p = session.query(Project).filter_by(id=project_id, tenant_id=actor.tenant_id).one_or_none()
+        if not p:
+            raise HTTPException(status_code=404, detail="project not found")
+        mid = str(uuid.uuid4())
+        m = Model(id=mid, tenant_id=actor.tenant_id, project_id=project_id, name=name, kind=kind, description=description)
+        session.add(m)
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "model.create", "model", mid, details={"name": name, "kind": kind})
+        return {"model_id": mid, "name": name}
+    except HTTPException:
+        raise
+    except Exception as e:
+        session.rollback()
+        raise HTTPException(status_code=400, detail=str(e))
+    finally:
+        session.close()
+
+
+# ----------------- Model registry: upload/register -> S3 -> sign -> DB -----------------
+
+@app.post("/v1/registry/register", dependencies=[Depends(require_tenant_actor())])
+async def register_model_version(
+    project_id: str = Form(...),
+    model_id: str = Form(...),
+    version: str = Form(...),
+    stage: str = Form("staging"),
+    artifact_file: UploadFile = File(...),
+    actor: Actor = Depends(require_actor),
+):
+    if stage not in ("staging", "canary", "prod"):
+        raise HTTPException(status_code=400, detail="invalid stage")
+
+    session = SessionLocal()
+    try:
+        m = session.query(Model).filter_by(id=model_id, tenant_id=actor.tenant_id, project_id=project_id).one_or_none()
+        if not m:
+            raise HTTPException(status_code=404, detail="model not found")
+
+        tmpdir = tempfile.mkdtemp()
+        local_path = os.path.join(tmpdir, artifact_file.filename or "artifact.bin")
+        content = await artifact_file.read()
+        with open(local_path, "wb") as f:
+            f.write(content)
+
+        artifact_uri, sha256 = put_artifact(
+            tenant_id=actor.tenant_id,
+            project_id=project_id,
+            model_id=model_id,
+            version=version,
+            local_path=local_path,
+            content_type=artifact_file.content_type,
+        )
+        sig = sign_sha256(sha256)
+        signed = bool(sig)
+
+        vid = str(uuid.uuid4())
+        mv = ModelVersion(
+            id=vid,
+            tenant_id=actor.tenant_id,
+            model_id=model_id,
+            version=version,
+            stage=stage,
+            artifact_uri=artifact_uri,
+            artifact_sha256=sha256,
+            signature=sig,
+            signed=signed,
+            eval_status="unknown",
+            approved=False,
+            metadata={"filename": artifact_file.filename, "content_type": artifact_file.content_type},
+        )
+        session.add(mv)
+        session.commit()
+        REGISTRY_UPLOAD_TOTAL.labels(tenant=actor.tenant_id).inc()
+
+        record_audit_event(
+            actor.tenant_id,
+            actor.sub,
+            "registry.register",
+            "model_version",
+            vid,
+            details={"model_id": model_id, "version": version, "artifact_uri": artifact_uri, "signed": signed},
+        )
+        return {"model_version_id": vid, "artifact_uri": artifact_uri, "sha256": sha256, "signed": signed}
+    except HTTPException:
+        raise
+    except Exception as e:
+        session.rollback()
+        raise HTTPException(status_code=500, detail=str(e))
+    finally:
+        session.close()
+
+
+@app.post("/v1/registry/{model_version_id}/approve", dependencies=[Depends(require_roles(["tenant_admin", "platform_admin"]))])
+async def approve_model_version(
+    model_version_id: str,
+    approved: bool = Form(True),
+    actor: Actor = Depends(require_actor),
+):
+    session = SessionLocal()
+    try:
+        mv = session.query(ModelVersion).filter_by(id=model_version_id, tenant_id=actor.tenant_id).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+        mv.approved = bool(approved)
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "registry.approve", "model_version", model_version_id, details={"approved": approved})
+        return {"model_version_id": model_version_id, "approved": mv.approved}
+    finally:
+        session.close()
+
+
+@app.post("/v1/registry/{model_version_id}/eval", dependencies=[Depends(require_roles(["tenant_admin", "platform_admin"]))])
+async def set_eval_status(
+    model_version_id: str,
+    status_val: str = Form(...),  # pass|fail
+    actor: Actor = Depends(require_actor),
+):
+    if status_val not in ("pass", "fail"):
+        raise HTTPException(status_code=400, detail="status must be pass|fail")
+    session = SessionLocal()
+    try:
+        mv = session.query(ModelVersion).filter_by(id=model_version_id, tenant_id=actor.tenant_id).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+        mv.eval_status = status_val
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "registry.eval_set", "model_version", model_version_id, details={"eval_status": status_val})
+        return {"model_version_id": model_version_id, "eval_status": mv.eval_status}
+    finally:
+        session.close()
+
+
+# ----------------- Deployments (Kubernetes-first) -----------------
+
+@app.post("/v1/deployments", dependencies=[Depends(require_tenant_actor())])
+async def create_deployment(
+    project_id: str = Form(...),
+    model_version_id: str = Form(...),
+    name: str = Form(...),
+    backend: str = Form(...),  # vllm|triton
+    gpu: int = Form(0),
+    actor: Actor = Depends(require_actor),
+):
+    if backend not in ("vllm", "triton"):
+        raise HTTPException(status_code=400, detail="backend must be vllm|triton")
+
+    session = SessionLocal()
+    try:
+        mv = session.query(ModelVersion).filter_by(id=model_version_id, tenant_id=actor.tenant_id).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+
+        # Policy gates
+        ensure_signature_valid(mv)
+        ensure_deploy_allowed(mv)
+
+        namespace = ensure_tenant_namespace(actor.tenant_id)
+        did = str(uuid.uuid4())
+        k8s_name = f"aegis-{name}-{did[:8]}".lower().replace("_", "-")
+
+        if backend == "vllm":
+            svc_name, url = deploy_vllm(
+                namespace=namespace,
+                name=k8s_name,
+                tenant_id=actor.tenant_id,
+                project_id=project_id,
+                model_version_id=model_version_id,
+                deployment_id=did,
+                model_artifact_uri=mv.artifact_uri,
+                gpu=max(0, int(gpu)),
+            )
+        else:
+            svc_name, url = deploy_triton(
+                namespace=namespace,
+                name=k8s_name,
+                tenant_id=actor.tenant_id,
+                project_id=project_id,
+                model_version_id=model_version_id,
+                deployment_id=did,
+                model_artifact_uri=mv.artifact_uri,
+                gpu=max(0, int(gpu)),
+            )
+
+        dep = Deployment(
+            id=did,
+            tenant_id=actor.tenant_id,
+            project_id=project_id,
+            model_version_id=model_version_id,
+            name=name,
+            backend=backend,
+            namespace=namespace,
+            service_name=svc_name,
+            url=url,
+            status="creating",
+            config={"gpu": gpu},
+        )
+        session.add(dep)
+        session.commit()
+        DEPLOY_TOTAL.labels(tenant=actor.tenant_id, backend=backend).inc()
+
+        record_audit_event(
+            actor.tenant_id,
+            actor.sub,
+            "deployment.create",
+            "deployment",
+            did,
+            decision="allow",
+            details={"backend": backend, "namespace": namespace, "service": svc_name, "url": url},
+        )
+        return {"deployment_id": did, "url": url, "service": svc_name, "namespace": namespace}
+    except HTTPException as e:
+        # record policy block
+        record_audit_event(actor.tenant_id, actor.sub, "deployment.create", "deployment", None, decision="block", details={"error": e.detail})
+        raise
+    except Exception as e:
+        session.rollback()
+        raise HTTPException(status_code=500, detail=str(e))
+    finally:
+        session.close()
+
+
+# ----------------- Inference Gateway (routes to deployment URL, meters usage) -----------------
+
+@app.post("/v1/infer", dependencies=[Depends(require_tenant_actor())])
+async def infer(
+    model_id: str = Form(...),
+    version: str = Form(...),
+    payload: str = Form(...),  # simplest v1; you can later accept JSON body
+    actor: Actor = Depends(require_actor),
+):
+    """
+    v1 inference gateway:
+    - resolves model+version -> latest deployment (by created_at)
+    - applies safety checks (block/flag)
+    - records usage record
+    - emits metrics
+    - returns a placeholder response (real routing is TODO)
+
+    In production, you'd forward to vLLM/Triton services. This patch focuses on platform wiring.
+    """
+    request_id = str(uuid.uuid4())
+
+    # Safety enforcement hook (uses api/safety.py)
+    enforce_and_maybe_block(
+        request_id=request_id,
+        user_obj={"username": actor.sub},
+        model_name=model_id,
+        version=version,
+        payload={"text": payload},
+    )
+
+    session = SessionLocal()
+    start = time.time()
+    backend = "unknown"
+    try:
+        # resolve model version
+        m = session.query(Model).filter_by(id=model_id, tenant_id=actor.tenant_id).one_or_none()
+        if not m:
+            raise HTTPException(status_code=404, detail="model not found")
+        mv = (
+            session.query(ModelVersion)
+            .filter_by(tenant_id=actor.tenant_id, model_id=model_id, version=version)
+            .one_or_none()
+        )
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+
+        dep = (
+            session.query(Deployment)
+            .filter_by(tenant_id=actor.tenant_id, model_version_id=mv.id)
+            .order_by(Deployment.created_at.desc())
+            .first()
+        )
+        if not dep:
+            raise HTTPException(status_code=409, detail="no deployment for model version")
+        backend = dep.backend
+
+        # TODO: Forward the request to dep.url (ClusterIP). For now return stub.
+        # In-cluster forwarding would typically use httpx.AsyncClient.
+        result = {"echo": payload, "model_id": model_id, "version": version, "deployment_url": dep.url}
+
+        elapsed_ms = (time.time() - start) * 1000.0
+        INFER_TOTAL.labels(tenant=actor.tenant_id, model=model_id, version=version, backend=backend).inc()
+        INFER_LAT_MS.labels(tenant=actor.tenant_id, model=model_id, version=version, backend=backend).observe(elapsed_ms)
+
+        # usage metering: 1 unit per request (replace with tokens/compute based metering later)
+        ur = UsageRecord(
+            tenant_id=actor.tenant_id,
+            model_name=model_id,
+            version=version,
+            units=1,
+            inference_ms=elapsed_ms,
+            cost_estimate=None,
+            extra={"backend": backend},
+        )
+        session.add(ur)
+        session.commit()
+
+        record_audit_event(actor.tenant_id, actor.sub, "infer", "deployment", dep.id, request_id=request_id, details={"backend": backend})
+        return {"request_id": request_id, "result": result}
+    finally:
+        session.close()
