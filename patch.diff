@@ -0,0 +1,140 @@
+"""
+Model artifact signing + verification.
+
+For v1 this module supports:
+1) "noop" mode for dev (unsigned allowed if configured).
+2) simple HMAC signing for dev/test.
+
+In production, wire to Vault Transit or KMS signing; you already have Vault scripts/docs in repo.
+"""
+
+from __future__ import annotations
+
+import os
+import hmac
+import hashlib
+from typing import Optional, Tuple
+
+
+SIGN_MODE = os.environ.get("AEGIS_SIGN_MODE", "hmac")  # hmac|noop
+HMAC_SECRET = os.environ.get("AEGIS_SIGN_HMAC_SECRET", "dev-sign-secret-change-me")
+
+
+def sign_sha256(hex_sha256: str) -> str:
+    if SIGN_MODE == "noop":
+        return ""
+    mac = hmac.new(HMAC_SECRET.encode("utf-8"), hex_sha256.encode("utf-8"), hashlib.sha256).hexdigest()
+    return mac
+
+
+def verify_sha256(hex_sha256: str, signature: Optional[str]) -> bool:
+    if SIGN_MODE == "noop":
+        # allow everything (dev)
+        return True
+    if not signature:
+        return False
+    expected = sign_sha256(hex_sha256)
+    return hmac.compare_digest(expected, signature)
