+def create_eval_job(
+    namespace: str,
+    job_name: str,
+    image: str,
+    env: Optional[Dict[str, str]] = None,
+    args: Optional[list[str]] = None,
+) -> str:
+    """
+    Create a simple Kubernetes Job for evaluation/training.
+    This is intentionally generic: you pass an image + args.
+    """
+    batch = _batch()
+    env_list = [client.V1EnvVar(name=k, value=v) for k, v in (env or {}).items()]
+    container = client.V1Container(
+        name="run",
+        image=image,
+        env=env_list,
+        args=args or [],
+    )
+    pod_spec = client.V1PodSpec(
+        restart_policy="Never",
+        containers=[container],
+        service_account_name=_jobs_service_account_name(),
+        automount_service_account_token=True,
+    )
+    template = client.V1PodTemplateSpec(
+        metadata=client.V1ObjectMeta(labels={"aegis.io/managed-by": "aegis-golden-api"}),
+        spec=pod_spec,
+    )
+    spec = client.V1JobSpec(template=template, backoff_limit=0)
+    body = client.V1Job(
+        metadata=client.V1ObjectMeta(name=job_name, namespace=namespace),
+        spec=spec,
+    )
+    batch.create_namespaced_job(namespace=namespace, body=body)
+    return job_name
+
+
+def get_job_status(namespace: str, job_name: str) -> str:
+    batch = _batch()
+    j = batch.read_namespaced_job(name=job_name, namespace=namespace)
+    st = j.status
+    if st.failed and st.failed > 0:
+        return "failed"
+    if st.succeeded and st.succeeded > 0:
+        return "succeeded"
+    if st.active and st.active > 0:
+        return "running"
+    return "pending"
+
 
