+@app.get("/v1/runs/{run_id}")
+async def get_run(request: Request, run_id: str):
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "tenant_developer", "tenant_user", "platform_admin"])
+    session = SessionLocal()
+    try:
+        run = session.query(Run).filter_by(id=run_id, tenant_id=actor.tenant_id).one_or_none()
+        if not run:
+            raise HTTPException(status_code=404, detail="run not found")
+
+        # reconcile status from K8s if possible
+        if run.k8s_namespace and run.k8s_job_name:
+            try:
+                st = get_job_status(run.k8s_namespace, run.k8s_job_name)
+                if st != run.status:
+                    run.status = st
+                    run.updated_at = time.time()  # not perfect, but ok for v1
+                    session.commit()
+            except Exception:
+                # Don't fail the request; just return last known status
+                pass
+
+        return {
+            "run_id": run.id,
+            "tenant_id": run.tenant_id,
+            "project_id": run.project_id,
+            "model_id": run.model_id,
+            "kind": run.kind,
+            "status": run.status,
+            "k8s_namespace": run.k8s_namespace,
+            "k8s_job_name": run.k8s_job_name,
+            "input": run.input,
+            "output": run.output,
+            "created_at": str(run.created_at),
