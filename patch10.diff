+# ------------------------ Runs: eval jobs ------------------------
+
+@app.post("/v1/runs/eval")
+async def create_eval_run(
+    request: Request,
+    project_id: str = Form(...),
+    model_id: str = Form(...),
+    model_version_id: str = Form(...),
+    image: Optional[str] = Form(None),
+    args: Optional[str] = Form(None),  # space-separated args for v1 simplicity
+):
+    """
+    Create a K8s Job to evaluate a model version.
+
+    This is a platform primitive:
+      - creates a Run row
+      - creates K8s job in tenant namespace
+      - user can poll run status
+
+    Your eval job should write results to object storage and/or report back out-of-band.
+    v1: we just track K8s job status.
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "tenant_developer", "platform_admin"])
+
+    session = SessionLocal()
+    try:
+        mv = session.query(ModelVersion).filter_by(id=model_version_id, tenant_id=actor.tenant_id).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+        # Ensure model belongs to tenant
+        m = session.query(Model).filter_by(id=model_id, tenant_id=actor.tenant_id, project_id=project_id).one_or_none()
+        if not m:
+            raise HTTPException(status_code=404, detail="model not found")
+
+        namespace = ensure_tenant_namespace(actor.tenant_id)
+        rid = str(uuid.uuid4())
+        job_name = f"aegis-eval-{rid[:8]}".lower()
+        img = image or DEFAULT_EVAL_IMAGE
+        arg_list = args.split(" ") if args else []
+
+        # Create K8s job
+        create_eval_job(
+            namespace=namespace,
+            job_name=job_name,
+            image=img,
+            env={
+                "AEGIS_TENANT_ID": actor.tenant_id,
+                "AEGIS_PROJECT_ID": project_id,
+                "AEGIS_MODEL_ID": model_id,
+                "AEGIS_MODEL_VERSION_ID": model_version_id,
+                "AEGIS_ARTIFACT_URI": mv.artifact_uri,
+                "AEGIS_ARTIFACT_SHA256": mv.artifact_sha256 or "",
+                "AEGIS_SIGNATURE": mv.signature or "",
+                "AEGIS_SIGNATURE_TYPE": mv.signature_type or SIGN_MODE,
+            },
+            args=arg_list,
+        )
+
+        run = Run(
+            id=rid,
+            tenant_id=actor.tenant_id,
+            project_id=project_id,
+            model_id=model_id,
+            kind="eval",
+            status="pending",
+            k8s_namespace=namespace,
+            k8s_job_name=job_name,
+            input={"image": img, "args": arg_list, "model_version_id": model_version_id},
+            output=None,
+        )
+        session.add(run)
+        session.commit()
+
+        record_audit_event(
+            actor.tenant_id,
+            actor.sub,
+            "run.create",
+            "run",
+            rid,
+            decision="allow",
+            details={"kind": "eval", "k8s_job": job_name, "namespace": namespace},
+        )
+        return {"run_id": rid, "k8s_job_name": job_name, "namespace": namespace}
+    finally:
+        session.close()
+
