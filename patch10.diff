+def _jobs_service_account_name() -> Optional[str]:
+    """
+    K8s Job SA (can differ from serving SA). In EKS, you can use IRSA here too.
+    """
+    return os.environ.get("AEGIS_JOBS_SERVICE_ACCOUNT", _serving_service_account_name())
