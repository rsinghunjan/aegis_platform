new file mode 100644
index 0000000..b74f95f
--- /dev/null
+++ b/api/golden_infer_metering.py
@@ -0,0 +1,116 @@
+from __future__ import annotations
+
+import os
+from typing import Any, Dict, Optional, Tuple
+
+
+CHARS_PER_UNIT = int(os.environ.get("AEGIS_CHARS_PER_UNIT", "400"))
+
+
+def estimate_units_from_text(text: str) -> int:
+    if not text:
+        return 1
+    return max(1, int((len(text) + CHARS_PER_UNIT - 1) / CHARS_PER_UNIT))
+
+
+def parse_vllm_openai_usage(resp_json: Dict[str, Any]) -> Tuple[Optional[int], Optional[int], Optional[int]]:
+    """
+    Parse OpenAI-style usage:
+      {"usage":{"prompt_tokens":..,"completion_tokens":..,"total_tokens":..}}
+    """
+    usage = resp_json.get("usage") if isinstance(resp_json, dict) else None
+    if not isinstance(usage, dict):
+        return None, None, None
+    pt = usage.get("prompt_tokens")
+    ct = usage.get("completion_tokens")
+    tt = usage.get("total_tokens")
+    try:
+        return (int(pt) if pt is not None else None, int(ct) if ct is not None else None, int(tt) if tt is not None else None)
+    except Exception:
+        return None, None, None
+
+
+def triton_compute_units(payload: str) -> Tuple[int, Optional[int], Optional[int]]:
+    """
+    Triton doesn't always return tokens. For v1 we meter based on payload size.
+    Return: (units, input_tokens, output_tokens)
+    """
+    units = estimate_units_from_text(payload)
+    return units, None, None
