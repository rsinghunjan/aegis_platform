 from __future__ import annotations
 
+import os
+import json
 from fastapi import HTTPException
 
 from api.golden_models import ModelVersion
 from api.golden_signing import verify_sha256, SIGN_MODE
 
 
 def require_signature_valid(mv: ModelVersion) -> None:
     if not mv.artifact_sha256:
         raise HTTPException(status_code=400, detail="model version missing artifact_sha256")
     if not verify_sha256(mv.artifact_sha256, mv.signature):
         raise HTTPException(status_code=403, detail="signature verification failed")
     # if present, enforce signature_type consistency
     if mv.signature_type and mv.signature_type != SIGN_MODE:
         # Example: prevent mixing modes if you want strictness.
         # You can relax this later (e.g., allow legacy hmac signatures) by changing this rule.
         raise HTTPException(
             status_code=403,
             detail=f"signature mode mismatch: stored={mv.signature_type} runtime={SIGN_MODE}",
         )
 
 
+def _metrics_thresholds() -> dict:
+    """
+    Configure thresholds as JSON:
+      AEGIS_DEPLOY_METRICS_THRESHOLDS='{"accuracy_min":0.9,"toxicity_max":0.02}'
+    """
+    raw = os.environ.get("AEGIS_DEPLOY_METRICS_THRESHOLDS", "").strip()
+    if not raw:
+        return {}
+    try:
+        return json.loads(raw)
+    except Exception as e:
+        raise RuntimeError(f"Invalid AEGIS_DEPLOY_METRICS_THRESHOLDS JSON: {e}")
+
+
+def require_metrics_thresholds(mv: ModelVersion) -> None:
+    """
+    Enforce basic metrics thresholds if configured.
+    Threshold keys:
+      - accuracy_min
+      - loss_max
+      - toxicity_max
+      - any custom key ending with _min or _max
+    """
+    thresholds = _metrics_thresholds()
+    if not thresholds:
+        return
+    if not mv.eval_metrics:
+        raise HTTPException(status_code=403, detail="deployment blocked: eval_metrics missing")
+
+    metrics = mv.eval_metrics or {}
+    for k, v in thresholds.items():
+        if k.endswith("_min"):
+            mk = k[: -len("_min")]
+            if metrics.get(mk) is None or float(metrics.get(mk)) < float(v):
+                raise HTTPException(status_code=403, detail=f"deployment blocked: metric {mk} below min {v}")
+        elif k.endswith("_max"):
+            mk = k[: -len("_max")]
+            if metrics.get(mk) is None or float(metrics.get(mk)) > float(v):
+                raise HTTPException(status_code=403, detail=f"deployment blocked: metric {mk} above max {v}")
+
+
 def require_deploy_allowed(mv: ModelVersion) -> None:
     if not mv.signed:
         raise HTTPException(status_code=403, detail="deployment blocked: model artifact is not signed")
     if mv.eval_status not in ("pass", "passed"):
         raise HTTPException(status_code=403, detail=f"deployment blocked: eval_status={mv.eval_status}")
     if not mv.approved:
         raise HTTPException(status_code=403, detail="deployment blocked: model version not approved")
+    # Evidence requirement (optional toggle)
+    require_evidence = os.environ.get("AEGIS_REQUIRE_EVAL_EVIDENCE", "true").lower() == "true"
+    if require_evidence and not mv.eval_evidence_uri:
+        raise HTTPException(status_code=403, detail="deployment blocked: eval_evidence_uri missing")
+    require_metrics_thresholds(mv)
