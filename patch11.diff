+@app.post("/v1/runs/train")
+async def create_training_run(
+    request: Request,
+    project_id: str = Form(...),
+    model_id: str = Form(...),
+    base_model_version_id: str = Form(...),
+    image: str = Form(...),
+    args: Optional[str] = Form(None),
+):
+    """
+    Standard training job spec (PyTorch/HF):
+      - job should write:
+          - metrics JSON to s3 evidence path
+          - model artifact to s3 output path (optional)
+      - job should POST callback to /v1/runs/{run_id}/callback with:
+          - metrics
+          - evidence_uri
+          - optional: set model_version eval fields
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "tenant_developer", "platform_admin"])
+    session = SessionLocal()
+    try:
+        namespace = ensure_tenant_namespace(actor.tenant_id)
+        rid = str(uuid.uuid4())
+        job_name = f"aegis-train-{rid[:8]}".lower()
+        arg_list = args.split(" ") if args else []
+
+        # Resolve base model version to get model/version info for evidence prefix
+        mv = session.query(ModelVersion).filter_by(id=base_model_version_id, tenant_id=actor.tenant_id).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="base model version not found")
+
+        bucket = os.environ.get("AEGIS_ARTIFACTS_BUCKET", "")
+        if not bucket:
+            raise HTTPException(status_code=500, detail="AEGIS_ARTIFACTS_BUCKET not set")
+
+        evid_prefix = evidence_prefix(actor.tenant_id, project_id, model_id, mv.version)
+        callback_url = os.environ.get("AEGIS_PUBLIC_BASE_URL", "").rstrip("/") + f"/v1/runs/{rid}/callback"
+        if not os.environ.get("AEGIS_PUBLIC_BASE_URL", "").strip():
+            # still allow job; callback can be disabled/handled out of band
+            callback_url = ""
+
+        contract = TrainingContract(
+            tenant_id=actor.tenant_id,
+            project_id=project_id,
+            model_id=model_id,
+            model_version_id=base_model_version_id,
+            run_id=rid,
+            evidence_bucket=bucket,
+            evidence_prefix=evid_prefix,
+            callback_url=callback_url,
+        )
+
+        create_eval_job(
+            namespace=namespace,
+            job_name=job_name,
+            image=image,
+            env=contract.env(),
+            args=arg_list,
+        )
+
+        run = Run(
+            id=rid,
+            tenant_id=actor.tenant_id,
+            project_id=project_id,
+            model_id=model_id,
+            kind="train",
+            status="pending",
+            k8s_namespace=namespace,
+            k8s_job_name=job_name,
+            input={"image": image, "args": arg_list, "base_model_version_id": base_model_version_id, "contract": contract.env()},
+            output=None,
+            evidence_uri=None,
+        )
+        session.add(run)
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "run.create", "run", rid, decision="allow", details={"kind": "train", "job": job_name})
+        return {"run_id": rid, "k8s_job_name": job_name, "namespace": namespace, "contract_env": contract.env()}
+    finally:
+        session.close()
+
+
+@app.post("/v1/runs/{run_id}/callback")
+async def run_callback(
+    request: Request,
+    run_id: str,
+    payload: Dict[str, Any] = Body(...),
+):
+    """
+    Run callback endpoint for jobs to post:
+      - metrics
+      - evidence_uri (s3://...)
+      - optional: model_version_id to update eval fields
+    Auth:
+      - For v1, reuse normal auth. In production, you should authenticate jobs with workload identity (mTLS/JWT) or signed payload.
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "tenant_developer", "platform_admin"])
+    session = SessionLocal()
+    try:
+        run = session.query(Run).filter_by(id=run_id, tenant_id=actor.tenant_id).one_or_none()
+        if not run:
+            raise HTTPException(status_code=404, detail="run not found")
+
+        metrics = payload.get("metrics") or {}
+        evidence_uri = payload.get("evidence_uri")
+        model_version_id = payload.get("model_version_id")
+
+        run.output = payload
+        run.evidence_uri = evidence_uri
+        run.status = payload.get("status") or run.status
+        session.commit()
+
+        # Optionally update model version with evidence+metrics and set eval_status.
+        if model_version_id:
+            mv = session.query(ModelVersion).filter_by(id=model_version_id, tenant_id=actor.tenant_id).one_or_none()
+            if mv:
+                mv.eval_metrics = metrics
+                mv.eval_evidence_uri = evidence_uri
+                # allow job to request pass/fail, but still require human approval
+                if payload.get("eval_status") in ("pass", "fail"):
+                    mv.eval_status = payload["eval_status"]
+                session.commit()
+
+        record_audit_event(actor.tenant_id, actor.sub, "run.callback", "run", run_id, decision="allow", details={"evidence_uri": evidence_uri})
+        return {"ok": True, "run_id": run_id}
+    finally:
+        session.close()
