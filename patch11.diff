+"""
+Standard training/eval job spec conventions for Aegis.
+
+Goal:
+- Provide a reproducible "contract" for PyTorch/HF jobs:
+  - write metrics JSON to S3
+  - write model artifacts to S3 (or register to Aegis separately)
+  - report back to Aegis callback endpoint with evidence URI + metrics
+
+This file defines environment variables expected by jobs.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, Any, Optional, List
+
+
+@dataclass(frozen=True)
+class TrainingContract:
+    # Provided to job
+    tenant_id: str
+    project_id: str
+    model_id: str
+    model_version_id: str
+    run_id: str
+
+    # Where job should write evidence
+    evidence_bucket: str
+    evidence_prefix: str  # <tenant>/<project>/<model>/<version>/evidence/
+
+    # Callback endpoint
+    callback_url: str  # e.g. https://aegis/api/v1/runs/<run_id>/callback
+
+    def env(self) -> Dict[str, str]:
+        return {
+            "AEGIS_TENANT_ID": self.tenant_id,
+            "AEGIS_PROJECT_ID": self.project_id,
+            "AEGIS_MODEL_ID": self.model_id,
+            "AEGIS_MODEL_VERSION_ID": self.model_version_id,
+            "AEGIS_RUN_ID": self.run_id,
+            "AEGIS_EVIDENCE_BUCKET": self.evidence_bucket,
+            "AEGIS_EVIDENCE_PREFIX": self.evidence_prefix,
+            "AEGIS_CALLBACK_URL": self.callback_url,
+        }
+
+
+def evidence_prefix(tenant_id: str, project_id: str, model_id: str, version: str) -> str:
+    return f"{tenant_id}/{project_id}/{model_id}/{version}/evidence"
