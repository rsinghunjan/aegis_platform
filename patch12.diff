+"""golden platform schema upgrades (evidence, autoscaling, tokens, runs)
+
+Revision ID: 0003_golden_platform_schema_upgrades
+Revises: 0002_add_safety_events
+Create Date: 2026-03-22
+
+This migration aligns the DB with the latest Golden Path schema additions:
+  - model_versions: eval_evidence_uri, eval_metrics, signature_type (if missing)
+  - deployments: autoscaling
+  - usage_records: input_tokens, output_tokens
+  - runs: evidence_uri
+
+Notes:
+  - This is written to be reasonably safe when tables/columns already exist,
+    but Alembic cannot perfectly "if exists" across all DBs without raw SQL.
+  - Target DB is Postgres (as configured in api/db.py default).
+"""
+
+from alembic import op
+import sqlalchemy as sa
+
+# revision identifiers, used by Alembic.
+revision = "0003_golden_platform_schema_upgrades"
+down_revision = "0002_add_safety_events"
+branch_labels = None
+depends_on = None
+
+
+def _has_column(table: str, column: str) -> bool:
+    bind = op.get_bind()
+    insp = sa.inspect(bind)
+    cols = [c["name"] for c in insp.get_columns(table)]
+    return column in cols
+
+
+def upgrade():
+    # --- model_versions upgrades ---
+    # Golden Path uses api/golden_models.py with table name "model_versions"
+    if op.get_bind().dialect.has_table(op.get_bind(), "model_versions"):
+        if not _has_column("model_versions", "signature_type"):
+            op.add_column("model_versions", sa.Column("signature_type", sa.String(length=50), nullable=True))
+        if not _has_column("model_versions", "eval_evidence_uri"):
+            op.add_column("model_versions", sa.Column("eval_evidence_uri", sa.String(length=2000), nullable=True))
+        if not _has_column("model_versions", "eval_metrics"):
+            op.add_column("model_versions", sa.Column("eval_metrics", sa.JSON(), nullable=True))
+
+        # Helpful index for evidence lookups
+        try:
+            op.create_index("ix_model_versions_eval_evidence_uri", "model_versions", ["eval_evidence_uri"])
+        except Exception:
+            # index may already exist
+            pass
+
+    # --- deployments upgrades ---
+    if op.get_bind().dialect.has_table(op.get_bind(), "deployments"):
+        if not _has_column("deployments", "autoscaling"):
+            op.add_column("deployments", sa.Column("autoscaling", sa.JSON(), nullable=True))
+
+    # --- usage_records upgrades ---
+    if op.get_bind().dialect.has_table(op.get_bind(), "usage_records"):
+        if not _has_column("usage_records", "input_tokens"):
+            op.add_column("usage_records", sa.Column("input_tokens", sa.Integer(), nullable=True))
+        if not _has_column("usage_records", "output_tokens"):
+            op.add_column("usage_records", sa.Column("output_tokens", sa.Integer(), nullable=True))
+
+        try:
+            op.create_index("ix_usage_records_tokens", "usage_records", ["tenant_id", "model_id", "version"])
+        except Exception:
+            pass
+
+    # --- runs upgrades ---
+    if op.get_bind().dialect.has_table(op.get_bind(), "runs"):
+        if not _has_column("runs", "evidence_uri"):
+            op.add_column("runs", sa.Column("evidence_uri", sa.String(length=2000), nullable=True))
+
+        try:
+            op.create_index("ix_runs_evidence_uri", "runs", ["tenant_id", "evidence_uri"])
+        except Exception:
+            pass
+
+
+def downgrade():
+    # Reverse order; drop indexes best-effort.
+
+    if op.get_bind().dialect.has_table(op.get_bind(), "runs"):
+        try:
+            op.drop_index("ix_runs_evidence_uri", table_name="runs")
+        except Exception:
+            pass
+        if _has_column("runs", "evidence_uri"):
+            op.drop_column("runs", "evidence_uri")
+
+    if op.get_bind().dialect.has_table(op.get_bind(), "usage_records"):
+        try:
+            op.drop_index("ix_usage_records_tokens", table_name="usage_records")
+        except Exception:
+            pass
+        if _has_column("usage_records", "output_tokens"):
+            op.drop_column("usage_records", "output_tokens")
+        if _has_column("usage_records", "input_tokens"):
+            op.drop_column("usage_records", "input_tokens")
+
+    if op.get_bind().dialect.has_table(op.get_bind(), "deployments"):
+        if _has_column("deployments", "autoscaling"):
+            op.drop_column("deployments", "autoscaling")
+
+    if op.get_bind().dialect.has_table(op.get_bind(), "model_versions"):
+        try:
+            op.drop_index("ix_model_versions_eval_evidence_uri", table_name="model_versions")
+        except Exception:
+            pass
+        if _has_column("model_versions", "eval_metrics"):
+            op.drop_column("model_versions", "eval_metrics")
+        if _has_column("model_versions", "eval_evidence_uri"):
+            op.drop_column("model_versions", "eval_evidence_uri")
+        if _has_column("model_versions", "signature_type"):
+            op.drop_column("model_versions", "signature_type")
