+"""
+Argo Workflows integration (minimal).
+
+This module submits Workflow CRs via the Kubernetes CustomObjects API.
+It is intentionally minimal and generic: you provide an Argo workflow spec template
+and Aegis fills in standard parameters (tenant/project/model/version/run_id, evidence paths).
+
+Requires:
+  - Argo Workflows installed in cluster
+  - K8s RBAC allowing Aegis API service account to create workflows
+"""
+
+from __future__ import annotations
+
+import os
+import uuid
+from typing import Any, Dict, Optional
+
+from kubernetes import client, config
+
+
+def _load_k8s():
+    mode = os.environ.get("AEGIS_K8S_CONFIG", "auto")  # auto|incluster|kubeconfig
+    if mode == "incluster":
+        config.load_incluster_config()
+        return
+    if mode == "kubeconfig":
+        config.load_kube_config()
+        return
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+
+
+def _coapi() -> client.CustomObjectsApi:
+    _load_k8s()
+    return client.CustomObjectsApi()
+
+
+ARGO_GROUP = os.environ.get("AEGIS_ARGO_GROUP", "argoproj.io")
+ARGO_VERSION = os.environ.get("AEGIS_ARGO_VERSION", "v1alpha1")
+ARGO_PLURAL = os.environ.get("AEGIS_ARGO_PLURAL", "workflows")
+
+
+def submit_workflow(
+    namespace: str,
+    workflow: Dict[str, Any],
+) -> str:
+    """
+    Submit an Argo Workflow CR and return workflow name.
+    """
+    api = _coapi()
+    obj = api.create_namespaced_custom_object(
+        group=ARGO_GROUP,
+        version=ARGO_VERSION,
+        namespace=namespace,
+        plural=ARGO_PLURAL,
+        body=workflow,
+    )
+    return obj["metadata"]["name"]
+
+
+def workflow_template_train_eval(
+    name_prefix: str,
+    image: str,
+    command: Optional[list[str]] = None,
+    args: Optional[list[str]] = None,
+    parameters: Optional[Dict[str, str]] = None,
+) -> Dict[str, Any]:
+    """
+    Minimal Argo Workflow template with one container step.
+    """
+    wf_name = f"{name_prefix}-{uuid.uuid4().hex[:8]}"
+    params = parameters or {}
+    wf = {
+        "apiVersion": f"{ARGO_GROUP}/{ARGO_VERSION}",
+        "kind": "Workflow",
+        "metadata": {"name": wf_name},
+        "spec": {
+            "entrypoint": "main",
+            "arguments": {
+                "parameters": [{"name": k, "value": v} for k, v in params.items()]
+            },
+            "templates": [
+                {
+                    "name": "main",
+                    "container": {
+                        "image": image,
+                        "command": command or [],
+                        "args": args or [],
+                        "env": [{"name": k, "value": v} for k, v in params.items()],
+                    },
+                }
+            ],
+        },
+    }
+    return wf
