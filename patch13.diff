@@ -0,0 +1,195 @@
+from __future__ import annotations
+
+import os
+import json
+import time
+import hmac
+import hashlib
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+
+from api.golden_store import put_json
+
+
+EVIDENCE_SIGN_SECRET = os.environ.get("AEGIS_EVIDENCE_HMAC_SECRET", "")
+
+
+def sign_payload(payload: Dict[str, Any]) -> str:
+    """
+    Sign a JSON payload deterministically using HMAC SHA256.
+    This is a stepping stone; production should use workload identity (OIDC) or Vault.
+    """
+    if not EVIDENCE_SIGN_SECRET:
+        raise RuntimeError("AEGIS_EVIDENCE_HMAC_SECRET not set")
+    b = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hmac.new(EVIDENCE_SIGN_SECRET.encode("utf-8"), b, hashlib.sha256).hexdigest()
+
+
+def verify_signature(payload: Dict[str, Any], signature: str) -> bool:
+    if not EVIDENCE_SIGN_SECRET:
+        return False
+    expected = sign_payload(payload)
+    return hmac.compare_digest(expected, signature or "")
+
+
+@dataclass(frozen=True)
+class EvidencePack:
+    """
+    Standardized evidence pack written to S3.
+    """
+    tenant_id: str
+    project_id: str
+    model_id: str
+    version: str
+    run_id: str
+    kind: str  # train|eval
+    metrics: Dict[str, Any]
+    evidence_uri: str
+    created_at: float
+    extra: Dict[str, Any]
+
+    def as_dict(self) -> Dict[str, Any]:
+        return {
+            "schema": "aegis.evidence.v1",
+            "tenant_id": self.tenant_id,
+            "project_id": self.project_id,
+            "model_id": self.model_id,
+            "version": self.version,
+            "run_id": self.run_id,
+            "kind": self.kind,
+            "metrics": self.metrics,
+            "evidence_uri": self.evidence_uri,
+            "created_at": self.created_at,
+            "extra": self.extra,
+        }
+
+
+def write_evidence_manifest(
+    tenant_id: str,
+    project_id: str,
+    model_id: str,
+    version: str,
+    run_id: str,
+    kind: str,
+    metrics: Dict[str, Any],
+    evidence_uri: str,
+    extra: Optional[Dict[str, Any]] = None,
+) -> str:
+    """
+    Write standardized manifest to S3 at:
+      s3://bucket/<tenant>/<project>/<model>/<version>/evidence/manifest-<run_id>.json
+    """
+    pack = EvidencePack(
+        tenant_id=tenant_id,
+        project_id=project_id,
+        model_id=model_id,
+        version=version,
+        run_id=run_id,
+        kind=kind,
+        metrics=metrics or {},
+        evidence_uri=evidence_uri,
+        created_at=time.time(),
+        extra=extra or {},
+    )
+    return put_json(
+        tenant_id=tenant_id,
+        project_id=project_id,
+        model_id=model_id,
+        version=version,
+        name=f"manifest-{run_id}.json",
+        obj=pack.as_dict(),
+    )
