+from __future__ import annotations
+
+from typing import Any, AsyncIterator, Dict, Optional, Tuple
+
+import httpx
+
+
+def openai_chat_body_from_form(model: str, content: str, temperature: float = 0.0, stream: bool = False) -> Dict[str, Any]:
+    return {
+        "model": model,
+        "messages": [{"role": "user", "content": content}],
+        "temperature": temperature,
+        "stream": stream,
+    }
+
+
+def parse_openai_usage_from_json(resp_json: Dict[str, Any]) -> Tuple[Optional[int], Optional[int], Optional[int]]:
+    usage = resp_json.get("usage") if isinstance(resp_json, dict) else None
+    if not isinstance(usage, dict):
+        return None, None, None
+    pt = usage.get("prompt_tokens")
+    ct = usage.get("completion_tokens")
+    tt = usage.get("total_tokens")
+    try:
+        return (int(pt) if pt is not None else None, int(ct) if ct is not None else None, int(tt) if tt is not None else None)
+    except Exception:
+        return None, None, None
+
+
+async def passthrough_stream(
+    client: httpx.AsyncClient,
+    method: str,
+    url: str,
+    json_body: Dict[str, Any],
+) -> Tuple[AsyncIterator[bytes], str]:
+    """
+    Returns: (byte iterator, content-type)
+    """
+    r = await client.stream(method, url, json=json_body)
+    r.raise_for_status()
+    content_type = r.headers.get("content-type", "text/event-stream")
+
+    async def gen() -> AsyncIterator[bytes]:
+        async for chunk in r.aiter_raw():
+            yield chunk
+
+    return gen(), content_type
