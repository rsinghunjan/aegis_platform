@@ -0,0 +1,139 @@
+from __future__ import annotations
+
+from datetime import datetime, timedelta
+from typing import Any, Dict
+
+from sqlalchemy import func
+
+from api.db import SessionLocal
+from api.golden_models import UsageRecord, AuditEvent, CostEvent
+
+
+def usage_summary(tenant_id: str, days: int = 7) -> Dict[str, Any]:
+    since = datetime.utcnow() - timedelta(days=days)
+    s = SessionLocal()
+    try:
+        q = (
+            s.query(
+                UsageRecord.backend,
+                func.count(UsageRecord.id),
+                func.sum(UsageRecord.units),
+                func.sum(UsageRecord.cost_usd),
+                func.avg(UsageRecord.inference_ms),
+            )
+            .filter(UsageRecord.tenant_id == tenant_id)
+            .filter(UsageRecord.created_at >= since)
+            .group_by(UsageRecord.backend)
+            .all()
+        )
+        rows = []
+        for backend, cnt, units, cost, avg_ms in q:
+            rows.append(
+                {
+                    "backend": backend,
+                    "requests": int(cnt or 0),
+                    "units": int(units or 0),
+                    "cost_usd": float(cost or 0.0),
+                    "avg_inference_ms": float(avg_ms or 0.0) if avg_ms is not None else None,
+                }
+            )
+        return {"tenant_id": tenant_id, "days": days, "by_backend": rows}
+    finally:
+        s.close()
+
+
+def audit_summary(tenant_id: str, days: int = 7) -> Dict[str, Any]:
+    since = datetime.utcnow() - timedelta(days=days)
+    s = SessionLocal()
+    try:
+        total = s.query(func.count(AuditEvent.id)).filter(AuditEvent.tenant_id == tenant_id).filter(AuditEvent.created_at >= since).scalar()
+        by_action = (
+            s.query(AuditEvent.action, func.count(AuditEvent.id))
+            .filter(AuditEvent.tenant_id == tenant_id)
+            .filter(AuditEvent.created_at >= since)
+            .group_by(AuditEvent.action)
+            .all()
+        )
+        return {
+            "tenant_id": tenant_id,
+            "days": days,
+            "total_events": int(total or 0),
+            "by_action": [{"action": a, "count": int(c)} for a, c in by_action],
+        }
+    finally:
+        s.close()
diff --git a/api/golden_retention.py b/api/golden_retention.py
