+from __future__ import annotations
+
+import os
+from typing import Optional, Tuple
+
+
+def estimate_infer_cost_usd(units: int, backend: str) -> float:
+    """
+    Simple configurable cost model.
+
+    Env:
+      AEGIS_COST_PER_UNIT_USD_VLLM
+      AEGIS_COST_PER_UNIT_USD_TRITON
+      AEGIS_COST_PER_UNIT_USD_DEFAULT
+    """
+    backend = (backend or "").lower()
+    if backend == "vllm":
+        cpu = float(os.environ.get("AEGIS_COST_PER_UNIT_USD_VLLM", "0.00002"))
+    elif backend == "triton":
+        cpu = float(os.environ.get("AEGIS_COST_PER_UNIT_USD_TRITON", "0.00001"))
+    else:
+        cpu = float(os.environ.get("AEGIS_COST_PER_UNIT_USD_DEFAULT", "0.00001"))
+    return float(units) * cpu
+
+
+def estimate_training_cost_usd(gpu_hours: float = 0.0, cpu_hours: float = 0.0) -> float:
+    """
+    Placeholder; wire to cloud billing later.
+    """
+    gpu_rate = float(os.environ.get("AEGIS_COST_PER_GPU_HOUR_USD", "1.25"))
+    cpu_rate = float(os.environ.get("AEGIS_COST_PER_CPU_HOUR_USD", "0.05"))
+    return gpu_hours * gpu_rate + cpu_hours * cpu_rate
