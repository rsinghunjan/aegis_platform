diff --git a/terraform/aws/main.tf b/terraform/aws/main.tf
new file mode 100644
index 0000000..c1f9f6a
--- /dev/null
+++ b/terraform/aws/main.tf
@@ -0,0 +1,45 @@
+terraform {
+  required_version = ">= 1.5.0"
+  required_providers {
+    aws = {
+      source  = "hashicorp/aws"
+      version = ">= 5.0"
+    }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+# Minimal: S3 bucket for artifacts/evidence (use existing in prod)
+resource "aws_s3_bucket" "aegis_artifacts" {
+  bucket = var.artifacts_bucket_name
+}
+
+# Add lifecycle rule for evidence retention (example)
+resource "aws_s3_bucket_lifecycle_configuration" "aegis_lifecycle" {
+  bucket = aws_s3_bucket.aegis_artifacts.id
+  rule {
+    id     = "evidence-retention"
+    status = "Enabled"
+    filter { prefix = "" }
+    expiration {
+      days = var.evidence_retention_days
+    }
+  }
+}
