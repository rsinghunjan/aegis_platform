+"""
+Hugging Face / PyTorch training job helpers.
+
+This does NOT execute training itself; it standardizes how Aegis launches the job
+and what the job is expected to produce (metrics + evidence pack).
+"""
+
+from __future__ import annotations
+
+from typing import Dict, List, Optional
+
+
+def hf_train_args(
+    base_model: str,
+    dataset: str,
+    output_dir: str = "/work/out",
+    epochs: int = 1,
+    lr: float = 2e-5,
+    batch_size: int = 1,
+) -> List[str]:
+    """
+    Default args for a common HF training entrypoint.
+    You can replace with your own container entrypoint that consumes these args.
+    """
+    return [
+        "--base_model",
+        base_model,
+        "--dataset",
+        dataset,
+        "--output_dir",
+        output_dir,
+        "--epochs",
+        str(epochs),
+        "--learning_rate",
+        str(lr),
+        "--batch_size",
+        str(batch_size),
+    ]
+
+
+def hf_env(
+    s3_bucket: str,
+    s3_prefix: str,
+    callback_url: str,
+) -> Dict[str, str]:
+    return {
+        "AEGIS_EVIDENCE_BUCKET": s3_bucket,
+        "AEGIS_EVIDENCE_PREFIX": s3_prefix,
+        "AEGIS_CALLBACK_URL": callback_url,
+    }
