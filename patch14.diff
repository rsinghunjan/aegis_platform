+"""fully ai schema expansion (cost, retention, model cards, run metrics)
+
+Revision ID: 0004_fully_ai_schema_expansion
+Revises: 0003_golden_platform_schema_upgrades
+Create Date: 2026-03-22
+"""
+
+from alembic import op
+import sqlalchemy as sa
+
+revision = "0004_fully_ai_schema_expansion"
+down_revision = "0003_golden_platform_schema_upgrades"
+branch_labels = None
+depends_on = None
+
+
+def _has_column(table: str, column: str) -> bool:
+    bind = op.get_bind()
+    insp = sa.inspect(bind)
+    cols = [c["name"] for c in insp.get_columns(table)]
+    return column in cols
+
+
+def upgrade():
+    bind = op.get_bind()
+    dialect = bind.dialect
+
+    # model_versions: model_card_uri
+    if dialect.has_table(bind, "model_versions"):
+        if not _has_column("model_versions", "model_card_uri"):
+            op.add_column("model_versions", sa.Column("model_card_uri", sa.String(length=2000), nullable=True))
+
+    # deployments: limits
+    if dialect.has_table(bind, "deployments"):
+        if not _has_column("deployments", "limits"):
+            op.add_column("deployments", sa.Column("limits", sa.JSON(), nullable=True))
+
+    # runs: metrics
+    if dialect.has_table(bind, "runs"):
+        if not _has_column("runs", "metrics"):
+            op.add_column("runs", sa.Column("metrics", sa.JSON(), nullable=True))
+
+    # usage_records: cost_usd
+    if dialect.has_table(bind, "usage_records"):
+        if not _has_column("usage_records", "cost_usd"):
+            op.add_column("usage_records", sa.Column("cost_usd", sa.Float(), nullable=True))
+
+    # new tables: cost_events, retention_policies
+    if not dialect.has_table(bind, "cost_events"):
+        op.create_table(
+            "cost_events",
