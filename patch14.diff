index 0000000..3c9d68c
--- /dev/null
+++ b/api/golden_retention.py
@@ -0,0 +1,127 @@
+from __future__ import annotations
+
+from datetime import datetime, timedelta
+from typing import Dict
+
+from api.db import SessionLocal
+from api.golden_models import RetentionPolicy, AuditEvent, UsageRecord, Run
+
+
+DEFAULT_DAYS = 90
+
+
+def get_policy_days(tenant_id: str, resource_type: str) -> int:
+    s = SessionLocal()
+    try:
+        p = s.query(RetentionPolicy).filter_by(tenant_id=tenant_id, resource_type=resource_type).one_or_none()
+        return int(p.days) if p else DEFAULT_DAYS
+    finally:
+        s.close()
+
+
+def prune_tenant(tenant_id: str) -> Dict[str, int]:
+    """
+    Prune DB rows older than retention policies. This is DB-only pruning.
+    Evidence in S3 should be pruned via S3 lifecycle rules (recommended) or a dedicated worker.
+    """
+    s = SessionLocal()
+    try:
+        out = {"audit_events": 0, "usage_records": 0, "runs": 0}
+
+        audit_days = get_policy_days(tenant_id, "audit_events")
+        usage_days = get_policy_days(tenant_id, "usage_records")
+        runs_days = get_policy_days(tenant_id, "runs")
+
+        audit_cutoff = datetime.utcnow() - timedelta(days=audit_days)
+        usage_cutoff = datetime.utcnow() - timedelta(days=usage_days)
+        runs_cutoff = datetime.utcnow() - timedelta(days=runs_days)
+
+        out["audit_events"] = s.query(AuditEvent).filter(AuditEvent.tenant_id == tenant_id).filter(AuditEvent.created_at < audit_cutoff).delete()
+        out["usage_records"] = s.query(UsageRecord).filter(UsageRecord.tenant_id == tenant_id).filter(UsageRecord.created_at < usage_cutoff).delete()
+        out["runs"] = s.query(Run).filter(Run.tenant_id == tenant_id).filter(Run.created_at < runs_cutoff).delete()
+
+        s.commit()
+        return out
+    except Exception:
+        s.rollback()
+        raise
+    finally:
+        s.close()
