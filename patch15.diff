new file mode 100644
index 0000000..bf6a7c2
--- /dev/null
+++ b/api/golden_sse.py
@@ -0,0 +1,170 @@
+from __future__ import annotations
+
+import json
+from typing import Any, Dict, Iterable, Optional, Tuple
+
+
+def _iter_sse_events(raw: bytes) -> Iterable[str]:
+    """
+    Split an SSE chunk into potential event payloads.
+    SSE frames can be fragmented; this helper is best-effort and expects the upstream
+    to flush on event boundaries fairly often (common with vLLM/OpenAI style streaming).
+    """
+    try:
+        s = raw.decode("utf-8", errors="ignore")
+    except Exception:
+        return []
+    # Each SSE line often begins with "data: ..."
+    lines = s.splitlines()
+    out = []
+    for ln in lines:
+        ln = ln.strip()
+        if not ln.startswith("data:"):
+            continue
+        out.append(ln[len("data:") :].strip())
+    return out
+
+
+def extract_openai_delta_text(data_json: Dict[str, Any]) -> str:
+    """
+    OpenAI chat completion streaming shape:
+      {"choices":[{"delta":{"content":"..."}}]}
+    Some servers use {"choices":[{"delta":{"role":"assistant","content":"..."}}]}
+    """
+    try:
+        choices = data_json.get("choices") or []
+        if not choices:
+            return ""
+        delta = (choices[0] or {}).get("delta") or {}
+        content = delta.get("content")
+        if isinstance(content, str):
+            return content
+    except Exception:
+        return ""
+    return ""
+
+
+def parse_stream_chunk_for_text(raw: bytes) -> Tuple[str, bool]:
+    """
+    Returns: (delta_text, done)
+    """
+    delta_text = ""
+    done = False
+    for payload in _iter_sse_events(raw):
+        if payload == "[DONE]":
+            done = True
+            continue
+        try:
+            j = json.loads(payload)
+        except Exception:
+            continue
+        delta_text += extract_openai_delta_text(j)
+    return delta_text, done
