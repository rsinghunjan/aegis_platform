@@ -0,0 +1,115 @@
+"""
+Token counting for streaming metering.
+
+Preferred: tiktoken (OpenAI-compatible tokenization for many LLMs).
+Fallback: whitespace/char heuristic.
+
+Env:
+  AEGIS_TOKENIZER = tiktoken|heuristic
+  AEGIS_TIKTOKEN_ENCODING = cl100k_base (default)
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Optional
+
+
+TOKENIZER = os.environ.get("AEGIS_TOKENIZER", "tiktoken")
+TIKTOKEN_ENCODING = os.environ.get("AEGIS_TIKTOKEN_ENCODING", "cl100k_base")
+
+
+class TokenCounter:
+    def __init__(self):
+        self._enc = None
+        if TOKENIZER == "tiktoken":
+            try:
+                import tiktoken  # type: ignore
+
+                self._enc = tiktoken.get_encoding(TIKTOKEN_ENCODING)
+            except Exception:
+                self._enc = None
+
+    def count(self, text: str) -> int:
+        if not text:
+            return 0
+        if self._enc is not None:
+            return len(self._enc.encode(text))
+        # fallback heuristic: ~4 chars/token
+        return max(1, int(len(text) / 4))
