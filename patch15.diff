@@ -0,0 +1,185 @@
+"""
+Workload identity support for jobs calling back into Aegis without shared HMAC secrets.
+
+Pattern:
+  - Use OIDC/JWKS verification already in place
+  - Jobs obtain a JWT (e.g., Kubernetes projected service account token with an OIDC issuer,
+    or an external identity provider) that includes a claim indicating it is a workload.
+
+Env:
+  AEGIS_WORKLOAD_CLAIM = "workload" (default)
+  AEGIS_WORKLOAD_ALLOWED = "true"|"false" (default true)
+  AEGIS_WORKLOAD_ROLES = "aegis_job" (comma-separated)
+
+We treat workloads as separate from human roles; they must include one of AEGIS_WORKLOAD_ROLES.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any, Dict, List, Optional
+
+from api.golden_auth import Actor
+
+
+WORKLOAD_ALLOWED = os.environ.get("AEGIS_WORKLOAD_ALLOWED", "true").lower() == "true"
+WORKLOAD_CLAIM = os.environ.get("AEGIS_WORKLOAD_CLAIM", "workload")
+WORKLOAD_ROLES = [r.strip() for r in os.environ.get("AEGIS_WORKLOAD_ROLES", "aegis_job").split(",") if r.strip()]
+
+
+def is_workload(actor: Actor) -> bool:
+    if not WORKLOAD_ALLOWED:
+        return False
+    flag = actor.raw_claims.get(WORKLOAD_CLAIM)
+    if flag is True:
+        return True
+    if isinstance(flag, str) and flag.lower() in ("true", "1", "yes"):
+        return True
+    return False
+
+
+def require_workload_role(actor: Actor) -> None:
+    if not is_workload(actor):
+        raise PermissionError("not a workload identity")
+    if not any(r in actor.roles for r in WORKLOAD_ROLES):
+        raise PermissionError(f"missing workload role; need one of {WORKLOAD_ROLES}")
