--- /dev/null
+++ b/api/k8s_client.py
@@ -0,0 +1,69 @@
+from __future__ import annotations
+
+import os
+
+from kubernetes import client, config
+
+
+def load_k8s():
+    """
+    Loads Kubernetes configuration.
+      AEGIS_K8S_CONFIG=auto|incluster|kubeconfig
+    """
+    mode = os.environ.get("AEGIS_K8S_CONFIG", "auto")
+    if mode == "incluster":
+        config.load_incluster_config()
+        return
+    if mode == "kubeconfig":
+        config.load_kube_config()
+        return
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+
+
+def core_api() -> client.CoreV1Api:
+    load_k8s()
+    return client.CoreV1Api()
+
+
+def apps_api() -> client.AppsV1Api:
+    load_k8s()
+    return client.AppsV1Api()
diff --git a/api/k8s_tenant.py b/api/k8s_tenant.py
new file mode 100644
index 0000000..7f7b1c7
--- /dev/null
+++ b/api/k8s_tenant.py
@@ -0,0 +1,78 @@
+from __future__ import annotations
+
+from kubernetes.client import V1Namespace, V1ObjectMeta
+from kubernetes.client.rest import ApiException
+
+from api.k8s_client import core_api
+
+
+def ensure_tenant_namespace(tenant_id: str) -> str:
+    """
+    Namespace-per-tenant:
+      aegis-<tenant_id>
+    """
+    ns = f"aegis-{tenant_id}"
+    api = core_api()
+    try:
+        api.read_namespace(ns)
+        return ns
+    except ApiException as e:
+        if e.status != 404:
+            raise
+
+    body = V1Namespace(
+        metadata=V1ObjectMeta(
+            name=ns,
+            labels={
+                "aegis.io/tenant": tenant_id,
+                "aegis.io/managed-by": "aegis-api",
+            },
+        )
+    )
+    api.create_namespace(body=body)
+    return ns
