+"""
+DB bootstrap for Aegis platform.
+
+This intentionally supports BOTH:
+  - Base.metadata.create_all() for first-run/dev bootstrap
+  - Alembic migrations for production upgrades
+
+Recommended pattern:
+  - In dev: run this once.
+  - In prod: run Alembic, but keeping create_all makes "fresh install" easy.
+
+Usage:
+  python -m api.bootstrap_db
+"""
+
+import logging
+
+from api.db import Base, engine
+
+# Import models so they register with Base.metadata
+from api import models_platform  # noqa: F401
+
+logger = logging.getLogger("aegis.bootstrap_db")
+
+
+def bootstrap():
+    logger.info("Creating tables via Base.metadata.create_all() ...")
+    Base.metadata.create_all(bind=engine)
+    logger.info("Done.")
+
+
+if __name__ == "__main__":
+    logging.basicConfig(level=logging.INFO)
+    bootstrap()
