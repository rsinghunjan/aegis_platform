@@ -0,0 +1,154 @@
+"""
+Signing and signature verification for model artifacts.
+
+v1 implementation supports:
+  - noop: accept everything (dev only)
+  - hmac: sign sha256 using an HMAC secret (dev/test)
+
+Production:
+  - swap to Vault Transit/KMS. Your repo already includes Vault OIDC/Transit docs/scripts.
+"""
+
+from __future__ import annotations
+
+import os
+import hmac
+import hashlib
+from typing import Optional
+
+
+SIGN_MODE = os.environ.get("AEGIS_SIGN_MODE", "hmac")  # noop|hmac
+HMAC_SECRET = os.environ.get("AEGIS_SIGN_HMAC_SECRET", "dev-sign-secret-change-me")
+
+
+def sign_sha256(hex_sha256: str) -> str:
+    if SIGN_MODE == "noop":
+        return ""
+    mac = hmac.new(HMAC_SECRET.encode("utf-8"), hex_sha256.encode("utf-8"), hashlib.sha256).hexdigest()
+    return mac
+
+
+def verify_sha256(hex_sha256: str, signature: Optional[str]) -> bool:
+    if SIGN_MODE == "noop":
+        return True
+    if not signature:
+        return False
+    expected = sign_sha256(hex_sha256)
+    return hmac.compare_digest(expected, signature)
