+import logging
+from typing import Any, Dict, Optional
+
+from api.db import SessionLocal
+from api.models_platform import AuditEvent
+
+logger = logging.getLogger("aegis.audit_platform")
+
+
+def record_audit_event(
+    tenant_id: Optional[str],
+    actor: str,
+    action: str,
+    resource_type: Optional[str] = None,
+    resource_id: Optional[str] = None,
+    request_id: Optional[str] = None,
+    decision: Optional[str] = None,
+    details: Optional[Dict[str, Any]] = None,
+) -> None:
+    session = SessionLocal()
+    try:
+        ev = AuditEvent(
+            tenant_id=tenant_id,
+            actor=actor,
+            action=action,
+            resource_type=resource_type,
+            resource_id=resource_id,
+            request_id=request_id,
+            decision=decision,
+            details=details or {},
+        )
+        session.add(ev)
+        session.commit()
+    except Exception:
+        session.rollback()
+        logger.exception("failed to record audit event")
+    finally:
+        session.close()
diff --git a/api/s3_store.py b/api/s3_store.py
new file mode 100644
index 0000000..0bfc2b1
--- /dev/null
+++ b/api/s3_store.py
@@ -0,0 +1,164 @@
+from __future__ import annotations
+
+import os
+import hashlib
+from typing import Tuple, Optional
+
+import boto3
+
+
+def _client():
+    """
+    Works with:
+      - AWS S3 (no endpoint_url)
+      - MinIO (endpoint_url=http://minio.<ns>.svc:9000)
+
+    Env:
+      AEGIS_S3_ENDPOINT_URL (optional)
+      AEGIS_S3_REGION (default us-east-1)
+      AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN as usual
+    """
+    endpoint_url = os.environ.get("AEGIS_S3_ENDPOINT_URL", None)
+    region = os.environ.get("AEGIS_S3_REGION", "us-east-1")
+    return boto3.client("s3", region_name=region, endpoint_url=endpoint_url)
+
+
+def sha256_file(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def put_artifact(
+    tenant_id: str,
+    project_id: str,
+    model_id: str,
+    version: str,
+    local_path: str,
+    content_type: Optional[str] = None,
+) -> Tuple[str, str]:
+    """
+    Consistent object key:
+      <tenant>/<project>/<model>/<version>/artifact
+
+    Returns:
+      (artifact_uri, sha256)
+    """
+    bucket = os.environ.get("AEGIS_ARTIFACTS_BUCKET", "")
+    if not bucket:
+        raise RuntimeError("AEGIS_ARTIFACTS_BUCKET not set")
+
+    digest = sha256_file(local_path)
+    key = f"{tenant_id}/{project_id}/{model_id}/{version}/artifact"
+
+    extra = {}
+    if content_type:
+        extra["ContentType"] = content_type
+
+    c = _client()
+    c.upload_file(local_path, bucket, key, ExtraArgs=extra or None)
+    return f"s3://{bucket}/{key}", digest
