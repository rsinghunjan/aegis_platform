+"""
+Golden-path artifact signing.
+
+Dev/test:
+  - HMAC signature of sha256
+
+Production:
+  - replace with Vault Transit/KMS signing (your repo already has Vault OIDC/Transit docs/scripts).
+"""
+
+from __future__ import annotations
+
+import os
+import hmac
+import hashlib
+from typing import Optional
+
+
+SIGN_MODE = os.environ.get("AEGIS_SIGN_MODE", "hmac")  # noop|hmac
+HMAC_SECRET = os.environ.get("AEGIS_SIGN_HMAC_SECRET", "dev-sign-secret-change-me")
+
+
+def sign_sha256(hex_sha256: str) -> str:
+    if SIGN_MODE == "noop":
+        return ""
+    return hmac.new(HMAC_SECRET.encode("utf-8"), hex_sha256.encode("utf-8"), hashlib.sha256).hexdigest()
+
+
+def verify_sha256(hex_sha256: str, signature: Optional[str]) -> bool:
+    if SIGN_MODE == "noop":
+        return True
+    if not signature:
+        return False
+    expected = sign_sha256(hex_sha256)
+    return hmac.compare_digest(expected, signature)
diff --git a/api/golden_store.py b/api/golden_store.py
new file mode 100644
index 0000000..9a8f35f
--- /dev/null
+++ b/api/golden_store.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+import os
+import hashlib
+from typing import Tuple, Optional
+
+import boto3
+
+
+def _client():
+    """
+    S3-compatible client.
+    - AWS S3: leave AEGIS_S3_ENDPOINT_URL unset
+    - MinIO: set AEGIS_S3_ENDPOINT_URL (e.g., http://minio.<ns>.svc:9000)
+    """
+    endpoint_url = os.environ.get("AEGIS_S3_ENDPOINT_URL", None)
+    region = os.environ.get("AEGIS_S3_REGION", "us-east-1")
+    return boto3.client("s3", region_name=region, endpoint_url=endpoint_url)
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def put_artifact_bytes(
+    tenant_id: str,
+    project_id: str,
+    model_id: str,
+    version: str,
+    data: bytes,
+    content_type: Optional[str] = None,
+) -> Tuple[str, str]:
+    """
+    Golden-path storage layout:
+      s3://<bucket>/<tenant>/<project>/<model>/<version>/artifact
+    """
+    bucket = os.environ.get("AEGIS_ARTIFACTS_BUCKET", "")
+    if not bucket:
+        raise RuntimeError("AEGIS_ARTIFACTS_BUCKET not set")
+
+    digest = sha256_bytes(data)
+    key = f"{tenant_id}/{project_id}/{model_id}/{version}/artifact"
+
+    extra = {}
+    if content_type:
+        extra["ContentType"] = content_type
+
+    c = _client()
+    c.put_object(Bucket=bucket, Key=key, Body=data, **extra)
+    return f"s3://{bucket}/{key}", digest
