+"""
+Golden-path DB bootstrap: Base.metadata.create_all()
+
+Usage:
+  python -m api.bootstrap_golden_db
+"""
+
+import logging
+
+from api.db import Base, engine
+
+# Ensure models are registered
+from api import golden_models  # noqa: F401
+
+logger = logging.getLogger("aegis.bootstrap_golden_db")
+
+
+def bootstrap():
+    logger.info("Creating Golden Path tables via Base.metadata.create_all() ...")
+    Base.metadata.create_all(bind=engine)
+    logger.info("Done.")
+
+
+if __name__ == "__main__":
+    logging.basicConfig(level=logging.INFO)
+    bootstrap()
