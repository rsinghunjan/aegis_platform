index 0000000..b15c4aa
--- /dev/null
+++ b/api/golden_policy.py
@@ -0,0 +1,46 @@
+from __future__ import annotations
+
+from fastapi import HTTPException
+
+from api.golden_models import ModelVersion
+from api.golden_signing import verify_sha256
+
+
+def require_signature_valid(mv: ModelVersion) -> None:
+    if not mv.artifact_sha256:
+        raise HTTPException(status_code=400, detail="model version missing artifact_sha256")
+    if not verify_sha256(mv.artifact_sha256, mv.signature):
+        raise HTTPException(status_code=403, detail="signature verification failed")
+
+
+def require_deploy_allowed(mv: ModelVersion) -> None:
+    if not mv.signed:
+        raise HTTPException(status_code=403, detail="deployment blocked: model artifact is not signed")
+    if mv.eval_status not in ("pass", "passed"):
+        raise HTTPException(status_code=403, detail=f"deployment blocked: eval_status={mv.eval_status}")
+    if not mv.approved:
+        raise HTTPException(status_code=403, detail="deployment blocked: model version not approved")
diff --git a/api/golden_k8s.py b/api/golden_k8s.py
new file mode 100644
index 0000000..b5c7b84
--- /dev/null
+++ b/api/golden_k8s.py
@@ -0,0 +1,335 @@
+from __future__ import annotations
+
+import os
+from typing import Dict, Optional, Tuple
+
+from kubernetes import client, config
+from kubernetes.client.rest import ApiException
+
+
+def _load_k8s():
+    mode = os.environ.get("AEGIS_K8S_CONFIG", "auto")  # auto|incluster|kubeconfig
+    if mode == "incluster":
+        config.load_incluster_config()
+        return
+    if mode == "kubeconfig":
+        config.load_kube_config()
+        return
+    try:
+        config.load_incluster_config()
+    except Exception:
+        config.load_kube_config()
+
+
+def _core() -> client.CoreV1Api:
+    _load_k8s()
+    return client.CoreV1Api()
+
+
+def _apps() -> client.AppsV1Api:
+    _load_k8s()
+    return client.AppsV1Api()
+
+
+def ensure_tenant_namespace(tenant_id: str) -> str:
+    ns = f"aegis-{tenant_id}"
+    core = _core()
+    try:
+        core.read_namespace(ns)
+        return ns
+    except ApiException as e:
+        if e.status != 404:
+            raise
+    body = client.V1Namespace(
+        metadata=client.V1ObjectMeta(
+            name=ns,
+            labels={"aegis.io/tenant": tenant_id, "aegis.io/managed-by": "aegis-golden-api"},
+        )
+    )
+    core.create_namespace(body=body)
+    return ns
+
+
+def _labels(tenant_id: str, project_id: str, model_version_id: str, deployment_id: str) -> Dict[str, str]:
+    return {
+        "app.kubernetes.io/name": "aegis-model",
+        "aegis.io/tenant": tenant_id,
+        "aegis.io/project": project_id,
+        "aegis.io/model_version": model_version_id,
+        "aegis.io/deployment": deployment_id,
+    }
+
+
+def deploy_vllm(
+    namespace: str,
+    name: str,
+    tenant_id: str,
+    project_id: str,
+    model_version_id: str,
+    deployment_id: str,
+    model_artifact_uri: str,
+    gpu: int = 1,
+    image: Optional[str] = None,
+) -> Tuple[str, str]:
+    """
+    Golden template: vLLM deployment (GPU).
+    """
+    image = image or os.environ.get("AEGIS_VLLM_IMAGE", "vllm/vllm-openai:latest")
+    labels = _labels(tenant_id, project_id, model_version_id, deployment_id)
+    apps = _apps()
+    core = _core()
+
+    env = [client.V1EnvVar(name="AEGIS_MODEL_ARTIFACT_URI", value=model_artifact_uri)]
+    container = client.V1Container(
+        name="vllm",
+        image=image,
+        ports=[client.V1ContainerPort(container_port=8000)],
+        env=env,
+        resources=client.V1ResourceRequirements(
+            limits={"nvidia.com/gpu": str(gpu)} if gpu and gpu > 0 else None
+        ),
+    )
+    pod_spec = client.V1PodSpec(containers=[container])
+    template = client.V1PodTemplateSpec(metadata=client.V1ObjectMeta(labels=labels), spec=pod_spec)
+    spec = client.V1DeploymentSpec(
+        replicas=1,
+        selector=client.V1LabelSelector(match_labels={"aegis.io/deployment": deployment_id}),
+        template=template,
+    )
+    dep = client.V1Deployment(metadata=client.V1ObjectMeta(name=name, namespace=namespace, labels=labels), spec=spec)
+    apps.create_namespaced_deployment(namespace=namespace, body=dep)
+
+    svc = client.V1Service(
+        metadata=client.V1ObjectMeta(name=f"{name}-svc", namespace=namespace, labels=labels),
+        spec=client.V1ServiceSpec(
+            selector={"aegis.io/deployment": deployment_id},
+            ports=[client.V1ServicePort(name="http", port=80, target_port=8000)],
+            type="ClusterIP",
+        ),
+    )
+    core.create_namespaced_service(namespace=namespace, body=svc)
+    return svc.metadata.name, f"http://{svc.metadata.name}.{namespace}.svc.cluster.local"
+
+
+def deploy_triton(
+    namespace: str,
+    name: str,
+    tenant_id: str,
+    project_id: str,
+    model_version_id: str,
+    deployment_id: str,
+    model_artifact_uri: str,
+    gpu: int = 0,
+    image: Optional[str] = None,
+) -> Tuple[str, str]:
+    """
+    Golden template: Triton deployment (CPU/GPU).
+    """
+    image = image or os.environ.get("AEGIS_TRITON_IMAGE", "nvcr.io/nvidia/tritonserver:24.01-py3")
+    labels = _labels(tenant_id, project_id, model_version_id, deployment_id)
+    apps = _apps()
+    core = _core()
+
+    env = [client.V1EnvVar(name="AEGIS_MODEL_ARTIFACT_URI", value=model_artifact_uri)]
+    container = client.V1Container(
+        name="triton",
+        image=image,
+        args=[
+            "tritonserver",
+            "--model-repository=/models",
+            "--http-port=8000",
+            "--grpc-port=8001",
+            "--metrics-port=8002",
+        ],
+        ports=[
+            client.V1ContainerPort(container_port=8000),
+            client.V1ContainerPort(container_port=8001),
+            client.V1ContainerPort(container_port=8002),
+        ],
+        env=env,
+        resources=client.V1ResourceRequirements(
+            limits={"nvidia.com/gpu": str(gpu)} if gpu and gpu > 0 else None
+        ),
+    )
+    pod_spec = client.V1PodSpec(containers=[container])
+    template = client.V1PodTemplateSpec(metadata=client.V1ObjectMeta(labels=labels), spec=pod_spec)
+    spec = client.V1DeploymentSpec(
+        replicas=1,
+        selector=client.V1LabelSelector(match_labels={"aegis.io/deployment": deployment_id}),
+        template=template,
+    )
+    dep = client.V1Deployment(metadata=client.V1ObjectMeta(name=name, namespace=namespace, labels=labels), spec=spec)
+    apps.create_namespaced_deployment(namespace=namespace, body=dep)
+
+    svc = client.V1Service(
+        metadata=client.V1ObjectMeta(name=f"{name}-svc", namespace=namespace, labels=labels),
+        spec=client.V1ServiceSpec(
+            selector={"aegis.io/deployment": deployment_id},
+            ports=[
+                client.V1ServicePort(name="http", port=80, target_port=8000),
+                client.V1ServicePort(name="grpc", port=81, target_port=8001),
+                client.V1ServicePort(name="metrics", port=82, target_port=8002),
+            ],
+            type="ClusterIP",
+        ),
+    )
+    core.create_namespaced_service(namespace=namespace, body=svc)
+    return svc.metadata.name, f"http://{svc.metadata.name}.{namespace}.svc.cluster.local"
