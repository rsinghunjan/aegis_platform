+"""
+Golden-path unified schema (minimal, tenant-scoped).
+
+Covers the golden path:
+  - tenants/projects/models/model_versions
+  - deployments
+  - usage_records
+  - audit_events
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+
+from sqlalchemy import (
+    Column,
+    Integer,
+    String,
+    Boolean,
+    DateTime,
+    ForeignKey,
+    Text,
+    JSON,
+    Float,
+    UniqueConstraint,
+    Index,
+)
+from sqlalchemy.orm import relationship
+
+from api.db import Base
+
+
+class Tenant(Base):
+    __tablename__ = "tenants"
+    id = Column(String(100), primary_key=True)  # uuid/slug
+    name = Column(String(200), nullable=True)
+    status = Column(String(50), nullable=False, default="active")
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    projects = relationship("Project", back_populates="tenant")
+
+
+class Project(Base):
+    __tablename__ = "projects"
+    id = Column(String(100), primary_key=True)
+    tenant_id = Column(String(100), ForeignKey("tenants.id", ondelete="CASCADE"), nullable=False, index=True)
+    name = Column(String(200), nullable=False)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    tenant = relationship("Tenant", back_populates="projects")
+    models = relationship("Model", back_populates="project")
+
+    __table_args__ = (
+        UniqueConstraint("tenant_id", "name", name="uq_project_tenant_name"),
+        Index("ix_projects_tenant_created", "tenant_id", "created_at"),
+    )
+
+
+class Model(Base):
+    __tablename__ = "models"
+    id = Column(String(100), primary_key=True)
+    tenant_id = Column(String(100), ForeignKey("tenants.id", ondelete="CASCADE"), nullable=False, index=True)
+    project_id = Column(String(100), ForeignKey("projects.id", ondelete="CASCADE"), nullable=False, index=True)
+    name = Column(String(200), nullable=False)
+    kind = Column(String(50), nullable=False, default="ml")  # ml|llm
+    description = Column(Text, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    project = relationship("Project", back_populates="models")
+    versions = relationship("ModelVersion", back_populates="model")
+
+    __table_args__ = (
+        UniqueConstraint("tenant_id", "project_id", "name", name="uq_model_tenant_project_name"),
+        Index("ix_models_tenant_project", "tenant_id", "project_id"),
+    )
+
+
+class ModelVersion(Base):
+    __tablename__ = "model_versions"
+    id = Column(String(100), primary_key=True)
+    tenant_id = Column(String(100), nullable=False, index=True)
+    model_id = Column(String(100), ForeignKey("models.id", ondelete="CASCADE"), nullable=False, index=True)
+    version = Column(String(100), nullable=False)
+    stage = Column(String(50), nullable=False, default="staging")  # staging|canary|prod
+
+    artifact_uri = Column(String(2000), nullable=False)
+    artifact_sha256 = Column(String(128), nullable=True)
+    signature = Column(Text, nullable=True)
+    signed = Column(Boolean, nullable=False, default=False)
+
+    eval_status = Column(String(50), nullable=False, default="unknown")  # pass|fail|unknown
+    approved = Column(Boolean, nullable=False, default=False)
+
+    metadata = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    model = relationship("Model", back_populates="versions")
+
+    __table_args__ = (
+        UniqueConstraint("model_id", "version", name="uq_model_version"),
+        Index("ix_model_versions_tenant_model_stage", "tenant_id", "model_id", "stage"),
+    )
+
+
+class Deployment(Base):
+    __tablename__ = "deployments"
+    id = Column(String(100), primary_key=True)
+    tenant_id = Column(String(100), nullable=False, index=True)
+    project_id = Column(String(100), nullable=False, index=True)
+    model_version_id = Column(String(100), ForeignKey("model_versions.id", ondelete="CASCADE"), nullable=False, index=True)
+    name = Column(String(200), nullable=False)
+    backend = Column(String(50), nullable=False)  # vllm|triton
+    namespace = Column(String(200), nullable=False)
+    service_name = Column(String(200), nullable=False)
+    url = Column(String(2000), nullable=True)
+    status = Column(String(50), nullable=False, default="creating")
+    config = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (
+        UniqueConstraint("tenant_id", "namespace", "name", name="uq_deployments_tenant_ns_name"),
+        Index("ix_deployments_tenant_project", "tenant_id", "project_id"),
+    )
+
+
+class UsageRecord(Base):
+    __tablename__ = "usage_records"
+    id = Column(Integer, primary_key=True)
+    tenant_id = Column(String(100), nullable=False, index=True)
+    model_id = Column(String(100), nullable=False)
+    version = Column(String(100), nullable=False)
+    deployment_id = Column(String(100), nullable=True)
+    backend = Column(String(50), nullable=True)
+    units = Column(Integer, nullable=False, default=1)
+    inference_ms = Column(Float, nullable=True)
+    extra = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (Index("ix_usage_tenant_created", "tenant_id", "created_at"),)
+
+
+class AuditEvent(Base):
+    __tablename__ = "audit_events"
+    id = Column(Integer, primary_key=True)
+    tenant_id = Column(String(100), nullable=True, index=True)
+    actor = Column(String(200), nullable=False)
+    action = Column(String(200), nullable=False)
+    resource_type = Column(String(200), nullable=True)
+    resource_id = Column(String(200), nullable=True)
+    request_id = Column(String(200), nullable=True, index=True)
+    decision = Column(String(50), nullable=True)  # allow|block|review|n/a
+    details = Column(JSON, nullable=True)
+    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
+
+    __table_args__ = (Index("ix_audit_tenant_created_at", "tenant_id", "created_at"),)
