index 0000000..c4e7c67
--- /dev/null
+++ b/api/golden_auth.py
@@ -0,0 +1,206 @@
+"""
+Golden-path tenant + roles auth.
+
+Uses auth/oidc_jwks.py to verify JWT via JWKS.
+
+Claims:
+  - tenant: tenant id (default claim name: "tenant")
+  - roles: list or comma-separated (default claim name: "roles")
+  - scope: optional space-separated scopes, merged into roles
+"""
+
+from __future__ import annotations
+
+import os
+import logging
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional
+
+from fastapi import Depends, HTTPException, Request, status
+from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
+
+from auth.oidc_jwks import verify_jwt
+
+logger = logging.getLogger("aegis.golden_auth")
+
+TENANT_CLAIM = os.environ.get("AEGIS_TENANT_CLAIM", "tenant")
+ROLES_CLAIM = os.environ.get("AEGIS_ROLES_CLAIM", "roles")
+SCOPES_CLAIM = os.environ.get("AEGIS_SCOPES_CLAIM", "scope")
+
+OIDC_AUDIENCE = os.environ.get("OIDC_AUDIENCE", None)
+OIDC_ISSUER = os.environ.get("OIDC_ISSUER", None)
+
+bearer = HTTPBearer(auto_error=False)
+
+
+@dataclass(frozen=True)
+class Actor:
+    sub: str
+    tenant_id: Optional[str]
+    roles: List[str]
+    raw_claims: Dict[str, Any]
+
+
+def _extract_roles(claims: Dict[str, Any]) -> List[str]:
+    roles: List[str] = []
+    raw_roles = claims.get(ROLES_CLAIM)
+    if isinstance(raw_roles, list):
+        roles.extend([str(x) for x in raw_roles])
+    elif isinstance(raw_roles, str) and raw_roles.strip():
+        roles.extend([r.strip() for r in raw_roles.split(",") if r.strip()])
+
+    raw_scopes = claims.get(SCOPES_CLAIM)
+    if isinstance(raw_scopes, str) and raw_scopes.strip():
+        roles.extend([s.strip() for s in raw_scopes.split(" ") if s.strip()])
+    elif isinstance(raw_scopes, list):
+        roles.extend([str(x) for x in raw_scopes])
+
+    seen = set()
+    out: List[str] = []
+    for r in roles:
+        if r not in seen:
+            seen.add(r)
+            out.append(r)
+    return out
+
+
+def _extract_tenant_id(claims: Dict[str, Any]) -> Optional[str]:
+    v = claims.get(TENANT_CLAIM)
+    if v is None:
+        return None
+    if isinstance(v, str) and v.strip():
+        return v.strip()
+    return str(v)
+
+
+async def require_actor(
+    request: Request,
+    creds: Optional[HTTPAuthorizationCredentials] = Depends(bearer),
+) -> Actor:
+    if creds is None or not creds.credentials:
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="missing bearer token")
+
+    token = creds.credentials
+    try:
+        claims = verify_jwt(token, audience=OIDC_AUDIENCE, issuer=OIDC_ISSUER)
+    except Exception as e:
+        logger.info("jwt.invalid", extra={"error": str(e)})
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="invalid token")
+
+    sub = str(claims.get("sub") or "")
+    if not sub:
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="token missing sub")
+
+    actor = Actor(
+        sub=sub,
+        tenant_id=_extract_tenant_id(claims),
+        roles=_extract_roles(claims),
+        raw_claims=claims,
+    )
+    request.state.actor = actor
+    return actor
