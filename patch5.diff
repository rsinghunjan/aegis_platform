index 0000000..cfad6dc
--- /dev/null
+++ b/api/golden_app.py
@@ -0,0 +1,531 @@
+"""
+Aegis Golden Path API
+
+Implements:
+  - Register model artifact -> S3/MinIO -> sign -> DB record
+  - Approve + eval pass -> deploy vLLM/Triton into tenant namespace
+  - Inference gateway routes -> meters usage -> writes audit events
+  - Enforced by OIDC roles + tenant_id scoping on all endpoints (except /healthz, /metrics)
+"""
+
+from __future__ import annotations
+
+import os
+import time
+import uuid
+import logging
+from typing import Any, Dict, Optional
+
+import httpx
+from fastapi import FastAPI, UploadFile, File, Form, HTTPException, Request
+from fastapi.responses import PlainTextResponse, JSONResponse
+from fastapi.middleware.gzip import GZipMiddleware
+from starlette.middleware.cors import CORSMiddleware
+from prometheus_client import generate_latest, CONTENT_TYPE_LATEST, Counter, Summary
+
+from api.logging_config import configure_logging, set_request_id
+from api.otel import init_otel
+from api.db import engine as sqlalchemy_engine, SessionLocal
+
+from api.golden_auth import require_actor, Actor
+from api.golden_audit import record_audit_event
+from api.golden_models import Tenant, Project, Model, ModelVersion, Deployment, UsageRecord
+from api.golden_store import put_artifact_bytes
+from api.golden_signing import sign_sha256
+from api.golden_policy import require_signature_valid, require_deploy_allowed
+from api.golden_k8s import ensure_tenant_namespace, deploy_vllm, deploy_triton
+from api.safety import enforce_and_maybe_block
+
+configure_logging()
+logger = logging.getLogger("aegis.golden")
+logger.setLevel(logging.INFO)
+
+app = FastAPI(title="Aegis Golden Path API", version="0.1.0")
+app.add_middleware(GZipMiddleware, minimum_size=1000)
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=["*"],
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+init_otel(app=app, sqlalchemy_engine=sqlalchemy_engine)
+
+PUBLIC_PATHS = {"/healthz", "/metrics"}
+
+# Metrics
+REGISTRY_UPLOAD_TOTAL = Counter("aegis_registry_upload_total", "Registry uploads", ["tenant"])
+DEPLOY_TOTAL = Counter("aegis_deploy_total", "Deployments created", ["tenant", "backend"])
+INFER_TOTAL = Counter("aegis_infer_total", "Inference calls", ["tenant", "model", "version", "backend"])
+INFER_LAT_MS = Summary("aegis_infer_latency_ms", "Inference latency ms", ["tenant", "model", "version", "backend"])
+
+
+@app.middleware("http")
+async def enforce_tenant_auth(request: Request, call_next):
+    """
+    Enforce tenant_id + roles on every request path (except health/metrics).
+    """
+    request_id = request.headers.get("x-request-id") or str(uuid.uuid4())
+    set_request_id(request_id)
+    start = time.time()
+    response = None
+    try:
+        if request.url.path not in PUBLIC_PATHS:
+            actor = await require_actor(request)
+            if not actor.tenant_id:
+                raise HTTPException(status_code=403, detail="missing tenant claim")
+        response = await call_next(request)
+        return response
+    except HTTPException as e:
+        response = JSONResponse(status_code=e.status_code, content={"error": e.detail, "request_id": request_id})
+        return response
+    finally:
+        elapsed_ms = (time.time() - start) * 1000.0
+        logger.info(
+            "http.request",
+            extra={
+                "request_id": request_id,
+                "method": request.method,
+                "path": request.url.path,
+                "status": getattr(response, "status_code", None),
+                "latency_ms": elapsed_ms,
+                "remote": request.client.host if request.client else None,
+            },
+        )
+
+
+@app.get("/healthz")
+async def healthz():
+    return {"ok": True}
+
+
+@app.get("/metrics")
+async def metrics():
+    return PlainTextResponse(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+
+def actor_from_request(request: Request) -> Actor:
+    a = getattr(request.state, "actor", None)
+    if not a:
+        raise HTTPException(status_code=401, detail="unauthenticated")
+    return a
+
+
+def require_any_role(actor: Actor, roles: list[str]) -> None:
+    for r in roles:
+        if r in actor.roles:
+            return
+    raise HTTPException(status_code=403, detail={"message": "forbidden", "required_roles": roles})
+
+
+# ------------------------ bootstrap endpoints ------------------------
+
+@app.post("/v1/admin/tenants/upsert")
+async def upsert_tenant(
+    request: Request,
+    tenant_id: str = Form(...),
+    name: Optional[str] = Form(None),
+):
+    """
+    Platform-admin only: create/update tenant in DB (and ensure namespace exists).
+    """
+    actor = actor_from_request(request)
+    require_any_role(actor, ["platform_admin"])
+
+    session = SessionLocal()
+    try:
+        t = session.query(Tenant).filter_by(id=tenant_id).one_or_none()
+        if not t:
+            t = Tenant(id=tenant_id, name=name or tenant_id)
+            session.add(t)
+        else:
+            if name:
+                t.name = name
+        session.commit()
+
+        ns = ensure_tenant_namespace(tenant_id)
+        record_audit_event(tenant_id, actor.sub, "tenant.upsert", "tenant", tenant_id, decision="allow", details={"namespace": ns})
+        return {"tenant_id": tenant_id, "namespace": ns}
+    finally:
+        session.close()
+
+
+@app.post("/v1/projects")
+async def create_project(request: Request, name: str = Form(...)):
+    actor = actor_from_request(request)
+    session = SessionLocal()
+    try:
+        pid = str(uuid.uuid4())
+        p = Project(id=pid, tenant_id=actor.tenant_id, name=name)
+        session.add(p)
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "project.create", "project", pid, decision="allow", details={"name": name})
+        return {"project_id": pid, "name": name}
+    except Exception as e:
+        session.rollback()
+        raise HTTPException(status_code=400, detail=str(e))
+    finally:
+        session.close()
+
+
+@app.post("/v1/models")
+async def create_model(
+    request: Request,
+    project_id: str = Form(...),
+    name: str = Form(...),
+    kind: str = Form("ml"),
+    description: Optional[str] = Form(None),
+):
+    actor = actor_from_request(request)
+    session = SessionLocal()
+    try:
+        p = session.query(Project).filter_by(id=project_id, tenant_id=actor.tenant_id).one_or_none()
+        if not p:
+            raise HTTPException(status_code=404, detail="project not found")
+        mid = str(uuid.uuid4())
+        m = Model(id=mid, tenant_id=actor.tenant_id, project_id=project_id, name=name, kind=kind, description=description)
+        session.add(m)
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "model.create", "model", mid, decision="allow", details={"name": name, "kind": kind})
+        return {"model_id": mid, "name": name}
+    finally:
+        session.close()
+
+
+# ------------------------ golden path: register -> store -> sign -> record ------------------------
+
+@app.post("/v1/registry/register")
+async def register_model_artifact(
+    request: Request,
+    project_id: str = Form(...),
+    model_id: str = Form(...),
+    version: str = Form(...),
+    stage: str = Form("staging"),
+    artifact_file: UploadFile = File(...),
+):
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "tenant_developer", "platform_admin"])
+    if stage not in ("staging", "canary", "prod"):
+        raise HTTPException(status_code=400, detail="invalid stage")
+
+    session = SessionLocal()
+    try:
+        m = session.query(Model).filter_by(id=model_id, tenant_id=actor.tenant_id, project_id=project_id).one_or_none()
+        if not m:
+            raise HTTPException(status_code=404, detail="model not found")
+
+        data = await artifact_file.read()
+        artifact_uri, sha256 = put_artifact_bytes(
+            tenant_id=actor.tenant_id,
+            project_id=project_id,
+            model_id=model_id,
+            version=version,
+            data=data,
+            content_type=artifact_file.content_type,
+        )
+        sig = sign_sha256(sha256)
+        signed = bool(sig)
+
+        mv_id = str(uuid.uuid4())
+        mv = ModelVersion(
+            id=mv_id,
+            tenant_id=actor.tenant_id,
+            model_id=model_id,
+            version=version,
+            stage=stage,
+            artifact_uri=artifact_uri,
+            artifact_sha256=sha256,
+            signature=sig,
+            signed=signed,
+            eval_status="unknown",
+            approved=False,
+            metadata={"filename": artifact_file.filename, "content_type": artifact_file.content_type},
+        )
+        session.add(mv)
+        session.commit()
+
+        REGISTRY_UPLOAD_TOTAL.labels(tenant=actor.tenant_id).inc()
+        record_audit_event(actor.tenant_id, actor.sub, "registry.register", "model_version", mv_id, decision="allow",
+                          details={"artifact_uri": artifact_uri, "sha256": sha256, "signed": signed})
+        return {"model_version_id": mv_id, "artifact_uri": artifact_uri, "sha256": sha256, "signed": signed}
+    except HTTPException:
+        raise
+    except Exception as e:
+        session.rollback()
+        record_audit_event(actor.tenant_id, actor.sub, "registry.register", "model_version", None, decision="block", details={"error": str(e)})
+        raise HTTPException(status_code=500, detail=str(e))
+    finally:
+        session.close()
+
+
+# ------------------------ golden path: approve + eval pass -> deploy ------------------------
+
+@app.post("/v1/registry/{model_version_id}/approve")
+async def approve_model_version(
+    request: Request,
+    model_version_id: str,
+    approved: bool = Form(True),
+):
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "platform_admin"])
+    session = SessionLocal()
+    try:
+        mv = session.query(ModelVersion).filter_by(id=model_version_id, tenant_id=actor.tenant_id).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+        mv.approved = bool(approved)
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "registry.approve", "model_version", model_version_id, decision="allow", details={"approved": mv.approved})
+        return {"model_version_id": model_version_id, "approved": mv.approved}
+    finally:
+        session.close()
+
+
+@app.post("/v1/registry/{model_version_id}/eval")
+async def set_eval_status(
+    request: Request,
+    model_version_id: str,
+    status_val: str = Form(...),  # pass|fail
+):
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "platform_admin"])
+    if status_val not in ("pass", "fail"):
+        raise HTTPException(status_code=400, detail="status must be pass|fail")
+    session = SessionLocal()
+    try:
+        mv = session.query(ModelVersion).filter_by(id=model_version_id, tenant_id=actor.tenant_id).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+        mv.eval_status = status_val
+        session.commit()
+        record_audit_event(actor.tenant_id, actor.sub, "registry.eval_set", "model_version", model_version_id, decision="allow", details={"eval_status": mv.eval_status})
+        return {"model_version_id": model_version_id, "eval_status": mv.eval_status}
+    finally:
+        session.close()
+
+
+@app.post("/v1/deployments")
+async def deploy_model_version(
+    request: Request,
+    project_id: str = Form(...),
+    model_version_id: str = Form(...),
+    name: str = Form(...),
+    backend: str = Form(...),  # vllm|triton
+    gpu: int = Form(0),
+):
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_admin", "platform_admin"])
+    if backend not in ("vllm", "triton"):
+        raise HTTPException(status_code=400, detail="backend must be vllm|triton")
+
+    session = SessionLocal()
+    try:
+        mv = session.query(ModelVersion).filter_by(id=model_version_id, tenant_id=actor.tenant_id).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+
+        # Policy gates: signature valid + approved + eval pass
+        require_signature_valid(mv)
+        require_deploy_allowed(mv)
+
+        namespace = ensure_tenant_namespace(actor.tenant_id)
+        deployment_id = str(uuid.uuid4())
+        k8s_name = f"aegis-{name}-{deployment_id[:8]}".lower().replace("_", "-")
+
+        if backend == "vllm":
+            svc_name, url = deploy_vllm(
+                namespace=namespace,
+                name=k8s_name,
+                tenant_id=actor.tenant_id,
+                project_id=project_id,
+                model_version_id=model_version_id,
+                deployment_id=deployment_id,
+                model_artifact_uri=mv.artifact_uri,
+                gpu=max(0, int(gpu or 0)),
+            )
+        else:
+            svc_name, url = deploy_triton(
+                namespace=namespace,
+                name=k8s_name,
+                tenant_id=actor.tenant_id,
+                project_id=project_id,
+                model_version_id=model_version_id,
+                deployment_id=deployment_id,
+                model_artifact_uri=mv.artifact_uri,
+                gpu=max(0, int(gpu or 0)),
+            )
+
+        d = Deployment(
+            id=deployment_id,
+            tenant_id=actor.tenant_id,
+            project_id=project_id,
+            model_version_id=model_version_id,
+            name=name,
+            backend=backend,
+            namespace=namespace,
+            service_name=svc_name,
+            url=url,
+            status="creating",
+            config={"gpu": gpu},
+        )
+        session.add(d)
+        session.commit()
+
+        DEPLOY_TOTAL.labels(tenant=actor.tenant_id, backend=backend).inc()
+        record_audit_event(actor.tenant_id, actor.sub, "deployment.create", "deployment", deployment_id, decision="allow",
+                          details={"backend": backend, "namespace": namespace, "service": svc_name, "url": url})
+        return {"deployment_id": deployment_id, "url": url, "service": svc_name, "namespace": namespace}
+    except HTTPException as e:
+        record_audit_event(actor.tenant_id, actor.sub, "deployment.create", "deployment", None, decision="block", details={"error": e.detail})
+        raise
+    except Exception as e:
+        session.rollback()
+        record_audit_event(actor.tenant_id, actor.sub, "deployment.create", "deployment", None, decision="block", details={"error": str(e)})
+        raise HTTPException(status_code=500, detail=str(e))
+    finally:
+        session.close()
+
+
+# ------------------------ golden path: inference -> route -> meter -> audit ------------------------
+
+@app.post("/v1/infer")
+async def infer(
+    request: Request,
+    model_id: str = Form(...),
+    version: str = Form(...),
+    payload: str = Form(...),
+):
+    actor = actor_from_request(request)
+    require_any_role(actor, ["tenant_user", "tenant_developer", "tenant_admin", "platform_admin"])
+    infer_request_id = str(uuid.uuid4())
+
+    # Safety hook (existing module in repo)
+    enforce_and_maybe_block(
+        request_id=infer_request_id,
+        user_obj={"username": actor.sub},
+        model_name=model_id,
+        version=version,
+        payload={"text": payload},
+    )
+
+    session = SessionLocal()
+    start = time.time()
+    backend = "unknown"
+    try:
+        mv = session.query(ModelVersion).filter_by(tenant_id=actor.tenant_id, model_id=model_id, version=version).one_or_none()
+        if not mv:
+            raise HTTPException(status_code=404, detail="model version not found")
+
+        dep = (
+            session.query(Deployment)
+            .filter_by(tenant_id=actor.tenant_id, model_version_id=mv.id)
+            .order_by(Deployment.created_at.desc())
+            .first()
+        )
+        if not dep:
+            raise HTTPException(status_code=409, detail="no deployment for model version")
+
+        backend = dep.backend
+
+        timeout = float(os.environ.get("AEGIS_INFER_PROXY_TIMEOUT_S", "10"))
+        proxy = os.environ.get("AEGIS_INFER_PROXY_ENABLED", "false").lower() == "true"
+
+        # Golden path: route to deployment (optional proxy on/off for local dev)
+        result: Dict[str, Any]
+        if proxy:
+            async with httpx.AsyncClient(timeout=timeout) as client:
+                r = await client.post(f"{dep.url}/infer", json={"payload": payload, "model_id": model_id, "version": version})
+                r.raise_for_status()
+                result = r.json()
+        else:
+            result = {"deployment_url": dep.url, "note": "proxy disabled; set AEGIS_INFER_PROXY_ENABLED=true"}
+
+        elapsed_ms = (time.time() - start) * 1000.0
+        INFER_TOTAL.labels(tenant=actor.tenant_id, model=model_id, version=version, backend=backend).inc()
+        INFER_LAT_MS.labels(tenant=actor.tenant_id, model=model_id, version=version, backend=backend).observe(elapsed_ms)
+
+        # Meter usage (v1: 1 unit per call)
+        ur = UsageRecord(
+            tenant_id=actor.tenant_id,
+            model_id=model_id,
+            version=version,
+            deployment_id=dep.id,
+            backend=backend,
+            units=1,
+            inference_ms=elapsed_ms,
+            extra={"request_id": infer_request_id},
+        )
+        session.add(ur)
+        session.commit()
+
+        record_audit_event(
+            actor.tenant_id,
+            actor.sub,
+            "infer",
+            "deployment",
+            dep.id,
+            request_id=infer_request_id,
+            decision="allow",
+            details={"backend": backend, "latency_ms": elapsed_ms},
+        )
+        return {"request_id": infer_request_id, "backend": backend, "result": result}
+    finally:
+        session.close()
