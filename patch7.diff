+def _storage_env_and_secrets(namespace: str) -> Tuple[list[client.V1EnvVar], list[client.V1EnvFromSource]]:
+    """
+    Provide S3/MinIO credentials to initContainers.
+
+    Supported modes:
+      1) AWS in-cluster with IRSA/instance profile: no explicit creds required.
+      2) MinIO / static creds: set AEGIS_MINIO_ACCESS_KEY + AEGIS_MINIO_SECRET_KEY
+         -> secret aegis-s3-creds will be created in the tenant namespace.
+
+    This keeps the patch self-contained. For production, use:
+      - External Secrets Operator, or
+      - Vault Agent injector + templates, or
+      - AWS IRSA only.
+    """
+    env: list[client.V1EnvVar] = [
+        client.V1EnvVar(name="AEGIS_S3_ENDPOINT_URL", value=os.environ.get("AEGIS_S3_ENDPOINT_URL", "")),
+        client.V1EnvVar(name="AEGIS_S3_REGION", value=os.environ.get("AEGIS_S3_REGION", "us-east-1")),
+    ]
+    env_from: list[client.V1EnvFromSource] = []
+
+    ak = os.environ.get("AEGIS_MINIO_ACCESS_KEY", "")
+    sk = os.environ.get("AEGIS_MINIO_SECRET_KEY", "")
+    if ak and sk:
+        _maybe_create_secret(
+            namespace=namespace,
+            name="aegis-s3-creds",
+            data={
+                "AWS_ACCESS_KEY_ID": ak,
+                "AWS_SECRET_ACCESS_KEY": sk,
+            },
+            labels={"aegis.io/managed-by": "aegis-golden-api"},
+        )
+        env_from.append(client.V1EnvFromSource(secret_ref=client.V1SecretEnvSource(name="aegis-s3-creds")))
+    # else: rely on AWS ambient credentials (IRSA / node role / local env)
+    return env, env_from
+
+
+def _vault_env_and_secrets(namespace: str) -> Tuple[list[client.V1EnvVar], list[client.V1EnvFromSource]]:
+    """
+    Provide Vault auth to initContainers.
+
+    Recommended production patterns:
+      - Vault Agent Injector (sidecar/init) using Kubernetes auth (no tokens in env)
+      - OR External Secrets synced from Vault into K8s Secret
+
+    Self-contained patch option:
+      - if AEGIS_VAULT_TOKEN is set, create secret aegis-vault-token in tenant namespace.
+        (Not recommended long-term.)
+    """
+    env: list[client.V1EnvVar] = [
+        client.V1EnvVar(name="VAULT_ADDR", value=os.environ.get("VAULT_ADDR", "")),
+        client.V1EnvVar(name="AEGIS_VAULT_TRANSIT_MOUNT", value=os.environ.get("AEGIS_VAULT_TRANSIT_MOUNT", "transit")),
+        client.V1EnvVar(name="AEGIS_VAULT_TRANSIT_KEY", value=os.environ.get("AEGIS_VAULT_TRANSIT_KEY", "aegis-model-sign")),
+    ]
+    env_from: list[client.V1EnvFromSource] = []
+
+    token = os.environ.get("AEGIS_VAULT_TOKEN", "") or os.environ.get("VAULT_TOKEN", "")
+    if token:
+        _maybe_create_secret(
+            namespace=namespace,
+            name="aegis-vault-token",
+            data={"VAULT_TOKEN": token},
+            labels={"aegis.io/managed-by": "aegis-golden-api"},
+        )
+        env_from.append(client.V1EnvFromSource(secret_ref=client.V1SecretEnvSource(name="aegis-vault-token")))
+    return env, env_from
+
