+def _maybe_create_secret(namespace: str, name: str, data: Dict[str, str], labels: Optional[Dict[str, str]] = None):
+    """
+    Best-effort: create a secret if it doesn't exist.
+    NOTE: This stores sensitive data in a Kubernetes Secret; use External Secrets / Vault Agent in production.
