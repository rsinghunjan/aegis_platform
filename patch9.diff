diff --git a/ops/images/artifact-init/Dockerfile b/ops/images/artifact-init/Dockerfile
new file mode 100644
index 0000000..0d4f5f4
--- /dev/null
+++ b/ops/images/artifact-init/Dockerfile
@@ -0,0 +1,52 @@
+# Aegis Artifact Init Image
+# - Contains boto3 + requests (no pip-at-runtime in initContainers)
+# - Intended to be used as: AEGIS_ARTIFACT_INIT_IMAGE=<registry>/aegis-artifact-init:<tag>
+#
+# Build:
+#   docker build -t aegis-artifact-init:local ops/images/artifact-init
+#
+# NOTE: Pin versions for reproducibility/security scanning.
+
+FROM python:3.11-slim
+
+ARG BOTO3_VERSION=1.34.131
+ARG REQUESTS_VERSION=2.32.3
+
+RUN apt-get update \
+ && apt-get install -y --no-install-recommends ca-certificates \
+ && rm -rf /var/lib/apt/lists/*
+
+RUN python -m pip install --no-cache-dir "boto3==${BOTO3_VERSION}" "requests==${REQUESTS_VERSION}"
+
+# Non-root for better default security posture
+RUN useradd -m -u 10001 aegis && mkdir -p /work /models /vault/secrets \
+ && chown -R aegis:aegis /work /models /vault
+
+USER 10001
+
+WORKDIR /work
