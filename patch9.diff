--- /dev/null
+++ b/k8s/external-secrets/aegis-minio-externalsecret.yaml
@@ -0,0 +1,44 @@
+# ExternalSecret example for MinIO credentials.
+# This creates a Secret in the tenant namespace with AWS-compatible env vars
+# consumed by boto3 (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
+#
+# Requires External Secrets Operator installed and a ClusterSecretStore/SecretStore configured.
+apiVersion: external-secrets.io/v1beta1
+kind: ExternalSecret
+metadata:
+  name: aegis-s3-creds
+  namespace: REPLACE_ME_TENANT_NAMESPACE
+spec:
+  refreshInterval: 1h
+  secretStoreRef:
+    kind: ClusterSecretStore
+    name: REPLACE_ME_SECRET_STORE
+  target:
+    name: aegis-s3-creds
+    creationPolicy: Owner
+    template:
+      type: Opaque
+      data:
+        AWS_ACCESS_KEY_ID: "{{ .minio_access_key }}"
+        AWS_SECRET_ACCESS_KEY: "{{ .minio_secret_key }}"
+  data:
+  - secretKey: minio_access_key
+    remoteRef:
+      key: REPLACE_ME_REMOTE_SECRET_KEY
+      property: access_key
+  - secretKey: minio_secret_key
+    remoteRef:
+      key: REPLACE_ME_REMOTE_SECRET_KEY
+      property: secret_key
diff --git a/k8s/vault-agent-injector/aegis-vault-agent-annotations.md b/k8s/vault-agent-injector/aegis-vault-agent-annotations.md
