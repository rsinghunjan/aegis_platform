@@ -0,0 +1,33 @@
+# ServiceAccount for model serving pods (vLLM/Triton) in a tenant namespace.
+# Apply per tenant namespace (e.g., aegis-<tenant_id>).
+#
+# For EKS IRSA:
+# - Create an IAM role with S3 read permissions for your artifacts bucket.
+# - Annotate this ServiceAccount with that role ARN.
+#
+# Example:
+#   eksctl create iamserviceaccount \
+#     --cluster <cluster> \
+#     --namespace aegis-tenant1 \
+#     --name aegis-model-serving \
+#     --attach-policy-arn arn:aws:iam::<acct>:policy/aegis-s3-read \
+#     --approve
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: aegis-model-serving
+  namespace: REPLACE_ME_TENANT_NAMESPACE
+  annotations:
+    # Replace with your IRSA role ARN
+    eks.amazonaws.com/role-arn: arn:aws:iam::123456789012:role/REPLACE_ME_AEGIS_S3_READ_ROLE
