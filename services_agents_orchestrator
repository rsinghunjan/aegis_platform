+#!/usr/bin/env python3
+"""
+Simple reviewer UI backend (FastAPI) to list pending moderation items and accept/reject them.
+Integrates with moderation_reviewer_audit.record_review for durable audit logging.
+"""
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+try:
+    import redis
+except Exception:
+    redis = None
+import json
+from services.serving.diffusers.moderation_reviewer_audit import record_review
+
+REDIS_URL = "redis://redis:6379/0"
+STREAM = "diffusers:moderation:stream"
+
+app = FastAPI(title="Aegis Moderation Reviewer UI")
+
+class ReviewReq(BaseModel):
+    action: str
+    reviewer: str
+    notes: str | None = ""
+
+@app.get("/pending")
+def pending(limit: int = 50):
+    if redis is None:
+        raise HTTPException(status_code=500, detail="redis not installed")
+    r = redis.from_url(REDIS_URL)
+    entries = r.xrange(STREAM, count=limit)
+    out = []
+    for e in entries:
+        _id = e[0]
+        payload = json.loads(e[1].get(b"payload").decode("utf-8"))
+        out.append({"id": _id.decode() if isinstance(_id, bytes) else _id, "payload": payload})
+    return out
+
+@app.post("/review/{entry_id}")
+def review(entry_id: str, body: ReviewReq):
+    if redis is None:
+        raise HTTPException(status_code=500, detail="redis not installed")
+    r = redis.from_url(REDIS_URL)
+    entries = r.xrange(STREAM, entry_id, entry_id, count=1)
+    if not entries:
+        raise HTTPException(status_code=404, detail="entry not found")
+    payload = json.loads(entries[0][1][b"payload"].decode("utf-8"))
+    # record audit
+    res = record_review(entry_id, body.action, body.reviewer, body.notes or "", payload)
+    # remove from pending
+    try:
+        r.xdel(STREAM, entry_id)
+    except Exception:
+        pass
+    return {"ok": True, "audit": res}
+
