+#!/usr/bin/env python3
+"""
+Agent Orchestrator service (FastAPI).
+
+Features (PoC):
+ - Accepts an agent "plan" (sequence of steps). Each step names a tool and input.
+ - Schedules execution, records per-step evidence (inputs, outputs, metadata) to S3.
+ - Uses a sandbox tool-runner service to execute tools securely (microVM/runsc/Kata in production).
+ - Publishes orchestration job into Redis for background workers.
+ - Simple audit/evidence signing hook available.
+"""
+import os
+import time
+import json
+import uuid
+import boto3
+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel
+try:
+    import redis
+except Exception:
+    redis = None
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+SANDBOX_RUNNER = os.environ.get("SANDBOX_RUNNER_URL", "http://sandbox-runner:8081/v1/run")
+SIGNING_KEY_REF = os.environ.get("COSIGN_KEY_REF", "")
+
+app = FastAPI(title="Aegis Agent Orchestrator")
+
+class Step(BaseModel):
+    name: str
+    tool: str
+    input: dict = {}
+
+class Plan(BaseModel):
+    agent_id: str
+    plan_id: str = None
+    steps: list[Step]
+    tenant: str | None = None
+
+def _push_job(key: str, payload: dict):
+    if redis is None:
+        raise RuntimeError("Redis client required")
+    r = redis.from_url(REDIS_URL)
+    r.rpush(key, json.dumps(payload))
+
+def _s3_put_bytes(key: str, data: bytes, content_type="application/json"):
+    if not EVIDENCE_BUCKET:
+        return None
+    s3 = boto3.client("s3")
+    bucket = EVIDENCE_BUCKET.replace("s3://","")
+    s3.put_object(Bucket=bucket, Key=key, Body=data, ContentType=content_type)
+    return f"s3://{bucket}/{key}"
+
+@app.post("/v1/submit-plan")
+def submit_plan(body: Plan):
+    # assign id
+    plan_id = body.plan_id or f"plan-{int(time.time())}-{uuid.uuid4().hex[:8]}"
+    job = {"plan_id": plan_id, "agent_id": body.agent_id, "steps": [s.dict() for s in body.steps], "tenant": body.tenant, "ts": time.time()}
+    # record evidence
+    meta_key = f"agents/evidence/{plan_id}.json"
+    _s3_put_bytes(meta_key, json.dumps(job, indent=2).encode("utf-8"))
+    # push to Redis queue for workers
+    try:
+        _push_job("aegis:agent:plans", job)
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"failed to enqueue: {e}")
+    return {"plan_id": plan_id, "status": "queued"}
+
+@app.get("/healthz")
+def health():
+    return {"status": "ok", "sandbox_runner": SANDBOX_RUNNER}
+
