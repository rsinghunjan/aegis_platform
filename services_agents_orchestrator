+#!/usr/bin/env python3
+"""
+Background worker that processes plans from Redis and executes steps via sandbox runner.
+ - Durable: acknowledges via Redis pop pattern and writes per-step evidence to S3.
+ - In production, run multiple replicas with leader-election/consumer groups for HA.
+"""
+import os
+import time
+import json
+import requests
+try:
+    import redis
+except Exception:
+    redis = None
+import boto3
+
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+QUEUE = os.environ.get("AGENT_PLAN_QUEUE", "aegis:agent:plans")
+SANDBOX_RUNNER = os.environ.get("SANDBOX_RUNNER_URL", "http://sandbox-runner:8081/v1/run")
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+
+def s3_put(key, data, content_type="application/json"):
+    if not EVIDENCE_BUCKET:
+        return None
+    s3 = boto3.client("s3")
+    bucket = EVIDENCE_BUCKET.replace("s3://","")
+    s3.put_object(Bucket=bucket, Key=key, Body=data, ContentType=content_type)
+    return f"s3://{bucket}/{key}"
+
+def execute_step(step, meta):
+    """
+    Call sandbox runner with JSON payload:
+    { "tool": <tool>, "input": {...}, "meta": {...} }
+    """
+    payload = {"tool": step["tool"], "input": step.get("input", {}), "meta": meta}
+    r = requests.post(SANDBOX_RUNNER, json=payload, timeout=60)
+    r.raise_for_status()
+    return r.json()
+
+def run_loop(poll_interval=0.5):
+    if redis is None:
+        raise RuntimeError("redis required")
+    r = redis.from_url(REDIS_URL)
+    print("Agent worker started")
+    while True:
+        raw = r.lpop(QUEUE)
+        if not raw:
+            time.sleep(poll_interval)
+            continue
+        job = json.loads(raw)
+        plan_id = job["plan_id"]
+        results = []
+        for idx, step in enumerate(job["steps"]):
+            step_meta = {"plan_id": plan_id, "step_index": idx, "step_name": step["name"], "ts": time.time()}
+            try:
+                out = execute_step(step, step_meta)
+                results.append({"step": step["name"], "ok": True, "out": out})
+            except Exception as e:
+                results.append({"step": step["name"], "ok": False, "error": str(e)})
+                # stop on error for now
+                break
+            # persist per-step evidence
+            key = f"agents/evidence/{plan_id}/step-{idx}.json"
+            s3_put(key, json.dumps({"step": step, "result": results[-1], "meta": step_meta}).encode("utf-8"))
+        # record plan result summary
+        summary_key = f"agents/evidence/{plan_id}/summary.json"
+        s3_put(summary_key, json.dumps({"plan_id": plan_id, "results": results, "ts": time.time()}).encode("utf-8"))
+
+if __name__ == "__main__":
+    run_loop()
+
