+#!/usr/bin/env python3
+"""
+Redis-backed dynamic batcher for Diffusers sampling jobs (PoC).
+Aggregates small requests into batched pipeline calls to improve GPU throughput.
+"""
+import os
+import time
+import json
+try:
+    import redis
+except Exception:
+    redis = None
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+REDIS_URL = os.environ.get("REDIS_BROKER", "redis://redis:6379/0")
+QUEUE_NAME = os.environ.get("DIFFUSERS_REDIS_QUEUE", "diffusers:queue")
+MAX_BATCH = int(os.environ.get("DIFFUSER_MAX_BATCH", "4"))
+TIMEOUT_S = float(os.environ.get("DIFFUSER_BATCH_TIMEOUT_S", "0.2"))
+
+def _pop_batch(r, max_items: int, timeout_s: float):
+    items = []
+    start = time.time()
+    while len(items) < max_items and (time.time() - start) < timeout_s:
+        raw = r.lpop(QUEUE_NAME)
+        if not raw:
+            time.sleep(0.01)
+            continue
+        try:
+            job = json.loads(raw)
+            items.append(job)
+        except Exception:
+            continue
+    return items
+
+class RedisBatchAggregator:
+    def __init__(self, pipe, max_batch=MAX_BATCH, timeout_s=TIMEOUT_S, redis_url=REDIS_URL):
+        if redis is None:
+            raise RuntimeError("redis package required for dynamic_batcher")
+        self.r = redis.from_url(redis_url, decode_responses=False)
+        self.pipe = pipe
+        self.max_batch = max_batch
+        self.timeout_s = timeout_s
+        self._stop = False
+
+    def run_once(self):
+        jobs = _pop_batch(self.r, self.max_batch, self.timeout_s)
+        if not jobs:
+            return
+        prompts = [j.get("prompt", "") for j in jobs]
+        params = jobs[0].get("params", {})  # simplistic: use same params for batch, or split into groups
+        try:
+            out = self.pipe(prompts, **params)
+            images = out.images
+        except Exception as e:
+            for j in jobs:
+                key = j.get("result_key")
+                if key:
+                    self.r.set(key, json.dumps({"status":"error","error":str(e)}))
+            return
+        for j, img in zip(jobs, images):
+            key = j.get("result_key")
+            job_id = j.get("id")
+            import io, boto3
+            buf = io.BytesIO()
+            img.save(buf, format="PNG")
+            img_bytes = buf.getvalue()
+            if EVIDENCE_BUCKET:
+                s3 = boto3.client("s3")
+                key_img = f"diffusion/outputs/{job_id}.png"
+                s3.put_object(Bucket=EVIDENCE_BUCKET.replace("s3://",""), Key=key_img, Body=img_bytes, ContentType="image/png")
+                result = {"status":"ok","s3_image": f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key_img}"}
+            else:
+                result = {"status":"ok"}
+            if key:
+                self.r.set(key, json.dumps(result))
+
+    def run_loop(self, poll_interval=0.05):
+        while not self._stop:
+            try:
+                self.run_once()
+            except Exception as e:
+                print("aggregator error", e)
+            time.sleep(poll_interval)
+
+    def stop(self):
+        self._stop = True
+
