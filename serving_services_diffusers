+#!/usr/bin/env python3
+"""
+Watermark adapter: selects the best available watermark implementation.
+ - Preferred: robust_watermark (FFT/spread-spectrum PoC)
+ - Fallback: invisible LSB watermark
+ - Detection API unified here
+"""
+from typing import Tuple
+try:
+    from services.serving.diffusers.watermark.robust_watermark import embed_watermark, detect_watermark
+    BACKEND = "robust"
+except Exception:
+    try:
+        from services.serving.diffusers.watermark.invisible_watermark import embed_watermark_bytes as lsb_embed, detect_watermark_bytes as lsb_detect
+        BACKEND = "lsb"
+    except Exception:
+        BACKEND = None
+
+def embed(image_bytes: bytes, payload: str, strength: float = 0.01) -> bytes:
+    if BACKEND == "robust":
+        return embed_watermark(image_bytes, payload, strength=strength)
+    elif BACKEND == "lsb":
+        return lsb_embed(image_bytes, payload.encode("utf-8"))
+    else:
+        raise RuntimeError("No watermark backend available")
+
+def detect(image_bytes: bytes, payload: str) -> bool:
+    if BACKEND == "robust":
+        return detect_watermark(image_bytes, payload)
+    elif BACKEND == "lsb":
+        return lsb_detect(image_bytes, payload.encode("utf-8"))
+    else:
+        raise RuntimeError("No watermark backend available")
