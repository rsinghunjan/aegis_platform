+#!/usr/bin/env python3
+"""
+Simple billing uploader that accepts charge records and writes daily aggregates to S3.
+Intended as a lightweight bridge until a full billing pipeline is available.
+"""
+import os
+import json
+import tempfile
+from datetime import datetime
+
+try:
+    import boto3
+except Exception:
+    boto3 = None
+
+EVIDENCE_BUCKET = os.environ.get("EVIDENCE_BUCKET", "")
+DAILY_PREFIX = "billing/daily"
+
+def upload_charge_record(record: dict):
+    """
+    record example:
+    {"model":"big-llm-v1","user":"alice","est_cost":0.12,"actual_cost":0.10,"timestamp":1630000000}
+    """
+    # write a raw record (append)
+    if not boto3 or not EVIDENCE_BUCKET:
+        print("Billing upload skipped (no boto3 or EVIDENCE_BUCKET)")
+        return None
+    s3 = boto3.client("s3")
+    key = f"billing/records/record-{int(record.get('timestamp', int(datetime.utcnow().timestamp())))}.json"
+    tmp = tempfile.mktemp(suffix=".json")
+    with open(tmp, "w") as f:
+        json.dump(record, f)
+    s3.upload_file(tmp, EVIDENCE_BUCKET.replace("s3://",""), key)
+    return f"s3://{EVIDENCE_BUCKET.replace('s3://','')}/{key}"
+
+def aggregate_daily(date: datetime = None):
+    if not boto3 or not EVIDENCE_BUCKET:
+        print("Aggregate skipped (no boto3 or EVIDENCE_BUCKET)")
+        return None
+    if date is None:
+        date = datetime.utcnow()
+    # simple aggregator: list keys under billing/records/ for the day range
+    s3 = boto3.client("s3")
+    bucket = EVIDENCE_BUCKET.replace("s3://","")
+    prefix = "billing/records/"
+    objs = s3.list_objects_v2(Bucket=bucket, Prefix=prefix)
+    totals = {}
+    for o in objs.get("Contents", []):
+        k = o["Key"]
+        # naive: download and read each record (ok for PoC)
+        tmp = tempfile.mktemp(suffix=".json")
+        s3.download_file(bucket, k, tmp)
+        rec = json.load(open(tmp))
+        model = rec.get("model","unknown")
+        cost = float(rec.get("actual_cost", rec.get("est_cost", 0.0)))
+        totals.setdefault(model, 0.0)
+        totals[model] += cost
+    # upload daily summary
+    out_key = f"{DAILY_PREFIX}/summary-{date.strftime('%Y-%m-%d')}.json"
+    tmp2 = tempfile.mktemp(suffix=".json")
+    with open(tmp2, "w") as f:
+        json.dump({"date": date.strftime("%Y-%m-%d"), "totals": totals}, f, indent=2)
+    s3.upload_file(tmp2, bucket, out_key)
+    return f"s3://{bucket}/{out_key}"
+
+if __name__ == "__main__":
+    print("Billing uploader CLI")
+
