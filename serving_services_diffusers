+#!/usr/bin/env python3
+"""
+Pre-deploy check to ensure model metadata includes license and legal signoff.
+Intended to be run in CI before deploying a model chart or promoting a model to production.
+Usage:
+  python ops/registry/pre_deploy_check.py --metadata-file model_metadata.json --evidence-bucket s3://aegis-evidence-prod
+"""
+import argparse
+import json
+import boto3
+import sys
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--metadata-file", required=True)
+    p.add_argument("--evidence-bucket", required=True)
+    args = p.parse_args()
+    md = json.load(open(args.metadata_file))
+    if not md.get("license"):
+        print("ERROR: metadata must include 'license' field")
+        sys.exit(2)
+    signoff = md.get("legal_signoff_s3_key")
+    if not signoff:
+        print("ERROR: metadata must include 'legal_signoff_s3_key' (S3 key to legal signoff token)")
+        sys.exit(2)
+    s3 = boto3.client("s3")
+    bucket = args.evidence_bucket.replace("s3://","")
+    try:
+        s3.head_object(Bucket=bucket, Key=signoff)
+        print("Found legal signoff:", signoff)
+    except Exception as e:
+        print("ERROR: legal signoff not found in evidence bucket:", e)
+        sys.exit(2)
+    print("Pre-deploy metadata checks passed")
+
+if __name__ == "__main__":
+    main()
